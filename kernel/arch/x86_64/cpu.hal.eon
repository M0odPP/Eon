module kernel.arch.x86_64.cpu @hal;

/// Fixed identity-mapped shared kernel state region (`0x00200000`, well above kernel ELF at `0x00100000`).
/// Layout (all 64-bit aligned, zero-initialized on BSP boot):
///   +0x00: timer_ticks  (Atomic[u64])
///   +0x08: cpus_online  (Atomic[u32])
///   +0x10: ap_lapic_id  (Atomic[u32])
///   +0x18: ap_ready     (Atomic[u32])
///   +0x20: irq_errors   (Atomic[u32])
pub struct KernelShared {
    pub timer_ticks: Atomic[u64];
    pub cpus_online: Atomic[u32];
    pub ap_lapic_id: Atomic[u32];
    pub ap_ready: Atomic[u32];
    pub irq_errors: Atomic[u32];
}

const SHARED_ADDR: usize = 0x00200000_usize;
const GDT_ADDR: usize    = 0x00201000_usize;
const TSS_ADDR: usize    = 0x00201080_usize;
const GDTR_ADDR: usize   = 0x00201100_usize;
const IDT_ADDR: usize    = 0x00202000_usize;
const IDTR_ADDR: usize   = 0x00203000_usize;
const IST1_TOP: u64      = 0x00210000_u64;
const RSP0_TOP: u64      = 0x0020F000_u64;

// ---------------------------------------------------------------------------
// Low-level x86_64 CPU & Port I/O Primitives (EonCall: rdi, rsi, rdx -> rax)
// ---------------------------------------------------------------------------

@naked
pub fn outb(_port: u16, _val: u8) @noalloc @noblock {
    raw {
        asm("mov rdx, rdi; mov rax, rsi; outb; ret", options(noreturn));
    }
}

@naked
pub fn inb(_port: u16) -> u8 @noalloc @noblock {
    raw {
        asm("mov rdx, rdi; xor rax, rax; inb; ret", options(noreturn));
    }
    return 0_u8;
}

@naked
pub fn outw(_port: u16, _val: u16) @noalloc @noblock {
    raw {
        asm("mov rdx, rdi; mov rax, rsi; outw; ret", options(noreturn));
    }
}

@naked
pub fn inw(_port: u16) -> u16 @noalloc @noblock {
    raw {
        asm("mov rdx, rdi; xor rax, rax; inw; ret", options(noreturn));
    }
    return 0_u16;
}

@naked
pub fn outl(_port: u16, _val: u32) @noalloc @noblock {
    raw {
        asm("mov rdx, rdi; mov rax, rsi; outl; ret", options(noreturn));
    }
}

@naked
pub fn inl(_port: u16) -> u32 @noalloc @noblock {
    raw {
        asm("mov rdx, rdi; xor rax, rax; inl; ret", options(noreturn));
    }
    return 0_u32;
}

@naked
pub fn rdmsr(_msr: u32) -> u64 @noalloc @noblock {
    raw {
        asm("mov rcx, rdi; rdmsr; shl rdx, 32; or rax, rdx; ret", options(noreturn));
    }
    return 0_u64;
}

@naked
pub fn wrmsr(_msr: u32, _val: u64) @noalloc @noblock {
    raw {
        asm("mov rcx, rdi; mov rax, rsi; mov rdx, rsi; shr rdx, 32; wrmsr; ret", options(noreturn));
    }
}

@naked
pub fn read_cr0() -> u64 @noalloc @noblock {
    raw {
        asm("mov rax, cr0; ret", options(noreturn));
    }
    return 0_u64;
}

@naked
pub fn read_cr2() -> u64 @noalloc @noblock {
    raw {
        asm("mov rax, cr2; ret", options(noreturn));
    }
    return 0_u64;
}

@naked
pub fn read_cr3() -> u64 @noalloc @noblock {
    raw {
        asm("mov rax, cr3; ret", options(noreturn));
    }
    return 0_u64;
}

@naked
pub fn write_cr3(_val: u64) @noalloc @noblock {
    raw {
        asm("mov cr3, rdi; ret", options(noreturn));
    }
}

@naked
pub fn invlpg_raw(_vaddr: u64) @noalloc @noblock {
    raw {
        asm("invlpg [rdi]; ret", options(noreturn));
    }
}

@naked
pub fn lgdt_raw(_gdtr_addr: u64) @noalloc @noblock {
    raw {
        asm("lgdt [rdi]; ret", options(noreturn));
    }
}

@naked
pub fn lidt_raw(_idtr_addr: u64) @noalloc @noblock {
    raw {
        asm("lidt [rdi]; ret", options(noreturn));
    }
}

@naked
pub fn ltr_raw(_sel: u16) @noalloc @noblock {
    raw {
        asm("ltr rdi; ret", options(noreturn));
    }
}

@naked
pub fn reload_segments(_cs_sel: u64, _ds_sel: u64) @noalloc @noblock {
    raw {
        asm("pop rax; push rdi; push rax; mov ds, rsi; mov es, rsi; mov ss, rsi; mov fs, rsi; mov gs, rsi; retfq", options(noreturn));
    }
}

