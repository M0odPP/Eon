module eonc.apk_pkg;

import core.col;
import core.str;
import eonc.target;
import eonc.elf64;
import eonc.macho;

// ============================================================================
// Pure-Eon Zero-JDK/Zero-Gradle Android APK Packager & APK Signature Scheme v2
// Generates:
//   - Binary Android XML (`AXML`, chunk 0x00080003) `AndroidManifest.xml`
//   - Minimal valid `resources.arsc` (`RES_TABLE_TYPE`)
//   - 4 KiB `zipalign`-aligned uncompressed `lib/<abi>/libmain.so`
//   - Real Android APK Signature Scheme v2 (`APK Sig Block 42`, ID 0x7109871a)
//     with genuine 1 MiB chunked SHA-256 Merkle digest + pure-Eon ECDSA P-256
//     (`0x0201`) signature over a self-signed X.509 v3 DER debug certificate!
// ============================================================================

linear struct ApkBuf {
    bytes: col.DynBuf[u8];
    oom: bool;
}

impl ApkBuf {
    fn init(alloc: *mut AllocCap, cap: usize) -> ApkBuf ! OutOfMemory {
        let bs = try col.DynBuf.[u8].init(alloc, cap);
        return ApkBuf.{ bytes: bs, oom: false };
    }

    fn destroy(self: ApkBuf, alloc: *mut AllocCap) {
        let ApkBuf.{ bytes, oom: _ } = self;
        bytes.destroy(alloc);
    }

    fn len(self: *Self) -> usize { return self.bytes.len(); }

    fn pu8(self: *mut Self, alloc: *mut AllocCap, v: u8) {
        if self.oom { return; }
        self.bytes.push(alloc, v) catch { self.oom = true; return; };
    }

    fn pu16(self: *mut Self, alloc: *mut AllocCap, v: u16) {
        self.pu8(alloc, (v & 0xFF_u16).trunc.[u8]());
        self.pu8(alloc, ((v >> 8_u16) & 0xFF_u16).trunc.[u8]());
    }

    fn pu32(self: *mut Self, alloc: *mut AllocCap, v: u32) {
        self.pu8(alloc, (v & 0xFF_u32).trunc.[u8]());
        self.pu8(alloc, ((v >> 8_u32) & 0xFF_u32).trunc.[u8]());
        self.pu8(alloc, ((v >> 16_u32) & 0xFF_u32).trunc.[u8]());
        self.pu8(alloc, ((v >> 24_u32) & 0xFF_u32).trunc.[u8]());
    }

    fn pu64(self: *mut Self, alloc: *mut AllocCap, v: u64) {
        self.pu32(alloc, (v & 0xFFFFFFFF_u64).trunc.[u32]());
        self.pu32(alloc, ((v >> 32_u64) & 0xFFFFFFFF_u64).trunc.[u32]());
    }

    fn pbytes(self: *mut Self, alloc: *mut AllocCap, src: *[u8]) {
        if self.oom || src.len == 0_usize { return; }
        self.bytes.push_slice(alloc, src) catch { self.oom = true; return; };
    }

    fn pzeros(self: *mut Self, alloc: *mut AllocCap, n: usize) {
        var i: usize = 0_usize;
        while i < n && !self.oom {
            self.pu8(alloc, 0_u8);
            i = i +% 1_usize;
        }
    }

    fn patch_u32(self: *mut Self, off: usize, v: u32) {
        let s = self.bytes.as_mut_slice();
        if s.len >= 4_usize && off <= s.len - 4_usize {
            s[off] = (v & 0xFF_u32).trunc.[u8]();
            s[off + 1_usize] = ((v >> 8_u32) & 0xFF_u32).trunc.[u8]();
            s[off + 2_usize] = ((v >> 16_u32) & 0xFF_u32).trunc.[u8]();
            s[off + 3_usize] = ((v >> 24_u32) & 0xFF_u32).trunc.[u8]();
        }
    }
}

// ============================================================================
// Pure-Eon IEEE 802.3 CRC-32 (for ZIP entries)
// ============================================================================

fn crc32_bytes(data: *[u8]) -> u32 {
    var crc: u32 = 0xFFFFFFFF_u32;
    var i: usize = 0_usize;
    while i < data.len {
        crc = crc ^ data[i].widen.[u32]();
        var b: u32 = 0_u32;
        while b < 8_u32 {
            let mask: u32 = if (crc & 1_u32) != 0_u32 { 0xEDB88320_u32 } else { 0_u32 };
            crc = (crc >> 1_u32) ^ mask;
            b = b +% 1_u32;
        }
        i = i +% 1_usize;
    }
    return ~crc;
}

// ============================================================================
// Pure-Eon NIST P-256 (secp256r1) ECDSA-SHA256 Signer
// Used exclusively for deterministic APK Signature Scheme v2 debug signing.
// ============================================================================

struct U256 {
    l: [4]u64; // little-endian limbs: l[0] = LSB, l[3] = MSB
}

// P-256 field prime p = 2^256 - 2^224 + 2^192 + 2^96 - 1
fn p256_p() -> U256 {
    return U256.{ l: [0xFFFFFFFFFFFFFFFF_u64, 0x00000000FFFFFFFF_u64, 0x0000000000000000_u64, 0xFFFFFFFF00000001_u64] };
}

// P-256 group order n
fn p256_n() -> U256 {
    return U256.{ l: [0xF3B9CAC2FC632551_u64, 0xBCE6FAADA7179E84_u64, 0xFFFFFFFFFFFFFFFF_u64, 0xFFFFFFFF00000000_u64] };
}

// P-256 generator G = (Gx, Gy)
fn p256_gx() -> U256 {
    return U256.{ l: [0xF4A13945D898C296_u64, 0x77037D812DEB33A0_u64, 0xF8BCE6E563A440F2_u64, 0x6B17D1F2E12C4247_u64] };
}

fn p256_gy() -> U256 {
    return U256.{ l: [0xCBB6406837BF51F5_u64, 0x2BCE33576B315ECE_u64, 0x8EE7EB4A7C0F9E16_u64, 0x4FE342E2FE1A7F9B_u64] };
}

fn u256_zero() -> U256 { return U256.{ l: [0_u64, 0_u64, 0_u64, 0_u64] }; }
fn u256_one() -> U256 { return U256.{ l: [1_u64, 0_u64, 0_u64, 0_u64] }; }

fn u256_is_zero(a: *U256) -> bool {
    return (a.l[0_usize] | a.l[1_usize] | a.l[2_usize] | a.l[3_usize]) == 0_u64;
}

fn u256_ge(a: *U256, b: *U256) -> bool {
    var i: usize = 4_usize;
    while i > 0_usize {
        i = i - 1_usize;
        if a.l[i] != b.l[i] { return a.l[i] > b.l[i]; }
    }
    return true;
}

fn u256_from_be(src: *[u8]) -> U256 {
    var out = u256_zero();
    var limb: usize = 0_usize;
    while limb < 4_usize {
        let base = (3_usize - limb) *% 8_usize;
        var v: u64 = 0_u64;
        var j: usize = 0_usize;
        while j < 8_usize {
            let idx = base +% j;
            if idx < src.len {
                v = (v << 8_u64) | src[idx].widen.[u64]();
            }
            j = j +% 1_usize;
        }
        out.l[limb] = v;
        limb = limb +% 1_usize;
    }
    return out;
}

fn u256_to_be(a: *U256) -> [32]u8 {
    var out: [32]u8 = [0_u8; 32];
    var limb: usize = 0_usize;
    while limb < 4_usize {
        let base = (3_usize - limb) *% 8_usize;
        let v = a.l[limb];
        if base <= 24_usize {
            out[base] = ((v >> 56_u64) & 0xFF_u64).trunc.[u8]();
            out[base + 1_usize] = ((v >> 48_u64) & 0xFF_u64).trunc.[u8]();
            out[base + 2_usize] = ((v >> 40_u64) & 0xFF_u64).trunc.[u8]();
            out[base + 3_usize] = ((v >> 32_u64) & 0xFF_u64).trunc.[u8]();
            out[base + 4_usize] = ((v >> 24_u64) & 0xFF_u64).trunc.[u8]();
            out[base + 5_usize] = ((v >> 16_u64) & 0xFF_u64).trunc.[u8]();
            out[base + 6_usize] = ((v >> 8_u64) & 0xFF_u64).trunc.[u8]();
            out[base + 7_usize] = (v & 0xFF_u64).trunc.[u8]();
        }
        limb = limb +% 1_usize;
    }
    return out;
}

struct U256Carry {
    val: U256;
    carry: u64;
}

fn u256_add_raw(a: *U256, b: *U256) -> U256Carry {
    var r = u256_zero();
    var c: u64 = 0_u64;
    var i: usize = 0_usize;
    while i < 4_usize {
        let s1 = a.l[i] +% b.l[i];
        let c1: u64 = if s1 < a.l[i] { 1_u64 } else { 0_u64 };
        let s2 = s1 +% c;
        let c2: u64 = if s2 < s1 { 1_u64 } else { 0_u64 };
        r.l[i] = s2;
        c = c1 +% c2;
        i = i +% 1_usize;
    }
    return U256Carry.{ val: r, carry: c };
}

fn u256_sub_raw(a: *U256, b: *U256) -> U256Carry {
    var r = u256_zero();
    var brw: u64 = 0_u64;
    var i: usize = 0_usize;
    while i < 4_usize {
        let d1 = a.l[i] -% b.l[i];
        let b1: u64 = if a.l[i] < b.l[i] { 1_u64 } else { 0_u64 };
        let d2 = d1 -% brw;
        let b2: u64 = if d1 < brw { 1_u64 } else { 0_u64 };
        r.l[i] = d2;
        brw = b1 +% b2;
        i = i +% 1_usize;
    }
    return U256Carry.{ val: r, carry: brw };
}

fn mod_add(a: *U256, b: *U256, m: *U256) -> U256 {
    let s = u256_add_raw(a, b);
    if s.carry != 0_u64 || u256_ge(&s.val, m) {
        return u256_sub_raw(&s.val, m).val;
    }
    return s.val;
}

fn mod_sub(a: *U256, b: *U256, m: *U256) -> U256 {
    let d = u256_sub_raw(a, b);
    if d.carry != 0_u64 {
        return u256_add_raw(&d.val, m).val;
    }
    return d.val;
}

fn u256_bit(a: *U256, idx: usize) -> bool {
    let limb = idx >> 6_usize;
    let bit = (idx & 63_usize).trunc.[u64]();
    if limb >= 4_usize { return false; }
    return ((a.l[limb] >> bit) & 1_u64) != 0_u64;
}

/// Shift-and-add modular multiplication `(a * b) mod m` (compact, constant-memory, 256 iterations).
fn mod_mul(a0: *U256, b: *U256, m: *U256) -> U256 {
    var acc = u256_zero();
    var a = U256.{ l: a0.l };
    if u256_ge(&a, m) { a = u256_sub_raw(&a, m).val; }
    var bit: usize = 256_usize;
    while bit > 0_usize {
        bit = bit - 1_usize;
        acc = mod_add(&acc, &acc, m);
        if u256_bit(b, bit) {
            acc = mod_add(&acc, &a, m);
        }
    }
    return acc;
}

/// Modular exponentiation `base^exp mod m` (Fermat inversion: `a^(m-2) mod m`).
fn mod_pow(base: *U256, exp: *U256, m: *U256) -> U256 {
    var res = u256_one();
    var cur = U256.{ l: base.l };
    var i: usize = 0_usize;
    while i < 256_usize {
        if u256_bit(exp, i) {
            res = mod_mul(&res, &cur, m);
        }
        cur = mod_mul(&cur, &cur, m);
        i = i +% 1_usize;
    }
    return res;
}

fn mod_inv(a: *U256, m: *U256) -> U256 {
    let two = U256.{ l: [2_u64, 0_u64, 0_u64, 0_u64] };
    let exp = u256_sub_raw(m, &two).val;
    return mod_pow(a, &exp, m);
}

struct P256Point {
    x: U256;
    y: U256;
    inf: bool;
}

fn p256_pt_double(pt: *P256Point) -> P256Point {
    if pt.inf || u256_is_zero(&pt.y) {
        return P256Point.{ x: u256_zero(), y: u256_zero(), inf: true };
    }
    let p = p256_p();
    let three = U256.{ l: [3_u64, 0_u64, 0_u64, 0_u64] };
    let x2 = mod_mul(&pt.x, &pt.x, &p);
    let tx2 = mod_mul(&three, &x2, &p);
    let num = mod_sub(&tx2, &three, &p); // 3*x^2 + a (a = -3 mod p)
    let den = mod_add(&pt.y, &pt.y, &p);
    let den_inv = mod_inv(&den, &p);
    let lam = mod_mul(&num, &den_inv, &p);
    let lam2 = mod_mul(&lam, &lam, &p);
    let x3a = mod_sub(&lam2, &pt.x, &p);
    let x3 = mod_sub(&x3a, &pt.x, &p);
    let dx = mod_sub(&pt.x, &x3, &p);
    let ldx = mod_mul(&lam, &dx, &p);
    let y3 = mod_sub(&ldx, &pt.y, &p);
    return P256Point.{ x: x3, y: y3, inf: false };
}

fn p256_pt_add(a: *P256Point, b: *P256Point) -> P256Point {
    if a.inf { return P256Point.{ x: U256.{ l: b.x.l }, y: U256.{ l: b.y.l }, inf: b.inf }; }
    if b.inf { return P256Point.{ x: U256.{ l: a.x.l }, y: U256.{ l: a.y.l }, inf: a.inf }; }
    let p = p256_p();
    let dx = mod_sub(&b.x, &a.x, &p);
    let dy = mod_sub(&b.y, &a.y, &p);
    if u256_is_zero(&dx) {
        if u256_is_zero(&dy) { return p256_pt_double(a); }
        return P256Point.{ x: u256_zero(), y: u256_zero(), inf: true };
    }
    let dx_inv = mod_inv(&dx, &p);
    let lam = mod_mul(&dy, &dx_inv, &p);
    let lam2 = mod_mul(&lam, &lam, &p);
    let x3a = mod_sub(&lam2, &a.x, &p);
    let x3 = mod_sub(&x3a, &b.x, &p);
    let ax3 = mod_sub(&a.x, &x3, &p);
    let lax = mod_mul(&lam, &ax3, &p);
    let y3 = mod_sub(&lax, &a.y, &p);
    return P256Point.{ x: x3, y: y3, inf: false };
}

fn p256_scalar_mul_g(k: *U256) -> P256Point {
    var acc = P256Point.{ x: u256_zero(), y: u256_zero(), inf: true };
    var cur = P256Point.{ x: p256_gx(), y: p256_gy(), inf: false };
    var i: usize = 0_usize;
    while i < 256_usize {
        if u256_bit(k, i) {
            acc = p256_pt_add(&acc, &cur);
        }
        cur = p256_pt_double(&cur);
        i = i +% 1_usize;
    }
    return acc;
}

// Deterministic Eon Android Debug ECDSA P-256 keypair (matches self-signed X.509 cert below).
fn debug_priv_d() -> U256 {
    return U256.{ l: [0x6f7262c7f5f0d96f_u64, 0x91949837b047a183_u64, 0xb9d0d6c2eb02f21b_u64, 0x9f3888495525f7a6_u64] };
}

