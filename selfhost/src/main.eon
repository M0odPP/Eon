// ---------------------------------------------------------------------------
// Path component comparison (matches Rust `std::path::Path::cmp` on POSIX)
// ---------------------------------------------------------------------------

struct PathComp {
    kind: u8; // 0 = End, 1 = RootDir, 2 = CurDir, 3 = ParentDir, 4 = Normal
    start: usize;
    end: usize;
}

struct PathCompIter {
    pos: usize;
    started: bool;
}

fn next_path_comp(p: *[u8], it: *mut PathCompIter) -> PathComp {
    if !it.started {
        it.started = true;
        if p.len > 0_usize && p[0_usize] == b'/' {
            var i: usize = 1_usize;
            while i < p.len && p[i] == b'/' {
                i = i +% 1_usize;
            }
            it.pos = i;
            return PathComp.{ kind: 1_u8, start: 0_usize, end: 0_usize };
        }
        if p.len == 1_usize && p[0_usize] == b'.' {
            it.pos = 1_usize;
            return PathComp.{ kind: 2_u8, start: 0_usize, end: 0_usize };
        }
        if p.len >= 2_usize && p[0_usize] == b'.' && p[1_usize] == b'/' {
            var i: usize = 1_usize;
            while i < p.len && p[i] == b'/' {
                i = i +% 1_usize;
            }
            it.pos = i;
            return PathComp.{ kind: 2_u8, start: 0_usize, end: 0_usize };
        }
    }

    while it.pos < p.len {
        while it.pos < p.len && p[it.pos] == b'/' {
            it.pos = it.pos +% 1_usize;
        }
        if it.pos >= p.len {
            break;
        }
        let cstart = it.pos;
        while it.pos < p.len && p[it.pos] != b'/' {
            it.pos = it.pos +% 1_usize;
        }
        let cend = it.pos;
        let clen = cend -% cstart;
        if clen == 1_usize && p[cstart] == b'.' {
            continue;
        }
        if clen == 2_usize && cstart + 1_usize < p.len && p[cstart] == b'.' && p[cstart + 1_usize] == b'.' {
            return PathComp.{ kind: 3_u8, start: cstart, end: cend };
        }
        return PathComp.{ kind: 4_u8, start: cstart, end: cend };
    }
    return PathComp.{ kind: 0_u8, start: 0_usize, end: 0_usize };
}

fn cmp_bytes_range(a: *[u8], as0: usize, ae0: usize, b: *[u8], bs0: usize, be0: usize) -> i32 {
    let alen = if ae0 >= as0 { ae0 - as0 } else { 0_usize };
    let blen = if be0 >= bs0 { be0 - bs0 } else { 0_usize };
    let min_len = if alen < blen { alen } else { blen };
    var i: usize = 0_usize;
    while i < min_len {
        let ai = as0 +% i;
        let bi = bs0 +% i;
        if ai < a.len && bi < b.len {
            let ca = a[ai];
            let cb = b[bi];
            if ca < cb {
                return -1_i32;
            }
            if ca > cb {
                return 1_i32;
            }
        }
        i = i +% 1_usize;
    }
    if alen < blen {
        return -1_i32;
    }
    if alen > blen {
        return 1_i32;
    }
    return 0_i32;
}

fn cmp_paths(a: *[u8], b: *[u8]) -> i32 {
    var ita = PathCompIter.{ pos: 0_usize, started: false };
    var itb = PathCompIter.{ pos: 0_usize, started: false };
    loop {
        let ca = next_path_comp(a, &mut ita);
        let cb = next_path_comp(b, &mut itb);
        if ca.kind != cb.kind {
            if ca.kind < cb.kind {
                return -1_i32;
            }
            return 1_i32;
        }
        if ca.kind == 0_u8 {
            return 0_i32;
        }
        if ca.kind == 4_u8 {
            let ord = cmp_bytes_range(a, ca.start, ca.end, b, cb.start, cb.end);
            if ord != 0_i32 {
                return ord;
            }
        }
    }
}

view fn slice_u32(src: *[u8], start: u32, end: u32) -> *[u8] {
    let empty: *str = "";
    let s0 = start.widen.[usize]();
    let s1 = end.widen.[usize]();
    let s = src.sub(s0, s1) catch {
        return empty.as_bytes();
    };
    return s;
}

view fn slice_off_len(src: *[u8], off: u32, len: u32) -> *[u8] {
    let empty: *str = "";
    let s0 = off.widen.[usize]();
    let s1 = s0 +% len.widen.[usize]();
    let s = src.sub(s0, s1) catch {
        return empty.as_bytes();
    };
    return s;
}

fn sort_path_entries(data: *[u8], offs: *mut [u32], lens: *mut [u32]) {
    let n = offs.len;
    if n <= 1_usize || n != lens.len {
        return;
    }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third {
        gap = (gap *% 3_usize) +% 1_usize;
    }
    while gap > 0_usize {
        var i = gap;
        while i < n {
            let cur_off = offs[i];
            let cur_len = lens[i];
            let cur_slice = slice_off_len(data, cur_off, cur_len);
            var j = i;
            while j >= gap {
                let prev = j - gap;
                let prev_slice = slice_off_len(data, offs[prev], lens[prev]);
                if cmp_paths(prev_slice, cur_slice) <= 0_i32 {
                    break;
                }
                offs[j] = offs[prev];
                lens[j] = lens[prev];
                j = prev;
            }
            offs[j] = cur_off;
            lens[j] = cur_len;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

// ---------------------------------------------------------------------------
// Owned list of file paths (flat backing buffer + offset/len tables)
// ---------------------------------------------------------------------------

linear struct PathList {
    data: col.DynBuf[u8];
    offs: col.DynBuf[u32];
    lens: col.DynBuf[u32];
}

impl PathList {
    fn init(alloc: *mut AllocCap) -> PathList ! OutOfMemory {
        let data = try col.DynBuf.[u8].init(alloc, 256_usize);
        errdefer data.destroy(alloc);
        let offs = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer offs.destroy(alloc);
        let lens = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer lens.destroy(alloc);
        return PathList.{ data: data, offs: offs, lens: lens };
    }

    fn len(self: *Self) -> usize {
        return self.offs.len();
    }

    fn push(self: *mut Self, alloc: *mut AllocCap, path: *[u8]) -> !OutOfMemory {
        let off = self.data.len().trunc.[u32]();
        let n = path.len.trunc.[u32]();
        try self.data.push_slice(alloc, path);
        try self.offs.push(alloc, off);
        try self.lens.push(alloc, n);
        return;
    }

    view fn get(self: *Self, idx: usize) -> *[u8] {
        let empty: *str = "";
        let os = self.offs.as_slice();
        let ls = self.lens.as_slice();
        if idx < os.len && idx < ls.len {
            return slice_off_len(self.data.as_slice(), os[idx], ls[idx]);
        }
        return empty.as_bytes();
    }

    fn sort(self: *mut Self) {
        sort_path_entries(self.data.as_slice(), self.offs.as_mut_slice(), self.lens.as_mut_slice());
    }

    fn destroy(self: PathList, alloc: *mut AllocCap) {
        let PathList.{ data, offs, lens } = self;
        data.destroy(alloc);
        offs.destroy(alloc);
        lens.destroy(alloc);
    }
}

// ---------------------------------------------------------------------------
// Iterative recursive `.eon` file collector
// ---------------------------------------------------------------------------

fn join_path(
    alloc: *mut AllocCap,
    dir: *[u8],
    name: *[u8],
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    out.clear();
    try out.push_bytes_grow(alloc, dir);
    if dir.len > 0_usize && dir[dir.len - 1_usize] != b'/' {
        try out.push_byte_grow(alloc, b'/');
    }
    try out.push_bytes_grow(alloc, name);
    return;
}

fn collect_eon_files(
    alloc: *mut AllocCap,
    fs: *FsCap,
    root: *str,
    out: *mut PathList,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    if !fs.is_dir(root) {
        try out.push(alloc, root.as_bytes());
        return true;
    }

    var pending = try PathList.init(alloc);
    errdefer pending.destroy(alloc);
    var cur_dir = try str.StrBuf.init(alloc, 128_usize);
    errdefer cur_dir.destroy(alloc);
    var joined = try str.StrBuf.init(alloc, 256_usize);
    errdefer joined.destroy(alloc);

    try pending.push(alloc, root.as_bytes());
    var head: usize = 0_usize;
    while head < pending.len() {
        cur_dir.clear();
        try cur_dir.push_bytes_grow(alloc, pending.get(head));
        head = head +% 1_usize;

        let dir_str = try cur_dir.as_str();
        let entries = fs.list_dir(alloc, dir_str) catch {
            err_buf.clear();
            try err_buf.push_str_grow(alloc, "failed to collect `");
            try err_buf.push_bytes_grow(alloc, cur_dir.as_bytes());
            try err_buf.push_str_grow(alloc, "`\n");
            rt.eprint_bytes(err_buf.as_bytes());
            joined.destroy(alloc);
            cur_dir.destroy(alloc);
            pending.destroy(alloc);
            return false;
        };
        errdefer entries.destroy(alloc);

        let raw_bytes = entries.as_slice();
        var pos: usize = 0_usize;
        while pos < raw_bytes.len {
            let nstart = pos;
            while pos < raw_bytes.len && raw_bytes[pos] != b'\n' {
                pos = pos +% 1_usize;
            }
            let nend = pos;
            if pos < raw_bytes.len && raw_bytes[pos] == b'\n' {
                pos = pos +% 1_usize;
            }
            if nend <= nstart {
                continue;
            }
            let name = raw_bytes.sub(nstart, nend) catch {
                continue;
            };
            try join_path(alloc, cur_dir.as_bytes(), name, &mut joined);
            let joined_str = try joined.as_str();
            if fs.is_dir(joined_str) {
                try pending.push(alloc, joined.as_bytes());
            } else if str.ends_with(name, ".eon".as_bytes()) {
                try out.push(alloc, joined.as_bytes());
            }
        }
        entries.destroy(alloc);
    }

    joined.destroy(alloc);
    cur_dir.destroy(alloc);
    pending.destroy(alloc);
    return true;
}

// ---------------------------------------------------------------------------
// Lexing & exact `eonc0`-compatible token/diagnostic printing
// ---------------------------------------------------------------------------

fn load_file_into_sm(
    alloc: *mut AllocCap,
    fs: *FsCap,
    path_bytes: *[u8],
    sm: *mut span.SourceMap,
    err_buf: *mut str.StrBuf,
) -> ?u32 ! OutOfMemory | Utf8Error {
    let path_str = try path_bytes.as_str();
    let file_buf = fs.read_file(alloc, path_str) catch {
        err_buf.clear();
        try err_buf.push_str_grow(alloc, "failed to read `");
        try err_buf.push_bytes_grow(alloc, path_bytes);
        try err_buf.push_str_grow(alloc, "`\n");
        rt.eprint_bytes(err_buf.as_bytes());
        return null;
    };
    errdefer file_buf.destroy(alloc);
    let fid = try sm.add_file_bytes(alloc, path_bytes, file_buf.as_slice());
    file_buf.destroy(alloc);
    return fid;
}

fn format_and_print_tokens(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    fid: u32,
    lexed: *lexer.LexOutput,
    path_bytes: *[u8],
    print_header: bool,
    out_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    out_buf.clear();
    if print_header {
        try out_buf.push_str_grow(alloc, "=== ");
        try out_buf.push_bytes_grow(alloc, path_bytes);
        try out_buf.push_str_grow(alloc, " ===\n");
    }
    let src_text = sm.file_text(fid);
    let toks = lexed.tokens.as_slice();
    var ti: usize = 0_usize;
    while ti < toks.len {
        let t = toks[ti];
        let lc = sm.line_col(fid, t.start);
        try out_buf.push_u64_grow(alloc, lc.line.widen.[u64]());
        try out_buf.push_byte_grow(alloc, b':');
        try out_buf.push_u64_grow(alloc, lc.col.widen.[u64]());
        try out_buf.push_byte_grow(alloc, b'\t');
        try tok.write_token_kind_debug(alloc, &t, out_buf);
        try out_buf.push_byte_grow(alloc, b'\t');
        let tslice = slice_u32(src_text, t.start, t.end);
        try tok.write_rust_str_debug(alloc, tslice, out_buf);
        try out_buf.push_byte_grow(alloc, b'\n');
        if out_buf.len() >= 65536_usize {
            rt.print_bytes(out_buf.as_bytes());
            out_buf.clear();
        }
        ti = ti +% 1_usize;
    }
    if out_buf.len() > 0_usize {
        rt.print_bytes(out_buf.as_bytes());
        out_buf.clear();
    }
    return;
}

/// Returns: 0 = ok, 1 = lex diagnostics emitted, 2 = I/O read failure.
fn lex_and_print_file(
    alloc: *mut AllocCap,
    fs: *FsCap,
    path_bytes: *[u8],
    print_header: bool,
    out_buf: *mut str.StrBuf,
    err_buf: *mut str.StrBuf,
) -> i32 ! OutOfMemory | Utf8Error {
    var sm = try span.SourceMap.init(alloc);
    errdefer sm.destroy(alloc);

    let fid = (try load_file_into_sm(alloc, fs, path_bytes, &mut sm, err_buf)) orelse {
        sm.destroy(alloc);
        return 2_i32;
    };

    var interner = try span.SymInterner.init(alloc);
    errdefer interner.destroy(alloc);
    var diags = try diag.DiagBag.init(alloc);
    errdefer diags.destroy(alloc);

    let lexed = try lexer.lex_file(alloc, &sm, fid, &mut interner, &mut diags);
    errdefer lexed.destroy(alloc);

    try format_and_print_tokens(alloc, &sm, fid, &lexed, path_bytes, print_header, out_buf);

    let has_err = diags.has_errors();
    if has_err {
        err_buf.clear();
        try diags.render_all(alloc, &sm, err_buf);
        rt.eprint_bytes(err_buf.as_bytes());
    }

    lexed.destroy(alloc);
    diags.destroy(alloc);
    interner.destroy(alloc);
    sm.destroy(alloc);
    if has_err {
        return 1_i32;
    }
    return 0_i32;
}

// ---------------------------------------------------------------------------
// CLI subcommands & entrypoint
// ---------------------------------------------------------------------------

fn print_usage() {
    rt.eprint_str(
        "eonc1 — self-hosted Eon compiler\n\nUSAGE:\n\teonc1 lex [--dump] <path...>\n\teonc1 parse [--dump-ast | --dump-ast-full] [--repeat N] <path...>\n\teonc1 resolve [--dump] [--no-stdlib] <path...>\n\teonc1 check [--dump-types] [--dump-cfg] [--dump-eir] [--dump-verify] [--no-stdlib] <path...>\n\teonc1 build [--native] [--freestanding] [--shared] [--soname NAME] [-l LIB] [--sanitize] [--audit-tcb] [--emi-cache DIR] [-o out_path] [path...|build.eon]\n\teonc1 run [--native | --interp] [--sanitize] [-l LIB] [--emi-cache DIR] <path...> [-- <prog_args...>]\n\teonc1 test [tests/ui]\n\teonc1 fmt [--check] <path...>\n\teonc1 lsp\n\teonc1 --help\n",
    );
}

fn cmd_lex_dump(env: *mut Env) -> i32 ! OutOfMemory | Utf8Error {
    let argc = env.args.len();
    var inputs = try PathList.init(&mut env.alloc);
    errdefer inputs.destroy(&mut env.alloc);
    var err_buf = try str.StrBuf.init(&mut env.alloc, 256_usize);
    errdefer err_buf.destroy(&mut env.alloc);

    var ai: usize = 2_usize;
    while ai < argc {
        if let arg = env.args.get(ai) {
            if rt.str_eq(arg, "--dump") {
                // handled
            } else if rt.str_eq(arg, "-h") || rt.str_eq(arg, "--help") {
                rt.eprint_str("usage: eonc lex [--dump] <path...>\n");
                err_buf.destroy(&mut env.alloc);
                inputs.destroy(&mut env.alloc);
                return 0_i32;
            } else if str.starts_with(arg.as_bytes(), "-".as_bytes()) {
                err_buf.clear();
                try err_buf.push_str_grow(&mut env.alloc, "unknown lex flag `");
                try err_buf.push_bytes_grow(&mut env.alloc, arg.as_bytes());
                try err_buf.push_str_grow(&mut env.alloc, "`\n");
                rt.eprint_bytes(err_buf.as_bytes());
                err_buf.destroy(&mut env.alloc);
                inputs.destroy(&mut env.alloc);
                return 1_i32;
            } else {
                try inputs.push(&mut env.alloc, arg.as_bytes());
            }
        }
        ai = ai +% 1_usize;
    }

    if inputs.len() == 0_usize {
        rt.eprint_str("usage: eonc lex --dump <path...>\n");
        err_buf.destroy(&mut env.alloc);
        inputs.destroy(&mut env.alloc);
        return 1_i32;
    }

    var files = try PathList.init(&mut env.alloc);
    errdefer files.destroy(&mut env.alloc);

    var ii: usize = 0_usize;
    while ii < inputs.len() {
        let p_str = try inputs.get(ii).as_str();
        let ok = try collect_eon_files(&mut env.alloc, &env.fs, p_str, &mut files, &mut err_buf);
        if !ok {
            files.destroy(&mut env.alloc);
            err_buf.destroy(&mut env.alloc);
            inputs.destroy(&mut env.alloc);
            return 1_i32;
        }
        ii = ii +% 1_usize;
    }
    files.sort();

    var out_buf = try str.StrBuf.init(&mut env.alloc, 8192_usize);
    errdefer out_buf.destroy(&mut env.alloc);

    var had_errors = false;
    var fi: usize = 0_usize;
    while fi < files.len() {
        let status = try lex_and_print_file(
            &mut env.alloc,
            &env.fs,
            files.get(fi),
            true,
            &mut out_buf,
            &mut err_buf,
        );
        if status == 2_i32 {
            out_buf.destroy(&mut env.alloc);
            files.destroy(&mut env.alloc);
            err_buf.destroy(&mut env.alloc);
            inputs.destroy(&mut env.alloc);
            return 1_i32;
        }
        if status != 0_i32 {
            had_errors = true;
        }
        fi = fi +% 1_usize;
    }

    out_buf.destroy(&mut env.alloc);
    files.destroy(&mut env.alloc);
    err_buf.destroy(&mut env.alloc);
    inputs.destroy(&mut env.alloc);
    if had_errors {
        return 1_i32;
    }
    return 0_i32;
}

fn cmd_lex(env: *mut Env) -> i32 ! OutOfMemory | Utf8Error {
    let argc = env.args.len();
    if argc < 3_usize {
        rt.eprint_str("usage: eonc lex [--dump] <path...>\n");
        return 1_i32;
    }

    var has_dump = false;
    var ai: usize = 2_usize;
    while ai < argc {
        if let arg = env.args.get(ai) {
            if rt.str_eq(arg, "--dump") {
                has_dump = true;
                break;
            }
        }
        ai = ai +% 1_usize;
    }
    if has_dump {
        return try cmd_lex_dump(env);
    }

    var path_copy = try str.StrBuf.init(&mut env.alloc, 128_usize);
    errdefer path_copy.destroy(&mut env.alloc);
    if let p = env.args.get(2_usize) {
        try path_copy.push_bytes_grow(&mut env.alloc, p.as_bytes());
    } else {
        path_copy.destroy(&mut env.alloc);
        rt.eprint_str("usage: eonc lex [--dump] <path...>\n");
        return 1_i32;
    }

    var out_buf = try str.StrBuf.init(&mut env.alloc, 8192_usize);
    errdefer out_buf.destroy(&mut env.alloc);
    var err_buf = try str.StrBuf.init(&mut env.alloc, 256_usize);
    errdefer err_buf.destroy(&mut env.alloc);

    let status = try lex_and_print_file(
        &mut env.alloc,
        &env.fs,
        path_copy.as_bytes(),
        false,
        &mut out_buf,
        &mut err_buf,
    );

    err_buf.destroy(&mut env.alloc);
    out_buf.destroy(&mut env.alloc);
    path_copy.destroy(&mut env.alloc);
    if status != 0_i32 {
        return 1_i32;
    }
    return 0_i32;
}

// ---------------------------------------------------------------------------
// Parsing & exact `eonc0`-compatible AST / diagnostic dumping
// ---------------------------------------------------------------------------

linear struct LoadedFileBytes {
    data: col.DynBuf[u8];
    offs: col.DynBuf[u32];
    lens: col.DynBuf[u32];
}

impl LoadedFileBytes {
    fn init(alloc: *mut AllocCap) -> LoadedFileBytes ! OutOfMemory {
        let data = try col.DynBuf.[u8].init(alloc, 4096_usize);
        errdefer data.destroy(alloc);
        let offs = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer offs.destroy(alloc);
        let lens = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer lens.destroy(alloc);
        return LoadedFileBytes.{ data: data, offs: offs, lens: lens };
    }

    fn push(self: *mut Self, alloc: *mut AllocCap, bytes: *[u8]) -> !OutOfMemory {
        let off = self.data.len().trunc.[u32]();
        let n = bytes.len.trunc.[u32]();
        try self.data.push_slice(alloc, bytes);
        try self.offs.push(alloc, off);
        try self.lens.push(alloc, n);
        return;
    }

    view fn get(self: *Self, idx: usize) -> *[u8] {
        let empty: *str = "";
        let os = self.offs.as_slice();
        let ls = self.lens.as_slice();
        if idx < os.len && idx < ls.len {
            return slice_off_len(self.data.as_slice(), os[idx], ls[idx]);
        }
        return empty.as_bytes();
    }

    fn destroy(self: LoadedFileBytes, alloc: *mut AllocCap) {
        let LoadedFileBytes.{ data, offs, lens } = self;
        data.destroy(alloc);
        offs.destroy(alloc);
        lens.destroy(alloc);
    }
}

fn load_all_files(
    alloc: *mut AllocCap,
    fs: *FsCap,
    files: *PathList,
    out_bytes: *mut LoadedFileBytes,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    var i: usize = 0_usize;
    while i < files.len() {
        let p_bytes = files.get(i);
        let p_str = try p_bytes.as_str();
        let file_buf = fs.read_file(alloc, p_str) catch {
            err_buf.clear();
            try err_buf.push_str_grow(alloc, "failed to read `");
            try err_buf.push_bytes_grow(alloc, p_bytes);
            try err_buf.push_str_grow(alloc, "`\n");
            rt.eprint_bytes(err_buf.as_bytes());
            return false;
        };
        errdefer file_buf.destroy(alloc);
        try out_bytes.push(alloc, file_buf.as_slice());
        file_buf.destroy(alloc);
        i = i +% 1_usize;
    }
    return true;
}

fn run_parse_pass(
    alloc: *mut AllocCap,
    files: *PathList,
    loaded: *LoadedFileBytes,
    dump_ast: bool,
    dump_ast_full: bool,
    emit_output: bool,
    out_buf: *mut str.StrBuf,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    var sm = try span.SourceMap.init(alloc);
    errdefer sm.destroy(alloc);
    var interner = try span.SymInterner.init(alloc);
    errdefer interner.destroy(alloc);
    var diags = try diag.DiagBag.init(alloc);
    errdefer diags.destroy(alloc);
    var arena = try ast.AstArena.init(alloc);
    errdefer arena.destroy(alloc);

    var fi: usize = 0_usize;
    while fi < files.len() {
        let name = files.get(fi);
        let file_bytes = loaded.get(fi);
        let fid = try sm.add_file_bytes(alloc, name, file_bytes);
        let unit_id = try parser.parse_file(alloc, &sm, fid, &mut interner, &mut diags, &mut arena);

        if emit_output && dump_ast {
            out_buf.clear();
            try out_buf.push_str_grow(alloc, "=== ");
            try out_buf.push_bytes_grow(alloc, name);
            try out_buf.push_str_grow(alloc, " ===\n");
            try arena.dump_summary(alloc, unit_id, &interner, out_buf);
            try out_buf.push_byte_grow(alloc, b'\n');
            rt.print_bytes(out_buf.as_bytes());
        }
        if emit_output && dump_ast_full {
            out_buf.clear();
            try out_buf.push_str_grow(alloc, "=== ");
            try out_buf.push_bytes_grow(alloc, name);
            try out_buf.push_str_grow(alloc, " ===\n");
            try arena.dump_full(alloc, unit_id, &interner, out_buf);
            rt.print_bytes(out_buf.as_bytes());
        }
        fi = fi +% 1_usize;
    }

    var had_err = false;
    if emit_output && diags.has_errors() {
        err_buf.clear();
        try diags.render_all(alloc, &sm, err_buf);
        rt.eprint_bytes(err_buf.as_bytes());
        had_err = true;
    }

    arena.destroy(alloc);
    diags.destroy(alloc);
    interner.destroy(alloc);
    sm.destroy(alloc);
    return had_err;
}

struct ParseCliOpts {
    status: i32; // 0 = ok, 1 = exit 0 (--help), 2 = exit 1 (error)
    dump_ast: bool;
    dump_ast_full: bool;
    repeat: u64;
}

fn parse_cmd_parse_args(
    env: *mut Env,
    inputs: *mut PathList,
    err_buf: *mut str.StrBuf,
) -> ParseCliOpts ! OutOfMemory {
    let argc = env.args.len();
    var dump_ast = false;
    var dump_ast_full = false;
    var repeat: u64 = 1_u64;

    var ai: usize = 2_usize;
    while ai < argc {
        if let arg = env.args.get(ai) {
            if rt.str_eq(arg, "--dump-ast") {
                dump_ast = true;
            } else if rt.str_eq(arg, "--dump-ast-full") {
                dump_ast_full = true;
            } else if rt.str_eq(arg, "--repeat") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--repeat requires an integer argument\n");
                    return ParseCliOpts.{ status: 2_i32, dump_ast: false, dump_ast_full: false, repeat: 1_u64 };
                }
                if let rarg = env.args.get(ai) {
                    let parsed = str.parse_u64(rarg.as_bytes()) catch {
                        err_buf.clear();
                        try err_buf.push_str_grow(&mut env.alloc, "invalid --repeat count `");
                        try err_buf.push_bytes_grow(&mut env.alloc, rarg.as_bytes());
                        try err_buf.push_str_grow(&mut env.alloc, "`\n");
                        rt.eprint_bytes(err_buf.as_bytes());
                        return ParseCliOpts.{ status: 2_i32, dump_ast: false, dump_ast_full: false, repeat: 1_u64 };
                    };
                    if parsed < 1_u64 {
                        err_buf.clear();
                        try err_buf.push_str_grow(&mut env.alloc, "invalid --repeat count `");
                        try err_buf.push_bytes_grow(&mut env.alloc, rarg.as_bytes());
                        try err_buf.push_str_grow(&mut env.alloc, "`\n");
                        rt.eprint_bytes(err_buf.as_bytes());
                        return ParseCliOpts.{ status: 2_i32, dump_ast: false, dump_ast_full: false, repeat: 1_u64 };
                    }
                    repeat = parsed;
                }
            } else if rt.str_eq(arg, "-h") || rt.str_eq(arg, "--help") {
                rt.eprint_str("usage: eonc parse [--dump-ast | --dump-ast-full] [--repeat N] <path...>\n");
                return ParseCliOpts.{ status: 1_i32, dump_ast: false, dump_ast_full: false, repeat: 1_u64 };
            } else {
                try inputs.push(&mut env.alloc, arg.as_bytes());
            }
        }
        ai = ai +% 1_usize;
    }

    if inputs.len() == 0_usize {
        rt.eprint_str("usage: eonc parse [--dump-ast | --dump-ast-full] [--repeat N] <path...>\n");
        return ParseCliOpts.{ status: 2_i32, dump_ast: false, dump_ast_full: false, repeat: 1_u64 };
    }
    return ParseCliOpts.{
        status: 0_i32,
        dump_ast: dump_ast,
        dump_ast_full: dump_ast_full,
        repeat: repeat,
    };
}

fn collect_all_input_files(
    alloc: *mut AllocCap,
    fs: *FsCap,
    inputs: *PathList,
    out_files: *mut PathList,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    var ii: usize = 0_usize;
    while ii < inputs.len() {
        var batch = try PathList.init(alloc);
        errdefer batch.destroy(alloc);
        let p_str = try inputs.get(ii).as_str();
        let ok = try collect_eon_files(alloc, fs, p_str, &mut batch, err_buf);
        if !ok {
            batch.destroy(alloc);
            return false;
        }
        batch.sort();
        var bi: usize = 0_usize;
        while bi < batch.len() {
            try out_files.push(alloc, batch.get(bi));
            bi = bi +% 1_usize;
        }
        batch.destroy(alloc);
        ii = ii +% 1_usize;
    }
    return true;
}

fn cmd_parse(env: *mut Env) -> i32 ! OutOfMemory | Utf8Error {
    var inputs = try PathList.init(&mut env.alloc);
    errdefer inputs.destroy(&mut env.alloc);
    var err_buf = try str.StrBuf.init(&mut env.alloc, 256_usize);
    errdefer err_buf.destroy(&mut env.alloc);

    let opts = try parse_cmd_parse_args(env, &mut inputs, &mut err_buf);
    if opts.status != 0_i32 {
        err_buf.destroy(&mut env.alloc);
        inputs.destroy(&mut env.alloc);
        if opts.status == 1_i32 {
            return 0_i32;
        }
        return 1_i32;
    }

    var files = try PathList.init(&mut env.alloc);
    errdefer files.destroy(&mut env.alloc);

    let col_ok = try collect_all_input_files(&mut env.alloc, &env.fs, &inputs, &mut files, &mut err_buf);
    if !col_ok {
        files.destroy(&mut env.alloc);
        err_buf.destroy(&mut env.alloc);
        inputs.destroy(&mut env.alloc);
        return 1_i32;
    }

    var loaded = try LoadedFileBytes.init(&mut env.alloc);
    errdefer loaded.destroy(&mut env.alloc);
    let read_ok = try load_all_files(&mut env.alloc, &env.fs, &files, &mut loaded, &mut err_buf);
    if !read_ok {
        loaded.destroy(&mut env.alloc);
        files.destroy(&mut env.alloc);
        err_buf.destroy(&mut env.alloc);
        inputs.destroy(&mut env.alloc);
        return 1_i32;
    }

    var out_buf = try str.StrBuf.init(&mut env.alloc, 8192_usize);
    errdefer out_buf.destroy(&mut env.alloc);

    var had_errors = false;
    var run_idx: u64 = 0_u64;
    while run_idx < opts.repeat {
        let pass_err = try run_parse_pass(
            &mut env.alloc,
            &files,
            &loaded,
            opts.dump_ast,
            opts.dump_ast_full,
            run_idx == 0_u64,
            &mut out_buf,
            &mut err_buf,
        );
        if pass_err {
            had_errors = true;
        }
        run_idx = run_idx +% 1_u64;
    }

    out_buf.destroy(&mut env.alloc);
    loaded.destroy(&mut env.alloc);
    files.destroy(&mut env.alloc);
    err_buf.destroy(&mut env.alloc);
    inputs.destroy(&mut env.alloc);
    if had_errors {
        return 1_i32;
    }
    return 0_i32;
}

// ---------------------------------------------------------------------------
// Reusable source loader with transitive `core.*` / `std.*` auto-discovery
// ---------------------------------------------------------------------------

struct PathSeg {
    start: u32;
    end: u32;
    is_dotdot: bool;
}

fn normalize_path(
    alloc: *mut AllocCap,
    path: *[u8],
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    out.clear();
    let is_abs = path.len > 0_usize && path[0_usize] == b'/';
    var segs = try col.DynBuf.[PathSeg].init(alloc, 16_usize);
    errdefer segs.destroy(alloc);

    var i: usize = 0_usize;
    while i < path.len {
        while i < path.len && path[i] == b'/' {
            i = i +% 1_usize;
        }
        if i >= path.len {
            break;
        }
        let cstart = i;
        while i < path.len && path[i] != b'/' {
            i = i +% 1_usize;
        }
        let cend = i;
        let clen = cend -% cstart;
        if clen == 1_usize && path[cstart] == b'.' {
            continue;
        }
        let next_i = cstart +% 1_usize;
        if clen == 2_usize && next_i < path.len && path[cstart] == b'.' && path[next_i] == b'.' {
            var can_pop = false;
            let slen = segs.len();
            if slen > 0_usize {
                let sro = segs.as_slice();
                let last_idx = slen - 1_usize;
                if last_idx < sro.len && !sro[last_idx].is_dotdot {
                    can_pop = true;
                }
            }
            if can_pop {
                _ = segs.pop();
            } else if !is_abs {
                try segs.push(
                    alloc,
                    PathSeg.{
                        start: cstart.trunc.[u32](),
                        end: cend.trunc.[u32](),
                        is_dotdot: true,
                    },
                );
            }
        } else {
            try segs.push(
                alloc,
                PathSeg.{
                    start: cstart.trunc.[u32](),
                    end: cend.trunc.[u32](),
                    is_dotdot: false,
                },
            );
        }
    }

    if is_abs {
        try out.push_byte_grow(alloc, b'/');
    }
    let sslice = segs.as_slice();
    var si: usize = 0_usize;
    while si < sslice.len {
        if si > 0_usize {
            try out.push_byte_grow(alloc, b'/');
        }
        let seg = sslice[si];
        let part = slice_u32(path, seg.start, seg.end);
        try out.push_bytes_grow(alloc, part);
        si = si +% 1_usize;
    }
    if out.len() == 0_usize {
        try out.push_byte_grow(alloc, b'.');
    }

    segs.destroy(alloc);
    return;
}

fn find_stdlib_root(
    alloc: *mut AllocCap,
    fs: *FsCap,
    args: *ArgsCap,
    inputs: *PathList,
    out_root: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    var ii: usize = 0_usize;
    while ii < inputs.len() {
        if try resolve.find_stdlib_root_from(alloc, fs, inputs.get(ii), out_root) {
            return true;
        }
        ii = ii +% 1_usize;
    }
    if try resolve.find_stdlib_root_from(alloc, fs, ".".as_bytes(), out_root) {
        return true;
    }
    if fs.is_dir("..") {
        if try resolve.find_stdlib_root_from(alloc, fs, "..".as_bytes(), out_root) {
            return true;
        }
    }
    if fs.is_dir("../..") {
        if try resolve.find_stdlib_root_from(alloc, fs, "../..".as_bytes(), out_root) {
            return true;
        }
    }
    if fs.is_dir("../../..") {
        if try resolve.find_stdlib_root_from(alloc, fs, "../../..".as_bytes(), out_root) {
            return true;
        }
    }
    if let exe = args.get(0_usize) {
        if try resolve.find_stdlib_root_from(alloc, fs, exe.as_bytes(), out_root) {
            return true;
        }
    }
    return false;
}

fn load_and_parse_single_file(
    alloc: *mut AllocCap,
    fs: *FsCap,
    path_bytes: *[u8],
    sm: *mut span.SourceMap,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    arena: *mut ast.AstArena,
    out_unit_ids: *mut col.DynBuf[u32],
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    let fid = (try load_file_into_sm(alloc, fs, path_bytes, sm, err_buf)) orelse {
        return false;
    };
    let unit_id = try parser.parse_file(alloc, sm, fid, interner, diags, arena);
    try out_unit_ids.push(alloc, unit_id);
    return true;
}

struct ParsedFileRec {
    wid: u32;
    local_uid: u32;
    diag_start: u32;
    diag_len: u32;
}

struct ParseSymEntry {
    wid: u32;
    local_sym: u32;
    off: u32;
    len: u32;
}

linear struct WorkerParseState {
    arena: ast.AstArena;
    interner: span.SymInterner;
    diags: diag.DiagBag;
    sym_map: col.DynBuf[u32];
    off: ast.AstPoolOffsets;
    oom: bool;
}

impl WorkerParseState {
    fn init(alloc: *mut AllocCap) -> WorkerParseState ! OutOfMemory {
        let arena = try ast.AstArena.init(alloc);
        errdefer arena.destroy(alloc);
        let interner = try span.SymInterner.init(alloc);
        errdefer interner.destroy(alloc);
        let diags = try diag.DiagBag.init(alloc);
        errdefer diags.destroy(alloc);
        let sym_map = try col.DynBuf.[u32].init(alloc, 16_usize);
        return WorkerParseState.{
            arena: arena,
            interner: interner,
            diags: diags,
            sym_map: sym_map,
            off: ast.ast_pool_offsets_zero(),
            oom: false,
        };
    }

    fn destroy(self: WorkerParseState, alloc: *mut AllocCap) {
        let WorkerParseState.{ arena, interner, diags, sym_map, off, oom } = self;
        _ = off;
        _ = oom;
        sym_map.destroy(alloc);
        diags.destroy(alloc);
        interner.destroy(alloc);
        arena.destroy(alloc);
    }
}

fn sort_parse_files_desc(order: *mut [u32], fids: *[u32], sm: *span.SourceMap) {
    var i: usize = 1_usize;
    while i < order.len {
        let key = order[i];
        let kw = if key.widen.[usize]() < fids.len { sm.file_text(fids[key.widen.[usize]()]).len } else { 0_usize };
        var j = i;
        while j > 0_usize {
            let prev = order[j - 1_usize];
            let pw = if prev.widen.[usize]() < fids.len { sm.file_text(fids[prev.widen.[usize]()]).len } else { 0_usize };
            if pw > kw || (pw == kw && prev < key) {
                break;
            }
            order[j] = prev;
            j = j - 1_usize;
        }
        order[j] = key;
        i = i +% 1_usize;
    }
}

fn parse_worker_loop(
    wid: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    order: *[u32],
    fids: *[u32],
    results: *mut [ParsedFileRec],
    sm: *span.SourceMap,
    w: *mut WorkerParseState,
) -> !OutOfMemory {
    while true {
        let pos = next_pos.fetch_add(1_u64, .AcqRel).trunc.[usize]();
        if pos >= order.len {
            break;
        }
        let fidx = order[pos].widen.[usize]();
        if fidx >= fids.len {
            continue;
        }
        let d_start = w.diags.count().trunc.[u32]();
        let local_uid = try parser.parse_file(
            alloc, sm, fids[fidx], &mut w.interner, &mut w.diags, &mut w.arena,
        );
        let d_len = w.diags.count().trunc.[u32]() -% d_start;
        if fidx < results.len {
            results[fidx] = ParsedFileRec.{
                wid: wid,
                local_uid: local_uid,
                diag_start: d_start,
                diag_len: d_len,
            };
        }
    }
    return;
}

fn run_parse_worker_entry(
    wid: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    order: *[u32],
    fids: *[u32],
    results: *mut [ParsedFileRec],
    sm: *span.SourceMap,
    w: *mut WorkerParseState,
) {
    parse_worker_loop(wid, alloc, next_pos, order, fids, results, sm, w) catch {
        w.oom = true;
    };
}

fn dispatch_parse_workers(
    nw: usize,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    order: *[u32],
    fids: *[u32],
    results: *mut [ParsedFileRec],
    sm: *span.SourceMap,
    w0: *mut WorkerParseState, w1: *mut WorkerParseState, w2: *mut WorkerParseState, w3: *mut WorkerParseState,
    w4: *mut WorkerParseState, w5: *mut WorkerParseState, w6: *mut WorkerParseState, w7: *mut WorkerParseState,
    w8: *mut WorkerParseState, w9: *mut WorkerParseState, w10: *mut WorkerParseState, w11: *mut WorkerParseState,
) {
    if nw <= 1_usize {
        run_parse_worker_entry(0_u32, alloc, next_pos, order, fids, results, sm, w0);
        return;
    }
    par for wi in 0_usize..nw {
        if wi == 0_usize { run_parse_worker_entry(0_u32, alloc, next_pos, order, fids, results, sm, w0); }
        else if wi == 1_usize { run_parse_worker_entry(1_u32, alloc, next_pos, order, fids, results, sm, w1); }
        else if wi == 2_usize { run_parse_worker_entry(2_u32, alloc, next_pos, order, fids, results, sm, w2); }
        else if wi == 3_usize { run_parse_worker_entry(3_u32, alloc, next_pos, order, fids, results, sm, w3); }
        else if wi == 4_usize { run_parse_worker_entry(4_u32, alloc, next_pos, order, fids, results, sm, w4); }
        else if wi == 5_usize { run_parse_worker_entry(5_u32, alloc, next_pos, order, fids, results, sm, w5); }
        else if wi == 6_usize { run_parse_worker_entry(6_u32, alloc, next_pos, order, fids, results, sm, w6); }
        else if wi == 7_usize { run_parse_worker_entry(7_u32, alloc, next_pos, order, fids, results, sm, w7); }
        else if wi == 8_usize { run_parse_worker_entry(8_u32, alloc, next_pos, order, fids, results, sm, w8); }
        else if wi == 9_usize { run_parse_worker_entry(9_u32, alloc, next_pos, order, fids, results, sm, w9); }
        else if wi == 10_usize { run_parse_worker_entry(10_u32, alloc, next_pos, order, fids, results, sm, w10); }
        else if wi == 11_usize { run_parse_worker_entry(11_u32, alloc, next_pos, order, fids, results, sm, w11); }
    }
}

fn check_parse_workers_oom(
    w0: *WorkerParseState, w1: *WorkerParseState, w2: *WorkerParseState, w3: *WorkerParseState,
    w4: *WorkerParseState, w5: *WorkerParseState, w6: *WorkerParseState, w7: *WorkerParseState,
    w8: *WorkerParseState, w9: *WorkerParseState, w10: *WorkerParseState, w11: *WorkerParseState,
) -> !OutOfMemory {
    if w0.oom || w1.oom || w2.oom || w3.oom || w4.oom || w5.oom
        || w6.oom || w7.oom || w8.oom || w9.oom || w10.oom || w11.oom
    {
        return OutOfMemory;
    }
    return;
}

fn collect_worker_parse_syms(
    alloc: *mut AllocCap,
    wid: u32,
    w: *mut WorkerParseState,
    sym_bytes: *mut col.DynBuf[u8],
    entries: *mut col.DynBuf[ParseSymEntry],
) -> !OutOfMemory {
    let n = w.interner.len();
    w.sym_map.clear();
    var si: u32 = 0_u32;
    while si < n {
        try w.sym_map.push(alloc, span.SYM_EMPTY);
        if si > 0_u32 {
            let bs = w.interner.get(si);
            let off = sym_bytes.len().trunc.[u32]();
            try sym_bytes.push_slice(alloc, bs);
            try entries.push(alloc, ParseSymEntry.{
                wid: wid,
                local_sym: si,
                off: off,
                len: bs.len.trunc.[u32](),
            });
        }
        si = si +% 1_u32;
    }
    return;
}

fn cmp_parse_sym_entries(bytes: *[u8], a: ParseSymEntry, b: ParseSymEntry) -> i32 {
    let a0 = a.off.widen.[usize]();
    let a1 = a0 +% a.len.widen.[usize]();
    let b0 = b.off.widen.[usize]();
    let b1 = b0 +% b.len.widen.[usize]();
    let c = cmp_bytes_range(bytes, a0, a1, bytes, b0, b1);
    if c != 0_i32 {
        return c;
    }
    if a.wid < b.wid { return -1_i32; }
    if a.wid > b.wid { return 1_i32; }
    if a.local_sym < b.local_sym { return -1_i32; }
    if a.local_sym > b.local_sym { return 1_i32; }
    return 0_i32;
}

fn sort_parse_sym_entries(entries: *mut [ParseSymEntry], bytes: *[u8]) {
    let n = entries.len;
    if n < 2_usize {
        return;
    }
    var i = n >> 1_usize;
    while i > 0_usize {
        i = i - 1_usize;
        var root = i;
        while (root *% 2_usize) +% 1_usize < n {
            var child = (root *% 2_usize) +% 1_usize;
            if child >= entries.len || root >= entries.len {
                break;
            }
            let right = child +% 1_usize;
            if right < n && right < entries.len && cmp_parse_sym_entries(bytes, entries[child], entries[right]) < 0_i32 {
                child = right;
            }
            if cmp_parse_sym_entries(bytes, entries[root], entries[child]) >= 0_i32 {
                break;
            }
            let tmp = entries[root];
            entries[root] = entries[child];
            entries[child] = tmp;
            root = child;
        }
    }
    var end = entries.len;
    while end > 1_usize && end <= entries.len {
        end = end - 1_usize;
        let tmp = entries[0_usize];
        entries[0_usize] = entries[end];
        entries[end] = tmp;
        var root: usize = 0_usize;
        while (root *% 2_usize) +% 1_usize < end {
            var child = (root *% 2_usize) +% 1_usize;
            if child >= entries.len || root >= entries.len {
                break;
            }
            let right = child +% 1_usize;
            if right < end && right < entries.len && cmp_parse_sym_entries(bytes, entries[child], entries[right]) < 0_i32 {
                child = right;
            }
            if cmp_parse_sym_entries(bytes, entries[root], entries[child]) >= 0_i32 {
                break;
            }
            let tmp2 = entries[root];
            entries[root] = entries[child];
            entries[child] = tmp2;
            root = child;
        }
    }
}

fn set_worker_sym_map(w: *mut WorkerParseState, local_sym: u32, main_sym: u32) {
    let sm = w.sym_map.as_mut_slice();
    let idx = local_sym.widen.[usize]();
    if idx < sm.len {
        sm[idx] = main_sym;
    }
}

fn fixup_parse_worker_single(w: *mut WorkerParseState) {
    ast.fixup_worker_ast_inplace(&mut w.arena, &w.off, w.sym_map.as_slice());
}

fn dispatch_parse_fixup_workers(
    nw: usize,
    w0: *mut WorkerParseState, w1: *mut WorkerParseState, w2: *mut WorkerParseState, w3: *mut WorkerParseState,
    w4: *mut WorkerParseState, w5: *mut WorkerParseState, w6: *mut WorkerParseState, w7: *mut WorkerParseState,
    w8: *mut WorkerParseState, w9: *mut WorkerParseState, w10: *mut WorkerParseState, w11: *mut WorkerParseState,
) {
    if nw <= 1_usize {
        fixup_parse_worker_single(w0);
        return;
    }
    par for wi in 0_usize..nw {
        if wi == 0_usize { fixup_parse_worker_single(w0); }
        else if wi == 1_usize { fixup_parse_worker_single(w1); }
        else if wi == 2_usize { fixup_parse_worker_single(w2); }
        else if wi == 3_usize { fixup_parse_worker_single(w3); }
        else if wi == 4_usize { fixup_parse_worker_single(w4); }
        else if wi == 5_usize { fixup_parse_worker_single(w5); }
        else if wi == 6_usize { fixup_parse_worker_single(w6); }
        else if wi == 7_usize { fixup_parse_worker_single(w7); }
        else if wi == 8_usize { fixup_parse_worker_single(w8); }
        else if wi == 9_usize { fixup_parse_worker_single(w9); }
        else if wi == 10_usize { fixup_parse_worker_single(w10); }
        else if wi == 11_usize { fixup_parse_worker_single(w11); }
    }
}

fn parse_fids_batch_parallel(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    fids: *[u32],
    jobs: u32,
    main_interner: *mut span.SymInterner,
    main_diags: *mut diag.DiagBag,
    main_arena: *mut ast.AstArena,
    out_unit_ids: *mut col.DynBuf[u32],
) -> !OutOfMemory {
    if fids.len == 0_usize {
        return;
    }
    if fids.len == 1_usize {
        let uid = try parser.parse_file(alloc, sm, fids[0_usize], main_interner, main_diags, main_arena);
        try out_unit_ids.push(alloc, uid);
        return;
    }

    var nw: usize = if jobs == 0_u32 { 4_usize } else { jobs.widen.[usize]() };
    if nw > 12_usize { nw = 12_usize; }
    if nw > fids.len { nw = fids.len; }
    if jobs == 1_u32 { nw = 1_usize; }

    var order = try col.DynBuf.[u32].init(alloc, fids.len);
    errdefer order.destroy(alloc);
    var results = try col.DynBuf.[ParsedFileRec].init(alloc, fids.len);
    errdefer results.destroy(alloc);
    var i: usize = 0_usize;
    while i < fids.len {
        try order.push(alloc, i.trunc.[u32]());
        try results.push(alloc, ParsedFileRec.{ wid: 0_u32, local_uid: 0_u32, diag_start: 0_u32, diag_len: 0_u32 });
        i = i +% 1_usize;
    }
    sort_parse_files_desc(order.as_mut_slice(), fids, sm);

    var w0 = try WorkerParseState.init(alloc); errdefer w0.destroy(alloc);
    var w1 = try WorkerParseState.init(alloc); errdefer w1.destroy(alloc);
    var w2 = try WorkerParseState.init(alloc); errdefer w2.destroy(alloc);
    var w3 = try WorkerParseState.init(alloc); errdefer w3.destroy(alloc);
    var w4 = try WorkerParseState.init(alloc); errdefer w4.destroy(alloc);
    var w5 = try WorkerParseState.init(alloc); errdefer w5.destroy(alloc);
    var w6 = try WorkerParseState.init(alloc); errdefer w6.destroy(alloc);
    var w7 = try WorkerParseState.init(alloc); errdefer w7.destroy(alloc);
    var w8 = try WorkerParseState.init(alloc); errdefer w8.destroy(alloc);
    var w9 = try WorkerParseState.init(alloc); errdefer w9.destroy(alloc);
    var w10 = try WorkerParseState.init(alloc); errdefer w10.destroy(alloc);
    var w11 = try WorkerParseState.init(alloc); errdefer w11.destroy(alloc);

    var next_pos = sync.AtomicCounter.init(0_u64);
    dispatch_parse_workers(
        nw, alloc, &mut next_pos, order.as_slice(), fids, results.as_mut_slice(), sm,
        &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
        &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
    );
    try check_parse_workers_oom(&w0, &w1, &w2, &w3, &w4, &w5, &w6, &w7, &w8, &w9, &w10, &w11);

    // Deterministic lexicographical symbol merge across active workers: guarantees -j 1 == -j 4 == -j 12!
    var sym_bytes = try col.DynBuf.[u8].init(alloc, 4096_usize);
    errdefer sym_bytes.destroy(alloc);
    var entries = try col.DynBuf.[ParseSymEntry].init(alloc, 512_usize);
    errdefer entries.destroy(alloc);
    try collect_worker_parse_syms(alloc, 0_u32, &mut w0, &mut sym_bytes, &mut entries);
    if nw > 1_usize { try collect_worker_parse_syms(alloc, 1_u32, &mut w1, &mut sym_bytes, &mut entries); }
    if nw > 2_usize { try collect_worker_parse_syms(alloc, 2_u32, &mut w2, &mut sym_bytes, &mut entries); }
    if nw > 3_usize { try collect_worker_parse_syms(alloc, 3_u32, &mut w3, &mut sym_bytes, &mut entries); }
    if nw > 4_usize { try collect_worker_parse_syms(alloc, 4_u32, &mut w4, &mut sym_bytes, &mut entries); }
    if nw > 5_usize { try collect_worker_parse_syms(alloc, 5_u32, &mut w5, &mut sym_bytes, &mut entries); }
    if nw > 6_usize { try collect_worker_parse_syms(alloc, 6_u32, &mut w6, &mut sym_bytes, &mut entries); }
    if nw > 7_usize { try collect_worker_parse_syms(alloc, 7_u32, &mut w7, &mut sym_bytes, &mut entries); }
    if nw > 8_usize { try collect_worker_parse_syms(alloc, 8_u32, &mut w8, &mut sym_bytes, &mut entries); }
    if nw > 9_usize { try collect_worker_parse_syms(alloc, 9_u32, &mut w9, &mut sym_bytes, &mut entries); }
    if nw > 10_usize { try collect_worker_parse_syms(alloc, 10_u32, &mut w10, &mut sym_bytes, &mut entries); }
    if nw > 11_usize { try collect_worker_parse_syms(alloc, 11_u32, &mut w11, &mut sym_bytes, &mut entries); }

    let sb_ro = sym_bytes.as_slice();
    sort_parse_sym_entries(entries.as_mut_slice(), sb_ro);

    let es = entries.as_slice();
    var has_prev = false;
    var prev_off: usize = 0_usize;
    var prev_end: usize = 0_usize;
    var prev_msym: u32 = span.SYM_EMPTY;
    var ei: usize = 0_usize;
    while ei < es.len {
        let e = es[ei];
        let s0 = e.off.widen.[usize]();
        let s1 = s0 +% e.len.widen.[usize]();
        var msym = prev_msym;
        if !has_prev || cmp_bytes_range(sb_ro, prev_off, prev_end, sb_ro, s0, s1) != 0_i32 {
            let sub = sb_ro.sub(s0, s1) catch { "".as_bytes() };
            msym = try main_interner.intern(alloc, sub);
            has_prev = true;
            prev_off = s0;
            prev_end = s1;
            prev_msym = msym;
        }
        if e.wid == 0_u32 { set_worker_sym_map(&mut w0, e.local_sym, msym); }
        else if e.wid == 1_u32 { set_worker_sym_map(&mut w1, e.local_sym, msym); }
        else if e.wid == 2_u32 { set_worker_sym_map(&mut w2, e.local_sym, msym); }
        else if e.wid == 3_u32 { set_worker_sym_map(&mut w3, e.local_sym, msym); }
        else if e.wid == 4_u32 { set_worker_sym_map(&mut w4, e.local_sym, msym); }
        else if e.wid == 5_u32 { set_worker_sym_map(&mut w5, e.local_sym, msym); }
        else if e.wid == 6_u32 { set_worker_sym_map(&mut w6, e.local_sym, msym); }
        else if e.wid == 7_u32 { set_worker_sym_map(&mut w7, e.local_sym, msym); }
        else if e.wid == 8_u32 { set_worker_sym_map(&mut w8, e.local_sym, msym); }
        else if e.wid == 9_u32 { set_worker_sym_map(&mut w9, e.local_sym, msym); }
        else if e.wid == 10_u32 { set_worker_sym_map(&mut w10, e.local_sym, msym); }
        else { set_worker_sym_map(&mut w11, e.local_sym, msym); }
        ei = ei +% 1_usize;
    }

    var cur_off = ast.ast_pool_offsets_from(main_arena);
    ast.ast_pool_offsets_copy(&mut w0.off, &cur_off);
    ast.ast_pool_offsets_advance(&mut cur_off, &w0.arena);
    if nw > 1_usize { ast.ast_pool_offsets_copy(&mut w1.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w1.arena); }
    if nw > 2_usize { ast.ast_pool_offsets_copy(&mut w2.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w2.arena); }
    if nw > 3_usize { ast.ast_pool_offsets_copy(&mut w3.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w3.arena); }
    if nw > 4_usize { ast.ast_pool_offsets_copy(&mut w4.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w4.arena); }
    if nw > 5_usize { ast.ast_pool_offsets_copy(&mut w5.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w5.arena); }
    if nw > 6_usize { ast.ast_pool_offsets_copy(&mut w6.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w6.arena); }
    if nw > 7_usize { ast.ast_pool_offsets_copy(&mut w7.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w7.arena); }
    if nw > 8_usize { ast.ast_pool_offsets_copy(&mut w8.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w8.arena); }
    if nw > 9_usize { ast.ast_pool_offsets_copy(&mut w9.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w9.arena); }
    if nw > 10_usize { ast.ast_pool_offsets_copy(&mut w10.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w10.arena); }
    if nw > 11_usize { ast.ast_pool_offsets_copy(&mut w11.off, &cur_off); ast.ast_pool_offsets_advance(&mut cur_off, &w11.arena); }

    dispatch_parse_fixup_workers(
        nw,
        &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
        &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
    );

    try ast.reserve_for_bulk_append(alloc, main_arena, &cur_off);
    try ast.bulk_append_worker_ast_pools(alloc, &w0.arena, main_arena);
    if nw > 1_usize { try ast.bulk_append_worker_ast_pools(alloc, &w1.arena, main_arena); }
    if nw > 2_usize { try ast.bulk_append_worker_ast_pools(alloc, &w2.arena, main_arena); }
    if nw > 3_usize { try ast.bulk_append_worker_ast_pools(alloc, &w3.arena, main_arena); }
    if nw > 4_usize { try ast.bulk_append_worker_ast_pools(alloc, &w4.arena, main_arena); }
    if nw > 5_usize { try ast.bulk_append_worker_ast_pools(alloc, &w5.arena, main_arena); }
    if nw > 6_usize { try ast.bulk_append_worker_ast_pools(alloc, &w6.arena, main_arena); }
    if nw > 7_usize { try ast.bulk_append_worker_ast_pools(alloc, &w7.arena, main_arena); }
    if nw > 8_usize { try ast.bulk_append_worker_ast_pools(alloc, &w8.arena, main_arena); }
    if nw > 9_usize { try ast.bulk_append_worker_ast_pools(alloc, &w9.arena, main_arena); }
    if nw > 10_usize { try ast.bulk_append_worker_ast_pools(alloc, &w10.arena, main_arena); }
    if nw > 11_usize { try ast.bulk_append_worker_ast_pools(alloc, &w11.arena, main_arena); }

    let rs = results.as_slice();
    var fi: usize = 0_usize;
    while fi < rs.len {
        let r = rs[fi];
        var uoff: u32 = 0_u32;
        if r.wid == 0_u32 { uoff = w0.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w0.diags, r.diag_start, r.diag_len); } }
        else if r.wid == 1_u32 { uoff = w1.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w1.diags, r.diag_start, r.diag_len); } }
        else if r.wid == 2_u32 { uoff = w2.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w2.diags, r.diag_start, r.diag_len); } }
        else if r.wid == 3_u32 { uoff = w3.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w3.diags, r.diag_start, r.diag_len); } }
        else if r.wid == 4_u32 { uoff = w4.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w4.diags, r.diag_start, r.diag_len); } }
        else if r.wid == 5_u32 { uoff = w5.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w5.diags, r.diag_start, r.diag_len); } }
        else if r.wid == 6_u32 { uoff = w6.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w6.diags, r.diag_start, r.diag_len); } }
        else if r.wid == 7_u32 { uoff = w7.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w7.diags, r.diag_start, r.diag_len); } }
        else if r.wid == 8_u32 { uoff = w8.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w8.diags, r.diag_start, r.diag_len); } }
        else if r.wid == 9_u32 { uoff = w9.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w9.diags, r.diag_start, r.diag_len); } }
        else if r.wid == 10_u32 { uoff = w10.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w10.diags, r.diag_start, r.diag_len); } }
        else { uoff = w11.off.units; if r.diag_len > 0_u32 { try main_diags.append_diag_range(alloc, &w11.diags, r.diag_start, r.diag_len); } }
        try out_unit_ids.push(alloc, uoff +% r.local_uid);
        fi = fi +% 1_usize;
    }

    entries.destroy(alloc);
    sym_bytes.destroy(alloc);
    w11.destroy(alloc); w10.destroy(alloc); w9.destroy(alloc); w8.destroy(alloc);
    w7.destroy(alloc); w6.destroy(alloc); w5.destroy(alloc); w4.destroy(alloc);
    w3.destroy(alloc); w2.destroy(alloc); w1.destroy(alloc); w0.destroy(alloc);
    results.destroy(alloc);
    order.destroy(alloc);
    return;
}

fn discover_transitive_stdlib_with_jobs(
    alloc: *mut AllocCap,
    fs: *FsCap,
    stdlib_root: *[u8],
    seen_paths: *mut col.Interner,
    sm: *mut span.SourceMap,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    arena: *mut ast.AstArena,
    out_unit_ids: *mut col.DynBuf[u32],
    err_buf: *mut str.StrBuf,
    jobs: u32,
) -> bool ! OutOfMemory | Utf8Error {
    var seen_mods = try col.HashMap.[u8].init(alloc, 32_usize);
    errdefer seen_mods.destroy(alloc);
    var pending_mods = try col.DynBuf.[u32].init(alloc, 16_usize);
    errdefer pending_mods.destroy(alloc);
    var wave_fids = try col.DynBuf.[u32].init(alloc, 16_usize);
    errdefer wave_fids.destroy(alloc);
    var cand_path = try str.StrBuf.init(alloc, 128_usize);
    errdefer cand_path.destroy(alloc);
    var norm_path = try str.StrBuf.init(alloc, 128_usize);
    errdefer norm_path.destroy(alloc);

    var scan_idx: usize = 0_usize;
    while scan_idx < out_unit_ids.len() {
        let wave_end = out_unit_ids.len();
        wave_fids.clear();
        while scan_idx < wave_end {
            var uid: u32 = 0_u32;
            let uslice = out_unit_ids.as_slice();
            if scan_idx < uslice.len {
                uid = uslice[scan_idx];
            }
            scan_idx = scan_idx +% 1_usize;

            pending_mods.clear();
            try resolve.collect_unit_stdlib_imports(alloc, arena, uid, interner, &mut pending_mods);

            var mi: usize = 0_usize;
            while mi < pending_mods.len() {
                var msym: u32 = 0_u32;
                let mslice = pending_mods.as_slice();
                if mi < mslice.len {
                    msym = mslice[mi];
                }
                mi = mi +% 1_usize;

                let mkey = msym.widen.[u64]();
                if seen_mods.contains(mkey) {
                    continue;
                }
                try seen_mods.insert(alloc, mkey, 1_u8);

                cand_path.clear();
                let found = try resolve.resolve_stdlib_module_file(
                    alloc,
                    fs,
                    stdlib_root,
                    interner.get(msym),
                    &mut cand_path,
                );
                if !found {
                    continue;
                }
                try normalize_path(alloc, cand_path.as_bytes(), &mut norm_path);
                if let _ = seen_paths.lookup(norm_path.as_bytes()) {
                    continue;
                }
                _ = try seen_paths.intern(alloc, norm_path.as_bytes());

                let fid = (try load_file_into_sm(alloc, fs, norm_path.as_bytes(), sm, err_buf)) orelse {
                    norm_path.destroy(alloc);
                    cand_path.destroy(alloc);
                    wave_fids.destroy(alloc);
                    pending_mods.destroy(alloc);
                    seen_mods.destroy(alloc);
                    return false;
                };
                try wave_fids.push(alloc, fid);
            }
        }
        if wave_fids.len() > 0_usize {
            try parse_fids_batch_parallel(
                alloc, sm, wave_fids.as_slice(), jobs, interner, diags, arena, out_unit_ids,
            );
        }
    }

    norm_path.destroy(alloc);
    cand_path.destroy(alloc);
    wave_fids.destroy(alloc);
    pending_mods.destroy(alloc);
    seen_mods.destroy(alloc);
    return true;
}

fn load_eon_sources_with_jobs(
    env: *mut Env,
    paths: *PathList,
    load_stdlib: bool,
    sm: *mut span.SourceMap,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    arena: *mut ast.AstArena,
    out_unit_ids: *mut col.DynBuf[u32],
    err_buf: *mut str.StrBuf,
    jobs: u32,
) -> bool ! OutOfMemory | Utf8Error {
    var files = try PathList.init(&mut env.alloc);
    errdefer files.destroy(&mut env.alloc);

    let col_ok = try collect_all_input_files(&mut env.alloc, &env.fs, paths, &mut files, err_buf);
    if !col_ok {
        files.destroy(&mut env.alloc);
        return false;
    }

    var seen_paths = try col.Interner.init(&mut env.alloc, 64_usize);
    errdefer seen_paths.destroy(&mut env.alloc);
    var norm_buf = try str.StrBuf.init(&mut env.alloc, 128_usize);
    errdefer norm_buf.destroy(&mut env.alloc);
    var init_fids = try col.DynBuf.[u32].init(&mut env.alloc, files.len() +% 1_usize);
    errdefer init_fids.destroy(&mut env.alloc);

    var fi: usize = 0_usize;
    while fi < files.len() {
        let p_bytes = files.get(fi);
        try normalize_path(&mut env.alloc, p_bytes, &mut norm_buf);
        if let _ = seen_paths.lookup(norm_buf.as_bytes()) {
            fi = fi +% 1_usize;
            continue;
        }
        _ = try seen_paths.intern(&mut env.alloc, norm_buf.as_bytes());
        let fid = (try load_file_into_sm(&mut env.alloc, &env.fs, p_bytes, sm, err_buf)) orelse {
            init_fids.destroy(&mut env.alloc);
            norm_buf.destroy(&mut env.alloc);
            seen_paths.destroy(&mut env.alloc);
            files.destroy(&mut env.alloc);
            return false;
        };
        try init_fids.push(&mut env.alloc, fid);
        fi = fi +% 1_usize;
    }

    try parse_fids_batch_parallel(
        &mut env.alloc, sm, init_fids.as_slice(), jobs, interner, diags, arena, out_unit_ids,
    );

    if load_stdlib {
        var stdlib_root = try str.StrBuf.init(&mut env.alloc, 128_usize);
        errdefer stdlib_root.destroy(&mut env.alloc);
        let has_root = try find_stdlib_root(&mut env.alloc, &env.fs, &env.args, paths, &mut stdlib_root);
        if has_root {
            let std_ok = try discover_transitive_stdlib_with_jobs(
                &mut env.alloc,
                &env.fs,
                stdlib_root.as_bytes(),
                &mut seen_paths,
                sm,
                interner,
                diags,
                arena,
                out_unit_ids,
                err_buf,
                jobs,
            );
            if !std_ok {
                stdlib_root.destroy(&mut env.alloc);
                init_fids.destroy(&mut env.alloc);
                norm_buf.destroy(&mut env.alloc);
                seen_paths.destroy(&mut env.alloc);
                files.destroy(&mut env.alloc);
                return false;
            }
        }
        stdlib_root.destroy(&mut env.alloc);
    }

    init_fids.destroy(&mut env.alloc);
    norm_buf.destroy(&mut env.alloc);
    seen_paths.destroy(&mut env.alloc);
    files.destroy(&mut env.alloc);
    return true;
}

fn load_eon_sources(
    env: *mut Env,
    paths: *PathList,
    load_stdlib: bool,
    sm: *mut span.SourceMap,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    arena: *mut ast.AstArena,
    out_unit_ids: *mut col.DynBuf[u32],
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    return try load_eon_sources_with_jobs(
        env, paths, load_stdlib, sm, interner, diags, arena, out_unit_ids, err_buf, 0_u32,
    );
}

// ---------------------------------------------------------------------------
// Module resolution subcommand (`resolve [--dump] [--no-stdlib] <path...>`)
// ---------------------------------------------------------------------------

struct ResolveCliOpts {
    status: i32; // 0 = ok, 1 = exit 0 (--help), 2 = exit 1 (error)
    dump: bool;
    no_stdlib: bool;
}

fn parse_cmd_resolve_args(
    env: *mut Env,
    inputs: *mut PathList,
    err_buf: *mut str.StrBuf,
) -> ResolveCliOpts ! OutOfMemory {
    let argc = env.args.len();
    var dump = false;
    var no_stdlib = false;

    var ai: usize = 2_usize;
    while ai < argc {
        if let arg = env.args.get(ai) {
            if rt.str_eq(arg, "--dump") {
                dump = true;
            } else if rt.str_eq(arg, "--no-stdlib") {
                no_stdlib = true;
            } else if rt.str_eq(arg, "-h") || rt.str_eq(arg, "--help") {
                rt.eprint_str("usage: eonc resolve [--dump] [--no-stdlib] <path...>\n");
                return ResolveCliOpts.{ status: 1_i32, dump: false, no_stdlib: false };
            } else if str.starts_with(arg.as_bytes(), "-".as_bytes()) {
                err_buf.clear();
                try err_buf.push_str_grow(&mut env.alloc, "unknown resolve flag `");
                try err_buf.push_bytes_grow(&mut env.alloc, arg.as_bytes());
                try err_buf.push_str_grow(&mut env.alloc, "`\n");
                rt.eprint_bytes(err_buf.as_bytes());
                return ResolveCliOpts.{ status: 2_i32, dump: false, no_stdlib: false };
            } else {
                try inputs.push(&mut env.alloc, arg.as_bytes());
            }
        }
        ai = ai +% 1_usize;
    }

    if inputs.len() == 0_usize {
        rt.eprint_str("usage: eonc resolve [--dump] [--no-stdlib] <path...>\n");
        return ResolveCliOpts.{ status: 2_i32, dump: false, no_stdlib: false };
    }
    return ResolveCliOpts.{
        status: 0_i32,
        dump: dump,
        no_stdlib: no_stdlib,
    };
}

fn cmd_resolve(env: *mut Env) -> i32 ! OutOfMemory | Utf8Error {
    var inputs = try PathList.init(&mut env.alloc);
    errdefer inputs.destroy(&mut env.alloc);
    var err_buf = try str.StrBuf.init(&mut env.alloc, 256_usize);
    errdefer err_buf.destroy(&mut env.alloc);

    let opts = try parse_cmd_resolve_args(env, &mut inputs, &mut err_buf);
    if opts.status != 0_i32 {
        err_buf.destroy(&mut env.alloc);
        inputs.destroy(&mut env.alloc);
        if opts.status == 1_i32 {
            return 0_i32;
        }
        return 1_i32;
    }

    var sm = try span.SourceMap.init(&mut env.alloc);
    errdefer sm.destroy(&mut env.alloc);
    var interner = try span.SymInterner.init(&mut env.alloc);
    errdefer interner.destroy(&mut env.alloc);
    var diags = try diag.DiagBag.init(&mut env.alloc);
    errdefer diags.destroy(&mut env.alloc);
    var arena = try ast.AstArena.init(&mut env.alloc);
    errdefer arena.destroy(&mut env.alloc);
    var unit_ids = try col.DynBuf.[u32].init(&mut env.alloc, 16_usize);
    errdefer unit_ids.destroy(&mut env.alloc);

    let load_ok = try load_eon_sources(
        env,
        &inputs,
        !opts.no_stdlib,
        &mut sm,
        &mut interner,
        &mut diags,
        &mut arena,
        &mut unit_ids,
        &mut err_buf,
    );
    if !load_ok {
        unit_ids.destroy(&mut env.alloc);
        arena.destroy(&mut env.alloc);
        diags.destroy(&mut env.alloc);
        interner.destroy(&mut env.alloc);
        sm.destroy(&mut env.alloc);
        err_buf.destroy(&mut env.alloc);
        inputs.destroy(&mut env.alloc);
        return 1_i32;
    }

    let resolved = try resolve.resolve_program(
        &mut env.alloc,
        &arena,
        unit_ids.as_slice(),
        &mut interner,
        &mut diags,
    );
    errdefer resolved.destroy(&mut env.alloc);

    if opts.dump {
        var out_buf = try str.StrBuf.init(&mut env.alloc, 8192_usize);
        errdefer out_buf.destroy(&mut env.alloc);
        try resolved.dump_canonical(&mut env.alloc, &interner, &mut out_buf);
        if out_buf.len() > 0_usize {
            rt.print_bytes(out_buf.as_bytes());
        }
        out_buf.destroy(&mut env.alloc);
    }

    let has_err = diags.has_errors();
    if has_err {
        err_buf.clear();
        try diags.render_all(&mut env.alloc, &sm, &mut err_buf);
        if err_buf.len() > 0_usize {
            rt.eprint_bytes(err_buf.as_bytes());
        }
    }

    resolved.destroy(&mut env.alloc);
    unit_ids.destroy(&mut env.alloc);
    arena.destroy(&mut env.alloc);
    diags.destroy(&mut env.alloc);
    interner.destroy(&mut env.alloc);
    sm.destroy(&mut env.alloc);
    err_buf.destroy(&mut env.alloc);
    inputs.destroy(&mut env.alloc);
    if has_err {
        return 1_i32;
    }
    return 0_i32;
}

// ---------------------------------------------------------------------------
// Type-checking subcommand (`check [--dump-types] [--dump-cfg] [--dump-eir] [--dump-verify] [--no-stdlib] <path...>`)
// ---------------------------------------------------------------------------

struct CheckCliOpts {
    status: i32; // 0 = ok, 1 = exit 0 (--help), 2 = exit 1 (error)
    dump_types: bool;
    dump_cfg: bool;
    dump_eir: bool;
    dump_verify: bool;
    no_stdlib: bool;
    profile_phases: bool;
    jobs: u32;
    target_spec: target.TargetSpec;
}

fn check_opts_err(status: i32) -> CheckCliOpts {
    return CheckCliOpts.{
        status: status,
        dump_types: false,
        dump_cfg: false,
        dump_eir: false,
        dump_verify: false,
        no_stdlib: false,
        profile_phases: false,
        jobs: 0_u32,
        target_spec: target.TargetSpec.host_default(),
    };
}

fn parse_target_triple_or_err(
    alloc: *mut AllocCap,
    triple: *[u8],
    err_buf: *mut str.StrBuf,
) -> ?target.TargetSpec ! OutOfMemory {
    if let spec = target.TargetSpec.parse_triple(triple) {
        return spec;
    }
    err_buf.clear();
    try err_buf.push_str_grow(alloc, "unknown target triple `");
    try err_buf.push_bytes_grow(alloc, triple);
    try err_buf.push_str_grow(
        alloc,
        "` (supported: x86_64-linux, aarch64-linux, riscv64-linux, x86_64-windows, aarch64-windows, aarch64-macos, x86_64-macos, aarch64-android, x86_64-android, aarch64-ios, x86_64-nostd, aarch64-nostd, riscv64-nostd)\n",
    );
    rt.eprint_bytes(err_buf.as_bytes());
    return null;
}

fn parse_jobs_value(bs: *[u8]) -> ?u32 {
    if let n = parse_i64_decimal(bs) {
        if n >= 1_i64 && n <= 1024_i64 {
            return n.trunc.[u32]();
        }
    }
    return null;
}

fn parse_cmd_check_args(
    env: *mut Env,
    inputs: *mut PathList,
    err_buf: *mut str.StrBuf,
) -> CheckCliOpts ! OutOfMemory {
    let argc = env.args.len();
    var dump_types = false;
    var dump_cfg = false;
    var dump_eir = false;
    var dump_verify = false;
    var no_stdlib = false;
    var profile_phases = false;
    var jobs: u32 = 0_u32;
    var target_spec = target.TargetSpec.host_default();

    var ai: usize = 2_usize;
    while ai < argc {
        if let arg = env.args.get(ai) {
            if rt.str_eq(arg, "--dump-types") {
                dump_types = true;
            } else if rt.str_eq(arg, "--dump-cfg") {
                dump_cfg = true;
            } else if rt.str_eq(arg, "--dump-eir") {
                dump_eir = true;
            } else if rt.str_eq(arg, "--dump-verify") {
                dump_verify = true;
            } else if rt.str_eq(arg, "--no-stdlib") {
                no_stdlib = true;
            } else if rt.str_eq(arg, "--target") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--target requires a target triple (e.g. aarch64-linux)\n");
                    return check_opts_err(2_i32);
                }
                if let tv = env.args.get(ai) {
                    if let ts = try parse_target_triple_or_err(&mut env.alloc, tv.as_bytes(), err_buf) {
                        target_spec = ts;
                    } else {
                        return check_opts_err(2_i32);
                    }
                }
            } else if str.starts_with(arg.as_bytes(), "--target=".as_bytes()) {
                let ab = arg.as_bytes();
                let tsub = ab.sub(9_usize, ab.len) catch { "".as_bytes() };
                if let ts = try parse_target_triple_or_err(&mut env.alloc, tsub, err_buf) {
                    target_spec = ts;
                } else {
                    return check_opts_err(2_i32);
                }
            } else if rt.str_eq(arg, "--profile-phases") {
                profile_phases = true;
            } else if rt.str_eq(arg, "-j") || rt.str_eq(arg, "--jobs") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--jobs requires a positive integer\n");
                    return check_opts_err(2_i32);
                }
                if let jv = env.args.get(ai) {
                    if let jn = parse_jobs_value(jv.as_bytes()) {
                        jobs = jn;
                    } else {
                        rt.eprint_str("--jobs requires a positive integer (1..1024)\n");
                        return check_opts_err(2_i32);
                    }
                }
            } else if str.starts_with(arg.as_bytes(), "--jobs=".as_bytes()) {
                let ab = arg.as_bytes();
                let jsub = ab.sub(7_usize, ab.len) catch { "".as_bytes() };
                if let jn = parse_jobs_value(jsub) {
                    jobs = jn;
                } else {
                    rt.eprint_str("--jobs requires a positive integer (1..1024)\n");
                    return check_opts_err(2_i32);
                }
            } else if rt.str_eq(arg, "-h") || rt.str_eq(arg, "--help") {
                rt.eprint_str(
                    "usage: eonc check [--dump-types] [--dump-cfg] [--dump-eir] [--dump-verify] [--no-stdlib] [--profile-phases] [-j|--jobs N] <path...>\n",
                );
                return check_opts_err(1_i32);
            } else if str.starts_with(arg.as_bytes(), "-".as_bytes()) {
                err_buf.clear();
                try err_buf.push_str_grow(&mut env.alloc, "unknown check flag `");
                try err_buf.push_bytes_grow(&mut env.alloc, arg.as_bytes());
                try err_buf.push_str_grow(&mut env.alloc, "`\n");
                rt.eprint_bytes(err_buf.as_bytes());
                return check_opts_err(2_i32);
            } else {
                try inputs.push(&mut env.alloc, arg.as_bytes());
            }
        }
        ai = ai +% 1_usize;
    }

    if inputs.len() == 0_usize {
        rt.eprint_str(
            "usage: eonc check [--dump-types] [--dump-cfg] [--dump-eir] [--dump-verify] [--no-stdlib] [--profile-phases] [-j|--jobs N] <path...>\n",
        );
        return check_opts_err(2_i32);
    }
    return CheckCliOpts.{
        status: 0_i32,
        dump_types: dump_types,
        dump_cfg: dump_cfg,
        dump_eir: dump_eir,
        dump_verify: dump_verify,
        no_stdlib: no_stdlib,
        profile_phases: profile_phases,
        jobs: jobs,
        target_spec: target_spec,
    };
}

fn print_phase_line(
    alloc: *mut AllocCap,
    clock: *ClockCap,
    name: *str,
    t0: u64,
    used_before: usize,
) -> !OutOfMemory {
    let dt_ns = rt.elapsed_since(clock, t0);
    let ms_whole = dt_ns / 1000000_u64;
    let ms_frac = (dt_ns % 1000000_u64) / 10000_u64;
    let used_after = alloc.used_bytes();
    let peak_after = alloc.peak_bytes();
    let live_after = alloc.live_allocs();
    var line = try str.StrBuf.init(alloc, 128_usize);
    errdefer line.destroy(alloc);
    try line.push_str_grow(alloc, "[profile-phase] ");
    try line.push_str_grow(alloc, name);
    try line.push_str_grow(alloc, ": wall=");
    try line.push_u64_grow(alloc, ms_whole);
    try line.push_byte_grow(alloc, b'.');
    if ms_frac < 10_u64 {
        try line.push_byte_grow(alloc, b'0');
    }
    try line.push_u64_grow(alloc, ms_frac);
    try line.push_str_grow(alloc, "ms used=");
    try line.push_u64_grow(alloc, (used_after >> 10_usize).widen.[u64]());
    try line.push_str_grow(alloc, "KiB (delta=");
    if used_after >= used_before {
        try line.push_byte_grow(alloc, b'+');
        try line.push_u64_grow(alloc, ((used_after - used_before) >> 10_usize).widen.[u64]());
    } else {
        try line.push_byte_grow(alloc, b'-');
        try line.push_u64_grow(alloc, ((used_before - used_after) >> 10_usize).widen.[u64]());
    }
    try line.push_str_grow(alloc, "KiB) peak=");
    try line.push_u64_grow(alloc, (peak_after >> 10_usize).widen.[u64]());
    try line.push_str_grow(alloc, "KiB live=");
    try line.push_u64_grow(alloc, live_after.widen.[u64]());
    try line.push_byte_grow(alloc, b'\n');
    rt.eprint_bytes(line.as_bytes());
    line.destroy(alloc);
    return;
}

fn emit_check_dumps(
    alloc: *mut AllocCap,
    opts: *CheckCliOpts,
    resolved: *resolve.ResolvedProgram,
    tenv: *types.TypeEnv,
    cfg_prog: *cfg_ir.CfgProgram,
    eff_rep: *effects.EffectsReport,
    eir_prog: *eir.EirProgram,
    ver_rep: *verify.VerifyReport,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    var out_buf = try str.StrBuf.init(alloc, 8192_usize);
    errdefer out_buf.destroy(alloc);

    if opts.dump_types {
        out_buf.clear();
        try tenv.dump_types_canonical(alloc, resolved, interner, &mut out_buf);
        if out_buf.len() > 0_usize {
            rt.print_bytes(out_buf.as_bytes());
        }
    }
    if opts.dump_cfg {
        out_buf.clear();
        try cfg_prog.dump_cfg_canonical(alloc, tenv, resolved, interner, &mut out_buf);
        if out_buf.len() > 0_usize {
            rt.print_bytes(out_buf.as_bytes());
        }
    }
    if opts.dump_eir {
        out_buf.clear();
        try eir_prog.dump_canonical(alloc, tenv, resolved, interner, &mut out_buf);
        if out_buf.len() > 0_usize {
            rt.print_bytes(out_buf.as_bytes());
        }
    }
    if opts.dump_verify {
        out_buf.clear();
        try verify.dump_verify_canonical(
            alloc, cfg_prog, eff_rep, ver_rep, resolved, tenv, interner, &mut out_buf,
        );
        if out_buf.len() > 0_usize {
            rt.print_bytes(out_buf.as_bytes());
        }
    }
    out_buf.destroy(alloc);
    return;
}

fn run_check_pipeline(
    alloc: *mut AllocCap,
    clock: *ClockCap,
    sm: *span.SourceMap,
    arena: *ast.AstArena,
    unit_ids: *[u32],
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    opts: *CheckCliOpts,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let prof = opts.profile_phases;
    var t0 = if prof { rt.now_ns(clock) } else { 0_u64 };
    var u0 = if prof { alloc.used_bytes() } else { 0_usize };
    var resolved = try resolve.resolve_program(alloc, arena, unit_ids, interner, diags);
    errdefer resolved.destroy(alloc);
    if prof { try print_phase_line(alloc, clock, "resolve", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }

    var tenv = try types.build_type_env(alloc, arena, &mut resolved, interner, diags);
    errdefer tenv.destroy(alloc);
    tenv.set_target(opts.target_spec);
    if prof { try print_phase_line(alloc, clock, "types", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }

    var ct = try ctvm.CtArena.init(alloc);
    errdefer ct.destroy(alloc);

    let ttable = try check.check_program_with_jobs(
        alloc, arena, unit_ids, &mut resolved, &mut tenv, &mut ct, interner, diags, opts.jobs,
    );
    errdefer ttable.destroy(alloc);
    if prof { try print_phase_line(alloc, clock, "check", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }

    let pre_err_count = diags.count();
    let cfg_prog = try cfg.lower_program_with_jobs(
        alloc, arena, unit_ids, &resolved, &mut tenv, &ct, &ttable, interner, opts.jobs,
    );
    errdefer cfg_prog.destroy(alloc);
    if prof { try print_phase_line(alloc, clock, "cfg", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }

    try borrow.analyze_program_with_jobs(alloc, &resolved, &tenv, &cfg_prog, interner, diags, opts.jobs);
    if prof { try print_phase_line(alloc, clock, "borrow", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }

    let eff_rep = if pre_err_count == 0_usize {
        try effects.check_effects_and_concurrency_with_jobs(
            alloc, arena, unit_ids, &resolved, &tenv, &cfg_prog, interner, diags, opts.jobs,
        )
    } else {
        try effects.EffectsReport.init(alloc)
    };
    errdefer eff_rep.destroy(alloc);
    if prof { try print_phase_line(alloc, clock, "effects", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }

    var eir_prog = try eir.lower_cfg_to_eir_with_diags_and_jobs(
        alloc, &cfg_prog, &resolved, &tenv, interner, diags, false, opts.jobs,
    );
    errdefer eir_prog.destroy(alloc);
    if prof { try print_phase_line(alloc, clock, "eir", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }

    let ver_rep = if pre_err_count == 0_usize {
        let vr = try verify.verify_program_with_jobs(
            alloc, arena, &resolved, &tenv, &mut eir_prog, interner, diags, opts.jobs,
        );
        errdefer vr.destroy(alloc);
        try eir.apply_layout_sharing(alloc, &mut eir_prog, &tenv);
        vr
    } else {
        try verify.VerifyReport.init(alloc)
    };
    errdefer ver_rep.destroy(alloc);
    if prof {
        try print_phase_line(alloc, clock, "verify", t0, u0);
        var vp_buf = try str.StrBuf.init(alloc, 256_usize);
        errdefer vp_buf.destroy(alloc);
        try verify.format_verify_prof(alloc, &ver_rep.prof, &eir_prog, interner, &mut vp_buf);
        rt.eprint_bytes(vp_buf.as_bytes());
        vp_buf.destroy(alloc);
    }

    try emit_check_dumps(
        alloc, opts, &resolved, &tenv, &cfg_prog, &eff_rep, &eir_prog, &ver_rep, interner,
    );

    let has_err = diags.has_errors();
    if has_err {
        err_buf.clear();
        try diags.render_all(alloc, sm, err_buf);
        if err_buf.len() > 0_usize {
            rt.eprint_bytes(err_buf.as_bytes());
        }
    }

    ver_rep.destroy(alloc);
    eir_prog.destroy(alloc);
    eff_rep.destroy(alloc);
    cfg_prog.destroy(alloc);
    ttable.destroy(alloc);
    ct.destroy(alloc);
    tenv.destroy(alloc);
    resolved.destroy(alloc);
    return has_err;
}

fn cmd_check(env: *mut Env) -> i32 ! OutOfMemory | Utf8Error {
    var inputs = try PathList.init(&mut env.alloc);
    errdefer inputs.destroy(&mut env.alloc);
    var err_buf = try str.StrBuf.init(&mut env.alloc, 256_usize);
    errdefer err_buf.destroy(&mut env.alloc);

    let opts = try parse_cmd_check_args(env, &mut inputs, &mut err_buf);
    if opts.status != 0_i32 {
        err_buf.destroy(&mut env.alloc);
        inputs.destroy(&mut env.alloc);
        if opts.status == 1_i32 {
            return 0_i32;
        }
        return 1_i32;
    }

    var sm = try span.SourceMap.init(&mut env.alloc);
    errdefer sm.destroy(&mut env.alloc);
    var interner = try span.SymInterner.init(&mut env.alloc);
    errdefer interner.destroy(&mut env.alloc);
    var diags = try diag.DiagBag.init(&mut env.alloc);
    errdefer diags.destroy(&mut env.alloc);
    var arena = try ast.AstArena.init(&mut env.alloc);
    errdefer arena.destroy(&mut env.alloc);
    var unit_ids = try col.DynBuf.[u32].init(&mut env.alloc, 16_usize);
    errdefer unit_ids.destroy(&mut env.alloc);

    let t_load = if opts.profile_phases { rt.now_ns(&env.clock) } else { 0_u64 };
    let u_load = if opts.profile_phases { env.alloc.used_bytes() } else { 0_usize };
    let load_ok = try load_eon_sources_with_jobs(
        env,
        &inputs,
        !opts.no_stdlib,
        &mut sm,
        &mut interner,
        &mut diags,
        &mut arena,
        &mut unit_ids,
        &mut err_buf,
        opts.jobs,
    );
    if !load_ok {
        unit_ids.destroy(&mut env.alloc);
        arena.destroy(&mut env.alloc);
        diags.destroy(&mut env.alloc);
        interner.destroy(&mut env.alloc);
        sm.destroy(&mut env.alloc);
        err_buf.destroy(&mut env.alloc);
        inputs.destroy(&mut env.alloc);
        return 1_i32;
    }
    if opts.profile_phases {
        try print_phase_line(&mut env.alloc, &env.clock, "load+parse", t_load, u_load);
    }

    let has_err = try run_check_pipeline(
        &mut env.alloc,
        &env.clock,
        &sm,
        &arena,
        unit_ids.as_slice(),
        &mut interner,
        &mut diags,
        &opts,
        &mut err_buf,
    );

    unit_ids.destroy(&mut env.alloc);
    arena.destroy(&mut env.alloc);
    diags.destroy(&mut env.alloc);
    interner.destroy(&mut env.alloc);
    sm.destroy(&mut env.alloc);
    err_buf.destroy(&mut env.alloc);
    inputs.destroy(&mut env.alloc);
    if has_err {
        return 1_i32;
    }
    return 0_i32;
}

// ---------------------------------------------------------------------------
// Shared Build / Run Helpers (library sonames, path helpers, ELF64 emission)
// ---------------------------------------------------------------------------

fn bytes_contain(hay: *[u8], needle: *[u8]) -> bool {
    if needle.len == 0_usize {
        return true;
    }
    if needle.len > hay.len {
        return false;
    }
    let lim = hay.len - needle.len;
    var i: usize = 0_usize;
    while i <= lim {
        var j: usize = 0_usize;
        var ok = true;
        while j < needle.len {
            let hi = i +% j;
            if hi >= hay.len || hay[hi] != needle[j] {
                ok = false;
                break;
            }
            j = j +% 1_usize;
        }
        if ok {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn bytes_contain_byte(hay: *[u8], b: u8) -> bool {
    var i: usize = 0_usize;
    while i < hay.len {
        if hay[i] == b {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn ends_with_nl(bs: *[u8]) -> bool {
    if bs.len == 0_usize {
        return false;
    }
    return bs[bs.len - 1_usize] == b'\n';
}

fn resolve_lib_soname(
    alloc: *mut AllocCap,
    lib_name: *[u8],
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    out.clear();
    if str.bytes_eq(lib_name, "c".as_bytes()) {
        try out.push_str_grow(alloc, "libc.so.6");
    } else if str.bytes_eq(lib_name, "m".as_bytes()) {
        try out.push_str_grow(alloc, "libm.so.6");
    } else if str.bytes_eq(lib_name, "pthread".as_bytes()) {
        try out.push_str_grow(alloc, "libpthread.so.6");
    } else if str.bytes_eq(lib_name, "dl".as_bytes()) {
        try out.push_str_grow(alloc, "libdl.so.6");
    } else if str.ends_with(lib_name, ".so".as_bytes())
        || bytes_contain(lib_name, ".so.".as_bytes())
        || bytes_contain_byte(lib_name, b'/')
    {
        try out.push_bytes_grow(alloc, lib_name);
    } else {
        try out.push_str_grow(alloc, "lib");
        try out.push_bytes_grow(alloc, lib_name);
        try out.push_str_grow(alloc, ".so");
    }
    return;
}

fn push_unique_path(
    alloc: *mut AllocCap,
    list: *mut PathList,
    item: *[u8],
) -> !OutOfMemory {
    var i: usize = 0_usize;
    while i < list.len() {
        if str.bytes_eq(list.get(i), item) {
            return;
        }
        i = i +% 1_usize;
    }
    try list.push(alloc, item);
    return;
}

view fn path_basename(path: *[u8]) -> *[u8] {
    var end = path.len;
    while end > 0_usize && path[end - 1_usize] == b'/' {
        end = end - 1_usize;
    }
    var i = end;
    while i > 0_usize {
        if path[i - 1_usize] == b'/' {
            let s = path.sub(i, end) catch { return path; };
            return s;
        }
        i = i - 1_usize;
    }
    let s = path.sub(0_usize, end) catch { return path; };
    return s;
}

view fn path_parent(path: *[u8]) -> *[u8] {
    let empty: *str = "";
    var end = path.len;
    while end > 1_usize && path[end - 1_usize] == b'/' {
        end = end - 1_usize;
    }
    var i = end;
    while i > 0_usize {
        i = i - 1_usize;
        if path[i] == b'/' {
            if i == 0_usize {
                let root = path.sub(0_usize, 1_usize) catch { return empty.as_bytes(); };
                return root;
            }
            let pdir = path.sub(0_usize, i) catch { return empty.as_bytes(); };
            return pdir;
        }
    }
    return empty.as_bytes();
}

fn file_exists_regular(alloc: *mut AllocCap, fs: *FsCap, path: *str) -> bool {
    if fs.is_dir(path) {
        return false;
    }
    let buf = fs.read_file(alloc, path) catch {
        return false;
    };
    buf.destroy(alloc);
    return true;
}

fn emit_unsupported_cfg_diags_range(
    alloc: *mut AllocCap,
    cfg_prog: *cfg_ir.CfgProgram,
    fn_start: u32,
    fn_end: u32,
    diags: *mut diag.DiagBag,
    suffix: *str,
) -> !OutOfMemory {
    var msg = try str.StrBuf.init(alloc, 64_usize);
    errdefer msg.destroy(alloc);
    let nfns = cfg_prog.fn_count();
    let lim = if fn_end > nfns { nfns } else { fn_end };
    var fi: u32 = fn_start;
    while fi < lim {
        if let cf = cfg_prog.get_fn(fi) {
            if cf.sig.generics.len == 0_u32 && !cf.sig.is_comptime {
                let unsup = cfg_prog.fn_unsupported(fi);
                var ui: usize = 0_usize;
                while ui < unsup.len {
                    msg.clear();
                    try msg.push_str_grow(alloc, "cannot lower `");
                    try msg.push_bytes_grow(alloc, cfg_prog.bytes_slice(unsup[ui].kind_bytes));
                    try msg.push_str_grow(alloc, suffix);
                    _ = try diags.emit_error_bytes(alloc, diag.E0230, unsup[ui].span, msg.as_bytes());
                    ui = ui +% 1_usize;
                }
            }
        }
        fi = fi +% 1_u32;
    }
    msg.destroy(alloc);
    return;
}

fn emit_unsupported_cfg_diags(
    alloc: *mut AllocCap,
    cfg_prog: *cfg_ir.CfgProgram,
    diags: *mut diag.DiagBag,
    suffix: *str,
) -> !OutOfMemory {
    try emit_unsupported_cfg_diags_range(alloc, cfg_prog, 0_u32, cfg_prog.fn_count(), diags, suffix);
    return;
}

fn write_elf_artifact(
    alloc: *mut AllocCap,
    fs: *FsCap,
    out_path: *[u8],
    elf_bytes: *[u8],
    is_shared: bool,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    let parent = path_parent(out_path);
    if parent.len > 0_usize {
        let pstr = try parent.as_str();
        fs.mkdir_all(pstr) catch {
            err_buf.clear();
            try err_buf.push_str_grow(alloc, "failed to create dir `");
            try err_buf.push_bytes_grow(alloc, parent);
            try err_buf.push_str_grow(alloc, "`\n");
            return false;
        };
    }
    let ostr = try out_path.as_str();
    if is_shared {
        fs.write_file(ostr, elf_bytes) catch {
            err_buf.clear();
            try err_buf.push_str_grow(alloc, "failed to write `");
            try err_buf.push_bytes_grow(alloc, out_path);
            try err_buf.push_str_grow(alloc, "`\n");
            return false;
        };
    } else {
        fs.write_executable(ostr, elf_bytes) catch {
            err_buf.clear();
            try err_buf.push_str_grow(alloc, "failed to write `");
            try err_buf.push_bytes_grow(alloc, out_path);
            try err_buf.push_str_grow(alloc, "`\n");
            return false;
        };
    }
    return true;
}

fn print_built_elf_msg(
    alloc: *mut AllocCap,
    out_path: *[u8],
    is_shared: bool,
    byte_len: usize,
) -> !OutOfMemory {
    var buf = try str.StrBuf.init(alloc, 128_usize);
    errdefer buf.destroy(alloc);
    if is_shared {
        try buf.push_str_grow(alloc, "built shared ELF64 ");
    } else {
        try buf.push_str_grow(alloc, "built native ELF64 ");
    }
    try buf.push_bytes_grow(alloc, out_path);
    try buf.push_str_grow(alloc, " (");
    try buf.push_u64_grow(alloc, byte_len.widen.[u64]());
    try buf.push_str_grow(alloc, " bytes)\n");
    rt.eprint_bytes(buf.as_bytes());
    buf.destroy(alloc);
    return;
}

fn parse_i64_decimal(bs: *[u8]) -> ?i64 {
    if bs.len == 0_usize {
        return null;
    }
    var neg = false;
    var i: usize = 0_usize;
    if bs[0_usize] == b'-' {
        neg = true;
        i = 1_usize;
    } else if bs[0_usize] == b'+' {
        i = 1_usize;
    }
    if i >= bs.len {
        return null;
    }
    var acc: u64 = 0_u64;
    while i < bs.len {
        let c = bs[i];
        if c < b'0' || c > b'9' {
            return null;
        }
        acc = acc *% 10_u64 +% (c -% b'0').widen.[u64]();
        i = i +% 1_usize;
    }
    let v = acc.bitcast.[i64]();
    return if neg { 0_i64 -% v } else { v };
}

fn print_opt_stats_line(alloc: *mut AllocCap, st: *eir_opt.OptStats) -> !OutOfMemory {
    var b = try str.StrBuf.init(alloc, 192_usize);
    errdefer b.destroy(alloc);
    try b.push_str_grow(alloc, "[opt] passes=");
    try b.push_u64_grow(alloc, st.passes_run);
    try b.push_str_grow(alloc, " inline=");
    try b.push_u64_grow(alloc, st.inlined_calls);
    try b.push_str_grow(alloc, " sroa=");
    try b.push_u64_grow(alloc, st.sroa_slots);
    try b.push_str_grow(alloc, " mem2reg=");
    try b.push_u64_grow(alloc, st.mem2reg_slots);
    try b.push_str_grow(alloc, " fold=");
    try b.push_u64_grow(alloc, st.folded_consts);
    try b.push_str_grow(alloc, " gvn=");
    try b.push_u64_grow(alloc, st.gvn_eliminated);
    try b.push_str_grow(alloc, " licm=");
    try b.push_u64_grow(alloc, st.licm_hoisted);
    try b.push_str_grow(alloc, " dbm=");
    try b.push_u64_grow(alloc, st.dbm_checks_eliminated);
    try b.push_str_grow(alloc, " fused=");
    try b.push_u64_grow(alloc, st.fused_pool_loops);
    try b.push_str_grow(alloc, " tce=");
    try b.push_u64_grow(alloc, st.tail_calls_eliminated);
    try b.push_str_grow(alloc, " devirt=");
    try b.push_u64_grow(alloc, st.devirt_calls);
    try b.push_str_grow(alloc, " dce=");
    try b.push_u64_grow(alloc, st.dce_removed);
    try b.push_byte_grow(alloc, b'\n');
    rt.eprint_bytes(b.as_bytes());
    b.destroy(alloc);
    return;
}

/// Returns: 0 = not an opt flag, 1 = consumed flag cleanly, 2 = error (message printed)
fn try_parse_opt_flag(
    arg: *str,
    opt: *mut eir.EirOptConfig,
    opt_stats: *mut bool,
) -> u8 {
    let ab = arg.as_bytes();
    if rt.str_eq(arg, "--release") || rt.str_eq(arg, "-O") || rt.str_eq(arg, "-O2") {
        opt.opt_level = 2_u8;
        opt.target_avx2 = true;
        opt.opt_size = false;
        return 1_u8;
    }
    if rt.str_eq(arg, "-O3") {
        opt.opt_level = 3_u8;
        opt.target_avx2 = true;
        opt.opt_size = false;
        return 1_u8;
    }
    if rt.str_eq(arg, "-Os") {
        opt.opt_level = 2_u8;
        opt.target_avx2 = true;
        opt.opt_size = true;
        return 1_u8;
    }
    if rt.str_eq(arg, "-Oz") {
        opt.opt_level = 2_u8;
        opt.target_avx2 = false;
        opt.opt_size = true;
        return 1_u8;
    }
    if rt.str_eq(arg, "-O1") {
        opt.opt_level = 1_u8;
        opt.target_avx2 = false;
        opt.opt_size = false;
        return 1_u8;
    }
    if rt.str_eq(arg, "--dev") || rt.str_eq(arg, "-O0") {
        opt.opt_level = 0_u8;
        opt.target_avx2 = false;
        opt.opt_size = false;
        return 1_u8;
    }
    if rt.str_eq(arg, "--verify-opt") {
        opt.verify_opt = true;
        return 1_u8;
    }
    if rt.str_eq(arg, "--opt-stats") {
        opt_stats.* = true;
        return 1_u8;
    }
    if str.starts_with(ab, "--opt-bisect=".as_bytes()) {
        let sub = ab.sub(13_usize, ab.len) catch { "".as_bytes() };
        if let n = parse_i64_decimal(sub) {
            opt.opt_bisect = n;
            return 1_u8;
        }
        rt.eprint_str("--opt-bisect= requires an integer\n");
        return 2_u8;
    }
    if str.starts_with(ab, "--target-cpu=".as_bytes()) {
        let sub = ab.sub(13_usize, ab.len) catch { "".as_bytes() };
        if str.bytes_eq(sub, "native".as_bytes()) || str.bytes_eq(sub, "x86-64-v3".as_bytes()) || str.bytes_eq(sub, "avx2".as_bytes()) {
            opt.target_avx2 = true;
            return 1_u8;
        }
        if str.bytes_eq(sub, "baseline".as_bytes()) || str.bytes_eq(sub, "x86-64".as_bytes()) || str.bytes_eq(sub, "no-avx2".as_bytes()) {
            opt.target_avx2 = false;
            return 1_u8;
        }
        rt.eprint_str("unknown --target-cpu value (expected native, x86-64-v3, or baseline)\n");
        return 2_u8;
    }
    return 0_u8;
}

// ---------------------------------------------------------------------------
// Incremental `.emi` Interface Stubs & Function-Level Early Cutoff
// ---------------------------------------------------------------------------

fn format_ident_range_dotted(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    range: ast.IdRange,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    out.clear();
    let segs = arena.idents_range(range);
    var i: usize = 0_usize;
    while i < segs.len {
        if i > 0_usize {
            try out.push_byte_grow(alloc, b'.');
        }
        try out.push_bytes_grow(alloc, interner.get(segs[i].sym));
        i = i +% 1_usize;
    }
    return;
}

fn decl_has_inline_attr(
    arena: *ast.AstArena,
    attrs: ast.IdRange,
    interner: *span.SymInterner,
) -> bool {
    let ats = arena.attrs_range(attrs);
    var i: usize = 0_usize;
    while i < ats.len {
        let nb = interner.get(ats[i].name.sym);
        if str.bytes_eq(nb, "inline".as_bytes()) || str.bytes_eq(nb, "always_inline".as_bytes()) {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn append_stub_fn_decl(
    alloc: *mut AllocCap,
    src: *[u8],
    arena: *ast.AstArena,
    d: *ast.DeclNode,
    fn_id: u32,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    if let fn_n = arena.get_fn_decl(fn_id) {
        let keep_full = fn_n.is_comptime
            || fn_n.generics.len > 0_u32
            || decl_has_inline_attr(arena, d.attrs, interner)
            || decl_has_inline_attr(arena, fn_n.effects, interner);
        if !keep_full {
            if let blk = arena.get_block(fn_n.body) {
                if blk.span.start >= d.span.start && blk.span.start <= d.span.end {
                    try out.push_bytes_grow(alloc, slice_u32(src, d.span.start, blk.span.start));
                    try out.push_str_grow(alloc, "{}\n");
                    return;
                }
            }
        }
    }
    try out.push_bytes_grow(alloc, slice_u32(src, d.span.start, d.span.end));
    try out.push_byte_grow(alloc, b'\n');
    return;
}

fn append_stub_sys_decl(
    alloc: *mut AllocCap,
    src: *[u8],
    arena: *ast.AstArena,
    d: *ast.DeclNode,
    sys_id: u32,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    if let sys_n = arena.get_sys_decl(sys_id) {
        let keep_full = sys_n.generics.len > 0_u32
            || decl_has_inline_attr(arena, d.attrs, interner)
            || decl_has_inline_attr(arena, sys_n.effects, interner);
        if !keep_full {
            if let blk = arena.get_block(sys_n.body) {
                if blk.span.start >= d.span.start && blk.span.start <= d.span.end {
                    try out.push_bytes_grow(alloc, slice_u32(src, d.span.start, blk.span.start));
                    try out.push_str_grow(alloc, "{}\n");
                    return;
                }
            }
        }
    }
    try out.push_bytes_grow(alloc, slice_u32(src, d.span.start, d.span.end));
    try out.push_byte_grow(alloc, b'\n');
    return;
}

fn extract_module_stub(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    arena: *ast.AstArena,
    unit_id: u32,
    interner: *span.SymInterner,
    out_stub: *mut str.StrBuf,
) -> !OutOfMemory {
    out_stub.clear();
    let unit = arena.get_unit(unit_id) orelse { return; };
    let src = sm.file_text(unit.file);

    if unit.module_path.len > 0_u32 {
        var mod_buf = try str.StrBuf.init(alloc, 32_usize);
        errdefer mod_buf.destroy(alloc);
        try format_ident_range_dotted(alloc, arena, unit.module_path, interner, &mut mod_buf);
        try out_stub.push_str_grow(alloc, "module ");
        try out_stub.push_bytes_grow(alloc, mod_buf.as_bytes());
        if unit.is_hal {
            try out_stub.push_str_grow(alloc, " @hal");
        }
        try out_stub.push_str_grow(alloc, ";\n");
        mod_buf.destroy(alloc);
    }

    let imps = arena.imports_range(unit.imports);
    var ii: usize = 0_usize;
    while ii < imps.len {
        let imp = imps[ii];
        try out_stub.push_bytes_grow(alloc, slice_u32(src, imp.span.start, imp.span.end));
        try out_stub.push_byte_grow(alloc, b'\n');
        ii = ii +% 1_usize;
    }

    let decls = arena.decl_list_range(unit.decls);
    var di: usize = 0_usize;
    while di < decls.len {
        if let d = arena.get_decl(decls[di]) {
            if d.kind == .Fn {
                try append_stub_fn_decl(alloc, src, arena, d, d.payload, interner, out_stub);
            } else if d.kind == .Sys {
                try append_stub_sys_decl(alloc, src, arena, d, d.payload, interner, out_stub);
            } else if d.kind == .Impl {
                var emitted_impl = false;
                if let im = arena.get_impl_decl(d.payload) {
                    if im.generics.len == 0_u32 && im.decls.len > 0_u32 {
                        let sub_ids = arena.decl_list_range(im.decls);
                        if sub_ids.len > 0_usize {
                            if let first_sd = arena.get_decl(sub_ids[0_usize]) {
                                if first_sd.span.start > d.span.start && first_sd.span.start <= d.span.end {
                                    try out_stub.push_bytes_grow(alloc, slice_u32(src, d.span.start, first_sd.span.start));
                                    var mi: usize = 0_usize;
                                    while mi < sub_ids.len {
                                        if let sd = arena.get_decl(sub_ids[mi]) {
                                            if sd.kind == .Fn {
                                                try append_stub_fn_decl(alloc, src, arena, sd, sd.payload, interner, out_stub);
                                            } else {
                                                try out_stub.push_bytes_grow(alloc, slice_u32(src, sd.span.start, sd.span.end));
                                                try out_stub.push_byte_grow(alloc, b'\n');
                                            }
                                        }
                                        mi = mi +% 1_usize;
                                    }
                                    try out_stub.push_str_grow(alloc, "}\n");
                                    emitted_impl = true;
                                }
                            }
                        }
                    }
                }
                if !emitted_impl {
                    try out_stub.push_bytes_grow(alloc, slice_u32(src, d.span.start, d.span.end));
                    try out_stub.push_byte_grow(alloc, b'\n');
                }
            } else {
                try out_stub.push_bytes_grow(alloc, slice_u32(src, d.span.start, d.span.end));
                try out_stub.push_byte_grow(alloc, b'\n');
            }
        }
        di = di +% 1_usize;
    }
    return;
}

fn collect_unit_fn_hashes(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    arena: *ast.AstArena,
    unit_id: u32,
    mod_name: *[u8],
    interner: *mut span.SymInterner,
    out_hashes: *mut col.DynBuf[tcb_audit.Sha256Digest],
    out_map: *mut col.HashMap[u32],
) -> !OutOfMemory {
    out_hashes.clear();
    out_map.clear();
    let unit = arena.get_unit(unit_id) orelse { return; };
    let src = sm.file_text(unit.file);
    let decls = arena.decl_list_range(unit.decls);
    var di: usize = 0_usize;
    while di < decls.len {
        if let d = arena.get_decl(decls[di]) {
            if d.kind == .Fn {
                if let fn_n = arena.get_fn_decl(d.payload) {
                    let fn_sym = try mach_x64.stable_top_fn_sym_id(
                        alloc, mod_name, interner.get(fn_n.name.sym), interner,
                    );
                    let h = tcb_audit.sha256(slice_u32(src, d.span.start, d.span.end));
                    let hidx = out_hashes.len().trunc.[u32]();
                    try out_hashes.push(alloc, h);
                    try out_map.insert(alloc, fn_sym.widen.[u64](), hidx);
                }
            } else if d.kind == .Sys {
                if let sys_n = arena.get_sys_decl(d.payload) {
                    let fn_sym = try mach_x64.stable_top_fn_sym_id(
                        alloc, mod_name, interner.get(sys_n.name.sym), interner,
                    );
                    let h = tcb_audit.sha256(slice_u32(src, d.span.start, d.span.end));
                    let hidx = out_hashes.len().trunc.[u32]();
                    try out_hashes.push(alloc, h);
                    try out_map.insert(alloc, fn_sym.widen.[u64](), hidx);
                }
            } else if d.kind == .Impl {
                if let im = arena.get_impl_decl(d.payload) {
                    let sub_ids = arena.decl_list_range(im.decls);
                    var mi: usize = 0_usize;
                    while mi < sub_ids.len {
                        if let sd = arena.get_decl(sub_ids[mi]) {
                            if sd.kind == .Fn {
                                if let mfn = arena.get_fn_decl(sd.payload) {
                                    let fn_sym = try mach_x64.stable_impl_fn_sym_id(
                                        alloc,
                                        mod_name,
                                        di.trunc.[u32](),
                                        mi.trunc.[u32](),
                                        interner.get(mfn.name.sym),
                                        interner,
                                    );
                                    let h = tcb_audit.sha256(slice_u32(src, sd.span.start, sd.span.end));
                                    let hidx = out_hashes.len().trunc.[u32]();
                                    try out_hashes.push(alloc, h);
                                    try out_map.insert(alloc, fn_sym.widen.[u64](), hidx);
                                }
                            }
                        }
                        mi = mi +% 1_usize;
                    }
                }
            }
        }
        di = di +% 1_usize;
    }
    return;
}

fn format_unit_imports_nl(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    unit_id: u32,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    out.clear();
    let unit = arena.get_unit(unit_id) orelse { return; };
    var one = try str.StrBuf.init(alloc, 48_usize);
    errdefer one.destroy(alloc);
    let imps = arena.imports_range(unit.imports);
    var i: usize = 0_usize;
    while i < imps.len {
        try format_ident_range_dotted(alloc, arena, imps[i].path, interner, &mut one);
        if one.len() > 0_usize {
            if out.len() > 0_usize {
                try out.push_byte_grow(alloc, b'\n');
            }
            try out.push_bytes_grow(alloc, one.as_bytes());
        }
        i = i +% 1_usize;
    }
    one.destroy(alloc);
    return;
}

fn imports_nl_contains_mod(imports_nl: *[u8], target: *[u8]) -> bool {
    if imports_nl.len == 0_usize || target.len == 0_usize {
        return false;
    }
    var start: usize = 0_usize;
    var i: usize = 0_usize;
    while i < imports_nl.len {
        if imports_nl[i] == b'\n' {
            if i > start {
                let seg = imports_nl.sub(start, i) catch { return false; };
                if str.bytes_eq(seg, target) {
                    return true;
                }
            }
            start = i +% 1_usize;
        }
        i = i +% 1_usize;
    }
    if start < imports_nl.len {
        let seg = imports_nl.sub(start, imports_nl.len) catch { return false; };
        if str.bytes_eq(seg, target) {
            return true;
        }
    }
    return false;
}

fn unit_defines_main_fn(
    arena: *ast.AstArena,
    unit_id: u32,
    interner: *span.SymInterner,
) -> bool {
    let unit = arena.get_unit(unit_id) orelse { return false; };
    let decls = arena.decl_list_range(unit.decls);
    var di: usize = 0_usize;
    while di < decls.len {
        if let d = arena.get_decl(decls[di]) {
            if d.kind == .Fn {
                if let fn_n = arena.get_fn_decl(d.payload) {
                    if str.bytes_eq(interner.get(fn_n.name.sym), "main".as_bytes()) {
                        return true;
                    }
                }
            }
        }
        di = di +% 1_usize;
    }
    return false;
}

fn unit_has_impl_decl(arena: *ast.AstArena, unit_id: u32) -> bool {
    let unit = arena.get_unit(unit_id) orelse { return true; };
    let decls = arena.decl_list_range(unit.decls);
    var di: usize = 0_usize;
    while di < decls.len {
        if let d = arena.get_decl(decls[di]) {
            if d.kind == .Impl {
                return true;
            }
        }
        di = di +% 1_usize;
    }
    return false;
}

fn unit_has_inline_or_generic_decl(
    arena: *ast.AstArena,
    unit_id: u32,
    interner: *span.SymInterner,
) -> bool {
    let unit = arena.get_unit(unit_id) orelse { return true; };
    let decls = arena.decl_list_range(unit.decls);
    var di: usize = 0_usize;
    while di < decls.len {
        if let d = arena.get_decl(decls[di]) {
            if d.kind == .Fn {
                if let fn_n = arena.get_fn_decl(d.payload) {
                    if fn_n.is_comptime
                        || fn_n.generics.len > 0_u32
                        || decl_has_inline_attr(arena, d.attrs, interner)
                        || decl_has_inline_attr(arena, fn_n.effects, interner)
                    {
                        return true;
                    }
                }
            } else if d.kind == .Impl {
                if let im = arena.get_impl_decl(d.payload) {
                    if im.generics.len > 0_u32 {
                        return true;
                    }
                    let sub_ids = arena.decl_list_range(im.decls);
                    var mi: usize = 0_usize;
                    while mi < sub_ids.len {
                        if let sd = arena.get_decl(sub_ids[mi]) {
                            if sd.kind == .Fn {
                                if let mfn = arena.get_fn_decl(sd.payload) {
                                    if mfn.is_comptime
                                        || mfn.generics.len > 0_u32
                                        || decl_has_inline_attr(arena, sd.attrs, interner)
                                        || decl_has_inline_attr(arena, mfn.effects, interner)
                                    {
                                        return true;
                                    }
                                }
                            }
                        }
                        mi = mi +% 1_usize;
                    }
                }
            }
        }
        di = di +% 1_usize;
    }
    return false;
}

fn save_updated_emi_module(
    alloc: *mut AllocCap,
    fs: *FsCap,
    sm: *span.SourceMap,
    arena: *ast.AstArena,
    uid: u32,
    cdir_str: *str,
    mname: *[u8],
    msym: u32,
    is_full_recomp: bool,
    iface_changed: bool,
    new_iface: *[32]u8,
    opts_hash: *[32]u8,
    dirty_blobs: *mach_x64.CapturedProgramBlobs,
    fn_hashes: *mut col.DynBuf[tcb_audit.Sha256Digest],
    fn_hmap: *mut col.HashMap[u32],
    interner: *mut span.SymInterner,
) -> bool ! OutOfMemory {
    try collect_unit_fn_hashes(alloc, sm, arena, uid, mname, interner, fn_hashes, fn_hmap);
    let dbs = dirty_blobs.fns.as_slice();
    let fhs = fn_hashes.as_slice();
    if is_full_recomp {
        let unit = arena.get_unit(uid) orelse { return false; };
        var stub_buf = try str.StrBuf.init(alloc, 1024_usize);
        errdefer stub_buf.destroy(alloc);
        try extract_module_stub(alloc, sm, arena, uid, interner, &mut stub_buf);
        var mc = try emi.EmiModuleCache.init(alloc, mname);
        errdefer mc.destroy(alloc);
        mc.set_interface_hash(copy new_iface.*);
        mc.set_opts_hash(copy opts_hash.*);
        mc.set_flags(if unit.is_hal { emi.EMI_FLAG_IS_HAL } else { 0_u32 });
        try mc.set_stub_text(alloc, stub_buf.as_bytes());
        var bi: usize = 0_usize;
        while bi < dbs.len {
            let r = dbs[bi];
            if r.mod_sym == msym {
                var fh: [32]u8 = [0_u8; 32];
                if let hidx = fn_hmap.get(r.fn_sym.widen.[u64]()) {
                    let hu = hidx.widen.[usize]();
                    if hu < fhs.len {
                        fh = fhs[hu].bytes;
                    }
                }
                try mc.put_entry(alloc, r.fn_sym, fh, dirty_blobs.fn_code(bi), dirty_blobs.fn_meta(bi));
            }
            bi = bi +% 1_usize;
        }
        var ok = true;
        emi.save_emi_cache(alloc, fs, cdir_str, &mc, interner) catch {
            ok = false;
        };
        mc.destroy(alloc);
        stub_buf.destroy(alloc);
        return ok;
    }
    let mc_opt = try emi.try_load_emi_cache(alloc, fs, cdir_str, mname, interner);
    var mc = mc_opt orelse { return false; };
    errdefer mc.destroy(alloc);
    if iface_changed {
        let unit = arena.get_unit(uid) orelse {
            mc.destroy(alloc);
            return false;
        };
        var stub_buf = try str.StrBuf.init(alloc, 1024_usize);
        errdefer stub_buf.destroy(alloc);
        try extract_module_stub(alloc, sm, arena, uid, interner, &mut stub_buf);
        mc.set_interface_hash(copy new_iface.*);
        mc.set_opts_hash(copy opts_hash.*);
        mc.set_flags(if unit.is_hal { emi.EMI_FLAG_IS_HAL } else { 0_u32 });
        try mc.set_stub_text(alloc, stub_buf.as_bytes());
        stub_buf.destroy(alloc);
    }
    var bi: usize = 0_usize;
    while bi < dbs.len {
        let r = dbs[bi];
        if r.mod_sym == msym {
            var fh: [32]u8 = [0_u8; 32];
            if let hidx = fn_hmap.get(r.fn_sym.widen.[u64]()) {
                let hu = hidx.widen.[usize]();
                if hu < fhs.len {
                    fh = fhs[hu].bytes;
                }
            }
            try mc.put_entry(alloc, r.fn_sym, fh, dirty_blobs.fn_code(bi), dirty_blobs.fn_meta(bi));
        }
        bi = bi +% 1_usize;
    }
    var ok = true;
    emi.save_emi_cache(alloc, fs, cdir_str, &mc, interner) catch {
        ok = false;
    };
    mc.destroy(alloc);
    return ok;
}

fn save_full_emi_caches(
    alloc: *mut AllocCap,
    fs: *FsCap,
    sm: *span.SourceMap,
    arena: *ast.AstArena,
    unit_ids: *[u32],
    user_file_count: usize,
    interner: *mut span.SymInterner,
    copts: *mach_x64.CompileOptions,
    emi_cache_dir: *[u8],
    cap: *mach_x64.CapturedProgramBlobs,
    elf_bytes: *[u8],
) -> !OutOfMemory | Utf8Error {
    if !cap.can_inc || emi_cache_dir.len == 0_usize || user_file_count == 0_usize {
        return;
    }
    let cdir_str = try emi_cache_dir.as_str();
    let opts_hash = mach_x64.compute_opts_hash(copts);

    var manifest = try emi.IncProgramManifest.init(alloc);
    errdefer manifest.destroy(alloc);
    manifest.opts_hash = copy opts_hash;
    manifest.can_inc = true;
    let elf_sha = tcb_audit.sha256(elf_bytes);
    manifest.has_out_elf = true;
    manifest.out_elf_len = elf_bytes.len.widen.[u64]();
    manifest.out_elf_sha256 = elf_sha.bytes;
    try manifest.start_code.push_slice(alloc, cap.start_code.as_slice());
    try manifest.start_meta.push_slice(alloc, cap.start_meta.as_slice());

    var mod_buf = try str.StrBuf.init(alloc, 64_usize);
    errdefer mod_buf.destroy(alloc);
    var stub_buf = try str.StrBuf.init(alloc, 1024_usize);
    errdefer stub_buf.destroy(alloc);
    var imp_buf = try str.StrBuf.init(alloc, 128_usize);
    errdefer imp_buf.destroy(alloc);
    var fn_hashes = try col.DynBuf.[tcb_audit.Sha256Digest].init(alloc, 64_usize);
    errdefer fn_hashes.destroy(alloc);
    var fn_hmap = try col.HashMap.[u32].init(alloc, 64_usize);
    errdefer fn_hmap.destroy(alloc);

    var all_ok = true;
    let cap_fns = cap.fns.as_slice();
    var ui: usize = 0_usize;
    while ui < unit_ids.len {
        let uid = unit_ids[ui];
        let unit = arena.get_unit(uid) orelse {
            all_ok = false;
            break;
        };
        try format_ident_range_dotted(alloc, arena, unit.module_path, interner, &mut mod_buf);
        if mod_buf.len() == 0_usize {
            all_ok = false;
            break;
        }
        let mod_name = mod_buf.as_bytes();
        let mod_sym = try interner.intern(alloc, mod_name);

        try extract_module_stub(alloc, sm, arena, uid, interner, &mut stub_buf);
        let iface_digest = try emi.compute_module_hash(alloc, mod_name, stub_buf.as_bytes(), &opts_hash);
        let file_sha = tcb_audit.sha256(sm.file_text(unit.file));

        if ui < user_file_count {
            try format_unit_imports_nl(alloc, arena, uid, interner, &mut imp_buf);
            try manifest.add_file(alloc, sm.file_name(unit.file), mod_name, imp_buf.as_bytes(), file_sha.bytes, iface_digest.bytes);
        } else {
            try manifest.add_stdlib(alloc, sm.file_name(unit.file), mod_name, file_sha.bytes, iface_digest.bytes);
        }

        try collect_unit_fn_hashes(alloc, sm, arena, uid, mod_name, interner, &mut fn_hashes, &mut fn_hmap);

        var mc = try emi.EmiModuleCache.init(alloc, mod_name);
        errdefer mc.destroy(alloc);
        mc.set_interface_hash(copy iface_digest.bytes);
        mc.set_opts_hash(copy opts_hash);
        mc.set_flags(if unit.is_hal { emi.EMI_FLAG_IS_HAL } else { 0_u32 });
        try mc.set_stub_text(alloc, stub_buf.as_bytes());

        let fhs = fn_hashes.as_slice();
        var ci: usize = 0_usize;
        while ci < cap_fns.len {
            let r = cap_fns[ci];
            if r.mod_sym == mod_sym {
                var fh: [32]u8 = [0_u8; 32];
                if let hidx = fn_hmap.get(r.fn_sym.widen.[u64]()) {
                    let hu = hidx.widen.[usize]();
                    if hu < fhs.len {
                        fh = fhs[hu].bytes;
                    }
                }
                try mc.put_entry(alloc, r.fn_sym, fh, cap.fn_code(ci), cap.fn_meta(ci));
            }
            ci = ci +% 1_usize;
        }

        emi.save_emi_cache(alloc, fs, cdir_str, &mc, interner) catch {
            all_ok = false;
        };
        mc.destroy(alloc);
        if !all_ok {
            break;
        }
        ui = ui +% 1_usize;
    }

    if all_ok {
        emi.save_inc_manifest(alloc, fs, cdir_str, &manifest) catch {};
    }

    fn_hmap.destroy(alloc);
    fn_hashes.destroy(alloc);
    imp_buf.destroy(alloc);
    stub_buf.destroy(alloc);
    mod_buf.destroy(alloc);
    manifest.destroy(alloc);
    return;
}

fn mark_unchanged_fns_in_dirty_unit(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    arena: *mut ast.AstArena,
    unit_id: u32,
    mod_name: *[u8],
    cache: *emi.EmiModuleCache,
    interner: *mut span.SymInterner,
) -> !OutOfMemory {
    let unit = arena.get_unit(unit_id) orelse { return; };
    let src = sm.file_text(unit.file);

    var decl_ids = try col.DynBuf.[u32].init(alloc, 32_usize);
    errdefer decl_ids.destroy(alloc);
    try decl_ids.push_slice(alloc, arena.decl_list_range(unit.decls));

    var stub_fn_ids = try col.DynBuf.[u32].init(alloc, 32_usize);
    errdefer stub_fn_ids.destroy(alloc);

    let ds = decl_ids.as_slice();
    var di: usize = 0_usize;
    while di < ds.len {
        if let d = arena.get_decl(ds[di]) {
            if d.kind == .Fn {
                if let fn_n = arena.get_fn_decl(d.payload) {
                    let keep_full = fn_n.is_comptime
                        || fn_n.generics.len > 0_u32
                        || decl_has_inline_attr(arena, d.attrs, interner)
                        || decl_has_inline_attr(arena, fn_n.effects, interner);
                    if !keep_full {
                        let fn_sym = try mach_x64.stable_top_fn_sym_id(
                            alloc, mod_name, interner.get(fn_n.name.sym), interner,
                        );
                        let h = tcb_audit.sha256(slice_u32(src, d.span.start, d.span.end));
                        if cache.is_fn_fresh(fn_sym, &h.bytes) {
                            try stub_fn_ids.push(alloc, d.payload);
                        }
                    }
                }
            } else if d.kind == .Impl {
                if let im = arena.get_impl_decl(d.payload) {
                    if im.generics.len == 0_u32 {
                        let sub_ids = arena.decl_list_range(im.decls);
                        var mi: usize = 0_usize;
                        while mi < sub_ids.len {
                            if let sd = arena.get_decl(sub_ids[mi]) {
                                if sd.kind == .Fn {
                                    if let mfn = arena.get_fn_decl(sd.payload) {
                                        let keep_full = mfn.is_comptime
                                            || mfn.generics.len > 0_u32
                                            || decl_has_inline_attr(arena, sd.attrs, interner)
                                            || decl_has_inline_attr(arena, mfn.effects, interner);
                                        if !keep_full {
                                            let fn_sym = try mach_x64.stable_impl_fn_sym_id(
                                                alloc,
                                                mod_name,
                                                di.trunc.[u32](),
                                                mi.trunc.[u32](),
                                                interner.get(mfn.name.sym),
                                                interner,
                                            );
                                            let h = tcb_audit.sha256(slice_u32(src, sd.span.start, sd.span.end));
                                            if cache.is_fn_fresh(fn_sym, &h.bytes) {
                                                try stub_fn_ids.push(alloc, sd.payload);
                                            }
                                        }
                                    }
                                }
                            }
                            mi = mi +% 1_usize;
                        }
                    }
                }
            }
        }
        di = di +% 1_usize;
    }

    let sfs = stub_fn_ids.as_slice();
    var si: usize = 0_usize;
    while si < sfs.len {
        arena.mark_fn_emi_stub_body(sfs[si]);
        si = si +% 1_usize;
    }

    stub_fn_ids.destroy(alloc);
    decl_ids.destroy(alloc);
    return;
}

/// Compiles ONLY the non-stub functions in `unit_ids` into `out_blobs`.
/// Returns: 0 = fallback to full build, 1 = success, 2 = compile diagnostic errors (in `err_buf`).
fn inc_compile_partial_units(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    arena: *ast.AstArena,
    unit_ids: *[u32],
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    copts: *mach_x64.CompileOptions,
    out_blobs: *mut mach_x64.CapturedProgramBlobs,
    err_buf: *mut str.StrBuf,
) -> u8 ! OutOfMemory {
    var resolved = try resolve.resolve_program(alloc, arena, unit_ids, interner, diags);
    errdefer resolved.destroy(alloc);
    var tenv = try types.build_type_env(alloc, arena, &mut resolved, interner, diags);
    errdefer tenv.destroy(alloc);
    var ct = try ctvm.CtArena.init(alloc);
    errdefer ct.destroy(alloc);
    let ttable = try check.check_program_with_jobs(
        alloc, arena, unit_ids, &mut resolved, &mut tenv, &mut ct, interner, diags, copts.jobs,
    );
    errdefer ttable.destroy(alloc);

    let pre_err = diags.count();
    let cfg_prog = try cfg.lower_program_with_jobs(
        alloc, arena, unit_ids, &resolved, &mut tenv, &ct, &ttable, interner, copts.jobs,
    );
    errdefer cfg_prog.destroy(alloc);
    try borrow.analyze_program_with_jobs(alloc, &resolved, &tenv, &cfg_prog, interner, diags, copts.jobs);
    if pre_err == 0_usize {
        let eff_rep = try effects.check_effects_and_concurrency_with_jobs(
            alloc, arena, unit_ids, &resolved, &tenv, &cfg_prog, interner, diags, copts.jobs,
        );
        eff_rep.destroy(alloc);
    }
    var eir_prog = try eir.lower_cfg_to_eir_with_diags_and_jobs(
        alloc, &cfg_prog, &resolved, &tenv, interner, diags, false, copts.jobs,
    );
    errdefer eir_prog.destroy(alloc);
    if pre_err == 0_usize {
        let vr = if copts.opt.opt_level > 0_u8 {
            try verify.verify_program_with_facts_and_jobs(
                alloc, arena, &resolved, &tenv, &mut eir_prog, interner, diags, copts.jobs,
            )
        } else {
            try verify.verify_program_with_jobs(
                alloc, arena, &resolved, &tenv, &mut eir_prog, interner, diags, copts.jobs,
            )
        };
        vr.destroy(alloc);
        try eir.apply_layout_sharing(alloc, &mut eir_prog, &tenv);
        try eir_prog.release_verify_dump_meta(alloc);
    }

    if !diags.has_errors() {
        try emit_unsupported_cfg_diags(alloc, &cfg_prog, diags, "` to EIR/x86_64");
    }

    var status: u8 = 0_u8;
    if diags.has_errors() {
        err_buf.clear();
        try diags.render_all(alloc, sm, err_buf);
        status = 2_u8;
    } else {
        err_buf.clear();
        var lint_ok = try eir.eir_lint_with_jobs(alloc, &eir_prog, &tenv, err_buf, copts.jobs);
        if lint_ok && copts.opt.opt_level > 0_u8 {
            try tenv.preintern_opt_vec_tys(alloc);
            err_buf.clear();
            let _ = try eir_opt.optimize_program_with_jobs(
                alloc, &mut eir_prog, &tenv, interner, copts.opt, err_buf, copts.jobs,
            );
            if err_buf.len() > 0_usize {
                lint_ok = false;
            }
        }
        if lint_ok {
            let compiled = try mach_x64.compile_dirty_eir_to_blobs(
                alloc, sm, &mut eir_prog, &tenv, &ct, interner, copts, out_blobs,
            );
            if compiled {
                status = 1_u8;
            } else {
                status = 0_u8;
            }
        } else {
            status = 0_u8;
        }
    }

    eir_prog.destroy(alloc);
    cfg_prog.destroy(alloc);
    ttable.destroy(alloc);
    ct.destroy(alloc);
    tenv.destroy(alloc);
    resolved.destroy(alloc);
    return status;
}

fn inc_link_populate_session(
    alloc: *mut AllocCap,
    fs: *FsCap,
    cdir_str: *str,
    manifest: *emi.IncProgramManifest,
    interner: *mut span.SymInterner,
    linker: *mut mach_x64.IncLinkSession,
) -> bool ! OutOfMemory {
    let nf = manifest.files.len();
    let f_recs = manifest.files.as_slice();
    var fi: usize = 0_usize;
    while fi < nf {
        let mc_opt = try emi.try_load_emi_cache(alloc, fs, cdir_str, manifest.file_mod(fi), interner);
        let mc = mc_opt orelse { return false; };
        errdefer mc.destroy(alloc);
        if fi >= f_recs.len || !mc.interface_matches(&f_recs[fi].iface_sha256, &manifest.opts_hash) {
            mc.destroy(alloc);
            return false;
        }
        let ok_app = try linker.append_emi_cache(alloc, &mc, interner);
        mc.destroy(alloc);
        if !ok_app {
            return false;
        }
        fi = fi +% 1_usize;
    }

    let ns = manifest.stdlibs.len();
    let s_recs = manifest.stdlibs.as_slice();
    var si: usize = 0_usize;
    while si < ns {
        let mc_opt = try emi.try_load_emi_cache(alloc, fs, cdir_str, manifest.stdlib_mod(si), interner);
        let mc = mc_opt orelse { return false; };
        errdefer mc.destroy(alloc);
        if si >= s_recs.len || !mc.interface_matches(&s_recs[si].iface_sha256, &manifest.opts_hash) {
            mc.destroy(alloc);
            return false;
        }
        let ok_app = try linker.append_emi_cache(alloc, &mc, interner);
        mc.destroy(alloc);
        if !ok_app {
            return false;
        }
        si = si +% 1_usize;
    }
    return true;
}

fn check_existing_elf_fresh(
    alloc: *mut AllocCap,
    fs: *FsCap,
    out_path: *[u8],
    expected_len: u64,
    expected_sha: *[32]u8,
    out_byte_len: *mut usize,
) -> bool {
    let out_str = out_path.as_str() catch { return false; };
    if out_str.as_bytes().len == 0_usize {
        return false;
    }
    let ebuf = fs.read_file(alloc, out_str) catch { return false; };
    let ebs = ebuf.as_slice();
    var ok = false;
    if ebs.len.widen.[u64]() == expected_len {
        let existing_sha = tcb_audit.sha256(ebs);
        if emi.hash_eq(&existing_sha.bytes, expected_sha) {
            out_byte_len.* = ebs.len;
            ok = true;
        }
    }
    ebuf.destroy(alloc);
    return ok;
}

fn inc_link_all_from_manifest(
    alloc: *mut AllocCap,
    fs: *FsCap,
    cdir_str: *str,
    manifest: *emi.IncProgramManifest,
    copts: *mach_x64.CompileOptions,
    out_path: *[u8],
    interner: *mut span.SymInterner,
    out_byte_len: *mut usize,
    out_elf_sha: *mut [32]u8,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    var linker = try mach_x64.IncLinkSession.init(alloc, copts);
    let pop_ok = inc_link_populate_session(alloc, fs, cdir_str, manifest, interner, &mut linker) catch {
        linker.destroy(alloc);
        return .OutOfMemory;
    };
    if !pop_ok {
        linker.destroy(alloc);
        return false;
    }

    let link_res = try linker.finish(
        alloc,
        manifest.start_code.as_slice(),
        manifest.start_meta.as_slice(),
        interner,
    );
    errdefer link_res.destroy(alloc);
    if !link_res.ok {
        link_res.destroy(alloc);
        return false;
    }
    let elf_bs = link_res.elf.bytes.as_slice();
    out_byte_len.* = elf_bs.len;
    let wrote = try write_elf_artifact(alloc, fs, out_path, elf_bs, false, err_buf);
    if wrote {
        let esha = tcb_audit.sha256(elf_bs);
        out_elf_sha.* = esha.bytes;
    }
    link_res.destroy(alloc);
    return wrote;
}

const STUB_DIFF_PURE_ADD: u8 = 0_u8;
const STUB_DIFF_PRIV_ONLY: u8 = 1_u8;
const STUB_DIFF_FN_SYMS: u8 = 2_u8;
const STUB_DIFF_ALL: u8 = 3_u8;

struct StubEntrySpan {
    start: usize;
    end: usize;
}

struct StubFnClassify {
    is_plain_fn: bool;
    is_pub: bool;
    name_start: usize;
    name_end: usize;
}

fn is_ident_byte_stub(c: u8) -> bool {
    return (c >= b'a' && c <= b'z')
        || (c >= b'A' && c <= b'Z')
        || (c >= b'0' && c <= b'9')
        || c == b'_';
}

fn is_ws_byte_stub(c: u8) -> bool {
    return c == b' ' || c == b'\t' || c == b'\r' || c == b'\n';
}

fn stub_span_eq(a: *[u8], sa: StubEntrySpan, b: *[u8], sb: StubEntrySpan) -> bool {
    if sa.end < sa.start || sb.end < sb.start {
        return false;
    }
    let la = sa.end - sa.start;
    let lb = sb.end - sb.start;
    if la != lb || sa.end > a.len || sb.end > b.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < la {
        let ia = sa.start +% i;
        let ib = sb.start +% i;
        if ia >= a.len || ib >= b.len || a[ia] != b[ib] {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

fn split_stub_entries(
    alloc: *mut AllocCap,
    bytes: *[u8],
    out: *mut col.DynBuf[StubEntrySpan],
) -> !OutOfMemory {
    out.clear();
    var depth: i32 = 0_i32;
    var in_str = false;
    var in_chr = false;
    var in_line_cmt = false;
    var esc = false;
    var entry_start: usize = 0_usize;
    var i: usize = 0_usize;
    while i < bytes.len {
        let c = bytes[i];
        if in_line_cmt {
            if c == b'\n' {
                in_line_cmt = false;
                if depth == 0_i32 {
                    var s = entry_start;
                    var e = i;
                    while s < e && s < bytes.len && is_ws_byte_stub(bytes[s]) { s = s +% 1_usize; }
                    while e > s {
                        let e1 = e - 1_usize;
                        if e1 >= bytes.len || !is_ws_byte_stub(bytes[e1]) { break; }
                        e = e1;
                    }
                    if s < e {
                        try out.push(alloc, StubEntrySpan.{ start: s, end: e });
                    }
                    entry_start = i +% 1_usize;
                }
            }
            i = i +% 1_usize;
            continue;
        }
        if in_str {
            if esc {
                esc = false;
            } else if c == b'\\' {
                esc = true;
            } else if c == b'"' {
                in_str = false;
            }
            i = i +% 1_usize;
            continue;
        }
        if in_chr {
            if esc {
                esc = false;
            } else if c == b'\\' {
                esc = true;
            } else if c == b'\'' {
                in_chr = false;
            }
            i = i +% 1_usize;
            continue;
        }
        if c == b'/' && i +% 1_usize < bytes.len {
            let nxt = i +% 1_usize;
            if nxt < bytes.len && bytes[nxt] == b'/' {
                in_line_cmt = true;
                i = i +% 2_usize;
                continue;
            }
        }
        if c == b'"' {
            in_str = true;
        } else if c == b'\'' {
            in_chr = true;
        } else if c == b'{' {
            depth = depth +% 1_i32;
        } else if c == b'}' && depth > 0_i32 {
            depth = depth -% 1_i32;
        } else if c == b'\n' && depth == 0_i32 {
            var s = entry_start;
            var e = i;
            while s < e && s < bytes.len && is_ws_byte_stub(bytes[s]) { s = s +% 1_usize; }
            while e > s {
                let e1 = e - 1_usize;
                if e1 >= bytes.len || !is_ws_byte_stub(bytes[e1]) { break; }
                e = e1;
            }
            if s < e {
                try out.push(alloc, StubEntrySpan.{ start: s, end: e });
            }
            entry_start = i +% 1_usize;
        }
        i = i +% 1_usize;
    }
    if entry_start < bytes.len {
        var s = entry_start;
        var e = bytes.len;
        while s < e && s < bytes.len && is_ws_byte_stub(bytes[s]) { s = s +% 1_usize; }
        while e > s {
            let e1 = e - 1_usize;
            if e1 >= bytes.len || !is_ws_byte_stub(bytes[e1]) { break; }
            e = e1;
        }
        if s < e {
            try out.push(alloc, StubEntrySpan.{ start: s, end: e });
        }
    }
    return;
}

fn stub_starts_with(bytes: *[u8], pos: usize, end: usize, lit: *str) -> bool {
    let lb = lit.as_bytes();
    if pos +% lb.len > end || pos +% lb.len > bytes.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < lb.len {
        let bi = pos +% i;
        if bi >= bytes.len || bytes[bi] != lb[i] {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

/// Returns `is_plain_fn = true` ONLY for non-generic, non-comptime, non-inline, unattributed
/// top-level `fn`/`sys` declarations whose stub body is empty `{}`.
fn classify_stub_plain_fn(bytes: *[u8], sp: StubEntrySpan) -> StubFnClassify {
    let fail = StubFnClassify.{ is_plain_fn: false, is_pub: false, name_start: 0_usize, name_end: 0_usize };
    if sp.start >= sp.end || sp.end > bytes.len || sp.end - sp.start < 6_usize {
        return fail;
    }
    if bytes[sp.start] == b'@' {
        return fail;
    }
    var is_pub = false;
    var p = sp.start;
    if stub_starts_with(bytes, p, sp.end, "pub fn ") {
        is_pub = true;
        p = p +% 7_usize;
    } else if stub_starts_with(bytes, p, sp.end, "fn ") {
        is_pub = false;
        p = p +% 3_usize;
    } else if stub_starts_with(bytes, p, sp.end, "pub sys ") {
        is_pub = true;
        p = p +% 8_usize;
    } else if stub_starts_with(bytes, p, sp.end, "sys ") {
        is_pub = false;
        p = p +% 4_usize;
    } else {
        return fail;
    }
    while p < sp.end && p < bytes.len && (bytes[p] == b' ' || bytes[p] == b'\t') {
        p = p +% 1_usize;
    }
    let ns = p;
    while p < sp.end && p < bytes.len && is_ident_byte_stub(bytes[p]) {
        p = p +% 1_usize;
    }
    let ne = p;
    if ne <= ns {
        return fail;
    }
    while p < sp.end && p < bytes.len && (bytes[p] == b' ' || bytes[p] == b'\t') {
        p = p +% 1_usize;
    }
    if p >= sp.end || p >= bytes.len || bytes[p] != b'(' {
        return fail;
    }
    let b_open = sp.end - 2_usize;
    let b_close = sp.end - 1_usize;
    if b_open <= p || b_close >= bytes.len || bytes[b_open] != b'{' || bytes[b_close] != b'}' {
        return fail;
    }
    var scan = p;
    while scan < b_open && scan < bytes.len {
        if bytes[scan] == b'{' {
            return fail;
        }
        scan = scan +% 1_usize;
    }
    return StubFnClassify.{ is_plain_fn: true, is_pub: is_pub, name_start: ns, name_end: ne };
}

struct StubImplClassify {
    is_plain_impl: bool;
    hdr_start: usize;
    hdr_end: usize;
    body_start: usize;
    body_end: usize;
}

/// Classifies non-generic, non-interface `impl Type { ... }` blocks so item-level stub diffing
/// can diff individual `impl` methods without invalidating unrelated importers.
fn classify_stub_plain_impl(bytes: *[u8], sp: StubEntrySpan) -> StubImplClassify {
    let fail = StubImplClassify.{
        is_plain_impl: false,
        hdr_start: 0_usize,
        hdr_end: 0_usize,
        body_start: 0_usize,
        body_end: 0_usize,
    };
    if sp.start >= sp.end || sp.end > bytes.len || sp.end - sp.start < 8_usize {
        return fail;
    }
    if bytes[sp.start] == b'@' || !stub_starts_with(bytes, sp.start, sp.end, "impl ") {
        return fail;
    }
    let last_idx = sp.end - 1_usize;
    if last_idx >= bytes.len || bytes[last_idx] != b'}' {
        return fail;
    }
    var open_pos = sp.end;
    var p = sp.start +% 5_usize;
    while p < last_idx && p < bytes.len {
        let ch = bytes[p];
        if ch == b'[' {
            // Generic impl block: fall back conservatively.
            return fail;
        }
        if ch == b'{' {
            open_pos = p;
            break;
        }
        if ch == b'f' && stub_starts_with(bytes, p, last_idx, "for ") {
            if p > sp.start && is_ws_byte_stub(bytes[p - 1_usize]) {
                // Trait/interface impl (`impl Iface for Type`): vtable/conformance sensitive.
                return fail;
            }
        }
        p = p +% 1_usize;
    }
    if open_pos >= last_idx {
        return fail;
    }
    var hs = sp.start +% 5_usize;
    while hs < open_pos && hs < bytes.len && is_ws_byte_stub(bytes[hs]) {
        hs = hs +% 1_usize;
    }
    var he = open_pos;
    while he > hs {
        let he1 = he - 1_usize;
        if he1 >= bytes.len || !is_ws_byte_stub(bytes[he1]) {
            break;
        }
        he = he1;
    }
    if hs >= he {
        return fail;
    }
    return StubImplClassify.{
        is_plain_impl: true,
        hdr_start: hs,
        hdr_end: he,
        body_start: open_pos +% 1_usize,
        body_end: last_idx,
    };
}

fn stub_impl_hdr_eq(a: *[u8], ca: *StubImplClassify, b: *[u8], cb: *StubImplClassify) -> bool {
    return stub_span_eq(
        a,
        StubEntrySpan.{ start: ca.hdr_start, end: ca.hdr_end },
        b,
        StubEntrySpan.{ start: cb.hdr_start, end: cb.hdr_end },
    );
}

fn diff_plain_impl_methods(
    alloc: *mut AllocCap,
    old_body: *[u8],
    new_body: *[u8],
    changed_syms_nl: *mut str.StrBuf,
    any_old_changed: *mut bool,
) -> bool ! OutOfMemory {
    var old_ms = try col.DynBuf.[StubEntrySpan].init(alloc, 16_usize);
    errdefer old_ms.destroy(alloc);
    var new_ms = try col.DynBuf.[StubEntrySpan].init(alloc, 16_usize);
    errdefer new_ms.destroy(alloc);
    try split_stub_entries(alloc, old_body, &mut old_ms);
    try split_stub_entries(alloc, new_body, &mut new_ms);

    let oms = old_ms.as_slice();
    let nms = new_ms.as_slice();
    var ok = true;

    var oi: usize = 0_usize;
    while oi < oms.len && ok {
        var found = false;
        var ni: usize = 0_usize;
        while ni < nms.len {
            if stub_span_eq(old_body, oms[oi], new_body, nms[ni]) {
                found = true;
                break;
            }
            ni = ni +% 1_usize;
        }
        if !found {
            any_old_changed.* = true;
            let info = classify_stub_plain_fn(old_body, oms[oi]);
            if !info.is_plain_fn {
                ok = false;
            } else if info.is_pub && info.name_end <= old_body.len && info.name_start < info.name_end {
                let nm = old_body.sub(info.name_start, info.name_end) catch {
                    ok = false;
                    break;
                };
                try changed_syms_nl.push_bytes_grow(alloc, nm);
                try changed_syms_nl.push_byte_grow(alloc, b'\n');
            }
        }
        oi = oi +% 1_usize;
    }

    var ni2: usize = 0_usize;
    while ni2 < nms.len && ok {
        var found = false;
        var oi2: usize = 0_usize;
        while oi2 < oms.len {
            if stub_span_eq(new_body, nms[ni2], old_body, oms[oi2]) {
                found = true;
                break;
            }
            oi2 = oi2 +% 1_usize;
        }
        if !found {
            let info = classify_stub_plain_fn(new_body, nms[ni2]);
            if !info.is_plain_fn {
                ok = false;
            }
        }
        ni2 = ni2 +% 1_usize;
    }

    new_ms.destroy(alloc);
    old_ms.destroy(alloc);
    return ok;
}

fn diff_module_stubs(
    alloc: *mut AllocCap,
    old_stub: *[u8],
    new_stub: *[u8],
    changed_syms_nl: *mut str.StrBuf,
) -> u8 ! OutOfMemory {
    var old_ents = try col.DynBuf.[StubEntrySpan].init(alloc, 32_usize);
    errdefer old_ents.destroy(alloc);
    var new_ents = try col.DynBuf.[StubEntrySpan].init(alloc, 32_usize);
    errdefer new_ents.destroy(alloc);
    try split_stub_entries(alloc, old_stub, &mut old_ents);
    try split_stub_entries(alloc, new_stub, &mut new_ents);

    let oes = old_ents.as_slice();
    let nes = new_ents.as_slice();
    var matched_new = try col.DynBuf.[u8].init(alloc, nes.len +% 1_usize);
    errdefer matched_new.destroy(alloc);
    var mn_i: usize = 0_usize;
    while mn_i < nes.len {
        try matched_new.push(alloc, 0_u8);
        mn_i = mn_i +% 1_usize;
    }

    let start_sym_len = changed_syms_nl.len();
    var all_dirty = false;
    var any_old_changed = false;

    var oi: usize = 0_usize;
    while oi < oes.len && !all_dirty {
        var found = false;
        var ni: usize = 0_usize;
        while ni < nes.len {
            if stub_span_eq(old_stub, oes[oi], new_stub, nes[ni]) {
                found = true;
                let mn_m = matched_new.as_mut_slice();
                if ni < mn_m.len { mn_m[ni] = 1_u8; }
                break;
            }
            ni = ni +% 1_usize;
        }
        if !found {
            let fn_info = classify_stub_plain_fn(old_stub, oes[oi]);
            if fn_info.is_plain_fn {
                any_old_changed = true;
                if fn_info.is_pub && fn_info.name_end <= old_stub.len && fn_info.name_start < fn_info.name_end {
                    let nm = old_stub.sub(fn_info.name_start, fn_info.name_end) catch {
                        all_dirty = true;
                        break;
                    };
                    try changed_syms_nl.push_bytes_grow(alloc, nm);
                    try changed_syms_nl.push_byte_grow(alloc, b'\n');
                }
            } else {
                let imp_old = classify_stub_plain_impl(old_stub, oes[oi]);
                var paired = false;
                if imp_old.is_plain_impl {
                    var ni_m: usize = 0_usize;
                    while ni_m < nes.len {
                        let mn_ro = matched_new.as_slice();
                        if ni_m < mn_ro.len && mn_ro[ni_m] == 0_u8 {
                            let imp_new = classify_stub_plain_impl(new_stub, nes[ni_m]);
                            if imp_new.is_plain_impl && stub_impl_hdr_eq(old_stub, &imp_old, new_stub, &imp_new) {
                                let mn_m2 = matched_new.as_mut_slice();
                                if ni_m < mn_m2.len { mn_m2[ni_m] = 1_u8; }
                                let ob = old_stub.sub(imp_old.body_start, imp_old.body_end) catch {
                                    all_dirty = true;
                                    break;
                                };
                                let nb = new_stub.sub(imp_new.body_start, imp_new.body_end) catch {
                                    all_dirty = true;
                                    break;
                                };
                                let m_ok = try diff_plain_impl_methods(
                                    alloc, ob, nb, changed_syms_nl, &mut any_old_changed,
                                );
                                if !m_ok {
                                    all_dirty = true;
                                }
                                paired = true;
                                break;
                            }
                        }
                        ni_m = ni_m +% 1_usize;
                    }
                }
                if !paired {
                    any_old_changed = true;
                    all_dirty = true;
                }
            }
        }
        oi = oi +% 1_usize;
    }

    var ni2: usize = 0_usize;
    while ni2 < nes.len && !all_dirty {
        let mn_ro2 = matched_new.as_slice();
        let already = ni2 < mn_ro2.len && mn_ro2[ni2] != 0_u8;
        if !already {
            let info = classify_stub_plain_fn(new_stub, nes[ni2]);
            if !info.is_plain_fn {
                all_dirty = true;
            }
        }
        ni2 = ni2 +% 1_usize;
    }

    matched_new.destroy(alloc);
    new_ents.destroy(alloc);
    old_ents.destroy(alloc);

    if all_dirty {
        return STUB_DIFF_ALL;
    }
    if changed_syms_nl.len() == start_sym_len {
        return if !any_old_changed { STUB_DIFF_PURE_ADD } else { STUB_DIFF_PRIV_ONLY };
    }
    return STUB_DIFF_FN_SYMS;
}

fn source_mentions_any_nl_sym(src: *[u8], syms_nl: *[u8]) -> bool {
    var pos: usize = 0_usize;
    while pos < syms_nl.len {
        var end = pos;
        while end < syms_nl.len && syms_nl[end] != b'\n' {
            end = end +% 1_usize;
        }
        let slen = end - pos;
        if slen > 0_usize && slen <= src.len {
            let first_b = syms_nl[pos];
            let max_i = src.len - slen;
            var i: usize = 0_usize;
            while i <= max_i {
                if src[i] == first_b {
                    var left_ok = true;
                    if i > 0_usize {
                        left_ok = !is_ident_byte_stub(src[i - 1_usize]);
                    }
                    let right_idx = i +% slen;
                    var right_ok = true;
                    if right_idx < src.len {
                        right_ok = !is_ident_byte_stub(src[right_idx]);
                    }
                    if left_ok && right_ok {
                        var match_all = true;
                        var k: usize = 1_usize;
                        while k < slen {
                            let si = i +% k;
                            let pi = pos +% k;
                            if si >= src.len || pi >= syms_nl.len || src[si] != syms_nl[pi] {
                                match_all = false;
                                break;
                            }
                            k = k +% 1_usize;
                        }
                        if match_all {
                            return true;
                        }
                    }
                }
                i = i +% 1_usize;
            }
        }
        pos = end +% 1_usize;
    }
    return false;
}

/// Attempts a fast module+function-level incremental `.emi` rebuild.
/// Returns: 0 = fallback to full build, 1 = rebuilt cleanly, 2 = user compile error (in `err_buf`).
fn try_incremental_emi_build(
    env: *mut Env,
    user_files: *PathList,
    copts: *mach_x64.CompileOptions,
    emi_cache_dir: *[u8],
    out_path: *[u8],
    out_byte_len: *mut usize,
    err_buf: *mut str.StrBuf,
) -> u8 ! OutOfMemory | Utf8Error {
    if emi_cache_dir.len == 0_usize || user_files.len() == 0_usize {
        return 0_u8;
    }
    let cdir_str = try emi_cache_dir.as_str();
    let man_opt = try emi.try_load_inc_manifest(&mut env.alloc, &env.fs, cdir_str);
    var manifest = man_opt orelse { return 0_u8; };
    errdefer manifest.destroy(&mut env.alloc);

    let opts_hash = mach_x64.compute_opts_hash(copts);
    if !manifest.can_inc
        || !emi.hash_eq(&opts_hash, &manifest.opts_hash)
        || user_files.len() != manifest.files.len()
    {
        manifest.destroy(&mut env.alloc);
        return 0_u8;
    }

    // Check exact file list match
    let n_files = user_files.len();
    var fi: usize = 0_usize;
    while fi < n_files {
        if !str.bytes_eq(user_files.get(fi), manifest.file_path(fi)) {
            manifest.destroy(&mut env.alloc);
            return 0_u8;
        }
        fi = fi +% 1_usize;
    }

    // Verify every recorded transitive stdlib (`core.*` / `std.*`) source file still matches its SHA-256.
    // Any change, removal, or unreadable dependency safely invalidates the fast path to a full rebuild.
    let n_std = manifest.stdlibs.len();
    var si_chk: usize = 0_usize;
    while si_chk < n_std {
        let sp_bytes = manifest.stdlib_path(si_chk);
        if sp_bytes.len == 0_usize {
            manifest.destroy(&mut env.alloc);
            return 0_u8;
        }
        let sp_str = sp_bytes.as_str() catch {
            manifest.destroy(&mut env.alloc);
            return 0_u8;
        };
        let sbuf = env.fs.read_file(&mut env.alloc, sp_str) catch {
            manifest.destroy(&mut env.alloc);
            return 0_u8;
        };
        let ssha = tcb_audit.sha256(sbuf.as_slice());
        sbuf.destroy(&mut env.alloc);
        let ms_slice = manifest.stdlibs.as_slice();
        if si_chk >= ms_slice.len || !emi.hash_eq(&ssha.bytes, &ms_slice[si_chk].file_sha256) {
            manifest.destroy(&mut env.alloc);
            return 0_u8;
        }
        si_chk = si_chk +% 1_usize;
    }

    var sm = try span.SourceMap.init(&mut env.alloc);
    errdefer sm.destroy(&mut env.alloc);
    var interner = try span.SymInterner.init(&mut env.alloc);
    errdefer interner.destroy(&mut env.alloc);
    var diags = try diag.DiagBag.init(&mut env.alloc);
    errdefer diags.destroy(&mut env.alloc);
    var arena = try ast.AstArena.init(&mut env.alloc);
    errdefer arena.destroy(&mut env.alloc);
    var unit_ids = try col.DynBuf.[u32].init(&mut env.alloc, 16_usize);
    errdefer unit_ids.destroy(&mut env.alloc);

    let max_dirty: usize = if n_files > 16_usize { n_files / 2_usize } else { 8_usize };
    var dirty_idxs = try col.DynBuf.[usize].init(&mut env.alloc, 8_usize);
    errdefer dirty_idxs.destroy(&mut env.alloc);
    var dirty_shas = try col.DynBuf.[tcb_audit.Sha256Digest].init(&mut env.alloc, 8_usize);
    errdefer dirty_shas.destroy(&mut env.alloc);
    var dirty_uids = try col.DynBuf.[u32].init(&mut env.alloc, 8_usize);
    errdefer dirty_uids.destroy(&mut env.alloc);

    var scan_ok = true;
    fi = 0_usize;
    while fi < n_files {
        let p_bytes = user_files.get(fi);
        let p_str = p_bytes.as_str() catch {
            scan_ok = false;
            break;
        };
        let fbuf = env.fs.read_file(&mut env.alloc, p_str) catch {
            scan_ok = false;
            break;
        };
        let fsha = tcb_audit.sha256(fbuf.as_slice());
        let mf_slice = manifest.files.as_slice();
        var changed = true;
        if fi < mf_slice.len {
            changed = !emi.hash_eq(&fsha.bytes, &mf_slice[fi].file_sha256);
        }
        if changed {
            if dirty_idxs.len() >= max_dirty {
                fbuf.destroy(&mut env.alloc);
                scan_ok = false;
                break;
            }
            let fid = try sm.add_file_bytes(&mut env.alloc, p_bytes, fbuf.as_slice());
            let uid = try parser.parse_file(&mut env.alloc, &sm, fid, &mut interner, &mut diags, &mut arena);
            try dirty_idxs.push(&mut env.alloc, fi);
            try dirty_shas.push(&mut env.alloc, fsha);
            try dirty_uids.push(&mut env.alloc, uid);
            try unit_ids.push(&mut env.alloc, uid);
        }
        fbuf.destroy(&mut env.alloc);
        fi = fi +% 1_usize;
    }

    var result_status: u8 = 0_u8;
    if !scan_ok {
        result_status = 0_u8;
    } else if diags.has_errors() {
        err_buf.clear();
        try diags.render_all(&mut env.alloc, &sm, err_buf);
        result_status = 2_u8;
    } else if dirty_idxs.len() == 0_usize {
        var elf_fresh = false;
        if manifest.has_out_elf {
            elf_fresh = check_existing_elf_fresh(
                &mut env.alloc, &env.fs, out_path, manifest.out_elf_len, &manifest.out_elf_sha256, out_byte_len,
            );
        }
        if elf_fresh {
            result_status = 1_u8;
        } else {
            var new_elf_sha: [32]u8 = [0_u8; 32];
            let linked = try inc_link_all_from_manifest(
                &mut env.alloc, &env.fs, cdir_str, &manifest, copts, out_path, &mut interner, out_byte_len, &mut new_elf_sha, err_buf,
            );
            if linked {
                manifest.has_out_elf = true;
                manifest.out_elf_len = out_byte_len.*.widen.[u64]();
                manifest.out_elf_sha256 = new_elf_sha;
                emi.save_inc_manifest(&mut env.alloc, &env.fs, cdir_str, &manifest) catch {};
                result_status = 1_u8;
            } else {
                result_status = 0_u8;
            }
        }
    } else {
        // Early cutoff + smart transitive reverse-dependency selective rebuild on interface changes!
        var loaded_mods = try col.HashMap.[u8].init(&mut env.alloc, 32_usize);
        errdefer loaded_mods.destroy(&mut env.alloc);
        var mod_buf = try str.StrBuf.init(&mut env.alloc, 64_usize);
        errdefer mod_buf.destroy(&mut env.alloc);
        var stub_buf = try str.StrBuf.init(&mut env.alloc, 1024_usize);
        errdefer stub_buf.destroy(&mut env.alloc);
        var imp_buf = try str.StrBuf.init(&mut env.alloc, 128_usize);
        errdefer imp_buf.destroy(&mut env.alloc);
        var dirty_iface_shas = try col.DynBuf.[tcb_audit.Sha256Digest].init(&mut env.alloc, 8_usize);
        errdefer dirty_iface_shas.destroy(&mut env.alloc);
        var dirty_full_recomp = try col.DynBuf.[u8].init(&mut env.alloc, 8_usize);
        errdefer dirty_full_recomp.destroy(&mut env.alloc);
        var dirty_iface_changed = try col.DynBuf.[u8].init(&mut env.alloc, 8_usize);
        errdefer dirty_iface_changed.destroy(&mut env.alloc);
        var file_dirty_pos = try col.DynBuf.[u32].init(&mut env.alloc, n_files);
        errdefer file_dirty_pos.destroy(&mut env.alloc);
        var in_rev_q = try col.DynBuf.[u8].init(&mut env.alloc, n_files);
        errdefer in_rev_q.destroy(&mut env.alloc);
        var rev_q = try col.DynBuf.[usize].init(&mut env.alloc, 8_usize);
        errdefer rev_q.destroy(&mut env.alloc);
        var rev_q_mode = try col.DynBuf.[u8].init(&mut env.alloc, 8_usize);
        errdefer rev_q_mode.destroy(&mut env.alloc);
        var rev_q_sym_lo = try col.DynBuf.[usize].init(&mut env.alloc, 8_usize);
        errdefer rev_q_sym_lo.destroy(&mut env.alloc);
        var rev_q_sym_hi = try col.DynBuf.[usize].init(&mut env.alloc, 8_usize);
        errdefer rev_q_sym_hi.destroy(&mut env.alloc);
        var rev_syms_buf = try str.StrBuf.init(&mut env.alloc, 128_usize);
        errdefer rev_syms_buf.destroy(&mut env.alloc);

        var fi0: usize = 0_usize;
        while fi0 < n_files {
            try file_dirty_pos.push(&mut env.alloc, 0xFFFFFFFF_u32);
            try in_rev_q.push(&mut env.alloc, 0_u8);
            fi0 = fi0 +% 1_usize;
        }

        var cutoff_ok = true;
        var any_iface_changed = false;
        let init_dirty_n = dirty_idxs.len();
        var di: usize = 0_usize;
        while di < init_dirty_n {
            let didx_s = dirty_idxs.as_slice();
            let duid_s = dirty_uids.as_slice();
            if di >= didx_s.len || di >= duid_s.len {
                break;
            }
            let fidx = didx_s[di];
            let uid = duid_s[di];
            let fdp_m = file_dirty_pos.as_mut_slice();
            if fidx < fdp_m.len {
                fdp_m[fidx] = di.trunc.[u32]();
            }
            let unit = arena.get_unit(uid) orelse {
                cutoff_ok = false;
                break;
            };
            try format_ident_range_dotted(&mut env.alloc, &arena, unit.module_path, &interner, &mut mod_buf);
            if !str.bytes_eq(mod_buf.as_bytes(), manifest.file_mod(fidx)) {
                cutoff_ok = false;
                break;
            }
            try extract_module_stub(&mut env.alloc, &sm, &arena, uid, &interner, &mut stub_buf);
            let iface_d = try emi.compute_module_hash(&mut env.alloc, mod_buf.as_bytes(), stub_buf.as_bytes(), &opts_hash);
            let mf_s = manifest.files.as_slice();
            let iface_same = fidx < mf_s.len && emi.hash_eq(&iface_d.bytes, &mf_s[fidx].iface_sha256);
            try dirty_iface_shas.push(&mut env.alloc, iface_d);
            if iface_same {
                try dirty_full_recomp.push(&mut env.alloc, 0_u8);
                try dirty_iface_changed.push(&mut env.alloc, 0_u8);
            } else {
                // If `fn main`'s module changed interface, fall back so `_start` regenerates cleanly.
                if unit_defines_main_fn(&arena, uid, &interner) {
                    cutoff_ok = false;
                    break;
                }
                // Fine-grained item-level interface diff cutoff:
                // - Purely additive plain `pub fn`/`pub sys`: 0 importers invalidated + fn-level cutoff inside dirty mod (when no impl decls)!
                // - Private-only fn sig edit: 0 importers invalidated (full recomp of dirty mod only).
                // - Modified/removed plain `pub fn`/`pub sys`: only importers mentioning changed symbol names!
                // - Struct/enum/pool/type/const/impl/generic/@inline changes: conservative full transitive BFS.
                var diff_kind: u8 = STUB_DIFF_ALL;
                let sym_lo = rev_syms_buf.len();
                if let old_emi = try emi.try_load_emi_cache(
                    &mut env.alloc, &env.fs, cdir_str, manifest.file_mod(fidx), &mut interner,
                ) {
                    errdefer old_emi.destroy(&mut env.alloc);
                    diff_kind = try diff_module_stubs(
                        &mut env.alloc, old_emi.stub_text.as_bytes(), stub_buf.as_bytes(), &mut rev_syms_buf,
                    );
                    old_emi.destroy(&mut env.alloc);
                }
                let sym_hi = rev_syms_buf.len();
                let can_fn_cutoff = diff_kind == STUB_DIFF_PURE_ADD && !unit_has_impl_decl(&arena, uid);
                try dirty_full_recomp.push(&mut env.alloc, if can_fn_cutoff { 0_u8 } else { 1_u8 });
                try dirty_iface_changed.push(&mut env.alloc, 1_u8);
                if diff_kind != STUB_DIFF_PURE_ADD && diff_kind != STUB_DIFF_PRIV_ONLY {
                    any_iface_changed = true;
                    let irq_m = in_rev_q.as_mut_slice();
                    if fidx < irq_m.len && irq_m[fidx] == 0_u8 {
                        irq_m[fidx] = 1_u8;
                        try rev_q.push(&mut env.alloc, fidx);
                        try rev_q_mode.push(&mut env.alloc, diff_kind);
                        try rev_q_sym_lo.push(&mut env.alloc, sym_lo);
                        try rev_q_sym_hi.push(&mut env.alloc, sym_hi);
                    }
                }
            }
            let msym = try interner.intern(&mut env.alloc, mod_buf.as_bytes());
            try loaded_mods.insert(&mut env.alloc, msym.widen.[u64](), 1_u8);
            di = di +% 1_usize;
        }

        // BFS transitive reverse-import closure whenever any dirty file's interface changed!
        var rev_parse_err = false;
        if cutoff_ok && any_iface_changed {
            var rqi: usize = 0_usize;
            while rqi < rev_q.len() && cutoff_ok && !rev_parse_err {
                let rq_s = rev_q.as_slice();
                let rqm_s = rev_q_mode.as_slice();
                let rqlo_s = rev_q_sym_lo.as_slice();
                let rqhi_s = rev_q_sym_hi.as_slice();
                if rqi >= rq_s.len || rqi >= rqm_s.len || rqi >= rqlo_s.len || rqi >= rqhi_s.len {
                    break;
                }
                let src_fidx = rq_s[rqi];
                let src_mode = rqm_s[rqi];
                let sym_lo = rqlo_s[rqi];
                let sym_hi = rqhi_s[rqi];
                rqi = rqi +% 1_usize;
                let src_mod = manifest.file_mod(src_fidx);
                var cand_fi: usize = 0_usize;
                while cand_fi < n_files && cutoff_ok && !rev_parse_err {
                    if imports_nl_contains_mod(manifest.file_imports(cand_fi), src_mod) {
                        let fdp_ro = file_dirty_pos.as_slice();
                        let existing_pos = if cand_fi < fdp_ro.len { fdp_ro[cand_fi] } else { 0xFFFFFFFF_u32 };
                        if existing_pos != 0xFFFFFFFF_u32 {
                            let dfr_m = dirty_full_recomp.as_mut_slice();
                            let epu = existing_pos.widen.[usize]();
                            if epu < dfr_m.len {
                                dfr_m[epu] = 1_u8;
                            }
                            let duid_ro = dirty_uids.as_slice();
                            let need_prop = src_mode == STUB_DIFF_ALL
                                || (epu < duid_ro.len && unit_has_inline_or_generic_decl(&arena, duid_ro[epu], &interner));
                            if need_prop {
                                let irq_m = in_rev_q.as_mut_slice();
                                if cand_fi < irq_m.len && irq_m[cand_fi] == 0_u8 {
                                    irq_m[cand_fi] = 1_u8;
                                    try rev_q.push(&mut env.alloc, cand_fi);
                                    try rev_q_mode.push(&mut env.alloc, STUB_DIFF_ALL);
                                    try rev_q_sym_lo.push(&mut env.alloc, 0_usize);
                                    try rev_q_sym_hi.push(&mut env.alloc, 0_usize);
                                }
                            }
                        } else {
                            let cp_bytes = user_files.get(cand_fi);
                            let cp_str = cp_bytes.as_str() catch {
                                cutoff_ok = false;
                                break;
                            };
                            let cfbuf = env.fs.read_file(&mut env.alloc, cp_str) catch {
                                cutoff_ok = false;
                                break;
                            };
                            if src_mode == STUB_DIFF_FN_SYMS {
                                let all_syms = rev_syms_buf.as_bytes();
                                var mentions_changed = true;
                                if sym_lo <= sym_hi && sym_hi <= all_syms.len {
                                    let sym_slice = all_syms.sub(sym_lo, sym_hi) catch {
                                        cfbuf.destroy(&mut env.alloc);
                                        cutoff_ok = false;
                                        break;
                                    };
                                    mentions_changed = source_mentions_any_nl_sym(cfbuf.as_slice(), sym_slice);
                                }
                                if !mentions_changed {
                                    cfbuf.destroy(&mut env.alloc);
                                    cand_fi = cand_fi +% 1_usize;
                                    continue;
                                }
                            }
                            if dirty_idxs.len() >= max_dirty {
                                cfbuf.destroy(&mut env.alloc);
                                cutoff_ok = false;
                                break;
                            }
                            let cfsha = tcb_audit.sha256(cfbuf.as_slice());
                            let cfid = sm.add_file_bytes(&mut env.alloc, cp_bytes, cfbuf.as_slice()) catch {
                                cfbuf.destroy(&mut env.alloc);
                                return .OutOfMemory;
                            };
                            cfbuf.destroy(&mut env.alloc);
                            let cuid = try parser.parse_file(&mut env.alloc, &sm, cfid, &mut interner, &mut diags, &mut arena);
                            if diags.has_errors() {
                                rev_parse_err = true;
                                break;
                            }
                            let cunit = arena.get_unit(cuid) orelse {
                                cutoff_ok = false;
                                break;
                            };
                            try format_ident_range_dotted(&mut env.alloc, &arena, cunit.module_path, &interner, &mut mod_buf);
                            if !str.bytes_eq(mod_buf.as_bytes(), manifest.file_mod(cand_fi)) {
                                cutoff_ok = false;
                                break;
                            }
                            try extract_module_stub(&mut env.alloc, &sm, &arena, cuid, &interner, &mut stub_buf);
                            let ciface_d = try emi.compute_module_hash(&mut env.alloc, mod_buf.as_bytes(), stub_buf.as_bytes(), &opts_hash);
                            let new_pos = dirty_idxs.len().trunc.[u32]();
                            try dirty_idxs.push(&mut env.alloc, cand_fi);
                            try dirty_shas.push(&mut env.alloc, cfsha);
                            try dirty_uids.push(&mut env.alloc, cuid);
                            try dirty_iface_shas.push(&mut env.alloc, ciface_d);
                            try dirty_full_recomp.push(&mut env.alloc, 1_u8);
                            try dirty_iface_changed.push(&mut env.alloc, 1_u8);
                            try unit_ids.push(&mut env.alloc, cuid);
                            let fdp_m2 = file_dirty_pos.as_mut_slice();
                            if cand_fi < fdp_m2.len {
                                fdp_m2[cand_fi] = new_pos;
                            }
                            let cmsym = try interner.intern(&mut env.alloc, mod_buf.as_bytes());
                            try loaded_mods.insert(&mut env.alloc, cmsym.widen.[u64](), 1_u8);
                            if src_mode == STUB_DIFF_ALL || unit_has_inline_or_generic_decl(&arena, cuid, &interner) {
                                let irq_m2 = in_rev_q.as_mut_slice();
                                if cand_fi < irq_m2.len && irq_m2[cand_fi] == 0_u8 {
                                    irq_m2[cand_fi] = 1_u8;
                                    try rev_q.push(&mut env.alloc, cand_fi);
                                    try rev_q_mode.push(&mut env.alloc, STUB_DIFF_ALL);
                                    try rev_q_sym_lo.push(&mut env.alloc, 0_usize);
                                    try rev_q_sym_hi.push(&mut env.alloc, 0_usize);
                                }
                            }
                        }
                    }
                    cand_fi = cand_fi +% 1_usize;
                }
            }
        }

        // Apply function-level early cutoff ONLY to body-only dirty modules (full-recomp modules compile all fns!)
        if rev_parse_err {
            err_buf.clear();
            try diags.render_all(&mut env.alloc, &sm, err_buf);
            result_status = 2_u8;
            cutoff_ok = false;
        } else if cutoff_ok {
            let didx_s = dirty_idxs.as_slice();
            let duid_s = dirty_uids.as_slice();
            let dfr_s = dirty_full_recomp.as_slice();
            var dsi: usize = 0_usize;
            while dsi < didx_s.len && dsi < duid_s.len && dsi < dfr_s.len {
                if dfr_s[dsi] == 0_u8 {
                    let fidx = didx_s[dsi];
                    let uid = duid_s[dsi];
                    let mname = manifest.file_mod(fidx);
                    let dc_opt = try emi.try_load_emi_cache(&mut env.alloc, &env.fs, cdir_str, mname, &mut interner);
                    let dc = dc_opt orelse {
                        cutoff_ok = false;
                        break;
                    };
                    errdefer dc.destroy(&mut env.alloc);
                    try mark_unchanged_fns_in_dirty_unit(
                        &mut env.alloc, &sm, &mut arena, uid, mname, &dc, &mut interner,
                    );
                    dc.destroy(&mut env.alloc);
                }
                dsi = dsi +% 1_usize;
            }
        }

        // BFS transitive imported stubs from `.emi` files
        if cutoff_ok {
            var vpath = try str.StrBuf.init(&mut env.alloc, 96_usize);
            errdefer vpath.destroy(&mut env.alloc);
            var scan_i: usize = 0_usize;
            while scan_i < unit_ids.len() && cutoff_ok {
                let u_s = unit_ids.as_slice();
                if scan_i >= u_s.len {
                    break;
                }
                let cur_uid = u_s[scan_i];
                scan_i = scan_i +% 1_usize;
                var imp_ranges = try col.DynBuf.[ast.IdRange].init(&mut env.alloc, 8_usize);
                errdefer imp_ranges.destroy(&mut env.alloc);
                if let u = arena.get_unit(cur_uid) {
                    let imps = arena.imports_range(u.imports);
                    var k: usize = 0_usize;
                    while k < imps.len {
                        try imp_ranges.push(&mut env.alloc, imps[k].path);
                        k = k +% 1_usize;
                    }
                }
                let irs = imp_ranges.as_slice();
                var k: usize = 0_usize;
                while k < irs.len {
                    try format_ident_range_dotted(&mut env.alloc, &arena, irs[k], &interner, &mut mod_buf);
                    if mod_buf.len() > 0_usize {
                        let isym = try interner.intern(&mut env.alloc, mod_buf.as_bytes());
                        if !loaded_mods.contains(isym.widen.[u64]()) {
                            try loaded_mods.insert(&mut env.alloc, isym.widen.[u64](), 1_u8);
                            var sfid: u32 = 0_u32;
                            var loaded_stub_ok = false;
                            if let sc = try emi.try_load_emi_cache(
                                &mut env.alloc, &env.fs, cdir_str, mod_buf.as_bytes(), &mut interner,
                            ) {
                                errdefer sc.destroy(&mut env.alloc);
                                vpath.clear();
                                try vpath.push_str_grow(&mut env.alloc, "<emi>/");
                                try vpath.push_bytes_grow(&mut env.alloc, mod_buf.as_bytes());
                                if (sc.flags & emi.EMI_FLAG_IS_HAL) != 0_u32 {
                                    try vpath.push_str_grow(&mut env.alloc, ".hal.eon");
                                } else {
                                    try vpath.push_str_grow(&mut env.alloc, ".eon");
                                }
                                sfid = try sm.add_file_bytes(&mut env.alloc, vpath.as_bytes(), sc.stub_text.as_bytes());
                                sc.destroy(&mut env.alloc);
                                loaded_stub_ok = true;
                            }
                            if !loaded_stub_ok {
                                cutoff_ok = false;
                                break;
                            }
                            let suid = try parser.parse_file(
                                &mut env.alloc, &sm, sfid, &mut interner, &mut diags, &mut arena,
                            );
                            if diags.has_errors() {
                                cutoff_ok = false;
                                break;
                            }
                            arena.mark_unit_emi_stub(suid);
                            try unit_ids.push(&mut env.alloc, suid);
                        }
                    }
                    k = k +% 1_usize;
                }
                imp_ranges.destroy(&mut env.alloc);
            }
            vpath.destroy(&mut env.alloc);
        }

        if cutoff_ok {
            var dirty_blobs = try mach_x64.CapturedProgramBlobs.init(&mut env.alloc);
            errdefer dirty_blobs.destroy(&mut env.alloc);
            let comp_st = try inc_compile_partial_units(
                &mut env.alloc,
                &sm,
                &arena,
                unit_ids.as_slice(),
                &mut interner,
                &mut diags,
                copts,
                &mut dirty_blobs,
                err_buf,
            );
            if comp_st == 2_u8 {
                result_status = 2_u8;
            } else if comp_st == 1_u8 {
                // Update dirty & affected modules' `.emi` caches & manifest, then link all cached `.emi`s!
                var fn_hashes = try col.DynBuf.[tcb_audit.Sha256Digest].init(&mut env.alloc, 64_usize);
                errdefer fn_hashes.destroy(&mut env.alloc);
                var fn_hmap = try col.HashMap.[u32].init(&mut env.alloc, 64_usize);
                errdefer fn_hmap.destroy(&mut env.alloc);

                var upd_ok = true;
                let didx_s2 = dirty_idxs.as_slice();
                let duid_s2 = dirty_uids.as_slice();
                let dsha_s2 = dirty_shas.as_slice();
                let diface_s2 = dirty_iface_shas.as_slice();
                let dfr_s2 = dirty_full_recomp.as_slice();
                let dichg_s2 = dirty_iface_changed.as_slice();
                var dki: usize = 0_usize;
                while dki < didx_s2.len && dki < duid_s2.len && dki < dsha_s2.len && dki < diface_s2.len && dki < dfr_s2.len && dki < dichg_s2.len {
                    let fidx = didx_s2[dki];
                    let uid = duid_s2[dki];
                    let new_fsha = dsha_s2[dki];
                    let new_iface = diface_s2[dki];
                    let is_full = dfr_s2[dki] != 0_u8;
                    let iface_chg = dichg_s2[dki] != 0_u8;
                    let mname = manifest.file_mod(fidx);
                    let msym = try interner.intern(&mut env.alloc, mname);
                    upd_ok = try save_updated_emi_module(
                        &mut env.alloc,
                        &env.fs,
                        &sm,
                        &arena,
                        uid,
                        cdir_str,
                        mname,
                        msym,
                        is_full,
                        iface_chg,
                        &new_iface.bytes,
                        &opts_hash,
                        &dirty_blobs,
                        &mut fn_hashes,
                        &mut fn_hmap,
                        &mut interner,
                    );
                    if !upd_ok {
                        break;
                    }
                    if is_full || iface_chg {
                        try format_unit_imports_nl(&mut env.alloc, &arena, uid, &interner, &mut imp_buf);
                        try manifest.set_file_hashes_and_imports(
                            &mut env.alloc, fidx, copy new_fsha.bytes, copy new_iface.bytes, imp_buf.as_bytes(),
                        );
                    } else {
                        var old_iface: [32]u8 = [0_u8; 32];
                        let mf_s2 = manifest.files.as_slice();
                        if fidx < mf_s2.len {
                            old_iface = copy mf_s2[fidx].iface_sha256;
                        }
                        manifest.set_file_hashes(fidx, copy new_fsha.bytes, old_iface);
                    }
                    dki = dki +% 1_usize;
                }

                if upd_ok {
                    var new_elf_sha: [32]u8 = [0_u8; 32];
                    let linked = try inc_link_all_from_manifest(
                        &mut env.alloc,
                        &env.fs,
                        cdir_str,
                        &manifest,
                        copts,
                        out_path,
                        &mut interner,
                        out_byte_len,
                        &mut new_elf_sha,
                        err_buf,
                    );
                    if linked {
                        manifest.has_out_elf = true;
                        manifest.out_elf_len = out_byte_len.*.widen.[u64]();
                        manifest.out_elf_sha256 = new_elf_sha;
                        emi.save_inc_manifest(&mut env.alloc, &env.fs, cdir_str, &manifest) catch {};
                        result_status = 1_u8;
                    } else {
                        result_status = 0_u8;
                    }
                } else {
                    result_status = 0_u8;
                }
                fn_hmap.destroy(&mut env.alloc);
                fn_hashes.destroy(&mut env.alloc);
            } else {
                result_status = 0_u8;
            }
            dirty_blobs.destroy(&mut env.alloc);
        }

        rev_syms_buf.destroy(&mut env.alloc);
        rev_q_sym_hi.destroy(&mut env.alloc);
        rev_q_sym_lo.destroy(&mut env.alloc);
        rev_q_mode.destroy(&mut env.alloc);
        rev_q.destroy(&mut env.alloc);
        in_rev_q.destroy(&mut env.alloc);
        file_dirty_pos.destroy(&mut env.alloc);
        dirty_iface_changed.destroy(&mut env.alloc);
        dirty_full_recomp.destroy(&mut env.alloc);
        dirty_iface_shas.destroy(&mut env.alloc);
        imp_buf.destroy(&mut env.alloc);
        stub_buf.destroy(&mut env.alloc);
        mod_buf.destroy(&mut env.alloc);
        loaded_mods.destroy(&mut env.alloc);
    }

    dirty_uids.destroy(&mut env.alloc);
    dirty_shas.destroy(&mut env.alloc);
    dirty_idxs.destroy(&mut env.alloc);
    unit_ids.destroy(&mut env.alloc);
    arena.destroy(&mut env.alloc);
    diags.destroy(&mut env.alloc);
    interner.destroy(&mut env.alloc);
    sm.destroy(&mut env.alloc);
    manifest.destroy(&mut env.alloc);
    return result_status;
}

fn stream_check_and_lower_batches(
    alloc: *mut AllocCap,
    clock: *ClockCap,
    arena: *ast.AstArena,
    unit_ids: *[u32],
    resolved: *mut resolve.ResolvedProgram,
    tenv: *mut types.TypeEnv,
    ct: *mut ctvm.CtArena,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    profile_phases: bool,
    jobs: u32,
    cfg_prog: *mut cfg_ir.CfgProgram,
    eir_prog: *mut eir.EirProgram,
    eff_stream: *mut effects.EffectsStream,
    unsup_diags: *mut diag.DiagBag,
    out_pre_err: *mut usize,
) -> !OutOfMemory {
    var t0 = if profile_phases { rt.now_ns(clock) } else { 0_u64 };
    var u0 = if profile_phases { alloc.used_bytes() } else { 0_usize };
    let ttable = try check.check_program_with_jobs(
        alloc, arena, unit_ids, resolved, tenv, ct, interner, diags, jobs,
    );
    errdefer ttable.destroy(alloc);
    if profile_phases { try print_phase_line(alloc, clock, "check", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }

    out_pre_err.* = diags.count();
    try eir.populate_eir_extern_fns(alloc, resolved, eir_prog);

    var sess = try cfg.CfgStreamSession.init(alloc, arena, resolved, tenv, cfg_prog, &ttable, jobs);
    errdefer sess.destroy(alloc);
    while true {
        let br_opt = try sess.next_batch(
            alloc, arena, resolved, tenv, cfg_prog, ct, &ttable, interner, 32_usize,
        );
        let br = br_opt orelse { break; };
        try borrow.analyze_fn_range_with_jobs(
            alloc, resolved, tenv, cfg_prog, br.start, br.end, interner, diags, jobs,
        );
        if out_pre_err.* == 0_usize {
            try eff_stream.collect_range_with_jobs(
                alloc, cfg_prog, tenv, br.start, br.end, jobs,
            );
        }
        try eir.lower_cfg_fn_range_with_jobs(
            alloc, cfg_prog, resolved, tenv, br.start, br.end, eir_prog, diags, false, jobs,
        );
        try emit_unsupported_cfg_diags_range(
            alloc, cfg_prog, br.start, br.end, unsup_diags, "` to EIR/x86_64",
        );
        try cfg_prog.release_body_pools(alloc);
    }
    if profile_phases { try print_phase_line(alloc, clock, "cfg+borrow+eir", t0, u0); }
    sess.destroy(alloc);
    ttable.destroy(alloc);
    return;
}

fn build_lower_to_eir_stage(
    alloc: *mut AllocCap,
    clock: *ClockCap,
    arena: *mut ast.AstArena,
    can_free_arena: bool,
    unit_ids: *[u32],
    resolved: *mut resolve.ResolvedProgram,
    tenv: *mut types.TypeEnv,
    ct: *mut ctvm.CtArena,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    profile_phases: bool,
    jobs: u32,
    out_pre_err: *mut usize,
) -> eir.EirProgram ! OutOfMemory {
    var cfg_prog = try cfg_ir.CfgProgram.init(alloc);
    errdefer cfg_prog.destroy(alloc);
    var eir_prog = try eir.EirProgram.init(alloc);
    errdefer eir_prog.destroy(alloc);
    var eff_stream = try effects.EffectsStream.init(alloc);
    errdefer eff_stream.destroy(alloc);
    var unsup_diags = try diag.DiagBag.init(alloc);
    errdefer unsup_diags.destroy(alloc);

    try stream_check_and_lower_batches(
        alloc, clock, arena, unit_ids, resolved, tenv, ct, interner, diags, profile_phases, jobs,
        &mut cfg_prog, &mut eir_prog, &mut eff_stream, &mut unsup_diags, out_pre_err,
    );

    let t0 = if profile_phases { rt.now_ns(clock) } else { 0_u64 };
    let u0 = if profile_phases { alloc.used_bytes() } else { 0_usize };
    if out_pre_err.* == 0_usize {
        let eff_rep = try eff_stream.finalize(
            alloc, arena, resolved, tenv, &cfg_prog, interner, diags, jobs,
        );
        eff_rep.destroy(alloc);
    }
    if can_free_arena {
        try arena.release_non_expr_pools(alloc);
    }
    if !diags.has_errors() && unsup_diags.count() > 0_usize {
        try diags.append_diag_range(alloc, &unsup_diags, 0_u32, unsup_diags.count().trunc.[u32]());
    }
    try eir.copy_cfg_metadata_to_eir(alloc, &cfg_prog, &mut eir_prog);
    if profile_phases { try print_phase_line(alloc, clock, "effects_final", t0, u0); }
    unsup_diags.destroy(alloc);
    eff_stream.destroy(alloc);
    cfg_prog.destroy(alloc);
    return eir_prog;
}

fn compile_loaded_to_elf_file(
    alloc: *mut AllocCap,
    clock: *ClockCap,
    fs: *FsCap,
    sm: *span.SourceMap,
    arena: *mut ast.AstArena,
    can_free_arena: bool,
    unit_ids: *[u32],
    user_file_count: usize,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    copts: *mach_x64.CompileOptions,
    needed_libs: *PathList,
    emi_cache_dir: *[u8],
    out_path: *[u8],
    is_shared: bool,
    print_opt_stats: bool,
    profile_phases: bool,
    jobs: u32,
    out_byte_len: *mut usize,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    var t0 = if profile_phases { rt.now_ns(clock) } else { 0_u64 };
    var u0 = if profile_phases { alloc.used_bytes() } else { 0_usize };
    var resolved = try resolve.resolve_program(alloc, arena, unit_ids, interner, diags);
    errdefer resolved.destroy(alloc);
    if profile_phases { try print_phase_line(alloc, clock, "resolve", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }

    var tenv = try types.build_type_env(alloc, arena, &mut resolved, interner, diags);
    errdefer tenv.destroy(alloc);
    tenv.set_target(copts.target_spec);
    if profile_phases { try print_phase_line(alloc, clock, "types", t0, u0); }

    var ct = try ctvm.CtArena.init(alloc);
    errdefer ct.destroy(alloc);
    var pre_err: usize = 0_usize;
    var eir_prog = try build_lower_to_eir_stage(
        alloc, clock, arena, can_free_arena, unit_ids, &mut resolved, &mut tenv, &mut ct, interner, diags, profile_phases, jobs, &mut pre_err,
    );
    errdefer eir_prog.destroy(alloc);
    if can_free_arena && !eir_prog.has_any_contracts() {
        try arena.release_all_pools(alloc);
    }
    if profile_phases { t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }

    if pre_err == 0_usize && !diags.has_errors() {
        let vr = if copts.opt.opt_level > 0_u8 {
            try verify.verify_program_with_facts_and_jobs(
                alloc, arena, &resolved, &tenv, &mut eir_prog, interner, diags, jobs,
            )
        } else {
            try verify.verify_program_with_jobs(
                alloc, arena, &resolved, &tenv, &mut eir_prog, interner, diags, jobs,
            )
        };
        let vp = vr.prof;
        vr.destroy(alloc);
        if profile_phases {
            try print_phase_line(alloc, clock, "verify", t0, u0);
            var vp_buf = try str.StrBuf.init(alloc, 256_usize);
            errdefer vp_buf.destroy(alloc);
            try verify.format_verify_prof(alloc, &vp, &eir_prog, interner, &mut vp_buf);
            rt.eprint_bytes(vp_buf.as_bytes());
            vp_buf.destroy(alloc);
            t0 = rt.now_ns(clock);
            u0 = alloc.used_bytes();
        }
        try eir.apply_layout_sharing(alloc, &mut eir_prog, &tenv);
        try eir_prog.release_verify_dump_meta(alloc);
    }
    if can_free_arena {
        try arena.release_all_pools(alloc);
    }

    var ok = false;
    if diags.has_errors() {
        err_buf.clear();
        try diags.render_all(alloc, sm, err_buf);
    } else {
        err_buf.clear();
        var lint_ok = try eir.eir_lint_with_jobs(alloc, &eir_prog, &tenv, err_buf, jobs);
        if profile_phases { try print_phase_line(alloc, clock, "eir_lint", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }
        if lint_ok && copts.opt.opt_level > 0_u8 {
            try tenv.preintern_opt_vec_tys(alloc);
            err_buf.clear();
            let stats = try eir_opt.optimize_program_profiled_with_jobs(
                alloc, clock, profile_phases, &mut eir_prog, &tenv, interner, copts.opt, err_buf, jobs,
            );
            try eir_prog.release_value_facts(alloc);
            if profile_phases { try print_phase_line(alloc, clock, "eir_opt", t0, u0); t0 = rt.now_ns(clock); u0 = alloc.used_bytes(); }
            if err_buf.len() > 0_usize {
                lint_ok = false;
            } else if print_opt_stats {
                try print_opt_stats_line(alloc, &stats);
            }
        }
        if lint_ok {
            var lib_syms = try col.DynBuf.[u32].init(alloc, 4_usize);
            errdefer lib_syms.destroy(alloc);
            var li: usize = 0_usize;
            while li < needed_libs.len() {
                let sym = try interner.intern(alloc, needed_libs.get(li));
                try lib_syms.push(alloc, sym);
                li = li +% 1_usize;
            }

            let res = if copts.target_spec.arch == .AArch64 {
                try mach_a64.compile_and_link_a64(
                    alloc, sm, &mut eir_prog, &resolved, &tenv, &ct, interner, copts, lib_syms.as_slice(),
                )
            } else if copts.target_spec.arch == .RiscV64 {
                try mach_rv64.compile_and_link_rv64(
                    alloc, sm, &mut eir_prog, &resolved, &tenv, &ct, interner, copts, lib_syms.as_slice(),
                )
            } else if copts.has_emi_cache && emi_cache_dir.len > 0_usize && user_file_count > 0_usize {
                var cap = try mach_x64.CapturedProgramBlobs.init(alloc);
                errdefer cap.destroy(alloc);
                let cr = try mach_x64.compile_and_link_x64_capture(
                    alloc, sm, &mut eir_prog, &resolved, &tenv, &ct, interner, copts, lib_syms.as_slice(), &mut cap,
                );
                errdefer cr.destroy(alloc);
                if cr.ok && cap.can_inc {
                    try save_full_emi_caches(
                        alloc, fs, sm, arena, unit_ids, user_file_count, interner, copts, emi_cache_dir, &cap, cr.elf.bytes.as_slice(),
                    );
                }
                cap.destroy(alloc);
                cr
            } else if copts.has_emi_cache && emi_cache_dir.len > 0_usize {
                let cdir_str = try emi_cache_dir.as_str();
                let cmod = "_program".as_bytes();
                let loaded_opt = try emi.try_load_emi_cache(alloc, fs, cdir_str, cmod, interner);
                var cache = if let c = loaded_opt {
                    c
                } else {
                    try emi.EmiModuleCache.init(alloc, cmod)
                };
                errdefer cache.destroy(alloc);
                let cr = try mach_x64.compile_and_link_x64_with_cache(
                    alloc, sm, &mut eir_prog, &resolved, &tenv, &ct, interner, copts, lib_syms.as_slice(), &mut cache,
                );
                errdefer cr.destroy(alloc);
                if cr.ok && cache.dirty {
                    emi.save_emi_cache(alloc, fs, cdir_str, &cache, interner) catch {};
                }
                cache.destroy(alloc);
                cr
            } else {
                try mach_x64.compile_and_link_x64(
                    alloc, sm, &mut eir_prog, &resolved, &tenv, &ct, interner, copts, lib_syms.as_slice(),
                )
            };
            errdefer res.destroy(alloc);
            if profile_phases { try print_phase_line(alloc, clock, "mach_x64+link", t0, u0); }

            if !res.ok {
                err_buf.clear();
                try err_buf.push_bytes_grow(alloc, res.err_msg.as_bytes());
                if !ends_with_nl(err_buf.as_bytes()) {
                    try err_buf.push_byte_grow(alloc, b'\n');
                }
            } else {
                let elf_bs = res.elf.bytes.as_slice();
                if copts.target_spec.os == .Android && str.ends_with(out_path, ".apk".as_bytes()) {
                    let apk_res = try apk_pkg.package_android_apk(
                        alloc, elf_bs, copts.target_spec.arch, "org.eon.app", "EonApp",
                    );
                    errdefer apk_res.destroy(alloc);
                    if !apk_res.ok {
                        err_buf.clear();
                        try err_buf.push_bytes_grow(alloc, apk_res.err_msg.as_bytes());
                        ok = false;
                    } else {
                        let apk_bs = apk_res.elf.bytes.as_slice();
                        out_byte_len.* = apk_bs.len;
                        ok = try write_elf_artifact(alloc, fs, out_path, apk_bs, true, err_buf);
                    }
                    apk_res.destroy(alloc);
                } else if copts.target_spec.is_darwin() && str.ends_with(out_path, ".app".as_bytes()) {
                    // Extract app stem from `.../Foo.app`
                    var slash_pos: usize = 0_usize;
                    var si: usize = 0_usize;
                    while si < out_path.len {
                        if out_path[si] == b'/' { slash_pos = si +% 1_usize; }
                        si = si +% 1_usize;
                    }
                    let stem_end = if out_path.len >= 4_usize { out_path.len - 4_usize } else { out_path.len };
                    let stem = if slash_pos < stem_end {
                        out_path.sub(slash_pos, stem_end) catch "EonApp".as_bytes()
                    } else {
                        "EonApp".as_bytes()
                    };
                    var bin_p = try str.StrBuf.init(alloc, out_path.len +% 64_usize);
                    errdefer bin_p.destroy(alloc);
                    var plist_p = try str.StrBuf.init(alloc, out_path.len +% 64_usize);
                    errdefer plist_p.destroy(alloc);
                    var plist_xml = try str.StrBuf.init(alloc, 512_usize);
                    errdefer plist_xml.destroy(alloc);
                    try bin_p.push_bytes_grow(alloc, out_path);
                    try plist_p.push_bytes_grow(alloc, out_path);
                    if copts.target_spec.os == .IOS {
                        try bin_p.push_str_grow(alloc, "/");
                        try bin_p.push_bytes_grow(alloc, stem);
                        try plist_p.push_str_grow(alloc, "/Info.plist");
                    } else {
                        try bin_p.push_str_grow(alloc, "/Contents/MacOS/");
                        try bin_p.push_bytes_grow(alloc, stem);
                        try plist_p.push_str_grow(alloc, "/Contents/Info.plist");
                    }
                    try macho.emit_app_info_plist(alloc, stem, "org.eon.app".as_bytes(), copts.target_spec.os == .IOS, &mut plist_xml);
                    out_byte_len.* = elf_bs.len;
                    let ok_bin = try write_elf_artifact(alloc, fs, bin_p.as_bytes(), elf_bs, false, err_buf);
                    let ok_pl = if ok_bin {
                        try write_elf_artifact(alloc, fs, plist_p.as_bytes(), plist_xml.as_bytes(), true, err_buf)
                    } else {
                        false
                    };
                    ok = ok_bin && ok_pl;
                    plist_xml.destroy(alloc);
                    plist_p.destroy(alloc);
                    bin_p.destroy(alloc);
                } else {
                    out_byte_len.* = elf_bs.len;
                    ok = try write_elf_artifact(alloc, fs, out_path, elf_bs, is_shared, err_buf);
                }
            }
            res.destroy(alloc);
            lib_syms.destroy(alloc);
        } else if !ends_with_nl(err_buf.as_bytes()) {
            try err_buf.push_byte_grow(alloc, b'\n');
        }
    }

    eir_prog.destroy(alloc);
    ct.destroy(alloc);
    tenv.destroy(alloc);
    resolved.destroy(alloc);
    return ok;
}

// ---------------------------------------------------------------------------
// `build` subcommand (direct mode + sandboxed `build.eon` manifest mode)
// ---------------------------------------------------------------------------

linear struct BuildCliArgs {
    status: i32; // 0 = ok, 1 = exit 0 (--help), 2 = exit 1 (error)
    freestanding: bool;
    shared: bool;
    sanitize: bool;
    audit_tcb: bool;
    has_out: bool;
    has_soname: bool;
    has_emi_cache: bool;
    opt_stats: bool;
    profile_phases: bool;
    win_gui: bool;
    jobs: u32;
    target_spec: target.TargetSpec;
    opt: eir.EirOptConfig;
    out_path: str.StrBuf;
    soname: str.StrBuf;
    emi_cache: str.StrBuf;
    needed_libs: PathList;
    inputs: PathList;
}

impl BuildCliArgs {
    fn init(alloc: *mut AllocCap) -> BuildCliArgs ! OutOfMemory {
        let out_path = try str.StrBuf.init(alloc, 64_usize);
        errdefer out_path.destroy(alloc);
        let soname = try str.StrBuf.init(alloc, 32_usize);
        errdefer soname.destroy(alloc);
        let emi_cache = try str.StrBuf.init(alloc, 64_usize);
        errdefer emi_cache.destroy(alloc);
        let needed_libs = try PathList.init(alloc);
        errdefer needed_libs.destroy(alloc);
        let inputs = try PathList.init(alloc);
        errdefer inputs.destroy(alloc);
        return BuildCliArgs.{
            status: 0_i32,
            freestanding: false,
            shared: false,
            sanitize: false,
            audit_tcb: false,
            has_out: false,
            has_soname: false,
            has_emi_cache: false,
            opt_stats: false,
            profile_phases: false,
            win_gui: false,
            jobs: 0_u32,
            target_spec: target.TargetSpec.host_default(),
            opt: eir.opt_config_dev(),
            out_path: out_path,
            soname: soname,
            emi_cache: emi_cache,
            needed_libs: needed_libs,
            inputs: inputs,
        };
    }

    fn destroy(self: BuildCliArgs, alloc: *mut AllocCap) {
        let BuildCliArgs.{
            status: _,
            freestanding: _,
            shared: _,
            sanitize: _,
            audit_tcb: _,
            has_out: _,
            has_soname: _,
            has_emi_cache: _,
            opt_stats: _,
            profile_phases: _,
            win_gui: _,
            jobs: _,
            target_spec: _,
            opt: _,
            out_path,
            soname,
            emi_cache,
            needed_libs,
            inputs,
        } = self;
        out_path.destroy(alloc);
        soname.destroy(alloc);
        emi_cache.destroy(alloc);
        needed_libs.destroy(alloc);
        inputs.destroy(alloc);
    }
}

fn parse_cmd_build_args(
    env: *mut Env,
    out: *mut BuildCliArgs,
    err_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    let argc = env.args.len();
    var lib_buf = try str.StrBuf.init(&mut env.alloc, 32_usize);
    errdefer lib_buf.destroy(&mut env.alloc);

    var ai: usize = 2_usize;
    while ai < argc {
        if let arg = env.args.get(ai) {
            if rt.str_eq(arg, "-o") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("-o requires a path\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let p = env.args.get(ai) {
                    out.out_path.clear();
                    try out.out_path.push_bytes_grow(&mut env.alloc, p.as_bytes());
                    out.has_out = true;
                }
            } else if rt.str_eq(arg, "--native") {
                // default
            } else if rt.str_eq(arg, "--freestanding") {
                out.freestanding = true;
            } else if rt.str_eq(arg, "--target") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--target requires a target triple (e.g. aarch64-linux)\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let tv = env.args.get(ai) {
                    if let ts = try parse_target_triple_or_err(&mut env.alloc, tv.as_bytes(), err_buf) {
                        out.target_spec = ts;
                        if ts.is_nostd {
                            out.freestanding = true;
                        }
                    } else {
                        out.status = 2_i32;
                        lib_buf.destroy(&mut env.alloc);
                        return;
                    }
                }
            } else if str.starts_with(arg.as_bytes(), "--target=".as_bytes()) {
                let ab = arg.as_bytes();
                let tsub = ab.sub(9_usize, ab.len) catch { "".as_bytes() };
                if let ts = try parse_target_triple_or_err(&mut env.alloc, tsub, err_buf) {
                    out.target_spec = ts;
                    if ts.is_nostd {
                        out.freestanding = true;
                    }
                } else {
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
            } else if rt.str_eq(arg, "--shared") {
                out.shared = true;
            } else if rt.str_eq(arg, "--gui") || rt.str_eq(arg, "--subsystem=gui") {
                out.win_gui = true;
            } else if rt.str_eq(arg, "--soname") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--soname requires a library soname\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let s = env.args.get(ai) {
                    out.soname.clear();
                    try out.soname.push_bytes_grow(&mut env.alloc, s.as_bytes());
                    out.has_soname = true;
                }
            } else if rt.str_eq(arg, "-l") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("-l requires a library name\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let l = env.args.get(ai) {
                    try resolve_lib_soname(&mut env.alloc, l.as_bytes(), &mut lib_buf);
                    try push_unique_path(&mut env.alloc, &mut out.needed_libs, lib_buf.as_bytes());
                }
            } else if rt.str_eq(arg, "--sanitize") {
                out.sanitize = true;
            } else if rt.str_eq(arg, "--audit-tcb") {
                out.audit_tcb = true;
            } else if rt.str_eq(arg, "--profile-phases") {
                out.profile_phases = true;
            } else if rt.str_eq(arg, "-j") || rt.str_eq(arg, "--jobs") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--jobs requires a positive integer\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let jv = env.args.get(ai) {
                    if let jn = parse_jobs_value(jv.as_bytes()) {
                        out.jobs = jn;
                    } else {
                        rt.eprint_str("--jobs requires a positive integer (1..1024)\n");
                        out.status = 2_i32;
                        lib_buf.destroy(&mut env.alloc);
                        return;
                    }
                }
            } else if str.starts_with(arg.as_bytes(), "--jobs=".as_bytes()) {
                let ab = arg.as_bytes();
                let jsub = ab.sub(7_usize, ab.len) catch { "".as_bytes() };
                if let jn = parse_jobs_value(jsub) {
                    out.jobs = jn;
                } else {
                    rt.eprint_str("--jobs requires a positive integer (1..1024)\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
            } else if rt.str_eq(arg, "--emi-cache") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--emi-cache requires a directory\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let d = env.args.get(ai) {
                    out.emi_cache.clear();
                    try out.emi_cache.push_bytes_grow(&mut env.alloc, d.as_bytes());
                    out.has_emi_cache = true;
                }
            } else if rt.str_eq(arg, "-h") || rt.str_eq(arg, "--help") {
                rt.eprint_str(
                    "usage: eonc build [--native] [--dev|--release|-O0..-O3] [--verify-opt] [--opt-bisect=N] [--opt-stats] [--target-cpu=native|baseline] [--freestanding] [--shared] [--soname NAME] [-l LIB] [--sanitize] [--audit-tcb] [--emi-cache DIR] [-o out_path] [path...|build.eon]\n",
                );
                out.status = 1_i32;
                lib_buf.destroy(&mut env.alloc);
                return;
            } else if rt.str_eq(arg, "--opt-bisect") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--opt-bisect requires an integer\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let nv = env.args.get(ai) {
                    if let n = parse_i64_decimal(nv.as_bytes()) {
                        out.opt.opt_bisect = n;
                    } else {
                        rt.eprint_str("--opt-bisect requires an integer\n");
                        out.status = 2_i32;
                        lib_buf.destroy(&mut env.alloc);
                        return;
                    }
                }
            } else if str.starts_with(arg.as_bytes(), "-l".as_bytes()) {
                let ab = arg.as_bytes();
                let lsub = ab.sub(2_usize, ab.len) catch { "".as_bytes() };
                if lsub.len == 0_usize {
                    rt.eprint_str("-l requires a library name\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                try resolve_lib_soname(&mut env.alloc, lsub, &mut lib_buf);
                try push_unique_path(&mut env.alloc, &mut out.needed_libs, lib_buf.as_bytes());
            } else if str.starts_with(arg.as_bytes(), "-".as_bytes()) {
                let opt_rc = try_parse_opt_flag(arg, &mut out.opt, &mut out.opt_stats);
                if opt_rc == 1_u8 {
                    // handled
                } else if opt_rc == 2_u8 {
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                } else {
                    err_buf.clear();
                    try err_buf.push_str_grow(&mut env.alloc, "unknown build flag `");
                    try err_buf.push_bytes_grow(&mut env.alloc, arg.as_bytes());
                    try err_buf.push_str_grow(&mut env.alloc, "`\n");
                    rt.eprint_bytes(err_buf.as_bytes());
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
            } else {
                try out.inputs.push(&mut env.alloc, arg.as_bytes());
            }
        }
        ai = ai +% 1_usize;
    }

    lib_buf.destroy(&mut env.alloc);
    return;
}

fn execute_build_eon_script(
    env: *mut Env,
    pkg_root: *[u8],
    build_file: *[u8],
    plan: *mut build_sys.BuildPlan,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    if str.ends_with(build_file, ".hal.eon".as_bytes())
        || span.profile_from_path(build_file) == .Hal
    {
        err_buf.clear();
        try err_buf.push_str_grow(
            &mut env.alloc,
            "build.eon sandbox error: @hal/raw/asm is forbidden in build scripts\n",
        );
        return false;
    }

    var sm = try span.SourceMap.init(&mut env.alloc);
    errdefer sm.destroy(&mut env.alloc);
    var interner = try span.SymInterner.init(&mut env.alloc);
    errdefer interner.destroy(&mut env.alloc);
    var diags = try diag.DiagBag.init(&mut env.alloc);
    errdefer diags.destroy(&mut env.alloc);
    var arena = try ast.AstArena.init(&mut env.alloc);
    errdefer arena.destroy(&mut env.alloc);
    var unit_ids = try col.DynBuf.[u32].init(&mut env.alloc, 4_usize);
    errdefer unit_ids.destroy(&mut env.alloc);

    let loaded = try load_and_parse_single_file(
        &mut env.alloc, &env.fs, build_file, &mut sm, &mut interner, &mut diags, &mut arena, &mut unit_ids, err_buf,
    );
    var uid0: u32 = 0_u32;
    let us0 = unit_ids.as_slice();
    if !loaded || us0.len == 0_usize {
        unit_ids.destroy(&mut env.alloc);
        arena.destroy(&mut env.alloc);
        diags.destroy(&mut env.alloc);
        interner.destroy(&mut env.alloc);
        sm.destroy(&mut env.alloc);
        return false;
    }
    uid0 = us0[0_usize];
    err_buf.clear();
    let prof_ok = try build_sys.validate_build_unit_profile(&mut env.alloc, &sm, &arena, uid0, err_buf);
    if !prof_ok {
        try err_buf.push_byte_grow(&mut env.alloc, b'\n');
        unit_ids.destroy(&mut env.alloc);
        arena.destroy(&mut env.alloc);
        diags.destroy(&mut env.alloc);
        interner.destroy(&mut env.alloc);
        sm.destroy(&mut env.alloc);
        return false;
    }

    var resolved = try resolve.resolve_program(&mut env.alloc, &arena, unit_ids.as_slice(), &mut interner, &mut diags);
    errdefer resolved.destroy(&mut env.alloc);
    var tenv = try types.build_type_env(&mut env.alloc, &arena, &mut resolved, &mut interner, &mut diags);
    errdefer tenv.destroy(&mut env.alloc);
    var ct = try ctvm.CtArena.init(&mut env.alloc);
    errdefer ct.destroy(&mut env.alloc);
    let ttable = try check.check_program(
        &mut env.alloc, &arena, unit_ids.as_slice(), &mut resolved, &mut tenv, &mut ct, &mut interner, &mut diags,
    );
    errdefer ttable.destroy(&mut env.alloc);
    let pre_err = diags.count();
    let cfg_prog = try cfg.lower_program(
        &mut env.alloc, &arena, unit_ids.as_slice(), &resolved, &mut tenv, &ct, &ttable, &mut interner,
    );
    errdefer cfg_prog.destroy(&mut env.alloc);
    try borrow.analyze_program(&mut env.alloc, &resolved, &tenv, &cfg_prog, &mut interner, &mut diags);
    if pre_err == 0_usize {
        let eff_rep = try effects.check_effects_and_concurrency(
            &mut env.alloc, &arena, unit_ids.as_slice(), &resolved, &tenv, &cfg_prog, &mut interner, &mut diags,
        );
        eff_rep.destroy(&mut env.alloc);
    }
    var eir_prog = try eir.lower_cfg_to_eir_with_diags(
        &mut env.alloc, &cfg_prog, &resolved, &tenv, &interner, &mut diags, false,
    );
    errdefer eir_prog.destroy(&mut env.alloc);
    if pre_err == 0_usize {
        let vr = try verify.verify_program(
            &mut env.alloc, &arena, &resolved, &tenv, &mut eir_prog, &interner, &mut diags,
        );
        vr.destroy(&mut env.alloc);
    }

    var ok = true;
    if diags.has_errors() {
        err_buf.clear();
        try diags.render_all(&mut env.alloc, &sm, err_buf);
        ok = false;
    } else if let entry_decl = build_sys.find_build_entry(&arena, uid0, &interner) {
        var entry_def: u32 = resolve.DEF_NONE;
        var di: u32 = 0_u32;
        while di < resolved.def_count() {
            if let d = resolved.get_def(di) {
                if d.decl_id == entry_decl {
                    entry_def = d.id;
                    break;
                }
            }
            di = di +% 1_u32;
        }
        let entry_key = cfg_ir.fn_key_top_def(entry_def);
        err_buf.clear();
        ok = try interp.interpret_build_script(
            &mut env.alloc, &env.fs, &eir_prog, entry_key, &resolved, &tenv, &ct, &interner, plan, err_buf,
        );
        if !ok && !ends_with_nl(err_buf.as_bytes()) {
            try err_buf.push_byte_grow(&mut env.alloc, b'\n');
        }
    } else {
        // Reject invalidly-typed `build`/`main` entrypoints.
        var di: u32 = 0_u32;
        while di < resolved.def_count() {
            if let d = resolved.get_def(di) {
                let nm = interner.get(d.name);
                if d.kind == .Fn && (str.bytes_eq(nm, "build".as_bytes()) || str.bytes_eq(nm, "main".as_bytes())) {
                    err_buf.clear();
                    try err_buf.push_str_grow(&mut env.alloc, "build.eon sandbox error: entry function `");
                    try err_buf.push_bytes_grow(&mut env.alloc, nm);
                    try err_buf.push_str_grow(&mut env.alloc, "` must take `(*mut BuildCap)`\n");
                    ok = false;
                    break;
                }
            }
            di = di +% 1_u32;
        }
    }

    if ok {
        _ = pkg_root;
        err_buf.clear();
        ok = try build_sys.validate_plan_paths(&mut env.alloc, plan, err_buf);
        if !ok && !ends_with_nl(err_buf.as_bytes()) {
            try err_buf.push_byte_grow(&mut env.alloc, b'\n');
        }
    }

    eir_prog.destroy(&mut env.alloc);
    cfg_prog.destroy(&mut env.alloc);
    ttable.destroy(&mut env.alloc);
    ct.destroy(&mut env.alloc);
    tenv.destroy(&mut env.alloc);
    resolved.destroy(&mut env.alloc);
    unit_ids.destroy(&mut env.alloc);
    arena.destroy(&mut env.alloc);
    diags.destroy(&mut env.alloc);
    interner.destroy(&mut env.alloc);
    sm.destroy(&mut env.alloc);
    return ok;
}

struct LockDepEntry {
    name_off: u32;
    name_len: u32;
    path_off: u32;
    path_len: u32;
    digest: tcb_audit.Sha256Digest;
}

linear struct ResolvedBuildDeps {
    src_roots: PathList;
    lock_entries: col.DynBuf[LockDepEntry];
    str_bytes: col.DynBuf[u8];
    visited: col.Interner;
    visiting: PathList;
}

impl ResolvedBuildDeps {
    fn init(alloc: *mut AllocCap) -> ResolvedBuildDeps ! OutOfMemory {
        let src_roots = try PathList.init(alloc);
        errdefer src_roots.destroy(alloc);
        let lock_entries = try col.DynBuf.[LockDepEntry].init(alloc, 8_usize);
        errdefer lock_entries.destroy(alloc);
        let str_bytes = try col.DynBuf.[u8].init(alloc, 256_usize);
        errdefer str_bytes.destroy(alloc);
        let visited = try col.Interner.init(alloc, 16_usize);
        errdefer visited.destroy(alloc);
        let visiting = try PathList.init(alloc);
        return ResolvedBuildDeps.{
            src_roots: src_roots,
            lock_entries: lock_entries,
            str_bytes: str_bytes,
            visited: visited,
            visiting: visiting,
        };
    }

    fn destroy(self: ResolvedBuildDeps, alloc: *mut AllocCap) {
        let ResolvedBuildDeps.{ src_roots, lock_entries, str_bytes, visited, visiting } = self;
        visiting.destroy(alloc);
        visited.destroy(alloc);
        str_bytes.destroy(alloc);
        lock_entries.destroy(alloc);
        src_roots.destroy(alloc);
    }

    fn push_lock_entry(
        self: *mut Self,
        alloc: *mut AllocCap,
        name: *[u8],
        path: *[u8],
        digest: tcb_audit.Sha256Digest,
    ) -> !OutOfMemory {
        let noff = self.str_bytes.len().trunc.[u32]();
        try self.str_bytes.push_slice(alloc, name);
        let poff = self.str_bytes.len().trunc.[u32]();
        try self.str_bytes.push_slice(alloc, path);
        try self.lock_entries.push(
            alloc,
            LockDepEntry.{
                name_off: noff,
                name_len: name.len.trunc.[u32](),
                path_off: poff,
                path_len: path.len.trunc.[u32](),
                digest: digest,
            },
        );
        return;
    }

    fn is_visiting(self: *Self, norm_root: *[u8]) -> bool {
        var i: usize = 0_usize;
        while i < self.visiting.len() {
            if str.bytes_eq(self.visiting.get(i), norm_root) {
                return true;
            }
            i = i +% 1_usize;
        }
        return false;
    }

    fn pop_visiting(self: *mut Self) {
        if self.visiting.offs.len() > 0_usize {
            _ = self.visiting.offs.pop();
            _ = self.visiting.lens.pop();
        }
    }
}

fn clone_lock_entry(e: *LockDepEntry) -> LockDepEntry {
    return LockDepEntry.{
        name_off: e.name_off,
        name_len: e.name_len,
        path_off: e.path_off,
        path_len: e.path_len,
        digest: tcb_audit.Sha256Digest.{ bytes: copy e.digest.bytes },
    };
}

fn cmp_lock_entries(bytes: *[u8], a: *LockDepEntry, b: *LockDepEntry) -> i32 {
    let a0 = a.name_off.widen.[usize]();
    let a1 = a0 +% a.name_len.widen.[usize]();
    let b0 = b.name_off.widen.[usize]();
    let b1 = b0 +% b.name_len.widen.[usize]();
    let c = cmp_bytes_range(bytes, a0, a1, bytes, b0, b1);
    if c != 0_i32 {
        return c;
    }
    let pa0 = a.path_off.widen.[usize]();
    let pa1 = pa0 +% a.path_len.widen.[usize]();
    let pb0 = b.path_off.widen.[usize]();
    let pb1 = pb0 +% b.path_len.widen.[usize]();
    return cmp_bytes_range(bytes, pa0, pa1, bytes, pb0, pb1);
}

fn sort_lock_entries(entries: *mut [LockDepEntry], bytes: *[u8]) {
    var i: usize = 1_usize;
    while i < entries.len {
        let key = clone_lock_entry(&entries[i]);
        var j = i;
        while j > 0_usize {
            let prev = j - 1_usize;
            if cmp_lock_entries(bytes, &entries[prev], &key) <= 0_i32 {
                break;
            }
            entries[j] = clone_lock_entry(&entries[prev]);
            j = prev;
        }
        entries[j] = key;
        i = i +% 1_usize;
    }
}

fn compute_pkg_tree_sha256(
    alloc: *mut AllocCap,
    fs: *FsCap,
    pkg_dir: *[u8],
    out_digest: *mut tcb_audit.Sha256Digest,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    var files = try PathList.init(alloc);
    errdefer files.destroy(alloc);
    let p_str = try pkg_dir.as_str();
    let ok = try collect_eon_files(alloc, fs, p_str, &mut files, err_buf);
    if !ok {
        files.destroy(alloc);
        return false;
    }
    files.sort();
    var hash_in = try col.DynBuf.[u8].init(alloc, 1024_usize);
    errdefer hash_in.destroy(alloc);
    try hash_in.push_slice(alloc, "EON_PKG_TREE_V1\n".as_bytes());
    let prefix_len = pkg_dir.len;
    var fi: usize = 0_usize;
    while fi < files.len() {
        let fp = files.get(fi);
        var rel = fp;
        if fp.len > prefix_len && str.starts_with(fp, pkg_dir) {
            var r0 = prefix_len;
            while r0 < fp.len && fp[r0] == b'/' {
                r0 = r0 +% 1_usize;
            }
            rel = fp.sub(r0, fp.len) catch fp;
        }
        try hash_in.push_slice(alloc, rel);
        try hash_in.push(alloc, 0_u8);
        let f_str = try fp.as_str();
        let fbuf = fs.read_file(alloc, f_str) catch {
            err_buf.clear();
            try err_buf.push_str_grow(alloc, "failed to hash dependency file `");
            try err_buf.push_bytes_grow(alloc, fp);
            try err_buf.push_str_grow(alloc, "`\n");
            hash_in.destroy(alloc);
            files.destroy(alloc);
            return false;
        };
        try hash_in.push_slice(alloc, fbuf.as_slice());
        fbuf.destroy(alloc);
        try hash_in.push(alloc, 0_u8);
        fi = fi +% 1_usize;
    }
    out_digest.* = tcb_audit.sha256(hash_in.as_slice());
    hash_in.destroy(alloc);
    files.destroy(alloc);
    return true;
}

@recursive
fn resolve_pkg_deps_rec(
    env: *mut Env,
    root_plan: *build_sys.BuildPlan,
    cur_pkg_root: *[u8],
    cur_plan: *build_sys.BuildPlan,
    merged_libs: *mut PathList,
    out_deps: *mut ResolvedBuildDeps,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    var raw_dep = try str.StrBuf.init(&mut env.alloc, 128_usize);
    errdefer raw_dep.destroy(&mut env.alloc);
    var norm_dep = try str.StrBuf.init(&mut env.alloc, 128_usize);
    errdefer norm_dep.destroy(&mut env.alloc);
    var sub_build = try str.StrBuf.init(&mut env.alloc, 128_usize);
    errdefer sub_build.destroy(&mut env.alloc);
    var sub_src = try str.StrBuf.init(&mut env.alloc, 128_usize);
    errdefer sub_src.destroy(&mut env.alloc);

    var di: usize = 0_usize;
    while di < cur_plan.dep_count() {
        let dname = cur_plan.dep_name(di);
        let dpath = cur_plan.dep_path(di);
        try join_path(&mut env.alloc, cur_pkg_root, dpath, &mut raw_dep);
        try normalize_path(&mut env.alloc, raw_dep.as_bytes(), &mut norm_dep);
        let dep_root = norm_dep.as_bytes();

        if out_deps.is_visiting(dep_root) {
            err_buf.clear();
            try err_buf.push_str_grow(&mut env.alloc, "build.eon dependency cycle detected involving `");
            try err_buf.push_bytes_grow(&mut env.alloc, dname);
            try err_buf.push_str_grow(&mut env.alloc, "` (");
            try err_buf.push_bytes_grow(&mut env.alloc, dep_root);
            try err_buf.push_str_grow(&mut env.alloc, ")\n");
            sub_src.destroy(&mut env.alloc);
            sub_build.destroy(&mut env.alloc);
            norm_dep.destroy(&mut env.alloc);
            raw_dep.destroy(&mut env.alloc);
            return false;
        }
        if let _ = out_deps.visited.lookup(dep_root) {
            di = di +% 1_usize;
            continue;
        }

        let dep_root_str = try dep_root.as_str();
        if !env.fs.is_dir(dep_root_str) {
            err_buf.clear();
            try err_buf.push_str_grow(&mut env.alloc, "build.eon dependency error: directory `");
            try err_buf.push_bytes_grow(&mut env.alloc, dep_root);
            try err_buf.push_str_grow(&mut env.alloc, "` for `");
            try err_buf.push_bytes_grow(&mut env.alloc, dname);
            try err_buf.push_str_grow(&mut env.alloc, "` not found\n");
            sub_src.destroy(&mut env.alloc);
            sub_build.destroy(&mut env.alloc);
            norm_dep.destroy(&mut env.alloc);
            raw_dep.destroy(&mut env.alloc);
            return false;
        }

        var digest = tcb_audit.sha256_zero();
        let hash_ok = try compute_pkg_tree_sha256(&mut env.alloc, &env.fs, dep_root, &mut digest, err_buf);
        if !hash_ok {
            sub_src.destroy(&mut env.alloc);
            sub_build.destroy(&mut env.alloc);
            norm_dep.destroy(&mut env.alloc);
            raw_dep.destroy(&mut env.alloc);
            return false;
        }
        try out_deps.push_lock_entry(&mut env.alloc, dname, dpath, digest);
        try out_deps.visiting.push(&mut env.alloc, dep_root);

        try join_path(&mut env.alloc, dep_root, "build.eon".as_bytes(), &mut sub_build);
        let sub_bstr = try sub_build.as_str();
        if file_exists_regular(&mut env.alloc, &env.fs, sub_bstr) {
            var dep_plan = try build_sys.BuildPlan.init(&mut env.alloc, dep_root);
            errdefer dep_plan.destroy(&mut env.alloc);
            let sub_ok = try execute_build_eon_script(env, dep_root, sub_build.as_bytes(), &mut dep_plan, err_buf);
            if !sub_ok {
                out_deps.pop_visiting();
                dep_plan.destroy(&mut env.alloc);
                sub_src.destroy(&mut env.alloc);
                sub_build.destroy(&mut env.alloc);
                norm_dep.destroy(&mut env.alloc);
                raw_dep.destroy(&mut env.alloc);
                return false;
            }
            // Per-package TCB policy: a dependency cannot escalate `@hal` unless root `build.eon` explicitly authorizes it.
            var hi: usize = 0_usize;
            while hi < dep_plan.allow_hal_count() {
                let hmod = dep_plan.allow_hal_at(hi);
                if !root_plan.allows_hal_mod(hmod) {
                    err_buf.clear();
                    try err_buf.push_str_grow(&mut env.alloc, "TCB audit error: dependency `");
                    try err_buf.push_bytes_grow(&mut env.alloc, dname);
                    try err_buf.push_str_grow(&mut env.alloc, "` requests @hal for `");
                    try err_buf.push_bytes_grow(&mut env.alloc, hmod);
                    try err_buf.push_str_grow(&mut env.alloc, "`, which is not authorized in root build.eon\n");
                    out_deps.pop_visiting();
                    dep_plan.destroy(&mut env.alloc);
                    sub_src.destroy(&mut env.alloc);
                    sub_build.destroy(&mut env.alloc);
                    norm_dep.destroy(&mut env.alloc);
                    raw_dep.destroy(&mut env.alloc);
                    return false;
                }
                hi = hi +% 1_usize;
            }
            try merge_plan_libs_only(&mut env.alloc, &dep_plan, merged_libs);

            let rec_ok = try resolve_pkg_deps_rec(
                env, root_plan, dep_root, &dep_plan, merged_libs, out_deps, err_buf,
            );
            if !rec_ok {
                out_deps.pop_visiting();
                dep_plan.destroy(&mut env.alloc);
                sub_src.destroy(&mut env.alloc);
                sub_build.destroy(&mut env.alloc);
                norm_dep.destroy(&mut env.alloc);
                raw_dep.destroy(&mut env.alloc);
                return false;
            }

            var added_lib = false;
            let dts = dep_plan.targets.as_slice();
            var dti: usize = 0_usize;
            while dti < dts.len {
                if dts[dti].kind == .EmiLib {
                    try join_path(&mut env.alloc, dep_root, dep_plan.target_root(dti), &mut sub_src);
                    try push_unique_path(&mut env.alloc, &mut out_deps.src_roots, sub_src.as_bytes());
                    added_lib = true;
                }
                dti = dti +% 1_usize;
            }
            if !added_lib {
                try join_path(&mut env.alloc, dep_root, "src".as_bytes(), &mut sub_src);
                let sstr = try sub_src.as_str();
                if env.fs.is_dir(sstr) {
                    try push_unique_path(&mut env.alloc, &mut out_deps.src_roots, sub_src.as_bytes());
                } else {
                    try push_unique_path(&mut env.alloc, &mut out_deps.src_roots, dep_root);
                }
            }
            dep_plan.destroy(&mut env.alloc);
        } else {
            try join_path(&mut env.alloc, dep_root, "src".as_bytes(), &mut sub_src);
            let sstr = try sub_src.as_str();
            if env.fs.is_dir(sstr) {
                try push_unique_path(&mut env.alloc, &mut out_deps.src_roots, sub_src.as_bytes());
            } else {
                try push_unique_path(&mut env.alloc, &mut out_deps.src_roots, dep_root);
            }
        }

        out_deps.pop_visiting();
        _ = try out_deps.visited.intern(&mut env.alloc, dep_root);
        di = di +% 1_usize;
    }

    sub_src.destroy(&mut env.alloc);
    sub_build.destroy(&mut env.alloc);
    norm_dep.destroy(&mut env.alloc);
    raw_dep.destroy(&mut env.alloc);
    return true;
}

fn write_eon_lock_file(
    alloc: *mut AllocCap,
    fs: *FsCap,
    pkg_root: *[u8],
    deps: *mut ResolvedBuildDeps,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    if deps.lock_entries.len() == 0_usize {
        return true;
    }
    let sb = deps.str_bytes.as_slice();
    sort_lock_entries(deps.lock_entries.as_mut_slice(), sb);

    var lock_buf = try str.StrBuf.init(alloc, 256_usize);
    errdefer lock_buf.destroy(alloc);
    try lock_buf.push_str_grow(alloc, "# Eon deterministic lockfile v1\nlock_version = 1\n");
    let es = deps.lock_entries.as_slice();
    var i: usize = 0_usize;
    while i < es.len {
        let e = es[i];
        let n0 = e.name_off.widen.[usize]();
        let n1 = n0 +% e.name_len.widen.[usize]();
        let p0 = e.path_off.widen.[usize]();
        let p1 = p0 +% e.path_len.widen.[usize]();
        let nm = sb.sub(n0, n1) catch { "".as_bytes() };
        let pt = sb.sub(p0, p1) catch { "".as_bytes() };
        try lock_buf.push_str_grow(alloc, "\n[[dep]]\nname = \"");
        try lock_buf.push_bytes_grow(alloc, nm);
        try lock_buf.push_str_grow(alloc, "\"\npath = \"");
        try lock_buf.push_bytes_grow(alloc, pt);
        try lock_buf.push_str_grow(alloc, "\"\nsha256 = \"");
        try tcb_audit.sha256_hex(alloc, &e.digest, &mut lock_buf);
        try lock_buf.push_str_grow(alloc, "\"\n");
        i = i +% 1_usize;
    }

    var lock_path = try str.StrBuf.init(alloc, 128_usize);
    errdefer lock_path.destroy(alloc);
    try join_path(alloc, pkg_root, "eon.lock".as_bytes(), &mut lock_path);
    let lstr = try lock_path.as_str();
    var ok = true;
    fs.write_file(lstr, lock_buf.as_bytes()) catch {
        err_buf.clear();
        try err_buf.push_str_grow(alloc, "failed to write `");
        try err_buf.push_bytes_grow(alloc, lock_path.as_bytes());
        try err_buf.push_str_grow(alloc, "`\n");
        ok = false;
    };
    lock_path.destroy(alloc);
    lock_buf.destroy(alloc);
    return ok;
}

fn compile_loaded_to_emi_lib(
    alloc: *mut AllocCap,
    clock: *ClockCap,
    fs: *FsCap,
    sm: *span.SourceMap,
    arena: *mut ast.AstArena,
    unit_ids: *[u32],
    lib_name: *[u8],
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    copts: *mach_x64.CompileOptions,
    needed_libs: *PathList,
    out_path: *[u8],
    profile_phases: bool,
    jobs: u32,
    out_byte_len: *mut usize,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    var resolved = try resolve.resolve_program(alloc, arena, unit_ids, interner, diags);
    errdefer resolved.destroy(alloc);
    var tenv = try types.build_type_env(alloc, arena, &mut resolved, interner, diags);
    errdefer tenv.destroy(alloc);
    var ct = try ctvm.CtArena.init(alloc);
    errdefer ct.destroy(alloc);
    var pre_err: usize = 0_usize;
    var eir_prog = try build_lower_to_eir_stage(
        alloc, clock, arena, false, unit_ids, &mut resolved, &mut tenv, &mut ct, interner, diags, profile_phases, jobs, &mut pre_err,
    );
    errdefer eir_prog.destroy(alloc);

    if pre_err == 0_usize && !diags.has_errors() {
        let vr = if copts.opt.opt_level > 0_u8 {
            try verify.verify_program_with_facts_and_jobs(
                alloc, arena, &resolved, &tenv, &mut eir_prog, interner, diags, jobs,
            )
        } else {
            try verify.verify_program_with_jobs(
                alloc, arena, &resolved, &tenv, &mut eir_prog, interner, diags, jobs,
            )
        };
        vr.destroy(alloc);
        try eir.apply_layout_sharing(alloc, &mut eir_prog, &tenv);
        try eir_prog.release_verify_dump_meta(alloc);
    }

    var ok = false;
    if diags.has_errors() {
        err_buf.clear();
        try diags.render_all(alloc, sm, err_buf);
    } else {
        err_buf.clear();
        var lint_ok = try eir.eir_lint_with_jobs(alloc, &eir_prog, &tenv, err_buf, jobs);
        if lint_ok && copts.opt.opt_level > 0_u8 {
            try tenv.preintern_opt_vec_tys(alloc);
            err_buf.clear();
            _ = try eir_opt.optimize_program_profiled_with_jobs(
                alloc, clock, profile_phases, &mut eir_prog, &tenv, interner, copts.opt, err_buf, jobs,
            );
            try eir_prog.release_value_facts(alloc);
            if err_buf.len() > 0_usize {
                lint_ok = false;
            }
        }
        if lint_ok {
            var lib_syms = try col.DynBuf.[u32].init(alloc, 4_usize);
            errdefer lib_syms.destroy(alloc);
            var li: usize = 0_usize;
            while li < needed_libs.len() {
                let sym = try interner.intern(alloc, needed_libs.get(li));
                try lib_syms.push(alloc, sym);
                li = li +% 1_usize;
            }
            var cap = try mach_x64.CapturedProgramBlobs.init(alloc);
            errdefer cap.destroy(alloc);
            let cr = try mach_x64.compile_and_link_x64_capture(
                alloc, sm, &mut eir_prog, &resolved, &tenv, &ct, interner, copts, lib_syms.as_slice(), &mut cap,
            );
            errdefer cr.destroy(alloc);
            if !cr.ok {
                err_buf.clear();
                try err_buf.push_bytes_grow(alloc, cr.err_msg.as_bytes());
                if !ends_with_nl(err_buf.as_bytes()) {
                    try err_buf.push_byte_grow(alloc, b'\n');
                }
            } else {
                var all_stubs = try str.StrBuf.init(alloc, 1024_usize);
                errdefer all_stubs.destroy(alloc);
                var one_stub = try str.StrBuf.init(alloc, 512_usize);
                errdefer one_stub.destroy(alloc);
                var ui: usize = 0_usize;
                while ui < unit_ids.len {
                    try extract_module_stub(alloc, sm, arena, unit_ids[ui], interner, &mut one_stub);
                    try all_stubs.push_bytes_grow(alloc, one_stub.as_bytes());
                    ui = ui +% 1_usize;
                }
                let opts_hash = mach_x64.compute_opts_hash(copts);
                let iface_d = try emi.compute_module_hash(alloc, lib_name, all_stubs.as_bytes(), &opts_hash);
                var mc = try emi.EmiModuleCache.init(alloc, lib_name);
                errdefer mc.destroy(alloc);
                mc.set_interface_hash(copy iface_d.bytes);
                mc.set_opts_hash(copy opts_hash);
                try mc.set_stub_text(alloc, all_stubs.as_bytes());
                let cfns = cap.fns.as_slice();
                var ci: usize = 0_usize;
                while ci < cfns.len {
                    let fh = tcb_audit.sha256(cap.fn_code(ci));
                    try mc.put_entry(alloc, cfns[ci].fn_sym, fh.bytes, cap.fn_code(ci), cap.fn_meta(ci));
                    ci = ci +% 1_usize;
                }
                var ser = try col.DynBuf.[u8].init(alloc, 4096_usize);
                errdefer ser.destroy(alloc);
                try emi.serialize_emi_cache(alloc, &mc, interner, &mut ser);
                out_byte_len.* = ser.len();
                ok = try write_elf_artifact(alloc, fs, out_path, ser.as_slice(), true, err_buf);
                ser.destroy(alloc);
                mc.destroy(alloc);
                one_stub.destroy(alloc);
                all_stubs.destroy(alloc);
            }
            cr.destroy(alloc);
            cap.destroy(alloc);
            lib_syms.destroy(alloc);
        } else if !ends_with_nl(err_buf.as_bytes()) {
            try err_buf.push_byte_grow(alloc, b'\n');
        }
    }

    eir_prog.destroy(alloc);
    ct.destroy(alloc);
    tenv.destroy(alloc);
    resolved.destroy(alloc);
    return ok;
}

fn build_plan_target(
    env: *mut Env,
    pkg_root: *[u8],
    out_dir_path: *[u8],
    plan: *build_sys.BuildPlan,
    ti: usize,
    dep_src_roots: *PathList,
    args: *BuildCliArgs,
    needed_libs: *PathList,
    sanitize: bool,
    audit_tcb: bool,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    var target_root = try str.StrBuf.init(&mut env.alloc, 128_usize);
    errdefer target_root.destroy(&mut env.alloc);
    try join_path(&mut env.alloc, pkg_root, plan.target_root(ti), &mut target_root);

    var target_inputs = try PathList.init(&mut env.alloc);
    errdefer target_inputs.destroy(&mut env.alloc);
    try target_inputs.push(&mut env.alloc, target_root.as_bytes());
    var dri: usize = 0_usize;
    while dri < dep_src_roots.len() {
        try push_unique_path(&mut env.alloc, &mut target_inputs, dep_src_roots.get(dri));
        dri = dri +% 1_usize;
    }

    var sm = try span.SourceMap.init(&mut env.alloc);
    errdefer sm.destroy(&mut env.alloc);
    var interner = try span.SymInterner.init(&mut env.alloc);
    errdefer interner.destroy(&mut env.alloc);
    var diags = try diag.DiagBag.init(&mut env.alloc);
    errdefer diags.destroy(&mut env.alloc);
    var arena = try ast.AstArena.init(&mut env.alloc);
    errdefer arena.destroy(&mut env.alloc);
    var unit_ids = try col.DynBuf.[u32].init(&mut env.alloc, 16_usize);
    errdefer unit_ids.destroy(&mut env.alloc);

    let load_ok = try load_eon_sources_with_jobs(
        env, &target_inputs, true, &mut sm, &mut interner, &mut diags, &mut arena, &mut unit_ids, err_buf, args.jobs,
    );
    if !load_ok {
        unit_ids.destroy(&mut env.alloc);
        arena.destroy(&mut env.alloc);
        diags.destroy(&mut env.alloc);
        interner.destroy(&mut env.alloc);
        sm.destroy(&mut env.alloc);
        target_inputs.destroy(&mut env.alloc);
        target_root.destroy(&mut env.alloc);
        return false;
    }

    let tcb_rep = try tcb_audit.audit_tcb(&mut env.alloc, &sm, &arena, unit_ids.as_slice(), &interner);
    errdefer tcb_rep.destroy(&mut env.alloc);

    var allow_syms = try col.DynBuf.[u32].init(&mut env.alloc, 4_usize);
    errdefer allow_syms.destroy(&mut env.alloc);
    var hi: usize = 0_usize;
    while hi < plan.allow_hal_count() {
        let sym = try interner.intern(&mut env.alloc, plan.allow_hal_at(hi));
        try allow_syms.push(&mut env.alloc, sym);
        hi = hi +% 1_usize;
    }

    err_buf.clear();
    let wl_ok = try tcb_rep.check_hal_whitelist(&mut env.alloc, allow_syms.as_slice(), &interner, err_buf);
    if !wl_ok {
        try err_buf.push_byte_grow(&mut env.alloc, b'\n');
        rt.eprint_bytes(err_buf.as_bytes());
        allow_syms.destroy(&mut env.alloc);
        tcb_rep.destroy(&mut env.alloc);
        unit_ids.destroy(&mut env.alloc);
        arena.destroy(&mut env.alloc);
        diags.destroy(&mut env.alloc);
        interner.destroy(&mut env.alloc);
        sm.destroy(&mut env.alloc);
        target_inputs.destroy(&mut env.alloc);
        target_root.destroy(&mut env.alloc);
        return false;
    }

    let ts = plan.targets.as_slice();
    let tkind: build_sys.BuildTargetKind = if ti < ts.len { ts[ti].kind } else { .Exe };
    let is_shared = tkind == .SharedLib;
    let is_emi_lib = tkind == .EmiLib;
    let eff_target = if args.freestanding && !args.target_spec.is_nostd {
        args.target_spec.with_freestanding()
    } else {
        args.target_spec
    };
    let is_nostd = args.freestanding || eff_target.is_nostd;
    let base_vaddr: u64 = if eff_target.arch == .AArch64 {
        0x40080000_u64
    } else if eff_target.arch == .RiscV64 {
        0x80200000_u64
    } else {
        0x00100000_u64
    };
    let mode_base = if is_shared || is_emi_lib {
        elf64.ElfMode.linux_shared(0_u32, 0_u32)
    } else if is_nostd {
        elf64.ElfMode.freestanding(base_vaddr, eff_target.arch == .X86_64)
    } else {
        elf64.ElfMode.linux_pie()
    };
    let mode = mode_base.with_arch(eff_target.arch);
    let copts = mach_x64.CompileOptions.{
        mode: mode,
        target_spec: eff_target,
        sanitize: sanitize,
        emit_debug_line: true,
        has_emi_cache: args.has_emi_cache && eff_target.arch == .X86_64 && eff_target.os == .Linux,
        win_gui: args.win_gui,
        opt: args.opt,
        jobs: args.jobs,
    };

    var out_path = try str.StrBuf.init(&mut env.alloc, 128_usize);
    errdefer out_path.destroy(&mut env.alloc);
    if args.has_out && plan.target_count() == 1_usize {
        try out_path.push_bytes_grow(&mut env.alloc, args.out_path.as_bytes());
    } else if args.has_out {
        try join_path(&mut env.alloc, args.out_path.as_bytes(), plan.target_name(ti), &mut out_path);
    } else {
        try join_path(&mut env.alloc, out_dir_path, plan.target_name(ti), &mut out_path);
        if is_emi_lib && !str.ends_with(out_path.as_bytes(), ".emi".as_bytes()) {
            try out_path.push_str_grow(&mut env.alloc, ".emi");
        }
    }

    var byte_len: usize = 0_usize;
    let built = if is_emi_lib {
        try compile_loaded_to_emi_lib(
            &mut env.alloc,
            &env.clock,
            &env.fs,
            &sm,
            &mut arena,
            unit_ids.as_slice(),
            plan.target_name(ti),
            &mut interner,
            &mut diags,
            &copts,
            needed_libs,
            out_path.as_bytes(),
            args.profile_phases,
            args.jobs,
            &mut byte_len,
            err_buf,
        )
    } else {
        try compile_loaded_to_elf_file(
            &mut env.alloc,
            &env.clock,
            &env.fs,
            &sm,
            &mut arena,
            !args.has_emi_cache,
            unit_ids.as_slice(),
            0_usize,
            &mut interner,
            &mut diags,
            &copts,
            needed_libs,
            args.emi_cache.as_bytes(),
            out_path.as_bytes(),
            is_shared,
            args.opt_stats,
            args.profile_phases,
            args.jobs,
            &mut byte_len,
            err_buf,
        )
    };
    if built {
        if is_emi_lib {
            var lmsg = try str.StrBuf.init(&mut env.alloc, 128_usize);
            errdefer lmsg.destroy(&mut env.alloc);
            try lmsg.push_str_grow(&mut env.alloc, "built EMI library ");
            try lmsg.push_bytes_grow(&mut env.alloc, out_path.as_bytes());
            try lmsg.push_str_grow(&mut env.alloc, " (");
            try lmsg.push_u64_grow(&mut env.alloc, byte_len.widen.[u64]());
            try lmsg.push_str_grow(&mut env.alloc, " bytes)\n");
            rt.eprint_bytes(lmsg.as_bytes());
            lmsg.destroy(&mut env.alloc);
        } else {
            try print_built_elf_msg(&mut env.alloc, out_path.as_bytes(), is_shared, byte_len);
        }
        if audit_tcb {
            var rep_buf = try str.StrBuf.init(&mut env.alloc, 512_usize);
            errdefer rep_buf.destroy(&mut env.alloc);
            try tcb_rep.format_report(&mut env.alloc, &mut rep_buf);
            rt.print_bytes(rep_buf.as_bytes());
            rep_buf.destroy(&mut env.alloc);
        }
    } else if err_buf.len() > 0_usize {
        rt.eprint_bytes(err_buf.as_bytes());
    }

    out_path.destroy(&mut env.alloc);
    allow_syms.destroy(&mut env.alloc);
    tcb_rep.destroy(&mut env.alloc);
    unit_ids.destroy(&mut env.alloc);
    arena.destroy(&mut env.alloc);
    diags.destroy(&mut env.alloc);
    interner.destroy(&mut env.alloc);
    sm.destroy(&mut env.alloc);
    target_inputs.destroy(&mut env.alloc);
    target_root.destroy(&mut env.alloc);
    return built;
}

fn print_build_summary_buf(
    alloc: *mut AllocCap,
    plan: *build_sys.BuildPlan,
) -> !OutOfMemory {
    var sum_buf = try str.StrBuf.init(alloc, 256_usize);
    errdefer sum_buf.destroy(alloc);
    try build_sys.format_build_summary(alloc, plan, &mut sum_buf);
    rt.print_bytes(sum_buf.as_bytes());
    sum_buf.destroy(alloc);
    return;
}

fn merge_plan_libs_only(
    alloc: *mut AllocCap,
    plan: *build_sys.BuildPlan,
    merged: *mut PathList,
) -> !OutOfMemory {
    var lib_tmp = try str.StrBuf.init(alloc, 32_usize);
    errdefer lib_tmp.destroy(alloc);
    var pi: usize = 0_usize;
    while pi < plan.link_lib_count() {
        try resolve_lib_soname(alloc, plan.link_lib_at(pi), &mut lib_tmp);
        try push_unique_path(alloc, merged, lib_tmp.as_bytes());
        pi = pi +% 1_usize;
    }
    lib_tmp.destroy(alloc);
    return;
}

fn resolve_root_pkg_deps(
    env: *mut Env,
    pkg_root: *[u8],
    plan: *build_sys.BuildPlan,
    merged_libs: *mut PathList,
    dep_state: *mut ResolvedBuildDeps,
    err_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory | Utf8Error {
    var norm_root = try str.StrBuf.init(&mut env.alloc, 128_usize);
    errdefer norm_root.destroy(&mut env.alloc);
    try normalize_path(&mut env.alloc, pkg_root, &mut norm_root);
    try dep_state.visiting.push(&mut env.alloc, norm_root.as_bytes());
    let deps_ok = try resolve_pkg_deps_rec(
        env, plan, pkg_root, plan, merged_libs, dep_state, err_buf,
    );
    dep_state.pop_visiting();
    norm_root.destroy(&mut env.alloc);
    return deps_ok;
}

fn merge_plan_and_cli_libs(
    alloc: *mut AllocCap,
    plan: *build_sys.BuildPlan,
    cli_libs: *PathList,
    merged: *mut PathList,
) -> !OutOfMemory {
    var lib_tmp = try str.StrBuf.init(alloc, 32_usize);
    errdefer lib_tmp.destroy(alloc);
    var pi: usize = 0_usize;
    while pi < plan.link_lib_count() {
        try resolve_lib_soname(alloc, plan.link_lib_at(pi), &mut lib_tmp);
        try push_unique_path(alloc, merged, lib_tmp.as_bytes());
        pi = pi +% 1_usize;
    }
    var ci: usize = 0_usize;
    while ci < cli_libs.len() {
        try push_unique_path(alloc, merged, cli_libs.get(ci));
        ci = ci +% 1_usize;
    }
    lib_tmp.destroy(alloc);
    return;
}

fn run_build_eon_mode(
    env: *mut Env,
    pkg_root: *[u8],
    build_file: *[u8],
    args: *BuildCliArgs,
    err_buf: *mut str.StrBuf,
) -> i32 ! OutOfMemory | Utf8Error {
    var plan = try build_sys.BuildPlan.init(&mut env.alloc, pkg_root);
    errdefer plan.destroy(&mut env.alloc);

    let ok_plan = try execute_build_eon_script(env, pkg_root, build_file, &mut plan, err_buf);
    if !ok_plan {
        if err_buf.len() > 0_usize {
            rt.eprint_bytes(err_buf.as_bytes());
        }
        plan.destroy(&mut env.alloc);
        return 1_i32;
    }

    try print_build_summary_buf(&mut env.alloc, &plan);

    if args.has_out && plan.target_count() > 1_usize {
        let ostr = try args.out_path.as_str();
        if !env.fs.is_dir(ostr) {
            err_buf.clear();
            try err_buf.push_str_grow(&mut env.alloc, "-o `");
            try err_buf.push_bytes_grow(&mut env.alloc, args.out_path.as_bytes());
            try err_buf.push_str_grow(&mut env.alloc, "` cannot be a single file for multiple targets\n");
            rt.eprint_bytes(err_buf.as_bytes());
            plan.destroy(&mut env.alloc);
            return 1_i32;
        }
    }

    var out_dir_path = try str.StrBuf.init(&mut env.alloc, 128_usize);
    errdefer out_dir_path.destroy(&mut env.alloc);
    try join_path(&mut env.alloc, pkg_root, plan.out_dir(), &mut out_dir_path);

    var merged_libs = try PathList.init(&mut env.alloc);
    errdefer merged_libs.destroy(&mut env.alloc);
    try merge_plan_and_cli_libs(&mut env.alloc, &plan, &args.needed_libs, &mut merged_libs);

    var dep_state = try ResolvedBuildDeps.init(&mut env.alloc);
    errdefer dep_state.destroy(&mut env.alloc);
    if plan.dep_count() > 0_usize {
        let deps_ok = try resolve_root_pkg_deps(
            env, pkg_root, &plan, &mut merged_libs, &mut dep_state, err_buf,
        );
        if !deps_ok {
            if err_buf.len() > 0_usize {
                rt.eprint_bytes(err_buf.as_bytes());
            }
            dep_state.destroy(&mut env.alloc);
            merged_libs.destroy(&mut env.alloc);
            out_dir_path.destroy(&mut env.alloc);
            plan.destroy(&mut env.alloc);
            return 1_i32;
        }
        let lock_ok = try write_eon_lock_file(&mut env.alloc, &env.fs, pkg_root, &mut dep_state, err_buf);
        if !lock_ok {
            if err_buf.len() > 0_usize {
                rt.eprint_bytes(err_buf.as_bytes());
            }
            dep_state.destroy(&mut env.alloc);
            merged_libs.destroy(&mut env.alloc);
            out_dir_path.destroy(&mut env.alloc);
            plan.destroy(&mut env.alloc);
            return 1_i32;
        }
    }

    let sanitize = args.sanitize || plan.sanitize;
    let audit_tcb = args.audit_tcb || plan.audit_tcb;

    var all_ok = true;
    var ti: usize = 0_usize;
    while ti < plan.target_count() {
        let tok = try build_plan_target(
            env,
            pkg_root,
            out_dir_path.as_bytes(),
            &plan,
            ti,
            &dep_state.src_roots,
            args,
            &merged_libs,
            sanitize,
            audit_tcb,
            err_buf,
        );
        if !tok {
            all_ok = false;
            break;
        }
        ti = ti +% 1_usize;
    }

    dep_state.destroy(&mut env.alloc);
    merged_libs.destroy(&mut env.alloc);
    out_dir_path.destroy(&mut env.alloc);
    plan.destroy(&mut env.alloc);
    if all_ok {
        return 0_i32;
    }
    return 1_i32;
}

fn maybe_run_build_eon_mode(
    env: *mut Env,
    args: *BuildCliArgs,
    err_buf: *mut str.StrBuf,
) -> ?i32 ! OutOfMemory | Utf8Error {
    var is_build_eon = false;
    var pkg_root = try str.StrBuf.init(&mut env.alloc, 64_usize);
    errdefer pkg_root.destroy(&mut env.alloc);
    var build_file = try str.StrBuf.init(&mut env.alloc, 64_usize);
    errdefer build_file.destroy(&mut env.alloc);

    if args.inputs.len() == 0_usize {
        if file_exists_regular(&mut env.alloc, &env.fs, "build.eon") {
            is_build_eon = true;
            try pkg_root.push_str_grow(&mut env.alloc, ".");
            try build_file.push_str_grow(&mut env.alloc, "build.eon");
        }
    } else if args.inputs.len() == 1_usize {
        let inp = args.inputs.get(0_usize);
        if str.bytes_eq(path_basename(inp), "build.eon".as_bytes()) {
            is_build_eon = true;
            try build_file.push_bytes_grow(&mut env.alloc, inp);
            let pdir = path_parent(inp);
            if pdir.len == 0_usize {
                try pkg_root.push_str_grow(&mut env.alloc, ".");
            } else {
                try pkg_root.push_bytes_grow(&mut env.alloc, pdir);
            }
        } else {
            let inp_str = try inp.as_str();
            if env.fs.is_dir(inp_str) {
                try join_path(&mut env.alloc, inp, "build.eon".as_bytes(), &mut build_file);
                let bf_str = try build_file.as_str();
                if file_exists_regular(&mut env.alloc, &env.fs, bf_str) {
                    is_build_eon = true;
                    try pkg_root.push_bytes_grow(&mut env.alloc, inp);
                }
            }
        }
    }

    var res: ?i32 = null;
    if is_build_eon {
        res = try run_build_eon_mode(env, pkg_root.as_bytes(), build_file.as_bytes(), args, err_buf);
    }
    build_file.destroy(&mut env.alloc);
    pkg_root.destroy(&mut env.alloc);
    return res;
}

fn cmd_build(env: *mut Env) -> i32 ! OutOfMemory | Utf8Error {
    var args = try BuildCliArgs.init(&mut env.alloc);
    errdefer args.destroy(&mut env.alloc);
    var err_buf = try str.StrBuf.init(&mut env.alloc, 256_usize);
    errdefer err_buf.destroy(&mut env.alloc);

    try parse_cmd_build_args(env, &mut args, &mut err_buf);
    if args.status != 0_i32 {
        let st = args.status;
        err_buf.destroy(&mut env.alloc);
        args.destroy(&mut env.alloc);
        if st == 1_i32 {
            return 0_i32;
        }
        return 1_i32;
    }
    if args.freestanding && args.shared {
        rt.eprint_str("cannot combine --freestanding and --shared\n");
        err_buf.destroy(&mut env.alloc);
        args.destroy(&mut env.alloc);
        return 1_i32;
    }

    if let brc = try maybe_run_build_eon_mode(env, &args, &mut err_buf) {
        err_buf.destroy(&mut env.alloc);
        args.destroy(&mut env.alloc);
        return brc;
    }

    if args.inputs.len() == 0_usize {
        rt.eprint_str(
            "usage: eonc build [--native] [--freestanding] [--shared] [--soname NAME] [-l LIB] [--sanitize] [--audit-tcb] [--emi-cache DIR] [-o out_path] [path...|build.eon]\n",
        );
        err_buf.destroy(&mut env.alloc);
        args.destroy(&mut env.alloc);
        return 1_i32;
    }
    if args.has_soname && !args.shared {
        rt.eprint_str("--soname requires --shared\n");
        err_buf.destroy(&mut env.alloc);
        args.destroy(&mut env.alloc);
        return 1_i32;
    }

    var out_path = try str.StrBuf.init(&mut env.alloc, 64_usize);
    errdefer out_path.destroy(&mut env.alloc);
    if args.has_out {
        try out_path.push_bytes_grow(&mut env.alloc, args.out_path.as_bytes());
    } else if args.shared {
        if args.has_soname {
            try out_path.push_bytes_grow(&mut env.alloc, args.soname.as_bytes());
        } else {
            try out_path.push_str_grow(&mut env.alloc, "libout.so");
        }
    } else {
        try out_path.push_str_grow(&mut env.alloc, "a.out");
    }

    let eff_target = if args.freestanding && !args.target_spec.is_nostd {
        args.target_spec.with_freestanding()
    } else {
        args.target_spec
    };
    let is_nostd = args.freestanding || eff_target.is_nostd;
    let base_vaddr: u64 = if eff_target.arch == .AArch64 {
        0x40080000_u64
    } else if eff_target.arch == .RiscV64 {
        0x80200000_u64
    } else {
        0x00100000_u64
    };
    let mode_base = if is_nostd {
        elf64.ElfMode.freestanding(base_vaddr, eff_target.arch == .X86_64)
    } else if args.shared || eff_target.is_shared {
        elf64.ElfMode.linux_shared(0_u32, 0_u32)
    } else {
        elf64.ElfMode.linux_pie()
    };
    let mode = mode_base.with_arch(eff_target.arch);
    var opt_cfg = args.opt;
    opt_cfg.incremental_cgu = args.has_emi_cache && eff_target.arch == .X86_64 && eff_target.os == .Linux;
    if is_nostd || !eff_target.has_avx2 {
        opt_cfg.target_avx2 = false;
    }
    let copts = mach_x64.CompileOptions.{
        mode: mode,
        target_spec: eff_target,
        sanitize: args.sanitize,
        emit_debug_line: true,
        has_emi_cache: args.has_emi_cache && eff_target.arch == .X86_64 && eff_target.os == .Linux,
        win_gui: args.win_gui,
        opt: opt_cfg,
        jobs: args.jobs,
    };

    var user_file_count: usize = 0_usize;
    if copts.has_emi_cache
        && args.emi_cache.len() > 0_usize
        && !is_nostd
        && !args.shared
        && args.needed_libs.len() == 0_usize
        && !args.audit_tcb
    {
        var inc_files = try PathList.init(&mut env.alloc);
        errdefer inc_files.destroy(&mut env.alloc);
        let col_ok = try collect_all_input_files(&mut env.alloc, &env.fs, &args.inputs, &mut inc_files, &mut err_buf);
        if col_ok {
            user_file_count = inc_files.len();
            var inc_byte_len: usize = 0_usize;
            let inc_st = try try_incremental_emi_build(
                env,
                &inc_files,
                &copts,
                args.emi_cache.as_bytes(),
                out_path.as_bytes(),
                &mut inc_byte_len,
                &mut err_buf,
            );
            if inc_st == 1_u8 {
                try print_built_elf_msg(&mut env.alloc, out_path.as_bytes(), false, inc_byte_len);
                inc_files.destroy(&mut env.alloc);
                out_path.destroy(&mut env.alloc);
                err_buf.destroy(&mut env.alloc);
                args.destroy(&mut env.alloc);
                return 0_i32;
            }
            if inc_st == 2_u8 {
                if err_buf.len() > 0_usize {
                    rt.eprint_bytes(err_buf.as_bytes());
                }
                inc_files.destroy(&mut env.alloc);
                out_path.destroy(&mut env.alloc);
                err_buf.destroy(&mut env.alloc);
                args.destroy(&mut env.alloc);
                return 1_i32;
            }
        }
        inc_files.destroy(&mut env.alloc);
    }

    var sm = try span.SourceMap.init(&mut env.alloc);
    errdefer sm.destroy(&mut env.alloc);
    var interner = try span.SymInterner.init(&mut env.alloc);
    errdefer interner.destroy(&mut env.alloc);
    var diags = try diag.DiagBag.init(&mut env.alloc);
    errdefer diags.destroy(&mut env.alloc);
    var arena = try ast.AstArena.init(&mut env.alloc);
    errdefer arena.destroy(&mut env.alloc);
    var unit_ids = try col.DynBuf.[u32].init(&mut env.alloc, 16_usize);
    errdefer unit_ids.destroy(&mut env.alloc);

    let t_load = if args.profile_phases { rt.now_ns(&env.clock) } else { 0_u64 };
    let u_load = if args.profile_phases { env.alloc.used_bytes() } else { 0_usize };
    let load_ok = try load_eon_sources_with_jobs(
        env, &args.inputs, true, &mut sm, &mut interner, &mut diags, &mut arena, &mut unit_ids, &mut err_buf, args.jobs,
    );
    if !load_ok {
        unit_ids.destroy(&mut env.alloc);
        arena.destroy(&mut env.alloc);
        diags.destroy(&mut env.alloc);
        interner.destroy(&mut env.alloc);
        sm.destroy(&mut env.alloc);
        out_path.destroy(&mut env.alloc);
        err_buf.destroy(&mut env.alloc);
        args.destroy(&mut env.alloc);
        return 1_i32;
    }
    if args.profile_phases {
        try print_phase_line(&mut env.alloc, &env.clock, "load+parse", t_load, u_load);
    }

    var byte_len: usize = 0_usize;
    let built = try compile_loaded_to_elf_file(
        &mut env.alloc,
        &env.clock,
        &env.fs,
        &sm,
        &mut arena,
        !args.has_emi_cache && !args.audit_tcb,
        unit_ids.as_slice(),
        user_file_count,
        &mut interner,
        &mut diags,
        &copts,
        &args.needed_libs,
        args.emi_cache.as_bytes(),
        out_path.as_bytes(),
        args.shared,
        args.opt_stats,
        args.profile_phases,
        args.jobs,
        &mut byte_len,
        &mut err_buf,
    );

    var rc: i32 = 1_i32;
    if built {
        try print_built_elf_msg(&mut env.alloc, out_path.as_bytes(), args.shared, byte_len);
        if args.audit_tcb {
            let rep = try tcb_audit.audit_tcb(&mut env.alloc, &sm, &arena, unit_ids.as_slice(), &interner);
            errdefer rep.destroy(&mut env.alloc);
            var rep_buf = try str.StrBuf.init(&mut env.alloc, 512_usize);
            errdefer rep_buf.destroy(&mut env.alloc);
            try rep.format_report(&mut env.alloc, &mut rep_buf);
            rt.print_bytes(rep_buf.as_bytes());
            rep_buf.destroy(&mut env.alloc);
            rep.destroy(&mut env.alloc);
        }
        rc = 0_i32;
    } else if args.audit_tcb
        && !args.has_out
        && !args.shared
        && !args.freestanding
        && bytes_contain(err_buf.as_bytes(), "unresolved entry symbol".as_bytes())
    {
        let rep = try tcb_audit.audit_tcb(&mut env.alloc, &sm, &arena, unit_ids.as_slice(), &interner);
        errdefer rep.destroy(&mut env.alloc);
        var rep_buf = try str.StrBuf.init(&mut env.alloc, 512_usize);
        errdefer rep_buf.destroy(&mut env.alloc);
        try rep.format_report(&mut env.alloc, &mut rep_buf);
        rt.print_bytes(rep_buf.as_bytes());
        rep_buf.destroy(&mut env.alloc);
        rep.destroy(&mut env.alloc);
        rc = 0_i32;
    } else if err_buf.len() > 0_usize {
        rt.eprint_bytes(err_buf.as_bytes());
    }

    unit_ids.destroy(&mut env.alloc);
    arena.destroy(&mut env.alloc);
    diags.destroy(&mut env.alloc);
    interner.destroy(&mut env.alloc);
    sm.destroy(&mut env.alloc);
    out_path.destroy(&mut env.alloc);
    err_buf.destroy(&mut env.alloc);
    args.destroy(&mut env.alloc);
    return rc;
}

// ---------------------------------------------------------------------------
// `run` subcommand (`--native` | `--interp`, `-- <prog_args...>`)
// ---------------------------------------------------------------------------

linear struct RunCliArgs {
    status: i32; // 0 = ok, 1 = exit 0 (--help), 2 = exit 1 (error)
    explicit_native: bool;
    interp: bool;
    sanitize: bool;
    has_emi_cache: bool;
    opt_stats: bool;
    profile_phases: bool;
    win_gui: bool;
    jobs: u32;
    target_spec: target.TargetSpec;
    opt: eir.EirOptConfig;
    emi_cache: str.StrBuf;
    needed_libs: PathList;
    inputs: PathList;
    prog_args: PathList;
}

impl RunCliArgs {
    fn init(alloc: *mut AllocCap) -> RunCliArgs ! OutOfMemory {
        let emi_cache = try str.StrBuf.init(alloc, 64_usize);
        errdefer emi_cache.destroy(alloc);
        let needed_libs = try PathList.init(alloc);
        errdefer needed_libs.destroy(alloc);
        let inputs = try PathList.init(alloc);
        errdefer inputs.destroy(alloc);
        let prog_args = try PathList.init(alloc);
        errdefer prog_args.destroy(alloc);
        return RunCliArgs.{
            status: 0_i32,
            explicit_native: false,
            interp: false,
            sanitize: false,
            has_emi_cache: false,
            opt_stats: false,
            profile_phases: false,
            win_gui: false,
            jobs: 0_u32,
            target_spec: target.TargetSpec.host_default(),
            opt: eir.opt_config_dev(),
            emi_cache: emi_cache,
            needed_libs: needed_libs,
            inputs: inputs,
            prog_args: prog_args,
        };
    }

    fn destroy(self: RunCliArgs, alloc: *mut AllocCap) {
        let RunCliArgs.{
            status: _,
            explicit_native: _,
            interp: _,
            sanitize: _,
            has_emi_cache: _,
            opt_stats: _,
            profile_phases: _,
            win_gui: _,
            jobs: _,
            target_spec: _,
            opt: _,
            emi_cache,
            needed_libs,
            inputs,
            prog_args,
        } = self;
        emi_cache.destroy(alloc);
        needed_libs.destroy(alloc);
        inputs.destroy(alloc);
        prog_args.destroy(alloc);
    }
}

fn parse_cmd_run_args(
    env: *mut Env,
    out: *mut RunCliArgs,
    err_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    let argc = env.args.len();
    var lib_buf = try str.StrBuf.init(&mut env.alloc, 32_usize);
    errdefer lib_buf.destroy(&mut env.alloc);

    var ai: usize = 2_usize;
    while ai < argc {
        if let arg = env.args.get(ai) {
            if rt.str_eq(arg, "--") {
                var pi = ai +% 1_usize;
                while pi < argc {
                    if let parg = env.args.get(pi) {
                        try out.prog_args.push(&mut env.alloc, parg.as_bytes());
                    }
                    pi = pi +% 1_usize;
                }
                break;
            } else if rt.str_eq(arg, "--native") {
                out.explicit_native = true;
            } else if rt.str_eq(arg, "--interp") {
                out.interp = true;
            } else if rt.str_eq(arg, "--sanitize") {
                out.sanitize = true;
            } else if rt.str_eq(arg, "--target") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--target requires a target triple (e.g. aarch64-linux)\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let tv = env.args.get(ai) {
                    if let ts = try parse_target_triple_or_err(&mut env.alloc, tv.as_bytes(), err_buf) {
                        out.target_spec = ts;
                    } else {
                        out.status = 2_i32;
                        lib_buf.destroy(&mut env.alloc);
                        return;
                    }
                }
            } else if str.starts_with(arg.as_bytes(), "--target=".as_bytes()) {
                let ab = arg.as_bytes();
                let tsub = ab.sub(9_usize, ab.len) catch { "".as_bytes() };
                if let ts = try parse_target_triple_or_err(&mut env.alloc, tsub, err_buf) {
                    out.target_spec = ts;
                } else {
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
            } else if rt.str_eq(arg, "--emi-cache") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--emi-cache requires a directory\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let d = env.args.get(ai) {
                    out.emi_cache.clear();
                    try out.emi_cache.push_bytes_grow(&mut env.alloc, d.as_bytes());
                    out.has_emi_cache = true;
                }
            } else if rt.str_eq(arg, "-l") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("-l requires a library name\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let l = env.args.get(ai) {
                    try resolve_lib_soname(&mut env.alloc, l.as_bytes(), &mut lib_buf);
                    try push_unique_path(&mut env.alloc, &mut out.needed_libs, lib_buf.as_bytes());
                }
            } else if rt.str_eq(arg, "--profile-phases") {
                out.profile_phases = true;
            } else if rt.str_eq(arg, "-j") || rt.str_eq(arg, "--jobs") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--jobs requires a positive integer\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let jv = env.args.get(ai) {
                    if let jn = parse_jobs_value(jv.as_bytes()) {
                        out.jobs = jn;
                    } else {
                        rt.eprint_str("--jobs requires a positive integer (1..1024)\n");
                        out.status = 2_i32;
                        lib_buf.destroy(&mut env.alloc);
                        return;
                    }
                }
            } else if str.starts_with(arg.as_bytes(), "--jobs=".as_bytes()) {
                let ab = arg.as_bytes();
                let jsub = ab.sub(7_usize, ab.len) catch { "".as_bytes() };
                if let jn = parse_jobs_value(jsub) {
                    out.jobs = jn;
                } else {
                    rt.eprint_str("--jobs requires a positive integer (1..1024)\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
            } else if rt.str_eq(arg, "-h") || rt.str_eq(arg, "--help") {
                rt.eprint_str(
                    "usage: eonc run [--native | --interp] [--dev|--release|-O0..-O3] [--verify-opt] [--opt-bisect=N] [--opt-stats] [--target-cpu=native|baseline] [--sanitize] [-l LIB] [--emi-cache DIR] [-j|--jobs N] <path...> [-- <prog_args...>]\n",
                );
                out.status = 1_i32;
                lib_buf.destroy(&mut env.alloc);
                return;
            } else if rt.str_eq(arg, "--opt-bisect") {
                ai = ai +% 1_usize;
                if ai >= argc {
                    rt.eprint_str("--opt-bisect requires an integer\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                if let nv = env.args.get(ai) {
                    if let n = parse_i64_decimal(nv.as_bytes()) {
                        out.opt.opt_bisect = n;
                    } else {
                        rt.eprint_str("--opt-bisect requires an integer\n");
                        out.status = 2_i32;
                        lib_buf.destroy(&mut env.alloc);
                        return;
                    }
                }
            } else if str.starts_with(arg.as_bytes(), "-l".as_bytes()) {
                let ab = arg.as_bytes();
                let lsub = ab.sub(2_usize, ab.len) catch { "".as_bytes() };
                if lsub.len == 0_usize {
                    rt.eprint_str("-l requires a library name\n");
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
                try resolve_lib_soname(&mut env.alloc, lsub, &mut lib_buf);
                try push_unique_path(&mut env.alloc, &mut out.needed_libs, lib_buf.as_bytes());
            } else if str.starts_with(arg.as_bytes(), "-".as_bytes()) {
                let opt_rc = try_parse_opt_flag(arg, &mut out.opt, &mut out.opt_stats);
                if opt_rc == 1_u8 {
                    // handled
                } else if opt_rc == 2_u8 {
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                } else {
                    err_buf.clear();
                    try err_buf.push_str_grow(&mut env.alloc, "unknown run flag `");
                    try err_buf.push_bytes_grow(&mut env.alloc, arg.as_bytes());
                    try err_buf.push_str_grow(&mut env.alloc, "`\n");
                    rt.eprint_bytes(err_buf.as_bytes());
                    out.status = 2_i32;
                    lib_buf.destroy(&mut env.alloc);
                    return;
                }
            } else {
                try out.inputs.push(&mut env.alloc, arg.as_bytes());
            }
        }
        ai = ai +% 1_usize;
    }

    lib_buf.destroy(&mut env.alloc);
    return;
}

fn run_loaded_interp(
    alloc: *mut AllocCap,
    fs: *FsCap,
    sm: *span.SourceMap,
    arena: *ast.AstArena,
    unit_ids: *[u32],
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    target_spec: target.TargetSpec,
    opt: eir.EirOptConfig,
    print_opt_stats: bool,
    jobs: u32,
    prog_args: *PathList,
    err_buf: *mut str.StrBuf,
) -> i32 ! OutOfMemory {
    var resolved = try resolve.resolve_program(alloc, arena, unit_ids, interner, diags);
    errdefer resolved.destroy(alloc);
    var tenv = try types.build_type_env(alloc, arena, &mut resolved, interner, diags);
    errdefer tenv.destroy(alloc);
    tenv.set_target(target_spec);
    var ct = try ctvm.CtArena.init(alloc);
    errdefer ct.destroy(alloc);
    let ttable = try check.check_program_with_jobs(
        alloc, arena, unit_ids, &mut resolved, &mut tenv, &mut ct, interner, diags, jobs,
    );
    errdefer ttable.destroy(alloc);
    let pre_err = diags.count();
    let cfg_prog = try cfg.lower_program_with_jobs(
        alloc, arena, unit_ids, &resolved, &mut tenv, &ct, &ttable, interner, jobs,
    );
    errdefer cfg_prog.destroy(alloc);
    try borrow.analyze_program_with_jobs(alloc, &resolved, &tenv, &cfg_prog, interner, diags, jobs);
    if pre_err == 0_usize {
        let eff_rep = try effects.check_effects_and_concurrency_with_jobs(
            alloc, arena, unit_ids, &resolved, &tenv, &cfg_prog, interner, diags, jobs,
        );
        eff_rep.destroy(alloc);
    }
    var eir_prog = try eir.lower_cfg_to_eir_with_diags_and_jobs(
        alloc, &cfg_prog, &resolved, &tenv, interner, diags, false, jobs,
    );
    errdefer eir_prog.destroy(alloc);
    if pre_err == 0_usize {
        let vr = if opt.opt_level > 0_u8 {
            try verify.verify_program_with_facts_and_jobs(
                alloc, arena, &resolved, &tenv, &mut eir_prog, interner, diags, jobs,
            )
        } else {
            try verify.verify_program_with_jobs(
                alloc, arena, &resolved, &tenv, &mut eir_prog, interner, diags, jobs,
            )
        };
        vr.destroy(alloc);
        try eir.apply_layout_sharing(alloc, &mut eir_prog, &tenv);
        try eir_prog.release_verify_dump_meta(alloc);
    }
    if !diags.has_errors() {
        try emit_unsupported_cfg_diags(alloc, &cfg_prog, diags, "` to EIR");
    }

    var rc: i32 = 1_i32;
    if diags.has_errors() {
        err_buf.clear();
        try diags.render_all(alloc, sm, err_buf);
        rt.eprint_bytes(err_buf.as_bytes());
    } else {
        err_buf.clear();
        var lint_ok = try eir.eir_lint_with_jobs(alloc, &eir_prog, &tenv, err_buf, jobs);
        if lint_ok && opt.opt_level > 0_u8 {
            try tenv.preintern_opt_vec_tys(alloc);
            err_buf.clear();
            let stats = try eir_opt.optimize_program_with_jobs(
                alloc, &mut eir_prog, &tenv, interner, opt, err_buf, jobs,
            );
            if err_buf.len() > 0_usize {
                lint_ok = false;
            } else if print_opt_stats {
                try print_opt_stats_line(alloc, &stats);
            }
        }
        if !lint_ok {
            rt.eprint_bytes(err_buf.as_bytes());
            rt.eprint_nl();
        } else {
            var nul_args = try col.DynBuf.[u8].init(alloc, 32_usize);
            errdefer nul_args.destroy(alloc);
            var pi: usize = 0_usize;
            while pi < prog_args.len() {
                try nul_args.push_slice(alloc, prog_args.get(pi));
                try nul_args.push(alloc, 0_u8);
                pi = pi +% 1_usize;
            }
            let res = try interp.interpret_eir(
                alloc,
                fs,
                &eir_prog,
                &resolved,
                &tenv,
                &ct,
                interner,
                nul_args.as_slice(),
                interp.DEFAULT_STEP_LIMIT,
            );
            errdefer res.destroy(alloc);
            if res.ok {
                if res.stdout.len() > 0_usize {
                    rt.print_bytes(res.stdout.as_bytes());
                }
                if res.stderr.len() > 0_usize {
                    rt.eprint_bytes(res.stderr.as_bytes());
                }
                rc = res.exit_code;
            } else {
                rt.eprint_bytes(res.err_msg.as_bytes());
                if !ends_with_nl(res.err_msg.as_bytes()) {
                    rt.eprint_nl();
                }
            }
            res.destroy(alloc);
            nul_args.destroy(alloc);
        }
    }

    eir_prog.destroy(alloc);
    cfg_prog.destroy(alloc);
    ttable.destroy(alloc);
    ct.destroy(alloc);
    tenv.destroy(alloc);
    resolved.destroy(alloc);
    return rc;
}

fn cmd_run(env: *mut Env) -> i32 ! OutOfMemory | Utf8Error {
    var args = try RunCliArgs.init(&mut env.alloc);
    errdefer args.destroy(&mut env.alloc);
    var err_buf = try str.StrBuf.init(&mut env.alloc, 256_usize);
    errdefer err_buf.destroy(&mut env.alloc);

    try parse_cmd_run_args(env, &mut args, &mut err_buf);
    if args.status != 0_i32 {
        let st = args.status;
        err_buf.destroy(&mut env.alloc);
        args.destroy(&mut env.alloc);
        if st == 1_i32 {
            return 0_i32;
        }
        return 1_i32;
    }
    if args.explicit_native && args.interp {
        rt.eprint_str("cannot combine --native and --interp\n");
        err_buf.destroy(&mut env.alloc);
        args.destroy(&mut env.alloc);
        return 1_i32;
    }
    if args.inputs.len() == 0_usize {
        rt.eprint_str(
            "usage: eonc run [--native | --interp] [--sanitize] [-l LIB] [--emi-cache DIR] <path...> [-- <prog_args...>]\n",
        );
        err_buf.destroy(&mut env.alloc);
        args.destroy(&mut env.alloc);
        return 1_i32;
    }

    var sm = try span.SourceMap.init(&mut env.alloc);
    errdefer sm.destroy(&mut env.alloc);
    var interner = try span.SymInterner.init(&mut env.alloc);
    errdefer interner.destroy(&mut env.alloc);
    var diags = try diag.DiagBag.init(&mut env.alloc);
    errdefer diags.destroy(&mut env.alloc);
    var arena = try ast.AstArena.init(&mut env.alloc);
    errdefer arena.destroy(&mut env.alloc);
    var unit_ids = try col.DynBuf.[u32].init(&mut env.alloc, 16_usize);
    errdefer unit_ids.destroy(&mut env.alloc);

    let load_ok = try load_eon_sources_with_jobs(
        env, &args.inputs, true, &mut sm, &mut interner, &mut diags, &mut arena, &mut unit_ids, &mut err_buf, args.jobs,
    );
    if !load_ok {
        unit_ids.destroy(&mut env.alloc);
        arena.destroy(&mut env.alloc);
        diags.destroy(&mut env.alloc);
        interner.destroy(&mut env.alloc);
        sm.destroy(&mut env.alloc);
        err_buf.destroy(&mut env.alloc);
        args.destroy(&mut env.alloc);
        return 1_i32;
    }

    var rc: i32 = 1_i32;
    if args.interp {
        rc = try run_loaded_interp(
            &mut env.alloc, &env.fs, &sm, &arena, unit_ids.as_slice(), &mut interner, &mut diags, args.target_spec, args.opt, args.opt_stats, args.jobs, &args.prog_args, &mut err_buf,
        );
    } else {
        var tmp_bin = try str.StrBuf.init(&mut env.alloc, 64_usize);
        errdefer tmp_bin.destroy(&mut env.alloc);
        try tmp_bin.push_str_grow(&mut env.alloc, "/tmp/eonc1_run_");
        try tmp_bin.push_u64_grow(&mut env.alloc, rt.now_ns(&env.clock));
        try tmp_bin.push_str_grow(&mut env.alloc, ".bin");

        let copts = mach_x64.CompileOptions.{
            mode: elf64.ElfMode.linux_pie().with_arch(args.target_spec.arch),
            target_spec: args.target_spec,
            sanitize: args.sanitize,
            emit_debug_line: true,
            has_emi_cache: args.has_emi_cache && args.target_spec.arch == .X86_64 && args.target_spec.os == .Linux,
            win_gui: false,
            opt: args.opt,
            jobs: args.jobs,
        };
        var byte_len: usize = 0_usize;
        let built = try compile_loaded_to_elf_file(
            &mut env.alloc,
            &env.clock,
            &env.fs,
            &sm,
            &mut arena,
            !args.has_emi_cache,
            unit_ids.as_slice(),
            0_usize,
            &mut interner,
            &mut diags,
            &copts,
            &args.needed_libs,
            args.emi_cache.as_bytes(),
            tmp_bin.as_bytes(),
            false,
            args.opt_stats,
            args.profile_phases,
            args.jobs,
            &mut byte_len,
            &mut err_buf,
        );
        if !built {
            if err_buf.len() > 0_usize {
                rt.eprint_bytes(err_buf.as_bytes());
            }
        } else {
            var spawn_args = try col.DynBuf.[u8].init(&mut env.alloc, 64_usize);
            errdefer spawn_args.destroy(&mut env.alloc);
            if args.prog_args.len() > 0_usize {
                try spawn_args.push_slice(&mut env.alloc, tmp_bin.as_bytes());
                try spawn_args.push(&mut env.alloc, 0_u8);
                var pi: usize = 0_usize;
                while pi < args.prog_args.len() {
                    try spawn_args.push_slice(&mut env.alloc, args.prog_args.get(pi));
                    try spawn_args.push(&mut env.alloc, 0_u8);
                    pi = pi +% 1_usize;
                }
            }
            let bstr = try tmp_bin.as_str();
            let child_rc = env.fs.spawn_wait(bstr, spawn_args.as_slice()) catch {
                rt.eprint_str("failed to run compiled binary\n");
                spawn_args.destroy(&mut env.alloc);
                tmp_bin.destroy(&mut env.alloc);
                unit_ids.destroy(&mut env.alloc);
                arena.destroy(&mut env.alloc);
                diags.destroy(&mut env.alloc);
                interner.destroy(&mut env.alloc);
                sm.destroy(&mut env.alloc);
                err_buf.destroy(&mut env.alloc);
                args.destroy(&mut env.alloc);
                return 1_i32;
            };
            rc = child_rc;
            spawn_args.destroy(&mut env.alloc);
        }
        tmp_bin.destroy(&mut env.alloc);
    }

    unit_ids.destroy(&mut env.alloc);
    arena.destroy(&mut env.alloc);
    diags.destroy(&mut env.alloc);
    interner.destroy(&mut env.alloc);
    sm.destroy(&mut env.alloc);
    err_buf.destroy(&mut env.alloc);
    args.destroy(&mut env.alloc);
    return rc;
}

// ---------------------------------------------------------------------------
// `test` subcommand (`eonc1 test [tests/ui]`)
// ---------------------------------------------------------------------------

fn cmd_test(env: *mut Env) -> i32 ! OutOfMemory | Utf8Error {
    var target = try str.StrBuf.init(&mut env.alloc, 64_usize);
    errdefer target.destroy(&mut env.alloc);

    if let p = env.args.get(2_usize) {
        if rt.str_eq(p, "-h") || rt.str_eq(p, "--help") {
            rt.eprint_str("usage: eonc test [tests/ui]\n");
            target.destroy(&mut env.alloc);
            return 0_i32;
        }
        try target.push_bytes_grow(&mut env.alloc, p.as_bytes());
    } else if env.fs.is_dir("tests/ui") {
        try target.push_str_grow(&mut env.alloc, "tests/ui");
    } else {
        try target.push_str_grow(&mut env.alloc, "../tests/ui");
    }

    let tstr = try target.as_str();
    let rc = try ui_test.run_ui_tests(env, tstr);
    target.destroy(&mut env.alloc);
    return rc;
}

// ---------------------------------------------------------------------------
// `fmt` subcommand (`eonc fmt [--check] <path...>`)
// ---------------------------------------------------------------------------

fn cmd_fmt(env: *mut Env) -> i32 ! OutOfMemory | Utf8Error {
    let argc = env.args.len();
    var check_only = false;
    var inputs = try PathList.init(&mut env.alloc);
    errdefer inputs.destroy(&mut env.alloc);
    var err_buf = try str.StrBuf.init(&mut env.alloc, 256_usize);
    errdefer err_buf.destroy(&mut env.alloc);

    var ai: usize = 2_usize;
    while ai < argc {
        if let arg = env.args.get(ai) {
            if rt.str_eq(arg, "-h") || rt.str_eq(arg, "--help") {
                rt.eprint_str("usage: eonc fmt [--check] <path...>\n");
                err_buf.destroy(&mut env.alloc);
                inputs.destroy(&mut env.alloc);
                return 0_i32;
            } else if rt.str_eq(arg, "--check") {
                check_only = true;
            } else {
                try inputs.push(&mut env.alloc, arg.as_bytes());
            }
        }
        ai = ai +% 1_usize;
    }
    if inputs.len() == 0_usize {
        rt.eprint_str("usage: eonc fmt [--check] <path...>\n");
        err_buf.destroy(&mut env.alloc);
        inputs.destroy(&mut env.alloc);
        return 1_i32;
    }

    var files = try PathList.init(&mut env.alloc);
    errdefer files.destroy(&mut env.alloc);
    var ii: usize = 0_usize;
    while ii < inputs.len() {
        let pstr = try inputs.get(ii).as_str();
        let ok = try collect_eon_files(&mut env.alloc, &env.fs, pstr, &mut files, &mut err_buf);
        if !ok {
            rt.eprint_bytes(err_buf.as_bytes());
            files.destroy(&mut env.alloc);
            err_buf.destroy(&mut env.alloc);
            inputs.destroy(&mut env.alloc);
            return 1_i32;
        }
        ii = ii +% 1_usize;
    }
    files.sort();

    var formatted = try str.StrBuf.init(&mut env.alloc, 4096_usize);
    errdefer formatted.destroy(&mut env.alloc);
    var unformatted_count: usize = 0_usize;
    var write_failed = false;

    var fi: usize = 0_usize;
    while fi < files.len() {
        let fp = files.get(fi);
        let fstr = try fp.as_str();
        let orig = env.fs.read_file(&mut env.alloc, fstr) catch {
            rt.eprint_str("fmt: failed to read `");
            rt.eprint_bytes(fp);
            rt.eprint_str("`\n");
            write_failed = true;
            fi = fi +% 1_usize;
            continue;
        };
        try fmt.format_eon_source(&mut env.alloc, orig.as_slice(), &mut formatted);
        let changed = !str.bytes_eq(orig.as_slice(), formatted.as_bytes());
        orig.destroy(&mut env.alloc);
        if changed {
            unformatted_count = unformatted_count +% 1_usize;
            if check_only {
                rt.eprint_str("would reformat: ");
                rt.eprint_bytes(fp);
                rt.eprint_nl();
            } else {
                env.fs.write_file(fstr, formatted.as_bytes()) catch {
                    rt.eprint_str("fmt: failed to write `");
                    rt.eprint_bytes(fp);
                    rt.eprint_str("`\n");
                    write_failed = true;
                };
            }
        }
        fi = fi +% 1_usize;
    }

    formatted.destroy(&mut env.alloc);
    files.destroy(&mut env.alloc);
    err_buf.destroy(&mut env.alloc);
    inputs.destroy(&mut env.alloc);
    if write_failed {
        return 1_i32;
    }
    if check_only && unformatted_count > 0_usize {
        return 1_i32;
    }
    return 0_i32;
}

// ---------------------------------------------------------------------------
// `lsp` subcommand (`eonc lsp`)
// ---------------------------------------------------------------------------

fn cmd_lsp(env: *mut Env) -> i32 ! OutOfMemory | Utf8Error {
    if let arg = env.args.get(2_usize) {
        if rt.str_eq(arg, "-h") || rt.str_eq(arg, "--help") {
            rt.eprint_str("usage: eonc lsp\n");
            return 0_i32;
        }
    }
    return try lsp.run_lsp_server(env);
}

pub fn main(env: *mut Env) -> i32 ! OutOfMemory | IoError | Utf8Error {
    let argc = env.args.len();
    if argc < 2_usize {
        print_usage();
        return 1_i32;
    }
    var mode: u8 = 0_u8;
    if let s = env.args.get(1_usize) {
        if rt.str_eq(s, "lex") {
            mode = 1_u8;
        } else if rt.str_eq(s, "-h") || rt.str_eq(s, "--help") || rt.str_eq(s, "help") {
            mode = 2_u8;
        } else if rt.str_eq(s, "parse") {
            mode = 3_u8;
        } else if rt.str_eq(s, "resolve") {
            mode = 4_u8;
        } else if rt.str_eq(s, "check") {
            mode = 5_u8;
        } else if rt.str_eq(s, "build") {
            mode = 6_u8;
        } else if rt.str_eq(s, "run") {
            mode = 7_u8;
        } else if rt.str_eq(s, "test") {
            mode = 8_u8;
        } else if rt.str_eq(s, "fmt") {
            mode = 9_u8;
        } else if rt.str_eq(s, "lsp") {
            mode = 10_u8;
        }
    }
    if mode == 2_u8 {
        print_usage();
        return 0_i32;
    }
    if mode == 0_u8 {
        rt.eprint_str("unknown subcommand `");
        if let s = env.args.get(1_usize) {
            rt.eprint_str(s);
        }
        rt.eprint_str("`\n");
        print_usage();
        return 1_i32;
    }

    var rc: i32 = 1_i32;
    if mode == 1_u8 {
        rc = try cmd_lex(env);
    } else if mode == 3_u8 {
        rc = try cmd_parse(env);
    } else if mode == 4_u8 {
        rc = try cmd_resolve(env);
    } else if mode == 5_u8 {
        rc = try cmd_check(env);
    } else if mode == 6_u8 {
        rc = try cmd_build(env);
    } else if mode == 7_u8 {
        rc = try cmd_run(env);
    } else if mode == 8_u8 {
        rc = try cmd_test(env);
    } else if mode == 9_u8 {
        rc = try cmd_fmt(env);
    } else if mode == 10_u8 {
        rc = try cmd_lsp(env);
    }

    if env.alloc.live_allocs() != 0_usize {
        rt.eprint_str("internal error: eonc1 leaked heap allocations\n");
        return 101_i32;
    }
    return rc;
}
