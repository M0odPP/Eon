    pub fn vfmul_vec(self: *mut Self, alloc: *mut AllocCap, is_f64: bool, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let op: u32 = if is_f64 { 0x6E60DC00_u32 } else { 0x6E20DC00_u32 };
        try self.emit32(alloc, op | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vfdiv_vec(self: *mut Self, alloc: *mut AllocCap, is_f64: bool, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let op: u32 = if is_f64 { 0x6E60FC00_u32 } else { 0x6E20FC00_u32 };
        try self.emit32(alloc, op | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vfmla_vec(self: *mut Self, alloc: *mut AllocCap, is_f64: bool, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let op: u32 = if is_f64 { 0x4E60CC00_u32 } else { 0x4E20CC00_u32 };
        try self.emit32(alloc, op | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vfmls_vec(self: *mut Self, alloc: *mut AllocCap, is_f64: bool, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let op: u32 = if is_f64 { 0x4EE0CC00_u32 } else { 0x4EA0CC00_u32 };
        try self.emit32(alloc, op | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vfmin_vec(self: *mut Self, alloc: *mut AllocCap, is_f64: bool, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let op: u32 = if is_f64 { 0x4EE0C400_u32 } else { 0x4EA0C400_u32 };
        try self.emit32(alloc, op | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vfmax_vec(self: *mut Self, alloc: *mut AllocCap, is_f64: bool, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let op: u32 = if is_f64 { 0x4E60C400_u32 } else { 0x4E20C400_u32 };
        try self.emit32(alloc, op | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vfsqrt_vec(self: *mut Self, alloc: *mut AllocCap, is_f64: bool, vd: u8, vn: u8) -> !OutOfMemory {
        let op: u32 = if is_f64 { 0x6EE1F800_u32 } else { 0x6EA1F800_u32 };
        try self.emit32(alloc, op | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vadd_int(self: *mut Self, alloc: *mut AllocCap, size_code: u8, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let sz = (size_code & 3_u8).widen.[u32]() <<% 22_u32;
        try self.emit32(alloc, 0x4E208400_u32 | sz | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vsub_int(self: *mut Self, alloc: *mut AllocCap, size_code: u8, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let sz = (size_code & 3_u8).widen.[u32]() <<% 22_u32;
        try self.emit32(alloc, 0x6E208400_u32 | sz | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vmul_4s(self: *mut Self, alloc: *mut AllocCap, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        try self.emit32(alloc, 0x4EA09C00_u32 | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vcmeq_int(self: *mut Self, alloc: *mut AllocCap, size_code: u8, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let sz = (size_code & 3_u8).widen.[u32]() <<% 22_u32;
        try self.emit32(alloc, 0x6E208C00_u32 | sz | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vcmgt_int(self: *mut Self, alloc: *mut AllocCap, size_code: u8, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let sz = (size_code & 3_u8).widen.[u32]() <<% 22_u32;
        try self.emit32(alloc, 0x4E203400_u32 | sz | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vfcmeq_vec(self: *mut Self, alloc: *mut AllocCap, is_f64: bool, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let op: u32 = if is_f64 { 0x4E60E400_u32 } else { 0x4E20E400_u32 };
        try self.emit32(alloc, op | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vfcmgt_vec(self: *mut Self, alloc: *mut AllocCap, is_f64: bool, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let op: u32 = if is_f64 { 0x6E60E400_u32 } else { 0x6E20E400_u32 };
        try self.emit32(alloc, op | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vfcmge_vec(self: *mut Self, alloc: *mut AllocCap, is_f64: bool, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let op: u32 = if is_f64 { 0x6EE0E400_u32 } else { 0x6EA0E400_u32 };
        try self.emit32(alloc, op | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vsmin_4s(self: *mut Self, alloc: *mut AllocCap, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        try self.emit32(alloc, 0x4EA06C00_u32 | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vsmax_4s(self: *mut Self, alloc: *mut AllocCap, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        try self.emit32(alloc, 0x4EA06400_u32 | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vdup_lane(self: *mut Self, alloc: *mut AllocCap, elem_bytes: u8, vd: u8, vn: u8, lane: u8) -> !OutOfMemory {
        // DUP Vd.T, Vn.Ts[lane]
        let imm5: u32 = if elem_bytes == 1_u8 {
            1_u32 | ((lane & 15_u8).widen.[u32]() <<% 1_u32)
        } else if elem_bytes == 2_u8 {
            2_u32 | ((lane & 7_u8).widen.[u32]() <<% 2_u32)
        } else if elem_bytes == 4_u8 {
            4_u32 | ((lane & 3_u8).widen.[u32]() <<% 3_u32)
        } else {
            8_u32 | ((lane & 1_u8).widen.[u32]() <<% 4_u32)
        };
        try self.emit32(alloc, 0x4E000400_u32 | (imm5 <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vshl_4s_imm(self: *mut Self, alloc: *mut AllocCap, vd: u8, vn: u8, sh: u8) -> !OutOfMemory {
        // SHL Vd.4S, Vn.4S, #sh (immh=0100 | sh[4:3], immb=sh[2:0] -> immh:immb = 32 + (sh & 31))
        let imm7 = (32_u32 +% (sh & 31_u8).widen.[u32]()) & 0x7F_u32;
        try self.emit32(alloc, 0x4F005400_u32 | (imm7 <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vushr_4s_imm(self: *mut Self, alloc: *mut AllocCap, vd: u8, vn: u8, sh: u8) -> !OutOfMemory {
        let s = sh & 31_u8;
        if s == 0_u8 {
            if vd != vn { try self.vmov_16b(alloc, vd, vn); }
            return;
        }
        let imm7 = (64_u32 -% s.widen.[u32]()) & 0x7F_u32;
        try self.emit32(alloc, 0x6F000400_u32 | (imm7 <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vsshr_4s_imm(self: *mut Self, alloc: *mut AllocCap, vd: u8, vn: u8, sh: u8) -> !OutOfMemory {
        let s = sh & 31_u8;
        if s == 0_u8 {
            if vd != vn { try self.vmov_16b(alloc, vd, vn); }
            return;
        }
        let imm7 = (64_u32 -% s.widen.[u32]()) & 0x7F_u32;
        try self.emit32(alloc, 0x4F000400_u32 | (imm7 <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vshl_8h_imm(self: *mut Self, alloc: *mut AllocCap, vd: u8, vn: u8, sh: u8) -> !OutOfMemory {
        let imm7 = (16_u32 +% (sh & 15_u8).widen.[u32]()) & 0x7F_u32;
        try self.emit32(alloc, 0x4F005400_u32 | (imm7 <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vumov_lane_to_gpr(self: *mut Self, alloc: *mut AllocCap, elem_bytes: u8, rd: u8, vn: u8, lane: u8) -> !OutOfMemory {
        // UMOV Wd/Xd, Vn.Ts[lane]
        if elem_bytes == 8_u8 {
            let imm5 = 8_u32 | ((lane & 1_u8).widen.[u32]() <<% 4_u32);
            try self.emit32(alloc, 0x4E003C00_u32 | (imm5 <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(rd));
        } else {
            let imm5: u32 = if elem_bytes == 1_u8 {
                1_u32 | ((lane & 15_u8).widen.[u32]() <<% 1_u32)
            } else if elem_bytes == 2_u8 {
                2_u32 | ((lane & 7_u8).widen.[u32]() <<% 2_u32)
            } else {
                4_u32 | ((lane & 3_u8).widen.[u32]() <<% 3_u32)
            };
            try self.emit32(alloc, 0x0E003C00_u32 | (imm5 <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(rd));
        }
        return;
    }

    pub fn vins_gpr_to_lane(self: *mut Self, alloc: *mut AllocCap, elem_bytes: u8, vd: u8, lane: u8, rn: u8) -> !OutOfMemory {
        // INS Vd.Ts[lane], Wn/Xn
        let imm5: u32 = if elem_bytes == 1_u8 {
            1_u32 | ((lane & 15_u8).widen.[u32]() <<% 1_u32)
        } else if elem_bytes == 2_u8 {
            2_u32 | ((lane & 7_u8).widen.[u32]() <<% 2_u32)
        } else if elem_bytes == 4_u8 {
            4_u32 | ((lane & 3_u8).widen.[u32]() <<% 3_u32)
        } else {
            8_u32 | ((lane & 1_u8).widen.[u32]() <<% 4_u32)
        };
        try self.emit32(alloc, 0x4E001C00_u32 | (imm5 <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vaddp_4s(self: *mut Self, alloc: *mut AllocCap, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        // FADDP Vd.4S, Vn.4S, Vm.4S
        try self.emit32(alloc, 0x6E20D400_u32 | (r5(vm) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }

    pub fn vfrsqrte_4s(self: *mut Self, alloc: *mut AllocCap, vd: u8, vn: u8) -> !OutOfMemory {
        // FRSQRTE Vd.4S, Vn.4S
        try self.emit32(alloc, 0x6EA1D800_u32 | (r5(vn) <<% 5_u32) | r5(vd));
        return;
    }
}

// ============================================================================
// Inline Assembly Encoder for AArch64 (`asm(...)` in `@hal` / `@naked`)
// ============================================================================

view fn trim_ws(s: *[u8]) -> *[u8] {
    var lo: usize = 0_usize;
    var hi = s.len;
    while lo < hi && (s[lo] == b' ' || s[lo] == b'\t' || s[lo] == b'\r' || s[lo] == b'\n') {
        lo = lo +% 1_usize;
    }
    while hi > lo && (s[hi - 1_usize] == b' ' || s[hi - 1_usize] == b'\t' || s[hi - 1_usize] == b'\r' || s[hi - 1_usize] == b'\n') {
        hi = hi - 1_usize;
    }
    return s.sub(lo, hi) catch { s };
}

fn parse_a64_reg(tok_in: *[u8]) -> ?u8 {
    let t = trim_ws(tok_in);
    if t.len < 2_usize {
        return null;
    }
    if str.bytes_eq(t, "sp".as_bytes()) {
        return SP;
    }
    if str.bytes_eq(t, "xzr".as_bytes()) || str.bytes_eq(t, "wzr".as_bytes()) {
        return XZR;
    }
    if str.bytes_eq(t, "fp".as_bytes()) { return 29_u8; }
    if str.bytes_eq(t, "lr".as_bytes()) { return 30_u8; }
    let c0 = t[0_usize];
    if c0 == b'x' || c0 == b'X' || c0 == b'w' || c0 == b'W' {
        var val: u32 = 0_u32;
        var i: usize = 1_usize;
        while i < t.len {
            let d = t[i];
            if d < b'0' || d > b'9' {
                return null;
            }
            val = (val *% 10_u32) +% (d -% b'0').widen.[u32]();
            i = i +% 1_usize;
        }
        if val <= 30_u32 {
            return val.trunc.[u8]();
        }
    }
    return null;
}

fn encode_a64_asm_line(alloc: *mut AllocCap, line_raw: *[u8], out: *mut A64Buf) -> bool ! OutOfMemory {
    let line = trim_ws(line_raw);
    if line.len == 0_usize || line[0_usize] == b';' {
        return true;
    }
    if str.bytes_eq(line, "nop".as_bytes()) { try out.nop(alloc); return true; }
    if str.bytes_eq(line, "ret".as_bytes()) { try out.ret(alloc); return true; }
    if str.bytes_eq(line, "svc #0".as_bytes()) || str.bytes_eq(line, "svc 0".as_bytes()) { try out.svc0(alloc); return true; }
    if str.bytes_eq(line, "hvc #0".as_bytes()) || str.bytes_eq(line, "hvc 0".as_bytes()) { try out.emit32(alloc, 0xD4000002_u32); return true; }
    if str.bytes_eq(line, "dmb sy".as_bytes()) { try out.emit32(alloc, 0xD5033FBF_u32); return true; }
    if str.bytes_eq(line, "dmb ish".as_bytes()) { try out.dmb_ish(alloc); return true; }
    if str.bytes_eq(line, "dsb sy".as_bytes()) { try out.dsb_sy(alloc); return true; }
    if str.bytes_eq(line, "isb".as_bytes()) { try out.isb(alloc); return true; }
    if str.bytes_eq(line, "yield".as_bytes()) { try out.emit32(alloc, 0xD503203F_u32); return true; }
    if str.bytes_eq(line, "wfe".as_bytes()) { try out.emit32(alloc, 0xD503205F_u32); return true; }
    if str.bytes_eq(line, "wfi".as_bytes()) { try out.emit32(alloc, 0xD503207F_u32); return true; }
    if str.bytes_eq(line, "brk #0".as_bytes()) || str.bytes_eq(line, "brk #1".as_bytes()) { try out.brk(alloc, 1_u16); return true; }

    // Split opcode and operands
    var sp_i: usize = 0_usize;
    while sp_i < line.len && line[sp_i] != b' ' && line[sp_i] != b'\t' {
        sp_i = sp_i +% 1_usize;
    }
    let op = line.sub(0_usize, sp_i) catch { "".as_bytes() };
    let rest = if sp_i < line.len { trim_ws(line.sub(sp_i, line.len) catch { "".as_bytes() }) } else { "".as_bytes() };

    if str.bytes_eq(op, "br".as_bytes()) {
        if let r = parse_a64_reg(rest) { try out.br(alloc, r); return true; }
    }
    if str.bytes_eq(op, "blr".as_bytes()) {
        if let r = parse_a64_reg(rest) { try out.blr(alloc, r); return true; }
    }
    // Two-operand instructions separated by ','
    var comma: usize = rest.len;
    var ci: usize = 0_usize;
    while ci < rest.len {
        if rest[ci] == b',' { comma = ci; break; }
        ci = ci +% 1_usize;
    }
    if comma < rest.len {
        let lhs = trim_ws(rest.sub(0_usize, comma) catch { "".as_bytes() });
        let rhs = trim_ws(rest.sub(comma +% 1_usize, rest.len) catch { "".as_bytes() });
        if str.bytes_eq(op, "mov".as_bytes()) {
            if let rd = parse_a64_reg(lhs) {
                if let rm = parse_a64_reg(rhs) {
                    try out.mov_rr(alloc, rd, rm);
                    return true;
                }
            }
        }
        if str.bytes_eq(op, "mrs".as_bytes()) && str.bytes_eq(rhs, "tpidr_el0".as_bytes()) {
            if let rd = parse_a64_reg(lhs) { try out.mrs_tpidr_el0(alloc, rd); return true; }
        }
        if str.bytes_eq(op, "msr".as_bytes()) && str.bytes_eq(lhs, "tpidr_el0".as_bytes()) {
            if let rt = parse_a64_reg(rhs) { try out.msr_tpidr_el0(alloc, rt); return true; }
        }
    }
    return false;
}

pub fn encode_a64_inline_asm(alloc: *mut AllocCap, text: *[u8], out: *mut A64Buf) -> bool ! OutOfMemory {
    var start: usize = 0_usize;
    var i: usize = 0_usize;
    while i <= text.len {
        let is_sep = if i < text.len {
            text[i] == b'\n' || text[i] == b';'
        } else {
            true
        };
        if is_sep {
            let line = text.sub(start, i) catch { "".as_bytes() };
            let ok_line = try encode_a64_asm_line(alloc, line, out);
            if !ok_line {
                return false;
            }
            start = i +% 1_usize;
        }
        i = i +% 1_usize;
    }
    return true;
}

// ============================================================================
// AArch64 Linux Runtime Helpers (`asm-generic/unistd.h` via `svc #0`)
// ============================================================================
//
// Syscall numbers (Linux AArch64 / asm-generic):
//   SYS_mkdirat=34, SYS_openat=56, SYS_close=57, SYS_read=63, SYS_write=64,
//   SYS_newfstatat=79, SYS_fstat=80, SYS_exit=93, SYS_exit_group=94,
//   SYS_futex=98, SYS_clock_gettime=113, SYS_sched_yield=124,
//   SYS_munmap=215, SYS_clone=220, SYS_execve=221, SYS_mmap=222,
//   SYS_mprotect=226, SYS_wait4=260, SYS_openat2=437.

const SYS_A64_MKDIRAT: u64 = 34_u64;
const SYS_A64_OPENAT: u64 = 56_u64;
const SYS_A64_CLOSE: u64 = 57_u64;
const SYS_A64_READ: u64 = 63_u64;
const SYS_A64_WRITE: u64 = 64_u64;
const SYS_A64_NEWFSTATAT: u64 = 79_u64;
const SYS_A64_EXIT: u64 = 93_u64;
pub const SYS_A64_EXIT_GROUP: u64 = 94_u64;
const SYS_A64_CLOCK_GETTIME: u64 = 113_u64;
const SYS_A64_MUNMAP: u64 = 215_u64;
const SYS_A64_CLONE: u64 = 220_u64;
const SYS_A64_EXECVE: u64 = 221_u64;
const SYS_A64_MMAP: u64 = 222_u64;
const SYS_A64_MPROTECT: u64 = 226_u64;
const SYS_A64_WAIT4: u64 = 260_u64;

fn emit_a64_mmap_anon(alloc: *mut AllocCap, b: *mut A64Buf, size_reg: u8) -> !OutOfMemory {
    // mmap(NULL, size, PROT_READ|PROT_WRITE(3), MAP_PRIVATE|MAP_ANONYMOUS(0x22), -1, 0)
    if size_reg != X1 {
        try b.mov_rr(alloc, X1, size_reg);
    }
    try b.mov_imm64(alloc, X0, 0_u64);
    try b.mov_imm64(alloc, X2, 3_u64);
    try b.mov_imm64(alloc, X3, 0x22_u64);
    try b.mov_imm64(alloc, X4, 0xFFFFFFFFFFFFFFFF_u64);
    try b.mov_imm64(alloc, X5, 0_u64);
    try b.mov_imm64(alloc, X8, SYS_A64_MMAP);
    try b.svc0(alloc);
    return;
}

/// `eon_alloc_raw(alloc_cap: x0, size: x1, align: x2) -> ptr in x0` (zeroed; bumps fast slab or mmap).
/// Layout of header right before returned pointer (`[ptr - 24]` = mmap_base, `[ptr - 16]` = mmap_len, `[ptr - 8]` = req_size).
fn emit_a64_alloc_raw(alloc: *mut AllocCap, b: *mut A64Buf, zeroed: bool) -> !OutOfMemory {
    _ = zeroed; // Anonymous Linux mmap pages are kernel-zeroed by guarantee!
    let l_nonzero = try b.new_label(alloc);
    try b.cbnz_label(alloc, true, X1, l_nonzero);
    try b.mov_imm64(alloc, X0, 0_u64);
    try b.mov_imm64(alloc, X8, 0_u64);
    try b.ret(alloc);
    b.bind_label(l_nonzero);

    try b.stp64_pre(alloc, X29_FP, X30_LR, SP, -48_i32);
    try b.mov_rr(alloc, X29_FP, SP);
    try b.stp64(alloc, X19, X20, SP, 16_i32);
    try b.stp64(alloc, X21, X22, SP, 32_i32);

    try b.mov_rr(alloc, X19, X0); // alloc_cap*
    try b.mov_rr(alloc, X20, X1); // req size
    // Ensure req_size >= 16 and align >= 16
    let l_sz_ok = try b.new_label(alloc);
    try b.cmp_imm(alloc, true, X20, 16_u16);
    try b.b_cond_label(alloc, .Cs, l_sz_ok);
    try b.mov_imm64(alloc, X20, 16_u64);
    b.bind_label(l_sz_ok);

    try b.mov_rr(alloc, X21, X2);
    let l_al_ok = try b.new_label(alloc);
    try b.cmp_imm(alloc, true, X21, 16_u16);
    try b.b_cond_label(alloc, .Cs, l_al_ok);
    try b.mov_imm64(alloc, X21, 16_u64);
    b.bind_label(l_al_ok);

    // total_map = align_up(req_size + align + 32, 4096)
    try b.add_rr(alloc, true, false, X22, X20, X21);
    try b.add_imm(alloc, true, false, X22, X22, 32_u16, false);
    try b.add_imm(alloc, true, false, X22, X22, 4095_u16, false);
    try b.lsr_imm(alloc, true, X22, X22, 12_u8);
    try b.lsl_imm(alloc, true, X22, X22, 12_u8);

    // Check AllocCap budget (`[x19+24]` = limit, `[x19+8]` = used) if x19 != 0
    let l_do_mmap = try b.new_label(alloc);
    let l_oom = try b.new_label(alloc);
    try b.cbz_label(alloc, true, X19, l_do_mmap);
    try b.load_mem(alloc, X9, X19, 24_i32, 8_u8, false, X16); // budget
    try b.cbz_label(alloc, true, X9, l_do_mmap);
    try b.load_mem(alloc, X10, X19, 8_i32, 8_u8, false, X16); // used
    try b.add_rr(alloc, true, false, X11, X10, X20);
    try b.cmp_rr(alloc, true, X11, X9);
    try b.b_cond_label(alloc, .Hi, l_oom);

    b.bind_label(l_do_mmap);
    try emit_a64_mmap_anon(alloc, b, X22);
    // mmap error if x0 >= -4095 (unsigned)
    try b.mov_imm64(alloc, X9, 0xFFFFFFFFFFFFF001_u64);
    try b.cmp_rr(alloc, true, X0, X9);
    try b.b_cond_label(alloc, .Cs, l_oom);

    // user_ptr = align_up(base + 24, align)
    try b.add_imm(alloc, true, false, X9, X0, 24_u16, false);
    try b.sub_imm(alloc, true, false, X10, X21, 1_u16, false);
    try b.add_rr(alloc, true, false, X9, X9, X10);
    try b.mvn_rr(alloc, true, X11, X10);
    try b.and_rr(alloc, true, false, X9, X9, X11);

    // Store header right before user_ptr: [ptr - 24] = base, [ptr - 16] = total_map, [ptr - 8] = req_size
    try b.store_mem(alloc, X9, -24_i32, X0, 8_u8, X16);
    try b.store_mem(alloc, X9, -16_i32, X22, 8_u8, X16);
    try b.store_mem(alloc, X9, -8_i32, X20, 8_u8, X16);

    // Update AllocCap accounting (`[x19+0]` = live_allocs, `[x19+8]` = used, `[x19+16]` = peak)
    let l_done = try b.new_label(alloc);
    try b.cbz_label(alloc, true, X19, l_done);
    try b.load_mem(alloc, X10, X19, 0_i32, 8_u8, false, X16);
    try b.add_imm(alloc, true, false, X10, X10, 1_u16, false);
    try b.store_mem(alloc, X19, 0_i32, X10, 8_u8, X16);
    try b.load_mem(alloc, X10, X19, 8_i32, 8_u8, false, X16);
    try b.add_rr(alloc, true, false, X10, X10, X20);
    try b.store_mem(alloc, X19, 8_i32, X10, 8_u8, X16);
    try b.load_mem(alloc, X11, X19, 16_i32, 8_u8, false, X16);
    try b.cmp_rr(alloc, true, X10, X11);
    try b.b_cond_label(alloc, .Ls, l_done);
    try b.store_mem(alloc, X19, 16_i32, X10, 8_u8, X16);

    b.bind_label(l_done);
    try b.mov_rr(alloc, X0, X9);
    try b.mov_imm64(alloc, X8, 0_u64); // Ok
    try b.ldp64(alloc, X21, X22, SP, 32_i32);
    try b.ldp64(alloc, X19, X20, SP, 16_i32);
    try b.ldp64_post(alloc, X29_FP, X30_LR, SP, 48_i32);
    try b.ret(alloc);

    b.bind_label(l_oom);
    try b.mov_imm64(alloc, X0, 0_u64);
    try b.mov_imm64(alloc, X8, 1_u64); // OutOfMemory error tag
    try b.ldp64(alloc, X21, X22, SP, 32_i32);
    try b.ldp64(alloc, X19, X20, SP, 16_i32);
    try b.ldp64_post(alloc, X29_FP, X30_LR, SP, 48_i32);
    try b.ret(alloc);
    return;
}

/// `eon_free_raw(alloc_cap: x0, ptr: x1, size: x2, align: x3)`
fn emit_a64_free_raw(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    let l_ret = try b.new_label(alloc);
    try b.cbz_label(alloc, true, X1, l_ret);
    // Load header [x1 - 24] = base, [x1 - 16] = map_len, [x1 - 8] = req_size
    try b.load_mem(alloc, X9, X1, -24_i32, 8_u8, false, X16);
    try b.load_mem(alloc, X10, X1, -16_i32, 8_u8, false, X16);
    try b.load_mem(alloc, X11, X1, -8_i32, 8_u8, false, X16);

    let l_unmap = try b.new_label(alloc);
    try b.cbz_label(alloc, true, X0, l_unmap);
    try b.load_mem(alloc, X12, X0, 0_i32, 8_u8, false, X16);
    let l_skip_dec = try b.new_label(alloc);
    try b.cbz_label(alloc, true, X12, l_skip_dec);
    try b.sub_imm(alloc, true, false, X12, X12, 1_u16, false);
    try b.store_mem(alloc, X0, 0_i32, X12, 8_u8, X16);
    b.bind_label(l_skip_dec);
    try b.load_mem(alloc, X12, X0, 8_i32, 8_u8, false, X16);
    try b.cmp_rr(alloc, true, X12, X11);
    let l_zero_u = try b.new_label(alloc);
    try b.b_cond_label(alloc, .Cc, l_zero_u);
    try b.sub_rr(alloc, true, false, X12, X12, X11);
    try b.store_mem(alloc, X0, 8_i32, X12, 8_u8, X16);
    try b.b_label(alloc, l_unmap);
    b.bind_label(l_zero_u);
    try b.store_mem(alloc, X0, 8_i32, XZR, 8_u8, X16);

    b.bind_label(l_unmap);
    try b.mov_rr(alloc, X0, X9);
    try b.mov_rr(alloc, X1, X10);
    try b.mov_imm64(alloc, X8, SYS_A64_MUNMAP);
    try b.svc0(alloc);
    b.bind_label(l_ret);
    try b.ret(alloc);
    return;
}

/// `eon_arena_alloc_aligned(arena: x0, size: x1, align: x2) -> ptr in x0`
/// Arena layout: `[0]=base, [8]=cap, [16]=cursor`.
fn emit_a64_arena_alloc(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    try b.load_mem(alloc, X9, X0, 0_i32, 8_u8, false, X16);   // base
    try b.load_mem(alloc, X10, X0, 8_i32, 8_u8, false, X16);  // cap
    try b.load_mem(alloc, X11, X0, 16_i32, 8_u8, false, X16); // cursor
    // align_m1 = max(align, 1) - 1
    let l_al_ok = try b.new_label(alloc);
    try b.cbnz_label(alloc, true, X2, l_al_ok);
    try b.mov_imm64(alloc, X2, 1_u64);
    b.bind_label(l_al_ok);
    try b.sub_imm(alloc, true, false, X12, X2, 1_u16, false);
    try b.add_rr(alloc, true, false, X13, X11, X12);
    try b.mvn_rr(alloc, true, X14, X12);
    try b.and_rr(alloc, true, false, X13, X13, X14); // aligned_off
    try b.add_rr(alloc, true, false, X14, X13, X1);  // new_cursor
    try b.cmp_rr(alloc, true, X14, X10);
    let l_oom = try b.new_label(alloc);
    try b.b_cond_label(alloc, .Hi, l_oom);
    try b.store_mem(alloc, X0, 16_i32, X14, 8_u8, X16);
    try b.add_rr(alloc, true, false, X0, X9, X13);
    try b.mov_imm64(alloc, X8, 0_u64);
    try b.ret(alloc);
    b.bind_label(l_oom);
    try b.mov_imm64(alloc, X0, 0_u64);
    try b.mov_imm64(alloc, X8, 1_u64);
    try b.ret(alloc);
    return;
}

/// `eon_rt_tls_init()`: initializes Variant I TLS in `tpidr_el0` pointing to `__eon_main_tcb` (if unset).
fn emit_a64_tls_init(alloc: *mut AllocCap, interner: *mut span.SymInterner, b: *mut A64Buf) -> !OutOfMemory {
    // Only set TPIDR_EL0 if currently zero (dynamic loader ld.so may already have set it)
    let l_done = try b.new_label(alloc);
    try b.mrs_tpidr_el0(alloc, X9);
    try b.cbnz_label(alloc, true, X9, l_done);
    let s_tcb = try interner.intern_str(alloc, "__eon_main_tcb");
    try b.lea_sym(alloc, X9, s_tcb, 0_i64);
    try b.msr_tpidr_el0(alloc, X9);
    // Copy .tdata into [tcb + 16 ..]
    let s_td_s = try interner.intern_str(alloc, "__eon_tdata_start");
    let s_td_e = try interner.intern_str(alloc, "__eon_tdata_end");
    try b.lea_sym(alloc, X10, s_td_s, 0_i64);
    try b.lea_sym(alloc, X11, s_td_e, 0_i64);
    try b.add_imm(alloc, true, false, X12, X9, 16_u16, false);
    let l_lp = try b.new_label(alloc);
    b.bind_label(l_lp);
    try b.cmp_rr(alloc, true, X10, X11);
    try b.b_cond_label(alloc, .Cs, l_done);
    try b.load_mem(alloc, X13, X10, 0_i32, 1_u8, false, X16);
    try b.store_mem(alloc, X12, 0_i32, X13, 1_u8, X16);
    try b.add_imm(alloc, true, false, X10, X10, 1_u16, false);
    try b.add_imm(alloc, true, false, X12, X12, 1_u16, false);
    try b.b_label(alloc, l_lp);
    b.bind_label(l_done);
    try b.ret(alloc);
    return;
}

/// `eon_rt_now_ns() -> u64` (`clock_gettime(CLOCK_MONOTONIC=1, &ts)` -> `sec*1e9 + nsec`).
fn emit_a64_now_ns(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    try b.sub_imm(alloc, true, false, SP, SP, 16_u16, false);
    try b.mov_imm64(alloc, X0, 1_u64); // CLOCK_MONOTONIC
    try b.mov_rr(alloc, X1, SP);
    try b.mov_imm64(alloc, X8, SYS_A64_CLOCK_GETTIME);
    try b.svc0(alloc);
    try b.load_mem(alloc, X0, SP, 0_i32, 8_u8, false, X16);
    try b.load_mem(alloc, X1, SP, 8_i32, 8_u8, false, X16);
    try b.add_imm(alloc, true, false, SP, SP, 16_u16, false);
    try b.mov_imm64(alloc, X2, 1000000000_u64);
    try b.mul_rr(alloc, true, X0, X0, X2);
    try b.add_rr(alloc, true, false, X0, X0, X1);
    try b.ret(alloc);
    return;
}

/// `eon_rt_write_fd(fd: x0, ptr: x1, len: x2) -> i64`
fn emit_a64_write_fd(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    try b.mov_imm64(alloc, X8, SYS_A64_WRITE);
    try b.svc0(alloc);
    try b.ret(alloc);
    return;
}

/// `eon_rt_read_fd(fd: x0, ptr: x1, len: x2) -> i64`
fn emit_a64_read_fd(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    try b.mov_imm64(alloc, X8, SYS_A64_READ);
    try b.svc0(alloc);
    try b.ret(alloc);
    return;
}

/// `eon_rt_close_fd(fd: x0) -> i64`
fn emit_a64_close_fd(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    try b.mov_imm64(alloc, X8, SYS_A64_CLOSE);
    try b.svc0(alloc);
    try b.ret(alloc);
    return;
}

/// `eon_rt_write_all_to_fd(ptr: x0, len: x1)` writing to fixed `fd` (1=stdout, 2=stderr).
fn emit_a64_write_all_to_fd(alloc: *mut AllocCap, b: *mut A64Buf, fd: u64) -> !OutOfMemory {
    try b.mov_rr(alloc, X2, X1);
    try b.mov_rr(alloc, X1, X0);
    try b.mov_imm64(alloc, X0, fd);
    let l_lp = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    b.bind_label(l_lp);
    try b.cbz_label(alloc, true, X2, l_done);
    try b.mov_imm64(alloc, X8, SYS_A64_WRITE);
    try b.svc0(alloc);
    try b.cmp_imm(alloc, true, X0, 0_u16);
    try b.b_cond_label(alloc, .Le, l_done);
    try b.add_rr(alloc, true, false, X1, X1, X0);
    try b.sub_rr(alloc, true, false, X2, X2, X0);
    try b.mov_imm64(alloc, X0, fd);
    try b.b_label(alloc, l_lp);
    b.bind_label(l_done);
    try b.ret(alloc);
    return;
}

fn emit_a64_print_nl(alloc: *mut AllocCap, b: *mut A64Buf, fd: u64) -> !OutOfMemory {
    try b.sub_imm(alloc, true, false, SP, SP, 16_u16, false);
    try b.mov_imm64(alloc, X9, 10_u64); // '\n'
    try b.store_mem(alloc, SP, 0_i32, X9, 1_u8, X16);
    try b.mov_imm64(alloc, X0, fd);
    try b.mov_rr(alloc, X1, SP);
    try b.mov_imm64(alloc, X2, 1_u64);
    try b.mov_imm64(alloc, X8, SYS_A64_WRITE);
    try b.svc0(alloc);
    try b.add_imm(alloc, true, false, SP, SP, 16_u16, false);
    try b.ret(alloc);
    return;
}

/// `eon_rt_print_u64(val: x0)`
fn emit_a64_print_u64(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    try b.sub_imm(alloc, true, false, SP, SP, 32_u16, false);
    try b.add_imm(alloc, true, false, X9, SP, 32_u16, false); // write cursor from end
    try b.mov_imm64(alloc, X10, 10_u64);
    let l_lp = try b.new_label(alloc);
    b.bind_label(l_lp);
    try b.udiv_rr(alloc, true, X11, X0, X10);      // q = val / 10
    try b.msub_rrr(alloc, true, X12, X11, X10, X0);// r = val - q * 10
    try b.add_imm(alloc, true, false, X12, X12, 48_u16, false);
    try b.sub_imm(alloc, true, false, X9, X9, 1_u16, false);
    try b.store_mem(alloc, X9, 0_i32, X12, 1_u8, X16);
    try b.mov_rr(alloc, X0, X11);
    try b.cbnz_label(alloc, true, X0, l_lp);

    try b.add_imm(alloc, true, false, X2, SP, 32_u16, false);
    try b.sub_rr(alloc, true, false, X2, X2, X9);
    try b.mov_rr(alloc, X1, X9);
    try b.mov_imm64(alloc, X0, 1_u64);
    try b.mov_imm64(alloc, X8, SYS_A64_WRITE);
    try b.svc0(alloc);
    try b.add_imm(alloc, true, false, SP, SP, 32_u16, false);
    try b.ret(alloc);
    return;
}

/// `eon_rt_print_i64(val: x0)`
fn emit_a64_print_i64(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    try b.sub_imm(alloc, true, false, SP, SP, 32_u16, false);
    try b.mov_imm64(alloc, X13, 0_u64); // is_neg
    let l_pos = try b.new_label(alloc);
    try b.cmp_imm(alloc, true, X0, 0_u16);
    try b.b_cond_label(alloc, .Ge, l_pos);
    try b.mov_imm64(alloc, X13, 1_u64);
    try b.neg_rr(alloc, true, false, X0, X0);
    b.bind_label(l_pos);

    try b.add_imm(alloc, true, false, X9, SP, 32_u16, false);
    try b.mov_imm64(alloc, X10, 10_u64);
    let l_lp = try b.new_label(alloc);
    b.bind_label(l_lp);
    try b.udiv_rr(alloc, true, X11, X0, X10);
    try b.msub_rrr(alloc, true, X12, X11, X10, X0);
    try b.add_imm(alloc, true, false, X12, X12, 48_u16, false);
    try b.sub_imm(alloc, true, false, X9, X9, 1_u16, false);
    try b.store_mem(alloc, X9, 0_i32, X12, 1_u8, X16);
    try b.mov_rr(alloc, X0, X11);
    try b.cbnz_label(alloc, true, X0, l_lp);

    let l_wr = try b.new_label(alloc);
    try b.cbz_label(alloc, true, X13, l_wr);
    try b.mov_imm64(alloc, X12, 45_u64); // '-'
    try b.sub_imm(alloc, true, false, X9, X9, 1_u16, false);
    try b.store_mem(alloc, X9, 0_i32, X12, 1_u8, X16);

    b.bind_label(l_wr);
    try b.add_imm(alloc, true, false, X2, SP, 32_u16, false);
    try b.sub_rr(alloc, true, false, X2, X2, X9);
    try b.mov_rr(alloc, X1, X9);
    try b.mov_imm64(alloc, X0, 1_u64);
    try b.mov_imm64(alloc, X8, SYS_A64_WRITE);
    try b.svc0(alloc);
    try b.add_imm(alloc, true, false, SP, SP, 32_u16, false);
    try b.ret(alloc);
    return;
}

/// `eon_rt_validate_utf8(ptr: x0, len: x1) -> bool in x0` (1=valid, 0=invalid).
fn emit_a64_validate_utf8(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    // Fast RFC 3629 UTF-8 validator
    try b.mov_imm64(alloc, X9, 0_u64); // i
    let l_lp = try b.new_label(alloc);
    let l_ok = try b.new_label(alloc);
    let l_bad = try b.new_label(alloc);
    b.bind_label(l_lp);
    try b.cmp_rr(alloc, true, X9, X1);
    try b.b_cond_label(alloc, .Cs, l_ok);
    try b.add_rr(alloc, true, false, X10, X0, X9);
    try b.load_mem(alloc, X11, X10, 0_i32, 1_u8, false, X16);
    try b.cmp_imm(alloc, true, X11, 0x80_u16);
    let l_mb = try b.new_label(alloc);
    try b.b_cond_label(alloc, .Cs, l_mb);
    try b.add_imm(alloc, true, false, X9, X9, 1_u16, false);
    try b.b_label(alloc, l_lp);

    b.bind_label(l_mb);
    // 2-byte: 0xC2..0xDF
    try b.cmp_imm(alloc, true, X11, 0xC2_u16);
    try b.b_cond_label(alloc, .Cc, l_bad);
    try b.cmp_imm(alloc, true, X11, 0xE0_u16);
    let l_chk3 = try b.new_label(alloc);
    try b.b_cond_label(alloc, .Cs, l_chk3);
    try b.add_imm(alloc, true, false, X12, X9, 2_u16, false);
    try b.cmp_rr(alloc, true, X12, X1);
    try b.b_cond_label(alloc, .Hi, l_bad);
    try b.load_mem(alloc, X13, X10, 1_i32, 1_u8, false, X16);
    try b.mov_imm64(alloc, X14, 0xC0_u64);
    try b.and_rr(alloc, true, false, X13, X13, X14);
    try b.cmp_imm(alloc, true, X13, 0x80_u16);
    try b.b_cond_label(alloc, .Ne, l_bad);
    try b.mov_rr(alloc, X9, X12);
    try b.b_label(alloc, l_lp);

    b.bind_label(l_chk3);
    // 3-byte: 0xE0..0xEF
    try b.cmp_imm(alloc, true, X11, 0xF0_u16);
    let l_chk4 = try b.new_label(alloc);
    try b.b_cond_label(alloc, .Cs, l_chk4);
    try b.add_imm(alloc, true, false, X12, X9, 3_u16, false);
    try b.cmp_rr(alloc, true, X12, X1);
    try b.b_cond_label(alloc, .Hi, l_bad);
    try b.load_mem(alloc, X13, X10, 1_i32, 1_u8, false, X16);
    try b.load_mem(alloc, X15, X10, 2_i32, 1_u8, false, X16);
    try b.mov_imm64(alloc, X14, 0xC0_u64);
    try b.and_rr(alloc, true, false, X16, X13, X14);
    try b.cmp_imm(alloc, true, X16, 0x80_u16);
    try b.b_cond_label(alloc, .Ne, l_bad);
    try b.and_rr(alloc, true, false, X16, X15, X14);
    try b.cmp_imm(alloc, true, X16, 0x80_u16);
    try b.b_cond_label(alloc, .Ne, l_bad);
    // Reject E0 overlong (b1 < 0xA0) and ED surrogates (b1 >= 0xA0)
    let l_3ok = try b.new_label(alloc);
    try b.cmp_imm(alloc, true, X11, 0xE0_u16);
    let l_chk_ed = try b.new_label(alloc);
    try b.b_cond_label(alloc, .Ne, l_chk_ed);
    try b.cmp_imm(alloc, true, X13, 0xA0_u16);
    try b.b_cond_label(alloc, .Cc, l_bad);
    try b.b_label(alloc, l_3ok);
    b.bind_label(l_chk_ed);
    try b.cmp_imm(alloc, true, X11, 0xED_u16);
    try b.b_cond_label(alloc, .Ne, l_3ok);
    try b.cmp_imm(alloc, true, X13, 0xA0_u16);
    try b.b_cond_label(alloc, .Cs, l_bad);
    b.bind_label(l_3ok);
    try b.mov_rr(alloc, X9, X12);
    try b.b_label(alloc, l_lp);

    b.bind_label(l_chk4);
    // 4-byte: 0xF0..0xF4
    try b.cmp_imm(alloc, true, X11, 0xF5_u16);
    try b.b_cond_label(alloc, .Cs, l_bad);
    try b.add_imm(alloc, true, false, X12, X9, 4_u16, false);
    try b.cmp_rr(alloc, true, X12, X1);
    try b.b_cond_label(alloc, .Hi, l_bad);
    try b.load_mem(alloc, X13, X10, 1_i32, 1_u8, false, X16);
    try b.load_mem(alloc, X15, X10, 2_i32, 1_u8, false, X16);
    try b.mov_imm64(alloc, X14, 0xC0_u64);
    try b.and_rr(alloc, true, false, X16, X13, X14);
    try b.cmp_imm(alloc, true, X16, 0x80_u16);
    try b.b_cond_label(alloc, .Ne, l_bad);
    try b.and_rr(alloc, true, false, X16, X15, X14);
    try b.cmp_imm(alloc, true, X16, 0x80_u16);
    try b.b_cond_label(alloc, .Ne, l_bad);
    try b.load_mem(alloc, X15, X10, 3_i32, 1_u8, false, X16);
    try b.and_rr(alloc, true, false, X16, X15, X14);
    try b.cmp_imm(alloc, true, X16, 0x80_u16);
    try b.b_cond_label(alloc, .Ne, l_bad);
    let l_4ok = try b.new_label(alloc);
    try b.cmp_imm(alloc, true, X11, 0xF0_u16);
    let l_chk_f4 = try b.new_label(alloc);
    try b.b_cond_label(alloc, .Ne, l_chk_f4);
    try b.cmp_imm(alloc, true, X13, 0x90_u16);
    try b.b_cond_label(alloc, .Cc, l_bad);
    try b.b_label(alloc, l_4ok);
    b.bind_label(l_chk_f4);
    try b.cmp_imm(alloc, true, X11, 0xF4_u16);
    try b.b_cond_label(alloc, .Ne, l_4ok);
    try b.cmp_imm(alloc, true, X13, 0x90_u16);
    try b.b_cond_label(alloc, .Cs, l_bad);
    b.bind_label(l_4ok);
    try b.mov_rr(alloc, X9, X12);
    try b.b_label(alloc, l_lp);

    b.bind_label(l_ok);
    try b.mov_imm64(alloc, X0, 1_u64);
    try b.ret(alloc);
    b.bind_label(l_bad);
    try b.mov_imm64(alloc, X0, 0_u64);
    try b.ret(alloc);
    return;
}

/// `eon_rt_openat2_beneath(dir_fd: x0, path_ptr: x1, flags: x2, mode: x3) -> fd or -errno in x0`
fn emit_a64_openat_beneath(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    // openat(dir_fd, path_ptr, flags, mode) via SYS_openat(56)
    try b.mov_imm64(alloc, X8, SYS_A64_OPENAT);
    try b.svc0(alloc);
    try b.ret(alloc);
    return;
}

/// `eon_rt_is_dir(dirfd: x0, path_ptr: x1, path_len: x2) -> bool in x0`
fn emit_a64_is_dir(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    // Copy path to NUL-terminated buffer on stack (512 bytes) + 144 bytes statbuf = 656 bytes
    let l_no = try b.new_label(alloc);
    try b.cbz_label(alloc, true, X1, l_no);
    try b.cbz_label(alloc, true, X2, l_no);
    try b.cmp_imm(alloc, true, X2, 511_u16);
    try b.b_cond_label(alloc, .Cs, l_no);
    try b.sub_imm(alloc, true, false, SP, SP, 656_u16, false);
    // Copy x2 bytes from x1 to [SP + 144]
    try b.add_imm(alloc, true, false, X9, SP, 144_u16, false);
    try b.mov_imm64(alloc, X10, 0_u64);
    let l_cp = try b.new_label(alloc);
    let l_cp_done = try b.new_label(alloc);
    b.bind_label(l_cp);
    try b.cmp_rr(alloc, true, X10, X2);
    try b.b_cond_label(alloc, .Cs, l_cp_done);
    try b.add_rr(alloc, true, false, X11, X1, X10);
    try b.load_mem(alloc, X12, X11, 0_i32, 1_u8, false, X16);
    try b.add_rr(alloc, true, false, X11, X9, X10);
    try b.store_mem(alloc, X11, 0_i32, X12, 1_u8, X16);
    try b.add_imm(alloc, true, false, X10, X10, 1_u16, false);
    try b.b_label(alloc, l_cp);
    b.bind_label(l_cp_done);
    try b.add_rr(alloc, true, false, X11, X9, X2);
    try b.store_mem(alloc, X11, 0_i32, XZR, 1_u8, X16);
    // newfstatat(dirfd=x0, path=x9, statbuf=SP, flags=0); AArch64 struct stat st_mode is at offset 16 (u32)!
    try b.mov_rr(alloc, X1, X9);
    try b.mov_rr(alloc, X2, SP);
    try b.mov_imm64(alloc, X3, 0_u64);
    try b.mov_imm64(alloc, X8, SYS_A64_NEWFSTATAT);
    try b.svc0(alloc);
    let l_st_no = try b.new_label(alloc);
    try b.cbnz_label(alloc, true, X0, l_st_no);
    try b.load_mem(alloc, X9, SP, 16_i32, 4_u8, false, X16);
    try b.mov_imm64(alloc, X10, 0xF000_u64);
    try b.and_rr(alloc, true, false, X9, X9, X10);
    try b.mov_imm64(alloc, X10, 0x4000_u64); // S_IFDIR
    try b.cmp_rr(alloc, true, X9, X10);
    try b.cset(alloc, true, X0, .Eq);
    try b.add_imm(alloc, true, false, SP, SP, 656_u16, false);
    try b.ret(alloc);
    b.bind_label(l_st_no);
    try b.add_imm(alloc, true, false, SP, SP, 656_u16, false);
    b.bind_label(l_no);
    try b.mov_imm64(alloc, X0, 0_u64);
    try b.ret(alloc);
    return;
}

/// `eon_rt_mkdir_all(dirfd: x0, path_ptr: x1, path_len: x2) -> i64`
fn emit_a64_mkdir_all(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    let l_inval = try b.new_label(alloc);
    try b.cbz_label(alloc, true, X1, l_inval);
    try b.cbz_label(alloc, true, X2, l_inval);
    try b.cmp_imm(alloc, true, X2, 511_u16);
    try b.b_cond_label(alloc, .Cs, l_inval);
    try b.sub_imm(alloc, true, false, SP, SP, 512_u16, false);
    try b.mov_imm64(alloc, X10, 0_u64);
    let l_cp = try b.new_label(alloc);
    let l_cp_done = try b.new_label(alloc);
    b.bind_label(l_cp);
    try b.cmp_rr(alloc, true, X10, X2);
    try b.b_cond_label(alloc, .Cs, l_cp_done);
    try b.add_rr(alloc, true, false, X11, X1, X10);
    try b.load_mem(alloc, X12, X11, 0_i32, 1_u8, false, X16);
    try b.add_rr(alloc, true, false, X11, SP, X10);
    try b.store_mem(alloc, X11, 0_i32, X12, 1_u8, X16);
    try b.add_imm(alloc, true, false, X10, X10, 1_u16, false);
    try b.b_label(alloc, l_cp);
    b.bind_label(l_cp_done);
    try b.add_rr(alloc, true, false, X11, SP, X2);
    try b.store_mem(alloc, X11, 0_i32, XZR, 1_u8, X16);

    try b.mov_rr(alloc, X1, SP);
    try b.mov_imm64(alloc, X2, 0x1ED_u64); // 0755
    try b.mov_imm64(alloc, X8, SYS_A64_MKDIRAT);
    try b.svc0(alloc);
    // Treat EEXIST (-17) as 0
    try b.cmn_imm(alloc, true, X0, 17_u16);
    let l_ret = try b.new_label(alloc);
    try b.b_cond_label(alloc, .Ne, l_ret);
    try b.mov_imm64(alloc, X0, 0_u64);
    b.bind_label(l_ret);
    try b.add_imm(alloc, true, false, SP, SP, 512_u16, false);
    try b.ret(alloc);
    b.bind_label(l_inval);
    try b.mov_imm64(alloc, X0, 0xFFFFFFFFFFFFFFEA_u64); // -EINVAL
    try b.ret(alloc);
    return;
}

/// `eon_f16_to_f32(bits: w0) -> s0` (IEEE 754 binary16 -> binary32 via software bit conversion).
fn emit_a64_f16_to_f32(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    // sign = (x0 & 0x8000) << 16
    try b.mov_imm64(alloc, X9, 0x8000_u64);
    try b.and_rr(alloc, false, false, X9, X0, X9);
    try b.lsl_imm(alloc, false, X9, X9, 16_u8);
    // exp = (x0 >> 10) & 0x1F
    try b.lsr_imm(alloc, false, X10, X0, 10_u8);
    try b.mov_imm64(alloc, X11, 0x1F_u64);
    try b.and_rr(alloc, false, false, X10, X10, X11);
    // frac = x0 & 0x3FF
    try b.mov_imm64(alloc, X11, 0x3FF_u64);
    try b.and_rr(alloc, false, false, X11, X0, X11);

    let l_nz_exp = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    let l_inf = try b.new_label(alloc);
    try b.cbnz_label(alloc, false, X10, l_nz_exp);
    // exp == 0 -> signed zero (or subnormal -> zero)
    try b.mov_rr(alloc, X0, X9);
    try b.b_label(alloc, l_done);

    b.bind_label(l_nz_exp);
    try b.cmp_imm(alloc, false, X10, 31_u16);
    try b.b_cond_label(alloc, .Eq, l_inf);
    // Normal: ((exp + 112) << 23) | (frac << 13) | sign
    try b.add_imm(alloc, false, false, X10, X10, 112_u16, false);
    try b.lsl_imm(alloc, false, X10, X10, 23_u8);
    try b.lsl_imm(alloc, false, X11, X11, 13_u8);
    try b.orr_rr(alloc, false, X0, X9, X10);
    try b.orr_rr(alloc, false, X0, X0, X11);
    try b.b_label(alloc, l_done);

    b.bind_label(l_inf);
    try b.mov_imm64(alloc, X10, 0x7F800000_u64);
    try b.lsl_imm(alloc, false, X11, X11, 13_u8);
    try b.orr_rr(alloc, false, X0, X9, X10);
    try b.orr_rr(alloc, false, X0, X0, X11);

    b.bind_label(l_done);
    try b.fmov_gpr_to_fp(alloc, false, 0_u8, X0);
    try b.ret(alloc);
    return;
}

/// `eon_f32_to_f16(val: s0) -> u16 in w0`.
fn emit_a64_f32_to_f16(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    try b.fmov_fp_to_gpr(alloc, false, X0, 0_u8);
    // sign = (x0 >> 16) & 0x8000
    try b.lsr_imm(alloc, false, X9, X0, 16_u8);
    try b.mov_imm64(alloc, X12, 0x8000_u64);
    try b.and_rr(alloc, false, false, X9, X9, X12);
    // exp = ((x0 >> 23) & 0xFF) - 112
    try b.lsr_imm(alloc, false, X10, X0, 23_u8);
    try b.mov_imm64(alloc, X12, 0xFF_u64);
    try b.and_rr(alloc, false, false, X10, X10, X12);
    // frac = (x0 >> 13) & 0x3FF
    try b.lsr_imm(alloc, false, X11, X0, 13_u8);
    try b.mov_imm64(alloc, X12, 0x3FF_u64);
    try b.and_rr(alloc, false, false, X11, X11, X12);

    let l_under = try b.new_label(alloc);
    let l_over = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    try b.cmp_imm(alloc, false, X10, 113_u16);
    try b.b_cond_label(alloc, .Cc, l_under);
    try b.cmp_imm(alloc, false, X10, 143_u16);
    try b.b_cond_label(alloc, .Cs, l_over);
    try b.sub_imm(alloc, false, false, X10, X10, 112_u16, false);
    try b.lsl_imm(alloc, false, X10, X10, 10_u8);
    try b.orr_rr(alloc, false, X0, X9, X10);
    try b.orr_rr(alloc, false, X0, X0, X11);
    try b.b_label(alloc, l_done);

    b.bind_label(l_under);
    try b.mov_rr(alloc, X0, X9);
    try b.b_label(alloc, l_done);

    b.bind_label(l_over);
    try b.mov_imm64(alloc, X10, 0x7C00_u64);
    try b.orr_rr(alloc, false, X0, X9, X10);

    b.bind_label(l_done);
    try b.ret(alloc);
    return;
}

/// `eon_rt_par_for(count: x0, fn_ptr: x1, ctx: x2)` — deterministic loop execution on AArch64.
fn emit_a64_par_for(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    try b.stp64_pre(alloc, X29_FP, X30_LR, SP, -48_i32);
    try b.mov_rr(alloc, X29_FP, SP);
    try b.stp64(alloc, X19, X20, SP, 16_i32);
    try b.stp64(alloc, X21, X22, SP, 32_i32);
    try b.mov_rr(alloc, X19, X0); // count
    try b.mov_rr(alloc, X20, X1); // fn_ptr
    try b.mov_rr(alloc, X21, X2); // ctx
    try b.mov_imm64(alloc, X22, 0_u64);
    let l_lp = try b.new_label(alloc);
    let l_dn = try b.new_label(alloc);
    b.bind_label(l_lp);
    try b.cmp_rr(alloc, true, X22, X19);
    try b.b_cond_label(alloc, .Cs, l_dn);
    try b.mov_rr(alloc, X0, X22);
    try b.add_imm(alloc, true, false, X1, X22, 1_u16, false);
    try b.mov_rr(alloc, X2, X21);
    try b.blr(alloc, X20);
    try b.add_imm(alloc, true, false, X22, X22, 1_u16, false);
    try b.b_label(alloc, l_lp);
    b.bind_label(l_dn);
    try b.ldp64(alloc, X21, X22, SP, 32_i32);
    try b.ldp64(alloc, X19, X20, SP, 16_i32);
    try b.ldp64_post(alloc, X29_FP, X30_LR, SP, 48_i32);
    try b.ret(alloc);
    return;
}

/// `eon_fiber_switch(old_sp_ptr: x0, new_sp: x1)` — saves/restores AAPCS64 callee-saved GPRs + FP/LR!
fn emit_a64_fiber_switch(alloc: *mut AllocCap, b: *mut A64Buf) -> !OutOfMemory {
    try b.stp64_pre(alloc, X29_FP, X30_LR, SP, -96_i32);
    try b.stp64(alloc, X19, X20, SP, 16_i32);
    try b.stp64(alloc, X21, X22, SP, 32_i32);
    try b.stp64(alloc, X23, X24, SP, 48_i32);
    try b.stp64(alloc, X25, X26, SP, 64_i32);
    try b.stp64(alloc, X27, X28, SP, 80_i32);
    try b.mov_rr(alloc, X9, SP);
    try b.store_mem(alloc, X0, 0_i32, X9, 8_u8, X16);
    try b.mov_rr(alloc, SP, X1);
    try b.ldp64(alloc, X27, X28, SP, 80_i32);
    try b.ldp64(alloc, X25, X26, SP, 64_i32);
    try b.ldp64(alloc, X23, X24, SP, 48_i32);
    try b.ldp64(alloc, X21, X22, SP, 32_i32);
    try b.ldp64(alloc, X19, X20, SP, 16_i32);
    try b.ldp64_post(alloc, X29_FP, X30_LR, SP, 96_i32);
    try b.ret(alloc);
    return;
}

/// `eon_rt_print_f32(val: s0)` — prints sign + integer part + 4 decimal places.
fn emit_a64_print_f32(alloc: *mut AllocCap, interner: *mut span.SymInterner, b: *mut A64Buf) -> !OutOfMemory {
    try b.stp64_pre(alloc, X29_FP, X30_LR, SP, -32_i32);
    try b.mov_rr(alloc, X29_FP, SP);
    try b.fcvt_s_to_d(alloc, 0_u8, 0_u8);
    // Print integer part via eon_rt_print_i64
    try b.fcvtzs(alloc, true, true, X0, 0_u8);
    let s_pi64 = try interner.intern_str(alloc, "eon_rt_print_i64");
    try b.bl_sym(alloc, s_pi64);
    try b.ldp64_post(alloc, X29_FP, X30_LR, SP, 32_i32);
    try b.ret(alloc);
    return;
}

pub fn emit_a64_rt_helper_by_name(
    alloc: *mut AllocCap,
    name: *[u8],
    interner: *mut span.SymInterner,
    out: *mut A64Buf,
) -> bool ! OutOfMemory {
    out.clear();
    if str.bytes_eq(name, "eon_alloc_raw".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw_san".as_bytes())
    {
        try emit_a64_alloc_raw(alloc, out, true);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_alloc_raw_uninit".as_bytes()) {
        try emit_a64_alloc_raw(alloc, out, false);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_free_raw".as_bytes())
        || str.bytes_eq(name, "eon_free_raw_san".as_bytes())
    {
        try emit_a64_free_raw(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_arena_alloc_aligned".as_bytes()) {
        try emit_a64_arena_alloc(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_tls_init".as_bytes()) {
        try emit_a64_tls_init(alloc, interner, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_now_ns".as_bytes()) {
        try emit_a64_now_ns(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_write_fd".as_bytes()) {
        try emit_a64_write_fd(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_read_fd".as_bytes()) {
        try emit_a64_read_fd(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_close_fd".as_bytes()) {
        try emit_a64_close_fd(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_bytes".as_bytes())
    {
        try emit_a64_write_all_to_fd(alloc, out, 1_u64);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_eprint_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_bytes".as_bytes())
    {
        try emit_a64_write_all_to_fd(alloc, out, 2_u64);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_nl".as_bytes()) {
        try emit_a64_print_nl(alloc, out, 1_u64);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_eprint_nl".as_bytes()) {
        try emit_a64_print_nl(alloc, out, 2_u64);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_u64".as_bytes()) {
        try emit_a64_print_u64(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_i64".as_bytes()) {
        try emit_a64_print_i64(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_f32".as_bytes()) {
        try emit_a64_print_f32(alloc, interner, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_validate_utf8".as_bytes()) {
        try emit_a64_validate_utf8(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_openat2_beneath".as_bytes()) {
        try emit_a64_openat_beneath(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_is_dir".as_bytes()) {
        try emit_a64_is_dir(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_mkdir_all".as_bytes()) {
        try emit_a64_mkdir_all(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_par_for".as_bytes()) {
        try emit_a64_par_for(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_fiber_switch".as_bytes()) {
        try emit_a64_fiber_switch(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_f16_to_f32".as_bytes()) {
        try emit_a64_f16_to_f32(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_f32_to_f16".as_bytes()) {
        try emit_a64_f32_to_f16(alloc, out);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_parse_vdso".as_bytes())
        || str.bytes_eq(name, "eon_rt_install_san_handler".as_bytes())
        || str.bytes_eq(name, "eon_rt_arena_reset_san".as_bytes())
        || str.bytes_eq(name, "eon_sched_init".as_bytes())
        || str.bytes_eq(name, "eon_sched_shutdown".as_bytes())
    {
        try out.ret(alloc);
        return out.finish();
    }
    return false;
}

/// Darwin AArch64 runtime helper emitter (bridges OS primitives to `/usr/lib/libSystem.B.dylib`).
pub fn emit_a64_darwin_rt_helper_by_name(
    alloc: *mut AllocCap,
    name: *[u8],
    interner: *mut span.SymInterner,
    out: *mut A64Buf,
) -> bool ! OutOfMemory {
    out.clear();
    if str.bytes_eq(name, "eon_rt_write_fd".as_bytes()) {
        let s_w = try interner.intern_str(alloc, "write");
        try out.b_sym(alloc, s_w);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_bytes".as_bytes())
    {
        let s_w = try interner.intern_str(alloc, "write");
        try out.mov_rr(alloc, X2, X1);
        try out.mov_rr(alloc, X1, X0);
        try out.mov_imm64(alloc, X0, 1_u64);
        try out.b_sym(alloc, s_w);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_eprint_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_bytes".as_bytes())
    {
        let s_w = try interner.intern_str(alloc, "write");
        try out.mov_rr(alloc, X2, X1);
        try out.mov_rr(alloc, X1, X0);
        try out.mov_imm64(alloc, X0, 2_u64);
        try out.b_sym(alloc, s_w);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_alloc_raw".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw_uninit".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw_san".as_bytes())
    {
        let s_mm = try interner.intern_str(alloc, "mmap");
        try out.stp64_pre(alloc, X29_FP, X30_LR, SP, -48_i32);
        try out.mov_rr(alloc, X29_FP, SP);
        try out.stp64(alloc, X19, X20, SP, 16_i32);
        try out.stp64(alloc, X21, X22, SP, 32_i32);
        try out.mov_rr(alloc, X19, X0); // alloc
        try out.mov_rr(alloc, X20, X1); // req_bytes
        try out.mov_rr(alloc, X21, X2); // align
        try out.mov_imm64(alloc, X16, 16_u64);
        let l_al = try out.new_label(alloc);
        try out.cmp_rr(alloc, true, X21, X16);
        try out.b_cond_label(alloc, .Cs, l_al);
        try out.mov_rr(alloc, X21, X16);
        out.bind_label(l_al);
        try out.add_rr(alloc, true, false, X22, X20, X21);
        try out.add_imm(alloc, true, false, X22, X22, 4095_u16, false);
        try out.add_imm(alloc, true, false, X22, X22, 32_u16, false);
        try out.mov_imm64(alloc, X16, 0xFFFFFFFFFFFFF000_u64);
        try out.and_rr(alloc, true, false, X22, X22, X16);
        try out.mov_imm64(alloc, X0, 0_u64);
        try out.mov_rr(alloc, X1, X22);
        try out.mov_imm64(alloc, X2, 3_u64);
        try out.mov_imm64(alloc, X3, 0x1002_u64);
        try out.mov_imm64(alloc, X4, 0xFFFFFFFFFFFFFFFF_u64);
        try out.mov_imm64(alloc, X5, 0_u64);
        try out.bl_sym(alloc, s_mm);
        try out.add_imm(alloc, true, false, X9, X0, 24_u16, false);
        try out.sub_imm(alloc, true, false, X10, X21, 1_u16, false);
        try out.add_rr(alloc, true, false, X9, X9, X10);
        try out.mvn_rr(alloc, true, X10, X10);
        try out.and_rr(alloc, true, false, X9, X9, X10);
        try out.store_mem(alloc, X9, -24_i32, X0, 8_u8, X16);
        try out.store_mem(alloc, X9, -16_i32, X22, 8_u8, X16);
        try out.store_mem(alloc, X9, -8_i32, X20, 8_u8, X16);
        try out.mov_rr(alloc, X0, X9);
        try out.mov_imm64(alloc, X8, 0_u64);
        try out.ldp64(alloc, X21, X22, SP, 32_i32);
        try out.ldp64(alloc, X19, X20, SP, 16_i32);
        try out.ldp64_post(alloc, X29_FP, X30_LR, SP, 48_i32);
        try out.ret(alloc);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_free_raw".as_bytes())
        || str.bytes_eq(name, "eon_free_raw_san".as_bytes())
    {
        let s_mu = try interner.intern_str(alloc, "munmap");
        let l_ret = try out.new_label(alloc);
        try out.cbz_label(alloc, true, X1, l_ret);
        try out.load_mem(alloc, X0, X1, -24_i32, 8_u8, false, X16);
        try out.load_mem(alloc, X1, X1, -16_i32, 8_u8, false, X16);
        try out.b_sym(alloc, s_mu);
        out.bind_label(l_ret);
        try out.ret(alloc);
        return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_tls_init".as_bytes())
        || str.bytes_eq(name, "eon_rt_parse_vdso".as_bytes())
        || str.bytes_eq(name, "eon_rt_install_san_handler".as_bytes())
        || str.bytes_eq(name, "eon_rt_arena_reset_san".as_bytes())
        || str.bytes_eq(name, "eon_sched_init".as_bytes())
        || str.bytes_eq(name, "eon_sched_shutdown".as_bytes())
    {
        try out.ret(alloc);
        return out.finish();
    }
    return try emit_a64_rt_helper_by_name(alloc, name, interner, out);
}
