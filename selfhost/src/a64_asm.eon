    pub fn ldar(self: *mut Self, alloc: *mut AllocCap, size_bytes: u8, rt: u8, rn: u8) -> !OutOfMemory {
        let sz: u32 = if size_bytes == 1_u8 { 0_u32 } else if size_bytes == 2_u8 { 1_u32 } else if size_bytes == 4_u8 { 2_u32 } else { 3_u32 };
        try self.emit32(alloc, (sz <<% 30_u32) | 0x08DFFC00_u32 | (r5(rn) <<% 5_u32) | r5(rt));
        return;
    }

