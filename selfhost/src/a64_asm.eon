    pub fn stp_d(self: *mut Self, alloc: *mut AllocCap, vt1: u8, vt2: u8, rn: u8, imm_bytes: i32) -> !OutOfMemory {
        let imm7 = ((imm_bytes >> 3_i32).bitcast.[u32]() & 0x7F_u32) <<% 15_u32;
