    pub fn vmov_16b(self: *mut Self, alloc: *mut AllocCap, vd: u8, vn: u8) -> !OutOfMemory {
        // ORR Vd.16B, Vn.16B, Vn.16B
        try self.emit32(alloc, 0x4EA01C00_u32 | (r5(vn) <<% 16_u32) | (r5(vn) <<% 5_u32) | r5(vd));
