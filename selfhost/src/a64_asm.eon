        try self.emit32(alloc, (sz <<% 30_u32) | 0x0800FC00_u32 | (r5(rs) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rt));
        return;
    }

    // --- Scalar Floating-Point & SIMD Load/Store ---

    /// Universal FP/SIMD load `[rn + disp]` for `bytes` in `{4 (S), 8 (D), 16 (Q)}`.
    pub fn load_vec_mem(self: *mut Self, alloc: *mut AllocCap, vt: u8, rn: u8, disp: i32, bytes: u8, scratch: u8) -> !OutOfMemory {
        let sh: u32 = if bytes == 4_u8 { 2_u32 } else if bytes == 8_u8 { 3_u32 } else { 4_u32 };
        let align_m: i32 = (1_i32 <<% sh.trunc.[i32]()) -% 1_i32;
        let max_u: i32 = 4095_i32 <<% sh.trunc.[i32]();
        if disp >= 0_i32 && disp <= max_u && (disp & align_m) == 0_i32 {
            let op: u32 = if bytes == 4_u8 { 0xBD400000_u32 } else if bytes == 8_u8 { 0xFD400000_u32 } else { 0x3DC00000_u32 };
            let imm12 = ((disp.bitcast.[u32]() >> sh) & 0xFFF_u32) <<% 10_u32;
            try self.emit32(alloc, op | imm12 | (r5(rn) <<% 5_u32) | r5(vt));
            return;
        }
        if disp >= -256_i32 && disp <= 255_i32 {
            let op: u32 = if bytes == 4_u8 { 0xBC400000_u32 } else if bytes == 8_u8 { 0xFC400000_u32 } else { 0x3CC00000_u32 };
            let imm9 = (disp.bitcast.[u32]() & 0x1FF_u32) <<% 12_u32;
            try self.emit32(alloc, op | imm9 | (r5(rn) <<% 5_u32) | r5(vt));
            return;
        }
        try self.add_signed_imm(alloc, scratch, rn, disp.widen.[i64](), scratch);
        let op: u32 = if bytes == 4_u8 { 0xBD400000_u32 } else if bytes == 8_u8 { 0xFD400000_u32 } else { 0x3DC00000_u32 };
        try self.emit32(alloc, op | (r5(scratch) <<% 5_u32) | r5(vt));
        return;
    }

    pub fn store_vec_mem(self: *mut Self, alloc: *mut AllocCap, rn: u8, disp: i32, vt: u8, bytes: u8, scratch: u8) -> !OutOfMemory {
        let sh: u32 = if bytes == 4_u8 { 2_u32 } else if bytes == 8_u8 { 3_u32 } else { 4_u32 };
        let align_m: i32 = (1_i32 <<% sh.trunc.[i32]()) -% 1_i32;
        let max_u: i32 = 4095_i32 <<% sh.trunc.[i32]();
        if disp >= 0_i32 && disp <= max_u && (disp & align_m) == 0_i32 {
            let op: u32 = if bytes == 4_u8 { 0xBD000000_u32 } else if bytes == 8_u8 { 0xFD000000_u32 } else { 0x3D800000_u32 };
            let imm12 = ((disp.bitcast.[u32]() >> sh) & 0xFFF_u32) <<% 10_u32;
            try self.emit32(alloc, op | imm12 | (r5(rn) <<% 5_u32) | r5(vt));
            return;
        }
        if disp >= -256_i32 && disp <= 255_i32 {
            let op: u32 = if bytes == 4_u8 { 0xBC000000_u32 } else if bytes == 8_u8 { 0xFC000000_u32 } else { 0x3C800000_u32 };
            let imm9 = (disp.bitcast.[u32]() & 0x1FF_u32) <<% 12_u32;
            try self.emit32(alloc, op | imm9 | (r5(rn) <<% 5_u32) | r5(vt));
            return;
        }
        try self.add_signed_imm(alloc, scratch, rn, disp.widen.[i64](), scratch);
        let op: u32 = if bytes == 4_u8 { 0xBD000000_u32 } else if bytes == 8_u8 { 0xFD000000_u32 } else { 0x3D800000_u32 };
        try self.emit32(alloc, op | (r5(scratch) <<% 5_u32) | r5(vt));
        return;
    }

    pub fn fadd_s(self: *mut Self, alloc: *mut AllocCap, is64: bool, vd: u8, vn: u8, vm: u8) -> !OutOfMemory {
        let ft: u32 = if is64 { 1_u32 <<% 22_u32 } else { 0_u32 };
