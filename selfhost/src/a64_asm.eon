module eonc.a64_asm;

import core.col;
import core.str;
import eonc.span;
import eonc.elf64;

// ============================================================================
// ARMv8-A + NEON 128-bit Binary Assembler & AArch64 Linux/NoStd Runtime
// ============================================================================

pub const X0: u8 = 0_u8;
pub const X1: u8 = 1_u8;
pub const X2: u8 = 2_u8;
pub const X3: u8 = 3_u8;
pub const X4: u8 = 4_u8;
pub const X5: u8 = 5_u8;
pub const X6: u8 = 6_u8;
pub const X7: u8 = 7_u8;
pub const X8: u8 = 8_u8;
pub const X9: u8 = 9_u8;
pub const X10: u8 = 10_u8;
pub const X11: u8 = 11_u8;
pub const X12: u8 = 12_u8;
pub const X13: u8 = 13_u8;
pub const X14: u8 = 14_u8;
pub const X15: u8 = 15_u8;
pub const X16: u8 = 16_u8;
pub const X17: u8 = 17_u8;
pub const X18: u8 = 18_u8;
pub const X19: u8 = 19_u8;
pub const X20: u8 = 20_u8;
pub const X21: u8 = 21_u8;
pub const X22: u8 = 22_u8;
pub const X23: u8 = 23_u8;
pub const X24: u8 = 24_u8;
pub const X25: u8 = 25_u8;
pub const X26: u8 = 26_u8;
pub const X27: u8 = 27_u8;
pub const X28: u8 = 28_u8;
pub const X29_FP: u8 = 29_u8;
pub const X30_LR: u8 = 30_u8;
pub const XZR: u8 = 63_u8;
pub const SP: u8 = 31_u8;

pub enum A64Cond : u8 {
    Eq = 0,
    Ne = 1,
    Cs = 2, // HS (unsigned >=)
    Cc = 3, // LO (unsigned <)
    Mi = 4,
    Pl = 5,
    Vs = 6,
    Vc = 7,
    Hi = 8, // unsigned >
    Ls = 9, // unsigned <=
    Ge = 10,
    Lt = 11,
    Gt = 12,
    Le = 13,
    Al = 14,
}

pub fn cond_code(c: A64Cond) -> u32 {
    match c {
        .Eq => { return 0_u32; }
        .Ne => { return 1_u32; }
        .Cs => { return 2_u32; }
        .Cc => { return 3_u32; }
        .Mi => { return 4_u32; }
        .Pl => { return 5_u32; }
        .Vs => { return 6_u32; }
        .Vc => { return 7_u32; }
        .Hi => { return 8_u32; }
        .Ls => { return 9_u32; }
        .Ge => { return 10_u32; }
        .Lt => { return 11_u32; }
        .Gt => { return 12_u32; }
        .Le => { return 13_u32; }
        .Al => { return 14_u32; }
    }
    return 14_u32;
}

pub fn cond_invert(c: A64Cond) -> A64Cond {
    match c {
        .Eq => { return .Ne; }
        .Ne => { return .Eq; }
        .Cs => { return .Cc; }
        .Cc => { return .Cs; }
        .Mi => { return .Pl; }
        .Pl => { return .Mi; }
        .Vs => { return .Vc; }
        .Vc => { return .Vs; }
        .Hi => { return .Ls; }
        .Ls => { return .Hi; }
        .Ge => { return .Lt; }
        .Lt => { return .Ge; }
        .Gt => { return .Le; }
        .Le => { return .Gt; }
        .Al => { return .Al; }
    }
    return .Al;
}

pub struct A64Reloc {
    pub offset: u32;
    pub kind: elf64.RelocKind;
    pub sym_id: u32;
    pub addend: i64;
}

pub enum A64FixupKind : u8 {
    Branch26 = 0,
    Cond19 = 1,
    Adr21 = 2,
}

pub struct A64Fixup {
    pub pos: u32;
    pub label: u32;
    pub kind: A64FixupKind;
}

pub linear struct A64Buf {
    pub code: col.DynBuf[u8];
    pub relocs: col.DynBuf[A64Reloc];
    pub labels: col.DynBuf[u32];
    pub fixups: col.DynBuf[A64Fixup];
}

const LBL_UNBOUND: u32 = 0xFFFFFFFF_u32;

fn r5(r: u8) -> u32 {
    return (r & 31_u8).widen.[u32]();
}

fn write_u32_le_slice(dst: *mut [u8], off: usize, w: u32) {
    if off < dst.len && (dst.len - off) >= 4_usize {
        dst[off] = (w & 0xFF_u32).trunc.[u8]();
        dst[off + 1_usize] = ((w >> 8_u32) & 0xFF_u32).trunc.[u8]();
        dst[off + 2_usize] = ((w >> 16_u32) & 0xFF_u32).trunc.[u8]();
        dst[off + 3_usize] = ((w >> 24_u32) & 0xFF_u32).trunc.[u8]();
    }
}

fn read_u32_le_slice(src: *[u8], off: usize) -> u32 {
    if off < src.len && (src.len - off) >= 4_usize {
        return src[off].widen.[u32]()
            | (src[off + 1_usize].widen.[u32]() <<% 8_u32)
            | (src[off + 2_usize].widen.[u32]() <<% 16_u32)
            | (src[off + 3_usize].widen.[u32]() <<% 24_u32);
    }
    return 0_u32;
}

impl A64Buf {
    pub fn init(alloc: *mut AllocCap) -> A64Buf ! OutOfMemory {
        let code = try col.DynBuf.[u8].init(alloc, 128_usize);
        errdefer code.destroy(alloc);
        let relocs = try col.DynBuf.[A64Reloc].init(alloc, 8_usize);
        errdefer relocs.destroy(alloc);
        let labels = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer labels.destroy(alloc);
        let fixups = try col.DynBuf.[A64Fixup].init(alloc, 16_usize);
        errdefer fixups.destroy(alloc);
        return A64Buf.{
            code: code,
            relocs: relocs,
            labels: labels,
            fixups: fixups,
        };
    }

    pub fn clear(self: *mut Self) {
        self.code.clear();
        self.relocs.clear();
        self.labels.clear();
        self.fixups.clear();
    }

    pub fn destroy(self: A64Buf, alloc: *mut AllocCap) {
        let A64Buf.{ code, relocs, labels, fixups } = self;
        code.destroy(alloc);
        relocs.destroy(alloc);
        labels.destroy(alloc);
        fixups.destroy(alloc);
    }

    pub fn pos(self: *Self) -> u32 {
        return self.code.len().trunc.[u32]();
    }

    pub fn emit32(self: *mut Self, alloc: *mut AllocCap, insn: u32) -> !OutOfMemory {
        let b: [4]u8 = [
            (insn & 0xFF_u32).trunc.[u8](),
            ((insn >> 8_u32) & 0xFF_u32).trunc.[u8](),
            ((insn >> 16_u32) & 0xFF_u32).trunc.[u8](),
            ((insn >> 24_u32) & 0xFF_u32).trunc.[u8](),
        ];
        try self.code.push_slice(alloc, &b);
        return;
    }

    pub fn emit_i32(self: *mut Self, alloc: *mut AllocCap, val: i32) -> !OutOfMemory {
        try self.emit32(alloc, val.bitcast.[u32]());
        return;
    }

    pub fn emit_bytes(self: *mut Self, alloc: *mut AllocCap, bs: *[u8]) -> !OutOfMemory {
        try self.code.push_slice(alloc, bs);
        return;
    }

    pub fn align_nop(self: *mut Self, alloc: *mut AllocCap, align: usize) -> !OutOfMemory {
        if align <= 4_usize {
            return;
        }
        while (self.code.len() & (align -% 1_usize)) != 0_usize {
            try self.nop(alloc);
        }
        return;
    }

    pub fn label_pos(self: *Self, lbl: u32) -> u32 {
        let idx = lbl.widen.[usize]();
        let ls = self.labels.as_slice();
        if idx < ls.len {
            return ls[idx];
        }
        return LBL_UNBOUND;
    }

    pub fn new_label(self: *mut Self, alloc: *mut AllocCap) -> u32 ! OutOfMemory {
        let id = self.labels.len().trunc.[u32]();
        try self.labels.push(alloc, LBL_UNBOUND);
        return id;
    }

    pub fn bind_label(self: *mut Self, lbl: u32) {
        let idx = lbl.widen.[usize]();
        let ls = self.labels.as_mut_slice();
        if idx < ls.len {
            ls[idx] = self.code.len().trunc.[u32]();
        }
    }

    pub fn finish(self: *mut Self) -> bool {
        let ls = self.labels.as_slice();
        let fs = self.fixups.as_slice();
        let cs = self.code.as_mut_slice();
        var i: usize = 0_usize;
        while i < fs.len {
            let f = fs[i];
            let lidx = f.label.widen.[usize]();
            if lidx >= ls.len || ls[lidx] == LBL_UNBOUND {
                return false;
            }
            let target = ls[lidx].widen.[i64]();
            let place = f.pos.widen.[i64]();
            let delta = target -% place;
            let off = f.pos.widen.[usize]();
            let old = read_u32_le_slice(cs, off);
            match f.kind {
                .Branch26 => {
                    if (delta & 3_i64) != 0_i64 || delta < -134217728_i64 || delta > 134217724_i64 {
                        return false;
                    }
                    let imm26 = ((delta >> 2_i64).bitcast.[u64]() & 0x03FFFFFF_u64).trunc.[u32]();
                    write_u32_le_slice(cs, off, (old & 0xFC000000_u32) | imm26);
                }
                .Cond19 => {
                    if (delta & 3_i64) != 0_i64 || delta < -1048576_i64 || delta > 1048572_i64 {
                        return false;
                    }
                    let imm19 = ((delta >> 2_i64).bitcast.[u64]() & 0x7FFFF_u64).trunc.[u32]();
                    write_u32_le_slice(cs, off, (old & 0xFF00001F_u32) | (imm19 <<% 5_u32));
                }
                .Adr21 => {
                    if delta < -1048576_i64 || delta > 1048575_i64 {
                        return false;
                    }
                    let imm21 = (delta.bitcast.[u64]() & 0x1FFFFF_u64).trunc.[u32]();
                    let immlo = (imm21 & 3_u32) <<% 29_u32;
                    let immhi = ((imm21 >> 2_u32) & 0x7FFFF_u32) <<% 5_u32;
                    write_u32_le_slice(cs, off, (old & 0x9F00001F_u32) | immlo | immhi);
                }
            }
            i = i +% 1_usize;
        }
        return true;
    }

    // --- Core Integer Data Processing ---

    pub fn nop(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit32(alloc, 0xD503201F_u32);
        return;
    }

    pub fn brk(self: *mut Self, alloc: *mut AllocCap, imm16: u16) -> !OutOfMemory {
        try self.emit32(alloc, 0xD4200000_u32 | (imm16.widen.[u32]() <<% 5_u32));
        return;
    }

    pub fn svc0(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit32(alloc, 0xD4000001_u32);
        return;
    }

    pub fn ret(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit32(alloc, 0xD65F03C0_u32);
        return;
    }

    pub fn br(self: *mut Self, alloc: *mut AllocCap, rn: u8) -> !OutOfMemory {
        try self.emit32(alloc, 0xD61F0000_u32 | (r5(rn) <<% 5_u32));
        return;
    }

    pub fn blr(self: *mut Self, alloc: *mut AllocCap, rn: u8) -> !OutOfMemory {
        try self.emit32(alloc, 0xD63F0000_u32 | (r5(rn) <<% 5_u32));
        return;
    }

    pub fn mov_rr(self: *mut Self, alloc: *mut AllocCap, rd: u8, rm: u8) -> !OutOfMemory {
        if rd == SP || rm == SP {
            // ADD Xd, Xn, #0 (handles SP properly)
            try self.emit32(alloc, 0x91000000_u32 | (r5(rm) <<% 5_u32) | r5(rd));
        } else {
            // ORR Xd, XZR, Xm
            try self.emit32(alloc, 0xAA0003E0_u32 | (r5(rm) <<% 16_u32) | r5(rd));
        }
        return;
    }

    pub fn mov32_rr(self: *mut Self, alloc: *mut AllocCap, rd: u8, rm: u8) -> !OutOfMemory {
        // ORR Wd, WZR, Wm (zero-extends to 64-bit!)
        try self.emit32(alloc, 0x2A0003E0_u32 | (r5(rm) <<% 16_u32) | r5(rd));
        return;
    }

    pub fn movz(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, imm16: u16, shift_hw: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let hw = (shift_hw & 3_u8).widen.[u32]() <<% 21_u32;
        try self.emit32(alloc, sf | 0x52800000_u32 | hw | (imm16.widen.[u32]() <<% 5_u32) | r5(rd));
        return;
    }

    pub fn movn(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, imm16: u16, shift_hw: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let hw = (shift_hw & 3_u8).widen.[u32]() <<% 21_u32;
        try self.emit32(alloc, sf | 0x12800000_u32 | hw | (imm16.widen.[u32]() <<% 5_u32) | r5(rd));
        return;
    }

    pub fn movk(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, imm16: u16, shift_hw: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let hw = (shift_hw & 3_u8).widen.[u32]() <<% 21_u32;
        try self.emit32(alloc, sf | 0x72800000_u32 | hw | (imm16.widen.[u32]() <<% 5_u32) | r5(rd));
        return;
    }

    /// Optimal 1..4-instruction materialization of any 64-bit constant into `rd`.
    pub fn mov_imm64(self: *mut Self, alloc: *mut AllocCap, rd: u8, val: u64) -> !OutOfMemory {
        let h0 = (val & 0xFFFF_u64).trunc.[u16]();
        let h1 = ((val >> 16_u64) & 0xFFFF_u64).trunc.[u16]();
        let h2 = ((val >> 32_u64) & 0xFFFF_u64).trunc.[u16]();
        let h3 = ((val >> 48_u64) & 0xFFFF_u64).trunc.[u16]();
        var zero_cnt: u8 = 0_u8;
        var ones_cnt: u8 = 0_u8;
        if h0 == 0_u16 { zero_cnt = zero_cnt +% 1_u8; } else if h0 == 0xFFFF_u16 { ones_cnt = ones_cnt +% 1_u8; }
        if h1 == 0_u16 { zero_cnt = zero_cnt +% 1_u8; } else if h1 == 0xFFFF_u16 { ones_cnt = ones_cnt +% 1_u8; }
        if h2 == 0_u16 { zero_cnt = zero_cnt +% 1_u8; } else if h2 == 0xFFFF_u16 { ones_cnt = ones_cnt +% 1_u8; }
        if h3 == 0_u16 { zero_cnt = zero_cnt +% 1_u8; } else if h3 == 0xFFFF_u16 { ones_cnt = ones_cnt +% 1_u8; }

        if ones_cnt > zero_cnt {
            // Use MOVN for first non-0xFFFF chunk, then MOVK for any remaining non-0xFFFF chunks
            var first_hw: u8 = 0_u8;
            var first_v: u16 = ~h0;
            if h0 == 0xFFFF_u16 {
                if h1 != 0xFFFF_u16 { first_hw = 1_u8; first_v = ~h1; }
                else if h2 != 0xFFFF_u16 { first_hw = 2_u8; first_v = ~h2; }
                else if h3 != 0xFFFF_u16 { first_hw = 3_u8; first_v = ~h3; }
                else { first_hw = 0_u8; first_v = 0_u16; }
            }
            try self.movn(alloc, true, rd, first_v, first_hw);
            if first_hw != 0_u8 && h0 != 0xFFFF_u16 { try self.movk(alloc, true, rd, h0, 0_u8); }
            if first_hw != 1_u8 && h1 != 0xFFFF_u16 { try self.movk(alloc, true, rd, h1, 1_u8); }
            if first_hw != 2_u8 && h2 != 0xFFFF_u16 { try self.movk(alloc, true, rd, h2, 2_u8); }
            if first_hw != 3_u8 && h3 != 0xFFFF_u16 { try self.movk(alloc, true, rd, h3, 3_u8); }
            return;
        }
        var first_hw: u8 = 0_u8;
        var first_v: u16 = h0;
        if h0 == 0_u16 {
            if h1 != 0_u16 { first_hw = 1_u8; first_v = h1; }
            else if h2 != 0_u16 { first_hw = 2_u8; first_v = h2; }
            else if h3 != 0_u16 { first_hw = 3_u8; first_v = h3; }
            else { first_hw = 0_u8; first_v = 0_u16; }
        }
        try self.movz(alloc, true, rd, first_v, first_hw);
        if first_hw != 0_u8 && h0 != 0_u16 { try self.movk(alloc, true, rd, h0, 0_u8); }
        if first_hw != 1_u8 && h1 != 0_u16 { try self.movk(alloc, true, rd, h1, 1_u8); }
        if first_hw != 2_u8 && h2 != 0_u16 { try self.movk(alloc, true, rd, h2, 2_u8); }
        if first_hw != 3_u8 && h3 != 0_u16 { try self.movk(alloc, true, rd, h3, 3_u8); }
        return;
    }

    pub fn add_imm(self: *mut Self, alloc: *mut AllocCap, is64: bool, set_flags: bool, rd: u8, rn: u8, imm12: u16, shift12: bool) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let s: u32 = if set_flags { 1_u32 <<% 29_u32 } else { 0_u32 };
        let sh: u32 = if shift12 { 1_u32 <<% 22_u32 } else { 0_u32 };
        let imm = (imm12 & 0xFFF_u16).widen.[u32]() <<% 10_u32;
        try self.emit32(alloc, sf | s | 0x11000000_u32 | sh | imm | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn sub_imm(self: *mut Self, alloc: *mut AllocCap, is64: bool, set_flags: bool, rd: u8, rn: u8, imm12: u16, shift12: bool) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let s: u32 = if set_flags { 1_u32 <<% 29_u32 } else { 0_u32 };
        let sh: u32 = if shift12 { 1_u32 <<% 22_u32 } else { 0_u32 };
        let imm = (imm12 & 0xFFF_u16).widen.[u32]() <<% 10_u32;
        try self.emit32(alloc, sf | s | 0x51000000_u32 | sh | imm | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    /// Add arbitrary signed 64-bit immediate to `rn` into `rd` (clobbers `scratch` only when |imm| > 4095).
    pub fn add_signed_imm(self: *mut Self, alloc: *mut AllocCap, rd: u8, rn: u8, delta: i64, scratch: u8) -> !OutOfMemory {
        if delta == 0_i64 {
            if rd != rn {
                try self.mov_rr(alloc, rd, rn);
            }
            return;
        }
        if delta > 0_i64 && delta <= 4095_i64 {
            try self.add_imm(alloc, true, false, rd, rn, delta.trunc.[u16](), false);
            return;
        }
        if delta < 0_i64 && delta >= -4095_i64 {
            let pos = (0_i64 -% delta).trunc.[u16]();
            try self.sub_imm(alloc, true, false, rd, rn, pos, false);
            return;
        }
        if delta > 0_i64 && delta <= 0xFFF000_i64 && (delta & 0xFFF_i64) == 0_i64 {
            try self.add_imm(alloc, true, false, rd, rn, (delta >> 12_i64).trunc.[u16](), true);
            return;
        }
        if delta < 0_i64 && delta >= -0xFFF000_i64 && ((0_i64 -% delta) & 0xFFF_i64) == 0_i64 {
            try self.sub_imm(alloc, true, false, rd, rn, ((0_i64 -% delta) >> 12_i64).trunc.[u16](), true);
            return;
        }
        if rd == SP || rn == SP {
            if delta > 0_i64 {
                try self.mov_imm64(alloc, scratch, delta.bitcast.[u64]());
                // ADD (extended reg) UXTX handles SP cleanly!
                try self.emit32(alloc, 0x8B206000_u32 | (r5(scratch) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
            } else {
                try self.mov_imm64(alloc, scratch, (0_i64 -% delta).bitcast.[u64]());
                // SUB (extended reg) UXTX handles SP cleanly!
                try self.emit32(alloc, 0xCB206000_u32 | (r5(scratch) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
            }
            return;
        }
        try self.mov_imm64(alloc, scratch, delta.bitcast.[u64]());
        try self.add_rr(alloc, true, false, rd, rn, scratch);
        return;
    }

    pub fn add_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, set_flags: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let s: u32 = if set_flags { 1_u32 <<% 29_u32 } else { 0_u32 };
        if is64 && !set_flags && (rd == SP || rn == SP) {
            try self.emit32(alloc, 0x8B206000_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
            return;
        }
        try self.emit32(alloc, sf | s | 0x0B000000_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn add_rr_lsl(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8, sh: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let s6 = (sh & 63_u8).widen.[u32]() <<% 10_u32;
        try self.emit32(alloc, sf | 0x0B000000_u32 | (r5(rm) <<% 16_u32) | s6 | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn sub_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, set_flags: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let s: u32 = if set_flags { 1_u32 <<% 29_u32 } else { 0_u32 };
        if is64 && !set_flags && (rd == SP || rn == SP) {
            try self.emit32(alloc, 0xCB206000_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
            return;
        }
        try self.emit32(alloc, sf | s | 0x4B000000_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn adc_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, set_flags: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let s: u32 = if set_flags { 1_u32 <<% 29_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | s | 0x1A000000_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn sbc_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, set_flags: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let s: u32 = if set_flags { 1_u32 <<% 29_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | s | 0x5A000000_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn ldrsw_reg_lsl2(self: *mut Self, alloc: *mut AllocCap, rt: u8, rn: u8, rm: u8) -> !OutOfMemory {
        // LDRSW Xt, [Xn, Xm, LSL #2]
        try self.emit32(alloc, 0xB8A07800_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rt));
        return;
    }

    pub fn cmp_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, rn: u8, rm: u8) -> !OutOfMemory {
        try self.sub_rr(alloc, is64, true, XZR, rn, rm);
        return;
    }

    pub fn cmp_imm(self: *mut Self, alloc: *mut AllocCap, is64: bool, rn: u8, imm12: u16) -> !OutOfMemory {
        try self.sub_imm(alloc, is64, true, XZR, rn, imm12, false);
        return;
    }

    pub fn cmn_imm(self: *mut Self, alloc: *mut AllocCap, is64: bool, rn: u8, imm12: u16) -> !OutOfMemory {
        try self.add_imm(alloc, is64, true, XZR, rn, imm12, false);
        return;
    }

    pub fn and_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, set_flags: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let opc: u32 = if set_flags { 0x6A000000_u32 } else { 0x0A000000_u32 };
        try self.emit32(alloc, sf | opc | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn orr_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x2A000000_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn eor_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x4A000000_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn mvn_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        // ORN Rd, XZR, Rm
        try self.emit32(alloc, sf | 0x2A2003E0_u32 | (r5(rm) <<% 16_u32) | r5(rd));
        return;
    }

    pub fn tst_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, rn: u8, rm: u8) -> !OutOfMemory {
        try self.and_rr(alloc, is64, true, XZR, rn, rm);
        return;
    }

    pub fn neg_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, set_flags: bool, rd: u8, rm: u8) -> !OutOfMemory {
        try self.sub_rr(alloc, is64, set_flags, rd, XZR, rm);
        return;
    }

    pub fn mul_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        // MADD Rd, Rn, Rm, XZR
        try self.emit32(alloc, sf | 0x1B007C00_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn msub_rrr(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8, ra: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x1B008000_u32 | (r5(rm) <<% 16_u32) | (r5(ra) <<% 10_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn smulh(self: *mut Self, alloc: *mut AllocCap, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        try self.emit32(alloc, 0x9B407C00_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn umulh(self: *mut Self, alloc: *mut AllocCap, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        try self.emit32(alloc, 0x9BC07C00_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn udiv_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x1AC00800_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn sdiv_rr(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x1AC00C00_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn lslv(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x1AC02000_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn lsrv(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x1AC02400_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn asrv(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x1AC02800_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn rorv(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x1AC02C00_u32 | (r5(rm) <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn ubfm(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, immr: u8, imms: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 0x80400000_u32 } else { 0_u32 }; // sf=1, N=1
        try self.emit32(
            alloc,
            sf | 0x53000000_u32
                | ((immr & 63_u8).widen.[u32]() <<% 16_u32)
                | ((imms & 63_u8).widen.[u32]() <<% 10_u32)
                | (r5(rn) <<% 5_u32)
                | r5(rd),
        );
        return;
    }

    pub fn sbfm(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, immr: u8, imms: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 0x80400000_u32 } else { 0_u32 };
        try self.emit32(
            alloc,
            sf | 0x13000000_u32
                | ((immr & 63_u8).widen.[u32]() <<% 16_u32)
                | ((imms & 63_u8).widen.[u32]() <<% 10_u32)
                | (r5(rn) <<% 5_u32)
                | r5(rd),
        );
        return;
    }

    pub fn lsl_imm(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, sh_in: u8) -> !OutOfMemory {
        let bits: u8 = if is64 { 64_u8 } else { 32_u8 };
        let sh = sh_in & (bits -% 1_u8);
        if sh == 0_u8 {
            if is64 {
                if rd != rn { try self.mov_rr(alloc, rd, rn); }
            } else {
                try self.mov32_rr(alloc, rd, rn);
            }
            return;
        }
        try self.ubfm(alloc, is64, rd, rn, bits -% sh, (bits -% 1_u8) -% sh);
        return;
    }

    pub fn lsr_imm(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, sh_in: u8) -> !OutOfMemory {
        let max_b: u8 = if is64 { 63_u8 } else { 31_u8 };
        let sh = sh_in & max_b;
        try self.ubfm(alloc, is64, rd, rn, sh, max_b);
        return;
    }

    pub fn asr_imm(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, sh_in: u8) -> !OutOfMemory {
        let max_b: u8 = if is64 { 63_u8 } else { 31_u8 };
        let sh = sh_in & max_b;
        try self.sbfm(alloc, is64, rd, rn, sh, max_b);
        return;
    }

    pub fn ror_imm(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, sh_in: u8) -> !OutOfMemory {
        let max_b: u8 = if is64 { 63_u8 } else { 31_u8 };
        let sh = sh_in & max_b;
        let sf: u32 = if is64 { 0x80400000_u32 } else { 0_u32 };
        // EXTR Rd, Rn, Rn, #sh
        try self.emit32(
            alloc,
            sf | 0x13800000_u32 | (r5(rn) <<% 16_u32) | (sh.widen.[u32]() <<% 10_u32) | (r5(rn) <<% 5_u32) | r5(rd),
        );
        return;
    }

    pub fn uxt(self: *mut Self, alloc: *mut AllocCap, rd: u8, rn: u8, bytes: u8) -> !OutOfMemory {
        if bytes == 1_u8 {
            try self.ubfm(alloc, false, rd, rn, 0_u8, 7_u8);
        } else if bytes == 2_u8 {
            try self.ubfm(alloc, false, rd, rn, 0_u8, 15_u8);
        } else if bytes == 4_u8 {
            try self.mov32_rr(alloc, rd, rn);
        } else if rd != rn {
            try self.mov_rr(alloc, rd, rn);
        }
        return;
    }

    pub fn sxt(self: *mut Self, alloc: *mut AllocCap, rd: u8, rn: u8, bytes: u8) -> !OutOfMemory {
        if bytes == 1_u8 {
            try self.sbfm(alloc, true, rd, rn, 0_u8, 7_u8);
        } else if bytes == 2_u8 {
            try self.sbfm(alloc, true, rd, rn, 0_u8, 15_u8);
        } else if bytes == 4_u8 {
            try self.sbfm(alloc, true, rd, rn, 0_u8, 31_u8);
        } else if rd != rn {
            try self.mov_rr(alloc, rd, rn);
        }
        return;
    }

    /// Arbitrary bit-width zero- or sign-extension (`1 <= bits <= 63`) in a single ARMv8 instruction!
    pub fn extend_bits(self: *mut Self, alloc: *mut AllocCap, rd: u8, rn: u8, bits: u8, signed: bool) -> !OutOfMemory {
        if bits == 0_u8 || bits >= 64_u8 {
            if rd != rn {
                try self.mov_rr(alloc, rd, rn);
            }
            return;
        }
        if signed {
            try self.sbfm(alloc, true, rd, rn, 0_u8, bits -% 1_u8);
        } else {
            try self.ubfm(alloc, true, rd, rn, 0_u8, bits -% 1_u8);
        }
        return;
    }

    pub fn clz(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x5AC01000_u32 | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn rbit(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x5AC00000_u32 | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn rev(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8) -> !OutOfMemory {
        if is64 {
            try self.emit32(alloc, 0xDAC00C00_u32 | (r5(rn) <<% 5_u32) | r5(rd));
        } else {
            try self.emit32(alloc, 0x5AC00800_u32 | (r5(rn) <<% 5_u32) | r5(rd));
        }
        return;
    }

    pub fn rev16(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x5AC00400_u32 | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn csel(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, rn: u8, rm: u8, cc: A64Cond) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x1A800000_u32 | (r5(rm) <<% 16_u32) | (cond_code(cc) <<% 12_u32) | (r5(rn) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn cset(self: *mut Self, alloc: *mut AllocCap, is64: bool, rd: u8, cc: A64Cond) -> !OutOfMemory {
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        let inv = cond_code(cond_invert(cc));
        // CSINC Rd, XZR, XZR, invert(cc)
        try self.emit32(alloc, sf | 0x1A9F07E0_u32 | (inv <<% 12_u32) | r5(rd));
        return;
    }

    // --- Branches & Labels ---

    pub fn b_label(self: *mut Self, alloc: *mut AllocCap, lbl: u32) -> !OutOfMemory {
        let p = self.pos();
        try self.fixups.push(alloc, A64Fixup.{ pos: p, label: lbl, kind: .Branch26 });
        try self.emit32(alloc, 0x14000000_u32);
        return;
    }

    pub fn b_cond_label(self: *mut Self, alloc: *mut AllocCap, cc: A64Cond, lbl: u32) -> !OutOfMemory {
        let p = self.pos();
        try self.fixups.push(alloc, A64Fixup.{ pos: p, label: lbl, kind: .Cond19 });
        try self.emit32(alloc, 0x54000000_u32 | cond_code(cc));
        return;
    }

    pub fn cbz_label(self: *mut Self, alloc: *mut AllocCap, is64: bool, rt: u8, lbl: u32) -> !OutOfMemory {
        let p = self.pos();
        try self.fixups.push(alloc, A64Fixup.{ pos: p, label: lbl, kind: .Cond19 });
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x34000000_u32 | r5(rt));
        return;
    }

    pub fn cbnz_label(self: *mut Self, alloc: *mut AllocCap, is64: bool, rt: u8, lbl: u32) -> !OutOfMemory {
        let p = self.pos();
        try self.fixups.push(alloc, A64Fixup.{ pos: p, label: lbl, kind: .Cond19 });
        let sf: u32 = if is64 { 1_u32 <<% 31_u32 } else { 0_u32 };
        try self.emit32(alloc, sf | 0x35000000_u32 | r5(rt));
        return;
    }

    pub fn adr_label(self: *mut Self, alloc: *mut AllocCap, rd: u8, lbl: u32) -> !OutOfMemory {
        let p = self.pos();
        try self.fixups.push(alloc, A64Fixup.{ pos: p, label: lbl, kind: .Adr21 });
        try self.emit32(alloc, 0x10000000_u32 | r5(rd));
        return;
    }

    pub fn bl_sym(self: *mut Self, alloc: *mut AllocCap, sym_id: u32) -> !OutOfMemory {
        let p = self.pos();
        try self.relocs.push(alloc, A64Reloc.{ offset: p, kind: .A64Call26, sym_id: sym_id, addend: 0_i64 });
        try self.emit32(alloc, 0x94000000_u32);
        return;
    }

    pub fn b_sym(self: *mut Self, alloc: *mut AllocCap, sym_id: u32) -> !OutOfMemory {
        let p = self.pos();
        try self.relocs.push(alloc, A64Reloc.{ offset: p, kind: .A64Jump26, sym_id: sym_id, addend: 0_i64 });
        try self.emit32(alloc, 0x14000000_u32);
        return;
    }

    pub fn lea_sym(self: *mut Self, alloc: *mut AllocCap, rd: u8, sym_id: u32, addend: i64) -> !OutOfMemory {
        let p0 = self.pos();
        try self.relocs.push(alloc, A64Reloc.{ offset: p0, kind: .A64Adrp21, sym_id: sym_id, addend: addend });
        try self.emit32(alloc, 0x90000000_u32 | r5(rd)); // ADRP rd, sym
        let p1 = self.pos();
        try self.relocs.push(alloc, A64Reloc.{ offset: p1, kind: .A64AddLo12, sym_id: sym_id, addend: addend });
        try self.emit32(alloc, 0x91000000_u32 | (r5(rd) <<% 5_u32) | r5(rd)); // ADD rd, rd, #:lo12:sym
        return;
    }

    pub fn load_got_sym(self: *mut Self, alloc: *mut AllocCap, rd: u8, sym_id: u32) -> !OutOfMemory {
        let p0 = self.pos();
        try self.relocs.push(alloc, A64Reloc.{ offset: p0, kind: .A64AdrpGot21, sym_id: sym_id, addend: 0_i64 });
        try self.emit32(alloc, 0x90000000_u32 | r5(rd));
        let p1 = self.pos();
        try self.relocs.push(alloc, A64Reloc.{ offset: p1, kind: .A64Ld64GotLo12, sym_id: sym_id, addend: 0_i64 });
        try self.emit32(alloc, 0xF9400000_u32 | (r5(rd) <<% 5_u32) | r5(rd));
        return;
    }

    pub fn lea_tls_sym(self: *mut Self, alloc: *mut AllocCap, rd: u8, sym_id: u32, addend: i64) -> !OutOfMemory {
        try self.mrs_tpidr_el0(alloc, rd);
        let p0 = self.pos();
        try self.relocs.push(alloc, A64Reloc.{ offset: p0, kind: .A64TpRelHi12, sym_id: sym_id, addend: addend });
        try self.emit32(alloc, 0x91400000_u32 | (r5(rd) <<% 5_u32) | r5(rd)); // ADD rd, rd, #:tprel_hi12:sym, lsl #12
        let p1 = self.pos();
        try self.relocs.push(alloc, A64Reloc.{ offset: p1, kind: .A64TpRelLo12, sym_id: sym_id, addend: addend });
        try self.emit32(alloc, 0x91000000_u32 | (r5(rd) <<% 5_u32) | r5(rd)); // ADD rd, rd, #:tprel_lo12:sym
        return;
    }

    // --- Memory Loads & Stores (Handles Arbitrary Signed Offsets!) ---

    pub fn ldr_uimm(self: *mut Self, alloc: *mut AllocCap, rt: u8, rn: u8, off: u32, size_bytes: u8, signed_ext: bool) -> !OutOfMemory {
        let base_op: u32 = if size_bytes == 1_u8 {
            if signed_ext { 0x39800000_u32 } else { 0x39400000_u32 }
        } else if size_bytes == 2_u8 {
            if signed_ext { 0x79800000_u32 } else { 0x79400000_u32 }
        } else if size_bytes == 4_u8 {
            if signed_ext { 0xB9800000_u32 } else { 0xB9400000_u32 }
        } else {
            0xF9400000_u32
        };
        let sh: u32 = if size_bytes == 1_u8 { 0_u32 } else if size_bytes == 2_u8 { 1_u32 } else if size_bytes == 4_u8 { 2_u32 } else { 3_u32 };
        let imm12 = ((off >> sh) & 0xFFF_u32) <<% 10_u32;
        try self.emit32(alloc, base_op | imm12 | (r5(rn) <<% 5_u32) | r5(rt));
        return;
    }

    pub fn str_uimm(self: *mut Self, alloc: *mut AllocCap, rt: u8, rn: u8, off: u32, size_bytes: u8) -> !OutOfMemory {
        let base_op: u32 = if size_bytes == 1_u8 {
            0x39000000_u32
        } else if size_bytes == 2_u8 {
            0x79000000_u32
        } else if size_bytes == 4_u8 {
            0xB9000000_u32
        } else {
            0xF9000000_u32
        };
        let sh: u32 = if size_bytes == 1_u8 { 0_u32 } else if size_bytes == 2_u8 { 1_u32 } else if size_bytes == 4_u8 { 2_u32 } else { 3_u32 };
        let imm12 = ((off >> sh) & 0xFFF_u32) <<% 10_u32;
        try self.emit32(alloc, base_op | imm12 | (r5(rn) <<% 5_u32) | r5(rt));
        return;
    }

    pub fn ldur_simm9(self: *mut Self, alloc: *mut AllocCap, rt: u8, rn: u8, off: i32, size_bytes: u8, signed_ext: bool) -> !OutOfMemory {
        let base_op: u32 = if size_bytes == 1_u8 {
            if signed_ext { 0x38800000_u32 } else { 0x38400000_u32 }
        } else if size_bytes == 2_u8 {
            if signed_ext { 0x78800000_u32 } else { 0x78400000_u32 }
        } else if size_bytes == 4_u8 {
            if signed_ext { 0xB8800000_u32 } else { 0xB8400000_u32 }
        } else {
            0xF8400000_u32
        };
        let imm9 = (off.bitcast.[u32]() & 0x1FF_u32) <<% 12_u32;
        try self.emit32(alloc, base_op | imm9 | (r5(rn) <<% 5_u32) | r5(rt));
        return;
    }

    pub fn stur_simm9(self: *mut Self, alloc: *mut AllocCap, rt: u8, rn: u8, off: i32, size_bytes: u8) -> !OutOfMemory {
        let base_op: u32 = if size_bytes == 1_u8 {
            0x38000000_u32
        } else if size_bytes == 2_u8 {
            0x78000000_u32
        } else if size_bytes == 4_u8 {
            0xB8000000_u32
        } else {
            0xF8000000_u32
        };
        let imm9 = (off.bitcast.[u32]() & 0x1FF_u32) <<% 12_u32;
        try self.emit32(alloc, base_op | imm9 | (r5(rn) <<% 5_u32) | r5(rt));
        return;
    }

    /// Universal GPR load `[rn + disp]` handling ANY signed 32-bit `disp` (uses `scratch` only when out of imm9/uimm12 range).
    pub fn load_mem(self: *mut Self, alloc: *mut AllocCap, rt: u8, rn: u8, disp: i32, size_bytes: u8, signed_ext: bool, scratch: u8) -> !OutOfMemory {
        let align_mask: i32 = if size_bytes <= 1_u8 { 0_i32 } else { size_bytes.widen.[i32]() -% 1_i32 };
        let max_uimm: i32 = 4095_i32 *% (if size_bytes <= 1_u8 { 1_i32 } else { size_bytes.widen.[i32]() });
        if disp >= 0_i32 && disp <= max_uimm && (disp & align_mask) == 0_i32 {
            try self.ldr_uimm(alloc, rt, rn, disp.bitcast.[u32](), size_bytes, signed_ext);
            return;
        }
        if disp >= -256_i32 && disp <= 255_i32 {
            try self.ldur_simm9(alloc, rt, rn, disp, size_bytes, signed_ext);
            return;
        }
        try self.add_signed_imm(alloc, scratch, rn, disp.widen.[i64](), scratch);
        try self.ldr_uimm(alloc, rt, scratch, 0_u32, size_bytes, signed_ext);
        return;
    }

    /// Universal GPR store `[rn + disp]` handling ANY signed 32-bit `disp`.
    pub fn store_mem(self: *mut Self, alloc: *mut AllocCap, rn: u8, disp: i32, rt: u8, size_bytes: u8, scratch: u8) -> !OutOfMemory {
        let align_mask: i32 = if size_bytes <= 1_u8 { 0_i32 } else { size_bytes.widen.[i32]() -% 1_i32 };
        let max_uimm: i32 = 4095_i32 *% (if size_bytes <= 1_u8 { 1_i32 } else { size_bytes.widen.[i32]() });
        if disp >= 0_i32 && disp <= max_uimm && (disp & align_mask) == 0_i32 {
            try self.str_uimm(alloc, rt, rn, disp.bitcast.[u32](), size_bytes);
            return;
        }
        if disp >= -256_i32 && disp <= 255_i32 {
            try self.stur_simm9(alloc, rt, rn, disp, size_bytes);
            return;
        }
        try self.add_signed_imm(alloc, scratch, rn, disp.widen.[i64](), scratch);
        try self.str_uimm(alloc, rt, scratch, 0_u32, size_bytes);
        return;
    }

    pub fn stp64(self: *mut Self, alloc: *mut AllocCap, rt1: u8, rt2: u8, rn: u8, imm_bytes: i32) -> !OutOfMemory {
        let imm7 = ((imm_bytes >> 3_i32).bitcast.[u32]() & 0x7F_u32) <<% 15_u32;
        try self.emit32(alloc, 0xA9000000_u32 | imm7 | (r5(rt2) <<% 10_u32) | (r5(rn) <<% 5_u32) | r5(rt1));
        return;
    }

    pub fn ldp64(self: *mut Self, alloc: *mut AllocCap, rt1: u8, rt2: u8, rn: u8, imm_bytes: i32) -> !OutOfMemory {
