    pub fn vdup_gpr(self: *mut Self, alloc: *mut AllocCap, elem_bytes: u8, vd: u8, rn: u8) -> !OutOfMemory {
        let imm5: u32 = if elem_bytes == 1_u8 { 1_u32 } else if elem_bytes == 2_u8 { 2_u32 } else if elem_bytes == 4_u8 { 4_u32 } else { 8_u32 };
        try self.emit32(alloc, 0x4E000C00_u32 | (imm5 <<% 16_u32) | (r5(rn) <<% 5_u32) | r5(vd));
        return;
    }

