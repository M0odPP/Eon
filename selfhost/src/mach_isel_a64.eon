// ============================================================================
// Section 1: Public AArch64 Blob Types, ABI Classification & Symbol Helpers
// ============================================================================

pub linear struct A64FnBlob {
    pub ok: bool;
    pub sym_id: u32;
    pub own_stack_bytes: u64;
    pub code: col.DynBuf[u8];
    pub relocs: col.DynBuf[a64_asm.A64Reloc];
    pub rodata_items: col.DynBuf[mach_x64.RodataItemMeta];
    pub rodata_bytes: col.DynBuf[u8];
    pub rodata_relocs: col.DynBuf[mach_x64.RodataReloc];
    pub used_helpers: col.DynBuf[u32];
    pub line_entries: col.DynBuf[elf64.LineEntry];
    pub fn_ref_thunks: col.DynBuf[mach_x64.FnRefThunkReq];
    pub err_msg: str.StrBuf;
}

impl A64FnBlob {
    pub fn init(alloc: *mut AllocCap, sym_id: u32) -> A64FnBlob ! OutOfMemory {
        let code = try col.DynBuf.[u8].init(alloc, 128_usize);
        errdefer code.destroy(alloc);
        let relocs = try col.DynBuf.[a64_asm.A64Reloc].init(alloc, 8_usize);
        errdefer relocs.destroy(alloc);
        let rodata_items = try col.DynBuf.[mach_x64.RodataItemMeta].init(alloc, 4_usize);
        errdefer rodata_items.destroy(alloc);
        let rodata_bytes = try col.DynBuf.[u8].init(alloc, 32_usize);
        errdefer rodata_bytes.destroy(alloc);
        let rodata_relocs = try col.DynBuf.[mach_x64.RodataReloc].init(alloc, 4_usize);
        errdefer rodata_relocs.destroy(alloc);
        let used_helpers = try col.DynBuf.[u32].init(alloc, 4_usize);
        errdefer used_helpers.destroy(alloc);
        let line_entries = try col.DynBuf.[elf64.LineEntry].init(alloc, 16_usize);
        errdefer line_entries.destroy(alloc);
        let fn_ref_thunks = try col.DynBuf.[mach_x64.FnRefThunkReq].init(alloc, 4_usize);
        errdefer fn_ref_thunks.destroy(alloc);
        let err_msg = try str.StrBuf.init(alloc, 16_usize);
        errdefer err_msg.destroy(alloc);
        return A64FnBlob.{
            ok: false,
            sym_id: sym_id,
            own_stack_bytes: 0_u64,
            code: code,
            relocs: relocs,
            rodata_items: rodata_items,
            rodata_bytes: rodata_bytes,
            rodata_relocs: rodata_relocs,
            used_helpers: used_helpers,
            line_entries: line_entries,
            fn_ref_thunks: fn_ref_thunks,
            err_msg: err_msg,
        };
    }

    pub fn destroy(self: A64FnBlob, alloc: *mut AllocCap) {
        let A64FnBlob.{
            ok: _,
            sym_id: _,
            own_stack_bytes: _,
            code,
            relocs,
            rodata_items,
            rodata_bytes,
            rodata_relocs,
            used_helpers,
            line_entries,
            fn_ref_thunks,
            err_msg,
        } = self;
        code.destroy(alloc);
        relocs.destroy(alloc);
        rodata_items.destroy(alloc);
        rodata_bytes.destroy(alloc);
        rodata_relocs.destroy(alloc);
        used_helpers.destroy(alloc);
        line_entries.destroy(alloc);
        fn_ref_thunks.destroy(alloc);
        err_msg.destroy(alloc);
    }
}

pub enum A64ArgClass : u8 {
    Zst = 0,
    IntReg = 1,
    TwoIntRegs = 2,
    FloatReg = 3,
    ByPtr = 4,
}

pub enum A64RetKind : u8 {
    Void = 0,
    IntReg = 1,
    TwoIntRegs = 2,
    FloatReg = 3,
    Sret = 4,
    ErrorUnion = 5,
}

pub struct A64RetClass {
    pub kind: A64RetKind;
    pub ok_ty: types.TyId;
    pub ok_kind: A64RetKind;
}

pub fn a64_gp_arg(idx: usize) -> ?u8 {
    if idx >= 8_usize {
        return null;
    }
    return idx.trunc.[u8](); // X0..X7
}

pub fn a64_flt_arg(idx: usize) -> ?u8 {
    if idx >= 8_usize {
        return null;
    }
    return idx.trunc.[u8](); // V0..V7
}

pub fn a64_classify_arg(ty: types.TyId, env: *types.TypeEnv) -> A64ArgClass {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return .Zst;
    }
    let n = env.get(ty);
    if n.kind == .Float {
        if n.u8_val == 32_u8 || n.u8_val == 64_u8 {
            return .FloatReg;
        }
        return .IntReg;
    }
    if n.kind == .Bool || n.kind == .Char || n.kind == .Int || n.kind == .Enum
        || n.kind == .ErrorSet || n.kind == .Bitfield || n.kind == .RawPtr
        || n.kind == .PhysAddr || n.kind == .VirtAddr || n.kind == .DmaAddr
    {
        if lay.size <= 8_usize { return .IntReg; }
        return .TwoIntRegs;
    }
    if n.kind == .Borrow {
        if n.borrow_kind == .Single && lay.size <= 8_usize { return .IntReg; }
        return .TwoIntRegs;
    }
    if n.kind == .Str || n.kind == .Dyn || n.kind == .FnPtr {
        return .TwoIntRegs;
    }
    if n.kind == .Builtin {
        if n.builtin_kind == .IdBrand || n.builtin_kind == .Link || n.builtin_kind == .GenId
            || n.builtin_kind == .FsCap || n.builtin_kind == .DirCap
            || n.builtin_kind == .NetCap || n.builtin_kind == .ClockCap
            || n.builtin_kind == .IoCap || n.builtin_kind == .BuildCap
            || n.builtin_kind == .MmioReg
        {
            return .IntReg;
        }
    }
    if lay.size <= 8_usize { return .IntReg; }
    if lay.size <= 16_usize { return .TwoIntRegs; }
    return .ByPtr;
}

fn a64_classify_ret_inner(ty: types.TyId, env: *types.TypeEnv) -> A64RetKind {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return .Void;
    }
    let n = env.get(ty);
    if n.kind == .Float {
        if n.u8_val == 32_u8 || n.u8_val == 64_u8 { return .FloatReg; }
        return .IntReg;
    }
    if lay.size <= 8_usize { return .IntReg; }
    if lay.size <= 16_usize { return .TwoIntRegs; }
    return .Sret;
}

pub fn a64_classify_ret(ty: types.TyId, env: *types.TypeEnv) -> A64RetClass {
    let n = env.get(ty);
    if n.kind == .ErrorUnion {
        let ok_ty = n.primary;
        return A64RetClass.{
            kind: .ErrorUnion,
            ok_ty: ok_ty,
            ok_kind: a64_classify_ret_inner(ok_ty, env),
        };
    }
    return A64RetClass.{
        kind: a64_classify_ret_inner(ty, env),
        ok_ty: types.TY_VOID,
        ok_kind: .Void,
    };
}

pub fn a64_ret_uses_sret(rc: A64RetClass) -> bool {
    return rc.kind == .Sret || (rc.kind == .ErrorUnion && rc.ok_kind == .Sret);
}

pub fn a64_is_builtin_rt_helper(name: *[u8]) -> bool {
    return str.bytes_eq(name, "eon_rt_print_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_bytes".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_u64".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_i64".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_f32".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_nl".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_bytes".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_nl".as_bytes())
        || str.bytes_eq(name, "eon_rt_validate_utf8".as_bytes())
        || str.bytes_eq(name, "eon_rt_is_dir".as_bytes())
        || str.bytes_eq(name, "eon_rt_mkdir_all".as_bytes())
        || str.bytes_eq(name, "eon_rt_spawn_wait".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw_uninit".as_bytes())
        || str.bytes_eq(name, "eon_free_raw".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw_san".as_bytes())
        || str.bytes_eq(name, "eon_free_raw_san".as_bytes())
        || str.bytes_eq(name, "eon_arena_alloc_aligned".as_bytes())
        || str.bytes_eq(name, "eon_rt_arena_reset_san".as_bytes())
        || str.bytes_eq(name, "eon_rt_install_san_handler".as_bytes())
        || str.bytes_eq(name, "eon_rt_tls_init".as_bytes())
        || str.bytes_eq(name, "eon_rt_parse_vdso".as_bytes())
        || str.bytes_eq(name, "eon_rt_now_ns".as_bytes())
        || str.bytes_eq(name, "eon_rt_openat2_beneath".as_bytes())
        || str.bytes_eq(name, "eon_rt_read_fd".as_bytes())
        || str.bytes_eq(name, "eon_rt_write_fd".as_bytes())
        || str.bytes_eq(name, "eon_rt_close_fd".as_bytes())
        || str.bytes_eq(name, "eon_f16_to_f32".as_bytes())
        || str.bytes_eq(name, "eon_f32_to_f16".as_bytes())
        || str.bytes_eq(name, "eon_sched_init".as_bytes())
        || str.bytes_eq(name, "eon_sched_shutdown".as_bytes())
        || str.bytes_eq(name, "eon_par_for".as_bytes())
        || str.bytes_eq(name, "eon_sched_run_dag".as_bytes())
        || str.bytes_eq(name, "eon_fiber_switch".as_bytes())
        || str.bytes_eq(name, "eon_iouring_create".as_bytes())
        || str.bytes_eq(name, "eon_iouring_destroy".as_bytes())
        || str.bytes_eq(name, "eon_run_fibers_iouring".as_bytes());
}

fn sanitize_sym_into(alloc: *mut AllocCap, bytes: *[u8], out: *mut str.StrBuf) -> !OutOfMemory {
    var i: usize = 0_usize;
    while i < bytes.len {
        let c = bytes[i];
        let ok = (c >= b'a' && c <= b'z')
            || (c >= b'A' && c <= b'Z')
            || (c >= b'0' && c <= b'9')
            || c == b'_';
        try out.push_byte_grow(alloc, if ok { c } else { b'_' });
        i = i +% 1_usize;
    }
    return;
}

pub fn a64_fn_sym_name_id(
    alloc: *mut AllocCap,
    key: cfg_ir.CfgFnKey,
    eir_prog: *eir.EirProgram,
    interner: *mut span.SymInterner,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 48_usize);
    errdefer sb.destroy(alloc);
    if let fid = eir_prog.find_fn_by_key(key) {
        if let f = eir_prog.get_fn(fid) {
            if f.sig.effects.is_export_c {
                try sb.push_bytes_grow(alloc, interner.get(f.name));
                let sid = try interner.intern(alloc, sb.as_bytes());
                sb.destroy(alloc);
                return sid;
            }
            match key.kind {
                .TopDef => {
                    try sb.push_str_grow(alloc, "eon_fn_");
                    if f.mod_name != span.SYM_EMPTY {
                        let mb = interner.get(f.mod_name);
                        try sb.push_u64_grow(alloc, mb.len.widen.[u64]());
                        try sb.push_byte_grow(alloc, b'_');
                        try sanitize_sym_into(alloc, mb, &mut sb);
                        try sb.push_str_grow(alloc, "__");
                    } else {
                        try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                        try sb.push_byte_grow(alloc, b'_');
                    }
                    try sanitize_sym_into(alloc, interner.get(f.name), &mut sb);
                }
                .ImplMethod => {
                    try sb.push_str_grow(alloc, "eon_m_");
                    if f.mod_name != span.SYM_EMPTY {
                        let mb = interner.get(f.mod_name);
                        try sb.push_u64_grow(alloc, mb.len.widen.[u64]());
                        try sb.push_byte_grow(alloc, b'_');
                        try sanitize_sym_into(alloc, mb, &mut sb);
                        try sb.push_str_grow(alloc, "__");
                        try sb.push_u64_grow(alloc, f.impl_decl_idx.widen.[u64]());
                    } else {
                        try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                    }
                    try sb.push_byte_grow(alloc, b'_');
                    try sb.push_u64_grow(alloc, key.b.widen.[u64]());
                    try sb.push_byte_grow(alloc, b'_');
                    try sanitize_sym_into(alloc, interner.get(f.name), &mut sb);
                }
                .GenericInst => {
                    try sb.push_str_grow(alloc, "eon_g_");
                    try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                    try sb.push_byte_grow(alloc, b'_');
                    try sanitize_sym_into(alloc, interner.get(f.name), &mut sb);
                }
                .Closure => {
                    try sb.push_str_grow(alloc, "eon_c_");
                    try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                }
            }
            let sid = try interner.intern(alloc, sb.as_bytes());
            sb.destroy(alloc);
            return sid;
        }
    }
    match key.kind {
        .TopDef => {
            try sb.push_str_grow(alloc, "eon_fn_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
        }
        .ImplMethod => {
            try sb.push_str_grow(alloc, "eon_m_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
            try sb.push_byte_grow(alloc, b'_');
            try sb.push_u64_grow(alloc, key.b.widen.[u64]());
        }
        .GenericInst => {
            try sb.push_str_grow(alloc, "eon_g_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
        }
        .Closure => {
            try sb.push_str_grow(alloc, "eon_c_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
        }
    }
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

pub fn intern_sym_u64(alloc: *mut AllocCap, interner: *mut span.SymInterner, prefix: *str, a: u64) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 40_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, prefix);
    try sb.push_u64_grow(alloc, a);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

pub fn intern_sym_u64_2(alloc: *mut AllocCap, interner: *mut span.SymInterner, prefix: *str, a: u64, b: u64) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 48_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, prefix);
    try sb.push_u64_grow(alloc, a);
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, b);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn intern_rodata_sym(alloc: *mut AllocCap, interner: *mut span.SymInterner, fn_sym_id: u32, idx: u64) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 64_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, ".Lro_");
    try sb.push_bytes_grow(alloc, interner.get(fn_sym_id));
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, idx);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn parse_f64_lit(src: *[u8]) -> f64 {
    var end = src.len;
    if end >= 4_usize && src[end - 4_usize] == b'_' && src[end - 3_usize] == b'f' {
        end = end - 4_usize;
    } else if end >= 3_usize && src[end - 3_usize] == b'f' {
        end = end - 3_usize;
    }
    var i: usize = 0_usize;
    var neg = false;
    if i < end && src[i] == b'-' { neg = true; i = i +% 1_usize; }
    else if i < end && src[i] == b'+' { i = i +% 1_usize; }
    var int_part: f64 = 0.0_f64;
    while i < end {
        let ch = src[i];
        if ch == b'_' { i = i +% 1_usize; continue; }
        if ch >= b'0' && ch <= b'9' {
            int_part = int_part * 10.0_f64 + (ch - b'0').widen.[u64]().to_float.[f64]();
            i = i +% 1_usize;
        } else { break; }
    }
    var frac_part: f64 = 0.0_f64;
    var frac_div: f64 = 1.0_f64;
    if i < end && src[i] == b'.' {
        i = i +% 1_usize;
        while i < end {
            let ch = src[i];
            if ch == b'_' { i = i +% 1_usize; continue; }
            if ch >= b'0' && ch <= b'9' {
                frac_part = frac_part * 10.0_f64 + (ch - b'0').widen.[u64]().to_float.[f64]();
                frac_div = frac_div * 10.0_f64;
                i = i +% 1_usize;
            } else { break; }
        }
    }
    var val: f64 = int_part + (frac_part / frac_div);
    if i < end && (src[i] == b'e' || src[i] == b'E') {
        i = i +% 1_usize;
        var exp_neg = false;
        if i < end && src[i] == b'-' { exp_neg = true; i = i +% 1_usize; }
        else if i < end && src[i] == b'+' { i = i +% 1_usize; }
        var exp_acc: i32 = 0_i32;
        while i < end {
            let ch = src[i];
            if ch == b'_' { i = i +% 1_usize; continue; }
            if ch >= b'0' && ch <= b'9' {
                if exp_acc < 1000_i32 { exp_acc = exp_acc *% 10_i32 +% (ch - b'0').widen.[i32](); }
                i = i +% 1_usize;
            } else { break; }
        }
        var pow10: f64 = 1.0_f64;
        var base: f64 = 10.0_f64;
        var e = exp_acc;
        while e > 0_i32 {
            if (e & 1_i32) != 0_i32 { pow10 = pow10 * base; }
            base = base * base;
            e = e >> 1_i32;
        }
        if exp_neg { val = val / pow10; } else { val = val * pow10; }
    }
    if neg { val = -val; }
    return val;
}

fn f64_bits_to_f32_bits(bits: u64) -> u32 {
    let sign = ((bits >> 32_u64) & 0x80000000_u64).trunc.[u32]();
    let exp = ((bits >> 52_u64) & 0x7FF_u64).trunc.[i32]();
    let frac = bits & 0x000FFFFFFFFFFFFF_u64;
    if exp == 0x7FF_i32 {
        if frac != 0_u64 {
            let payload = (frac >> 29_u64).trunc.[u32]();
            return sign | 0x7F800000_u32 | (if payload == 0_u32 { 1_u32 } else { payload });
        }
        return sign | 0x7F800000_u32;
    }
    if exp == 0_i32 { return sign; }
    let unbiased = exp -% 1023_i32;
    if unbiased > 127_i32 { return sign | 0x7F800000_u32; }
    if unbiased < -149_i32 { return sign; }
    if unbiased < -126_i32 {
        let full = frac | 0x0010000000000000_u64;
        let shift = (((-126_i32 -% unbiased).bitcast.[u32]() +% 29_u32).widen.[u64]()) & 63_u64;
        let mant = (full >> shift).trunc.[u32]();
        let rem = full & ((1_u64 <<% shift) -% 1_u64);
        let half = 1_u64 <<% (shift -% 1_u64);
        let round: u32 = if rem > half || (rem == half && (mant & 1_u32) != 0_u32) { 1_u32 } else { 0_u32 };
        return sign | (mant +% round);
    }
    let f_exp = ((unbiased +% 127_i32).bitcast.[u32]()) <<% 23_u32;
    let mant = (frac >> 29_u64).trunc.[u32]();
    let rem = frac & 0x1FFFFFFF_u64;
    let round: u32 = if rem > 0x10000000_u64 || (rem == 0x10000000_u64 && (mant & 1_u32) != 0_u32) { 1_u32 } else { 0_u32 };
    return sign | (f_exp +% mant +% round);
}

fn f32_bits_to_f16_bits(bits: u32) -> u16 {
    let sign = ((bits >> 16_u32) & 0x8000_u32).trunc.[u16]();
    let exp = ((bits >> 23_u32) & 0xFF_u32).bitcast.[i32]() -% 127_i32;
    let frac = bits & 0x007FFFFF_u32;
    if exp == 128_i32 {
        if frac != 0_u32 { return sign | 0x7E00_u16 | ((frac >> 13_u32).trunc.[u16]() & 0x03FF_u16); }
        return sign | 0x7C00_u16;
    }
    if exp > 15_i32 { return sign | 0x7C00_u16; }
    if exp < -14_i32 {
        if exp < -24_i32 { return sign; }
        let m = frac | 0x00800000_u32;
        let shift = (14_i32 -% exp +% 13_i32).bitcast.[u32]();
        if shift >= 32_u32 { return sign; }
        return sign | (m >> shift).trunc.[u16]();
    }
    let hexp = ((exp +% 15_i32).bitcast.[u32]() & 0x1F_u32) <<% 10_u32;
    return sign | hexp.trunc.[u16]() | (frac >> 13_u32).trunc.[u16]();
}

// ============================================================================
// Section 2: Optimized SSA EIR -> `MachFunc` ISel for AArch64 (`--release`)
// ============================================================================
// Lowers pure scalar/FP/control-flow/call SSA functions into `mach_ir.MachFunc`
// targeting `TargetRegFile.aarch64_aapcs64()`, unlocking shared `mach_regalloc`
// (26 GPRs + 30 FP/NEON regs) and `mach_opt_a64` peephole + emission!

fn is_fast_scalar_int_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    let n = env.get(ty);
    if n.kind == .Bool { return true; }
    if n.kind == .Int {
        let bits = env.int_bits(ty);
        return bits == 8_u8 || bits == 16_u8 || bits == 32_u8 || bits == 64_u8;
    }
    if n.kind == .Enum || n.kind == .Char || n.kind == .RawPtr {
        let sz = env.x64_layout(ty).size;
        return sz == 1_usize || sz == 2_usize || sz == 4_usize || sz == 8_usize;
    }
    return false;
}

fn is_fast_a64_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    let n = env.get(ty);
    if n.kind == .Void || n.kind == .Never { return true; }
    if is_fast_scalar_int_ty(env, ty) { return true; }
    if n.kind == .Float && (n.u8_val == 32_u8 || n.u8_val == 64_u8) { return true; }
    return false;
}

fn a64_isel_vreg_of(vmap: *[u32], v: eir.EirValue) -> mach_ir.VReg {
    let idx = v.widen.[usize]();
    if idx < vmap.len { return vmap[idx]; }
    return mach_ir.VREG_NONE;
}

fn a64_isel_ensure_vreg(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    vmap: *mut [u32],
    v: eir.EirValue,
) -> mach_ir.VReg ! OutOfMemory {
    let idx = v.widen.[usize]();
    if idx < vmap.len && vmap[idx] != mach_ir.VREG_NONE {
        return vmap[idx];
    }
    let ty = eir_prog.fn_val_ty(fn_id, v);
    let cls: mach_ir.RegClass = if env.get(ty).kind == .Float { .Vec128 } else { .Gpr };
    let vr = try mf.new_vreg(alloc, cls);
    if idx < vmap.len {
        vmap[idx] = vr;
    }
    return vr;
}

fn a64_is_mach_eligible(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> bool {
    let f = eir_prog.get_fn(fn_id) orelse { return false; };
    if f.sig.effects.is_naked || f.sig.effects.is_interrupt || f.par_for_regions.len > 0_u32 {
        return false;
    }
    let rc = a64_classify_ret(f.sig.ret, env);
    if rc.kind == .Sret || rc.kind == .TwoIntRegs || rc.kind == .ErrorUnion {
        return false;
    }
    if !is_fast_a64_ty(env, f.sig.ret) {
        return false;
    }
    let params = eir_prog.fn_params(fn_id);
    var p_gp: usize = 0_usize;
    var p_fp: usize = 0_usize;
    var pi: usize = 0_usize;
    while pi < params.len {
        let pty = eir_prog.fn_val_ty(fn_id, params[pi]);
        if !is_fast_a64_ty(env, pty) { return false; }
        let cls = a64_classify_arg(pty, env);
        if cls == .IntReg {
            if p_gp >= 8_usize { return false; }
            p_gp = p_gp +% 1_usize;
        } else if cls == .FloatReg {
            if p_fp >= 8_usize { return false; }
            p_fp = p_fp +% 1_usize;
        } else if cls != .Zst {
            return false;
        }
        pi = pi +% 1_usize;
    }
    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < slots.len {
        if !is_fast_a64_ty(env, slots[si].ty) { return false; }
        si = si +% 1_usize;
    }
    let blks = eir_prog.fn_blocks(fn_id);
    if blks.len == 0_usize { return false; }
    var bi: usize = 0_usize;
    while bi < blks.len {
        let cur_b = blks[bi];
        let phis = eir_prog.phis_slice(cur_b.phis);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len {
            if !is_fast_a64_ty(env, phis[phi_i].ty) { return false; }
            phi_i = phi_i +% 1_usize;
        }
        let insts = eir_prog.insts_slice(cur_b.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let ins = insts[ii];
            if ins.kind == .Const {
                if !is_fast_a64_ty(env, ins.ty0) { return false; }
                let c = eir_prog.get_const(ins.aux0) orelse { return false; };
                if c.kind != .Void && c.kind != .Bool && c.kind != .Char && c.kind != .Int && c.kind != .EnumTag && c.kind != .Float {
                    return false;
                }
                if c.kind == .Int && env.x64_layout(ins.ty0).size > 8_usize { return false; }
            } else if ins.kind == .Copy || ins.kind == .LoadSlot {
                if !is_fast_a64_ty(env, eir_prog.fn_val_ty(fn_id, ins.dst)) { return false; }
            } else if ins.kind == .StoreSlot {
                if !is_fast_a64_ty(env, eir_prog.fn_val_ty(fn_id, ins.v0)) { return false; }
            } else if ins.kind == .Unary {
                if !is_fast_scalar_int_ty(env, ins.ty0) { return false; }
                if ins.unary_op != .Neg && ins.unary_op != .Not && ins.unary_op != .BitNot { return false; }
            } else if ins.kind == .Binary {
                if !is_fast_a64_ty(env, ins.ty0) || !is_fast_a64_ty(env, ins.ty1) { return false; }
                if ins.bin_op == .AddCheck || ins.bin_op == .SubCheck || ins.bin_op == .MulCheck
                    || ins.bin_op == .DivCheck || ins.bin_op == .ModCheck
                    || ins.bin_op == .AddSat || ins.bin_op == .SubSat || ins.bin_op == .MulSat
                {
                    return false;
                }
                if env.get(ins.ty1).kind == .Float {
                    if ins.bin_op != .Add && ins.bin_op != .Sub && ins.bin_op != .Mul && ins.bin_op != .Div {
                        return false;
                    }
                }
            } else if ins.kind == .Cast {
                if !is_fast_a64_ty(env, ins.ty0) || !is_fast_a64_ty(env, ins.ty1) { return false; }
                if ins.cast_kind != .Widen && ins.cast_kind != .Trunc && ins.cast_kind != .Bitcast
                    && ins.cast_kind != .ToFloat && ins.cast_kind != .TruncToInt && ins.cast_kind != .AsU64
                {
                    return false;
                }
                if ins.cast_kind == .ToFloat && !env.is_signed_int(ins.ty1) { return false; }
                if ins.cast_kind == .TruncToInt && !env.is_signed_int(ins.ty0) { return false; }
            } else if ins.kind == .Call {
                let cd = eir_prog.get_call(ins.aux0) orelse { return false; };
                if cd.callee.kind != .DirectFn && cd.callee.kind != .Method && cd.callee.kind != .GenericInst {
                    return false;
                }
                let crc = a64_classify_ret(cd.ret_ty, env);
                if crc.kind == .Sret || crc.kind == .TwoIntRegs || crc.kind == .ErrorUnion { return false; }
                if !is_fast_a64_ty(env, cd.ret_ty) { return false; }
                let cargs = eir_prog.vals_slice(cd.args);
                var cgp: usize = 0_usize;
                var cfp: usize = 0_usize;
                var cai: usize = 0_usize;
                while cai < cargs.len {
                    let caty = eir_prog.fn_val_ty(fn_id, cargs[cai]);
                    if !is_fast_a64_ty(env, caty) { return false; }
                    let ccls = a64_classify_arg(caty, env);
                    if ccls == .IntReg {
                        if cgp >= 8_usize { return false; }
                        cgp = cgp +% 1_usize;
                    } else if ccls == .FloatReg {
                        if cfp >= 8_usize { return false; }
                        cfp = cfp +% 1_usize;
                    } else if ccls != .Zst {
                        return false;
                    }
                    cai = cai +% 1_usize;
                }
            } else {
                return false;
            }
            ii = ii +% 1_usize;
        }
        let bt = cur_b.term;
        if bt.kind == .SwitchInt {
            return false;
        }
        if bt.kind == .Branch {
            if eir_prog.block_phis(fn_id, bt.bb0).len > 0_usize || eir_prog.block_phis(fn_id, bt.bb1).len > 0_usize {
                return false;
            }
        }
        bi = bi +% 1_usize;
    }
    return true;
}

fn a64_lower_inst_const_copy_slot(
    alloc: *mut AllocCap,
    out_mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    vmap: *mut [u32],
    slot_s: *[i32],
    ins: eir.EirInst,
) -> !OutOfMemory {
    let sp = ins.span;
    if ins.kind == .Const {
        if ins.dst != eir.EIR_NONE && env.x64_layout(ins.ty0).size > 0_usize {
            let dvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.dst);
            if let c = eir_prog.get_const(ins.aux0) {
                if c.kind == .Bool {
                    try out_mf.emit_inst(alloc, mach_ir.inst_mov_imm(dvr, if c.bool_val { 1_i64 } else { 0_i64 }, sp));
                } else if c.kind == .Char {
                    try out_mf.emit_inst(alloc, mach_ir.inst_mov_imm(dvr, c.aux_u32.widen.[i64](), sp));
                } else if c.kind == .Int || c.kind == .EnumTag {
                    try out_mf.emit_inst(alloc, mach_ir.inst_mov_imm(dvr, c.int_val.lo.bitcast.[i64](), sp));
                } else if c.kind == .Float {
                    let fval = parse_f64_lit(eir_prog.bytes_slice(c.bytes));
                    let is_f64 = env.get(ins.ty0).u8_val == 64_u8;
                    let tmp = try out_mf.new_vreg(alloc, .Gpr);
                    if is_f64 {
                        try out_mf.emit_inst(alloc, mach_ir.inst_mov_imm(tmp, fval.bitcast.[i64](), sp));
                        var mv = mach_ir.inst_empty(.VMovQToXmm, sp);
                        mv.dst = dvr; mv.src0 = tmp;
                        try out_mf.emit_inst(alloc, mv);
                    } else {
                        let f32_b = f64_bits_to_f32_bits(fval.bitcast.[u64]());
                        try out_mf.emit_inst(alloc, mach_ir.inst_mov_imm(tmp, f32_b.widen.[i64](), sp));
                        var mv = mach_ir.inst_empty(.VMovDToXmm, sp);
                        mv.dst = dvr; mv.src0 = tmp;
                        try out_mf.emit_inst(alloc, mv);
                    }
                }
            }
        }
    } else if ins.kind == .Copy {
        let ty = eir_prog.fn_val_ty(fn_id, ins.dst);
        if env.x64_layout(ty).size > 0_usize {
            let svr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.v0);
            let dvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.dst);
            if env.get(ty).kind == .Float {
                var mv = mach_ir.inst_empty(.VMovVecReg, sp);
                mv.dst = dvr; mv.src0 = svr;
                try out_mf.emit_inst(alloc, mv);
            } else {
                try out_mf.emit_inst(alloc, mach_ir.inst_copy(dvr, svr, sp));
            }
        }
    } else if ins.kind == .LoadSlot {
        let ty = eir_prog.fn_val_ty(fn_id, ins.dst);
        let lay = env.x64_layout(ty);
        if lay.size > 0_usize {
            let dvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.dst);
            let sidx = ins.aux0.widen.[usize]();
            let soff = if sidx < slot_s.len { slot_s[sidx] } else { -8_i32 };
            let m = mach_ir.mem_stack_slot(soff);
            if env.get(ty).kind == .Float {
                let op: mach_ir.MachOp = if env.get(ty).u8_val == 64_u8 { .VMovSDLoad } else { .VMovSSLoad };
                var mi = mach_ir.inst_empty(op, sp);
                mi.dst = dvr; mi.mem = m;
                try out_mf.emit_inst(alloc, mi);
            } else {
                let op: mach_ir.MachOp = if env.is_signed_int(ty) && lay.size < 8_usize { .LoadSX } else { .Load };
                var mi = mach_ir.inst_empty(op, sp);
                mi.dst = dvr; mi.mem = m; mi.size_bytes = lay.size.trunc.[u8]();
                try out_mf.emit_inst(alloc, mi);
            }
        }
    } else if ins.kind == .StoreSlot {
        let ty = eir_prog.fn_val_ty(fn_id, ins.v0);
        let lay = env.x64_layout(ty);
        if lay.size > 0_usize {
            let svr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.v0);
            let sidx = ins.aux0.widen.[usize]();
            let soff = if sidx < slot_s.len { slot_s[sidx] } else { -8_i32 };
            let m = mach_ir.mem_stack_slot(soff);
            if env.get(ty).kind == .Float {
                let op: mach_ir.MachOp = if env.get(ty).u8_val == 64_u8 { .VMovSDStore } else { .VMovSSStore };
                var mi = mach_ir.inst_empty(op, sp);
                mi.src0 = svr; mi.mem = m;
                try out_mf.emit_inst(alloc, mi);
            } else {
                try out_mf.emit_inst(alloc, mach_ir.inst_store(m, svr, lay.size.trunc.[u8](), sp));
            }
        }
    }
    return;
}

fn a64_lower_inst_alu(
    alloc: *mut AllocCap,
    out_mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    vmap: *mut [u32],
    ins: eir.EirInst,
) -> !OutOfMemory {
    let sp = ins.span;
    if ins.kind == .Unary {
        let svr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.v0);
        let dvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.dst);
        let bytes = env.x64_layout(ins.ty0).size.trunc.[u8]();
        if ins.unary_op == .Neg {
            var mi = mach_ir.inst_empty(.Neg, sp);
            mi.dst = dvr; mi.src0 = svr;
            try out_mf.emit_inst(alloc, mi);
        } else if ins.unary_op == .Not {
            var mi = mach_ir.inst_empty(.XorImm, sp);
            mi.dst = dvr; mi.src0 = svr; mi.imm = 1_i64;
            try out_mf.emit_inst(alloc, mi);
        } else {
            var mi = mach_ir.inst_empty(.Not, sp);
            mi.dst = dvr; mi.src0 = svr;
            try out_mf.emit_inst(alloc, mi);
        }
        if bytes < 8_u8 && ins.unary_op != .Not {
            var ex = mach_ir.inst_empty(.Extend, sp);
            ex.dst = dvr; ex.src0 = dvr; ex.size_bytes = bytes; ex.flag0 = env.is_signed_int(ins.ty0);
            try out_mf.emit_inst(alloc, ex);
        }
        return;
    }
    let lvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.v0);
    let rvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.v1);
    let dvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.dst);
    if env.get(ins.ty1).kind == .Float {
        let is64 = env.get(ins.ty1).u8_val == 64_u8;
        var mop: mach_ir.MachOp = if is64 { .VDivSD } else { .VDivSS };
        if ins.bin_op == .Add { mop = if is64 { .VAddSD } else { .VAddSS }; }
        else if ins.bin_op == .Sub { mop = if is64 { .VSubSD } else { .VSubSS }; }
        else if ins.bin_op == .Mul { mop = if is64 { .VMulSD } else { .VMulSS }; }
        var mi = mach_ir.inst_empty(mop, sp);
        mi.dst = dvr; mi.src0 = lvr; mi.src1 = rvr;
        try out_mf.emit_inst(alloc, mi);
        return;
    }
    let signed = env.is_signed_int(ins.ty1);
    let bytes = env.x64_layout(ins.ty1).size.trunc.[u8]();
    let dst_bytes = env.x64_layout(ins.ty0).size.trunc.[u8]();
    let is_cmp = ins.bin_op == .Eq || ins.bin_op == .NotEq || ins.bin_op == .Lt
        || ins.bin_op == .LtEq || ins.bin_op == .Gt || ins.bin_op == .GtEq;
    if is_cmp {
        var cmp = mach_ir.inst_empty(.Cmp, sp);
        cmp.src0 = lvr; cmp.src1 = rvr;
        try out_mf.emit_inst(alloc, cmp);
        var sc = mach_ir.inst_empty(.Setcc, sp);
        sc.dst = dvr;
        sc.cc = if signed { .Ge } else { .Ae };
        if ins.bin_op == .Eq { sc.cc = .E; }
        else if ins.bin_op == .NotEq { sc.cc = .Ne; }
        else if ins.bin_op == .Lt { sc.cc = if signed { .L } else { .B }; }
        else if ins.bin_op == .LtEq { sc.cc = if signed { .Le } else { .Be }; }
        else if ins.bin_op == .Gt { sc.cc = if signed { .G } else { .A }; }
        try out_mf.emit_inst(alloc, sc);
    } else if ins.bin_op == .Div || ins.bin_op == .Mod {
        let dop: mach_ir.MachOp = if signed { .Idiv } else { .Div };
        var dv = mach_ir.inst_empty(dop, sp);
        dv.src0 = lvr; dv.src1 = rvr;
        if ins.bin_op == .Div { dv.dst = dvr; } else { dv.dst2 = dvr; }
        try out_mf.emit_inst(alloc, dv);
        if dst_bytes < 8_u8 {
            var ex = mach_ir.inst_empty(.Extend, sp);
            ex.dst = dvr; ex.src0 = dvr; ex.size_bytes = dst_bytes; ex.flag0 = signed;
            try out_mf.emit_inst(alloc, ex);
        }
    } else {
        var mop: mach_ir.MachOp = if signed { .Sar } else { .Shr };
        if ins.bin_op == .Add || ins.bin_op == .AddWrap { mop = .Add; }
        else if ins.bin_op == .Sub || ins.bin_op == .SubWrap { mop = .Sub; }
        else if ins.bin_op == .Mul || ins.bin_op == .MulWrap { mop = .Mul; }
        else if ins.bin_op == .BitAnd || ins.bin_op == .And { mop = .And; }
        else if ins.bin_op == .BitOr || ins.bin_op == .Or { mop = .Or; }
        else if ins.bin_op == .BitXor { mop = .Xor; }
        else if ins.bin_op == .Shl || ins.bin_op == .ShlWrap { mop = .Shl; }
        var src_r = rvr;
        if ins.bin_op == .ShlWrap && bytes < 8_u8 {
            let mvr = try out_mf.new_vreg(alloc, .Gpr);
            var am = mach_ir.inst_empty(.AndImm, sp);
            am.dst = mvr; am.src0 = rvr; am.imm = (bytes.widen.[i64]() *% 8_i64) -% 1_i64;
            try out_mf.emit_inst(alloc, am);
            src_r = mvr;
        }
        var mi = mach_ir.inst_empty(mop, sp);
        mi.dst = dvr; mi.src0 = lvr; mi.src1 = src_r;
        try out_mf.emit_inst(alloc, mi);
        if dst_bytes < 8_u8 && ins.bin_op != .And && ins.bin_op != .Or {
            var ex = mach_ir.inst_empty(.Extend, sp);
            ex.dst = dvr; ex.src0 = dvr; ex.size_bytes = dst_bytes; ex.flag0 = env.is_signed_int(ins.ty0);
            try out_mf.emit_inst(alloc, ex);
        }
    }
    return;
}

fn a64_lower_inst_cast_call(
    alloc: *mut AllocCap,
    out_mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    vmap: *mut [u32],
    ins: eir.EirInst,
) -> !OutOfMemory {
    let sp = ins.span;
    if ins.kind == .Cast {
        let svr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.v0);
        let dvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.dst);
        let fn_node = env.get(ins.ty1);
        let tn_node = env.get(ins.ty0);
        if ins.cast_kind == .Widen {
            if fn_node.kind == .Float && tn_node.kind == .Float {
                let op: mach_ir.MachOp = if fn_node.u8_val == 32_u8 && tn_node.u8_val == 64_u8 { .VCvtSS2SD } else { .VMovVecReg };
                var mi = mach_ir.inst_empty(op, sp);
                mi.dst = dvr; mi.src0 = svr;
                try out_mf.emit_inst(alloc, mi);
            } else {
                try out_mf.emit_inst(alloc, mach_ir.inst_copy(dvr, svr, sp));
            }
        } else if ins.cast_kind == .Trunc {
            if fn_node.kind == .Float && tn_node.kind == .Float {
                let op: mach_ir.MachOp = if fn_node.u8_val == 64_u8 && tn_node.u8_val == 32_u8 { .VCvtSD2SS } else { .VMovVecReg };
                var mi = mach_ir.inst_empty(op, sp);
                mi.dst = dvr; mi.src0 = svr;
                try out_mf.emit_inst(alloc, mi);
            } else {
                let bytes = env.x64_layout(ins.ty0).size.trunc.[u8]();
                if bytes < 8_u8 {
                    var ex = mach_ir.inst_empty(.Extend, sp);
                    ex.dst = dvr; ex.src0 = svr; ex.size_bytes = bytes; ex.flag0 = env.is_signed_int(ins.ty0);
                    try out_mf.emit_inst(alloc, ex);
                } else {
                    try out_mf.emit_inst(alloc, mach_ir.inst_copy(dvr, svr, sp));
                }
            }
        } else if ins.cast_kind == .ToFloat {
            let op: mach_ir.MachOp = if tn_node.u8_val == 64_u8 { .VCvtSI2SD } else { .VCvtSI2SS };
            var mi = mach_ir.inst_empty(op, sp);
            mi.dst = dvr; mi.src0 = svr; mi.size_bytes = 8_u8;
            try out_mf.emit_inst(alloc, mi);
        } else if ins.cast_kind == .TruncToInt {
            let op: mach_ir.MachOp = if fn_node.u8_val == 64_u8 { .VCvtTTSD2SI } else { .VCvtTTSS2SI };
            var mi = mach_ir.inst_empty(op, sp);
            mi.dst = dvr; mi.src0 = svr; mi.size_bytes = 8_u8;
            try out_mf.emit_inst(alloc, mi);
            let bytes = env.x64_layout(ins.ty0).size.trunc.[u8]();
            if bytes < 8_u8 {
                var ex = mach_ir.inst_empty(.Extend, sp);
                ex.dst = dvr; ex.src0 = dvr; ex.size_bytes = bytes; ex.flag0 = env.is_signed_int(ins.ty0);
                try out_mf.emit_inst(alloc, ex);
            }
        } else if ins.cast_kind == .Bitcast {
            if fn_node.kind == .Float && tn_node.kind != .Float {
                let op: mach_ir.MachOp = if fn_node.u8_val == 64_u8 { .VMovQFromXmm } else { .VMovDFromXmm };
                var mi = mach_ir.inst_empty(op, sp);
                mi.dst = dvr; mi.src0 = svr;
                try out_mf.emit_inst(alloc, mi);
            } else if fn_node.kind != .Float && tn_node.kind == .Float {
                let op: mach_ir.MachOp = if tn_node.u8_val == 64_u8 { .VMovQToXmm } else { .VMovDToXmm };
                var mi = mach_ir.inst_empty(op, sp);
                mi.dst = dvr; mi.src0 = svr;
                try out_mf.emit_inst(alloc, mi);
            } else {
                let bytes = env.x64_layout(ins.ty0).size.trunc.[u8]();
                if bytes < 8_u8 {
                    var ex = mach_ir.inst_empty(.Extend, sp);
                    ex.dst = dvr; ex.src0 = svr; ex.size_bytes = bytes; ex.flag0 = env.is_signed_int(ins.ty0);
                    try out_mf.emit_inst(alloc, ex);
                } else {
                    try out_mf.emit_inst(alloc, mach_ir.inst_copy(dvr, svr, sp));
                }
            }
        } else {
            try out_mf.emit_inst(alloc, mach_ir.inst_copy(dvr, svr, sp));
        }
        return;
    }
    if ins.kind == .Call {
        if let cd = eir_prog.get_call(ins.aux0) {
            let cargs = eir_prog.vals_slice(cd.args);
            var gpi: usize = 0_usize;
            var fpi: usize = 0_usize;
            var cai: usize = 0_usize;
            while cai < cargs.len {
                let av = cargs[cai];
                let aty = eir_prog.fn_val_ty(fn_id, av);
                let cls = a64_classify_arg(aty, env);
                if cls == .IntReg {
                    let avr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, av);
                    try out_mf.emit_inst(alloc, mach_ir.inst_use_fixed(avr, gpi.trunc.[u8](), sp));
                    gpi = gpi +% 1_usize;
                } else if cls == .FloatReg {
                    let avr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, av);
                    try out_mf.emit_inst(alloc, mach_ir.inst_use_fixed(avr, fpi.trunc.[u8](), sp));
                    fpi = fpi +% 1_usize;
                }
                cai = cai +% 1_usize;
            }
            var ckey = cfg_ir.fn_key_generic_inst(cd.callee.a);
            if cd.callee.kind == .DirectFn {
                ckey = cfg_ir.fn_key_top_def(cd.callee.a);
            } else if cd.callee.kind == .Method {
                ckey = cfg_ir.fn_key_impl_method(cd.callee.a, cd.callee.b);
            }
            let csym = try a64_fn_sym_name_id(alloc, ckey, eir_prog, interner);
            try out_mf.emit_inst(
                alloc,
                mach_ir.inst_call_sym(csym, out_mf.reg_file.caller_saved_gprs, out_mf.reg_file.caller_saved_vecs, sp),
            );
            if ins.dst != eir.EIR_NONE && env.x64_layout(cd.ret_ty).size > 0_usize {
                let dvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ins.dst);
                try out_mf.emit_inst(alloc, mach_ir.inst_def_fixed(dvr, 0_u8, sp));
            }
        }
    }
    return;
}

fn a64_lower_term_to_mach(
    alloc: *mut AllocCap,
    out_mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    ret_ty: types.TyId,
    vmap: *mut [u32],
    bb: u32,
    term: eir.EirTerm,
) -> !OutOfMemory {
    let tsp = term.span;
    if term.kind == .Goto {
        let ps = out_mf.pcopy_pairs.len().trunc.[u32]();
        let tphis = eir_prog.block_phis(fn_id, term.bb0);
        var tpi: usize = 0_usize;
        while tpi < tphis.len {
            let tphi = tphis[tpi];
            let inc = eir_prog.phi_incoming(tphi.incoming);
            var k: usize = 0_usize;
            while k < inc.len {
                let ink = inc[k];
                if ink.pred_bb == bb && ink.val != tphi.dst && env.x64_layout(tphi.ty).size > 0_usize {
                    let dvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, tphi.dst);
                    let svr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, ink.val);
                    try out_mf.add_pcopy_pair(alloc, dvr, svr);
                    break;
                }
                k = k +% 1_usize;
            }
            tpi = tpi +% 1_usize;
        }
        let plen = out_mf.pcopy_pairs.len().trunc.[u32]() -% ps;
        try out_mf.emit_parallel_copy(alloc, ps, plen, tsp);
        try out_mf.emit_inst(alloc, mach_ir.inst_jmp(term.bb0, tsp));
    } else if term.kind == .Branch {
        let cvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, term.val);
        var tst = mach_ir.inst_empty(.Cmp32Imm, tsp);
        tst.src0 = cvr; tst.imm = 0_i64;
        try out_mf.emit_inst(alloc, tst);
        try out_mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, term.bb0, tsp));
        try out_mf.emit_inst(alloc, mach_ir.inst_jmp(term.bb1, tsp));
    } else if term.kind == .Return {
        if term.flag && env.x64_layout(ret_ty).size > 0_usize {
            let rvr = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap, term.val);
            try out_mf.emit_inst(alloc, mach_ir.inst_use_fixed(rvr, 0_u8, tsp));
        }
        try out_mf.emit_inst(alloc, mach_ir.inst_ret(tsp));
    } else if term.kind == .Unreachable {
        try out_mf.emit_inst(alloc, mach_ir.inst_empty(.Ud2, tsp));
    }
    return;
}

/// Attempts to lower an EIR function cleanly into `mach_ir.MachFunc` for AArch64.
/// Returns `true` if eligible and lowered completely; returns `false` to fall back
/// to the 100%-EIR-coverage `compile_fn_a64_direct`.
pub fn try_lower_eir_to_mach_a64(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    fn_sym: u32,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    spec: target.TargetSpec,
    out_mf: *mut mach_ir.MachFunc,
) -> bool ! OutOfMemory {
    if !a64_is_mach_eligible(eir_prog, fn_id, env) {
        return false;
    }
    let f = eir_prog.get_fn(fn_id) orelse { return false; };
    let params = eir_prog.fn_params(fn_id);
    let slots = eir_prog.fn_slots(fn_id);
    let blks = eir_prog.fn_blocks(fn_id);

    _ = fn_sym;
    out_mf.reg_file = target.TargetRegFile.for_target(spec);
    let nvals = f.value_tys.len.widen.[usize]();
    var vmap = try col.DynBuf.[u32].init(alloc, if nvals > 8_usize { nvals } else { 8_usize });
    errdefer vmap.destroy(alloc);
    var vi0: usize = 0_usize;
    while vi0 < nvals {
        try vmap.push(alloc, mach_ir.VREG_NONE);
        vi0 = vi0 +% 1_usize;
    }
    var slot_offs = try col.DynBuf.[i32].init(alloc, if slots.len > 4_usize { slots.len } else { 4_usize });
    errdefer slot_offs.destroy(alloc);
    var si: usize = 0_usize;
    while si < slots.len {
        let sl = env.x64_layout(slots[si].ty);
        let sz = if sl.size == 0_usize { 8_usize } else { sl.size };
        let al = if sl.align == 0_usize { 8_usize } else { sl.align };
        try slot_offs.push(alloc, out_mf.alloc_stack_slot(sz, al));
        si = si +% 1_usize;
    }

    var bi_mk: usize = 0_usize;
    while bi_mk < blks.len {
        _ = try out_mf.add_block(alloc, 0_u8);
        bi_mk = bi_mk +% 1_usize;
    }
    out_mf.entry_block = 0_u32;

    var pi: usize = 0_usize;
    while pi < params.len {
        let pty = eir_prog.fn_val_ty(fn_id, params[pi]);
        if env.x64_layout(pty).size > 0_usize {
            _ = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap.as_mut_slice(), params[pi]);
        }
        pi = pi +% 1_usize;
    }
    var bi: usize = 0_usize;
    while bi < blks.len {
        let phis = eir_prog.phis_slice(blks[bi].phis);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len {
            if env.x64_layout(phis[phi_i].ty).size > 0_usize {
                _ = try a64_isel_ensure_vreg(alloc, out_mf, eir_prog, fn_id, env, vmap.as_mut_slice(), phis[phi_i].dst);
            }
            phi_i = phi_i +% 1_usize;
        }
        bi = bi +% 1_usize;
    }

    let slot_s = slot_offs.as_slice();
    bi = 0_usize;
    while bi < blks.len {
        let cur_blk = blks[bi];
        let bb = bi.trunc.[u32]();
        out_mf.begin_block_insts(bb);

        if bi == 0_usize {
            var gpi: usize = 0_usize;
            var fpi: usize = 0_usize;
            var k: usize = 0_usize;
            while k < params.len {
                let pv = params[k];
                let pty = eir_prog.fn_val_ty(fn_id, pv);
                let cls = a64_classify_arg(pty, env);
                if cls == .IntReg {
                    let vr = a64_isel_vreg_of(vmap.as_slice(), pv);
                    try out_mf.emit_inst(alloc, mach_ir.inst_def_fixed(vr, gpi.trunc.[u8](), f.body_span));
                    gpi = gpi +% 1_usize;
                } else if cls == .FloatReg {
                    let vr = a64_isel_vreg_of(vmap.as_slice(), pv);
                    try out_mf.emit_inst(alloc, mach_ir.inst_def_fixed(vr, fpi.trunc.[u8](), f.body_span));
                    fpi = fpi +% 1_usize;
                }
                k = k +% 1_usize;
            }
        }

        let insts = eir_prog.insts_slice(cur_blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let ins = insts[ii];
            if ins.kind == .Const || ins.kind == .Copy || ins.kind == .LoadSlot || ins.kind == .StoreSlot {
                try a64_lower_inst_const_copy_slot(alloc, out_mf, eir_prog, fn_id, env, vmap.as_mut_slice(), slot_s, ins);
            } else if ins.kind == .Unary || ins.kind == .Binary {
                try a64_lower_inst_alu(alloc, out_mf, eir_prog, fn_id, env, vmap.as_mut_slice(), ins);
            } else if ins.kind == .Cast || ins.kind == .Call {
                try a64_lower_inst_cast_call(alloc, out_mf, eir_prog, fn_id, env, interner, vmap.as_mut_slice(), ins);
            }
            ii = ii +% 1_usize;
        }

        try a64_lower_term_to_mach(alloc, out_mf, eir_prog, fn_id, env, f.sig.ret, vmap.as_mut_slice(), bb, cur_blk.term);
        out_mf.end_block_insts(bb);
        bi = bi +% 1_usize;
    }

    slot_offs.destroy(alloc);
    vmap.destroy(alloc);
    return true;
}

// ============================================================================
// Section 3: Complete 100%-EIR AArch64 Direct Codegen (Frame & Linear Scan)
// ============================================================================
// Uses X19..X26 (8 callee-saved GPRs!) for scalar SSA values, X29=FP, X30=LR,
// SP=16B-aligned stack, X8=ErrorUnion tag channel, X0..X7/V0..V7=ABI args,
// X9..X15=scratch temps, X16/X17=assembler addressing scratch.

const A64_LS_REG_COUNT: usize = 8_usize;

fn a64_ls_reg(idx: usize) -> u8 {
    return (19_usize +% idx).trunc.[u8](); // X19..X26
}

enum A64LocKind : u8 {
    Reg = 0,
    Stack = 1,
}

struct A64ValLoc {
    kind: A64LocKind;
    reg: u8;
    stack_off: i32;
}

fn loc_reg(r: u8) -> A64ValLoc {
    return A64ValLoc.{ kind: .Reg, reg: r, stack_off: 0_i32 };
}

fn loc_stack(off: i32) -> A64ValLoc {
    return A64ValLoc.{ kind: .Stack, reg: 0_u8, stack_off: off };
}

fn is_scalar_reg_cand(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize || lay.size > 8_usize { return false; }
    let n = env.get(ty);
    match n.kind {
        .Bool => { return true; }
        .Char => { return true; }
        .Int => { return true; }
        .Enum => { return true; }
        .ErrorSet => { return true; }
        .Bitfield => { return true; }
        .RawPtr => { return true; }
        .PhysAddr => { return true; }
        .VirtAddr => { return true; }
        .DmaAddr => { return true; }
        .Borrow => { return n.borrow_kind == .Single; }
        .Builtin => {
            return n.builtin_kind == .IdBrand || n.builtin_kind == .GenId || n.builtin_kind == .Link;
        }
        _ => { return false; }
    }
}

struct A64LiveIv {
    val: u32;
    start: u32;
    end: u32;
}

struct A64ActiveReg {
    end: u32;
    reg_idx: usize;
}

linear struct A64FramePlan {
    has_sret: bool;
    sret_off: i32;
    temp_off: i32;
    slot_offs: col.DynBuf[i32];
    val_locs: col.DynBuf[A64ValLoc];
    saved_regs: col.DynBuf[u8];
    local_bytes: usize;
    saved_bytes: usize;
    total_sub: usize;
}

impl A64FramePlan {
    fn destroy(self: A64FramePlan, alloc: *mut AllocCap) {
        let A64FramePlan.{
            has_sret: _, sret_off: _, temp_off: _,
            slot_offs, val_locs, saved_regs,
            local_bytes: _, saved_bytes: _, total_sub: _,
        } = self;
        slot_offs.destroy(alloc);
        val_locs.destroy(alloc);
        saved_regs.destroy(alloc);
    }
}

fn collect_place_uses(alloc: *mut AllocCap, eir_prog: *eir.EirProgram, place_id: u32, out: *mut col.DynBuf[eir.EirValue]) -> !OutOfMemory {
    if let p = eir_prog.get_place(place_id) {
        if p.base.kind == .Val { try out.push(alloc, p.base.id); }
        let projs = eir_prog.projs_slice(p.projs);
        var i: usize = 0_usize;
        while i < projs.len {
            if projs[i].kind == .Index { try out.push(alloc, projs[i].index); }
            i = i +% 1_usize;
        }
    }
    return;
}

fn collect_inst_uses(alloc: *mut AllocCap, eir_prog: *eir.EirProgram, inst: *eir.EirInst, out: *mut col.DynBuf[eir.EirValue]) -> !OutOfMemory {
    match inst.kind {
        .Copy => { try out.push(alloc, inst.v0); }
        .StoreSlot => { try out.push(alloc, inst.v0); }
        .LoadPlace => { try collect_place_uses(alloc, eir_prog, inst.aux0, out); }
        .StorePlace => { try collect_place_uses(alloc, eir_prog, inst.aux0, out); try out.push(alloc, inst.v0); }
        .PlaceAddr => { try collect_place_uses(alloc, eir_prog, inst.aux0, out); }
        .PoolColumnLoad => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Val { try out.push(alloc, op.pool_base.id); }
                try out.push(alloc, op.index);
            }
        }
        .PoolColumnStore => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Val { try out.push(alloc, op.pool_base.id); }
                try out.push(alloc, op.index);
            }
            try out.push(alloc, inst.v0);
        }
        .Unary => { try out.push(alloc, inst.v0); }
        .Binary => { try out.push(alloc, inst.v0); try out.push(alloc, inst.v1); }
        .Cast => { try out.push(alloc, inst.v0); }
        .Slice => {
            try out.push(alloc, inst.v0);
            if inst.v1 != eir.EIR_NONE { try out.push(alloc, inst.v1); }
            if inst.v2 != eir.EIR_NONE { try out.push(alloc, inst.v2); }
        }
        .VecLoad => { try out.push(alloc, inst.v0); try out.push(alloc, inst.v1); }
        .VecStore => { try out.push(alloc, inst.v0); try out.push(alloc, inst.v1); try out.push(alloc, inst.v2); }
        .VecFma => { try out.push(alloc, inst.v0); try out.push(alloc, inst.v1); try out.push(alloc, inst.v2); }
        .Aggregate => {
            let es = eir_prog.vals_slice(inst.range);
            var i: usize = 0_usize;
            while i < es.len { try out.push(alloc, es[i]); i = i +% 1_usize; }
        }
        .UnwrapOptional => { try out.push(alloc, inst.v0); }
        .UnwrapErrorOk => { try out.push(alloc, inst.v0); }
        .UnwrapErrorErr => { try out.push(alloc, inst.v0); }
        .IsNonNull => { try out.push(alloc, inst.v0); }
        .IsError => { try out.push(alloc, inst.v0); }
        .MatchTag => { try out.push(alloc, inst.v0); }
        .FieldExtract => { try out.push(alloc, inst.v0); }
        .MakeDyn => { try out.push(alloc, inst.v0); }
        .MakeClosure => { if inst.v0 != eir.EIR_NONE { try out.push(alloc, inst.v0); } }
        .Call => {
            if let cd = eir_prog.get_call(inst.aux0) {
                if cd.callee.kind == .FnPtr { try out.push(alloc, cd.callee.a); }
                let args = eir_prog.vals_slice(cd.args);
                var i: usize = 0_usize;
                while i < args.len { try out.push(alloc, args[i]); i = i +% 1_usize; }
            }
        }
        .BuiltinCall => {
            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                let args = eir_prog.vals_slice(bc.args);
                var i: usize = 0_usize;
                while i < args.len { try out.push(alloc, args[i]); i = i +% 1_usize; }
            }
        }
        .InlineAsm => {
            if let ad = eir_prog.get_asm(inst.aux0) {
                let ins = eir_prog.asm_inputs_slice(ad.inputs);
                var i: usize = 0_usize;
                while i < ins.len { try out.push(alloc, ins[i].val); i = i +% 1_usize; }
            }
        }
        _ => {}
    }
    return;
}

fn sort_a64_ivs(iv: *mut [A64LiveIv]) {
    let n = iv.len;
    if n <= 1_usize { return; }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third { gap = (gap *% 3_usize) +% 1_usize; }
    while gap > 0_usize {
        var i = gap;
        while i < n {
            let cur = iv[i];
            var j = i;
            while j >= gap && j < n {
                let prev = j - gap;
                let p = iv[prev];
                if p.start < cur.start || (p.start == cur.start && p.val <= cur.val) { break; }
                iv[j] = p;
                j = prev;
            }
            iv[j] = cur;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

fn a64_set_def_end(dp: *mut [u32], ep: *mut [u32], idx: usize, def_val: u32, end_val: u32) {
    if idx < dp.len {
        if dp[idx] == 0xFFFFFFFF_u32 { dp[idx] = def_val; }
    }
    if idx < ep.len {
        if end_val > ep[idx] { ep[idx] = end_val; }
    }
}

fn a64_extend_end(ep: *mut [u32], idx: usize, end_val: u32) {
    if idx < ep.len {
        if end_val > ep[idx] { ep[idx] = end_val; }
    }
}

fn a64_swap_active_last(am: *mut [A64ActiveReg], idx: usize) {
    if am.len > 0_usize {
        let last_i = am.len - 1_usize;
        if idx < am.len && idx != last_i {
            let tmp = am[last_i];
            am[idx] = tmp;
        }
    }
}

fn plan_a64_direct_frame(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    has_sret: bool,
) -> A64FramePlan ! OutOfMemory {
    let nslots = eir_prog.fn_slots(fn_id).len;
    let nvals = if let f0 = eir_prog.get_fn(fn_id) { f0.value_tys.len.widen.[usize]() } else { 0_usize };
    var slot_offs = try col.DynBuf.[i32].init(alloc, if nslots > 4_usize { nslots } else { 4_usize });
    errdefer slot_offs.destroy(alloc);
    var val_locs = try col.DynBuf.[A64ValLoc].init(alloc, if nvals > 8_usize { nvals } else { 8_usize });
    errdefer val_locs.destroy(alloc);
    var saved_regs = try col.DynBuf.[u8].init(alloc, A64_LS_REG_COUNT);
    errdefer saved_regs.destroy(alloc);

    var cursor: usize = 0_usize;
    var sret_off: i32 = 0_i32;
    if has_sret {
        cursor = types.align_up_usize(cursor +% 8_usize, 8_usize);
        sret_off = 0_i32 -% cursor.trunc.[i32]();
    }
    // 128B 16-byte-aligned scratch area for pools/fs/f16/etc.
    cursor = types.align_up_usize(cursor +% 128_usize, 16_usize);
    let temp_off = 0_i32 -% cursor.trunc.[i32]();

    // Allocate all EIR local slots on stack
    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < slots.len {
        let lay = env.x64_layout(slots[si].ty);
        let sz = if lay.size == 0_usize { 8_usize } else { lay.size };
        let al = if lay.align <= 8_usize { 8_usize } else if lay.align <= 16_usize { 16_usize } else { 32_usize };
        cursor = types.align_up_usize(cursor +% sz, al);
        try slot_offs.push(alloc, 0_i32 -% cursor.trunc.[i32]());
        si = si +% 1_usize;
    }

    // Track which SSA values require addressable stack storage (never promoted to reg)
    var need_addr = try col.BitSet.init(alloc, if nvals > 1_usize { nvals } else { 1_usize });
    errdefer need_addr.destroy(alloc);
    var def_pos = try col.DynBuf.[u32].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer def_pos.destroy(alloc);
    var end_pos = try col.DynBuf.[u32].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer end_pos.destroy(alloc);
    var vi0: usize = 0_usize;
    while vi0 < nvals {
        try val_locs.push(alloc, loc_stack(0_i32));
        try def_pos.push(alloc, 0xFFFFFFFF_u32);
        try end_pos.push(alloc, 0_u32);
        vi0 = vi0 +% 1_usize;
    }

    let params = eir_prog.fn_params(fn_id);
    let dp_m = def_pos.as_mut_slice();
    let ep_m = end_pos.as_mut_slice();
    var pi: usize = 0_usize;
    while pi < params.len {
        let pv = params[pi].widen.[usize]();
        if pv < dp_m.len && pv < ep_m.len { dp_m[pv] = 0_u32; ep_m[pv] = 1_u32; }
        pi = pi +% 1_usize;
    }

    var uses_tmp = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
    errdefer uses_tmp.destroy(alloc);
    let blks = eir_prog.fn_blocks(fn_id);
    var pos: u32 = 2_u32;
    var bi: usize = 0_usize;
    while bi < blks.len {
        let cur_blk = blks[bi];
        let phis = eir_prog.phis_slice(cur_blk.phis);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len {
            let dv = phis[phi_i].dst.widen.[usize]();
            a64_set_def_end(dp_m, ep_m, dv, pos, pos);
            phi_i = phi_i +% 1_usize;
        }
        pos = pos +% 1_u32;
        let insts = eir_prog.insts_slice(cur_blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let ins = insts[ii];
            uses_tmp.clear();
            try collect_inst_uses(alloc, eir_prog, &ins, &mut uses_tmp);
            let us = uses_tmp.as_slice();
            var ui: usize = 0_usize;
            while ui < us.len {
                let uv = us[ui].widen.[usize]();
                a64_set_def_end(dp_m, ep_m, uv, 0_u32, pos);
                ui = ui +% 1_usize;
            }
            if ins.dst != eir.EIR_NONE {
                let dv = ins.dst.widen.[usize]();
                a64_set_def_end(dp_m, ep_m, dv, pos, pos);
            }
            // Values whose address is taken or passed as ByPtr must stay on stack
            if ins.kind == .LoadPlace || ins.kind == .StorePlace || ins.kind == .PlaceAddr {
                if let pl = eir_prog.get_place(ins.aux0) {
                    if pl.base.kind == .Val { need_addr.set(pl.base.id.widen.[usize]()); }
                }
            } else if ins.kind == .PoolColumnLoad || ins.kind == .PoolColumnStore {
                if let op = eir_prog.get_pool_col_op(ins.aux0) {
                    if op.pool_base.kind == .Val && !op.pool_is_ptr { need_addr.set(op.pool_base.id.widen.[usize]()); }
                }
            } else if ins.kind == .Slice {
                need_addr.set(ins.v0.widen.[usize]());
            } else if ins.kind == .Call {
                if let cd = eir_prog.get_call(ins.aux0) {
                    let cargs = eir_prog.vals_slice(cd.args);
                    var ci: usize = 0_usize;
                    while ci < cargs.len {
                        let cav = cargs[ci];
                        let caty = eir_prog.fn_val_ty(fn_id, cav);
                        if a64_classify_arg(caty, env) == .ByPtr { need_addr.set(cav.widen.[usize]()); }
                        ci = ci +% 1_usize;
                    }
                }
            } else if ins.kind == .BuiltinCall {
                if let bc = eir_prog.get_builtin_call(ins.aux0) {
                    let bargs = eir_prog.vals_slice(bc.args);
                    if bargs.len > 0_usize { need_addr.set(bargs[0_usize].widen.[usize]()); }
                }
            }
            pos = pos +% 1_u32;
            ii = ii +% 1_usize;
        }
        // Terminator use
        let term = cur_blk.term;
        if (term.kind == .Branch || term.kind == .SwitchInt || (term.kind == .Return && term.flag)) && term.val != eir.EIR_NONE {
            let tv = term.val.widen.[usize]();
            a64_set_def_end(dp_m, ep_m, tv, 0_u32, pos);
        }
        // Extend intervals for back-edge phis
        var succs: [2]u32 = [0xFFFFFFFF_u32, 0xFFFFFFFF_u32];
        var n_succ: usize = 0_usize;
        if term.kind == .Goto { succs[0_usize] = term.bb0; n_succ = 1_usize; }
        else if term.kind == .Branch { succs[0_usize] = term.bb0; succs[1_usize] = term.bb1; n_succ = 2_usize; }
        var sci: usize = 0_usize;
        while sci < n_succ {
            let sbb = succs[sci];
            let sphis = eir_prog.block_phis(fn_id, sbb);
            var k: usize = 0_usize;
            while k < sphis.len {
                let sphi = sphis[k];
                let inc = eir_prog.phi_incoming(sphi.incoming);
                var m: usize = 0_usize;
                while m < inc.len {
                    let inm = inc[m];
                    if inm.pred_bb == bi.trunc.[u32]() {
                        a64_extend_end(ep_m, inm.val.widen.[usize](), pos);
                        a64_extend_end(ep_m, sphi.dst.widen.[usize](), pos);
                    }
                    m = m +% 1_usize;
                }
                k = k +% 1_usize;
            }
            sci = sci +% 1_usize;
        }
        pos = pos +% 1_u32;
        bi = bi +% 1_usize;
    }
    // Extend any value used inside a loop back-edge across the full loop span (conservative safe extension)
    let dp_ro = def_pos.as_slice();
    let ep_ro = end_pos.as_slice();
    var cands = try col.DynBuf.[A64LiveIv].init(alloc, 16_usize);
    errdefer cands.destroy(alloc);
    var v_i: usize = 0_usize;
    while v_i < nvals && v_i < dp_ro.len && v_i < ep_ro.len {
        let ty = eir_prog.fn_val_ty(fn_id, v_i.trunc.[u32]());
        if is_scalar_reg_cand(ty, env) && !need_addr.test(v_i) && dp_ro[v_i] != 0xFFFFFFFF_u32 && blks.len <= 1_usize {
            // Single-block functions get exact live-range linear scan in X19..X26!
            // Multi-block functions with loops keep SSA values safely on stack (or use fast MachIR path with full CFG liveness!).
            try cands.push(alloc, A64LiveIv.{ val: v_i.trunc.[u32](), start: dp_ro[v_i], end: ep_ro[v_i] });
        }
        v_i = v_i +% 1_usize;
    }
    sort_a64_ivs(cands.as_mut_slice());

    var active = try col.DynBuf.[A64ActiveReg].init(alloc, A64_LS_REG_COUNT);
    errdefer active.destroy(alloc);
    var reg_free: [8]bool = [true; 8];
    var reg_used: [8]bool = [false; 8];
    let vl_m = val_locs.as_mut_slice();
    let cs = cands.as_slice();
    var ci_iv: usize = 0_usize;
    while ci_iv < cs.len {
        let iv = cs[ci_iv];
        // Expire finished intervals
        var ai_e: usize = 0_usize;
        while ai_e < active.len() {
            let as_ro = active.as_slice();
            if ai_e >= as_ro.len { break; }
            let ac = as_ro[ai_e];
            if ac.end < iv.start {
                if ac.reg_idx < 8_usize { reg_free[ac.reg_idx] = true; }
                a64_swap_active_last(active.as_mut_slice(), ai_e);
                _ = active.pop();
            } else {
                ai_e = ai_e +% 1_usize;
            }
        }
        var picked: usize = A64_LS_REG_COUNT;
        var ri: usize = 0_usize;
        while ri < A64_LS_REG_COUNT {
            if reg_free[ri] { picked = ri; break; }
            ri = ri +% 1_usize;
        }
        if picked < A64_LS_REG_COUNT {
            reg_free[picked] = false;
            reg_used[picked] = true;
            try active.push(alloc, A64ActiveReg.{ end: iv.end, reg_idx: picked });
            let ivu = iv.val.widen.[usize]();
            if ivu < vl_m.len { vl_m[ivu] = loc_reg(a64_ls_reg(picked)); }
        }
        ci_iv = ci_iv +% 1_usize;
    }
    var ri_s: usize = 0_usize;
    while ri_s < A64_LS_REG_COUNT {
        if reg_used[ri_s] { try saved_regs.push(alloc, a64_ls_reg(ri_s)); }
        ri_s = ri_s +% 1_usize;
    }

    // Allocate stack offsets for all remaining (non-reg) values
    v_i = 0_usize;
    while v_i < nvals && v_i < vl_m.len {
        if vl_m[v_i].kind == .Stack {
            let ty = eir_prog.fn_val_ty(fn_id, v_i.trunc.[u32]());
            let lay = env.x64_layout(ty);
            if lay.size > 0_usize {
                let sz = if lay.size < 8_usize { 8_usize } else { lay.size };
                let al = if lay.align <= 8_usize { 8_usize } else if lay.align <= 16_usize { 16_usize } else { 32_usize };
                cursor = types.align_up_usize(cursor +% sz, al);
                vl_m[v_i] = loc_stack(0_i32 -% cursor.trunc.[i32]());
            }
        }
        v_i = v_i +% 1_usize;
    }

    active.destroy(alloc);
    cands.destroy(alloc);
    uses_tmp.destroy(alloc);
    end_pos.destroy(alloc);
    def_pos.destroy(alloc);
    need_addr.destroy(alloc);

    let local_bytes = types.align_up_usize(cursor, 16_usize);
    let saved_bytes = types.align_up_usize(saved_regs.len() *% 8_usize, 16_usize);
    return A64FramePlan.{
        has_sret: has_sret,
        sret_off: sret_off,
        temp_off: temp_off,
        slot_offs: slot_offs,
        val_locs: val_locs,
        saved_regs: saved_regs,
        local_bytes: local_bytes,
        saved_bytes: saved_bytes,
        total_sub: local_bytes +% saved_bytes,
    };
}

// ============================================================================
// Section 4: Direct AArch64 Codegen State & Core Helpers
// ============================================================================

linear struct A64Cg {
    fn_id: u32;
    fn_sym_id: u32;
    ret_ty: types.TyId;
    ret_class: A64RetClass;
    is_naked: bool;
    is_export_c: bool;
    is_linux: bool;
    sanitize: bool;
    emit_debug_line: bool;
    failed: bool;
    err_msg: str.StrBuf;
    frame: A64FramePlan;
    buf: a64_asm.A64Buf;
    blk_labels: col.DynBuf[u32];
    rodata_items: col.DynBuf[mach_x64.RodataItemMeta];
    rodata_bytes: col.DynBuf[u8];
    rodata_relocs: col.DynBuf[mach_x64.RodataReloc];
    used_helpers: col.DynBuf[u32];
    line_entries: col.DynBuf[elf64.LineEntry];
    fn_ref_thunks: col.DynBuf[mach_x64.FnRefThunkReq];
    last_line_file: u32;
    last_line_num: u32;
    max_call_stk: u64;
}

impl A64Cg {
    fn destroy(self: A64Cg, alloc: *mut AllocCap) {
        let A64Cg.{
            fn_id: _, fn_sym_id: _, ret_ty: _, ret_class: _,
            is_naked: _, is_export_c: _, is_linux: _, sanitize: _, emit_debug_line: _,
            failed: _, err_msg, frame, buf, blk_labels,
            rodata_items, rodata_bytes, rodata_relocs,
            used_helpers, line_entries, fn_ref_thunks,
            last_line_file: _, last_line_num: _, max_call_stk: _,
        } = self;
        err_msg.destroy(alloc);
        frame.destroy(alloc);
        buf.destroy(alloc);
        blk_labels.destroy(alloc);
        rodata_items.destroy(alloc);
        rodata_bytes.destroy(alloc);
        rodata_relocs.destroy(alloc);
        used_helpers.destroy(alloc);
        line_entries.destroy(alloc);
        fn_ref_thunks.destroy(alloc);
    }
}

fn cg_fail(alloc: *mut AllocCap, cg: *mut A64Cg, msg: *str) -> !OutOfMemory {
    if !cg.failed {
        cg.failed = true;
        cg.err_msg.clear();
        try cg.err_msg.push_str_grow(alloc, msg);
    }
    return;
}

fn cg_val_loc(cg: *A64Cg, v: eir.EirValue) -> A64ValLoc {
    let idx = v.widen.[usize]();
    let s = cg.frame.val_locs.as_slice();
    if idx < s.len { return s[idx]; }
    return loc_stack(0_i32);
}

fn cg_val_off(cg: *A64Cg, v: eir.EirValue) -> i32 {
    return cg_val_loc(cg, v).stack_off;
}

fn cg_slot_off(cg: *A64Cg, slot: eir.EirSlot) -> i32 {
    let idx = slot.widen.[usize]();
    let s = cg.frame.slot_offs.as_slice();
    if idx < s.len { return s[idx]; }
    return 0_i32;
}

fn cg_blk_lbl(cg: *A64Cg, bb: eir.BlockId) -> u32 {
    let idx = bb.widen.[usize]();
    let s = cg.blk_labels.as_slice();
    if idx < s.len { return s[idx]; }
    return 0_u32;
}

fn cg_note_helper(alloc: *mut AllocCap, cg: *mut A64Cg, sym: u32) -> !OutOfMemory {
    let hs = cg.used_helpers.as_slice();
    var i: usize = 0_usize;
    while i < hs.len {
        if hs[i] == sym { return; }
        i = i +% 1_usize;
    }
    try cg.used_helpers.push(alloc, sym);
    return;
}

fn cg_helper_call(alloc: *mut AllocCap, cg: *mut A64Cg, interner: *mut span.SymInterner, name: *str) -> !OutOfMemory {
    let sym = try interner.intern_str(alloc, name);
    try cg_note_helper(alloc, cg, sym);
    try cg.buf.bl_sym(alloc, sym);
    return;
}

fn cg_call_alloc_raw(alloc: *mut AllocCap, cg: *mut A64Cg, interner: *mut span.SymInterner) -> !OutOfMemory {
    try cg_helper_call(alloc, cg, interner, if cg.sanitize { "eon_alloc_raw_san" } else { "eon_alloc_raw" });
    return;
}

fn cg_call_free_raw(alloc: *mut AllocCap, cg: *mut A64Cg, interner: *mut span.SymInterner) -> !OutOfMemory {
    try cg_helper_call(alloc, cg, interner, if cg.sanitize { "eon_free_raw_san" } else { "eon_free_raw" });
    return;
}

fn cg_intern_rodata(alloc: *mut AllocCap, cg: *mut A64Cg, interner: *mut span.SymInterner, bytes: *[u8], align: u32) -> u32 ! OutOfMemory {
    let idx = cg.rodata_items.len().widen.[u64]();
    let sym = try intern_rodata_sym(alloc, interner, cg.fn_sym_id, idx);
    let data_off = cg.rodata_bytes.len().trunc.[u32]();
    try cg.rodata_bytes.push_slice(alloc, bytes);
    try cg.rodata_items.push(alloc, mach_x64.RodataItemMeta.{
        sym_id: sym,
        data_off: data_off,
        data_len: bytes.len.trunc.[u32](),
        align: align,
        reloc_start: 0_u32,
        reloc_len: 0_u32,
    });
    return sym;
}

fn cg_record_line(alloc: *mut AllocCap, cg: *mut A64Cg, sm: *span.SourceMap, sp: span.Span) -> !OutOfMemory {
    if !cg.emit_debug_line || sp.file == span.FILE_DUMMY { return; }
    let lc = sm.line_col(sp.file, sp.start);
    if lc.line == 0_u32 { return; }
    if sp.file == cg.last_line_file && lc.line == cg.last_line_num { return; }
    cg.last_line_file = sp.file;
    cg.last_line_num = lc.line;
    try cg.line_entries.push(alloc, elf64.LineEntry.{
        code_offset: cg.buf.pos(),
        file_idx: sp.file +% 1_u32,
        line: lc.line,
        col: lc.col,
    });
    return;
}

/// Copies `size` bytes from `[src_base + src_disp]` to `[dst_base + dst_disp]`.
/// Preserves `X0..X7`, `X9..X12`, `X19..X28`; uses ONLY `X13`, `X14`, `X15`, `X16`, `X17`!
fn cg_copy_mem(
    alloc: *mut AllocCap,
    cg: *mut A64Cg,
    dst_base: u8,
    dst_disp: i32,
    src_base: u8,
    src_disp: i32,
    size: usize,
) -> !OutOfMemory {
    if size == 0_usize { return; }
    if size <= 32_usize {
        var off: usize = 0_usize;
        while off +% 8_usize <= size {
            try cg.buf.load_mem(alloc, a64_asm.X15, src_base, src_disp +% off.trunc.[i32](), 8_u8, false, a64_asm.X16);
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% off.trunc.[i32](), a64_asm.X15, 8_u8, a64_asm.X16);
            off = off +% 8_usize;
        }
        while off +% 4_usize <= size {
            try cg.buf.load_mem(alloc, a64_asm.X15, src_base, src_disp +% off.trunc.[i32](), 4_u8, false, a64_asm.X16);
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% off.trunc.[i32](), a64_asm.X15, 4_u8, a64_asm.X16);
            off = off +% 4_usize;
        }
        while off +% 2_usize <= size {
            try cg.buf.load_mem(alloc, a64_asm.X15, src_base, src_disp +% off.trunc.[i32](), 2_u8, false, a64_asm.X16);
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% off.trunc.[i32](), a64_asm.X15, 2_u8, a64_asm.X16);
            off = off +% 2_usize;
        }
        while off < size {
            try cg.buf.load_mem(alloc, a64_asm.X15, src_base, src_disp +% off.trunc.[i32](), 1_u8, false, a64_asm.X16);
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% off.trunc.[i32](), a64_asm.X15, 1_u8, a64_asm.X16);
            off = off +% 1_usize;
        }
        return;
    }
    try cg.buf.add_signed_imm(alloc, a64_asm.X13, dst_base, dst_disp.widen.[i64](), a64_asm.X16);
    try cg.buf.add_signed_imm(alloc, a64_asm.X14, src_base, src_disp.widen.[i64](), a64_asm.X16);
    let qwords = size >> 3_usize;
    try cg.buf.mov_imm64(alloc, a64_asm.X15, qwords.widen.[u64]());
    let l_lp = try cg.buf.new_label(alloc);
    cg.buf.bind_label(l_lp);
    try cg.buf.ldr_uimm(alloc, a64_asm.X17, a64_asm.X14, 0_u32, 8_u8, false);
    try cg.buf.str_uimm(alloc, a64_asm.X17, a64_asm.X13, 0_u32, 8_u8);
    try cg.buf.add_imm(alloc, true, false, a64_asm.X14, a64_asm.X14, 8_u16, false);
    try cg.buf.add_imm(alloc, true, false, a64_asm.X13, a64_asm.X13, 8_u16, false);
    try cg.buf.sub_imm(alloc, true, false, a64_asm.X15, a64_asm.X15, 1_u16, false);
    try cg.buf.cbnz_label(alloc, true, a64_asm.X15, l_lp);
    let rem = size & 7_usize;
    var tail: usize = 0_usize;
    while tail < rem {
        try cg.buf.ldr_uimm(alloc, a64_asm.X17, a64_asm.X14, tail.trunc.[u32](), 1_u8, false);
        try cg.buf.str_uimm(alloc, a64_asm.X17, a64_asm.X13, tail.trunc.[u32](), 1_u8);
        tail = tail +% 1_usize;
    }
    return;
}

/// Copies `cnt_reg` bytes from `src_reg` to `dst_reg` (advances all 3 regs; uses `X16`).
fn cg_copy_mem_dyn(alloc: *mut AllocCap, cg: *mut A64Cg, dst_reg: u8, src_reg: u8, cnt_reg: u8) -> !OutOfMemory {
    let l_lp = try cg.buf.new_label(alloc);
    let l_dn = try cg.buf.new_label(alloc);
    cg.buf.bind_label(l_lp);
    try cg.buf.cbz_label(alloc, true, cnt_reg, l_dn);
    try cg.buf.ldr_uimm(alloc, a64_asm.X16, src_reg, 0_u32, 1_u8, false);
    try cg.buf.str_uimm(alloc, a64_asm.X16, dst_reg, 0_u32, 1_u8);
    try cg.buf.add_imm(alloc, true, false, src_reg, src_reg, 1_u16, false);
    try cg.buf.add_imm(alloc, true, false, dst_reg, dst_reg, 1_u16, false);
    try cg.buf.sub_imm(alloc, true, false, cnt_reg, cnt_reg, 1_u16, false);
    try cg.buf.b_label(alloc, l_lp);
    cg.buf.bind_label(l_dn);
    return;
}

/// Zeros `size` bytes at `[dst_base + dst_disp]` using `X13`, `X14`, `X16`.
fn cg_memzero(alloc: *mut AllocCap, cg: *mut A64Cg, dst_base: u8, dst_disp: i32, size: usize) -> !OutOfMemory {
    if size == 0_usize { return; }
    if size <= 32_usize {
        var off: usize = 0_usize;
        while off +% 8_usize <= size {
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% off.trunc.[i32](), a64_asm.XZR, 8_u8, a64_asm.X16);
            off = off +% 8_usize;
        }
        while off +% 4_usize <= size {
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% off.trunc.[i32](), a64_asm.XZR, 4_u8, a64_asm.X16);
            off = off +% 4_usize;
        }
        while off < size {
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% off.trunc.[i32](), a64_asm.XZR, 1_u8, a64_asm.X16);
            off = off +% 1_usize;
        }
        return;
    }
    try cg.buf.add_signed_imm(alloc, a64_asm.X13, dst_base, dst_disp.widen.[i64](), a64_asm.X16);
    try cg.buf.mov_imm64(alloc, a64_asm.X14, (size >> 3_usize).widen.[u64]());
    let l_lp = try cg.buf.new_label(alloc);
    cg.buf.bind_label(l_lp);
    try cg.buf.str_uimm(alloc, a64_asm.XZR, a64_asm.X13, 0_u32, 8_u8);
    try cg.buf.add_imm(alloc, true, false, a64_asm.X13, a64_asm.X13, 8_u16, false);
    try cg.buf.sub_imm(alloc, true, false, a64_asm.X14, a64_asm.X14, 1_u16, false);
    try cg.buf.cbnz_label(alloc, true, a64_asm.X14, l_lp);
    let rem = size & 7_usize;
    var tail: usize = 0_usize;
    while tail < rem {
        try cg.buf.str_uimm(alloc, a64_asm.XZR, a64_asm.X13, tail.trunc.[u32](), 1_u8);
        tail = tail +% 1_usize;
    }
    return;
}

fn cg_norm_subword(alloc: *mut AllocCap, cg: *mut A64Cg, env: *types.TypeEnv, ty: types.TyId, reg: u8) -> !OutOfMemory {
    let bits = env.int_bits(ty);
    if bits > 0_u8 && bits < 64_u8 {
        try cg.buf.extend_bits(alloc, reg, reg, bits, env.is_signed_int(ty));
    }
    return;
}

fn cg_load_scalar_raw(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, v: eir.EirValue, dst: u8) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        try cg.buf.mov_imm64(alloc, dst, 0_u64);
        return;
    }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        if dst != loc.reg { try cg.buf.mov_rr(alloc, dst, loc.reg); }
    } else {
        let bytes = if lay.size <= 8_usize { lay.size.trunc.[u8]() } else { 8_u8 };
        try cg.buf.load_mem(alloc, dst, a64_asm.X29_FP, loc.stack_off, bytes, false, a64_asm.X16);
    }
    return;
}

fn cg_load_scalar_val(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, v: eir.EirValue, dst: u8) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        try cg.buf.mov_imm64(alloc, dst, 0_u64);
        return;
    }
    let signed = env.is_signed_int(ty);
    let bits = env.int_bits(ty);
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        if bits > 0_u8 && bits < 64_u8 {
            try cg.buf.extend_bits(alloc, dst, loc.reg, bits, signed);
        } else if lay.size < 8_usize {
            if signed { try cg.buf.sxt(alloc, dst, loc.reg, lay.size.trunc.[u8]()); }
            else { try cg.buf.uxt(alloc, dst, loc.reg, lay.size.trunc.[u8]()); }
        } else if dst != loc.reg {
            try cg.buf.mov_rr(alloc, dst, loc.reg);
        }
    } else {
        let bytes = if lay.size <= 8_usize { lay.size.trunc.[u8]() } else { 8_u8 };
        try cg.buf.load_mem(alloc, dst, a64_asm.X29_FP, loc.stack_off, bytes, signed, a64_asm.X16);
        if bits > 0_u8 && bits < 64_u8 && bits != (bytes *% 8_u8) {
            try cg.buf.extend_bits(alloc, dst, dst, bits, signed);
        }
    }
    return;
}

fn cg_store_scalar_val(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, v: eir.EirValue, src: u8) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize { return; }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        let bits = env.int_bits(ty);
        let signed = env.is_signed_int(ty);
        if bits > 0_u8 && bits < 64_u8 {
            try cg.buf.extend_bits(alloc, loc.reg, src, bits, signed);
        } else if lay.size < 8_usize {
            if signed { try cg.buf.sxt(alloc, loc.reg, src, lay.size.trunc.[u8]()); }
            else { try cg.buf.uxt(alloc, loc.reg, src, lay.size.trunc.[u8]()); }
        } else if loc.reg != src {
            try cg.buf.mov_rr(alloc, loc.reg, src);
        }
    } else {
        let bytes = if lay.size <= 8_usize { lay.size.trunc.[u8]() } else { 8_u8 };
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, loc.stack_off, src, bytes, a64_asm.X16);
    }
    return;
}

fn cg_load_float_val(
    alloc: *mut AllocCap,
    cg: *mut A64Cg,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    v: eir.EirValue,
    vdst: u8,
) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let n = env.get(ty);
    if n.kind == .Float && n.u8_val == 16_u8 {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, v, a64_asm.X0);
        try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        if vdst != 0_u8 { try cg.buf.vmov_16b(alloc, vdst, 0_u8); }
        return;
    }
    let off = cg_val_off(cg, v);
    let bytes: u8 = if n.kind == .Float && n.u8_val == 64_u8 { 8_u8 } else { 4_u8 };
    try cg.buf.load_vec_mem(alloc, vdst, a64_asm.X29_FP, off, bytes, a64_asm.X16);
    return;
}

fn cg_store_float_val(
    alloc: *mut AllocCap,
    cg: *mut A64Cg,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    v: eir.EirValue,
    vsrc: u8,
) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let n = env.get(ty);
    if n.kind == .Float && n.u8_val == 16_u8 {
        if vsrc != 0_u8 { try cg.buf.vmov_16b(alloc, 0_u8, vsrc); }
        try cg_helper_call(alloc, cg, interner, "eon_f32_to_f16");
        try cg_store_scalar_val(alloc, cg, eir_prog, env, v, a64_asm.X0);
        return;
    }
    let off = cg_val_off(cg, v);
    let bytes: u8 = if n.kind == .Float && n.u8_val == 64_u8 { 8_u8 } else { 4_u8 };
    try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, off, vsrc, bytes, a64_asm.X16);
    return;
}

fn cg_val_addr_into(alloc: *mut AllocCap, cg: *mut A64Cg, v: eir.EirValue, dst: u8) -> !OutOfMemory {
    let off = cg_val_off(cg, v);
    try cg.buf.add_signed_imm(alloc, dst, a64_asm.X29_FP, off.widen.[i64](), a64_asm.X16);
    return;
}

fn cg_copy_val_to_val(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, src: eir.EirValue) -> !OutOfMemory {
    if dst == src { return; }
    let ty = eir_prog.fn_val_ty(cg.fn_id, dst);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize { return; }
    let dloc = cg_val_loc(cg, dst);
    let sloc = cg_val_loc(cg, src);
    if dloc.kind == .Reg && sloc.kind == .Reg {
        if dloc.reg != sloc.reg { try cg.buf.mov_rr(alloc, dloc.reg, sloc.reg); }
        return;
    }
    if dloc.kind == .Reg {
        let bytes = if lay.size <= 8_usize { lay.size.trunc.[u8]() } else { 8_u8 };
        try cg.buf.load_mem(alloc, dloc.reg, a64_asm.X29_FP, sloc.stack_off, bytes, env.is_signed_int(ty), a64_asm.X16);
        return;
    }
    if sloc.kind == .Reg {
        let bytes = if lay.size <= 8_usize { lay.size.trunc.[u8]() } else { 8_u8 };
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, dloc.stack_off, sloc.reg, bytes, a64_asm.X16);
        return;
    }
    if dloc.stack_off == sloc.stack_off { return; }
    try cg_copy_mem(alloc, cg, a64_asm.X29_FP, dloc.stack_off, a64_asm.X29_FP, sloc.stack_off, lay.size);
    return;
}

fn cg_store_val_to_mem(alloc: *mut AllocCap, cg: *mut A64Cg, env: *types.TypeEnv, base: u8, disp: i32, v: eir.EirValue, ty: types.TyId) -> !OutOfMemory {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize { return; }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        try cg.buf.store_mem(alloc, base, disp, loc.reg, lay.size.trunc.[u8](), a64_asm.X16);
    } else {
        try cg_copy_mem(alloc, cg, base, disp, a64_asm.X29_FP, loc.stack_off, lay.size);
    }
    return;
}

fn cg_load_val_from_mem(alloc: *mut AllocCap, cg: *mut A64Cg, env: *types.TypeEnv, v: eir.EirValue, base: u8, disp: i32, ty: types.TyId) -> !OutOfMemory {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize { return; }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        try cg.buf.load_mem(alloc, loc.reg, base, disp, lay.size.trunc.[u8](), env.is_signed_int(ty), a64_asm.X16);
    } else {
        try cg_copy_mem(alloc, cg, a64_asm.X29_FP, loc.stack_off, base, disp, lay.size);
    }
    return;
}

fn cg_emit_opt_null(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, opt_ty: types.TyId) -> !OutOfMemory {
    let n = env.get(opt_ty);
    if n.kind != .Optional {
        if n.kind == .Builtin && n.builtin_kind == .IdBrand {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0xFFFFFFFF_u64);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            return;
        }
        let lay = env.x64_layout(opt_ty);
        if lay.size > 0_usize {
            let loc = cg_val_loc(cg, dst);
            if loc.kind == .Reg { try cg.buf.mov_imm64(alloc, loc.reg, 0_u64); }
            else { try cg_memzero(alloc, cg, a64_asm.X29_FP, loc.stack_off, lay.size); }
        }
        return;
    }
    let niche = env.opt_niche(n.primary);
    let loc = cg_val_loc(cg, dst);
    match niche.kind {
        .IdBrand => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0xFFFFFFFF_u64);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .GenId => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .Link => {
            if loc.kind == .Reg { try cg.buf.mov_imm64(alloc, loc.reg, 0_u64); }
            else {
                let lay = env.x64_layout(opt_ty);
                try cg_memzero(alloc, cg, a64_asm.X29_FP, loc.stack_off, if lay.size < 8_usize { 8_usize } else { lay.size });
            }
        }
        .NullPtr => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .FatPtrNullFirst => {
            try cg_memzero(alloc, cg, a64_asm.X29_FP, loc.stack_off, 16_usize);
        }
        .SliceMaxLen => {
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, loc.stack_off, a64_asm.XZR, 8_u8, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0xFFFFFFFFFFFFFFFF_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, loc.stack_off +% 8_i32, a64_asm.X0, 8_u8, a64_asm.X16);
        }
        .BoolTag => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 2_u64);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .ScalarSentinel => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, niche.sentinel);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .None => {
            let lay = env.x64_layout(opt_ty);
            if loc.kind == .Reg { try cg.buf.mov_imm64(alloc, loc.reg, 0_u64); }
            else { try cg_memzero(alloc, cg, a64_asm.X29_FP, loc.stack_off, lay.size); }
        }
    }
    return;
}

fn cg_load_ptr_arg(
    alloc: *mut AllocCap,
    cg: *mut A64Cg,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    arg_val: eir.EirValue,
    arg_slot: eir.EirSlot,
    dst: u8,
) -> !OutOfMemory {
    if arg_slot != eir.EIR_NONE {
        let soff = cg_slot_off(cg, arg_slot);
        try cg.buf.add_signed_imm(alloc, dst, a64_asm.X29_FP, soff.widen.[i64](), a64_asm.X16);
        if let sinfo = eir_prog.fn_slot(cg.fn_id, arg_slot) {
            let sn = env.get(sinfo.ty);
            if sn.kind == .Borrow || sn.kind == .RawPtr {
                try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_u8, false, a64_asm.X16);
            }
        }
        return;
    }
    let ty = eir_prog.fn_val_ty(cg.fn_id, arg_val);
    let n = env.get(ty);
    if n.kind == .Borrow || n.kind == .RawPtr {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, arg_val, dst);
        return;
    }
    let loc = cg_val_loc(cg, arg_val);
    if loc.kind == .Stack {
        try cg.buf.add_signed_imm(alloc, dst, a64_asm.X29_FP, loc.stack_off.widen.[i64](), a64_asm.X16);
    } else if dst != loc.reg {
        try cg.buf.mov_rr(alloc, dst, loc.reg);
    }
    return;
}

// ============================================================================
// Section 5: Places, Bitfields, Pool Columns, Prologue/Epilogue & Params
// ============================================================================

struct BitfieldAccess {
    has_bf: bool;
    base_bytes: u8;
    lo: u8;
    width: u8;
    member_ty: types.TyId;
}

fn bf_none() -> BitfieldAccess {
    return BitfieldAccess.{ has_bf: false, base_bytes: 0_u8, lo: 0_u8, width: 0_u8, member_ty: types.TY_VOID };
}

fn lookup_bf_member(env: *types.TypeEnv, bf_def: u32, fidx: usize) -> BitfieldAccess {
    let bm = env.get_bitfield(bf_def) orelse { return bf_none(); };
    let mems = env.bitfield_members_range(bm.members);
    if fidx >= mems.len { return bf_none(); }
    let m = mems[fidx];
    return BitfieldAccess.{
        has_bf: true,
        base_bytes: ((bm.base_bits.widen.[usize]() +% 7_usize) / 8_usize).trunc.[u8](),
        lo: m.lo,
        width: m.hi -% m.lo,
        member_ty: m.ty,
    };
}

fn place_base_ty(eir_prog: *eir.EirProgram, fn_id: u32, base: eir.EirPlaceBase) -> types.TyId {
    if base.kind == .Slot {
        if let s = eir_prog.fn_slot(fn_id, base.id) { return s.ty; }
        return types.TY_ERROR;
    }
    return eir_prog.fn_val_ty(fn_id, base.id);
}

fn cg_split_bitfield_tail(eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, place: *eir.EirPlace) -> BitfieldAccess {
    let projs = eir_prog.projs_slice(place.projs);
    if projs.len == 0_usize { return bf_none(); }
    let last = projs[projs.len - 1_usize];
    if last.kind != .Field { return bf_none(); }
    var cur_ty = place_base_ty(eir_prog, fn_id, place.base);
    var i: usize = 0_usize;
    while i + 1_usize < projs.len {
        let pr = projs[i];
        if pr.kind == .Deref {
            let cn = env.get(cur_ty);
            if cn.kind == .Borrow || cn.kind == .RawPtr { cur_ty = cn.primary; }
        } else {
            cur_ty = pr.ty;
        }
        i = i +% 1_usize;
    }
    var cn = env.get(cur_ty);
    if cn.kind == .Borrow && cn.borrow_kind == .Single {
        cur_ty = cn.primary;
        cn = env.get(cur_ty);
    }
    if cn.kind == .Bitfield { return lookup_bf_member(env, cn.primary, last.index.widen.[usize]()); }
    return bf_none();
}

fn cg_compute_place_addr(
    alloc: *mut AllocCap,
    cg: *mut A64Cg,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    place: *eir.EirPlace,
    n_projs: usize,
    dst: u8,
) -> types.TyId ! OutOfMemory {
    var cur_ty = place_base_ty(eir_prog, cg.fn_id, place.base);
    let projs = eir_prog.projs_slice(place.projs);
    if place.base.kind == .Slot {
        let soff = cg_slot_off(cg, place.base.id);
        try cg.buf.add_signed_imm(alloc, dst, a64_asm.X29_FP, soff.widen.[i64](), a64_asm.X16);
    } else {
        let loc = cg_val_loc(cg, place.base.id);
        let n = env.get(cur_ty);
        let is_row_view = n.kind == .Borrow && n.borrow_kind == .Single && env.get(n.primary).kind == .Pool;
        if (n.kind == .Borrow && n.borrow_kind == .Single && !is_row_view) || n.kind == .RawPtr {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, place.base.id, dst);
        } else if loc.kind == .Stack {
            try cg.buf.add_signed_imm(alloc, dst, a64_asm.X29_FP, loc.stack_off.widen.[i64](), a64_asm.X16);
        } else if dst != loc.reg {
            try cg.buf.mov_rr(alloc, dst, loc.reg);
        }
    }

    var pi: usize = 0_usize;
    while pi < n_projs && pi < projs.len {
        let pr = projs[pi];
        match pr.kind {
            .Deref => {
                let cn = env.get(cur_ty);
                let inner_ty = if cn.kind == .Borrow || cn.kind == .RawPtr { cn.primary } else { cur_ty };
                let inner_is_pool = env.get(inner_ty).kind == .Pool;
                if !inner_is_pool {
                    let base_is_reg_ptr = pi == 0_usize && place.base.kind == .Val
                        && ((cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr);
                    if !base_is_reg_ptr {
                        try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_u8, false, a64_asm.X16);
                    }
                }
                cur_ty = inner_ty;
            }
            .Field => {
                let cn = env.get(cur_ty);
                let is_ptr = (cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr;
                let deref_ty = if is_ptr { cn.primary } else { cur_ty };
                if env.get(deref_ty).kind == .Pool && is_ptr {
                    // RowView { pool_ptr (+0), index (+8) }
                    try cg.buf.load_mem(alloc, a64_asm.X10, dst, 0_i32, 8_u8, false, a64_asm.X16);
                    try cg.buf.load_mem(alloc, a64_asm.X11, dst, 8_i32, 4_u8, false, a64_asm.X16);
                    try cg.buf.load_mem(alloc, dst, a64_asm.X10, pr.index.trunc.[i32]() *% 8_i32, 8_u8, false, a64_asm.X16);
                    let esz_r = env.x64_layout_impl(pr.ty, true).size;
                    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                    if esz != 1_usize {
                        try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                        try cg.buf.mul_rr(alloc, true, a64_asm.X11, a64_asm.X11, a64_asm.X12);
                    }
                    try cg.buf.add_rr(alloc, true, false, dst, dst, a64_asm.X11);
                } else {
                    if is_ptr {
                        let base_already_ptr = pi == 0_usize && place.base.kind == .Val;
                        if !base_already_ptr {
                            try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_u8, false, a64_asm.X16);
                        }
                        cur_ty = deref_ty;
                    }
                    let foff = env.struct_field_offset(cur_ty, pr.index.widen.[usize]());
                    if foff.offset > 0_usize {
                        try cg.buf.add_signed_imm(alloc, dst, dst, foff.offset.widen.[u64]().bitcast.[i64](), a64_asm.X16);
                    }
                }
                cur_ty = pr.ty;
            }
            .TupleField => {
                let cn = env.get(cur_ty);
                let is_ptr = (cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr;
                if is_ptr {
                    let base_already_ptr = pi == 0_usize && place.base.kind == .Val;
                    if !base_already_ptr {
                        try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_u8, false, a64_asm.X16);
                    }
                    cur_ty = cn.primary;
                }
                let foff = env.struct_field_offset(cur_ty, pr.index.widen.[usize]());
                if foff.offset > 0_usize {
                    try cg.buf.add_signed_imm(alloc, dst, dst, foff.offset.widen.[u64]().bitcast.[i64](), a64_asm.X16);
                }
                cur_ty = pr.ty;
            }
            .PoolCol => {
                let cn = env.get(cur_ty);
                if (cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr {
                    let base_already_ptr = pi == 0_usize && place.base.kind == .Val;
                    if !base_already_ptr {
                        try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_u8, false, a64_asm.X16);
                    }
                }
                let col_off = pr.index.trunc.[i32]() *% 8_i32;
                try cg.buf.load_mem(alloc, dst, dst, col_off, 8_u8, false, a64_asm.X16);
                if pi +% 1_usize < n_projs && pi +% 1_usize < projs.len && projs[pi +% 1_usize].kind == .Index {
                    let next_pr = projs[pi +% 1_usize];
                    try cg.buf.mov_rr(alloc, a64_asm.X13, dst);
                    try cg_load_scalar_raw(alloc, cg, eir_prog, env, next_pr.index, a64_asm.X1);
                    if pr.is_slot_pool { try cg.buf.uxt(alloc, a64_asm.X1, a64_asm.X1, 4_u8); }
                    let esz_r = env.x64_layout_impl(pr.ty, pr.is_slot_pool).size;
                    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                    if esz > 1_usize {
                        try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                        try cg.buf.mul_rr(alloc, true, a64_asm.X1, a64_asm.X1, a64_asm.X12);
                    }
                    try cg.buf.add_rr(alloc, true, false, dst, a64_asm.X13, a64_asm.X1);
                    cur_ty = next_pr.ty;
                    pi = pi +% 2_usize;
                    continue;
                }
                cur_ty = pr.ty;
            }
            .Index => {
                let cn = env.get(cur_ty);
                let elem_sz = env.x64_layout(pr.ty).size;
                try cg.buf.mov_rr(alloc, a64_asm.X13, dst);
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, pr.index, a64_asm.X1);
                if (cn.kind == .Borrow && (cn.borrow_kind == .Slice || cn.borrow_kind == .Str)) || cn.kind == .Str {
                    try cg.buf.load_mem(alloc, a64_asm.X13, a64_asm.X13, 0_i32, 8_u8, false, a64_asm.X16);
                } else if cn.kind == .Borrow && cn.borrow_kind == .Single {
                    let base_already_ptr = pi == 0_usize && place.base.kind == .Val;
                    if !base_already_ptr {
                        try cg.buf.load_mem(alloc, a64_asm.X13, a64_asm.X13, 0_i32, 8_u8, false, a64_asm.X16);
                    }
                }
                if elem_sz > 1_usize {
                    try cg.buf.mov_imm64(alloc, a64_asm.X12, elem_sz.widen.[u64]());
                    try cg.buf.mul_rr(alloc, true, a64_asm.X1, a64_asm.X1, a64_asm.X12);
                }
                try cg.buf.add_rr(alloc, true, false, dst, a64_asm.X13, a64_asm.X1);
                cur_ty = pr.ty;
            }
        }
        pi = pi +% 1_usize;
    }
    return cur_ty;
}

fn cg_emit_prologue(alloc: *mut AllocCap, cg: *mut A64Cg) -> !OutOfMemory {
    if cg.is_naked { return; }
    try cg.buf.stp64_pre(alloc, a64_asm.X29_FP, a64_asm.X30_LR, a64_asm.SP, -16_i32);
    try cg.buf.mov_rr(alloc, a64_asm.X29_FP, a64_asm.SP);
    if cg.frame.total_sub > 0_usize {
        try cg.buf.add_signed_imm(alloc, a64_asm.SP, a64_asm.SP, 0_i64 -% cg.frame.total_sub.widen.[u64]().bitcast.[i64](), a64_asm.X16);
    }
    let srs = cg.frame.saved_regs.as_slice();
    var off: i32 = 0_i32;
    var i: usize = 0_usize;
    while i < srs.len && i + 1_usize < srs.len {
        try cg.buf.stp64(alloc, srs[i], srs[i + 1_usize], a64_asm.SP, off);
        off = off +% 16_i32;
        i = i +% 2_usize;
    }
    if i < srs.len {
        try cg.buf.store_mem(alloc, a64_asm.SP, off, srs[i], 8_u8, a64_asm.X16);
    }
    return;
}

fn cg_emit_epilogue(alloc: *mut AllocCap, cg: *mut A64Cg) -> !OutOfMemory {
    if cg.is_naked { return; }
    let srs = cg.frame.saved_regs.as_slice();
    var off: i32 = 0_i32;
    var i: usize = 0_usize;
    while i < srs.len && i + 1_usize < srs.len {
        try cg.buf.ldp64(alloc, srs[i], srs[i + 1_usize], a64_asm.SP, off);
        off = off +% 16_i32;
        i = i +% 2_usize;
    }
    if i < srs.len {
        try cg.buf.load_mem(alloc, srs[i], a64_asm.SP, off, 8_u8, false, a64_asm.X16);
    }
    if cg.frame.total_sub > 0_usize {
        try cg.buf.mov_rr(alloc, a64_asm.SP, a64_asm.X29_FP);
    }
    try cg.buf.ldp64_post(alloc, a64_asm.X29_FP, a64_asm.X30_LR, a64_asm.SP, 16_i32);
    return;
}

fn cg_receive_params(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv) -> !OutOfMemory {
    if cg.is_naked { return; }
    var gp_i: usize = 0_usize;
    var flt_i: usize = 0_usize;
    var stk_off: i32 = 16_i32; // Caller overflow args live at [X29 + 16]!

    if cg.frame.has_sret {
        if cg.is_export_c {
            // AAPCS64 C ABI passes sret pointer in X8
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, cg.frame.sret_off, a64_asm.X8, 8_u8, a64_asm.X16);
        } else {
            // EonCall passes sret pointer in X0 (keeping X8 exclusively for ErrorUnion!)
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, cg.frame.sret_off, a64_asm.X0, 8_u8, a64_asm.X16);
            gp_i = 1_usize;
        }
    }

    let params = eir_prog.fn_params(cg.fn_id);
    var pi: usize = 0_usize;
    while pi < params.len {
        let pv = params[pi];
        let ty = eir_prog.fn_val_ty(cg.fn_id, pv);
        let lay = env.x64_layout(ty);
        let cls = a64_classify_arg(ty, env);
        match cls {
            .Zst => {}
            .IntReg => {
                if let r = a64_gp_arg(gp_i) {
                    try cg_store_scalar_val(alloc, cg, eir_prog, env, pv, r);
                    gp_i = gp_i +% 1_usize;
                } else {
                    try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, stk_off, lay.size.trunc.[u8](), env.is_signed_int(ty), a64_asm.X16);
                    try cg_store_scalar_val(alloc, cg, eir_prog, env, pv, a64_asm.X9);
                    stk_off = stk_off +% 8_i32;
                }
            }
            .TwoIntRegs => {
                let dst_off = cg_val_off(cg, pv);
                let hi_sz = if lay.size > 8_usize { (lay.size - 8_usize).trunc.[u8]() } else { 0_u8 };
                if gp_i +% 1_usize < 8_usize {
                    let r0 = gp_i.trunc.[u8]();
                    let r1 = (gp_i +% 1_usize).trunc.[u8]();
                    try cg.buf.store_mem(alloc, a64_asm.X29_FP, dst_off, r0, 8_u8, a64_asm.X16);
                    if hi_sz > 0_u8 {
                        try cg.buf.store_mem(alloc, a64_asm.X29_FP, dst_off +% 8_i32, r1, hi_sz, a64_asm.X16);
                    }
                    gp_i = gp_i +% 2_usize;
                } else {
                    try cg_copy_mem(alloc, cg, a64_asm.X29_FP, dst_off, a64_asm.X29_FP, stk_off, lay.size);
                    stk_off = stk_off +% 16_i32;
                }
            }
            .FloatReg => {
                let dst_off = cg_val_off(cg, pv);
                let bytes: u8 = if env.get(ty).u8_val == 64_u8 { 8_u8 } else { 4_u8 };
                if let vr = a64_flt_arg(flt_i) {
                    try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, dst_off, vr, bytes, a64_asm.X16);
                    flt_i = flt_i +% 1_usize;
                } else {
                    try cg_copy_mem(alloc, cg, a64_asm.X29_FP, dst_off, a64_asm.X29_FP, stk_off, bytes.widen.[usize]());
                    stk_off = stk_off +% 8_i32;
                }
            }
            .ByPtr => {
                let dst_off = cg_val_off(cg, pv);
                if let r = a64_gp_arg(gp_i) {
                    // cg_copy_mem preserves X0..X7 completely!
                    try cg_copy_mem(alloc, cg, a64_asm.X29_FP, dst_off, r, 0_i32, lay.size);
                    gp_i = gp_i +% 1_usize;
                } else {
                    try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, stk_off, 8_u8, false, a64_asm.X16);
                    try cg_copy_mem(alloc, cg, a64_asm.X29_FP, dst_off, a64_asm.X9, 0_i32, lay.size);
                    stk_off = stk_off +% 8_i32;
                }
            }
        }
        pi = pi +% 1_usize;
    }
    return;
}

// ============================================================================
// Section 6: Load/Store Place, Pool Cols, Const, Unary, Binary, Cast, Agg
// ============================================================================

fn cg_emit_load_place(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, place_id: u32) -> !OutOfMemory {
    let place = eir_prog.get_place(place_id) orelse { return; };
    let bf = cg_split_bitfield_tail(eir_prog, cg.fn_id, env, place);
    let projs_len = place.projs.len.widen.[usize]();
    if bf.has_bf && projs_len > 0_usize {
        _ = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs_len - 1_usize, a64_asm.X9);
        try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, bf.base_bytes, false, a64_asm.X16);
        if bf.lo > 0_u8 { try cg.buf.lsr_imm(alloc, true, a64_asm.X0, a64_asm.X0, bf.lo); }
        if bf.width < 64_u8 {
            try cg.buf.extend_bits(alloc, a64_asm.X0, a64_asm.X0, bf.width, env.is_signed_int(bf.member_ty));
        }
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        return;
    }
    let projs = eir_prog.projs_slice(place.projs);
    if projs.len > 0_usize && projs[projs.len - 1_usize].kind == .PoolCol {
        let last_pr = projs[projs.len - 1_usize];
        let pool_ty = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs.len - 1_usize, a64_asm.X9);
        let pn = env.get(pool_ty);
        var deref_ty = pool_ty;
        if pn.kind == .Borrow && pn.borrow_kind == .Single {
            let base_already_ptr = projs.len == 1_usize && place.base.kind == .Val;
            if !base_already_ptr {
                try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            }
            deref_ty = pn.primary;
        }
        let dn = env.get(deref_ty);
        let ncols = if dn.kind == .Builtin { env.pool_col_count(env.node_gval_list(&dn)) } else { 0_usize };
        let len_off: i32 = if last_pr.is_slot_pool { ((ncols +% 2_usize) *% 8_usize).trunc.[i32]() } else { (ncols *% 8_usize).trunc.[i32]() };
        let col_off = last_pr.index.trunc.[i32]() *% 8_i32;
        try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, col_off, 8_u8, false, a64_asm.X16);
        try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, len_off, 8_u8, false, a64_asm.X16);
        let doff = cg_val_off(cg, dst);
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 8_u8, a64_asm.X16);
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 8_i32, a64_asm.X1, 8_u8, a64_asm.X16);
        return;
    }
    _ = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs_len, a64_asm.X9);
    let ty = eir_prog.fn_val_ty(cg.fn_id, dst);
    try cg_load_val_from_mem(alloc, cg, env, dst, a64_asm.X9, 0_i32, ty);
    return;
}

fn cg_emit_store_place(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, place_id: u32, val: eir.EirValue) -> !OutOfMemory {
    let place = eir_prog.get_place(place_id) orelse { return; };
    let bf = cg_split_bitfield_tail(eir_prog, cg.fn_id, env, place);
    let projs_len = place.projs.len.widen.[usize]();
    if bf.has_bf && projs_len > 0_usize {
        _ = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs_len - 1_usize, a64_asm.X9);
        try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X9, 0_i32, bf.base_bytes, false, a64_asm.X16);
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, val, a64_asm.X0);
        let mask: u64 = if bf.width >= 64_u8 { 0xFFFFFFFFFFFFFFFF_u64 } else { (1_u64 <<% bf.width.widen.[u64]()) -% 1_u64 };
        try cg.buf.mov_imm64(alloc, a64_asm.X1, mask);
        try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1);
        if bf.lo > 0_u8 {
            try cg.buf.lsl_imm(alloc, true, a64_asm.X0, a64_asm.X0, bf.lo);
            try cg.buf.lsl_imm(alloc, true, a64_asm.X1, a64_asm.X1, bf.lo);
        }
        try cg.buf.mvn_rr(alloc, true, a64_asm.X1, a64_asm.X1);
        try cg.buf.and_rr(alloc, true, false, a64_asm.X10, a64_asm.X10, a64_asm.X1);
        try cg.buf.orr_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X0);
        try cg.buf.store_mem(alloc, a64_asm.X9, 0_i32, a64_asm.X10, bf.base_bytes, a64_asm.X16);
        return;
    }
    _ = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs_len, a64_asm.X9);
    let ty = eir_prog.fn_val_ty(cg.fn_id, val);
    try cg_store_val_to_mem(alloc, cg, env, a64_asm.X9, 0_i32, val, ty);
    return;
}

fn cg_load_pool_base_x9(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, base: eir.EirPlaceBase, pool_is_ptr: bool) -> !OutOfMemory {
    if base.kind == .Slot {
        let soff = cg_slot_off(cg, base.id);
        try cg.buf.add_signed_imm(alloc, a64_asm.X9, a64_asm.X29_FP, soff.widen.[i64](), a64_asm.X16);
        if pool_is_ptr { try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16); }
        return;
    }
    if pool_is_ptr { try cg_load_scalar_raw(alloc, cg, eir_prog, env, base.id, a64_asm.X9); }
    else { try cg_val_addr_into(alloc, cg, base.id, a64_asm.X9); }
    return;
}

fn cg_emit_pool_col_load(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, op_id: u32) -> !OutOfMemory {
    let op = eir_prog.get_pool_col_op(op_id) orelse { return; };
    try cg_load_pool_base_x9(alloc, cg, eir_prog, env, op.pool_base, op.pool_is_ptr);
    try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X9, op.col_idx.trunc.[i32]() *% 8_i32, 8_u8, false, a64_asm.X16);
    try cg_load_scalar_raw(alloc, cg, eir_prog, env, op.index, a64_asm.X1);
    try cg.buf.uxt(alloc, a64_asm.X1, a64_asm.X1, 4_u8);
    let esz = env.x64_layout_impl(op.elem_ty, op.is_slot_pool).size;
    if esz > 1_usize {
        try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
        try cg.buf.mul_rr(alloc, true, a64_asm.X1, a64_asm.X1, a64_asm.X12);
    }
    try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X1);
    if op.is_slot_pool && env.is_link_or_opt_link(op.elem_ty) {
        try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        return;
    }
    try cg_load_val_from_mem(alloc, cg, env, dst, a64_asm.X9, 0_i32, op.elem_ty);
    return;
}

fn cg_emit_pool_col_store(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, op_id: u32, val: eir.EirValue) -> !OutOfMemory {
    let op = eir_prog.get_pool_col_op(op_id) orelse { return; };
    try cg_load_pool_base_x9(alloc, cg, eir_prog, env, op.pool_base, op.pool_is_ptr);
    try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X9, op.col_idx.trunc.[i32]() *% 8_i32, 8_u8, false, a64_asm.X16);
    try cg_load_scalar_raw(alloc, cg, eir_prog, env, op.index, a64_asm.X1);
    try cg.buf.uxt(alloc, a64_asm.X1, a64_asm.X1, 4_u8);
    let esz = env.x64_layout_impl(op.elem_ty, op.is_slot_pool).size;
    if esz > 1_usize {
        try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
        try cg.buf.mul_rr(alloc, true, a64_asm.X1, a64_asm.X1, a64_asm.X12);
    }
    try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X1);
    if op.is_slot_pool && env.is_link_or_opt_link(op.elem_ty) {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, val, a64_asm.X0);
        try cg.buf.store_mem(alloc, a64_asm.X9, 0_i32, a64_asm.X0, 8_u8, a64_asm.X16);
        return;
    }
    try cg_store_val_to_mem(alloc, cg, env, a64_asm.X9, 0_i32, val, op.elem_ty);
    return;
}

fn cg_emit_const(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, ct: *ctvm.CtArena, interner: *mut span.SymInterner, dst: eir.EirValue, const_id: u32, ty: types.TyId) -> !OutOfMemory {
    let c = eir_prog.get_const(const_id) orelse { return; };
    let lay = env.x64_layout(ty);
    match c.kind {
        .Void => {}
        .Bool => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, if c.bool_val { 1_u64 } else { 0_u64 });
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .Char => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, c.aux_u32.widen.[u64]());
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .Int => {
            if lay.size == 16_usize {
                let off = cg_val_off(cg, dst);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, c.int_val.lo);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, off, a64_asm.X0, 8_u8, a64_asm.X16);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, c.int_val.hi.bitcast.[u64]());
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, off +% 8_i32, a64_asm.X0, 8_u8, a64_asm.X16);
            } else {
                try cg.buf.mov_imm64(alloc, a64_asm.X0, c.int_val.lo);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            }
        }
        .Float => {
            let fval = parse_f64_lit(eir_prog.bytes_slice(c.bytes));
            let f64_b = fval.bitcast.[u64]();
            let n = env.get(ty);
            if n.kind == .Float && n.u8_val == 64_u8 {
                let off = cg_val_off(cg, dst);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, f64_b);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, off, a64_asm.X0, 8_u8, a64_asm.X16);
            } else if n.kind == .Float && n.u8_val == 16_u8 {
                let f16_b = f32_bits_to_f16_bits(f64_bits_to_f32_bits(f64_b));
                try cg.buf.mov_imm64(alloc, a64_asm.X0, f16_b.widen.[u64]());
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            } else {
                let off = cg_val_off(cg, dst);
                let f32_b = f64_bits_to_f32_bits(f64_b);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, f32_b.widen.[u64]());
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, off, a64_asm.X0, 4_u8, a64_asm.X16);
            }
        }
        .Str => {
            let bytes = eir_prog.bytes_slice(c.bytes);
            let ro_sym = try cg_intern_rodata(alloc, cg, interner, bytes, 1_u32);
            let off = cg_val_off(cg, dst);
            try cg.buf.lea_sym(alloc, a64_asm.X0, ro_sym, 0_i64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, off, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, bytes.len.widen.[u64]());
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, off +% 8_i32, a64_asm.X0, 8_u8, a64_asm.X16);
        }
        .Bytes => {
            let bytes = eir_prog.bytes_slice(c.bytes);
            let ro_sym = try cg_intern_rodata(alloc, cg, interner, bytes, 4_u32);
            let off = cg_val_off(cg, dst);
            try cg.buf.lea_sym(alloc, a64_asm.X0, ro_sym, 0_i64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, off, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, bytes.len.widen.[u64]());
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, off +% 8_i32, a64_asm.X0, 8_u8, a64_asm.X16);
        }
        .Null => { try cg_emit_opt_null(alloc, cg, eir_prog, env, dst, ty); }
        .EnumTag => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, c.int_val.lo);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .ErrorTag => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, c.aux_u32.widen.[u64]());
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .FnRef => {
            let def_id = c.aux_u32;
            let thunk_sym = try intern_sym_u64(alloc, interner, "eon_fnref_thunk_", def_id.widen.[u64]());
            try cg.fn_ref_thunks.push(alloc, mach_x64.FnRefThunkReq.{ thunk_sym: thunk_sym, target_def: def_id });
            let off = cg_val_off(cg, dst);
            try cg.buf.lea_sym(alloc, a64_asm.X0, thunk_sym, 0_i64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, off, a64_asm.X0, 8_u8, a64_asm.X16);
            if lay.size >= 16_usize {
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, off +% 8_i32, a64_asm.XZR, 8_u8, a64_asm.X16);
            }
        }
        .ConstDef => {
            if lay.size == 0_usize { return; }
            if let val_id = ct.get_const_val(c.aux_u32) {
                var enc = try col.DynBuf.[u8].init(alloc, if lay.size > 8_usize { lay.size } else { 8_usize });
                errdefer enc.destroy(alloc);
                let ok = try ctvm.encode_ct_val_bytes(alloc, ct, val_id, ty, env, &mut enc);
                if ok && enc.len() > 0_usize {
                    let al = if lay.align == 0_usize { 1_u32 } else { lay.align.trunc.[u32]() };
                    let ro_sym = try cg_intern_rodata(alloc, cg, interner, enc.as_slice(), al);
                    try cg.buf.lea_sym(alloc, a64_asm.X9, ro_sym, 0_i64);
                    try cg_load_val_from_mem(alloc, cg, env, dst, a64_asm.X9, 0_i32, ty);
                    enc.destroy(alloc);
                    return;
                }
                enc.destroy(alloc);
            }
            if let cm = env.get_const(c.aux_u32) {
                if cm.has_int_val {
                    try cg.buf.mov_imm64(alloc, a64_asm.X0, cm.int_val.lo);
                    try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
                    return;
                }
            }
            let loc = cg_val_loc(cg, dst);
            if loc.kind == .Reg { try cg.buf.mov_imm64(alloc, loc.reg, 0_u64); }
            else { try cg_memzero(alloc, cg, a64_asm.X29_FP, loc.stack_off, lay.size); }
        }
    }
    return;
}

fn cg_emit_unary(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: ast.UnaryOp, operand: eir.EirValue, ty: types.TyId) -> !OutOfMemory {
    let n = env.get(ty);
    if n.kind == .Float && op == .Neg {
        if n.u8_val == 16_u8 {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, a64_asm.X0);
            try cg.buf.mov_imm64(alloc, a64_asm.X1, 0x8000_u64);
            try cg.buf.eor_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            return;
        }
        let is64 = n.u8_val == 64_u8;
        try cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, 0_u8);
        try cg.buf.fneg_s(alloc, is64, 0_u8, 0_u8);
        try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8);
        return;
    }
    if n.kind == .Vec && op == .Neg {
        let elem = n.primary;
        let lanes = n.u8_val.widen.[usize]();
        let esz = env.x64_layout(elem).size;
        let is_flt = env.get(elem).kind == .Float;
        let doff = cg_val_off(cg, dst);
        let soff = cg_val_off(cg, operand);
        var li: usize = 0_usize;
        while li < lanes {
            let ld = (li *% esz).trunc.[i32]();
            if is_flt {
                let is64 = esz == 8_usize;
                try cg.buf.load_vec_mem(alloc, 0_u8, a64_asm.X29_FP, soff +% ld, esz.trunc.[u8](), a64_asm.X16);
                try cg.buf.fneg_s(alloc, is64, 0_u8, 0_u8);
                try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, doff +% ld, 0_u8, esz.trunc.[u8](), a64_asm.X16);
            } else {
                try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, soff +% ld, esz.trunc.[u8](), env.is_signed_int(elem), a64_asm.X16);
                try cg.buf.neg_rr(alloc, true, false, a64_asm.X0, a64_asm.X0);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ld, a64_asm.X0, esz.trunc.[u8](), a64_asm.X16);
            }
            li = li +% 1_usize;
        }
        return;
    }
    try cg_load_scalar_val(alloc, cg, eir_prog, env, operand, a64_asm.X0);
    match op {
        .Neg => {
            try cg.buf.neg_rr(alloc, true, false, a64_asm.X0, a64_asm.X0);
            try cg_norm_subword(alloc, cg, env, ty, a64_asm.X0);
        }
        .Not => {
            try cg.buf.mov_imm64(alloc, a64_asm.X1, 1_u64);
            try cg.buf.eor_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1);
        }
        .BitNot => {
            try cg.buf.mvn_rr(alloc, true, a64_asm.X0, a64_asm.X0);
            try cg_norm_subword(alloc, cg, env, ty, a64_asm.X0);
        }
        _ => {}
    }
    try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
    return;
}

fn cg_emit_binary_float(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: ast.BinaryOp, lhs: eir.EirValue, rhs: eir.EirValue, op_ty: types.TyId) -> !OutOfMemory {
    let is_f16 = env.get(op_ty).u8_val == 16_u8;
    let is_f64 = env.get(op_ty).u8_val == 64_u8;
    if is_f16 {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, rhs, a64_asm.X0);
        try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, cg.frame.temp_off, 0_u8, 4_u8, a64_asm.X16);
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, lhs, a64_asm.X0);
        try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        try cg.buf.load_vec_mem(alloc, 1_u8, a64_asm.X29_FP, cg.frame.temp_off, 4_u8, a64_asm.X16);
    } else {
        try cg_load_float_val(alloc, cg, eir_prog, env, interner, lhs, 0_u8);
        try cg_load_float_val(alloc, cg, eir_prog, env, interner, rhs, 1_u8);
    }
    let use_f64 = !is_f16 && is_f64;
    match op {
        .Add => { try cg.buf.fadd_s(alloc, use_f64, 0_u8, 0_u8, 1_u8); try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8); }
        .Sub => { try cg.buf.fsub_s(alloc, use_f64, 0_u8, 0_u8, 1_u8); try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8); }
        .Mul => { try cg.buf.fmul_s(alloc, use_f64, 0_u8, 0_u8, 1_u8); try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8); }
        .Div => { try cg.buf.fdiv_s(alloc, use_f64, 0_u8, 0_u8, 1_u8); try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8); }
        _ => {
            try cg.buf.fcmp_s(alloc, use_f64, 0_u8, 1_u8);
            let cc: a64_asm.A64Cond = match op {
                .Eq => .Eq,
                .NotEq => .Ne,
                .Lt => .Mi,
                .LtEq => .Ls,
                .Gt => .Gt,
                _ => .Ge,
            };
            try cg.buf.cset(alloc, true, a64_asm.X0, cc);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
    }
    return;
}

fn cg_emit_binary_vec(alloc: *mut AllocCap, cg: *mut A64Cg, env: *types.TypeEnv, dst: eir.EirValue, op: ast.BinaryOp, lhs: eir.EirValue, rhs: eir.EirValue, op_ty: types.TyId) -> !OutOfMemory {
    let vn = env.get(op_ty);
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem);
    let esz = env.x64_layout(elem).size;
    let doff = cg_val_off(cg, dst);
    let loff = cg_val_off(cg, lhs);
    let roff = cg_val_off(cg, rhs);

    // NEON 128-bit packed fast path for f32x4 and f64x2!
    if en.kind == .Float && ((en.u8_val == 32_u8 && lanes == 4_usize) || (en.u8_val == 64_u8 && lanes == 2_usize)) {
        let is64 = en.u8_val == 64_u8;
        if op == .Add || op == .Sub || op == .Mul || op == .Div {
            try cg.buf.load_vec_mem(alloc, 0_u8, a64_asm.X29_FP, loff, 16_u8, a64_asm.X16);
            try cg.buf.load_vec_mem(alloc, 1_u8, a64_asm.X29_FP, roff, 16_u8, a64_asm.X16);
            match op {
                .Add => { try cg.buf.vfadd_vec(alloc, is64, 0_u8, 0_u8, 1_u8); }
                .Sub => { try cg.buf.vfsub_vec(alloc, is64, 0_u8, 0_u8, 1_u8); }
                .Mul => { try cg.buf.vfmul_vec(alloc, is64, 0_u8, 0_u8, 1_u8); }
                _ => { try cg.buf.vfdiv_vec(alloc, is64, 0_u8, 0_u8, 1_u8); }
            }
            try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, doff, 0_u8, 16_u8, a64_asm.X16);
            return;
        }
    }

    let signed = env.is_signed_int(elem);
    var li: usize = 0_usize;
    while li < lanes {
        let ld = (li *% esz).trunc.[i32]();
        if en.kind == .Float {
            let is64 = en.u8_val == 64_u8;
            let b: u8 = if is64 { 8_u8 } else { 4_u8 };
            try cg.buf.load_vec_mem(alloc, 0_u8, a64_asm.X29_FP, loff +% ld, b, a64_asm.X16);
            try cg.buf.load_vec_mem(alloc, 1_u8, a64_asm.X29_FP, roff +% ld, b, a64_asm.X16);
            match op {
                .Add => { try cg.buf.fadd_s(alloc, is64, 0_u8, 0_u8, 1_u8); }
                .Sub => { try cg.buf.fsub_s(alloc, is64, 0_u8, 0_u8, 1_u8); }
                .Mul => { try cg.buf.fmul_s(alloc, is64, 0_u8, 0_u8, 1_u8); }
                _ => { try cg.buf.fdiv_s(alloc, is64, 0_u8, 0_u8, 1_u8); }
            }
            try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, doff +% ld, 0_u8, b, a64_asm.X16);
        } else {
            let b = esz.trunc.[u8]();
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, loff +% ld, b, signed, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, roff +% ld, b, signed, a64_asm.X16);
            match op {
                .Add => { try cg.buf.add_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .AddWrap => { try cg.buf.add_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .Sub => { try cg.buf.sub_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .SubWrap => { try cg.buf.sub_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .Mul => { try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .MulWrap => { try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .BitAnd => { try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .BitOr => { try cg.buf.orr_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .BitXor => { try cg.buf.eor_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .Shl => { try cg.buf.lslv(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .ShlWrap => { try cg.buf.lslv(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .Shr => {
                    if signed { try cg.buf.asrv(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                    else { try cg.buf.lsrv(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                }
                _ => {}
            }
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ld, a64_asm.X0, b, a64_asm.X16);
        }
        li = li +% 1_usize;
    }
    return;
}

fn cg_emit_binary_checked(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, op: ast.BinaryOp, lhs: eir.EirValue, rhs: eir.EirValue, op_ty: types.TyId) -> !OutOfMemory {
    let signed = env.is_signed_int(op_ty);
    let bits = env.int_bits(op_ty);
    let ok_sz = env.x64_layout(op_ty).size.trunc.[u8]();
    let ok_off = env.eu_ok_offset(op_ty).trunc.[i32]();
    let dst_off = cg_val_off(cg, dst);
    let bnds = types.int_bounds(env.get(op_ty));

    try cg_load_scalar_val(alloc, cg, eir_prog, env, lhs, a64_asm.X0);
    try cg_load_scalar_val(alloc, cg, eir_prog, env, rhs, a64_asm.X1);
    let l_ovf = try cg.buf.new_label(alloc);
    let l_done = try cg.buf.new_label(alloc);

    if op == .DivCheck || op == .ModCheck {
        let l_dz = try cg.buf.new_label(alloc);
        try cg.buf.cbz_label(alloc, true, a64_asm.X1, l_dz);
        if signed {
            let l_okd = try cg.buf.new_label(alloc);
            try cg.buf.mov_imm64(alloc, a64_asm.X2, bnds.min.lo);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X2);
            try cg.buf.b_cond_label(alloc, .Ne, l_okd);
            try cg.buf.cmn_imm(alloc, true, a64_asm.X1, 1_u16); // X1 == -1?
            try cg.buf.b_cond_label(alloc, .Eq, l_ovf);
            cg.buf.bind_label(l_okd);
            try cg.buf.sdiv_rr(alloc, true, a64_asm.X2, a64_asm.X0, a64_asm.X1);
        } else {
            try cg.buf.udiv_rr(alloc, true, a64_asm.X2, a64_asm.X0, a64_asm.X1);
        }
        if op == .ModCheck {
            try cg.buf.msub_rrr(alloc, true, a64_asm.X2, a64_asm.X2, a64_asm.X1, a64_asm.X0);
        }
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, dst_off, a64_asm.XZR, 4_u8, a64_asm.X16);
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, dst_off +% ok_off, a64_asm.X2, ok_sz, a64_asm.X16);
        try cg.buf.b_label(alloc, l_done);
        cg.buf.bind_label(l_dz);
        try cg.buf.mov_imm64(alloc, a64_asm.X9, 2_u64); // DivByZero = 2
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, dst_off, a64_asm.X9, 4_u8, a64_asm.X16);
        try cg.buf.b_label(alloc, l_done);
    } else if bits < 64_u8 {
        if !signed && op == .SubCheck {
            try cg.buf.sub_rr(alloc, true, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.b_cond_label(alloc, .Cc, l_ovf); // ARM64: C=0 means borrow/underflow!
        } else {
            match op {
                .AddCheck => { try cg.buf.add_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .SubCheck => { try cg.buf.sub_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                _ => { try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
            }
            if signed {
                try cg.buf.mov_imm64(alloc, a64_asm.X2, bnds.min.lo);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X2);
                try cg.buf.b_cond_label(alloc, .Lt, l_ovf);
            }
            try cg.buf.mov_imm64(alloc, a64_asm.X2, bnds.max.lo);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X2);
            try cg.buf.b_cond_label(alloc, if signed { .Gt } else { .Hi }, l_ovf);
        }
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, dst_off, a64_asm.XZR, 4_u8, a64_asm.X16);
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, dst_off +% ok_off, a64_asm.X0, ok_sz, a64_asm.X16);
        try cg.buf.b_label(alloc, l_done);
    } else {
        if op == .AddCheck {
            try cg.buf.add_rr(alloc, true, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.b_cond_label(alloc, if signed { .Vs } else { .Cs }, l_ovf);
        } else if op == .SubCheck {
            try cg.buf.sub_rr(alloc, true, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.b_cond_label(alloc, if signed { .Vs } else { .Cc }, l_ovf);
        } else {
            if signed {
                try cg.buf.smulh(alloc, a64_asm.X2, a64_asm.X0, a64_asm.X1);
                try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                try cg.buf.asr_imm(alloc, true, a64_asm.X3, a64_asm.X0, 63_u8);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X2, a64_asm.X3);
                try cg.buf.b_cond_label(alloc, .Ne, l_ovf);
            } else {
                try cg.buf.umulh(alloc, a64_asm.X2, a64_asm.X0, a64_asm.X1);
                try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                try cg.buf.cbnz_label(alloc, true, a64_asm.X2, l_ovf);
            }
        }
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, dst_off, a64_asm.XZR, 4_u8, a64_asm.X16);
        try cg.buf.store_mem(alloc, a64_asm.X29_FP, dst_off +% ok_off, a64_asm.X0, ok_sz, a64_asm.X16);
        try cg.buf.b_label(alloc, l_done);
    }

    cg.buf.bind_label(l_ovf);
    try cg.buf.mov_imm64(alloc, a64_asm.X9, 1_u64); // Overflow = 1
    try cg.buf.store_mem(alloc, a64_asm.X29_FP, dst_off, a64_asm.X9, 4_u8, a64_asm.X16);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_binary_sat(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, op: ast.BinaryOp, lhs: eir.EirValue, rhs: eir.EirValue, op_ty: types.TyId) -> !OutOfMemory {
    let signed = env.is_signed_int(op_ty);
    let bits = env.int_bits(op_ty);
    let bnds = types.int_bounds(env.get(op_ty));
    try cg_load_scalar_val(alloc, cg, eir_prog, env, lhs, a64_asm.X0);
    try cg_load_scalar_val(alloc, cg, eir_prog, env, rhs, a64_asm.X1);

    if bits < 64_u8 {
        if !signed && op == .SubSat {
            try cg.buf.sub_rr(alloc, true, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.XZR, a64_asm.X0, .Cc);
        } else {
            match op {
                .AddSat => { try cg.buf.add_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                .SubSat => { try cg.buf.sub_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
                _ => { try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
            }
            if signed {
                try cg.buf.mov_imm64(alloc, a64_asm.X2, bnds.min.lo);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X2);
                try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X2, a64_asm.X0, .Lt);
            }
            try cg.buf.mov_imm64(alloc, a64_asm.X2, bnds.max.lo);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X2);
            try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X2, a64_asm.X0, if signed { .Gt } else { .Hi });
        }
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        return;
    }

    let l_done = try cg.buf.new_label(alloc);
    if !signed {
        if op == .AddSat {
            try cg.buf.add_rr(alloc, true, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.b_cond_label(alloc, .Cc, l_done);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0xFFFFFFFFFFFFFFFF_u64);
        } else if op == .SubSat {
            try cg.buf.sub_rr(alloc, true, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.b_cond_label(alloc, .Cs, l_done);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
        } else {
            try cg.buf.umulh(alloc, a64_asm.X2, a64_asm.X0, a64_asm.X1);
            try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.cbz_label(alloc, true, a64_asm.X2, l_done);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0xFFFFFFFFFFFFFFFF_u64);
        }
        cg.buf.bind_label(l_done);
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        return;
    }

    // Signed 64-bit saturating add / sub / mul
    try cg.buf.mov_rr(alloc, a64_asm.X9, a64_asm.X0);
    try cg.buf.mov_rr(alloc, a64_asm.X10, a64_asm.X1);
    if op == .AddSat {
        try cg.buf.add_rr(alloc, true, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
        try cg.buf.b_cond_label(alloc, .Vc, l_done);
        try cg.buf.mov_imm64(alloc, a64_asm.X0, 0x7FFFFFFFFFFFFFFF_u64);
        try cg.buf.mov_imm64(alloc, a64_asm.X2, 0x8000000000000000_u64);
        try cg.buf.cmp_imm(alloc, true, a64_asm.X9, 0_u16);
        try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X2, a64_asm.X0, .Lt);
    } else if op == .SubSat {
        try cg.buf.sub_rr(alloc, true, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
        try cg.buf.b_cond_label(alloc, .Vc, l_done);
        try cg.buf.mov_imm64(alloc, a64_asm.X0, 0x7FFFFFFFFFFFFFFF_u64);
        try cg.buf.mov_imm64(alloc, a64_asm.X2, 0x8000000000000000_u64);
        try cg.buf.cmp_imm(alloc, true, a64_asm.X9, 0_u16);
        try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X2, a64_asm.X0, .Lt);
    } else {
        try cg.buf.smulh(alloc, a64_asm.X2, a64_asm.X0, a64_asm.X1);
        try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
        try cg.buf.asr_imm(alloc, true, a64_asm.X3, a64_asm.X0, 63_u8);
        try cg.buf.cmp_rr(alloc, true, a64_asm.X2, a64_asm.X3);
        try cg.buf.b_cond_label(alloc, .Eq, l_done);
        try cg.buf.eor_rr(alloc, true, a64_asm.X9, a64_asm.X9, a64_asm.X10);
        try cg.buf.mov_imm64(alloc, a64_asm.X0, 0x7FFFFFFFFFFFFFFF_u64);
        try cg.buf.mov_imm64(alloc, a64_asm.X2, 0x8000000000000000_u64);
        try cg.buf.cmp_imm(alloc, true, a64_asm.X9, 0_u16);
        try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X2, a64_asm.X0, .Lt);
    }
    cg.buf.bind_label(l_done);
    try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
    return;
}

fn cg_emit_binary(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: ast.BinaryOp, lhs: eir.EirValue, rhs: eir.EirValue, dst_ty: types.TyId, op_ty: types.TyId) -> !OutOfMemory {
    let op_node = env.get(op_ty);
    if op_node.kind == .Float {
        try cg_emit_binary_float(alloc, cg, eir_prog, env, interner, dst, op, lhs, rhs, op_ty);
        return;
    }
    if op_node.kind == .Vec {
        try cg_emit_binary_vec(alloc, cg, env, dst, op, lhs, rhs, op_ty);
        return;
    }
    if op == .AddCheck || op == .SubCheck || op == .MulCheck || op == .DivCheck || op == .ModCheck {
        try cg_emit_binary_checked(alloc, cg, eir_prog, env, dst, op, lhs, rhs, op_ty);
        return;
    }
    if op == .AddSat || op == .SubSat || op == .MulSat {
        try cg_emit_binary_sat(alloc, cg, eir_prog, env, dst, op, lhs, rhs, op_ty);
        return;
    }

    let signed = env.is_signed_int(op_ty);
    try cg_load_scalar_val(alloc, cg, eir_prog, env, lhs, a64_asm.X0);
    try cg_load_scalar_val(alloc, cg, eir_prog, env, rhs, a64_asm.X1);

    match op {
        .Add => { try cg.buf.add_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0); }
        .AddWrap => { try cg.buf.add_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0); }
        .Sub => { try cg.buf.sub_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0); }
        .SubWrap => { try cg.buf.sub_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0); }
        .Mul => { try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0); }
        .MulWrap => { try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0); }
        .Div => {
            if signed { try cg.buf.sdiv_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
            else { try cg.buf.udiv_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
            try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0);
        }
        .Mod => {
            if signed { try cg.buf.sdiv_rr(alloc, true, a64_asm.X2, a64_asm.X0, a64_asm.X1); }
            else { try cg.buf.udiv_rr(alloc, true, a64_asm.X2, a64_asm.X0, a64_asm.X1); }
            try cg.buf.msub_rrr(alloc, true, a64_asm.X0, a64_asm.X2, a64_asm.X1, a64_asm.X0);
            try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0);
        }
        .BitAnd => { try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1); try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0); }
        .BitOr => { try cg.buf.orr_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0); }
        .BitXor => { try cg.buf.eor_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0); }
        .And => {
            try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 1_u64);
            try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X2);
        }
        .Or => {
            try cg.buf.orr_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 1_u64);
            try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X2);
        }
        .Shl => { try cg.buf.lslv(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0); }
        .ShlWrap => {
            let bits = env.int_bits(op_ty);
            if bits > 0_u8 && bits < 64_u8 {
                try cg.buf.mov_imm64(alloc, a64_asm.X2, (bits -% 1_u8).widen.[u64]());
                try cg.buf.and_rr(alloc, true, false, a64_asm.X1, a64_asm.X1, a64_asm.X2);
            }
            try cg.buf.lslv(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0);
        }
        .Shr => {
            if signed { try cg.buf.asrv(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
            else { try cg.buf.lsrv(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1); }
            try cg_norm_subword(alloc, cg, env, dst_ty, a64_asm.X0);
        }
        .Eq => { try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1); try cg.buf.cset(alloc, true, a64_asm.X0, .Eq); }
        .NotEq => { try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1); try cg.buf.cset(alloc, true, a64_asm.X0, .Ne); }
        .Lt => { try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1); try cg.buf.cset(alloc, true, a64_asm.X0, if signed { .Lt } else { .Cc }); }
        .LtEq => { try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1); try cg.buf.cset(alloc, true, a64_asm.X0, if signed { .Le } else { .Ls }); }
        .Gt => { try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1); try cg.buf.cset(alloc, true, a64_asm.X0, if signed { .Gt } else { .Hi }); }
        .GtEq => { try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1); try cg.buf.cset(alloc, true, a64_asm.X0, if signed { .Ge } else { .Cs }); }
        _ => {}
    }
    try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
    return;
}

fn cg_emit_cast(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, kind: cfg_ir.CastKind, operand: eir.EirValue, from_ty: types.TyId, to_ty: types.TyId) -> !OutOfMemory {
    let from_n = env.get(from_ty);
    let to_n = env.get(to_ty);
    match kind {
        .Widen => {
            if from_n.kind == .Float && to_n.kind == .Float {
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, 0_u8);
                if from_n.u8_val != 64_u8 && to_n.u8_val == 64_u8 { try cg.buf.fcvt_s_to_d(alloc, 0_u8, 0_u8); }
                try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8);
                return;
            }
            try cg_load_scalar_val(alloc, cg, eir_prog, env, operand, a64_asm.X0);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .Trunc => {
            if from_n.kind == .Float && to_n.kind == .Float {
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, 0_u8);
                if from_n.u8_val == 64_u8 && to_n.u8_val != 64_u8 { try cg.buf.fcvt_d_to_s(alloc, 0_u8, 0_u8); }
                try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8);
                return;
            }
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, a64_asm.X0);
            try cg_norm_subword(alloc, cg, env, to_ty, a64_asm.X0);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .Clamp => {
            try cg_load_scalar_val(alloc, cg, eir_prog, env, operand, a64_asm.X0);
            let src_signed = env.is_signed_int(from_ty);
            let dst_signed = env.is_signed_int(to_ty);
            let bnds = types.int_bounds(to_n);
            if src_signed && !dst_signed {
                try cg.buf.cmp_imm(alloc, true, a64_asm.X0, 0_u16);
                try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.XZR, a64_asm.X0, .Lt);
                if env.int_bits(to_ty) < 64_u8 {
                    try cg.buf.mov_imm64(alloc, a64_asm.X2, bnds.max.lo);
                    try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X2);
                    try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X2, a64_asm.X0, .Hi);
                }
            } else {
                try cg.buf.mov_imm64(alloc, a64_asm.X2, bnds.min.lo);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X2);
                try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X2, a64_asm.X0, if src_signed { .Lt } else { .Cc });
                try cg.buf.mov_imm64(alloc, a64_asm.X2, bnds.max.lo);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X2);
                try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X2, a64_asm.X0, if src_signed { .Gt } else { .Hi });
            }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .ToFloat => {
            let is_f64 = to_n.u8_val == 64_u8;
            try cg_load_scalar_val(alloc, cg, eir_prog, env, operand, a64_asm.X0);
            if env.is_signed_int(from_ty) {
                try cg.buf.scvtf(alloc, true, is_f64, 0_u8, a64_asm.X0);
            } else {
                try cg.buf.ucvtf(alloc, true, is_f64, 0_u8, a64_asm.X0);
            }
            try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8);
        }
        .TruncToInt => {
            let is_f64 = from_n.u8_val == 64_u8;
            try cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, 0_u8);
            if env.is_signed_int(to_ty) {
                try cg.buf.fcvtzs(alloc, true, is_f64, a64_asm.X0, 0_u8);
            } else {
                try cg.buf.fcvtzu(alloc, true, is_f64, a64_asm.X0, 0_u8);
            }
            try cg_norm_subword(alloc, cg, env, to_ty, a64_asm.X0);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .Bitcast => {
            let sz = env.x64_layout(to_ty).size;
            if sz == 0_usize { return; }
            let dloc = cg_val_loc(cg, dst);
            let sloc = cg_val_loc(cg, operand);
            if dloc.kind == .Reg || sloc.kind == .Reg {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, a64_asm.X0);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            } else {
                try cg_copy_mem(alloc, cg, a64_asm.X29_FP, dloc.stack_off, a64_asm.X29_FP, sloc.stack_off, sz);
            }
        }
        .AsU64 => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, a64_asm.X0);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .MutToConst => { try cg_copy_val_to_val(alloc, cg, eir_prog, env, dst, operand); }
        .ArrayBorrowToSlice => {
            let arr_len = env.get(from_n.primary).u64_val;
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, a64_asm.X0);
            let doff = cg_val_off(cg, dst);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, arr_len);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 8_i32, a64_asm.X0, 8_u8, a64_asm.X16);
        }
        .WrapOptional => {
            let inner = to_n.primary;
            let niche = env.opt_niche(inner);
            if niche.kind != .None {
                try cg_copy_val_to_val(alloc, cg, eir_prog, env, dst, operand);
            } else {
                let doff = cg_val_off(cg, dst);
                let voff = env.opt_val_offset(inner).trunc.[i32]();
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 1_u64);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 1_u8, a64_asm.X16);
                try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff +% voff, operand, inner);
            }
        }
        .WrapOk => {
            let ok_ty = to_n.primary;
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            if env.x64_layout(ok_ty).size > 0_usize {
                try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff +% ok_off, operand, ok_ty);
            }
        }
        .WrapErr => {
            let doff = cg_val_off(cg, dst);
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, a64_asm.X0);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
        }
    }
    return;
}

fn cg_emit_slice(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, base: eir.EirValue, lo_val: eir.EirValue, hi_val: eir.EirValue, base_ty: types.TyId) -> !OutOfMemory {
    let bn = env.get(base_ty);
    var elem_sz: usize = 1_usize;
    if bn.kind == .Array {
        elem_sz = env.x64_layout(bn.primary).size;
        try cg_val_addr_into(alloc, cg, base, a64_asm.X9);
        try cg.buf.mov_imm64(alloc, a64_asm.X10, bn.u64_val);
    } else if bn.kind == .Borrow && bn.borrow_kind == .Single {
        let inner = env.get(bn.primary);
        if inner.kind == .Array {
            elem_sz = env.x64_layout(inner.primary).size;
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, base, a64_asm.X9);
            try cg.buf.mov_imm64(alloc, a64_asm.X10, inner.u64_val);
        }
    } else if bn.kind == .Borrow && bn.borrow_kind == .Slice {
        elem_sz = env.x64_layout(bn.primary).size;
        let boff = cg_val_off(cg, base);
        try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, boff, 8_u8, false, a64_asm.X16);
        try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X29_FP, boff +% 8_i32, 8_u8, false, a64_asm.X16);
    } else {
        let boff = cg_val_off(cg, base);
        try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, boff, 8_u8, false, a64_asm.X16);
        try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X29_FP, boff +% 8_i32, 8_u8, false, a64_asm.X16);
    }
    if lo_val != eir.EIR_NONE { try cg_load_scalar_raw(alloc, cg, eir_prog, env, lo_val, a64_asm.X1); }
    else { try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64); }
    if hi_val != eir.EIR_NONE { try cg_load_scalar_raw(alloc, cg, eir_prog, env, hi_val, a64_asm.X2); }
    else { try cg.buf.mov_rr(alloc, a64_asm.X2, a64_asm.X10); }
    try cg.buf.sub_rr(alloc, true, false, a64_asm.X2, a64_asm.X2, a64_asm.X1);
    if elem_sz > 1_usize {
        try cg.buf.mov_imm64(alloc, a64_asm.X12, elem_sz.widen.[u64]());
        try cg.buf.mul_rr(alloc, true, a64_asm.X1, a64_asm.X1, a64_asm.X12);
    }
    try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X1);
    let doff = cg_val_off(cg, dst);
    try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X9, 8_u8, a64_asm.X16);
    try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 8_i32, a64_asm.X2, 8_u8, a64_asm.X16);
    return;
}

fn cg_emit_aggregate(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, agg_id: u32, elems_range: ast.IdRange, dst_ty: types.TyId) -> !OutOfMemory {
    let agg = eir_prog.get_aggregate(agg_id) orelse { return; };
    let elems = eir_prog.vals_slice(elems_range);
    let dst_lay = env.x64_layout(dst_ty);
    if dst_lay.size == 0_usize { return; }
    let dst_loc = cg_val_loc(cg, dst);

    if agg.tag == .Bitfield {
        try cg.buf.mov_imm64(alloc, a64_asm.X10, 0_u64);
        if let bm = env.get_bitfield(agg.def_id) {
            let mems = env.bitfield_members_range(bm.members);
            var i: usize = 0_usize;
            while i < elems.len && i < mems.len {
                let m = mems[i];
                let width = m.hi -% m.lo;
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, elems[i], a64_asm.X0);
                if width < 64_u8 { try cg.buf.extend_bits(alloc, a64_asm.X0, a64_asm.X0, width, false); }
                if m.lo > 0_u8 { try cg.buf.lsl_imm(alloc, true, a64_asm.X0, a64_asm.X0, m.lo); }
                try cg.buf.orr_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X0);
                i = i +% 1_usize;
            }
        }
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X10);
        return;
    }

    let doff = dst_loc.stack_off;
    if dst_loc.kind == .Stack { try cg_memzero(alloc, cg, a64_asm.X29_FP, doff, dst_lay.size); }

    match agg.tag {
        .Struct => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff +% foff.offset.trunc.[i32](), elems[i], foff.ty);
                i = i +% 1_usize;
            }
        }
        .AnonStruct => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff +% foff.offset.trunc.[i32](), elems[i], foff.ty);
                i = i +% 1_usize;
            }
        }
        .Tuple => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff +% foff.offset.trunc.[i32](), elems[i], foff.ty);
                i = i +% 1_usize;
            }
        }
        .PoolRow => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                let is_link = env.is_link_or_opt_link(foff.ty);
                let ev_ty = eir_prog.fn_val_ty(cg.fn_id, elems[i]);
                let ev_sz = env.x64_layout(ev_ty).size;
                if !agg.is_slot_pool && is_link && ev_sz == 4_usize {
                    try cg_load_scalar_raw(alloc, cg, eir_prog, env, elems[i], a64_asm.X0);
                    try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% foff.offset.trunc.[i32](), a64_asm.X0, 4_u8, a64_asm.X16);
                    try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% foff.offset.trunc.[i32]() +% 4_i32, a64_asm.XZR, 4_u8, a64_asm.X16);
                } else {
                    let store_ty = if agg.is_slot_pool && is_link { ev_ty } else { foff.ty };
                    try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff +% foff.offset.trunc.[i32](), elems[i], store_ty);
                }
                i = i +% 1_usize;
            }
        }
        .Array => {
            let esz = env.x64_layout(agg.elem_ty).size;
            var i: usize = 0_usize;
            while i < elems.len {
                try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff +% (i *% esz).trunc.[i32](), elems[i], agg.elem_ty);
                i = i +% 1_usize;
            }
        }
        .ArrayRepeat => {
            if elems.len > 0_usize && agg.count > 0_u64 {
                let esz = env.x64_layout(agg.elem_ty).size;
                let cnt = agg.count.trunc.[usize]();
                if cnt <= 4_usize {
                    var i: usize = 0_usize;
                    while i < cnt {
                        try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff +% (i *% esz).trunc.[i32](), elems[0_usize], agg.elem_ty);
                        i = i +% 1_usize;
                    }
                } else {
                    try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff, elems[0_usize], agg.elem_ty);
                    try cg.buf.add_signed_imm(alloc, a64_asm.X9, a64_asm.X29_FP, doff.widen.[i64](), a64_asm.X16);
                    try cg.buf.mov_imm64(alloc, a64_asm.X10, 1_u64);
                    try cg.buf.mov_imm64(alloc, a64_asm.X11, agg.count);
                    let l_lp = try cg.buf.new_label(alloc);
                    cg.buf.bind_label(l_lp);
                    try cg.buf.add_signed_imm(alloc, a64_asm.X9, a64_asm.X9, esz.widen.[u64]().bitcast.[i64](), a64_asm.X16);
                    try cg_copy_mem(alloc, cg, a64_asm.X9, 0_i32, a64_asm.X29_FP, doff, esz);
                    try cg.buf.add_imm(alloc, true, false, a64_asm.X10, a64_asm.X10, 1_u16, false);
                    try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
                    try cg.buf.b_cond_label(alloc, .Cc, l_lp);
                }
            }
        }
        .UnionVariant => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, agg.variant_idx.widen.[u64]());
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
            if elems.len > 0_usize {
                let pay_off = env.union_payload_offset(agg.def_id).trunc.[i32]();
                let pty = eir_prog.fn_val_ty(cg.fn_id, elems[0_usize]);
                try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff +% pay_off, elems[0_usize], pty);
            }
        }
        .Vec => {
            let esz = env.x64_layout(agg.elem_ty).size;
            var i: usize = 0_usize;
            while i < elems.len {
                try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, doff +% (i *% esz).trunc.[i32](), elems[i], agg.elem_ty);
                i = i +% 1_usize;
            }
        }
        _ => {}
    }
    return;
}

fn cg_emit_unwrap_and_extract(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, inst: *eir.EirInst) -> !OutOfMemory {
    match inst.kind {
        .UnwrapOptional => {
            let inner = inst.ty0;
            if env.opt_niche(inner).kind != .None {
                try cg_copy_val_to_val(alloc, cg, eir_prog, env, inst.dst, inst.v0);
            } else {
                let soff = cg_val_off(cg, inst.v0);
                let voff = env.opt_val_offset(inner).trunc.[i32]();
                try cg_load_val_from_mem(alloc, cg, env, inst.dst, a64_asm.X29_FP, soff +% voff, inner);
            }
        }
        .UnwrapErrorOk => {
            let ok_ty = inst.ty0;
            if env.x64_layout(ok_ty).size > 0_usize {
                let soff = cg_val_off(cg, inst.v0);
                let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
                try cg_load_val_from_mem(alloc, cg, env, inst.dst, a64_asm.X29_FP, soff +% ok_off, ok_ty);
            }
        }
        .UnwrapErrorErr => {
            let soff = cg_val_off(cg, inst.v0);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, soff, 4_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, a64_asm.X0);
        }
        .IsNonNull => {
            let inner = env.get(inst.ty1).primary;
            let niche = env.opt_niche(inner);
            let sloc = cg_val_loc(cg, inst.v0);
            match niche.kind {
                .IdBrand => {
                    try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, a64_asm.X0);
                    try cg.buf.mov_imm64(alloc, a64_asm.X1, 0xFFFFFFFF_u64);
                    try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1);
                    try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
                }
                .GenId => {
                    try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, a64_asm.X0);
                    try cg.buf.lsr_imm(alloc, true, a64_asm.X0, a64_asm.X0, 32_u8);
                    try cg.buf.cmp_imm(alloc, false, a64_asm.X0, 0_u16);
                    try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
                }
                .Link => {
                    try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, a64_asm.X0);
                    try cg.buf.lsr_imm(alloc, true, a64_asm.X0, a64_asm.X0, 32_u8);
                    try cg.buf.cmp_imm(alloc, false, a64_asm.X0, 0_u16);
                    try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
                }
                .NullPtr => {
                    try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, a64_asm.X0);
                    try cg.buf.cmp_imm(alloc, true, a64_asm.X0, 0_u16);
                    try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
                }
                .FatPtrNullFirst => {
                    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, sloc.stack_off, 8_u8, false, a64_asm.X16);
                    try cg.buf.cmp_imm(alloc, true, a64_asm.X0, 0_u16);
                    try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
                }
                .SliceMaxLen => {
                    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, sloc.stack_off +% 8_i32, 8_u8, false, a64_asm.X16);
                    try cg.buf.mov_imm64(alloc, a64_asm.X1, 0xFFFFFFFFFFFFFFFF_u64);
                    try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1);
                    try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
                }
                .BoolTag => {
                    try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, a64_asm.X0);
                    try cg.buf.cmp_imm(alloc, true, a64_asm.X0, 2_u16);
                    try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
                }
                .ScalarSentinel => {
                    try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, a64_asm.X0);
                    try cg.buf.mov_imm64(alloc, a64_asm.X1, niche.sentinel);
                    try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1);
                    try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
                }
                .None => {
                    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, sloc.stack_off, 1_u8, false, a64_asm.X16);
                    try cg.buf.cmp_imm(alloc, true, a64_asm.X0, 0_u16);
                    try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
                }
            }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, a64_asm.X0);
        }
        .IsError => {
            let soff = cg_val_off(cg, inst.v0);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, soff, 4_u8, false, a64_asm.X16);
            try cg.buf.cmp_imm(alloc, false, a64_asm.X0, 0_u16);
            try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, a64_asm.X0);
        }
        .MatchTag => {
            let src_n = env.get(inst.ty1);
            if src_n.kind == .Union || src_n.kind == .ErrorUnion {
                let soff = cg_val_off(cg, inst.v0);
                try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, soff, 4_u8, false, a64_asm.X16);
            } else {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, a64_asm.X0);
            }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, a64_asm.X0);
        }
        .FieldExtract => {
            let src_n = env.get(inst.ty1);
            if src_n.kind == .Union {
                let pay_off = env.union_payload_offset(src_n.primary).trunc.[i32]();
                try cg_load_val_from_mem(alloc, cg, env, inst.dst, a64_asm.X29_FP, cg_val_off(cg, inst.v0) +% pay_off, inst.ty0);
                return;
            }
            if src_n.kind == .Bitfield {
                let bf = lookup_bf_member(env, src_n.primary, inst.aux0.widen.[usize]());
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, a64_asm.X0);
                if bf.lo > 0_u8 { try cg.buf.lsr_imm(alloc, true, a64_asm.X0, a64_asm.X0, bf.lo); }
                if bf.width < 64_u8 { try cg.buf.extend_bits(alloc, a64_asm.X0, a64_asm.X0, bf.width, env.is_signed_int(bf.member_ty)); }
                try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, a64_asm.X0);
                return;
            }
            let foff = env.struct_field_offset(inst.ty1, inst.aux0.widen.[usize]());
            let sloc = cg_val_loc(cg, inst.v0);
            if sloc.kind == .Reg {
                try cg.buf.mov_rr(alloc, a64_asm.X0, sloc.reg);
                if foff.offset > 0_usize { try cg.buf.lsr_imm(alloc, true, a64_asm.X0, a64_asm.X0, (foff.offset *% 8_usize).trunc.[u8]()); }
                try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, a64_asm.X0);
            } else {
                try cg_load_val_from_mem(alloc, cg, env, inst.dst, a64_asm.X29_FP, sloc.stack_off +% foff.offset.trunc.[i32](), inst.ty0);
            }
        }
        .MakeDyn => {
            let vt_sym = try intern_sym_u64_2(alloc, interner, "eon_vtable_", inst.aux0.widen.[u64](), inst.ty1.widen.[u64]());
            let doff = cg_val_off(cg, inst.dst);
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, a64_asm.X0);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.lea_sym(alloc, a64_asm.X0, vt_sym, 0_i64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 8_i32, a64_asm.X0, 8_u8, a64_asm.X16);
        }
        .MakeClosure => {
            let csym = try a64_fn_sym_name_id(alloc, cfg_ir.fn_key_closure(inst.aux0), eir_prog, interner);
            let doff = cg_val_off(cg, inst.dst);
            try cg.buf.lea_sym(alloc, a64_asm.X0, csym, 0_i64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 8_u8, a64_asm.X16);
            if inst.v0 != eir.EIR_NONE {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, a64_asm.X0);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 8_i32, a64_asm.X0, 8_u8, a64_asm.X16);
            } else {
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 8_i32, a64_asm.XZR, 8_u8, a64_asm.X16);
            }
        }
        .InlineAsm => {
            if let ad = eir_prog.get_asm(inst.aux0) {
                let ins = eir_prog.asm_inputs_slice(ad.inputs);
                var i: usize = 0_usize;
                while i < ins.len {
                    if let r = a64_gp_arg(i) {
                        try cg_load_scalar_raw(alloc, cg, eir_prog, env, ins[i].val, r);
                    }
                    i = i +% 1_usize;
                }
                let ok = try a64_asm.encode_a64_inline_asm(alloc, eir_prog.bytes_slice(ad.template), &mut cg.buf);
                if !ok {
                    try cg_fail(alloc, cg, "aarch64 codegen error: unsupported inline asm template");
                }
            }
        }
        _ => {}
    }
    return;
}

// ============================================================================
// Section 7: Calls (`EonCall` X8 Error Channel + `AAPCS64`), Builtins, Terms
// ============================================================================

struct A64CallArgSlot {
    val: eir.EirValue;
    ty: types.TyId;
    cls: A64ArgClass;
    is_reg: bool;
    gp_idx: usize;
    flt_idx: usize;
    stk_off: i32;
}

fn cg_emit_call(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, call_id: u32) -> !OutOfMemory {
    let cd = eir_prog.get_call(call_id) orelse { return; };
    let callee = cd.callee;
    let args = eir_prog.vals_slice(cd.args);
    let ret_ty = cd.ret_ty;
    let rc = a64_classify_ret(ret_ty, env);
    let uses_sret = a64_ret_uses_sret(rc);

    var is_c = false;
    if callee.kind == .ExternFn {
        is_c = true;
    } else if callee.kind == .DirectFn {
        if let fid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(callee.a)) {
            if let f = eir_prog.get_fn(fid) { is_c = f.sig.effects.is_export_c; }
        }
    }

    var gp_i: usize = 0_usize;
    var flt_i: usize = 0_usize;
    var stk_bytes: usize = 0_usize;
    if uses_sret && !is_c { gp_i = 1_usize; } // EonCall sret in X0; C ABI sret in X8

    var env_gp_idx: usize = 99_usize;
    var dyn_gp_idx: usize = 99_usize;
    var start_arg: usize = 0_usize;
    if callee.kind == .FnPtr { env_gp_idx = gp_i; gp_i = gp_i +% 1_usize; }
    else if callee.kind == .DynCall { dyn_gp_idx = gp_i; gp_i = gp_i +% 1_usize; start_arg = 1_usize; }

    var plan = try col.DynBuf.[A64CallArgSlot].init(alloc, if args.len > 4_usize { args.len } else { 4_usize });
    errdefer plan.destroy(alloc);
    var ai = start_arg;
    while ai < args.len {
        let av = args[ai];
        let aty = eir_prog.fn_val_ty(cg.fn_id, av);
        let cls = a64_classify_arg(aty, env);
        match cls {
            .Zst => {}
            .IntReg => {
                if gp_i < 8_usize {
                    try plan.push(alloc, A64CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32 });
                    gp_i = gp_i +% 1_usize;
                } else {
                    try plan.push(alloc, A64CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32]() });
                    stk_bytes = stk_bytes +% 8_usize;
                }
            }
            .TwoIntRegs => {
                if gp_i +% 1_usize < 8_usize {
                    try plan.push(alloc, A64CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32 });
                    gp_i = gp_i +% 2_usize;
                } else {
                    try plan.push(alloc, A64CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32]() });
                    stk_bytes = stk_bytes +% 16_usize;
                }
            }
            .FloatReg => {
                if flt_i < 8_usize {
                    try plan.push(alloc, A64CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: 0_usize, flt_idx: flt_i, stk_off: 0_i32 });
                    flt_i = flt_i +% 1_usize;
                } else {
                    try plan.push(alloc, A64CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32]() });
                    stk_bytes = stk_bytes +% 8_usize;
                }
            }
            .ByPtr => {
                if gp_i < 8_usize {
                    try plan.push(alloc, A64CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32 });
                    gp_i = gp_i +% 1_usize;
                } else {
                    try plan.push(alloc, A64CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32]() });
                    stk_bytes = stk_bytes +% 8_usize;
                }
            }
        }
        ai = ai +% 1_usize;
    }

    var discard_sret: usize = 0_usize;
    if uses_sret && dst == eir.EIR_NONE {
        let sty = if rc.kind == .ErrorUnion { rc.ok_ty } else { ret_ty };
        discard_sret = types.align_up_usize(env.x64_layout(sty).size, 16_usize);
        if discard_sret == 0_usize { discard_sret = 16_usize; }
    }
    let aligned_stk = types.align_up_usize(stk_bytes +% discard_sret, 16_usize);
    if aligned_stk > 0_usize {
        if aligned_stk.widen.[u64]() > cg.max_call_stk { cg.max_call_stk = aligned_stk.widen.[u64](); }
        try cg.buf.add_signed_imm(alloc, a64_asm.SP, a64_asm.SP, 0_i64 -% aligned_stk.widen.[u64]().bitcast.[i64](), a64_asm.X16);
    }

    // 1. Stack args first
    let ps = plan.as_slice();
    var pi: usize = 0_usize;
    while pi < ps.len {
        let s = ps[pi];
        if !s.is_reg {
            let lay = env.x64_layout(s.ty);
            if s.cls == .IntReg {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, s.val, a64_asm.X9);
                try cg.buf.store_mem(alloc, a64_asm.SP, s.stk_off, a64_asm.X9, 8_u8, a64_asm.X16);
            } else if s.cls == .TwoIntRegs {
                try cg_copy_mem(alloc, cg, a64_asm.SP, s.stk_off, a64_asm.X29_FP, cg_val_off(cg, s.val), lay.size);
            } else if s.cls == .FloatReg {
                let sz: usize = if env.get(s.ty).u8_val == 64_u8 { 8_usize } else { 4_usize };
                try cg_copy_mem(alloc, cg, a64_asm.SP, s.stk_off, a64_asm.X29_FP, cg_val_off(cg, s.val), sz);
            } else if s.cls == .ByPtr {
                try cg_val_addr_into(alloc, cg, s.val, a64_asm.X9);
                try cg.buf.store_mem(alloc, a64_asm.SP, s.stk_off, a64_asm.X9, 8_u8, a64_asm.X16);
            }
        }
        pi = pi +% 1_usize;
    }

    // 2. Register args (all sources are on stack or callee-saved X19..X26, never X0..X7!)
    pi = 0_usize;
    while pi < ps.len {
        let s = ps[pi];
        if s.is_reg {
            let lay = env.x64_layout(s.ty);
            if s.cls == .IntReg {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, s.val, s.gp_idx.trunc.[u8]());
            } else if s.cls == .TwoIntRegs {
                let soff = cg_val_off(cg, s.val);
                let r0 = s.gp_idx.trunc.[u8]();
                let r1 = (s.gp_idx +% 1_usize).trunc.[u8]();
                try cg.buf.load_mem(alloc, r0, a64_asm.X29_FP, soff, 8_u8, false, a64_asm.X16);
                if lay.size > 8_usize {
                    try cg.buf.load_mem(alloc, r1, a64_asm.X29_FP, soff +% 8_i32, (lay.size - 8_usize).trunc.[u8](), false, a64_asm.X16);
                } else {
                    try cg.buf.mov_imm64(alloc, r1, 0_u64);
                }
            } else if s.cls == .FloatReg {
                let b: u8 = if env.get(s.ty).u8_val == 64_u8 { 8_u8 } else { 4_u8 };
                let foff = cg_val_off(cg, s.val);
                try cg.buf.load_vec_mem(alloc, s.flt_idx.trunc.[u8](), a64_asm.X29_FP, foff, b, a64_asm.X16);
            } else if s.cls == .ByPtr {
                try cg_val_addr_into(alloc, cg, s.val, s.gp_idx.trunc.[u8]());
            }
        }
        pi = pi +% 1_usize;
    }

    // 3. Hidden sret, closure env, or dyn receiver + indirect target in X9
    if uses_sret {
        let sreg: u8 = if is_c { a64_asm.X8 } else { a64_asm.X0 };
        if dst == eir.EIR_NONE {
            try cg.buf.add_signed_imm(alloc, sreg, a64_asm.SP, stk_bytes.widen.[u64]().bitcast.[i64](), a64_asm.X16);
        } else {
            var sdisp = cg_val_off(cg, dst);
            if rc.kind == .ErrorUnion { sdisp = sdisp +% env.eu_ok_offset(rc.ok_ty).trunc.[i32](); }
            try cg.buf.add_signed_imm(alloc, sreg, a64_asm.X29_FP, sdisp.widen.[i64](), a64_asm.X16);
        }
    }
    if callee.kind == .FnPtr {
        let foff = cg_val_off(cg, callee.a);
        if env_gp_idx < 8_usize {
            try cg.buf.load_mem(alloc, env_gp_idx.trunc.[u8](), a64_asm.X29_FP, foff +% 8_i32, 8_u8, false, a64_asm.X16);
        }
        try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, foff, 8_u8, false, a64_asm.X16);
    } else if callee.kind == .DynCall && args.len > 0_usize {
        let doff = cg_val_off(cg, args[0_usize]);
        if dyn_gp_idx < 8_usize {
            try cg.buf.load_mem(alloc, dyn_gp_idx.trunc.[u8](), a64_asm.X29_FP, doff, 8_u8, false, a64_asm.X16);
        }
        try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, doff +% 8_i32, 8_u8, false, a64_asm.X16);
        try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X9, (callee.b.widen.[usize]() *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
    }

    // 4. Emit BL / BLR
    match callee.kind {
        .DirectFn => { try cg.buf.bl_sym(alloc, try a64_fn_sym_name_id(alloc, cfg_ir.fn_key_top_def(callee.a), eir_prog, interner)); }
        .Method => { try cg.buf.bl_sym(alloc, try a64_fn_sym_name_id(alloc, cfg_ir.fn_key_impl_method(callee.a, callee.b), eir_prog, interner)); }
        .GenericInst => { try cg.buf.bl_sym(alloc, try a64_fn_sym_name_id(alloc, cfg_ir.fn_key_generic_inst(callee.a), eir_prog, interner)); }
        .ExternFn => {
            let ext_sym = callee.b;
            if a64_is_builtin_rt_helper(interner.get(ext_sym)) { try cg_note_helper(alloc, cg, ext_sym); }
            try cg.buf.bl_sym(alloc, ext_sym);
        }
        .DynCall => { try cg.buf.blr(alloc, a64_asm.X9); }
        .FnPtr => { try cg.buf.blr(alloc, a64_asm.X9); }
    }

    // 5. Restore SP (does not touch X0, X1, X8, V0!)
    if aligned_stk > 0_usize {
        try cg.buf.add_signed_imm(alloc, a64_asm.SP, a64_asm.SP, aligned_stk.widen.[u64]().bitcast.[i64](), a64_asm.X16);
    }

    // 6. Capture return value (ErrorUnion uses X8 == 0 Ok / X8 != 0 Err!)
    if dst != eir.EIR_NONE {
        let lay = env.x64_layout(ret_ty);
        match rc.kind {
            .Void => {}
            .IntReg => { try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0); }
            .TwoIntRegs => {
                let doff = cg_val_off(cg, dst);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 8_u8, a64_asm.X16);
                if lay.size > 8_usize {
                    try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 8_i32, a64_asm.X1, (lay.size - 8_usize).trunc.[u8](), a64_asm.X16);
                }
            }
            .FloatReg => { try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8); }
            .Sret => {}
            .ErrorUnion => {
                let l_err = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                let doff = cg_val_off(cg, dst);
                try cg.buf.cbnz_label(alloc, false, a64_asm.X8, l_err);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
                let ok_off = env.eu_ok_offset(rc.ok_ty).trunc.[i32]();
                let ok_lay = env.x64_layout(rc.ok_ty);
                match rc.ok_kind {
                    .Void => {}
                    .IntReg => { try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X0, ok_lay.size.trunc.[u8](), a64_asm.X16); }
                    .TwoIntRegs => {
                        try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X0, 8_u8, a64_asm.X16);
                        if ok_lay.size > 8_usize {
                            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.X1, (ok_lay.size - 8_usize).trunc.[u8](), a64_asm.X16);
                        }
                    }
                    .FloatReg => {
                        let b: u8 = if env.get(rc.ok_ty).u8_val == 64_u8 { 8_u8 } else { 4_u8 };
                        try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, doff +% ok_off, 0_u8, b, a64_asm.X16);
                    }
                    .Sret => {}
                    .ErrorUnion => {}
                }
                try cg.buf.b_label(alloc, l_done);
                cg.buf.bind_label(l_err);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X8, 4_u8, a64_asm.X16);
                cg.buf.bind_label(l_done);
            }
        }
    }
    plan.destroy(alloc);
    return;
}

// ============================================================================
// Section 8: Complete AArch64 Builtin Operations (Arena, Pools, Buf, Atomic,
//            Slice/Array/Str, Math, Vec/NEON, ParReduce, SysIO, Schedule)
// ============================================================================

fn get_arg_slot(arg_slots: *[eir.EirSlot], idx: usize) -> eir.EirSlot {
    if idx < arg_slots.len { return arg_slots[idx]; }
    return eir.EIR_NONE;
}

fn cg_bptr(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], idx: usize, dst: u8) -> !OutOfMemory {
    if idx < args.len {
        try cg_load_ptr_arg(alloc, cg, eir_prog, env, args[idx], get_arg_slot(arg_slots, idx), dst);
    }
    return;
}

fn pool_ncols_ty(env: *types.TypeEnv, elem_ty: types.TyId) -> usize {
    let n = env.get(elem_ty);
    if n.kind == .Pool {
        if let pm = env.get_pool(n.primary) { return pm.columns.len.widen.[usize](); }
    }
    return 0_usize;
}

fn pool_ncols_arg(env: *types.TypeEnv, arg_ty: types.TyId) -> usize {
    var cur = arg_ty;
    let n0 = env.get(cur);
    if n0.kind == .Borrow && n0.borrow_kind == .Single { cur = n0.primary; }
    let n1 = env.get(cur);
    if n1.kind == .Builtin { return env.pool_col_count(env.node_gval_list(&n1)); }
    return 0_usize;
}

fn array_len_arg(eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, v: eir.EirValue) -> u64 {
    var ty = eir_prog.fn_val_ty(fn_id, v);
    let n0 = env.get(ty);
    if n0.kind == .Borrow && n0.borrow_kind == .Single { ty = n0.primary; }
    let n1 = env.get(ty);
    if n1.kind == .Array { return n1.u64_val; }
    return 0_u64;
}

fn cg_emit_builtin_arena(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId) -> !OutOfMemory {
    match op.kind {
        .ArenaInit => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X0);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
            else { try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64); }
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 64_u64);
            try cg_call_alloc_raw(alloc, cg, interner);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
            else { try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64); }
            let l_ok = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cbnz_label(alloc, true, a64_asm.X0, l_ok);
            try cg.buf.cbz_label(alloc, true, a64_asm.X1, l_ok);
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 7_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X2, 4_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_ok);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.X1, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 16_i32, a64_asm.XZR, 8_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .ArenaAlloc => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X0);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
            else { try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64); }
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 16_u64);
            try cg_helper_call(alloc, cg, interner, "eon_arena_alloc_aligned");
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
            else { try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64); }
            let l_ok = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cbnz_label(alloc, true, a64_asm.X0, l_ok);
            try cg.buf.cbz_label(alloc, true, a64_asm.X1, l_ok);
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 7_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X2, 4_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_ok);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.X1, 8_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .ArenaReset => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.store_mem(alloc, a64_asm.X9, 16_i32, a64_asm.XZR, 8_u8, a64_asm.X16);
        }
        .ArenaDestroy => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X2, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            try cg_call_free_raw(alloc, cg, interner);
        }
        .ArenaUsedBytes => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 16_i32, 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .ArenaCapacity => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .AllocCapLiveAllocs => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .AllocCapUsedBytes => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .AllocCapPeakBytes => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 16_i32, 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .AllocCapSubBudget => {
            let doff = cg_val_off(cg, dst);
            try cg_memzero(alloc, cg, a64_asm.X29_FP, doff, 40_usize);
            if args.len > 1_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X0);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 24_i32, a64_asm.X0, 8_u8, a64_asm.X16);
            }
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X0);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 32_i32, a64_asm.X0, 8_u8, a64_asm.X16);
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_arena_pool(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId) -> !OutOfMemory {
    match op.kind {
        .ArenaPoolInit => {
            let pdef = env.get(op.ty0).primary;
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            let ncols = pool_ncols_ty(env, op.ty0);
            try cg_memzero(alloc, cg, a64_asm.X29_FP, doff, env.x64_layout(ret_ty).size);
            if args.len > 1_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X0);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), a64_asm.X0, 8_u8, a64_asm.X16);
            }
            let l_fail = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let esz_r = env.x64_layout_impl(cols[ci].ty, false).size;
                    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X0);
                    if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
                    else { try cg.buf.mov_imm64(alloc, a64_asm.X1, 1_u64); }
                    let l_nz = try cg.buf.new_label(alloc);
                    try cg.buf.cbnz_label(alloc, true, a64_asm.X1, l_nz);
                    try cg.buf.mov_imm64(alloc, a64_asm.X1, 1_u64);
                    cg.buf.bind_label(l_nz);
                    if esz != 1_usize {
                        try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                        try cg.buf.mul_rr(alloc, true, a64_asm.X1, a64_asm.X1, a64_asm.X12);
                    }
                    try cg.buf.mov_imm64(alloc, a64_asm.X2, 64_u64);
                    try cg_helper_call(alloc, cg, interner, "eon_arena_alloc_aligned");
                    try cg.buf.cbz_label(alloc, true, a64_asm.X0, l_fail);
                    try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% (ci *% 8_usize).trunc.[i32](), a64_asm.X0, 8_u8, a64_asm.X16);
                    ci = ci +% 1_usize;
                }
            }
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_fail);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 7_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .ArenaPoolPush => {
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_ty(env, op.ty0);
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_U32).trunc.[i32]();
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            let l_oom = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
            try cg.buf.b_cond_label(alloc, .Cs, l_oom);
            try cg.buf.add_imm(alloc, true, false, a64_asm.X0, a64_asm.X10, 1_u16, false);
            try cg.buf.store_mem(alloc, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), a64_asm.X0, 8_u8, a64_asm.X16);
            if args.len > 1_usize {
                let row_v = args[1_usize];
                let row_off = cg_val_off(cg, row_v);
                let row_ty = eir_prog.fn_val_ty(cg.fn_id, row_v);
                if let pm = env.get_pool(pdef) {
                    let cols = env.pool_cols_range(pm.columns);
                    var ci: usize = 0_usize;
                    while ci < cols.len {
                        let foff = env.struct_field_offset(row_ty, ci).offset;
                        let esz_r = env.x64_layout_impl(cols[ci].ty, false).size;
                        let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                        try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, (ci *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
                        try cg.buf.mov_rr(alloc, a64_asm.X12, a64_asm.X10);
                        if esz != 1_usize {
                            try cg.buf.mov_imm64(alloc, a64_asm.X0, esz.widen.[u64]());
                            try cg.buf.mul_rr(alloc, true, a64_asm.X12, a64_asm.X12, a64_asm.X0);
                        }
                        try cg.buf.add_rr(alloc, true, false, a64_asm.X11, a64_asm.X11, a64_asm.X12);
                        try cg_copy_mem(alloc, cg, a64_asm.X11, 0_i32, a64_asm.X29_FP, row_off +% foff.trunc.[i32](), esz);
                        ci = ci +% 1_usize;
                    }
                }
            }
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X10, 4_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_oom);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 7_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0xFFFFFFFF_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X0, 4_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .ArenaPoolIdAt => {
            let ncols = if args.len > 0_usize { pool_ncols_arg(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_U32).trunc.[i32]();
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10); }
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            let l_oob = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
            try cg.buf.b_cond_label(alloc, .Cs, l_oob);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X10, 4_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 4_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0xFFFFFFFF_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X0, 4_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .ArenaPoolReset => {
            let ncols = pool_ncols_ty(env, op.ty0);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.store_mem(alloc, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), a64_asm.XZR, 8_u8, a64_asm.X16);
            if dst != eir.EIR_NONE { try cg_load_val_from_mem(alloc, cg, env, dst, a64_asm.X9, 0_i32, ret_ty); }
        }
        .ArenaPoolLen => {
            let ncols = if args.len > 0_usize { pool_ncols_arg(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        _ => {}
    }
    return;
}

fn cg_slot_pool_validate_gid(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, ncols: usize, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], l_stale: u32) -> !OutOfMemory {
    // Leaves pool_ptr in X9, idx in X10, gen in X11, &gen[idx] in X12
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
    if args.len > 1_usize {
        let loc = cg_val_loc(cg, args[1_usize]);
        if loc.kind == .Reg {
            try cg.buf.uxt(alloc, a64_asm.X10, loc.reg, 4_u8);
            try cg.buf.lsr_imm(alloc, true, a64_asm.X11, loc.reg, 32_u8);
        } else {
            try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X29_FP, loc.stack_off, 4_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X29_FP, loc.stack_off +% 4_i32, 4_u8, false, a64_asm.X16);
        }
    }
    try cg.buf.cbz_label(alloc, false, a64_asm.X11, l_stale);
    try cg.buf.mov_imm64(alloc, a64_asm.X0, 1_u64);
    try cg.buf.tst_rr(alloc, false, a64_asm.X11, a64_asm.X0);
    try cg.buf.b_cond_label(alloc, .Eq, l_stale);
    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
    try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X0);
    try cg.buf.b_cond_label(alloc, .Cs, l_stale);
    try cg.buf.load_mem(alloc, a64_asm.X12, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
    try cg.buf.add_rr_lsl(alloc, true, a64_asm.X12, a64_asm.X12, a64_asm.X10, 2_u8);
    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X12, 0_i32, 4_u8, false, a64_asm.X16);
    try cg.buf.cmp_rr(alloc, false, a64_asm.X0, a64_asm.X11);
    try cg.buf.b_cond_label(alloc, .Ne, l_stale);
    return;
}

fn cg_emit_slot_pool_grow(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, pdef: u32, ncols: usize, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], l_oom: u32) -> !OutOfMemory {
    let tmp = cg.frame.temp_off;
    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
    try cg.buf.store_mem(alloc, a64_asm.X29_FP, tmp, a64_asm.X0, 8_u8, a64_asm.X16); // old_cap
    try cg.buf.lsl_imm(alloc, true, a64_asm.X0, a64_asm.X0, 1_u8);
    let l_nz = try cg.buf.new_label(alloc);
    try cg.buf.cbnz_label(alloc, true, a64_asm.X0, l_nz);
    try cg.buf.mov_imm64(alloc, a64_asm.X0, 4_u64);
    cg.buf.bind_label(l_nz);
    try cg.buf.store_mem(alloc, a64_asm.X29_FP, tmp +% 8_i32, a64_asm.X0, 8_u8, a64_asm.X16); // new_cap

    // Grow gen array
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
    try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, tmp +% 8_i32, 8_u8, false, a64_asm.X16);
    try cg.buf.lsl_imm(alloc, true, a64_asm.X1, a64_asm.X1, 2_u8);
    try cg.buf.mov_imm64(alloc, a64_asm.X2, 4_u64);
    try cg_call_alloc_raw(alloc, cg, interner);
    try cg.buf.cbz_label(alloc, true, a64_asm.X0, l_oom);
    try cg.buf.store_mem(alloc, a64_asm.X29_FP, tmp +% 16_i32, a64_asm.X0, 8_u8, a64_asm.X16);
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
    try cg.buf.mov_rr(alloc, a64_asm.X10, a64_asm.X0);
    try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
    try cg.buf.load_mem(alloc, a64_asm.X12, a64_asm.X29_FP, tmp, 8_u8, false, a64_asm.X16);
    try cg.buf.lsl_imm(alloc, true, a64_asm.X12, a64_asm.X12, 2_u8);
    try cg_copy_mem_dyn(alloc, cg, a64_asm.X10, a64_asm.X11, a64_asm.X12);
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
    try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
    try cg.buf.load_mem(alloc, a64_asm.X2, a64_asm.X29_FP, tmp, 8_u8, false, a64_asm.X16);
    try cg.buf.lsl_imm(alloc, true, a64_asm.X2, a64_asm.X2, 2_u8);
    try cg_call_free_raw(alloc, cg, interner);
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, tmp +% 16_i32, 8_u8, false, a64_asm.X16);
    try cg.buf.store_mem(alloc, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), a64_asm.X0, 8_u8, a64_asm.X16);

    // Grow free_stack
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
    try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, tmp +% 8_i32, 8_u8, false, a64_asm.X16);
    try cg.buf.lsl_imm(alloc, true, a64_asm.X1, a64_asm.X1, 2_u8);
    try cg.buf.mov_imm64(alloc, a64_asm.X2, 4_u64);
    try cg_call_alloc_raw(alloc, cg, interner);
    try cg.buf.cbz_label(alloc, true, a64_asm.X0, l_oom);
    try cg.buf.store_mem(alloc, a64_asm.X29_FP, tmp +% 16_i32, a64_asm.X0, 8_u8, a64_asm.X16);
    try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X29_FP, tmp, 8_u8, false, a64_asm.X16);
    try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X29_FP, tmp +% 8_i32, 8_u8, false, a64_asm.X16);
    let l_fk = try cg.buf.new_label(alloc);
    let l_fk_end = try cg.buf.new_label(alloc);
    cg.buf.bind_label(l_fk);
    try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
    try cg.buf.b_cond_label(alloc, .Cs, l_fk_end);
    try cg.buf.sub_imm(alloc, true, false, a64_asm.X12, a64_asm.X11, 1_u16, false);
    try cg.buf.sub_rr(alloc, true, false, a64_asm.X12, a64_asm.X12, a64_asm.X10);
    try cg.buf.add_rr_lsl(alloc, true, a64_asm.X12, a64_asm.X0, a64_asm.X12, 2_u8);
    try cg.buf.store_mem(alloc, a64_asm.X12, 0_i32, a64_asm.X10, 4_u8, a64_asm.X16);
    try cg.buf.add_imm(alloc, true, false, a64_asm.X10, a64_asm.X10, 1_u16, false);
    try cg.buf.b_label(alloc, l_fk);
    cg.buf.bind_label(l_fk_end);
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
    try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
    try cg.buf.load_mem(alloc, a64_asm.X2, a64_asm.X29_FP, tmp, 8_u8, false, a64_asm.X16);
    try cg.buf.lsl_imm(alloc, true, a64_asm.X2, a64_asm.X2, 2_u8);
    try cg_call_free_raw(alloc, cg, interner);
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, tmp +% 16_i32, 8_u8, false, a64_asm.X16);
    try cg.buf.store_mem(alloc, a64_asm.X9, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), a64_asm.X0, 8_u8, a64_asm.X16);

    // Grow columns
    if let pm = env.get_pool(pdef) {
        let cols = env.pool_cols_range(pm.columns);
        var ci: usize = 0_usize;
        while ci < cols.len {
            let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, tmp +% 8_i32, 8_u8, false, a64_asm.X16);
            if esz != 1_usize {
                try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                try cg.buf.mul_rr(alloc, true, a64_asm.X1, a64_asm.X1, a64_asm.X12);
            }
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 64_u64);
            try cg_call_alloc_raw(alloc, cg, interner);
            try cg.buf.cbz_label(alloc, true, a64_asm.X0, l_oom);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, tmp +% 16_i32, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.mov_rr(alloc, a64_asm.X10, a64_asm.X0);
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, (ci *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X12, a64_asm.X29_FP, tmp, 8_u8, false, a64_asm.X16);
            if esz != 1_usize {
                try cg.buf.mov_imm64(alloc, a64_asm.X13, esz.widen.[u64]());
                try cg.buf.mul_rr(alloc, true, a64_asm.X12, a64_asm.X12, a64_asm.X13);
            }
            try cg_copy_mem_dyn(alloc, cg, a64_asm.X10, a64_asm.X11, a64_asm.X12);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, (ci *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X2, a64_asm.X29_FP, tmp, 8_u8, false, a64_asm.X16);
            if esz != 1_usize {
                try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                try cg.buf.mul_rr(alloc, true, a64_asm.X2, a64_asm.X2, a64_asm.X12);
            }
            try cg_call_free_raw(alloc, cg, interner);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, tmp +% 16_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X9, (ci *% 8_usize).trunc.[i32](), a64_asm.X0, 8_u8, a64_asm.X16);
            ci = ci +% 1_usize;
        }
    }
    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, tmp +% 8_i32, 8_u8, false, a64_asm.X16);
    try cg.buf.store_mem(alloc, a64_asm.X9, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), a64_asm.X0, 8_u8, a64_asm.X16);
    try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, tmp, 8_u8, false, a64_asm.X16);
    try cg.buf.sub_rr(alloc, true, false, a64_asm.X10, a64_asm.X0, a64_asm.X1);
    try cg.buf.store_mem(alloc, a64_asm.X9, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), a64_asm.X10, 8_u8, a64_asm.X16);
    return;
}

fn cg_emit_builtin_slot_pool(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId) -> !OutOfMemory {
    match op.kind {
        .SlotPoolInit => {
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_ty(env, op.ty0);
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            let tmp = cg.frame.temp_off;
            try cg_memzero(alloc, cg, a64_asm.X29_FP, doff, env.x64_layout(ret_ty).size);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X0); }
            else { try cg.buf.mov_imm64(alloc, a64_asm.X0, 4_u64); }
            let l_nz = try cg.buf.new_label(alloc);
            try cg.buf.cbnz_label(alloc, true, a64_asm.X0, l_nz);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 4_u64);
            cg.buf.bind_label(l_nz);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, tmp, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), a64_asm.X0, 8_u8, a64_asm.X16);
            let l_fail = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
