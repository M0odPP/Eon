            let ncols = if args.len > 0_usize { pool_ncols_arg(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .SlotPoolIsAlive => {
            let ncols = pool_ncols_ty(env, op.ty0);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10); }
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            let l_false = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
            try cg.buf.b_cond_label(alloc, .Cs, l_false);
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            try cg.buf.add_rr_lsl(alloc, true, a64_asm.X11, a64_asm.X11, a64_asm.X10, 2_u8);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X11, 0_i32, 4_u8, false, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X1, 1_u64);
            try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_false);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
            cg.buf.bind_label(l_done);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .SlotPoolIdAt => {
            let ncols = pool_ncols_ty(env, op.ty0);
            let doff = cg_val_off(cg, dst);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10); }
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            try cg.buf.add_rr_lsl(alloc, true, a64_asm.X11, a64_asm.X11, a64_asm.X10, 2_u8);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X11, 0_i32, 4_u8, false, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X10, 4_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 4_i32, a64_asm.X0, 4_u8, a64_asm.X16);
        }
        .SlotPoolDestroy => {
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_ty(env, op.ty0);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
                    try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
                    try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, (ci *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
                    try cg.buf.mov_imm64(alloc, a64_asm.X2, 0_u64);
                    try cg_call_free_raw(alloc, cg, interner);
                    ci = ci +% 1_usize;
                }
            }
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, (ncols *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 0_u64);
            try cg_call_free_raw(alloc, cg, interner);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), 8_u8, false, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 0_u64);
            try cg_call_free_raw(alloc, cg, interner);
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_buf(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId) -> !OutOfMemory {
    let elay = env.x64_layout(op.ty0);
    let esz = if elay.size == 0_usize { 1_usize } else { elay.size };
    let ealign = if elay.align == 0_usize { 1_usize } else { elay.align };
    match op.kind {
        .BufInit => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X0);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
            else { try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64); }
            if esz != 1_usize {
                try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                try cg.buf.mul_rr(alloc, true, a64_asm.X1, a64_asm.X1, a64_asm.X12);
            }
            try cg.buf.mov_imm64(alloc, a64_asm.X2, ealign.widen.[u64]());
            try cg_call_alloc_raw(alloc, cg, interner);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
            else { try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64); }
            let l_ok = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cbnz_label(alloc, true, a64_asm.X0, l_ok);
            try cg.buf.cbz_label(alloc, true, a64_asm.X1, l_ok);
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 7_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X2, 4_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_ok);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.XZR, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 16_i32, a64_asm.X1, 8_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .BufPush => {
            let doff = cg_val_off(cg, dst);
            let val_arg = if args.len >= 3_usize { args[2_usize] } else if args.len > 1_usize { args[1_usize] } else { 0_u32 };
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, 16_i32, 8_u8, false, a64_asm.X16);
            let l_full = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
            try cg.buf.b_cond_label(alloc, .Cs, l_full);
            try cg.buf.add_imm(alloc, true, false, a64_asm.X0, a64_asm.X10, 1_u16, false);
            try cg.buf.store_mem(alloc, a64_asm.X9, 8_i32, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            if esz != 1_usize {
                try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X12);
            }
            try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
            try cg_store_val_to_mem(alloc, cg, env, a64_asm.X9, 0_i32, val_arg, op.ty0);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_full);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 7_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .BufPushSlice => {
            let doff = cg_val_off(cg, dst);
            let slice_arg = if args.len >= 3_usize { args[2_usize] } else if args.len > 1_usize { args[1_usize] } else { 0_u32 };
            let soff = cg_val_off(cg, slice_arg);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, 16_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X12, a64_asm.X29_FP, soff +% 8_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.sub_rr(alloc, true, false, a64_asm.X0, a64_asm.X11, a64_asm.X10);
            let l_full = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X12);
            try cg.buf.b_cond_label(alloc, .Cc, l_full);
            try cg.buf.add_rr(alloc, true, false, a64_asm.X0, a64_asm.X10, a64_asm.X12);
            try cg.buf.store_mem(alloc, a64_asm.X9, 8_i32, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            if esz != 1_usize {
                try cg.buf.mov_imm64(alloc, a64_asm.X13, esz.widen.[u64]());
                try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X13);
                try cg.buf.mul_rr(alloc, true, a64_asm.X12, a64_asm.X12, a64_asm.X13);
            }
            try cg.buf.add_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X10);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, soff, 8_u8, false, a64_asm.X16);
            try cg_copy_mem_dyn(alloc, cg, a64_asm.X0, a64_asm.X1, a64_asm.X12);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_full);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 7_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .BufPop => {
            let doff = cg_val_off(cg, dst);
            let voff = env.opt_val_offset(op.ty0).trunc.[i32]();
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            let l_empty = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cbz_label(alloc, true, a64_asm.X10, l_empty);
            try cg.buf.sub_imm(alloc, true, false, a64_asm.X10, a64_asm.X10, 1_u16, false);
            try cg.buf.store_mem(alloc, a64_asm.X9, 8_i32, a64_asm.X10, 8_u8, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            if esz != 1_usize {
                try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X12);
            }
            try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
            if env.opt_niche(op.ty0).kind != .None {
                try cg_load_val_from_mem(alloc, cg, env, dst, a64_asm.X9, 0_i32, op.ty0);
            } else {
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 1_u64);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 1_u8, a64_asm.X16);
                try cg_copy_mem(alloc, cg, a64_asm.X29_FP, doff +% voff, a64_asm.X9, 0_i32, esz);
            }
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_empty);
            try cg_emit_opt_null(alloc, cg, eir_prog, env, dst, ret_ty);
            cg.buf.bind_label(l_done);
        }
        .BufLen => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .BufCap => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 16_i32, 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .BufClear => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.store_mem(alloc, a64_asm.X9, 8_i32, a64_asm.XZR, 8_u8, a64_asm.X16);
        }
        .BufAsSlice => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            let doff = cg_val_off(cg, dst);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 8_i32, a64_asm.X1, 8_u8, a64_asm.X16);
        }
        .BufAt => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_USIZE).trunc.[i32]();
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10); }
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            let l_oob = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
            try cg.buf.b_cond_label(alloc, .Cs, l_oob);
            try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            if esz != 1_usize {
                try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X12);
            }
            try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X9, 8_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 4_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.XZR, 8_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .BufGet => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10); }
            try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            let l_oob = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
            try cg.buf.b_cond_label(alloc, .Cs, l_oob);
            try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            if esz != 1_usize {
                try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X12);
            }
            try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X9);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            cg.buf.bind_label(l_done);
        }
        .BufSub => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X12, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10); }
            if args.len > 2_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], a64_asm.X11); }
            let l_oob = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
            try cg.buf.b_cond_label(alloc, .Hi, l_oob);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X11, a64_asm.X12);
            try cg.buf.b_cond_label(alloc, .Hi, l_oob);
            try cg.buf.sub_rr(alloc, true, false, a64_asm.X11, a64_asm.X11, a64_asm.X10);
            if esz != 1_usize {
                try cg.buf.mov_imm64(alloc, a64_asm.X0, esz.widen.[u64]());
                try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X0);
            }
            try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X9, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.X11, 8_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 4_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.XZR, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.XZR, 8_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .BufDestroy => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, a64_asm.X0);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X2, a64_asm.X9, 16_i32, 8_u8, false, a64_asm.X16);
            try cg_call_free_raw(alloc, cg, interner);
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_atomic_mmio(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot]) -> !OutOfMemory {
    let raw_sz = env.x64_layout(op.ty0).size;
    let sz: u8 = if raw_sz <= 1_usize { 1_u8 } else if raw_sz <= 2_usize { 2_u8 } else if raw_sz <= 4_usize { 4_u8 } else { 8_u8 };
    let is64 = sz == 8_u8;
    match op.kind {
        .AtomicNew => {
            if args.len > 0_usize {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], a64_asm.X0);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            }
        }
        .AtomicLoad => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.ldar(alloc, sz, a64_asm.X0, a64_asm.X9);
            if env.is_signed_int(op.ty0) && sz < 8_u8 { try cg.buf.sxt(alloc, a64_asm.X0, a64_asm.X0, sz); }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .AtomicStore => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X0); }
            try cg.buf.stlr(alloc, sz, a64_asm.X0, a64_asm.X9);
        }
        .AtomicFetchAdd => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
            let l_r = try cg.buf.new_label(alloc);
            cg.buf.bind_label(l_r);
            try cg.buf.ldaxr(alloc, sz, a64_asm.X0, a64_asm.X9);
            try cg.buf.add_rr(alloc, is64, false, a64_asm.X2, a64_asm.X0, a64_asm.X1);
            try cg.buf.stlxr(alloc, sz, a64_asm.X3, a64_asm.X2, a64_asm.X9);
            try cg.buf.cbnz_label(alloc, false, a64_asm.X3, l_r);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .AtomicFetchSub => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
            let l_r = try cg.buf.new_label(alloc);
            cg.buf.bind_label(l_r);
            try cg.buf.ldaxr(alloc, sz, a64_asm.X0, a64_asm.X9);
            try cg.buf.sub_rr(alloc, is64, false, a64_asm.X2, a64_asm.X0, a64_asm.X1);
            try cg.buf.stlxr(alloc, sz, a64_asm.X3, a64_asm.X2, a64_asm.X9);
            try cg.buf.cbnz_label(alloc, false, a64_asm.X3, l_r);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .AtomicSwap => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
            let l_r = try cg.buf.new_label(alloc);
            cg.buf.bind_label(l_r);
            try cg.buf.ldaxr(alloc, sz, a64_asm.X0, a64_asm.X9);
            try cg.buf.stlxr(alloc, sz, a64_asm.X3, a64_asm.X1, a64_asm.X9);
            try cg.buf.cbnz_label(alloc, false, a64_asm.X3, l_r);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .AtomicCas => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X1); }
            if args.len > 2_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[2_usize], a64_asm.X2); }
            if sz < 8_u8 { try cg.buf.uxt(alloc, a64_asm.X1, a64_asm.X1, sz); }
            let l_r = try cg.buf.new_label(alloc);
            let l_fail = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            cg.buf.bind_label(l_r);
            try cg.buf.ldaxr(alloc, sz, a64_asm.X0, a64_asm.X9);
            try cg.buf.cmp_rr(alloc, is64, a64_asm.X0, a64_asm.X1);
            try cg.buf.b_cond_label(alloc, .Ne, l_fail);
            try cg.buf.stlxr(alloc, sz, a64_asm.X3, a64_asm.X2, a64_asm.X9);
            try cg.buf.cbnz_label(alloc, false, a64_asm.X3, l_r);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 1_u64);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_fail);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
            cg.buf.bind_label(l_done);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .MmioRead => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, sz, env.is_signed_int(op.ty0), a64_asm.X16);
            try cg.buf.dmb_ish(alloc);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .MmioWrite => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X0); }
            try cg.buf.dmb_ish(alloc);
            try cg.buf.store_mem(alloc, a64_asm.X9, 0_i32, a64_asm.X0, sz, a64_asm.X16);
        }
        .RawPtrFromUsize => {
            if args.len > 0_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[0_usize], a64_asm.X0);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            }
        }
        .RawPtrAsUsize => {
            if args.len > 0_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[0_usize], a64_asm.X0);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            }
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_slice_array(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId) -> !OutOfMemory {
    let raw_esz = env.x64_layout(op.ty0).size;
    let esz = if raw_esz == 0_usize { 1_usize } else { raw_esz };
    match op.kind {
        .SliceLen => {
            if args.len > 0_usize {
                let loff = cg_val_off(cg, args[0_usize]) +% 8_i32;
                try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, loff, 8_u8, false, a64_asm.X16);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            }
        }
        .StrLen => {
            if args.len > 0_usize {
                let loff = cg_val_off(cg, args[0_usize]) +% 8_i32;
                try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, loff, 8_u8, false, a64_asm.X16);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            }
        }
        .ArrayLen => {
            let alen = if args.len > 0_usize { array_len_arg(eir_prog, cg.fn_id, env, args[0_usize]) } else { 0_u64 };
            try cg.buf.mov_imm64(alloc, a64_asm.X0, alen);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .StrAsBytes => {
            if args.len > 0_usize { try cg_copy_val_to_val(alloc, cg, eir_prog, env, dst, args[0_usize]); }
        }
        .BytesAsStr => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            if args.len > 0_usize {
                let soff = cg_val_off(cg, args[0_usize]);
                try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, soff, 8_u8, false, a64_asm.X16);
                try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, soff +% 8_i32, 8_u8, false, a64_asm.X16);
                try cg_helper_call(alloc, cg, interner, "eon_rt_validate_utf8");
                let l_err = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cbz_label(alloc, true, a64_asm.X0, l_err);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
                try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, soff, 8_u8, false, a64_asm.X16);
                try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X29_FP, soff +% 8_i32, 8_u8, false, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X9, 8_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.X10, 8_u8, a64_asm.X16);
                try cg.buf.b_label(alloc, l_done);
                cg.buf.bind_label(l_err);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 5_u64);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.XZR, 8_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.XZR, 8_u8, a64_asm.X16);
                cg.buf.bind_label(l_done);
            }
        }
        .SliceAt => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_USIZE).trunc.[i32]();
            if args.len > 1_usize {
                let soff = cg_val_off(cg, args[0_usize]);
                try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, soff, 8_u8, false, a64_asm.X16);
                try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X29_FP, soff +% 8_i32, 8_u8, false, a64_asm.X16);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
                try cg.buf.b_cond_label(alloc, .Cs, l_oob);
                if esz != 1_usize {
                    try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                    try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X12);
                }
                try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X9, 8_u8, a64_asm.X16);
                try cg.buf.b_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 4_u64);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.XZR, 8_u8, a64_asm.X16);
                cg.buf.bind_label(l_done);
            }
        }
        .ArrayAt => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_USIZE).trunc.[i32]();
            if args.len > 1_usize {
                let alen = array_len_arg(eir_prog, cg.fn_id, env, args[0_usize]);
                try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10);
                try cg.buf.mov_imm64(alloc, a64_asm.X11, alen);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
                try cg.buf.b_cond_label(alloc, .Cs, l_oob);
                if esz != 1_usize {
                    try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                    try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X12);
                }
                try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X9, 8_u8, a64_asm.X16);
                try cg.buf.b_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 4_u64);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.XZR, 8_u8, a64_asm.X16);
                cg.buf.bind_label(l_done);
            }
        }
        .SliceGet => {
            if args.len > 1_usize {
                let soff = cg_val_off(cg, args[0_usize]);
                try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, soff, 8_u8, false, a64_asm.X16);
                try cg.buf.load_mem(alloc, a64_asm.X11, a64_asm.X29_FP, soff +% 8_i32, 8_u8, false, a64_asm.X16);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
                try cg.buf.b_cond_label(alloc, .Cs, l_oob);
                if esz != 1_usize {
                    try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                    try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X12);
                }
                try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X9);
                try cg.buf.b_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
                cg.buf.bind_label(l_done);
            }
        }
        .ArrayGet => {
            if args.len > 1_usize {
                let alen = array_len_arg(eir_prog, cg.fn_id, env, args[0_usize]);
                try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10);
                try cg.buf.mov_imm64(alloc, a64_asm.X11, alen);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
                try cg.buf.b_cond_label(alloc, .Cs, l_oob);
                if esz != 1_usize {
                    try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                    try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X12);
                }
                try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X9);
                try cg.buf.b_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
                cg.buf.bind_label(l_done);
            }
        }
        .SliceSub => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            if args.len > 2_usize {
                let soff = cg_val_off(cg, args[0_usize]);
                try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, soff, 8_u8, false, a64_asm.X16);
                try cg.buf.load_mem(alloc, a64_asm.X12, a64_asm.X29_FP, soff +% 8_i32, 8_u8, false, a64_asm.X16);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], a64_asm.X11);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
                try cg.buf.b_cond_label(alloc, .Hi, l_oob);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X11, a64_asm.X12);
                try cg.buf.b_cond_label(alloc, .Hi, l_oob);
                try cg.buf.sub_rr(alloc, true, false, a64_asm.X11, a64_asm.X11, a64_asm.X10);
                if esz != 1_usize {
                    try cg.buf.mov_imm64(alloc, a64_asm.X0, esz.widen.[u64]());
                    try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X0);
                }
                try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X9, 8_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.X11, 8_u8, a64_asm.X16);
                try cg.buf.b_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 4_u64);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.XZR, 8_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.XZR, 8_u8, a64_asm.X16);
                cg.buf.bind_label(l_done);
            }
        }
        .ArraySub => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            if args.len > 2_usize {
                let alen = array_len_arg(eir_prog, cg.fn_id, env, args[0_usize]);
                try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
                try cg.buf.mov_imm64(alloc, a64_asm.X12, alen);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X10);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], a64_asm.X11);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X10, a64_asm.X11);
                try cg.buf.b_cond_label(alloc, .Hi, l_oob);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X11, a64_asm.X12);
                try cg.buf.b_cond_label(alloc, .Hi, l_oob);
                try cg.buf.sub_rr(alloc, true, false, a64_asm.X11, a64_asm.X11, a64_asm.X10);
                if esz != 1_usize {
                    try cg.buf.mov_imm64(alloc, a64_asm.X0, esz.widen.[u64]());
                    try cg.buf.mul_rr(alloc, true, a64_asm.X10, a64_asm.X10, a64_asm.X0);
                }
                try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.X9, 8_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.X11, 8_u8, a64_asm.X16);
                try cg.buf.b_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 4_u64);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off, a64_asm.XZR, 8_u8, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ok_off +% 8_i32, a64_asm.XZR, 8_u8, a64_asm.X16);
                cg.buf.bind_label(l_done);
            }
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_math(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue]) -> !OutOfMemory {
    if args.len == 0_usize { return; }
    let aty = eir_prog.fn_val_ty(cg.fn_id, args[0_usize]);
    let an = env.get(aty);
    let is_f64 = an.kind == .Float && an.u8_val == 64_u8;
    let bytes = env.x64_layout(aty).size.trunc.[u8]();
    match op.kind {
        .MathSqrt => {
            try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[0_usize], 0_u8);
            try cg.buf.fsqrt_s(alloc, is_f64, 0_u8, 0_u8);
            try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8);
        }
        .MathFma => {
            if args.len >= 3_usize {
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[0_usize], 0_u8);
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[1_usize], 1_u8);
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[2_usize], 2_u8);
                try cg.buf.fmadd_s(alloc, is_f64, 0_u8, 0_u8, 1_u8, 2_u8);
                try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8);
            }
        }
        .MathLzcnt => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], a64_asm.X0);
            if bytes == 8_u8 {
                try cg.buf.clz(alloc, true, a64_asm.X0, a64_asm.X0);
            } else if bytes == 4_u8 {
                try cg.buf.clz(alloc, false, a64_asm.X0, a64_asm.X0);
            } else {
                try cg.buf.uxt(alloc, a64_asm.X0, a64_asm.X0, bytes);
                try cg.buf.clz(alloc, false, a64_asm.X0, a64_asm.X0);
                try cg.buf.sub_imm(alloc, false, false, a64_asm.X0, a64_asm.X0, (32_u8 -% (bytes *% 8_u8)).widen.[u16](), false);
            }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .MathTzcnt => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], a64_asm.X0);
            if bytes == 8_u8 {
                try cg.buf.rbit(alloc, true, a64_asm.X0, a64_asm.X0);
                try cg.buf.clz(alloc, true, a64_asm.X0, a64_asm.X0);
            } else {
                if bytes < 4_u8 {
                    let hi_bit = 1_u64 <<% (bytes *% 8_u8).widen.[u64]();
                    try cg.buf.uxt(alloc, a64_asm.X0, a64_asm.X0, bytes);
                    try cg.buf.mov_imm64(alloc, a64_asm.X1, hi_bit);
                    try cg.buf.orr_rr(alloc, false, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                }
                try cg.buf.rbit(alloc, false, a64_asm.X0, a64_asm.X0);
                try cg.buf.clz(alloc, false, a64_asm.X0, a64_asm.X0);
            }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .MathPopcnt => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], a64_asm.X0);
            if bytes < 8_u8 { try cg.buf.uxt(alloc, a64_asm.X0, a64_asm.X0, bytes); }
            try cg.buf.fmov_gpr_to_fp(alloc, true, 0_u8, a64_asm.X0);
            try cg.buf.vcnt_8b(alloc, 0_u8, 0_u8);
            try cg.buf.vaddv_8b(alloc, 0_u8, 0_u8);
            try cg.buf.fmov_fp_to_gpr(alloc, false, a64_asm.X0, 0_u8);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .MathBswap => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], a64_asm.X0);
            if bytes == 2_u8 { try cg.buf.rev16(alloc, false, a64_asm.X0, a64_asm.X0); try cg.buf.uxt(alloc, a64_asm.X0, a64_asm.X0, 2_u8); }
            else if bytes == 4_u8 { try cg.buf.rev(alloc, false, a64_asm.X0, a64_asm.X0); }
            else if bytes == 8_u8 { try cg.buf.rev(alloc, true, a64_asm.X0, a64_asm.X0); }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_vec(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue]) -> !OutOfMemory {
    match op.kind {
        .VecSplat => {
            if args.len == 0_usize { return; }
            let vn = env.get(op.ty0);
            let elem = vn.primary;
            let lanes = vn.u8_val.widen.[usize]();
            let esz_r = env.x64_layout(elem).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            let doff = cg_val_off(cg, dst);
            let en = env.get(elem);
            if en.kind == .Float && en.u8_val != 16_u8 {
                let b: u8 = if en.u8_val == 64_u8 { 8_u8 } else { 4_u8 };
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[0_usize], 0_u8);
                var li: usize = 0_usize;
                while li < lanes {
                    try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, doff +% (li *% esz).trunc.[i32](), 0_u8, b, a64_asm.X16);
                    li = li +% 1_usize;
                }
            } else {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], a64_asm.X0);
                var li: usize = 0_usize;
                while li < lanes {
                    try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% (li *% esz).trunc.[i32](), a64_asm.X0, esz.trunc.[u8](), a64_asm.X16);
                    li = li +% 1_usize;
                }
            }
        }
        .VecLen => {
            try cg.buf.mov_imm64(alloc, a64_asm.X0, op.len_u8.widen.[u64]());
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .VecCmp => {
            if args.len < 2_usize { return; }
            let vn = env.get(op.ty0);
            if vn.kind != .Vec { return; }
            let elem = vn.primary;
            let lanes = vn.u8_val.widen.[usize]();
            let esz_r = env.x64_layout(elem).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            let en = env.get(elem);
            let sgn = env.is_signed_int(elem);
            let aoff = cg_val_off(cg, args[0_usize]);
            let boff = cg_val_off(cg, args[1_usize]);
            let doff = cg_val_off(cg, dst);
            var li: usize = 0_usize;
            while li < lanes {
                let ao = aoff +% (li *% esz).trunc.[i32]();
                let bo = boff +% (li *% esz).trunc.[i32]();
                if en.kind == .Float {
                    let is_f16 = en.u8_val == 16_u8;
                    let is_f64 = en.u8_val == 64_u8;
                    if is_f16 {
                        try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, bo, 2_u8, false, a64_asm.X16);
                        try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
                        try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, cg.frame.temp_off, 0_u8, 4_u8, a64_asm.X16);
                        try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, ao, 2_u8, false, a64_asm.X16);
                        try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
                        try cg.buf.load_vec_mem(alloc, 1_u8, a64_asm.X29_FP, cg.frame.temp_off, 4_u8, a64_asm.X16);
                    } else {
                        let b: u8 = if is_f64 { 8_u8 } else { 4_u8 };
                        try cg.buf.load_vec_mem(alloc, 0_u8, a64_asm.X29_FP, ao, b, a64_asm.X16);
                        try cg.buf.load_vec_mem(alloc, 1_u8, a64_asm.X29_FP, bo, b, a64_asm.X16);
                    }
                    try cg.buf.fcmp_s(alloc, !is_f16 && is_f64, 0_u8, 1_u8);
                    let cc: a64_asm.A64Cond = match op.bin_op {
                        .Eq => .Eq, .NotEq => .Ne, .Lt => .Mi, .LtEq => .Ls, .Gt => .Gt, _ => .Ge,
                    };
                    try cg.buf.cset(alloc, true, a64_asm.X0, cc);
                } else {
                    let b = esz.trunc.[u8]();
                    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, ao, b, sgn, a64_asm.X16);
                    try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, bo, b, sgn, a64_asm.X16);
                    try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1);
                    var cc: a64_asm.A64Cond = if sgn { .Ge } else { .Cs };
                    if op.bin_op == .Eq { cc = .Eq; }
                    else if op.bin_op == .NotEq { cc = .Ne; }
                    else if op.bin_op == .Lt { cc = if sgn { .Lt } else { .Cc }; }
                    else if op.bin_op == .LtEq { cc = if sgn { .Le } else { .Ls }; }
                    else if op.bin_op == .Gt { cc = if sgn { .Gt } else { .Hi }; }
                    try cg.buf.cset(alloc, true, a64_asm.X0, cc);
                }
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% li.trunc.[i32](), a64_asm.X0, 1_u8, a64_asm.X16);
                li = li +% 1_usize;
            }
        }
        .VecMaskAny => {
            if args.len == 0_usize { return; }
            let lanes = op.len_u8.widen.[usize]();
            let aoff = cg_val_off(cg, args[0_usize]);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
            var li: usize = 0_usize;
            while li < lanes {
                try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, aoff +% li.trunc.[i32](), 1_u8, false, a64_asm.X16);
                try cg.buf.orr_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                li = li +% 1_usize;
            }
            try cg.buf.cmp_imm(alloc, true, a64_asm.X0, 0_u16);
            try cg.buf.cset(alloc, true, a64_asm.X0, .Ne);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .VecMaskAll => {
            if args.len == 0_usize { return; }
            let lanes = op.len_u8.widen.[usize]();
            let aoff = cg_val_off(cg, args[0_usize]);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 1_u64);
            var li: usize = 0_usize;
            while li < lanes {
                try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, aoff +% li.trunc.[i32](), 1_u8, false, a64_asm.X16);
                try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                li = li +% 1_usize;
            }
            try cg.buf.mov_imm64(alloc, a64_asm.X1, 1_u64);
            try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .VecBitmask => {
            if args.len == 0_usize { return; }
            let lanes = op.len_u8.widen.[usize]();
            let aoff = cg_val_off(cg, args[0_usize]);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
            try cg.buf.mov_imm64(alloc, a64_asm.X2, 1_u64);
            var li: usize = 0_usize;
            while li < lanes {
                try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, aoff +% li.trunc.[i32](), 1_u8, false, a64_asm.X16);
                try cg.buf.and_rr(alloc, true, false, a64_asm.X1, a64_asm.X1, a64_asm.X2);
                if li > 0_usize { try cg.buf.lsl_imm(alloc, true, a64_asm.X1, a64_asm.X1, li.trunc.[u8]()); }
                try cg.buf.orr_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                li = li +% 1_usize;
            }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .VecSelect => {
            if args.len < 3_usize { return; }
            let vn = env.get(op.ty0);
            let elem = vn.primary;
            let lanes = vn.u8_val.widen.[usize]();
            let esz_r = env.x64_layout(elem).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            let moff = cg_val_off(cg, args[0_usize]);
            let aoff = cg_val_off(cg, args[1_usize]);
            let boff = cg_val_off(cg, args[2_usize]);
            let doff = cg_val_off(cg, dst);
            var li: usize = 0_usize;
            while li < lanes {
                let ld = (li *% esz).trunc.[i32]();
                try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, boff +% ld, esz.trunc.[u8](), false, a64_asm.X16);
                try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, aoff +% ld, esz.trunc.[u8](), false, a64_asm.X16);
                try cg.buf.load_mem(alloc, a64_asm.X2, a64_asm.X29_FP, moff +% li.trunc.[i32](), 1_u8, false, a64_asm.X16);
                try cg.buf.cmp_imm(alloc, false, a64_asm.X2, 0_u16);
                try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X1, a64_asm.X0, .Ne);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ld, a64_asm.X0, esz.trunc.[u8](), a64_asm.X16);
                li = li +% 1_usize;
            }
        }
        .VecMin => {
            if args.len < 2_usize { return; }
            try cg_emit_vec_mmf(alloc, cg, env, dst, op, args);
        }
        .VecMax => {
            if args.len < 2_usize { return; }
            try cg_emit_vec_mmf(alloc, cg, env, dst, op, args);
        }
        .VecFma => {
            if args.len < 3_usize { return; }
            try cg_emit_vec_mmf(alloc, cg, env, dst, op, args);
        }
        .VecReduceAdd => { try cg_emit_vec_reduce(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecReduceMin => { try cg_emit_vec_reduce(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecReduceMax => { try cg_emit_vec_reduce(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecDot => { try cg_emit_vec_reduce(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecShuffle => {
            let sn = env.get(op.ty0);
            let in_n = env.get(op.ty1);
            if sn.kind != .Vec || in_n.kind != .Vec || args.len < 2_usize { return; }
            let elem = sn.primary;
            let src_lanes = sn.u8_val.widen.[usize]();
            let out_lanes = in_n.u8_val.widen.[usize]();
            let idx_esz = if env.x64_layout(in_n.primary).size == 0_usize { 1_usize } else { env.x64_layout(in_n.primary).size };
            let esz = if env.x64_layout(elem).size == 0_usize { 1_usize } else { env.x64_layout(elem).size };
            let two_src = op.flag;
            if two_src && args.len < 3_usize { return; }
            let aoff = cg_val_off(cg, args[0_usize]);
            let boff: i32 = if two_src { cg_val_off(cg, args[1_usize]) } else { aoff };
            let ioff: i32 = if two_src && args.len >= 3_usize { cg_val_off(cg, args[2_usize]) } else { cg_val_off(cg, args[1_usize]) };
            let doff = cg_val_off(cg, dst);
            let total_lanes = if two_src { src_lanes *% 2_usize } else { src_lanes };
            if total_lanes == 0_usize { return; }
            var li: usize = 0_usize;
            while li < out_lanes {
                try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, ioff +% (li *% idx_esz).trunc.[i32](), idx_esz.trunc.[u8](), false, a64_asm.X16);
                try cg.buf.mov_imm64(alloc, a64_asm.X2, (total_lanes -% 1_usize).widen.[u64]());
                try cg.buf.cmp_rr(alloc, true, a64_asm.X1, a64_asm.X2);
                try cg.buf.csel(alloc, true, a64_asm.X1, a64_asm.X2, a64_asm.X1, .Hi);
                try cg.buf.add_signed_imm(alloc, a64_asm.X9, a64_asm.X29_FP, aoff.widen.[i64](), a64_asm.X16);
                if two_src {
                    let l_first = try cg.buf.new_label(alloc);
                    try cg.buf.mov_imm64(alloc, a64_asm.X10, src_lanes.widen.[u64]());
                    try cg.buf.cmp_rr(alloc, true, a64_asm.X1, a64_asm.X10);
                    try cg.buf.b_cond_label(alloc, .Cc, l_first);
                    try cg.buf.sub_rr(alloc, true, false, a64_asm.X1, a64_asm.X1, a64_asm.X10);
                    try cg.buf.add_signed_imm(alloc, a64_asm.X9, a64_asm.X29_FP, boff.widen.[i64](), a64_asm.X16);
                    cg.buf.bind_label(l_first);
                }
                if esz != 1_usize {
                    try cg.buf.mov_imm64(alloc, a64_asm.X12, esz.widen.[u64]());
                    try cg.buf.mul_rr(alloc, true, a64_asm.X1, a64_asm.X1, a64_asm.X12);
                }
                try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X1);
                try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, esz.trunc.[u8](), false, a64_asm.X16);
                try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% (li *% esz).trunc.[i32](), a64_asm.X0, esz.trunc.[u8](), a64_asm.X16);
                li = li +% 1_usize;
            }
        }
        _ => {}
    }
    return;
}

fn cg_emit_vec_mmf(alloc: *mut AllocCap, cg: *mut A64Cg, env: *types.TypeEnv, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue]) -> !OutOfMemory {
    if args.len < 2_usize { return; }
    let vn = env.get(op.ty0);
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem);
    let esz = if env.x64_layout(elem).size == 0_usize { 1_usize } else { env.x64_layout(elem).size };
    let sgn = env.is_signed_int(elem);
    let aoff = cg_val_off(cg, args[0_usize]);
    let boff = cg_val_off(cg, args[1_usize]);
    let coff: i32 = if op.kind == .VecFma && args.len > 2_usize { cg_val_off(cg, args[2_usize]) } else { 0_i32 };
    let doff = cg_val_off(cg, dst);
    var li: usize = 0_usize;
    while li < lanes {
        let ld = (li *% esz).trunc.[i32]();
        if en.kind == .Float {
            let is64 = en.u8_val == 64_u8;
            let b: u8 = if is64 { 8_u8 } else { 4_u8 };
            try cg.buf.load_vec_mem(alloc, 0_u8, a64_asm.X29_FP, aoff +% ld, b, a64_asm.X16);
            try cg.buf.load_vec_mem(alloc, 1_u8, a64_asm.X29_FP, boff +% ld, b, a64_asm.X16);
            if op.kind == .VecFma {
                try cg.buf.load_vec_mem(alloc, 2_u8, a64_asm.X29_FP, coff +% ld, b, a64_asm.X16);
                try cg.buf.fmadd_s(alloc, is64, 0_u8, 0_u8, 1_u8, 2_u8);
            } else if op.kind == .VecMin {
                try cg.buf.fmin_s(alloc, is64, 0_u8, 0_u8, 1_u8);
            } else {
                try cg.buf.fmax_s(alloc, is64, 0_u8, 0_u8, 1_u8);
            }
            try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, doff +% ld, 0_u8, b, a64_asm.X16);
        } else {
            let b = esz.trunc.[u8]();
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, aoff +% ld, b, sgn, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, boff +% ld, b, sgn, a64_asm.X16);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X1, a64_asm.X0);
            let cc: a64_asm.A64Cond = if op.kind == .VecMin {
                if sgn { .Lt } else { .Cc }
            } else {
                if sgn { .Gt } else { .Hi }
            };
            try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X1, a64_asm.X0, cc);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% ld, a64_asm.X0, b, a64_asm.X16);
        }
        li = li +% 1_usize;
    }
    return;
}

fn cg_emit_vec_reduce(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue]) -> !OutOfMemory {
    if args.len == 0_usize { return; }
    let vn = env.get(op.ty0);
    if vn.kind != .Vec { return; }
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem);
    let esz = if env.x64_layout(elem).size == 0_usize { 1_usize } else { env.x64_layout(elem).size };
    let sgn = env.is_signed_int(elem);
    let aoff = cg_val_off(cg, args[0_usize]);
    let is_dot = op.kind == .VecDot;
    let boff: i32 = if is_dot && args.len > 1_usize { cg_val_off(cg, args[1_usize]) } else { 0_i32 };

    if en.kind == .Float {
        let is64 = en.u8_val == 64_u8;
        let b: u8 = if is64 { 8_u8 } else { 4_u8 };
        var li: usize = 0_usize;
        while li < lanes {
            let ld = (li *% esz).trunc.[i32]();
            try cg.buf.load_vec_mem(alloc, 1_u8, a64_asm.X29_FP, aoff +% ld, b, a64_asm.X16);
            if is_dot {
                try cg.buf.load_vec_mem(alloc, 2_u8, a64_asm.X29_FP, boff +% ld, b, a64_asm.X16);
                try cg.buf.fmul_s(alloc, is64, 1_u8, 1_u8, 2_u8);
            }
            if li == 0_usize { try cg.buf.vmov_16b(alloc, 0_u8, 1_u8); }
            else if op.kind == .VecReduceMin { try cg.buf.fmin_s(alloc, is64, 0_u8, 0_u8, 1_u8); }
            else if op.kind == .VecReduceMax { try cg.buf.fmax_s(alloc, is64, 0_u8, 0_u8, 1_u8); }
            else { try cg.buf.fadd_s(alloc, is64, 0_u8, 0_u8, 1_u8); }
            li = li +% 1_usize;
        }
        try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8);
        return;
    }

    var li: usize = 0_usize;
    while li < lanes {
        let ld = (li *% esz).trunc.[i32]();
        try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, aoff +% ld, esz.trunc.[u8](), sgn, a64_asm.X16);
        if is_dot {
            try cg.buf.load_mem(alloc, a64_asm.X2, a64_asm.X29_FP, boff +% ld, esz.trunc.[u8](), sgn, a64_asm.X16);
            try cg.buf.mul_rr(alloc, true, a64_asm.X1, a64_asm.X1, a64_asm.X2);
        }
        if li == 0_usize { try cg.buf.mov_rr(alloc, a64_asm.X0, a64_asm.X1); }
        else if op.kind == .VecReduceMin {
            try cg.buf.cmp_rr(alloc, true, a64_asm.X1, a64_asm.X0);
            try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X1, a64_asm.X0, if sgn { .Lt } else { .Cc });
        } else if op.kind == .VecReduceMax {
            try cg.buf.cmp_rr(alloc, true, a64_asm.X1, a64_asm.X0);
            try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X1, a64_asm.X0, if sgn { .Gt } else { .Hi });
        } else {
            try cg.buf.add_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1);
        }
        li = li +% 1_usize;
    }
    try cg_norm_subword(alloc, cg, env, elem, a64_asm.X0);
    try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
    return;
}

fn cg_emit_builtin_sys_io(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId) -> !OutOfMemory {
    _ = ret_ty;
    match op.kind {
        .ClockNowNs => {
            try cg_helper_call(alloc, cg, interner, "eon_rt_now_ns");
            if dst != eir.EIR_NONE { try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0); }
        }
        .ArgsLen => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .ArgsGet => {
            if args.len < 2_usize { return; }
            let doff = cg_val_off(cg, dst);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], a64_asm.X11);
            let l_oob = try cg.buf.new_label(alloc);
            let l_sl = try cg.buf.new_label(alloc);
            let l_sl_d = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X11, a64_asm.X10);
            try cg.buf.b_cond_label(alloc, .Cs, l_oob);
            try cg.buf.load_mem(alloc, a64_asm.X12, a64_asm.X9, 8_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.add_rr_lsl(alloc, true, a64_asm.X12, a64_asm.X12, a64_asm.X11, 3_u8);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X12, 0_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.cbz_label(alloc, true, a64_asm.X0, l_oob);
            try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64);
            cg.buf.bind_label(l_sl);
            try cg.buf.add_rr(alloc, true, false, a64_asm.X2, a64_asm.X0, a64_asm.X1);
            try cg.buf.load_mem(alloc, a64_asm.X3, a64_asm.X2, 0_i32, 1_u8, false, a64_asm.X16);
            try cg.buf.cbz_label(alloc, false, a64_asm.X3, l_sl_d);
            try cg.buf.add_imm(alloc, true, false, a64_asm.X1, a64_asm.X1, 1_u16, false);
            try cg.buf.b_label(alloc, l_sl);
            cg.buf.bind_label(l_sl_d);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 8_u8, a64_asm.X16);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 8_i32, a64_asm.X1, 8_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 8_u8, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X1, 0xFFFFFFFFFFFFFFFF_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff +% 8_i32, a64_asm.X1, 8_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .FsIsDir => {
            if args.len < 2_usize { return; }
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            let poff = cg_val_off(cg, args[1_usize]);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, poff, 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X2, a64_asm.X29_FP, poff +% 8_i32, 8_u8, false, a64_asm.X16);
            try cg_helper_call(alloc, cg, interner, "eon_rt_is_dir");
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
        }
        .FsMkdirAll => {
            if args.len < 2_usize { return; }
            let doff = cg_val_off(cg, dst);
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            let poff = cg_val_off(cg, args[1_usize]);
            try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, poff, 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X2, a64_asm.X29_FP, poff +% 8_i32, 8_u8, false, a64_asm.X16);
            try cg_helper_call(alloc, cg, interner, "eon_rt_mkdir_all");
            let l_ok = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_imm(alloc, true, a64_asm.X0, 0_u16);
            try cg.buf.b_cond_label(alloc, .Ge, l_ok);
            try cg.buf.mov_imm64(alloc, a64_asm.X0, 17_u64);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.X0, 4_u8, a64_asm.X16);
            try cg.buf.b_label(alloc, l_done);
            cg.buf.bind_label(l_ok);
            try cg.buf.store_mem(alloc, a64_asm.X29_FP, doff, a64_asm.XZR, 4_u8, a64_asm.X16);
            cg.buf.bind_label(l_done);
        }
        .DirClose => {
            try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X1, 0xFFFFFFFFFFFFFFFF_u64);
            try cg.buf.store_mem(alloc, a64_asm.X9, 0_i32, a64_asm.X1, 8_u8, a64_asm.X16);
            let l_skip = try cg.buf.new_label(alloc);
            try cg.buf.cmp_imm(alloc, true, a64_asm.X0, 0_u16);
            try cg.buf.b_cond_label(alloc, .Lt, l_skip);
            try cg_helper_call(alloc, cg, interner, "eon_rt_close_fd");
            cg.buf.bind_label(l_skip);
        }
        .NetRestrictHost => {
            if dst != eir.EIR_NONE {
                try cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, a64_asm.X9);
                try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X9, 0_i32, 8_u8, false, a64_asm.X16);
                try cg.buf.add_imm(alloc, true, false, a64_asm.X0, a64_asm.X0, 1_u16, false);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0);
            }
        }
        .ParReduce => {
            if args.len == 0_usize { return; }
            let elem_ty = op.ty0;
            let op_name = interner.get(op.sym);
            let en = env.get(elem_ty);
            let is_flt = en.kind == .Float;
            let is_f64 = is_flt && en.u8_val == 64_u8;
            let esz = if env.x64_layout(elem_ty).size == 0_usize { 1_usize } else { env.x64_layout(elem_ty).size };
            let signed = env.is_signed_int(elem_ty);
            let soff = cg_val_off(cg, args[0_usize]);
            try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, soff, 8_u8, false, a64_asm.X16);
            try cg.buf.load_mem(alloc, a64_asm.X10, a64_asm.X29_FP, soff +% 8_i32, 8_u8, false, a64_asm.X16);
            try cg.buf.mov_imm64(alloc, a64_asm.X11, 0_u64);
            if is_flt {
                if args.len > 2_usize { try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[2_usize], 0_u8); }
                else { try cg.buf.fmov_gpr_to_fp(alloc, true, 0_u8, a64_asm.XZR); }
            } else if args.len > 2_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], a64_asm.X0);
            } else {
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
            }
            let l_hd = try cg.buf.new_label(alloc);
            let l_end = try cg.buf.new_label(alloc);
            cg.buf.bind_label(l_hd);
            try cg.buf.cmp_rr(alloc, true, a64_asm.X11, a64_asm.X10);
            try cg.buf.b_cond_label(alloc, .Cs, l_end);
            if is_flt {
                let b: u8 = if is_f64 { 8_u8 } else { 4_u8 };
                try cg.buf.load_vec_mem(alloc, 1_u8, a64_asm.X9, 0_i32, b, a64_asm.X16);
                if str.bytes_eq(op_name, "Mul".as_bytes()) { try cg.buf.fmul_s(alloc, is_f64, 0_u8, 0_u8, 1_u8); }
                else if str.bytes_eq(op_name, "Min".as_bytes()) { try cg.buf.fmin_s(alloc, is_f64, 0_u8, 0_u8, 1_u8); }
                else if str.bytes_eq(op_name, "Max".as_bytes()) { try cg.buf.fmax_s(alloc, is_f64, 0_u8, 0_u8, 1_u8); }
                else { try cg.buf.fadd_s(alloc, is_f64, 0_u8, 0_u8, 1_u8); }
            } else {
                try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X9, 0_i32, esz.trunc.[u8](), signed, a64_asm.X16);
                if str.bytes_eq(op_name, "Min".as_bytes()) {
                    try cg.buf.cmp_rr(alloc, true, a64_asm.X1, a64_asm.X0);
                    try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X1, a64_asm.X0, if signed { .Lt } else { .Cc });
                } else if str.bytes_eq(op_name, "Max".as_bytes()) {
                    try cg.buf.cmp_rr(alloc, true, a64_asm.X1, a64_asm.X0);
                    try cg.buf.csel(alloc, true, a64_asm.X0, a64_asm.X1, a64_asm.X0, if signed { .Gt } else { .Hi });
                } else if str.bytes_eq(op_name, "Mul".as_bytes()) {
                    try cg.buf.mul_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                    try cg_norm_subword(alloc, cg, env, elem_ty, a64_asm.X0);
                } else if str.bytes_eq(op_name, "And".as_bytes()) || str.bytes_eq(op_name, "BitAnd".as_bytes()) {
                    try cg.buf.and_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                } else if str.bytes_eq(op_name, "Or".as_bytes()) || str.bytes_eq(op_name, "BitOr".as_bytes()) {
                    try cg.buf.orr_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                } else if str.bytes_eq(op_name, "Xor".as_bytes()) || str.bytes_eq(op_name, "BitXor".as_bytes()) {
                    try cg.buf.eor_rr(alloc, true, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                } else {
                    try cg.buf.add_rr(alloc, true, false, a64_asm.X0, a64_asm.X0, a64_asm.X1);
                    try cg_norm_subword(alloc, cg, env, elem_ty, a64_asm.X0);
                }
            }
            try cg.buf.add_signed_imm(alloc, a64_asm.X9, a64_asm.X9, esz.widen.[u64]().bitcast.[i64](), a64_asm.X16);
            try cg.buf.add_imm(alloc, true, false, a64_asm.X11, a64_asm.X11, 1_u16, false);
            try cg.buf.b_label(alloc, l_hd);
            cg.buf.bind_label(l_end);
            if is_flt { try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, 0_u8); }
            else { try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, a64_asm.X0); }
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_call(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, bc_id: u32) -> !OutOfMemory {
    let bc = eir_prog.get_builtin_call(bc_id) orelse { return; };
    let op = bc.op;
    let args = eir_prog.vals_slice(bc.args);
    let arg_slots = eir_prog.arg_slots_slice(bc.arg_slots);
    let ret_ty = bc.ret_ty;
    match op.kind {
        .ArenaInit => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaAlloc => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaReset => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaDestroy => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaUsedBytes => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaCapacity => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .AllocCapLiveAllocs => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .AllocCapUsedBytes => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .AllocCapPeakBytes => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .AllocCapSubBudget => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }

        .ArenaPoolInit => { try cg_emit_builtin_arena_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
