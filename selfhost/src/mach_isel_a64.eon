        .ArrayGet => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SliceSub => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArraySub => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }

        .MathSqrt => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .MathFma => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .MathLzcnt => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .MathTzcnt => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .MathPopcnt => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .MathBswap => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }

        .VecSplat => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecLen => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecCmp => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecMaskAny => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecMaskAll => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecBitmask => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecSelect => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecMin => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecMax => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecFma => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecReduceAdd => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecReduceMin => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecReduceMax => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecDot => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecShuffle => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }

        _ => { try cg_emit_builtin_sys_io(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
    }
    return;
}

// ============================================================================
// Section 9: Instruction Dispatch, Parallel Phi Copies, Terminators & Entry
// ============================================================================

struct A64PhiPair {
    dst: eir.EirValue;
    src: eir.EirValue;
}

fn cg_emit_phi_edge(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, from_bb: eir.BlockId, to_bb: eir.BlockId) -> !OutOfMemory {
    let phis = eir_prog.block_phis(cg.fn_id, to_bb);
    if phis.len == 0_usize { return; }
    var pairs = try col.DynBuf.[A64PhiPair].init(alloc, phis.len);
    errdefer pairs.destroy(alloc);
    var i: usize = 0_usize;
    while i < phis.len {
        let inc = eir_prog.phi_incoming(phis[i].incoming);
        var j: usize = 0_usize;
        while j < inc.len {
            if inc[j].pred_bb == from_bb && inc[j].val != phis[i].dst {
                try pairs.push(alloc, A64PhiPair.{ dst: phis[i].dst, src: inc[j].val });
                break;
            }
            j = j +% 1_usize;
        }
        i = i +% 1_usize;
    }
    if pairs.is_empty() { pairs.destroy(alloc); return; }

    let ps = pairs.as_slice();
    var has_conflict = false;
    if ps.len > 1_usize {
        var ic: usize = 0_usize;
        while ic < ps.len && !has_conflict {
            let sloc = cg_val_loc(cg, ps[ic].src);
            var jc: usize = 0_usize;
            while jc < ic {
                if ps[jc].dst == ps[ic].src { has_conflict = true; break; }
                let dloc = cg_val_loc(cg, ps[jc].dst);
                if sloc.kind == .Reg && dloc.kind == .Reg && sloc.reg == dloc.reg { has_conflict = true; break; }
                if sloc.kind == .Stack && dloc.kind == .Stack && sloc.stack_off == dloc.stack_off { has_conflict = true; break; }
                jc = jc +% 1_usize;
            }
            ic = ic +% 1_usize;
        }
    }
    if !has_conflict {
        var pi: usize = 0_usize;
        while pi < ps.len {
            try cg_copy_val_to_val(alloc, cg, eir_prog, env, ps[pi].dst, ps[pi].src);
            pi = pi +% 1_usize;
        }
        pairs.destroy(alloc);
        return;
    }

    // Parallel-copy snapshot on SP for conflicting phis (swap/cycle safe)
    var snap_offs = try col.DynBuf.[i32].init(alloc, ps.len);
    errdefer snap_offs.destroy(alloc);
    var total_snap: usize = 0_usize;
    var pi: usize = 0_usize;
    while pi < ps.len {
        try snap_offs.push(alloc, total_snap.trunc.[i32]());
        let lay = env.x64_layout(eir_prog.fn_val_ty(cg.fn_id, ps[pi].dst));
        let ssz = if lay.size == 0_usize { 0_usize } else { types.align_up_usize(if lay.size < 8_usize { 8_usize } else { lay.size }, 8_usize) };
        total_snap = total_snap +% ssz;
        pi = pi +% 1_usize;
    }
    let pad = types.align_up_usize(total_snap, 16_usize);
    if pad > 0_usize { try cg.buf.add_signed_imm(alloc, a64_asm.SP, a64_asm.SP, 0_i64 -% pad.widen.[u64]().bitcast.[i64](), a64_asm.X16); }
    let so = snap_offs.as_slice();
    pi = 0_usize;
    while pi < ps.len && pi < so.len {
        let lay = env.x64_layout(eir_prog.fn_val_ty(cg.fn_id, ps[pi].dst));
        if lay.size > 0_usize && lay.size <= 8_usize {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, ps[pi].src, a64_asm.X0);
            try cg.buf.store_mem(alloc, a64_asm.SP, so[pi], a64_asm.X0, 8_u8, a64_asm.X16);
        } else if lay.size > 8_usize {
            try cg_copy_mem(alloc, cg, a64_asm.SP, so[pi], a64_asm.X29_FP, cg_val_off(cg, ps[pi].src), lay.size);
        }
        pi = pi +% 1_usize;
    }
    pi = 0_usize;
    while pi < ps.len && pi < so.len {
        let lay = env.x64_layout(eir_prog.fn_val_ty(cg.fn_id, ps[pi].dst));
        if lay.size > 0_usize && lay.size <= 8_usize {
            try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.SP, so[pi], 8_u8, false, a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, ps[pi].dst, a64_asm.X0);
        } else if lay.size > 8_usize {
            try cg_copy_mem(alloc, cg, a64_asm.X29_FP, cg_val_off(cg, ps[pi].dst), a64_asm.SP, so[pi], lay.size);
        }
        pi = pi +% 1_usize;
    }
    if pad > 0_usize { try cg.buf.add_signed_imm(alloc, a64_asm.SP, a64_asm.SP, pad.widen.[u64]().bitcast.[i64](), a64_asm.X16); }
    snap_offs.destroy(alloc);
    pairs.destroy(alloc);
    return;
}

fn cg_emit_return_term(alloc: *mut AllocCap, cg: *mut A64Cg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, has_val: bool, val: eir.EirValue) -> !OutOfMemory {
    if cg.is_naked { return; }
    let rc = cg.ret_class;
    match rc.kind {
        .Void => {
            try cg_emit_epilogue(alloc, cg);
            try cg.buf.ret(alloc);
        }
        .IntReg => {
            if has_val { try cg_load_scalar_val(alloc, cg, eir_prog, env, val, a64_asm.X0); }
            else { try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64); }
            try cg_emit_epilogue(alloc, cg);
            try cg.buf.ret(alloc);
        }
        .TwoIntRegs => {
            if has_val {
                let soff = cg_val_off(cg, val);
                let lay = env.x64_layout(cg.ret_ty);
                try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, soff, 8_u8, false, a64_asm.X16);
                if lay.size > 8_usize {
                    try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, soff +% 8_i32, (lay.size - 8_usize).trunc.[u8](), false, a64_asm.X16);
                } else {
                    try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64);
                }
            } else {
                try cg.buf.mov_imm64(alloc, a64_asm.X0, 0_u64);
                try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64);
            }
            try cg_emit_epilogue(alloc, cg);
            try cg.buf.ret(alloc);
        }
        .FloatReg => {
            if has_val { try cg_load_float_val(alloc, cg, eir_prog, env, interner, val, 0_u8); }
            else { try cg.buf.fmov_gpr_to_fp(alloc, true, 0_u8, a64_asm.XZR); }
            try cg_emit_epilogue(alloc, cg);
            try cg.buf.ret(alloc);
        }
        .Sret => {
            try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, cg.frame.sret_off, 8_u8, false, a64_asm.X16);
            if has_val {
                try cg_store_val_to_mem(alloc, cg, env, a64_asm.X9, 0_i32, val, cg.ret_ty);
                try cg.buf.mov_rr(alloc, a64_asm.X0, a64_asm.X9);
            }
            try cg_emit_epilogue(alloc, cg);
            try cg.buf.ret(alloc);
        }
        .ErrorUnion => {
            if !has_val {
                try cg.buf.mov_imm64(alloc, a64_asm.X8, 0_u64);
                try cg_emit_epilogue(alloc, cg);
                try cg.buf.ret(alloc);
                return;
            }
            let soff = cg_val_off(cg, val);
            let l_err = try cg.buf.new_label(alloc);
            try cg.buf.load_mem(alloc, a64_asm.X8, a64_asm.X29_FP, soff, 4_u8, false, a64_asm.X16);
            try cg.buf.cbnz_label(alloc, false, a64_asm.X8, l_err);
            let ok_off = env.eu_ok_offset(rc.ok_ty).trunc.[i32]();
            let ok_lay = env.x64_layout(rc.ok_ty);
            match rc.ok_kind {
                .Void => {}
                .IntReg => {
                    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, soff +% ok_off, ok_lay.size.trunc.[u8](), env.is_signed_int(rc.ok_ty), a64_asm.X16);
                }
                .TwoIntRegs => {
                    try cg.buf.load_mem(alloc, a64_asm.X0, a64_asm.X29_FP, soff +% ok_off, 8_u8, false, a64_asm.X16);
                    if ok_lay.size > 8_usize {
                        try cg.buf.load_mem(alloc, a64_asm.X1, a64_asm.X29_FP, soff +% ok_off +% 8_i32, (ok_lay.size - 8_usize).trunc.[u8](), false, a64_asm.X16);
                    } else {
                        try cg.buf.mov_imm64(alloc, a64_asm.X1, 0_u64);
                    }
                }
                .FloatReg => {
                    let b: u8 = if env.get(rc.ok_ty).u8_val == 64_u8 { 8_u8 } else { 4_u8 };
                    try cg.buf.load_vec_mem(alloc, 0_u8, a64_asm.X29_FP, soff +% ok_off, b, a64_asm.X16);
                }
                .Sret => {
                    try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, cg.frame.sret_off, 8_u8, false, a64_asm.X16);
                    try cg_copy_mem(alloc, cg, a64_asm.X9, 0_i32, a64_asm.X29_FP, soff +% ok_off, ok_lay.size);
                    try cg.buf.mov_rr(alloc, a64_asm.X0, a64_asm.X9);
                }
                .ErrorUnion => {}
            }
            cg.buf.bind_label(l_err);
            try cg_emit_epilogue(alloc, cg);
            try cg.buf.ret(alloc);
        }
    }
    return;
}

fn cg_emit_inst(alloc: *mut AllocCap, cg: *mut A64Cg, sm: *span.SourceMap, eir_prog: *eir.EirProgram, env: *types.TypeEnv, ct: *ctvm.CtArena, interner: *mut span.SymInterner, inst: *eir.EirInst) -> !OutOfMemory {
    if cg.is_naked && inst.kind != .InlineAsm { return; }
    try cg_record_line(alloc, cg, sm, inst.span);
    match inst.kind {
        .Const => { try cg_emit_const(alloc, cg, eir_prog, env, ct, interner, inst.dst, inst.aux0, inst.ty0); }
        .Copy => { try cg_copy_val_to_val(alloc, cg, eir_prog, env, inst.dst, inst.v0); }
        .LoadSlot => {
            let ty = eir_prog.fn_val_ty(cg.fn_id, inst.dst);
            try cg_load_val_from_mem(alloc, cg, env, inst.dst, a64_asm.X29_FP, cg_slot_off(cg, inst.aux0), ty);
        }
        .StoreSlot => {
            let ty = eir_prog.fn_val_ty(cg.fn_id, inst.v0);
            try cg_store_val_to_mem(alloc, cg, env, a64_asm.X29_FP, cg_slot_off(cg, inst.aux0), inst.v0, ty);
        }
        .SlotAddr => {
            let soff = cg_slot_off(cg, inst.aux0);
            try cg.buf.add_signed_imm(alloc, a64_asm.X0, a64_asm.X29_FP, soff.widen.[i64](), a64_asm.X16);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, a64_asm.X0);
        }
        .LoadPlace => { try cg_emit_load_place(alloc, cg, eir_prog, env, inst.dst, inst.aux0); }
        .StorePlace => { try cg_emit_store_place(alloc, cg, eir_prog, env, inst.aux0, inst.v0); }
        .PlaceAddr => {
            if let place = eir_prog.get_place(inst.aux0) {
                _ = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, place.projs.len.widen.[usize](), a64_asm.X9);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, a64_asm.X9);
            }
        }
        .PoolColumnLoad => { try cg_emit_pool_col_load(alloc, cg, eir_prog, env, inst.dst, inst.aux0); }
        .PoolColumnStore => { try cg_emit_pool_col_store(alloc, cg, eir_prog, env, inst.aux0, inst.v0); }
        .Unary => { try cg_emit_unary(alloc, cg, eir_prog, env, interner, inst.dst, inst.unary_op, inst.v0, inst.ty0); }
        .Binary => { try cg_emit_binary(alloc, cg, eir_prog, env, interner, inst.dst, inst.bin_op, inst.v0, inst.v1, inst.ty0, inst.ty1); }
        .Cast => { try cg_emit_cast(alloc, cg, eir_prog, env, interner, inst.dst, inst.cast_kind, inst.v0, inst.ty1, inst.ty0); }
        .Slice => { try cg_emit_slice(alloc, cg, eir_prog, env, inst.dst, inst.v0, inst.v1, inst.v2, inst.ty1); }
        .VecLoad => {
            let vlay = env.x64_layout(inst.ty0);
            let esz = if env.x64_layout(inst.ty1).size == 0_usize { 4_usize } else { env.x64_layout(inst.ty1).size };
            let ptr_off = cg_val_off(cg, inst.v0);
            try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, ptr_off, 8_u8, false, a64_asm.X16);
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v1, a64_asm.X10);
            if esz == 4_usize { try cg.buf.lsl_imm(alloc, true, a64_asm.X10, a64_asm.X10, 2_u8); }
            else if esz == 8_usize { try cg.buf.lsl_imm(alloc, true, a64_asm.X10, a64_asm.X10, 3_u8); }
            else if esz == 2_usize { try cg.buf.lsl_imm(alloc, true, a64_asm.X10, a64_asm.X10, 1_u8); }
            try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
            let doff = cg_val_off(cg, inst.dst);
            try cg_copy_mem(alloc, cg, a64_asm.X29_FP, doff, a64_asm.X9, 0_i32, vlay.size);
        }
        .VecStore => {
            let vlay = env.x64_layout(inst.ty0);
            let esz = if env.x64_layout(inst.ty1).size == 0_usize { 4_usize } else { env.x64_layout(inst.ty1).size };
            let ptr_off = cg_val_off(cg, inst.v0);
            try cg.buf.load_mem(alloc, a64_asm.X9, a64_asm.X29_FP, ptr_off, 8_u8, false, a64_asm.X16);
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v1, a64_asm.X10);
            if esz == 4_usize { try cg.buf.lsl_imm(alloc, true, a64_asm.X10, a64_asm.X10, 2_u8); }
            else if esz == 8_usize { try cg.buf.lsl_imm(alloc, true, a64_asm.X10, a64_asm.X10, 3_u8); }
            else if esz == 2_usize { try cg.buf.lsl_imm(alloc, true, a64_asm.X10, a64_asm.X10, 1_u8); }
            try cg.buf.add_rr(alloc, true, false, a64_asm.X9, a64_asm.X9, a64_asm.X10);
            let soff = cg_val_off(cg, inst.v2);
            try cg_copy_mem(alloc, cg, a64_asm.X9, 0_i32, a64_asm.X29_FP, soff, vlay.size);
        }
        .VecFma => {
            let vn = env.get(inst.ty0);
            let lanes = vn.u8_val.widen.[usize]();
            let is64 = env.get(vn.primary).u8_val == 64_u8;
            let esz: usize = if is64 { 8_usize } else { 4_usize };
            let b = esz.trunc.[u8]();
            let aoff = cg_val_off(cg, inst.v0);
            let boff = cg_val_off(cg, inst.v1);
            let coff = cg_val_off(cg, inst.v2);
            let doff = cg_val_off(cg, inst.dst);
            var li: usize = 0_usize;
            while li < lanes {
                let d_off = (li *% esz).trunc.[i32]();
                try cg.buf.load_vec_mem(alloc, 0_u8, a64_asm.X29_FP, aoff +% d_off, b, a64_asm.X16);
                try cg.buf.load_vec_mem(alloc, 1_u8, a64_asm.X29_FP, boff +% d_off, b, a64_asm.X16);
                try cg.buf.load_vec_mem(alloc, 2_u8, a64_asm.X29_FP, coff +% d_off, b, a64_asm.X16);
                try cg.buf.fmadd_s(alloc, is64, 0_u8, 0_u8, 1_u8, 2_u8);
                try cg.buf.store_vec_mem(alloc, a64_asm.X29_FP, doff +% d_off, 0_u8, b, a64_asm.X16);
                li = li +% 1_usize;
            }
        }
        .Aggregate => { try cg_emit_aggregate(alloc, cg, eir_prog, env, inst.dst, inst.aux0, inst.range, inst.ty0); }
        .Call => { try cg_emit_call(alloc, cg, eir_prog, env, interner, inst.dst, inst.aux0); }
        .BuiltinCall => { try cg_emit_builtin_call(alloc, cg, eir_prog, env, interner, inst.dst, inst.aux0); }
        .ParForHint => {}
        _ => { try cg_emit_unwrap_and_extract(alloc, cg, eir_prog, env, interner, inst); }
    }
    return;
}

fn cg_emit_term(alloc: *mut AllocCap, cg: *mut A64Cg, sm: *span.SourceMap, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, bb: eir.BlockId, term: *eir.EirTerm, next_bb: eir.BlockId) -> !OutOfMemory {
    try cg_record_line(alloc, cg, sm, term.span);
    match term.kind {
        .Goto => {
            try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, term.bb0);
            if term.bb0 != next_bb {
                let lbl0 = cg_blk_lbl(cg, term.bb0);
                try cg.buf.b_label(alloc, lbl0);
            }
        }
        .Branch => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, term.val, a64_asm.X0);
            let l_else = try cg.buf.new_label(alloc);
            try cg.buf.cbz_label(alloc, false, a64_asm.X0, l_else);
            try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, term.bb0);
            let lbl0 = cg_blk_lbl(cg, term.bb0);
            try cg.buf.b_label(alloc, lbl0);
            cg.buf.bind_label(l_else);
            try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, term.bb1);
            if term.bb1 != next_bb {
                let lbl1 = cg_blk_lbl(cg, term.bb1);
                try cg.buf.b_label(alloc, lbl1);
            }
        }
        .SwitchInt => {
            let targets = eir_prog.switch_targets_slice(term.targets);
            try cg_load_scalar_val(alloc, cg, eir_prog, env, term.val, a64_asm.X0);
            var ti: usize = 0_usize;
            while ti < targets.len {
                let t = targets[ti];
                let l_skip = try cg.buf.new_label(alloc);
                try cg.buf.mov_imm64(alloc, a64_asm.X1, t.val.lo);
                try cg.buf.cmp_rr(alloc, true, a64_asm.X0, a64_asm.X1);
                try cg.buf.b_cond_label(alloc, .Ne, l_skip);
                try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, t.target);
                let tlbl = cg_blk_lbl(cg, t.target);
                try cg.buf.b_label(alloc, tlbl);
                cg.buf.bind_label(l_skip);
                ti = ti +% 1_usize;
            }
            try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, term.bb0);
            if term.bb0 != next_bb {
                let dlbl = cg_blk_lbl(cg, term.bb0);
                try cg.buf.b_label(alloc, dlbl);
            }
        }
        .Return => { try cg_emit_return_term(alloc, cg, eir_prog, env, interner, term.flag, term.val); }
        .Unreachable => { try cg.buf.brk(alloc, 1_u16); }
    }
    return;
}

fn init_a64_cg(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    fn_sym_id: u32,
    env: *types.TypeEnv,
    opts: *mach_x64.CompileOptions,
    f: *eir.EirFunction,
    rc: A64RetClass,
) -> A64Cg ! OutOfMemory {
    let has_sret = a64_ret_uses_sret(rc);
    let frame = try plan_a64_direct_frame(alloc, eir_prog, fn_id, env, has_sret);
    errdefer frame.destroy(alloc);
    let buf = try a64_asm.A64Buf.init(alloc);
    errdefer buf.destroy(alloc);
    let blk_labels = try col.DynBuf.[u32].init(alloc, 8_usize);
    errdefer blk_labels.destroy(alloc);
    let rodata_items = try col.DynBuf.[mach_x64.RodataItemMeta].init(alloc, 4_usize);
    errdefer rodata_items.destroy(alloc);
    let rodata_bytes = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer rodata_bytes.destroy(alloc);
    let rodata_relocs = try col.DynBuf.[mach_x64.RodataReloc].init(alloc, 4_usize);
    errdefer rodata_relocs.destroy(alloc);
    let used_helpers = try col.DynBuf.[u32].init(alloc, 4_usize);
    errdefer used_helpers.destroy(alloc);
    let line_entries = try col.DynBuf.[elf64.LineEntry].init(alloc, 16_usize);
    errdefer line_entries.destroy(alloc);
    let fn_ref_thunks = try col.DynBuf.[mach_x64.FnRefThunkReq].init(alloc, 4_usize);
    errdefer fn_ref_thunks.destroy(alloc);
    let err_msg = try str.StrBuf.init(alloc, 16_usize);
    errdefer err_msg.destroy(alloc);

    return A64Cg.{
        fn_id: fn_id,
        fn_sym_id: fn_sym_id,
        ret_ty: f.sig.ret,
        ret_class: rc,
        is_naked: f.sig.effects.is_naked,
        is_export_c: f.sig.effects.is_export_c,
        is_linux: opts.mode.kind != .Freestanding,
        sanitize: opts.sanitize,
        emit_debug_line: opts.emit_debug_line,
        failed: false,
        err_msg: err_msg,
        frame: frame,
        buf: buf,
        blk_labels: blk_labels,
        rodata_items: rodata_items,
        rodata_bytes: rodata_bytes,
        rodata_relocs: rodata_relocs,
        used_helpers: used_helpers,
        line_entries: line_entries,
        fn_ref_thunks: fn_ref_thunks,
        last_line_file: span.FILE_DUMMY,
        last_line_num: 0_u32,
        max_call_stk: 0_u64,
    };
}

pub fn compile_fn_a64_direct(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    fn_sym_id: u32,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *mach_x64.CompileOptions,
) -> A64FnBlob ! OutOfMemory {
    var out = try A64FnBlob.init(alloc, fn_sym_id);
    errdefer out.destroy(alloc);
    let f = eir_prog.get_fn(fn_id) orelse { return out; };
    let rc = a64_classify_ret(f.sig.ret, env);
    var cg = try init_a64_cg(alloc, eir_prog, fn_id, fn_sym_id, env, opts, f, rc);
    errdefer cg.destroy(alloc);

    let blks = eir_prog.fn_blocks(fn_id);
    var bi: usize = 0_usize;
    while bi < blks.len {
        let lbl = try cg.buf.new_label(alloc);
        try cg.blk_labels.push(alloc, lbl);
        bi = bi +% 1_usize;
    }

    try cg_emit_prologue(alloc, &mut cg);
    try cg_receive_params(alloc, &mut cg, eir_prog, env);

    bi = 0_usize;
    while bi < blks.len && !cg.failed {
        let bb = bi.trunc.[u32]();
        let next_bb: eir.BlockId = if bi +% 1_usize < blks.len { (bi +% 1_usize).trunc.[u32]() } else { 0xFFFFFFFF_u32 };
        let blbl = cg_blk_lbl(&cg, bb);
        cg.buf.bind_label(blbl);
        let insts = eir_prog.insts_slice(blks[bi].insts);
        var ii: usize = 0_usize;
        while ii < insts.len && !cg.failed {
            try cg_emit_inst(alloc, &mut cg, sm, eir_prog, env, ct, interner, &insts[ii]);
            ii = ii +% 1_usize;
        }
        if !cg.failed {
            try cg_emit_term(alloc, &mut cg, sm, eir_prog, env, interner, bb, &blks[bi].term, next_bb);
        }
        bi = bi +% 1_usize;
    }

    let fin_ok = !cg.failed && cg.buf.finish();
    out.ok = fin_ok;
    out.own_stack_bytes = 16_u64 +% cg.frame.total_sub.widen.[u64]() +% cg.max_call_stk;
    if fin_ok {
        try out.code.push_slice(alloc, cg.buf.code.as_slice());
        try out.relocs.push_slice(alloc, cg.buf.relocs.as_slice());
        try out.rodata_items.push_slice(alloc, cg.rodata_items.as_slice());
        try out.rodata_bytes.push_slice(alloc, cg.rodata_bytes.as_slice());
        try out.rodata_relocs.push_slice(alloc, cg.rodata_relocs.as_slice());
        try out.used_helpers.push_slice(alloc, cg.used_helpers.as_slice());
        try out.line_entries.push_slice(alloc, cg.line_entries.as_slice());
        try out.fn_ref_thunks.push_slice(alloc, cg.fn_ref_thunks.as_slice());
    } else if cg.err_msg.len() > 0_usize {
        try out.err_msg.push_bytes_grow(alloc, cg.err_msg.as_bytes());
    } else {
        try out.err_msg.push_str_grow(alloc, "aarch64 codegen error: branch fixup failed");
    }

    cg.destroy(alloc);
    return out;
}
