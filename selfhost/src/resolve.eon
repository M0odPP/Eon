module eonc.resolve;

import core.col;
import core.str;
import eonc.span;
import eonc.diag;
import eonc.ast;

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

pub const UNIT_NONE: u32 = 4294967295_u32;
pub const MODULE_NONE: u32 = 4294967295_u32;
pub const DEF_NONE: u32 = 4294967295_u32;

// ---------------------------------------------------------------------------
// Builtin & Primitive Kinds (matching `compiler/src/resolve.rs`)
// ---------------------------------------------------------------------------

pub enum PrimKind : u8 {
    UInt = 0,
    USize = 1,
    IInt = 2,
    ISize = 3,
    F16 = 4,
    F32 = 5,
    F64 = 6,
    Bool = 7,
    Char = 8,
    Void = 9,
    Never = 10,
    TypeType = 11,
    Str = 12,
    PhysAddr = 13,
    VirtAddr = 14,
    DmaAddr = 15,
}

pub enum BuiltinKind : u8 {
    Prim = 0,
    VecType = 1,
    SimdAlias = 2,
    ArithError = 3,
    BoundsError = 4,
    Utf8Error = 5,
    OutOfMemory = 6,
    Ordering = 7,
    OrdIface = 8,
    EqIface = 9,
    RawPtr = 10,
    MmioReg = 11,
    Arena = 12,
    ArenaPool = 13,
    ArenaStr = 14,
    SlotPool = 15,
    Buf = 16,
    LinearBuf = 17,
    Link = 18,
    IdBrand = 19,
    GenId = 20,
    AllocCap = 21,
    Env = 22,
    FsCap = 23,
    DirCap = 24,
    NetCap = 25,
    ClockCap = 26,
    IoCap = 27,
    ArgsCap = 28,
    BuildCap = 29,
    IoError = 30,
    MemError = 31,
    StaleId = 32,
    Schedule = 33,
    Atomic = 34,
    GpuBuf = 35,
    GpuImage2D = 36,
}

pub struct BuiltinInfo {
    pub kind: BuiltinKind;
    pub prim: PrimKind;
    pub prim_bits: u8;
    pub lanes: u8;
    pub is_mut: bool;
}

pub enum TopDefKind : u8 {
    Fn = 0,
    Sys = 1,
    Struct = 2,
    Pool = 3,
    Enum = 4,
    Union = 5,
    Bitfield = 6,
    Iface = 7,
    Error = 8,
    TypeAlias = 9,
    Const = 10,
    ExternFn = 11,
    ExternStruct = 12,
    ExternUnion = 13,
}

pub enum TargetKind : u8 {
    Def = 0,
    Module = 1,
    Builtin = 2,
}

// ---------------------------------------------------------------------------
// Core Resolution Records
// ---------------------------------------------------------------------------

pub struct ScopeEntry {
    pub name: u32;
    pub kind: TargetKind;
    pub target_id: u32;
    pub is_pub: bool;
    pub is_import: bool;
    pub used: bool;
    pub span: span.Span;
}

pub struct TopDef {
    pub id: u32;
    pub module_id: u32;
    pub unit_id: u32;
    pub decl_idx: u32;
    pub decl_id: u32;
    pub name: u32;
    pub kind: TopDefKind;
    pub is_pub: bool;
    pub used: bool;
    pub span: span.Span;
}

pub struct ImplInfo {
    pub module_id: u32;
    pub unit_id: u32;
    pub decl_idx: u32;
    pub decl_id: u32;
    pub span: span.Span;
}

pub struct ImportEdge {
    pub from_mod: u32;
    pub to_mod: u32;
    pub span: span.Span;
}

pub struct ImportRec {
    pub module_id: u32;
    pub local_sym: u32;
    pub kind: TargetKind;
    pub target_id: u32;
    pub span: span.Span;
}

pub struct ModuleInfo {
    pub id: u32;
    pub unit_id: u32;
    pub file: u32;
    pub path_sym: u32;
    pub profile: span.FileProfile;
    pub imports_off: u32;
    pub imports_len: u32;
    pub scope_off: u32;
    pub scope_len: u32;
    pub items_off: u32;
    pub items_len: u32;
    pub is_emi_stub: bool;
}

// ---------------------------------------------------------------------------
// Builtin Encoding / Decoding & Debug Formatting
// ---------------------------------------------------------------------------

fn prim_kind_to_u8(p: PrimKind) -> u8 {
    match p {
        .UInt => { return 0_u8; }
        .USize => { return 1_u8; }
        .IInt => { return 2_u8; }
        .ISize => { return 3_u8; }
        .F16 => { return 4_u8; }
        .F32 => { return 5_u8; }
        .F64 => { return 6_u8; }
        .Bool => { return 7_u8; }
        .Char => { return 8_u8; }
        .Void => { return 9_u8; }
        .Never => { return 10_u8; }
        .TypeType => { return 11_u8; }
        .Str => { return 12_u8; }
        .PhysAddr => { return 13_u8; }
        .VirtAddr => { return 14_u8; }
        .DmaAddr => { return 15_u8; }
    }
}

fn prim_kind_from_u8(v: u8) -> PrimKind {
    match v {
        0_u8 => { return .UInt; }
        1_u8 => { return .USize; }
        2_u8 => { return .IInt; }
        3_u8 => { return .ISize; }
        4_u8 => { return .F16; }
        5_u8 => { return .F32; }
        6_u8 => { return .F64; }
        7_u8 => { return .Bool; }
        8_u8 => { return .Char; }
        9_u8 => { return .Void; }
        10_u8 => { return .Never; }
        11_u8 => { return .TypeType; }
        12_u8 => { return .Str; }
        13_u8 => { return .PhysAddr; }
        14_u8 => { return .VirtAddr; }
        15_u8 => { return .DmaAddr; }
        _ => { return .Void; }
    }
}

fn builtin_kind_to_u8(k: BuiltinKind) -> u8 {
    match k {
        .Prim => { return 0_u8; }
        .VecType => { return 1_u8; }
        .SimdAlias => { return 2_u8; }
        .ArithError => { return 3_u8; }
        .BoundsError => { return 4_u8; }
        .Utf8Error => { return 5_u8; }
        .OutOfMemory => { return 6_u8; }
        .Ordering => { return 7_u8; }
        .OrdIface => { return 8_u8; }
        .EqIface => { return 9_u8; }
        .RawPtr => { return 10_u8; }
        .MmioReg => { return 11_u8; }
        .Arena => { return 12_u8; }
        .ArenaPool => { return 13_u8; }
        .ArenaStr => { return 14_u8; }
        .SlotPool => { return 15_u8; }
        .Buf => { return 16_u8; }
        .LinearBuf => { return 17_u8; }
        .Link => { return 18_u8; }
        .IdBrand => { return 19_u8; }
        .GenId => { return 20_u8; }
        .AllocCap => { return 21_u8; }
        .Env => { return 22_u8; }
        .FsCap => { return 23_u8; }
        .DirCap => { return 24_u8; }
        .NetCap => { return 25_u8; }
        .ClockCap => { return 26_u8; }
        .IoCap => { return 27_u8; }
        .ArgsCap => { return 28_u8; }
        .BuildCap => { return 29_u8; }
        .IoError => { return 30_u8; }
        .MemError => { return 31_u8; }
        .StaleId => { return 32_u8; }
        .Schedule => { return 33_u8; }
        .Atomic => { return 34_u8; }
        .GpuBuf => { return 35_u8; }
        .GpuImage2D => { return 36_u8; }
    }
}

fn builtin_kind_from_u8(v: u8) -> BuiltinKind {
    match v {
        0_u8 => { return .Prim; }
        1_u8 => { return .VecType; }
        2_u8 => { return .SimdAlias; }
        3_u8 => { return .ArithError; }
        4_u8 => { return .BoundsError; }
        5_u8 => { return .Utf8Error; }
        6_u8 => { return .OutOfMemory; }
        7_u8 => { return .Ordering; }
        8_u8 => { return .OrdIface; }
        9_u8 => { return .EqIface; }
        10_u8 => { return .RawPtr; }
        11_u8 => { return .MmioReg; }
        12_u8 => { return .Arena; }
        13_u8 => { return .ArenaPool; }
        14_u8 => { return .ArenaStr; }
        15_u8 => { return .SlotPool; }
        16_u8 => { return .Buf; }
        17_u8 => { return .LinearBuf; }
        18_u8 => { return .Link; }
        19_u8 => { return .IdBrand; }
        20_u8 => { return .GenId; }
        21_u8 => { return .AllocCap; }
        22_u8 => { return .Env; }
        23_u8 => { return .FsCap; }
        24_u8 => { return .DirCap; }
        25_u8 => { return .NetCap; }
        26_u8 => { return .ClockCap; }
        27_u8 => { return .IoCap; }
        28_u8 => { return .ArgsCap; }
        29_u8 => { return .BuildCap; }
        30_u8 => { return .IoError; }
        31_u8 => { return .MemError; }
        32_u8 => { return .StaleId; }
        33_u8 => { return .Schedule; }
        34_u8 => { return .Atomic; }
        35_u8 => { return .GpuBuf; }
        36_u8 => { return .GpuImage2D; }
        _ => { return .Prim; }
    }
}

pub fn encode_builtin_simple(kind: BuiltinKind) -> u32 {
    return builtin_kind_to_u8(kind).widen.[u32]();
}

pub fn encode_builtin_prim(prim: PrimKind, bits: u8) -> u32 {
    let b0 = builtin_kind_to_u8(.Prim).widen.[u32]();
    let b1 = prim_kind_to_u8(prim).widen.[u32]() <<% 8_u32;
    let b2 = bits.widen.[u32]() <<% 16_u32;
    return b0 | b1 | b2;
}

pub fn encode_builtin_simd(prim: PrimKind, bits: u8, lanes: u8) -> u32 {
    let b0 = builtin_kind_to_u8(.SimdAlias).widen.[u32]();
    let b1 = prim_kind_to_u8(prim).widen.[u32]() <<% 8_u32;
    let b2 = bits.widen.[u32]() <<% 16_u32;
    let b3 = lanes.widen.[u32]() <<% 24_u32;
    return b0 | b1 | b2 | b3;
}

pub fn encode_builtin_rawptr(is_mut: bool) -> u32 {
    let b0 = builtin_kind_to_u8(.RawPtr).widen.[u32]();
    let b3: u32 = if is_mut { 1_u32 <<% 24_u32 } else { 0_u32 };
    return b0 | b3;
}

pub fn decode_builtin(id: u32) -> BuiltinInfo {
    let kind = builtin_kind_from_u8((id & 0xFF_u32).trunc.[u8]());
    let prim = prim_kind_from_u8(((id >> 8_u32) & 0xFF_u32).trunc.[u8]());
    let prim_bits = ((id >> 16_u32) & 0xFF_u32).trunc.[u8]();
    let aux = ((id >> 24_u32) & 0xFF_u32).trunc.[u8]();
    let lanes: u8 = if kind == .SimdAlias { aux } else { 0_u8 };
    let is_mut = kind == .RawPtr && aux != 0_u8;
    return BuiltinInfo.{
        kind: kind,
        prim: prim,
        prim_bits: prim_bits,
        lanes: lanes,
        is_mut: is_mut,
    };
}

fn write_prim_debug(
    alloc: *mut AllocCap,
    prim: PrimKind,
    bits: u8,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    match prim {
        .UInt => {
            try out.push_str_grow(alloc, "UInt(");
            try out.push_u64_grow(alloc, bits.widen.[u64]());
            try out.push_byte_grow(alloc, b')');
        }
        .USize => { try out.push_str_grow(alloc, "USize"); }
        .IInt => {
            try out.push_str_grow(alloc, "IInt(");
            try out.push_u64_grow(alloc, bits.widen.[u64]());
            try out.push_byte_grow(alloc, b')');
        }
        .ISize => { try out.push_str_grow(alloc, "ISize"); }
        .F16 => { try out.push_str_grow(alloc, "F16"); }
        .F32 => { try out.push_str_grow(alloc, "F32"); }
        .F64 => { try out.push_str_grow(alloc, "F64"); }
        .Bool => { try out.push_str_grow(alloc, "Bool"); }
        .Char => { try out.push_str_grow(alloc, "Char"); }
        .Void => { try out.push_str_grow(alloc, "Void"); }
        .Never => { try out.push_str_grow(alloc, "Never"); }
        .TypeType => { try out.push_str_grow(alloc, "TypeType"); }
        .Str => { try out.push_str_grow(alloc, "Str"); }
        .PhysAddr => { try out.push_str_grow(alloc, "PhysAddr"); }
        .VirtAddr => { try out.push_str_grow(alloc, "VirtAddr"); }
        .DmaAddr => { try out.push_str_grow(alloc, "DmaAddr"); }
    }
    return;
}

