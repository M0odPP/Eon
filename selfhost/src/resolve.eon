        .VecType => { try out.push_str_grow(alloc, "VecType"); }
        .SimdAlias => { try out.push_str_grow(alloc, "SimdAlias"); }
        .ArithError => { try out.push_str_grow(alloc, "ArithError"); }
        .BoundsError => { try out.push_str_grow(alloc, "BoundsError"); }
        .Utf8Error => { try out.push_str_grow(alloc, "Utf8Error"); }
        .OutOfMemory => { try out.push_str_grow(alloc, "OutOfMemory"); }
        .Ordering => { try out.push_str_grow(alloc, "Ordering"); }
        .OrdIface => { try out.push_str_grow(alloc, "OrdIface"); }
        .EqIface => { try out.push_str_grow(alloc, "EqIface"); }
        .RawPtr => { try out.push_str_grow(alloc, "RawPtr"); }
        .MmioReg => { try out.push_str_grow(alloc, "MmioReg"); }
        .Arena => { try out.push_str_grow(alloc, "Arena"); }
        .ArenaPool => { try out.push_str_grow(alloc, "ArenaPool"); }
        .ArenaStr => { try out.push_str_grow(alloc, "ArenaStr"); }
        .SlotPool => { try out.push_str_grow(alloc, "SlotPool"); }
        .Buf => { try out.push_str_grow(alloc, "Buf"); }
        .LinearBuf => { try out.push_str_grow(alloc, "LinearBuf"); }
        .Link => { try out.push_str_grow(alloc, "Link"); }
        .IdBrand => { try out.push_str_grow(alloc, "IdBrand"); }
        .GenId => { try out.push_str_grow(alloc, "GenId"); }
        .AllocCap => { try out.push_str_grow(alloc, "AllocCap"); }
        .Env => { try out.push_str_grow(alloc, "Env"); }
        .FsCap => { try out.push_str_grow(alloc, "FsCap"); }
        .DirCap => { try out.push_str_grow(alloc, "DirCap"); }
        .NetCap => { try out.push_str_grow(alloc, "NetCap"); }
        .ClockCap => { try out.push_str_grow(alloc, "ClockCap"); }
        .IoCap => { try out.push_str_grow(alloc, "IoCap"); }
        .ArgsCap => { try out.push_str_grow(alloc, "ArgsCap"); }
        .BuildCap => { try out.push_str_grow(alloc, "BuildCap"); }
        .IoError => { try out.push_str_grow(alloc, "IoError"); }
        .MemError => { try out.push_str_grow(alloc, "MemError"); }
        .StaleId => { try out.push_str_grow(alloc, "StaleId"); }
        .Schedule => { try out.push_str_grow(alloc, "Schedule"); }
        .Atomic => { try out.push_str_grow(alloc, "Atomic"); }
        .GpuBuf => { try out.push_str_grow(alloc, "GpuBuf"); }
        .GpuImage2D => { try out.push_str_grow(alloc, "GpuImage2D"); }
    }
    return;
}

/// Formats `builtin_id` identically to Rust `format!("{bk:?}")` on `BuiltinKind`.
pub fn write_builtin_debug(
    alloc: *mut AllocCap,
    builtin_id: u32,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    let info = decode_builtin(builtin_id);
    if info.kind == .Prim {
        try out.push_str_grow(alloc, "Prim(");
        try write_prim_debug(alloc, info.prim, info.prim_bits, out);
        try out.push_byte_grow(alloc, b')');
        return;
    }
    if info.kind == .SimdAlias {
        try out.push_str_grow(alloc, "SimdAlias(");
        try write_prim_debug(alloc, info.prim, info.prim_bits, out);
        try out.push_str_grow(alloc, ", ");
        try out.push_u64_grow(alloc, info.lanes.widen.[u64]());
        try out.push_byte_grow(alloc, b')');
        return;
    }
    if info.kind == .RawPtr {
        if info.is_mut {
            try out.push_str_grow(alloc, "RawPtr { is_mut: true }");
        } else {
            try out.push_str_grow(alloc, "RawPtr { is_mut: false }");
        }
        return;
    }
    try write_builtin_simple_debug(alloc, info.kind, out);
    return;
}

