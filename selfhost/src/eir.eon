}

pub struct EirValName {
    pub val: EirValue;
    pub sym: u32;
}

pub struct EirValRange {
    pub val: EirValue;
    pub lo: types.IntVal;
    pub hi: types.IntVal;
}

pub struct EirProvenSafeInst {
    pub bb: BlockId;
    pub inst_idx: u32;
}

pub struct LayoutSharedMember {
    pub key: cfg_ir.CfgFnKey;
    pub gargs: ast.IdRange;
}

pub struct LayoutSharedGroup {
