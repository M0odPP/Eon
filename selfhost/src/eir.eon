    /// Allocates a fresh SSA value in `fn_id` with type `ty` (amortized O(1) via tail-extend fast path).
    pub fn alloc_fn_value(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        ty: types.TyId,
    ) -> EirValue ! OutOfMemory {
        var cur_r = ast.range_empty();
        if let f = self.funcs.fns.get(fn_id.widen.[usize]()) {
            cur_r = f.value_tys;
        } else {
            return EIR_NONE;
        }
        let pool_len = self.funcs.value_tys.len().trunc.[u32]();
        let new_val = cur_r.len;
        if cur_r.start +% cur_r.len == pool_len {
            try self.funcs.value_tys.push(alloc, ty);
            if let fm = self.funcs.fns.get_mut(fn_id.widen.[usize]()) {
                fm.value_tys = ast.range_new(cur_r.start, cur_r.len +% 1_u32);
            }
            return new_val;
        }
        let new_start = pool_len;
        var i: u32 = 0_u32;
        while i < cur_r.len {
            var old_ty = types.TY_ERROR;
            if let tp = self.funcs.value_tys.get((cur_r.start +% i).widen.[usize]()) {
                old_ty = tp.*;
            }
            try self.funcs.value_tys.push(alloc, old_ty);
            i = i +% 1_u32;
        }
        try self.funcs.value_tys.push(alloc, ty);
        if let fm = self.funcs.fns.get_mut(fn_id.widen.[usize]()) {
            fm.value_tys = ast.range_new(new_start, cur_r.len +% 1_u32);
        }
        return new_val;
    }

    /// Allocates a fresh stack slot in `fn_id` (amortized O(1) via tail-extend fast path).
    pub fn alloc_fn_slot(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        info: EirSlotInfo,
    ) -> EirSlot ! OutOfMemory {
        var cur_r = ast.range_empty();
        if let f = self.funcs.fns.get(fn_id.widen.[usize]()) {
            cur_r = f.slots;
        } else {
            return EIR_NONE;
        }
        let pool_len = self.funcs.slots.len().trunc.[u32]();
        let new_slot = cur_r.len;
        var sinfo = info;
        sinfo.id = new_slot;
        if cur_r.start +% cur_r.len == pool_len {
            try self.funcs.slots.push(alloc, sinfo);
            if let fm = self.funcs.fns.get_mut(fn_id.widen.[usize]()) {
                fm.slots = ast.range_new(cur_r.start, cur_r.len +% 1_u32);
            }
            return new_slot;
        }
        let new_start = pool_len;
        var i: u32 = 0_u32;
        while i < cur_r.len {
            var old_s = sinfo;
            if let sp = self.funcs.slots.get((cur_r.start +% i).widen.[usize]()) {
                old_s = sp.*;
            }
            try self.funcs.slots.push(alloc, old_s);
            i = i +% 1_u32;
        }
        try self.funcs.slots.push(alloc, sinfo);
        if let fm = self.funcs.fns.get_mut(fn_id.widen.[usize]()) {
            fm.slots = ast.range_new(new_start, cur_r.len +% 1_u32);
        }
        return new_slot;
    }

    /// Recomputes `f.rpo` (DFS reverse postorder from `f.entry`), `blk.preds` (unique sorted
    /// reachable predecessors), and `blk.idom` (Cooper-Harvey-Kennedy dominators using RPO positions).
    pub fn rebuild_fn_rpo(self: *mut Self, alloc: *mut AllocCap, fn_id: u32) -> !OutOfMemory {
        var blks_r = ast.range_empty();
        var entry: BlockId = 0_u32;
        if let f = self.get_fn(fn_id) {
            blks_r = f.blocks;
            entry = f.entry;
        } else {
            return;
        }
        let n = blks_r.len.widen.[usize]();
        if n == 0_usize || entry.widen.[usize]() >= n {
            if let fm = self.get_fn_mut(fn_id) {
                fm.rpo = ast.range_empty();
            }
            return;
        }

        var visited = try col.BitSet.init(alloc, n);
        errdefer visited.destroy(alloc);
        var stack = try col.DynBuf.[RpoFrame].init(alloc, 32_usize);
        errdefer stack.destroy(alloc);
        var rpo_buf = try col.DynBuf.[BlockId].init(alloc, n);
        errdefer rpo_buf.destroy(alloc);

        visited.set(entry.widen.[usize]());
        try stack.push(alloc, RpoFrame.{ bb: entry, next_succ: 0_usize });

        while !stack.is_empty() {
            let top_idx = stack.len() -% 1_usize;
            var u: BlockId = 0_u32;
            var sidx: usize = 0_usize;
            if let fr = stack.get(top_idx) {
                u = fr.bb;
                sidx = fr.next_succ;
            }
            var term = term_unreachable(span.span_dummy(), false);
            if let bp = self.fn_block(fn_id, u) {
                term = bp.term;
            }
            let sc = self.term_successor_count(&term);
            if sidx < sc {
                if let fm = stack.get_mut(top_idx) {
                    fm.next_succ = sidx +% 1_usize;
                }
                let v = self.term_successor_at(&term, sidx);
                let vu = v.widen.[usize]();
                if v != EIR_NONE && vu < n && !visited.test(vu) {
                    visited.set(vu);
                    try stack.push(alloc, RpoFrame.{ bb: v, next_succ: 0_usize });
                }
            } else {
                _ = stack.pop();
                try rpo_buf.push(alloc, u);
            }
        }

        let rpo_m = rpo_buf.as_mut_slice();
        var lo: usize = 0_usize;
        if rpo_m.len > 1_usize {
            var hi = rpo_m.len -% 1_usize;
            while lo < hi {
                let tmp = rpo_m[lo];
                rpo_m[lo] = rpo_m[hi];
                rpo_m[hi] = tmp;
                lo = lo +% 1_usize;
                hi = hi -% 1_usize;
            }
        }

        var rpo_pos = try col.DynBuf.[u32].init(alloc, n);
        errdefer rpo_pos.destroy(alloc);
        var i0: usize = 0_usize;
        while i0 < n {
            try rpo_pos.push(alloc, EIR_NONE);
            i0 = i0 +% 1_usize;
        }
        let rpo_len = rpo_buf.len();
        var ri: usize = 0_usize;
        while ri < rpo_len {
            let b = u32_at(&rpo_buf, ri);
            let bu = b.widen.[usize]();
            let rp_m = rpo_pos.as_mut_slice();
            if bu < rp_m.len {
                rp_m[bu] = ri.trunc.[u32]();
            }
            ri = ri +% 1_usize;
        }

        var pred_head = try col.DynBuf.[u32].init(alloc, n);
        errdefer pred_head.destroy(alloc);
        var pred_val = try col.DynBuf.[BlockId].init(alloc, n *% 2_usize +% 4_usize);
        errdefer pred_val.destroy(alloc);
        var pred_next = try col.DynBuf.[u32].init(alloc, n *% 2_usize +% 4_usize);
        errdefer pred_next.destroy(alloc);
        var i1: usize = 0_usize;
        while i1 < n {
            try pred_head.push(alloc, EIR_NONE);
            i1 = i1 +% 1_usize;
        }

        var ri2: usize = 0_usize;
        while ri2 < rpo_len {
            let u = u32_at(&rpo_buf, ri2);
            var term = term_unreachable(span.span_dummy(), false);
            if let bp = self.fn_block(fn_id, u) {
                term = bp.term;
            }
            let sc = self.term_successor_count(&term);
            var si: usize = 0_usize;
            while si < sc {
                let v = self.term_successor_at(&term, si);
                let vu = v.widen.[usize]();
                if v != EIR_NONE && vu < n {
                    var dup = false;
                    var cur = u32_at(&pred_head, vu);
                    while cur != EIR_NONE {
                        let cu = cur.widen.[usize]();
                        if u32_at(&pred_val, cu) == u {
                            dup = true;
                            break;
                        }
                        cur = u32_at(&pred_next, cu);
                    }
                    if !dup {
                        let nid = pred_val.len().trunc.[u32]();
                        let old_h = u32_at(&pred_head, vu);
                        try pred_val.push(alloc, u);
                        try pred_next.push(alloc, old_h);
                        let ph = pred_head.as_mut_slice();
                        if vu < ph.len {
                            ph[vu] = nid;
                        }
                    }
                }
                si = si +% 1_usize;
            }
            ri2 = ri2 +% 1_usize;
        }

        var tmp_preds = try col.DynBuf.[BlockId].init(alloc, 8_usize);
        errdefer tmp_preds.destroy(alloc);
        var bi: usize = 0_usize;
        while bi < n {
            tmp_preds.clear();
            var cur = u32_at(&pred_head, bi);
            while cur != EIR_NONE {
                let cu = cur.widen.[usize]();
                try tmp_preds.push(alloc, u32_at(&pred_val, cu));
                cur = u32_at(&pred_next, cu);
            }
            sort_u32_asc(tmp_preds.as_mut_slice());
            let tp_sl = tmp_preds.as_slice();
            var old_pr = ast.range_empty();
            if let b_ro = self.fn_block(fn_id, bi.trunc.[u32]()) {
                old_pr = b_ro.preds;
            }
            if tp_sl.len <= old_pr.len.widen.[usize]() {
                let p_dst = self.meta.preds.as_mut_slice();
                let p_base = old_pr.start.widen.[usize]();
                var pi_w: usize = 0_usize;
                while pi_w < tp_sl.len {
                    let pos = p_base +% pi_w;
                    if pos < p_dst.len {
                        p_dst[pos] = tp_sl[pi_w];
                    }
                    pi_w = pi_w +% 1_usize;
                }
                if let bm = self.fn_block_mut(fn_id, bi.trunc.[u32]()) {
                    bm.preds = ast.range_new(old_pr.start, tp_sl.len.trunc.[u32]());
                }
            } else {
                let pr = try self.append_preds(alloc, tp_sl);
                if let bm = self.fn_block_mut(fn_id, bi.trunc.[u32]()) {
                    bm.preds = pr;
                }
            }
            bi = bi +% 1_usize;
        }

        var idom = try col.DynBuf.[BlockId].init(alloc, n);
        errdefer idom.destroy(alloc);
        var i2: usize = 0_usize;
        while i2 < n {
            try idom.push(alloc, EIR_NONE);
            i2 = i2 +% 1_usize;
        }
        let eu = entry.widen.[usize]();
        let idom_init = idom.as_mut_slice();
        if eu < idom_init.len {
            idom_init[eu] = entry;
        }

        var changed = true;
        while changed {
            changed = false;
            var ridx: usize = 1_usize;
            while ridx < rpo_len {
                let b = u32_at(&rpo_buf, ridx);
                let bu = b.widen.[usize]();
                var new_idom = EIR_NONE;
                var cur = u32_at(&pred_head, bu);
                while cur != EIR_NONE {
                    let cu = cur.widen.[usize]();
                    let p = u32_at(&pred_val, cu);
                    let pu = p.widen.[usize]();
                    if u32_at(&idom, pu) != EIR_NONE {
                        if new_idom == EIR_NONE {
                            new_idom = p;
                        } else {
                            new_idom = intersect_rpo(idom.as_slice(), rpo_pos.as_slice(), p, new_idom);
                        }
                    }
                    cur = u32_at(&pred_next, cu);
                }
                let id_s = idom.as_mut_slice();
                if new_idom != EIR_NONE && bu < id_s.len && id_s[bu] != new_idom {
                    id_s[bu] = new_idom;
                    changed = true;
                }
                ridx = ridx +% 1_usize;
            }
        }

        var bi2: usize = 0_usize;
        while bi2 < n {
            let id_v = u32_at(&idom, bi2);
            if let bm = self.fn_block_mut(fn_id, bi2.trunc.[u32]()) {
                bm.idom = id_v;
            }
            bi2 = bi2 +% 1_usize;
        }
        var old_rpo = ast.range_empty();
        if let f_ro = self.get_fn(fn_id) {
            old_rpo = f_ro.rpo;
        }
        let rpo_sl = rpo_buf.as_slice();
        if rpo_sl.len <= old_rpo.len.widen.[usize]() {
            let r_dst = self.meta.rpo.as_mut_slice();
            let r_base = old_rpo.start.widen.[usize]();
            var ri_w: usize = 0_usize;
            while ri_w < rpo_sl.len {
                let pos = r_base +% ri_w;
                if pos < r_dst.len {
                    r_dst[pos] = rpo_sl[ri_w];
                }
                ri_w = ri_w +% 1_usize;
            }
            if let fm = self.get_fn_mut(fn_id) {
                fm.rpo = ast.range_new(old_rpo.start, rpo_sl.len.trunc.[u32]());
            }
        } else if old_rpo.len > 0_u32 && (old_rpo.start.widen.[usize]() +% old_rpo.len.widen.[usize]()) == self.meta.rpo.len() {
            let old_len_u = old_rpo.len.widen.[usize]();
            let r_base = old_rpo.start.widen.[usize]();
            let r_dst = self.meta.rpo.as_mut_slice();
            var ri_w: usize = 0_usize;
            while ri_w < old_len_u && ri_w < rpo_sl.len {
                let pos = r_base +% ri_w;
                if pos < r_dst.len {
                    r_dst[pos] = rpo_sl[ri_w];
                }
                ri_w = ri_w +% 1_usize;
            }
            var ri_p = old_len_u;
            while ri_p < rpo_sl.len {
                try self.meta.rpo.push(alloc, rpo_sl[ri_p]);
                ri_p = ri_p +% 1_usize;
            }
            if let fm = self.get_fn_mut(fn_id) {
                fm.rpo = ast.range_new(old_rpo.start, rpo_sl.len.trunc.[u32]());
            }
        } else {
            let rpo_r = try self.append_rpo(alloc, rpo_sl);
            if let fm = self.get_fn_mut(fn_id) {
                fm.rpo = rpo_r;
            }
        }

        idom.destroy(alloc);
        tmp_preds.destroy(alloc);
        pred_next.destroy(alloc);
        pred_val.destroy(alloc);
        pred_head.destroy(alloc);
        rpo_pos.destroy(alloc);
        rpo_buf.destroy(alloc);
        stack.destroy(alloc);
        visited.destroy(alloc);
        return;
    }

    /// Removes phi incoming entries whose `pred_bb` is no longer in `blk.preds` (handy after CFG pruning).
    pub fn prune_fn_phi_preds(self: *mut Self, alloc: *mut AllocCap, fn_id: u32) -> !OutOfMemory {
        var n: usize = 0_usize;
        if let f = self.get_fn(fn_id) {
            n = f.blocks.len.widen.[usize]();
        } else {
            return;
        }
        var pred_set = try col.BitSet.init(alloc, n);
        errdefer pred_set.destroy(alloc);
        var kept_in = try col.DynBuf.[EirPhiIn].init(alloc, 8_usize);
        errdefer kept_in.destroy(alloc);

        var bi: usize = 0_usize;
        while bi < n {
            let bb = bi.trunc.[u32]();
            var phis_r = ast.range_empty();
            var preds_r = ast.range_empty();
            if let bp = self.fn_block(fn_id, bb) {
                phis_r = bp.phis;
                preds_r = bp.preds;
            }
            if phis_r.len > 0_u32 {
                pred_set.clear();
                let bpreds = self.preds_slice(preds_r);
                var pri: usize = 0_usize;
                while pri < bpreds.len {
                    let pu = bpreds[pri].widen.[usize]();
                    if pu < n {
                        pred_set.set(pu);
                    }
                    pri = pri +% 1_usize;
                }
                var pi: u32 = 0_u32;
                while pi < phis_r.len {
                    let phi_gid = (phis_r.start +% pi).widen.[usize]();
                    var inc_r = ast.range_empty();
                    if let pp = self.funcs.phis.get(phi_gid) {
                        inc_r = pp.incoming;
                    }
                    kept_in.clear();
                    var changed = false;
                    var ki: u32 = 0_u32;
                    while ki < inc_r.len {
                        let igid = (inc_r.start +% ki).widen.[usize]();
                        if let ip = self.funcs.phi_in.get(igid) {
                            let entry = ip.*;
                            let pu = entry.pred_bb.widen.[usize]();
                            if pu < n && pred_set.test(pu) {
                                try kept_in.push(alloc, entry);
                            } else {
                                changed = true;
                            }
                        }
                        ki = ki +% 1_u32;
                    }
                    if changed {
                        let ks = kept_in.as_slice();
                        if ks.len <= inc_r.len.widen.[usize]() {
                            let dst_in = self.funcs.phi_in.as_mut_slice();
                            let base_in = inc_r.start.widen.[usize]();
                            var wi_in: usize = 0_usize;
                            while wi_in < ks.len {
                                let pos = base_in +% wi_in;
                                if pos < dst_in.len {
                                    dst_in[pos] = ks[wi_in];
                                }
                                wi_in = wi_in +% 1_usize;
                            }
                            if let ppm = self.funcs.phis.get_mut(phi_gid) {
                                ppm.incoming = ast.range_new(inc_r.start, ks.len.trunc.[u32]());
                            }
                        } else {
                            let new_r = try self.append_phi_incoming(alloc, ks);
                            if let ppm = self.funcs.phis.get_mut(phi_gid) {
                                ppm.incoming = new_r;
                            }
                        }
                    }
                    pi = pi +% 1_u32;
                }
            }
            bi = bi +% 1_usize;
        }

        kept_in.destroy(alloc);
        pred_set.destroy(alloc);
        return;
    }

    /// Canonical EIR dump matching `compiler/src/eir.rs::EirProgram::dump_canonical` byte-for-byte.
    pub fn dump_canonical(
        self: *Self,
        alloc: *mut AllocCap,
        env: *types.TypeEnv,
        prog: *resolve.ResolvedProgram,
        interner: *span.SymInterner,
        out: *mut str.StrBuf,
    ) -> !OutOfMemory {
        _ = prog;
        try dump_eir_program_canonical(self, alloc, env, interner, out);
        return;
    }
}

fn intersect_rpo(idom: *[BlockId], rpo_pos: *[u32], b1_in: BlockId, b2_in: BlockId) -> BlockId {
    var f1 = b1_in;
    var f2 = b2_in;
    var guard: usize = 0_usize;
    let max_steps = idom.len *% 4_usize +% 4_usize;
    while f1 != f2 && guard < max_steps {
        guard = guard +% 1_usize;
        let u1 = f1.widen.[usize]();
        let u2 = f2.widen.[usize]();
        if u1 >= rpo_pos.len || u2 >= rpo_pos.len || u1 >= idom.len || u2 >= idom.len {
            break;
        }
        let p1 = rpo_pos[u1];
        let p2 = rpo_pos[u2];
        if p1 == EIR_NONE || p2 == EIR_NONE {
            break;
        }
        if p1 > p2 {
            let next1 = idom[u1];
            if next1 == EIR_NONE || next1 == f1 {
                break;
            }
            f1 = next1;
        } else {
            let next2 = idom[u2];
            if next2 == EIR_NONE || next2 == f2 {
                break;
            }
            f2 = next2;
        }
    }
    return f1;
}

fn dominates_dense_blocks(blks: *[EirBlock], dom: BlockId, start: BlockId) -> bool {
    if dom == start {
        return true;
    }
    var cur = start;
    var steps: usize = 0_usize;
    while steps < blks.len {
        let idx = cur.widen.[usize]();
        if idx >= blks.len {
            return false;
        }
        let p = blks[idx].idom;
        if p == EIR_NONE {
            return false;
        }
        if p == dom {
            return true;
        }
        if p == cur {
            break;
        }
        cur = p;
        steps = steps +% 1_usize;
    }
    return dom == cur;
}

/// Copies program-wide tables (`extern_fns`, `dyn_impl_pairs`, `layout_shared_groups`, `scheds`)
/// from `src` into `dst`.
pub fn copy_program_globals(
    alloc: *mut AllocCap,
    src: *EirProgram,
    dst: *mut EirProgram,
) -> !OutOfMemory {
    try dst.aux.extern_fns.push_slice(alloc, src.aux.extern_fns.as_slice());
    try dst.aux.dyn_impl_pairs.push_slice(alloc, src.aux.dyn_impl_pairs.as_slice());

    let lgs = src.meta.layout_shared_groups.as_slice();
    var gi: usize = 0_usize;
    while gi < lgs.len {
        let g = lgs[gi];
        let tag_r = try dst.add_bytes(alloc, src.bytes_slice(g.layout_tag));
        let mems = src.layout_group_members(g.member_insts);
        let mem_start = dst.meta.layout_members.len().trunc.[u32]();
        var mi: usize = 0_usize;
        while mi < mems.len {
            let m = mems[mi];
            let gr = try dst.add_gvals(alloc, src.gvals_slice(m.gargs));
            try dst.meta.layout_members.push(alloc, LayoutSharedMember.{ key: m.key, gargs: gr });
            mi = mi +% 1_usize;
        }
        let mem_r = ast.range_new(mem_start, mems.len.trunc.[u32]());
        try dst.meta.layout_shared_groups.push(
            alloc,
            LayoutSharedGroup.{
                canonical_key: g.canonical_key,
                layout_tag: tag_r,
                member_insts: mem_r,
            },
        );
        gi = gi +% 1_usize;
    }

    let wave_off = dst.scheds.sched_waves.len().trunc.[u32]();
    let sys_off = dst.scheds.sched_systems.len().trunc.[u32]();
    let node_off = dst.scheds.dag_nodes.len().trunc.[u32]();
    let dep_off = dst.scheds.dag_deps.len().trunc.[u32]();

    try dst.scheds.sched_systems.push_slice(alloc, src.scheds.sched_systems.as_slice());
    try dst.scheds.dag_deps.push_slice(alloc, src.scheds.dag_deps.as_slice());

    let sws = src.scheds.sched_waves.as_slice();
    var wi: usize = 0_usize;
    while wi < sws.len {
        var w = sws[wi];
        if w.systems.len > 0_u32 {
            w.systems = ast.range_new(w.systems.start +% sys_off, w.systems.len);
        }
        try dst.scheds.sched_waves.push(alloc, w);
        wi = wi +% 1_usize;
    }

    let dns = src.scheds.dag_nodes.as_slice();
    var ni: usize = 0_usize;
    while ni < dns.len {
        var dn = dns[ni];
        if dn.deps_range.len > 0_u32 {
            dn.deps_range = ast.range_new(dn.deps_range.start +% dep_off, dn.deps_range.len);
        }
        try dst.scheds.dag_nodes.push(alloc, dn);
        ni = ni +% 1_usize;
    }

    let scs = src.scheds.schedules.as_slice();
    var si: usize = 0_usize;
    while si < scs.len {
        var sc = scs[si];
        if sc.waves.len > 0_u32 {
            sc.waves = ast.range_new(sc.waves.start +% wave_off, sc.waves.len);
        }
        if sc.nodes.len > 0_u32 {
            sc.nodes = ast.range_new(sc.nodes.start +% node_off, sc.nodes.len);
        }
        try dst.scheds.schedules.push(alloc, sc);
        si = si +% 1_usize;
    }
    return;
}

/// Deep-copies a single `EirInst` and all its sub-pool payloads from `src` into `dst`.
pub fn copy_inst_into_eir(
    alloc: *mut AllocCap,
    src: *EirProgram,
    orig: *EirInst,
    dst: *mut EirProgram,
) -> EirInst ! OutOfMemory {
    var inst = orig.*;
    match inst.kind {
        .Const => {
            if let kp = src.get_const(inst.aux0) {
                var kc = kp.*;
                if (kc.kind == .Float || kc.kind == .Str || kc.kind == .Bytes) && kc.bytes.len > 0_u32 {
                    kc.bytes = try dst.add_bytes(alloc, src.bytes_slice(kc.bytes));
                }
                inst.aux0 = try dst.add_const(alloc, kc);
            }
            _ = 0_u8;
        }
        .LoadPlace => {
            if let pp = src.get_place(inst.aux0) {
                var pl = pp.*;
                pl.projs = try dst.add_projs(alloc, src.projs_slice(pl.projs));
                inst.aux0 = try dst.add_place(alloc, pl);
            }
            _ = 0_u8;
        }
        .StorePlace => {
            if let pp = src.get_place(inst.aux0) {
                var pl = pp.*;
                pl.projs = try dst.add_projs(alloc, src.projs_slice(pl.projs));
                inst.aux0 = try dst.add_place(alloc, pl);
            }
            _ = 0_u8;
        }
        .PlaceAddr => {
            if let pp = src.get_place(inst.aux0) {
                var pl = pp.*;
                pl.projs = try dst.add_projs(alloc, src.projs_slice(pl.projs));
                inst.aux0 = try dst.add_place(alloc, pl);
            }
            _ = 0_u8;
        }
        .PoolColumnLoad => {
            if let opp = src.get_pool_col_op(inst.aux0) {
                inst.aux0 = try dst.add_pool_col_op(alloc, opp.*);
            }
            _ = 0_u8;
        }
        .PoolColumnStore => {
            if let opp = src.get_pool_col_op(inst.aux0) {
                inst.aux0 = try dst.add_pool_col_op(alloc, opp.*);
            }
            _ = 0_u8;
        }
        .Aggregate => {
            if let akp = src.get_aggregate(inst.aux0) {
                var ak = akp.*;
                if ak.field_syms.len > 0_u32 {
                    ak.field_syms = try dst.add_syms(alloc, src.syms_slice(ak.field_syms));
                }
                inst.aux0 = try dst.add_aggregate(alloc, ak);
            }
            inst.range = try dst.add_vals(alloc, src.vals_slice(inst.range));
        }
        .Call => {
            if let cdp = src.get_call(inst.aux0) {
                var cd = cdp.*;
                let new_args = try dst.add_vals(alloc, src.vals_slice(cd.args));
                cd.args = new_args;
                inst.aux0 = try dst.add_call(alloc, cd);
                inst.range = new_args;
            }
            _ = 0_u8;
        }
        .BuiltinCall => {
            if let bcp = src.get_builtin_call(inst.aux0) {
                var bc = bcp.*;
                let new_args = try dst.add_vals(alloc, src.vals_slice(bc.args));
                let new_slots = try dst.add_arg_slots(alloc, src.arg_slots_slice(bc.arg_slots));
                bc.args = new_args;
                bc.arg_slots = new_slots;
                inst.aux0 = try dst.add_builtin_call(alloc, bc);
                inst.range = new_args;
            }
            _ = 0_u8;
        }
        .InlineAsm => {
            if let adp = src.get_asm(inst.aux0) {
                var ad = adp.*;
                ad.template = try dst.add_bytes(alloc, src.bytes_slice(ad.template));
                let src_inps = src.asm_inputs_slice(ad.inputs);
                let in_start = dst.meta.asm_inputs.len().trunc.[u32]();
                var ii: usize = 0_usize;
                while ii < src_inps.len {
                    var inp = src_inps[ii];
                    inp.name = try dst.add_bytes(alloc, src.bytes_slice(inp.name));
                    try dst.meta.asm_inputs.push(alloc, inp);
                    ii = ii +% 1_usize;
                }
                ad.inputs = ast.range_new(in_start, src_inps.len.trunc.[u32]());
                inst.aux0 = try dst.add_asm(alloc, ad);
            }
            _ = 0_u8;
        }
        _ => {}
    }
    return inst;
}

pub linear struct EirCopyScratch {
    new_blks: col.DynBuf[EirBlock];
    tmp_phis: col.DynBuf[EirPhi];
    tmp_insts: col.DynBuf[EirInst];
    tmp_flags: col.DynBuf[u8];
    depths: col.DynBuf[u8];
}

impl EirCopyScratch {
    pub fn init(alloc: *mut AllocCap) -> EirCopyScratch ! OutOfMemory {
        let new_blks = try col.DynBuf.[EirBlock].init(alloc, 32_usize);
        errdefer new_blks.destroy(alloc);
        let tmp_phis = try col.DynBuf.[EirPhi].init(alloc, 16_usize);
        errdefer tmp_phis.destroy(alloc);
        let tmp_insts = try col.DynBuf.[EirInst].init(alloc, 64_usize);
        errdefer tmp_insts.destroy(alloc);
        let tmp_flags = try col.DynBuf.[u8].init(alloc, 64_usize);
        errdefer tmp_flags.destroy(alloc);
        let depths = try col.DynBuf.[u8].init(alloc, 32_usize);
        return EirCopyScratch.{
            new_blks: new_blks,
            tmp_phis: tmp_phis,
            tmp_insts: tmp_insts,
            tmp_flags: tmp_flags,
            depths: depths,
        };
    }

    pub fn destroy(self: EirCopyScratch, alloc: *mut AllocCap) {
        let EirCopyScratch.{ new_blks, tmp_phis, tmp_insts, tmp_flags, depths } = self;
        depths.destroy(alloc);
        tmp_flags.destroy(alloc);
        tmp_insts.destroy(alloc);
        tmp_phis.destroy(alloc);
        new_blks.destroy(alloc);
    }
}

fn copy_fn_body_into_eir_scratch(
    alloc: *mut AllocCap,
    src: *EirProgram,
    src_fi: u32,
    dst: *mut EirProgram,
    sc: *mut EirCopyScratch,
) -> EirFunction ! OutOfMemory {
    let fp = src.get_fn(src_fi) orelse {
        return EirFunction.{
            key: cfg_ir.fn_key_top_def(0_u32),
            mod_id: 0_u32,
            mod_name: span.SYM_EMPTY,
            impl_decl_idx: EIR_NONE,
            is_emi_stub: true,
            name: span.SYM_EMPTY,
            body_span: span.span_dummy(),
            is_sys: false,
            sig: types.FnSig.{
                has_def: false,
                def_id: 0_u32,
                module_id: 0_u32,
                name: span.SYM_EMPTY,
                is_pub: false,
                is_view: false,
                is_comptime: false,
                is_extern: false,
                generics: ast.range_empty(),
                params: ast.range_empty(),
                ret: types.TY_VOID,
                has_gpu_attr: false,
                effects: types.effect_set_empty(),
            },
            params: ast.range_empty(),
            param_names: ast.range_empty(),
            slots: ast.range_empty(),
            value_tys: ast.range_empty(),
            val_names: ast.range_empty(),
            blocks: ast.range_empty(),
            entry: 0_u32,
            rpo: ast.range_empty(),
            noalias_params: ast.range_empty(),
            value_ranges: ast.range_empty(),
            value_facts: ast.range_empty(),
            proven_safe_insts: ast.range_empty(),
            where_clauses: ast.range_empty(),
            ensures_clauses: ast.range_empty(),
            loop_invariants: ast.range_empty(),
            has_base_generic: false,
            base_generic_key: cfg_ir.fn_key_top_def(0_u32),
            base_generic_args: ast.range_empty(),
            has_layout_shared_tag: false,
            layout_shared_tag: ast.range_empty(),
            par_for_regions: ast.range_empty(),
        };
    };
    var f = fp.*;

    let p_start = dst.funcs.param_vals.len().trunc.[u32]();
    let src_params = src.fn_params(src_fi);
    try dst.funcs.param_vals.push_slice(alloc, src_params);
    f.params = ast.range_new(p_start, src_params.len.trunc.[u32]());

    f.param_names = try dst.add_syms(alloc, src.fn_param_names(src_fi));

    let s_start = dst.funcs.slots.len().trunc.[u32]();
    let src_slots = src.fn_slots(src_fi);
    try dst.funcs.slots.push_slice(alloc, src_slots);
    f.slots = ast.range_new(s_start, src_slots.len.trunc.[u32]());

    f.value_tys = try dst.append_value_tys(alloc, src.fn_value_tys(src_fi));

    let vn_start = dst.meta.val_names.len().trunc.[u32]();
    let src_vns = src.fn_val_names(src_fi);
    try dst.meta.val_names.push_slice(alloc, src_vns);
    f.val_names = ast.range_new(vn_start, src_vns.len.trunc.[u32]());

    f.rpo = try dst.append_rpo(alloc, src.fn_rpo(src_fi));

    let na_start = dst.meta.noalias_params.len().trunc.[u32]();
    let src_na = src.fn_noalias_params(src_fi);
    try dst.meta.noalias_params.push_slice(alloc, src_na);
    f.noalias_params = ast.range_new(na_start, src_na.len.trunc.[u32]());

    let vr_start = dst.meta.value_ranges.len().trunc.[u32]();
    let src_vr = src.fn_value_ranges(src_fi);
    try dst.meta.value_ranges.push_slice(alloc, src_vr);
    f.value_ranges = ast.range_new(vr_start, src_vr.len.trunc.[u32]());

    let vf_start = dst.value_facts.len().trunc.[u32]();
    let src_vf = src.fn_value_facts(src_fi);
    try dst.value_facts.push_slice(alloc, src_vf);
    f.value_facts = ast.range_new(vf_start, src_vf.len.trunc.[u32]());

    let ps_start = dst.meta.proven_safe_insts.len().trunc.[u32]();
    let src_ps = src.fn_proven_safe_insts(src_fi);
    try dst.meta.proven_safe_insts.push_slice(alloc, src_ps);
    f.proven_safe_insts = ast.range_new(ps_start, src_ps.len.trunc.[u32]());

    f.where_clauses = try dst.add_expr_ids(alloc, src.fn_where_clauses(src_fi));
    f.ensures_clauses = try dst.add_expr_ids(alloc, src.fn_ensures_clauses(src_fi));

    let src_invs = src.fn_loop_invariants(src_fi);
    let inv_start = dst.aux.loop_invariants.len().trunc.[u32]();
    var invi: usize = 0_usize;
    while invi < src_invs.len {
        let inv = src_invs[invi];
        let er = try dst.add_expr_ids(alloc, src.expr_ids_slice(inv.exprs));
        try dst.aux.loop_invariants.push(alloc, cfg_ir.LoopInvariantEntry.{ block_id: inv.block_id, exprs: er });
        invi = invi +% 1_usize;
    }
    f.loop_invariants = ast.range_new(inv_start, src_invs.len.trunc.[u32]());

    if f.has_base_generic {
        f.base_generic_args = try dst.add_gvals(alloc, src.fn_base_generic_args(src_fi));
    } else {
        f.base_generic_args = ast.range_empty();
    }

    if f.has_layout_shared_tag {
        f.layout_shared_tag = try dst.add_bytes(alloc, src.bytes_slice(f.layout_shared_tag));
    } else {
        f.layout_shared_tag = ast.range_empty();
    }

    let pf_start = dst.meta.par_for_regions.len().trunc.[u32]();
    let src_pf = src.fn_par_for_regions(src_fi);
    try dst.meta.par_for_regions.push_slice(alloc, src_pf);
    f.par_for_regions = ast.range_new(pf_start, src_pf.len.trunc.[u32]());

    let src_blks = src.fn_blocks(src_fi);
    sc.new_blks.clear();
    sc.depths.clear();
    var bi: usize = 0_usize;
    while bi < src_blks.len {
        let ob = src_blks[bi];
        var nb = copy ob;

        sc.tmp_phis.clear();
        let ophis = src.phis_slice(ob.phis);
        var pi: usize = 0_usize;
        while pi < ophis.len {
            var ph = ophis[pi];
            ph.incoming = try dst.append_phi_incoming(alloc, src.phi_incoming(ph.incoming));
            try sc.tmp_phis.push(alloc, ph);
            pi = pi +% 1_usize;
        }
        nb.phis = try dst.append_phis(alloc, sc.tmp_phis.as_slice());

        sc.tmp_insts.clear();
        sc.tmp_flags.clear();
        let oinsts = src.insts_slice(ob.insts);
        var has_any_flag = false;
        var ii: usize = 0_usize;
        while ii < oinsts.len {
            let ci = try copy_inst_into_eir(alloc, src, &oinsts[ii], dst);
            let fl = src.inst_proven_flags(ob.insts.start +% ii.trunc.[u32]());
            if fl != 0_u8 {
                has_any_flag = true;
            }
            try sc.tmp_insts.push(alloc, ci);
            try sc.tmp_flags.push(alloc, fl);
            ii = ii +% 1_usize;
        }
        nb.insts = try dst.append_insts(alloc, sc.tmp_insts.as_slice());
        if has_any_flag {
            let fls = sc.tmp_flags.as_slice();
            var fi_fl: usize = 0_usize;
            while fi_fl < fls.len {
                if fls[fi_fl] != 0_u8 {
                    try dst.set_inst_proven_flags(alloc, nb.insts.start +% fi_fl.trunc.[u32](), fls[fi_fl]);
                }
                fi_fl = fi_fl +% 1_usize;
            }
        }

        if nb.term.kind == .SwitchInt {
            nb.term.targets = try dst.add_switch_targets(alloc, src.switch_targets_slice(ob.term.targets));
        }

        let pr_start = dst.meta.preds.len().trunc.[u32]();
        let src_pr = src.preds_slice(ob.preds);
        try dst.meta.preds.push_slice(alloc, src_pr);
        nb.preds = ast.range_new(pr_start, src_pr.len.trunc.[u32]());

        try sc.new_blks.push(alloc, nb);
        try sc.depths.push(alloc, src.block_depth(src_fi, bi.trunc.[u32]()));
        bi = bi +% 1_usize;
    }

    f.blocks = try dst.append_blocks(alloc, sc.new_blks.as_slice());
    return f;
}

/// Deep-copies function `src_fi` from `src` into `dst` using reusable scratch buffers.
pub fn copy_fn_into_eir_scratch(
    alloc: *mut AllocCap,
    src: *EirProgram,
    src_fi: u32,
    dst: *mut EirProgram,
    sc: *mut EirCopyScratch,
) -> u32 ! OutOfMemory {
    let nf = try copy_fn_body_into_eir_scratch(alloc, src, src_fi, dst, sc);
    let dst_fi = try dst.add_fn(alloc, nf);
    let ds = sc.depths.as_slice();
    var bi: usize = 0_usize;
    while bi < ds.len {
        if ds[bi] != 0_u8 {
            try dst.set_block_depth(alloc, dst_fi, bi.trunc.[u32](), ds[bi]);
        }
        bi = bi +% 1_usize;
    }
    if src.fn_has_ipra(src_fi) {
        try dst.set_fn_ipra(alloc, dst_fi, src.fn_ipra_gprs(src_fi), src.fn_ipra_xmms(src_fi));
    }
    let oe = src.fn_opt_eligible(src_fi);
    if oe != 0_u8 {
        try dst.set_fn_opt_eligible(alloc, dst_fi, oe);
    }
    return dst_fi;
}

/// Deep-copies function `src_fi` from `src` into `dst` as a new compacted function, returning its new `fn_id`.
pub fn copy_fn_into_eir(
    alloc: *mut AllocCap,
    src: *EirProgram,
    src_fi: u32,
    dst: *mut EirProgram,
) -> u32 ! OutOfMemory {
    var sc = try EirCopyScratch.init(alloc);
    errdefer sc.destroy(alloc);
    let dst_fi = try copy_fn_into_eir_scratch(alloc, src, src_fi, dst, &mut sc);
    sc.destroy(alloc);
    return dst_fi;
}

/// Deep-copies function `src_fi` from `src` and overwrites existing slot `dst_fi` in `dst` using reusable scratch.
pub fn overwrite_fn_from_eir_scratch(
    alloc: *mut AllocCap,
    src: *EirProgram,
    src_fi: u32,
    dst: *mut EirProgram,
    dst_fi: u32,
    sc: *mut EirCopyScratch,
) -> !OutOfMemory {
    let nf = try copy_fn_body_into_eir_scratch(alloc, src, src_fi, dst, sc);
    if let fm = dst.get_fn_mut(dst_fi) {
        fm.* = nf;
    }
    let ds = sc.depths.as_slice();
    var bi: usize = 0_usize;
    while bi < ds.len {
        if ds[bi] != 0_u8 {
            try dst.set_block_depth(alloc, dst_fi, bi.trunc.[u32](), ds[bi]);
        }
        bi = bi +% 1_usize;
    }
    if src.fn_has_ipra(src_fi) {
        try dst.set_fn_ipra(alloc, dst_fi, src.fn_ipra_gprs(src_fi), src.fn_ipra_xmms(src_fi));
    }
    let oe = src.fn_opt_eligible(src_fi);
    if oe != 0_u8 {
        try dst.set_fn_opt_eligible(alloc, dst_fi, oe);
    }
    return;
}

/// Deep-copies function `src_fi` from `src` and overwrites existing slot `dst_fi` in `dst`
/// (preserving `dst_fi` and `dst.funcs.by_key`).
pub fn overwrite_fn_from_eir(
    alloc: *mut AllocCap,
    src: *EirProgram,
    src_fi: u32,
    dst: *mut EirProgram,
    dst_fi: u32,
) -> !OutOfMemory {
    var sc = try EirCopyScratch.init(alloc);
    errdefer sc.destroy(alloc);
    try overwrite_fn_from_eir_scratch(alloc, src, src_fi, dst, dst_fi, &mut sc);
    sc.destroy(alloc);
    return;
}

// ===========================================================================
// Section 3: CFG -> SSA EIR Lowering (RPO, Dominators, Frontiers, Mem2Reg)
// ===========================================================================

@recursive
fn ty_has_generic_param(id: types.TyId, env: *types.TypeEnv) -> bool {
    let n = env.get(id);
    match n.kind {
        .GenericParam => { return true; }
        .Optional => { return ty_has_generic_param(n.primary, env); }
        .RawPtr => { return ty_has_generic_param(n.primary, env); }
        .Array => { return ty_has_generic_param(n.primary, env); }
        .ErrorUnion => { return ty_has_generic_param(n.primary, env); }
        .Borrow => {
            if n.borrow_kind == .Single || n.borrow_kind == .Slice {
                return ty_has_generic_param(n.primary, env);
            }
            return false;
        }
        .Tuple => {
            let es = env.node_ty_list(&n);
            var i: usize = 0_usize;
            while i < es.len {
                if ty_has_generic_param(es[i], env) {
                    return true;
                }
                i = i +% 1_usize;
            }
            return false;
        }
        .Builtin => {
            let args = env.node_gval_list(&n);
            var i: usize = 0_usize;
            while i < args.len {
                if args[i].kind == .Ty && ty_has_generic_param(args[i].id, env) {
                    return true;
                }
                i = i +% 1_usize;
            }
            return false;
        }
        _ => { return false; }
    }
}

fn sig_has_generic_param(sig: *types.FnSig, env: *types.TypeEnv) -> bool {
    let ps = env.params_range(sig.params);
    var i: usize = 0_usize;
    while i < ps.len {
        if ty_has_generic_param(ps[i].ty, env) {
            return true;
        }
        i = i +% 1_usize;
    }
    return ty_has_generic_param(sig.ret, env);
}

fn is_ssa_promotable_ty(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let n = env.get(ty);
    match n.kind {
        .Void => { return false; }
        .Never => { return false; }
        .Bool => { return true; }
        .Char => { return true; }
        .Int => { return true; }
        .Float => { return true; }
        .PhysAddr => { return true; }
        .VirtAddr => { return true; }
        .DmaAddr => { return true; }
        .Enum => { return true; }
        .ErrorSet => { return true; }
        .FnPtr => { return true; }
        .Borrow => { return true; }
        .RawPtr => { return true; }
        .Str => { return true; }
        .Builtin => {
            return n.builtin_kind == .IdBrand
                || n.builtin_kind == .GenId
                || n.builtin_kind == .Link
                || n.builtin_kind == .Ordering;
        }
        .Optional => {
            let inn = env.get(n.primary);
            if inn.kind == .Builtin {
                return inn.builtin_kind == .IdBrand
                    || inn.builtin_kind == .GenId
                    || inn.builtin_kind == .Link;
            }
            return false;
        }
        _ => { return false; }
    }
}

struct TmpPhi {
    dst: EirValue;
    ty: types.TyId;
    owner_local: u32;
    in_head: u32;
    in_tail: u32;
    in_len: u32;
}

struct RpoFrame {
    bb: BlockId;
    next_succ: usize;
}

struct RenameFrame {
    bb: BlockId;
    next_child_node: u32;
    pushed_start: usize;
    entered: bool;
}

linear struct FnLowerCore {
    orig_to_dense: col.DynBuf[u32];
    post: col.DynBuf[BlockId];
    slot_of: col.DynBuf[EirSlot];
    is_promoted: col.BitSet;
    slots: col.DynBuf[EirSlotInfo];
    value_tys: col.DynBuf[types.TyId];
    val_names: col.DynBuf[u32];
    params: col.DynBuf[EirValue];
    terms: col.DynBuf[EirTerm];
}

impl FnLowerCore {
    fn init(alloc: *mut AllocCap, n_orig: usize, n_locals: usize) -> FnLowerCore ! OutOfMemory {
        let cap_b = if n_orig < 4_usize { 4_usize } else { n_orig };
        let cap_l = if n_locals < 4_usize { 4_usize } else { n_locals };
        var orig_to_dense = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer orig_to_dense.destroy(alloc);
        var i: usize = 0_usize;
        while i < n_orig {
            try orig_to_dense.push(alloc, EIR_NONE);
            i = i +% 1_usize;
        }
        let post = try col.DynBuf.[BlockId].init(alloc, cap_b);
        errdefer post.destroy(alloc);
        var slot_of = try col.DynBuf.[EirSlot].init(alloc, cap_l);
        errdefer slot_of.destroy(alloc);
        var j: usize = 0_usize;
        while j < n_locals {
            try slot_of.push(alloc, EIR_NONE);
            j = j +% 1_usize;
        }
        let is_promoted = try col.BitSet.init(alloc, n_locals);
        errdefer is_promoted.destroy(alloc);
        let slots = try col.DynBuf.[EirSlotInfo].init(alloc, 16_usize);
        errdefer slots.destroy(alloc);
        let value_tys = try col.DynBuf.[types.TyId].init(alloc, 64_usize);
        errdefer value_tys.destroy(alloc);
        let val_names = try col.DynBuf.[u32].init(alloc, 64_usize);
        errdefer val_names.destroy(alloc);
        let params = try col.DynBuf.[EirValue].init(alloc, 8_usize);
        errdefer params.destroy(alloc);
        let terms = try col.DynBuf.[EirTerm].init(alloc, cap_b);
        errdefer terms.destroy(alloc);
        return FnLowerCore.{
            orig_to_dense: orig_to_dense,
            post: post,
            slot_of: slot_of,
            is_promoted: is_promoted,
            slots: slots,
            value_tys: value_tys,
            val_names: val_names,
            params: params,
            terms: terms,
        };
    }

    fn destroy(self: FnLowerCore, alloc: *mut AllocCap) {
        let FnLowerCore.{
            orig_to_dense,
            post,
            slot_of,
            is_promoted,
            slots,
            value_tys,
            val_names,
            params,
            terms,
        } = self;
        orig_to_dense.destroy(alloc);
        post.destroy(alloc);
        slot_of.destroy(alloc);
        is_promoted.destroy(alloc);
        slots.destroy(alloc);
        value_tys.destroy(alloc);
        val_names.destroy(alloc);
        params.destroy(alloc);
        terms.destroy(alloc);
    }
}

linear struct FnInstLists {
    insts: col.DynBuf[EirInst];
    next: col.DynBuf[u32];
    head: col.DynBuf[u32];
    tail: col.DynBuf[u32];
}

impl FnInstLists {
    fn init(alloc: *mut AllocCap, n_blocks: usize) -> FnInstLists ! OutOfMemory {
        let cap_b = if n_blocks < 4_usize { 4_usize } else { n_blocks };
        let insts = try col.DynBuf.[EirInst].init(alloc, 64_usize);
        errdefer insts.destroy(alloc);
        let next = try col.DynBuf.[u32].init(alloc, 64_usize);
        errdefer next.destroy(alloc);
        var head = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer head.destroy(alloc);
        var tail = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer tail.destroy(alloc);
        var i: usize = 0_usize;
        while i < n_blocks {
            try head.push(alloc, EIR_NONE);
            try tail.push(alloc, EIR_NONE);
            i = i +% 1_usize;
        }
        return FnInstLists.{ insts: insts, next: next, head: head, tail: tail };
    }

    fn push_block_inst(
        self: *mut Self,
        alloc: *mut AllocCap,
        bb: BlockId,
        inst: EirInst,
    ) -> !OutOfMemory {
        let bi = bb.widen.[usize]();
        let nid = self.insts.len().trunc.[u32]();
        try self.insts.push(alloc, inst);
        try self.next.push(alloc, EIR_NONE);
        let heads = self.head.as_mut_slice();
        let tails = self.tail.as_mut_slice();
        if bi < heads.len && bi < tails.len {
            let prev_tail = tails[bi];
            if prev_tail == EIR_NONE {
                heads[bi] = nid;
                tails[bi] = nid;
            } else {
                let pt = prev_tail.widen.[usize]();
                let nx = self.next.as_mut_slice();
                if pt < nx.len {
                    nx[pt] = nid;
                }
                tails[bi] = nid;
            }
        }
        return;
    }

    fn destroy(self: FnInstLists, alloc: *mut AllocCap) {
        let FnInstLists.{ insts, next, head, tail } = self;
        insts.destroy(alloc);
        next.destroy(alloc);
        head.destroy(alloc);
        tail.destroy(alloc);
    }
}

linear struct FnPhiLists {
    phis: col.DynBuf[TmpPhi];
    phi_next: col.DynBuf[u32];
    blk_head: col.DynBuf[u32];
    blk_tail: col.DynBuf[u32];
    phi_in: col.DynBuf[EirPhiIn];
    phi_in_next: col.DynBuf[u32];
}

impl FnPhiLists {
    fn init(alloc: *mut AllocCap, n_blocks: usize) -> FnPhiLists ! OutOfMemory {
        let cap_b = if n_blocks < 4_usize { 4_usize } else { n_blocks };
        let phis = try col.DynBuf.[TmpPhi].init(alloc, 16_usize);
        errdefer phis.destroy(alloc);
        let phi_next = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer phi_next.destroy(alloc);
        var blk_head = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer blk_head.destroy(alloc);
        var blk_tail = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer blk_tail.destroy(alloc);
        var i: usize = 0_usize;
        while i < n_blocks {
            try blk_head.push(alloc, EIR_NONE);
            try blk_tail.push(alloc, EIR_NONE);
            i = i +% 1_usize;
        }
        let phi_in = try col.DynBuf.[EirPhiIn].init(alloc, 32_usize);
        errdefer phi_in.destroy(alloc);
        let phi_in_next = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer phi_in_next.destroy(alloc);
        return FnPhiLists.{
            phis: phis,
            phi_next: phi_next,
            blk_head: blk_head,
            blk_tail: blk_tail,
            phi_in: phi_in,
            phi_in_next: phi_in_next,
        };
    }

    fn add_phi(
        self: *mut Self,
        alloc: *mut AllocCap,
        bb: BlockId,
        dst: EirValue,
        ty: types.TyId,
        owner_local: u32,
    ) -> !OutOfMemory {
        let bi = bb.widen.[usize]();
        let pid = self.phis.len().trunc.[u32]();
        try self.phis.push(
            alloc,
            TmpPhi.{
                dst: dst,
                ty: ty,
                owner_local: owner_local,
                in_head: EIR_NONE,
                in_tail: EIR_NONE,
                in_len: 0_u32,
            },
        );
        try self.phi_next.push(alloc, EIR_NONE);
        let heads = self.blk_head.as_mut_slice();
        let tails = self.blk_tail.as_mut_slice();
        if bi < heads.len && bi < tails.len {
            let pt = tails[bi];
            if pt == EIR_NONE {
                heads[bi] = pid;
                tails[bi] = pid;
            } else {
                let ptu = pt.widen.[usize]();
                let nx = self.phi_next.as_mut_slice();
                if ptu < nx.len {
                    nx[ptu] = pid;
                }
                tails[bi] = pid;
            }
        }
        return;
    }

    fn add_phi_in(
        self: *mut Self,
        alloc: *mut AllocCap,
        phi_idx: u32,
        pred_bb: BlockId,
        val: EirValue,
    ) -> !OutOfMemory {
        let nid = self.phi_in.len().trunc.[u32]();
        try self.phi_in.push(alloc, EirPhiIn.{ pred_bb: pred_bb, val: val });
        try self.phi_in_next.push(alloc, EIR_NONE);
        let p_u = phi_idx.widen.[usize]();
        let ps = self.phis.as_mut_slice();
        if p_u < ps.len {
            let prev = ps[p_u].in_tail;
            if prev == EIR_NONE {
                ps[p_u].in_head = nid;
                ps[p_u].in_tail = nid;
            } else {
                let pr_u = prev.widen.[usize]();
                let nx = self.phi_in_next.as_mut_slice();
                if pr_u < nx.len {
                    nx[pr_u] = nid;
                }
                ps[p_u].in_tail = nid;
            }
            ps[p_u].in_len = ps[p_u].in_len +% 1_u32;
        }
        return;
    }

    fn destroy(self: FnPhiLists, alloc: *mut AllocCap) {
        let FnPhiLists.{ phis, phi_next, blk_head, blk_tail, phi_in, phi_in_next } = self;
        phis.destroy(alloc);
        phi_next.destroy(alloc);
        blk_head.destroy(alloc);
        blk_tail.destroy(alloc);
        phi_in.destroy(alloc);
        phi_in_next.destroy(alloc);
    }
}

linear struct FnDomGraph {
    preds_head: col.DynBuf[u32];
    preds_tail: col.DynBuf[u32];
    preds_len: col.DynBuf[u32];
    preds_val: col.DynBuf[BlockId];
    preds_next: col.DynBuf[u32];
    idom: col.DynBuf[BlockId];
    df_head: col.DynBuf[u32];
    df_val: col.DynBuf[BlockId];
    df_next: col.DynBuf[u32];
    dom_ch_head: col.DynBuf[u32];
}

impl FnDomGraph {
    fn init(alloc: *mut AllocCap, n_blocks: usize) -> FnDomGraph ! OutOfMemory {
        let cap_b = if n_blocks < 4_usize { 4_usize } else { n_blocks };
        var preds_head = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer preds_head.destroy(alloc);
        var preds_tail = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer preds_tail.destroy(alloc);
        var preds_len = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer preds_len.destroy(alloc);
        let preds_val = try col.DynBuf.[BlockId].init(alloc, cap_b *% 2_usize);
        errdefer preds_val.destroy(alloc);
        let preds_next = try col.DynBuf.[u32].init(alloc, cap_b *% 2_usize);
        errdefer preds_next.destroy(alloc);
        var idom = try col.DynBuf.[BlockId].init(alloc, cap_b);
        errdefer idom.destroy(alloc);
        var df_head = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer df_head.destroy(alloc);
        let df_val = try col.DynBuf.[BlockId].init(alloc, cap_b);
        errdefer df_val.destroy(alloc);
        let df_next = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer df_next.destroy(alloc);
        var dom_ch_head = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer dom_ch_head.destroy(alloc);
        var i: usize = 0_usize;
        while i < n_blocks {
            try preds_head.push(alloc, EIR_NONE);
            try preds_tail.push(alloc, EIR_NONE);
            try preds_len.push(alloc, 0_u32);
            try idom.push(alloc, EIR_NONE);
            try df_head.push(alloc, EIR_NONE);
            try dom_ch_head.push(alloc, EIR_NONE);
            i = i +% 1_usize;
        }
        return FnDomGraph.{
            preds_head: preds_head,
            preds_tail: preds_tail,
            preds_len: preds_len,
            preds_val: preds_val,
            preds_next: preds_next,
            idom: idom,
            df_head: df_head,
            df_val: df_val,
            df_next: df_next,
            dom_ch_head: dom_ch_head,
        };
    }

    fn add_pred_unique(
        self: *mut Self,
        alloc: *mut AllocCap,
        target_bb: BlockId,
        pred_bb: BlockId,
    ) -> !OutOfMemory {
        let ti = target_bb.widen.[usize]();
        if ti >= self.preds_head.len() {
            return;
        }
        var cur = u32_at(&self.preds_head, ti);
        let pvals = self.preds_val.as_slice();
        let pnext = self.preds_next.as_slice();
        while cur != EIR_NONE {
            let cu = cur.widen.[usize]();
            if cu >= pvals.len || cu >= pnext.len {
                break;
            }
            if pvals[cu] == pred_bb {
                return;
            }
            cur = pnext[cu];
        }
        let nid = self.preds_val.len().trunc.[u32]();
        try self.preds_val.push(alloc, pred_bb);
        try self.preds_next.push(alloc, EIR_NONE);
        let heads = self.preds_head.as_mut_slice();
        let tails = self.preds_tail.as_mut_slice();
        let lens = self.preds_len.as_mut_slice();
        if ti < heads.len && ti < tails.len && ti < lens.len {
            let pt = tails[ti];
            if pt == EIR_NONE {
                heads[ti] = nid;
                tails[ti] = nid;
            } else {
                tails[ti] = nid;
                let ptu = pt.widen.[usize]();
                let nx = self.preds_next.as_mut_slice();
                if ptu < nx.len {
                    nx[ptu] = nid;
                }
            }
            lens[ti] = lens[ti] +% 1_u32;
        }
        return;
    }

    fn add_df_unique(
        self: *mut Self,
        alloc: *mut AllocCap,
        runner_bb: BlockId,
        frontier_bb: BlockId,
    ) -> !OutOfMemory {
        let ri = runner_bb.widen.[usize]();
        if ri >= self.df_head.len() {
            return;
        }
        var cur = u32_at(&self.df_head, ri);
        let dvals = self.df_val.as_slice();
        let dnext = self.df_next.as_slice();
        while cur != EIR_NONE {
            let cu = cur.widen.[usize]();
            if cu >= dvals.len || cu >= dnext.len {
                break;
            }
            if dvals[cu] == frontier_bb {
                return;
            }
            cur = dnext[cu];
        }
        let prev = u32_at(&self.df_head, ri);
        let nid = self.df_val.len().trunc.[u32]();
        try self.df_val.push(alloc, frontier_bb);
        try self.df_next.push(alloc, prev);
        let heads = self.df_head.as_mut_slice();
        if ri < heads.len {
            heads[ri] = nid;
        }
        return;
    }

    fn destroy(self: FnDomGraph, alloc: *mut AllocCap) {
        let FnDomGraph.{
            preds_head,
            preds_tail,
            preds_len,
            preds_val,
            preds_next,
            idom,
            df_head,
            df_val,
            df_next,
            dom_ch_head,
        } = self;
        preds_head.destroy(alloc);
        preds_tail.destroy(alloc);
        preds_len.destroy(alloc);
        preds_val.destroy(alloc);
        preds_next.destroy(alloc);
        idom.destroy(alloc);
        df_head.destroy(alloc);
        df_val.destroy(alloc);
        df_next.destroy(alloc);
        dom_ch_head.destroy(alloc);
    }
}

linear struct FnRenamePools {
    dom_ch_tail: col.DynBuf[u32];
    dom_ch_val: col.DynBuf[BlockId];
    dom_ch_next: col.DynBuf[u32];
    stack_head: col.DynBuf[u32];
    stack_val: col.DynBuf[EirValue];
    stack_prev: col.DynBuf[u32];
    val_remap: col.DynBuf[EirValue];
}

impl FnRenamePools {
    fn init(alloc: *mut AllocCap, n_blocks: usize, n_locals: usize) -> FnRenamePools ! OutOfMemory {
        let cap_b = if n_blocks < 4_usize { 4_usize } else { n_blocks };
        let cap_l = if n_locals < 4_usize { 4_usize } else { n_locals };
        var dom_ch_tail = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer dom_ch_tail.destroy(alloc);
        var i: usize = 0_usize;
        while i < n_blocks {
            try dom_ch_tail.push(alloc, EIR_NONE);
            i = i +% 1_usize;
        }
        let dom_ch_val = try col.DynBuf.[BlockId].init(alloc, cap_b);
        errdefer dom_ch_val.destroy(alloc);
        let dom_ch_next = try col.DynBuf.[u32].init(alloc, cap_b);
        errdefer dom_ch_next.destroy(alloc);
        var stack_head = try col.DynBuf.[u32].init(alloc, cap_l);
        errdefer stack_head.destroy(alloc);
        var j: usize = 0_usize;
        while j < n_locals {
            try stack_head.push(alloc, EIR_NONE);
            j = j +% 1_usize;
        }
        let stack_val = try col.DynBuf.[EirValue].init(alloc, cap_l *% 2_usize);
        errdefer stack_val.destroy(alloc);
        let stack_prev = try col.DynBuf.[u32].init(alloc, cap_l *% 2_usize);
        errdefer stack_prev.destroy(alloc);
        let val_remap = try col.DynBuf.[EirValue].init(alloc, 64_usize);
        errdefer val_remap.destroy(alloc);
        return FnRenamePools.{
            dom_ch_tail: dom_ch_tail,
            dom_ch_val: dom_ch_val,
            dom_ch_next: dom_ch_next,
            stack_head: stack_head,
            stack_val: stack_val,
            stack_prev: stack_prev,
            val_remap: val_remap,
        };
    }

    fn stack_push(
        self: *mut Self,
        alloc: *mut AllocCap,
        lid: cfg_ir.LocalId,
        val: EirValue,
    ) -> !OutOfMemory {
        let li = lid.widen.[usize]();
        if li >= self.stack_head.len() {
            return;
        }
        let prev = u32_at(&self.stack_head, li);
        let nid = self.stack_val.len().trunc.[u32]();
        try self.stack_val.push(alloc, val);
        try self.stack_prev.push(alloc, prev);
        let heads = self.stack_head.as_mut_slice();
        if li < heads.len {
            heads[li] = nid;
        }
        return;
    }

    fn stack_peek(self: *Self, lid: cfg_ir.LocalId, fallback: EirValue) -> EirValue {
        let li = lid.widen.[usize]();
        let heads = self.stack_head.as_slice();
        if li >= heads.len {
            return fallback;
        }
        let top = heads[li];
        if top == EIR_NONE {
            return fallback;
        }
        let tu = top.widen.[usize]();
        let vals = self.stack_val.as_slice();
        if tu < vals.len {
            return vals[tu];
        }
        return fallback;
    }

    fn stack_pop(self: *mut Self, lid: cfg_ir.LocalId) {
        let li = lid.widen.[usize]();
        let heads = self.stack_head.as_mut_slice();
        if li >= heads.len {
            return;
        }
        let top = heads[li];
        if top == EIR_NONE {
            return;
        }
        let tu = top.widen.[usize]();
        let prevs = self.stack_prev.as_slice();
        if tu < prevs.len {
            heads[li] = prevs[tu];
        }
    }

    fn destroy(self: FnRenamePools, alloc: *mut AllocCap) {
        let FnRenamePools.{
            dom_ch_tail,
            dom_ch_val,
            dom_ch_next,
            stack_head,
            stack_val,
            stack_prev,
            val_remap,
        } = self;
        dom_ch_tail.destroy(alloc);
        dom_ch_val.destroy(alloc);
        dom_ch_next.destroy(alloc);
        stack_head.destroy(alloc);
        stack_val.destroy(alloc);
        stack_prev.destroy(alloc);
        val_remap.destroy(alloc);
    }
}

linear struct LowerFnCtx {
    fn_id: u32;
    core: FnLowerCore;
    insts: FnInstLists;
    phis: FnPhiLists;
    dom: FnDomGraph;
    ren: FnRenamePools;
}

impl LowerFnCtx {
    fn new_val(self: *mut Self, alloc: *mut AllocCap, ty: types.TyId) -> EirValue ! OutOfMemory {
        let id = self.core.value_tys.len().trunc.[u32]();
        try self.core.value_tys.push(alloc, ty);
        try self.core.val_names.push(alloc, EIR_NONE);
        return id;
    }

    fn map_bb(self: *Self, orig: BlockId) -> BlockId {
        let oi = orig.widen.[usize]();
        let map = self.core.orig_to_dense.as_slice();
        if oi < map.len {
            let mapped = map[oi];
            if mapped != EIR_NONE {
                return mapped;
            }
        }
        return 0_u32;
    }

    fn slot_of_local(self: *Self, lid: cfg_ir.LocalId) -> EirSlot {
        let li = lid.widen.[usize]();
        let s = self.core.slot_of.as_slice();
        if li < s.len {
            return s[li];
        }
        return EIR_NONE;
    }

    fn is_local_promoted(self: *Self, lid: cfg_ir.LocalId) -> bool {
        return self.core.is_promoted.test(lid.widen.[usize]());
    }

    fn destroy(self: LowerFnCtx, alloc: *mut AllocCap) {
        let LowerFnCtx.{ fn_id: _, core, insts, phis, dom, ren } = self;
        core.destroy(alloc);
        insts.destroy(alloc);
        phis.destroy(alloc);
        dom.destroy(alloc);
        ren.destroy(alloc);
    }
}

fn compute_rpo(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    fn_id: u32,
    entry: BlockId,
    n_orig: usize,
    core: *mut FnLowerCore,
) -> !OutOfMemory {
    if n_orig == 0_usize || entry.widen.[usize]() >= n_orig {
        return;
    }
    var visited = try col.BitSet.init(alloc, n_orig);
    errdefer visited.destroy(alloc);
    var stack = try col.DynBuf.[RpoFrame].init(alloc, 32_usize);
    errdefer stack.destroy(alloc);

    visited.set(entry.widen.[usize]());
    try stack.push(alloc, RpoFrame.{ bb: entry, next_succ: 0_usize });

    while !stack.is_empty() {
        let top_idx = stack.len() -% 1_usize;
        var u: BlockId = 0_u32;
        var sidx: usize = 0_usize;
        if let f = stack.get(top_idx) {
            u = f.bb;
            sidx = f.next_succ;
        }
        let sc = cfg.block_successor_count(fn_id, u);
        if sidx < sc {
            if let fm = stack.get_mut(top_idx) {
                fm.next_succ = sidx +% 1_usize;
            }
            let v = cfg.block_successor_at(fn_id, u, sidx);
            let vu = v.widen.[usize]();
            if vu < n_orig && !visited.test(vu) {
                visited.set(vu);
                try stack.push(alloc, RpoFrame.{ bb: v, next_succ: 0_usize });
            }
        } else {
            _ = stack.pop();
            try core.post.push(alloc, u);
        }
    }

    // Reverse postorder in-place.
    let ps = core.post.as_mut_slice();
    var lo: usize = 0_usize;
    if ps.len > 1_usize {
        var hi = ps.len -% 1_usize;
        while lo < hi {
            let tmp = ps[lo];
            ps[lo] = ps[hi];
            ps[hi] = tmp;
            lo = lo +% 1_usize;
            hi = hi -% 1_usize;
        }
    }

    let post_ro = core.post.as_slice();
    let o2d = core.orig_to_dense.as_mut_slice();
    var bi: usize = 0_usize;
    while bi < post_ro.len {
        let ob = post_ro[bi].widen.[usize]();
        if ob < o2d.len {
            o2d[ob] = bi.trunc.[u32]();
        }
        bi = bi +% 1_usize;
    }

    stack.destroy(alloc);
    visited.destroy(alloc);
    return;
}

fn mark_non_promotable_stmt(
    cfg: *cfg_ir.CfgProgram,
    stmt: *cfg_ir.CfgStmt,
    must_slot: *mut col.BitSet,
) {
    match stmt.kind {
        .Assign => {
            if let dst = cfg.get_place(stmt.dst_place_id) {
                if dst.projs.len > 0_u32 {
                    must_slot.set(dst.local.widen.[usize]());
                }
            }
            if let rv = cfg.get_rvalue(stmt.payload_id) {
                if rv.kind == .Borrow {
                    if let bp = cfg.get_place(rv.place_id) {
                        must_slot.set(bp.local.widen.[usize]());
                    }
                }
            }
        }
        .Call => {
            if stmt.dst_place_id != cfg_ir.CFG_NONE {
                if let dst = cfg.get_place(stmt.dst_place_id) {
                    if dst.projs.len > 0_u32 {
                        must_slot.set(dst.local.widen.[usize]());
                    }
                }
            }
            if let cd = cfg.get_call(stmt.payload_id) {
                if (cd.is_mut_recv || cd.consumes_recv) && cd.has_recv_place {
                    if let rp = cfg.get_place(cd.recv_place_id) {
                        must_slot.set(rp.local.widen.[usize]());
                    }
                }
            }
        }
        _ => {}
    }
}

fn partition_locals(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    core: *mut FnLowerCore,
) -> !OutOfMemory {
    let locals = cfg.fn_locals(fn_id);
    var must_slot = try col.BitSet.init(alloc, locals.len);
    errdefer must_slot.destroy(alloc);

    var li: usize = 0_usize;
    while li < locals.len {
        if !is_ssa_promotable_ty(locals[li].ty, env) {
            must_slot.set(li);
        }
        li = li +% 1_usize;
    }

    let post = core.post.as_slice();
    var pi: usize = 0_usize;
    while pi < post.len {
        let stmts = cfg.fn_block_stmts(fn_id, post[pi]);
        var si: usize = 0_usize;
        while si < stmts.len {
            mark_non_promotable_stmt(cfg, &stmts[si], &mut must_slot);
            si = si +% 1_usize;
        }
        pi = pi +% 1_usize;
    }

    let pfs = cfg.fn_par_for_regions(fn_id);
    var pfi: usize = 0_usize;
    while pfi < pfs.len {
        must_slot.set(pfs[pfi].idx_local.widen.[usize]());
        must_slot.set(pfs[pfi].end_local.widen.[usize]());
        pfi = pfi +% 1_usize;
    }

    var idx: usize = 0_usize;
    while idx < locals.len {
        let loc = locals[idx];
        if must_slot.test(idx) {
            let sid = core.slots.len().trunc.[u32]();
            try core.slots.push(
                alloc,
                EirSlotInfo.{
                    id: sid,
                    ty: loc.ty,
                    has_name: loc.has_name,
                    name: loc.name,
                    is_mut: loc.is_mut,
                },
            );
            let sof = core.slot_of.as_mut_slice();
            if idx < sof.len {
                sof[idx] = sid;
            }
        } else if loc.ty != types.TY_VOID && loc.ty != types.TY_NEVER {
            core.is_promoted.set(idx);
        }
        idx = idx +% 1_usize;
    }

    must_slot.destroy(alloc);
    return;
}

fn clone_cfg_const_to_eir(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    c: *cfg_ir.CfgConst,
) -> u32 ! OutOfMemory {
    var ec = c.*;
    if ec.kind == .Float || ec.kind == .Str || ec.kind == .Bytes {
        let bs = cfg.bytes_slice(ec.bytes);
        ec.bytes = try eir.add_bytes(alloc, bs);
    }
    return try eir.add_const(alloc, ec);
}

fn emit_zero_const_inst(
    alloc: *mut AllocCap,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    ty: types.TyId,
    sp: span.Span,
) -> EirInst ! OutOfMemory {
    let dst = try ctx.new_val(alloc, ty);
    let n = env.get(ty);
    var konst = cfg_ir.const_null(ty);
    if n.kind == .Bool {
        konst = cfg_ir.const_bool(false);
    } else if n.kind == .Char {
        konst = cfg_ir.const_char(0_u32);
    } else if n.kind == .Float {
        let r = try eir.add_str(alloc, "0.0");
        konst = cfg_ir.const_float(r, ty);
    } else if env.is_integer(ty) || env.is_address(ty) {
        konst = cfg_ir.const_int(types.int_val_zero(), ty);
    }
    let cid = try eir.add_const(alloc, konst);
    var inst = inst_zero(sp, .Const);
    inst.dst = dst;
    inst.ty0 = ty;
    inst.aux0 = cid;
    return inst;
}

fn emit_zero_const(
    alloc: *mut AllocCap,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    ty: types.TyId,
    sp: span.Span,
) -> EirValue ! OutOfMemory {
    let inst = try emit_zero_const_inst(alloc, eir, env, ctx, ty, sp);
    let dst = inst.dst;
    try ctx.insts.push_block_inst(alloc, bb, inst);
    return dst;
}

fn operand_root_slot(
    cfg: *cfg_ir.CfgProgram,
    env: *types.TypeEnv,
    ctx: *LowerFnCtx,
    op: cfg_ir.CfgOperand,
) -> EirSlot {
    if op.kind == .Copy || op.kind == .Move {
        if let p = cfg.get_place(op.id) {
            let pk = env.get(p.ty).kind;
            if p.projs.len == 0_u32 && pk != .Borrow && pk != .RawPtr {
                return ctx.slot_of_local(p.local);
            }
        }
    }
    return EIR_NONE;
}

fn local_is_ptr_ty(
    cfg: *cfg_ir.CfgProgram,
    env: *types.TypeEnv,
    fn_id: u32,
    lid: cfg_ir.LocalId,
) -> bool {
    if let loc = cfg.fn_local(fn_id, lid) {
        let n = env.get(loc.ty);
        return (n.kind == .Borrow && n.borrow_kind == .Single) || n.kind == .RawPtr;
    }
    return false;
}

@recursive
fn build_place_parts(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    place: *cfg_ir.CfgPlace,
    sp: span.Span,
    projs_out: *mut col.DynBuf[EirProj],
) -> EirPlaceBase ! OutOfMemory {
    let slot = ctx.slot_of_local(place.local);
    var base = place_base_slot(slot);
    if slot == EIR_NONE {
        var lty = types.TY_ERROR;
        if let loc = cfg.fn_local(ctx.fn_id, place.local) {
            lty = loc.ty;
        }
        let v = try ctx.new_val(alloc, lty);
        var gv = inst_zero(sp, .GetVar);
        gv.dst = v;
        gv.aux0 = place.local;
        try ctx.insts.push_block_inst(alloc, bb, gv);
        base = place_base_val(v);
    }

    let cprojs = cfg.projs_slice(place.projs);
    var i: usize = 0_usize;
    while i < cprojs.len {
        let pr = cprojs[i];
        match pr.kind {
            .Deref => { try projs_out.push(alloc, proj_deref()); }
            .Field => { try projs_out.push(alloc, proj_field(pr.sym, pr.index, pr.ty)); }
            .TupleField => { try projs_out.push(alloc, proj_tuple_field(pr.index, pr.ty)); }
            .PoolCol => {
                try projs_out.push(alloc, proj_pool_col(pr.sym, pr.index, pr.is_slot_pool, pr.ty));
            }
            .Index => {
                var idx_op = cfg_ir.op_none();
                if let o = cfg.get_operand(pr.operand_id) {
                    idx_op = o.*;
                }
                let iv = try lower_operand(alloc, cfg, eir, env, ctx, bb, idx_op, sp);
                try projs_out.push(alloc, proj_index(iv, pr.ty));
            }
        }
        i = i +% 1_usize;
    }
    return base;
}

@recursive
fn lower_operand(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    op: cfg_ir.CfgOperand,
    sp: span.Span,
) -> EirValue ! OutOfMemory {
    if op.kind == .Const {
        var c = cfg_ir.const_void();
        if let cc = cfg.get_const(op.id) {
            c = cc.*;
        }
        let cty = cfg_ir.const_ty(&c, env);
        let dst = try ctx.new_val(alloc, cty);
        let cid = try clone_cfg_const_to_eir(alloc, cfg, eir, &c);
        var inst = inst_zero(sp, .Const);
        inst.dst = dst;
        inst.ty0 = cty;
        inst.aux0 = cid;
        try ctx.insts.push_block_inst(alloc, bb, inst);
        return dst;
    }

    let p = cfg.get_place(op.id) orelse {
        return try emit_zero_const(alloc, eir, env, ctx, bb, types.TY_VOID, sp);
    };

    if p.projs.len == 0_u32 {
        var lty = p.ty;
        if lty == types.TY_ERROR {
            if let loc = cfg.fn_local(ctx.fn_id, p.local) {
                lty = loc.ty;
            }
        }
        let slot = ctx.slot_of_local(p.local);
        if slot != EIR_NONE {
            let dst = try ctx.new_val(alloc, lty);
            var inst = inst_zero(sp, .LoadSlot);
            inst.dst = dst;
            inst.aux0 = slot;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        if ctx.is_local_promoted(p.local) {
            let dst = try ctx.new_val(alloc, lty);
            var inst = inst_zero(sp, .GetVar);
            inst.dst = dst;
            inst.aux0 = p.local;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        return try emit_zero_const(alloc, eir, env, ctx, bb, lty, sp);
    }

    var tmp_projs = try col.DynBuf.[EirProj].init(alloc, p.projs.len.widen.[usize]());
    errdefer tmp_projs.destroy(alloc);
    let base = try build_place_parts(alloc, cfg, eir, env, ctx, bb, p, sp, &mut tmp_projs);
    let dst = try ctx.new_val(alloc, p.ty);

    let ps = tmp_projs.as_slice();
    if ps.len == 2_usize && ps[0_usize].kind == .PoolCol && ps[1_usize].kind == .Index {
        let p0 = ps[0_usize];
        let p1 = ps[1_usize];
        let is_ptr = local_is_ptr_ty(cfg, env, ctx.fn_id, p.local);
        let op_id = try eir.add_pool_col_op(
            alloc,
            EirPoolColOp.{
                pool_base: base,
                pool_is_ptr: is_ptr,
                is_slot_pool: p0.is_slot_pool,
                col: p0.sym,
                col_idx: p0.index,
                index: p1.index,
                elem_ty: p0.ty,
            },
        );
        var inst = inst_zero(sp, .PoolColumnLoad);
        inst.dst = dst;
        inst.aux0 = op_id;
        inst.ty0 = p0.ty;
        try ctx.insts.push_block_inst(alloc, bb, inst);
        tmp_projs.destroy(alloc);
        return dst;
    }

    let pr_range = try eir.add_projs(alloc, ps);
    let pid = try eir.add_place(alloc, EirPlace.{ base: base, projs: pr_range, ty: p.ty });
    var inst = inst_zero(sp, .LoadPlace);
    inst.dst = dst;
    inst.aux0 = pid;
    try ctx.insts.push_block_inst(alloc, bb, inst);
    tmp_projs.destroy(alloc);
    return dst;
}

fn store_cfg_place(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    place: *cfg_ir.CfgPlace,
    val: EirValue,
    sp: span.Span,
) -> !OutOfMemory {
    if place.projs.len == 0_u32 {
        let slot = ctx.slot_of_local(place.local);
        if slot != EIR_NONE {
            var inst = inst_zero(sp, .StoreSlot);
            inst.aux0 = slot;
            inst.v0 = val;
            try ctx.insts.push_block_inst(alloc, bb, inst);
        } else if ctx.is_local_promoted(place.local) {
            var inst = inst_zero(sp, .SetVar);
            inst.aux0 = place.local;
            inst.v0 = val;
            try ctx.insts.push_block_inst(alloc, bb, inst);
        }
        return;
    }

    var tmp_projs = try col.DynBuf.[EirProj].init(alloc, place.projs.len.widen.[usize]());
    errdefer tmp_projs.destroy(alloc);
    let base = try build_place_parts(alloc, cfg, eir, env, ctx, bb, place, sp, &mut tmp_projs);
    let ps = tmp_projs.as_slice();
    if ps.len == 2_usize && ps[0_usize].kind == .PoolCol && ps[1_usize].kind == .Index {
        let p0 = ps[0_usize];
        let p1 = ps[1_usize];
        let is_ptr = local_is_ptr_ty(cfg, env, ctx.fn_id, place.local);
        let op_id = try eir.add_pool_col_op(
            alloc,
            EirPoolColOp.{
                pool_base: base,
                pool_is_ptr: is_ptr,
                is_slot_pool: p0.is_slot_pool,
                col: p0.sym,
                col_idx: p0.index,
                index: p1.index,
                elem_ty: p0.ty,
            },
        );
        var inst = inst_zero(sp, .PoolColumnStore);
        inst.aux0 = op_id;
        inst.v0 = val;
        inst.ty0 = p0.ty;
        try ctx.insts.push_block_inst(alloc, bb, inst);
        tmp_projs.destroy(alloc);
        return;
    }

    let pr_range = try eir.add_projs(alloc, ps);
    let pid = try eir.add_place(alloc, EirPlace.{ base: base, projs: pr_range, ty: place.ty });
    var inst = inst_zero(sp, .StorePlace);
    inst.aux0 = pid;
    inst.v0 = val;
    try ctx.insts.push_block_inst(alloc, bb, inst);
    tmp_projs.destroy(alloc);
    return;
}

fn lower_rvalue_borrow(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    rv: *cfg_ir.CfgRvalue,
    has_expected: bool,
    expected_dst: types.TyId,
    sp: span.Span,
) -> EirValue ! OutOfMemory {
    let place = cfg.get_place(rv.place_id) orelse {
        return try emit_zero_const(alloc, eir, env, ctx, bb, types.TY_ERROR, sp);
    };
    let borrow_ty = if has_expected && expected_dst != types.TY_ERROR {
        expected_dst
    } else {
        place.ty
    };
    let dst = try ctx.new_val(alloc, borrow_ty);
    let slot = ctx.slot_of_local(place.local);
    if place.projs.len == 0_u32 && slot != EIR_NONE {
        var inst = inst_zero(sp, .SlotAddr);
        inst.dst = dst;
        inst.aux0 = slot;
        inst.flag0 = rv.flag;
        inst.ty0 = borrow_ty;
        try ctx.insts.push_block_inst(alloc, bb, inst);
        return dst;
    }
    var tmp_projs = try col.DynBuf.[EirProj].init(alloc, place.projs.len.widen.[usize]());
    errdefer tmp_projs.destroy(alloc);
    let base = try build_place_parts(alloc, cfg, eir, env, ctx, bb, place, sp, &mut tmp_projs);
    let pr_range = try eir.add_projs(alloc, tmp_projs.as_slice());
    let pid = try eir.add_place(alloc, EirPlace.{ base: base, projs: pr_range, ty: place.ty });
    var inst = inst_zero(sp, .PlaceAddr);
    inst.dst = dst;
    inst.aux0 = pid;
    inst.flag0 = rv.flag;
    inst.ty0 = borrow_ty;
    try ctx.insts.push_block_inst(alloc, bb, inst);
    tmp_projs.destroy(alloc);
    return dst;
}

fn lower_rvalue_aggregate(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    rv: *cfg_ir.CfgRvalue,
    has_expected: bool,
    expected_dst: types.TyId,
    sp: span.Span,
) -> EirValue ! OutOfMemory {
    let dst_ty = if has_expected && expected_dst != types.TY_ERROR {
        expected_dst
    } else {
        types.TY_ERROR
    };
    let elems = cfg.operands_slice(rv.range);
    var evs = try col.DynBuf.[EirValue].init(alloc, elems.len);
    errdefer evs.destroy(alloc);
    var i: usize = 0_usize;
    while i < elems.len {
        let ev = try lower_operand(alloc, cfg, eir, env, ctx, bb, elems[i], sp);
        try evs.push(alloc, ev);
        i = i +% 1_usize;
    }
    var agg = cfg_ir.agg_tuple();
    if let a = cfg.get_aggregate_kind(rv.aux_u32) {
        agg = a.*;
    }
    if agg.tag == .AnonStruct {
        let fs = cfg.syms_slice(agg.field_syms);
        agg.field_syms = try eir.add_syms(alloc, fs);
    }
    let agg_id = try eir.add_aggregate(alloc, agg);
    let erange = try eir.add_vals(alloc, evs.as_slice());
    let dst = try ctx.new_val(alloc, dst_ty);
    var inst = inst_zero(sp, .Aggregate);
    inst.dst = dst;
    inst.aux0 = agg_id;
    inst.range = erange;
    inst.ty0 = dst_ty;
    try ctx.insts.push_block_inst(alloc, bb, inst);
    evs.destroy(alloc);
    return dst;
}

fn lower_rvalue_inline_asm(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    rv: *cfg_ir.CfgRvalue,
    sp: span.Span,
) -> EirValue ! OutOfMemory {
    let c_inps = cfg.asm_inputs_slice(rv.range);
    var e_inps = try col.DynBuf.[EirAsmInput].init(alloc, c_inps.len);
    errdefer e_inps.destroy(alloc);
    var i: usize = 0_usize;
    while i < c_inps.len {
        let v = try lower_operand(alloc, cfg, eir, env, ctx, bb, c_inps[i].operand, sp);
        let nm = try eir.add_bytes(alloc, cfg.bytes_slice(c_inps[i].name));
        try e_inps.push(alloc, EirAsmInput.{ name: nm, val: v });
        i = i +% 1_usize;
    }
    let tpl = try eir.add_bytes(alloc, cfg.bytes_slice(rv.bytes));
    let inps_r = try eir.add_asm_inputs(alloc, e_inps.as_slice());
    let asm_id = try eir.add_asm(alloc, EirInlineAsmData.{ template: tpl, inputs: inps_r });
    var ainst = inst_zero(sp, .InlineAsm);
    ainst.aux0 = asm_id;
    try ctx.insts.push_block_inst(alloc, bb, ainst);

    let dst = try ctx.new_val(alloc, types.TY_VOID);
    let cid = try eir.add_const(alloc, cfg_ir.const_void());
    var cinst = inst_zero(sp, .Const);
    cinst.dst = dst;
    cinst.ty0 = types.TY_VOID;
    cinst.aux0 = cid;
    try ctx.insts.push_block_inst(alloc, bb, cinst);
    e_inps.destroy(alloc);
    return dst;
}

fn binary_dst_ty(
    op: ast.BinaryOp,
    op_ty: types.TyId,
    has_expected: bool,
    expected_dst: types.TyId,
) -> types.TyId {
    match op {
        .Eq => { return types.TY_BOOL; }
        .NotEq => { return types.TY_BOOL; }
        .Lt => { return types.TY_BOOL; }
        .LtEq => { return types.TY_BOOL; }
        .Gt => { return types.TY_BOOL; }
        .GtEq => { return types.TY_BOOL; }
        .And => { return types.TY_BOOL; }
        .Or => { return types.TY_BOOL; }
        .AddCheck => { return if has_expected { expected_dst } else { op_ty }; }
        .SubCheck => { return if has_expected { expected_dst } else { op_ty }; }
        .MulCheck => { return if has_expected { expected_dst } else { op_ty }; }
        .DivCheck => { return if has_expected { expected_dst } else { op_ty }; }
        .ModCheck => { return if has_expected { expected_dst } else { op_ty }; }
        _ => { return op_ty; }
    }
}

fn lower_rvalue_unwrap_or_query(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    rv: *cfg_ir.CfgRvalue,
    has_expected: bool,
    expected_dst: types.TyId,
    sp: span.Span,
) -> EirValue ! OutOfMemory {
    let st = cfg.operand_ty(ctx.fn_id, rv.op0, env);
    let sv = try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op0, sp);
    match rv.kind {
        .UnwrapOptional => {
            let sn = env.get(st);
            let dt = if sn.kind == .Optional { sn.primary } else { st };
            let dst = try ctx.new_val(alloc, dt);
            var inst = inst_zero(sp, .UnwrapOptional);
            inst.dst = dst;
            inst.v0 = sv;
            inst.ty0 = dt;
            inst.ty1 = st;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .UnwrapErrorOk => {
            let sn = env.get(st);
            let dt = if sn.kind == .ErrorUnion { sn.primary } else { st };
            let dst = try ctx.new_val(alloc, dt);
            var inst = inst_zero(sp, .UnwrapErrorOk);
            inst.dst = dst;
            inst.v0 = sv;
            inst.ty0 = dt;
            inst.ty1 = st;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .UnwrapErrorErr => {
            let dt = if has_expected && expected_dst != types.TY_ERROR {
                expected_dst
            } else {
                types.TY_U32
            };
            let dst = try ctx.new_val(alloc, dt);
            var inst = inst_zero(sp, .UnwrapErrorErr);
            inst.dst = dst;
            inst.v0 = sv;
            inst.ty0 = dt;
            inst.ty1 = st;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .IsNonNull => {
            let dst = try ctx.new_val(alloc, types.TY_BOOL);
            var inst = inst_zero(sp, .IsNonNull);
            inst.dst = dst;
            inst.v0 = sv;
            inst.ty0 = types.TY_BOOL;
            inst.ty1 = st;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .IsError => {
            let dst = try ctx.new_val(alloc, types.TY_BOOL);
            var inst = inst_zero(sp, .IsError);
            inst.dst = dst;
            inst.v0 = sv;
            inst.ty0 = types.TY_BOOL;
            inst.ty1 = st;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .MatchTag => {
            let dst = try ctx.new_val(alloc, types.TY_U32);
            var inst = inst_zero(sp, .MatchTag);
            inst.dst = dst;
            inst.v0 = sv;
            inst.ty0 = types.TY_U32;
            inst.ty1 = st;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        _ => {
            let dst = try ctx.new_val(alloc, rv.ty);
            var inst = inst_zero(sp, .FieldExtract);
            inst.dst = dst;
            inst.v0 = sv;
            inst.aux0 = rv.aux_u32;
            inst.ty0 = rv.ty;
            inst.ty1 = st;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
    }
}

fn lower_rvalue(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    rv: *cfg_ir.CfgRvalue,
    has_expected: bool,
    expected_dst: types.TyId,
    sp: span.Span,
) -> EirValue ! OutOfMemory {
    match rv.kind {
        .Use => { return try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op0, sp); }
        .Borrow => {
            return try lower_rvalue_borrow(alloc, cfg, eir, env, ctx, bb, rv, has_expected, expected_dst, sp);
        }
        .Unary => {
            let ot = cfg.operand_ty(ctx.fn_id, rv.op0, env);
            let ov = try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op0, sp);
            let dst_ty = if rv.unary_op == .Not { types.TY_BOOL } else { ot };
            let dst = try ctx.new_val(alloc, dst_ty);
            var inst = inst_zero(sp, .Unary);
            inst.dst = dst;
            inst.unary_op = rv.unary_op;
            inst.v0 = ov;
            inst.ty0 = dst_ty;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .Binary => {
            let op_ty = cfg.operand_ty(ctx.fn_id, rv.op0, env);
            let lv = try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op0, sp);
            let rv_v = try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op1, sp);
            let dst_ty = binary_dst_ty(rv.bin_op, op_ty, has_expected, expected_dst);
            let dst = try ctx.new_val(alloc, dst_ty);
            var inst = inst_zero(sp, .Binary);
            inst.dst = dst;
            inst.bin_op = rv.bin_op;
            inst.v0 = lv;
            inst.v1 = rv_v;
            inst.ty0 = dst_ty;
            inst.ty1 = op_ty;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .Slice => {
            let bty = cfg.operand_ty(ctx.fn_id, rv.op0, env);
            let out_ty = if has_expected && expected_dst != types.TY_ERROR { expected_dst } else { bty };
            let bv = try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op0, sp);
            let lv = if rv.has_op1 { try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op1, sp) } else { EIR_NONE };
            let hv = if rv.has_op2 { try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op2, sp) } else { EIR_NONE };
            let dst = try ctx.new_val(alloc, out_ty);
            var inst = inst_zero(sp, .Slice);
            inst.dst = dst;
            inst.v0 = bv;
            inst.v1 = lv;
            inst.v2 = hv;
            inst.ty0 = out_ty;
            inst.ty1 = bty;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .Cast => {
            let from_ty = cfg.operand_ty(ctx.fn_id, rv.op0, env);
            let ov = try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op0, sp);
            let dst = try ctx.new_val(alloc, rv.ty);
            var inst = inst_zero(sp, .Cast);
            inst.dst = dst;
            inst.cast_kind = rv.cast_kind;
            inst.v0 = ov;
            inst.ty0 = rv.ty;
            inst.ty1 = from_ty;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .Aggregate => {
            return try lower_rvalue_aggregate(alloc, cfg, eir, env, ctx, bb, rv, has_expected, expected_dst, sp);
        }
        .MakeDyn => {
            let pv = try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op0, sp);
            let dst_ty = if has_expected { expected_dst } else { types.TY_ERROR };
            let dst = try ctx.new_val(alloc, dst_ty);
            var inst = inst_zero(sp, .MakeDyn);
            inst.dst = dst;
            inst.v0 = pv;
            inst.aux0 = rv.aux_u32;
            inst.flag0 = rv.flag;
            inst.ty0 = dst_ty;
            inst.ty1 = rv.ty;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .MakeClosure => {
            let ev = if rv.has_op0 { try lower_operand(alloc, cfg, eir, env, ctx, bb, rv.op0, sp) } else { EIR_NONE };
            let dst = try ctx.new_val(alloc, rv.ty);
            var inst = inst_zero(sp, .MakeClosure);
            inst.dst = dst;
            inst.aux0 = rv.aux_u32;
            inst.v0 = ev;
            inst.ty0 = rv.ty;
            try ctx.insts.push_block_inst(alloc, bb, inst);
            return dst;
        }
        .InlineAsm => {
            return try lower_rvalue_inline_asm(alloc, cfg, eir, env, ctx, bb, rv, sp);
        }
        _ => {
            return try lower_rvalue_unwrap_or_query(alloc, cfg, eir, env, ctx, bb, rv, has_expected, expected_dst, sp);
        }
    }
}

fn lower_call_stmt(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    stmt: *cfg_ir.CfgStmt,
) -> !OutOfMemory {
    let cd = cfg.get_call(stmt.payload_id) orelse {
        return;
    };
    let has_dst_place = stmt.dst_place_id != cfg_ir.CFG_NONE;
    var ret_ty = types.TY_VOID;
    if has_dst_place {
        if let dp = cfg.get_place(stmt.dst_place_id) {
            ret_ty = dp.ty;
        }
    }
    let dst_val = if ret_ty == types.TY_VOID {
        EIR_NONE
    } else {
        try ctx.new_val(alloc, ret_ty)
    };

    let cargs = cfg.call_args(stmt.payload_id);
    var eargs = try col.DynBuf.[EirValue].init(alloc, cargs.len);
    errdefer eargs.destroy(alloc);
    var arg_slots = try col.DynBuf.[EirSlot].init(alloc, cargs.len);
    errdefer arg_slots.destroy(alloc);
    var i: usize = 0_usize;
    while i < cargs.len {
        try arg_slots.push(alloc, operand_root_slot(cfg, env, ctx, cargs[i]));
        let av = try lower_operand(alloc, cfg, eir, env, ctx, bb, cargs[i], stmt.span);
        try eargs.push(alloc, av);
        i = i +% 1_usize;
    }

    if cd.callee.kind == .Builtin {
        if cd.has_recv_place {
            if let rp = cfg.get_place(cd.recv_place_id) {
                let rpk = env.get(rp.ty).kind;
                let as_mut = arg_slots.as_mut_slice();
                if rp.projs.len == 0_u32
                    && rpk != .Borrow
                    && rpk != .RawPtr
                    && as_mut.len > 0_usize
                    && as_mut[0_usize] == EIR_NONE
                {
                    as_mut[0_usize] = ctx.slot_of_local(rp.local);
                }
            }
        }
        let ar = try eir.add_vals(alloc, eargs.as_slice());
        let sr = try eir.add_arg_slots(alloc, arg_slots.as_slice());
        let bc_id = try eir.add_builtin_call(
            alloc,
            EirBuiltinCallData.{
                op: cd.callee.builtin,
                args: ar,
                arg_slots: sr,
                ret_ty: ret_ty,
            },
        );
        var inst = inst_zero(stmt.span, .BuiltinCall);
        inst.dst = dst_val;
        inst.aux0 = bc_id;
        inst.range = ar;
        inst.ty0 = ret_ty;
        try ctx.insts.push_block_inst(alloc, bb, inst);
    } else {
        var ecallee = callee_direct_fn(cd.callee.a);
        match cd.callee.kind {
            .DirectFn => { ecallee = callee_direct_fn(cd.callee.a); }
            .Method => { ecallee = callee_method(cd.callee.a, cd.callee.b); }
            .GenericInst => { ecallee = callee_generic_inst(cd.callee.a); }
            .DynCall => { ecallee = callee_dyn_call(cd.callee.a, cd.callee.b); }
            .ExternFn => { ecallee = callee_extern_fn(cd.callee.a, cd.callee.b); }
            .FnPtr => {
                let fv = try lower_operand(alloc, cfg, eir, env, ctx, bb, cd.callee.fn_ptr, stmt.span);
                ecallee = callee_fn_ptr(fv);
            }
            .Builtin => {}
        }
        let ar = try eir.add_vals(alloc, eargs.as_slice());
        let call_id = try eir.add_call(
            alloc,
            EirCallData.{ callee: ecallee, args: ar, ret_ty: ret_ty },
        );
        var inst = inst_zero(stmt.span, .Call);
        inst.dst = dst_val;
        inst.aux0 = call_id;
        inst.range = ar;
        inst.ty0 = ret_ty;
        try ctx.insts.push_block_inst(alloc, bb, inst);
    }

    if has_dst_place && dst_val != EIR_NONE {
        if let dp = cfg.get_place(stmt.dst_place_id) {
            try store_cfg_place(alloc, cfg, eir, env, ctx, bb, dp, dst_val, stmt.span);
        }
    }
    arg_slots.destroy(alloc);
    eargs.destroy(alloc);
    return;
}

fn lower_stmt(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    stmt: *cfg_ir.CfgStmt,
) -> !OutOfMemory {
    match stmt.kind {
        .StorageLive => {
            if ctx.is_local_promoted(stmt.local) {
                var lty = types.TY_VOID;
                if let loc = cfg.fn_local(ctx.fn_id, stmt.local) {
                    lty = loc.ty;
                }
                let z = try emit_zero_const(alloc, eir, env, ctx, bb, lty, stmt.span);
                var sv = inst_zero(stmt.span, .SetVar);
                sv.aux0 = stmt.local;
                sv.v0 = z;
                try ctx.insts.push_block_inst(alloc, bb, sv);
            }
        }
        .Assign => {
            if let dp = cfg.get_place(stmt.dst_place_id) {
                if let rv = cfg.get_rvalue(stmt.payload_id) {
                    let v = try lower_rvalue(alloc, cfg, eir, env, ctx, bb, rv, true, dp.ty, stmt.span);
                    try store_cfg_place(alloc, cfg, eir, env, ctx, bb, dp, v, stmt.span);
                }
            }
        }
        .Call => {
            try lower_call_stmt(alloc, cfg, eir, env, ctx, bb, stmt);
        }
        _ => {}
    }
    return;
}

fn lower_term(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    term: *cfg_ir.CfgTerm,
) -> EirTerm ! OutOfMemory {
    match term.kind {
        .Goto => { return term_goto(ctx.map_bb(term.bb0)); }
        .Branch => {
            let cv = try lower_operand(alloc, cfg, eir, env, ctx, bb, term.operand, term.span);
            return term_branch(cv, ctx.map_bb(term.bb0), ctx.map_bb(term.bb1), term.span, term.flag);
        }
        .SwitchInt => {
            let dv = try lower_operand(alloc, cfg, eir, env, ctx, bb, term.operand, term.span);
            let cts = cfg.switch_targets_slice(term.targets);
            var ets = try col.DynBuf.[cfg_ir.SwitchTarget].init(alloc, cts.len);
            errdefer ets.destroy(alloc);
            var i: usize = 0_usize;
            while i < cts.len {
                try ets.push(
                    alloc,
                    cfg_ir.SwitchTarget.{ val: cts[i].val, target: ctx.map_bb(cts[i].target) },
                );
                i = i +% 1_usize;
            }
            let tr = try eir.add_switch_targets(alloc, ets.as_slice());
            ets.destroy(alloc);
            return term_switch_int(dv, tr, ctx.map_bb(term.bb0));
        }
        .Return => {
            if term.flag {
                let rv = try lower_operand(alloc, cfg, eir, env, ctx, bb, term.operand, term.span);
                return term_return(true, rv);
            }
            return term_return(false, EIR_NONE);
        }
        .Unreachable => {
            return term_unreachable(term.span, term.flag);
        }
    }
}

fn lower_fn_body_blocks(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
) -> !OutOfMemory {
    let fn_params = cfg.fn_params(ctx.fn_id);
    var pi: usize = 0_usize;
    while pi < fn_params.len {
        let plid = fn_params[pi];
        var pty = types.TY_ERROR;
        var pspan = span.span_dummy();
        if let loc = cfg.fn_local(ctx.fn_id, plid) {
            pty = loc.ty;
            pspan = loc.span;
        }
        let pv = try ctx.new_val(alloc, pty);
        try ctx.core.params.push(alloc, pv);
        let slot = ctx.slot_of_local(plid);
        if slot != EIR_NONE {
            var st = inst_zero(pspan, .StoreSlot);
            st.aux0 = slot;
            st.v0 = pv;
            try ctx.insts.push_block_inst(alloc, 0_u32, st);
        } else if ctx.is_local_promoted(plid) {
            var sv = inst_zero(pspan, .SetVar);
            sv.aux0 = plid;
            sv.v0 = pv;
            try ctx.insts.push_block_inst(alloc, 0_u32, sv);
        }
        pi = pi +% 1_usize;
    }

    let n_blocks = ctx.core.post.len();
    var bi: usize = 0_usize;
    while bi < n_blocks {
        let ob = u32_at(&ctx.core.post, bi);
        let cur_bb = bi.trunc.[u32]();
        let stmts = cfg.fn_block_stmts(ctx.fn_id, ob);
        var si: usize = 0_usize;
        while si < stmts.len {
            try lower_stmt(alloc, cfg, eir, env, ctx, cur_bb, &stmts[si]);
            si = si +% 1_usize;
        }
        var eterm = term_unreachable(span.span_dummy(), false);
        if let cb = cfg.fn_block(ctx.fn_id, ob) {
            eterm = try lower_term(alloc, cfg, eir, env, ctx, cur_bb, &cb.term);
        }
        try ctx.core.terms.push(alloc, eterm);
        bi = bi +% 1_usize;
    }
    return;
}

fn propagate_missing_tys(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *EirProgram,
    ctx: *mut LowerFnCtx,
) -> !OutOfMemory {
    let nvals = ctx.core.value_tys.len();
    var expected = try col.DynBuf.[types.TyId].init(alloc, nvals);
    errdefer expected.destroy(alloc);
    var i: usize = 0_usize;
    while i < nvals {
        try expected.push(alloc, types.TY_NONE);
        i = i +% 1_usize;
    }

    let insts_ro = ctx.insts.insts.as_slice();
    let slots_ro = ctx.core.slots.as_slice();
    let exp_mut = expected.as_mut_slice();
    var ii: usize = 0_usize;
    while ii < insts_ro.len {
        let inst = insts_ro[ii];
        if inst.kind == .StoreSlot {
            let su = inst.aux0.widen.[usize]();
            let vu = inst.v0.widen.[usize]();
            if su < slots_ro.len && vu < exp_mut.len {
                exp_mut[vu] = slots_ro[su].ty;
            }
        } else if inst.kind == .StorePlace {
            let vu = inst.v0.widen.[usize]();
            if let pl = eir.get_place(inst.aux0) {
                if vu < exp_mut.len {
                    exp_mut[vu] = pl.ty;
                }
            }
        } else if inst.kind == .SetVar {
            let vu = inst.v0.widen.[usize]();
            if let loc = cfg.fn_local(ctx.fn_id, inst.aux0) {
                if vu < exp_mut.len {
                    exp_mut[vu] = loc.ty;
                }
            }
        }
        ii = ii +% 1_usize;
    }

    let exp_ro = expected.as_slice();
    let insts_mut = ctx.insts.insts.as_mut_slice();
    let vtys_mut = ctx.core.value_tys.as_mut_slice();
    var j: usize = 0_usize;
    while j < insts_mut.len {
        let k = insts_mut[j].kind;
        if (k == .Aggregate || k == .SlotAddr || k == .PlaceAddr) && insts_mut[j].ty0 == types.TY_ERROR {
            let du = insts_mut[j].dst.widen.[usize]();
            if du < exp_ro.len && exp_ro[du] != types.TY_NONE && exp_ro[du] != types.TY_ERROR {
                let et = exp_ro[du];
                insts_mut[j].ty0 = et;
                if du < vtys_mut.len {
                    vtys_mut[du] = et;
                }
            }
        }
        j = j +% 1_usize;
    }

    expected.destroy(alloc);
    return;
}

fn intersect_dense(idom: *[BlockId], a: BlockId, b: BlockId) -> BlockId {
    var b1 = a;
    var b2 = b;
    while b1 != b2 {
        while b1 > b2 {
            let u1 = b1.widen.[usize]();
            if u1 >= idom.len {
                break;
            }
            let p1 = idom[u1];
            if p1 == EIR_NONE || p1 == b1 {
                break;
            }
            b1 = p1;
        }
        while b2 > b1 {
            let u2 = b2.widen.[usize]();
            if u2 >= idom.len {
                break;
            }
            let p2 = idom[u2];
            if p2 == EIR_NONE || p2 == b2 {
                break;
            }
            b2 = p2;
        }
        if b1 != b2 {
            let u1 = b1.widen.[usize]();
            let u2 = b2.widen.[usize]();
            var stuck1 = true;
            if u1 < idom.len {
                let p1 = idom[u1];
                stuck1 = p1 == EIR_NONE || p1 == b1;
            }
            var stuck2 = true;
            if u2 < idom.len {
                let p2 = idom[u2];
                stuck2 = p2 == EIR_NONE || p2 == b2;
            }
            if stuck1 && stuck2 {
                break;
            }
        }
    }
    return b1;
}

fn compute_preds_idom_df(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    ctx: *mut LowerFnCtx,
) -> !OutOfMemory {
    let n = ctx.core.terms.len();
    if n == 0_usize {
        return;
    }

    var bi: usize = 0_usize;
    while bi < n {
        if let tp = ctx.core.terms.get(bi) {
            let term = tp.*;
            let sc = eir.term_successor_count(&term);
            var si: usize = 0_usize;
            while si < sc {
                let succ = eir.term_successor_at(&term, si);
                if succ.widen.[usize]() < n {
                    try ctx.dom.add_pred_unique(alloc, succ, bi.trunc.[u32]());
                }
                si = si +% 1_usize;
            }
        }
        bi = bi +% 1_usize;
    }

    let idom_mut = ctx.dom.idom.as_mut_slice();
    if idom_mut.len > 0_usize {
        idom_mut[0_usize] = 0_u32;
    }

    var changed = true;
    while changed {
        changed = false;
        var b: usize = 1_usize;
        while b < n {
            var new_idom = EIR_NONE;
            var cur = u32_at(&ctx.dom.preds_head, b);
            while cur != EIR_NONE {
                let cu = cur.widen.[usize]();
                let p = u32_at(&ctx.dom.preds_val, cu);
                let pu = p.widen.[usize]();
                let p_idom = u32_at(&ctx.dom.idom, pu);
                if p_idom != EIR_NONE {
                    if new_idom == EIR_NONE {
                        new_idom = p;
                    } else {
                        new_idom = intersect_dense(ctx.dom.idom.as_slice(), p, new_idom);
                    }
                }
                cur = u32_at(&ctx.dom.preds_next, cu);
            }
            let idom_s = ctx.dom.idom.as_mut_slice();
            if new_idom != EIR_NONE && b < idom_s.len && idom_s[b] != new_idom {
                idom_s[b] = new_idom;
                changed = true;
            }
            b = b +% 1_usize;
        }
    }

    // Dominance frontiers.
    var fb: usize = 0_usize;
    while fb < n {
        let plen = u32_at(&ctx.dom.preds_len, fb);
        let id_b = u32_at(&ctx.dom.idom, fb);
        if plen >= 2_u32 && id_b != EIR_NONE {
            var cur = u32_at(&ctx.dom.preds_head, fb);
            while cur != EIR_NONE {
                let cu = cur.widen.[usize]();
                var runner = u32_at(&ctx.dom.preds_val, cu);
                while runner != id_b {
                    try ctx.dom.add_df_unique(alloc, runner, fb.trunc.[u32]());
                    let ru = runner.widen.[usize]();
                    if ru >= n {
                        break;
                    }
                    let next = u32_at(&ctx.dom.idom, ru);
                    if next == EIR_NONE || next == runner {
                        break;
                    }
                    runner = next;
                }
                cur = u32_at(&ctx.dom.preds_next, cu);
            }
        }
        fb = fb +% 1_usize;
    }

    // Build dominator tree children in ascending block order.
    var cb: usize = 1_usize;
    while cb < n {
        let pid = u32_at(&ctx.dom.idom, cb);
        if pid != EIR_NONE && pid.widen.[usize]() != cb {
            let pu = pid.widen.[usize]();
            let nid = ctx.ren.dom_ch_val.len().trunc.[u32]();
            try ctx.ren.dom_ch_val.push(alloc, cb.trunc.[u32]());
            try ctx.ren.dom_ch_next.push(alloc, EIR_NONE);
            let ch_head = ctx.dom.dom_ch_head.as_mut_slice();
            let ch_tail = ctx.ren.dom_ch_tail.as_mut_slice();
            if pu < ch_head.len && pu < ch_tail.len {
                let pt = ch_tail[pu];
                if pt == EIR_NONE {
                    ch_head[pu] = nid;
                    ch_tail[pu] = nid;
                } else {
                    ch_tail[pu] = nid;
                    let ptu = pt.widen.[usize]();
                    let nx = ctx.ren.dom_ch_next.as_mut_slice();
                    if ptu < nx.len {
                        nx[ptu] = nid;
                    }
                }
            }
        }
        cb = cb +% 1_usize;
    }
    return;
}

fn sort_u32_asc(xs: *mut [u32]) {
    var i: usize = 1_usize;
    while i < xs.len {
        let key = xs[i];
        var j = i;
        while j > 0_usize {
            let prev = j -% 1_usize;
            if xs[prev] <= key {
                break;
            }
            xs[j] = xs[prev];
            j = prev;
        }
        xs[j] = key;
        i = i +% 1_usize;
    }
}

fn place_ssa_phis(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    ctx: *mut LowerFnCtx,
) -> !OutOfMemory {
    let n_blocks = ctx.core.terms.len();
    let locals = cfg.fn_locals(ctx.fn_id);
    let n_locals = locals.len;
    var def_blocks = try col.BitSet.init(alloc, n_blocks);
    errdefer def_blocks.destroy(alloc);
    var has_phi = try col.BitSet.init(alloc, n_blocks);
    errdefer has_phi.destroy(alloc);
    var work = try col.DynBuf.[BlockId].init(alloc, 16_usize);
    errdefer work.destroy(alloc);
    var frontier = try col.DynBuf.[BlockId].init(alloc, 16_usize);
    errdefer frontier.destroy(alloc);

    // Single pass over all blocks/instructions to collect per-local defining blocks (in ascending block order).
    var ldef_head = try col.DynBuf.[u32].init(alloc, if n_locals < 4_usize { 4_usize } else { n_locals });
    errdefer ldef_head.destroy(alloc);
    var ldef_tail = try col.DynBuf.[u32].init(alloc, if n_locals < 4_usize { 4_usize } else { n_locals });
    errdefer ldef_tail.destroy(alloc);
    var ldef_last_bb = try col.DynBuf.[u32].init(alloc, if n_locals < 4_usize { 4_usize } else { n_locals });
    errdefer ldef_last_bb.destroy(alloc);
    var ldef_bb = try col.DynBuf.[u32].init(alloc, 32_usize);
    errdefer ldef_bb.destroy(alloc);
    var ldef_next = try col.DynBuf.[u32].init(alloc, 32_usize);
    errdefer ldef_next.destroy(alloc);
    var lid_to_li = try col.HashMap.[u32].init(alloc, if n_locals < 8_usize { 8_usize } else { n_locals });
    errdefer lid_to_li.destroy(alloc);

    var li0: usize = 0_usize;
    while li0 < n_locals {
        try ldef_head.push(alloc, EIR_NONE);
        try ldef_tail.push(alloc, EIR_NONE);
        try ldef_last_bb.push(alloc, EIR_NONE);
        if ctx.core.is_promoted.test(li0) {
            try lid_to_li.insert(alloc, locals[li0].id.widen.[u64](), li0.trunc.[u32]());
        }
        li0 = li0 +% 1_usize;
    }

    var bi: usize = 0_usize;
    while bi < n_blocks {
        let bi_u32 = bi.trunc.[u32]();
        var cur = u32_at(&ctx.insts.head, bi);
        while cur != EIR_NONE {
            let cu = cur.widen.[usize]();
            if let ip = ctx.insts.insts.get(cu) {
                if ip.kind == .SetVar {
                    if let lidx_u32 = lid_to_li.get(ip.aux0.widen.[u64]()) {
                        let lidx = lidx_u32.widen.[usize]();
                        if u32_at(&ldef_last_bb, lidx) != bi_u32 {
                            let node_id = ldef_bb.len().trunc.[u32]();
                            try ldef_bb.push(alloc, bi_u32);
                            try ldef_next.push(alloc, EIR_NONE);
                            let last_s = ldef_last_bb.as_mut_slice();
                            let head_s = ldef_head.as_mut_slice();
                            let tail_s = ldef_tail.as_mut_slice();
                            if lidx < last_s.len && lidx < head_s.len && lidx < tail_s.len {
                                last_s[lidx] = bi_u32;
                                let old_tail = tail_s[lidx];
                                tail_s[lidx] = node_id;
                                if old_tail == EIR_NONE {
                                    head_s[lidx] = node_id;
                                } else {
                                    let ns = ldef_next.as_mut_slice();
                                    let ot = old_tail.widen.[usize]();
                                    if ot < ns.len {
                                        ns[ot] = node_id;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            cur = u32_at(&ctx.insts.next, cu);
        }
        bi = bi +% 1_usize;
    }

    var li: usize = 0_usize;
    while li < locals.len {
        if !ctx.core.is_promoted.test(li) {
            li = li +% 1_usize;
            continue;
        }
        let lid = locals[li].id;
        let phi_ty = locals[li].ty;

        def_blocks.clear();
        has_phi.clear();
        work.clear();

        var dcur = u32_at(&ldef_head, li);
        while dcur != EIR_NONE {
            let dcu = dcur.widen.[usize]();
            let dbb = u32_at(&ldef_bb, dcu);
            let dbu = dbb.widen.[usize]();
            if dbu < n_blocks && !def_blocks.test(dbu) {
                def_blocks.set(dbu);
                try work.push(alloc, dbb);
            }
            dcur = u32_at(&ldef_next, dcu);
        }

        loop {
            let b = work.pop() orelse {
                break;
            };
            frontier.clear();
            let bu = b.widen.[usize]();
            var dc = u32_at(&ctx.dom.df_head, bu);
            while dc != EIR_NONE {
                let dcu = dc.widen.[usize]();
                let dfb = u32_at(&ctx.dom.df_val, dcu);
                if dfb != EIR_NONE {
                    try frontier.push(alloc, dfb);
                }
                dc = u32_at(&ctx.dom.df_next, dcu);
            }
            sort_u32_asc(frontier.as_mut_slice());

            let fs = frontier.as_slice();
            var fi: usize = 0_usize;
            while fi < fs.len {
                let d = fs[fi];
                let du = d.widen.[usize]();
                if !has_phi.test(du) {
                    has_phi.set(du);
                    let pval = try ctx.new_val(alloc, phi_ty);
                    try ctx.phis.add_phi(alloc, d, pval, phi_ty, lid);
                    if !def_blocks.test(du) {
                        try work.push(alloc, d);
                    }
                }
                fi = fi +% 1_usize;
            }
        }
        li = li +% 1_usize;
    }

    lid_to_li.destroy(alloc);
    ldef_next.destroy(alloc);
    ldef_bb.destroy(alloc);
    ldef_last_bb.destroy(alloc);
    ldef_tail.destroy(alloc);
    ldef_head.destroy(alloc);
    frontier.destroy(alloc);
    work.destroy(alloc);
    has_phi.destroy(alloc);
    def_blocks.destroy(alloc);
    return;
}

fn prepend_entry_defaults(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
) -> !OutOfMemory {
    if ctx.insts.head.len() == 0_usize {
        return;
    }
    let locals = cfg.fn_locals(ctx.fn_id);
    var def_head = EIR_NONE;
    var def_tail = EIR_NONE;

    var li: usize = 0_usize;
    while li < locals.len {
        if ctx.core.is_promoted.test(li) {
            let lid = locals[li].id;
            let lty = locals[li].ty;
            let inst = try emit_zero_const_inst(alloc, eir, env, ctx, lty, span.span_dummy());
            let zv = inst.dst;
            let nid = ctx.insts.insts.len().trunc.[u32]();
            try ctx.insts.insts.push(alloc, inst);
            try ctx.insts.next.push(alloc, EIR_NONE);
            if def_tail == EIR_NONE {
                def_head = nid;
                def_tail = nid;
            } else {
                let tu = def_tail.widen.[usize]();
                let nx = ctx.insts.next.as_mut_slice();
                if tu < nx.len {
                    nx[tu] = nid;
                }
                def_tail = nid;
            }
            try ctx.ren.stack_push(alloc, lid, zv);
        }
        li = li +% 1_usize;
    }

    if def_head != EIR_NONE {
        let old_head = u32_at(&ctx.insts.head, 0_usize);
        let tu = def_tail.widen.[usize]();
        let nx = ctx.insts.next.as_mut_slice();
        if tu < nx.len {
            nx[tu] = old_head;
        }
        let heads = ctx.insts.head.as_mut_slice();
        let tails = ctx.insts.tail.as_mut_slice();
        if heads.len > 0_usize {
            heads[0_usize] = def_head;
        }
        if tails.len > 0_usize && tails[0_usize] == EIR_NONE {
            tails[0_usize] = def_tail;
        }
    }
    return;
}

fn resolve_val(v: EirValue, remap: *[EirValue]) -> EirValue {
    var cur = v;
    var guard: usize = 0_usize;
    while guard <= 128_usize {
        let idx = cur.widen.[usize]();
        if idx >= remap.len {
            break;
        }
        let next = remap[idx];
        if next == EIR_NONE || next == cur {
            break;
        }
        cur = next;
        guard = guard +% 1_usize;
    }
    return cur;
}

fn rewrite_place_in_eir(eir: *mut EirProgram, place_id: u32, remap: *[EirValue]) {
    var projs_r = ast.range_empty();
    if let p = eir.exprs.places.get_mut(place_id.widen.[usize]()) {
        if p.base.kind == .Val {
            p.base.id = resolve_val(p.base.id, remap);
        }
        projs_r = p.projs;
    }
    let ps = eir.exprs.projs.as_mut_slice();
    let start = projs_r.start.widen.[usize]();
    let cnt = projs_r.len.widen.[usize]();
    var i: usize = 0_usize;
    while i < cnt {
        let idx = start +% i;
        if idx < ps.len && ps[idx].kind == .Index {
            ps[idx].index = resolve_val(ps[idx].index, remap);
        }
        i = i +% 1_usize;
    }
}

fn rewrite_val_range_in_eir(eir: *mut EirProgram, r: ast.IdRange, remap: *[EirValue]) {
    let vs = eir.exprs.vals.as_mut_slice();
    let start = r.start.widen.[usize]();
    let cnt = r.len.widen.[usize]();
    var i: usize = 0_usize;
    while i < cnt {
        let idx = start +% i;
        if idx < vs.len {
            vs[idx] = resolve_val(vs[idx], remap);
        }
        i = i +% 1_usize;
    }
}

pub fn rewrite_inst_operands(eir: *mut EirProgram, inst: *mut EirInst, remap: *[EirValue]) {
    match inst.kind {
        .Copy => { inst.v0 = resolve_val(inst.v0, remap); }
        .StoreSlot => { inst.v0 = resolve_val(inst.v0, remap); }
        .LoadPlace => { rewrite_place_in_eir(eir, inst.aux0, remap); }
        .PlaceAddr => { rewrite_place_in_eir(eir, inst.aux0, remap); }
        .StorePlace => {
            rewrite_place_in_eir(eir, inst.aux0, remap);
            inst.v0 = resolve_val(inst.v0, remap);
        }
        .PoolColumnLoad => {
            if let op = eir.exprs.pool_col_ops.get_mut(inst.aux0.widen.[usize]()) {
                if op.pool_base.kind == .Val {
                    op.pool_base.id = resolve_val(op.pool_base.id, remap);
                }
                op.index = resolve_val(op.index, remap);
            }
        }
        .PoolColumnStore => {
            if let op = eir.exprs.pool_col_ops.get_mut(inst.aux0.widen.[usize]()) {
                if op.pool_base.kind == .Val {
                    op.pool_base.id = resolve_val(op.pool_base.id, remap);
                }
                op.index = resolve_val(op.index, remap);
            }
            inst.v0 = resolve_val(inst.v0, remap);
        }
        .Unary => { inst.v0 = resolve_val(inst.v0, remap); }
        .Cast => { inst.v0 = resolve_val(inst.v0, remap); }
        .Binary => {
            inst.v0 = resolve_val(inst.v0, remap);
            inst.v1 = resolve_val(inst.v1, remap);
        }
        .Slice => {
            inst.v0 = resolve_val(inst.v0, remap);
            if inst.v1 != EIR_NONE {
                inst.v1 = resolve_val(inst.v1, remap);
            }
            if inst.v2 != EIR_NONE {
                inst.v2 = resolve_val(inst.v2, remap);
            }
        }
        .VecLoad => {
            inst.v0 = resolve_val(inst.v0, remap);
            inst.v1 = resolve_val(inst.v1, remap);
        }
        .VecStore => {
            inst.v0 = resolve_val(inst.v0, remap);
            inst.v1 = resolve_val(inst.v1, remap);
            inst.v2 = resolve_val(inst.v2, remap);
        }
        .VecFma => {
            inst.v0 = resolve_val(inst.v0, remap);
            inst.v1 = resolve_val(inst.v1, remap);
            inst.v2 = resolve_val(inst.v2, remap);
        }
        .Aggregate => { rewrite_val_range_in_eir(eir, inst.range, remap); }
        .UnwrapOptional => { inst.v0 = resolve_val(inst.v0, remap); }
        .UnwrapErrorOk => { inst.v0 = resolve_val(inst.v0, remap); }
        .UnwrapErrorErr => { inst.v0 = resolve_val(inst.v0, remap); }
        .IsNonNull => { inst.v0 = resolve_val(inst.v0, remap); }
        .IsError => { inst.v0 = resolve_val(inst.v0, remap); }
        .MatchTag => { inst.v0 = resolve_val(inst.v0, remap); }
        .FieldExtract => { inst.v0 = resolve_val(inst.v0, remap); }
        .MakeDyn => { inst.v0 = resolve_val(inst.v0, remap); }
        .MakeClosure => {
            if inst.v0 != EIR_NONE {
                inst.v0 = resolve_val(inst.v0, remap);
            }
        }
        .Call => {
            var args_r = ast.range_empty();
            if let cd = eir.exprs.calls.get_mut(inst.aux0.widen.[usize]()) {
                if cd.callee.kind == .FnPtr {
                    cd.callee.a = resolve_val(cd.callee.a, remap);
                }
                args_r = cd.args;
            }
            rewrite_val_range_in_eir(eir, args_r, remap);
        }
        .BuiltinCall => {
            var args_r = ast.range_empty();
            if let bc = eir.exprs.builtin_calls.get(inst.aux0.widen.[usize]()) {
                args_r = bc.args;
            }
            rewrite_val_range_in_eir(eir, args_r, remap);
        }
        .InlineAsm => {
            var inps_r = ast.range_empty();
            if let ad = eir.exprs.asms.get(inst.aux0.widen.[usize]()) {
                inps_r = ad.inputs;
            }
            let inps = eir.meta.asm_inputs.as_mut_slice();
            let start = inps_r.start.widen.[usize]();
            let cnt = inps_r.len.widen.[usize]();
            var i: usize = 0_usize;
            while i < cnt {
                let idx = start +% i;
                if idx < inps.len {
                    inps[idx].val = resolve_val(inps[idx].val, remap);
                }
                i = i +% 1_usize;
            }
        }
        _ => {}
    }
}

fn rename_populate_succ_phis(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    bi: usize,
    seen_succ: *mut col.DynBuf[BlockId],
) -> !OutOfMemory {
    seen_succ.clear();
    var term = term_unreachable(span.span_dummy(), false);
    if let tp = ctx.core.terms.get(bi) {
        term = tp.*;
    }
    let sc = eir.term_successor_count(&term);
    let n_blocks = ctx.core.terms.len();
    var si: usize = 0_usize;
    while si < sc {
        let s = eir.term_successor_at(&term, si);
        let su = s.widen.[usize]();
        var dup = false;
        let ss = seen_succ.as_slice();
        var ki: usize = 0_usize;
        while ki < ss.len {
            if ss[ki] == s {
                dup = true;
                break;
            }
            ki = ki +% 1_usize;
        }
        if !dup && su < n_blocks {
            try seen_succ.push(alloc, s);
            var sp_cur = u32_at(&ctx.phis.blk_head, su);
            while sp_cur != EIR_NONE {
                let spu = sp_cur.widen.[usize]();
                if let phip = ctx.phis.phis.get(spu) {
                    let lid = phip.owner_local;
                    let top_v = ctx.ren.stack_peek(lid, 0_u32);
                    try ctx.phis.add_phi_in(alloc, sp_cur, bb, top_v);
                }
                sp_cur = u32_at(&ctx.phis.phi_next, spu);
            }
        }
        si = si +% 1_usize;
    }
    return;
}

fn rename_block_enter(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    ctx: *mut LowerFnCtx,
    bb: BlockId,
    pushed_locals: *mut col.DynBuf[cfg_ir.LocalId],
    seen_succ: *mut col.DynBuf[BlockId],
) -> !OutOfMemory {
    let bi = bb.widen.[usize]();

    // 1. Push phi definitions onto local stacks.
    var pcur = u32_at(&ctx.phis.blk_head, bi);
    while pcur != EIR_NONE {
        let pu = pcur.widen.[usize]();
        if let phip = ctx.phis.phis.get(pu) {
            let phi = phip.*;
            if let loc = cfg.fn_local(ctx.fn_id, phi.owner_local) {
                if loc.has_name {
                    let d_u = phi.dst.widen.[usize]();
                    let vns = ctx.core.val_names.as_mut_slice();
                    if d_u < vns.len {
                        vns[d_u] = loc.name;
                    }
                }
            }
            try ctx.ren.stack_push(alloc, phi.owner_local, phi.dst);
            try pushed_locals.push(alloc, phi.owner_local);
        }
        pcur = u32_at(&ctx.phis.phi_next, pu);
    }

    // 2. Filter out GetVar / SetVar and rewrite remaining instructions in-place.
    var new_head = EIR_NONE;
    var new_tail = EIR_NONE;
    var icur = u32_at(&ctx.insts.head, bi);
    while icur != EIR_NONE {
        let iu = icur.widen.[usize]();
        let next_i = u32_at(&ctx.insts.next, iu);
        var kind = EirInstKind.ParForHint;
        var has_inst = false;
        var inst_copy = inst_zero(span.span_dummy(), .ParForHint);
        if let ip = ctx.insts.insts.get(iu) {
            kind = ip.kind;
            inst_copy = ip.*;
            has_inst = true;
        }
        if has_inst && kind == .GetVar {
            let top = ctx.ren.stack_peek(inst_copy.aux0, inst_copy.dst);
            let du = inst_copy.dst.widen.[usize]();
            let rm = ctx.ren.val_remap.as_mut_slice();
            if du < rm.len {
                rm[du] = top;
            }
        } else if has_inst && kind == .SetVar {
            let rv = resolve_val(inst_copy.v0, ctx.ren.val_remap.as_slice());
            if let loc = cfg.fn_local(ctx.fn_id, inst_copy.aux0) {
                if loc.has_name {
                    let rvu = rv.widen.[usize]();
                    let vns = ctx.core.val_names.as_mut_slice();
                    if rvu < vns.len && vns[rvu] == EIR_NONE {
                        vns[rvu] = loc.name;
                    }
                }
            }
            try ctx.ren.stack_push(alloc, inst_copy.aux0, rv);
            try pushed_locals.push(alloc, inst_copy.aux0);
        } else if has_inst {
            if let im = ctx.insts.insts.get_mut(iu) {
                rewrite_inst_operands(eir, im, ctx.ren.val_remap.as_slice());
            }
            let nx = ctx.insts.next.as_mut_slice();
            if iu < nx.len {
                nx[iu] = EIR_NONE;
            }
            if new_tail == EIR_NONE {
                new_head = icur;
                new_tail = icur;
            } else {
                let tu = new_tail.widen.[usize]();
                if tu < nx.len {
                    nx[tu] = icur;
                }
                new_tail = icur;
            }
        }
        icur = next_i;
    }
    let heads = ctx.insts.head.as_mut_slice();
    let tails = ctx.insts.tail.as_mut_slice();
    if bi < heads.len && bi < tails.len {
        heads[bi] = new_head;
        tails[bi] = new_tail;
    }

    // 3. Rewrite terminator operand.
    if let tm = ctx.core.terms.get_mut(bi) {
        if tm.kind == .Branch || tm.kind == .SwitchInt || (tm.kind == .Return && tm.flag) {
            tm.val = resolve_val(tm.val, ctx.ren.val_remap.as_slice());
        }
    }

    // 4. Populate incoming phi arguments for unique successor blocks.
    try rename_populate_succ_phis(alloc, eir, ctx, bb, bi, seen_succ);
    return;
}

fn rename_ssa_iterative(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    ctx: *mut LowerFnCtx,
) -> !OutOfMemory {
    if ctx.core.terms.is_empty() {
        return;
    }
    let nvals = ctx.core.value_tys.len();
    var vi: usize = 0_usize;
    while vi < nvals {
        try ctx.ren.val_remap.push(alloc, EIR_NONE);
        vi = vi +% 1_usize;
    }

    var frames = try col.DynBuf.[RenameFrame].init(alloc, 32_usize);
    errdefer frames.destroy(alloc);
    var pushed_locals = try col.DynBuf.[cfg_ir.LocalId].init(alloc, 64_usize);
    errdefer pushed_locals.destroy(alloc);
    var seen_succ = try col.DynBuf.[BlockId].init(alloc, 8_usize);
    errdefer seen_succ.destroy(alloc);

    let root_ch = u32_at(&ctx.dom.dom_ch_head, 0_usize);
    try frames.push(
        alloc,
        RenameFrame.{
            bb: 0_u32,
            next_child_node: root_ch,
            pushed_start: 0_usize,
            entered: false,
        },
    );

    while !frames.is_empty() {
        let top_idx = frames.len() -% 1_usize;
        var f = RenameFrame.{ bb: 0_u32, next_child_node: EIR_NONE, pushed_start: 0_usize, entered: true };
        if let fp = frames.get(top_idx) {
            f = fp.*;
        }
        if !f.entered {
            let pstart = pushed_locals.len();
            if let fm = frames.get_mut(top_idx) {
                fm.entered = true;
                fm.pushed_start = pstart;
            }
            try rename_block_enter(alloc, cfg, eir, ctx, f.bb, &mut pushed_locals, &mut seen_succ);
            if let fp2 = frames.get(top_idx) {
                f = fp2.*;
            }
        }

        if f.next_child_node != EIR_NONE {
            let cn = f.next_child_node.widen.[usize]();
            let ch_bb = u32_at(&ctx.ren.dom_ch_val, cn);
            let next_cn = u32_at(&ctx.ren.dom_ch_next, cn);
            if let fm = frames.get_mut(top_idx) {
                fm.next_child_node = next_cn;
            }
            let ch_head = u32_at(&ctx.dom.dom_ch_head, ch_bb.widen.[usize]());
            try frames.push(
                alloc,
                RenameFrame.{
                    bb: ch_bb,
                    next_child_node: ch_head,
                    pushed_start: 0_usize,
                    entered: false,
                },
            );
        } else {
            while pushed_locals.len() > f.pushed_start {
                if let lid = pushed_locals.pop() {
                    ctx.ren.stack_pop(lid);
                }
            }
            _ = frames.pop();
        }
    }

    seen_succ.destroy(alloc);
    pushed_locals.destroy(alloc);
    frames.destroy(alloc);
    return;
}

struct CommittedBlocks {
    blocks: ast.IdRange;
    rpo: ast.IdRange;
}

fn commit_fn_blocks(
    alloc: *mut AllocCap,
    eir: *mut EirProgram,
    ctx: *LowerFnCtx,
) -> CommittedBlocks ! OutOfMemory {
    let n_blocks = ctx.core.terms.len();
    let blks_start = eir.funcs.blocks.len().trunc.[u32]();
    let rpo_start = eir.meta.rpo.len().trunc.[u32]();
    var bi: usize = 0_usize;
    while bi < n_blocks {
        try eir.meta.rpo.push(alloc, bi.trunc.[u32]());

        let phis_start = eir.funcs.phis.len().trunc.[u32]();
        var phis_len: u32 = 0_u32;
        var pcur = u32_at(&ctx.phis.blk_head, bi);
        while pcur != EIR_NONE {
            let pu = pcur.widen.[usize]();
            if let phip = ctx.phis.phis.get(pu) {
                let tphi = phip.*;
                let in_start = eir.funcs.phi_in.len().trunc.[u32]();
                var in_len: u32 = 0_u32;
                var inc = tphi.in_head;
                while inc != EIR_NONE {
                    let inc_u = inc.widen.[usize]();
                    if let pin = ctx.phis.phi_in.get(inc_u) {
                        try eir.funcs.phi_in.push(alloc, pin.*);
                        in_len = in_len +% 1_u32;
                    }
                    inc = u32_at(&ctx.phis.phi_in_next, inc_u);
                }
                try eir.funcs.phis.push(
                    alloc,
                    EirPhi.{
                        dst: tphi.dst,
                        ty: tphi.ty,
                        incoming: ast.range_new(in_start, in_len),
                    },
                );
                phis_len = phis_len +% 1_u32;
            }
            pcur = u32_at(&ctx.phis.phi_next, pu);
        }

        let insts_start = eir.funcs.insts.len().trunc.[u32]();
        var insts_len: u32 = 0_u32;
        var icur = u32_at(&ctx.insts.head, bi);
        while icur != EIR_NONE {
            let iu = icur.widen.[usize]();
            if let ip = ctx.insts.insts.get(iu) {
                try eir.funcs.insts.push(alloc, ip.*);
                insts_len = insts_len +% 1_u32;
            }
            icur = u32_at(&ctx.insts.next, iu);
        }

        let preds_start = eir.meta.preds.len().trunc.[u32]();
        var preds_len: u32 = 0_u32;
        var prcur = u32_at(&ctx.dom.preds_head, bi);
        while prcur != EIR_NONE {
            let pru = prcur.widen.[usize]();
            let pv = u32_at(&ctx.dom.preds_val, pru);
            if pv != EIR_NONE {
                try eir.meta.preds.push(alloc, pv);
                preds_len = preds_len +% 1_u32;
            }
            prcur = u32_at(&ctx.dom.preds_next, pru);
        }

        var bterm = term_unreachable(span.span_dummy(), false);
        if let tp = ctx.core.terms.get(bi) {
            bterm = tp.*;
        }
        try eir.funcs.blocks.push(
            alloc,
            EirBlock.{
                id: bi.trunc.[u32](),
                phis: ast.range_new(phis_start, phis_len),
                insts: ast.range_new(insts_start, insts_len),
                term: bterm,
                preds: ast.range_new(preds_start, preds_len),
                idom: u32_at(&ctx.dom.idom, bi),
            },
        );
        bi = bi +% 1_usize;
    }
    return CommittedBlocks.{
        blocks: ast.range_new(blks_start, n_blocks.trunc.[u32]()),
        rpo: ast.range_new(rpo_start, n_blocks.trunc.[u32]()),
    };
}

fn commit_fn_noalias(
    alloc: *mut AllocCap,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    sig_params: *[types.ParamSig],
) -> ast.IdRange ! OutOfMemory {
    var any_mut_borrow = false;
    var k: usize = 0_usize;
    while k < sig_params.len {
        let pn = env.get(sig_params[k].ty);
        if pn.kind == .Borrow && pn.flag0 {
            any_mut_borrow = true;
            break;
        }
        k = k +% 1_usize;
    }
    let na_start = eir.meta.noalias_params.len().trunc.[u32]();
    var na_len: u32 = 0_u32;
    var ni: usize = 0_usize;
    while ni < sig_params.len {
        let pn = env.get(sig_params[ni].ty);
        if pn.kind == .Borrow && (pn.flag0 || any_mut_borrow) {
            try eir.meta.noalias_params.push(alloc, ni.trunc.[u32]());
            na_len = na_len +% 1_u32;
        }
        ni = ni +% 1_usize;
    }
    return ast.range_new(na_start, na_len);
}

fn commit_fn_par_for(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    ctx: *LowerFnCtx,
) -> ast.IdRange ! OutOfMemory {
    let cpfs = cfg.fn_par_for_regions(ctx.fn_id);
    let pf_start = eir.meta.par_for_regions.len().trunc.[u32]();
    var pf_len: u32 = 0_u32;
    var pfi: usize = 0_usize;
    while pfi < cpfs.len {
        let pf = cpfs[pfi];
        let o2d = ctx.core.orig_to_dense.as_slice();
        let h_u = pf.header_bb.widen.[usize]();
        let b_u = pf.body_bb.widen.[usize]();
        let s_u = pf.step_bb.widen.[usize]();
        let e_u = pf.exit_bb.widen.[usize]();
        let islot = ctx.slot_of_local(pf.idx_local);
        let eslot = ctx.slot_of_local(pf.end_local);
        if h_u < o2d.len && b_u < o2d.len && s_u < o2d.len && e_u < o2d.len
            && o2d[h_u] != EIR_NONE && o2d[b_u] != EIR_NONE
            && o2d[s_u] != EIR_NONE && o2d[e_u] != EIR_NONE
            && islot != EIR_NONE && eslot != EIR_NONE
        {
            try eir.meta.par_for_regions.push(
                alloc,
                EirParForRegion.{
                    header_bb: o2d[h_u],
                    body_bb: o2d[b_u],
                    step_bb: o2d[s_u],
                    exit_bb: o2d[e_u],
                    idx_slot: islot,
                    end_slot: eslot,
                    chunk_size: pf.chunk_size,
                },
            );
            pf_len = pf_len +% 1_u32;
        }
        pfi = pfi +% 1_usize;
    }
    return ast.range_new(pf_start, pf_len);
}

fn commit_lowered_function(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
    ctx: *mut LowerFnCtx,
    mod_name: u32,
    impl_decl_idx: u32,
) -> !OutOfMemory {
    let cf = cfg.get_fn(ctx.fn_id) orelse {
        return;
    };
    let sig_params = env.params_range(cf.sig.params);
    let pvals = ctx.core.params.as_slice();
    let pnames_start = eir.aux.sym_list.len().trunc.[u32]();
    var pnames_len: u32 = 0_u32;
    var pi: usize = 0_usize;
    while pi < pvals.len && pi < sig_params.len {
        let nm = sig_params[pi].name;
        try eir.aux.sym_list.push(alloc, nm);
        pnames_len = pnames_len +% 1_u32;
        let pvu = pvals[pi].widen.[usize]();
        let vns = ctx.core.val_names.as_mut_slice();
        if pvu < vns.len {
            vns[pvu] = nm;
        }
        pi = pi +% 1_usize;
    }

    let params_start = eir.funcs.param_vals.len().trunc.[u32]();
    try eir.funcs.param_vals.push_slice(alloc, pvals);
    let params_r = ast.range_new(params_start, pvals.len.trunc.[u32]());

    let slots_start = eir.funcs.slots.len().trunc.[u32]();
    try eir.funcs.slots.push_slice(alloc, ctx.core.slots.as_slice());
    let slots_r = ast.range_new(slots_start, ctx.core.slots.len().trunc.[u32]());

    let vtys_start = eir.funcs.value_tys.len().trunc.[u32]();
    try eir.funcs.value_tys.push_slice(alloc, ctx.core.value_tys.as_slice());
    let vtys_r = ast.range_new(vtys_start, ctx.core.value_tys.len().trunc.[u32]());

    let vnames_start = eir.meta.val_names.len().trunc.[u32]();
    var vnames_len: u32 = 0_u32;
    let vn_ro = ctx.core.val_names.as_slice();
    var vi: usize = 0_usize;
    while vi < vn_ro.len {
        if vn_ro[vi] != EIR_NONE {
            try eir.meta.val_names.push(
                alloc,
                EirValName.{ val: vi.trunc.[u32](), sym: vn_ro[vi] },
            );
            vnames_len = vnames_len +% 1_u32;
        }
        vi = vi +% 1_usize;
    }

    let cblks = try commit_fn_blocks(alloc, eir, ctx);
    let na_r = try commit_fn_noalias(alloc, eir, env, sig_params);
    let where_r = try eir.add_expr_ids(alloc, cfg.fn_where_clauses(ctx.fn_id));
    let ensures_r = try eir.add_expr_ids(alloc, cfg.fn_ensures_clauses(ctx.fn_id));

    let cinvs = cfg.fn_loop_invariants(ctx.fn_id);
    let invs_start = eir.aux.loop_invariants.len().trunc.[u32]();
    var invs_len: u32 = 0_u32;
    var ii: usize = 0_usize;
    while ii < cinvs.len {
        let old_u = cinvs[ii].block_id.widen.[usize]();
        let o2d = ctx.core.orig_to_dense.as_slice();
        if old_u < o2d.len && o2d[old_u] != EIR_NONE {
            let er = try eir.add_expr_ids(alloc, cfg.expr_ids_slice(cinvs[ii].exprs));
            try eir.aux.loop_invariants.push(
                alloc,
                cfg_ir.LoopInvariantEntry.{ block_id: o2d[old_u], exprs: er },
            );
            invs_len = invs_len +% 1_u32;
        }
        ii = ii +% 1_usize;
    }

    var bg_args = ast.range_empty();
    if cf.has_base_generic {
        bg_args = try eir.add_gvals(alloc, cfg.fn_base_generic_args(ctx.fn_id));
    }
    let pf_r = try commit_fn_par_for(alloc, cfg, eir, ctx);

    _ = try eir.add_fn(
        alloc,
        EirFunction.{
            key: cf.key,
            mod_id: cf.module_id,
            mod_name: mod_name,
            impl_decl_idx: impl_decl_idx,
            is_emi_stub: false,
            name: cf.name,
            body_span: cf.body_span,
            is_sys: cf.is_sys,
            sig: cf.sig,
            params: params_r,
            param_names: ast.range_new(pnames_start, pnames_len),
            slots: slots_r,
            value_tys: vtys_r,
            val_names: ast.range_new(vnames_start, vnames_len),
            blocks: cblks.blocks,
            entry: 0_u32,
            rpo: cblks.rpo,
            noalias_params: na_r,
            value_ranges: ast.range_empty(),
            value_facts: ast.range_empty(),
            proven_safe_insts: ast.range_empty(),
            where_clauses: where_r,
            ensures_clauses: ensures_r,
            loop_invariants: ast.range_new(invs_start, invs_len),
            has_base_generic: cf.has_base_generic,
            base_generic_key: cf.base_generic_key,
            base_generic_args: bg_args,
            has_layout_shared_tag: false,
            layout_shared_tag: ast.range_empty(),
            par_for_regions: pf_r,
        },
    );
    return;
}

fn init_lower_fn_ctx(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    fn_id: u32,
    entry: BlockId,
    n_orig: usize,
    n_locals: usize,
    env: *types.TypeEnv,
) -> LowerFnCtx ! OutOfMemory {
    var core = try FnLowerCore.init(alloc, n_orig, n_locals);
    errdefer core.destroy(alloc);
    try compute_rpo(alloc, cfg, fn_id, entry, n_orig, &mut core);
    try partition_locals(alloc, cfg, fn_id, env, &mut core);

    let n_blocks = core.post.len();
    let insts = try FnInstLists.init(alloc, n_blocks);
    errdefer insts.destroy(alloc);
    let phis = try FnPhiLists.init(alloc, n_blocks);
    errdefer phis.destroy(alloc);
    let dom = try FnDomGraph.init(alloc, n_blocks);
    errdefer dom.destroy(alloc);
    let ren = try FnRenamePools.init(alloc, n_blocks, n_locals);
    errdefer ren.destroy(alloc);

    return LowerFnCtx.{
        fn_id: fn_id,
        core: core,
        insts: insts,
        phis: phis,
        dom: dom,
        ren: ren,
    };
}

fn lower_cfg_function(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    eir: *mut EirProgram,
    mod_name: u32,
    impl_decl_idx: u32,
) -> !OutOfMemory {
    let cf = cfg.get_fn(fn_id) orelse {
        return;
    };
    let n_orig = cf.blocks.len.widen.[usize]();
    if n_orig == 0_usize {
        _ = try eir.add_fn(
            alloc,
            EirFunction.{
                key: cf.key,
                mod_id: cf.module_id,
                mod_name: mod_name,
                impl_decl_idx: impl_decl_idx,
                is_emi_stub: true,
                name: cf.name,
                body_span: cf.body_span,
                is_sys: cf.is_sys,
                sig: cf.sig,
                params: ast.range_empty(),
                param_names: ast.range_empty(),
                slots: ast.range_empty(),
                value_tys: ast.range_empty(),
                val_names: ast.range_empty(),
                blocks: ast.range_empty(),
                entry: 0_u32,
                rpo: ast.range_empty(),
                noalias_params: ast.range_empty(),
                value_ranges: ast.range_empty(),
                value_facts: ast.range_empty(),
                proven_safe_insts: ast.range_empty(),
                where_clauses: ast.range_empty(),
                ensures_clauses: ast.range_empty(),
                loop_invariants: ast.range_empty(),
                has_base_generic: cf.has_base_generic,
                base_generic_key: cf.base_generic_key,
                base_generic_args: ast.range_empty(),
                has_layout_shared_tag: false,
                layout_shared_tag: ast.range_empty(),
                par_for_regions: ast.range_empty(),
            },
        );
        return;
    }
    let n_locals = cf.locals.len.widen.[usize]();

    var ctx = try init_lower_fn_ctx(alloc, cfg, fn_id, cf.entry, n_orig, n_locals, env);
    errdefer ctx.destroy(alloc);

    try lower_fn_body_blocks(alloc, cfg, eir, env, &mut ctx);
    try propagate_missing_tys(alloc, cfg, eir, &mut ctx);
    try compute_preds_idom_df(alloc, eir, &mut ctx);
    try place_ssa_phis(alloc, cfg, &mut ctx);
    try prepend_entry_defaults(alloc, cfg, eir, env, &mut ctx);
    try rename_ssa_iterative(alloc, cfg, eir, &mut ctx);
    try commit_lowered_function(alloc, cfg, eir, env, &mut ctx, mod_name, impl_decl_idx);

    ctx.destroy(alloc);
    return;
}

fn copy_cfg_metadata_to_eir(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eir: *mut EirProgram,
) -> !OutOfMemory {
    try eir.aux.dyn_impl_pairs.push_slice(alloc, cfg.dyn_impl_pairs_slice());
    try eir.scheds.schedules.push_slice(alloc, cfg.scheds.schedules.as_slice());
    try eir.scheds.sched_waves.push_slice(alloc, cfg.scheds.sched_waves.as_slice());
    try eir.scheds.sched_systems.push_slice(alloc, cfg.scheds.sched_systems.as_slice());
    try eir.scheds.dag_nodes.push_slice(alloc, cfg.scheds.dag_nodes.as_slice());
    try eir.scheds.dag_deps.push_slice(alloc, cfg.scheds.dag_deps.as_slice());
    return;
}

/// Lowers a `CfgProgram` into SSA `EirProgram` (skipping uninstantiated generics, comptime fns, and unsupported fns).
pub fn lower_cfg_to_eir(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
) -> EirProgram ! OutOfMemory {
    _ = interner;
    var eir = try EirProgram.init(alloc);
    errdefer eir.destroy(alloc);
    try copy_cfg_metadata_to_eir(alloc, cfg, &mut eir);

    let n_fns = cfg.fn_count();
    var fi: u32 = 0_u32;
    while fi < n_fns {
        if let cf = cfg.get_fn(fi) {
            if cf.sig.generics.len == 0_u32
                && !cf.sig.is_comptime
                && !sig_has_generic_param(&cf.sig, env)
                && cf.unsupported.len == 0_u32
            {
                try lower_cfg_function(alloc, cfg, fi, env, &mut eir, span.SYM_EMPTY, 0_u32);
            }
        }
        fi = fi +% 1_u32;
    }
    return eir;
}

/// Full pipeline lowering matching `compiler/src/eir.rs::lower_program` / `lower_program_for_verify`:
/// populates `extern_fns` from `prog` and optionally reports `E0230` diagnostics for unsupported CFG items.
pub fn lower_cfg_to_eir_with_diags(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    strict_unsupported: bool,
) -> EirProgram ! OutOfMemory {
    return try lower_cfg_to_eir_with_diags_and_jobs(
        alloc, cfg, prog, env, interner, diags, strict_unsupported, 0_u32,
    );
}

struct EirLowerItem {
    cfg_fi: u32;
    mod_name: u32;
    impl_decl_idx: u32;
    weight: u32;
}

linear struct WorkerEirLowerOut {
    out: EirProgram;
    oom: bool;
}

impl WorkerEirLowerOut {
    fn init(alloc: *mut AllocCap) -> WorkerEirLowerOut ! OutOfMemory {
        let out = try EirProgram.init(alloc);
        return WorkerEirLowerOut.{ out: out, oom: false };
    }

    fn destroy(self: WorkerEirLowerOut, alloc: *mut AllocCap) {
        let WorkerEirLowerOut.{ out, oom } = self;
        _ = oom;
        out.destroy(alloc);
    }
}

fn sort_eir_lower_order_desc(order: *mut [u32], items: *[EirLowerItem]) {
    let n = order.len;
    if n <= 1_usize {
        return;
    }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third {
        gap = (gap *% 3_usize) +% 1_usize;
    }
    while gap > 0_usize {
        var i = gap;
        while i < order.len {
            let idx = order[i];
            let wi = if idx.widen.[usize]() < items.len { items[idx.widen.[usize]()].weight } else { 0_u32 };
            var j = i;
            while j >= gap && j < order.len {
                let prev = j - gap;
                let pidx = order[prev];
                let wp = if pidx.widen.[usize]() < items.len { items[pidx.widen.[usize]()].weight } else { 0_u32 };
                if wp > wi || (wp == wi && pidx < idx) {
                    break;
                }
                order[j] = pidx;
                j = prev;
            }
            order[j] = idx;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

fn eir_lower_worker_loop(
    wi: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    items: *[EirLowerItem],
    item_loc: *mut [u64],
    cfg: *cfg_ir.CfgProgram,
    env: *types.TypeEnv,
    w: *mut WorkerEirLowerOut,
) -> !OutOfMemory {
    while true {
        let pos = next_pos.fetch_add(1_u64, .AcqRel).trunc.[usize]();
        if pos >= work_order.len {
            break;
        }
        let item_idx = work_order[pos].widen.[usize]();
        if item_idx >= items.len {
            continue;
        }
        let it = items[item_idx];
        let local_idx = w.out.fn_count();
        try lower_cfg_function(alloc, cfg, it.cfg_fi, env, &mut w.out, it.mod_name, it.impl_decl_idx);
        if item_idx < item_loc.len {
            item_loc[item_idx] = ((wi +% 1_u32).widen.[u64]() <<% 32_u64) | local_idx.widen.[u64]();
        }
    }
    return;
}

fn run_eir_lower_worker_entry(
    wi: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    items: *[EirLowerItem],
    item_loc: *mut [u64],
    cfg: *cfg_ir.CfgProgram,
    env: *types.TypeEnv,
    w: *mut WorkerEirLowerOut,
) {
    eir_lower_worker_loop(wi, alloc, next_pos, work_order, items, item_loc, cfg, env, w) catch {
        w.oom = true;
    };
}

fn dispatch_eir_lower_workers(
    n_workers: usize,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    items: *[EirLowerItem],
    item_loc: *mut [u64],
    cfg: *cfg_ir.CfgProgram,
    env: *types.TypeEnv,
    w0: *mut WorkerEirLowerOut,
    w1: *mut WorkerEirLowerOut,
    w2: *mut WorkerEirLowerOut,
    w3: *mut WorkerEirLowerOut,
    w4: *mut WorkerEirLowerOut,
    w5: *mut WorkerEirLowerOut,
    w6: *mut WorkerEirLowerOut,
    w7: *mut WorkerEirLowerOut,
    w8: *mut WorkerEirLowerOut,
    w9: *mut WorkerEirLowerOut,
    w10: *mut WorkerEirLowerOut,
    w11: *mut WorkerEirLowerOut,
) {
    if n_workers <= 1_usize {
        run_eir_lower_worker_entry(0_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w0);
        return;
    }
    par for wi in 0_usize..n_workers {
        if wi == 0_usize { run_eir_lower_worker_entry(0_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w0); }
        else if wi == 1_usize { run_eir_lower_worker_entry(1_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w1); }
        else if wi == 2_usize { run_eir_lower_worker_entry(2_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w2); }
        else if wi == 3_usize { run_eir_lower_worker_entry(3_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w3); }
        else if wi == 4_usize { run_eir_lower_worker_entry(4_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w4); }
        else if wi == 5_usize { run_eir_lower_worker_entry(5_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w5); }
        else if wi == 6_usize { run_eir_lower_worker_entry(6_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w6); }
        else if wi == 7_usize { run_eir_lower_worker_entry(7_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w7); }
        else if wi == 8_usize { run_eir_lower_worker_entry(8_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w8); }
        else if wi == 9_usize { run_eir_lower_worker_entry(9_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w9); }
        else if wi == 10_usize { run_eir_lower_worker_entry(10_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w10); }
        else if wi == 11_usize { run_eir_lower_worker_entry(11_u32, alloc, next_pos, work_order, items, item_loc, cfg, env, w11); }
    }
}

fn copy_lowered_from_worker(
    alloc: *mut AllocCap,
    wid: u32,
    local_idx: u32,
    dst: *mut EirProgram,
    sc: *mut EirCopyScratch,
    w0: *WorkerEirLowerOut,
    w1: *WorkerEirLowerOut,
    w2: *WorkerEirLowerOut,
    w3: *WorkerEirLowerOut,
    w4: *WorkerEirLowerOut,
    w5: *WorkerEirLowerOut,
    w6: *WorkerEirLowerOut,
    w7: *WorkerEirLowerOut,
    w8: *WorkerEirLowerOut,
    w9: *WorkerEirLowerOut,
    w10: *WorkerEirLowerOut,
    w11: *WorkerEirLowerOut,
) -> !OutOfMemory {
    if wid == 0_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w0.out, local_idx, dst, sc); }
    else if wid == 1_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w1.out, local_idx, dst, sc); }
    else if wid == 2_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w2.out, local_idx, dst, sc); }
    else if wid == 3_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w3.out, local_idx, dst, sc); }
    else if wid == 4_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w4.out, local_idx, dst, sc); }
    else if wid == 5_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w5.out, local_idx, dst, sc); }
    else if wid == 6_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w6.out, local_idx, dst, sc); }
    else if wid == 7_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w7.out, local_idx, dst, sc); }
    else if wid == 8_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w8.out, local_idx, dst, sc); }
    else if wid == 9_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w9.out, local_idx, dst, sc); }
    else if wid == 10_u32 { _ = try copy_fn_into_eir_scratch(alloc, &w10.out, local_idx, dst, sc); }
    else { _ = try copy_fn_into_eir_scratch(alloc, &w11.out, local_idx, dst, sc); }
    return;
}

/// Parallel CFG -> SSA EIR lowering (up to 12 workers, deterministic item-order merge).
pub fn lower_cfg_to_eir_with_diags_and_jobs(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    strict_unsupported: bool,
    jobs: u32,
) -> EirProgram ! OutOfMemory {
    _ = interner;
    var eir = try EirProgram.init(alloc);
    errdefer eir.destroy(alloc);
    try copy_cfg_metadata_to_eir(alloc, cfg, &mut eir);

    let ndefs = prog.def_count();
    var di: u32 = 0_u32;
    while di < ndefs {
        if let d = prog.get_def(di) {
            if d.kind == .ExternFn {
                try eir.aux.extern_fns.push(alloc, di);
            }
        }
        di = di +% 1_u32;
    }

    var msg = try str.StrBuf.init(alloc, 64_usize);
    errdefer msg.destroy(alloc);
    let n_fns = cfg.fn_count();
    var items = try col.DynBuf.[EirLowerItem].init(alloc, if n_fns < 8_u32 { 8_usize } else { n_fns.widen.[usize]() });
    errdefer items.destroy(alloc);

    var fi: u32 = 0_u32;
    while fi < n_fns {
        if let cf = cfg.get_fn(fi) {
            if cf.sig.generics.len > 0_u32
                || cf.sig.is_comptime
                || sig_has_generic_param(&cf.sig, env)
            {
                fi = fi +% 1_u32;
                continue;
            }
            let unsup = cfg.fn_unsupported(fi);
            if unsup.len > 0_usize {
                if strict_unsupported {
                    var ui: usize = 0_usize;
                    while ui < unsup.len {
                        msg.clear();
                        try msg.push_str_grow(alloc, "cannot lower `");
                        try msg.push_bytes_grow(alloc, cfg.bytes_slice(unsup[ui].kind_bytes));
                        try msg.push_str_grow(alloc, "` to EIR");
                        _ = try diags.emit_error_bytes(
                            alloc,
                            diag.E0230,
                            unsup[ui].span,
                            msg.as_bytes(),
                        );
                        ui = ui +% 1_usize;
                    }
                }
                fi = fi +% 1_u32;
                continue;
            }
            var mname = span.SYM_EMPTY;
            if let md = prog.get_module(cf.module_id) {
                mname = md.path_sym;
            }
            var impl_didx: u32 = 0_u32;
            if cf.key.kind == .ImplMethod {
                let ims = prog.impls.as_slice();
                let ia = cf.key.a.widen.[usize]();
                if ia < ims.len {
                    impl_didx = ims[ia].decl_idx;
                }
            }
            try items.push(
                alloc,
                EirLowerItem.{
                    cfg_fi: fi,
                    mod_name: mname,
                    impl_decl_idx: impl_didx,
                    weight: cf.blocks.len,
                },
            );
        }
        fi = fi +% 1_u32;
    }

    let n_items = items.len();
    var n_workers: usize = 1_usize;
    if jobs == 1_u32 {
        n_workers = 1_usize;
    } else if jobs > 1_u32 {
        n_workers = jobs.widen.[usize]();
        if n_workers > 12_usize { n_workers = 12_usize; }
        if n_workers > n_items { n_workers = n_items; }
    } else {
        if n_items < 32_usize {
            n_workers = 1_usize;
        } else if n_items < 192_usize {
            n_workers = 4_usize;
        } else if n_items < 480_usize {
            n_workers = 8_usize;
        } else {
            n_workers = 12_usize;
        }
    }
    if n_items < 32_usize {
        let its = items.as_slice();
        var ii: usize = 0_usize;
        while ii < its.len {
            let it = its[ii];
            try lower_cfg_function(alloc, cfg, it.cfg_fi, env, &mut eir, it.mod_name, it.impl_decl_idx);
            ii = ii +% 1_usize;
        }
        items.destroy(alloc);
        msg.destroy(alloc);
        return eir;
    }

    var work_order = try col.DynBuf.[u32].init(alloc, n_items);
    errdefer work_order.destroy(alloc);
    var item_loc = try col.DynBuf.[u64].init(alloc, n_items);
    errdefer item_loc.destroy(alloc);
    var wi_i: usize = 0_usize;
    while wi_i < n_items {
        try work_order.push(alloc, wi_i.trunc.[u32]());
        try item_loc.push(alloc, 0_u64);
        wi_i = wi_i +% 1_usize;
    }
    sort_eir_lower_order_desc(work_order.as_mut_slice(), items.as_slice());

    var next_pos = sync.AtomicCounter.init(0_u64);
    var w0 = try WorkerEirLowerOut.init(alloc);
    errdefer w0.destroy(alloc);
    var w1 = try WorkerEirLowerOut.init(alloc);
    errdefer w1.destroy(alloc);
    var w2 = try WorkerEirLowerOut.init(alloc);
    errdefer w2.destroy(alloc);
    var w3 = try WorkerEirLowerOut.init(alloc);
    errdefer w3.destroy(alloc);
    var w4 = try WorkerEirLowerOut.init(alloc);
    errdefer w4.destroy(alloc);
    var w5 = try WorkerEirLowerOut.init(alloc);
    errdefer w5.destroy(alloc);
    var w6 = try WorkerEirLowerOut.init(alloc);
    errdefer w6.destroy(alloc);
    var w7 = try WorkerEirLowerOut.init(alloc);
    errdefer w7.destroy(alloc);
    var w8 = try WorkerEirLowerOut.init(alloc);
    errdefer w8.destroy(alloc);
    var w9 = try WorkerEirLowerOut.init(alloc);
    errdefer w9.destroy(alloc);
    var w10 = try WorkerEirLowerOut.init(alloc);
    errdefer w10.destroy(alloc);
    var w11 = try WorkerEirLowerOut.init(alloc);
    errdefer w11.destroy(alloc);

    dispatch_eir_lower_workers(
        n_workers, alloc, &mut next_pos, work_order.as_slice(), items.as_slice(), item_loc.as_mut_slice(), cfg, env,
        &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
        &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
    );

    let any_oom = w0.oom || w1.oom || w2.oom || w3.oom || w4.oom || w5.oom
        || w6.oom || w7.oom || w8.oom || w9.oom || w10.oom || w11.oom;

    var merge_sc = try EirCopyScratch.init(alloc);
    errdefer merge_sc.destroy(alloc);
    if !any_oom {
        let locs = item_loc.as_slice();
        var mi: usize = 0_usize;
        while mi < n_items && mi < locs.len {
            let loc = locs[mi];
            let wid = ((loc >> 32_u64) -% 1_u64).trunc.[u32]();
            let local_idx = (loc & 0xFFFFFFFF_u64).trunc.[u32]();
            try copy_lowered_from_worker(
                alloc, wid, local_idx, &mut eir, &mut merge_sc,
                &w0, &w1, &w2, &w3, &w4, &w5, &w6, &w7, &w8, &w9, &w10, &w11,
            );
            mi = mi +% 1_usize;
        }
    }

    merge_sc.destroy(alloc);
    w11.destroy(alloc);
    w10.destroy(alloc);
    w9.destroy(alloc);
    w8.destroy(alloc);
    w7.destroy(alloc);
    w6.destroy(alloc);
    w5.destroy(alloc);
    w4.destroy(alloc);
    w3.destroy(alloc);
    w2.destroy(alloc);
    w1.destroy(alloc);
    w0.destroy(alloc);
    item_loc.destroy(alloc);
    work_order.destroy(alloc);
    items.destroy(alloc);
    msg.destroy(alloc);
    if any_oom {
        eir.destroy(alloc);
        return OutOfMemory;
    }
    return eir;
}

// ===========================================================================
// Section 4: Phase 4 Layout Sharing (`apply_layout_sharing`)
// ===========================================================================

const LS_FNV_OFFSET: u64 = 0xCBF29CE484222325_u64;
const LS_FNV_PRIME: u64 = 0x100000001B3_u64;

fn ls_fnv_u8(h: u64, b: u8) -> u64 {
    return (h ^ b.widen.[u64]()) *% LS_FNV_PRIME;
}

fn ls_fnv_u64(h: u64, v: u64) -> u64 {
    var cur = ls_fnv_u8(h, (v & 0xFF_u64).trunc.[u8]());
    cur = ls_fnv_u8(cur, ((v >> 8_u64) & 0xFF_u64).trunc.[u8]());
    cur = ls_fnv_u8(cur, ((v >> 16_u64) & 0xFF_u64).trunc.[u8]());
    cur = ls_fnv_u8(cur, ((v >> 24_u64) & 0xFF_u64).trunc.[u8]());
    cur = ls_fnv_u8(cur, ((v >> 32_u64) & 0xFF_u64).trunc.[u8]());
    cur = ls_fnv_u8(cur, ((v >> 40_u64) & 0xFF_u64).trunc.[u8]());
    cur = ls_fnv_u8(cur, ((v >> 48_u64) & 0xFF_u64).trunc.[u8]());
    cur = ls_fnv_u8(cur, ((v >> 56_u64) & 0xFF_u64).trunc.[u8]());
    return cur;
}

fn opt_niche_code(kind: types.OptNicheKind) -> u8 {
    match kind {
        .None => { return 0_u8; }
        .IdBrand => { return 1_u8; }
        .GenId => { return 2_u8; }
        .Link => { return 3_u8; }
        .NullPtr => { return 4_u8; }
        .FatPtrNullFirst => { return 5_u8; }
        .SliceMaxLen => { return 6_u8; }
        .BoolTag => { return 7_u8; }
        .ScalarSentinel => { return 8_u8; }
    }
}

struct ArgLayout {
    size: u64;
    align: u64;
    is_linear: bool;
    niche: types.OptNiche;
    float_abi: u8;
}

fn arg_layout_eq(a: ArgLayout, b: ArgLayout) -> bool {
    return a.size == b.size
        && a.align == b.align
        && a.is_linear == b.is_linear
        && a.niche.kind == b.niche.kind
        && a.niche.size == b.niche.size
        && a.niche.sentinel == b.niche.sentinel
        && a.float_abi == b.float_abi;
}

fn arg_layouts_eq(a: *[ArgLayout], b: *[ArgLayout]) -> bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < a.len {
        if !arg_layout_eq(a[i], b[i]) {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

fn hash_layout_key(base_key: cfg_ir.CfgFnKey, lays: *[ArgLayout]) -> u64 {
    var h = LS_FNV_OFFSET;
    h = ls_fnv_u64(h, cfg_ir.fn_key_u64(base_key));
    h = ls_fnv_u64(h, lays.len.widen.[u64]());
    var i: usize = 0_usize;
    while i < lays.len {
        let l = lays[i];
        h = ls_fnv_u64(h, l.size);
        h = ls_fnv_u64(h, l.align);
        h = ls_fnv_u8(h, if l.is_linear { 1_u8 } else { 0_u8 });
        h = ls_fnv_u8(h, opt_niche_code(l.niche.kind));
        h = ls_fnv_u64(h, l.niche.size.widen.[u64]());
        h = ls_fnv_u64(h, l.niche.sentinel);
        h = ls_fnv_u8(h, l.float_abi);
        i = i +% 1_usize;
    }
    return h;
}

fn format_layout_tag(
    alloc: *mut AllocCap,
    lays: *[ArgLayout],
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    try out.push_str_grow(alloc, "ls_");
    var i: usize = 0_usize;
    while i < lays.len {
        if i > 0_usize {
            try out.push_str_grow(alloc, "__");
        }
        let l = lays[i];
        try out.push_u64_grow(alloc, l.size);
        try out.push_byte_grow(alloc, b'_');
        try out.push_u64_grow(alloc, l.align);
        if l.is_linear {
            try out.push_str_grow(alloc, "_lin");
        }
        if l.niche.kind != .None {
            let nc = opt_niche_code(l.niche.kind);
            try out.push_str_grow(alloc, "_n");
            try out.push_u64_grow(alloc, nc.widen.[u64]());
            if l.niche.kind == .ScalarSentinel {
                try out.push_byte_grow(alloc, b'_');
                try out.push_u64_grow(alloc, l.niche.size.widen.[u64]());
                try out.push_byte_grow(alloc, b'_');
                try out.push_hex_u64_grow(alloc, l.niche.sentinel);
            }
        }
        if l.float_abi != 0_u8 {
            try out.push_str_grow(alloc, "_f");
            try out.push_u64_grow(alloc, l.float_abi.widen.[u64]());
        }
        i = i +% 1_usize;
    }
    return;
}

fn check_bare_ty(ty: types.TyId, target: types.TyId, env: *types.TypeEnv) -> bool {
    if ty == target {
        return true;
    }
    let n = env.get(ty);
    if n.kind == .ErrorUnion {
        return n.primary == target;
    }
    return false;
}

fn sig_uses_bare_ty(sig: *types.FnSig, target: types.TyId, env: *types.TypeEnv) -> bool {
    if check_bare_ty(sig.ret, target, env) {
        return true;
    }
    let ps = env.params_range(sig.params);
    var i: usize = 0_usize;
    while i < ps.len {
        if check_bare_ty(ps[i].ty, target, env) {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn ty_in_gargs(ty: types.TyId, gargs: *[types.GenericVal]) -> bool {
    var i: usize = 0_usize;
    while i < gargs.len {
        if gargs[i].kind == .Ty && gargs[i].id == ty {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

@recursive
fn ty_mentions_any_garg(ty: types.TyId, gargs: *[types.GenericVal], env: *types.TypeEnv) -> bool {
    if ty_in_gargs(ty, gargs) {
        return true;
    }
    let n = env.get(ty);
    match n.kind {
        .Borrow => {
            if n.borrow_kind == .Single || n.borrow_kind == .Slice {
                return ty_mentions_any_garg(n.primary, gargs, env);
            }
            return false;
        }
        .Optional => { return ty_mentions_any_garg(n.primary, gargs, env); }
        .RawPtr => { return ty_mentions_any_garg(n.primary, gargs, env); }
        .Array => { return ty_mentions_any_garg(n.primary, gargs, env); }
        _ => { return false; }
    }
}

fn is_layout_shareable(eir: *EirProgram, fn_id: u32, env: *types.TypeEnv) -> bool {
    let f = eir.get_fn(fn_id) orelse {
        return false;
    };
    if f.sig.effects.is_hot || f.sig.effects.is_inline || f.sig.effects.is_gpu {
        return false;
    }
    let gargs = eir.fn_base_generic_args(fn_id);
    if gargs.len == 0_usize {
        return false;
    }
    var gi: usize = 0_usize;
    while gi < gargs.len {
        if gargs[gi].kind != .Ty {
            return false;
        }
        gi = gi +% 1_usize;
    }

    let vtys = eir.fn_value_tys(fn_id);
    let blks = eir.fn_blocks(fn_id);
    var bi: usize = 0_usize;
    while bi < blks.len {
        let insts = eir.insts_slice(blks[bi].insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .Binary {
                if ty_in_gargs(inst.ty1, gargs) || ty_in_gargs(inst.ty0, gargs) {
                    return false;
                }
            } else if inst.kind == .Unary {
                if ty_in_gargs(inst.ty0, gargs) {
                    return false;
                }
            } else if inst.kind == .Cast {
                if ty_in_gargs(inst.ty1, gargs) || ty_in_gargs(inst.ty0, gargs) {
                    return false;
                }
            } else if inst.kind == .Call {
                if let cd = eir.get_call(inst.aux0) {
                    if cd.callee.kind != .DynCall {
                        let args = eir.vals_slice(cd.args);
                        var ai: usize = 0_usize;
                        while ai < args.len {
                            let vu = args[ai].widen.[usize]();
                            if vu < vtys.len && ty_mentions_any_garg(vtys[vu], gargs, env) {
                                return false;
                            }
                            ai = ai +% 1_usize;
                        }
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        bi = bi +% 1_usize;
    }
    return true;
}

struct LayoutGroupRec {
    base_key: cfg_ir.CfgFnKey;
    layouts: ast.IdRange;
    mem_head: u32;
    mem_tail: u32;
    mem_len: u32;
}

linear struct LayoutGroupTable {
    groups: col.DynBuf[LayoutGroupRec];
    group_head: col.HashMap[u32];
    group_next: col.DynBuf[u32];
    all_layouts: col.DynBuf[ArgLayout];
    mem_fn: col.DynBuf[u32];
    mem_next: col.DynBuf[u32];
}

impl LayoutGroupTable {
    fn init(alloc: *mut AllocCap) -> LayoutGroupTable ! OutOfMemory {
        let groups = try col.DynBuf.[LayoutGroupRec].init(alloc, 16_usize);
        errdefer groups.destroy(alloc);
        let group_head = try col.HashMap.[u32].init(alloc, 32_usize);
        errdefer group_head.destroy(alloc);
        let group_next = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer group_next.destroy(alloc);
        let all_layouts = try col.DynBuf.[ArgLayout].init(alloc, 32_usize);
        errdefer all_layouts.destroy(alloc);
        let mem_fn = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer mem_fn.destroy(alloc);
        let mem_next = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer mem_next.destroy(alloc);
        return LayoutGroupTable.{
            groups: groups,
            group_head: group_head,
            group_next: group_next,
            all_layouts: all_layouts,
            mem_fn: mem_fn,
            mem_next: mem_next,
        };
    }

    fn insert_member(
        self: *mut Self,
        alloc: *mut AllocCap,
        base_key: cfg_ir.CfgFnKey,
        lays: *[ArgLayout],
        fn_idx: u32,
    ) -> !OutOfMemory {
        let h = hash_layout_key(base_key, lays);
        var found_gid = EIR_NONE;
        var cur = self.group_head.get(h) orelse EIR_NONE;
        let gs = self.groups.as_slice();
        let gnx = self.group_next.as_slice();
        let al = self.all_layouts.as_slice();
        while cur != EIR_NONE {
            let cu = cur.widen.[usize]();
            if cu >= gs.len {
                break;
            }
            if cfg_ir.fn_key_eq(gs[cu].base_key, base_key) {
                let gl = slice_id_range.[ArgLayout](al, gs[cu].layouts);
                if arg_layouts_eq(gl, lays) {
                    found_gid = cur;
                    break;
                }
            }
            if cu >= gnx.len {
                break;
            }
            cur = gnx[cu];
        }

        let mnid = self.mem_fn.len().trunc.[u32]();
        try self.mem_fn.push(alloc, fn_idx);
        try self.mem_next.push(alloc, EIR_NONE);

        if found_gid == EIR_NONE {
            let lstart = self.all_layouts.len().trunc.[u32]();
            try self.all_layouts.push_slice(alloc, lays);
            let lr = ast.range_new(lstart, lays.len.trunc.[u32]());
            let prev = self.group_head.get(h) orelse EIR_NONE;
            let gid = self.groups.len().trunc.[u32]();
            try self.groups.push(
                alloc,
                LayoutGroupRec.{
                    base_key: base_key,
                    layouts: lr,
                    mem_head: mnid,
                    mem_tail: mnid,
                    mem_len: 1_u32,
                },
            );
            try self.group_next.push(alloc, prev);
            try self.group_head.insert(alloc, h, gid);
        } else {
            let gu = found_gid.widen.[usize]();
            let gs_mut = self.groups.as_mut_slice();
            if gu < gs_mut.len {
                let pt = gs_mut[gu].mem_tail.widen.[usize]();
                let mnx = self.mem_next.as_mut_slice();
                if pt < mnx.len {
                    mnx[pt] = mnid;
                }
                gs_mut[gu].mem_tail = mnid;
                gs_mut[gu].mem_len = gs_mut[gu].mem_len +% 1_u32;
            }
        }
        return;
    }

    fn destroy(self: LayoutGroupTable, alloc: *mut AllocCap) {
        let LayoutGroupTable.{ groups, group_head, group_next, all_layouts, mem_fn, mem_next } = self;
        groups.destroy(alloc);
        group_head.destroy(alloc);
        group_next.destroy(alloc);
        all_layouts.destroy(alloc);
        mem_fn.destroy(alloc);
        mem_next.destroy(alloc);
    }
}

fn collect_fn_arg_layouts(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    out: *mut col.DynBuf[ArgLayout],
) -> bool ! OutOfMemory {
    out.clear();
    let f = eir.get_fn(fn_id) orelse {
        return false;
    };
    let gargs = eir.fn_base_generic_args(fn_id);
    if gargs.len == 0_usize {
        return false;
    }
    var i: usize = 0_usize;
    while i < gargs.len {
        if gargs[i].kind != .Ty {
            return false;
        }
        let t = gargs[i].id;
        let lay = env.x64_layout(t);
        let is_lin = env.is_linear(t);
        let niche = env.opt_niche(t);
        var fabi: u8 = 0_u8;
        if sig_uses_bare_ty(&f.sig, t, env) {
            let tn = env.get(t);
            if tn.kind == .Float {
                if tn.u8_val == 32_u8 {
                    fabi = 32_u8;
                } else if tn.u8_val == 64_u8 {
                    fabi = 64_u8;
                }
            }
        }
        try out.push(
            alloc,
            ArgLayout.{
                size: lay.size.widen.[u64](),
                align: lay.align.widen.[u64](),
                is_linear: is_lin,
                niche: niche,
                float_abi: fabi,
            },
        );
        i = i +% 1_usize;
    }
    return !out.is_empty();
}

fn populate_layout_groups(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    env: *types.TypeEnv,
    table: *mut LayoutGroupTable,
) -> !OutOfMemory {
    let n_fns = eir.fn_count();
    var cur_lays = try col.DynBuf.[ArgLayout].init(alloc, 4_usize);
    errdefer cur_lays.destroy(alloc);

    var fi: u32 = 0_u32;
    while fi < n_fns {
        var has_bg = false;
        var base_key = cfg_ir.fn_key_top_def(resolve.DEF_NONE);
        if let f = eir.get_fn(fi) {
            has_bg = f.has_base_generic;
            base_key = f.base_generic_key;
        }
        if has_bg && is_layout_shareable(eir, fi, env) {
            let ok = try collect_fn_arg_layouts(alloc, eir, fi, env, &mut cur_lays);
            if ok {
                try table.insert_member(alloc, base_key, cur_lays.as_slice(), fi);
            }
        }
        fi = fi +% 1_u32;
    }
    cur_lays.destroy(alloc);
    return;
}

fn compact_layout_shared_fns(
    alloc: *mut AllocCap,
    eir: *mut EirProgram,
    inst_remap: *col.HashMap[u32],
    remap_dups: *[u32],
    remap_canons: *[u32],
    drop_indices: *col.BitSet,
) -> !OutOfMemory {
    let calls_mut = eir.exprs.calls.as_mut_slice();
    var ci: usize = 0_usize;
    while ci < calls_mut.len {
        if calls_mut[ci].callee.kind == .GenericInst {
            if let cid = inst_remap.get(calls_mut[ci].callee.a.widen.[u64]()) {
                calls_mut[ci].callee.a = cid;
            }
        }
        ci = ci +% 1_usize;
    }

    let n_fns = eir.fn_count().widen.[usize]();
    var kept = try col.DynBuf.[EirFunction].init(alloc, n_fns);
    errdefer kept.destroy(alloc);
    eir.funcs.by_key.clear();
    let old_fns = eir.funcs.fns.as_slice();
    var oi: usize = 0_usize;
    while oi < old_fns.len {
        if !drop_indices.test(oi) {
            let new_idx = kept.len().trunc.[u32]();
            let fkey = old_fns[oi].key;
            try kept.push(alloc, old_fns[oi]);
            try eir.funcs.by_key.insert(alloc, cfg_ir.fn_key_u64(fkey), new_idx);
        }
        oi = oi +% 1_usize;
    }
    eir.funcs.fns.clear();
    try eir.funcs.fns.push_slice(alloc, kept.as_slice());

    var ri: usize = 0_usize;
    while ri < remap_dups.len && ri < remap_canons.len {
        let ck = cfg_ir.fn_key_u64(cfg_ir.fn_key_generic_inst(remap_canons[ri]));
        if let cidx = eir.funcs.by_key.get(ck) {
            let dk = cfg_ir.fn_key_u64(cfg_ir.fn_key_generic_inst(remap_dups[ri]));
            try eir.funcs.by_key.insert(alloc, dk, cidx);
        }
        ri = ri +% 1_usize;
    }
    kept.destroy(alloc);
    return;
}

/// Phase 4 Layout Sharing pass matching `compiler/src/generics.rs::apply_layout_sharing`.
pub fn apply_layout_sharing(
    alloc: *mut AllocCap,
    eir: *mut EirProgram,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    let n_fns = eir.fn_count();
    if n_fns < 2_u32 {
        return;
    }
    var table = try LayoutGroupTable.init(alloc);
    errdefer table.destroy(alloc);
    try populate_layout_groups(alloc, eir, env, &mut table);

    var inst_remap = try col.HashMap.[u32].init(alloc, 16_usize);
    errdefer inst_remap.destroy(alloc);
    var remap_dups = try col.DynBuf.[u32].init(alloc, 16_usize);
    errdefer remap_dups.destroy(alloc);
    var remap_canons = try col.DynBuf.[u32].init(alloc, 16_usize);
    errdefer remap_canons.destroy(alloc);
    var drop_indices = try col.BitSet.init(alloc, n_fns.widen.[usize]());
    errdefer drop_indices.destroy(alloc);
    var tag_buf = try str.StrBuf.init(alloc, 64_usize);
    errdefer tag_buf.destroy(alloc);

    let ngroups = table.groups.len();
    var gi: usize = 0_usize;
    while gi < ngroups {
        if let gp = table.groups.get(gi) {
            let g = gp.*;
            if g.mem_len >= 2_u32 {
                let canon_idx = u32_at(&table.mem_fn, g.mem_head.widen.[usize]());
                var canon_key = cfg_ir.fn_key_top_def(resolve.DEF_NONE);
                if let cf = eir.get_fn(canon_idx) {
                    canon_key = cf.key;
                }
                if canon_key.kind == .GenericInst {
                    let canon_inst_id = canon_key.a;
                    tag_buf.clear();
                    let gl = slice_id_range.[ArgLayout](table.all_layouts.as_slice(), g.layouts);
                    try format_layout_tag(alloc, gl, &mut tag_buf);
                    let tag_r = try eir.add_bytes(alloc, tag_buf.as_bytes());
                    if let cfm = eir.get_fn_mut(canon_idx) {
                        cfm.has_layout_shared_tag = true;
                        cfm.layout_shared_tag = tag_r;
                    }

                    let mstart = eir.meta.layout_members.len().trunc.[u32]();
                    var mlen: u32 = 0_u32;
                    var mcur = g.mem_head;
                    while mcur != EIR_NONE {
                        let mu = mcur.widen.[usize]();
                        let mi = u32_at(&table.mem_fn, mu);
                        if let mf = eir.get_fn(mi) {
                            let mkey = mf.key;
                            let mgargs = mf.base_generic_args;
                            try eir.meta.layout_members.push(
                                alloc,
                                LayoutSharedMember.{ key: mkey, gargs: mgargs },
                            );
                            mlen = mlen +% 1_u32;
                            if mi != canon_idx {
                                if mkey.kind == .GenericInst {
                                    try inst_remap.insert(alloc, mkey.a.widen.[u64](), canon_inst_id);
                                    try remap_dups.push(alloc, mkey.a);
                                    try remap_canons.push(alloc, canon_inst_id);
                                }
                                drop_indices.set(mi.widen.[usize]());
                            }
                        }
                        mcur = u32_at(&table.mem_next, mu);
                    }
                    try eir.meta.layout_shared_groups.push(
                        alloc,
                        LayoutSharedGroup.{
                            canonical_key: cfg_ir.fn_key_generic_inst(canon_inst_id),
                            layout_tag: tag_r,
                            member_insts: ast.range_new(mstart, mlen),
                        },
                    );
                }
            }
        }
        gi = gi +% 1_usize;
    }

    if drop_indices.count_ones() > 0_usize {
        try compact_layout_shared_fns(
            alloc,
            eir,
            &inst_remap,
            remap_dups.as_slice(),
            remap_canons.as_slice(),
            &drop_indices,
        );
    }

    tag_buf.destroy(alloc);
    drop_indices.destroy(alloc);
    remap_canons.destroy(alloc);
    remap_dups.destroy(alloc);
    inst_remap.destroy(alloc);
    table.destroy(alloc);
    return;
}

// ===========================================================================
// Section 5: `eir_lint` (SSA Dominance, Bounds, Definite-Init, Type Invariants)
// ===========================================================================

fn lint_err_msg(
    alloc: *mut AllocCap,
    err_out: *mut str.StrBuf,
    msg: *str,
    fn_id: u32,
) -> !OutOfMemory {
    try err_out.push_str_grow(alloc, "EIR-Lint: ");
    try err_out.push_str_grow(alloc, msg);
    try err_out.push_str_grow(alloc, " in fn#");
    try err_out.push_u64_grow(alloc, fn_id.widen.[u64]());
    return;
}

fn collect_place_uses(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    place_id: u32,
    out: *mut col.DynBuf[EirValue],
) -> !OutOfMemory {
    if let p = eir.get_place(place_id) {
        if p.base.kind == .Val {
            try out.push(alloc, p.base.id);
        }
        let ps = eir.projs_slice(p.projs);
        var i: usize = 0_usize;
        while i < ps.len {
            if ps[i].kind == .Index {
                try out.push(alloc, ps[i].index);
            }
            i = i +% 1_usize;
        }
    }
    return;
}

pub fn collect_inst_uses(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    inst: *EirInst,
    out: *mut col.DynBuf[EirValue],
) -> !OutOfMemory {
    out.clear();
    match inst.kind {
        .Const => {}
        .SlotAddr => {}
        .LoadSlot => {}
        .GetVar => {}
        .ParForHint => {}
        .Copy => { try out.push(alloc, inst.v0); }
        .StoreSlot => { try out.push(alloc, inst.v0); }
        .Unary => { try out.push(alloc, inst.v0); }
        .Cast => { try out.push(alloc, inst.v0); }
        .UnwrapOptional => { try out.push(alloc, inst.v0); }
        .UnwrapErrorOk => { try out.push(alloc, inst.v0); }
        .UnwrapErrorErr => { try out.push(alloc, inst.v0); }
        .IsNonNull => { try out.push(alloc, inst.v0); }
        .IsError => { try out.push(alloc, inst.v0); }
        .MatchTag => { try out.push(alloc, inst.v0); }
        .FieldExtract => { try out.push(alloc, inst.v0); }
        .MakeDyn => { try out.push(alloc, inst.v0); }
        .SetVar => { try out.push(alloc, inst.v0); }
        .MakeClosure => {
            if inst.v0 != EIR_NONE {
                try out.push(alloc, inst.v0);
            }
        }
        .LoadPlace => { try collect_place_uses(alloc, eir, inst.aux0, out); }
        .PlaceAddr => { try collect_place_uses(alloc, eir, inst.aux0, out); }
        .StorePlace => {
            try collect_place_uses(alloc, eir, inst.aux0, out);
            try out.push(alloc, inst.v0);
        }
        .PoolColumnLoad => {
            if let op = eir.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Val {
                    try out.push(alloc, op.pool_base.id);
                }
                try out.push(alloc, op.index);
            }
        }
        .PoolColumnStore => {
            if let op = eir.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Val {
                    try out.push(alloc, op.pool_base.id);
                }
                try out.push(alloc, op.index);
            }
            try out.push(alloc, inst.v0);
        }
        .Binary => {
            try out.push(alloc, inst.v0);
            try out.push(alloc, inst.v1);
        }
        .Slice => {
            try out.push(alloc, inst.v0);
            if inst.v1 != EIR_NONE {
                try out.push(alloc, inst.v1);
            }
            if inst.v2 != EIR_NONE {
                try out.push(alloc, inst.v2);
            }
        }
        .VecLoad => {
            try out.push(alloc, inst.v0);
            try out.push(alloc, inst.v1);
        }
        .VecStore => {
            try out.push(alloc, inst.v0);
            try out.push(alloc, inst.v1);
            try out.push(alloc, inst.v2);
        }
        .VecFma => {
            try out.push(alloc, inst.v0);
            try out.push(alloc, inst.v1);
            try out.push(alloc, inst.v2);
        }
        .Aggregate => {
            try out.push_slice(alloc, eir.vals_slice(inst.range));
        }
        .Call => {
            if let cd = eir.get_call(inst.aux0) {
                if cd.callee.kind == .FnPtr {
                    try out.push(alloc, cd.callee.a);
                }
                try out.push_slice(alloc, eir.vals_slice(cd.args));
            }
        }
        .BuiltinCall => {
            if let bc = eir.get_builtin_call(inst.aux0) {
                try out.push_slice(alloc, eir.vals_slice(bc.args));
            }
        }
        .InlineAsm => {
            if let ad = eir.get_asm(inst.aux0) {
                let inps = eir.asm_inputs_slice(ad.inputs);
                var i: usize = 0_usize;
                while i < inps.len {
                    try out.push(alloc, inps[i].val);
                    i = i +% 1_usize;
                }
            }
        }
    }
    return;
}

fn lint_reg_def(
    alloc: *mut AllocCap,
    v: EirValue,
    bb: BlockId,
    pos: u32,
    nvals: usize,
    fn_id: u32,
    def_bb: *mut [u32],
    def_pos: *mut [u32],
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let vu = v.widen.[usize]();
    if vu >= nvals || vu >= def_bb.len || vu >= def_pos.len {
        try lint_err_msg(alloc, err_out, "SSA value out of range", fn_id);
        return false;
    }
    if def_bb[vu] != EIR_NONE {
        try lint_err_msg(alloc, err_out, "SSA value defined twice", fn_id);
        return false;
    }
    def_bb[vu] = bb;
    def_pos[vu] = pos;
    return true;
}

fn lint_check_use(
    alloc: *mut AllocCap,
    blks: *[EirBlock],
    v: EirValue,
    use_bb: BlockId,
    use_pos: u32,
    nvals: usize,
    fn_id: u32,
    def_bb: *[u32],
    def_pos: *[u32],
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let vu = v.widen.[usize]();
    if vu >= nvals || vu >= def_bb.len || vu >= def_pos.len {
        try lint_err_msg(alloc, err_out, "SSA value use out of range", fn_id);
        return false;
    }
    let dbb = def_bb[vu];
    if dbb == EIR_NONE {
        try lint_err_msg(alloc, err_out, "use of undefined SSA value", fn_id);
        return false;
    }
    if !dominates_dense_blocks(blks, dbb, use_bb) {
        try lint_err_msg(alloc, err_out, "SSA definition does not dominate use", fn_id);
        return false;
    }
    if dbb == use_bb && def_pos[vu] >= use_pos {
        try lint_err_msg(alloc, err_out, "SSA value used before its definition", fn_id);
        return false;
    }
    return true;
}

fn lint_track_inst_slots(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    inst: *EirInst,
    nslots: usize,
    fn_id: u32,
    slot_written: *mut col.BitSet,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    match inst.kind {
        .StoreSlot => {
            if inst.aux0.widen.[usize]() >= nslots {
                try lint_err_msg(alloc, err_out, "StoreSlot out of range", fn_id);
                return false;
            }
            slot_written.set(inst.aux0.widen.[usize]());
        }
        .SlotAddr => {
            if inst.aux0.widen.[usize]() >= nslots {
                try lint_err_msg(alloc, err_out, "SlotAddr out of range", fn_id);
                return false;
            }
            slot_written.set(inst.aux0.widen.[usize]());
        }
        .LoadSlot => {
            if inst.aux0.widen.[usize]() >= nslots {
                try lint_err_msg(alloc, err_out, "LoadSlot out of range", fn_id);
                return false;
            }
        }
        .StorePlace => {
            if let pl = eir.get_place(inst.aux0) {
                if pl.base.kind == .Slot {
                    if pl.base.id.widen.[usize]() >= nslots {
                        try lint_err_msg(alloc, err_out, "StorePlace slot out of range", fn_id);
                        return false;
                    }
                    slot_written.set(pl.base.id.widen.[usize]());
                }
            }
        }
        .PlaceAddr => {
            if let pl = eir.get_place(inst.aux0) {
                if pl.base.kind == .Slot {
                    if pl.base.id.widen.[usize]() >= nslots {
                        try lint_err_msg(alloc, err_out, "PlaceAddr slot out of range", fn_id);
                        return false;
                    }
                    slot_written.set(pl.base.id.widen.[usize]());
                }
            }
        }
        .LoadPlace => {
            if let pl = eir.get_place(inst.aux0) {
                if pl.base.kind == .Slot && pl.base.id.widen.[usize]() >= nslots {
                    try lint_err_msg(alloc, err_out, "LoadPlace slot out of range", fn_id);
                    return false;
                }
            }
        }
        .PoolColumnLoad => {
            if let op = eir.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Slot && op.pool_base.id.widen.[usize]() >= nslots {
                    try lint_err_msg(alloc, err_out, "PoolColumnLoad slot out of range", fn_id);
                    return false;
                }
            }
        }
        .PoolColumnStore => {
            if let op = eir.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Slot {
                    if op.pool_base.id.widen.[usize]() >= nslots {
                        try lint_err_msg(alloc, err_out, "PoolColumnStore slot out of range", fn_id);
                        return false;
                    }
                    slot_written.set(op.pool_base.id.widen.[usize]());
                }
            }
        }
        .BuiltinCall => {
            if let bc = eir.get_builtin_call(inst.aux0) {
                let ss = eir.arg_slots_slice(bc.arg_slots);
                var i: usize = 0_usize;
                while i < ss.len {
                    if ss[i] != EIR_NONE {
                        if ss[i].widen.[usize]() >= nslots {
                            try lint_err_msg(alloc, err_out, "BuiltinCall slot out of range", fn_id);
                            return false;
                        }
                        slot_written.set(ss[i].widen.[usize]());
                    }
                    i = i +% 1_usize;
                }
            }
        }
        _ => {}
    }
    return true;
}

fn is_concrete_eir_ty(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let k = env.get(ty).kind;
    return k != .Error && k != .GenericParam && k != .ComptimeInt && k != .ComptimeFloat;
}

fn phi_types_compatible(phi_ty: types.TyId, in_ty: types.TyId, env: *types.TypeEnv) -> bool {
    if in_ty == phi_ty {
        return true;
    }
    let pn = env.get(phi_ty);
    let in_n = env.get(in_ty);
    if pn.kind == .Never || in_n.kind == .Never {
        return true;
    }
    if pn.kind == .Str && in_n.kind == .Borrow && !in_n.flag0 && in_n.borrow_kind == .Str {
        return true;
    }
    if in_n.kind == .Str && pn.kind == .Borrow && !pn.flag0 && pn.borrow_kind == .Str {
        return true;
    }
    return false;
}

fn lint_fn_types(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let f = eir.get_fn(fn_id) orelse {
        return true;
    };
    let slots = eir.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < slots.len {
        if !is_concrete_eir_ty(slots[si].ty, env) {
            try lint_err_msg(alloc, err_out, "non-concrete type in slot", fn_id);
            return false;
        }
        si = si +% 1_usize;
    }

    let vtys = eir.fn_value_tys(fn_id);
    let blks = eir.fn_blocks(fn_id);
    var bi: usize = 0_usize;
    while bi < blks.len {
        let phis = eir.phis_slice(blks[bi].phis);
        var pi: usize = 0_usize;
        while pi < phis.len {
            let phi = phis[pi];
            if !is_concrete_eir_ty(phi.ty, env) {
                try lint_err_msg(alloc, err_out, "non-concrete type in phi", fn_id);
                return false;
            }
            let incs = eir.phi_incoming(phi.incoming);
            var ii: usize = 0_usize;
            while ii < incs.len {
                let vu = incs[ii].val.widen.[usize]();
                if vu < vtys.len && !phi_types_compatible(phi.ty, vtys[vu], env) {
                    try lint_err_msg(alloc, err_out, "phi incoming type mismatch", fn_id);
                    return false;
                }
                ii = ii +% 1_usize;
            }
            pi = pi +% 1_usize;
        }

        let insts = eir.insts_slice(blks[bi].insts);
        var k: usize = 0_usize;
        while k < insts.len {
            let inst = insts[k];
            if inst.kind == .Const {
                var is_void = false;
                if let c = eir.get_const(inst.aux0) {
                    is_void = c.kind == .Void;
                }
                if !is_void && !is_concrete_eir_ty(inst.ty0, env) {
                    try lint_err_msg(alloc, err_out, "non-concrete type in const", fn_id);
                    return false;
                }
            } else if inst.kind == .IsNonNull || inst.kind == .UnwrapOptional {
                if env.get(inst.ty1).kind != .Optional {
                    try lint_err_msg(alloc, err_out, "Optional op on non-optional type", fn_id);
                    return false;
                }
            } else if inst.kind == .IsError || inst.kind == .UnwrapErrorOk || inst.kind == .UnwrapErrorErr {
                if env.get(inst.ty1).kind != .ErrorUnion {
                    try lint_err_msg(alloc, err_out, "ErrorUnion op on non-error-union type", fn_id);
                    return false;
                }
            }
            k = k +% 1_usize;
        }

        let term = blks[bi].term;
        if term.kind == .Branch {
            let cu = term.val.widen.[usize]();
            if cu >= vtys.len || vtys[cu] != types.TY_BOOL {
                try lint_err_msg(alloc, err_out, "Branch condition has non-bool type", fn_id);
                return false;
            }
        } else if term.kind == .Return && term.flag {
            if f.sig.ret != types.TY_VOID && f.sig.ret != types.TY_NEVER {
                let ru = term.val.widen.[usize]();
                if ru >= vtys.len || !is_concrete_eir_ty(vtys[ru], env) {
                    try lint_err_msg(alloc, err_out, "non-concrete return value type", fn_id);
                    return false;
                }
            }
        }
        bi = bi +% 1_usize;
    }
    return true;
}

fn lint_fn_defs_pass(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    nvals: usize,
    nslots: usize,
    def_bb: *mut [u32],
    def_pos: *mut [u32],
    slot_written: *mut col.BitSet,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let blks = eir.fn_blocks(fn_id);
    let n = blks.len;
    var inc_preds = try col.BitSet.init(alloc, n);
    errdefer inc_preds.destroy(alloc);
    var exp_preds = try col.BitSet.init(alloc, n);
    errdefer exp_preds.destroy(alloc);

    var bi: usize = 0_usize;
    while bi < blks.len {
        let bid = bi.trunc.[u32]();
        let blk = blks[bi];
        let sc = eir.term_successor_count(&blk.term);
        var si: usize = 0_usize;
        while si < sc {
            let succ = eir.term_successor_at(&blk.term, si);
            if succ.widen.[usize]() >= n {
                try lint_err_msg(alloc, err_out, "invalid terminator branch target", fn_id);
                exp_preds.destroy(alloc);
                inc_preds.destroy(alloc);
                return false;
            }
            si = si +% 1_usize;
        }

        exp_preds.clear();
        let bpreds = eir.preds_slice(blk.preds);
        var pri: usize = 0_usize;
        while pri < bpreds.len {
            exp_preds.set(bpreds[pri].widen.[usize]());
            pri = pri +% 1_usize;
        }

        let phis = eir.phis_slice(blk.phis);
        var pi: usize = 0_usize;
        while pi < phis.len {
            let phi = phis[pi];
            let ok_phi = try lint_reg_def(alloc, phi.dst, bid, pi.trunc.[u32](), nvals, fn_id, def_bb, def_pos, err_out);
            if !ok_phi {
                exp_preds.destroy(alloc);
                inc_preds.destroy(alloc);
                return false;
            }
            inc_preds.clear();
            let incs = eir.phi_incoming(phi.incoming);
            var ki: usize = 0_usize;
            while ki < incs.len {
                let p = incs[ki].pred_bb;
                if p.widen.[usize]() >= n {
                    try lint_err_msg(alloc, err_out, "invalid phi predecessor", fn_id);
                    exp_preds.destroy(alloc);
                    inc_preds.destroy(alloc);
                    return false;
                }
                if incs[ki].val.widen.[usize]() >= nvals {
                    try lint_err_msg(alloc, err_out, "phi incoming value out of range", fn_id);
                    exp_preds.destroy(alloc);
                    inc_preds.destroy(alloc);
                    return false;
                }
                inc_preds.set(p.widen.[usize]());
                ki = ki +% 1_usize;
            }
            if !inc_preds.equals(&exp_preds) {
                try lint_err_msg(alloc, err_out, "phi predecessor mismatch", fn_id);
                exp_preds.destroy(alloc);
                inc_preds.destroy(alloc);
                return false;
            }
            pi = pi +% 1_usize;
        }

        let base_pos = phis.len.trunc.[u32]() +% 1_u32;
        let insts = eir.insts_slice(blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let d = inst_def(&insts[ii]);
            if d != EIR_NONE {
                let ok_d = try lint_reg_def(alloc, d, bid, base_pos +% ii.trunc.[u32](), nvals, fn_id, def_bb, def_pos, err_out);
                if !ok_d {
                    exp_preds.destroy(alloc);
                    inc_preds.destroy(alloc);
                    return false;
                }
            }
            let ok_sl = try lint_track_inst_slots(alloc, eir, &insts[ii], nslots, fn_id, slot_written, err_out);
            if !ok_sl {
                exp_preds.destroy(alloc);
                inc_preds.destroy(alloc);
                return false;
            }
            ii = ii +% 1_usize;
        }
        bi = bi +% 1_usize;
    }

    exp_preds.destroy(alloc);
    inc_preds.destroy(alloc);
    return true;
}

fn lint_fn_uses_pass(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    nvals: usize,
    def_bb: *[u32],
    def_pos: *[u32],
    slot_written: *col.BitSet,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let blks = eir.fn_blocks(fn_id);
    var uses = try col.DynBuf.[EirValue].init(alloc, 16_usize);
    errdefer uses.destroy(alloc);

    var bi: usize = 0_usize;
    while bi < blks.len {
        let bid = bi.trunc.[u32]();
        let blk = blks[bi];
        let phis = eir.phis_slice(blk.phis);
        var pi: usize = 0_usize;
        while pi < phis.len {
            let incs = eir.phi_incoming(phis[pi].incoming);
            var ki: usize = 0_usize;
            while ki < incs.len {
                let pbb = incs[ki].pred_bb;
                let pu = pbb.widen.[usize]();
                if pu >= blks.len {
                    try lint_err_msg(alloc, err_out, "phi predecessor out of range", fn_id);
                    uses.destroy(alloc);
                    return false;
                }
                let end_pos = blks[pu].phis.len +% blks[pu].insts.len +% 2_u32;
                let ok_u = try lint_check_use(alloc, blks, incs[ki].val, pbb, end_pos, nvals, fn_id, def_bb, def_pos, err_out);
                if !ok_u {
                    uses.destroy(alloc);
                    return false;
                }
                ki = ki +% 1_usize;
            }
            pi = pi +% 1_usize;
        }

        let base_pos = phis.len.trunc.[u32]() +% 1_u32;
        let insts = eir.insts_slice(blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .GetVar || inst.kind == .SetVar {
                try lint_err_msg(alloc, err_out, "unlowered GetVar/SetVar remains", fn_id);
                uses.destroy(alloc);
                return false;
            }
            try collect_inst_uses(alloc, eir, &inst, &mut uses);
            let us = uses.as_slice();
            var ui: usize = 0_usize;
            while ui < us.len {
                let ok_u = try lint_check_use(alloc, blks, us[ui], bid, base_pos +% ii.trunc.[u32](), nvals, fn_id, def_bb, def_pos, err_out);
                if !ok_u {
                    uses.destroy(alloc);
                    return false;
                }
                ui = ui +% 1_usize;
            }
            if inst.kind == .LoadSlot && !slot_written.test(inst.aux0.widen.[usize]()) {
                try lint_err_msg(alloc, err_out, "LoadSlot from never-initialized slot", fn_id);
                uses.destroy(alloc);
                return false;
            }
            ii = ii +% 1_usize;
        }

        let end_pos = base_pos +% insts.len.trunc.[u32]();
        if blk.term.kind == .Branch || blk.term.kind == .SwitchInt || (blk.term.kind == .Return && blk.term.flag) {
            let ok_t = try lint_check_use(alloc, blks, blk.term.val, bid, end_pos, nvals, fn_id, def_bb, def_pos, err_out);
            if !ok_t {
                uses.destroy(alloc);
                return false;
            }
        }
        bi = bi +% 1_usize;
    }

    uses.destroy(alloc);
    return true;
}

fn lint_eir_fn(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let f = eir.get_fn(fn_id) orelse {
        return true;
    };
    if f.is_emi_stub {
        return true;
    }
    let blks = eir.fn_blocks(fn_id);
    if blks.len == 0_usize {
        try lint_err_msg(alloc, err_out, "function has zero basic blocks", fn_id);
        return false;
    }
    if f.entry.widen.[usize]() >= blks.len {
        try lint_err_msg(alloc, err_out, "entry block out of range", fn_id);
        return false;
    }

    let vtys = eir.fn_value_tys(fn_id);
    let nvals = vtys.len;
    let nslots = eir.fn_slots(fn_id).len;
    var vi: usize = 0_usize;
    while vi < nvals {
        if vtys[vi] == types.TY_ERROR {
            try lint_err_msg(alloc, err_out, "SSA value has TY_ERROR", fn_id);
            return false;
        }
        vi = vi +% 1_usize;
    }

    var def_bb = try col.DynBuf.[u32].init(alloc, if nvals < 4_usize { 4_usize } else { nvals });
    errdefer def_bb.destroy(alloc);
    var def_pos = try col.DynBuf.[u32].init(alloc, if nvals < 4_usize { 4_usize } else { nvals });
    errdefer def_pos.destroy(alloc);
    var i: usize = 0_usize;
    while i < nvals {
        try def_bb.push(alloc, EIR_NONE);
        try def_pos.push(alloc, 0_u32);
        i = i +% 1_usize;
    }

    let params = eir.fn_params(fn_id);
    var pi: usize = 0_usize;
    while pi < params.len {
        let ok_p = try lint_reg_def(
            alloc,
            params[pi],
            f.entry,
            0_u32,
            nvals,
            fn_id,
            def_bb.as_mut_slice(),
            def_pos.as_mut_slice(),
            err_out,
        );
        if !ok_p {
            def_pos.destroy(alloc);
            def_bb.destroy(alloc);
            return false;
        }
        pi = pi +% 1_usize;
    }

    var slot_written = try col.BitSet.init(alloc, nslots);
    errdefer slot_written.destroy(alloc);

    let ok_defs = try lint_fn_defs_pass(
        alloc,
        eir,
        fn_id,
        nvals,
        nslots,
        def_bb.as_mut_slice(),
        def_pos.as_mut_slice(),
        &mut slot_written,
        err_out,
    );
    if !ok_defs {
        slot_written.destroy(alloc);
        def_pos.destroy(alloc);
        def_bb.destroy(alloc);
        return false;
    }

    let ok_uses = try lint_fn_uses_pass(
        alloc,
        eir,
        fn_id,
        nvals,
        def_bb.as_slice(),
        def_pos.as_slice(),
        &slot_written,
        err_out,
    );
    if !ok_uses {
        slot_written.destroy(alloc);
        def_pos.destroy(alloc);
        def_bb.destroy(alloc);
        return false;
    }

    let ok_types = try lint_fn_types(alloc, eir, fn_id, env, err_out);
    slot_written.destroy(alloc);
    def_pos.destroy(alloc);
    def_bb.destroy(alloc);
    return ok_types;
}

/// Full EIR-Lint pass matching `compiler/src/eir.rs::lint_eir`.
/// Returns `true` if all invariants hold; otherwise appends an explanation to `err_out` and returns `false`.
pub fn eir_lint(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    env: *types.TypeEnv,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let n_fns = eir.fn_count();
    var fi: u32 = 0_u32;
    while fi < n_fns {
        let ok = try lint_eir_fn(alloc, eir, fi, env, err_out);
        if !ok {
            return false;
        }
        fi = fi +% 1_u32;
    }
    return true;
}

linear struct WorkerLintOut {
    failed_fi: u32;
    err: str.StrBuf;
    oom: bool;
}

impl WorkerLintOut {
    fn init(alloc: *mut AllocCap) -> WorkerLintOut ! OutOfMemory {
        let err = try str.StrBuf.init(alloc, 64_usize);
        return WorkerLintOut.{ failed_fi: EIR_NONE, err: err, oom: false };
    }

    fn destroy(self: WorkerLintOut, alloc: *mut AllocCap) {
        let WorkerLintOut.{ failed_fi, err, oom } = self;
        _ = failed_fi;
        _ = oom;
        err.destroy(alloc);
    }
}

fn lint_worker_loop(
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    n_fns: usize,
    eir: *EirProgram,
    env: *types.TypeEnv,
    out: *mut WorkerLintOut,
) -> !OutOfMemory {
    var tmp_err = try str.StrBuf.init(alloc, 64_usize);
    errdefer tmp_err.destroy(alloc);
    while true {
        let idx = next_pos.fetch_add(1_u64, .AcqRel).trunc.[usize]();
        if idx >= n_fns {
            break;
        }
        let fi = idx.trunc.[u32]();
        if out.failed_fi != EIR_NONE && fi > out.failed_fi {
            continue;
        }
        tmp_err.clear();
        let ok = try lint_eir_fn(alloc, eir, fi, env, &mut tmp_err);
        if !ok && (out.failed_fi == EIR_NONE || fi < out.failed_fi) {
            out.failed_fi = fi;
            out.err.clear();
            try out.err.push_bytes_grow(alloc, tmp_err.as_bytes());
        }
    }
    tmp_err.destroy(alloc);
    return;
}

fn run_lint_worker_entry(
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    n_fns: usize,
    eir: *EirProgram,
    env: *types.TypeEnv,
    out: *mut WorkerLintOut,
) {
    lint_worker_loop(alloc, next_pos, n_fns, eir, env, out) catch {
        out.oom = true;
    };
}

fn dispatch_lint_workers(
    n_workers: usize,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    n_fns: usize,
    eir: *EirProgram,
    env: *types.TypeEnv,
    w0: *mut WorkerLintOut,
    w1: *mut WorkerLintOut,
    w2: *mut WorkerLintOut,
    w3: *mut WorkerLintOut,
    w4: *mut WorkerLintOut,
    w5: *mut WorkerLintOut,
    w6: *mut WorkerLintOut,
    w7: *mut WorkerLintOut,
    w8: *mut WorkerLintOut,
    w9: *mut WorkerLintOut,
    w10: *mut WorkerLintOut,
    w11: *mut WorkerLintOut,
) {
    par for wi in 0_usize..n_workers {
        if wi == 0_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w0); }
        else if wi == 1_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w1); }
        else if wi == 2_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w2); }
        else if wi == 3_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w3); }
        else if wi == 4_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w4); }
        else if wi == 5_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w5); }
        else if wi == 6_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w6); }
        else if wi == 7_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w7); }
        else if wi == 8_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w8); }
        else if wi == 9_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w9); }
        else if wi == 10_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w10); }
        else if wi == 11_usize { run_lint_worker_entry(alloc, next_pos, n_fns, eir, env, w11); }
    }
}

/// Parallel EIR-Lint pass (up to 12 workers, deterministic lowest-`fn_id` diagnostic order).
pub fn eir_lint_with_jobs(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    env: *types.TypeEnv,
    err_out: *mut str.StrBuf,
    jobs: u32,
) -> bool ! OutOfMemory {
    let n_fns = eir.fn_count().widen.[usize]();
    var n_workers: usize = 1_usize;
    if jobs == 1_u32 {
        n_workers = 1_usize;
    } else if jobs > 1_u32 {
        n_workers = jobs.widen.[usize]();
        if n_workers > 12_usize { n_workers = 12_usize; }
    } else {
        if n_fns < 64_usize {
            n_workers = 1_usize;
        } else if n_fns < 192_usize {
            n_workers = 4_usize;
        } else if n_fns < 480_usize {
            n_workers = 8_usize;
        } else {
            n_workers = 12_usize;
        }
    }
    if n_workers <= 1_usize || n_fns < 16_usize {
        return try eir_lint(alloc, eir, env, err_out);
    }

    var next_pos = sync.AtomicCounter.init(0_u64);
    var w0 = try WorkerLintOut.init(alloc);
    errdefer w0.destroy(alloc);
    var w1 = try WorkerLintOut.init(alloc);
    errdefer w1.destroy(alloc);
    var w2 = try WorkerLintOut.init(alloc);
    errdefer w2.destroy(alloc);
    var w3 = try WorkerLintOut.init(alloc);
    errdefer w3.destroy(alloc);
    var w4 = try WorkerLintOut.init(alloc);
    errdefer w4.destroy(alloc);
    var w5 = try WorkerLintOut.init(alloc);
    errdefer w5.destroy(alloc);
    var w6 = try WorkerLintOut.init(alloc);
    errdefer w6.destroy(alloc);
    var w7 = try WorkerLintOut.init(alloc);
    errdefer w7.destroy(alloc);
    var w8 = try WorkerLintOut.init(alloc);
    errdefer w8.destroy(alloc);
    var w9 = try WorkerLintOut.init(alloc);
    errdefer w9.destroy(alloc);
    var w10 = try WorkerLintOut.init(alloc);
    errdefer w10.destroy(alloc);
    var w11 = try WorkerLintOut.init(alloc);
    errdefer w11.destroy(alloc);

    dispatch_lint_workers(
        n_workers, alloc, &mut next_pos, n_fns, eir, env,
        &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
        &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
    );

    let any_oom = w0.oom || w1.oom || w2.oom || w3.oom || w4.oom || w5.oom
        || w6.oom || w7.oom || w8.oom || w9.oom || w10.oom || w11.oom;

    var best_fi = EIR_NONE;
    var best_w: u32 = EIR_NONE;
    if w0.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w0.failed_fi < best_fi) { best_fi = w0.failed_fi; best_w = 0_u32; }
    if w1.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w1.failed_fi < best_fi) { best_fi = w1.failed_fi; best_w = 1_u32; }
    if w2.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w2.failed_fi < best_fi) { best_fi = w2.failed_fi; best_w = 2_u32; }
    if w3.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w3.failed_fi < best_fi) { best_fi = w3.failed_fi; best_w = 3_u32; }
    if w4.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w4.failed_fi < best_fi) { best_fi = w4.failed_fi; best_w = 4_u32; }
    if w5.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w5.failed_fi < best_fi) { best_fi = w5.failed_fi; best_w = 5_u32; }
    if w6.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w6.failed_fi < best_fi) { best_fi = w6.failed_fi; best_w = 6_u32; }
    if w7.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w7.failed_fi < best_fi) { best_fi = w7.failed_fi; best_w = 7_u32; }
    if w8.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w8.failed_fi < best_fi) { best_fi = w8.failed_fi; best_w = 8_u32; }
    if w9.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w9.failed_fi < best_fi) { best_fi = w9.failed_fi; best_w = 9_u32; }
    if w10.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w10.failed_fi < best_fi) { best_fi = w10.failed_fi; best_w = 10_u32; }
    if w11.failed_fi != EIR_NONE && (best_fi == EIR_NONE || w11.failed_fi < best_fi) { best_fi = w11.failed_fi; best_w = 11_u32; }

    var ok = true;
    if !any_oom && best_w != EIR_NONE {
        ok = false;
        if best_w == 0_u32 { try err_out.push_bytes_grow(alloc, w0.err.as_bytes()); }
        else if best_w == 1_u32 { try err_out.push_bytes_grow(alloc, w1.err.as_bytes()); }
        else if best_w == 2_u32 { try err_out.push_bytes_grow(alloc, w2.err.as_bytes()); }
        else if best_w == 3_u32 { try err_out.push_bytes_grow(alloc, w3.err.as_bytes()); }
        else if best_w == 4_u32 { try err_out.push_bytes_grow(alloc, w4.err.as_bytes()); }
        else if best_w == 5_u32 { try err_out.push_bytes_grow(alloc, w5.err.as_bytes()); }
        else if best_w == 6_u32 { try err_out.push_bytes_grow(alloc, w6.err.as_bytes()); }
        else if best_w == 7_u32 { try err_out.push_bytes_grow(alloc, w7.err.as_bytes()); }
        else if best_w == 8_u32 { try err_out.push_bytes_grow(alloc, w8.err.as_bytes()); }
        else if best_w == 9_u32 { try err_out.push_bytes_grow(alloc, w9.err.as_bytes()); }
        else if best_w == 10_u32 { try err_out.push_bytes_grow(alloc, w10.err.as_bytes()); }
        else if best_w == 11_u32 { try err_out.push_bytes_grow(alloc, w11.err.as_bytes()); }
    }

    w11.destroy(alloc);
    w10.destroy(alloc);
    w9.destroy(alloc);
    w8.destroy(alloc);
    w7.destroy(alloc);
    w6.destroy(alloc);
    w5.destroy(alloc);
    w4.destroy(alloc);
    w3.destroy(alloc);
    w2.destroy(alloc);
    w1.destroy(alloc);
    w0.destroy(alloc);
    if any_oom {
        return OutOfMemory;
    }
    return ok;
}

fn lint_term_has_succ(eir: *EirProgram, term: *EirTerm, target: BlockId) -> bool {
    let sc = eir.term_successor_count(term);
    var si: usize = 0_usize;
    while si < sc {
        if eir.term_successor_at(term, si) == target {
            return true;
        }
        si = si +% 1_usize;
    }
    return false;
}

fn lint_preds_contains(preds: *[BlockId], p: BlockId) -> bool {
    var i: usize = 0_usize;
    while i < preds.len {
        if preds[i] == p {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn lint_struct_reach(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    blks: *[EirBlock],
    entry: BlockId,
    reachable: *mut col.BitSet,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    var work = try col.DynBuf.[BlockId].init(alloc, 16_usize);
    errdefer work.destroy(alloc);
    reachable.set(entry.widen.[usize]());
    try work.push(alloc, entry);

    while !work.is_empty() {
        let u = work.pop() orelse {
            break;
        };
        let uu = u.widen.[usize]();
        if uu >= blks.len {
            continue;
        }
        let term = blks[uu].term;
        let sc = eir.term_successor_count(&term);
        var si: usize = 0_usize;
        while si < sc {
            let v = eir.term_successor_at(&term, si);
            let vu = v.widen.[usize]();
            if v == EIR_NONE || vu >= blks.len {
                try lint_err_msg(alloc, err_out, "invalid terminator branch target", fn_id);
                work.destroy(alloc);
                return false;
            }
            if !reachable.test(vu) {
                reachable.set(vu);
                try work.push(alloc, v);
            }
            si = si +% 1_usize;
        }
    }
    work.destroy(alloc);
    return true;
}

fn lint_struct_rpo(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    n: usize,
    reachable: *col.BitSet,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    var rpo_seen = try col.BitSet.init(alloc, n);
    errdefer rpo_seen.destroy(alloc);
    let rpo = eir.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let b = rpo[ri];
        let bu = b.widen.[usize]();
        if bu >= n {
            try lint_err_msg(alloc, err_out, "RPO block ID out of range", fn_id);
            rpo_seen.destroy(alloc);
            return false;
        }
        if rpo_seen.test(bu) {
            try lint_err_msg(alloc, err_out, "duplicate block ID in RPO", fn_id);
            rpo_seen.destroy(alloc);
            return false;
        }
        rpo_seen.set(bu);
        ri = ri +% 1_usize;
    }
    if !rpo_seen.equals(reachable) {
        try lint_err_msg(alloc, err_out, "RPO does not match reachable CFG blocks", fn_id);
        rpo_seen.destroy(alloc);
        return false;
    }
    rpo_seen.destroy(alloc);
    return true;
}

fn lint_struct_cfg(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    blks: *[EirBlock],
    entry: BlockId,
    reachable: *mut col.BitSet,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let ok_reach = try lint_struct_reach(alloc, eir, fn_id, blks, entry, reachable, err_out);
    if !ok_reach {
        return false;
    }
    let ok_rpo = try lint_struct_rpo(alloc, eir, fn_id, blks.len, reachable, err_out);
    if !ok_rpo {
        return false;
    }

    // Verify `blk.preds` on every reachable block matches exact reachable CFG predecessors.
    var bi: usize = 0_usize;
    while bi < blks.len {
        if reachable.test(bi) {
            let u = bi.trunc.[u32]();
            let term = blks[bi].term;
            let sc = eir.term_successor_count(&term);
            var si: usize = 0_usize;
            while si < sc {
                let v = eir.term_successor_at(&term, si);
                let vu = v.widen.[usize]();
                if vu < blks.len {
                    let vpreds = eir.preds_slice(blks[vu].preds);
                    if !lint_preds_contains(vpreds, u) {
                        try lint_err_msg(alloc, err_out, "CFG edge missing from successor preds list", fn_id);
                        return false;
                    }
                }
                si = si +% 1_usize;
            }
            let bpreds = eir.preds_slice(blks[bi].preds);
            var pi: usize = 0_usize;
            while pi < bpreds.len {
                let p = bpreds[pi];
                let pu = p.widen.[usize]();
                if pu >= blks.len || !reachable.test(pu) {
                    try lint_err_msg(alloc, err_out, "predecessor out of range or unreachable", fn_id);
                    return false;
                }
                let pterm = blks[pu].term;
                if !lint_term_has_succ(eir, &pterm, u) {
                    try lint_err_msg(alloc, err_out, "stale predecessor in blk.preds", fn_id);
                    return false;
                }
                pi = pi +% 1_usize;
            }
        }
        bi = bi +% 1_usize;
    }
    return true;
}

fn lint_struct_defs(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    blks: *[EirBlock],
    reachable: *col.BitSet,
    nvals: usize,
    nslots: usize,
    def_bb: *mut [u32],
    def_pos: *mut [u32],
    slot_written: *mut col.BitSet,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let n = blks.len;
    var inc_preds = try col.BitSet.init(alloc, n);
    errdefer inc_preds.destroy(alloc);
    var exp_preds = try col.BitSet.init(alloc, n);
    errdefer exp_preds.destroy(alloc);

    var bi: usize = 0_usize;
    while bi < blks.len {
        if !reachable.test(bi) {
            bi = bi +% 1_usize;
            continue;
        }
        let bid = bi.trunc.[u32]();
        let blk = blks[bi];
        exp_preds.clear();
        let bpreds = eir.preds_slice(blk.preds);
        var pri: usize = 0_usize;
        while pri < bpreds.len {
            let pu = bpreds[pri].widen.[usize]();
            if pu < n {
                exp_preds.set(pu);
            }
            pri = pri +% 1_usize;
        }

        let phis = eir.phis_slice(blk.phis);
        var pi: usize = 0_usize;
        while pi < phis.len {
            let phi = phis[pi];
            let ok_phi = try lint_reg_def(alloc, phi.dst, bid, pi.trunc.[u32](), nvals, fn_id, def_bb, def_pos, err_out);
            if !ok_phi {
                exp_preds.destroy(alloc);
                inc_preds.destroy(alloc);
                return false;
            }
            inc_preds.clear();
            let incs = eir.phi_incoming(phi.incoming);
            var ki: usize = 0_usize;
            while ki < incs.len {
                let p = incs[ki].pred_bb;
                if p.widen.[usize]() >= n {
                    try lint_err_msg(alloc, err_out, "invalid phi predecessor", fn_id);
                    exp_preds.destroy(alloc);
                    inc_preds.destroy(alloc);
                    return false;
                }
                if incs[ki].val.widen.[usize]() >= nvals {
                    try lint_err_msg(alloc, err_out, "phi incoming value out of range", fn_id);
                    exp_preds.destroy(alloc);
                    inc_preds.destroy(alloc);
                    return false;
                }
                inc_preds.set(p.widen.[usize]());
                ki = ki +% 1_usize;
            }
            if !inc_preds.equals(&exp_preds) {
                try lint_err_msg(alloc, err_out, "phi predecessor mismatch", fn_id);
                exp_preds.destroy(alloc);
                inc_preds.destroy(alloc);
                return false;
            }
            pi = pi +% 1_usize;
        }

        let base_pos = phis.len.trunc.[u32]() +% 1_u32;
        let insts = eir.insts_slice(blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let d = inst_def(&insts[ii]);
            if d != EIR_NONE {
                let ok_d = try lint_reg_def(alloc, d, bid, base_pos +% ii.trunc.[u32](), nvals, fn_id, def_bb, def_pos, err_out);
                if !ok_d {
                    exp_preds.destroy(alloc);
                    inc_preds.destroy(alloc);
                    return false;
                }
            }
            let ok_sl = try lint_track_inst_slots(alloc, eir, &insts[ii], nslots, fn_id, slot_written, err_out);
            if !ok_sl {
                exp_preds.destroy(alloc);
                inc_preds.destroy(alloc);
                return false;
            }
            ii = ii +% 1_usize;
        }
        bi = bi +% 1_usize;
    }

    exp_preds.destroy(alloc);
    inc_preds.destroy(alloc);
    return true;
}

fn lint_struct_uses(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    blks: *[EirBlock],
    reachable: *col.BitSet,
    nvals: usize,
    def_bb: *[u32],
    def_pos: *[u32],
    slot_written: *col.BitSet,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    var uses = try col.DynBuf.[EirValue].init(alloc, 16_usize);
    errdefer uses.destroy(alloc);

    var bi: usize = 0_usize;
    while bi < blks.len {
        if !reachable.test(bi) {
            bi = bi +% 1_usize;
            continue;
        }
        let bid = bi.trunc.[u32]();
        let blk = blks[bi];
        let phis = eir.phis_slice(blk.phis);
        var pi: usize = 0_usize;
        while pi < phis.len {
            let incs = eir.phi_incoming(phis[pi].incoming);
            var ki: usize = 0_usize;
            while ki < incs.len {
                let pbb = incs[ki].pred_bb;
                let pu = pbb.widen.[usize]();
                if pu >= blks.len {
                    try lint_err_msg(alloc, err_out, "phi predecessor out of range", fn_id);
                    uses.destroy(alloc);
                    return false;
                }
                let end_pos = blks[pu].phis.len +% blks[pu].insts.len +% 2_u32;
                let ok_u = try lint_check_use(alloc, blks, incs[ki].val, pbb, end_pos, nvals, fn_id, def_bb, def_pos, err_out);
                if !ok_u {
                    uses.destroy(alloc);
                    return false;
                }
                ki = ki +% 1_usize;
            }
            pi = pi +% 1_usize;
        }

        let base_pos = phis.len.trunc.[u32]() +% 1_u32;
        let insts = eir.insts_slice(blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .GetVar || inst.kind == .SetVar {
                try lint_err_msg(alloc, err_out, "unlowered GetVar/SetVar remains", fn_id);
                uses.destroy(alloc);
                return false;
            }
            try collect_inst_uses(alloc, eir, &inst, &mut uses);
            let us = uses.as_slice();
            var ui: usize = 0_usize;
            while ui < us.len {
                let ok_u = try lint_check_use(alloc, blks, us[ui], bid, base_pos +% ii.trunc.[u32](), nvals, fn_id, def_bb, def_pos, err_out);
                if !ok_u {
                    uses.destroy(alloc);
                    return false;
                }
                ui = ui +% 1_usize;
            }
            if inst.kind == .LoadSlot && !slot_written.test(inst.aux0.widen.[usize]()) {
                try lint_err_msg(alloc, err_out, "LoadSlot from never-initialized slot", fn_id);
                uses.destroy(alloc);
                return false;
            }
            ii = ii +% 1_usize;
        }

        let end_pos = base_pos +% insts.len.trunc.[u32]();
        if blk.term.kind == .Branch || blk.term.kind == .SwitchInt || (blk.term.kind == .Return && blk.term.flag) {
            let ok_t = try lint_check_use(alloc, blks, blk.term.val, bid, end_pos, nvals, fn_id, def_bb, def_pos, err_out);
            if !ok_t {
                uses.destroy(alloc);
                return false;
            }
        }
        bi = bi +% 1_usize;
    }

    uses.destroy(alloc);
    return true;
}

/// Structural SSA & CFG verifier for a single function (used after optimization passes).
pub fn lint_fn(
    alloc: *mut AllocCap,
    eir_prog: *EirProgram,
    fn_id: u32,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let f = eir_prog.get_fn(fn_id) orelse {
        return true;
    };
    if f.is_emi_stub {
        return true;
    }
    let blks = eir_prog.fn_blocks(fn_id);
    if blks.len == 0_usize {
        try lint_err_msg(alloc, err_out, "function has zero basic blocks", fn_id);
        return false;
    }
    if f.entry.widen.[usize]() >= blks.len {
        try lint_err_msg(alloc, err_out, "entry block out of range", fn_id);
        return false;
    }

    var reachable = try col.BitSet.init(alloc, blks.len);
    errdefer reachable.destroy(alloc);
    let ok_cfg = try lint_struct_cfg(alloc, eir_prog, fn_id, blks, f.entry, &mut reachable, err_out);
    if !ok_cfg {
        reachable.destroy(alloc);
        return false;
    }

    let vtys = eir_prog.fn_value_tys(fn_id);
    let nvals = vtys.len;
    let nslots = eir_prog.fn_slots(fn_id).len;
    var vi: usize = 0_usize;
    while vi < nvals {
        if vtys[vi] == types.TY_ERROR {
            try lint_err_msg(alloc, err_out, "SSA value has TY_ERROR", fn_id);
            reachable.destroy(alloc);
            return false;
        }
        vi = vi +% 1_usize;
    }

    var def_bb = try col.DynBuf.[u32].init(alloc, if nvals < 4_usize { 4_usize } else { nvals });
    errdefer def_bb.destroy(alloc);
    var def_pos = try col.DynBuf.[u32].init(alloc, if nvals < 4_usize { 4_usize } else { nvals });
    errdefer def_pos.destroy(alloc);
    var i: usize = 0_usize;
    while i < nvals {
        try def_bb.push(alloc, EIR_NONE);
        try def_pos.push(alloc, 0_u32);
        i = i +% 1_usize;
    }

    let params = eir_prog.fn_params(fn_id);
    var pi: usize = 0_usize;
    while pi < params.len {
        let ok_p = try lint_reg_def(
            alloc,
            params[pi],
            f.entry,
            0_u32,
            nvals,
            fn_id,
            def_bb.as_mut_slice(),
            def_pos.as_mut_slice(),
            err_out,
        );
        if !ok_p {
            def_pos.destroy(alloc);
            def_bb.destroy(alloc);
            reachable.destroy(alloc);
            return false;
        }
        pi = pi +% 1_usize;
    }

    var slot_written = try col.BitSet.init(alloc, nslots);
    errdefer slot_written.destroy(alloc);

    let ok_defs = try lint_struct_defs(
        alloc,
        eir_prog,
        fn_id,
        blks,
        &reachable,
        nvals,
        nslots,
        def_bb.as_mut_slice(),
        def_pos.as_mut_slice(),
        &mut slot_written,
        err_out,
    );
    if !ok_defs {
        slot_written.destroy(alloc);
        def_pos.destroy(alloc);
        def_bb.destroy(alloc);
        reachable.destroy(alloc);
        return false;
    }

    let ok_uses = try lint_struct_uses(
        alloc,
        eir_prog,
        fn_id,
        blks,
        &reachable,
        nvals,
        def_bb.as_slice(),
        def_pos.as_slice(),
        &slot_written,
        err_out,
    );
    slot_written.destroy(alloc);
    def_pos.destroy(alloc);
    def_bb.destroy(alloc);
    reachable.destroy(alloc);
    return ok_uses;
}

/// Structural SSA & CFG verifier for an entire `EirProgram` (invoked after optimization passes).
/// Checks valid block IDs, RPO/CFG predecessor consistency, valid value & slot IDs,
/// phi predecessor edge matching, terminator targets, and SSA dominance.
pub fn lint_program(
    alloc: *mut AllocCap,
    eir_prog: *EirProgram,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let n_fns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < n_fns {
        let ok = try lint_fn(alloc, eir_prog, fi, err_out);
        if !ok {
            return false;
        }
        fi = fi +% 1_u32;
    }
    return true;
}

// ===========================================================================
// Section 6: Canonical EIR Dumper (`dump_canonical`)
// ===========================================================================

struct EirDumpEntry {
    key_off: u32;
    key_len: u32;
    body_off: u32;
    body_len: u32;
}

fn cmp_bytes_lex(a: *[u8], b: *[u8]) -> i32 {
    let min_len = if a.len < b.len { a.len } else { b.len };
    var i: usize = 0_usize;
    while i < min_len {
        let ca = a[i];
        let cb = b[i];
        if ca < cb {
            return -1_i32;
        }
        if ca > cb {
            return 1_i32;
        }
        i = i +% 1_usize;
    }
    if a.len < b.len {
        return -1_i32;
    }
    if a.len > b.len {
        return 1_i32;
    }
    return 0_i32;
}

fn cmp_eir_dump_entries(
    keys: *[u8],
    bodies: *[u8],
    a: EirDumpEntry,
    b: EirDumpEntry,
) -> i32 {
    let ka = slice_id_range.[u8](keys, ast.range_new(a.key_off, a.key_len));
    let kb = slice_id_range.[u8](keys, ast.range_new(b.key_off, b.key_len));
    let ord = cmp_bytes_lex(ka, kb);
    if ord != 0_i32 {
        return ord;
    }
    let ba = slice_id_range.[u8](bodies, ast.range_new(a.body_off, a.body_len));
    let bb = slice_id_range.[u8](bodies, ast.range_new(b.body_off, b.body_len));
    return cmp_bytes_lex(ba, bb);
}

fn sort_eir_dump_entries(keys: *[u8], bodies: *[u8], entries: *mut [EirDumpEntry]) {
    let n = entries.len;
    if n <= 1_usize {
        return;
    }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third {
        gap = (gap *% 3_usize) +% 1_usize;
    }
    while gap > 0_usize {
        var i = gap;
        while i < n {
            let cur = entries[i];
            var j = i;
            while j >= gap {
                let prev = j - gap;
                if cmp_eir_dump_entries(keys, bodies, entries[prev], cur) <= 0_i32 {
                    break;
                }
                entries[j] = entries[prev];
                j = prev;
            }
            entries[j] = cur;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

fn push_rust_debug_str(
    alloc: *mut AllocCap,
    bytes: *[u8],
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    try out.push_byte_grow(alloc, b'"');
    var pos: usize = 0_usize;
    while pos < bytes.len {
        let dec = str.decode_utf8_char(bytes, pos);
        if dec.len == 0_usize {
            break;
        }
        let cp = dec.cp;
        if cp == 0_u32 {
            try out.push_str_grow(alloc, "\\0");
        } else if cp == 9_u32 {
            try out.push_str_grow(alloc, "\\t");
        } else if cp == 13_u32 {
            try out.push_str_grow(alloc, "\\r");
        } else if cp == 10_u32 {
            try out.push_str_grow(alloc, "\\n");
        } else if cp == 92_u32 {
            try out.push_str_grow(alloc, "\\\\");
        } else if cp == 34_u32 {
            try out.push_str_grow(alloc, "\\\"");
        } else if cp < 32_u32 || cp == 127_u32 || (cp >= 128_u32 && cp <= 159_u32) {
            try out.push_str_grow(alloc, "\\u{");
            try out.push_hex_u64_grow(alloc, cp.widen.[u64]());
            try out.push_byte_grow(alloc, b'}');
        } else {
            let end = pos +% dec.len;
            var k = pos;
            while k < end && k < bytes.len {
                try out.push_byte_grow(alloc, bytes[k]);
                k = k +% 1_usize;
            }
        }
        pos = pos +% dec.len;
    }
    try out.push_byte_grow(alloc, b'"');
    return;
}

