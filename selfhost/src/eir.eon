    pub fn term_successor_count(self: *Self, term: *EirTerm) -> usize {
        _ = self;
        match term.kind {
            .Goto => { return 1_usize; }
            .Branch => { return 2_usize; }
            .SwitchInt => { return term.targets.len.widen.[usize]() +% 1_usize; }
            .Return => { return 0_usize; }
            .Unreachable => { return 0_usize; }
        }
    }

    pub fn term_successor_at(self: *Self, term: *EirTerm, idx: usize) -> BlockId {
        match term.kind {
            .Goto => { return term.bb0; }
            .Branch => {
                if idx == 0_usize {
                    return term.bb0;
                }
                return term.bb1;
            }
            .SwitchInt => {
                let ts = self.switch_targets_slice(term.targets);
                if idx < ts.len {
                    return ts[idx].target;
                }
                return term.bb0;
            }
            .Return => { return EIR_NONE; }
            .Unreachable => { return EIR_NONE; }
        }
    }

    /// Returns true iff `dom` dominates `cur` in function `fn_id`'s dense dominator tree.
    pub fn dominates_block(self: *Self, fn_id: u32, dom: BlockId, cur: BlockId) -> bool {
        let blks = self.fn_blocks(fn_id);
        return dominates_dense_blocks(blks, dom, cur);
    }

    // --- Phase 9 Proof Metadata, Loop Depth, & IPRA Accessors ---

    pub fn set_fn_value_facts(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        facts: *[EirValueFact],
    ) -> !OutOfMemory {
        let start = self.value_facts.len().trunc.[u32]();
        try self.value_facts.push_slice(alloc, facts);
        let r = ast.range_new(start, facts.len.trunc.[u32]());
        if let f = self.funcs.fns.get_mut(fn_id.widen.[usize]()) {
            f.value_facts = r;
        }
        return;
    }

    /// Updates/extends `fn_id`'s `value_facts` to length `new_nvals` and writes `(dsts[i] -> facts[i])`,
    /// reusing or tail-extending the existing range in place whenever possible (O(callee) instead of O(caller)).
    pub fn extend_fn_value_facts(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        new_nvals: usize,
        dsts: *[EirValue],
        facts: *[EirValueFact],
    ) -> !OutOfMemory {
        var old_r = ast.range_empty();
        if let f = self.get_fn(fn_id) {
            old_r = f.value_facts;
        } else {
            return;
        }
        let old_len = old_r.len.widen.[usize]();
        let old_start = old_r.start.widen.[usize]();
        var base = old_start;
        if old_len >= new_nvals {
            base = old_start;
        } else if old_len > 0_usize && old_start +% old_len == self.value_facts.len() {
            let need = new_nvals - old_len;
            let cur_len = self.value_facts.len();
            try self.value_facts.reserve(alloc, cur_len +% need);
            var k: usize = 0_usize;
            while k < need {
                try self.value_facts.push(alloc, value_fact_unknown());
                k = k +% 1_usize;
            }
            if let fm = self.funcs.fns.get_mut(fn_id.widen.[usize]()) {
                fm.value_facts = ast.range_new(old_r.start, new_nvals.trunc.[u32]());
            }
        } else {
            let new_start = self.value_facts.len();
            try self.value_facts.reserve(alloc, new_start +% new_nvals);
            var i: usize = 0_usize;
            while i < old_len && i < new_nvals {
                let fv = if let fp = self.value_facts.get(old_start +% i) { fp.* } else { value_fact_unknown() };
                try self.value_facts.push(alloc, fv);
                i = i +% 1_usize;
            }
            while i < new_nvals {
                try self.value_facts.push(alloc, value_fact_unknown());
                i = i +% 1_usize;
            }
            base = new_start;
            if let fm = self.funcs.fns.get_mut(fn_id.widen.[usize]()) {
                fm.value_facts = ast.range_new(new_start.trunc.[u32](), new_nvals.trunc.[u32]());
            }
        }
        let vfs = self.value_facts.as_mut_slice();
        var j: usize = 0_usize;
        while j < dsts.len && j < facts.len {
            let du = dsts[j].widen.[usize]();
            let idx = base +% du;
            if du < new_nvals && idx < vfs.len {
                vfs[idx] = facts[j];
            }
            j = j +% 1_usize;
        }
        return;
    }

    /// Replaces `fn_id`'s block `bb` instructions, overwriting in-place when `insts.len <= old_len`.
    pub fn replace_block_insts_reuse(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        bb: BlockId,
        insts: *[EirInst],
        flags: *[u8],
    ) -> !OutOfMemory {
        var old_r = ast.range_empty();
        if let blk = self.fn_block(fn_id, bb) {
            old_r = blk.insts;
        } else {
            return;
        }
        let old_len_u = old_r.len.widen.[usize]();
        let start_u = old_r.start.widen.[usize]();
        if insts.len <= old_len_u {
            let dst_sl = self.funcs.insts.as_mut_slice();
            var i: usize = 0_usize;
            while i < insts.len {
                let pos = start_u +% i;
                if pos < dst_sl.len {
                    dst_sl[pos] = insts[i];
                }
                i = i +% 1_usize;
            }
            var j: usize = 0_usize;
            while j < insts.len {
                let fl: u8 = if j < flags.len { flags[j] } else { 0_u8 };
                let gid = old_r.start +% j.trunc.[u32]();
                if fl != 0_u8 || gid.widen.[usize]() < self.proven_safe_insts.len() {
                    try self.set_inst_proven_flags(alloc, gid, fl);
                }
                j = j +% 1_usize;
            }
            if let bm = self.fn_block_mut(fn_id, bb) {
                bm.insts = ast.range_new(old_r.start, insts.len.trunc.[u32]());
            }
            return;
        }
        if old_len_u > 0_usize && start_u +% old_len_u == self.funcs.insts.len() {
            let dst_sl = self.funcs.insts.as_mut_slice();
            var i: usize = 0_usize;
            while i < old_len_u {
                let pos = start_u +% i;
                if pos < dst_sl.len {
                    dst_sl[pos] = insts[i];
                }
                i = i +% 1_usize;
            }
            while i < insts.len {
                try self.funcs.insts.push(alloc, insts[i]);
                i = i +% 1_usize;
            }
            var j: usize = 0_usize;
            while j < insts.len {
                let fl: u8 = if j < flags.len { flags[j] } else { 0_u8 };
                let gid = old_r.start +% j.trunc.[u32]();
                if fl != 0_u8 || gid.widen.[usize]() < self.proven_safe_insts.len() {
                    try self.set_inst_proven_flags(alloc, gid, fl);
                }
                j = j +% 1_usize;
            }
            if let bm = self.fn_block_mut(fn_id, bb) {
                bm.insts = ast.range_new(old_r.start, insts.len.trunc.[u32]());
            }
            return;
        }
        let nr = try self.append_insts(alloc, insts);
        let n = if insts.len < flags.len { insts.len } else { flags.len };
        var k: usize = 0_usize;
        while k < n {
            if flags[k] != 0_u8 {
                try self.set_inst_proven_flags(alloc, nr.start +% k.trunc.[u32](), flags[k]);
            }
            k = k +% 1_usize;
        }
        if let bm = self.fn_block_mut(fn_id, bb) {
            bm.insts = nr;
        }
        return;
    }

    /// Replaces `fn_id`'s block `bb` phis, overwriting in-place when `phis.len <= old_len`.
    pub fn replace_block_phis_reuse(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        bb: BlockId,
        phis: *[EirPhi],
    ) -> !OutOfMemory {
        var old_r = ast.range_empty();
        if let blk = self.fn_block(fn_id, bb) {
            old_r = blk.phis;
        } else {
            return;
        }
        if phis.len <= old_r.len.widen.[usize]() {
            let start_u = old_r.start.widen.[usize]();
            let dst_sl = self.funcs.phis.as_mut_slice();
            var i: usize = 0_usize;
            while i < phis.len {
                let pos = start_u +% i;
                if pos < dst_sl.len {
                    dst_sl[pos] = phis[i];
                }
                i = i +% 1_usize;
            }
            if let bm = self.fn_block_mut(fn_id, bb) {
                bm.phis = ast.range_new(old_r.start, phis.len.trunc.[u32]());
            }
            return;
        }
        let nr = try self.append_phis(alloc, phis);
        if let bm = self.fn_block_mut(fn_id, bb) {
            bm.phis = nr;
        }
        return;
    }

    pub view fn fn_value_facts(self: *Self, fn_id: u32) -> *[EirValueFact] {
        let all = self.value_facts.as_slice();
        if let f = self.get_fn(fn_id) {
            return slice_id_range.[EirValueFact](all, f.value_facts);
        }
        return empty_slice.[EirValueFact](all);
    }

    pub fn fn_val_fact(self: *Self, fn_id: u32, v: EirValue) -> EirValueFact {
        let facts = self.fn_value_facts(fn_id);
        let idx = v.widen.[usize]();
        if idx < facts.len {
            return facts[idx];
        }
        return value_fact_unknown();
    }

    pub fn set_fn_val_fact(self: *mut Self, fn_id: u32, v: EirValue, fact: EirValueFact) {
        var r = ast.range_empty();
        if let f = self.funcs.fns.get(fn_id.widen.[usize]()) {
            r = f.value_facts;
        }
        if v < r.len {
            let gid = (r.start +% v).widen.[usize]();
            let s = self.value_facts.as_mut_slice();
            if gid < s.len {
                s[gid] = fact;
            }
        }
    }

    pub fn fn_block_inst_global_id(self: *Self, fn_id: u32, bb: BlockId, local_idx: u32) -> u32 {
        let b = self.fn_block(fn_id, bb) orelse {
            return EIR_NONE;
        };
        if local_idx >= b.insts.len {
            return EIR_NONE;
        }
        return b.insts.start +% local_idx;
    }

    pub fn mark_inst_proven(
        self: *mut Self,
        alloc: *mut AllocCap,
        inst_idx: u32,
        flags: u8,
    ) -> !OutOfMemory {
        let idx = inst_idx.widen.[usize]();
        while self.proven_safe_insts.len() <= idx {
            try self.proven_safe_insts.push(alloc, 0_u8);
        }
        let s = self.proven_safe_insts.as_mut_slice();
        if idx < s.len {
            s[idx] = s[idx] | flags;
        }
        return;
    }

    pub fn set_inst_proven_flags(
        self: *mut Self,
        alloc: *mut AllocCap,
        inst_idx: u32,
        flags: u8,
    ) -> !OutOfMemory {
        let idx = inst_idx.widen.[usize]();
        while self.proven_safe_insts.len() <= idx {
            try self.proven_safe_insts.push(alloc, 0_u8);
        }
        let s = self.proven_safe_insts.as_mut_slice();
        if idx < s.len {
            s[idx] = flags;
        }
        return;
    }

    pub fn inst_proven_flags(self: *Self, inst_idx: u32) -> u8 {
        let idx = inst_idx.widen.[usize]();
        let s = self.proven_safe_insts.as_slice();
        if idx < s.len {
            return s[idx];
        }
        return 0_u8;
    }

    pub fn set_block_depth(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        bb: BlockId,
        depth: u8,
    ) -> !OutOfMemory {
        let gid = self.fn_block_global_id(fn_id, bb);
        if gid == EIR_NONE {
            return;
        }
        let idx = gid.widen.[usize]();
        while self.block_loop_depth.len() <= idx {
            try self.block_loop_depth.push(alloc, 0_u8);
        }
        let s = self.block_loop_depth.as_mut_slice();
        if idx < s.len {
            s[idx] = depth;
        }
        return;
    }

    pub fn block_depth(self: *Self, fn_id: u32, bb: BlockId) -> u8 {
        let gid = self.fn_block_global_id(fn_id, bb);
        if gid == EIR_NONE {
            return 0_u8;
        }
        let idx = gid.widen.[usize]();
        let s = self.block_loop_depth.as_slice();
        if idx < s.len {
            return s[idx];
        }
        return 0_u8;
    }

    pub fn set_fn_ipra(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        gpr_clobbers: u16,
        xmm_clobbers: u16,
    ) -> !OutOfMemory {
        let idx = fn_id.widen.[usize]();
        while self.fn_ipra_gpr_clobbers.len() <= idx {
            try self.fn_ipra_gpr_clobbers.push(alloc, 0xFFFF_u16);
        }
        while self.fn_ipra_xmm_clobbers.len() <= idx {
            try self.fn_ipra_xmm_clobbers.push(alloc, 0xFFFF_u16);
        }
        while self.fn_ipra_valid.len() <= idx {
            try self.fn_ipra_valid.push(alloc, 0_u8);
        }
        let gs = self.fn_ipra_gpr_clobbers.as_mut_slice();
        if idx < gs.len {
            gs[idx] = gpr_clobbers;
        }
        let xs = self.fn_ipra_xmm_clobbers.as_mut_slice();
        if idx < xs.len {
            xs[idx] = xmm_clobbers;
        }
        let vs = self.fn_ipra_valid.as_mut_slice();
        if idx < vs.len {
            vs[idx] = 1_u8;
        }
        return;
    }

    pub fn fn_has_ipra(self: *Self, fn_id: u32) -> bool {
        let idx = fn_id.widen.[usize]();
        let vs = self.fn_ipra_valid.as_slice();
        return idx < vs.len && vs[idx] != 0_u8;
    }

    pub fn fn_ipra_gprs(self: *Self, fn_id: u32) -> u16 {
        if !self.fn_has_ipra(fn_id) {
            return 0xFFFF_u16;
        }
        let idx = fn_id.widen.[usize]();
        let gs = self.fn_ipra_gpr_clobbers.as_slice();
        if idx < gs.len {
            return gs[idx];
        }
        return 0xFFFF_u16;
    }

    pub fn fn_ipra_xmms(self: *Self, fn_id: u32) -> u16 {
        if !self.fn_has_ipra(fn_id) {
            return 0xFFFF_u16;
        }
        let idx = fn_id.widen.[usize]();
        let xs = self.fn_ipra_xmm_clobbers.as_slice();
        if idx < xs.len {
            return xs[idx];
        }
        return 0xFFFF_u16;
    }

    pub fn set_fn_opt_eligible(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        flags: u8,
    ) -> !OutOfMemory {
        let idx = fn_id.widen.[usize]();
        while self.fn_is_opt_eligible.len() <= idx {
            try self.fn_is_opt_eligible.push(alloc, 0_u8);
        }
        let s = self.fn_is_opt_eligible.as_mut_slice();
        if idx < s.len {
            s[idx] = flags;
        }
        return;
    }

    pub fn fn_opt_eligible(self: *Self, fn_id: u32) -> u8 {
        let idx = fn_id.widen.[usize]();
        let s = self.fn_is_opt_eligible.as_slice();
        if idx < s.len {
            return s[idx];
        }
        return 0_u8;
    }

    // --- Phase 9 EIR Mutation & Arena Append API (for `eir_opt.eon`) ---

    pub view fn fn_blocks_mut(self: *mut Self, fn_id: u32) -> *mut [EirBlock] {
        var r = ast.range_empty();
        if let f = self.funcs.fns.get(fn_id.widen.[usize]()) {
            r = f.blocks;
        }
        return slice_id_range_mut.[EirBlock](self.funcs.blocks.as_mut_slice(), r);
    }

