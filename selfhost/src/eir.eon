        .VecReduceMin => { return 5_u8; }
        .VecReduceMax => { return 5_u8; }
        .VecDot => { return 5_u8; }
        .VecCmp => { return 6_u8; }
        .VecMaskAny => { return 7_u8; }
        .VecMaskAll => { return 7_u8; }
        .VecBitmask => { return 7_u8; }
        .VecShuffle => { return 8_u8; }
        _ => { return 0_u8; }
    }
}

/// Exact Rust `#[derive(Debug)]` formatter for `CfgBuiltinOp`.
fn write_builtin_op_debug(
    alloc: *mut AllocCap,
    op: *cfg_ir.CfgBuiltinOp,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    try write_builtin_name(alloc, op.kind, out);
    let shape = builtin_op_shape(op.kind);
    if shape == 1_u8 {
        try out.push_str_grow(alloc, "(TyId(");
        try out.push_u64_grow(alloc, op.ty0.widen.[u64]());
        try out.push_str_grow(alloc, "))");
    } else if shape == 2_u8 {
        try out.push_str_grow(alloc, " { elem_ty: TyId(");
        try out.push_u64_grow(alloc, op.ty0.widen.[u64]());
        try out.push_str_grow(alloc, "), is_mut: ");
        try out.push_str_grow(alloc, if op.flag { "true" } else { "false" });
        try out.push_str_grow(alloc, " }");
    } else if shape == 3_u8 {
        try out.push_str_grow(alloc, " { elem_ty: TyId(");
        try out.push_u64_grow(alloc, op.ty0.widen.[u64]());
        try out.push_str_grow(alloc, "), op: Symbol(");
        try out.push_u64_grow(alloc, op.sym.widen.[u64]());
        try out.push_str_grow(alloc, ") }");
    } else if shape == 4_u8 {
        try out.push_byte_grow(alloc, b'(');
        try out.push_u64_grow(alloc, op.len_u8.widen.[u64]());
        try out.push_byte_grow(alloc, b')');
    } else if shape == 5_u8 {
        try out.push_str_grow(alloc, " { vec_ty: TyId(");
        try out.push_u64_grow(alloc, op.ty0.widen.[u64]());
        try out.push_str_grow(alloc, ") }");
    } else if shape == 6_u8 {
        try out.push_str_grow(alloc, " { op: ");
        try write_binary_op_debug(alloc, op.bin_op, out);
        try out.push_str_grow(alloc, ", vec_ty: TyId(");
        try out.push_u64_grow(alloc, op.ty0.widen.[u64]());
        try out.push_str_grow(alloc, ") }");
    } else if shape == 7_u8 {
        try out.push_str_grow(alloc, " { len: ");
        try out.push_u64_grow(alloc, op.len_u8.widen.[u64]());
        try out.push_str_grow(alloc, " }");
    } else if shape == 8_u8 {
        try out.push_str_grow(alloc, " { src_ty: TyId(");
        try out.push_u64_grow(alloc, op.ty0.widen.[u64]());
        try out.push_str_grow(alloc, "), idx_ty: TyId(");
        try out.push_u64_grow(alloc, op.ty1.widen.[u64]());
        try out.push_str_grow(alloc, "), two_src: ");
        try out.push_str_grow(alloc, if op.flag { "true" } else { "false" });
        try out.push_str_grow(alloc, " }");
    }
    return;
}

fn fmt_eir_place_base(
    alloc: *mut AllocCap,
    base: EirPlaceBase,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    match base.kind {
        .Slot => {
            try out.push_byte_grow(alloc, b's');
            try out.push_u64_grow(alloc, base.id.widen.[u64]());
        }
        .Val => {
            try out.push_str_grow(alloc, "%v");
            try out.push_u64_grow(alloc, base.id.widen.[u64]());
        }
    }
    return;
}

fn fmt_eir_place(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    place_id: u32,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    let pl = eir.get_place(place_id) orelse {
        return;
    };
    try fmt_eir_place_base(alloc, pl.base, out);
    let ps = eir.projs_slice(pl.projs);
    var i: usize = 0_usize;
    while i < ps.len {
        let pr = ps[i];
        match pr.kind {
            .Deref => { try out.push_str_grow(alloc, ".*"); }
            .Field => {
                try out.push_byte_grow(alloc, b'.');
                try out.push_bytes_grow(alloc, interner.get(pr.sym));
                try out.push_byte_grow(alloc, b'#');
                try out.push_u64_grow(alloc, pr.index.widen.[u64]());
            }
            .TupleField => {
                try out.push_byte_grow(alloc, b'.');
                try out.push_u64_grow(alloc, pr.index.widen.[u64]());
            }
            .Index => {
                try out.push_str_grow(alloc, "[%v");
                try out.push_u64_grow(alloc, pr.index.widen.[u64]());
                try out.push_byte_grow(alloc, b']');
            }
            .PoolCol => {
                try out.push_str_grow(alloc, ".col:");
                try out.push_bytes_grow(alloc, interner.get(pr.sym));
                try out.push_byte_grow(alloc, b'#');
                try out.push_u64_grow(alloc, pr.index.widen.[u64]());
            }
        }
        i = i +% 1_usize;
    }
    return;
}

fn fmt_eir_val_list(
    alloc: *mut AllocCap,
    vals: *[EirValue],
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    var i: usize = 0_usize;
    while i < vals.len {
        if i > 0_usize {
            try out.push_str_grow(alloc, ", ");
        }
        try out.push_str_grow(alloc, "%v");
        try out.push_u64_grow(alloc, vals[i].widen.[u64]());
        i = i +% 1_usize;
    }
    return;
}

fn fmt_eir_const(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    const_id: u32,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    let k = eir.get_const(const_id) orelse {
        try out.push_str_grow(alloc, "void");
        return;
    };
    match k.kind {
        .Void => { try out.push_str_grow(alloc, "void"); }
        .Bool => {
            try out.push_str_grow(alloc, if k.bool_val { "bool(true)" } else { "bool(false)" });
        }
        .Char => {
            try out.push_str_grow(alloc, "char(");
            try out.push_u64_grow(alloc, k.aux_u32.widen.[u64]());
            try out.push_byte_grow(alloc, b')');
        }
        .Int => {
            try out.push_str_grow(alloc, "int(");
            try types.push_int_val_grow(alloc, k.int_val, out);
            try out.push_byte_grow(alloc, b')');
        }
        .Float => {
            try out.push_str_grow(alloc, "float(");
            try out.push_bytes_grow(alloc, eir.bytes_slice(k.bytes));
            try out.push_byte_grow(alloc, b')');
        }
        .Str => {
            try out.push_str_grow(alloc, "str(");
            try push_rust_debug_str(alloc, eir.bytes_slice(k.bytes), out);
            try out.push_byte_grow(alloc, b')');
        }
        .Bytes => {
            try out.push_str_grow(alloc, "bytes(");
            try out.push_u64_grow(alloc, k.bytes.len.widen.[u64]());
            try out.push_byte_grow(alloc, b')');
        }
        .Null => { try out.push_str_grow(alloc, "null"); }
        .EnumTag => {
            try out.push_str_grow(alloc, "enum(.");
            try out.push_bytes_grow(alloc, interner.get(k.sym));
            try out.push_byte_grow(alloc, b'=');
            try types.push_int_val_grow(alloc, k.int_val, out);
            try out.push_byte_grow(alloc, b')');
        }
        .ErrorTag => {
            try out.push_str_grow(alloc, "err(.");
            try out.push_bytes_grow(alloc, interner.get(k.sym));
            try out.push_byte_grow(alloc, b'=');
            try out.push_u64_grow(alloc, k.aux_u32.widen.[u64]());
            try out.push_byte_grow(alloc, b')');
        }
        .FnRef => {
            try out.push_str_grow(alloc, "fnref(#");
            try out.push_u64_grow(alloc, k.aux_u32.widen.[u64]());
            try out.push_byte_grow(alloc, b')');
        }
        .ConstDef => {
            try out.push_str_grow(alloc, "constdef(#");
            try out.push_u64_grow(alloc, k.aux_u32.widen.[u64]());
            try out.push_byte_grow(alloc, b')');
        }
    }
    return;
}

fn fmt_eir_agg_kind(
    alloc: *mut AllocCap,
    agg: *cfg_ir.AggregateKind,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    match agg.tag {
        .Struct => { try out.push_str_grow(alloc, "struct"); }
        .AnonStruct => { try out.push_str_grow(alloc, "anon_struct"); }
        .PoolRow => {
            try out.push_str_grow(
                alloc,
                if agg.is_slot_pool { "slot_pool_row" } else { "arena_pool_row" },
            );
        }
        .Tuple => { try out.push_str_grow(alloc, "tuple"); }
        .Array => { try out.push_str_grow(alloc, "array"); }
        .ArrayRepeat => {
            try out.push_str_grow(alloc, "array_repeat[");
            try out.push_u64_grow(alloc, agg.count);
            try out.push_byte_grow(alloc, b']');
        }
        .UnionVariant => {
            try out.push_str_grow(alloc, "union_variant#");
            try out.push_u64_grow(alloc, agg.variant_idx.widen.[u64]());
        }
        .Bitfield => { try out.push_str_grow(alloc, "bitfield"); }
        .Vec => {
            try out.push_str_grow(alloc, "vec[");
            try out.push_u64_grow(alloc, agg.vec_len.widen.[u64]());
            try out.push_byte_grow(alloc, b']');
        }
    }
    return;
}

fn write_val_header(
    alloc: *mut AllocCap,
    v: EirValue,
    ty: types.TyId,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    try out.push_str_grow(alloc, "%v");
    try out.push_u64_grow(alloc, v.widen.[u64]());
    try out.push_str_grow(alloc, ": ");
    try env.format_ty_short(alloc, ty, interner, out);
    try out.push_str_grow(alloc, " = ");
    return;
}

fn fmt_eir_inst_hi(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    inst: *EirInst,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    match inst.kind {
        .UnwrapOptional => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "unwrap_opt %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .UnwrapErrorOk => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "unwrap_ok %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .UnwrapErrorErr => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "unwrap_err %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .IsNonNull => {
            try out.push_str_grow(alloc, "%v");
            try out.push_u64_grow(alloc, inst.dst.widen.[u64]());
            try out.push_str_grow(alloc, ": bool = is_non_null %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .IsError => {
            try out.push_str_grow(alloc, "%v");
            try out.push_u64_grow(alloc, inst.dst.widen.[u64]());
            try out.push_str_grow(alloc, ": bool = is_error %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .MatchTag => {
            let dty = eir.fn_val_ty(fn_id, inst.dst);
            try write_val_header(alloc, inst.dst, dty, env, interner, out);
            try out.push_str_grow(alloc, "match_tag %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .FieldExtract => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "field_extract %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
            try out.push_byte_grow(alloc, b'.');
            try out.push_u64_grow(alloc, inst.aux0.widen.[u64]());
        }
        .MakeDyn => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, if inst.flag0 { "make_dyn_mut %v" } else { "make_dyn %v" });
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
            try out.push_str_grow(alloc, " (");
            try env.format_ty_short(alloc, inst.ty1, interner, out);
            try out.push_byte_grow(alloc, b')');
        }
        .MakeClosure => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "make_closure cl");
            try out.push_u64_grow(alloc, inst.aux0.widen.[u64]());
            try out.push_byte_grow(alloc, b'(');
            if inst.v0 != EIR_NONE {
                try out.push_str_grow(alloc, "%v");
                try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
            }
            try out.push_byte_grow(alloc, b')');
        }
        .InlineAsm => {
            if let ad = eir.get_asm(inst.aux0) {
                try out.push_str_grow(alloc, "inline_asm ");
                try push_rust_debug_str(alloc, eir.bytes_slice(ad.template), out);
                try out.push_str_grow(alloc, " (");
                let inps = eir.asm_inputs_slice(ad.inputs);
                var i: usize = 0_usize;
                while i < inps.len {
                    if i > 0_usize {
                        try out.push_str_grow(alloc, ", ");
                    }
                    try out.push_bytes_grow(alloc, eir.bytes_slice(inps[i].name));
                    try out.push_str_grow(alloc, ":%v");
                    try out.push_u64_grow(alloc, inps[i].val.widen.[u64]());
                    i = i +% 1_usize;
                }
                try out.push_byte_grow(alloc, b')');
            }
        }
        .Call => {
            if let cd = eir.get_call(inst.aux0) {
                if inst.dst != EIR_NONE {
                    try write_val_header(alloc, inst.dst, cd.ret_ty, env, interner, out);
                }
                try out.push_str_grow(alloc, "call ");
                try fmt_eir_callee(alloc, eir, cd.callee, interner, out);
                try out.push_byte_grow(alloc, b'(');
                try fmt_eir_val_list(alloc, eir.vals_slice(cd.args), out);
                try out.push_str_grow(alloc, ") -> ");
                try env.format_ty_short(alloc, cd.ret_ty, interner, out);
            }
        }
        .BuiltinCall => {
            if let bc = eir.get_builtin_call(inst.aux0) {
                if inst.dst != EIR_NONE {
                    try write_val_header(alloc, inst.dst, bc.ret_ty, env, interner, out);
                }
                try out.push_str_grow(alloc, "builtin ");
                try write_builtin_op_debug(alloc, &bc.op, out);
                try out.push_byte_grow(alloc, b'(');
                try fmt_eir_val_list(alloc, eir.vals_slice(bc.args), out);
                try out.push_str_grow(alloc, ") -> ");
                try env.format_ty_short(alloc, bc.ret_ty, interner, out);
            }
        }
        .GetVar => {
            let dty = eir.fn_val_ty(fn_id, inst.dst);
            try write_val_header(alloc, inst.dst, dty, env, interner, out);
            try out.push_str_grow(alloc, "get_var l");
            try out.push_u64_grow(alloc, inst.aux0.widen.[u64]());
        }
        .SetVar => {
            try out.push_str_grow(alloc, "set_var l");
            try out.push_u64_grow(alloc, inst.aux0.widen.[u64]());
            try out.push_str_grow(alloc, " = %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .ParForHint => {
            try out.push_str_grow(alloc, "par_for_hint r");
            try out.push_u64_grow(alloc, inst.aux0.widen.[u64]());
        }
        .VecLoad => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "vec_load %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
            try out.push_str_grow(alloc, "[%v");
            try out.push_u64_grow(alloc, inst.v1.widen.[u64]());
            try out.push_byte_grow(alloc, b']');
        }
        .VecStore => {
            try out.push_str_grow(alloc, "vec_store %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
            try out.push_str_grow(alloc, "[%v");
            try out.push_u64_grow(alloc, inst.v1.widen.[u64]());
            try out.push_str_grow(alloc, "] = %v");
            try out.push_u64_grow(alloc, inst.v2.widen.[u64]());
        }
        .VecFma => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "vec_fma(%v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
            try out.push_str_grow(alloc, ", %v");
            try out.push_u64_grow(alloc, inst.v1.widen.[u64]());
            try out.push_str_grow(alloc, ", %v");
            try out.push_u64_grow(alloc, inst.v2.widen.[u64]());
            try out.push_byte_grow(alloc, b')');
        }
        _ => {}
    }
    return;
}

fn fmt_eir_callee(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    callee: EirCallee,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    match callee.kind {
        .DirectFn => {
            if let idx = eir.find_fn_by_key(cfg_ir.fn_key_top_def(callee.a)) {
                if let tf = eir.get_fn(idx) {
                    try out.push_str_grow(alloc, "fn:");
                    try out.push_bytes_grow(alloc, interner.get(tf.name));
                    return;
                }
            }
            try out.push_str_grow(alloc, "def#");
            try out.push_u64_grow(alloc, callee.a.widen.[u64]());
        }
        .Method => {
            if let idx = eir.find_fn_by_key(cfg_ir.fn_key_impl_method(callee.a, callee.b)) {
                if let tf = eir.get_fn(idx) {
                    try out.push_str_grow(alloc, "method:");
                    try out.push_bytes_grow(alloc, interner.get(tf.name));
                    return;
                }
            }
            try out.push_str_grow(alloc, "method#");
            try out.push_u64_grow(alloc, callee.a.widen.[u64]());
            try out.push_byte_grow(alloc, b'.');
            try out.push_u64_grow(alloc, callee.b.widen.[u64]());
        }
        .GenericInst => {
            if let idx = eir.find_fn_by_key(cfg_ir.fn_key_generic_inst(callee.a)) {
                if let tf = eir.get_fn(idx) {
                    try out.push_str_grow(alloc, "inst:");
                    try out.push_bytes_grow(alloc, interner.get(tf.name));
                    return;
                }
            }
            try out.push_str_grow(alloc, "inst#");
            try out.push_u64_grow(alloc, callee.a.widen.[u64]());
        }
        .DynCall => {
            try out.push_str_grow(alloc, "dyn#");
            try out.push_u64_grow(alloc, callee.a.widen.[u64]());
            try out.push_byte_grow(alloc, b'.');
            try out.push_u64_grow(alloc, callee.b.widen.[u64]());
        }
        .ExternFn => {
            try out.push_str_grow(alloc, "extern:");
            try out.push_bytes_grow(alloc, interner.get(callee.b));
        }
        .FnPtr => {
            try out.push_str_grow(alloc, "fnptr:%v");
            try out.push_u64_grow(alloc, callee.a.widen.[u64]());
        }
    }
    return;
}

fn fmt_eir_inst_pool_col(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    inst: *EirInst,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    let op = eir.get_pool_col_op(inst.aux0) orelse {
        return;
    };
    if inst.kind == .PoolColumnLoad {
        try write_val_header(alloc, inst.dst, op.elem_ty, env, interner, out);
        try out.push_str_grow(alloc, "pool_col_load ");
        try fmt_eir_place_base(alloc, op.pool_base, out);
        try out.push_byte_grow(alloc, b'.');
        try out.push_bytes_grow(alloc, interner.get(op.col));
        try out.push_str_grow(alloc, "[%v");
        try out.push_u64_grow(alloc, op.index.widen.[u64]());
        try out.push_byte_grow(alloc, b']');
    } else {
        try out.push_str_grow(alloc, "pool_col_store ");
        try fmt_eir_place_base(alloc, op.pool_base, out);
        try out.push_byte_grow(alloc, b'.');
        try out.push_bytes_grow(alloc, interner.get(op.col));
        try out.push_str_grow(alloc, "[%v");
        try out.push_u64_grow(alloc, op.index.widen.[u64]());
        try out.push_str_grow(alloc, "] = %v");
        try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        try out.push_str_grow(alloc, ": ");
        try env.format_ty_short(alloc, op.elem_ty, interner, out);
    }
    return;
}

fn fmt_eir_inst(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    inst: *EirInst,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    match inst.kind {
        .Const => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "const ");
            try fmt_eir_const(alloc, eir, inst.aux0, interner, out);
        }
        .Copy => {
            let dty = eir.fn_val_ty(fn_id, inst.dst);
            try write_val_header(alloc, inst.dst, dty, env, interner, out);
            try out.push_str_grow(alloc, "copy %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .LoadSlot => {
            let dty = eir.fn_val_ty(fn_id, inst.dst);
            try write_val_header(alloc, inst.dst, dty, env, interner, out);
            try out.push_str_grow(alloc, "load_slot s");
            try out.push_u64_grow(alloc, inst.aux0.widen.[u64]());
        }
        .StoreSlot => {
            try out.push_str_grow(alloc, "store_slot s");
            try out.push_u64_grow(alloc, inst.aux0.widen.[u64]());
            try out.push_str_grow(alloc, " = %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .SlotAddr => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, if inst.flag0 { "slot_addr_mut s" } else { "slot_addr s" });
            try out.push_u64_grow(alloc, inst.aux0.widen.[u64]());
        }
        .LoadPlace => {
            let dty = eir.fn_val_ty(fn_id, inst.dst);
            try write_val_header(alloc, inst.dst, dty, env, interner, out);
            try out.push_str_grow(alloc, "load_place ");
            try fmt_eir_place(alloc, eir, inst.aux0, interner, out);
        }
        .StorePlace => {
            try out.push_str_grow(alloc, "store_place ");
            try fmt_eir_place(alloc, eir, inst.aux0, interner, out);
            try out.push_str_grow(alloc, " = %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .PlaceAddr => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, if inst.flag0 { "place_addr_mut " } else { "place_addr " });
            try fmt_eir_place(alloc, eir, inst.aux0, interner, out);
        }
        .PoolColumnLoad => { try fmt_eir_inst_pool_col(alloc, eir, inst, env, interner, out); }
        .PoolColumnStore => { try fmt_eir_inst_pool_col(alloc, eir, inst, env, interner, out); }
        .Unary => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "unary ");
            try write_unary_op_debug(alloc, inst.unary_op, out);
            try out.push_str_grow(alloc, " %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .Binary => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "bin ");
            try write_binary_op_debug(alloc, inst.bin_op, out);
            try out.push_byte_grow(alloc, b'(');
            try env.format_ty_short(alloc, inst.ty1, interner, out);
            try out.push_str_grow(alloc, ") %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
            try out.push_str_grow(alloc, ", %v");
            try out.push_u64_grow(alloc, inst.v1.widen.[u64]());
        }
        .Cast => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "cast ");
            try write_cast_kind_debug(alloc, inst.cast_kind, out);
            try out.push_byte_grow(alloc, b'(');
            try env.format_ty_short(alloc, inst.ty1, interner, out);
            try out.push_str_grow(alloc, " -> ");
            try env.format_ty_short(alloc, inst.ty0, interner, out);
            try out.push_str_grow(alloc, ") %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
        }
        .Slice => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "slice %v");
            try out.push_u64_grow(alloc, inst.v0.widen.[u64]());
            try out.push_byte_grow(alloc, b'[');
            if inst.v1 != EIR_NONE {
                try out.push_str_grow(alloc, "%v");
                try out.push_u64_grow(alloc, inst.v1.widen.[u64]());
            }
            try out.push_str_grow(alloc, "..");
            if inst.v2 != EIR_NONE {
                try out.push_str_grow(alloc, "%v");
                try out.push_u64_grow(alloc, inst.v2.widen.[u64]());
            }
            try out.push_byte_grow(alloc, b']');
        }
        .Aggregate => {
            try write_val_header(alloc, inst.dst, inst.ty0, env, interner, out);
            try out.push_str_grow(alloc, "aggregate ");
            if let agg = eir.get_aggregate(inst.aux0) {
                try fmt_eir_agg_kind(alloc, agg, out);
            }
            try out.push_byte_grow(alloc, b'(');
            try fmt_eir_val_list(alloc, eir.vals_slice(inst.range), out);
            try out.push_byte_grow(alloc, b')');
        }
        _ => {
            try fmt_eir_inst_hi(alloc, eir, fn_id, inst, env, interner, out);
        }
    }
    return;
}

fn fmt_eir_term(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    term: *EirTerm,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    match term.kind {
        .Goto => {
            try out.push_str_grow(alloc, "goto bb");
            try out.push_u64_grow(alloc, term.bb0.widen.[u64]());
        }
        .Branch => {
            try out.push_str_grow(alloc, "branch %v");
            try out.push_u64_grow(alloc, term.val.widen.[u64]());
            try out.push_str_grow(alloc, " ? bb");
            try out.push_u64_grow(alloc, term.bb0.widen.[u64]());
            try out.push_str_grow(alloc, " : bb");
            try out.push_u64_grow(alloc, term.bb1.widen.[u64]());
        }
        .SwitchInt => {
            try out.push_str_grow(alloc, "switch %v");
            try out.push_u64_grow(alloc, term.val.widen.[u64]());
            try out.push_str_grow(alloc, " [");
            let ts = eir.switch_targets_slice(term.targets);
            var i: usize = 0_usize;
            while i < ts.len {
                if i > 0_usize {
                    try out.push_str_grow(alloc, ", ");
                }
                try types.push_int_val_grow(alloc, ts[i].val, out);
                try out.push_str_grow(alloc, "->bb");
                try out.push_u64_grow(alloc, ts[i].target.widen.[u64]());
                i = i +% 1_usize;
            }
            try out.push_str_grow(alloc, "] else bb");
            try out.push_u64_grow(alloc, term.bb0.widen.[u64]());
        }
        .Return => {
            if term.flag {
                try out.push_str_grow(alloc, "return %v");
                try out.push_u64_grow(alloc, term.val.widen.[u64]());
            } else {
                try out.push_str_grow(alloc, "return void");
            }
        }
        .Unreachable => {
            if term.flag {
                try out.push_str_grow(alloc, "unreachable(explicit)");
            } else {
                try out.push_str_grow(alloc, "unreachable");
            }
        }
    }
    return;
}

fn fmt_eir_fn_gargs(
    alloc: *mut AllocCap,
    eir: *EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    let args = eir.fn_base_generic_args(fn_id);
    if args.len == 0_usize {
        return;
    }
    try out.push_byte_grow(alloc, b'[');
    var i: usize = 0_usize;
    while i < args.len {
        if i > 0_usize {
            try out.push_str_grow(alloc, ", ");
        }
        let gv = args[i];
        match gv.kind {
            .Ty => { try env.format_ty_short(alloc, gv.id, interner, out); }
            .Int => { try types.push_int_val_grow(alloc, gv.int_val, out); }
            .Variant => { try out.push_bytes_grow(alloc, interner.get(gv.id)); }
        }
        i = i +% 1_usize;
    }
    try out.push_byte_grow(alloc, b']');
    return;
}

fn write_eir_fn_blocks_dump(
    eir: *EirProgram,
    fn_id: u32,
    alloc: *mut AllocCap,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    bodies_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    let slots = eir.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < slots.len {
        let s = slots[si];
        try bodies_buf.push_str_grow(alloc, "  slot s");
        try bodies_buf.push_u64_grow(alloc, s.id.widen.[u64]());
        try bodies_buf.push_str_grow(alloc, ": ");
        try env.format_ty_short(alloc, s.ty, interner, bodies_buf);
        if s.has_name {
            try bodies_buf.push_str_grow(alloc, " (");
            try bodies_buf.push_bytes_grow(alloc, interner.get(s.name));
            try bodies_buf.push_byte_grow(alloc, b')');
        }
        try bodies_buf.push_byte_grow(alloc, b'\n');
        si = si +% 1_usize;
    }

    let blks = eir.fn_blocks(fn_id);
    var bi: usize = 0_usize;
    while bi < blks.len {
        let b = blks[bi];
        try bodies_buf.push_str_grow(alloc, "  bb");
        try bodies_buf.push_u64_grow(alloc, b.id.widen.[u64]());
        try bodies_buf.push_str_grow(alloc, ":\n");

        let phis = eir.phis_slice(b.phis);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len {
            let phi = phis[phi_i];
            try bodies_buf.push_str_grow(alloc, "    phi %v");
            try bodies_buf.push_u64_grow(alloc, phi.dst.widen.[u64]());
            try bodies_buf.push_str_grow(alloc, ": ");
            try env.format_ty_short(alloc, phi.ty, interner, bodies_buf);
            try bodies_buf.push_str_grow(alloc, " = [");
            let incs = eir.phi_incoming(phi.incoming);
            var ki: usize = 0_usize;
            while ki < incs.len {
                if ki > 0_usize {
                    try bodies_buf.push_str_grow(alloc, ", ");
                }
                try bodies_buf.push_str_grow(alloc, "bb");
                try bodies_buf.push_u64_grow(alloc, incs[ki].pred_bb.widen.[u64]());
                try bodies_buf.push_str_grow(alloc, ": %v");
                try bodies_buf.push_u64_grow(alloc, incs[ki].val.widen.[u64]());
                ki = ki +% 1_usize;
            }
            try bodies_buf.push_str_grow(alloc, "]\n");
            phi_i = phi_i +% 1_usize;
        }

        let insts = eir.insts_slice(b.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            try bodies_buf.push_str_grow(alloc, "    ");
            try fmt_eir_inst(alloc, eir, fn_id, &insts[ii], env, interner, bodies_buf);
            try bodies_buf.push_byte_grow(alloc, b'\n');
            ii = ii +% 1_usize;
        }

        try bodies_buf.push_str_grow(alloc, "    term ");
        try fmt_eir_term(alloc, eir, &b.term, bodies_buf);
        try bodies_buf.push_byte_grow(alloc, b'\n');
        bi = bi +% 1_usize;
    }
    return;
}

fn append_eir_fn_dump_entry(
    eir: *EirProgram,
    fn_id: u32,
    alloc: *mut AllocCap,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    gstr_buf: *mut str.StrBuf,
    params_buf: *mut str.StrBuf,
    ret_buf: *mut str.StrBuf,
    keys_buf: *mut str.StrBuf,
    bodies_buf: *mut str.StrBuf,
    entries: *mut col.DynBuf[EirDumpEntry],
) -> !OutOfMemory {
    let f = eir.get_fn(fn_id) orelse {
        return;
    };
    let name = interner.get(f.name);

    gstr_buf.clear();
    try fmt_eir_fn_gargs(alloc, eir, fn_id, env, interner, gstr_buf);

    params_buf.clear();
    let pvals = eir.fn_params(fn_id);
    var pi: usize = 0_usize;
    while pi < pvals.len {
        if pi > 0_usize {
            try params_buf.push_str_grow(alloc, ", ");
        }
        let pv = pvals[pi];
        let pty = eir.fn_val_ty(fn_id, pv);
        try params_buf.push_str_grow(alloc, "%v");
        try params_buf.push_u64_grow(alloc, pv.widen.[u64]());
        try params_buf.push_str_grow(alloc, ": ");
        try env.format_ty_short(alloc, pty, interner, params_buf);
        pi = pi +% 1_usize;
    }

    ret_buf.clear();
    try env.format_ty_short(alloc, f.sig.ret, interner, ret_buf);

    let body_off = bodies_buf.len().trunc.[u32]();
    try bodies_buf.push_str_grow(alloc, "eir ");
    try cfg_ir.write_fn_key_kind(alloc, f.key, f.is_sys, bodies_buf);
    try bodies_buf.push_byte_grow(alloc, b' ');
    try bodies_buf.push_bytes_grow(alloc, name);
    try bodies_buf.push_bytes_grow(alloc, gstr_buf.as_bytes());
    try bodies_buf.push_byte_grow(alloc, b'(');
    try bodies_buf.push_bytes_grow(alloc, params_buf.as_bytes());
    try bodies_buf.push_str_grow(alloc, ") -> ");
    try bodies_buf.push_bytes_grow(alloc, ret_buf.as_bytes());
    try bodies_buf.push_byte_grow(alloc, b'\n');
    try write_eir_fn_blocks_dump(eir, fn_id, alloc, env, interner, bodies_buf);
    let body_len = bodies_buf.len().trunc.[u32]() -% body_off;

    let key_off = keys_buf.len().trunc.[u32]();
    try keys_buf.push_bytes_grow(alloc, name);
    try keys_buf.push_byte_grow(alloc, 9_u8);
    try cfg_ir.write_fn_key_kind(alloc, f.key, f.is_sys, keys_buf);
    try keys_buf.push_byte_grow(alloc, 9_u8);
    try keys_buf.push_bytes_grow(alloc, gstr_buf.as_bytes());
    try keys_buf.push_byte_grow(alloc, 9_u8);
    try keys_buf.push_bytes_grow(alloc, params_buf.as_bytes());
    try keys_buf.push_byte_grow(alloc, 9_u8);
    try keys_buf.push_bytes_grow(alloc, ret_buf.as_bytes());
    let key_len = keys_buf.len().trunc.[u32]() -% key_off;

    try entries.push(
        alloc,
        EirDumpEntry.{
            key_off: key_off,
            key_len: key_len,
            body_off: body_off,
            body_len: body_len,
        },
    );
    return;
}

fn dump_eir_program_canonical(
    eir: *EirProgram,
    alloc: *mut AllocCap,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    let n_fns = eir.fn_count();
    let cap_entries = if n_fns < 4_u32 { 4_usize } else { n_fns.widen.[usize]() };
    var entries = try col.DynBuf.[EirDumpEntry].init(alloc, cap_entries);
    errdefer entries.destroy(alloc);
    var keys_buf = try str.StrBuf.init(alloc, 256_usize);
    errdefer keys_buf.destroy(alloc);
    var bodies_buf = try str.StrBuf.init(alloc, 2048_usize);
    errdefer bodies_buf.destroy(alloc);
    var gstr_buf = try str.StrBuf.init(alloc, 64_usize);
    errdefer gstr_buf.destroy(alloc);
    var params_buf = try str.StrBuf.init(alloc, 128_usize);
    errdefer params_buf.destroy(alloc);
    var ret_buf = try str.StrBuf.init(alloc, 64_usize);
    errdefer ret_buf.destroy(alloc);

    var fi: u32 = 0_u32;
    while fi < n_fns {
        try append_eir_fn_dump_entry(
            eir,
            fi,
            alloc,
            env,
            interner,
            &mut gstr_buf,
            &mut params_buf,
            &mut ret_buf,
            &mut keys_buf,
            &mut bodies_buf,
            &mut entries,
        );
        fi = fi +% 1_u32;
    }

    sort_eir_dump_entries(keys_buf.as_bytes(), bodies_buf.as_bytes(), entries.as_mut_slice());
    let sorted = entries.as_slice();
    let all_bodies = bodies_buf.as_bytes();
    var ei: usize = 0_usize;
    while ei < sorted.len {
        let e = sorted[ei];
        let bslice = slice_id_range.[u8](all_bodies, ast.range_new(e.body_off, e.body_len));
        try out.push_bytes_grow(alloc, bslice);
        ei = ei +% 1_usize;
    }

    ret_buf.destroy(alloc);
    params_buf.destroy(alloc);
    gstr_buf.destroy(alloc);
    bodies_buf.destroy(alloc);
    keys_buf.destroy(alloc);
    entries.destroy(alloc);
    return;
}
