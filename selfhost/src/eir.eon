}

pub struct EirOptConfig {
    pub opt_level: u8;      // 0 = --dev, 2/3 = --release
    pub opt_bisect: i64;    // < 0 = unlimited; >= 0 = stop after N opt passes
    pub verify_opt: bool;   // run eir_lint after each pass
    pub target_avx2: bool;  // enable 256-bit AVX2/FMA lowering
    pub incremental_cgu: bool; // disable non-@inline inlining for sound .emi function caching
    pub opt_size: bool;     // -Os / -Oz size optimization profile
}

pub fn opt_config_dev() -> EirOptConfig {
    return EirOptConfig.{
        opt_level: 0_u8,
        opt_bisect: -1_i64,
        verify_opt: false,
        target_avx2: false,
        incremental_cgu: false,
        opt_size: false,
    };
}

pub fn opt_config_release() -> EirOptConfig {
    return EirOptConfig.{
        opt_level: 2_u8,
        opt_bisect: -1_i64,
        verify_opt: false,
        target_avx2: true,
        incremental_cgu: false,
        opt_size: false,
    };
}

pub fn opt_config_size() -> EirOptConfig {
    return EirOptConfig.{
        opt_level: 2_u8,
        opt_bisect: -1_i64,
        verify_opt: false,
        target_avx2: false,
        incremental_cgu: false,
        opt_size: true,
    };
}

pub const PROVEN_BOUNDS_SAFE: u8 = 1_u8;
pub const PROVEN_NONZERO_DIV: u8 = 2_u8;
pub const PROVEN_NO_OVERFLOW: u8 = 4_u8;
pub const PROVEN_NARROW_U32: u8 = 8_u8;

pub struct EirValueFact {
    pub has_range: bool;
    pub lo_i64: i64;        // proven lower bound (when both bounds fit in i64)
    pub hi_i64: i64;        // proven upper bound (when both bounds fit in i64)
    pub non_neg: bool;      // proven >= 0
    pub non_zero: bool;     // proven != 0
    pub fits_u32: bool;     // proven in [0, 0xFFFFFFFF]
    pub fits_i32: bool;     // proven in [-2147483648, 2147483647]
    pub is_const: bool;     // proven exact constant lo == hi (fits in 64 bits)
    pub const_u64: u64;     // exact constant bits
}

pub fn value_fact_unknown() -> EirValueFact {
    return EirValueFact.{
        has_range: false,
        lo_i64: 0_i64,
        hi_i64: 0_i64,
        non_neg: false,
        non_zero: false,
        fits_u32: false,
        fits_i32: false,
        is_const: false,
        const_u64: 0_u64,
    };
}

pub struct EirFunction {
    pub key: cfg_ir.CfgFnKey;
    pub mod_id: u32;
    pub mod_name: u32;
    pub impl_decl_idx: u32;
    pub is_emi_stub: bool;
    pub name: u32;
    pub body_span: span.Span;
    pub is_sys: bool;
    pub sig: types.FnSig;
    pub params: ast.IdRange;
    pub param_names: ast.IdRange;
    pub slots: ast.IdRange;
    pub value_tys: ast.IdRange;
    pub val_names: ast.IdRange;
    pub blocks: ast.IdRange;
    pub entry: BlockId;
    pub rpo: ast.IdRange;
    pub noalias_params: ast.IdRange;
    pub value_ranges: ast.IdRange;
    pub value_facts: ast.IdRange;
    pub proven_safe_insts: ast.IdRange;
    pub where_clauses: ast.IdRange;
    pub ensures_clauses: ast.IdRange;
    pub loop_invariants: ast.IdRange;
    pub has_base_generic: bool;
    pub base_generic_key: cfg_ir.CfgFnKey;
    pub base_generic_args: ast.IdRange;
    pub has_layout_shared_tag: bool;
    pub layout_shared_tag: ast.IdRange;
    pub par_for_regions: ast.IdRange;
}

// ===========================================================================
// Section 2: Flat Arena Linear Sub-Pools & EirProgram Lifecycle / Accessors
// ===========================================================================

pub linear struct EirFnPools {
    pub fns: col.DynBuf[EirFunction];
    pub by_key: col.HashMap[u32];
    pub blocks: col.DynBuf[EirBlock];
    pub phis: col.DynBuf[EirPhi];
    pub phi_in: col.DynBuf[EirPhiIn];
    pub insts: col.DynBuf[EirInst];
    pub slots: col.DynBuf[EirSlotInfo];
    pub value_tys: col.DynBuf[types.TyId];
    pub param_vals: col.DynBuf[EirValue];
    pub switch_targets: col.DynBuf[cfg_ir.SwitchTarget];
}

impl EirFnPools {
    pub fn init(alloc: *mut AllocCap) -> EirFnPools ! OutOfMemory {
        let fns = try col.DynBuf.[EirFunction].init(alloc, 64_usize);
        errdefer fns.destroy(alloc);
        let by_key = try col.HashMap.[u32].init(alloc, 128_usize);
        errdefer by_key.destroy(alloc);
        let blocks = try col.DynBuf.[EirBlock].init(alloc, 256_usize);
        errdefer blocks.destroy(alloc);
        let phis = try col.DynBuf.[EirPhi].init(alloc, 128_usize);
        errdefer phis.destroy(alloc);
        let phi_in = try col.DynBuf.[EirPhiIn].init(alloc, 256_usize);
        errdefer phi_in.destroy(alloc);
        let insts = try col.DynBuf.[EirInst].init(alloc, 1024_usize);
        errdefer insts.destroy(alloc);
        let slots = try col.DynBuf.[EirSlotInfo].init(alloc, 256_usize);
        errdefer slots.destroy(alloc);
        let value_tys = try col.DynBuf.[types.TyId].init(alloc, 1024_usize);
        errdefer value_tys.destroy(alloc);
        let param_vals = try col.DynBuf.[EirValue].init(alloc, 128_usize);
        errdefer param_vals.destroy(alloc);
        let switch_targets = try col.DynBuf.[cfg_ir.SwitchTarget].init(alloc, 64_usize);
        errdefer switch_targets.destroy(alloc);
        return EirFnPools.{
            fns: fns,
            by_key: by_key,
            blocks: blocks,
            phis: phis,
            phi_in: phi_in,
            insts: insts,
            slots: slots,
            value_tys: value_tys,
            param_vals: param_vals,
            switch_targets: switch_targets,
        };
    }

    pub fn destroy(self: EirFnPools, alloc: *mut AllocCap) {
        let EirFnPools.{
            fns,
            by_key,
            blocks,
            phis,
            phi_in,
            insts,
            slots,
            value_tys,
            param_vals,
            switch_targets,
        } = self;
        fns.destroy(alloc);
        by_key.destroy(alloc);
        blocks.destroy(alloc);
        phis.destroy(alloc);
        phi_in.destroy(alloc);
        insts.destroy(alloc);
        slots.destroy(alloc);
        value_tys.destroy(alloc);
        param_vals.destroy(alloc);
        switch_targets.destroy(alloc);
    }

    pub fn clear_all(self: *mut Self) {
        self.fns.clear();
        self.by_key.clear();
        self.blocks.clear();
        self.phis.clear();
        self.phi_in.clear();
        self.insts.clear();
        self.slots.clear();
        self.value_tys.clear();
        self.param_vals.clear();
        self.switch_targets.clear();
    }
}

pub linear struct EirExprPools {
    pub places: col.DynBuf[EirPlace];
    pub projs: col.DynBuf[EirProj];
    pub consts: col.DynBuf[cfg_ir.CfgConst];
    pub vals: col.DynBuf[EirValue];
    pub arg_slots: col.DynBuf[EirSlot];
    pub aggregates: col.DynBuf[cfg_ir.AggregateKind];
    pub pool_col_ops: col.DynBuf[EirPoolColOp];
    pub calls: col.DynBuf[EirCallData];
    pub builtin_calls: col.DynBuf[EirBuiltinCallData];
    pub asms: col.DynBuf[EirInlineAsmData];
}

impl EirExprPools {
    pub fn init(alloc: *mut AllocCap) -> EirExprPools ! OutOfMemory {
        let places = try col.DynBuf.[EirPlace].init(alloc, 256_usize);
        errdefer places.destroy(alloc);
        let projs = try col.DynBuf.[EirProj].init(alloc, 256_usize);
        errdefer projs.destroy(alloc);
        let consts = try col.DynBuf.[cfg_ir.CfgConst].init(alloc, 256_usize);
        errdefer consts.destroy(alloc);
        let vals = try col.DynBuf.[EirValue].init(alloc, 512_usize);
        errdefer vals.destroy(alloc);
        let arg_slots = try col.DynBuf.[EirSlot].init(alloc, 128_usize);
        errdefer arg_slots.destroy(alloc);
        let aggregates = try col.DynBuf.[cfg_ir.AggregateKind].init(alloc, 64_usize);
        errdefer aggregates.destroy(alloc);
        let pool_col_ops = try col.DynBuf.[EirPoolColOp].init(alloc, 16_usize);
        errdefer pool_col_ops.destroy(alloc);
        let calls = try col.DynBuf.[EirCallData].init(alloc, 256_usize);
        errdefer calls.destroy(alloc);
        let builtin_calls = try col.DynBuf.[EirBuiltinCallData].init(alloc, 128_usize);
        errdefer builtin_calls.destroy(alloc);
        let asms = try col.DynBuf.[EirInlineAsmData].init(alloc, 8_usize);
        errdefer asms.destroy(alloc);
        return EirExprPools.{
            places: places,
            projs: projs,
            consts: consts,
            vals: vals,
            arg_slots: arg_slots,
            aggregates: aggregates,
            pool_col_ops: pool_col_ops,
            calls: calls,
            builtin_calls: builtin_calls,
            asms: asms,
        };
    }

    pub fn destroy(self: EirExprPools, alloc: *mut AllocCap) {
        let EirExprPools.{
            places,
            projs,
            consts,
            vals,
            arg_slots,
            aggregates,
            pool_col_ops,
            calls,
            builtin_calls,
            asms,
        } = self;
        places.destroy(alloc);
        projs.destroy(alloc);
        consts.destroy(alloc);
        vals.destroy(alloc);
        arg_slots.destroy(alloc);
        aggregates.destroy(alloc);
        pool_col_ops.destroy(alloc);
        calls.destroy(alloc);
        builtin_calls.destroy(alloc);
        asms.destroy(alloc);
    }

    pub fn clear_all(self: *mut Self) {
        self.places.clear();
        self.projs.clear();
        self.consts.clear();
        self.vals.clear();
        self.arg_slots.clear();
        self.aggregates.clear();
        self.pool_col_ops.clear();
        self.calls.clear();
        self.builtin_calls.clear();
        self.asms.clear();
    }
}

pub linear struct EirMetaPools {
    pub rpo: col.DynBuf[BlockId];
    pub preds: col.DynBuf[BlockId];
    pub val_names: col.DynBuf[EirValName];
    pub noalias_params: col.DynBuf[u32];
    pub value_ranges: col.DynBuf[EirValRange];
    pub proven_safe_insts: col.DynBuf[EirProvenSafeInst];
    pub par_for_regions: col.DynBuf[EirParForRegion];
    pub layout_shared_groups: col.DynBuf[LayoutSharedGroup];
    pub layout_members: col.DynBuf[LayoutSharedMember];
    pub asm_inputs: col.DynBuf[EirAsmInput];
}

impl EirMetaPools {
    pub fn init(alloc: *mut AllocCap) -> EirMetaPools ! OutOfMemory {
        let rpo = try col.DynBuf.[BlockId].init(alloc, 256_usize);
        errdefer rpo.destroy(alloc);
        let preds = try col.DynBuf.[BlockId].init(alloc, 256_usize);
        errdefer preds.destroy(alloc);
        let val_names = try col.DynBuf.[EirValName].init(alloc, 256_usize);
        errdefer val_names.destroy(alloc);
        let noalias_params = try col.DynBuf.[u32].init(alloc, 64_usize);
        errdefer noalias_params.destroy(alloc);
        let value_ranges = try col.DynBuf.[EirValRange].init(alloc, 16_usize);
        errdefer value_ranges.destroy(alloc);
        let proven_safe_insts = try col.DynBuf.[EirProvenSafeInst].init(alloc, 16_usize);
        errdefer proven_safe_insts.destroy(alloc);
        let par_for_regions = try col.DynBuf.[EirParForRegion].init(alloc, 8_usize);
        errdefer par_for_regions.destroy(alloc);
        let layout_shared_groups = try col.DynBuf.[LayoutSharedGroup].init(alloc, 8_usize);
        errdefer layout_shared_groups.destroy(alloc);
        let layout_members = try col.DynBuf.[LayoutSharedMember].init(alloc, 16_usize);
        errdefer layout_members.destroy(alloc);
        let asm_inputs = try col.DynBuf.[EirAsmInput].init(alloc, 8_usize);
        errdefer asm_inputs.destroy(alloc);
        return EirMetaPools.{
            rpo: rpo,
            preds: preds,
            val_names: val_names,
            noalias_params: noalias_params,
            value_ranges: value_ranges,
            proven_safe_insts: proven_safe_insts,
            par_for_regions: par_for_regions,
            layout_shared_groups: layout_shared_groups,
            layout_members: layout_members,
            asm_inputs: asm_inputs,
        };
    }

    pub fn destroy(self: EirMetaPools, alloc: *mut AllocCap) {
        let EirMetaPools.{
            rpo,
            preds,
            val_names,
            noalias_params,
            value_ranges,
            proven_safe_insts,
            par_for_regions,
            layout_shared_groups,
            layout_members,
            asm_inputs,
        } = self;
        rpo.destroy(alloc);
        preds.destroy(alloc);
        val_names.destroy(alloc);
        noalias_params.destroy(alloc);
        value_ranges.destroy(alloc);
        proven_safe_insts.destroy(alloc);
        par_for_regions.destroy(alloc);
        layout_shared_groups.destroy(alloc);
        layout_members.destroy(alloc);
        asm_inputs.destroy(alloc);
    }

    pub fn clear_all(self: *mut Self) {
        self.rpo.clear();
        self.preds.clear();
        self.val_names.clear();
        self.noalias_params.clear();
        self.value_ranges.clear();
        self.proven_safe_insts.clear();
        self.par_for_regions.clear();
        self.layout_shared_groups.clear();
        self.layout_members.clear();
        self.asm_inputs.clear();
    }
}

pub linear struct EirAuxPools {
    pub str_bytes: col.DynBuf[u8];
    pub sym_list: col.DynBuf[u32];
    pub expr_ids: col.DynBuf[u32];
    pub loop_invariants: col.DynBuf[cfg_ir.LoopInvariantEntry];
    pub gvals: col.DynBuf[types.GenericVal];
    pub extern_fns: col.DynBuf[u32];
    pub dyn_impl_pairs: col.DynBuf[cfg_ir.DynImplPair];
}

impl EirAuxPools {
    pub fn init(alloc: *mut AllocCap) -> EirAuxPools ! OutOfMemory {
        let str_bytes = try col.DynBuf.[u8].init(alloc, 256_usize);
        errdefer str_bytes.destroy(alloc);
        let sym_list = try col.DynBuf.[u32].init(alloc, 128_usize);
        errdefer sym_list.destroy(alloc);
        let expr_ids = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer expr_ids.destroy(alloc);
        let loop_invariants = try col.DynBuf.[cfg_ir.LoopInvariantEntry].init(alloc, 16_usize);
        errdefer loop_invariants.destroy(alloc);
        let gvals = try col.DynBuf.[types.GenericVal].init(alloc, 64_usize);
        errdefer gvals.destroy(alloc);
        let extern_fns = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer extern_fns.destroy(alloc);
        let dyn_impl_pairs = try col.DynBuf.[cfg_ir.DynImplPair].init(alloc, 16_usize);
        errdefer dyn_impl_pairs.destroy(alloc);
        return EirAuxPools.{
            str_bytes: str_bytes,
            sym_list: sym_list,
            expr_ids: expr_ids,
            loop_invariants: loop_invariants,
            gvals: gvals,
            extern_fns: extern_fns,
            dyn_impl_pairs: dyn_impl_pairs,
        };
    }

    pub fn destroy(self: EirAuxPools, alloc: *mut AllocCap) {
        let EirAuxPools.{
            str_bytes,
            sym_list,
            expr_ids,
            loop_invariants,
            gvals,
            extern_fns,
            dyn_impl_pairs,
        } = self;
        str_bytes.destroy(alloc);
        sym_list.destroy(alloc);
        expr_ids.destroy(alloc);
        loop_invariants.destroy(alloc);
        gvals.destroy(alloc);
        extern_fns.destroy(alloc);
        dyn_impl_pairs.destroy(alloc);
    }

    pub fn clear_all(self: *mut Self) {
        self.str_bytes.clear();
        self.sym_list.clear();
        self.expr_ids.clear();
        self.loop_invariants.clear();
        self.gvals.clear();
        self.extern_fns.clear();
        self.dyn_impl_pairs.clear();
    }
}

pub linear struct EirSchedPools {
    pub schedules: col.DynBuf[cfg_ir.ScheduleDag];
    pub sched_waves: col.DynBuf[cfg_ir.ScheduleWave];
    pub sched_systems: col.DynBuf[u32];
    pub dag_nodes: col.DynBuf[cfg_ir.ScheduleDagNode];
    pub dag_deps: col.DynBuf[u32];
}

impl EirSchedPools {
    pub fn init(alloc: *mut AllocCap) -> EirSchedPools ! OutOfMemory {
        let schedules = try col.DynBuf.[cfg_ir.ScheduleDag].init(alloc, 4_usize);
        errdefer schedules.destroy(alloc);
        let sched_waves = try col.DynBuf.[cfg_ir.ScheduleWave].init(alloc, 8_usize);
        errdefer sched_waves.destroy(alloc);
        let sched_systems = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer sched_systems.destroy(alloc);
        let dag_nodes = try col.DynBuf.[cfg_ir.ScheduleDagNode].init(alloc, 8_usize);
        errdefer dag_nodes.destroy(alloc);
        let dag_deps = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer dag_deps.destroy(alloc);
        return EirSchedPools.{
            schedules: schedules,
            sched_waves: sched_waves,
            sched_systems: sched_systems,
            dag_nodes: dag_nodes,
            dag_deps: dag_deps,
        };
    }

    pub fn destroy(self: EirSchedPools, alloc: *mut AllocCap) {
        let EirSchedPools.{ schedules, sched_waves, sched_systems, dag_nodes, dag_deps } = self;
        schedules.destroy(alloc);
        sched_waves.destroy(alloc);
        sched_systems.destroy(alloc);
        dag_nodes.destroy(alloc);
        dag_deps.destroy(alloc);
    }

    pub fn clear_all(self: *mut Self) {
        self.schedules.clear();
        self.sched_waves.clear();
        self.sched_systems.clear();
        self.dag_nodes.clear();
        self.dag_deps.clear();
    }
}

pub linear struct EirProgram {
    pub funcs: EirFnPools;
    pub exprs: EirExprPools;
    pub meta: EirMetaPools;
    pub aux: EirAuxPools;
    pub scheds: EirSchedPools;
    pub value_facts: col.DynBuf[EirValueFact];
    pub proven_safe_insts: col.DynBuf[u8];
    pub block_loop_depth: col.DynBuf[u8];
    pub fn_ipra_gpr_clobbers: col.DynBuf[u16];
    pub fn_ipra_xmm_clobbers: col.DynBuf[u16];
    pub fn_ipra_valid: col.DynBuf[u8];
    pub fn_is_opt_eligible: col.DynBuf[u8];
}

impl EirProgram {
    pub fn init(alloc: *mut AllocCap) -> EirProgram ! OutOfMemory {
        let funcs = try EirFnPools.init(alloc);
        errdefer funcs.destroy(alloc);
        let exprs = try EirExprPools.init(alloc);
        errdefer exprs.destroy(alloc);
        let meta = try EirMetaPools.init(alloc);
        errdefer meta.destroy(alloc);
        let aux = try EirAuxPools.init(alloc);
        errdefer aux.destroy(alloc);
        let scheds = try EirSchedPools.init(alloc);
        errdefer scheds.destroy(alloc);
        let value_facts = try col.DynBuf.[EirValueFact].init(alloc, 16_usize);
        errdefer value_facts.destroy(alloc);
        let proven_safe_insts = try col.DynBuf.[u8].init(alloc, 16_usize);
        errdefer proven_safe_insts.destroy(alloc);
        let block_loop_depth = try col.DynBuf.[u8].init(alloc, 16_usize);
        errdefer block_loop_depth.destroy(alloc);
        let fn_ipra_gpr_clobbers = try col.DynBuf.[u16].init(alloc, 16_usize);
        errdefer fn_ipra_gpr_clobbers.destroy(alloc);
        let fn_ipra_xmm_clobbers = try col.DynBuf.[u16].init(alloc, 16_usize);
        errdefer fn_ipra_xmm_clobbers.destroy(alloc);
        let fn_ipra_valid = try col.DynBuf.[u8].init(alloc, 16_usize);
        errdefer fn_ipra_valid.destroy(alloc);
        let fn_is_opt_eligible = try col.DynBuf.[u8].init(alloc, 16_usize);
        errdefer fn_is_opt_eligible.destroy(alloc);
        return EirProgram.{
            funcs: funcs,
            exprs: exprs,
            meta: meta,
            aux: aux,
            scheds: scheds,
            value_facts: value_facts,
            proven_safe_insts: proven_safe_insts,
            block_loop_depth: block_loop_depth,
            fn_ipra_gpr_clobbers: fn_ipra_gpr_clobbers,
            fn_ipra_xmm_clobbers: fn_ipra_xmm_clobbers,
            fn_ipra_valid: fn_ipra_valid,
            fn_is_opt_eligible: fn_is_opt_eligible,
        };
    }

    pub fn destroy(self: EirProgram, alloc: *mut AllocCap) {
        let EirProgram.{
            funcs,
            exprs,
            meta,
            aux,
            scheds,
            value_facts,
            proven_safe_insts,
            block_loop_depth,
            fn_ipra_gpr_clobbers,
            fn_ipra_xmm_clobbers,
            fn_ipra_valid,
            fn_is_opt_eligible,
        } = self;
        funcs.destroy(alloc);
        exprs.destroy(alloc);
        meta.destroy(alloc);
        aux.destroy(alloc);
        scheds.destroy(alloc);
        value_facts.destroy(alloc);
        proven_safe_insts.destroy(alloc);
        block_loop_depth.destroy(alloc);
        fn_ipra_gpr_clobbers.destroy(alloc);
        fn_ipra_xmm_clobbers.destroy(alloc);
        fn_ipra_valid.destroy(alloc);
        fn_is_opt_eligible.destroy(alloc);
    }

    pub fn clear_all(self: *mut Self) {
        self.funcs.clear_all();
        self.exprs.clear_all();
        self.meta.clear_all();
        self.aux.clear_all();
        self.scheds.clear_all();
        self.value_facts.clear();
        self.proven_safe_insts.clear();
        self.block_loop_depth.clear();
        self.fn_ipra_gpr_clobbers.clear();
        self.fn_ipra_xmm_clobbers.clear();
        self.fn_ipra_valid.clear();
        self.fn_is_opt_eligible.clear();
    }

    // --- Pool Builders ---

    pub fn add_bytes(self: *mut Self, alloc: *mut AllocCap, data: *[u8]) -> ast.IdRange ! OutOfMemory {
        let start = self.aux.str_bytes.len().trunc.[u32]();
        try self.aux.str_bytes.push_slice(alloc, data);
        return ast.range_new(start, data.len.trunc.[u32]());
    }

    pub fn add_str(self: *mut Self, alloc: *mut AllocCap, s: *str) -> ast.IdRange ! OutOfMemory {
        return try self.add_bytes(alloc, s.as_bytes());
    }

    pub fn add_syms(self: *mut Self, alloc: *mut AllocCap, syms: *[u32]) -> ast.IdRange ! OutOfMemory {
        let start = self.aux.sym_list.len().trunc.[u32]();
        try self.aux.sym_list.push_slice(alloc, syms);
        return ast.range_new(start, syms.len.trunc.[u32]());
    }

    pub fn add_expr_ids(self: *mut Self, alloc: *mut AllocCap, ids: *[u32]) -> ast.IdRange ! OutOfMemory {
        let start = self.aux.expr_ids.len().trunc.[u32]();
        try self.aux.expr_ids.push_slice(alloc, ids);
        return ast.range_new(start, ids.len.trunc.[u32]());
    }

    pub fn add_gvals(
        self: *mut Self,
        alloc: *mut AllocCap,
        vals: *[types.GenericVal],
    ) -> ast.IdRange ! OutOfMemory {
        let start = self.aux.gvals.len().trunc.[u32]();
        try self.aux.gvals.push_slice(alloc, vals);
        return ast.range_new(start, vals.len.trunc.[u32]());
    }

    pub fn add_const(self: *mut Self, alloc: *mut AllocCap, c: cfg_ir.CfgConst) -> u32 ! OutOfMemory {
        let id = self.exprs.consts.len().trunc.[u32]();
        try self.exprs.consts.push(alloc, c);
        return id;
    }

    pub fn add_projs(self: *mut Self, alloc: *mut AllocCap, ps: *[EirProj]) -> ast.IdRange ! OutOfMemory {
        let start = self.exprs.projs.len().trunc.[u32]();
        try self.exprs.projs.push_slice(alloc, ps);
        return ast.range_new(start, ps.len.trunc.[u32]());
    }

    pub fn add_place(self: *mut Self, alloc: *mut AllocCap, p: EirPlace) -> u32 ! OutOfMemory {
        let id = self.exprs.places.len().trunc.[u32]();
        try self.exprs.places.push(alloc, p);
        return id;
    }

    pub fn add_vals(self: *mut Self, alloc: *mut AllocCap, vs: *[EirValue]) -> ast.IdRange ! OutOfMemory {
        let start = self.exprs.vals.len().trunc.[u32]();
        try self.exprs.vals.push_slice(alloc, vs);
        return ast.range_new(start, vs.len.trunc.[u32]());
    }

    pub fn add_arg_slots(self: *mut Self, alloc: *mut AllocCap, ss: *[EirSlot]) -> ast.IdRange ! OutOfMemory {
        let start = self.exprs.arg_slots.len().trunc.[u32]();
        try self.exprs.arg_slots.push_slice(alloc, ss);
        return ast.range_new(start, ss.len.trunc.[u32]());
    }

    pub fn add_aggregate(
        self: *mut Self,
        alloc: *mut AllocCap,
        kind: cfg_ir.AggregateKind,
    ) -> u32 ! OutOfMemory {
        let id = self.exprs.aggregates.len().trunc.[u32]();
        try self.exprs.aggregates.push(alloc, kind);
        return id;
    }

    pub fn add_pool_col_op(
        self: *mut Self,
        alloc: *mut AllocCap,
        op: EirPoolColOp,
    ) -> u32 ! OutOfMemory {
        let id = self.exprs.pool_col_ops.len().trunc.[u32]();
        try self.exprs.pool_col_ops.push(alloc, op);
        return id;
    }

    pub fn add_call(self: *mut Self, alloc: *mut AllocCap, c: EirCallData) -> u32 ! OutOfMemory {
        let id = self.exprs.calls.len().trunc.[u32]();
        try self.exprs.calls.push(alloc, c);
        return id;
    }

    pub fn add_builtin_call(
        self: *mut Self,
        alloc: *mut AllocCap,
        bc: EirBuiltinCallData,
    ) -> u32 ! OutOfMemory {
        let id = self.exprs.builtin_calls.len().trunc.[u32]();
        try self.exprs.builtin_calls.push(alloc, bc);
        return id;
    }

    pub fn add_asm(self: *mut Self, alloc: *mut AllocCap, data: EirInlineAsmData) -> u32 ! OutOfMemory {
        let id = self.exprs.asms.len().trunc.[u32]();
        try self.exprs.asms.push(alloc, data);
        return id;
    }

    pub fn add_asm_inputs(
        self: *mut Self,
        alloc: *mut AllocCap,
        inputs: *[EirAsmInput],
    ) -> ast.IdRange ! OutOfMemory {
        let start = self.meta.asm_inputs.len().trunc.[u32]();
        try self.meta.asm_inputs.push_slice(alloc, inputs);
        return ast.range_new(start, inputs.len.trunc.[u32]());
    }

    pub fn add_switch_targets(
        self: *mut Self,
        alloc: *mut AllocCap,
        targets: *[cfg_ir.SwitchTarget],
    ) -> ast.IdRange ! OutOfMemory {
        let start = self.funcs.switch_targets.len().trunc.[u32]();
        try self.funcs.switch_targets.push_slice(alloc, targets);
        return ast.range_new(start, targets.len.trunc.[u32]());
    }

    pub fn add_fn(self: *mut Self, alloc: *mut AllocCap, func: EirFunction) -> u32 ! OutOfMemory {
        let fn_id = self.funcs.fns.len().trunc.[u32]();
        let key_u64 = cfg_ir.fn_key_u64(func.key);
        try self.funcs.fns.push(alloc, func);
        try self.funcs.by_key.insert(alloc, key_u64, fn_id);
        return fn_id;
    }

    /// Attaches verifier-computed value ranges to `fn_id` (used by `verify.eon` and `mach_x64.eon`).
    pub fn set_fn_value_ranges(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        ranges: *[EirValRange],
    ) -> !OutOfMemory {
        let start = self.meta.value_ranges.len().trunc.[u32]();
        try self.meta.value_ranges.push_slice(alloc, ranges);
        let r = ast.range_new(start, ranges.len.trunc.[u32]());
        if let f = self.funcs.fns.get_mut(fn_id.widen.[usize]()) {
            f.value_ranges = r;
        }
        return;
    }

    /// Attaches verifier-computed proven-safe instruction coordinates to `fn_id`.
    pub fn set_fn_proven_safe_insts(
        self: *mut Self,
        alloc: *mut AllocCap,
        fn_id: u32,
        insts: *[EirProvenSafeInst],
    ) -> !OutOfMemory {
        let start = self.meta.proven_safe_insts.len().trunc.[u32]();
        try self.meta.proven_safe_insts.push_slice(alloc, insts);
        let r = ast.range_new(start, insts.len.trunc.[u32]());
        if let f = self.funcs.fns.get_mut(fn_id.widen.[usize]()) {
            f.proven_safe_insts = r;
        }
        return;
    }

    // --- Accessors for `interp.eon`, `verify.eon`, `mach_x64.eon` ---

    pub fn fn_count(self: *Self) -> u32 {
        return self.funcs.fns.len().trunc.[u32]();
    }

    pub fn block_count(self: *Self) -> u32 {
        return self.funcs.blocks.len().trunc.[u32]();
    }

    pub fn schedule_count(self: *Self) -> u32 {
        return self.scheds.schedules.len().trunc.[u32]();
    }

    pub fn dyn_impl_pair_count(self: *Self) -> u32 {
        return self.aux.dyn_impl_pairs.len().trunc.[u32]();
    }

    pub fn extern_fn_count(self: *Self) -> u32 {
        return self.aux.extern_fns.len().trunc.[u32]();
    }

    pub fn layout_shared_group_count(self: *Self) -> u32 {
        return self.meta.layout_shared_groups.len().trunc.[u32]();
    }

    pub fn find_fn_by_key(self: *Self, key: cfg_ir.CfgFnKey) -> ?u32 {
        return self.funcs.by_key.get(cfg_ir.fn_key_u64(key));
    }

    pub view fn get_fn(self: *Self, fn_id: u32) -> ?*EirFunction {
        return self.funcs.fns.get(fn_id.widen.[usize]());
    }

    pub view fn get_fn_mut(self: *mut Self, fn_id: u32) -> ?*mut EirFunction {
        return self.funcs.fns.get_mut(fn_id.widen.[usize]());
    }

    pub view fn fn_params(self: *Self, fn_id: u32) -> *[EirValue] {
        let all = self.funcs.param_vals.as_slice();
        if let f = self.get_fn(fn_id) {
            return slice_id_range.[EirValue](all, f.params);
        }
        return empty_slice.[EirValue](all);
    }

    pub view fn fn_param_names(self: *Self, fn_id: u32) -> *[u32] {
        let all = self.aux.sym_list.as_slice();
        if let f = self.get_fn(fn_id) {
            return slice_id_range.[u32](all, f.param_names);
        }
        return empty_slice.[u32](all);
    }

    pub view fn fn_slots(self: *Self, fn_id: u32) -> *[EirSlotInfo] {
        let all = self.funcs.slots.as_slice();
        if let f = self.get_fn(fn_id) {
            return slice_id_range.[EirSlotInfo](all, f.slots);
        }
        return empty_slice.[EirSlotInfo](all);
    }

    pub view fn fn_slot(self: *Self, fn_id: u32, slot: EirSlot) -> ?*EirSlotInfo {
        let f = self.get_fn(fn_id) orelse {
            return null;
        };
        if slot >= f.slots.len {
            return null;
        }
        return self.funcs.slots.get((f.slots.start +% slot).widen.[usize]());
    }

    pub view fn fn_value_tys(self: *Self, fn_id: u32) -> *[types.TyId] {
        let all = self.funcs.value_tys.as_slice();
        if let f = self.get_fn(fn_id) {
            return slice_id_range.[types.TyId](all, f.value_tys);
        }
        return empty_slice.[types.TyId](all);
    }

    pub fn fn_val_ty(self: *Self, fn_id: u32, v: EirValue) -> types.TyId {
        let tys = self.fn_value_tys(fn_id);
        let idx = v.widen.[usize]();
        if idx < tys.len {
            return tys[idx];
        }
        return types.TY_ERROR;
    }

    pub view fn fn_val_names(self: *Self, fn_id: u32) -> *[EirValName] {
        let all = self.meta.val_names.as_slice();
        if let f = self.get_fn(fn_id) {
            return slice_id_range.[EirValName](all, f.val_names);
        }
        return empty_slice.[EirValName](all);
    }

    pub fn fn_val_name(self: *Self, fn_id: u32, v: EirValue) -> ?u32 {
        let ns = self.fn_val_names(fn_id);
        var i: usize = 0_usize;
        while i < ns.len {
            if ns[i].val == v {
                return ns[i].sym;
            }
            i = i +% 1_usize;
        }
        return null;
    }

    pub view fn fn_blocks(self: *Self, fn_id: u32) -> *[EirBlock] {
        let all = self.funcs.blocks.as_slice();
        if let f = self.get_fn(fn_id) {
            return slice_id_range.[EirBlock](all, f.blocks);
        }
        return empty_slice.[EirBlock](all);
    }

    pub fn fn_block_global_id(self: *Self, fn_id: u32, bb: BlockId) -> u32 {
        let f = self.get_fn(fn_id) orelse {
            return EIR_NONE;
        };
        if bb >= f.blocks.len {
            return EIR_NONE;
        }
        return f.blocks.start +% bb;
    }

    pub view fn fn_block(self: *Self, fn_id: u32, bb: BlockId) -> ?*EirBlock {
        let gid = self.fn_block_global_id(fn_id, bb);
        if gid == EIR_NONE {
            return null;
        }
        return self.funcs.blocks.get(gid.widen.[usize]());
    }

    pub view fn fn_block_mut(self: *mut Self, fn_id: u32, bb: BlockId) -> ?*mut EirBlock {
        let gid = self.fn_block_global_id(fn_id, bb);
        if gid == EIR_NONE {
            return null;
        }
        return self.funcs.blocks.get_mut(gid.widen.[usize]());
    }

    pub view fn phis_slice(self: *Self, r: ast.IdRange) -> *[EirPhi] {
        return slice_id_range.[EirPhi](self.funcs.phis.as_slice(), r);
    }

    pub view fn phi_incoming(self: *Self, r: ast.IdRange) -> *[EirPhiIn] {
        return slice_id_range.[EirPhiIn](self.funcs.phi_in.as_slice(), r);
    }

    pub view fn insts_slice(self: *Self, r: ast.IdRange) -> *[EirInst] {
        return slice_id_range.[EirInst](self.funcs.insts.as_slice(), r);
    }

    pub view fn get_inst_mut(self: *mut Self, inst_id: u32) -> ?*mut EirInst {
        return self.funcs.insts.get_mut(inst_id.widen.[usize]());
    }

