// ===========================================================================
// Section 1: Core IDs, Constants, Places, Instructions, Blocks, and Functions
// ===========================================================================

pub type EirValue = u32;
pub type EirSlot = u32;
pub type BlockId = cfg_ir.BlockId;

pub const EIR_NONE: u32 = 4294967295_u32;

view fn slice_id_range[T](all: *[T], r: ast.IdRange) -> *[T] {
    let start = r.start.widen.[usize]();
    let end = start +% r.len.widen.[usize]();
    let s = all.sub(start, end) catch {
        return all.sub(0_usize, 0_usize) catch {
            return all;
        };
    };
    return s;
}

view fn empty_slice[T](all: *[T]) -> *[T] {
    return all.sub(0_usize, 0_usize) catch {
        return all;
    };
}

view fn slice_id_range_mut[T](all: *mut [T], r: ast.IdRange) -> *mut [T] {
    let start = r.start.widen.[usize]();
    let end = start +% r.len.widen.[usize]();
    if start <= end && end <= all.len {
        return all.sub_mut(start, end) catch {
            return all;
        };
    }
    return all.sub_mut(0_usize, 0_usize) catch {
        return all;
    };
}

fn u32_at(buf: *col.DynBuf[u32], idx: usize) -> u32 {
    let s = buf.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return EIR_NONE;
}

pub enum EirPlaceBaseKind : u8 {
    Slot = 0,
    Val = 1,
}

pub struct EirPlaceBase {
    pub kind: EirPlaceBaseKind;
    pub id: u32;
}

pub fn place_base_slot(slot: EirSlot) -> EirPlaceBase {
    return EirPlaceBase.{ kind: .Slot, id: slot };
}

pub fn place_base_val(val: EirValue) -> EirPlaceBase {
    return EirPlaceBase.{ kind: .Val, id: val };
}

pub enum EirProjKind : u8 {
    Deref = 0,
    Field = 1,
    TupleField = 2,
    Index = 3,
    PoolCol = 4,
}

pub struct EirProj {
    pub kind: EirProjKind;
    pub is_slot_pool: bool;
    pub sym: u32;
    pub index: u32;
    pub ty: types.TyId;
}

pub fn proj_deref() -> EirProj {
    return EirProj.{
        kind: .Deref,
        is_slot_pool: false,
        sym: span.SYM_EMPTY,
        index: 0_u32,
        ty: types.TY_ERROR,
    };
}

pub fn proj_field(name: u32, field_idx: u32, ty: types.TyId) -> EirProj {
    return EirProj.{
        kind: .Field,
        is_slot_pool: false,
        sym: name,
        index: field_idx,
        ty: ty,
    };
}

pub fn proj_tuple_field(index: u32, ty: types.TyId) -> EirProj {
    return EirProj.{
        kind: .TupleField,
        is_slot_pool: false,
        sym: span.SYM_EMPTY,
        index: index,
        ty: ty,
    };
}

pub fn proj_index(index_val: EirValue, ty: types.TyId) -> EirProj {
    return EirProj.{
        kind: .Index,
        is_slot_pool: false,
        sym: span.SYM_EMPTY,
        index: index_val,
        ty: ty,
    };
}

pub fn proj_pool_col(col: u32, col_idx: u32, is_slot_pool: bool, elem_ty: types.TyId) -> EirProj {
    return EirProj.{
        kind: .PoolCol,
        is_slot_pool: is_slot_pool,
        sym: col,
        index: col_idx,
        ty: elem_ty,
    };
}

pub struct EirPlace {
    pub base: EirPlaceBase;
    pub projs: ast.IdRange;
    pub ty: types.TyId;
}

pub enum EirCalleeKind : u8 {
    DirectFn = 0,
    Method = 1,
    GenericInst = 2,
    DynCall = 3,
    ExternFn = 4,
    FnPtr = 5,
}

pub struct EirCallee {
    pub kind: EirCalleeKind;
    pub a: u32;
    pub b: u32;
}

pub fn callee_direct_fn(def_id: u32) -> EirCallee {
    return EirCallee.{ kind: .DirectFn, a: def_id, b: 0_u32 };
}

pub fn callee_method(impl_idx: u32, sub_idx: u32) -> EirCallee {
    return EirCallee.{ kind: .Method, a: impl_idx, b: sub_idx };
}

pub fn callee_generic_inst(inst_id: u32) -> EirCallee {
    return EirCallee.{ kind: .GenericInst, a: inst_id, b: 0_u32 };
}

pub fn callee_dyn_call(iface_def: u32, method_idx: u32) -> EirCallee {
    return EirCallee.{ kind: .DynCall, a: iface_def, b: method_idx };
}

pub fn callee_extern_fn(def_id: u32, name_sym: u32) -> EirCallee {
    return EirCallee.{ kind: .ExternFn, a: def_id, b: name_sym };
}

pub fn callee_fn_ptr(val: EirValue) -> EirCallee {
    return EirCallee.{ kind: .FnPtr, a: val, b: 0_u32 };
}

pub struct EirPoolColOp {
    pub pool_base: EirPlaceBase;
    pub pool_is_ptr: bool;
    pub is_slot_pool: bool;
    pub col: u32;
    pub col_idx: u32;
    pub index: EirValue;
    pub elem_ty: types.TyId;
}

pub struct EirCallData {
    pub callee: EirCallee;
    pub args: ast.IdRange;
    pub ret_ty: types.TyId;
}

pub struct EirBuiltinCallData {
    pub op: cfg_ir.CfgBuiltinOp;
    pub args: ast.IdRange;
    pub arg_slots: ast.IdRange;
    pub ret_ty: types.TyId;
}

pub struct EirAsmInput {
    pub name: ast.IdRange;
    pub val: EirValue;
}

pub struct EirInlineAsmData {
    pub template: ast.IdRange;
    pub inputs: ast.IdRange;
}

pub enum EirInstKind : u8 {
    Const = 0,
    Copy = 1,
    LoadSlot = 2,
    StoreSlot = 3,
    SlotAddr = 4,
    LoadPlace = 5,
    StorePlace = 6,
    PlaceAddr = 7,
    PoolColumnLoad = 8,
    PoolColumnStore = 9,
    Unary = 10,
    Binary = 11,
    Cast = 12,
    Slice = 13,
    Aggregate = 14,
    UnwrapOptional = 15,
    UnwrapErrorOk = 16,
    UnwrapErrorErr = 17,
    IsNonNull = 18,
    IsError = 19,
    MatchTag = 20,
    FieldExtract = 21,
    MakeDyn = 22,
    MakeClosure = 23,
    Call = 24,
    BuiltinCall = 25,
    InlineAsm = 26,
    GetVar = 27,
    SetVar = 28,
    ParForHint = 29,
    VecLoad = 30,
    VecStore = 31,
    VecFma = 32,
}

pub struct EirInst {
    pub span: span.Span;
    pub kind: EirInstKind;
    pub flag0: bool;
    pub unary_op: ast.UnaryOp;
    pub bin_op: ast.BinaryOp;
    pub cast_kind: cfg_ir.CastKind;
    pub dst: EirValue;
    pub v0: EirValue;
    pub v1: EirValue;
    pub v2: EirValue;
    pub aux0: u32;
    pub ty0: types.TyId;
    pub ty1: types.TyId;
    pub range: ast.IdRange;
}

pub fn inst_zero(sp: span.Span, kind: EirInstKind) -> EirInst {
    return EirInst.{
        span: sp,
        kind: kind,
        flag0: false,
        unary_op: .Neg,
        bin_op: .Add,
        cast_kind: .Widen,
        dst: EIR_NONE,
        v0: EIR_NONE,
        v1: EIR_NONE,
        v2: EIR_NONE,
        aux0: 0_u32,
        ty0: types.TY_VOID,
        ty1: types.TY_VOID,
        range: ast.range_empty(),
    };
}

/// Returns the defined SSA `EirValue` of `inst`, or `EIR_NONE` if the instruction has no value result.
pub fn inst_def(inst: *EirInst) -> EirValue {
    match inst.kind {
        .StoreSlot => { return EIR_NONE; }
        .StorePlace => { return EIR_NONE; }
        .PoolColumnStore => { return EIR_NONE; }
        .InlineAsm => { return EIR_NONE; }
        .SetVar => { return EIR_NONE; }
        .ParForHint => { return EIR_NONE; }
        .VecStore => { return EIR_NONE; }
        _ => { return inst.dst; }
    }
}

pub struct EirPhiIn {
    pub pred_bb: BlockId;
    pub val: EirValue;
}

pub type EirPhiIncoming = EirPhiIn;

pub struct EirPhi {
    pub dst: EirValue;
    pub ty: types.TyId;
    pub incoming: ast.IdRange;
}

pub enum EirTermKind : u8 {
    Goto = 0,
    Branch = 1,
    SwitchInt = 2,
    Return = 3,
    Unreachable = 4,
}

pub struct EirTerm {
    pub kind: EirTermKind;
    pub flag: bool;
    pub val: EirValue;
    pub bb0: BlockId;
    pub bb1: BlockId;
    pub targets: ast.IdRange;
    pub span: span.Span;
}

pub fn term_goto(target: BlockId) -> EirTerm {
    return EirTerm.{
        kind: .Goto,
        flag: false,
        val: EIR_NONE,
        bb0: target,
        bb1: 0_u32,
        targets: ast.range_empty(),
        span: span.span_dummy(),
    };
}

pub fn term_branch(
    cond: EirValue,
    then_bb: BlockId,
    else_bb: BlockId,
    sp: span.Span,
    is_user_if: bool,
) -> EirTerm {
    return EirTerm.{
        kind: .Branch,
        flag: is_user_if,
        val: cond,
        bb0: then_bb,
        bb1: else_bb,
        targets: ast.range_empty(),
        span: sp,
    };
}

pub fn term_switch_int(
    discr: EirValue,
    targets: ast.IdRange,
    otherwise: BlockId,
) -> EirTerm {
    return EirTerm.{
        kind: .SwitchInt,
        flag: false,
        val: discr,
        bb0: otherwise,
        bb1: 0_u32,
        targets: targets,
        span: span.span_dummy(),
    };
}

pub fn term_return(has_val: bool, val: EirValue) -> EirTerm {
    return EirTerm.{
        kind: .Return,
        flag: has_val,
        val: val,
        bb0: 0_u32,
        bb1: 0_u32,
        targets: ast.range_empty(),
        span: span.span_dummy(),
    };
}

pub fn term_unreachable(sp: span.Span, explicit: bool) -> EirTerm {
    return EirTerm.{
        kind: .Unreachable,
        flag: explicit,
        val: EIR_NONE,
        bb0: 0_u32,
        bb1: 0_u32,
        targets: ast.range_empty(),
        span: sp,
    };
}

pub struct EirBlock {
    pub id: BlockId;
    pub phis: ast.IdRange;
    pub insts: ast.IdRange;
    pub term: EirTerm;
    pub preds: ast.IdRange;
    pub idom: BlockId;
}

pub struct EirSlotInfo {
