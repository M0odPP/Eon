// ===========================================================================
// Section 1: Public API, ABI Classification, Symbol Naming, Float & Magic Div
// ===========================================================================

pub struct IselResult {
    pub ok: bool;
    pub uses_avx2_loop: bool;
}

const PHYS_XMM0: u8 = 0_u8;

fn mem_clone(m: *mach_ir.MemAddr) -> mach_ir.MemAddr {
    return mach_ir.MemAddr.{
        kind: m.kind,
        base: m.base,
        base_phys: m.base_phys,
        idx: m.idx,
        idx_phys: m.idx_phys,
        scale: m.scale,
        disp: m.disp,
        sym: m.sym,
        label: m.label,
    };
}

fn mem_offset(m: *mach_ir.MemAddr, delta: i32) -> mach_ir.MemAddr {
    return mach_ir.MemAddr.{
        kind: m.kind,
        base: m.base,
        base_phys: m.base_phys,
        idx: m.idx,
        idx_phys: m.idx_phys,
        scale: m.scale,
        disp: m.disp +% delta,
        sym: m.sym,
        label: m.label,
    };
}

enum ArgClass : u8 {
    Zst = 0,
    IntReg = 1,
    TwoIntRegs = 2,
    FloatReg = 3,
    ByPtr = 4,
}

enum RetClassKind : u8 {
    Void = 0,
    IntReg = 1,
    TwoIntRegs = 2,
    FloatReg = 3,
    Sret = 4,
    ErrorUnion = 5,
}

struct RetClass {
    kind: RetClassKind;
    ok_ty: types.TyId;
    ok_kind: RetClassKind;
}

fn ret_class_simple(k: RetClassKind) -> RetClass {
    return RetClass.{ kind: k, ok_ty: types.TY_VOID, ok_kind: .Void };
}

fn gp_arg_phys(is_c: bool, idx: usize) -> u8 {
    let limit: usize = if is_c { 6_usize } else { 8_usize };
    if idx >= limit {
        return mach_ir.PHYS_NONE;
    }
    match idx {
        0_usize => { return mach_ir.PHYS_RDI; }
        1_usize => { return mach_ir.PHYS_RSI; }
        2_usize => { return mach_ir.PHYS_RDX; }
        3_usize => { return mach_ir.PHYS_RCX; }
        4_usize => { return mach_ir.PHYS_R8; }
        5_usize => { return mach_ir.PHYS_R9; }
        6_usize => { return mach_ir.PHYS_R10; }
        7_usize => { return mach_ir.PHYS_R11; }
        _ => { return mach_ir.PHYS_NONE; }
    }
}

fn flt_arg_phys(idx: usize) -> u8 {
    if idx >= 8_usize {
        return mach_ir.PHYS_NONE;
    }
    return idx.trunc.[u8]();
}

fn classify_arg(ty: types.TyId, env: *types.TypeEnv) -> ArgClass {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return .Zst;
    }
    let n = env.get(ty);
    if n.kind == .Float {
        if n.u8_val == 32_u8 || n.u8_val == 64_u8 {
            return .FloatReg;
        }
        return .IntReg;
    }
    if n.kind == .Bool || n.kind == .Char || n.kind == .Int || n.kind == .Enum
        || n.kind == .ErrorSet || n.kind == .Bitfield || n.kind == .RawPtr
        || n.kind == .PhysAddr || n.kind == .VirtAddr || n.kind == .DmaAddr
    {
        if lay.size <= 8_usize {
            return .IntReg;
        }
        return .TwoIntRegs;
    }
    if n.kind == .Borrow {
        if n.borrow_kind == .Single && lay.size <= 8_usize {
            return .IntReg;
        }
        return .TwoIntRegs;
    }
    if n.kind == .Str || n.kind == .Dyn || n.kind == .FnPtr {
        return .TwoIntRegs;
    }
    if n.kind == .Builtin {
        if n.builtin_kind == .IdBrand || n.builtin_kind == .Link
            || n.builtin_kind == .GenId
            || n.builtin_kind == .FsCap || n.builtin_kind == .DirCap
            || n.builtin_kind == .NetCap || n.builtin_kind == .ClockCap
            || n.builtin_kind == .IoCap || n.builtin_kind == .BuildCap
            || n.builtin_kind == .MmioReg
        {
            return .IntReg;
        }
    }
    if lay.size <= 8_usize {
        return .IntReg;
    }
    if lay.size <= 16_usize {
        return .TwoIntRegs;
    }
    return .ByPtr;
}

fn classify_ret_inner(ty: types.TyId, env: *types.TypeEnv) -> RetClassKind {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return .Void;
    }
    let n = env.get(ty);
    if n.kind == .Float {
        if n.u8_val == 32_u8 || n.u8_val == 64_u8 {
            return .FloatReg;
        }
        return .IntReg;
    }
    if lay.size <= 8_usize {
        return .IntReg;
    }
    if lay.size <= 16_usize {
        return .TwoIntRegs;
    }
    return .Sret;
}

fn classify_ret(ty: types.TyId, env: *types.TypeEnv) -> RetClass {
    let n = env.get(ty);
    if n.kind == .ErrorUnion {
        let ok_ty = n.primary;
        let ok_k = classify_ret_inner(ok_ty, env);
        return RetClass.{ kind: .ErrorUnion, ok_ty: ok_ty, ok_kind: ok_k };
    }
    return ret_class_simple(classify_ret_inner(ty, env));
}

fn ret_uses_sret(rc: RetClass) -> bool {
    if rc.kind == .Sret {
        return true;
    }
    if rc.kind == .ErrorUnion && rc.ok_kind == .Sret {
        return true;
    }
    return false;
}

fn is_builtin_rt_helper(name: *[u8]) -> bool {
    return str.bytes_eq(name, "eon_rt_print_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_bytes".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_u64".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_i64".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_f32".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_nl".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_bytes".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_nl".as_bytes())
        || str.bytes_eq(name, "eon_rt_validate_utf8".as_bytes())
        || str.bytes_eq(name, "eon_rt_is_dir".as_bytes())
        || str.bytes_eq(name, "eon_rt_mkdir_all".as_bytes())
        || str.bytes_eq(name, "eon_rt_spawn_wait".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw_uninit".as_bytes())
        || str.bytes_eq(name, "eon_free_raw".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw_san".as_bytes())
        || str.bytes_eq(name, "eon_free_raw_san".as_bytes())
        || str.bytes_eq(name, "eon_arena_alloc_aligned".as_bytes())
        || str.bytes_eq(name, "eon_rt_arena_reset_san".as_bytes())
        || str.bytes_eq(name, "eon_rt_install_san_handler".as_bytes())
        || str.bytes_eq(name, "eon_rt_tls_init".as_bytes())
        || str.bytes_eq(name, "eon_rt_parse_vdso".as_bytes())
        || str.bytes_eq(name, "eon_rt_now_ns".as_bytes())
        || str.bytes_eq(name, "eon_rt_openat2_beneath".as_bytes())
        || str.bytes_eq(name, "eon_rt_read_fd".as_bytes())
        || str.bytes_eq(name, "eon_rt_write_fd".as_bytes())
        || str.bytes_eq(name, "eon_rt_close_fd".as_bytes())
        || str.bytes_eq(name, "eon_f16_to_f32".as_bytes())
        || str.bytes_eq(name, "eon_f32_to_f16".as_bytes())
        || str.bytes_eq(name, "eon_sched_init".as_bytes())
        || str.bytes_eq(name, "eon_sched_shutdown".as_bytes())
        || str.bytes_eq(name, "eon_par_for".as_bytes())
        || str.bytes_eq(name, "eon_sched_run_dag".as_bytes())
        || str.bytes_eq(name, "eon_fiber_switch".as_bytes())
        || str.bytes_eq(name, "eon_iouring_create".as_bytes())
        || str.bytes_eq(name, "eon_iouring_destroy".as_bytes())
        || str.bytes_eq(name, "eon_run_fibers_iouring".as_bytes());
}

fn sanitize_sym_into(alloc: *mut AllocCap, bytes: *[u8], out: *mut str.StrBuf) -> !OutOfMemory {
    var i: usize = 0_usize;
    while i < bytes.len {
        let c = bytes[i];
        let ok = (c >= b'a' && c <= b'z')
            || (c >= b'A' && c <= b'Z')
            || (c >= b'0' && c <= b'9')
            || c == b'_';
        if ok {
            try out.push_byte_grow(alloc, c);
        } else {
            try out.push_byte_grow(alloc, b'_');
        }
        i = i +% 1_usize;
    }
    return;
}

fn fn_sym_name_id(
    alloc: *mut AllocCap,
    key: cfg_ir.CfgFnKey,
    eir_prog: *eir.EirProgram,
    interner: *mut span.SymInterner,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 48_usize);
    errdefer sb.destroy(alloc);
    if let fid = eir_prog.find_fn_by_key(key) {
        if let f = eir_prog.get_fn(fid) {
            if f.sig.effects.is_export_c {
                let raw_name = interner.get(f.name);
                try sb.push_bytes_grow(alloc, raw_name);
                let sid = try interner.intern(alloc, sb.as_bytes());
                sb.destroy(alloc);
                return sid;
            }
            match key.kind {
                .TopDef => {
                    try sb.push_str_grow(alloc, "eon_fn_");
                    if f.mod_name != span.SYM_EMPTY {
                        let mb = interner.get(f.mod_name);
                        try sb.push_u64_grow(alloc, mb.len.widen.[u64]());
                        try sb.push_byte_grow(alloc, b'_');
                        try sanitize_sym_into(alloc, mb, &mut sb);
                        try sb.push_str_grow(alloc, "__");
                    } else {
                        try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                        try sb.push_byte_grow(alloc, b'_');
                    }
                    try sanitize_sym_into(alloc, interner.get(f.name), &mut sb);
                }
                .ImplMethod => {
                    try sb.push_str_grow(alloc, "eon_m_");
                    if f.mod_name != span.SYM_EMPTY {
                        let mb = interner.get(f.mod_name);
                        try sb.push_u64_grow(alloc, mb.len.widen.[u64]());
                        try sb.push_byte_grow(alloc, b'_');
                        try sanitize_sym_into(alloc, mb, &mut sb);
                        try sb.push_str_grow(alloc, "__");
                        try sb.push_u64_grow(alloc, f.impl_decl_idx.widen.[u64]());
                    } else {
                        try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                    }
                    try sb.push_byte_grow(alloc, b'_');
                    try sb.push_u64_grow(alloc, key.b.widen.[u64]());
                    try sb.push_byte_grow(alloc, b'_');
                    try sanitize_sym_into(alloc, interner.get(f.name), &mut sb);
                }
                .GenericInst => {
                    try sb.push_str_grow(alloc, "eon_g_");
                    try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                    try sb.push_byte_grow(alloc, b'_');
                    try sanitize_sym_into(alloc, interner.get(f.name), &mut sb);
                }
                .Closure => {
                    try sb.push_str_grow(alloc, "eon_c_");
                    try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                }
            }
            let sid = try interner.intern(alloc, sb.as_bytes());
            sb.destroy(alloc);
            return sid;
        }
    }
    match key.kind {
        .TopDef => {
            try sb.push_str_grow(alloc, "eon_fn_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
        }
        .ImplMethod => {
            try sb.push_str_grow(alloc, "eon_m_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
            try sb.push_byte_grow(alloc, b'_');
            try sb.push_u64_grow(alloc, key.b.widen.[u64]());
        }
        .GenericInst => {
            try sb.push_str_grow(alloc, "eon_g_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
        }
        .Closure => {
            try sb.push_str_grow(alloc, "eon_c_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
        }
    }
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn intern_sym_u64_2(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    prefix: *str,
    a: u64,
    b: u64,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 48_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, prefix);
    try sb.push_u64_grow(alloc, a);
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, b);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn intern_rodata_sym(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    fn_sym_id: u32,
    idx: u64,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 64_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, ".Lro_");
    try sb.push_bytes_grow(alloc, interner.get(fn_sym_id));
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, idx);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn intern_jt_sym(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    fn_sym_id: u32,
    idx: u64,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 64_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, ".Ljt_");
    try sb.push_bytes_grow(alloc, interner.get(fn_sym_id));
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, idx);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

// --- Float Literal Parsing & IEEE 754 Conversion ---

fn parse_f64_lit(src: *[u8]) -> f64 {
    var end = src.len;
    if end >= 4_usize {
        let a = src[end - 4_usize];
        let b = src[end - 3_usize];
        let c = src[end - 2_usize];
        let d = src[end - 1_usize];
        if a == b'_' && b == b'f'
            && ((c == b'3' && d == b'2') || (c == b'6' && d == b'4') || (c == b'1' && d == b'6'))
        {
            end = end - 4_usize;
        }
    }
    var i: usize = 0_usize;
    var neg = false;
    if i < end && src[i] == b'-' {
        neg = true;
        i = i +% 1_usize;
    } else if i < end && src[i] == b'+' {
        i = i +% 1_usize;
    }
    var mant: u64 = 0_u64;
    var digits: i32 = 0_i32;
    var frac_digits: i32 = 0_i32;
    var seen_dot = false;
    var exp_adj: i32 = 0_i32;
    while i < end {
        let ch = src[i];
        if ch == b'_' {
            i = i +% 1_usize;
            continue;
        }
        if ch == b'.' {
            seen_dot = true;
            i = i +% 1_usize;
            continue;
        }
        if ch == b'e' || ch == b'E' {
            i = i +% 1_usize;
            break;
        }
        if ch >= b'0' && ch <= b'9' {
            if digits < 19_i32 {
                mant = (mant *% 10_u64) +% (ch - b'0').widen.[u64]();
                digits = digits +% 1_i32;
                if seen_dot {
                    frac_digits = frac_digits +% 1_i32;
                }
            } else if !seen_dot {
                exp_adj = exp_adj +% 1_i32;
            }
        }
        i = i +% 1_usize;
    }
    var exp10: i32 = exp_adj -% frac_digits;
    var exp_neg = false;
    var exp_val: i32 = 0_i32;
    if i < end && src[i] == b'-' {
        exp_neg = true;
        i = i +% 1_usize;
    } else if i < end && src[i] == b'+' {
        i = i +% 1_usize;
    }
    while i < end {
        let ch = src[i];
        if ch >= b'0' && ch <= b'9' {
            if exp_val < 10000_i32 {
                exp_val = (exp_val *% 10_i32) +% (ch - b'0').widen.[i32]();
            }
        }
        i = i +% 1_usize;
    }
    if exp_neg {
        exp10 = exp10 -% exp_val;
    } else {
        exp10 = exp10 +% exp_val;
    }
    var val = mant.to_float.[f64]();
    var p = if exp10 < 0_i32 { 0_i32 -% exp10 } else { exp10 };
    var scale: f64 = 1.0_f64;
    var base: f64 = 10.0_f64;
    while p > 0_i32 {
        if (p & 1_i32) != 0_i32 {
            scale = scale * base;
        }
        p = p >> 1_i32;
        if p > 0_i32 {
            base = base * base;
        }
    }
    if exp10 > 0_i32 {
        val = val * scale;
    } else if exp10 < 0_i32 {
        val = val / scale;
    }
    if neg {
        val = 0.0_f64 - val;
    }
    return val;
}

fn f64_bits_to_f32_bits(bits: u64) -> u32 {
    let sign = ((bits >> 32_u64) & 0x80000000_u64).trunc.[u32]();
    let exp = ((bits >> 52_u64) & 0x7FF_u64).trunc.[i32]();
    let frac = bits & 0x000FFFFFFFFFFFFF_u64;
    if exp == 0x7FF_i32 {
        if frac != 0_u64 {
            let payload = (frac >> 29_u64).trunc.[u32]();
            return sign | 0x7F800000_u32 | (if payload == 0_u32 { 1_u32 } else { payload });
        }
        return sign | 0x7F800000_u32;
    }
    if exp == 0_i32 {
        return sign;
    }
    let e32 = exp -% 1023_i32 +% 127_i32;
    if e32 >= 255_i32 {
        return sign | 0x7F800000_u32;
    }
    if e32 <= 0_i32 {
        let shift = (1_i32 -% e32).bitcast.[u32]().widen.[u64]();
        if shift >= 25_u64 {
            return sign;
        }
        let full = 0x0010000000000000_u64 | frac;
        let total_sh = 29_u64 +% shift;
        let mant = (full >> total_sh).trunc.[u32]();
        return sign | (mant & 0x007FFFFF_u32);
    }
    let mant_raw = (frac >> 29_u64).trunc.[u32]();
    let rem = frac & 0x1FFFFFFF_u64;
    let half = 0x10000000_u64;
    var mant = mant_raw;
    if rem > half || (rem == half && (mant & 1_u32) != 0_u32) {
        mant = mant +% 1_u32;
    }
    if mant >= 0x00800000_u32 {
        let e32_inc = e32 +% 1_i32;
        if e32_inc >= 255_i32 {
            return sign | 0x7F800000_u32;
        }
        return sign | (e32_inc.bitcast.[u32]() <<% 23_u32);
    }
    return sign | (e32.bitcast.[u32]() <<% 23_u32) | (mant & 0x007FFFFF_u32);
}

// --- Warren Hacker's Delight Fig. 10-1 Exact 64-bit Unsigned Magic Divider ---

struct MagicU64 {
    magic: u64;
    add_ind: bool;
    shift: u8;
}

/// Computes exact `(magic, add_ind, shift)` for unsigned 64-bit division by `d > 1` (non-power-of-2).
fn compute_magic_u64(d: u64) -> MagicU64 {
    let two63: u64 = 0x8000000000000000_u64;
    let two63_m1: u64 = 0x7FFFFFFFFFFFFFFF_u64;
    let rem_top: u64 = if d > 0_u64 { (0_u64 -% d) % d } else { 0_u64 };
    let nc: u64 = 0xFFFFFFFFFFFFFFFF_u64 -% rem_top;
    var p: u32 = 63_u32;
    var q1: u64 = two63 / nc;
    var r1: u64 = two63 -% (q1 *% nc);
    var q2: u64 = if d > 0_u64 { two63_m1 / d } else { 0_u64 };
    var r2: u64 = two63_m1 -% (q2 *% d);
    var add_ind = false;

    var guard: u32 = 0_u32;
    while guard < 128_u32 {
        p = p +% 1_u32;
        if r1 >= (nc -% r1) {
            q1 = (q1 *% 2_u64) +% 1_u64;
            r1 = (r1 *% 2_u64) -% nc;
        } else {
            q1 = q1 *% 2_u64;
            r1 = r1 *% 2_u64;
        }
        if (r2 +% 1_u64) >= (d -% r2) {
            if q2 >= two63_m1 {
                add_ind = true;
            }
            q2 = (q2 *% 2_u64) +% 1_u64;
            r2 = ((r2 *% 2_u64) +% 1_u64) -% d;
        } else {
            if q2 >= two63 {
                add_ind = true;
            }
            q2 = q2 *% 2_u64;
            r2 = (r2 *% 2_u64) +% 1_u64;
        }
        let delta: u64 = (d -% 1_u64) -% r2;
        if !(q1 < delta || (q1 == delta && r1 == 0_u64)) {
            break;
        }
        guard = guard +% 1_u32;
    }
    let sh: u8 = if p >= 64_u32 { (p -% 64_u32).trunc.[u8]() } else { 0_u8 };
    return MagicU64.{
        magic: q2 +% 1_u64,
        add_ind: add_ind,
        shift: sh,
    };
}

fn is_power_of_two_u64(x: u64) -> bool {
    return x > 0_u64 && (x & (x -% 1_u64)) == 0_u64;
}

fn log2_u64(x: u64) -> u8 {
    var v = x;
    var r: u8 = 0_u8;
    while v > 1_u64 {
        v = v >> 1_u64;
        r = r +% 1_u8;
    }
    return r;
}

fn fits_i32(v: i64) -> bool {
    return v >= -2147483648_i64 && v <= 2147483647_i64;
}

// ===========================================================================
// Section 2: `IselCtx`, Eligibility Precheck, DAG Pre-Scan & Value Planning
// ===========================================================================

enum IselValKind : u8 {
    Zst = 0,
    Gpr = 1,
    PairGpr = 2,      // Slices & strs: vreg0 = ptr, vreg1 = len
    Float32 = 3,      // Scalar f32 in XMM
    Float64 = 4,      // Scalar f64 in XMM
    Vec128 = 5,       // 16B packed vector in XMM
    Vec256 = 6,       // 32B packed vector in YMM
    Stack = 7,        // Frame stack slot [rbp + stack_off]
    SliceEuPair = 8,  // Fused SliceSub/ArraySub ErrorUnion: vreg0 = sub_ptr, vreg1 = sub_len (err tag = 4)
}

struct IselValLoc {
    kind: IselValKind;
    vreg0: mach_ir.VReg;
    vreg1: mach_ir.VReg;
    stack_off: i32;
}

fn val_loc_zst() -> IselValLoc {
    return IselValLoc.{
        kind: .Zst,
        vreg0: mach_ir.VREG_NONE,
        vreg1: mach_ir.VREG_NONE,
        stack_off: 0_i32,
    };
}

struct Avx2LoopEntry {
    hdr_bb: eir.BlockId;
    pre_bb: eir.BlockId;
    latch_bb: eir.BlockId;
    body_bb: eir.BlockId;
    exit_bb: eir.BlockId;
    ind_val: eir.EirValue;
    start_val: eir.EirValue;
    bound_val: eir.EirValue;
    v_pre_mbb: u32;
}

linear struct IselCtx {
    fn_id: u32;
    fn_sym_id: u32;
    is_export_c: bool;
    sanitize: bool;
    is_linux: bool;
    cfg: eir.EirOptConfig;
    ret_ty: types.TyId;
    ret_class: RetClass;
    has_sret: bool;
    sret_vreg: mach_ir.VReg;
    scratch_vec_off: i32;
    call_arg6_off: i32;
    call_arg7_off: i32;
    cur_mbb: u32;
    cur_depth: u8;
    rodata_counter: u64;
    jt_counter: u64;
    uses_avx2_loop: bool;
    hoisted_pvals: [6]eir.EirValue;
    hoisted_offs: [6]i32;
    hoisted_vregs: [6]mach_ir.VReg;
    hoisted_cols_cnt: usize;

    val_locs: col.DynBuf[IselValLoc];
    slot_offs: col.DynBuf[i32];
    eir_to_mbb: col.DynBuf[u32];

    // Pre-scan DAG metadata (indexed by EirValue)
    use_count: col.DynBuf[u32];
    def_bb: col.DynBuf[u32];
    def_inst_gid: col.DynBuf[u32];
    is_const_int: col.DynBuf[u8];
    const_int_val: col.DynBuf[u64];
    is_const_flt: col.DynBuf[u8];
    const_flt_bits: col.DynBuf[u64];
    skip_val: col.DynBuf[u8];         // fused compare-and-branch / fused VSqrtPS / fused VecBitmask / fused VecLoad
    fused_sqrt_src: col.DynBuf[u32];  // for Aggregate(.Vec, [MathSqrt(extract(v,0..3))]) -> src vec v
    fused_bitmask_cmp: col.DynBuf[u32]; // for VecBitmask(VecCmp(u8x16, Eq)) -> cmp inst_gid
    fused_vec_load_gid: col.DynBuf[u32]; // for Aggregate(.Vec, [base[i], base[i+1], ...]) -> first LoadPlace gid

    // Detected 8-wide AVX2 SoA loops (keyed by pre_bb -> hdr_bb)
    avx2_loops: col.DynBuf[Avx2LoopEntry];
}

impl IselCtx {
    fn destroy(self: IselCtx, alloc: *mut AllocCap) {
        let IselCtx.{
            fn_id: _,
            fn_sym_id: _,
            is_export_c: _,
            sanitize: _,
            is_linux: _,
            cfg: _,
            ret_ty: _,
            ret_class: _,
            has_sret: _,
            sret_vreg: _,
            scratch_vec_off: _,
            call_arg6_off: _,
            call_arg7_off: _,
            cur_mbb: _,
            cur_depth: _,
            rodata_counter: _,
            jt_counter: _,
            uses_avx2_loop: _,
            hoisted_pvals: _,
            hoisted_offs: _,
            hoisted_vregs: _,
            hoisted_cols_cnt: _,
            val_locs,
            slot_offs,
            eir_to_mbb,
            use_count,
            def_bb,
            def_inst_gid,
            is_const_int,
            const_int_val,
            is_const_flt,
            const_flt_bits,
            skip_val,
            fused_sqrt_src,
            fused_bitmask_cmp,
            fused_vec_load_gid,
            avx2_loops,
        } = self;
        val_locs.destroy(alloc);
        slot_offs.destroy(alloc);
        eir_to_mbb.destroy(alloc);
        use_count.destroy(alloc);
        def_bb.destroy(alloc);
        def_inst_gid.destroy(alloc);
        is_const_int.destroy(alloc);
        const_int_val.destroy(alloc);
        is_const_flt.destroy(alloc);
        const_flt_bits.destroy(alloc);
        skip_val.destroy(alloc);
        fused_sqrt_src.destroy(alloc);
        fused_bitmask_cmp.destroy(alloc);
        fused_vec_load_gid.destroy(alloc);
        avx2_loops.destroy(alloc);
    }
}

fn ty_has_unsupported_scalar(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let n = env.get(ty);
    if n.kind == .Float && n.u8_val == 16_u8 {
        return true;
    }
    if n.kind == .Int && n.u8_val == 128_u8 {
        return true;
    }
    if n.kind == .Vec {
        let en = env.get(n.primary);
        if en.kind == .Float && en.u8_val == 16_u8 {
            return true;
        }
        if en.kind == .Int && en.u8_val == 128_u8 {
            return true;
        }
    }
    return false;
}

fn is_supported_builtin(op: cfg_ir.CfgBuiltinOpKind) -> bool {
    match op {
        .ArenaInit => { return true; }
        .ArenaAlloc => { return true; }
        .ArenaReset => { return true; }
        .ArenaDestroy => { return true; }
        .ArenaUsedBytes => { return true; }
        .ArenaCapacity => { return true; }
        .AllocCapLiveAllocs => { return true; }
        .AllocCapUsedBytes => { return true; }
        .AllocCapPeakBytes => { return true; }

        .ArenaPoolInit => { return true; }
        .ArenaPoolPush => { return true; }
        .ArenaPoolIdAt => { return true; }
        .ArenaPoolReset => { return true; }
        .ArenaPoolLen => { return true; }

        .SlotPoolInit => { return true; }
        .SlotPoolInsert => { return true; }
        .SlotPoolTryInsert => { return true; }
        .SlotPoolRemove => { return true; }
        .SlotPoolGet => { return true; }
        .SlotPoolAt => { return true; }
        .SlotPoolLen => { return true; }
        .SlotPoolCap => { return true; }
        .SlotPoolIsAlive => { return true; }
        .SlotPoolIdAt => { return true; }
        .SlotPoolDestroy => { return true; }

        .BufInit => { return true; }
        .BufPush => { return true; }
        .BufPushSlice => { return true; }
        .BufPop => { return true; }
        .BufLen => { return true; }
        .BufCap => { return true; }
        .BufClear => { return true; }
        .BufAsSlice => { return true; }
        .BufAt => { return true; }
        .BufGet => { return true; }
        .BufSub => { return true; }
        .BufDestroy => { return true; }

        .AtomicNew => { return true; }
        .AtomicLoad => { return true; }
        .AtomicStore => { return true; }
        .AtomicFetchAdd => { return true; }
        .AtomicFetchSub => { return true; }
        .AtomicSwap => { return true; }
        .AtomicCas => { return true; }
        .MmioRead => { return true; }
        .MmioWrite => { return true; }
        .RawPtrFromUsize => { return true; }
        .RawPtrAsUsize => { return true; }

        .SliceLen => { return true; }
        .ArrayLen => { return true; }
        .StrLen => { return true; }
        .StrAsBytes => { return true; }
        .BytesAsStr => { return true; }
        .SliceAt => { return true; }
        .ArrayAt => { return true; }
        .SliceGet => { return true; }
        .ArrayGet => { return true; }
        .SliceSub => { return true; }
        .ArraySub => { return true; }

        .MathSqrt => { return true; }
        .MathFma => { return true; }
        .MathLzcnt => { return true; }
        .MathTzcnt => { return true; }
        .MathPopcnt => { return true; }
        .MathBswap => { return true; }

        .VecSplat => { return true; }
        .VecLen => { return true; }
        .VecCmp => { return true; }
        .VecMaskAny => { return true; }
        .VecMaskAll => { return true; }
        .VecBitmask => { return true; }
        .VecSelect => { return true; }
        .VecMin => { return true; }
        .VecMax => { return true; }
        .VecFma => { return true; }
        .VecReduceAdd => { return true; }
        .VecReduceMin => { return true; }
        .VecReduceMax => { return true; }
        .VecDot => { return true; }
        .VecShuffle => { return true; }

        .ClockNowNs => { return true; }
        .ArgsLen => { return true; }
        .ScheduleBuild => { return true; }

        _ => { return false; }
    }
}

fn precheck_fn_eligible(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> bool {
    let f = eir_prog.get_fn(fn_id) orelse {
        return false;
    };
    if f.sig.effects.is_naked || f.sig.effects.is_interrupt || f.sig.effects.is_gpu {
        return false;
    }
    if eir_prog.fn_par_for_regions(fn_id).len > 0_usize {
        return false;
    }
    if ty_has_unsupported_scalar(f.sig.ret, env) {
        return false;
    }
    let val_tys = eir_prog.fn_value_tys(fn_id);
    var vi: usize = 0_usize;
    while vi < val_tys.len {
        if ty_has_unsupported_scalar(val_tys[vi], env) {
            return false;
        }
        vi = vi +% 1_usize;
    }
    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < slots.len {
        if ty_has_unsupported_scalar(slots[si].ty, env) {
            return false;
        }
        si = si +% 1_usize;
    }

    let blks = eir_prog.fn_blocks(fn_id);
    if blks.len == 0_usize {
        return false;
    }
    var bi: usize = 0_usize;
    while bi < blks.len {
        let insts = eir_prog.insts_slice(blks[bi].insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            match inst.kind {
                .InlineAsm => { return false; }
                .GetVar => { return false; }
                .SetVar => { return false; }
                .Const => {
                    if let c = eir_prog.get_const(inst.aux0) {
                        if c.kind == .FnRef {
                            return false;
                        }
                    }
                }
                .BuiltinCall => {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        if !is_supported_builtin(bc.op.kind) {
                            return false;
                        }
                    } else {
                        return false;
                    }
                }
                _ => {}
            }
            ii = ii +% 1_usize;
        }
        bi = bi +% 1_usize;
    }
    return true;
}

fn is_slice_or_str_ty(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let n = env.get(ty);
    if n.kind == .Str {
        return true;
    }
    if n.kind == .Borrow && (n.borrow_kind == .Slice || n.borrow_kind == .Str) {
        return true;
    }
    return false;
}

fn is_row_view_ty(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let n = env.get(ty);
    return n.kind == .Borrow && n.borrow_kind == .Single && env.get(n.primary).kind == .Pool;
}

fn is_opt_row_view_ty(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let n = env.get(ty);
    return n.kind == .Optional && is_row_view_ty(n.primary, env);
}

fn is_scalar_gpr_ty(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize || lay.size > 8_usize {
        return false;
    }
    let n = env.get(ty);
    match n.kind {
        .Bool => { return true; }
        .Char => { return true; }
        .Int => { return true; }
        .Enum => { return true; }
        .ErrorSet => { return true; }
        .Bitfield => { return true; }
        .RawPtr => { return true; }
        .PhysAddr => { return true; }
        .VirtAddr => { return true; }
        .DmaAddr => { return true; }
        .Borrow => {
            if n.borrow_kind == .Single {
                return env.get(n.primary).kind != .Pool;
            }
            return false;
        }
        .Optional => {
            let niche = env.opt_niche(n.primary);
            return niche.kind == .IdBrand || niche.kind == .GenId
                || niche.kind == .Link || niche.kind == .NullPtr
                || niche.kind == .BoolTag || niche.kind == .ScalarSentinel;
        }
        .Builtin => {
            return n.builtin_kind == .IdBrand
                || n.builtin_kind == .GenId
                || n.builtin_kind == .Link
                || n.builtin_kind == .FsCap
                || n.builtin_kind == .DirCap
                || n.builtin_kind == .NetCap
                || n.builtin_kind == .ClockCap
                || n.builtin_kind == .IoCap
                || n.builtin_kind == .BuildCap
                || n.builtin_kind == .MmioReg;
        }
        _ => { return false; }
    }
}

fn is_vec128_ty(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let n = env.get(ty);
    if n.kind != .Vec {
        return false;
    }
    return env.x64_layout(ty).size == 16_usize;
}

fn is_vec256_ty(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let n = env.get(ty);
    if n.kind != .Vec {
        return false;
    }
    return env.x64_layout(ty).size == 32_usize;
}

fn ctx_val_loc(ctx: *IselCtx, v: eir.EirValue) -> IselValLoc {
    let idx = v.widen.[usize]();
    let s = ctx.val_locs.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return val_loc_zst();
}

fn ctx_slot_off(ctx: *IselCtx, slot: eir.EirSlot) -> i32 {
    let idx = slot.widen.[usize]();
    let s = ctx.slot_offs.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return -8_i32;
}

fn ctx_mbb_for_eir(ctx: *IselCtx, bb: eir.BlockId) -> u32 {
    let idx = bb.widen.[usize]();
    let s = ctx.eir_to_mbb.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return 0_u32;
}

fn ctx_is_const_int(ctx: *IselCtx, v: eir.EirValue) -> bool {
    let idx = v.widen.[usize]();
    let s = ctx.is_const_int.as_slice();
    return idx < s.len && s[idx] != 0_u8;
}

fn ctx_const_int(ctx: *IselCtx, v: eir.EirValue) -> u64 {
    let idx = v.widen.[usize]();
    let s = ctx.const_int_val.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return 0_u64;
}

fn ctx_is_const_flt(ctx: *IselCtx, v: eir.EirValue) -> bool {
    let idx = v.widen.[usize]();
    let s = ctx.is_const_flt.as_slice();
    return idx < s.len && s[idx] != 0_u8;
}

fn ctx_const_flt_bits(ctx: *IselCtx, v: eir.EirValue) -> u64 {
    let idx = v.widen.[usize]();
    let s = ctx.const_flt_bits.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return 0_u64;
}

fn ctx_use_count(ctx: *IselCtx, v: eir.EirValue) -> u32 {
    let idx = v.widen.[usize]();
    let s = ctx.use_count.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return 0_u32;
}

fn ctx_def_bb(ctx: *IselCtx, v: eir.EirValue) -> u32 {
    let idx = v.widen.[usize]();
    let s = ctx.def_bb.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return eir.EIR_NONE;
}

fn ctx_def_inst_gid(ctx: *IselCtx, v: eir.EirValue) -> u32 {
    let idx = v.widen.[usize]();
    let s = ctx.def_inst_gid.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return eir.EIR_NONE;
}

fn ctx_should_skip(ctx: *IselCtx, v: eir.EirValue) -> bool {
    let idx = v.widen.[usize]();
    let s = ctx.skip_val.as_slice();
    return idx < s.len && s[idx] != 0_u8;
}

fn bump_use(uc: *mut [u32], v: eir.EirValue) {
    if v == eir.EIR_NONE {
        return;
    }
    let idx = v.widen.[usize]();
    if idx < uc.len {
        uc[idx] = uc[idx] +% 1_u32;
    }
}

fn mark_addr_taken(at: *mut [u8], v: eir.EirValue) {
    if v == eir.EIR_NONE {
        return;
    }
    let idx = v.widen.[usize]();
    if idx < at.len {
        at[idx] = 1_u8;
    }
}

fn collect_inst_uses_for_isel(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    inst: *eir.EirInst,
    uc: *mut [u32],
    at: *mut [u8],
) {
    match inst.kind {
        .Copy => { bump_use(uc, inst.v0); }
        .StoreSlot => { bump_use(uc, inst.v0); }
        .LoadPlace => {
            if let p = eir_prog.get_place(inst.aux0) {
                if p.base.kind == .Val {
                    bump_use(uc, p.base.id);
                    let bty = eir_prog.fn_val_ty(fn_id, p.base.id);
                    let bn = env.get(bty);
                    let projs0 = eir_prog.projs_slice(p.projs);
                    var is_rv_field = false;
                    if is_row_view_ty(bty, env) && projs0.len > 0_usize {
                        is_rv_field = projs0[0_usize].kind == .Field;
                    }
                    let is_ptr_or_slice = (bn.kind == .Borrow && (bn.borrow_kind == .Slice || bn.borrow_kind == .Str || (bn.borrow_kind == .Single && env.get(bn.primary).kind != .Pool)))
                        || bn.kind == .RawPtr || bn.kind == .Str || is_rv_field;
                    if !is_ptr_or_slice {
                        mark_addr_taken(at, p.base.id);
                    }
                }
                let projs = eir_prog.projs_slice(p.projs);
                var pi: usize = 0_usize;
                while pi < projs.len {
                    if projs[pi].kind == .Index {
                        bump_use(uc, projs[pi].index);
                    }
                    pi = pi +% 1_usize;
                }
            }
        }
        .StorePlace => {
            if let p = eir_prog.get_place(inst.aux0) {
                if p.base.kind == .Val {
                    bump_use(uc, p.base.id);
                    let bty = eir_prog.fn_val_ty(fn_id, p.base.id);
                    let bn = env.get(bty);
                    let projs0 = eir_prog.projs_slice(p.projs);
                    var is_rv_field = false;
                    if is_row_view_ty(bty, env) && projs0.len > 0_usize {
                        is_rv_field = projs0[0_usize].kind == .Field;
                    }
                    let is_ptr_or_slice = (bn.kind == .Borrow && (bn.borrow_kind == .Slice || bn.borrow_kind == .Str || (bn.borrow_kind == .Single && env.get(bn.primary).kind != .Pool)))
                        || bn.kind == .RawPtr || bn.kind == .Str || is_rv_field;
                    if !is_ptr_or_slice {
                        mark_addr_taken(at, p.base.id);
                    }
                }
                let projs = eir_prog.projs_slice(p.projs);
                var pi: usize = 0_usize;
                while pi < projs.len {
                    if projs[pi].kind == .Index {
                        bump_use(uc, projs[pi].index);
                    }
                    pi = pi +% 1_usize;
                }
            }
            bump_use(uc, inst.v0);
        }
        .PlaceAddr => {
            if let p = eir_prog.get_place(inst.aux0) {
                if p.base.kind == .Val {
                    bump_use(uc, p.base.id);
                    let bty = eir_prog.fn_val_ty(fn_id, p.base.id);
                    let bn = env.get(bty);
                    let is_ptr_or_slice = (bn.kind == .Borrow && (bn.borrow_kind == .Slice || bn.borrow_kind == .Str || (bn.borrow_kind == .Single && env.get(bn.primary).kind != .Pool)))
                        || bn.kind == .RawPtr || bn.kind == .Str;
                    if !is_ptr_or_slice {
                        mark_addr_taken(at, p.base.id);
                    }
                }
                let projs = eir_prog.projs_slice(p.projs);
                var pi: usize = 0_usize;
                while pi < projs.len {
                    if projs[pi].kind == .Index {
                        bump_use(uc, projs[pi].index);
                    }
                    pi = pi +% 1_usize;
                }
            }
        }
        .PoolColumnLoad => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Val {
                    bump_use(uc, op.pool_base.id);
                    if !op.pool_is_ptr {
                        mark_addr_taken(at, op.pool_base.id);
                    }
                }
                bump_use(uc, op.index);
            }
        }
        .PoolColumnStore => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Val {
                    bump_use(uc, op.pool_base.id);
                    if !op.pool_is_ptr {
                        mark_addr_taken(at, op.pool_base.id);
                    }
                }
                bump_use(uc, op.index);
            }
            bump_use(uc, inst.v0);
        }
        .Unary => { bump_use(uc, inst.v0); }
        .Binary => {
            bump_use(uc, inst.v0);
            bump_use(uc, inst.v1);
        }
        .Cast => { bump_use(uc, inst.v0); }
        .Slice => {
            bump_use(uc, inst.v0);
            if env.get(inst.ty1).kind == .Array {
                mark_addr_taken(at, inst.v0);
            }
            bump_use(uc, inst.v1);
            bump_use(uc, inst.v2);
        }
        .VecLoad => {
            bump_use(uc, inst.v0);
            bump_use(uc, inst.v1);
        }
        .VecStore => {
            bump_use(uc, inst.v0);
            bump_use(uc, inst.v1);
            bump_use(uc, inst.v2);
        }
        .VecFma => {
            bump_use(uc, inst.v0);
            bump_use(uc, inst.v1);
            bump_use(uc, inst.v2);
        }
        .Aggregate => {
            let elems = eir_prog.vals_slice(inst.range);
            var i: usize = 0_usize;
            while i < elems.len {
                bump_use(uc, elems[i]);
                i = i +% 1_usize;
            }
        }
        .UnwrapOptional => { bump_use(uc, inst.v0); }
        .UnwrapErrorOk => { bump_use(uc, inst.v0); }
        .UnwrapErrorErr => { bump_use(uc, inst.v0); }
        .IsNonNull => { bump_use(uc, inst.v0); }
        .IsError => { bump_use(uc, inst.v0); }
        .MatchTag => { bump_use(uc, inst.v0); }
        .FieldExtract => { bump_use(uc, inst.v0); }
        .MakeDyn => { bump_use(uc, inst.v0); }
        .MakeClosure => { bump_use(uc, inst.v0); }
        .Call => {
            if let cd = eir_prog.get_call(inst.aux0) {
                if cd.callee.kind == .FnPtr {
                    bump_use(uc, cd.callee.a);
                }
                let args = eir_prog.vals_slice(cd.args);
                var i: usize = 0_usize;
                while i < args.len {
                    bump_use(uc, args[i]);
                    let aty = eir_prog.fn_val_ty(fn_id, args[i]);
                    if classify_arg(aty, env) == .ByPtr {
                        mark_addr_taken(at, args[i]);
                    }
                    i = i +% 1_usize;
                }
            }
        }
        .BuiltinCall => {
            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                let args = eir_prog.vals_slice(bc.args);
                let aslots = eir_prog.arg_slots_slice(bc.arg_slots);
                var i: usize = 0_usize;
                while i < args.len {
                    bump_use(uc, args[i]);
                    i = i +% 1_usize;
                }
                // Check pointer-arg builtins where arg 0 might be an array/struct value without slot
                if args.len > 0_usize && (aslots.len == 0_usize || aslots[0_usize] == eir.EIR_NONE) {
                    let k = bc.op.kind;
                    if k == .ArrayAt || k == .ArrayGet || k == .ArraySub || k == .ArenaPoolPush {
                        let a0ty = eir_prog.fn_val_ty(fn_id, args[0_usize]);
                        let a0n = env.get(a0ty);
                        if a0n.kind != .Borrow && a0n.kind != .RawPtr {
                            mark_addr_taken(at, args[0_usize]);
                        }
                    }
                }
                if bc.op.kind == .ArenaPoolPush && args.len > 1_usize {
                    mark_addr_taken(at, args[1_usize]);
                }
                if bc.op.kind == .SlotPoolInsert && args.len > 2_usize {
                    mark_addr_taken(at, args[2_usize]);
                }
                if bc.op.kind == .SlotPoolTryInsert && args.len > 1_usize {
                    mark_addr_taken(at, args[1_usize]);
                }
            }
        }
        _ => {}
    }
}

fn check_branch_fusible_cond(
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ctx: *IselCtx,
    bb: eir.BlockId,
    cond_v: eir.EirValue,
) -> bool {
    if cond_v == eir.EIR_NONE {
        return false;
    }
    if ctx_use_count(ctx, cond_v) != 1_u32 {
        return false;
    }
    if ctx_def_bb(ctx, cond_v) != bb {
        return false;
    }
    let gid = ctx_def_inst_gid(ctx, cond_v);
    if gid == eir.EIR_NONE {
        return false;
    }
    let insts = eir_prog.funcs.insts.as_slice();
    let gidx = gid.widen.[usize]();
    if gidx >= insts.len {
        return false;
    }
    let def_i = insts[gidx];
    if def_i.kind == .Binary {
        let op = def_i.bin_op;
        if op == .Eq || op == .NotEq || op == .Lt || op == .LtEq || op == .Gt || op == .GtEq {
            let tn = env.get(def_i.ty1);
            if tn.kind == .Float {
                return tn.u8_val == 32_u8 || tn.u8_val == 64_u8;
            }
            return tn.kind != .Vec && env.x64_layout(def_i.ty1).size <= 8_usize;
        }
        return false;
    }
    if def_i.kind == .IsNonNull || def_i.kind == .IsError {
        return true;
    }
    return false;
}

/// Detects `Aggregate(.Vec, [MathSqrt(FieldExtract(v, 0)), ..., MathSqrt(FieldExtract(v, N-1))])`
/// on `f32x4` or `f64x2` -> fused into single `VSqrtPS` / `VSqrtPD`!
fn detect_vec_sqrt_fusion(
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ctx: *mut IselCtx,
    bb: eir.BlockId,
    inst: *eir.EirInst,
) {
    let agg = eir_prog.get_aggregate(inst.aux0) orelse { return; };
    if agg.tag != .Vec {
        return;
    }
    let dn = env.get(inst.ty0);
    if dn.kind != .Vec {
        return;
    }
    let en = env.get(dn.primary);
    if en.kind != .Float {
        return;
    }
    let lanes = dn.u8_val.widen.[usize]();
    if !((en.u8_val == 32_u8 && (lanes == 4_usize || lanes == 8_usize))
        || (en.u8_val == 64_u8 && (lanes == 2_usize || lanes == 4_usize)))
    {
        return;
    }
    let elems = eir_prog.vals_slice(inst.range);
    if elems.len != lanes {
        return;
    }
    let all_insts = eir_prog.funcs.insts.as_slice();
    var src_vec = eir.EIR_NONE;
    var li: usize = 0_usize;
    while li < lanes && li < elems.len {
        let ev = elems[li];
        if ctx_use_count(ctx, ev) != 1_u32 || ctx_def_bb(ctx, ev) != bb {
            return;
        }
        let sgid = ctx_def_inst_gid(ctx, ev);
        if sgid == eir.EIR_NONE || sgid.widen.[usize]() >= all_insts.len {
            return;
        }
        let si = all_insts[sgid.widen.[usize]()];
        if si.kind != .BuiltinCall {
            return;
        }
        let bc = eir_prog.get_builtin_call(si.aux0) orelse { return; };
        if bc.op.kind != .MathSqrt {
            return;
        }
        let bargs = eir_prog.vals_slice(bc.args);
        if bargs.len != 1_usize {
            return;
        }
        let xv = bargs[0_usize];
        if ctx_use_count(ctx, xv) != 1_u32 || ctx_def_bb(ctx, xv) != bb {
            return;
        }
        let xgid = ctx_def_inst_gid(ctx, xv);
        if xgid == eir.EIR_NONE || xgid.widen.[usize]() >= all_insts.len {
            return;
        }
        let xi = all_insts[xgid.widen.[usize]()];
        if xi.kind != .FieldExtract || xi.aux0.widen.[usize]() != li {
            return;
        }
        if src_vec == eir.EIR_NONE {
            src_vec = xi.v0;
        } else if xi.v0 != src_vec {
            return;
        }
        li = li +% 1_usize;
    }
    if src_vec == eir.EIR_NONE {
        return;
    }
    if eir_prog.fn_val_ty(ctx.fn_id, src_vec) != inst.ty0 {
        return;
    }
    // Mark scalar extracts and sqrts skipped, and record fused vector sqrt source!
    let dst_idx = inst.dst.widen.[usize]();
    let fss = ctx.fused_sqrt_src.as_mut_slice();
    if dst_idx < fss.len {
        fss[dst_idx] = src_vec;
    }
    li = 0_usize;
    while li < lanes && li < elems.len {
        let ev = elems[li];
        let eidx = ev.widen.[usize]();
        let sgid = ctx_def_inst_gid(ctx, ev);
        let sk = ctx.skip_val.as_mut_slice();
        if eidx < sk.len {
            sk[eidx] = 1_u8;
        }
        if sgid != eir.EIR_NONE && sgid.widen.[usize]() < all_insts.len {
            let si = all_insts[sgid.widen.[usize]()];
            if let bc = eir_prog.get_builtin_call(si.aux0) {
                let bargs = eir_prog.vals_slice(bc.args);
                if bargs.len == 1_usize {
                    let xidx = bargs[0_usize].widen.[usize]();
                    if xidx < sk.len {
                        sk[xidx] = 1_u8;
                    }
                }
            }
        }
        li = li +% 1_usize;
    }
}

struct BasePlusOff {
    base: eir.EirValue;
    off: u64;
}

fn resolve_copy_for_vec_load(
    eir_prog: *eir.EirProgram,
    ctx: *IselCtx,
    v_in: eir.EirValue,
) -> eir.EirValue {
    let all_insts = eir_prog.funcs.insts.as_slice();
    var v = v_in;
    var hops: usize = 0_usize;
    while hops < 8_usize {
        let gid = ctx_def_inst_gid(ctx, v);
        if gid == eir.EIR_NONE || gid.widen.[usize]() >= all_insts.len {
            break;
        }
        let inst = all_insts[gid.widen.[usize]()];
        if inst.kind == .Copy && inst.v0 != eir.EIR_NONE {
            v = inst.v0;
            hops = hops +% 1_usize;
        } else {
            break;
        }
    }
    return v;
}

fn extract_base_plus_off(
    eir_prog: *eir.EirProgram,
    ctx: *IselCtx,
    idx_in: eir.EirValue,
) -> BasePlusOff {
    var v = resolve_copy_for_vec_load(eir_prog, ctx, idx_in);
    var total_off: u64 = 0_u64;
    let all_insts = eir_prog.funcs.insts.as_slice();
    var hops: usize = 0_usize;
    while hops < 4_usize {
        let gid = ctx_def_inst_gid(ctx, v);
        if gid == eir.EIR_NONE || gid.widen.[usize]() >= all_insts.len {
            break;
        }
        let inst = all_insts[gid.widen.[usize]()];
        if inst.kind == .Binary && (inst.bin_op == .Add || inst.bin_op == .AddWrap) {
            if ctx_is_const_int(ctx, inst.v1) {
                total_off = total_off +% ctx_const_int(ctx, inst.v1);
                v = resolve_copy_for_vec_load(eir_prog, ctx, inst.v0);
                hops = hops +% 1_usize;
                continue;
            }
            if ctx_is_const_int(ctx, inst.v0) {
                total_off = total_off +% ctx_const_int(ctx, inst.v0);
                v = resolve_copy_for_vec_load(eir_prog, ctx, inst.v1);
                hops = hops +% 1_usize;
                continue;
            }
        }
        break;
    }
    return BasePlusOff.{ base: v, off: total_off };
}

fn inst_may_write_mem_for_vec_load(eir_prog: *eir.EirProgram, inst: *eir.EirInst) -> bool {
    match inst.kind {
        .StoreSlot => { return true; }
        .StorePlace => { return true; }
        .PoolColumnStore => { return true; }
        .Call => { return true; }
        .InlineAsm => { return true; }
        .SetVar => { return true; }
        .BuiltinCall => {
            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                match bc.op.kind {
                    .SliceLen => { return false; }
                    .ArrayLen => { return false; }
                    .StrLen => { return false; }
                    .StrAsBytes => { return false; }
                    .VecSplat => { return false; }
                    .VecLen => { return false; }
                    .VecCmp => { return false; }
                    .VecMaskAny => { return false; }
                    .VecMaskAll => { return false; }
                    .VecBitmask => { return false; }
                    .VecSelect => { return false; }
                    .VecMin => { return false; }
                    .VecMax => { return false; }
                    .VecFma => { return false; }
                    .VecReduceAdd => { return false; }
                    .VecReduceMin => { return false; }
                    .VecReduceMax => { return false; }
                    .VecDot => { return false; }
                    .VecShuffle => { return false; }
                    .MathSqrt => { return false; }
                    .MathFma => { return false; }
                    .MathLzcnt => { return false; }
                    .MathTzcnt => { return false; }
                    .MathPopcnt => { return false; }
                    .MathBswap => { return false; }
                    _ => { return true; }
                }
            }
            return true;
        }
        _ => { return false; }
    }
}

/// Detects contiguous vector gather `Aggregate(.Vec, [s[i], s[i+1], ..., s[i+N-1]])`
/// (16B or 32B) and fuses all N scalar byte/float loads into ONE `VMovUpsLoad`!
fn detect_vec_contiguous_load(
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ctx: *mut IselCtx,
    bb: eir.BlockId,
    agg_gid: u32,
    inst: *eir.EirInst,
) {
    let didx = inst.dst.widen.[usize]();
    let fss = ctx.fused_sqrt_src.as_slice();
    if didx < fss.len && fss[didx] != eir.EIR_NONE {
        return;
    }
    let agg = eir_prog.get_aggregate(inst.aux0) orelse { return; };
    if agg.tag != .Vec {
        return;
    }
    let dsz = env.x64_layout(inst.ty0).size;
    if dsz != 16_usize && dsz != 32_usize {
        return;
    }
    let esz = env.x64_layout(agg.elem_ty).size;
    if esz != 1_usize && esz != 2_usize && esz != 4_usize && esz != 8_usize {
        return;
    }
    let elems = eir_prog.vals_slice(inst.range);
    if elems.len == 0_usize || elems.len *% esz != dsz {
        return;
    }

    let all_insts = eir_prog.funcs.insts.as_slice();
    let e0 = elems[0_usize];
    if ctx_use_count(ctx, e0) != 1_u32 || ctx_def_bb(ctx, e0) != bb {
        return;
    }
    let gid0 = ctx_def_inst_gid(ctx, e0);
    if gid0 == eir.EIR_NONE || gid0 >= agg_gid || gid0.widen.[usize]() >= all_insts.len {
        return;
    }
    let lp0 = all_insts[gid0.widen.[usize]()];
    if lp0.kind != .LoadPlace {
        return;
    }
    let pl0 = eir_prog.get_place(lp0.aux0) orelse { return; };
    let ps0 = eir_prog.projs_slice(pl0.projs);
    if ps0.len != 1_usize || ps0[0_usize].kind != .Index {
        return;
    }
    if pl0.ty != agg.elem_ty {
        return;
    }
    let base0_dyn = extract_base_plus_off(eir_prog, ctx, ps0[0_usize].index);

    var min_gid = gid0;
    var k: usize = 1_usize;
    while k < elems.len {
        let ek = elems[k];
        if ctx_use_count(ctx, ek) != 1_u32 || ctx_def_bb(ctx, ek) != bb {
            return;
        }
        let gidk = ctx_def_inst_gid(ctx, ek);
        if gidk == eir.EIR_NONE || gidk >= agg_gid || gidk.widen.[usize]() >= all_insts.len {
            return;
        }
        if gidk < min_gid {
            min_gid = gidk;
        }
        let lpk = all_insts[gidk.widen.[usize]()];
        if lpk.kind != .LoadPlace {
            return;
        }
        let plk = eir_prog.get_place(lpk.aux0) orelse { return; };
        if plk.base.kind != pl0.base.kind || plk.base.id != pl0.base.id || plk.ty != agg.elem_ty {
            return;
        }
        let psk = eir_prog.projs_slice(plk.projs);
        if psk.len != 1_usize || psk[0_usize].kind != .Index {
            return;
        }
        let dk = extract_base_plus_off(eir_prog, ctx, psk[0_usize].index);
        if dk.base != base0_dyn.base || dk.off != base0_dyn.off +% k.widen.[u64]() {
            return;
        }
        k = k +% 1_usize;
    }

    // Verify no memory write / call occurs between min_gid and agg_gid in this block
    var scan_gid = min_gid +% 1_u32;
    while scan_gid < agg_gid && scan_gid.widen.[usize]() < all_insts.len {
        if inst_may_write_mem_for_vec_load(eir_prog, &all_insts[scan_gid.widen.[usize]()]) {
            return;
        }
        scan_gid = scan_gid +% 1_u32;
    }

    // Success: fuse all N scalar loads into ONE vector load anchored at gid0!
    let fvl = ctx.fused_vec_load_gid.as_mut_slice();
    if didx < fvl.len {
        fvl[didx] = gid0;
    }
    let sk = ctx.skip_val.as_mut_slice();
    k = 0_usize;
    while k < elems.len {
        let eidx = elems[k].widen.[usize]();
        if eidx < sk.len {
            sk[eidx] = 1_u8;
        }
        k = k +% 1_usize;
    }
}

fn is_vec_splat_byte_const(
    eir_prog: *eir.EirProgram,
    ctx: *IselCtx,
    val_in: eir.EirValue,
    target_byte: u64,
) -> bool {
    let v = resolve_copy_for_vec_load(eir_prog, ctx, val_in);
    let gid = ctx_def_inst_gid(ctx, v);
    let all_insts = eir_prog.funcs.insts.as_slice();
    if gid == eir.EIR_NONE || gid.widen.[usize]() >= all_insts.len {
        return false;
    }
    let inst = all_insts[gid.widen.[usize]()];
    if inst.kind != .BuiltinCall {
        return false;
    }
    let bc = eir_prog.get_builtin_call(inst.aux0) orelse { return false; };
    if bc.op.kind != .VecSplat {
        return false;
    }
    let args = eir_prog.vals_slice(bc.args);
    if args.len != 1_usize {
        return false;
    }
    let a0 = resolve_copy_for_vec_load(eir_prog, ctx, args[0_usize]);
    return ctx_is_const_int(ctx, a0) && (ctx_const_int(ctx, a0) & 0xFF_u64) == target_byte;
}

/// If `VecCmp(u8x16/32, Eq, a, b)` is `(x & splat(0x80)) == splat(0)`, returns `(x, and_val)`
/// so `VecBitmask` can emit ONE `vpmovmskb` + invert instead of `vpand` + `vpcmpeqb` + `vpmovmskb`!
fn match_ascii_signbit_and_val(
    eir_prog: *eir.EirProgram,
    ctx: *IselCtx,
    a: eir.EirValue,
    b: eir.EirValue,
) -> eir.EirValue {
    var cand = eir.EIR_NONE;
    if is_vec_splat_byte_const(eir_prog, ctx, b, 0_u64) {
        cand = resolve_copy_for_vec_load(eir_prog, ctx, a);
    } else if is_vec_splat_byte_const(eir_prog, ctx, a, 0_u64) {
        cand = resolve_copy_for_vec_load(eir_prog, ctx, b);
    } else {
        return eir.EIR_NONE;
    }
    let gid = ctx_def_inst_gid(ctx, cand);
    let all_insts = eir_prog.funcs.insts.as_slice();
    if gid == eir.EIR_NONE || gid.widen.[usize]() >= all_insts.len {
        return eir.EIR_NONE;
    }
    let inst = all_insts[gid.widen.[usize]()];
    if inst.kind != .Binary || inst.bin_op != .BitAnd {
        return eir.EIR_NONE;
    }
    if is_vec_splat_byte_const(eir_prog, ctx, inst.v1, 0x80_u64)
        || is_vec_splat_byte_const(eir_prog, ctx, inst.v0, 0x80_u64)
    {
        return cand;
    }
    return eir.EIR_NONE;
}

fn match_ascii_signbit_src(
    eir_prog: *eir.EirProgram,
    ctx: *IselCtx,
    a: eir.EirValue,
    b: eir.EirValue,
) -> eir.EirValue {
    let and_v = match_ascii_signbit_and_val(eir_prog, ctx, a, b);
    if and_v == eir.EIR_NONE {
        return eir.EIR_NONE;
    }
    let gid = ctx_def_inst_gid(ctx, and_v);
    let all_insts = eir_prog.funcs.insts.as_slice();
    if gid == eir.EIR_NONE || gid.widen.[usize]() >= all_insts.len {
        return eir.EIR_NONE;
    }
    let inst = all_insts[gid.widen.[usize]()];
    if is_vec_splat_byte_const(eir_prog, ctx, inst.v1, 0x80_u64) {
        return inst.v0;
    }
    return inst.v1;
}

/// Detects `VecSplat(f32x4/f32x8, LoadPlace(s[j]))` -> single memory-operand `vbroadcastss [mem], %ymm`!
fn detect_vec_splat_load_fusion(
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ctx: *mut IselCtx,
    bb: eir.BlockId,
    splat_gid: u32,
    inst: *eir.EirInst,
) {
    let bc = eir_prog.get_builtin_call(inst.aux0) orelse { return; };
    if bc.op.kind != .VecSplat {
        return;
    }
    let vn = env.get(bc.op.ty0);
    if vn.kind != .Vec {
        return;
    }
    let total_sz = env.x64_layout(bc.op.ty0).size;
    if total_sz != 16_usize && total_sz != 32_usize {
        return;
    }
    let en = env.get(vn.primary);
    if en.kind != .Float || en.u8_val != 32_u8 {
        return;
    }
    let args = eir_prog.vals_slice(bc.args);
    if args.len != 1_usize {
        return;
    }
    let sv = args[0_usize];
    if ctx_use_count(ctx, sv) != 1_u32 || ctx_def_bb(ctx, sv) != bb {
        return;
    }
    let lgid = ctx_def_inst_gid(ctx, sv);
    let all_insts = eir_prog.funcs.insts.as_slice();
    if lgid == eir.EIR_NONE || lgid >= splat_gid || lgid.widen.[usize]() >= all_insts.len {
        return;
    }
    let li = all_insts[lgid.widen.[usize]()];
    if li.kind != .LoadPlace {
        return;
    }
    let pl = eir_prog.get_place(li.aux0) orelse { return; };
    if pl.ty != vn.primary {
        return;
    }
    // Verify no memory write occurs between lgid and splat_gid
    var scan_gid = lgid +% 1_u32;
    while scan_gid < splat_gid && scan_gid.widen.[usize]() < all_insts.len {
        if inst_may_write_mem_for_vec_load(eir_prog, &all_insts[scan_gid.widen.[usize]()]) {
            return;
        }
        scan_gid = scan_gid +% 1_u32;
    }
    let didx = inst.dst.widen.[usize]();
    let fvl = ctx.fused_vec_load_gid.as_mut_slice();
    if didx < fvl.len {
        fvl[didx] = lgid;
    }
    let sidx = sv.widen.[usize]();
    let sk = ctx.skip_val.as_mut_slice();
    if sidx < sk.len {
        sk[sidx] = 1_u8;
    }
}

/// Detects `VecBitmask(VecCmp(u8x16, Eq, a, b))` -> single `VPCmpEqB` + `VPMovMskB`!
fn detect_vec_bitmask_cmp_fusion(
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ctx: *mut IselCtx,
    bb: eir.BlockId,
    inst: *eir.EirInst,
) {
    let bc = eir_prog.get_builtin_call(inst.aux0) orelse { return; };
    if (bc.op.kind != .VecBitmask && bc.op.kind != .VecMaskAny && bc.op.kind != .VecMaskAll)
        || (bc.op.len_u8 != 16_u8 && bc.op.len_u8 != 32_u8)
    {
        return;
    }
    let args = eir_prog.vals_slice(bc.args);
    if args.len != 1_usize {
        return;
    }
    let mv = args[0_usize];
    if ctx_use_count(ctx, mv) != 1_u32 || ctx_def_bb(ctx, mv) != bb {
        return;
    }
    let mgid = ctx_def_inst_gid(ctx, mv);
    let all_insts = eir_prog.funcs.insts.as_slice();
    if mgid == eir.EIR_NONE || mgid.widen.[usize]() >= all_insts.len {
        return;
    }
    let mi = all_insts[mgid.widen.[usize]()];
    if mi.kind != .BuiltinCall {
        return;
    }
    let mbc = eir_prog.get_builtin_call(mi.aux0) orelse { return; };
    if mbc.op.kind != .VecCmp || mbc.op.bin_op != .Eq {
        return;
    }
    let vn = env.get(mbc.op.ty0);
    if vn.kind != .Vec || vn.u8_val != bc.op.len_u8 {
        return;
    }
    if vn.primary != types.TY_U8 && vn.primary != types.TY_I8 {
        return;
    }
    let didx = inst.dst.widen.[usize]();
    let fbc = ctx.fused_bitmask_cmp.as_mut_slice();
    if didx < fbc.len {
        fbc[didx] = mgid;
    }
    let midx = mv.widen.[usize]();
    let sk = ctx.skip_val.as_mut_slice();
    if midx < sk.len {
        sk[midx] = 1_u8;
    }
    // If `.VecBitmask` is specifically `((x & splat(0x80)) == splat(0)).bitmask()` and `and_v` is single-use, skip `and_v` too!
    if bc.op.kind == .VecBitmask {
        let cargs = eir_prog.vals_slice(mbc.args);
        if cargs.len >= 2_usize {
            let and_v = match_ascii_signbit_and_val(eir_prog, ctx, cargs[0_usize], cargs[1_usize]);
            if and_v != eir.EIR_NONE && ctx_use_count(ctx, and_v) == 1_u32 && ctx_def_bb(ctx, and_v) == bb {
                let aidx = and_v.widen.[usize]();
                let sk2 = ctx.skip_val.as_mut_slice();
                if aidx < sk2.len {
                    sk2[aidx] = 1_u8;
                }
            }
        }
    }
}

/// Checks if `v` is a single-use same-block `VecBitmask(VecCmp(u8x16/u8x32, Eq))` (non-ascii-invert)
/// and returns its lane count (16 or 32), or 0 if not fusable into `VPOr + VPMovMskB`.
fn bitor_fusible_bitmask_lanes(
    eir_prog: *eir.EirProgram,
    ctx: *IselCtx,
    bb: eir.BlockId,
    v: eir.EirValue,
) -> u8 {
    if ctx_use_count(ctx, v) != 1_u32 || ctx_def_bb(ctx, v) != bb {
        return 0_u8;
    }
    let vidx = v.widen.[usize]();
    let fbc = ctx.fused_bitmask_cmp.as_slice();
    if vidx >= fbc.len || fbc[vidx] == eir.EIR_NONE {
        return 0_u8;
    }
    let gid = ctx_def_inst_gid(ctx, v);
    let all_insts = eir_prog.funcs.insts.as_slice();
    if gid == eir.EIR_NONE || gid.widen.[usize]() >= all_insts.len {
        return 0_u8;
    }
    let vi = all_insts[gid.widen.[usize]()];
    if vi.kind != .BuiltinCall {
        return 0_u8;
    }
    let bc = eir_prog.get_builtin_call(vi.aux0) orelse { return 0_u8; };
    if bc.op.kind != .VecBitmask || (bc.op.len_u8 != 16_u8 && bc.op.len_u8 != 32_u8) {
        return 0_u8;
    }
    let cg = fbc[vidx].widen.[usize]();
    if cg >= all_insts.len {
        return 0_u8;
    }
    let cbc = eir_prog.get_builtin_call(all_insts[cg].aux0) orelse { return 0_u8; };
    let cargs = eir_prog.vals_slice(cbc.args);
    if cargs.len < 2_usize {
        return 0_u8;
    }
    if match_ascii_signbit_src(eir_prog, ctx, cargs[0_usize], cargs[1_usize]) != eir.EIR_NONE {
        return 0_u8;
    }
    return bc.op.len_u8;
}

/// Detects `BitOr(VecBitmask(VecCmp(Eq)), VecBitmask(VecCmp(Eq)))` -> `VPCmpEqB + VPCmpEqB + VPOr + VPMovMskB`!
fn detect_bitor_vec_bitmask_fusion(
    eir_prog: *eir.EirProgram,
    ctx: *mut IselCtx,
    bb: eir.BlockId,
    inst: *eir.EirInst,
) {
    if inst.kind != .Binary || inst.bin_op != .BitOr {
        return;
    }
    let l_lanes = bitor_fusible_bitmask_lanes(eir_prog, ctx, bb, inst.v0);
    if l_lanes == 0_u8 {
        return;
    }
    let r_lanes = bitor_fusible_bitmask_lanes(eir_prog, ctx, bb, inst.v1);
    if r_lanes != l_lanes {
        return;
    }
    let lidx = inst.v0.widen.[usize]();
    let ridx = inst.v1.widen.[usize]();
    let sk = ctx.skip_val.as_mut_slice();
    if lidx < sk.len && ridx < sk.len {
        sk[lidx] = 1_u8;
        sk[ridx] = 1_u8;
    }
}

fn record_const_val(
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    inst: *eir.EirInst,
    didx: usize,
    ic: *mut [u8],
    cv: *mut [u64],
    icf: *mut [u8],
    cfb: *mut [u64],
) {
    let c = eir_prog.get_const(inst.aux0) orelse { return; };
    if c.kind == .Int || c.kind == .EnumTag {
        if didx < ic.len { ic[didx] = 1_u8; }
        if didx < cv.len { cv[didx] = c.int_val.lo; }
    } else if c.kind == .Bool {
        if didx < ic.len { ic[didx] = 1_u8; }
        if didx < cv.len { cv[didx] = if c.bool_val { 1_u64 } else { 0_u64 }; }
    } else if c.kind == .Char || c.kind == .ErrorTag {
        if didx < ic.len { ic[didx] = 1_u8; }
        if didx < cv.len { cv[didx] = c.aux_u32.widen.[u64](); }
    } else if c.kind == .Null {
        let tn = env.get(inst.ty0);
        if tn.kind == .Optional {
            let niche = env.opt_niche(tn.primary);
            if niche.kind == .IdBrand {
                if didx < ic.len { ic[didx] = 1_u8; }
                if didx < cv.len { cv[didx] = 0xFFFFFFFF_u64; }
            } else if niche.kind == .GenId || niche.kind == .NullPtr
                || (niche.kind == .Link && env.x64_layout(inst.ty0).size <= 8_usize)
            {
                if didx < ic.len { ic[didx] = 1_u8; }
                if didx < cv.len { cv[didx] = 0_u64; }
            }
        } else if tn.kind == .Builtin && tn.builtin_kind == .IdBrand {
            if didx < ic.len { ic[didx] = 1_u8; }
            if didx < cv.len { cv[didx] = 0xFFFFFFFF_u64; }
        }
    } else if c.kind == .Float {
        let flt_bytes = eir_prog.bytes_slice(c.bytes);
        let fv = parse_f64_lit(flt_bytes);
        let f64_b = fv.bitcast.[u64]();
        let fn_n = env.get(inst.ty0);
        let bits = if fn_n.kind == .Float && fn_n.u8_val == 64_u8 {
            f64_b
        } else {
            f64_bits_to_f32_bits(f64_b).widen.[u64]()
        };
        if didx < icf.len { icf[didx] = 1_u8; }
        if didx < cfb.len { cfb[didx] = bits; }
    }
}

fn init_ctx_and_plan(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    fn_sym_id: u32,
    env: *types.TypeEnv,
    cfg: eir.EirOptConfig,
    sanitize: bool,
    is_linux: bool,
    mf: *mut mach_ir.MachFunc,
) -> IselCtx ! OutOfMemory {
    let f = eir_prog.get_fn(fn_id) orelse {
        let vl = try col.DynBuf.[IselValLoc].init(alloc, 1_usize);
        errdefer vl.destroy(alloc);
        let so = try col.DynBuf.[i32].init(alloc, 1_usize);
        errdefer so.destroy(alloc);
        let em = try col.DynBuf.[u32].init(alloc, 1_usize);
        errdefer em.destroy(alloc);
        let uc = try col.DynBuf.[u32].init(alloc, 1_usize);
        errdefer uc.destroy(alloc);
        let db = try col.DynBuf.[u32].init(alloc, 1_usize);
        errdefer db.destroy(alloc);
        let dg = try col.DynBuf.[u32].init(alloc, 1_usize);
        errdefer dg.destroy(alloc);
        let ici = try col.DynBuf.[u8].init(alloc, 1_usize);
        errdefer ici.destroy(alloc);
        let civ = try col.DynBuf.[u64].init(alloc, 1_usize);
        errdefer civ.destroy(alloc);
        let icf = try col.DynBuf.[u8].init(alloc, 1_usize);
        errdefer icf.destroy(alloc);
        let cfb = try col.DynBuf.[u64].init(alloc, 1_usize);
        errdefer cfb.destroy(alloc);
        let sk = try col.DynBuf.[u8].init(alloc, 1_usize);
        errdefer sk.destroy(alloc);
        let fss = try col.DynBuf.[u32].init(alloc, 1_usize);
        errdefer fss.destroy(alloc);
        let fbc = try col.DynBuf.[u32].init(alloc, 1_usize);
        errdefer fbc.destroy(alloc);
        let fvl = try col.DynBuf.[u32].init(alloc, 1_usize);
        errdefer fvl.destroy(alloc);
        let avx = try col.DynBuf.[Avx2LoopEntry].init(alloc, 1_usize);
        errdefer avx.destroy(alloc);
        return IselCtx.{
            fn_id: fn_id,
            fn_sym_id: fn_sym_id,
            is_export_c: false,
            sanitize: sanitize,
            is_linux: is_linux,
            cfg: cfg,
            ret_ty: types.TY_VOID,
            ret_class: ret_class_simple(.Void),
            has_sret: false,
            sret_vreg: mach_ir.VREG_NONE,
            scratch_vec_off: 0_i32,
            call_arg6_off: 0_i32,
            call_arg7_off: 0_i32,
            cur_mbb: 0_u32,
            cur_depth: 0_u8,
            rodata_counter: 0_u64,
            jt_counter: 0_u64,
            uses_avx2_loop: false,
            hoisted_pvals: [eir.EIR_NONE; 6],
            hoisted_offs: [0_i32; 6],
            hoisted_vregs: [mach_ir.VREG_NONE; 6],
            hoisted_cols_cnt: 0_usize,
            val_locs: vl,
            slot_offs: so,
            eir_to_mbb: em,
            use_count: uc,
            def_bb: db,
            def_inst_gid: dg,
            is_const_int: ici,
            const_int_val: civ,
            is_const_flt: icf,
            const_flt_bits: cfb,
            skip_val: sk,
            fused_sqrt_src: fss,
            fused_bitmask_cmp: fbc,
            fused_vec_load_gid: fvl,
            avx2_loops: avx,
        };
    };

    let ret_ty = f.sig.ret;
    let rc = classify_ret(ret_ty, env);
    let has_sret = ret_uses_sret(rc);
    if rc.kind == .ErrorUnion {
        mf.uses_r15_error = true;
    }

    let val_tys = eir_prog.fn_value_tys(fn_id);
    let nvals = val_tys.len;
    let slots = eir_prog.fn_slots(fn_id);
    let nslots = slots.len;
    let blks = eir_prog.fn_blocks(fn_id);
    let nblks = blks.len;
    let cap_v = if nvals > 4_usize { nvals } else { 4_usize };
    let cap_s = if nslots > 4_usize { nslots } else { 4_usize };
    let cap_b = if nblks > 4_usize { nblks } else { 4_usize };

    var val_locs = try col.DynBuf.[IselValLoc].init(alloc, cap_v);
    errdefer val_locs.destroy(alloc);
    var slot_offs = try col.DynBuf.[i32].init(alloc, cap_s);
    errdefer slot_offs.destroy(alloc);
    var eir_to_mbb = try col.DynBuf.[u32].init(alloc, cap_b);
    errdefer eir_to_mbb.destroy(alloc);
    var use_count = try col.DynBuf.[u32].init(alloc, cap_v);
    errdefer use_count.destroy(alloc);
    var def_bb = try col.DynBuf.[u32].init(alloc, cap_v);
    errdefer def_bb.destroy(alloc);
    var def_inst_gid = try col.DynBuf.[u32].init(alloc, cap_v);
    errdefer def_inst_gid.destroy(alloc);
    var is_const_int = try col.DynBuf.[u8].init(alloc, cap_v);
    errdefer is_const_int.destroy(alloc);
    var const_int_val = try col.DynBuf.[u64].init(alloc, cap_v);
    errdefer const_int_val.destroy(alloc);
    var is_const_flt = try col.DynBuf.[u8].init(alloc, cap_v);
    errdefer is_const_flt.destroy(alloc);
    var const_flt_bits = try col.DynBuf.[u64].init(alloc, cap_v);
    errdefer const_flt_bits.destroy(alloc);
    var skip_val = try col.DynBuf.[u8].init(alloc, cap_v);
    errdefer skip_val.destroy(alloc);
    var fused_sqrt_src = try col.DynBuf.[u32].init(alloc, cap_v);
    errdefer fused_sqrt_src.destroy(alloc);
    var fused_bitmask_cmp = try col.DynBuf.[u32].init(alloc, cap_v);
    errdefer fused_bitmask_cmp.destroy(alloc);
    var fused_vec_load_gid = try col.DynBuf.[u32].init(alloc, cap_v);
    errdefer fused_vec_load_gid.destroy(alloc);
    let avx2_loops = try col.DynBuf.[Avx2LoopEntry].init(alloc, 4_usize);
    errdefer avx2_loops.destroy(alloc);

    var addr_taken = try col.DynBuf.[u8].init(alloc, cap_v);
    errdefer addr_taken.destroy(alloc);

    var vi: usize = 0_usize;
    while vi < nvals {
        try val_locs.push(alloc, val_loc_zst());
        try use_count.push(alloc, 0_u32);
        try def_bb.push(alloc, eir.EIR_NONE);
        try def_inst_gid.push(alloc, eir.EIR_NONE);
        try is_const_int.push(alloc, 0_u8);
        try const_int_val.push(alloc, 0_u64);
        try is_const_flt.push(alloc, 0_u8);
        try const_flt_bits.push(alloc, 0_u64);
        try skip_val.push(alloc, 0_u8);
        try fused_sqrt_src.push(alloc, eir.EIR_NONE);
        try fused_bitmask_cmp.push(alloc, eir.EIR_NONE);
        try fused_vec_load_gid.push(alloc, eir.EIR_NONE);
        try addr_taken.push(alloc, 0_u8);
        vi = vi +% 1_usize;
    }

    // 1. Scan blocks to populate def_bb, def_inst_gid, use_count, addr_taken, const maps
    var bi: usize = 0_usize;
    while bi < blks.len {
        let blk = blks[bi];
        let bbid = bi.trunc.[u32]();
        let phis = eir_prog.phis_slice(blk.phis);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len {
            let ph = phis[phi_i];
            let pidx = ph.dst.widen.[usize]();
            let dbs = def_bb.as_mut_slice();
            if pidx < dbs.len {
                dbs[pidx] = bbid;
            }
            let incs = eir_prog.phi_incoming(ph.incoming);
            var inc_i: usize = 0_usize;
            while inc_i < incs.len {
                bump_use(use_count.as_mut_slice(), incs[inc_i].val);
                inc_i = inc_i +% 1_usize;
            }
            phi_i = phi_i +% 1_usize;
        }
        let insts = eir_prog.insts_slice(blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            let gid = blk.insts.start +% ii.trunc.[u32]();
            let dv = eir.inst_def(&inst);
            if dv != eir.EIR_NONE {
                let didx = dv.widen.[usize]();
                let dbs = def_bb.as_mut_slice();
                let dgs = def_inst_gid.as_mut_slice();
                if didx < dbs.len {
                    dbs[didx] = bbid;
                }
                if didx < dgs.len {
                    dgs[didx] = gid;
                }
                if inst.kind == .Const {
                    record_const_val(
                        eir_prog, env, &inst, didx,
                        is_const_int.as_mut_slice(),
                        const_int_val.as_mut_slice(),
                        is_const_flt.as_mut_slice(),
                        const_flt_bits.as_mut_slice(),
                    );
                }
            }
            collect_inst_uses_for_isel(
                eir_prog, fn_id, env, &inst,
                use_count.as_mut_slice(), addr_taken.as_mut_slice(),
            );
            ii = ii +% 1_usize;
        }
        match blk.term.kind {
            .Branch => { bump_use(use_count.as_mut_slice(), blk.term.val); }
            .SwitchInt => { bump_use(use_count.as_mut_slice(), blk.term.val); }
            .Return => {
                if blk.term.flag {
                    bump_use(use_count.as_mut_slice(), blk.term.val);
                }
            }
            _ => {}
        }
        bi = bi +% 1_usize;
    }

    // 2. Allocate stack slots for EIR local slots
    var si: usize = 0_usize;
    while si < slots.len {
        let lay = env.x64_layout(slots[si].ty);
        let sz = if lay.size == 0_usize { 8_usize } else { lay.size };
        let al = if lay.align < 8_usize { 8_usize } else if lay.align > 32_usize { 32_usize } else { lay.align };
        let off = mf.alloc_stack_slot(sz, al);
        try slot_offs.push(alloc, off);
        si = si +% 1_usize;
    }

    // 3. Allocate VRegs / stack slots for all EIR SSA values
    // Also detect non-escaping `ArenaPoolIdAt` / `ArenaPoolPush` / void `BufPush` ErrorUnion values that
    // are ONLY consumed by `IsError` / `UnwrapErrorOk` / `UnwrapErrorErr` / `MatchTag` -> PairGpr (tag, ok)!
    var eu_pair_ok = try col.DynBuf.[u8].init(alloc, cap_v);
    errdefer eu_pair_ok.destroy(alloc);
    var eu_reads_err = try col.DynBuf.[u8].init(alloc, cap_v);
    errdefer eu_reads_err.destroy(alloc);
    vi = 0_usize;
    while vi < nvals {
        try eu_pair_ok.push(alloc, 0_u8);
        try eu_reads_err.push(alloc, 0_u8);
        vi = vi +% 1_usize;
    }
    let all_insts_p = eir_prog.funcs.insts.as_slice();
    let dgs_ro = def_inst_gid.as_slice();
    vi = 0_usize;
    while vi < val_tys.len {
        let ty = val_tys[vi];
        let tn = env.get(ty);
        if tn.kind == .ErrorUnion && vi < dgs_ro.len {
            let ok_sz = env.x64_layout(tn.primary).size;
            let gid = dgs_ro[vi];
            if gid != eir.EIR_NONE && gid.widen.[usize]() < all_insts_p.len {
                let di = all_insts_p[gid.widen.[usize]()];
                if di.kind == .BuiltinCall {
                    if let bc = eir_prog.get_builtin_call(di.aux0) {
                        if (ok_sz == 4_usize && (bc.op.kind == .ArenaPoolIdAt || bc.op.kind == .ArenaPoolPush))
                            || (ok_sz == 0_usize && bc.op.kind == .BufPush)
                        {
                            let ep = eu_pair_ok.as_mut_slice();
                            if vi < ep.len { ep[vi] = 1_u8; }
                        } else if is_slice_or_str_ty(tn.primary, env)
                            && (bc.op.kind == .SliceSub || bc.op.kind == .ArraySub)
                        {
                            let ep = eu_pair_ok.as_mut_slice();
                            if vi < ep.len { ep[vi] = 2_u8; }
                        }
                    }
                } else if di.kind == .Call {
                    let rc_call = classify_ret(ty, env);
                    if rc_call.kind == .ErrorUnion
                        && (rc_call.ok_kind == .Void
                            || (rc_call.ok_kind == .IntReg
                                && (ok_sz == 1_usize || ok_sz == 2_usize || ok_sz == 4_usize || ok_sz == 8_usize)))
                    {
                        let ep = eu_pair_ok.as_mut_slice();
                        if vi < ep.len { ep[vi] = 1_u8; }
                    }
                }
            }
        }
        vi = vi +% 1_usize;
    }
    // Disqualify any eu_pair_ok value used by anything other than IsError/UnwrapErrorOk/UnwrapErrorErr/MatchTag,
    // and track whether any ErrorUnion's error payload/tag is actually read via UnwrapErrorErr/MatchTag.
    bi = 0_usize;
    while bi < blks.len {
        let blk = blks[bi];
        let phis = eir_prog.phis_slice(blk.phis);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len {
            let incs = eir_prog.phi_incoming(phis[phi_i].incoming);
            var inc_i: usize = 0_usize;
            while inc_i < incs.len {
                let iv = incs[inc_i].val.widen.[usize]();
                let ep = eu_pair_ok.as_mut_slice();
                if iv < ep.len { ep[iv] = 0_u8; }
                inc_i = inc_i +% 1_usize;
            }
            phi_i = phi_i +% 1_usize;
        }
        let insts = eir_prog.insts_slice(blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .MatchTag {
                if inst.v0 != eir.EIR_NONE {
                    let u0 = inst.v0.widen.[usize]();
                    let er = eu_reads_err.as_mut_slice();
                    if u0 < er.len { er[u0] = 2_u8; }
                }
            } else if inst.kind == .IsError {
                if inst.v0 != eir.EIR_NONE {
                    let u0 = inst.v0.widen.[usize]();
                    let er = eu_reads_err.as_mut_slice();
                    if u0 < er.len && er[u0] < 2_u8 { er[u0] = er[u0] +% 1_u8; }
                }
            } else if inst.kind != .UnwrapErrorOk && inst.kind != .UnwrapErrorErr {
                if inst.v0 != eir.EIR_NONE {
                    let u0 = inst.v0.widen.[usize]();
                    let ep = eu_pair_ok.as_mut_slice();
                    if u0 < ep.len { ep[u0] = 0_u8; }
                }
                if inst.v1 != eir.EIR_NONE {
                    let u1 = inst.v1.widen.[usize]();
                    let ep = eu_pair_ok.as_mut_slice();
                    if u1 < ep.len { ep[u1] = 0_u8; }
                }
                if inst.v2 != eir.EIR_NONE {
                    let u2 = inst.v2.widen.[usize]();
                    let ep = eu_pair_ok.as_mut_slice();
                    if u2 < ep.len { ep[u2] = 0_u8; }
                }
                if inst.kind == .Call {
                    if let cd = eir_prog.get_call(inst.aux0) {
                        let args = eir_prog.vals_slice(cd.args);
                        var ai: usize = 0_usize;
                        while ai < args.len {
                            let au = args[ai].widen.[usize]();
                            let ep = eu_pair_ok.as_mut_slice();
                            if au < ep.len { ep[au] = 0_u8; }
                            ai = ai +% 1_usize;
                        }
                    }
                } else if inst.kind == .BuiltinCall {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        let args = eir_prog.vals_slice(bc.args);
                        var ai: usize = 0_usize;
                        while ai < args.len {
                            let au = args[ai].widen.[usize]();
                            let ep = eu_pair_ok.as_mut_slice();
                            if au < ep.len { ep[au] = 0_u8; }
                            ai = ai +% 1_usize;
                        }
                    }
                } else if inst.kind == .Aggregate {
                    let elems = eir_prog.vals_slice(inst.range);
                    var ai: usize = 0_usize;
                    while ai < elems.len {
                        let au = elems[ai].widen.[usize]();
                        let ep = eu_pair_ok.as_mut_slice();
                        if au < ep.len { ep[au] = 0_u8; }
                        ai = ai +% 1_usize;
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        if blk.term.kind == .Return && blk.term.flag && blk.term.val != eir.EIR_NONE {
            let rv = blk.term.val.widen.[usize]();
            let ep = eu_pair_ok.as_mut_slice();
            if rv < ep.len { ep[rv] = 0_u8; }
        }
        bi = bi +% 1_usize;
    }

    // Verify strict dominance & fusibility for `SliceSub`/`ArraySub` SliceEuPair (`eu_pair_ok == 2`):
    // requires single `Branch(IsError(eu), err_bb, ok_bb)` in def_bb, all UnwrapErrorOk dominated by ok_bb,
    // and all UnwrapErrorErr/MatchTag dominated by err_bb (where tag is always constant 4 = BoundsError).
    let dbb_ro = def_bb.as_slice();
    let uc_ro0 = use_count.as_slice();
    let er_ro0 = eu_reads_err.as_slice();
    vi = 0_usize;
    while vi < val_tys.len {
        let ep_chk = eu_pair_ok.as_slice();
        if vi < ep_chk.len && ep_chk[vi] == 2_u8 {
            var slice_eu_valid = false;
            let euv = vi.trunc.[u32]();
            if vi < dbb_ro.len && vi < dgs_ro.len && vi < er_ro0.len && er_ro0[vi] == 1_u8 {
                let dbb = dbb_ro[vi];
                let egid = dgs_ro[vi];
                if dbb.widen.[usize]() < blks.len && egid != eir.EIR_NONE {
                    let dblk = blks[dbb.widen.[usize]()];
                    if dblk.term.kind == .Branch && dblk.term.val != eir.EIR_NONE {
                        let cond_v = dblk.term.val;
                        let cidx = cond_v.widen.[usize]();
                        if cidx < dbb_ro.len && dbb_ro[cidx] == dbb
                            && cidx < uc_ro0.len && uc_ro0[cidx] == 1_u32
                            && cidx < dgs_ro.len
                        {
                            let cgid = dgs_ro[cidx];
                            if cgid != eir.EIR_NONE && cgid > egid && cgid.widen.[usize]() < all_insts_p.len {
                                let ci0 = all_insts_p[cgid.widen.[usize]()];
                                if ci0.kind == .IsError && ci0.v0 == euv {
                                    var mid_ok = true;
                                    var chk_gid = egid +% 1_u32;
                                    let end_gid = dblk.insts.start +% dblk.insts.len;
                                    while chk_gid < end_gid && chk_gid.widen.[usize]() < all_insts_p.len {
                                        if chk_gid != cgid {
                                            let ki = all_insts_p[chk_gid.widen.[usize]()];
                                            let safe_mid = ki.kind == .Const || ki.kind == .Copy
                                                || ki.kind == .Binary || ki.kind == .Unary
                                                || ki.kind == .Cast || ki.kind == .FieldExtract
                                                || ki.kind == .SlotAddr || ki.kind == .LoadSlot;
                                            if !safe_mid || ki.v0 == euv || ki.v1 == euv || ki.v2 == euv {
                                                mid_ok = false;
                                                break;
                                            }
                                        }
                                        chk_gid = chk_gid +% 1_u32;
                                    }
                                    if mid_ok {
                                        let err_bb = dblk.term.bb0;
                                        let ok_bb = dblk.term.bb1;
                                        var dom_ok = err_bb != ok_bb;
                                        var bchk: usize = 0_usize;
                                        while bchk < blks.len && dom_ok {
                                            let ubb = bchk.trunc.[u32]();
                                            let b_is = eir_prog.insts_slice(blks[bchk].insts);
                                            var ik: usize = 0_usize;
                                            while ik < b_is.len {
                                                let ui = b_is[ik];
                                                if ui.v0 == euv {
                                                    if ui.kind == .UnwrapErrorOk {
                                                        if !eir_prog.dominates_block(fn_id, ok_bb, ubb) {
                                                            dom_ok = false;
                                                            break;
                                                        }
                                                    } else if ui.kind == .UnwrapErrorErr || ui.kind == .MatchTag {
                                                        if !eir_prog.dominates_block(fn_id, err_bb, ubb) {
                                                            dom_ok = false;
                                                            break;
                                                        }
                                                    } else if ui.kind == .IsError {
                                                        if ubb != dbb {
                                                            dom_ok = false;
                                                            break;
                                                        }
                                                    }
                                                }
                                                ik = ik +% 1_usize;
                                            }
                                            bchk = bchk +% 1_usize;
                                        }
                                        if dom_ok {
                                            slice_eu_valid = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if !slice_eu_valid {
                let ep_m = eu_pair_ok.as_mut_slice();
                if vi < ep_m.len { ep_m[vi] = 0_u8; }
            }
        }
        vi = vi +% 1_usize;
    }

    let at_ro = addr_taken.as_slice();
    let ep_ro = eu_pair_ok.as_slice();
    vi = 0_usize;
    while vi < val_tys.len {
        let ty = val_tys[vi];
        let lay = env.x64_layout(ty);
        let is_at = vi < at_ro.len && at_ro[vi] != 0_u8;
        let ep_tag = if vi < ep_ro.len { ep_ro[vi] } else { 0_u8 };
        let is_eu_pair = ep_tag == 1_u8;
        let is_slice_eu_pair = ep_tag == 2_u8;
        var loc = val_loc_zst();
        if lay.size == 0_usize {
            loc = val_loc_zst();
        } else if !is_at && is_scalar_gpr_ty(ty, env) {
            let vr = try mf.new_vreg(alloc, .Gpr);
            loc = IselValLoc.{ kind: .Gpr, vreg0: vr, vreg1: mach_ir.VREG_NONE, stack_off: 0_i32 };
        } else if !is_at && is_slice_eu_pair {
            let vr0 = try mf.new_vreg(alloc, .Gpr);
            let vr1 = try mf.new_vreg(alloc, .Gpr);
            loc = IselValLoc.{ kind: .SliceEuPair, vreg0: vr0, vreg1: vr1, stack_off: 0_i32 };
        } else if !is_at && (is_slice_or_str_ty(ty, env) || is_row_view_ty(ty, env) || is_opt_row_view_ty(ty, env) || is_eu_pair) {
            let vr0 = try mf.new_vreg(alloc, .Gpr);
            let vr1 = try mf.new_vreg(alloc, .Gpr);
            loc = IselValLoc.{ kind: .PairGpr, vreg0: vr0, vreg1: vr1, stack_off: 0_i32 };
        } else if !is_at && env.get(ty).kind == .Float && env.get(ty).u8_val == 32_u8 {
            let vr = try mf.new_vreg(alloc, .Vec128);
            loc = IselValLoc.{ kind: .Float32, vreg0: vr, vreg1: mach_ir.VREG_NONE, stack_off: 0_i32 };
        } else if !is_at && env.get(ty).kind == .Float && env.get(ty).u8_val == 64_u8 {
            let vr = try mf.new_vreg(alloc, .Vec128);
            loc = IselValLoc.{ kind: .Float64, vreg0: vr, vreg1: mach_ir.VREG_NONE, stack_off: 0_i32 };
        } else if !is_at && is_vec128_ty(ty, env) {
            let vr = try mf.new_vreg(alloc, .Vec128);
            loc = IselValLoc.{ kind: .Vec128, vreg0: vr, vreg1: mach_ir.VREG_NONE, stack_off: 0_i32 };
        } else if !is_at && is_vec256_ty(ty, env) {
            let vr = try mf.new_vreg(alloc, .Vec256);
            loc = IselValLoc.{ kind: .Vec256, vreg0: vr, vreg1: mach_ir.VREG_NONE, stack_off: 0_i32 };
        } else {
            let al = if lay.align < 8_usize { 8_usize } else if lay.align > 32_usize { 32_usize } else { lay.align };
            let off = mf.alloc_stack_slot(lay.size, al);
            loc = IselValLoc.{ kind: .Stack, vreg0: mach_ir.VREG_NONE, vreg1: mach_ir.VREG_NONE, stack_off: off };
        }
        let vls = val_locs.as_mut_slice();
        if vi < vls.len {
            vls[vi] = loc;
        }
        vi = vi +% 1_usize;
    }

    // 4. Create 1 MachBlock per EIR block (preserving loop_depth from EIR!)
    bi = 0_usize;
    while bi < blks.len {
        let depth = eir_prog.block_depth(fn_id, bi.trunc.[u32]());
        let mbb = try mf.add_block(alloc, depth);
        try eir_to_mbb.push(alloc, mbb);
        bi = bi +% 1_usize;
    }
    let e2m_ro = eir_to_mbb.as_slice();
    let eidx = f.entry.widen.[usize]();
    let entry_mbb = if eidx < e2m_ro.len {
        e2m_ro[eidx]
    } else {
        0_u32
    };
    mf.entry_block = entry_mbb;

    let sret_vreg = if has_sret { try mf.new_vreg(alloc, .Gpr) } else { mach_ir.VREG_NONE };

    // Pre-allocate up to 6 hoisted pool-column VRegs BEFORE finalizing linear buffers (zero `try` after `ctx`!)
    var pre_hv: [6]mach_ir.VReg = [mach_ir.VREG_NONE; 6];
    if cfg.opt_level >= 2_u8 {
        var phi_k: usize = 0_usize;
        while phi_k < 6_usize {
            pre_hv[phi_k] = try mf.new_vreg(alloc, .Gpr);
            phi_k = phi_k +% 1_usize;
        }
    }

    eu_pair_ok.destroy(alloc);
    addr_taken.destroy(alloc);

    var ctx = IselCtx.{
        fn_id: fn_id,
        fn_sym_id: fn_sym_id,
        is_export_c: f.sig.effects.is_export_c,
        sanitize: sanitize,
        is_linux: is_linux,
        cfg: cfg,
        ret_ty: ret_ty,
        ret_class: rc,
        has_sret: has_sret,
        sret_vreg: sret_vreg,
        scratch_vec_off: 0_i32,
        call_arg6_off: 0_i32,
        call_arg7_off: 0_i32,
        cur_mbb: entry_mbb,
        cur_depth: 0_u8,
        rodata_counter: 0_u64,
        jt_counter: 0_u64,
        uses_avx2_loop: false,
        hoisted_pvals: [eir.EIR_NONE; 6],
        hoisted_offs: [0_i32; 6],
        hoisted_vregs: [mach_ir.VREG_NONE; 6],
        hoisted_cols_cnt: 0_usize,
        val_locs: val_locs,
        slot_offs: slot_offs,
        eir_to_mbb: eir_to_mbb,
        use_count: use_count,
        def_bb: def_bb,
        def_inst_gid: def_inst_gid,
        is_const_int: is_const_int,
        const_int_val: const_int_val,
        is_const_flt: is_const_flt,
        const_flt_bits: const_flt_bits,
        skip_val: skip_val,
        fused_sqrt_src: fused_sqrt_src,
        fused_bitmask_cmp: fused_bitmask_cmp,
        fused_vec_load_gid: fused_vec_load_gid,
        avx2_loops: avx2_loops,
    };

    // 5. Run DAG fusion pre-scans: fused compare-and-branch, VecSqrt4/2/8, VecContigLoad, VecBitmask(VecCmp),
    // direct ArenaPoolPush(Aggregate), StoreSlot(zero ArrayRepeat), Return(WrapOk/WrapErr),
    // and fused Branch(IsError(ArenaPoolIdAt / ArenaPoolPush / BufPush))!
    var fn_has_call = false;
    bi = 0_usize;
    while bi < blks.len {
        let blk = blks[bi];
        let bbid = bi.trunc.[u32]();
        let all_i0 = eir_prog.funcs.insts.as_slice();
        if blk.term.kind == .Return && blk.term.flag && blk.term.val != eir.EIR_NONE && rc.kind == .ErrorUnion {
            let rv = blk.term.val;
            if ctx_use_count(&ctx, rv) == 1_u32 && ctx_def_bb(&ctx, rv) == bbid {
                let rgid = ctx_def_inst_gid(&ctx, rv);
                let end_gid = blk.insts.start +% blk.insts.len;
                if rgid != eir.EIR_NONE && rgid +% 1_u32 == end_gid && rgid.widen.[usize]() < all_i0.len {
                    let ri0 = all_i0[rgid.widen.[usize]()];
                    if ri0.kind == .Cast && (ri0.cast_kind == .WrapOk || ri0.cast_kind == .WrapErr) {
                        let ridx0 = rv.widen.[usize]();
                        let sk_r = ctx.skip_val.as_mut_slice();
                        if ridx0 < sk_r.len {
                            sk_r[ridx0] = 1_u8;
                        }
                    }
                }
            }
        }
        if blk.term.kind == .Branch {
            if check_branch_fusible_cond(eir_prog, env, &ctx, bbid, blk.term.val) {
                let cidx = blk.term.val.widen.[usize]();
                let sk = ctx.skip_val.as_mut_slice();
                if cidx < sk.len {
                    sk[cidx] = 1_u8;
                }
                // Fuse `Branch(IsError(ArenaPoolIdAt / ArenaPoolPush / BufPush))` directly into the branch!
                let cgid = ctx_def_inst_gid(&ctx, blk.term.val);
                if cgid != eir.EIR_NONE && cgid.widen.[usize]() < all_i0.len {
                    let ci0 = all_i0[cgid.widen.[usize]()];
                    if ci0.kind == .IsError && ci0.v0 != eir.EIR_NONE {
                        let euv = ci0.v0;
                        let eidx0 = euv.widen.[usize]();
                        let euloc = ctx_val_loc(&ctx, euv);
                        if euloc.kind == .SliceEuPair && ctx_def_bb(&ctx, euv) == bbid {
                            let sk_s = ctx.skip_val.as_mut_slice();
                            if eidx0 < sk_s.len {
                                sk_s[eidx0] = 1_u8;
                            }
                        } else if euloc.kind == .PairGpr && ctx_def_bb(&ctx, euv) == bbid {
                            let egid = ctx_def_inst_gid(&ctx, euv);
                            if egid != eir.EIR_NONE && egid >= blk.insts.start && egid < blk.insts.start +% blk.insts.len && egid.widen.[usize]() < all_i0.len {
                                let ei0 = all_i0[egid.widen.[usize]()];
                                if ei0.kind == .BuiltinCall {
                                    if let ebc = eir_prog.get_builtin_call(ei0.aux0) {
                                        let is_id_at = ebc.op.kind == .ArenaPoolIdAt;
                                        let is_push = ebc.op.kind == .ArenaPoolPush || ebc.op.kind == .BufPush;
                                        if is_id_at || is_push {
                                            var can_fuse_eu = true;
                                            var chk_gid = egid +% 1_u32;
                                            let end_gid = blk.insts.start +% blk.insts.len;
                                            while chk_gid < end_gid && chk_gid.widen.[usize]() < all_i0.len {
                                                let ki = all_i0[chk_gid.widen.[usize]()];
                                                if chk_gid != cgid {
                                                    let is_safe_after = if is_push {
                                                        ki.kind == .Const
                                                    } else {
                                                        ki.kind == .Const || ki.kind == .Copy
                                                            || ki.kind == .Binary || ki.kind == .Unary
                                                            || ki.kind == .Cast || ki.kind == .FieldExtract
                                                            || ki.kind == .SlotAddr || ki.kind == .LoadSlot
                                                    };
                                                    if !is_safe_after || ki.v0 == euv || ki.v1 == euv || ki.v2 == euv {
                                                        can_fuse_eu = false;
                                                        break;
                                                    }
                                                }
                                                chk_gid = chk_gid +% 1_u32;
                                            }
                                            if can_fuse_eu {
                                                let sk2 = ctx.skip_val.as_mut_slice();
                                                if eidx0 < sk2.len {
                                                    sk2[eidx0] = 1_u8;
                                                }
                                            }
                                        }
                                    }
                                } else if ei0.kind == .Call {
                                    let er_ro = eu_reads_err.as_slice();
                                    if eidx0 < er_ro.len && er_ro[eidx0] <= 1_u8 {
                                        var can_fuse_call = true;
                                        var chk_gid = egid +% 1_u32;
                                        let end_gid = blk.insts.start +% blk.insts.len;
                                        while chk_gid < end_gid && chk_gid.widen.[usize]() < all_i0.len {
                                            let ki = all_i0[chk_gid.widen.[usize]()];
                                            if chk_gid != cgid {
                                                if ki.kind != .Const || ki.v0 == euv || ki.v1 == euv || ki.v2 == euv {
                                                    can_fuse_call = false;
                                                    break;
                                                }
                                            }
                                            chk_gid = chk_gid +% 1_u32;
                                        }
                                        if can_fuse_call {
                                            let sk2 = ctx.skip_val.as_mut_slice();
                                            if eidx0 < sk2.len {
                                                sk2[eidx0] = 1_u8;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        let insts = eir_prog.insts_slice(blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            let gid = blk.insts.start +% ii.trunc.[u32]();
            if inst.kind == .Call {
                fn_has_call = true;
            } else if inst.kind == .StoreSlot {
                let sv = inst.v0;
                if sv != eir.EIR_NONE && ctx_use_count(&ctx, sv) == 1_u32 && ctx_def_bb(&ctx, sv) == bbid {
                    let agid = ctx_def_inst_gid(&ctx, sv);
                    if agid != eir.EIR_NONE && agid < gid && agid.widen.[usize]() < all_i0.len {
                        let ai = all_i0[agid.widen.[usize]()];
                        if ai.kind == .Aggregate && env.x64_layout(ai.ty0).size >= 64_usize {
                            if let agg = eir_prog.get_aggregate(ai.aux0) {
                                if agg.tag == .ArrayRepeat {
                                    let aelems = eir_prog.vals_slice(ai.range);
                                    if aelems.len == 1_usize && ctx_is_const_int(&ctx, aelems[0_usize]) && ctx_const_int(&ctx, aelems[0_usize]) == 0_u64 {
                                        let sidx = sv.widen.[usize]();
                                        let sk = ctx.skip_val.as_mut_slice();
                                        if sidx < sk.len {
                                            sk[sidx] = 1_u8;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else if inst.kind == .Binary {
                detect_bitor_vec_bitmask_fusion(eir_prog, &mut ctx, bbid, &inst);
                detect_bitor_rotate_fusion(eir_prog, env, &mut ctx, bbid, &inst);
            } else if inst.kind == .Aggregate {
                detect_vec_sqrt_fusion(eir_prog, env, &mut ctx, bbid, &inst);
                detect_vec_contiguous_load(eir_prog, env, &mut ctx, bbid, gid, &inst);
            } else if inst.kind == .BuiltinCall {
                detect_vec_bitmask_cmp_fusion(eir_prog, env, &mut ctx, bbid, &inst);
                detect_vec_splat_load_fusion(eir_prog, env, &mut ctx, bbid, gid, &inst);
                // Detect `ArenaPoolPush(pool, Aggregate(fields...))` and `BufPush(buf, Aggregate(.Struct))`
                // where the Aggregate has use_count == 1 in the same block -> skip stack materialization!
                // Also skip dead `LoadSlot` args whose ONLY use is `bc.args[0]` when `arg_slots[0] != EIR_NONE`
                // on builtins that load arg 0 purely via `load_ptr_arg` (eliminates dead 24B vmovups copies!).
                if let bc = eir_prog.get_builtin_call(inst.aux0) {
                    let bargs = eir_prog.vals_slice(bc.args);
                    let baslots = eir_prog.arg_slots_slice(bc.arg_slots);
                    let uses_ptr_arg0 = bc.op.kind == .ArenaAlloc || bc.op.kind == .ArenaReset
                        || bc.op.kind == .ArenaDestroy || bc.op.kind == .ArenaUsedBytes
                        || bc.op.kind == .ArenaCapacity || bc.op.kind == .BufPush
                        || bc.op.kind == .BufPushSlice || bc.op.kind == .BufPop
                        || bc.op.kind == .BufLen || bc.op.kind == .BufCap
                        || bc.op.kind == .BufClear || bc.op.kind == .BufAsSlice
                        || bc.op.kind == .BufAt || bc.op.kind == .BufGet
                        || bc.op.kind == .BufSub || bc.op.kind == .BufDestroy
                        || bc.op.kind == .ArenaPoolPush || bc.op.kind == .ArenaPoolIdAt
                        || bc.op.kind == .ArenaPoolReset || bc.op.kind == .ArenaPoolLen
                        || bc.op.kind == .SlotPoolInsert || bc.op.kind == .SlotPoolTryInsert
                        || bc.op.kind == .SlotPoolRemove || bc.op.kind == .SlotPoolGet
                        || bc.op.kind == .SlotPoolAt || bc.op.kind == .SlotPoolLen
                        || bc.op.kind == .SlotPoolCap || bc.op.kind == .SlotPoolIsAlive
                        || bc.op.kind == .SlotPoolIdAt || bc.op.kind == .SlotPoolDestroy;
                    if uses_ptr_arg0 && bargs.len > 0_usize && get_arg_slot(baslots, 0_usize) != eir.EIR_NONE {
                        let a0v = bargs[0_usize];
                        if ctx_use_count(&ctx, a0v) == 1_u32 && ctx_def_bb(&ctx, a0v) == bbid {
                            let a0gid = ctx_def_inst_gid(&ctx, a0v);
                            let all_i0s = eir_prog.funcs.insts.as_slice();
                            if a0gid != eir.EIR_NONE && a0gid < gid && a0gid.widen.[usize]() < all_i0s.len {
                                if all_i0s[a0gid.widen.[usize]()].kind == .LoadSlot {
                                    let a0idx = a0v.widen.[usize]();
                                    let sk0 = ctx.skip_val.as_mut_slice();
                                    if a0idx < sk0.len {
                                        sk0[a0idx] = 1_u8;
                                    }
                                }
                            }
                        }
                    }
                    if bc.op.kind == .ArenaPoolPush {
                        if bargs.len > 1_usize {
                            let rv = bargs[1_usize];
                            if ctx_use_count(&ctx, rv) == 1_u32 && ctx_def_bb(&ctx, rv) == bbid {
                                let agid = ctx_def_inst_gid(&ctx, rv);
                                let all_i = eir_prog.funcs.insts.as_slice();
                                if agid != eir.EIR_NONE && agid < gid && agid.widen.[usize]() < all_i.len {
                                    let ai = all_i[agid.widen.[usize]()];
                                    if ai.kind == .Aggregate {
                                        if let agg = eir_prog.get_aggregate(ai.aux0) {
                                            if agg.tag == .Struct || agg.tag == .AnonStruct || agg.tag == .PoolRow {
                                                let ncols = pool_ncols_from_ty(env, bc.op.ty0);
                                                if eir_prog.vals_slice(ai.range).len == ncols {
                                                    let ridx = rv.widen.[usize]();
                                                    let sk = ctx.skip_val.as_mut_slice();
                                                    if ridx < sk.len {
                                                        sk[ridx] = 1_u8;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else if bc.op.kind == .BufPush && bargs.len >= 2_usize {
                        let val_arg = if bargs.len >= 3_usize { bargs[2_usize] } else { bargs[1_usize] };
                        if ctx_use_count(&ctx, val_arg) == 1_u32 && ctx_def_bb(&ctx, val_arg) == bbid {
                            let agid = ctx_def_inst_gid(&ctx, val_arg);
                            let all_i = eir_prog.funcs.insts.as_slice();
                            if agid != eir.EIR_NONE && agid < gid && agid.widen.[usize]() < all_i.len {
                                let ai = all_i[agid.widen.[usize]()];
                                if ai.kind == .Aggregate && ai.ty0 == bc.op.ty0 {
                                    if let agg = eir_prog.get_aggregate(ai.aux0) {
                                        if agg.tag == .Struct || agg.tag == .AnonStruct {
                                            let aelems = eir_prog.vals_slice(ai.range);
                                            let tot_sz = env.x64_layout(bc.op.ty0).size;
                                            var sum_fsz: usize = 0_usize;
                                            var fi: usize = 0_usize;
                                            while fi < aelems.len {
                                                let foff = env.struct_field_offset(bc.op.ty0, fi);
                                                sum_fsz = sum_fsz +% env.x64_layout(foff.ty).size;
                                                fi = fi +% 1_usize;
                                            }
                                            if sum_fsz == tot_sz && aelems.len > 0_usize {
                                                let vidx = val_arg.widen.[usize]();
                                                let sk = ctx.skip_val.as_mut_slice();
                                                if vidx < sk.len {
                                                    sk[vidx] = 1_u8;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        bi = bi +% 1_usize;
    }
    eu_reads_err.destroy(alloc);

    // 6. Hoist loop-invariant ArenaPool / immutable SlotPool parameter column base pointers
    // (plus ArenaPool `cap`, unmutated ArenaPool `len`, and immutable SlotPool `gen_arr`/`cap`)
    // in leaf functions (up to 5 hottest loop entries!).
    if !fn_has_call && cfg.opt_level >= 2_u8 && eir_prog.block_preds(fn_id, f.entry).len == 0_usize {
        let fparams = eir_prog.fn_params(fn_id);
        // Check if any ArenaPoolPush / ArenaPoolReset mutates pool len in this function
        var fn_mutates_pool_len = false;
        bi = 0_usize;
        while bi < blks.len && !fn_mutates_pool_len {
            let insts = eir_prog.insts_slice(blks[bi].insts);
            var ii: usize = 0_usize;
            while ii < insts.len {
                if insts[ii].kind == .BuiltinCall {
                    if let bc = eir_prog.get_builtin_call(insts[ii].aux0) {
                        if bc.op.kind == .ArenaPoolPush || bc.op.kind == .ArenaPoolReset {
                            fn_mutates_pool_len = true;
                            break;
                        }
                    }
                }
                ii = ii +% 1_usize;
            }
            bi = bi +% 1_usize;
        }
        var h_pvals: [16]eir.EirValue = [eir.EIR_NONE; 16];
        var h_offs: [16]i32 = [0_i32; 16];
        var h_score: [16]u32 = [0_u32; 16];
        var h_cnt: usize = 0_usize;
        bi = 0_usize;
        while bi < blks.len {
            let bbid = bi.trunc.[u32]();
            let bdep = eir_prog.block_depth(fn_id, bbid);
            if bdep > 0_u8 {
                let bwt: u32 = if bdep >= 2_u8 { 16_u32 } else { 4_u32 };
                let insts = eir_prog.insts_slice(blks[bi].insts);
                var ii: usize = 0_usize;
                while ii < insts.len {
                    let inst = insts[ii];
                    var cand_pvs: [8]eir.EirValue = [eir.EIR_NONE; 8];
                    var cand_offs: [8]i32 = [0_i32; 8];
                    var cand_is_len: [8]bool = [false; 8];
                    var cand_n: usize = 0_usize;
                    if inst.kind == .PoolColumnLoad || inst.kind == .PoolColumnStore {
                        if let op = eir_prog.get_pool_col_op(inst.aux0) {
                            if op.pool_is_ptr && op.pool_base.kind == .Val {
                                cand_pvs[0_usize] = op.pool_base.id;
                                cand_offs[0_usize] = op.col_idx.trunc.[i32]() *% 8_i32;
                                cand_n = 1_usize;
                            }
                        }
                    } else if inst.kind == .BuiltinCall {
                        if let bc = eir_prog.get_builtin_call(inst.aux0) {
                            let args = eir_prog.vals_slice(bc.args);
                            let aslots = eir_prog.arg_slots_slice(bc.arg_slots);
                            if args.len > 0_usize && get_arg_slot(aslots, 0_usize) == eir.EIR_NONE {
                                let pv0 = args[0_usize];
                                if bc.op.kind == .ArenaPoolIdAt || bc.op.kind == .ArenaPoolLen {
                                    let ncols = pool_ncols_from_arg_ty(env, eir_prog.fn_val_ty(fn_id, pv0));
                                    cand_pvs[0_usize] = pv0;
                                    cand_offs[0_usize] = (ncols *% 8_usize).trunc.[i32]();
                                    cand_is_len[0_usize] = true;
                                    cand_n = 1_usize;
                                } else if bc.op.kind == .ArenaPoolPush {
                                    let ncols = pool_ncols_from_ty(env, bc.op.ty0);
                                    // Score cap_off (invariant) + column pointers 0..min(ncols, 7)
                                    cand_pvs[0_usize] = pv0;
                                    cand_offs[0_usize] = ((ncols +% 1_usize) *% 8_usize).trunc.[i32]();
                                    cand_n = 1_usize;
                                    var ci: usize = 0_usize;
                                    while ci < ncols && cand_n < 8_usize {
                                        cand_pvs[cand_n] = pv0;
                                        cand_offs[cand_n] = (ci *% 8_usize).trunc.[i32]();
                                        cand_n = cand_n +% 1_usize;
                                        ci = ci +% 1_usize;
                                    }
                                } else if bc.op.kind == .SlotPoolGet || bc.op.kind == .SlotPoolAt {
                                    let ncols = pool_ncols_from_ty(env, bc.op.ty0);
                                    cand_pvs[0_usize] = pv0;
                                    cand_offs[0_usize] = (ncols *% 8_usize).trunc.[i32](); // gen_arr
                                    cand_pvs[1_usize] = pv0;
                                    cand_offs[1_usize] = ((ncols +% 3_usize) *% 8_usize).trunc.[i32](); // cap
                                    cand_n = 2_usize;
                                }
                            }
                        }
                    }
                    var ci_k: usize = 0_usize;
                    while ci_k < cand_n && ci_k < 8_usize {
                        let cand_pv = cand_pvs[ci_k];
                        let cand_off = cand_offs[ci_k];
                        let is_len_off = cand_is_len[ci_k];
                        if cand_pv != eir.EIR_NONE && ctx_val_loc(&ctx, cand_pv).kind == .Gpr {
                            var is_pool_param = false;
                            var pi: usize = 0_usize;
                            while pi < fparams.len {
                                if fparams[pi] == cand_pv {
                                    let pty = eir_prog.fn_val_ty(fn_id, cand_pv);
                                    let pn = env.get(pty);
                                    if pn.kind == .Borrow && pn.borrow_kind == .Single {
                                        let inn = env.get(pn.primary);
                                        if inn.kind == .Builtin {
                                            if inn.builtin_kind == .ArenaPool {
                                                if !is_len_off || !pn.flag0 || !fn_mutates_pool_len {
                                                    is_pool_param = true;
                                                }
                                            } else if inn.builtin_kind == .SlotPool && !pn.flag0 && !is_len_off {
                                                is_pool_param = true;
                                            }
                                        }
                                    }
                                    break;
                                }
                                pi = pi +% 1_usize;
                            }
                            if is_pool_param {
                                var found_hi: usize = 99_usize;
                                var hi: usize = 0_usize;
                                while hi < h_cnt && hi < 16_usize {
                                    if h_pvals[hi] == cand_pv && h_offs[hi] == cand_off {
                                        found_hi = hi;
                                        break;
                                    }
                                    hi = hi +% 1_usize;
                                }
                                if found_hi < 16_usize {
                                    h_score[found_hi] = h_score[found_hi] +% bwt;
                                } else if h_cnt < 16_usize {
                                    h_pvals[h_cnt] = cand_pv;
                                    h_offs[h_cnt] = cand_off;
                                    h_score[h_cnt] = bwt;
                                    h_cnt = h_cnt +% 1_usize;
                                }
                            }
                        }
                        ci_k = ci_k +% 1_usize;
                    }
                    ii = ii +% 1_usize;
                }
            }
            bi = bi +% 1_usize;
        }
        if h_cnt > 0_usize {
            // Double-check no whole-struct StorePlace (projs.len == 0) overwrites any hoisted pool param
            var safe_hoist = true;
            bi = 0_usize;
            while bi < blks.len && safe_hoist {
                let insts = eir_prog.insts_slice(blks[bi].insts);
                var ii: usize = 0_usize;
                while ii < insts.len {
                    if insts[ii].kind == .StorePlace {
                        if let pl = eir_prog.get_place(insts[ii].aux0) {
                            if pl.base.kind == .Val && pl.projs.len == 0_u32 {
                                var hi: usize = 0_usize;
                                while hi < h_cnt && hi < 16_usize {
                                    if pl.base.id == h_pvals[hi] {
                                        safe_hoist = false;
                                        break;
                                    }
                                    hi = hi +% 1_usize;
                                }
                            }
                        }
                    }
                    ii = ii +% 1_usize;
                }
                bi = bi +% 1_usize;
            }
            if safe_hoist {
                // Pick top <= 4 entries by loop-weighted score (leaves 8 GPRs for loop state!)
                var used_pick: [16]bool = [false; 16];
                var picked: usize = 0_usize;
                let max_pick = if h_cnt < 4_usize { h_cnt } else { 4_usize };
                while picked < max_pick {
                    var best_i: usize = 99_usize;
                    var best_s: u32 = 0_u32;
                    var ci: usize = 0_usize;
                    while ci < h_cnt && ci < 16_usize {
                        if !used_pick[ci] && h_score[ci] > best_s {
                            best_s = h_score[ci];
                            best_i = ci;
                        }
                        ci = ci +% 1_usize;
                    }
                    if best_i >= 16_usize {
                        break;
                    }
                    used_pick[best_i] = true;
                    ctx.hoisted_pvals[picked] = h_pvals[best_i];
                    ctx.hoisted_offs[picked] = h_offs[best_i];
                    ctx.hoisted_vregs[picked] = pre_hv[picked];
                    picked = picked +% 1_usize;
                }
                ctx.hoisted_cols_cnt = picked;
            }
        }
    }

    return ctx;
}

// ===========================================================================
// Section 3: Low-Level MachIR Emission Helpers
// ===========================================================================

fn find_hoisted_pool_col(ctx: *IselCtx, pool_val: eir.EirValue, col_off: i32) -> mach_ir.VReg {
    if ctx.cur_depth == 0_u8 {
        return mach_ir.VREG_NONE;
    }
    var i: usize = 0_usize;
    while i < ctx.hoisted_cols_cnt && i < 6_usize {
        if ctx.hoisted_pvals[i] == pool_val && ctx.hoisted_offs[i] == col_off {
            return ctx.hoisted_vregs[i];
        }
        i = i +% 1_usize;
    }
    return mach_ir.VREG_NONE;
}

fn ensure_scratch_vec_off(ctx: *mut IselCtx, mf: *mut mach_ir.MachFunc) -> i32 {
    if ctx.scratch_vec_off == 0_i32 {
        ctx.scratch_vec_off = mf.alloc_stack_slot(32_usize, 32_usize);
    }
    return ctx.scratch_vec_off;
}

fn ensure_call_arg6_off(ctx: *mut IselCtx, mf: *mut mach_ir.MachFunc) -> i32 {
    if ctx.call_arg6_off == 0_i32 {
        ctx.call_arg6_off = mf.alloc_stack_slot(8_usize, 8_usize);
    }
    return ctx.call_arg6_off;
}

fn ensure_call_arg7_off(ctx: *mut IselCtx, mf: *mut mach_ir.MachFunc) -> i32 {
    if ctx.call_arg7_off == 0_i32 {
        ctx.call_arg7_off = mf.alloc_stack_slot(8_usize, 8_usize);
    }
    return ctx.call_arg7_off;
}

fn emit_mov_imm(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    dst: mach_ir.VReg,
    val: u64,
    sp: span.Span,
) -> !OutOfMemory {
    try mf.emit_inst(alloc, mach_ir.inst_mov_imm(dst, val.bitcast.[i64](), sp));
    return;
}

fn emit_imm_vreg(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    val: u64,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    let v = try mf.new_vreg(alloc, .Gpr);
    try emit_mov_imm(alloc, mf, v, val, sp);
    return v;
}

fn emit_alu_rr(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    op: mach_ir.MachOp,
    dst: mach_ir.VReg,
    lhs: mach_ir.VReg,
    rhs: mach_ir.VReg,
    sp: span.Span,
) -> !OutOfMemory {
    var m = mach_ir.inst_empty(op, sp);
    m.dst = dst;
    m.src0 = lhs;
    m.src1 = rhs;
    m.tied_src0 = true;
    try mf.emit_inst(alloc, m);
    return;
}

fn emit_alu_ri(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    op: mach_ir.MachOp,
    dst: mach_ir.VReg,
    lhs: mach_ir.VReg,
    imm: i64,
    sp: span.Span,
) -> !OutOfMemory {
    var m = mach_ir.inst_empty(op, sp);
    m.dst = dst;
    m.src0 = lhs;
    m.imm = imm;
    m.tied_src0 = op != .MulImm && op != .Mul32Imm;
    try mf.emit_inst(alloc, m);
    return;
}

fn emit_unary_r(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    op: mach_ir.MachOp,
    dst: mach_ir.VReg,
    src: mach_ir.VReg,
    sp: span.Span,
) -> !OutOfMemory {
    var m = mach_ir.inst_empty(op, sp);
    m.dst = dst;
    m.src0 = src;
    m.tied_src0 = true;
    try mf.emit_inst(alloc, m);
    return;
}

fn emit_extend(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    dst: mach_ir.VReg,
    src: mach_ir.VReg,
    size_bytes: u8,
    signed: bool,
    sp: span.Span,
) -> !OutOfMemory {
    var m = mach_ir.inst_empty(.Extend, sp);
    m.dst = dst;
    m.src0 = src;
    m.size_bytes = size_bytes;
    m.flag0 = signed;
    try mf.emit_inst(alloc, m);
    return;
}

fn emit_cmp_rr(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    lhs: mach_ir.VReg,
    rhs: mach_ir.VReg,
    sp: span.Span,
) -> !OutOfMemory {
    var m = mach_ir.inst_empty(.Cmp, sp);
    m.src0 = lhs;
    m.src1 = rhs;
    try mf.emit_inst(alloc, m);
    return;
}

fn emit_cmp_ri(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    lhs: mach_ir.VReg,
    imm: i32,
    sp: span.Span,
) -> !OutOfMemory {
    var m = mach_ir.inst_empty(.CmpImm, sp);
    m.src0 = lhs;
    m.imm = imm.widen.[i64]();
    try mf.emit_inst(alloc, m);
    return;
}

fn emit_test_rr(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    a: mach_ir.VReg,
    b: mach_ir.VReg,
    is_32: bool,
    sp: span.Span,
) -> !OutOfMemory {
    var m = mach_ir.inst_empty(if is_32 { .Test32 } else { .Test }, sp);
    m.src0 = a;
    m.src1 = b;
    try mf.emit_inst(alloc, m);
    return;
}

fn emit_setcc_zext(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    cc: x64_asm.Cond,
    dst: mach_ir.VReg,
    sp: span.Span,
) -> !OutOfMemory {
    let tmp = try mf.new_vreg(alloc, .Gpr);
    var s = mach_ir.inst_empty(.Setcc, sp);
    s.dst = tmp;
    s.cc = cc;
    s.size_bytes = 1_u8;
    try mf.emit_inst(alloc, s);
    try emit_extend(alloc, mf, dst, tmp, 1_u8, false, sp);
    return;
}

fn emit_cmov(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    cc: x64_asm.Cond,
    dst: mach_ir.VReg,
    false_v: mach_ir.VReg,
    true_v: mach_ir.VReg,
    sp: span.Span,
) -> !OutOfMemory {
    var m = mach_ir.inst_empty(.Cmov, sp);
    m.dst = dst;
    m.src0 = false_v;
    m.src1 = true_v;
    m.cc = cc;
    m.tied_src0 = true;
    try mf.emit_inst(alloc, m);
    return;
}

fn emit_load_mem(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    dst: mach_ir.VReg,
    mem: mach_ir.MemAddr,
    bytes: usize,
    signed: bool,
    sp: span.Span,
) -> !OutOfMemory {
    let sz: u8 = if bytes <= 1_usize { 1_u8 } else if bytes <= 2_usize { 2_u8 } else if bytes <= 4_usize { 4_u8 } else { 8_u8 };
    let op: mach_ir.MachOp = if signed && sz < 8_u8 { .LoadSX } else { .Load };
    var m = mach_ir.inst_empty(op, sp);
    m.dst = dst;
    m.mem = mem;
    m.size_bytes = sz;
    try mf.emit_inst(alloc, m);
    return;
}

fn emit_store_mem(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    mem: mach_ir.MemAddr,
    src: mach_ir.VReg,
    bytes: usize,
    sp: span.Span,
) -> !OutOfMemory {
    let sz: u8 = if bytes <= 1_usize { 1_u8 } else if bytes <= 2_usize { 2_u8 } else if bytes <= 4_usize { 4_u8 } else { 8_u8 };
    try mf.emit_inst(alloc, mach_ir.inst_store(mem, src, sz, sp));
    return;
}

fn emit_store_imm_mem(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    mem: mach_ir.MemAddr,
    imm: i64,
    bytes: usize,
    sp: span.Span,
) -> !OutOfMemory {
    let sz: u8 = if bytes <= 1_usize { 1_u8 } else if bytes <= 2_usize { 2_u8 } else if bytes <= 4_usize { 4_u8 } else { 8_u8 };
    if fits_i32(imm) && (sz == 4_u8 || sz == 8_u8) && mem.kind != .Sib {
        var m = mach_ir.inst_empty(.StoreImm, sp);
        m.mem = mem;
        m.imm = imm;
        m.size_bytes = sz;
        try mf.emit_inst(alloc, m);
        return;
    }
    let tmp = try emit_imm_vreg(alloc, mf, imm.bitcast.[u64](), sp);
    try mf.emit_inst(alloc, mach_ir.inst_store(mem, tmp, sz, sp));
    return;
}

struct RotMatch {
    ok: bool;
    src: eir.EirValue;
    amt: u8;
    bits: u8;
}

fn try_match_rotate_right(
    ctx: *IselCtx,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    op_ty: types.TyId,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
) -> RotMatch {
    let nope = RotMatch.{ ok: false, src: eir.EIR_NONE, amt: 0_u8, bits: 0_u8 };
    if env.is_signed_int(op_ty) || lhs == rhs {
        return nope;
    }
    let bits = env.int_bits(op_ty);
    if bits != 32_u8 && bits != 64_u8 {
        return nope;
    }
    let lgid = ctx_def_inst_gid(ctx, lhs);
    let rgid = ctx_def_inst_gid(ctx, rhs);
    let all_i = eir_prog.funcs.insts.as_slice();
    if lgid == eir.EIR_NONE || rgid == eir.EIR_NONE {
        return nope;
    }
    let lu = lgid.widen.[usize]();
    let ru = rgid.widen.[usize]();
    if lu >= all_i.len || ru >= all_i.len {
        return nope;
    }
    let li = all_i[lu];
    let ri = all_i[ru];
    if li.kind != .Binary || ri.kind != .Binary || li.ty0 != op_ty || ri.ty0 != op_ty {
        return nope;
    }
    var shr_v0 = eir.EIR_NONE;
    var shr_v1 = eir.EIR_NONE;
    var shl_v0 = eir.EIR_NONE;
    var shl_v1 = eir.EIR_NONE;
    if li.bin_op == .Shr && (ri.bin_op == .Shl || ri.bin_op == .ShlWrap) {
        shr_v0 = li.v0;
        shr_v1 = li.v1;
        shl_v0 = ri.v0;
        shl_v1 = ri.v1;
    } else if ri.bin_op == .Shr && (li.bin_op == .Shl || li.bin_op == .ShlWrap) {
        shr_v0 = ri.v0;
        shr_v1 = ri.v1;
        shl_v0 = li.v0;
        shl_v1 = li.v1;
    } else {
        return nope;
    }
    if shr_v0 == eir.EIR_NONE || shr_v0 != shl_v0 {
        return nope;
    }
    if !ctx_is_const_int(ctx, shr_v1) || !ctx_is_const_int(ctx, shl_v1) {
        return nope;
    }
    let c1 = ctx_const_int(ctx, shr_v1);
    let c2 = ctx_const_int(ctx, shl_v1);
    let bw = bits.widen.[u64]();
    if c1 == 0_u64 || c2 == 0_u64 || c1 >= bw || c2 >= bw || (c1 +% c2) != bw {
        return nope;
    }
    return RotMatch.{ ok: true, src: shr_v0, amt: c1.trunc.[u8](), bits: bits };
}

fn detect_bitor_rotate_fusion(
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ctx: *mut IselCtx,
    bbid: u32,
    inst: *eir.EirInst,
) {
    if inst.bin_op != .BitOr {
        return;
    }
    let dst_ty = eir_prog.fn_val_ty(ctx.fn_id, inst.dst);
    if dst_ty != inst.ty0 {
        return;
    }
    if ctx_def_bb(ctx, inst.v0) != bbid || ctx_def_bb(ctx, inst.v1) != bbid {
        return;
    }
    let rm = try_match_rotate_right(ctx, eir_prog, env, inst.ty0, inst.v0, inst.v1);
    if !rm.ok {
        return;
    }
    let l_one = ctx_use_count(ctx, inst.v0) == 1_u32;
    let r_one = ctx_use_count(ctx, inst.v1) == 1_u32;
    let sk = ctx.skip_val.as_mut_slice();
    if l_one {
        let li = inst.v0.widen.[usize]();
        if li < sk.len { sk[li] = 1_u8; }
    }
    if r_one {
        let ri = inst.v1.widen.[usize]();
        if ri < sk.len { sk[ri] = 1_u8; }
    }
}

fn emit_norm_subword(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    env: *types.TypeEnv,
    ty: types.TyId,
    src: mach_ir.VReg,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    let bits = env.int_bits(ty);
    if bits > 0_u8 && bits < 64_u8 {
        let dst = try mf.new_vreg(alloc, .Gpr);
        let sz = (bits / 8_u8);
        try emit_extend(alloc, mf, dst, src, if sz == 0_u8 { 1_u8 } else { sz }, env.is_signed_int(ty), sp);
        return dst;
    }
    return src;
}

/// Scales an index VReg by `elem_sz` bytes into a fresh GPR VReg (power-of-2 shift, lea *3/*5/*9, or imul).
fn emit_scale_index(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    idx: mach_ir.VReg,
    elem_sz: usize,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    if elem_sz <= 1_usize {
        return idx;
    }
    if elem_sz == 3_usize || elem_sz == 5_usize || elem_sz == 9_usize {
        let sc: u8 = (elem_sz - 1_usize).trunc.[u8]();
        let dst = try mf.new_vreg(alloc, .Gpr);
        try mf.emit_inst(alloc, mach_ir.inst_lea(dst, mach_ir.mem_sib(idx, idx, sc, 0_i32), sp));
        return dst;
    }
    let dst = try mf.new_vreg(alloc, .Gpr);
    if is_power_of_two_u64(elem_sz.widen.[u64]()) {
        let sh = log2_u64(elem_sz.widen.[u64]());
        try emit_alu_ri(alloc, mf, .ShlImm, dst, idx, sh.widen.[i64](), sp);
        return dst;
    }
    if fits_i32(elem_sz.widen.[u64]().bitcast.[i64]()) {
        try emit_alu_ri(alloc, mf, .MulImm, dst, idx, elem_sz.widen.[u64]().bitcast.[i64](), sp);
        return dst;
    }
    let c = try emit_imm_vreg(alloc, mf, elem_sz.widen.[u64](), sp);
    try emit_alu_rr(alloc, mf, .Mul, dst, idx, c, sp);
    return dst;
}

/// Copies `size` bytes from `src_base + src_disp` to `dst_base + dst_disp` (using VRegs / XMMs / rep movsb).
fn emit_copy_mem(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    dst_mem_base: mach_ir.MemAddr,
    src_mem_base: mach_ir.MemAddr,
    size: usize,
    sp: span.Span,
) -> !OutOfMemory {
    if size == 0_usize {
        return;
    }
    if size <= 128_usize {
        var off: usize = 0_usize;
        while mf.target_avx2 && off +% 16_usize <= size {
            let v = try mf.new_vreg(alloc, .Vec128);
            let sm = mem_offset(&src_mem_base, off.trunc.[i32]());
            let dm = mem_offset(&dst_mem_base, off.trunc.[i32]());
            var ld = mach_ir.inst_empty(.VMovUpsLoad, sp);
            ld.dst = v;
            ld.mem = sm;
            ld.size_bytes = 16_u8;
            try mf.emit_inst(alloc, ld);
            var st = mach_ir.inst_empty(.VMovUpsStore, sp);
            st.src0 = v;
            st.mem = dm;
            st.size_bytes = 16_u8;
            try mf.emit_inst(alloc, st);
            off = off +% 16_usize;
        }
        while off < size {
            let rem = size - off;
            let chunk: usize = if rem >= 8_usize { 8_usize } else if rem >= 4_usize { 4_usize } else if rem >= 2_usize { 2_usize } else { 1_usize };
            let t = try mf.new_vreg(alloc, .Gpr);
            let sm = mem_offset(&src_mem_base, off.trunc.[i32]());
            let dm = mem_offset(&dst_mem_base, off.trunc.[i32]());
            try emit_load_mem(alloc, mf, t, sm, chunk, false, sp);
            try emit_store_mem(alloc, mf, dm, t, chunk, sp);
            off = off +% chunk;
        }
        return;
    }
    let dptr = try mf.new_vreg(alloc, .Gpr);
    let sptr = try mf.new_vreg(alloc, .Gpr);
    let len_v = try emit_imm_vreg(alloc, mf, size.widen.[u64](), sp);
    try mf.emit_inst(alloc, mach_ir.inst_lea(dptr, dst_mem_base, sp));
    try mf.emit_inst(alloc, mach_ir.inst_lea(sptr, src_mem_base, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(dptr, mach_ir.PHYS_RDI, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(sptr, mach_ir.PHYS_RSI, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(len_v, mach_ir.PHYS_RCX, sp));
    var mc = mach_ir.inst_empty(.MemCopy, sp);
    mc.clobber_gprs = mach_ir.phys_bit(mach_ir.PHYS_RDI)
        | mach_ir.phys_bit(mach_ir.PHYS_RSI)
        | mach_ir.phys_bit(mach_ir.PHYS_RCX);
    try mf.emit_inst(alloc, mc);
    return;
}

fn emit_memzero(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    dst_mem_base: mach_ir.MemAddr,
    size: usize,
    sp: span.Span,
) -> !OutOfMemory {
    if size == 0_usize {
        return;
    }
    if size <= 128_usize {
        var off: usize = 0_usize;
        if mf.target_avx2 && size >= 16_usize {
            let z = try mf.new_vreg(alloc, .Vec128);
            let z_gpr = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            var zq = mach_ir.inst_empty(.VMovQToXmm, sp);
            zq.dst = z;
            zq.src0 = z_gpr;
            zq.size_bytes = 8_u8;
            try mf.emit_inst(alloc, zq);
            while off +% 16_usize <= size {
                let dm = mem_offset(&dst_mem_base, off.trunc.[i32]());
                var st = mach_ir.inst_empty(.VMovUpsStore, sp);
                st.src0 = z;
                st.mem = dm;
                st.size_bytes = 16_u8;
                try mf.emit_inst(alloc, st);
                off = off +% 16_usize;
            }
        }
        if off < size {
            let z_gpr = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            while off < size {
                let rem = size - off;
                let chunk: usize = if rem >= 8_usize { 8_usize } else if rem >= 4_usize { 4_usize } else if rem >= 2_usize { 2_usize } else { 1_usize };
                let dm = mem_offset(&dst_mem_base, off.trunc.[i32]());
                try emit_store_mem(alloc, mf, dm, z_gpr, chunk, sp);
                off = off +% chunk;
            }
        }
        return;
    }
    let dptr = try mf.new_vreg(alloc, .Gpr);
    let zero_v = try emit_imm_vreg(alloc, mf, 0_u64, sp);
    let len_v = try emit_imm_vreg(alloc, mf, size.widen.[u64](), sp);
    try mf.emit_inst(alloc, mach_ir.inst_lea(dptr, dst_mem_base, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(dptr, mach_ir.PHYS_RDI, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(zero_v, mach_ir.PHYS_RAX, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(len_v, mach_ir.PHYS_RCX, sp));
    var mz = mach_ir.inst_empty(.MemZero, sp);
    mz.clobber_gprs = mach_ir.phys_bit(mach_ir.PHYS_RDI)
        | mach_ir.phys_bit(mach_ir.PHYS_RAX)
        | mach_ir.phys_bit(mach_ir.PHYS_RCX);
    try mf.emit_inst(alloc, mz);
    return;
}

/// Loads EIR scalar value `v` into a GPR VReg (sign/zero-extended if `extend_val` is true).
fn load_val_gpr(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    v: eir.EirValue,
    extend_val: bool,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    let ty = eir_prog.fn_val_ty(ctx.fn_id, v);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return try emit_imm_vreg(alloc, mf, 0_u64, sp);
    }
    // Rematerialize integer/bool/char/enum constants locally (avoids spilling entry-block constants across loops!)
    if ctx_is_const_int(ctx, v) {
        var imm = ctx_const_int(ctx, v);
        let signed = env.is_signed_int(ty);
        if lay.size == 1_usize {
            imm = imm & 0xFF_u64;
            if signed && (imm & 0x80_u64) != 0_u64 {
                imm = imm | 0xFFFFFFFFFFFFFF00_u64;
            }
        } else if lay.size == 2_usize {
            imm = imm & 0xFFFF_u64;
            if signed && (imm & 0x8000_u64) != 0_u64 {
                imm = imm | 0xFFFFFFFFFFFF0000_u64;
            }
        } else if lay.size == 4_usize {
            imm = imm & 0xFFFFFFFF_u64;
            if signed && (imm & 0x80000000_u64) != 0_u64 {
                imm = imm | 0xFFFFFFFF00000000_u64;
            }
        }
        return try emit_imm_vreg(alloc, mf, imm, sp);
    }
    let loc = ctx_val_loc(ctx, v);
    match loc.kind {
        .Gpr => {
            // Every .Gpr value is canonically zero/sign-extended at definition (`store_gpr_to_val` / `load_val_from_mem`)!
            let _ = extend_val;
            return loc.vreg0;
        }
        .PairGpr => {
            return loc.vreg0;
        }
        .Float32 => {
            let dst = try mf.new_vreg(alloc, .Gpr);
            var m = mach_ir.inst_empty(.VMovDFromXmm, sp);
            m.dst = dst;
            m.src0 = loc.vreg0;
            m.size_bytes = 4_u8;
            try mf.emit_inst(alloc, m);
            return dst;
        }
        .Float64 => {
            let dst = try mf.new_vreg(alloc, .Gpr);
            var m = mach_ir.inst_empty(.VMovQFromXmm, sp);
            m.dst = dst;
            m.src0 = loc.vreg0;
            m.size_bytes = 8_u8;
            try mf.emit_inst(alloc, m);
            return dst;
        }
        .Stack => {
            let dst = try mf.new_vreg(alloc, .Gpr);
            let bytes = if lay.size <= 8_usize { lay.size } else { 8_usize };
            let signed = extend_val && env.is_signed_int(ty);
            try emit_load_mem(alloc, mf, dst, mach_ir.mem_stack_slot(loc.stack_off), bytes, signed, sp);
            return dst;
        }
        _ => {
            return try emit_imm_vreg(alloc, mf, 0_u64, sp);
        }
    }
}

fn store_gpr_to_val(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    src: mach_ir.VReg,
    sp: span.Span,
) -> !OutOfMemory {
    if dst == eir.EIR_NONE {
        return;
    }
    let ty = eir_prog.fn_val_ty(ctx.fn_id, dst);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return;
    }
    let loc = ctx_val_loc(ctx, dst);
    match loc.kind {
        .Gpr => {
            if lay.size < 8_usize {
                try emit_extend(alloc, mf, loc.vreg0, src, lay.size.trunc.[u8](), env.is_signed_int(ty), sp);
            } else {
                try mf.emit_inst(alloc, mach_ir.inst_copy(loc.vreg0, src, sp));
            }
            _ = 0_u8;
        }
        .Float32 => {
            var m = mach_ir.inst_empty(.VMovDToXmm, sp);
            m.dst = loc.vreg0;
            m.src0 = src;
            m.size_bytes = 4_u8;
            try mf.emit_inst(alloc, m);
        }
        .Float64 => {
            var m = mach_ir.inst_empty(.VMovQToXmm, sp);
            m.dst = loc.vreg0;
            m.src0 = src;
            m.size_bytes = 8_u8;
            try mf.emit_inst(alloc, m);
        }
        .Stack => {
            let bytes = if lay.size <= 8_usize { lay.size } else { 8_usize };
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), src, bytes, sp);
        }
        _ => {}
    }
    return;
}

fn load_val_float(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    v: eir.EirValue,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    let loc = ctx_val_loc(ctx, v);
    if loc.kind == .Float32 || loc.kind == .Float64 {
        return loc.vreg0;
    }
    let ty = eir_prog.fn_val_ty(ctx.fn_id, v);
    let is_f64 = env.get(ty).u8_val == 64_u8;
    let dst = try mf.new_vreg(alloc, .Vec128);
    if loc.kind == .Stack {
        var m = mach_ir.inst_empty(if is_f64 { .VMovSDLoad } else { .VMovSSLoad }, sp);
        m.dst = dst;
        m.mem = mach_ir.mem_stack_slot(loc.stack_off);
        m.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
        try mf.emit_inst(alloc, m);
        return dst;
    }
    if loc.kind == .Gpr {
        var m = mach_ir.inst_empty(if is_f64 { .VMovQToXmm } else { .VMovDToXmm }, sp);
        m.dst = dst;
        m.src0 = loc.vreg0;
        m.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
        try mf.emit_inst(alloc, m);
        return dst;
    }
    let z = try emit_imm_vreg(alloc, mf, 0_u64, sp);
    var m = mach_ir.inst_empty(.VMovQToXmm, sp);
    m.dst = dst;
    m.src0 = z;
    m.size_bytes = 8_u8;
    try mf.emit_inst(alloc, m);
    return dst;
}

fn store_float_to_val(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    src: mach_ir.VReg,
    sp: span.Span,
) -> !OutOfMemory {
    if dst == eir.EIR_NONE {
        return;
    }
    let loc = ctx_val_loc(ctx, dst);
    if loc.kind == .Float32 || loc.kind == .Float64 {
        try mf.emit_inst(alloc, mach_ir.inst_copy(loc.vreg0, src, sp));
        return;
    }
    let ty = eir_prog.fn_val_ty(ctx.fn_id, dst);
    let is_f64 = env.get(ty).u8_val == 64_u8;
    if loc.kind == .Stack {
        var m = mach_ir.inst_empty(if is_f64 { .VMovSDStore } else { .VMovSSStore }, sp);
        m.src0 = src;
        m.mem = mach_ir.mem_stack_slot(loc.stack_off);
        m.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
        try mf.emit_inst(alloc, m);
    }
    return;
}

fn load_val_vec(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    v: eir.EirValue,
    l256: bool,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    let loc = ctx_val_loc(ctx, v);
    if (loc.kind == .Vec128 && !l256) || (loc.kind == .Vec256 && l256) {
        return loc.vreg0;
    }
    let dst = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
    if loc.kind == .Stack {
        var m = mach_ir.inst_empty(.VMovUpsLoad, sp);
        m.dst = dst;
        m.mem = mach_ir.mem_stack_slot(loc.stack_off);
        m.flag0 = l256;
        m.size_bytes = if l256 { 32_u8 } else { 16_u8 };
        try mf.emit_inst(alloc, m);
    }
    return dst;
}

fn store_vec_to_val(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    dst: eir.EirValue,
    src: mach_ir.VReg,
    l256: bool,
    sp: span.Span,
) -> !OutOfMemory {
    if dst == eir.EIR_NONE {
        return;
    }
    let loc = ctx_val_loc(ctx, dst);
    if (loc.kind == .Vec128 && !l256) || (loc.kind == .Vec256 && l256) {
        try mf.emit_inst(alloc, mach_ir.inst_copy(loc.vreg0, src, sp));
        return;
    }
    if loc.kind == .Stack {
        var m = mach_ir.inst_empty(.VMovUpsStore, sp);
        m.src0 = src;
        m.mem = mach_ir.mem_stack_slot(loc.stack_off);
        m.flag0 = l256;
        m.size_bytes = if l256 { 32_u8 } else { 16_u8 };
        try mf.emit_inst(alloc, m);
    }
    return;
}

struct VRegPair {
    lo: mach_ir.VReg;
    hi: mach_ir.VReg;
}

fn load_slice_pair(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    v: eir.EirValue,
    sp: span.Span,
) -> VRegPair ! OutOfMemory {
    let loc = ctx_val_loc(ctx, v);
    if loc.kind == .PairGpr {
        return VRegPair.{ lo: loc.vreg0, hi: loc.vreg1 };
    }
    let lo = try mf.new_vreg(alloc, .Gpr);
    let hi = try mf.new_vreg(alloc, .Gpr);
    if loc.kind == .Stack {
        try emit_load_mem(alloc, mf, lo, mach_ir.mem_stack_slot(loc.stack_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, hi, mach_ir.mem_stack_slot(loc.stack_off +% 8_i32), 8_usize, false, sp);
    } else {
        try emit_mov_imm(alloc, mf, lo, 0_u64, sp);
        try emit_mov_imm(alloc, mf, hi, 0_u64, sp);
    }
    return VRegPair.{ lo: lo, hi: hi };
}

fn store_slice_pair(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    dst: eir.EirValue,
    lo: mach_ir.VReg,
    hi: mach_ir.VReg,
    sp: span.Span,
) -> !OutOfMemory {
    if dst == eir.EIR_NONE {
        return;
    }
    let loc = ctx_val_loc(ctx, dst);
    if loc.kind == .PairGpr {
        try mf.emit_inst(alloc, mach_ir.inst_copy(loc.vreg0, lo, sp));
        try mf.emit_inst(alloc, mach_ir.inst_copy(loc.vreg1, hi, sp));
    } else if loc.kind == .Stack {
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), lo, 8_usize, sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off +% 8_i32), hi, 8_usize, sp);
    }
    return;
}

/// Ensures value `v` is addressable on the stack (returning its `rbp`-relative displacement).
fn materialize_val_to_stack(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    v: eir.EirValue,
    sp: span.Span,
) -> i32 ! OutOfMemory {
    let loc = ctx_val_loc(ctx, v);
    if loc.kind == .Stack {
        return loc.stack_off;
    }
    let off = ensure_scratch_vec_off(ctx, mf);
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(off), v, eir_prog.fn_val_ty(ctx.fn_id, v), sp);
    return off;
}

fn load_val_from_mem(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    mem: mach_ir.MemAddr,
    ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    _ = eir_prog;
    if dst == eir.EIR_NONE {
        return;
    }
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return;
    }
    let loc = ctx_val_loc(ctx, dst);
    match loc.kind {
        .Zst => {}
        .Gpr => {
            let signed = env.is_signed_int(ty);
            try emit_load_mem(alloc, mf, loc.vreg0, mem, lay.size, signed, sp);
        }
        .PairGpr => {
            try emit_load_mem(alloc, mf, loc.vreg0, mem_clone(&mem), 8_usize, false, sp);
            let hi_sz: usize = if lay.size >= 16_usize { 8_usize } else if lay.size > 8_usize { lay.size - 8_usize } else { 4_usize };
            try emit_load_mem(alloc, mf, loc.vreg1, mem_offset(&mem, 8_i32), hi_sz, false, sp);
        }
        .SliceEuPair => {}
        .Float32 => {
            var m = mach_ir.inst_empty(.VMovSSLoad, sp);
            m.dst = loc.vreg0;
            m.mem = mem;
            m.size_bytes = 4_u8;
            try mf.emit_inst(alloc, m);
        }
        .Float64 => {
            var m = mach_ir.inst_empty(.VMovSDLoad, sp);
            m.dst = loc.vreg0;
            m.mem = mem;
            m.size_bytes = 8_u8;
            try mf.emit_inst(alloc, m);
        }
        .Vec128 => {
            var m = mach_ir.inst_empty(.VMovUpsLoad, sp);
            m.dst = loc.vreg0;
            m.mem = mem;
            m.flag0 = false;
            m.size_bytes = 16_u8;
            try mf.emit_inst(alloc, m);
        }
        .Vec256 => {
            var m = mach_ir.inst_empty(.VMovUpsLoad, sp);
            m.dst = loc.vreg0;
            m.mem = mem;
            m.flag0 = true;
            m.size_bytes = 32_u8;
            try mf.emit_inst(alloc, m);
        }
        .Stack => {
            if mem.kind == .Sib {
                let addr = try mf.new_vreg(alloc, .Gpr);
                try mf.emit_inst(alloc, mach_ir.inst_lea(addr, mem, sp));
                try emit_copy_mem(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), mach_ir.mem_base_disp(addr, 0_i32), lay.size, sp);
            } else {
                try emit_copy_mem(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), mem, lay.size, sp);
            }
            _ = 0_u8;
        }
    }
    return;
}

fn store_val_to_mem(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    mem: mach_ir.MemAddr,
    v: eir.EirValue,
    ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    _ = eir_prog;
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return;
    }
    let loc = ctx_val_loc(ctx, v);
    match loc.kind {
        .Zst => {}
        .Gpr => {
            if ctx_is_const_int(ctx, v) {
                let cval = ctx_const_int(ctx, v);
                if lay.size <= 4_usize || fits_i32(cval.bitcast.[i64]()) {
                    try emit_store_imm_mem(alloc, mf, mem, cval.bitcast.[i64](), lay.size, sp);
                } else {
                    let iv = try emit_imm_vreg(alloc, mf, cval, sp);
                    try emit_store_mem(alloc, mf, mem, iv, lay.size, sp);
                }
            } else {
                try emit_store_mem(alloc, mf, mem, loc.vreg0, lay.size, sp);
            }
            _ = 0_u8;
        }
        .PairGpr => {
            try emit_store_mem(alloc, mf, mem_clone(&mem), loc.vreg0, 8_usize, sp);
            let hi_sz: usize = if lay.size >= 16_usize { 8_usize } else if lay.size > 8_usize { lay.size - 8_usize } else { 4_usize };
            try emit_store_mem(alloc, mf, mem_offset(&mem, 8_i32), loc.vreg1, hi_sz, sp);
        }
        .SliceEuPair => {}
        .Float32 => {
            var m = mach_ir.inst_empty(.VMovSSStore, sp);
            m.src0 = loc.vreg0;
            m.mem = mem;
            m.size_bytes = 4_u8;
            try mf.emit_inst(alloc, m);
        }
        .Float64 => {
            var m = mach_ir.inst_empty(.VMovSDStore, sp);
            m.src0 = loc.vreg0;
            m.mem = mem;
            m.size_bytes = 8_u8;
            try mf.emit_inst(alloc, m);
        }
        .Vec128 => {
            var m = mach_ir.inst_empty(.VMovUpsStore, sp);
            m.src0 = loc.vreg0;
            m.mem = mem;
            m.flag0 = false;
            m.size_bytes = 16_u8;
            try mf.emit_inst(alloc, m);
        }
        .Vec256 => {
            var m = mach_ir.inst_empty(.VMovUpsStore, sp);
            m.src0 = loc.vreg0;
            m.mem = mem;
            m.flag0 = true;
            m.size_bytes = 32_u8;
            try mf.emit_inst(alloc, m);
        }
        .Stack => {
            if mem.kind == .Sib {
                let addr = try mf.new_vreg(alloc, .Gpr);
                try mf.emit_inst(alloc, mach_ir.inst_lea(addr, mem, sp));
                try emit_copy_mem(alloc, mf, mach_ir.mem_base_disp(addr, 0_i32), mach_ir.mem_stack_slot(loc.stack_off), lay.size, sp);
            } else {
                try emit_copy_mem(alloc, mf, mem, mach_ir.mem_stack_slot(loc.stack_off), lay.size, sp);
            }
            _ = 0_u8;
        }
    }
    return;
}

fn emit_copy_val_to_val(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    src: eir.EirValue,
    sp: span.Span,
) -> !OutOfMemory {
    if dst == src || dst == eir.EIR_NONE {
        return;
    }
    let ty = eir_prog.fn_val_ty(ctx.fn_id, dst);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return;
    }
    let dl = ctx_val_loc(ctx, dst);
    let sl = ctx_val_loc(ctx, src);
    if dl.kind == sl.kind {
        match dl.kind {
            .Zst => { return; }
            .Gpr => {
                try mf.emit_inst(alloc, mach_ir.inst_copy(dl.vreg0, sl.vreg0, sp));
                return;
            }
            .PairGpr => {
                try mf.emit_inst(alloc, mach_ir.inst_copy(dl.vreg0, sl.vreg0, sp));
                try mf.emit_inst(alloc, mach_ir.inst_copy(dl.vreg1, sl.vreg1, sp));
                return;
            }
            .SliceEuPair => {
                try mf.emit_inst(alloc, mach_ir.inst_copy(dl.vreg0, sl.vreg0, sp));
                try mf.emit_inst(alloc, mach_ir.inst_copy(dl.vreg1, sl.vreg1, sp));
                return;
            }
            .Float32 => {
                try mf.emit_inst(alloc, mach_ir.inst_copy(dl.vreg0, sl.vreg0, sp));
                return;
            }
            .Float64 => {
                try mf.emit_inst(alloc, mach_ir.inst_copy(dl.vreg0, sl.vreg0, sp));
                return;
            }
            .Vec128 => {
                try mf.emit_inst(alloc, mach_ir.inst_copy(dl.vreg0, sl.vreg0, sp));
                return;
            }
            .Vec256 => {
                try mf.emit_inst(alloc, mach_ir.inst_copy(dl.vreg0, sl.vreg0, sp));
                return;
            }
            .Stack => {
                try emit_copy_mem(alloc, mf, mach_ir.mem_stack_slot(dl.stack_off), mach_ir.mem_stack_slot(sl.stack_off), lay.size, sp);
                return;
            }
        }
    }
    // Cross-kind copy (e.g. Stack <-> Gpr / PairGpr / Float / Vec due to addr_taken or cast)
    if sl.kind == .Stack {
        try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_stack_slot(sl.stack_off), ty, sp);
        return;
    }
    if dl.kind == .Stack {
        try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dl.stack_off), src, ty, sp);
        return;
    }
    // Bitcast between Gpr and Float32/Float64
    let g = try load_val_gpr(alloc, ctx, mf, eir_prog, env, src, false, sp);
    try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, g, sp);
    return;
}

fn emit_opt_null(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    opt_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    if dst == eir.EIR_NONE {
        return;
    }
    let n = env.get(opt_ty);
    let loc = ctx_val_loc(ctx, dst);
    if n.kind != .Optional {
        if n.kind == .Builtin && n.builtin_kind == .IdBrand {
            let v = try emit_imm_vreg(alloc, mf, 0xFFFFFFFF_u64, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
            return;
        }
        let lay = env.x64_layout(opt_ty);
        if loc.kind == .Gpr {
            try emit_mov_imm(alloc, mf, loc.vreg0, 0_u64, sp);
        } else if loc.kind == .Stack {
            try emit_memzero(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), lay.size, sp);
        }
        return;
    }
    let inner = n.primary;
    let niche = env.opt_niche(inner);
    match niche.kind {
        .IdBrand => {
            let v = try emit_imm_vreg(alloc, mf, 0xFFFFFFFF_u64, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .GenId => {
            let v = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .Link => {
            if loc.kind == .Gpr {
                try emit_mov_imm(alloc, mf, loc.vreg0, 0_u64, sp);
            } else if loc.kind == .Stack {
                let lay = env.x64_layout(opt_ty);
                let zsz = if lay.size < 8_usize { 8_usize } else { lay.size };
                try emit_memzero(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), zsz, sp);
            }
            _ = 0_u8;
        }
        .NullPtr => {
            let v = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .FatPtrNullFirst => {
            if loc.kind == .PairGpr {
                try emit_mov_imm(alloc, mf, loc.vreg0, 0_u64, sp);
                try emit_mov_imm(alloc, mf, loc.vreg1, 0_u64, sp);
            } else if loc.kind == .Stack {
                try emit_memzero(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), 16_usize, sp);
            }
            _ = 0_u8;
        }
        .SliceMaxLen => {
            if loc.kind == .Stack {
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), 0_i64, 8_usize, sp);
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off +% 8_i32), -1_i64, 8_usize, sp);
            }
        }
        .BoolTag => {
            let v = try emit_imm_vreg(alloc, mf, 2_u64, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .ScalarSentinel => {
            let v = try emit_imm_vreg(alloc, mf, niche.sentinel, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .None => {
            let lay = env.x64_layout(opt_ty);
            if loc.kind == .Gpr {
                try emit_mov_imm(alloc, mf, loc.vreg0, 0_u64, sp);
            } else if loc.kind == .Stack {
                try emit_memzero(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), lay.size, sp);
            }
            _ = 0_u8;
        }
    }
    return;
}

fn load_ptr_arg(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    arg_val: eir.EirValue,
    arg_slot: eir.EirSlot,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    if arg_slot != eir.EIR_NONE {
        let soff = ctx_slot_off(ctx, arg_slot);
        let dst = try mf.new_vreg(alloc, .Gpr);
        if let sinfo = eir_prog.fn_slot(ctx.fn_id, arg_slot) {
            let sn = env.get(sinfo.ty);
            if sn.kind == .Borrow || sn.kind == .RawPtr {
                try emit_load_mem(alloc, mf, dst, mach_ir.mem_stack_slot(soff), 8_usize, false, sp);
                return dst;
            }
        }
        try mf.emit_inst(alloc, mach_ir.inst_lea(dst, mach_ir.mem_stack_slot(soff), sp));
        return dst;
    }
    let ty = eir_prog.fn_val_ty(ctx.fn_id, arg_val);
    let n = env.get(ty);
    if n.kind == .Borrow || n.kind == .RawPtr {
        return try load_val_gpr(alloc, ctx, mf, eir_prog, env, arg_val, false, sp);
    }
    let loc = ctx_val_loc(ctx, arg_val);
    if loc.kind == .Stack {
        let dst = try mf.new_vreg(alloc, .Gpr);
        try mf.emit_inst(alloc, mach_ir.inst_lea(dst, mach_ir.mem_stack_slot(loc.stack_off), sp));
        return dst;
    }
    return try load_val_gpr(alloc, ctx, mf, eir_prog, env, arg_val, false, sp);
}

fn emit_magic_udiv_umod(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    lhs: mach_ir.VReg,
    d: u64,
    is_mod: bool,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    if d == 1_u64 {
        if is_mod {
            return try emit_imm_vreg(alloc, mf, 0_u64, sp);
        }
        return lhs;
    }
    if is_power_of_two_u64(d) {
        if is_mod {
            let mask = d -% 1_u64;
            let dst = try mf.new_vreg(alloc, .Gpr);
            if fits_i32(mask.bitcast.[i64]()) {
                try emit_alu_ri(alloc, mf, .AndImm, dst, lhs, mask.bitcast.[i64](), sp);
            } else {
                let mv = try emit_imm_vreg(alloc, mf, mask, sp);
                try emit_alu_rr(alloc, mf, .And, dst, lhs, mv, sp);
            }
            return dst;
        }
        let sh = log2_u64(d);
        let dst = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .ShrImm, dst, lhs, sh.widen.[i64](), sp);
        return dst;
    }
    if d >= 0x8000000000000000_u64 {
        // Since 2 * d > u64::MAX, lhs / d is 1 iff lhs >= d else 0,
        // and lhs % d is lhs - d iff lhs >= d else lhs.
        let dv = try emit_imm_vreg(alloc, mf, d, sp);
        if !is_mod {
            try emit_cmp_rr(alloc, mf, lhs, dv, sp);
            let dst = try mf.new_vreg(alloc, .Gpr);
            try emit_setcc_zext(alloc, mf, .Ae, dst, sp);
            return dst;
        }
        let sub_v = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .Sub, sub_v, lhs, dv, sp);
        try emit_cmp_rr(alloc, mf, lhs, dv, sp);
        let dst = try mf.new_vreg(alloc, .Gpr);
        try emit_cmov(alloc, mf, .B, dst, sub_v, lhs, sp);
        return dst;
    }
    let mg = compute_magic_u64(d);
    let m_reg = try emit_imm_vreg(alloc, mf, mg.magic, sp);
    let lo_dead = try mf.new_vreg(alloc, .Gpr);
    let hi_t = try mf.new_vreg(alloc, .Gpr);
    var mul = mach_ir.inst_empty(.Mul128, sp);
    mul.dst = lo_dead;
    mul.dst2 = hi_t;
    mul.src0 = lhs;
    mul.src1 = m_reg;
    try mf.emit_inst(alloc, mul);

    var q = hi_t;
    if mg.add_ind {
        // q = ((lhs - hi_t) >> 1) + hi_t; q >>= (shift - 1)
        let diff = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .Sub, diff, lhs, hi_t, sp);
        let half = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .ShrImm, half, diff, 1_i64, sp);
        let sum = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .Add, sum, half, hi_t, sp);
        if mg.shift > 1_u8 {
            let q2 = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_ri(alloc, mf, .ShrImm, q2, sum, (mg.shift -% 1_u8).widen.[i64](), sp);
            q = q2;
        } else {
            q = sum;
        }
    } else if mg.shift > 0_u8 {
        let q2 = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .ShrImm, q2, hi_t, mg.shift.widen.[i64](), sp);
        q = q2;
    }
    if !is_mod {
        return q;
    }
    // rem = lhs - q * d
    let prod = try mf.new_vreg(alloc, .Gpr);
    if fits_i32(d.bitcast.[i64]()) {
        try emit_alu_ri(alloc, mf, .MulImm, prod, q, d.bitcast.[i64](), sp);
    } else {
        let dv = try emit_imm_vreg(alloc, mf, d, sp);
        try emit_alu_rr(alloc, mf, .Mul, prod, q, dv, sp);
    }
    let rem = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Sub, rem, lhs, prod, sp);
    return rem;
}

fn emit_sdiv_pow2(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    lhs: mach_ir.VReg,
    d: u64,
    non_neg: bool,
    is_mod: bool,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    let sh = log2_u64(d);
    if non_neg {
        if is_mod {
            let mask = d -% 1_u64;
            let dst = try mf.new_vreg(alloc, .Gpr);
            if fits_i32(mask.bitcast.[i64]()) {
                try emit_alu_ri(alloc, mf, .AndImm, dst, lhs, mask.bitcast.[i64](), sp);
            } else {
                let mv = try emit_imm_vreg(alloc, mf, mask, sp);
                try emit_alu_rr(alloc, mf, .And, dst, lhs, mv, sp);
            }
            return dst;
        }
        let dst = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .SarImm, dst, lhs, sh.widen.[i64](), sp);
        return dst;
    }
    // Branchless signed division by 2^sh:
    // bias = (lhs >>s 63) >>u (64 - sh); q = (lhs + bias) >>s sh
    let sgn = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .SarImm, sgn, lhs, 63_i64, sp);
    let bias = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShrImm, bias, sgn, (64_u8 -% sh).widen.[i64](), sp);
    let adj = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, adj, lhs, bias, sp);
    let q = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .SarImm, q, adj, sh.widen.[i64](), sp);
    if !is_mod {
        return q;
    }
    let mul = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, mul, q, sh.widen.[i64](), sp);
    let rem = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Sub, rem, lhs, mul, sp);
    return rem;
}

fn emit_helper_call(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    interner: *mut span.SymInterner,
    name: *str,
    sp: span.Span,
) -> !OutOfMemory {
    let sym = try interner.intern(alloc, name.as_bytes());
    try mf.add_used_helper(alloc, sym);
    try mf.emit_inst(alloc, mach_ir.inst_call_sym(
        sym,
        mach_ir.CALLER_SAVED_GPRS_MASK,
        mach_ir.CALLER_SAVED_XMMS_MASK,
        sp,
    ));
    return;
}

// ===========================================================================
// Section 4: Prologue Parameter Reception (Safe 8-GP ABI + Vec128/256)
// ===========================================================================

struct InParamPlan {
    pv: eir.EirValue;
    ty: types.TyId;
    cls: ArgClass;
    is_reg: bool;
    gp_idx: usize;
    flt_idx: usize;
    stk_off: i32;
    v0: mach_ir.VReg;
    v1: mach_ir.VReg;
}

fn emit_receive_params(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    sp: span.Span,
) -> !OutOfMemory {
    let is_c = ctx.is_export_c;
    var gp_i: usize = 0_usize;
    var flt_i: usize = 0_usize;
    var stk_off: i32 = 16_i32;

    var sret_gp: usize = 99_usize;
    if ctx.has_sret {
        sret_gp = gp_i;
        gp_i = gp_i +% 1_usize;
    }

    let params = eir_prog.fn_params(ctx.fn_id);
    var plan = try col.DynBuf.[InParamPlan].init(alloc, if params.len > 4_usize { params.len } else { 4_usize });
    errdefer plan.destroy(alloc);

    var uses_r10 = false;
    var uses_r11 = false;

    var pi: usize = 0_usize;
    while pi < params.len {
        let pv = params[pi];
        let ty = eir_prog.fn_val_ty(ctx.fn_id, pv);
        let cls = classify_arg(ty, env);
        match cls {
            .Zst => {}
            .IntReg => {
                let p = gp_arg_phys(is_c, gp_i);
                if p != mach_ir.PHYS_NONE {
                    if p == mach_ir.PHYS_R10 { uses_r10 = true; }
                    if p == mach_ir.PHYS_R11 { uses_r11 = true; }
                    let v0 = try mf.new_vreg(alloc, .Gpr);
                    try plan.push(alloc, InParamPlan.{
                        pv: pv, ty: ty, cls: cls, is_reg: true,
                        gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32,
                        v0: v0, v1: mach_ir.VREG_NONE,
                    });
                    gp_i = gp_i +% 1_usize;
                } else {
                    try plan.push(alloc, InParamPlan.{
                        pv: pv, ty: ty, cls: cls, is_reg: false,
                        gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_off,
                        v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE,
                    });
                    stk_off = stk_off +% 8_i32;
                }
                _ = 0_u8;
            }
            .TwoIntRegs => {
                let p0 = gp_arg_phys(is_c, gp_i);
                let p1 = gp_arg_phys(is_c, gp_i +% 1_usize);
                if p0 != mach_ir.PHYS_NONE && p1 != mach_ir.PHYS_NONE {
                    if p0 == mach_ir.PHYS_R10 || p1 == mach_ir.PHYS_R10 { uses_r10 = true; }
                    if p0 == mach_ir.PHYS_R11 || p1 == mach_ir.PHYS_R11 { uses_r11 = true; }
                    let v0 = try mf.new_vreg(alloc, .Gpr);
                    let v1 = try mf.new_vreg(alloc, .Gpr);
                    try plan.push(alloc, InParamPlan.{
                        pv: pv, ty: ty, cls: cls, is_reg: true,
                        gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32,
                        v0: v0, v1: v1,
                    });
                    gp_i = gp_i +% 2_usize;
                } else {
                    try plan.push(alloc, InParamPlan.{
                        pv: pv, ty: ty, cls: cls, is_reg: false,
                        gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_off,
                        v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE,
                    });
                    stk_off = stk_off +% 16_i32;
                }
                _ = 0_u8;
            }
            .FloatReg => {
                let fp = flt_arg_phys(flt_i);
                if fp != mach_ir.PHYS_NONE {
                    let v0 = try mf.new_vreg(alloc, .Vec128);
                    try plan.push(alloc, InParamPlan.{
                        pv: pv, ty: ty, cls: cls, is_reg: true,
                        gp_idx: 0_usize, flt_idx: flt_i, stk_off: 0_i32,
                        v0: v0, v1: mach_ir.VREG_NONE,
                    });
                    flt_i = flt_i +% 1_usize;
                } else {
                    try plan.push(alloc, InParamPlan.{
                        pv: pv, ty: ty, cls: cls, is_reg: false,
                        gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_off,
                        v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE,
                    });
                    stk_off = stk_off +% 8_i32;
                }
                _ = 0_u8;
            }
            .ByPtr => {
                let p = gp_arg_phys(is_c, gp_i);
                if p != mach_ir.PHYS_NONE {
                    if p == mach_ir.PHYS_R10 { uses_r10 = true; }
                    if p == mach_ir.PHYS_R11 { uses_r11 = true; }
                    let v0 = try mf.new_vreg(alloc, .Gpr);
                    try plan.push(alloc, InParamPlan.{
                        pv: pv, ty: ty, cls: cls, is_reg: true,
                        gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32,
                        v0: v0, v1: mach_ir.VREG_NONE,
                    });
                    gp_i = gp_i +% 1_usize;
                } else {
                    try plan.push(alloc, InParamPlan.{
                        pv: pv, ty: ty, cls: cls, is_reg: false,
                        gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_off,
                        v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE,
                    });
                    stk_off = stk_off +% 8_i32;
                }
                _ = 0_u8;
            }
        }
        pi = pi +% 1_usize;
    }

    // Step 1: Save incoming R10/R11 (EonCall GP args 6 & 7) BEFORE DefFixed so regalloc scratch never clobbers them!
    var in_r10_off: i32 = 0_i32;
    var in_r11_off: i32 = 0_i32;
    if uses_r10 {
        in_r10_off = mf.alloc_stack_slot(8_usize, 8_usize);
        try mf.emit_inst(alloc, mach_ir.inst_store_phys(mach_ir.mem_stack_slot(in_r10_off), mach_ir.PHYS_R10, 8_u8, sp));
    }
    if uses_r11 {
        in_r11_off = mf.alloc_stack_slot(8_usize, 8_usize);
        try mf.emit_inst(alloc, mach_ir.inst_store_phys(mach_ir.mem_stack_slot(in_r11_off), mach_ir.PHYS_R11, 8_u8, sp));
    }

    // Step 2: Contiguous DefFixed run for Rdi..R9 and Xmm0..Xmm7 (handled in parallel by regalloc!)
    if ctx.has_sret && sret_gp < 6_usize {
        let p = gp_arg_phys(is_c, sret_gp);
        mf.set_vreg_hint_phys(ctx.sret_vreg, p);
        try mf.emit_inst(alloc, mach_ir.inst_def_fixed(ctx.sret_vreg, p, sp));
    }
    let ps = plan.as_slice();
    pi = 0_usize;
    while pi < ps.len {
        let it = ps[pi];
        if it.is_reg {
            if it.cls == .IntReg || it.cls == .ByPtr {
                let p = gp_arg_phys(is_c, it.gp_idx);
                if p != mach_ir.PHYS_R10 && p != mach_ir.PHYS_R11 && p != mach_ir.PHYS_NONE {
                    mf.set_vreg_hint_phys(it.v0, p);
                    try mf.emit_inst(alloc, mach_ir.inst_def_fixed(it.v0, p, sp));
                }
            } else if it.cls == .TwoIntRegs {
                let p0 = gp_arg_phys(is_c, it.gp_idx);
                let p1 = gp_arg_phys(is_c, it.gp_idx +% 1_usize);
                if p0 != mach_ir.PHYS_R10 && p0 != mach_ir.PHYS_R11 && p0 != mach_ir.PHYS_NONE {
                    mf.set_vreg_hint_phys(it.v0, p0);
                    try mf.emit_inst(alloc, mach_ir.inst_def_fixed(it.v0, p0, sp));
                }
                if p1 != mach_ir.PHYS_R10 && p1 != mach_ir.PHYS_R11 && p1 != mach_ir.PHYS_NONE {
                    mf.set_vreg_hint_phys(it.v1, p1);
                    try mf.emit_inst(alloc, mach_ir.inst_def_fixed(it.v1, p1, sp));
                }
            } else if it.cls == .FloatReg {
                let fp = flt_arg_phys(it.flt_idx);
                if fp != mach_ir.PHYS_NONE {
                    mf.set_vreg_hint_phys(it.v0, fp);
                    try mf.emit_inst(alloc, mach_ir.inst_def_fixed(it.v0, fp, sp));
                }
            }
        }
        pi = pi +% 1_usize;
    }

    // Step 3: Load R10/R11 saved slots, materialize all params into their planned IselValLoc!
    pi = 0_usize;
    while pi < ps.len {
        let it = ps[pi];
        let lay = env.x64_layout(it.ty);
        let loc = ctx_val_loc(ctx, it.pv);
        if it.is_reg {
            match it.cls {
                .IntReg => {
                    let p = gp_arg_phys(is_c, it.gp_idx);
                    if p == mach_ir.PHYS_R10 {
                        try emit_load_mem(alloc, mf, it.v0, mach_ir.mem_stack_slot(in_r10_off), 8_usize, false, sp);
                    } else if p == mach_ir.PHYS_R11 {
                        try emit_load_mem(alloc, mf, it.v0, mach_ir.mem_stack_slot(in_r11_off), 8_usize, false, sp);
                    }
                    try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, it.pv, it.v0, sp);
                }
                .TwoIntRegs => {
                    let p0 = gp_arg_phys(is_c, it.gp_idx);
                    let p1 = gp_arg_phys(is_c, it.gp_idx +% 1_usize);
                    if p0 == mach_ir.PHYS_R10 {
                        try emit_load_mem(alloc, mf, it.v0, mach_ir.mem_stack_slot(in_r10_off), 8_usize, false, sp);
                    } else if p0 == mach_ir.PHYS_R11 {
                        try emit_load_mem(alloc, mf, it.v0, mach_ir.mem_stack_slot(in_r11_off), 8_usize, false, sp);
                    }
                    if p1 == mach_ir.PHYS_R10 {
                        try emit_load_mem(alloc, mf, it.v1, mach_ir.mem_stack_slot(in_r10_off), 8_usize, false, sp);
                    } else if p1 == mach_ir.PHYS_R11 {
                        try emit_load_mem(alloc, mf, it.v1, mach_ir.mem_stack_slot(in_r11_off), 8_usize, false, sp);
                    }
                    if loc.kind == .PairGpr {
                        try mf.emit_inst(alloc, mach_ir.inst_copy(loc.vreg0, it.v0, sp));
                        try mf.emit_inst(alloc, mach_ir.inst_copy(loc.vreg1, it.v1, sp));
                    } else if loc.kind == .Vec128 {
                        // Marshal 16B Vec128 from (v0, v1) GP ABI regs into XMM VReg via scratch slot
                        let sc = ensure_scratch_vec_off(ctx, mf);
                        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(sc), it.v0, 8_usize, sp);
                        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(sc +% 8_i32), it.v1, 8_usize, sp);
                        var ld = mach_ir.inst_empty(.VMovUpsLoad, sp);
                        ld.dst = loc.vreg0;
                        ld.mem = mach_ir.mem_stack_slot(sc);
                        ld.size_bytes = 16_u8;
                        try mf.emit_inst(alloc, ld);
                    } else if loc.kind == .Stack {
                        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), it.v0, 8_usize, sp);
                        if lay.size > 8_usize {
                            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off +% 8_i32), it.v1, lay.size - 8_usize, sp);
                        }
                    }
                    _ = 0_u8;
                }
                .FloatReg => {
                    try store_float_to_val(alloc, ctx, mf, eir_prog, env, it.pv, it.v0, sp);
                }
                .ByPtr => {
                    let p = gp_arg_phys(is_c, it.gp_idx);
                    if p == mach_ir.PHYS_R10 {
                        try emit_load_mem(alloc, mf, it.v0, mach_ir.mem_stack_slot(in_r10_off), 8_usize, false, sp);
                    } else if p == mach_ir.PHYS_R11 {
                        try emit_load_mem(alloc, mf, it.v0, mach_ir.mem_stack_slot(in_r11_off), 8_usize, false, sp);
                    }
                    try load_val_from_mem(alloc, ctx, mf, eir_prog, env, it.pv, mach_ir.mem_base_disp(it.v0, 0_i32), it.ty, sp);
                }
                .Zst => {}
            }
        } else {
            // Stack-passed parameter at [rbp + it.stk_off]
            match it.cls {
                .IntReg => {
                    let tmp = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, tmp, mach_ir.mem_phys_disp(mach_ir.PHYS_RBP, it.stk_off), lay.size, env.is_signed_int(it.ty), sp);
                    try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, it.pv, tmp, sp);
                }
                .TwoIntRegs => {
                    try load_val_from_mem(alloc, ctx, mf, eir_prog, env, it.pv, mach_ir.mem_phys_disp(mach_ir.PHYS_RBP, it.stk_off), it.ty, sp);
                }
                .FloatReg => {
                    try load_val_from_mem(alloc, ctx, mf, eir_prog, env, it.pv, mach_ir.mem_phys_disp(mach_ir.PHYS_RBP, it.stk_off), it.ty, sp);
                }
                .ByPtr => {
                    let ptr_v = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, ptr_v, mach_ir.mem_phys_disp(mach_ir.PHYS_RBP, it.stk_off), 8_usize, false, sp);
                    try load_val_from_mem(alloc, ctx, mf, eir_prog, env, it.pv, mach_ir.mem_base_disp(ptr_v, 0_i32), it.ty, sp);
                }
                .Zst => {}
            }
        }
        pi = pi +% 1_usize;
    }

    plan.destroy(alloc);
    return;
}

fn emit_hoisted_pool_cols(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    sp: span.Span,
) -> !OutOfMemory {
    var hi: usize = 0_usize;
    while hi < ctx.hoisted_cols_cnt && hi < 6_usize {
        let hpv = ctx.hoisted_pvals[hi];
        let hoff = ctx.hoisted_offs[hi];
        let hvr = ctx.hoisted_vregs[hi];
        let pv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, hpv, false, sp);
        try emit_load_mem(alloc, mf, hvr, mach_ir.mem_base_disp(pv, hoff), 8_usize, false, sp);
        hi = hi +% 1_usize;
    }
    return;
}

// ===========================================================================
// Section 5: Places (with SIB Folding), Bitfields & Pool Columns
// ===========================================================================

struct BitfieldAccess {
    has_bf: bool;
    base_bytes: usize;
    lo: u8;
    width: u8;
    member_ty: types.TyId;
}

fn bitfield_access_none() -> BitfieldAccess {
    return BitfieldAccess.{
        has_bf: false,
        base_bytes: 0_usize,
        lo: 0_u8,
        width: 0_u8,
        member_ty: types.TY_VOID,
    };
}

fn lookup_bitfield_member(
    env: *types.TypeEnv,
    bf_def: u32,
    field_idx: usize,
) -> BitfieldAccess {
    let bm = env.get_bitfield(bf_def) orelse {
        return bitfield_access_none();
    };
    let mems = env.bitfield_members_range(bm.members);
    if field_idx >= mems.len {
        return bitfield_access_none();
    }
    let m = mems[field_idx];
    let width = m.hi -% m.lo;
    let base_bytes = (bm.base_bits.widen.[usize]() +% 7_usize) / 8_usize;
    return BitfieldAccess.{
        has_bf: true,
        base_bytes: base_bytes,
        lo: m.lo,
        width: width,
        member_ty: m.ty,
    };
}

fn place_base_ty(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    base: eir.EirPlaceBase,
) -> types.TyId {
    if base.kind == .Slot {
        if let s = eir_prog.fn_slot(fn_id, base.id) {
            return s.ty;
        }
        return types.TY_ERROR;
    }
    return eir_prog.fn_val_ty(fn_id, base.id);
}

fn split_bitfield_tail(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    place: *eir.EirPlace,
) -> BitfieldAccess {
    let projs = eir_prog.projs_slice(place.projs);
    if projs.len == 0_usize {
        return bitfield_access_none();
    }
    let last = projs[projs.len - 1_usize];
    if last.kind != .Field {
        return bitfield_access_none();
    }
    var cur_ty = place_base_ty(eir_prog, fn_id, place.base);
    var i: usize = 0_usize;
    while i +% 1_usize < projs.len && i < projs.len {
        let pr = projs[i];
        match pr.kind {
            .Deref => {
                let cn = env.get(cur_ty);
                if cn.kind == .Borrow || cn.kind == .RawPtr {
                    cur_ty = cn.primary;
                }
            }
            _ => {
                cur_ty = pr.ty;
            }
        }
        i = i +% 1_usize;
    }
    var cn = env.get(cur_ty);
    if cn.kind == .Borrow && cn.borrow_kind == .Single {
        cur_ty = cn.primary;
        cn = env.get(cur_ty);
    }
    if cn.kind == .Bitfield {
        return lookup_bitfield_member(env, cn.primary, last.index.widen.[usize]());
    }
    return bitfield_access_none();
}

struct PlaceMem {
    mem: mach_ir.MemAddr;
    ty: types.TyId;
}

/// Materializes any `MemAddr` into a single GPR base VReg (`disp = 0`).
fn materialize_mem_to_vreg(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    mem: mach_ir.MemAddr,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    if mem.kind == .BaseDisp && mem.base != mach_ir.VREG_NONE && mem.disp == 0_i32 {
        return mem.base;
    }
    let r = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(r, mem, sp));
    return r;
}

/// Computes an optimal `MemAddr` (folding struct offsets into `disp` and index scales into SIB!)
/// for the first `n_projs` projections of `place`.
fn compute_place_mem(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    place: *eir.EirPlace,
    n_projs: usize,
    sp: span.Span,
) -> PlaceMem ! OutOfMemory {
    var cur_ty = place_base_ty(eir_prog, ctx.fn_id, place.base);
    var cur_mem = mach_ir.mem_none();
    var val_is_direct_ptr = false;
    var val_is_pair_slice = false;
    var pair_v0 = mach_ir.VREG_NONE;
    var pair_v1 = mach_ir.VREG_NONE;

    if place.base.kind == .Slot {
        cur_mem = mach_ir.mem_stack_slot(ctx_slot_off(ctx, place.base.id));
    } else {
        let loc = ctx_val_loc(ctx, place.base.id);
        let bn = env.get(cur_ty);
        let is_row_view = bn.kind == .Borrow && bn.borrow_kind == .Single && env.get(bn.primary).kind == .Pool;
        if (bn.kind == .Borrow && bn.borrow_kind == .Single && !is_row_view) || bn.kind == .RawPtr {
            let pv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, place.base.id, false, sp);
            cur_mem = mach_ir.mem_base_disp(pv, 0_i32);
            val_is_direct_ptr = true;
        } else if loc.kind == .PairGpr {
            cur_mem = mach_ir.mem_base_disp(loc.vreg0, 0_i32);
            val_is_pair_slice = true;
            pair_v0 = loc.vreg0;
            pair_v1 = loc.vreg1;
        } else if loc.kind == .Stack {
            cur_mem = mach_ir.mem_stack_slot(loc.stack_off);
        } else {
            let pv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, place.base.id, false, sp);
            cur_mem = mach_ir.mem_base_disp(pv, 0_i32);
            val_is_direct_ptr = true;
        }
    }

    let projs = eir_prog.projs_slice(place.projs);
    var pi: usize = 0_usize;
    while pi < n_projs && pi < projs.len {
        let pr = projs[pi];
        match pr.kind {
            .Deref => {
                let cn = env.get(cur_ty);
                let inner_ty = if cn.kind == .Borrow || cn.kind == .RawPtr { cn.primary } else { cur_ty };
                let inner_is_pool = env.get(inner_ty).kind == .Pool;
                if !inner_is_pool {
                    let already_ptr = pi == 0_usize && val_is_direct_ptr;
                    if !already_ptr {
                        let ptr_v = try mf.new_vreg(alloc, .Gpr);
                        try emit_load_mem(alloc, mf, ptr_v, mem_clone(&cur_mem), 8_usize, false, sp);
                        cur_mem = mach_ir.mem_base_disp(ptr_v, 0_i32);
                    }
                }
                cur_ty = inner_ty;
            }
            .Field => {
                let cn = env.get(cur_ty);
                let is_ptr = (cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr;
                let deref_ty = if is_ptr { cn.primary } else { cur_ty };
                if env.get(deref_ty).kind == .Pool && is_ptr {
                    // RowView { pool_ptr (+0), index (+8, u32) } — zero-stack fast path when in PairGpr!
                    var pool_ptr = mach_ir.VREG_NONE;
                    var row_idx = mach_ir.VREG_NONE;
                    if pi == 0_usize && val_is_pair_slice && pair_v0 != mach_ir.VREG_NONE {
                        pool_ptr = pair_v0;
                        row_idx = pair_v1;
                    } else {
                        let rv_base = try materialize_mem_to_vreg(alloc, mf, mem_clone(&cur_mem), sp);
                        pool_ptr = try mf.new_vreg(alloc, .Gpr);
                        row_idx = try mf.new_vreg(alloc, .Gpr);
                        try emit_load_mem(alloc, mf, pool_ptr, mach_ir.mem_base_disp(rv_base, 0_i32), 8_usize, false, sp);
                        try emit_load_mem(alloc, mf, row_idx, mach_ir.mem_base_disp(rv_base, 8_i32), 4_usize, false, sp);
                    }
                    let col_ptr = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, col_ptr, mach_ir.mem_base_disp(pool_ptr, pr.index.trunc.[i32]() *% 8_i32), 8_usize, false, sp);
                    let elem_sz_r = env.x64_layout_impl(pr.ty, true).size;
                    let elem_sz = if elem_sz_r == 0_usize { 1_usize } else { elem_sz_r };
                    if elem_sz == 1_usize || elem_sz == 2_usize || elem_sz == 4_usize || elem_sz == 8_usize {
                        cur_mem = mach_ir.mem_sib(col_ptr, row_idx, elem_sz.trunc.[u8](), 0_i32);
                    } else {
                        let off_v = try emit_scale_index(alloc, mf, row_idx, elem_sz, sp);
                        cur_mem = mach_ir.mem_sib(col_ptr, off_v, 1_u8, 0_i32);
                    }
                    _ = 0_u8;
                } else {
                    if is_ptr {
                        let already_ptr = pi == 0_usize && val_is_direct_ptr;
                        if !already_ptr {
                            let ptr_v = try mf.new_vreg(alloc, .Gpr);
                            try emit_load_mem(alloc, mf, ptr_v, mem_clone(&cur_mem), 8_usize, false, sp);
                            cur_mem = mach_ir.mem_base_disp(ptr_v, 0_i32);
                        }
                        cur_ty = deref_ty;
                    }
                    let foff = env.struct_field_offset(cur_ty, pr.index.widen.[usize]());
                    cur_mem.disp = cur_mem.disp +% foff.offset.trunc.[i32]();
                }
                cur_ty = pr.ty;
            }
            .TupleField => {
                let cn = env.get(cur_ty);
                let is_ptr = (cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr;
                if is_ptr {
                    let already_ptr = pi == 0_usize && val_is_direct_ptr;
                    if !already_ptr {
                        let ptr_v = try mf.new_vreg(alloc, .Gpr);
                        try emit_load_mem(alloc, mf, ptr_v, mem_clone(&cur_mem), 8_usize, false, sp);
                        cur_mem = mach_ir.mem_base_disp(ptr_v, 0_i32);
                    }
                    cur_ty = cn.primary;
                }
                let foff = env.struct_field_offset(cur_ty, pr.index.widen.[usize]());
                cur_mem.disp = cur_mem.disp +% foff.offset.trunc.[i32]();
                cur_ty = pr.ty;
            }
            .PoolCol => {
                let cn = env.get(cur_ty);
                if (cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr {
                    let already_ptr = pi == 0_usize && val_is_direct_ptr;
                    if !already_ptr {
                        let ptr_v = try mf.new_vreg(alloc, .Gpr);
                        try emit_load_mem(alloc, mf, ptr_v, mem_clone(&cur_mem), 8_usize, false, sp);
                        cur_mem = mach_ir.mem_base_disp(ptr_v, 0_i32);
                    }
                }
                let col_hdr_off = pr.index.trunc.[i32]() *% 8_i32;
                let col_ptr = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, col_ptr, mem_offset(&cur_mem, col_hdr_off), 8_usize, false, sp);
                if pi +% 1_usize < n_projs && pi +% 1_usize < projs.len && projs[pi +% 1_usize].kind == .Index {
                    let next_pr = projs[pi +% 1_usize];
                    var idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, next_pr.index, false, sp);
                    if pr.is_slot_pool {
                        let z = try mf.new_vreg(alloc, .Gpr);
                        try emit_extend(alloc, mf, z, idx_v, 4_u8, false, sp);
                        idx_v = z;
                    }
                    let esz_r = env.x64_layout_impl(pr.ty, pr.is_slot_pool).size;
                    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                    if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                        cur_mem = mach_ir.mem_sib(col_ptr, idx_v, esz.trunc.[u8](), 0_i32);
                    } else {
                        let off_v = try emit_scale_index(alloc, mf, idx_v, esz, sp);
                        cur_mem = mach_ir.mem_sib(col_ptr, off_v, 1_u8, 0_i32);
                    }
                    cur_ty = next_pr.ty;
                    pi = pi +% 2_usize;
                    continue;
                }
                cur_mem = mach_ir.mem_base_disp(col_ptr, 0_i32);
                cur_ty = pr.ty;
            }
            .Index => {
                let cn = env.get(cur_ty);
                let elem_ty = pr.ty;
                let elem_sz = env.x64_layout(elem_ty).size;
                var base_v = mach_ir.VREG_NONE;
                var base_is_rbp = false;
                var base_disp: i32 = 0_i32;

                if (cn.kind == .Borrow && (cn.borrow_kind == .Slice || cn.borrow_kind == .Str)) || cn.kind == .Str {
                    if pi == 0_usize && val_is_pair_slice {
                        base_v = cur_mem.base;
                    } else {
                        base_v = try mf.new_vreg(alloc, .Gpr);
                        try emit_load_mem(alloc, mf, base_v, mem_clone(&cur_mem), 8_usize, false, sp);
                    }
                    _ = 0_u8;
                } else if cn.kind == .Borrow && cn.borrow_kind == .Single {
                    if pi == 0_usize && val_is_direct_ptr {
                        base_v = cur_mem.base;
                    } else {
                        base_v = try mf.new_vreg(alloc, .Gpr);
                        try emit_load_mem(alloc, mf, base_v, mem_clone(&cur_mem), 8_usize, false, sp);
                    }
                    _ = 0_u8;
                } else {
                    // Direct array in memory (stack or inside struct)
                    if cur_mem.kind == .StackSlot {
                        base_is_rbp = true;
                        base_disp = cur_mem.disp;
                    } else if cur_mem.kind == .BaseDisp && cur_mem.base != mach_ir.VREG_NONE {
                        base_v = cur_mem.base;
                        base_disp = cur_mem.disp;
                    } else {
                        base_v = try materialize_mem_to_vreg(alloc, mf, mem_clone(&cur_mem), sp);
                    }
                    _ = 0_u8;
                }

                // Constant index folding into disp!
                if ctx_is_const_int(ctx, pr.index) {
                    let c_idx = ctx_const_int(ctx, pr.index);
                    let byte_off = c_idx *% elem_sz.widen.[u64]();
                    let total_d = base_disp.widen.[i64]() +% byte_off.bitcast.[i64]();
                    if fits_i32(total_d) {
                        cur_mem = if base_is_rbp {
                            mach_ir.mem_stack_slot(total_d.trunc.[i32]())
                        } else {
                            mach_ir.mem_base_disp(base_v, total_d.trunc.[i32]())
                        };
                        cur_ty = elem_ty;
                        pi = pi +% 1_usize;
                        continue;
                    }
                }

                // Fold 64-bit `base[i + k]` / `base[i - k]` constant offset directly into SIB disp!
                var fold_idx = pr.index;
                var fold_disp = base_disp;
                if elem_sz == 1_usize || elem_sz == 2_usize || elem_sz == 4_usize || elem_sz == 8_usize {
                    let igid = ctx_def_inst_gid(ctx, pr.index);
                    let all_ins = eir_prog.funcs.insts.as_slice();
                    if igid != eir.EIR_NONE && igid.widen.[usize]() < all_ins.len {
                        let di = all_ins[igid.widen.[usize]()];
                        if di.kind == .Binary
                            && (di.bin_op == .Add || di.bin_op == .AddWrap || di.bin_op == .Sub || di.bin_op == .SubWrap)
                            && env.x64_layout_impl(di.ty1, false).size == 8_usize
                        {
                            var b_cand = eir.EIR_NONE;
                            var k_u64: u64 = 0_u64;
                            var is_neg = false;
                            if ctx_is_const_int(ctx, di.v1) {
                                b_cand = di.v0;
                                k_u64 = ctx_const_int(ctx, di.v1);
                                is_neg = di.bin_op == .Sub || di.bin_op == .SubWrap;
                            } else if (di.bin_op == .Add || di.bin_op == .AddWrap) && ctx_is_const_int(ctx, di.v0) {
                                b_cand = di.v1;
                                k_u64 = ctx_const_int(ctx, di.v0);
                            }
                            if b_cand != eir.EIR_NONE && k_u64 <= 1048576_u64 {
                                let delta_i64 = (k_u64 *% elem_sz.widen.[u64]()).bitcast.[i64]();
                                let signed_delta = if is_neg { 0_i64 -% delta_i64 } else { delta_i64 };
                                let new_disp_i64 = base_disp.widen.[i64]() +% signed_delta;
                                if new_disp_i64 >= -1073741824_i64 && new_disp_i64 <= 1073741823_i64 {
                                    fold_idx = b_cand;
                                    fold_disp = new_disp_i64.trunc.[i32]();
                                }
                            }
                        }
                    }
                }
                let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, fold_idx, false, sp);
                if elem_sz == 0_usize {
                    cur_mem = if base_is_rbp {
                        mach_ir.mem_stack_slot(base_disp)
                    } else {
                        mach_ir.mem_base_disp(base_v, base_disp)
                    };
                } else if elem_sz == 1_usize || elem_sz == 2_usize || elem_sz == 4_usize || elem_sz == 8_usize {
                    if base_is_rbp {
                        cur_mem = mach_ir.MemAddr.{
                            kind: .Sib,
                            base: mach_ir.VREG_NONE,
                            base_phys: mach_ir.PHYS_RBP,
                            idx: idx_v,
                            idx_phys: mach_ir.PHYS_NONE,
                            scale: elem_sz.trunc.[u8](),
                            disp: fold_disp,
                            sym: span.SYM_EMPTY,
                            label: mach_ir.LABEL_NONE,
                        };
                    } else {
                        cur_mem = mach_ir.mem_sib(base_v, idx_v, elem_sz.trunc.[u8](), fold_disp);
                    }
                } else {
                    let scaled = try emit_scale_index(alloc, mf, idx_v, elem_sz, sp);
                    if base_is_rbp {
                        cur_mem = mach_ir.MemAddr.{
                            kind: .Sib,
                            base: mach_ir.VREG_NONE,
                            base_phys: mach_ir.PHYS_RBP,
                            idx: scaled,
                            idx_phys: mach_ir.PHYS_NONE,
                            scale: 1_u8,
                            disp: base_disp,
                            sym: span.SYM_EMPTY,
                            label: mach_ir.LABEL_NONE,
                        };
                    } else {
                        cur_mem = mach_ir.mem_sib(base_v, scaled, 1_u8, base_disp);
                    }
                }
                cur_ty = elem_ty;
            }
        }
        pi = pi +% 1_usize;
    }
    return PlaceMem.{ mem: cur_mem, ty: cur_ty };
}

fn emit_load_place(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    place_id: u32,
    sp: span.Span,
) -> !OutOfMemory {
    let place = eir_prog.get_place(place_id) orelse { return; };
    let bf = split_bitfield_tail(eir_prog, ctx.fn_id, env, place);
    let projs_len = place.projs.len.widen.[usize]();
    if bf.has_bf && projs_len > 0_usize {
        let pm = try compute_place_mem(alloc, ctx, mf, eir_prog, env, place, projs_len - 1_usize, sp);
        var val = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, val, pm.mem, bf.base_bytes, false, sp);
        if bf.lo > 0_u8 {
            let v2 = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_ri(alloc, mf, .ShrImm, v2, val, bf.lo.widen.[i64](), sp);
            val = v2;
        }
        if bf.width < 64_u8 {
            let mask = (1_u64 <<% bf.width.widen.[u64]()) -% 1_u64;
            let v3 = try mf.new_vreg(alloc, .Gpr);
            if fits_i32(mask.bitcast.[i64]()) {
                try emit_alu_ri(alloc, mf, .AndImm, v3, val, mask.bitcast.[i64](), sp);
            } else {
                let mv = try emit_imm_vreg(alloc, mf, mask, sp);
                try emit_alu_rr(alloc, mf, .And, v3, val, mv, sp);
            }
            val = v3;
            if env.is_signed_int(bf.member_ty) {
                let sh = 64_u8 -% bf.width;
                let v4 = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_ri(alloc, mf, .ShlImm, v4, val, sh.widen.[i64](), sp);
                let v5 = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_ri(alloc, mf, .SarImm, v5, v4, sh.widen.[i64](), sp);
                val = v5;
            }
        }
        try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, val, sp);
        return;
    }

    let projs = eir_prog.projs_slice(place.projs);
    if projs.len > 0_usize && projs[projs.len - 1_usize].kind == .PoolCol {
        let last_pr = projs[projs.len - 1_usize];
        let pm = try compute_place_mem(alloc, ctx, mf, eir_prog, env, place, projs.len - 1_usize, sp);
        let pn = env.get(pm.ty);
        var deref_ty = pm.ty;
        var pool_mem = pm.mem;
        if pn.kind == .Borrow && pn.borrow_kind == .Single {
            let base_already_ptr = projs.len == 1_usize && place.base.kind == .Val;
            if !base_already_ptr {
                let pp = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, pp, pool_mem, 8_usize, false, sp);
                pool_mem = mach_ir.mem_base_disp(pp, 0_i32);
            }
            deref_ty = pn.primary;
        }
        let dn = env.get(deref_ty);
        let ncols = if dn.kind == .Builtin { env.pool_col_count(env.node_gval_list(&dn)) } else { 0_usize };
        let len_off: i32 = if last_pr.is_slot_pool {
            ((ncols +% 2_usize) *% 8_usize).trunc.[i32]()
        } else {
            (ncols *% 8_usize).trunc.[i32]()
        };
        let col_off = last_pr.index.trunc.[i32]() *% 8_i32;
        let col_ptr = try mf.new_vreg(alloc, .Gpr);
        let len_v = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, col_ptr, mem_offset(&pool_mem, col_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, len_v, mem_offset(&pool_mem, len_off), 8_usize, false, sp);
        try store_slice_pair(alloc, ctx, mf, dst, col_ptr, len_v, sp);
        return;
    }

    let pm = try compute_place_mem(alloc, ctx, mf, eir_prog, env, place, projs_len, sp);
    let ty = eir_prog.fn_val_ty(ctx.fn_id, dst);
    try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, pm.mem, ty, sp);
    return;
}

fn emit_store_place(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    place_id: u32,
    val: eir.EirValue,
    sp: span.Span,
) -> !OutOfMemory {
    let place = eir_prog.get_place(place_id) orelse { return; };
    let bf = split_bitfield_tail(eir_prog, ctx.fn_id, env, place);
    let projs_len = place.projs.len.widen.[usize]();
    if bf.has_bf && projs_len > 0_usize {
        let pm = try compute_place_mem(alloc, ctx, mf, eir_prog, env, place, projs_len - 1_usize, sp);
        let base_ptr = try materialize_mem_to_vreg(alloc, mf, pm.mem, sp);
        let old_v = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, old_v, mach_ir.mem_base_disp(base_ptr, 0_i32), bf.base_bytes, false, sp);
        var nv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, val, false, sp);
        let mask: u64 = if bf.width >= 64_u8 {
            0xFFFFFFFFFFFFFFFF_u64
        } else {
            (1_u64 <<% bf.width.widen.[u64]()) -% 1_u64
        };
        let mv = try emit_imm_vreg(alloc, mf, mask, sp);
        let masked_nv = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .And, masked_nv, nv, mv, sp);
        nv = masked_nv;
        var clear_mask = mask;
        if bf.lo > 0_u8 {
            let shifted_nv = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_ri(alloc, mf, .ShlImm, shifted_nv, nv, bf.lo.widen.[i64](), sp);
            nv = shifted_nv;
            clear_mask = mask <<% bf.lo.widen.[u64]();
        }
        let inv_m = try emit_imm_vreg(alloc, mf, ~clear_mask, sp);
        let cleared = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .And, cleared, old_v, inv_m, sp);
        let combined = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .Or, combined, cleared, nv, sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(base_ptr, 0_i32), combined, bf.base_bytes, sp);
        return;
    }

    let pm = try compute_place_mem(alloc, ctx, mf, eir_prog, env, place, projs_len, sp);
    let ty = eir_prog.fn_val_ty(ctx.fn_id, val);
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, pm.mem, val, ty, sp);
    return;
}

fn load_pool_base_vreg(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    base: eir.EirPlaceBase,
    pool_is_ptr: bool,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    if base.kind == .Slot {
        let soff = ctx_slot_off(ctx, base.id);
        let r = try mf.new_vreg(alloc, .Gpr);
        if pool_is_ptr {
            try emit_load_mem(alloc, mf, r, mach_ir.mem_stack_slot(soff), 8_usize, false, sp);
        } else {
            try mf.emit_inst(alloc, mach_ir.inst_lea(r, mach_ir.mem_stack_slot(soff), sp));
        }
        return r;
    }
    if pool_is_ptr {
        return try load_val_gpr(alloc, ctx, mf, eir_prog, env, base.id, false, sp);
    }
    let off = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, base.id, sp);
    let r = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(r, mach_ir.mem_stack_slot(off), sp));
    return r;
}

fn emit_pool_col_addr_mem(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    op: *eir.EirPoolColOp,
    sp: span.Span,
) -> mach_ir.MemAddr ! OutOfMemory {
    let hdr_off = op.col_idx.trunc.[i32]() *% 8_i32;
    var col_ptr = mach_ir.VREG_NONE;
    if op.pool_is_ptr && op.pool_base.kind == .Val {
        col_ptr = find_hoisted_pool_col(ctx, op.pool_base.id, hdr_off);
    }
    if col_ptr == mach_ir.VREG_NONE {
        let pool_v = try load_pool_base_vreg(alloc, ctx, mf, eir_prog, env, op.pool_base, op.pool_is_ptr, sp);
        col_ptr = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, col_ptr, mach_ir.mem_base_disp(pool_v, hdr_off), 8_usize, false, sp);
    }

    let idx_raw = try load_val_gpr(alloc, ctx, mf, eir_prog, env, op.index, false, sp);
    // GenId / Link / IdBrand slot index is always in low 32 bits!
    // For 4-byte Id[pool], idx_raw is already canonically zero-extended to 64 bits.
    let idx_sz = env.x64_layout(eir_prog.fn_val_ty(ctx.fn_id, op.index)).size;
    var idx32 = idx_raw;
    if idx_sz > 4_usize {
        idx32 = try mf.new_vreg(alloc, .Gpr);
        try emit_extend(alloc, mf, idx32, idx_raw, 4_u8, false, sp);
    }

    let elem_lay = env.x64_layout_impl(op.elem_ty, op.is_slot_pool);
    let esz = elem_lay.size;
    if esz == 0_usize {
        return mach_ir.mem_base_disp(col_ptr, 0_i32);
    }
    if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
        return mach_ir.mem_sib(col_ptr, idx32, esz.trunc.[u8](), 0_i32);
    }
    let off_v = try emit_scale_index(alloc, mf, idx32, esz, sp);
    return mach_ir.mem_sib(col_ptr, off_v, 1_u8, 0_i32);
}

fn emit_pool_col_load(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op_id: u32,
    sp: span.Span,
) -> !OutOfMemory {
    let op = eir_prog.get_pool_col_op(op_id) orelse { return; };
    let mem = try emit_pool_col_addr_mem(alloc, ctx, mf, eir_prog, env, op, sp);
    if op.is_slot_pool && env.is_link_or_opt_link(op.elem_ty) {
        let v = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, v, mem, 8_usize, false, sp);
        try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        return;
    }
    try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mem, op.elem_ty, sp);
    return;
}

fn emit_pool_col_store(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    op_id: u32,
    val: eir.EirValue,
    sp: span.Span,
) -> !OutOfMemory {
    let op = eir_prog.get_pool_col_op(op_id) orelse { return; };
    let mem = try emit_pool_col_addr_mem(alloc, ctx, mf, eir_prog, env, op, sp);
    if op.is_slot_pool && env.is_link_or_opt_link(op.elem_ty) {
        let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, val, false, sp);
        try emit_store_mem(alloc, mf, mem, v, 8_usize, sp);
        return;
    }
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mem, val, op.elem_ty, sp);
    return;
}

// ===========================================================================
// Section 6: Const, Unary, Binary, Cast, Slice, Aggregate, Tag & Extract Ops
// ===========================================================================

fn intern_fn_rodata(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    interner: *mut span.SymInterner,
    bytes: *[u8],
    align: u32,
) -> u32 ! OutOfMemory {
    let idx = ctx.rodata_counter;
    ctx.rodata_counter = ctx.rodata_counter +% 1_u64;
    let sym = try intern_rodata_sym(alloc, interner, ctx.fn_sym_id, idx);
    _ = try mf.add_rodata(alloc, sym, bytes, align);
    return sym;
}

fn emit_const_inst(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    const_id: u32,
    ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    if dst == eir.EIR_NONE {
        return;
    }
    let c = eir_prog.get_const(const_id) orelse { return; };
    let lay = env.x64_layout(ty);
    match c.kind {
        .Void => {}
        .Bool => {
            let v = try emit_imm_vreg(alloc, mf, if c.bool_val { 1_u64 } else { 0_u64 }, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .Char => {
            let v = try emit_imm_vreg(alloc, mf, c.aux_u32.widen.[u64](), sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .Int => {
            let v = try emit_imm_vreg(alloc, mf, c.int_val.lo, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .Float => {
            let flt_bytes = eir_prog.bytes_slice(c.bytes);
            let fval = parse_f64_lit(flt_bytes);
            let f64_bits = fval.bitcast.[u64]();
            let n = env.get(ty);
            let is_f64 = n.kind == .Float && n.u8_val == 64_u8;
            let raw_bits: u64 = if is_f64 { f64_bits } else { f64_bits_to_f32_bits(f64_bits).widen.[u64]() };
            let loc = ctx_val_loc(ctx, dst);
            if loc.kind == .Float32 || loc.kind == .Float64 {
                let gv = try emit_imm_vreg(alloc, mf, raw_bits, sp);
                var mv = mach_ir.inst_empty(if is_f64 { .VMovQToXmm } else { .VMovDToXmm }, sp);
                mv.dst = loc.vreg0;
                mv.src0 = gv;
                mv.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
                try mf.emit_inst(alloc, mv);
            } else if loc.kind == .Stack {
                let gv = try emit_imm_vreg(alloc, mf, raw_bits, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), gv, if is_f64 { 8_usize } else { 4_usize }, sp);
            }
            _ = 0_u8;
        }
        .Str => {
            let bytes = eir_prog.bytes_slice(c.bytes);
            let ro_sym = try intern_fn_rodata(alloc, ctx, mf, interner, bytes, 1_u32);
            let ptr_v = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(ptr_v, mach_ir.mem_rip_sym(ro_sym, 0_i32), sp));
            let len_v = try emit_imm_vreg(alloc, mf, bytes.len.widen.[u64](), sp);
            try store_slice_pair(alloc, ctx, mf, dst, ptr_v, len_v, sp);
        }
        .Bytes => {
            let bytes = eir_prog.bytes_slice(c.bytes);
            let ro_sym = try intern_fn_rodata(alloc, ctx, mf, interner, bytes, 4_u32);
            let ptr_v = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(ptr_v, mach_ir.mem_rip_sym(ro_sym, 0_i32), sp));
            let len_v = try emit_imm_vreg(alloc, mf, bytes.len.widen.[u64](), sp);
            try store_slice_pair(alloc, ctx, mf, dst, ptr_v, len_v, sp);
        }
        .Null => {
            try emit_opt_null(alloc, ctx, mf, eir_prog, env, dst, ty, sp);
        }
        .EnumTag => {
            let v = try emit_imm_vreg(alloc, mf, c.int_val.lo, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .ErrorTag => {
            let v = try emit_imm_vreg(alloc, mf, c.aux_u32.widen.[u64](), sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .ConstDef => {
            if lay.size == 0_usize {
                return;
            }
            if let val_id = ct.get_const_val(c.aux_u32) {
                var enc = try col.DynBuf.[u8].init(alloc, if lay.size > 8_usize { lay.size } else { 8_usize });
                errdefer enc.destroy(alloc);
                let ok = try ctvm.encode_ct_val_bytes(alloc, ct, val_id, ty, env, &mut enc);
                if ok && enc.len() > 0_usize {
                    let al = if lay.align == 0_usize { 1_usize } else { lay.align };
                    let ro_sym = try intern_fn_rodata(alloc, ctx, mf, interner, enc.as_slice(), al.trunc.[u32]());
                    let base_v = try mf.new_vreg(alloc, .Gpr);
                    try mf.emit_inst(alloc, mach_ir.inst_lea(base_v, mach_ir.mem_rip_sym(ro_sym, 0_i32), sp));
                    try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_base_disp(base_v, 0_i32), ty, sp);
                    enc.destroy(alloc);
                    return;
                }
                enc.destroy(alloc);
            }
            if let cm = env.get_const(c.aux_u32) {
                if cm.has_int_val {
                    let v = try emit_imm_vreg(alloc, mf, cm.int_val.lo, sp);
                    try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
                    return;
                }
            }
            let loc = ctx_val_loc(ctx, dst);
            if loc.kind == .Gpr {
                try emit_mov_imm(alloc, mf, loc.vreg0, 0_u64, sp);
            } else if loc.kind == .Stack {
                try emit_memzero(alloc, mf, mach_ir.mem_stack_slot(loc.stack_off), lay.size, sp);
            }
            _ = 0_u8;
        }
        .FnRef => {}
    }
    return;
}

fn emit_unary_inst(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: ast.UnaryOp,
    operand: eir.EirValue,
    ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let n = env.get(ty);
    if n.kind == .Float && op == .Neg {
        let is_f64 = n.u8_val == 64_u8;
        let sv = try load_val_float(alloc, ctx, mf, eir_prog, env, operand, sp);
        let sign_bits: u64 = if is_f64 { 0x8000000000000000_u64 } else { 0x80000000_u64 };
        let sg = try emit_imm_vreg(alloc, mf, sign_bits, sp);
        let sm = try mf.new_vreg(alloc, .Vec128);
        var to_x = mach_ir.inst_empty(if is_f64 { .VMovQToXmm } else { .VMovDToXmm }, sp);
        to_x.dst = sm;
        to_x.src0 = sg;
        to_x.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
        try mf.emit_inst(alloc, to_x);
        let res = try mf.new_vreg(alloc, .Vec128);
        var xr = mach_ir.inst_empty(if is_f64 { .VXorPD } else { .VXorPS }, sp);
        xr.dst = res;
        xr.src0 = sv;
        xr.src1 = sm;
        xr.size_bytes = 16_u8;
        try mf.emit_inst(alloc, xr);
        try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        return;
    }

    if n.kind == .Vec && op == .Neg {
        let elem_ty = n.primary;
        let lanes = n.u8_val.widen.[usize]();
        let en = env.get(elem_ty);
        let lay_sz = env.x64_layout(ty).size;
        if en.kind == .Float && (lay_sz == 16_usize || lay_sz == 32_usize) {
            let l256 = lay_sz == 32_usize;
            let is_f64 = en.u8_val == 64_u8;
            let sv = try load_val_vec(alloc, ctx, mf, operand, l256, sp);
            let sign_bits: u64 = if is_f64 { 0x8000000000000000_u64 } else { 0x80000000_u64 };
            let sg = try emit_imm_vreg(alloc, mf, sign_bits, sp);
            let sm_s = try mf.new_vreg(alloc, .Vec128);
            var to_x = mach_ir.inst_empty(if is_f64 { .VMovQToXmm } else { .VMovDToXmm }, sp);
            to_x.dst = sm_s;
            to_x.src0 = sg;
            to_x.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
            try mf.emit_inst(alloc, to_x);
            let sm = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
            var bc = mach_ir.inst_empty(if is_f64 { .VBroadcastSD } else { .VBroadcastSS }, sp);
            bc.dst = sm;
            bc.src0 = sm_s;
            bc.flag0 = l256;
            bc.size_bytes = if l256 { 32_u8 } else { 16_u8 };
            try mf.emit_inst(alloc, bc);
            let res = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
            var xr = mach_ir.inst_empty(if is_f64 { .VXorPD } else { .VXorPS }, sp);
            xr.dst = res;
            xr.src0 = sv;
            xr.src1 = sm;
            xr.flag0 = l256;
            xr.size_bytes = if l256 { 32_u8 } else { 16_u8 };
            try mf.emit_inst(alloc, xr);
            try store_vec_to_val(alloc, ctx, mf, dst, res, l256, sp);
            return;
        }
        // Fallback lane-by-lane for integer vectors
        let esz = env.x64_layout(elem_ty).size;
        let s_off = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, operand, sp);
        let d_loc = ctx_val_loc(ctx, dst);
        let d_off = if d_loc.kind == .Stack { d_loc.stack_off } else { ensure_scratch_vec_off(ctx, mf) };
        var li: usize = 0_usize;
        while li < lanes {
            let ld = (li *% esz).trunc.[i32]();
            let lv = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, lv, mach_ir.mem_stack_slot(s_off +% ld), esz, env.is_signed_int(elem_ty), sp);
            let nv = try mf.new_vreg(alloc, .Gpr);
            try emit_unary_r(alloc, mf, .Neg, nv, lv, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(d_off +% ld), nv, esz, sp);
            li = li +% 1_usize;
        }
        if d_loc.kind == .Vec128 || d_loc.kind == .Vec256 {
            try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_stack_slot(d_off), ty, sp);
        }
        return;
    }

    let sv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, operand, true, sp);
    var res = try mf.new_vreg(alloc, .Gpr);
    match op {
        .Neg => {
            try emit_unary_r(alloc, mf, .Neg, res, sv, sp);
            res = try emit_norm_subword(alloc, mf, env, ty, res, sp);
        }
        .Not => {
            let t = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_ri(alloc, mf, .XorImm, t, sv, 1_i64, sp);
            try emit_alu_ri(alloc, mf, .AndImm, res, t, 1_i64, sp);
        }
        .BitNot => {
            try emit_unary_r(alloc, mf, .Not, res, sv, sp);
            res = try emit_norm_subword(alloc, mf, env, ty, res, sp);
        }
        _ => {
            try mf.emit_inst(alloc, mach_ir.inst_copy(res, sv, sp));
        }
    }
    try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
    return;
}

fn emit_binary_float(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let is_f64 = env.get(op_ty).u8_val == 64_u8;
    let lv = try load_val_float(alloc, ctx, mf, eir_prog, env, lhs, sp);
    let rv = try load_val_float(alloc, ctx, mf, eir_prog, env, rhs, sp);
    if op == .Add || op == .Sub || op == .Mul || op == .Div {
        let mop: mach_ir.MachOp = match op {
            .Add => { if is_f64 { .VAddSD } else { .VAddSS } }
            .Sub => { if is_f64 { .VSubSD } else { .VSubSS } }
            .Mul => { if is_f64 { .VMulSD } else { .VMulSS } }
            _ => { if is_f64 { .VDivSD } else { .VDivSS } }
        };
        let res = try mf.new_vreg(alloc, .Vec128);
        var m = mach_ir.inst_empty(mop, sp);
        m.dst = res;
        m.src0 = lv;
        m.src1 = rv;
        m.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
        try mf.emit_inst(alloc, m);
        try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        return;
    }
    let ucop: mach_ir.MachOp = if is_f64 { .VUcomiSD } else { .VUcomiSS };
    let res = try mf.new_vreg(alloc, .Gpr);
    match op {
        .Eq => {
            var u = mach_ir.inst_empty(ucop, sp);
            u.src0 = lv;
            u.src1 = rv;
            try mf.emit_inst(alloc, u);
            let a = try mf.new_vreg(alloc, .Gpr);
            let b = try mf.new_vreg(alloc, .Gpr);
            var s1 = mach_ir.inst_empty(.Setcc, sp);
            s1.dst = a;
            s1.cc = .E;
            s1.size_bytes = 1_u8;
            try mf.emit_inst(alloc, s1);
            var s2 = mach_ir.inst_empty(.Setcc, sp);
            s2.dst = b;
            s2.cc = .Np;
            s2.size_bytes = 1_u8;
            try mf.emit_inst(alloc, s2);
            let c = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .And, c, a, b, sp);
            try emit_extend(alloc, mf, res, c, 1_u8, false, sp);
        }
        .NotEq => {
            var u = mach_ir.inst_empty(ucop, sp);
            u.src0 = lv;
            u.src1 = rv;
            try mf.emit_inst(alloc, u);
            let a = try mf.new_vreg(alloc, .Gpr);
            let b = try mf.new_vreg(alloc, .Gpr);
            var s1 = mach_ir.inst_empty(.Setcc, sp);
            s1.dst = a;
            s1.cc = .Ne;
            s1.size_bytes = 1_u8;
            try mf.emit_inst(alloc, s1);
            var s2 = mach_ir.inst_empty(.Setcc, sp);
            s2.dst = b;
            s2.cc = .P;
            s2.size_bytes = 1_u8;
            try mf.emit_inst(alloc, s2);
            let c = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Or, c, a, b, sp);
            try emit_extend(alloc, mf, res, c, 1_u8, false, sp);
        }
        .Lt => {
            var u = mach_ir.inst_empty(ucop, sp);
            u.src0 = rv;
            u.src1 = lv;
            try mf.emit_inst(alloc, u);
            try emit_setcc_zext(alloc, mf, .A, res, sp);
        }
        .LtEq => {
            var u = mach_ir.inst_empty(ucop, sp);
            u.src0 = rv;
            u.src1 = lv;
            try mf.emit_inst(alloc, u);
            try emit_setcc_zext(alloc, mf, .Ae, res, sp);
        }
        .Gt => {
            var u = mach_ir.inst_empty(ucop, sp);
            u.src0 = lv;
            u.src1 = rv;
            try mf.emit_inst(alloc, u);
            try emit_setcc_zext(alloc, mf, .A, res, sp);
        }
        _ => {
            var u = mach_ir.inst_empty(ucop, sp);
            u.src0 = lv;
            u.src1 = rv;
            try mf.emit_inst(alloc, u);
            try emit_setcc_zext(alloc, mf, .Ae, res, sp);
        }
    }
    try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
    return;
}

fn emit_binary_vec(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let vn = env.get(op_ty);
    let elem_ty = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem_ty);
    let esz = env.x64_layout(elem_ty).size;
    let total_sz = env.x64_layout(op_ty).size;

    // Hardware AVX/AVX2 packed vector fast path in XMM/YMM (ZERO stack round-trips!)
    if total_sz == 16_usize || total_sz == 32_usize {
        let l256 = total_sz == 32_usize;
        var mop: mach_ir.MachOp = .Nop;
        if en.kind == .Float && (en.u8_val == 32_u8 || en.u8_val == 64_u8) {
            let is_f64 = en.u8_val == 64_u8;
            match op {
                .Add => { mop = if is_f64 { .VAddPD } else { .VAddPS }; }
                .Sub => { mop = if is_f64 { .VSubPD } else { .VSubPS }; }
                .Mul => { mop = if is_f64 { .VMulPD } else { .VMulPS }; }
                .Div => { mop = if is_f64 { .VDivPD } else { .VDivPS }; }
                _ => {}
            }
        } else if en.kind == .Int {
            match op {
                .BitAnd => { mop = .VPAnd; }
                .BitOr => { mop = .VPOr; }
                .BitXor => { mop = .VPXor; }
                .Add => {
                    if esz == 1_usize { mop = .VPAddB; }
                    else if esz == 4_usize { mop = .VPAddD; }
                    else if esz == 8_usize { mop = .VPAddQ; }
                }
                .AddWrap => {
                    if esz == 1_usize { mop = .VPAddB; }
                    else if esz == 4_usize { mop = .VPAddD; }
                    else if esz == 8_usize { mop = .VPAddQ; }
                }
                .Sub => {
                    if esz == 1_usize { mop = .VPSubB; }
                    else if esz == 4_usize { mop = .VPSubD; }
                    else if esz == 8_usize { mop = .VPSubQ; }
                }
                .SubWrap => {
                    if esz == 1_usize { mop = .VPSubB; }
                    else if esz == 4_usize { mop = .VPSubD; }
                    else if esz == 8_usize { mop = .VPSubQ; }
                }
                .Mul => {
                    if esz == 4_usize { mop = .VPMullD; }
                }
                .MulWrap => {
                    if esz == 4_usize { mop = .VPMullD; }
                }
                _ => {}
            }
        }
        if mop != .Nop {
            let lv = try load_val_vec(alloc, ctx, mf, lhs, l256, sp);
            let rv = try load_val_vec(alloc, ctx, mf, rhs, l256, sp);
            let res = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
            var m = mach_ir.inst_empty(mop, sp);
            m.dst = res;
            m.src0 = lv;
            m.src1 = rv;
            m.flag0 = l256;
            m.size_bytes = if l256 { 32_u8 } else { 16_u8 };
            try mf.emit_inst(alloc, m);
            try store_vec_to_val(alloc, ctx, mf, dst, res, l256, sp);
            return;
        }
    }

    // Lane-by-lane fallback for exotic element sizes/ops (e.g. u16x8 mul, variable vector shift)
    let loff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, lhs, sp);
    let roff = if ctx_val_loc(ctx, rhs).kind == .Stack {
        ctx_val_loc(ctx, rhs).stack_off
    } else {
        let tmp_off = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
        try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(tmp_off), rhs, op_ty, sp);
        tmp_off
    };
    let dloc = ctx_val_loc(ctx, dst);
    let doff = if dloc.kind == .Stack {
        dloc.stack_off
    } else {
        mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize)
    };
    let signed = env.is_signed_int(elem_ty);
    var li: usize = 0_usize;
    while li < lanes {
        let ld = (li *% esz).trunc.[i32]();
        if en.kind == .Float {
            let is_f64 = en.u8_val == 64_u8;
            let a = try mf.new_vreg(alloc, .Vec128);
            let b = try mf.new_vreg(alloc, .Vec128);
            var la = mach_ir.inst_empty(if is_f64 { .VMovSDLoad } else { .VMovSSLoad }, sp);
            la.dst = a;
            la.mem = mach_ir.mem_stack_slot(loff +% ld);
            la.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
            try mf.emit_inst(alloc, la);
            var lb = mach_ir.inst_empty(if is_f64 { .VMovSDLoad } else { .VMovSSLoad }, sp);
            lb.dst = b;
            lb.mem = mach_ir.mem_stack_slot(roff +% ld);
            lb.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
            try mf.emit_inst(alloc, lb);
            let mop: mach_ir.MachOp = match op {
                .Add => { if is_f64 { .VAddSD } else { .VAddSS } }
                .Sub => { if is_f64 { .VSubSD } else { .VSubSS } }
                .Mul => { if is_f64 { .VMulSD } else { .VMulSS } }
                _ => { if is_f64 { .VDivSD } else { .VDivSS } }
            };
            let c = try mf.new_vreg(alloc, .Vec128);
            var mo = mach_ir.inst_empty(mop, sp);
            mo.dst = c;
            mo.src0 = a;
            mo.src1 = b;
            mo.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
            try mf.emit_inst(alloc, mo);
            var st = mach_ir.inst_empty(if is_f64 { .VMovSDStore } else { .VMovSSStore }, sp);
            st.src0 = c;
            st.mem = mach_ir.mem_stack_slot(doff +% ld);
            st.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
            try mf.emit_inst(alloc, st);
        } else {
            let a = try mf.new_vreg(alloc, .Gpr);
            let b = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, a, mach_ir.mem_stack_slot(loff +% ld), esz, signed, sp);
            try emit_load_mem(alloc, mf, b, mach_ir.mem_stack_slot(roff +% ld), esz, signed, sp);
            let c = try mf.new_vreg(alloc, .Gpr);
            match op {
                .Add => { try emit_alu_rr(alloc, mf, .Add, c, a, b, sp); }
                .AddWrap => { try emit_alu_rr(alloc, mf, .Add, c, a, b, sp); }
                .Sub => { try emit_alu_rr(alloc, mf, .Sub, c, a, b, sp); }
                .SubWrap => { try emit_alu_rr(alloc, mf, .Sub, c, a, b, sp); }
                .Mul => { try emit_alu_rr(alloc, mf, .Mul, c, a, b, sp); }
                .MulWrap => { try emit_alu_rr(alloc, mf, .Mul, c, a, b, sp); }
                .BitAnd => { try emit_alu_rr(alloc, mf, .And, c, a, b, sp); }
                .BitOr => { try emit_alu_rr(alloc, mf, .Or, c, a, b, sp); }
                .BitXor => { try emit_alu_rr(alloc, mf, .Xor, c, a, b, sp); }
                .Shl => { try emit_alu_rr(alloc, mf, .Shl, c, a, b, sp); }
                .ShlWrap => { try emit_alu_rr(alloc, mf, .Shl, c, a, b, sp); }
                .Shr => { try emit_alu_rr(alloc, mf, if signed { .Sar } else { .Shr }, c, a, b, sp); }
                _ => { try mf.emit_inst(alloc, mach_ir.inst_copy(c, a, sp)); }
            }
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ld), c, esz, sp);
        }
        li = li +% 1_usize;
    }
    if dloc.kind != .Stack {
        try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_stack_slot(doff), op_ty, sp);
    }
    return;
}

fn emit_binary_checked(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let signed = env.is_signed_int(op_ty);
    let bits = env.int_bits(op_ty);
    let ok_sz = env.x64_layout(op_ty).size;
    let ok_off = env.eu_ok_offset(op_ty).trunc.[i32]();
    let dst_off = ctx_val_loc(ctx, dst).stack_off;
    let lv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, lhs, true, sp);
    let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
    let bnds = types.int_bounds(env.get(op_ty));

    let b_ok = try mf.add_block(alloc, ctx.cur_depth);
    let b_ovf = try mf.add_block(alloc, ctx.cur_depth);
    let b_done = try mf.add_block(alloc, ctx.cur_depth);
    var res_v = try mf.new_vreg(alloc, .Gpr);

    if op == .DivCheck || op == .ModCheck {
        let b_nz = try mf.add_block(alloc, ctx.cur_depth);
        let b_dz = try mf.add_block(alloc, ctx.cur_depth);
        try emit_test_rr(alloc, mf, rv, rv, false, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_dz, sp));
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_nz, sp));
        mf.end_block_insts(ctx.cur_mbb);

        mf.begin_block_insts(b_dz);
        try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off), 2_i64, 4_usize, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
        mf.end_block_insts(b_dz);

        mf.begin_block_insts(b_nz);
        ctx.cur_mbb = b_nz;
        if signed {
            let b_chk_m1 = try mf.add_block(alloc, ctx.cur_depth);
            let b_do_div = try mf.add_block(alloc, ctx.cur_depth);
            let min_v = try emit_imm_vreg(alloc, mf, bnds.min.lo, sp);
            try emit_cmp_rr(alloc, mf, lv, min_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_chk_m1, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_do_div, sp));
            mf.end_block_insts(b_nz);

            mf.begin_block_insts(b_chk_m1);
            try emit_cmp_ri(alloc, mf, rv, -1_i32, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_ovf, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_do_div, sp));
            mf.end_block_insts(b_chk_m1);

            mf.begin_block_insts(b_do_div);
            ctx.cur_mbb = b_do_div;
        }
        let q = try mf.new_vreg(alloc, .Gpr);
        let rem = try mf.new_vreg(alloc, .Gpr);
        var dv = mach_ir.inst_empty(if signed { .Idiv } else { .Div }, sp);
        dv.dst = q;
        dv.dst2 = rem;
        dv.src0 = lv;
        dv.src1 = rv;
        try mf.emit_inst(alloc, dv);
        res_v = if op == .DivCheck { q } else { rem };
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
        mf.end_block_insts(ctx.cur_mbb);
    } else if bits < 64_u8 {
        if !signed && op == .SubCheck {
            try emit_alu_rr(alloc, mf, .Sub, res_v, lv, rv, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, b_ovf, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(ctx.cur_mbb);
        } else {
            let mop: mach_ir.MachOp = match op {
                .AddCheck => { .Add }
                .SubCheck => { .Sub }
                _ => { .Mul }
            };
            try emit_alu_rr(alloc, mf, mop, res_v, lv, rv, sp);
            if signed {
                let b_hi = try mf.add_block(alloc, ctx.cur_depth);
                let min_v = try emit_imm_vreg(alloc, mf, bnds.min.lo, sp);
                try emit_cmp_rr(alloc, mf, res_v, min_v, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jcc(.L, b_ovf, sp));
                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_hi, sp));
                mf.end_block_insts(ctx.cur_mbb);
                mf.begin_block_insts(b_hi);
                ctx.cur_mbb = b_hi;
            }
            let max_v = try emit_imm_vreg(alloc, mf, bnds.max.lo, sp);
            try emit_cmp_rr(alloc, mf, res_v, max_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(if signed { .G } else { .A }, b_ovf, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(ctx.cur_mbb);
        }
    } else {
        if op == .AddCheck {
            try emit_alu_rr(alloc, mf, .Add, res_v, lv, rv, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(if signed { .O } else { .B }, b_ovf, sp));
        } else if op == .SubCheck {
            try emit_alu_rr(alloc, mf, .Sub, res_v, lv, rv, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(if signed { .O } else { .B }, b_ovf, sp));
        } else if signed {
            try emit_alu_rr(alloc, mf, .Mul, res_v, lv, rv, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.O, b_ovf, sp));
        } else {
            let hi_d = try mf.new_vreg(alloc, .Gpr);
            var m = mach_ir.inst_empty(.Mul128, sp);
            m.dst = res_v;
            m.dst2 = hi_d;
            m.src0 = lv;
            m.src1 = rv;
            try mf.emit_inst(alloc, m);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.O, b_ovf, sp));
        }
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
        mf.end_block_insts(ctx.cur_mbb);
    }

    mf.begin_block_insts(b_ok);
    try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off), 0_i64, 4_usize, sp);
    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off +% ok_off), res_v, ok_sz, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
    mf.end_block_insts(b_ok);

    mf.begin_block_insts(b_ovf);
    try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off), 1_i64, 4_usize, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
    mf.end_block_insts(b_ovf);

    mf.begin_block_insts(b_done);
    ctx.cur_mbb = b_done;
    return;
}

fn emit_binary_sat(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let signed = env.is_signed_int(op_ty);
    let bits = env.int_bits(op_ty);
    let bnds = types.int_bounds(env.get(op_ty));
    let lv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, lhs, true, sp);
    let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);

    if bits < 64_u8 {
        let r = try mf.new_vreg(alloc, .Gpr);
        if !signed && op == .SubSat {
            let z = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            let sub = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Sub, sub, lv, rv, sp);
            try emit_cmov(alloc, mf, .B, r, sub, z, sp);
        } else {
            let mop: mach_ir.MachOp = match op {
                .AddSat => { .Add }
                .SubSat => { .Sub }
                _ => { .Mul }
            };
            let raw_v = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, mop, raw_v, lv, rv, sp);
            var cur = raw_v;
            if signed {
                let mn = try emit_imm_vreg(alloc, mf, bnds.min.lo, sp);
                try emit_cmp_rr(alloc, mf, cur, mn, sp);
                let c1 = try mf.new_vreg(alloc, .Gpr);
                try emit_cmov(alloc, mf, .L, c1, cur, mn, sp);
                cur = c1;
            }
            let mx = try emit_imm_vreg(alloc, mf, bnds.max.lo, sp);
            try emit_cmp_rr(alloc, mf, cur, mx, sp);
            try emit_cmov(alloc, mf, if signed { .G } else { .A }, r, cur, mx, sp);
        }
        try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, r, sp);
        return;
    }

    if !signed {
        let raw_v = try mf.new_vreg(alloc, .Gpr);
        let sat_v = try emit_imm_vreg(alloc, mf, if op == .SubSat { 0_u64 } else { 0xFFFFFFFFFFFFFFFF_u64 }, sp);
        let res = try mf.new_vreg(alloc, .Gpr);
        if op == .AddSat {
            try emit_alu_rr(alloc, mf, .Add, raw_v, lv, rv, sp);
            try emit_cmov(alloc, mf, .B, res, raw_v, sat_v, sp);
        } else if op == .SubSat {
            try emit_alu_rr(alloc, mf, .Sub, raw_v, lv, rv, sp);
            try emit_cmov(alloc, mf, .B, res, raw_v, sat_v, sp);
        } else {
            let hi_d = try mf.new_vreg(alloc, .Gpr);
            var m = mach_ir.inst_empty(.Mul128, sp);
            m.dst = raw_v;
            m.dst2 = hi_d;
            m.src0 = lv;
            m.src1 = rv;
            try mf.emit_inst(alloc, m);
            try emit_cmov(alloc, mf, .O, res, raw_v, sat_v, sp);
        }
        try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        return;
    }

    // Signed 64-bit saturating add / sub / mul
    let raw_v = try mf.new_vreg(alloc, .Gpr);
    let b_sat = try mf.add_block(alloc, ctx.cur_depth);
    let b_ok = try mf.add_block(alloc, ctx.cur_depth);
    let b_done = try mf.add_block(alloc, ctx.cur_depth);
    let res = try mf.new_vreg(alloc, .Gpr);

    let mop: mach_ir.MachOp = match op {
        .AddSat => { .Add }
        .SubSat => { .Sub }
        _ => { .Mul }
    };
    try emit_alu_rr(alloc, mf, mop, raw_v, lv, rv, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.O, b_sat, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
    mf.end_block_insts(ctx.cur_mbb);

    mf.begin_block_insts(b_ok);
    try mf.emit_inst(alloc, mach_ir.inst_copy(res, raw_v, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
    mf.end_block_insts(b_ok);

    mf.begin_block_insts(b_sat);
    let sign_src = if op == .MulSat {
        let xr = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .Xor, xr, lv, rv, sp);
        xr
    } else {
        lv
    };
    let pos_max = try emit_imm_vreg(alloc, mf, 0x7FFFFFFFFFFFFFFF_u64, sp);
    let neg_min = try emit_imm_vreg(alloc, mf, 0x8000000000000000_u64, sp);
    try emit_test_rr(alloc, mf, sign_src, sign_src, false, sp);
    try emit_cmov(alloc, mf, .S, res, pos_max, neg_min, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
    mf.end_block_insts(b_sat);

    mf.begin_block_insts(b_done);
    ctx.cur_mbb = b_done;
    try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
    return;
}

fn emit_binary_inst(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    inst_gid: u32,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    dst_ty: types.TyId,
    op_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let op_node = env.get(op_ty);
    if op_node.kind == .Float {
        try emit_binary_float(alloc, ctx, mf, eir_prog, env, dst, op, lhs, rhs, op_ty, sp);
        return;
    }
    if op_node.kind == .Vec {
        try emit_binary_vec(alloc, ctx, mf, eir_prog, env, dst, op, lhs, rhs, op_ty, sp);
        return;
    }
    if op == .AddCheck || op == .SubCheck || op == .MulCheck || op == .DivCheck || op == .ModCheck {
        try emit_binary_checked(alloc, ctx, mf, eir_prog, env, dst, op, lhs, rhs, op_ty, sp);
        return;
    }
    if op == .AddSat || op == .SubSat || op == .MulSat {
        try emit_binary_sat(alloc, ctx, mf, eir_prog, env, dst, op, lhs, rhs, op_ty, sp);
        return;
    }
    // Fused `BitOr(VecBitmask(VecCmp(Eq)), VecBitmask(VecCmp(Eq)))` -> `VPCmpEqB + VPCmpEqB + VPOr + VPMovMskB`!
    if op == .BitOr && ctx_should_skip(ctx, lhs) && ctx_should_skip(ctx, rhs) {
        let lidx = lhs.widen.[usize]();
        let ridx = rhs.widen.[usize]();
        let fbc = ctx.fused_bitmask_cmp.as_slice();
        if lidx < fbc.len && ridx < fbc.len && fbc[lidx] != eir.EIR_NONE && fbc[ridx] != eir.EIR_NONE {
            let all_i = eir_prog.funcs.insts.as_slice();
            let lg = fbc[lidx].widen.[usize]();
            let rg = fbc[ridx].widen.[usize]();
            if lg < all_i.len && rg < all_i.len {
                if let lbc = eir_prog.get_builtin_call(all_i[lg].aux0) {
                    if let rbc = eir_prog.get_builtin_call(all_i[rg].aux0) {
                        let largs = eir_prog.vals_slice(lbc.args);
                        let rargs = eir_prog.vals_slice(rbc.args);
                        if largs.len >= 2_usize && rargs.len >= 2_usize {
                            let l256 = env.get(lbc.op.ty0).u8_val == 32_u8;
                            let vcls: mach_ir.RegClass = if l256 { .Vec256 } else { .Vec128 };
                            let vbytes: u8 = if l256 { 32_u8 } else { 16_u8 };
                            let la = try load_val_vec(alloc, ctx, mf, largs[0_usize], l256, sp);
                            let lb = try load_val_vec(alloc, ctx, mf, largs[1_usize], l256, sp);
                            let ra = try load_val_vec(alloc, ctx, mf, rargs[0_usize], l256, sp);
                            let rb = try load_val_vec(alloc, ctx, mf, rargs[1_usize], l256, sp);
                            let c1 = try mf.new_vreg(alloc, vcls);
                            var e1 = mach_ir.inst_empty(.VPCmpEqB, sp);
                            e1.dst = c1; e1.src0 = la; e1.src1 = lb; e1.flag0 = l256; e1.size_bytes = vbytes;
                            try mf.emit_inst(alloc, e1);
                            let c2 = try mf.new_vreg(alloc, vcls);
                            var e2 = mach_ir.inst_empty(.VPCmpEqB, sp);
                            e2.dst = c2; e2.src0 = ra; e2.src1 = rb; e2.flag0 = l256; e2.size_bytes = vbytes;
                            try mf.emit_inst(alloc, e2);
                            let co = try mf.new_vreg(alloc, vcls);
                            var vo = mach_ir.inst_empty(.VPOr, sp);
                            vo.dst = co; vo.src0 = c1; vo.src1 = c2; vo.flag0 = l256; vo.size_bytes = vbytes;
                            try mf.emit_inst(alloc, vo);
                            let msk = try mf.new_vreg(alloc, .Gpr);
                            var pm = mach_ir.inst_empty(.VPMovMskB, sp);
                            pm.dst = msk; pm.src0 = co; pm.flag0 = l256; pm.size_bytes = 4_u8;
                            try mf.emit_inst(alloc, pm);
                            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, msk, sp);
                            return;
                        }
                    }
                }
            }
        }
    }

    if op == .BitOr && op_ty == dst_ty {
        let rm = try_match_rotate_right(ctx, eir_prog, env, op_ty, lhs, rhs);
        if rm.ok {
            let xv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rm.src, true, sp);
            let rres = try mf.new_vreg(alloc, .Gpr);
            let rop: mach_ir.MachOp = if rm.bits == 32_u8 { .Ror32Imm } else { .RorImm };
            try emit_alu_ri(alloc, mf, rop, rres, xv, rm.amt.widen.[i64](), sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, rres, sp);
            return;
        }
    }

    let signed = env.is_signed_int(op_ty);
    let is_u32 = !signed && env.int_bits(op_ty) == 32_u8 && dst_ty == op_ty;
    let is_comm_bin = op == .Add || op == .AddWrap || op == .Mul || op == .MulWrap
        || op == .BitAnd || op == .BitOr || op == .BitXor;
    let swap_const = is_comm_bin && ctx_is_const_int(ctx, lhs) && !ctx_is_const_int(ctx, rhs);
    let eff_lhs = if swap_const { rhs } else { lhs };
    let eff_rhs = if swap_const { lhs } else { rhs };
    let lv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_lhs, true, sp);
    let rhs_is_const = ctx_is_const_int(ctx, eff_rhs);
    let rhs_u64 = if rhs_is_const { ctx_const_int(ctx, eff_rhs) } else { 0_u64 };
    let rhs_i64 = rhs_u64.bitcast.[i64]();
    let rhs_fits_i32 = rhs_is_const && fits_i32(rhs_i64);
    let proven = eir_prog.inst_proven_flags(inst_gid);

    var res = try mf.new_vreg(alloc, .Gpr);

    match op {
        .Add => {
            if is_u32 {
                if rhs_fits_i32 {
                    try emit_alu_ri(alloc, mf, .Add32Imm, res, lv, rhs_i64, sp);
                } else {
                    let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                    try emit_alu_rr(alloc, mf, .Add32, res, lv, rv, sp);
                }
            } else if rhs_fits_i32 {
                // Non-destructive 3-address `lea dst, [lhs + imm]`!
                try mf.emit_inst(alloc, mach_ir.inst_lea(res, mach_ir.mem_base_disp(lv, rhs_i64.trunc.[i32]()), sp));
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(res, mach_ir.mem_sib(lv, rv, 1_u8, 0_i32), sp));
            }
            if !is_u32 { res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp); }
        }
        .AddWrap => {
            if is_u32 {
                if rhs_fits_i32 {
                    try emit_alu_ri(alloc, mf, .Add32Imm, res, lv, rhs_i64, sp);
                } else {
                    let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                    try emit_alu_rr(alloc, mf, .Add32, res, lv, rv, sp);
                }
            } else if rhs_fits_i32 {
                try mf.emit_inst(alloc, mach_ir.inst_lea(res, mach_ir.mem_base_disp(lv, rhs_i64.trunc.[i32]()), sp));
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(res, mach_ir.mem_sib(lv, rv, 1_u8, 0_i32), sp));
            }
            if !is_u32 { res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp); }
        }
        .Sub => {
            if is_u32 {
                if rhs_fits_i32 {
                    try emit_alu_ri(alloc, mf, .Sub32Imm, res, lv, rhs_i64, sp);
                } else {
                    let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                    try emit_alu_rr(alloc, mf, .Sub32, res, lv, rv, sp);
                }
            } else if rhs_fits_i32 {
                try emit_alu_ri(alloc, mf, .SubImm, res, lv, rhs_i64, sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                try emit_alu_rr(alloc, mf, .Sub, res, lv, rv, sp);
            }
            if !is_u32 { res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp); }
        }
        .SubWrap => {
            if is_u32 {
                if rhs_fits_i32 {
                    try emit_alu_ri(alloc, mf, .Sub32Imm, res, lv, rhs_i64, sp);
                } else {
                    let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                    try emit_alu_rr(alloc, mf, .Sub32, res, lv, rv, sp);
                }
            } else if rhs_fits_i32 {
                try emit_alu_ri(alloc, mf, .SubImm, res, lv, rhs_i64, sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                try emit_alu_rr(alloc, mf, .Sub, res, lv, rv, sp);
            }
            if !is_u32 { res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp); }
        }
        .Mul => {
            if rhs_is_const && (rhs_u64 == 3_u64 || rhs_u64 == 5_u64 || rhs_u64 == 9_u64) {
                let sc: u8 = (rhs_u64 -% 1_u64).trunc.[u8]();
                try mf.emit_inst(alloc, mach_ir.inst_lea(res, mach_ir.mem_sib(lv, lv, sc, 0_i32), sp));
            } else if rhs_is_const && is_power_of_two_u64(rhs_u64) && rhs_u64 > 1_u64 {
                try emit_alu_ri(alloc, mf, .ShlImm, res, lv, log2_u64(rhs_u64).widen.[i64](), sp);
            } else if rhs_fits_i32 {
                try emit_alu_ri(alloc, mf, .MulImm, res, lv, rhs_i64, sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                try emit_alu_rr(alloc, mf, .Mul, res, lv, rv, sp);
            }
            res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp);
        }
        .MulWrap => {
            if rhs_is_const && (rhs_u64 == 3_u64 || rhs_u64 == 5_u64 || rhs_u64 == 9_u64) {
                let sc: u8 = (rhs_u64 -% 1_u64).trunc.[u8]();
                try mf.emit_inst(alloc, mach_ir.inst_lea(res, mach_ir.mem_sib(lv, lv, sc, 0_i32), sp));
            } else if rhs_is_const && is_power_of_two_u64(rhs_u64) && rhs_u64 > 1_u64 {
                try emit_alu_ri(alloc, mf, .ShlImm, res, lv, log2_u64(rhs_u64).widen.[i64](), sp);
            } else if rhs_fits_i32 {
                try emit_alu_ri(alloc, mf, .MulImm, res, lv, rhs_i64, sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                try emit_alu_rr(alloc, mf, .Mul, res, lv, rv, sp);
            }
            res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp);
        }
        .Div => {
            if !signed && rhs_is_const && rhs_u64 >= 1_u64 {
                res = try emit_magic_udiv_umod(alloc, mf, lv, rhs_u64, false, sp);
            } else if signed && rhs_is_const && rhs_i64 >= 2_i64 && is_power_of_two_u64(rhs_u64) {
                let lf = eir_prog.fn_val_fact(ctx.fn_id, lhs);
                res = try emit_sdiv_pow2(alloc, mf, lv, rhs_u64, lf.non_neg, false, sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                let rem_dead = try mf.new_vreg(alloc, .Gpr);
                let narrow32 = (proven & eir.PROVEN_NARROW_U32) != 0_u8 || env.int_bits(op_ty) <= 32_u8;
                let dop: mach_ir.MachOp = if narrow32 {
                    if signed { .Idiv32 } else { .Div32 }
                } else {
                    if signed { .Idiv } else { .Div }
                };
                var dv = mach_ir.inst_empty(dop, sp);
                dv.dst = res;
                dv.dst2 = rem_dead;
                dv.src0 = lv;
                dv.src1 = rv;
                try mf.emit_inst(alloc, dv);
            }
            res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp);
        }
        .Mod => {
            if !signed && rhs_is_const && rhs_u64 >= 1_u64 {
                res = try emit_magic_udiv_umod(alloc, mf, lv, rhs_u64, true, sp);
            } else if signed && rhs_is_const && rhs_i64 >= 2_i64 && is_power_of_two_u64(rhs_u64) {
                let lf = eir_prog.fn_val_fact(ctx.fn_id, lhs);
                res = try emit_sdiv_pow2(alloc, mf, lv, rhs_u64, lf.non_neg, true, sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                let q_dead = try mf.new_vreg(alloc, .Gpr);
                let narrow32 = (proven & eir.PROVEN_NARROW_U32) != 0_u8 || env.int_bits(op_ty) <= 32_u8;
                let dop: mach_ir.MachOp = if narrow32 {
                    if signed { .Idiv32 } else { .Div32 }
                } else {
                    if signed { .Idiv } else { .Div }
                };
                var dv = mach_ir.inst_empty(dop, sp);
                dv.dst = q_dead;
                dv.dst2 = res;
                dv.src0 = lv;
                dv.src1 = rv;
                try mf.emit_inst(alloc, dv);
            }
            res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp);
        }
        .BitAnd => {
            if is_u32 {
                if rhs_fits_i32 {
                    try emit_alu_ri(alloc, mf, .And32Imm, res, lv, rhs_i64, sp);
                } else {
                    let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                    try emit_alu_rr(alloc, mf, .And32, res, lv, rv, sp);
                }
            } else if rhs_fits_i32 {
                try emit_alu_ri(alloc, mf, .AndImm, res, lv, rhs_i64, sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                try emit_alu_rr(alloc, mf, .And, res, lv, rv, sp);
            }
            if !is_u32 { res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp); }
        }
        .BitOr => {
            if is_u32 {
                if rhs_fits_i32 {
                    try emit_alu_ri(alloc, mf, .Or32Imm, res, lv, rhs_i64, sp);
                } else {
                    let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                    try emit_alu_rr(alloc, mf, .Or32, res, lv, rv, sp);
                }
            } else if rhs_fits_i32 {
                try emit_alu_ri(alloc, mf, .OrImm, res, lv, rhs_i64, sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                try emit_alu_rr(alloc, mf, .Or, res, lv, rv, sp);
            }
            if !is_u32 { res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp); }
        }
        .BitXor => {
            if is_u32 {
                if rhs_fits_i32 {
                    try emit_alu_ri(alloc, mf, .Xor32Imm, res, lv, rhs_i64, sp);
                } else {
                    let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                    try emit_alu_rr(alloc, mf, .Xor32, res, lv, rv, sp);
                }
            } else if rhs_fits_i32 {
                try emit_alu_ri(alloc, mf, .XorImm, res, lv, rhs_i64, sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eff_rhs, true, sp);
                try emit_alu_rr(alloc, mf, .Xor, res, lv, rv, sp);
            }
            if !is_u32 { res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp); }
        }
        .And => {
            let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
            let t = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .And, t, lv, rv, sp);
            try emit_alu_ri(alloc, mf, .AndImm, res, t, 1_i64, sp);
        }
        .Or => {
            let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
            let t = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Or, t, lv, rv, sp);
            try emit_alu_ri(alloc, mf, .AndImm, res, t, 1_i64, sp);
        }
        .Shl => {
            if is_u32 && rhs_is_const {
                try emit_alu_ri(alloc, mf, .Shl32Imm, res, lv, (rhs_u64 & 31_u64).bitcast.[i64](), sp);
            } else if rhs_is_const {
                try emit_alu_ri(alloc, mf, .ShlImm, res, lv, (rhs_u64 & 63_u64).bitcast.[i64](), sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                try emit_alu_rr(alloc, mf, .Shl, res, lv, rv, sp);
            }
            if !(is_u32 && rhs_is_const) { res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp); }
        }
        .ShlWrap => {
            let bits = env.int_bits(op_ty);
            if is_u32 && rhs_is_const {
                try emit_alu_ri(alloc, mf, .Shl32Imm, res, lv, (rhs_u64 & 31_u64).bitcast.[i64](), sp);
            } else if rhs_is_const {
                let mask: u64 = if bits > 0_u8 && bits < 64_u8 { (bits -% 1_u8).widen.[u64]() } else { 63_u64 };
                try emit_alu_ri(alloc, mf, .ShlImm, res, lv, (rhs_u64 & mask).bitcast.[i64](), sp);
            } else {
                var rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                if bits > 0_u8 && bits < 64_u8 {
                    let mr = try mf.new_vreg(alloc, .Gpr);
                    try emit_alu_ri(alloc, mf, .AndImm, mr, rv, (bits -% 1_u8).widen.[i64](), sp);
                    rv = mr;
                }
                try emit_alu_rr(alloc, mf, .Shl, res, lv, rv, sp);
            }
            if !(is_u32 && rhs_is_const) { res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp); }
        }
        .Shr => {
            if is_u32 && rhs_is_const {
                try emit_alu_ri(alloc, mf, .Shr32Imm, res, lv, (rhs_u64 & 31_u64).bitcast.[i64](), sp);
            } else if rhs_is_const {
                let sop: mach_ir.MachOp = if signed { .SarImm } else { .ShrImm };
                try emit_alu_ri(alloc, mf, sop, res, lv, (rhs_u64 & 63_u64).bitcast.[i64](), sp);
            } else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                let sop: mach_ir.MachOp = if signed { .Sar } else { .Shr };
                try emit_alu_rr(alloc, mf, sop, res, lv, rv, sp);
            }
            if !(is_u32 && rhs_is_const) { res = try emit_norm_subword(alloc, mf, env, dst_ty, res, sp); }
        }
        .Eq => {
            if rhs_fits_i32 { try emit_cmp_ri(alloc, mf, lv, rhs_i64.trunc.[i32](), sp); }
            else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                try emit_cmp_rr(alloc, mf, lv, rv, sp);
            }
            try emit_setcc_zext(alloc, mf, .E, res, sp);
        }
        .NotEq => {
            if rhs_fits_i32 { try emit_cmp_ri(alloc, mf, lv, rhs_i64.trunc.[i32](), sp); }
            else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                try emit_cmp_rr(alloc, mf, lv, rv, sp);
            }
            try emit_setcc_zext(alloc, mf, .Ne, res, sp);
        }
        .Lt => {
            if rhs_fits_i32 { try emit_cmp_ri(alloc, mf, lv, rhs_i64.trunc.[i32](), sp); }
            else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                try emit_cmp_rr(alloc, mf, lv, rv, sp);
            }
            try emit_setcc_zext(alloc, mf, if signed { .L } else { .B }, res, sp);
        }
        .LtEq => {
            if rhs_fits_i32 { try emit_cmp_ri(alloc, mf, lv, rhs_i64.trunc.[i32](), sp); }
            else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                try emit_cmp_rr(alloc, mf, lv, rv, sp);
            }
            try emit_setcc_zext(alloc, mf, if signed { .Le } else { .Be }, res, sp);
        }
        .Gt => {
            if rhs_fits_i32 { try emit_cmp_ri(alloc, mf, lv, rhs_i64.trunc.[i32](), sp); }
            else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                try emit_cmp_rr(alloc, mf, lv, rv, sp);
            }
            try emit_setcc_zext(alloc, mf, if signed { .G } else { .A }, res, sp);
        }
        .GtEq => {
            if rhs_fits_i32 { try emit_cmp_ri(alloc, mf, lv, rhs_i64.trunc.[i32](), sp); }
            else {
                let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, rhs, true, sp);
                try emit_cmp_rr(alloc, mf, lv, rv, sp);
            }
            try emit_setcc_zext(alloc, mf, if signed { .Ge } else { .Ae }, res, sp);
        }
        _ => {}
    }
    try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
    return;
}

fn emit_cast_inst(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    kind: cfg_ir.CastKind,
    operand: eir.EirValue,
    from_ty: types.TyId,
    to_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let from_n = env.get(from_ty);
    let to_n = env.get(to_ty);
    match kind {
        .Widen => {
            if from_n.kind == .Float && to_n.kind == .Float {
                let fv = try load_val_float(alloc, ctx, mf, eir_prog, env, operand, sp);
                if from_n.u8_val != 64_u8 && to_n.u8_val == 64_u8 {
                    let res = try mf.new_vreg(alloc, .Vec128);
                    var m = mach_ir.inst_empty(.VCvtSS2SD, sp);
                    m.dst = res;
                    m.src0 = fv;
                    m.size_bytes = 8_u8;
                    try mf.emit_inst(alloc, m);
                    try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
                } else {
                    try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, fv, sp);
                }
                return;
            }
            let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, operand, true, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .Trunc => {
            if from_n.kind == .Float && to_n.kind == .Float {
                let fv = try load_val_float(alloc, ctx, mf, eir_prog, env, operand, sp);
                if from_n.u8_val == 64_u8 && to_n.u8_val != 64_u8 {
                    let res = try mf.new_vreg(alloc, .Vec128);
                    var m = mach_ir.inst_empty(.VCvtSD2SS, sp);
                    m.dst = res;
                    m.src0 = fv;
                    m.size_bytes = 4_u8;
                    try mf.emit_inst(alloc, m);
                    try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
                } else {
                    try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, fv, sp);
                }
                return;
            }
            let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, operand, false, sp);
            let nv = try emit_norm_subword(alloc, mf, env, to_ty, v, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, nv, sp);
        }
        .Clamp => {
            var cur = try load_val_gpr(alloc, ctx, mf, eir_prog, env, operand, true, sp);
            let src_signed = env.is_signed_int(from_ty);
            let dst_signed = env.is_signed_int(to_ty);
            let bnds = types.int_bounds(to_n);
            if src_signed && !dst_signed {
                let z = try emit_imm_vreg(alloc, mf, 0_u64, sp);
                try emit_test_rr(alloc, mf, cur, cur, false, sp);
                let c1 = try mf.new_vreg(alloc, .Gpr);
                try emit_cmov(alloc, mf, .S, c1, cur, z, sp);
                cur = c1;
                if env.int_bits(to_ty) < 64_u8 {
                    let mx = try emit_imm_vreg(alloc, mf, bnds.max.lo, sp);
                    try emit_cmp_rr(alloc, mf, cur, mx, sp);
                    let c2 = try mf.new_vreg(alloc, .Gpr);
                    try emit_cmov(alloc, mf, .A, c2, cur, mx, sp);
                    cur = c2;
                }
            } else {
                let mn = try emit_imm_vreg(alloc, mf, bnds.min.lo, sp);
                try emit_cmp_rr(alloc, mf, cur, mn, sp);
                let c1 = try mf.new_vreg(alloc, .Gpr);
                try emit_cmov(alloc, mf, if src_signed { .L } else { .B }, c1, cur, mn, sp);
                let mx = try emit_imm_vreg(alloc, mf, bnds.max.lo, sp);
                try emit_cmp_rr(alloc, mf, c1, mx, sp);
                let c2 = try mf.new_vreg(alloc, .Gpr);
                try emit_cmov(alloc, mf, if src_signed { .G } else { .A }, c2, c1, mx, sp);
                cur = c2;
            }
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, cur, sp);
        }
        .ToFloat => {
            let is_f64 = to_n.u8_val == 64_u8;
            let iv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, operand, true, sp);
            let res = try mf.new_vreg(alloc, .Vec128);
            var m = mach_ir.inst_empty(if is_f64 { .VCvtSI2SD } else { .VCvtSI2SS }, sp);
            m.dst = res;
            m.src0 = iv;
            m.size_bytes = 8_u8;
            try mf.emit_inst(alloc, m);
            try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .TruncToInt => {
            let is_f64 = from_n.u8_val == 64_u8;
            let fv = try load_val_float(alloc, ctx, mf, eir_prog, env, operand, sp);
            let iv = try mf.new_vreg(alloc, .Gpr);
            var m = mach_ir.inst_empty(if is_f64 { .VCvtTTSD2SI } else { .VCvtTTSS2SI }, sp);
            m.dst = iv;
            m.src0 = fv;
            m.size_bytes = 8_u8;
            try mf.emit_inst(alloc, m);
            let nv = try emit_norm_subword(alloc, mf, env, to_ty, iv, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, nv, sp);
        }
        .Bitcast => {
            if from_n.kind == .Int && to_n.kind == .Int && env.int_bits(to_ty) < 64_u8 {
                let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, operand, false, sp);
                let nv = try emit_norm_subword(alloc, mf, env, to_ty, v, sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, nv, sp);
            } else {
                try emit_copy_val_to_val(alloc, ctx, mf, eir_prog, env, dst, operand, sp);
            }
        }
        .AsU64 => {
            let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, operand, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .MutToConst => {
            try emit_copy_val_to_val(alloc, ctx, mf, eir_prog, env, dst, operand, sp);
        }
        .ArrayBorrowToSlice => {
            let mut_arr_ty = from_n.primary;
            let arr_len = env.get(mut_arr_ty).u64_val;
            let ptr_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, operand, false, sp);
            let len_v = try emit_imm_vreg(alloc, mf, arr_len, sp);
            try store_slice_pair(alloc, ctx, mf, dst, ptr_v, len_v, sp);
        }
        .WrapOptional => {
            let inner_ty = to_n.primary;
            let niche = env.opt_niche(inner_ty);
            if niche.kind != .None {
                try emit_copy_val_to_val(alloc, ctx, mf, eir_prog, env, dst, operand, sp);
            } else {
                let dst_off = ctx_val_loc(ctx, dst).stack_off;
                let val_off = env.opt_val_offset(inner_ty).trunc.[i32]();
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off), 1_i64, 1_usize, sp);
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off +% val_off), operand, inner_ty, sp);
            }
            _ = 0_u8;
        }
        .WrapOk => {
            let ok_ty = to_n.primary;
            let dst_off = ctx_val_loc(ctx, dst).stack_off;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off), 0_i64, 4_usize, sp);
            if env.x64_layout(ok_ty).size > 0_usize {
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off +% ok_off), operand, ok_ty, sp);
            }
        }
        .WrapErr => {
            let dst_off = ctx_val_loc(ctx, dst).stack_off;
            let ev = try load_val_gpr(alloc, ctx, mf, eir_prog, env, operand, false, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off), ev, 4_usize, sp);
        }
    }
    return;
}

fn emit_slice_inst(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    base: eir.EirValue,
    lo_val: eir.EirValue,
    hi_val: eir.EirValue,
    base_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let bn = env.get(base_ty);
    var elem_sz: usize = 1_usize;
    var base_ptr = mach_ir.VREG_NONE;
    var base_len = mach_ir.VREG_NONE;
    if bn.kind == .Array {
        elem_sz = env.x64_layout(bn.primary).size;
        let off = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, base, sp);
        base_ptr = try mf.new_vreg(alloc, .Gpr);
        try mf.emit_inst(alloc, mach_ir.inst_lea(base_ptr, mach_ir.mem_stack_slot(off), sp));
        base_len = try emit_imm_vreg(alloc, mf, bn.u64_val, sp);
    } else if bn.kind == .Borrow && bn.borrow_kind == .Single {
        let inner = env.get(bn.primary);
        if inner.kind == .Array {
            elem_sz = env.x64_layout(inner.primary).size;
            base_ptr = try load_val_gpr(alloc, ctx, mf, eir_prog, env, base, false, sp);
            base_len = try emit_imm_vreg(alloc, mf, inner.u64_val, sp);
        } else {
            base_ptr = try load_val_gpr(alloc, ctx, mf, eir_prog, env, base, false, sp);
            base_len = try emit_imm_vreg(alloc, mf, 0_u64, sp);
        }
    } else {
        if bn.kind == .Borrow && bn.borrow_kind == .Slice {
            elem_sz = env.x64_layout(bn.primary).size;
        }
        let pr = try load_slice_pair(alloc, ctx, mf, base, sp);
        base_ptr = pr.lo;
        base_len = pr.hi;
    }

    let lo_v = if lo_val != eir.EIR_NONE {
        try load_val_gpr(alloc, ctx, mf, eir_prog, env, lo_val, false, sp)
    } else {
        try emit_imm_vreg(alloc, mf, 0_u64, sp)
    };
    let hi_v = if hi_val != eir.EIR_NONE {
        try load_val_gpr(alloc, ctx, mf, eir_prog, env, hi_val, false, sp)
    } else {
        base_len
    };
    let new_len = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Sub, new_len, hi_v, lo_v, sp);

    var new_ptr = base_ptr;
    if lo_val != eir.EIR_NONE {
        if elem_sz == 1_usize || elem_sz == 2_usize || elem_sz == 4_usize || elem_sz == 8_usize {
            new_ptr = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(new_ptr, mach_ir.mem_sib(base_ptr, lo_v, elem_sz.trunc.[u8](), 0_i32), sp));
        } else if elem_sz > 0_usize {
            let scaled = try emit_scale_index(alloc, mf, lo_v, elem_sz, sp);
            new_ptr = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(new_ptr, mach_ir.mem_sib(base_ptr, scaled, 1_u8, 0_i32), sp));
        }
    }
    try store_slice_pair(alloc, ctx, mf, dst, new_ptr, new_len, sp);
    return;
}

fn emit_aggregate_inst(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    agg_id: u32,
    elems_range: ast.IdRange,
    dst_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    // Check fused VSqrtPS / VSqrtPD pattern (`nbody_simd`!):
    // Aggregate(.Vec, [MathSqrt(extract(v, 0)), ..., MathSqrt(extract(v, N-1))])
    let didx = dst.widen.[usize]();
    let fss = ctx.fused_sqrt_src.as_slice();
    if didx < fss.len && fss[didx] != eir.EIR_NONE {
        let src_v = fss[didx];
        let dn = env.get(dst_ty);
        let is_f64 = env.get(dn.primary).u8_val == 64_u8;
        let l256 = env.x64_layout(dst_ty).size == 32_usize;
        let sv = try load_val_vec(alloc, ctx, mf, src_v, l256, sp);
        let res = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
        var sq = mach_ir.inst_empty(if is_f64 { .VSqrtPD } else { .VSqrtPS }, sp);
        sq.dst = res;
        sq.src0 = sv;
        sq.flag0 = l256;
        sq.size_bytes = if l256 { 32_u8 } else { 16_u8 };
        try mf.emit_inst(alloc, sq);
        try store_vec_to_val(alloc, ctx, mf, dst, res, l256, sp);
        return;
    }

    // Check fused contiguous vector load (`03_utf8_scan` / `06_hashmap_intern`!):
    // Aggregate(.Vec, [base[i], base[i+1], ..., base[i+N-1]]) -> single VMovUpsLoad!
    let fvl = ctx.fused_vec_load_gid.as_slice();
    if didx < fvl.len && fvl[didx] != eir.EIR_NONE {
        let lgid = fvl[didx].widen.[usize]();
        let all_insts = eir_prog.funcs.insts.as_slice();
        if lgid < all_insts.len {
            let lp0 = all_insts[lgid];
            if let place = eir_prog.get_place(lp0.aux0) {
                let pm = try compute_place_mem(alloc, ctx, mf, eir_prog, env, place, place.projs.len.widen.[usize](), sp);
                let l256 = env.x64_layout(dst_ty).size == 32_usize;
                let res = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
                var ld = mach_ir.inst_empty(.VMovUpsLoad, sp);
                ld.dst = res;
                ld.mem = pm.mem;
                ld.flag0 = l256;
                ld.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                try mf.emit_inst(alloc, ld);
                try store_vec_to_val(alloc, ctx, mf, dst, res, l256, sp);
                return;
            }
        }
    }

    let agg = eir_prog.get_aggregate(agg_id) orelse { return; };
    let elems = eir_prog.vals_slice(elems_range);
    let dst_lay = env.x64_layout(dst_ty);
    if dst_lay.size == 0_usize {
        return;
    }

    if agg.tag == .Bitfield {
        var acc = try emit_imm_vreg(alloc, mf, 0_u64, sp);
        if let bm = env.get_bitfield(agg.def_id) {
            let mems = env.bitfield_members_range(bm.members);
            var i: usize = 0_usize;
            while i < elems.len && i < mems.len {
                let m = mems[i];
                let width = m.hi -% m.lo;
                var ev = try load_val_gpr(alloc, ctx, mf, eir_prog, env, elems[i], false, sp);
                if width < 64_u8 {
                    let mask = (1_u64 <<% width.widen.[u64]()) -% 1_u64;
                    let t = try mf.new_vreg(alloc, .Gpr);
                    if fits_i32(mask.bitcast.[i64]()) {
                        try emit_alu_ri(alloc, mf, .AndImm, t, ev, mask.bitcast.[i64](), sp);
                    } else {
                        let mv = try emit_imm_vreg(alloc, mf, mask, sp);
                        try emit_alu_rr(alloc, mf, .And, t, ev, mv, sp);
                    }
                    ev = t;
                }
                if m.lo > 0_u8 {
                    let sh = try mf.new_vreg(alloc, .Gpr);
                    try emit_alu_ri(alloc, mf, .ShlImm, sh, ev, m.lo.widen.[i64](), sp);
                    ev = sh;
                }
                let nxt = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_rr(alloc, mf, .Or, nxt, acc, ev, sp);
                acc = nxt;
                i = i +% 1_usize;
            }
        }
        try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, acc, sp);
        return;
    }

    let dloc = ctx_val_loc(ctx, dst);
    if agg.tag == .Vec && (dloc.kind == .Vec128 || dloc.kind == .Vec256) {
        let l256 = dloc.kind == .Vec256;
        let esz = env.x64_layout(agg.elem_ty).size;
        let sc = ensure_scratch_vec_off(ctx, mf);
        var i: usize = 0_usize;
        while i < elems.len {
            let fdisp = (i *% esz).trunc.[i32]();
            try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(sc +% fdisp), elems[i], agg.elem_ty, sp);
            i = i +% 1_usize;
        }
        var ld = mach_ir.inst_empty(.VMovUpsLoad, sp);
        ld.dst = dloc.vreg0;
        ld.mem = mach_ir.mem_stack_slot(sc);
        ld.flag0 = l256;
        ld.size_bytes = if l256 { 32_u8 } else { 16_u8 };
        try mf.emit_inst(alloc, ld);
        return;
    }

    let dst_off = dloc.stack_off;
    if dloc.kind == .Stack {
        try emit_memzero(alloc, mf, mach_ir.mem_stack_slot(dst_off), dst_lay.size, sp);
    }

    match agg.tag {
        .Struct => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off +% foff.offset.trunc.[i32]()), elems[i], foff.ty, sp);
                i = i +% 1_usize;
            }
        }
        .AnonStruct => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off +% foff.offset.trunc.[i32]()), elems[i], foff.ty, sp);
                i = i +% 1_usize;
            }
        }
        .Tuple => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off +% foff.offset.trunc.[i32]()), elems[i], foff.ty, sp);
                i = i +% 1_usize;
            }
        }
        .PoolRow => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                let is_link = env.is_link_or_opt_link(foff.ty);
                let ev_ty = eir_prog.fn_val_ty(ctx.fn_id, elems[i]);
                let ev_sz = env.x64_layout(ev_ty).size;
                if !agg.is_slot_pool && is_link && ev_sz == 4_usize {
                    let ev = try load_val_gpr(alloc, ctx, mf, eir_prog, env, elems[i], false, sp);
                    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off +% foff.offset.trunc.[i32]()), ev, 4_usize, sp);
                    try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off +% foff.offset.trunc.[i32]() +% 4_i32), 0_i64, 4_usize, sp);
                } else {
                    let store_ty = if agg.is_slot_pool && is_link { ev_ty } else { foff.ty };
                    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off +% foff.offset.trunc.[i32]()), elems[i], store_ty, sp);
                }
                i = i +% 1_usize;
            }
            _ = 0_u8;
        }
        .Array => {
            let esz = env.x64_layout(agg.elem_ty).size;
            var i: usize = 0_usize;
            while i < elems.len {
                let fdisp = (i *% esz).trunc.[i32]();
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off +% fdisp), elems[i], agg.elem_ty, sp);
                i = i +% 1_usize;
            }
        }
        .ArrayRepeat => {
            if elems.len > 0_usize {
                // `dloc.kind == .Stack` was already zero-initialized by `emit_memzero` above!
                let elem0 = elems[0_usize];
                let is_zero_elem = (ctx_is_const_int(ctx, elem0) && ctx_const_int(ctx, elem0) == 0_u64)
                    || (ctx_is_const_flt(ctx, elem0) && ctx_const_flt_bits(ctx, elem0) == 0_u64);
                if dloc.kind == .Stack && is_zero_elem {
                    return;
                }
                let esz = env.x64_layout(agg.elem_ty).size;
                let cnt = agg.count.trunc.[usize]();
                if cnt <= 16_usize {
                    var i: usize = 0_usize;
                    while i < cnt {
                        try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off +% (i *% esz).trunc.[i32]()), elems[0_usize], agg.elem_ty, sp);
                        i = i +% 1_usize;
                    }
                } else {
                    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off), elems[0_usize], agg.elem_ty, sp);
                    let b_lp = try mf.add_block(alloc, ctx.cur_depth +% 1_u8);
                    let b_done = try mf.add_block(alloc, ctx.cur_depth);
                    let ptr_phi = try mf.new_vreg(alloc, .Gpr);
                    let idx_phi = try mf.new_vreg(alloc, .Gpr);
                    let ptr_init = try mf.new_vreg(alloc, .Gpr);
                    let idx_init = try emit_imm_vreg(alloc, mf, 1_u64, sp);
                    let cnt_v = try emit_imm_vreg(alloc, mf, agg.count, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_lea(ptr_init, mach_ir.mem_stack_slot(dst_off +% esz.trunc.[i32]()), sp));
                    let p0 = mf.pcopy_pairs.len().trunc.[u32]();
                    try mf.add_pcopy_pair(alloc, ptr_phi, ptr_init);
                    try mf.add_pcopy_pair(alloc, idx_phi, idx_init);
                    try mf.emit_parallel_copy(alloc, p0, 2_u32, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_lp, sp));
                    mf.end_block_insts(ctx.cur_mbb);

                    mf.begin_block_insts(b_lp);
                    try emit_copy_mem(alloc, mf, mach_ir.mem_base_disp(ptr_phi, 0_i32), mach_ir.mem_stack_slot(dst_off), esz, sp);
                    let ptr_nxt = try mf.new_vreg(alloc, .Gpr);
                    let idx_nxt = try mf.new_vreg(alloc, .Gpr);
                    try mf.emit_inst(alloc, mach_ir.inst_lea(ptr_nxt, mach_ir.mem_base_disp(ptr_phi, esz.trunc.[i32]()), sp));
                    try mf.emit_inst(alloc, mach_ir.inst_lea(idx_nxt, mach_ir.mem_base_disp(idx_phi, 1_i32), sp));
                    let p1 = mf.pcopy_pairs.len().trunc.[u32]();
                    try mf.add_pcopy_pair(alloc, ptr_phi, ptr_nxt);
                    try mf.add_pcopy_pair(alloc, idx_phi, idx_nxt);
                    try mf.emit_parallel_copy(alloc, p1, 2_u32, sp);
                    try emit_cmp_rr(alloc, mf, idx_phi, cnt_v, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, b_lp, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
                    mf.end_block_insts(b_lp);

                    mf.begin_block_insts(b_done);
                    ctx.cur_mbb = b_done;
                }
                _ = 0_u8;
            }
            _ = 0_u8;
        }
        .UnionVariant => {
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off), agg.variant_idx.widen.[i64](), 4_usize, sp);
            if elems.len > 0_usize {
                let pay_off = env.union_payload_offset(agg.def_id).trunc.[i32]();
                let pty = eir_prog.fn_val_ty(ctx.fn_id, elems[0_usize]);
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off +% pay_off), elems[0_usize], pty, sp);
            }
        }
        .Vec => {
            let esz = env.x64_layout(agg.elem_ty).size;
            var i: usize = 0_usize;
            while i < elems.len {
                let fdisp = (i *% esz).trunc.[i32]();
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(dst_off +% fdisp), elems[i], agg.elem_ty, sp);
                i = i +% 1_usize;
            }
        }
        _ => {}
    }
    return;
}

/// Emits flags for `IsNonNull(src, src_ty)` and returns the condition code `cc` that means "is non-null".
fn emit_is_non_null_flags(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    src: eir.EirValue,
    src_ty: types.TyId,
    sp: span.Span,
) -> x64_asm.Cond ! OutOfMemory {
    let inner = env.get(src_ty).primary;
    let niche = env.opt_niche(inner);
    let sloc = ctx_val_loc(ctx, src);
    match niche.kind {
        .IdBrand => {
            let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, src, false, sp);
            let sent = try emit_imm_vreg(alloc, mf, 0xFFFFFFFF_u64, sp);
            try emit_cmp_rr(alloc, mf, v, sent, sp);
            return .Ne;
        }
        .GenId => {
            let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, src, false, sp);
            let hi = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_ri(alloc, mf, .ShrImm, hi, v, 32_i64, sp);
            try emit_test_rr(alloc, mf, hi, hi, true, sp);
            return .Ne;
        }
        .Link => {
            let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, src, false, sp);
            let hi = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_ri(alloc, mf, .ShrImm, hi, v, 32_i64, sp);
            try emit_test_rr(alloc, mf, hi, hi, true, sp);
            return .Ne;
        }
        .NullPtr => {
            let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, src, false, sp);
            try emit_test_rr(alloc, mf, v, v, false, sp);
            return .Ne;
        }
        .FatPtrNullFirst => {
            if sloc.kind == .PairGpr {
                try emit_test_rr(alloc, mf, sloc.vreg0, sloc.vreg0, false, sp);
            } else {
                let v = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, v, mach_ir.mem_stack_slot(sloc.stack_off), 8_usize, false, sp);
                try emit_test_rr(alloc, mf, v, v, false, sp);
            }
            return .Ne;
        }
        .SliceMaxLen => {
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_stack_slot(sloc.stack_off +% 8_i32), 8_usize, false, sp);
            try emit_cmp_ri(alloc, mf, v, -1_i32, sp);
            return .Ne;
        }
        .BoolTag => {
            let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, src, false, sp);
            try emit_cmp_ri(alloc, mf, v, 2_i32, sp);
            return .Ne;
        }
        .ScalarSentinel => {
            let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, src, false, sp);
            let sent = try emit_imm_vreg(alloc, mf, niche.sentinel, sp);
            try emit_cmp_rr(alloc, mf, v, sent, sp);
            return .Ne;
        }
        .None => {
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_stack_slot(sloc.stack_off), 1_usize, false, sp);
            try emit_test_rr(alloc, mf, v, v, true, sp);
            return .Ne;
        }
    }
}

fn emit_unwrap_and_extract(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    inst: *eir.EirInst,
) -> !OutOfMemory {
    let sp = inst.span;
    match inst.kind {
        .UnwrapOptional => {
            let inner_ty = inst.ty0;
            let niche = env.opt_niche(inner_ty);
            if niche.kind != .None {
                try emit_copy_val_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, inst.v0, sp);
            } else {
                let soff = ctx_val_loc(ctx, inst.v0).stack_off;
                let voff = env.opt_val_offset(inner_ty).trunc.[i32]();
                try load_val_from_mem(alloc, ctx, mf, eir_prog, env, inst.dst, mach_ir.mem_stack_slot(soff +% voff), inner_ty, sp);
            }
            _ = 0_u8;
        }
        .UnwrapErrorOk => {
            let ok_ty = inst.ty0;
            if env.x64_layout(ok_ty).size > 0_usize {
                let sloc = ctx_val_loc(ctx, inst.v0);
                if sloc.kind == .PairGpr {
                    try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, sloc.vreg1, sp);
                } else if sloc.kind == .SliceEuPair {
                    try store_slice_pair(alloc, ctx, mf, inst.dst, sloc.vreg0, sloc.vreg1, sp);
                } else {
                    let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
                    try load_val_from_mem(alloc, ctx, mf, eir_prog, env, inst.dst, mach_ir.mem_stack_slot(sloc.stack_off +% ok_off), ok_ty, sp);
                }
            }
            _ = 0_u8;
        }
        .UnwrapErrorErr => {
            let sloc = ctx_val_loc(ctx, inst.v0);
            if sloc.kind == .PairGpr {
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, sloc.vreg0, sp);
            } else if sloc.kind == .SliceEuPair {
                let v = try emit_imm_vreg(alloc, mf, 4_u64, sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, v, sp);
            } else {
                let v = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, v, mach_ir.mem_stack_slot(sloc.stack_off), 4_usize, false, sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, v, sp);
            }
            _ = 0_u8;
        }
        .IsNonNull => {
            let cc = try emit_is_non_null_flags(alloc, ctx, mf, eir_prog, env, inst.v0, inst.ty1, sp);
            let res = try mf.new_vreg(alloc, .Gpr);
            try emit_setcc_zext(alloc, mf, cc, res, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, res, sp);
        }
        .IsError => {
            let sloc = ctx_val_loc(ctx, inst.v0);
            if sloc.kind == .PairGpr {
                try emit_test_rr(alloc, mf, sloc.vreg0, sloc.vreg0, true, sp);
            } else {
                let tag = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, tag, mach_ir.mem_stack_slot(sloc.stack_off), 4_usize, false, sp);
                try emit_test_rr(alloc, mf, tag, tag, true, sp);
            }
            let res = try mf.new_vreg(alloc, .Gpr);
            try emit_setcc_zext(alloc, mf, .Ne, res, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, res, sp);
        }
        .MatchTag => {
            let src_n = env.get(inst.ty1);
            let sloc = ctx_val_loc(ctx, inst.v0);
            let tag = if src_n.kind == .ErrorUnion && sloc.kind == .PairGpr {
                sloc.vreg0
            } else if src_n.kind == .ErrorUnion && sloc.kind == .SliceEuPair {
                try emit_imm_vreg(alloc, mf, 4_u64, sp)
            } else if src_n.kind == .Union || src_n.kind == .ErrorUnion {
                let v = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, v, mach_ir.mem_stack_slot(sloc.stack_off), 4_usize, false, sp);
                v
            } else {
                try load_val_gpr(alloc, ctx, mf, eir_prog, env, inst.v0, false, sp)
            };
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, tag, sp);
        }
        .FieldExtract => {
            let src_n = env.get(inst.ty1);
            if src_n.kind == .Union {
                let pay_off = env.union_payload_offset(src_n.primary).trunc.[i32]();
                let soff = ctx_val_loc(ctx, inst.v0).stack_off;
                try load_val_from_mem(alloc, ctx, mf, eir_prog, env, inst.dst, mach_ir.mem_stack_slot(soff +% pay_off), inst.ty0, sp);
                return;
            }
            if src_n.kind == .Bitfield {
                let bf = lookup_bitfield_member(env, src_n.primary, inst.aux0.widen.[usize]());
                var v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, inst.v0, false, sp);
                if bf.lo > 0_u8 {
                    let v2 = try mf.new_vreg(alloc, .Gpr);
                    try emit_alu_ri(alloc, mf, .ShrImm, v2, v, bf.lo.widen.[i64](), sp);
                    v = v2;
                }
                if bf.width < 64_u8 {
                    let mask = (1_u64 <<% bf.width.widen.[u64]()) -% 1_u64;
                    let v3 = try mf.new_vreg(alloc, .Gpr);
                    if fits_i32(mask.bitcast.[i64]()) {
                        try emit_alu_ri(alloc, mf, .AndImm, v3, v, mask.bitcast.[i64](), sp);
                    } else {
                        let mv = try emit_imm_vreg(alloc, mf, mask, sp);
                        try emit_alu_rr(alloc, mf, .And, v3, v, mv, sp);
                    }
                    v = v3;
                    if env.is_signed_int(bf.member_ty) {
                        let sh = 64_u8 -% bf.width;
                        let v4 = try mf.new_vreg(alloc, .Gpr);
                        try emit_alu_ri(alloc, mf, .ShlImm, v4, v, sh.widen.[i64](), sp);
                        let v5 = try mf.new_vreg(alloc, .Gpr);
                        try emit_alu_ri(alloc, mf, .SarImm, v5, v4, sh.widen.[i64](), sp);
                        v = v5;
                    }
                }
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, v, sp);
                return;
            }
            // Fast hardware lane extraction from Vec128 f32x4 / f64x2 in XMM!
            let sloc = ctx_val_loc(ctx, inst.v0);
            if src_n.kind == .Vec && sloc.kind == .Vec128 {
                let en = env.get(src_n.primary);
                let lane = inst.aux0.widen.[usize]();
                if en.kind == .Float && en.u8_val == 32_u8 && lane < 4_usize {
                    if lane == 0_usize {
                        try store_float_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, sloc.vreg0, sp);
                    } else {
                        let sh_imm: u8 = lane.trunc.[u8]();
                        let res = try mf.new_vreg(alloc, .Vec128);
                        var sh = mach_ir.inst_empty(.VShufPS, sp);
                        sh.dst = res;
                        sh.src0 = sloc.vreg0;
                        sh.src1 = sloc.vreg0;
                        sh.imm = sh_imm.widen.[i64]();
                        sh.size_bytes = 16_u8;
                        try mf.emit_inst(alloc, sh);
                        try store_float_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, res, sp);
                    }
                    return;
                }
                if en.kind == .Float && en.u8_val == 64_u8 && lane < 2_usize {
                    if lane == 0_usize {
                        try store_float_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, sloc.vreg0, sp);
                    } else {
                        let res = try mf.new_vreg(alloc, .Vec128);
                        var sh = mach_ir.inst_empty(.VShufPS, sp);
                        sh.dst = res;
                        sh.src0 = sloc.vreg0;
                        sh.src1 = sloc.vreg0;
                        sh.imm = 0xEE_i64;
                        sh.size_bytes = 16_u8;
                        try mf.emit_inst(alloc, sh);
                        try store_float_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, res, sp);
                    }
                    return;
                }
                // Spill vector to scratch slot and load lane
                let sc = ensure_scratch_vec_off(ctx, mf);
                var st = mach_ir.inst_empty(.VMovUpsStore, sp);
                st.src0 = sloc.vreg0;
                st.mem = mach_ir.mem_stack_slot(sc);
                st.size_bytes = 16_u8;
                try mf.emit_inst(alloc, st);
                let esz = env.x64_layout(src_n.primary).size;
                let dst_ty = eir_prog.fn_val_ty(ctx.fn_id, inst.dst);
                try load_val_from_mem(alloc, ctx, mf, eir_prog, env, inst.dst, mach_ir.mem_stack_slot(sc +% (lane *% esz).trunc.[i32]()), dst_ty, sp);
                return;
            }
            if src_n.kind == .Vec && sloc.kind == .Vec256 {
                let en = env.get(src_n.primary);
                let lane = inst.aux0.widen.[usize]();
                if en.kind == .Float && en.u8_val == 32_u8 && lane < 8_usize {
                    let half = try mf.new_vreg(alloc, .Vec128);
                    var ex = mach_ir.inst_empty(.VExtractF128, sp);
                    ex.dst = half;
                    ex.src0 = sloc.vreg0;
                    ex.imm = if lane < 4_usize { 0_i64 } else { 1_i64 };
                    ex.flag0 = true;
                    ex.size_bytes = 32_u8;
                    try mf.emit_inst(alloc, ex);
                    let sub_lane = lane & 3_usize;
                    if sub_lane == 0_usize {
                        try store_float_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, half, sp);
                    } else {
                        let res = try mf.new_vreg(alloc, .Vec128);
                        var sh = mach_ir.inst_empty(.VShufPS, sp);
                        sh.dst = res;
                        sh.src0 = half;
                        sh.src1 = half;
                        sh.imm = sub_lane.trunc.[u8]().widen.[i64]();
                        sh.size_bytes = 16_u8;
                        try mf.emit_inst(alloc, sh);
                        try store_float_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, res, sp);
                    }
                    return;
                }
                if en.kind == .Float && en.u8_val == 64_u8 && lane < 4_usize {
                    let half = try mf.new_vreg(alloc, .Vec128);
                    var ex = mach_ir.inst_empty(.VExtractF128, sp);
                    ex.dst = half;
                    ex.src0 = sloc.vreg0;
                    ex.imm = if lane < 2_usize { 0_i64 } else { 1_i64 };
                    ex.flag0 = true;
                    ex.size_bytes = 32_u8;
                    try mf.emit_inst(alloc, ex);
                    if (lane & 1_usize) == 0_usize {
                        try store_float_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, half, sp);
                    } else {
                        let res = try mf.new_vreg(alloc, .Vec128);
                        var sh = mach_ir.inst_empty(.VShufPS, sp);
                        sh.dst = res;
                        sh.src0 = half;
                        sh.src1 = half;
                        sh.imm = 0xEE_i64;
                        sh.size_bytes = 16_u8;
                        try mf.emit_inst(alloc, sh);
                        try store_float_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, res, sp);
                    }
                    return;
                }
                let sc = ensure_scratch_vec_off(ctx, mf);
                var st = mach_ir.inst_empty(.VMovUpsStore, sp);
                st.src0 = sloc.vreg0;
                st.mem = mach_ir.mem_stack_slot(sc);
                st.flag0 = true;
                st.size_bytes = 32_u8;
                try mf.emit_inst(alloc, st);
                let esz = env.x64_layout(src_n.primary).size;
                let dst_ty = eir_prog.fn_val_ty(ctx.fn_id, inst.dst);
                try load_val_from_mem(alloc, ctx, mf, eir_prog, env, inst.dst, mach_ir.mem_stack_slot(sc +% (lane *% esz).trunc.[i32]()), dst_ty, sp);
                return;
            }

            let foff = env.struct_field_offset(inst.ty1, inst.aux0.widen.[usize]());
            if sloc.kind == .Gpr {
                var v = sloc.vreg0;
                if foff.offset > 0_usize {
                    let sh = try mf.new_vreg(alloc, .Gpr);
                    try emit_alu_ri(alloc, mf, .ShrImm, sh, v, (foff.offset *% 8_usize).trunc.[i64](), sp);
                    v = sh;
                }
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, v, sp);
            } else if sloc.kind == .PairGpr {
                let v = if foff.offset == 0_usize { sloc.vreg0 } else { sloc.vreg1 };
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, v, sp);
            } else {
                try load_val_from_mem(alloc, ctx, mf, eir_prog, env, inst.dst, mach_ir.mem_stack_slot(sloc.stack_off +% foff.offset.trunc.[i32]()), inst.ty0, sp);
            }
            _ = 0_u8;
        }
        .MakeDyn => {
            let vt_sym = try intern_sym_u64_2(alloc, interner, "eon_vtable_", inst.aux0.widen.[u64](), inst.ty1.widen.[u64]());
            let dst_off = ctx_val_loc(ctx, inst.dst).stack_off;
            let dv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, inst.v0, false, sp);
            let vt = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(vt, mach_ir.mem_rip_sym(vt_sym, 0_i32), sp));
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off), dv, 8_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off +% 8_i32), vt, 8_usize, sp);
        }
        .MakeClosure => {
            let csym = try fn_sym_name_id(alloc, cfg_ir.fn_key_closure(inst.aux0), eir_prog, interner);
            let dst_off = ctx_val_loc(ctx, inst.dst).stack_off;
            let fn_p = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(fn_p, mach_ir.mem_rip_sym(csym, 0_i32), sp));
            let env_p = if inst.v0 != eir.EIR_NONE {
                try load_val_gpr(alloc, ctx, mf, eir_prog, env, inst.v0, false, sp)
            } else {
                try emit_imm_vreg(alloc, mf, 0_u64, sp)
            };
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off), fn_p, 8_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dst_off +% 8_i32), env_p, 8_usize, sp);
        }
        _ => {}
    }
    return;
}

// ===========================================================================
// Section 7: Function Calls (8-GP EonCall, SysV C, IPRA Clobbers, r15+CF)
// ===========================================================================

struct OutCallArg {
    val: eir.EirValue;
    ty: types.TyId;
    cls: ArgClass;
    is_reg: bool;
    gp_idx: usize;
    flt_idx: usize;
    stk_off: i32;
    v0: mach_ir.VReg;
    v1: mach_ir.VReg;
}

fn resolve_callee_fid(eir_prog: *eir.EirProgram, callee: eir.EirCallee) -> ?u32 {
    match callee.kind {
        .DirectFn => { return eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(callee.a)); }
        .Method => { return eir_prog.find_fn_by_key(cfg_ir.fn_key_impl_method(callee.a, callee.b)); }
        .GenericInst => { return eir_prog.find_fn_by_key(cfg_ir.fn_key_generic_inst(callee.a)); }
        _ => { return null; }
    }
}

fn emit_call_inst(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    call_id: u32,
    sp: span.Span,
) -> !OutOfMemory {
    try emit_call_inst_core(alloc, ctx, mf, eir_prog, env, interner, dst, call_id, sp, false, 0_u32, 0_u32);
    return;
}

fn emit_call_inst_core(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    call_id: u32,
    sp: span.Span,
    fused_eu_br: bool,
    br_err_mbb: u32,
    br_ok_mbb: u32,
) -> !OutOfMemory {
    let cd = eir_prog.get_call(call_id) orelse { return; };
    let callee = cd.callee;
    let args = eir_prog.vals_slice(cd.args);
    let ret_ty = cd.ret_ty;
    let rc = classify_ret(ret_ty, env);
    let uses_sret = ret_uses_sret(rc);

    var is_c = false;
    if callee.kind == .ExternFn {
        is_c = true;
    } else if callee.kind == .DirectFn {
        if let fid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(callee.a)) {
            if let f = eir_prog.get_fn(fid) {
                is_c = f.sig.effects.is_export_c;
            }
        }
    }

    var gp_i: usize = 0_usize;
    var flt_i: usize = 0_usize;
    var stk_bytes: usize = 0_usize;

    var sret_gp_idx: usize = 99_usize;
    if uses_sret {
        sret_gp_idx = gp_i;
        gp_i = gp_i +% 1_usize;
    }

    var env_gp_idx: usize = 99_usize;
    var dyn_gp_idx: usize = 99_usize;
    var start_arg: usize = 0_usize;
    if callee.kind == .FnPtr {
        env_gp_idx = gp_i;
        gp_i = gp_i +% 1_usize;
    } else if callee.kind == .DynCall {
        dyn_gp_idx = gp_i;
        gp_i = gp_i +% 1_usize;
        start_arg = 1_usize;
    }

    var plan = try col.DynBuf.[OutCallArg].init(alloc, if args.len > 4_usize { args.len } else { 4_usize });
    errdefer plan.destroy(alloc);

    var ai = start_arg;
    while ai < args.len {
        let av = args[ai];
        let aty = eir_prog.fn_val_ty(ctx.fn_id, av);
        let cls = classify_arg(aty, env);
        match cls {
            .Zst => {}
            .IntReg => {
                if gp_arg_phys(is_c, gp_i) != mach_ir.PHYS_NONE {
                    try plan.push(alloc, OutCallArg.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32, v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE });
                    gp_i = gp_i +% 1_usize;
                } else {
                    try plan.push(alloc, OutCallArg.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32](), v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE });
                    stk_bytes = stk_bytes +% 8_usize;
                }
                _ = 0_u8;
            }
            .TwoIntRegs => {
                if gp_arg_phys(is_c, gp_i) != mach_ir.PHYS_NONE && gp_arg_phys(is_c, gp_i +% 1_usize) != mach_ir.PHYS_NONE {
                    try plan.push(alloc, OutCallArg.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32, v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE });
                    gp_i = gp_i +% 2_usize;
                } else {
                    try plan.push(alloc, OutCallArg.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32](), v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE });
                    stk_bytes = stk_bytes +% 16_usize;
                }
                _ = 0_u8;
            }
            .FloatReg => {
                if flt_arg_phys(flt_i) != mach_ir.PHYS_NONE {
                    try plan.push(alloc, OutCallArg.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: 0_usize, flt_idx: flt_i, stk_off: 0_i32, v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE });
                    flt_i = flt_i +% 1_usize;
                } else {
                    try plan.push(alloc, OutCallArg.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32](), v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE });
                    stk_bytes = stk_bytes +% 8_usize;
                }
                _ = 0_u8;
            }
            .ByPtr => {
                if gp_arg_phys(is_c, gp_i) != mach_ir.PHYS_NONE {
                    try plan.push(alloc, OutCallArg.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32, v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE });
                    gp_i = gp_i +% 1_usize;
                } else {
                    try plan.push(alloc, OutCallArg.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32](), v0: mach_ir.VREG_NONE, v1: mach_ir.VREG_NONE });
                    stk_bytes = stk_bytes +% 8_usize;
                }
                _ = 0_u8;
            }
        }
        ai = ai +% 1_usize;
    }

    var discard_sret_bytes: usize = 0_usize;
    if uses_sret && dst == eir.EIR_NONE {
        let sret_ty = if rc.kind == .ErrorUnion { rc.ok_ty } else { ret_ty };
        discard_sret_bytes = types.align_up_usize(env.x64_layout(sret_ty).size, 16_usize);
        if discard_sret_bytes == 0_usize {
            discard_sret_bytes = 16_usize;
        }
    }
    let aligned_stk = types.align_up_usize(stk_bytes +% discard_sret_bytes, 16_usize);
    if aligned_stk > 0_usize {
        var sub_sp = mach_ir.inst_empty(.SubImm, sp);
        sub_sp.dst_phys = mach_ir.PHYS_RSP;
        sub_sp.src0_phys = mach_ir.PHYS_RSP;
        sub_sp.imm = aligned_stk.widen.[u64]().bitcast.[i64]();
        try mf.emit_inst(alloc, sub_sp);
    }

    // 1. Populate stack args & prepare VRegs for all register args
    let n_plan = plan.len();
    var pi: usize = 0_usize;
    while pi < n_plan {
        let plan_ro = plan.as_slice();
        if pi >= plan_ro.len { break; }
        let slot = plan_ro[pi];
        let lay = env.x64_layout(slot.ty);
        if !slot.is_reg {
            if slot.cls == .IntReg {
                let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, slot.val, true, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_phys_disp(mach_ir.PHYS_RSP, slot.stk_off), v, 8_usize, sp);
            } else if slot.cls == .TwoIntRegs {
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_phys_disp(mach_ir.PHYS_RSP, slot.stk_off), slot.val, slot.ty, sp);
            } else if slot.cls == .FloatReg {
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_phys_disp(mach_ir.PHYS_RSP, slot.stk_off), slot.val, slot.ty, sp);
            } else if slot.cls == .ByPtr {
                let soff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, slot.val, sp);
                let ptr_v = try mf.new_vreg(alloc, .Gpr);
                try mf.emit_inst(alloc, mach_ir.inst_lea(ptr_v, mach_ir.mem_stack_slot(soff), sp));
                try emit_store_mem(alloc, mf, mach_ir.mem_phys_disp(mach_ir.PHYS_RSP, slot.stk_off), ptr_v, 8_usize, sp);
            }
        } else {
            var v0 = mach_ir.VREG_NONE;
            var v1 = mach_ir.VREG_NONE;
            if slot.cls == .IntReg {
                v0 = try load_val_gpr(alloc, ctx, mf, eir_prog, env, slot.val, true, sp);
            } else if slot.cls == .TwoIntRegs {
                let loc = ctx_val_loc(ctx, slot.val);
                if loc.kind == .PairGpr {
                    v0 = loc.vreg0;
                    v1 = loc.vreg1;
                } else {
                    let soff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, slot.val, sp);
                    v0 = try mf.new_vreg(alloc, .Gpr);
                    v1 = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, v0, mach_ir.mem_stack_slot(soff), 8_usize, false, sp);
                    if lay.size > 8_usize {
                        try emit_load_mem(alloc, mf, v1, mach_ir.mem_stack_slot(soff +% 8_i32), lay.size - 8_usize, false, sp);
                    } else {
                        try emit_mov_imm(alloc, mf, v1, 0_u64, sp);
                    }
                }
            } else if slot.cls == .FloatReg {
                v0 = try load_val_float(alloc, ctx, mf, eir_prog, env, slot.val, sp);
            } else if slot.cls == .ByPtr {
                let soff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, slot.val, sp);
                v0 = try mf.new_vreg(alloc, .Gpr);
                try mf.emit_inst(alloc, mach_ir.inst_lea(v0, mach_ir.mem_stack_slot(soff), sp));
            }
            let pm = plan.as_mut_slice();
            if pi < pm.len {
                pm[pi].v0 = v0;
                pm[pi].v1 = v1;
            }
        }
        pi = pi +% 1_usize;
    }

    // Prepare sret, closure env, dyn data_ptr & indirect target VRegs
    var sret_ptr_v = mach_ir.VREG_NONE;
    if uses_sret {
        sret_ptr_v = try mf.new_vreg(alloc, .Gpr);
        if dst == eir.EIR_NONE {
            try mf.emit_inst(alloc, mach_ir.inst_lea(sret_ptr_v, mach_ir.mem_phys_disp(mach_ir.PHYS_RSP, stk_bytes.trunc.[i32]()), sp));
        } else {
            var sret_disp = ctx_val_loc(ctx, dst).stack_off;
            if rc.kind == .ErrorUnion {
                sret_disp = sret_disp +% env.eu_ok_offset(rc.ok_ty).trunc.[i32]();
            }
            try mf.emit_inst(alloc, mach_ir.inst_lea(sret_ptr_v, mach_ir.mem_stack_slot(sret_disp), sp));
        }
    }
    var env_v = mach_ir.VREG_NONE;
    var dyn_v = mach_ir.VREG_NONE;
    var indir_fn_v = mach_ir.VREG_NONE;
    if callee.kind == .FnPtr {
        let foff = ctx_val_loc(ctx, callee.a).stack_off;
        env_v = try mf.new_vreg(alloc, .Gpr);
        indir_fn_v = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, env_v, mach_ir.mem_stack_slot(foff +% 8_i32), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, indir_fn_v, mach_ir.mem_stack_slot(foff), 8_usize, false, sp);
    } else if callee.kind == .DynCall && args.len > 0_usize {
        let doff = ctx_val_loc(ctx, args[0_usize]).stack_off;
        dyn_v = try mf.new_vreg(alloc, .Gpr);
        let vt = try mf.new_vreg(alloc, .Gpr);
        indir_fn_v = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, dyn_v, mach_ir.mem_stack_slot(doff), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, vt, mach_ir.mem_stack_slot(doff +% 8_i32), 8_usize, false, sp);
        let mdisp = (callee.b.widen.[usize]() *% 8_usize).trunc.[i32]();
        try emit_load_mem(alloc, mf, indir_fn_v, mach_ir.mem_base_disp(vt, mdisp), 8_usize, false, sp);
    }

    // 2. Stage GP args 6 & 7 (R10/R11) to stack slots BEFORE UseFixed so regalloc scratch never collides!
    var has_r10_arg = false;
    var has_r11_arg = false;
    let ps = plan.as_slice();
    pi = 0_usize;
    while pi < ps.len {
        let slot = ps[pi];
        if slot.is_reg && (slot.cls == .IntReg || slot.cls == .ByPtr) {
            let p = gp_arg_phys(is_c, slot.gp_idx);
            if p == mach_ir.PHYS_R10 {
                let off6 = ensure_call_arg6_off(ctx, mf);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(off6), slot.v0, 8_usize, sp);
                has_r10_arg = true;
            } else if p == mach_ir.PHYS_R11 {
                let off7 = ensure_call_arg7_off(ctx, mf);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(off7), slot.v0, 8_usize, sp);
                has_r11_arg = true;
            }
        } else if slot.is_reg && slot.cls == .TwoIntRegs {
            let p0 = gp_arg_phys(is_c, slot.gp_idx);
            let p1 = gp_arg_phys(is_c, slot.gp_idx +% 1_usize);
            if p0 == mach_ir.PHYS_R10 {
                let off6 = ensure_call_arg6_off(ctx, mf);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(off6), slot.v0, 8_usize, sp);
                has_r10_arg = true;
            } else if p0 == mach_ir.PHYS_R11 {
                let off7 = ensure_call_arg7_off(ctx, mf);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(off7), slot.v0, 8_usize, sp);
                has_r11_arg = true;
            }
            if p1 == mach_ir.PHYS_R10 {
                let off6 = ensure_call_arg6_off(ctx, mf);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(off6), slot.v1, 8_usize, sp);
                has_r10_arg = true;
            } else if p1 == mach_ir.PHYS_R11 {
                let off7 = ensure_call_arg7_off(ctx, mf);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(off7), slot.v1, 8_usize, sp);
                has_r11_arg = true;
            }
        }
        pi = pi +% 1_usize;
    }

    // 3. Contiguous UseFixed run for Rdi..R9, Xmm0..Xmm7, and Rax (for indirect call target)!
    if uses_sret {
        let p = gp_arg_phys(is_c, sret_gp_idx);
        if p != mach_ir.PHYS_NONE {
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(sret_ptr_v, p, sp));
        }
    }
    if env_v != mach_ir.VREG_NONE {
        let p = gp_arg_phys(false, env_gp_idx);
        if p != mach_ir.PHYS_NONE {
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(env_v, p, sp));
        }
    }
    if dyn_v != mach_ir.VREG_NONE {
        let p = gp_arg_phys(false, dyn_gp_idx);
        if p != mach_ir.PHYS_NONE {
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(dyn_v, p, sp));
        }
    }
    pi = 0_usize;
    while pi < ps.len {
        let slot = ps[pi];
        if slot.is_reg {
            if slot.cls == .IntReg || slot.cls == .ByPtr {
                let p = gp_arg_phys(is_c, slot.gp_idx);
                if p != mach_ir.PHYS_NONE && p != mach_ir.PHYS_R10 && p != mach_ir.PHYS_R11 {
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(slot.v0, p, sp));
                }
            } else if slot.cls == .TwoIntRegs {
                let p0 = gp_arg_phys(is_c, slot.gp_idx);
                let p1 = gp_arg_phys(is_c, slot.gp_idx +% 1_usize);
                if p0 != mach_ir.PHYS_NONE && p0 != mach_ir.PHYS_R10 && p0 != mach_ir.PHYS_R11 {
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(slot.v0, p0, sp));
                }
                if p1 != mach_ir.PHYS_NONE && p1 != mach_ir.PHYS_R10 && p1 != mach_ir.PHYS_R11 {
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(slot.v1, p1, sp));
                }
            } else if slot.cls == .FloatReg {
                let fp = flt_arg_phys(slot.flt_idx);
                if fp != mach_ir.PHYS_NONE {
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(slot.v0, fp, sp));
                }
            }
        }
        pi = pi +% 1_usize;
    }
    if indir_fn_v != mach_ir.VREG_NONE {
        try mf.emit_inst(alloc, mach_ir.inst_use_fixed(indir_fn_v, mach_ir.PHYS_RAX, sp));
    }

    // 4. Reload R10/R11 immediately before Call (zero interference with regalloc!)
    if has_r10_arg {
        try mf.emit_inst(alloc, mach_ir.inst_load_phys(mach_ir.PHYS_R10, mach_ir.mem_stack_slot(ctx.call_arg6_off), 8_u8, sp));
    }
    if has_r11_arg {
        try mf.emit_inst(alloc, mach_ir.inst_load_phys(mach_ir.PHYS_R11, mach_ir.mem_stack_slot(ctx.call_arg7_off), 8_u8, sp));
    }

    // 5. Compute IPRA clobber masks (Domain Super-Opt #4!)
    var clob_gprs: u32 = if rc.kind == .ErrorUnion { mach_ir.EON_CALL_ERR_CLOBBER_GPRS } else { mach_ir.CALLER_SAVED_GPRS_MASK };
    var clob_xmms: u32 = mach_ir.CALLER_SAVED_XMMS_MASK;
    if !ctx.cfg.incremental_cgu {
        if let callee_fid = resolve_callee_fid(eir_prog, callee) {
            if eir_prog.fn_has_ipra(callee_fid) {
                clob_gprs = eir_prog.fn_ipra_gprs(callee_fid);
                clob_xmms = eir_prog.fn_ipra_xmms(callee_fid);
            }
        }
    }
    // Always include return channels & scratch regs used in clobbers for 100% soundness
    clob_gprs = clob_gprs | mach_ir.phys_bit(mach_ir.PHYS_RAX);
    if rc.kind == .TwoIntRegs || (rc.kind == .ErrorUnion && rc.ok_kind == .TwoIntRegs) {
        clob_gprs = clob_gprs | mach_ir.phys_bit(mach_ir.PHYS_RDX);
    }
    if rc.kind == .ErrorUnion {
        clob_gprs = clob_gprs | mach_ir.phys_bit(mach_ir.PHYS_R15);
    }
    if rc.kind == .FloatReg || (rc.kind == .ErrorUnion && rc.ok_kind == .FloatReg) {
        clob_xmms = clob_xmms | mach_ir.phys_bit(PHYS_XMM0);
    }
    if has_r10_arg { clob_gprs = clob_gprs | mach_ir.phys_bit(mach_ir.PHYS_R10); }
    if has_r11_arg { clob_gprs = clob_gprs | mach_ir.phys_bit(mach_ir.PHYS_R11); }

    // 6. Emit the call instruction
    match callee.kind {
        .DirectFn => {
            let sym = try fn_sym_name_id(alloc, cfg_ir.fn_key_top_def(callee.a), eir_prog, interner);
            try mf.emit_inst(alloc, mach_ir.inst_call_sym(sym, clob_gprs, clob_xmms, sp));
        }
        .Method => {
            let sym = try fn_sym_name_id(alloc, cfg_ir.fn_key_impl_method(callee.a, callee.b), eir_prog, interner);
            try mf.emit_inst(alloc, mach_ir.inst_call_sym(sym, clob_gprs, clob_xmms, sp));
        }
        .GenericInst => {
            let sym = try fn_sym_name_id(alloc, cfg_ir.fn_key_generic_inst(callee.a), eir_prog, interner);
            try mf.emit_inst(alloc, mach_ir.inst_call_sym(sym, clob_gprs, clob_xmms, sp));
        }
        .ExternFn => {
            let ext_sym = callee.b;
            let name_bytes = interner.get(ext_sym);
            var ci = mach_ir.inst_call_sym(ext_sym, clob_gprs, clob_xmms, sp);
            if is_builtin_rt_helper(name_bytes) {
                try mf.add_used_helper(alloc, ext_sym);
            } else if ctx.is_linux {
                ci.imm = 3_i64; // Plt32
            }
            try mf.emit_inst(alloc, ci);
        }
        .DynCall => {
            var cr = mach_ir.inst_empty(.CallReg, sp);
            cr.src0_phys = mach_ir.PHYS_RAX;
            cr.clobber_gprs = clob_gprs;
            cr.clobber_xmms = clob_xmms;
            try mf.emit_inst(alloc, cr);
        }
        .FnPtr => {
            var cr = mach_ir.inst_empty(.CallReg, sp);
            cr.src0_phys = mach_ir.PHYS_RAX;
            cr.clobber_gprs = clob_gprs;
            cr.clobber_xmms = clob_xmms;
            try mf.emit_inst(alloc, cr);
        }
    }

    // 7. Restore stack WITHOUT clobbering RFLAGS (LEA preserves CF for ErrorUnion!)
    if aligned_stk > 0_usize {
        try mf.emit_inst(alloc, mach_ir.inst_lea_phys(mach_ir.PHYS_RSP, mach_ir.mem_phys_disp(mach_ir.PHYS_RSP, aligned_stk.trunc.[i32]()), sp));
    }

    // 8. Capture return value
    if dst != eir.EIR_NONE {
        let lay = env.x64_layout(ret_ty);
        let dloc = ctx_val_loc(ctx, dst);
        match rc.kind {
            .Void => {}
            .IntReg => {
                let rv = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
                try mf.emit_inst(alloc, mach_ir.inst_def_fixed(rv, mach_ir.PHYS_RAX, sp));
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, rv, sp);
            }
            .TwoIntRegs => {
                let r0 = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
                let r1 = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RDX);
                try mf.emit_inst(alloc, mach_ir.inst_def_fixed(r0, mach_ir.PHYS_RAX, sp));
                try mf.emit_inst(alloc, mach_ir.inst_def_fixed(r1, mach_ir.PHYS_RDX, sp));
                if dloc.kind == .PairGpr {
                    try mf.emit_inst(alloc, mach_ir.inst_copy(dloc.vreg0, r0, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_copy(dloc.vreg1, r1, sp));
                } else if dloc.kind == .Vec128 {
                    let sc = ensure_scratch_vec_off(ctx, mf);
                    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(sc), r0, 8_usize, sp);
                    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(sc +% 8_i32), r1, 8_usize, sp);
                    var ld = mach_ir.inst_empty(.VMovUpsLoad, sp);
                    ld.dst = dloc.vreg0;
                    ld.mem = mach_ir.mem_stack_slot(sc);
                    ld.size_bytes = 16_u8;
                    try mf.emit_inst(alloc, ld);
                } else if dloc.kind == .Stack {
                    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dloc.stack_off), r0, 8_usize, sp);
                    if lay.size > 8_usize {
                        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dloc.stack_off +% 8_i32), r1, lay.size - 8_usize, sp);
                    }
                }
                _ = 0_u8;
            }
            .FloatReg => {
                let rv = try mf.new_vreg_hint(alloc, .Vec128, PHYS_XMM0);
                try mf.emit_inst(alloc, mach_ir.inst_def_fixed(rv, PHYS_XMM0, sp));
                try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, rv, sp);
            }
            .Sret => {}
            .ErrorUnion => {
                if dloc.kind == .PairGpr {
                    if fused_eu_br {
                        // Fused `Branch(IsError(Call(...)))` -> `call; jb cold_err;` with zero stack slots!
                        let b_err_c = try mf.add_block(alloc, 0_u8);
                        if rc.ok_kind == .Void {
                            try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, b_err_c, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(br_ok_mbb, sp));
                            mf.end_block_insts(ctx.cur_mbb);
                        } else {
                            let b_ok_c = try mf.add_block(alloc, ctx.cur_depth);
                            try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, b_err_c, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok_c, sp));
                            mf.end_block_insts(ctx.cur_mbb);

                            mf.begin_block_insts(b_ok_c);
                            if rc.ok_kind == .IntReg {
                                let r0 = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
                                try mf.emit_inst(alloc, mach_ir.inst_def_fixed(r0, mach_ir.PHYS_RAX, sp));
                                try mf.emit_inst(alloc, mach_ir.inst_copy(dloc.vreg1, r0, sp));
                            }
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(br_ok_mbb, sp));
                            mf.end_block_insts(b_ok_c);
                        }

                        mf.begin_block_insts(b_err_c);
                        let err_v = try mf.new_vreg(alloc, .Gpr);
                        try mf.emit_inst(alloc, mach_ir.inst_def_fixed(err_v, mach_ir.PHYS_R15, sp));
                        try mf.emit_inst(alloc, mach_ir.inst_copy(dloc.vreg0, err_v, sp));
                        try mf.emit_inst(alloc, mach_ir.inst_jmp(br_err_mbb, sp));
                        mf.end_block_insts(b_err_c);
                    } else {
                        let b_ok = try mf.add_block(alloc, ctx.cur_depth);
                        let b_err = try mf.add_block(alloc, 0_u8);
                        let b_done = try mf.add_block(alloc, ctx.cur_depth);
                        try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, b_err, sp));
                        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
                        mf.end_block_insts(ctx.cur_mbb);

                        mf.begin_block_insts(b_ok);
                        if rc.ok_kind == .IntReg {
                            let r0 = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
                            try mf.emit_inst(alloc, mach_ir.inst_def_fixed(r0, mach_ir.PHYS_RAX, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_copy(dloc.vreg1, r0, sp));
                        }
                        try emit_mov_imm(alloc, mf, dloc.vreg0, 0_u64, sp);
                        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
                        mf.end_block_insts(b_ok);

                        mf.begin_block_insts(b_err);
                        let err_v = try mf.new_vreg(alloc, .Gpr);
                        try mf.emit_inst(alloc, mach_ir.inst_def_fixed(err_v, mach_ir.PHYS_R15, sp));
                        try mf.emit_inst(alloc, mach_ir.inst_copy(dloc.vreg0, err_v, sp));
                        if rc.ok_kind == .IntReg {
                            try emit_mov_imm(alloc, mf, dloc.vreg1, 0_u64, sp);
                        }
                        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
                        mf.end_block_insts(b_err);

                        mf.begin_block_insts(b_done);
                        ctx.cur_mbb = b_done;
                    }
                    _ = 0_u8;
                } else {
                    let b_ok = try mf.add_block(alloc, ctx.cur_depth);
                    let b_err = try mf.add_block(alloc, ctx.cur_depth);
                    let b_done = try mf.add_block(alloc, ctx.cur_depth);
                    let doff = dloc.stack_off;
                    try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, b_err, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
                    mf.end_block_insts(ctx.cur_mbb);

                    mf.begin_block_insts(b_ok);
                    let ok_off = env.eu_ok_offset(rc.ok_ty).trunc.[i32]();
                    let ok_lay = env.x64_layout(rc.ok_ty);
                    match rc.ok_kind {
                        .Void => {}
                        .IntReg => {
                            let r0 = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
                            try mf.emit_inst(alloc, mach_ir.inst_def_fixed(r0, mach_ir.PHYS_RAX, sp));
                            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), r0, ok_lay.size, sp);
                        }
                        .TwoIntRegs => {
                            let r0 = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
                            let r1 = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RDX);
                            try mf.emit_inst(alloc, mach_ir.inst_def_fixed(r0, mach_ir.PHYS_RAX, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_def_fixed(r1, mach_ir.PHYS_RDX, sp));
                            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), r0, 8_usize, sp);
                            if ok_lay.size > 8_usize {
                                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), r1, ok_lay.size - 8_usize, sp);
                            }
                        }
                        .FloatReg => {
                            let rx = try mf.new_vreg_hint(alloc, .Vec128, PHYS_XMM0);
                            try mf.emit_inst(alloc, mach_ir.inst_def_fixed(rx, PHYS_XMM0, sp));
                            let is_f64 = env.get(rc.ok_ty).u8_val == 64_u8;
                            var st = mach_ir.inst_empty(if is_f64 { .VMovSDStore } else { .VMovSSStore }, sp);
                            st.src0 = rx;
                            st.mem = mach_ir.mem_stack_slot(doff +% ok_off);
                            st.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
                            try mf.emit_inst(alloc, st);
                        }
                        .Sret => {}
                        .ErrorUnion => {}
                    }
                    try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
                    mf.end_block_insts(b_ok);

                    mf.begin_block_insts(b_err);
                    let err_v = try mf.new_vreg(alloc, .Gpr);
                    try mf.emit_inst(alloc, mach_ir.inst_def_fixed(err_v, mach_ir.PHYS_R15, sp));
                    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff), err_v, 4_usize, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
                    mf.end_block_insts(b_err);

                    mf.begin_block_insts(b_done);
                    ctx.cur_mbb = b_done;
                    _ = 0_u8;
                }
                _ = 0_u8;
            }
        }
    }

    plan.destroy(alloc);
    return;
}

// ===========================================================================
// Section 8: Fast Builtins (Inline Bump-Ptr Arena, Uninit BufInit, Hardware Math & AVX2 Vec)
// ===========================================================================

fn get_arg_slot(arg_slots: *[eir.EirSlot], idx: usize) -> eir.EirSlot {
    if idx < arg_slots.len {
        return arg_slots[idx];
    }
    return eir.EIR_NONE;
}

fn pool_ncols_from_ty(env: *types.TypeEnv, elem_ty: types.TyId) -> usize {
    let n = env.get(elem_ty);
    if n.kind == .Pool {
        if let pm = env.get_pool(n.primary) {
            return pm.columns.len.widen.[usize]();
        }
    }
    return 0_usize;
}

fn pool_ncols_from_arg_ty(env: *types.TypeEnv, arg_ty: types.TyId) -> usize {
    var cur = arg_ty;
    let n0 = env.get(cur);
    if n0.kind == .Borrow && n0.borrow_kind == .Single {
        cur = n0.primary;
    }
    let n1 = env.get(cur);
    if n1.kind == .Builtin {
        return env.pool_col_count(env.node_gval_list(&n1));
    }
    return 0_usize;
}

fn array_len_from_arg(eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, v: eir.EirValue) -> u64 {
    var ty = eir_prog.fn_val_ty(fn_id, v);
    let n0 = env.get(ty);
    if n0.kind == .Borrow && n0.borrow_kind == .Single {
        ty = n0.primary;
    }
    let n1 = env.get(ty);
    if n1.kind == .Array {
        return n1.u64_val;
    }
    return 0_u64;
}

fn emit_call_alloc_raw(
    alloc: *mut AllocCap,
    ctx: *IselCtx,
    mf: *mut mach_ir.MachFunc,
    interner: *mut span.SymInterner,
    alloc_ptr: mach_ir.VReg,
    size_v: mach_ir.VReg,
    align_v: mach_ir.VReg,
    uninit: bool,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(alloc_ptr, mach_ir.PHYS_RDI, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(size_v, mach_ir.PHYS_RSI, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(align_v, mach_ir.PHYS_RDX, sp));
    if ctx.sanitize {
        try emit_helper_call(alloc, mf, interner, "eon_alloc_raw_san", sp);
    } else if uninit {
        try emit_helper_call(alloc, mf, interner, "eon_alloc_raw_uninit", sp);
    } else {
        try emit_helper_call(alloc, mf, interner, "eon_alloc_raw", sp);
    }
    let ret_v = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
    try mf.emit_inst(alloc, mach_ir.inst_def_fixed(ret_v, mach_ir.PHYS_RAX, sp));
    return ret_v;
}

fn emit_call_free_raw(
    alloc: *mut AllocCap,
    ctx: *IselCtx,
    mf: *mut mach_ir.MachFunc,
    interner: *mut span.SymInterner,
    alloc_ptr: mach_ir.VReg,
    ptr_v: mach_ir.VReg,
    size_v: mach_ir.VReg,
    sp: span.Span,
) -> !OutOfMemory {
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(alloc_ptr, mach_ir.PHYS_RDI, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(ptr_v, mach_ir.PHYS_RSI, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(size_v, mach_ir.PHYS_RDX, sp));
    if ctx.sanitize {
        try emit_helper_call(alloc, mf, interner, "eon_free_raw_san", sp);
    } else {
        try emit_helper_call(alloc, mf, interner, "eon_free_raw", sp);
    }
    return;
}

fn emit_builtin_arena(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    match op.kind {
        .ArenaInit => {
            if args.len < 2_usize { return; }
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let a_ptr = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let cap_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            let al_v = try emit_imm_vreg(alloc, mf, 64_u64, sp);
            let raw_p = try emit_call_alloc_raw(alloc, ctx, mf, interner, a_ptr, cap_v, al_v, false, sp);

            let b_chk_zero = try mf.add_block(alloc, ctx.cur_depth);
            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_oom = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_test_rr(alloc, mf, raw_p, raw_p, false, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, b_ok, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_zero, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_chk_zero);
            try emit_test_rr(alloc, mf, cap_v, cap_v, false, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_ok, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_oom, sp));
            mf.end_block_insts(b_chk_zero);

            mf.begin_block_insts(b_oom);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 7_i64, 4_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oom);

            mf.begin_block_insts(b_ok);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), raw_p, 8_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), cap_v, 8_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 16_i32), 0_i64, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .ArenaAlloc => {
            if args.len < 2_usize { return; }
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let arena_ptr = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let req_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);

            if ctx.sanitize {
                let al_v = try emit_imm_vreg(alloc, mf, 16_u64, sp);
                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(arena_ptr, mach_ir.PHYS_RDI, sp));
                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(req_v, mach_ir.PHYS_RSI, sp));
                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(al_v, mach_ir.PHYS_RDX, sp));
                try emit_helper_call(alloc, mf, interner, "eon_arena_alloc_aligned", sp);
                let out_p = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
                try mf.emit_inst(alloc, mach_ir.inst_def_fixed(out_p, mach_ir.PHYS_RAX, sp));

                let b_chk_z = try mf.add_block(alloc, ctx.cur_depth);
                let b_ok = try mf.add_block(alloc, ctx.cur_depth);
                let b_oom = try mf.add_block(alloc, ctx.cur_depth);
                let b_done = try mf.add_block(alloc, ctx.cur_depth);

                try emit_test_rr(alloc, mf, out_p, out_p, false, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, b_ok, sp));
                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_z, sp));
                mf.end_block_insts(ctx.cur_mbb);

                mf.begin_block_insts(b_chk_z);
                try emit_test_rr(alloc, mf, req_v, req_v, false, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_ok, sp));
                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_oom, sp));
                mf.end_block_insts(b_chk_z);

                mf.begin_block_insts(b_oom);
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 7_i64, 4_usize, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
                mf.end_block_insts(b_oom);

                mf.begin_block_insts(b_ok);
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), out_p, 8_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), req_v, 8_usize, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
                mf.end_block_insts(b_ok);

                mf.begin_block_insts(b_done);
                ctx.cur_mbb = b_done;
                return;
            }

            // FAST INLINE BUMP-POINTER ARENA ALLOC (ZERO call overhead, exact overflow-free check!)
            let base_p = try mf.new_vreg(alloc, .Gpr);
            let cap_v = try mf.new_vreg(alloc, .Gpr);
            let pos_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, base_p, mach_ir.mem_base_disp(arena_ptr, 0_i32), 8_usize, false, sp);
            try emit_load_mem(alloc, mf, cap_v, mach_ir.mem_base_disp(arena_ptr, 8_i32), 8_usize, false, sp);
            try emit_load_mem(alloc, mf, pos_v, mach_ir.mem_base_disp(arena_ptr, 16_i32), 8_usize, false, sp);

            let b_chk_req = try mf.add_block(alloc, ctx.cur_depth);
            let b_chk_cur = try mf.add_block(alloc, ctx.cur_depth);
            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_zero_or_oom = try mf.add_block(alloc, ctx.cur_depth);
            let b_ok_zero = try mf.add_block(alloc, ctx.cur_depth);
            let b_oom = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_test_rr(alloc, mf, base_p, base_p, false, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_zero_or_oom, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_req, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_chk_req);
            try emit_cmp_rr(alloc, mf, req_v, cap_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_oom, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_cur, sp));
            mf.end_block_insts(b_chk_req);

            mf.begin_block_insts(b_chk_cur);
            let pos15 = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(pos15, mach_ir.mem_base_disp(pos_v, 15_i32), sp));
            let cur_v = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_ri(alloc, mf, .AndImm, cur_v, pos15, -16_i64, sp);
            let max_cur = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Sub, max_cur, cap_v, req_v, sp);
            try emit_cmp_rr(alloc, mf, cur_v, max_cur, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_zero_or_oom, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(b_chk_cur);

            mf.begin_block_insts(b_ok);
            let out_p = try mf.new_vreg(alloc, .Gpr);
            let nxt_pos = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(out_p, mach_ir.mem_sib(base_p, cur_v, 1_u8, 0_i32), sp));
            try mf.emit_inst(alloc, mach_ir.inst_lea(nxt_pos, mach_ir.mem_sib(cur_v, req_v, 1_u8, 0_i32), sp));
            try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(arena_ptr, 16_i32), nxt_pos, 8_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), out_p, 8_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), req_v, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_zero_or_oom);
            try emit_test_rr(alloc, mf, req_v, req_v, false, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_ok_zero, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_oom, sp));
            mf.end_block_insts(b_zero_or_oom);

            mf.begin_block_insts(b_ok_zero);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), 0_i64, 8_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), 0_i64, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok_zero);

            mf.begin_block_insts(b_oom);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 7_i64, 4_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oom);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .ArenaReset => {
            if args.len == 0_usize { return; }
            let arena_ptr = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            if ctx.sanitize {
                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(arena_ptr, mach_ir.PHYS_RDI, sp));
                try emit_helper_call(alloc, mf, interner, "eon_rt_arena_reset_san", sp);
            } else {
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_base_disp(arena_ptr, 16_i32), 0_i64, 8_usize, sp);
            }
            _ = 0_u8;
        }
        .ArenaDestroy => {
            if args.len < 2_usize { return; }
            let arena_ptr = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let alloc_ptr = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[1_usize], get_arg_slot(arg_slots, 1_usize), sp);
            let base_p = try mf.new_vreg(alloc, .Gpr);
            let cap_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, base_p, mach_ir.mem_base_disp(arena_ptr, 0_i32), 8_usize, false, sp);
            try emit_load_mem(alloc, mf, cap_v, mach_ir.mem_base_disp(arena_ptr, 8_i32), 8_usize, false, sp);
            try emit_call_free_raw(alloc, ctx, mf, interner, alloc_ptr, base_p, cap_v, sp);
        }
        .ArenaUsedBytes => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, 16_i32), 8_usize, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .ArenaCapacity => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, 8_i32), 8_usize, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .AllocCapLiveAllocs => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, 0_i32), 8_usize, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .AllocCapUsedBytes => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, 8_i32), 8_usize, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .AllocCapPeakBytes => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, 16_i32), 8_usize, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        _ => {}
    }
    return;
}

fn emit_builtin_arena_pool(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    inst_gid: u32,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let proven_safe = (eir_prog.inst_proven_flags(inst_gid) & eir.PROVEN_BOUNDS_SAFE) != 0_u8;
    match op.kind {
        .ArenaPoolInit => {
            if args.len == 0_usize { return; }
            let pdef = env.get(op.ty0).primary;
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let ncols = pool_ncols_from_ty(env, op.ty0);
            try emit_memzero(alloc, mf, mach_ir.mem_stack_slot(doff), env.x64_layout(ret_ty).size, sp);

            let cap_off = mf.alloc_stack_slot(8_usize, 8_usize);
            let arena_off = mf.alloc_stack_slot(8_usize, 8_usize);
            let arena_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(arena_off), arena_p, 8_usize, sp);
            var cap_v = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            if args.len > 1_usize {
                cap_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], false, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% ((ncols +% 1_usize) *% 8_usize).trunc.[i32]()), cap_v, 8_usize, sp);
            }
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(cap_off), cap_v, 8_usize, sp);

            let b_fail = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let esz_raw = env.x64_layout_impl(cols[ci].ty, false).size;
                    let esz = if esz_raw == 0_usize { 1_usize } else { esz_raw };
                    let ap_r = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, ap_r, mach_ir.mem_stack_slot(arena_off), 8_usize, false, sp);
                    let cnt_raw = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, cnt_raw, mach_ir.mem_stack_slot(cap_off), 8_usize, false, sp);
                    let one_v = try emit_imm_vreg(alloc, mf, 1_u64, sp);
                    let cnt_nz = try mf.new_vreg(alloc, .Gpr);
                    try mf.emit_inst(alloc, mach_ir.inst_copy(cnt_nz, cnt_raw, sp));
                    try emit_test_rr(alloc, mf, cnt_raw, cnt_raw, false, sp);
                    var cm = mach_ir.inst_empty(.Cmov, sp);
                    cm.dst = cnt_nz;
                    cm.src0 = cnt_nz;
                    cm.src1 = one_v;
                    cm.cc = .E;
                    cm.tied_src0 = true;
                    try mf.emit_inst(alloc, cm);

                    var sz_v = cnt_nz;
                    if esz != 1_usize {
                        sz_v = try emit_scale_index(alloc, mf, cnt_nz, esz, sp);
                    }
                    // 64B cache-line coloring: when `cap * esz` is a 4K multiple (e.g. 16384*4 = 65536B),
                    // pad by +64B so consecutive SoA columns land in distinct L1d sets & 4K page offsets!
                    let sz_pad = try mf.new_vreg(alloc, .Gpr);
                    try mf.emit_inst(alloc, mach_ir.inst_lea(sz_pad, mach_ir.mem_base_disp(sz_v, 64_i32), sp));
                    let sz_rem = try mf.new_vreg(alloc, .Gpr);
                    try emit_alu_ri(alloc, mf, .AndImm, sz_rem, sz_v, 4095_i64, sp);
                    try emit_test_rr(alloc, mf, sz_rem, sz_rem, false, sp);
                    let sz_col = try mf.new_vreg(alloc, .Gpr);
                    try emit_cmov(alloc, mf, .E, sz_col, sz_v, sz_pad, sp);
                    sz_v = sz_col;
                    let al_v = try emit_imm_vreg(alloc, mf, 64_u64, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(ap_r, mach_ir.PHYS_RDI, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(sz_v, mach_ir.PHYS_RSI, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(al_v, mach_ir.PHYS_RDX, sp));
                    try emit_helper_call(alloc, mf, interner, "eon_arena_alloc_aligned", sp);
                    let col_p = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
                    try mf.emit_inst(alloc, mach_ir.inst_def_fixed(col_p, mach_ir.PHYS_RAX, sp));

                    let b_next = try mf.add_block(alloc, ctx.cur_depth);
                    try emit_test_rr(alloc, mf, col_p, col_p, false, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_fail, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_next, sp));
                    mf.end_block_insts(ctx.cur_mbb);

                    mf.begin_block_insts(b_next);
                    ctx.cur_mbb = b_next;
                    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% (ci *% 8_usize).trunc.[i32]()), col_p, 8_usize, sp);
                    ci = ci +% 1_usize;
                }
            }
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_fail);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 7_i64, 4_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_fail);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .ArenaPoolPush => {
            if args.len == 0_usize { return; }
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let dloc = ctx_val_loc(ctx, dst);
            let doff = dloc.stack_off;
            let ok_off = env.eu_ok_offset(types.TY_U32).trunc.[i32]();
            let pool_arg_slot = get_arg_slot(arg_slots, 0_usize);
            let pool_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], pool_arg_slot, sp);
            let cur_len = try mf.new_vreg(alloc, .Gpr);
            let len_off = (ncols *% 8_usize).trunc.[i32]();
            let cap_off = ((ncols +% 1_usize) *% 8_usize).trunc.[i32]();
            try emit_load_mem(alloc, mf, cur_len, mach_ir.mem_base_disp(pool_p, len_off), 8_usize, false, sp);
            var cur_cap = if pool_arg_slot == eir.EIR_NONE {
                find_hoisted_pool_col(ctx, args[0_usize], cap_off)
            } else {
                mach_ir.VREG_NONE
            };
            if cur_cap == mach_ir.VREG_NONE {
                cur_cap = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, cur_cap, mach_ir.mem_base_disp(pool_p, cap_off), 8_usize, false, sp);
            }

            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_oom = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_cmp_rr(alloc, mf, cur_len, cur_cap, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_oom, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_ok);
            let nxt_len = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(nxt_len, mach_ir.mem_base_disp(cur_len, 1_i32), sp));
            try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(pool_p, len_off), nxt_len, 8_usize, sp);
            if args.len > 1_usize {
                let row_v = args[1_usize];
                var did_direct_agg = false;
                if ctx_should_skip(ctx, row_v) {
                    let agid = ctx_def_inst_gid(ctx, row_v);
                    let all_i = eir_prog.funcs.insts.as_slice();
                    if agid != eir.EIR_NONE && agid.widen.[usize]() < all_i.len {
                        let ai = all_i[agid.widen.[usize]()];
                        if ai.kind == .Aggregate {
                            let elems = eir_prog.vals_slice(ai.range);
                            if let pm = env.get_pool(pdef) {
                                let cols = env.pool_cols_range(pm.columns);
                                if elems.len == cols.len {
                                    did_direct_agg = true;
                                    var ci: usize = 0_usize;
                                    while ci < cols.len {
                                        let esz_r = env.x64_layout_impl(cols[ci].ty, false).size;
                                        let col_esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                                        let col_hdr_off = (ci *% 8_usize).trunc.[i32]();
                                        var col_p = if pool_arg_slot == eir.EIR_NONE {
                                            find_hoisted_pool_col(ctx, args[0_usize], col_hdr_off)
                                        } else {
                                            mach_ir.VREG_NONE
                                        };
                                        if col_p == mach_ir.VREG_NONE {
                                            col_p = try mf.new_vreg(alloc, .Gpr);
                                            try emit_load_mem(alloc, mf, col_p, mach_ir.mem_base_disp(pool_p, col_hdr_off), 8_usize, false, sp);
                                        }
                                        var dst_mem = mach_ir.mem_none();
                                        if col_esz == 1_usize || col_esz == 2_usize || col_esz == 4_usize || col_esz == 8_usize {
                                            dst_mem = mach_ir.mem_sib(col_p, cur_len, col_esz.trunc.[u8](), 0_i32);
                                        } else {
                                            let sc = try emit_scale_index(alloc, mf, cur_len, col_esz, sp);
                                            let dst_addr = try mf.new_vreg(alloc, .Gpr);
                                            try mf.emit_inst(alloc, mach_ir.inst_lea(dst_addr, mach_ir.mem_sib(col_p, sc, 1_u8, 0_i32), sp));
                                            dst_mem = mach_ir.mem_base_disp(dst_addr, 0_i32);
                                        }
                                        if col_esz == 4_usize && env.is_link_or_opt_link(cols[ci].ty) {
                                            let lv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, elems[ci], false, sp);
                                            try emit_store_mem(alloc, mf, dst_mem, lv, 4_usize, sp);
                                        } else {
                                            try store_val_to_mem(alloc, ctx, mf, eir_prog, env, dst_mem, elems[ci], cols[ci].ty, sp);
                                        }
                                        ci = ci +% 1_usize;
                                    }
                                }
                            }
                        }
                    }
                }
                if !did_direct_agg {
                    let row_off = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, row_v, sp);
                    let row_ty = eir_prog.fn_val_ty(ctx.fn_id, row_v);
                    if let pm = env.get_pool(pdef) {
                        let cols = env.pool_cols_range(pm.columns);
                        var ci: usize = 0_usize;
                        while ci < cols.len {
                            let foff = env.struct_field_offset(row_ty, ci).offset;
                            let esz_r = env.x64_layout_impl(cols[ci].ty, false).size;
                            let col_esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                            let col_hdr_off = (ci *% 8_usize).trunc.[i32]();
                            var col_p = if pool_arg_slot == eir.EIR_NONE {
                                find_hoisted_pool_col(ctx, args[0_usize], col_hdr_off)
                            } else {
                                mach_ir.VREG_NONE
                            };
                            if col_p == mach_ir.VREG_NONE {
                                col_p = try mf.new_vreg(alloc, .Gpr);
                                try emit_load_mem(alloc, mf, col_p, mach_ir.mem_base_disp(pool_p, col_hdr_off), 8_usize, false, sp);
                            }
                            if col_esz == 1_usize || col_esz == 2_usize || col_esz == 4_usize || col_esz == 8_usize {
                                let tv = try mf.new_vreg(alloc, .Gpr);
                                try emit_load_mem(alloc, mf, tv, mach_ir.mem_stack_slot(row_off +% foff.trunc.[i32]()), col_esz, false, sp);
                                try emit_store_mem(alloc, mf, mach_ir.mem_sib(col_p, cur_len, col_esz.trunc.[u8](), 0_i32), tv, col_esz, sp);
                            } else {
                                let sc = try emit_scale_index(alloc, mf, cur_len, col_esz, sp);
                                let dst_addr = try mf.new_vreg(alloc, .Gpr);
                                try mf.emit_inst(alloc, mach_ir.inst_lea(dst_addr, mach_ir.mem_sib(col_p, sc, 1_u8, 0_i32), sp));
                                try emit_copy_mem(alloc, mf, mach_ir.mem_base_disp(dst_addr, 0_i32), mach_ir.mem_stack_slot(row_off +% foff.trunc.[i32]()), col_esz, sp);
                            }
                            ci = ci +% 1_usize;
                        }
                    }
                }
            }
            if dloc.kind == .PairGpr {
                try emit_mov_imm(alloc, mf, dloc.vreg0, 0_u64, sp);
                try emit_extend(alloc, mf, dloc.vreg1, cur_len, 4_u8, false, sp);
            } else {
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), cur_len, 4_usize, sp);
            }
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_oom);
            if dloc.kind == .PairGpr {
                try emit_mov_imm(alloc, mf, dloc.vreg0, 7_u64, sp);
                try emit_mov_imm(alloc, mf, dloc.vreg1, 0xFFFFFFFF_u64, sp);
            } else {
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 7_i64, 4_usize, sp);
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), -1_i64, 4_usize, sp);
            }
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oom);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .ArenaPoolIdAt => {
            if args.len < 2_usize { return; }
            let dloc = ctx_val_loc(ctx, dst);
            let doff = dloc.stack_off;
            let ok_off = env.eu_ok_offset(types.TY_U32).trunc.[i32]();
            let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            if proven_safe {
                // DBM PROVEN_BOUNDS_SAFE: ZERO bounds check!
                if dloc.kind == .PairGpr {
                    try emit_mov_imm(alloc, mf, dloc.vreg0, 0_u64, sp);
                    try emit_extend(alloc, mf, dloc.vreg1, idx_v, 4_u8, false, sp);
                } else {
                    try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), idx_v, 4_usize, sp);
                }
                return;
            }
            let ncols = pool_ncols_from_arg_ty(env, eir_prog.fn_val_ty(ctx.fn_id, args[0_usize]));
            let pool_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let len_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, len_v, mach_ir.mem_base_disp(pool_p, (ncols *% 8_usize).trunc.[i32]()), 8_usize, false, sp);

            if dloc.kind == .PairGpr {
                // Branchless zero-stack ArenaPoolIdAt! (`cmp idx, len; cmovae tag, 4`)
                let z0 = try emit_imm_vreg(alloc, mf, 0_u64, sp);
                let e4 = try emit_imm_vreg(alloc, mf, 4_u64, sp);
                try emit_cmp_rr(alloc, mf, idx_v, len_v, sp);
                try emit_cmov(alloc, mf, .Ae, dloc.vreg0, z0, e4, sp);
                try emit_extend(alloc, mf, dloc.vreg1, idx_v, 4_u8, false, sp);
                return;
            }

            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_oob = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_cmp_rr(alloc, mf, idx_v, len_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_oob, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_ok);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), idx_v, 4_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_oob);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 4_i64, 4_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), -1_i64, 4_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oob);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .ArenaPoolReset => {
            if args.len == 0_usize { return; }
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let pool_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_base_disp(pool_p, (ncols *% 8_usize).trunc.[i32]()), 0_i64, 8_usize, sp);
            if dst != eir.EIR_NONE {
                try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_base_disp(pool_p, 0_i32), ret_ty, sp);
            }
        }
        .ArenaPoolLen => {
            if args.len == 0_usize { return; }
            let ncols = pool_ncols_from_arg_ty(env, eir_prog.fn_val_ty(ctx.fn_id, args[0_usize]));
            let pool_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(pool_p, (ncols *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        _ => {}
    }
    return;
}

/// Validates SlotPool GenId: branches to `b_stale` if invalid, else falls into a new valid block
/// returning `{ pool_p, idx32 }`.
struct SlotValidRes {
    pool_p: mach_ir.VReg;
    idx32: mach_ir.VReg;
}

fn emit_slot_pool_validate(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ncols: usize,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    b_stale: u32,
    sp: span.Span,
) -> SlotValidRes ! OutOfMemory {
    if args.len < 2_usize {
        return SlotValidRes.{ pool_p: mach_ir.VREG_NONE, idx32: mach_ir.VREG_NONE };
    }
    let pool_arg_slot = get_arg_slot(arg_slots, 0_usize);
    let pool_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], pool_arg_slot, sp);
    let gid_raw = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], false, sp);
    let idx32 = try mf.new_vreg(alloc, .Gpr);
    let gen32 = try mf.new_vreg(alloc, .Gpr);
    try emit_extend(alloc, mf, idx32, gid_raw, 4_u8, false, sp);
    try emit_alu_ri(alloc, mf, .ShrImm, gen32, gid_raw, 32_i64, sp);

    let b_chk_cap = try mf.add_block(alloc, ctx.cur_depth);
    let b_chk_gen = try mf.add_block(alloc, ctx.cur_depth);
    let b_valid = try mf.add_block(alloc, ctx.cur_depth);

    // Note: `(gen32 & 1) == 0` catches BOTH `gen32 == 0` and even (freed) generations in 1 branch!
    var t1 = mach_ir.inst_empty(.Test32Imm, sp);
    t1.src0 = gen32;
    t1.imm = 1_i64;
    try mf.emit_inst(alloc, t1);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_stale, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_cap, sp));
    mf.end_block_insts(ctx.cur_mbb);

    mf.begin_block_insts(b_chk_cap);
    let cap_off = ((ncols +% 3_usize) *% 8_usize).trunc.[i32]();
    var cap_v = if pool_arg_slot == eir.EIR_NONE {
        find_hoisted_pool_col(ctx, args[0_usize], cap_off)
    } else {
        mach_ir.VREG_NONE
    };
    if cap_v == mach_ir.VREG_NONE {
        cap_v = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, cap_v, mach_ir.mem_base_disp(pool_p, cap_off), 8_usize, false, sp);
    }
    try emit_cmp_rr(alloc, mf, idx32, cap_v, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_stale, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_gen, sp));
    mf.end_block_insts(b_chk_cap);

    mf.begin_block_insts(b_chk_gen);
    let gen_off = (ncols *% 8_usize).trunc.[i32]();
    var gen_arr = if pool_arg_slot == eir.EIR_NONE {
        find_hoisted_pool_col(ctx, args[0_usize], gen_off)
    } else {
        mach_ir.VREG_NONE
    };
    if gen_arr == mach_ir.VREG_NONE {
        gen_arr = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, gen_arr, mach_ir.mem_base_disp(pool_p, gen_off), 8_usize, false, sp);
    }
    let cur_gen = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, cur_gen, mach_ir.mem_sib(gen_arr, idx32, 4_u8, 0_i32), 4_usize, false, sp);
    try emit_cmp_rr(alloc, mf, cur_gen, gen32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, b_stale, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_valid, sp));
    mf.end_block_insts(b_chk_gen);

    mf.begin_block_insts(b_valid);
    ctx.cur_mbb = b_valid;
    return SlotValidRes.{ pool_p: pool_p, idx32: idx32 };
}

fn emit_memcopy_dyn(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    dst_ptr: mach_ir.VReg,
    src_ptr: mach_ir.VReg,
    nbytes: mach_ir.VReg,
    sp: span.Span,
) -> !OutOfMemory {
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(dst_ptr, mach_ir.PHYS_RDI, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(src_ptr, mach_ir.PHYS_RSI, sp));
    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(nbytes, mach_ir.PHYS_RCX, sp));
    var mc = mach_ir.inst_empty(.MemCopy, sp);
    mc.clobber_gprs = mach_ir.phys_bit(mach_ir.PHYS_RDI)
        | mach_ir.phys_bit(mach_ir.PHYS_RSI)
        | mach_ir.phys_bit(mach_ir.PHYS_RCX);
    try mf.emit_inst(alloc, mc);
    return;
}

fn emit_slot_pool_init_isel(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    elem_ty: types.TyId,
    dst: eir.EirValue,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    if args.len == 0_usize { return; }
    let pdef = env.get(elem_ty).primary;
    let ncols = pool_ncols_from_ty(env, elem_ty);
    let doff = ctx_val_loc(ctx, dst).stack_off;
    let ok_ty = env.get(ret_ty).primary;
    let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
    try emit_memzero(alloc, mf, mach_ir.mem_stack_slot(doff), env.x64_layout(ret_ty).size, sp);

    let alloc_off = mf.alloc_stack_slot(8_usize, 8_usize);
    let cap_off = mf.alloc_stack_slot(8_usize, 8_usize);
    let alloc_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(alloc_off), alloc_p, 8_usize, sp);

    var cap_v = try emit_imm_vreg(alloc, mf, 4_u64, sp);
    if args.len > 1_usize {
        let raw_cap = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], false, sp);
        let four_v = try emit_imm_vreg(alloc, mf, 4_u64, sp);
        cap_v = try mf.new_vreg(alloc, .Gpr);
        try mf.emit_inst(alloc, mach_ir.inst_copy(cap_v, raw_cap, sp));
        try emit_test_rr(alloc, mf, raw_cap, raw_cap, false, sp);
        var cm = mach_ir.inst_empty(.Cmov, sp);
        cm.dst = cap_v;
        cm.src0 = cap_v;
        cm.src1 = four_v;
        cm.cc = .E;
        cm.tied_src0 = true;
        try mf.emit_inst(alloc, cm);
    }
    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(cap_off), cap_v, 8_usize, sp);
    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% ((ncols +% 3_usize) *% 8_usize).trunc.[i32]()), cap_v, 8_usize, sp);
    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% ((ncols +% 4_usize) *% 8_usize).trunc.[i32]()), cap_v, 8_usize, sp);

    let b_fail = try mf.add_block(alloc, ctx.cur_depth);
    let b_done = try mf.add_block(alloc, ctx.cur_depth);

    if let pm = env.get_pool(pdef) {
        let cols = env.pool_cols_range(pm.columns);
        var ci: usize = 0_usize;
        while ci < cols.len {
            let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            let ap = try mf.new_vreg(alloc, .Gpr);
            let cp = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, ap, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
            try emit_load_mem(alloc, mf, cp, mach_ir.mem_stack_slot(cap_off), 8_usize, false, sp);
            let sz_v = if esz != 1_usize { try emit_scale_index(alloc, mf, cp, esz, sp) } else { cp };
            let al_v = try emit_imm_vreg(alloc, mf, 64_u64, sp);
            let ptr = try emit_call_alloc_raw(alloc, ctx, mf, interner, ap, sz_v, al_v, false, sp);

            let b_next = try mf.add_block(alloc, ctx.cur_depth);
            try emit_test_rr(alloc, mf, ptr, ptr, false, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_fail, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_next, sp));
            mf.end_block_insts(ctx.cur_mbb);
            mf.begin_block_insts(b_next);
            ctx.cur_mbb = b_next;
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% (ci *% 8_usize).trunc.[i32]()), ptr, 8_usize, sp);
            ci = ci +% 1_usize;
        }
    }

    // Allocate zeroed gen array (cap * 4, align 4)
    let ap_g = try mf.new_vreg(alloc, .Gpr);
    let cp_g = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, ap_g, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
    try emit_load_mem(alloc, mf, cp_g, mach_ir.mem_stack_slot(cap_off), 8_usize, false, sp);
    let gsz = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, gsz, cp_g, 2_i64, sp);
    let al4 = try emit_imm_vreg(alloc, mf, 4_u64, sp);
    let gen_p = try emit_call_alloc_raw(alloc, ctx, mf, interner, ap_g, gsz, al4, false, sp);
    let b_after_gen = try mf.add_block(alloc, ctx.cur_depth);
    try emit_test_rr(alloc, mf, gen_p, gen_p, false, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_fail, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_after_gen, sp));
    mf.end_block_insts(ctx.cur_mbb);
    mf.begin_block_insts(b_after_gen);
    ctx.cur_mbb = b_after_gen;
    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% (ncols *% 8_usize).trunc.[i32]()), gen_p, 8_usize, sp);

    // Allocate free_stack (cap * 4, align 4) and fill free_stack[cap - 1 - k] = k
    let ap_f = try mf.new_vreg(alloc, .Gpr);
    let cp_f = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, ap_f, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
    try emit_load_mem(alloc, mf, cp_f, mach_ir.mem_stack_slot(cap_off), 8_usize, false, sp);
    let fsz = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, fsz, cp_f, 2_i64, sp);
    let al4_2 = try emit_imm_vreg(alloc, mf, 4_u64, sp);
    let fs_p = try emit_call_alloc_raw(alloc, ctx, mf, interner, ap_f, fsz, al4_2, false, sp);
    let b_fill_pre = try mf.add_block(alloc, ctx.cur_depth);
    try emit_test_rr(alloc, mf, fs_p, fs_p, false, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_fail, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_fill_pre, sp));
    mf.end_block_insts(ctx.cur_mbb);

    mf.begin_block_insts(b_fill_pre);
    ctx.cur_mbb = b_fill_pre;
    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% ((ncols +% 1_usize) *% 8_usize).trunc.[i32]()), fs_p, 8_usize, sp);
    let cap_lim = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, cap_lim, mach_ir.mem_stack_slot(cap_off), 8_usize, false, sp);
    let k_init = try emit_imm_vreg(alloc, mf, 0_u64, sp);
    let k_phi = try mf.new_vreg(alloc, .Gpr);
    let b_fk = try mf.add_block(alloc, ctx.cur_depth +% 1_u8);
    let b_fk_body = try mf.add_block(alloc, ctx.cur_depth +% 1_u8);
    let p0 = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, k_phi, k_init);
    try mf.emit_parallel_copy(alloc, p0, 1_u32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_fk, sp));
    mf.end_block_insts(b_fill_pre);

    mf.begin_block_insts(b_fk);
    try emit_cmp_rr(alloc, mf, k_phi, cap_lim, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_done, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_fk_body, sp));
    mf.end_block_insts(b_fk);

    mf.begin_block_insts(b_fk_body);
    let cm1 = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(cm1, mach_ir.mem_base_disp(cap_lim, -1_i32), sp));
    let rev_k = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Sub, rev_k, cm1, k_phi, sp);
    try emit_store_mem(alloc, mf, mach_ir.mem_sib(fs_p, rev_k, 4_u8, 0_i32), k_phi, 4_usize, sp);
    let k_nxt = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(k_nxt, mach_ir.mem_base_disp(k_phi, 1_i32), sp));
    let p1 = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, k_phi, k_nxt);
    try mf.emit_parallel_copy(alloc, p1, 1_u32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_fk, sp));
    mf.end_block_insts(b_fk_body);

    mf.begin_block_insts(b_fail);
    try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 7_i64, 4_usize, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
    mf.end_block_insts(b_fail);

    mf.begin_block_insts(b_done);
    ctx.cur_mbb = b_done;
    return;
}

fn emit_slot_pool_insert_isel(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    elem_ty: types.TyId,
    dst: eir.EirValue,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
    may_grow: bool,
    sp: span.Span,
) -> !OutOfMemory {
    if args.len == 0_usize { return; }
    let pdef = env.get(elem_ty).primary;
    let ncols = pool_ncols_from_ty(env, elem_ty);
    let doff = ctx_val_loc(ctx, dst).stack_off;
    let ok_ty = env.get(ret_ty).primary;
    let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
    let row_arg_idx: usize = if may_grow { 2_usize } else { 1_usize };

    let pool_off = mf.alloc_stack_slot(8_usize, 8_usize);
    let pool_p0 = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(pool_off), pool_p0, 8_usize, sp);

    let b_grow = try mf.add_block(alloc, ctx.cur_depth);
    let b_has_slot = try mf.add_block(alloc, ctx.cur_depth);
    let b_oom = try mf.add_block(alloc, ctx.cur_depth);
    let b_done = try mf.add_block(alloc, ctx.cur_depth);

    let ft0 = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, ft0, mach_ir.mem_base_disp(pool_p0, ((ncols +% 4_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
    try emit_test_rr(alloc, mf, ft0, ft0, false, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, b_has_slot, sp));
    if may_grow {
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_grow, sp));
    } else {
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_oom, sp));
    }
    mf.end_block_insts(ctx.cur_mbb);

    // Cold grow path
    mf.begin_block_insts(b_grow);
    ctx.cur_mbb = b_grow;
    if may_grow && args.len > 1_usize {
        let alloc_off = mf.alloc_stack_slot(8_usize, 8_usize);
        let oc_off = mf.alloc_stack_slot(8_usize, 8_usize);
        let nc_off = mf.alloc_stack_slot(8_usize, 8_usize);
        let newp_off = mf.alloc_stack_slot(8_usize, 8_usize);

        let ap0 = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[1_usize], get_arg_slot(arg_slots, 1_usize), sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(alloc_off), ap0, 8_usize, sp);
        let pp_g = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, pp_g, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
        let oc = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, oc, mach_ir.mem_base_disp(pp_g, ((ncols +% 3_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(oc_off), oc, 8_usize, sp);
        let dbl = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .ShlImm, dbl, oc, 1_i64, sp);
        let four_v = try emit_imm_vreg(alloc, mf, 4_u64, sp);
        let nc = try mf.new_vreg(alloc, .Gpr);
        try mf.emit_inst(alloc, mach_ir.inst_copy(nc, dbl, sp));
        try emit_test_rr(alloc, mf, dbl, dbl, false, sp);
        var cm = mach_ir.inst_empty(.Cmov, sp);
        cm.dst = nc;
        cm.src0 = nc;
        cm.src1 = four_v;
        cm.cc = .E;
        cm.tied_src0 = true;
        try mf.emit_inst(alloc, cm);
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(nc_off), nc, 8_usize, sp);

        // 1. Grow gen array (zeroed via eon_alloc_raw, copy old, free old)
        let ap1 = try mf.new_vreg(alloc, .Gpr);
        let nc1 = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, ap1, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, nc1, mach_ir.mem_stack_slot(nc_off), 8_usize, false, sp);
        let ngsz = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .ShlImm, ngsz, nc1, 2_i64, sp);
        let al4a = try emit_imm_vreg(alloc, mf, 4_u64, sp);
        let new_gen = try emit_call_alloc_raw(alloc, ctx, mf, interner, ap1, ngsz, al4a, false, sp);
        let b_g1 = try mf.add_block(alloc, ctx.cur_depth);
        try emit_test_rr(alloc, mf, new_gen, new_gen, false, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_oom, sp));
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_g1, sp));
        mf.end_block_insts(ctx.cur_mbb);
        mf.begin_block_insts(b_g1);
        ctx.cur_mbb = b_g1;
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(newp_off), new_gen, 8_usize, sp);
        let pp1 = try mf.new_vreg(alloc, .Gpr);
        let old_gen = try mf.new_vreg(alloc, .Gpr);
        let oc1 = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, pp1, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, old_gen, mach_ir.mem_base_disp(pp1, (ncols *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, oc1, mach_ir.mem_stack_slot(oc_off), 8_usize, false, sp);
        let ogsz = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .ShlImm, ogsz, oc1, 2_i64, sp);
        try emit_memcopy_dyn(alloc, mf, new_gen, old_gen, ogsz, sp);
        let ap1f = try mf.new_vreg(alloc, .Gpr);
        let pp1f = try mf.new_vreg(alloc, .Gpr);
        let og_f = try mf.new_vreg(alloc, .Gpr);
        let oc1f = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, ap1f, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, pp1f, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, og_f, mach_ir.mem_base_disp(pp1f, (ncols *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, oc1f, mach_ir.mem_stack_slot(oc_off), 8_usize, false, sp);
        let ogsz_f = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .ShlImm, ogsz_f, oc1f, 2_i64, sp);
        try emit_call_free_raw(alloc, ctx, mf, interner, ap1f, og_f, ogsz_f, sp);
        let pp1s = try mf.new_vreg(alloc, .Gpr);
        let ng_s = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, pp1s, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, ng_s, mach_ir.mem_stack_slot(newp_off), 8_usize, false, sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(pp1s, (ncols *% 8_usize).trunc.[i32]()), ng_s, 8_usize, sp);

        // 2. Grow free_stack & push new slots [oc..nc)
        let ap2 = try mf.new_vreg(alloc, .Gpr);
        let nc2 = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, ap2, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, nc2, mach_ir.mem_stack_slot(nc_off), 8_usize, false, sp);
        let nfsz = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .ShlImm, nfsz, nc2, 2_i64, sp);
        let al4b = try emit_imm_vreg(alloc, mf, 4_u64, sp);
        let new_fs = try emit_call_alloc_raw(alloc, ctx, mf, interner, ap2, nfsz, al4b, false, sp);
        let b_g2 = try mf.add_block(alloc, ctx.cur_depth);
        try emit_test_rr(alloc, mf, new_fs, new_fs, false, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_oom, sp));
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_g2, sp));
        mf.end_block_insts(ctx.cur_mbb);
        mf.begin_block_insts(b_g2);
        ctx.cur_mbb = b_g2;
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(newp_off), new_fs, 8_usize, sp);
        let oc_lp = try mf.new_vreg(alloc, .Gpr);
        let nc_lp = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, oc_lp, mach_ir.mem_stack_slot(oc_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, nc_lp, mach_ir.mem_stack_slot(nc_off), 8_usize, false, sp);
        let k_phi = try mf.new_vreg(alloc, .Gpr);
        let b_fk = try mf.add_block(alloc, ctx.cur_depth +% 1_u8);
        let b_fk_body = try mf.add_block(alloc, ctx.cur_depth +% 1_u8);
        let b_fk_done = try mf.add_block(alloc, ctx.cur_depth);
        let p0 = mf.pcopy_pairs.len().trunc.[u32]();
        try mf.add_pcopy_pair(alloc, k_phi, oc_lp);
        try mf.emit_parallel_copy(alloc, p0, 1_u32, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_fk, sp));
        mf.end_block_insts(b_g2);

        mf.begin_block_insts(b_fk);
        try emit_cmp_rr(alloc, mf, k_phi, nc_lp, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_fk_done, sp));
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_fk_body, sp));
        mf.end_block_insts(b_fk);

        mf.begin_block_insts(b_fk_body);
        let nm1 = try mf.new_vreg(alloc, .Gpr);
        try mf.emit_inst(alloc, mach_ir.inst_lea(nm1, mach_ir.mem_base_disp(nc_lp, -1_i32), sp));
        let rev_k = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .Sub, rev_k, nm1, k_phi, sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_sib(new_fs, rev_k, 4_u8, 0_i32), k_phi, 4_usize, sp);
        let k_nxt = try mf.new_vreg(alloc, .Gpr);
        try mf.emit_inst(alloc, mach_ir.inst_lea(k_nxt, mach_ir.mem_base_disp(k_phi, 1_i32), sp));
        let p1 = mf.pcopy_pairs.len().trunc.[u32]();
        try mf.add_pcopy_pair(alloc, k_phi, k_nxt);
        try mf.emit_parallel_copy(alloc, p1, 1_u32, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_fk, sp));
        mf.end_block_insts(b_fk_body);

        mf.begin_block_insts(b_fk_done);
        ctx.cur_mbb = b_fk_done;
        let ap2f = try mf.new_vreg(alloc, .Gpr);
        let pp2f = try mf.new_vreg(alloc, .Gpr);
        let ofs = try mf.new_vreg(alloc, .Gpr);
        let oc2f = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, ap2f, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, pp2f, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, ofs, mach_ir.mem_base_disp(pp2f, ((ncols +% 1_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, oc2f, mach_ir.mem_stack_slot(oc_off), 8_usize, false, sp);
        let ofsz = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .ShlImm, ofsz, oc2f, 2_i64, sp);
        try emit_call_free_raw(alloc, ctx, mf, interner, ap2f, ofs, ofsz, sp);
        let pp2s = try mf.new_vreg(alloc, .Gpr);
        let nfs_s = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, pp2s, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, nfs_s, mach_ir.mem_stack_slot(newp_off), 8_usize, false, sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(pp2s, ((ncols +% 1_usize) *% 8_usize).trunc.[i32]()), nfs_s, 8_usize, sp);

        // 3. Grow each data column
        if let pm = env.get_pool(pdef) {
            let cols = env.pool_cols_range(pm.columns);
            var ci: usize = 0_usize;
            while ci < cols.len {
                let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
                let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                let apc = try mf.new_vreg(alloc, .Gpr);
                let ncc = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, apc, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
                try emit_load_mem(alloc, mf, ncc, mach_ir.mem_stack_slot(nc_off), 8_usize, false, sp);
                let ncsz = if esz != 1_usize { try emit_scale_index(alloc, mf, ncc, esz, sp) } else { ncc };
                let al64 = try emit_imm_vreg(alloc, mf, 64_u64, sp);
                let new_c = try emit_call_alloc_raw(alloc, ctx, mf, interner, apc, ncsz, al64, false, sp);
                let b_gc = try mf.add_block(alloc, ctx.cur_depth);
                try emit_test_rr(alloc, mf, new_c, new_c, false, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_oom, sp));
                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_gc, sp));
                mf.end_block_insts(ctx.cur_mbb);
                mf.begin_block_insts(b_gc);
                ctx.cur_mbb = b_gc;
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(newp_off), new_c, 8_usize, sp);
                let ppc = try mf.new_vreg(alloc, .Gpr);
                let old_c = try mf.new_vreg(alloc, .Gpr);
                let occ = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, ppc, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
                try emit_load_mem(alloc, mf, old_c, mach_ir.mem_base_disp(ppc, (ci *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
                try emit_load_mem(alloc, mf, occ, mach_ir.mem_stack_slot(oc_off), 8_usize, false, sp);
                let ocsz = if esz != 1_usize { try emit_scale_index(alloc, mf, occ, esz, sp) } else { occ };
                try emit_memcopy_dyn(alloc, mf, new_c, old_c, ocsz, sp);
                let apcf = try mf.new_vreg(alloc, .Gpr);
                let ppcf = try mf.new_vreg(alloc, .Gpr);
                let ocf = try mf.new_vreg(alloc, .Gpr);
                let occf = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, apcf, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
                try emit_load_mem(alloc, mf, ppcf, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
                try emit_load_mem(alloc, mf, ocf, mach_ir.mem_base_disp(ppcf, (ci *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
                try emit_load_mem(alloc, mf, occf, mach_ir.mem_stack_slot(oc_off), 8_usize, false, sp);
                let ocszf = if esz != 1_usize { try emit_scale_index(alloc, mf, occf, esz, sp) } else { occf };
                try emit_call_free_raw(alloc, ctx, mf, interner, apcf, ocf, ocszf, sp);
                let ppcs = try mf.new_vreg(alloc, .Gpr);
                let ncs = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, ppcs, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
                try emit_load_mem(alloc, mf, ncs, mach_ir.mem_stack_slot(newp_off), 8_usize, false, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(ppcs, (ci *% 8_usize).trunc.[i32]()), ncs, 8_usize, sp);
                ci = ci +% 1_usize;
            }
        }
        let pp_fin = try mf.new_vreg(alloc, .Gpr);
        let nc_fin = try mf.new_vreg(alloc, .Gpr);
        let oc_fin = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, pp_fin, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, nc_fin, mach_ir.mem_stack_slot(nc_off), 8_usize, false, sp);
        try emit_load_mem(alloc, mf, oc_fin, mach_ir.mem_stack_slot(oc_off), 8_usize, false, sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(pp_fin, ((ncols +% 3_usize) *% 8_usize).trunc.[i32]()), nc_fin, 8_usize, sp);
        let new_ft = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .Sub, new_ft, nc_fin, oc_fin, sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(pp_fin, ((ncols +% 4_usize) *% 8_usize).trunc.[i32]()), new_ft, 8_usize, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_has_slot, sp));
    } else {
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_oom, sp));
    }
    mf.end_block_insts(ctx.cur_mbb);

    // Fast path: pop free slot, bump gen, write row, return Ok(GenId)
    mf.begin_block_insts(b_has_slot);
    ctx.cur_mbb = b_has_slot;
    let pp = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, pp, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
    let ft = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, ft, mach_ir.mem_base_disp(pp, ((ncols +% 4_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
    let ft_m1 = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(ft_m1, mach_ir.mem_base_disp(ft, -1_i32), sp));
    try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(pp, ((ncols +% 4_usize) *% 8_usize).trunc.[i32]()), ft_m1, 8_usize, sp);
    let fs_arr = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, fs_arr, mach_ir.mem_base_disp(pp, ((ncols +% 1_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
    let idx = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, idx, mach_ir.mem_sib(fs_arr, ft_m1, 4_u8, 0_i32), 4_usize, false, sp);

    let gen_arr = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, gen_arr, mach_ir.mem_base_disp(pp, (ncols *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
    let gen_old = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, gen_old, mach_ir.mem_sib(gen_arr, idx, 4_u8, 0_i32), 4_usize, false, sp);
    let gen_new = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(gen_new, mach_ir.mem_base_disp(gen_old, 1_i32), sp));
    try emit_store_mem(alloc, mf, mach_ir.mem_sib(gen_arr, idx, 4_u8, 0_i32), gen_new, 4_usize, sp);

    try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), idx, 4_usize, sp);
    try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 4_i32), gen_new, 4_usize, sp);

    let cur_len = try mf.new_vreg(alloc, .Gpr);
    try emit_load_mem(alloc, mf, cur_len, mach_ir.mem_base_disp(pp, ((ncols +% 2_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
    let nxt_len = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(nxt_len, mach_ir.mem_base_disp(cur_len, 1_i32), sp));
    try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(pp, ((ncols +% 2_usize) *% 8_usize).trunc.[i32]()), nxt_len, 8_usize, sp);

    if row_arg_idx < args.len {
        let row_v = args[row_arg_idx];
        let row_off = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, row_v, sp);
        let row_ty = eir_prog.fn_val_ty(ctx.fn_id, row_v);
        if let pm = env.get_pool(pdef) {
            let cols = env.pool_cols_range(pm.columns);
            var ci: usize = 0_usize;
            while ci < cols.len {
                let foff = env.struct_field_offset(row_ty, ci).offset;
                let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
                let col_esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                let col_base = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, col_base, mach_ir.mem_base_disp(pp, (ci *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
                let byte_off = try emit_scale_index(alloc, mf, idx, col_esz, sp);
                let dst_addr = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_rr(alloc, mf, .Add, dst_addr, col_base, byte_off, sp);
                try emit_copy_mem(alloc, mf, mach_ir.mem_base_disp(dst_addr, 0_i32), mach_ir.mem_stack_slot(row_off +% foff.trunc.[i32]()), col_esz, sp);
                ci = ci +% 1_usize;
            }
        }
    }
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
    mf.end_block_insts(b_has_slot);

    mf.begin_block_insts(b_oom);
    try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 7_i64, 4_usize, sp);
    try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), 0_i64, 8_usize, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
    mf.end_block_insts(b_oom);

    mf.begin_block_insts(b_done);
    ctx.cur_mbb = b_done;
    return;
}

fn emit_builtin_slot_pool(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    match op.kind {
        .SlotPoolInit => {
            try emit_slot_pool_init_isel(alloc, ctx, mf, eir_prog, env, interner, op.ty0, dst, args, arg_slots, ret_ty, sp);
        }
        .SlotPoolInsert => {
            try emit_slot_pool_insert_isel(alloc, ctx, mf, eir_prog, env, interner, op.ty0, dst, args, arg_slots, ret_ty, true, sp);
        }
        .SlotPoolTryInsert => {
            try emit_slot_pool_insert_isel(alloc, ctx, mf, eir_prog, env, interner, op.ty0, dst, args, arg_slots, ret_ty, false, sp);
        }
        .SlotPoolRemove => {
            if args.len < 2_usize { return; }
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let b_stale = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);
            let vr = try emit_slot_pool_validate(alloc, ctx, mf, eir_prog, env, ncols, args, arg_slots, b_stale, sp);
            try emit_memzero(alloc, mf, mach_ir.mem_stack_slot(doff), env.x64_layout(ret_ty).size, sp);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let foff = env.struct_field_offset(ok_ty, ci).offset;
                    let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
                    let col_esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                    let col_base = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, col_base, mach_ir.mem_base_disp(vr.pool_p, (ci *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
                    let byte_off = try emit_scale_index(alloc, mf, vr.idx32, col_esz, sp);
                    let src_addr = try mf.new_vreg(alloc, .Gpr);
                    try emit_alu_rr(alloc, mf, .Add, src_addr, col_base, byte_off, sp);
                    try emit_copy_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% foff.trunc.[i32]()), mach_ir.mem_base_disp(src_addr, 0_i32), col_esz, sp);
                    ci = ci +% 1_usize;
                }
            }
            // Bump gen, push onto free_stack, len -= 1
            let gen_arr = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, gen_arr, mach_ir.mem_base_disp(vr.pool_p, (ncols *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
            let g_old = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, g_old, mach_ir.mem_sib(gen_arr, vr.idx32, 4_u8, 0_i32), 4_usize, false, sp);
            let g_new = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(g_new, mach_ir.mem_base_disp(g_old, 1_i32), sp));
            try emit_store_mem(alloc, mf, mach_ir.mem_sib(gen_arr, vr.idx32, 4_u8, 0_i32), g_new, 4_usize, sp);

            let ft = try mf.new_vreg(alloc, .Gpr);
            let fs_arr = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, ft, mach_ir.mem_base_disp(vr.pool_p, ((ncols +% 4_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
            try emit_load_mem(alloc, mf, fs_arr, mach_ir.mem_base_disp(vr.pool_p, ((ncols +% 1_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_sib(fs_arr, ft, 4_u8, 0_i32), vr.idx32, 4_usize, sp);
            let ft_nxt = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(ft_nxt, mach_ir.mem_base_disp(ft, 1_i32), sp));
            try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(vr.pool_p, ((ncols +% 4_usize) *% 8_usize).trunc.[i32]()), ft_nxt, 8_usize, sp);

            let cur_len = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, cur_len, mach_ir.mem_base_disp(vr.pool_p, ((ncols +% 2_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
            let nxt_len = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(nxt_len, mach_ir.mem_base_disp(cur_len, -1_i32), sp));
            try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(vr.pool_p, ((ncols +% 2_usize) *% 8_usize).trunc.[i32]()), nxt_len, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_stale);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 11_i64, 4_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_stale);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .SlotPoolDestroy => {
            if args.len < 2_usize { return; }
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let pool_off = mf.alloc_stack_slot(8_usize, 8_usize);
            let alloc_off = mf.alloc_stack_slot(8_usize, 8_usize);
            let pp0 = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let ap0 = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[1_usize], get_arg_slot(arg_slots, 1_usize), sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(pool_off), pp0, 8_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(alloc_off), ap0, 8_usize, sp);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
                    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                    let pp = try mf.new_vreg(alloc, .Gpr);
                    let ap = try mf.new_vreg(alloc, .Gpr);
                    let ptr = try mf.new_vreg(alloc, .Gpr);
                    let cap_v = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, pp, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
                    try emit_load_mem(alloc, mf, ap, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
                    try emit_load_mem(alloc, mf, ptr, mach_ir.mem_base_disp(pp, (ci *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
                    try emit_load_mem(alloc, mf, cap_v, mach_ir.mem_base_disp(pp, ((ncols +% 3_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
                    let sz_v = if esz != 1_usize { try emit_scale_index(alloc, mf, cap_v, esz, sp) } else { cap_v };
                    try emit_call_free_raw(alloc, ctx, mf, interner, ap, ptr, sz_v, sp);
                    ci = ci +% 1_usize;
                }
            }
            var ex: usize = ncols;
            while ex <= ncols +% 1_usize {
                let pp = try mf.new_vreg(alloc, .Gpr);
                let ap = try mf.new_vreg(alloc, .Gpr);
                let ptr = try mf.new_vreg(alloc, .Gpr);
                let cap_v = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, pp, mach_ir.mem_stack_slot(pool_off), 8_usize, false, sp);
                try emit_load_mem(alloc, mf, ap, mach_ir.mem_stack_slot(alloc_off), 8_usize, false, sp);
                try emit_load_mem(alloc, mf, ptr, mach_ir.mem_base_disp(pp, (ex *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
                try emit_load_mem(alloc, mf, cap_v, mach_ir.mem_base_disp(pp, ((ncols +% 3_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
                let sz_v = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_ri(alloc, mf, .ShlImm, sz_v, cap_v, 2_i64, sp);
                try emit_call_free_raw(alloc, ctx, mf, interner, ap, ptr, sz_v, sp);
                ex = ex +% 1_usize;
            }
        }
        .SlotPoolGet => {
            if args.len < 2_usize { return; }
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let dloc = ctx_val_loc(ctx, dst);
            let b_stale = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);
            let vr = try emit_slot_pool_validate(alloc, ctx, mf, eir_prog, env, ncols, args, arg_slots, b_stale, sp);
            if dloc.kind == .PairGpr {
                try mf.emit_inst(alloc, mach_ir.inst_copy(dloc.vreg0, vr.pool_p, sp));
                try mf.emit_inst(alloc, mach_ir.inst_copy(dloc.vreg1, vr.idx32, sp));
            } else {
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dloc.stack_off), vr.pool_p, 8_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(dloc.stack_off +% 8_i32), vr.idx32, 4_usize, sp);
            }
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_stale);
            try emit_opt_null(alloc, ctx, mf, eir_prog, env, dst, ret_ty, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_stale);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .SlotPoolAt => {
            if args.len < 2_usize { return; }
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let b_stale = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);
            let vr = try emit_slot_pool_validate(alloc, ctx, mf, eir_prog, env, ncols, args, arg_slots, b_stale, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), vr.pool_p, 8_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), vr.idx32, 4_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_stale);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 11_i64, 4_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), 0_i64, 8_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), 0_i64, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_stale);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .SlotPoolLen => {
            if args.len == 0_usize { return; }
            let ncols = pool_ncols_from_arg_ty(env, eir_prog.fn_val_ty(ctx.fn_id, args[0_usize]));
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, ((ncols +% 2_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .SlotPoolCap => {
            if args.len == 0_usize { return; }
            let ncols = pool_ncols_from_arg_ty(env, eir_prog.fn_val_ty(ctx.fn_id, args[0_usize]));
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, ((ncols +% 3_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .SlotPoolIsAlive => {
            if args.len < 2_usize { return; }
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            let cap_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, cap_v, mach_ir.mem_base_disp(p, ((ncols +% 3_usize) *% 8_usize).trunc.[i32]()), 8_usize, false, sp);

            let b_in = try mf.add_block(alloc, ctx.cur_depth);
            let b_false = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);
            let res = try mf.new_vreg(alloc, .Gpr);

            try emit_cmp_rr(alloc, mf, idx_v, cap_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_false, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_in, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_in);
            let gen_arr = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, gen_arr, mach_ir.mem_base_disp(p, (ncols *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
            let g = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, g, mach_ir.mem_sib(gen_arr, idx_v, 4_u8, 0_i32), 4_usize, false, sp);
            try emit_alu_ri(alloc, mf, .AndImm, res, g, 1_i64, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_in);

            mf.begin_block_insts(b_false);
            try emit_mov_imm(alloc, mf, res, 0_u64, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_false);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .SlotPoolIdAt => {
            if args.len < 2_usize { return; }
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            let gen_arr = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, gen_arr, mach_ir.mem_base_disp(p, (ncols *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
            let g = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, g, mach_ir.mem_sib(gen_arr, idx_v, 4_u8, 0_i32), 4_usize, false, sp);
            let idx_lo = try mf.new_vreg(alloc, .Gpr);
            try emit_extend(alloc, mf, idx_lo, idx_v, 4_u8, false, sp);
            let g_hi = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_ri(alloc, mf, .ShlImm, g_hi, g, 32_i64, sp);
            let packed = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Or, packed, idx_lo, g_hi, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, packed, sp);
        }
        _ => {}
    }
    return;
}

fn emit_buf_push_elem(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    data_p: mach_ir.VReg,
    len_v: mach_ir.VReg,
    esz: usize,
    val_arg: eir.EirValue,
    elem_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    // Fast direct field stores when `val_arg` is a skipped single-use `Aggregate(.Struct|.AnonStruct)`:
    // eliminates stack zero-init + store-to-load forwarding stalls on every Token / JsonNode / AstNode push!
    if ctx_should_skip(ctx, val_arg) {
        let agid = ctx_def_inst_gid(ctx, val_arg);
        let all_i = eir_prog.funcs.insts.as_slice();
        if agid != eir.EIR_NONE && agid.widen.[usize]() < all_i.len {
            let ai = all_i[agid.widen.[usize]()];
            if ai.kind == .Aggregate {
                if let agg = eir_prog.get_aggregate(ai.aux0) {
                    if agg.tag == .Struct || agg.tag == .AnonStruct {
                        let aelems = eir_prog.vals_slice(ai.range);
                        let elem_ptr = try mf.new_vreg(alloc, .Gpr);
                        if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                            try mf.emit_inst(alloc, mach_ir.inst_lea(elem_ptr, mach_ir.mem_sib(data_p, len_v, esz.trunc.[u8](), 0_i32), sp));
                        } else {
                            let sc = try emit_scale_index(alloc, mf, len_v, esz, sp);
                            try mf.emit_inst(alloc, mach_ir.inst_lea(elem_ptr, mach_ir.mem_sib(data_p, sc, 1_u8, 0_i32), sp));
                        }
                        var fi: usize = 0_usize;
                        while fi < aelems.len {
                            let foff = env.struct_field_offset(elem_ty, fi);
                            let fmem = mach_ir.mem_base_disp(elem_ptr, foff.offset.trunc.[i32]());
                            try store_val_to_mem(alloc, ctx, mf, eir_prog, env, fmem, aelems[fi], foff.ty, sp);
                            fi = fi +% 1_usize;
                        }
                        return;
                    }
                }
            }
        }
    }
    var elem_mem = mach_ir.mem_none();
    if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
        elem_mem = mach_ir.mem_sib(data_p, len_v, esz.trunc.[u8](), 0_i32);
    } else {
        let sc = try emit_scale_index(alloc, mf, len_v, esz, sp);
        elem_mem = mach_ir.mem_sib(data_p, sc, 1_u8, 0_i32);
    }
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, elem_mem, val_arg, elem_ty, sp);
    return;
}

fn emit_builtin_buf(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    inst_gid: u32,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let elay = env.x64_layout(op.ty0);
    let esz = if elay.size == 0_usize { 1_usize } else { elay.size };
    let ealign = if elay.align == 0_usize { 1_usize } else { elay.align };
    let proven_safe = (eir_prog.inst_proven_flags(inst_gid) & eir.PROVEN_BOUNDS_SAFE) != 0_u8;

    match op.kind {
        .BufInit => {
            if args.len < 2_usize { return; }
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let a_ptr = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let cap_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            let byte_sz = try emit_scale_index(alloc, mf, cap_v, esz, sp);
            let al_v = try emit_imm_vreg(alloc, mf, ealign.widen.[u64](), sp);
            // ZERO-TAX BufInit: call `eon_alloc_raw_uninit` when `!sanitize`!
            let raw_p = try emit_call_alloc_raw(alloc, ctx, mf, interner, a_ptr, byte_sz, al_v, true, sp);

            let b_chk_z = try mf.add_block(alloc, ctx.cur_depth);
            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_oom = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_test_rr(alloc, mf, raw_p, raw_p, false, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, b_ok, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_z, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_chk_z);
            try emit_test_rr(alloc, mf, cap_v, cap_v, false, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_ok, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_oom, sp));
            mf.end_block_insts(b_chk_z);

            mf.begin_block_insts(b_oom);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 7_i64, 4_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oom);

            mf.begin_block_insts(b_ok);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), raw_p, 8_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), 0_i64, 8_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 16_i32), cap_v, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .BufPush => {
            if args.len < 2_usize { return; }
            let dloc = ctx_val_loc(ctx, dst);
            let doff = dloc.stack_off;
            let val_arg = if args.len >= 3_usize { args[2_usize] } else { args[1_usize] };
            let buf_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let len_v = try mf.new_vreg(alloc, .Gpr);
            let cap_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, len_v, mach_ir.mem_base_disp(buf_p, 8_i32), 8_usize, false, sp);
            try emit_load_mem(alloc, mf, cap_v, mach_ir.mem_base_disp(buf_p, 16_i32), 8_usize, false, sp);

            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_full = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_cmp_rr(alloc, mf, len_v, cap_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_full, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_ok);
            let nxt_len = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(nxt_len, mach_ir.mem_base_disp(len_v, 1_i32), sp));
            try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(buf_p, 8_i32), nxt_len, 8_usize, sp);
            let data_p = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, data_p, mach_ir.mem_base_disp(buf_p, 0_i32), 8_usize, false, sp);
            try emit_buf_push_elem(alloc, ctx, mf, eir_prog, env, data_p, len_v, esz, val_arg, op.ty0, sp);
            if dloc.kind == .PairGpr {
                try emit_mov_imm(alloc, mf, dloc.vreg0, 0_u64, sp);
            } else {
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            }
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_full);
            if dloc.kind == .PairGpr {
                try emit_mov_imm(alloc, mf, dloc.vreg0, 7_u64, sp);
            } else {
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 7_i64, 4_usize, sp);
            }
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_full);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .BufPushSlice => {
            if args.len < 2_usize { return; }
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let slice_arg = if args.len >= 3_usize { args[2_usize] } else { args[1_usize] };
            let spair = try load_slice_pair(alloc, ctx, mf, slice_arg, sp);
            let buf_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let len_v = try mf.new_vreg(alloc, .Gpr);
            let cap_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, len_v, mach_ir.mem_base_disp(buf_p, 8_i32), 8_usize, false, sp);
            try emit_load_mem(alloc, mf, cap_v, mach_ir.mem_base_disp(buf_p, 16_i32), 8_usize, false, sp);
            let avail = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Sub, avail, cap_v, len_v, sp);

            let b_fit = try mf.add_block(alloc, ctx.cur_depth);
            let b_copy = try mf.add_block(alloc, ctx.cur_depth);
            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_full = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_cmp_rr(alloc, mf, avail, spair.hi, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, b_full, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_fit, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_fit);
            let nxt_len = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(nxt_len, mach_ir.mem_sib(len_v, spair.hi, 1_u8, 0_i32), sp));
            try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(buf_p, 8_i32), nxt_len, 8_usize, sp);
            let nbytes = try emit_scale_index(alloc, mf, spair.hi, esz, sp);
            try emit_test_rr(alloc, mf, nbytes, nbytes, false, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_ok, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_copy, sp));
            mf.end_block_insts(b_fit);

            mf.begin_block_insts(b_copy);
            let data_p = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, data_p, mach_ir.mem_base_disp(buf_p, 0_i32), 8_usize, false, sp);
            let dst_off = try emit_scale_index(alloc, mf, len_v, esz, sp);
            let dst_p = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(dst_p, mach_ir.mem_sib(data_p, dst_off, 1_u8, 0_i32), sp));
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(dst_p, mach_ir.PHYS_RDI, sp));
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(spair.lo, mach_ir.PHYS_RSI, sp));
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(nbytes, mach_ir.PHYS_RCX, sp));
            var mc = mach_ir.inst_empty(.MemCopy, sp);
            mc.flag0 = ctx.is_linux && ctx.cfg.target_avx2 && ctx.cfg.opt_level >= 2_u8;
            mc.clobber_gprs = mach_ir.phys_bit(mach_ir.PHYS_RDI)
                | mach_ir.phys_bit(mach_ir.PHYS_RSI)
                | mach_ir.phys_bit(mach_ir.PHYS_RCX);
            try mf.emit_inst(alloc, mc);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(b_copy);

            mf.begin_block_insts(b_ok);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_full);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 7_i64, 4_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_full);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .BufPop => {
            if args.len == 0_usize { return; }
            let buf_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let len_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, len_v, mach_ir.mem_base_disp(buf_p, 8_i32), 8_usize, false, sp);

            let b_some = try mf.add_block(alloc, ctx.cur_depth);
            let b_empty = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_test_rr(alloc, mf, len_v, len_v, false, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_empty, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_some, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_some);
            let new_len = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(new_len, mach_ir.mem_base_disp(len_v, -1_i32), sp));
            try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(buf_p, 8_i32), new_len, 8_usize, sp);
            let data_p = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, data_p, mach_ir.mem_base_disp(buf_p, 0_i32), 8_usize, false, sp);
            var elem_mem = mach_ir.mem_none();
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                elem_mem = mach_ir.mem_sib(data_p, new_len, esz.trunc.[u8](), 0_i32);
            } else {
                let sc = try emit_scale_index(alloc, mf, new_len, esz, sp);
                elem_mem = mach_ir.mem_sib(data_p, sc, 1_u8, 0_i32);
            }
            let niche = env.opt_niche(op.ty0);
            if niche.kind != .None {
                try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, elem_mem, op.ty0, sp);
            } else {
                let doff = ctx_val_loc(ctx, dst).stack_off;
                let voff = env.opt_val_offset(op.ty0).trunc.[i32]();
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 1_i64, 1_usize, sp);
                let src_addr = try materialize_mem_to_vreg(alloc, mf, elem_mem, sp);
                try emit_copy_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% voff), mach_ir.mem_base_disp(src_addr, 0_i32), esz, sp);
            }
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_some);

            mf.begin_block_insts(b_empty);
            try emit_opt_null(alloc, ctx, mf, eir_prog, env, dst, ret_ty, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_empty);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .BufLen => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, 8_i32), 8_usize, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .BufCap => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, 16_i32), 8_usize, false, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .BufClear => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_base_disp(p, 8_i32), 0_i64, 8_usize, sp);
        }
        .BufAsSlice => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let data_p = try mf.new_vreg(alloc, .Gpr);
            let len_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, data_p, mach_ir.mem_base_disp(p, 0_i32), 8_usize, false, sp);
            try emit_load_mem(alloc, mf, len_v, mach_ir.mem_base_disp(p, 8_i32), 8_usize, false, sp);
            try store_slice_pair(alloc, ctx, mf, dst, data_p, len_v, sp);
        }
        .BufAt => {
            if args.len < 2_usize { return; }
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_off = env.eu_ok_offset(types.TY_USIZE).trunc.[i32]();
            let buf_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            if proven_safe {
                let data_p = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, data_p, mach_ir.mem_base_disp(buf_p, 0_i32), 8_usize, false, sp);
                let elem_p = try mf.new_vreg(alloc, .Gpr);
                if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                    try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(data_p, idx_v, esz.trunc.[u8](), 0_i32), sp));
                } else {
                    let sc = try emit_scale_index(alloc, mf, idx_v, esz, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(data_p, sc, 1_u8, 0_i32), sp));
                }
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), elem_p, 8_usize, sp);
                return;
            }
            let len_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, len_v, mach_ir.mem_base_disp(buf_p, 8_i32), 8_usize, false, sp);
            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_oob = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);
            try emit_cmp_rr(alloc, mf, idx_v, len_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_oob, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_ok);
            let data_p = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, data_p, mach_ir.mem_base_disp(buf_p, 0_i32), 8_usize, false, sp);
            let elem_p = try mf.new_vreg(alloc, .Gpr);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(data_p, idx_v, esz.trunc.[u8](), 0_i32), sp));
            } else {
                let sc = try emit_scale_index(alloc, mf, idx_v, esz, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(data_p, sc, 1_u8, 0_i32), sp));
            }
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), elem_p, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_oob);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 4_i64, 4_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), 0_i64, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oob);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .BufGet => {
            if args.len < 2_usize { return; }
            let buf_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            let data_p = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, data_p, mach_ir.mem_base_disp(buf_p, 0_i32), 8_usize, false, sp);
            let elem_p = try mf.new_vreg(alloc, .Gpr);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(data_p, idx_v, esz.trunc.[u8](), 0_i32), sp));
            } else {
                let sc = try emit_scale_index(alloc, mf, idx_v, esz, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(data_p, sc, 1_u8, 0_i32), sp));
            }
            if proven_safe {
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, elem_p, sp);
                return;
            }
            // Branchless CMOV for BufGet!
            let len_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, len_v, mach_ir.mem_base_disp(buf_p, 8_i32), 8_usize, false, sp);
            let z = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            let res = try mf.new_vreg(alloc, .Gpr);
            try emit_cmp_rr(alloc, mf, idx_v, len_v, sp);
            try emit_cmov(alloc, mf, .Ae, res, elem_p, z, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .BufSub => {
            if args.len < 3_usize { return; }
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let buf_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let data_p = try mf.new_vreg(alloc, .Gpr);
            let len_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, data_p, mach_ir.mem_base_disp(buf_p, 0_i32), 8_usize, false, sp);
            try emit_load_mem(alloc, mf, len_v, mach_ir.mem_base_disp(buf_p, 8_i32), 8_usize, false, sp);
            let lo_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            let hi_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[2_usize], true, sp);

            if proven_safe {
                let sub_len = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_rr(alloc, mf, .Sub, sub_len, hi_v, lo_v, sp);
                let sub_p = try mf.new_vreg(alloc, .Gpr);
                if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                    try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(data_p, lo_v, esz.trunc.[u8](), 0_i32), sp));
                } else {
                    let sc = try emit_scale_index(alloc, mf, lo_v, esz, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(data_p, sc, 1_u8, 0_i32), sp));
                }
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), sub_p, 8_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), sub_len, 8_usize, sp);
                return;
            }
            let b_chk2 = try mf.add_block(alloc, ctx.cur_depth);
            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_oob = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_cmp_rr(alloc, mf, lo_v, hi_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_oob, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk2, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_chk2);
            try emit_cmp_rr(alloc, mf, hi_v, len_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_oob, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(b_chk2);

            mf.begin_block_insts(b_ok);
            let sub_len = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Sub, sub_len, hi_v, lo_v, sp);
            let sub_p = try mf.new_vreg(alloc, .Gpr);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(data_p, lo_v, esz.trunc.[u8](), 0_i32), sp));
            } else {
                let sc = try emit_scale_index(alloc, mf, lo_v, esz, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(data_p, sc, 1_u8, 0_i32), sp));
            }
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), sub_p, 8_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), sub_len, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_oob);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 4_i64, 4_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), 0_i64, 8_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), 0_i64, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oob);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .BufDestroy => {
            if args.len < 2_usize { return; }
            let buf_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let alloc_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[1_usize], get_arg_slot(arg_slots, 1_usize), sp);
            let data_p = try mf.new_vreg(alloc, .Gpr);
            let cap_v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, data_p, mach_ir.mem_base_disp(buf_p, 0_i32), 8_usize, false, sp);
            try emit_load_mem(alloc, mf, cap_v, mach_ir.mem_base_disp(buf_p, 16_i32), 8_usize, false, sp);
            let byte_sz = try emit_scale_index(alloc, mf, cap_v, esz, sp);
            try emit_call_free_raw(alloc, ctx, mf, interner, alloc_p, data_p, byte_sz, sp);
        }
        _ => {}
    }
    return;
}

fn emit_builtin_atomic_mmio(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    sp: span.Span,
) -> !OutOfMemory {
    let raw_sz = env.x64_layout(op.ty0).size;
    let sz = if raw_sz < 1_usize { 1_usize } else if raw_sz > 8_usize { 8_usize } else { raw_sz };
    let sz_u8 = sz.trunc.[u8]();
    match op.kind {
        .AtomicNew => {
            if args.len > 0_usize {
                let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[0_usize], false, sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
            }
        }
        .AtomicLoad => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, 0_i32), sz, env.is_signed_int(op.ty0), sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .AtomicStore => {
            if args.len < 2_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let nv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], false, sp);
            let old = try mf.new_vreg(alloc, .Gpr);
            var x = mach_ir.inst_empty(.XchgMem, sp);
            x.dst = old;
            x.src0 = nv;
            x.tied_src0 = true;
            x.mem = mach_ir.mem_base_disp(p, 0_i32);
            x.size_bytes = sz_u8;
            try mf.emit_inst(alloc, x);
        }
        .AtomicFetchAdd => {
            if args.len < 2_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let dv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], false, sp);
            let old = try mf.new_vreg(alloc, .Gpr);
            var x = mach_ir.inst_empty(.LockXadd, sp);
            x.dst = old;
            x.src0 = dv;
            x.tied_src0 = true;
            x.mem = mach_ir.mem_base_disp(p, 0_i32);
            x.size_bytes = sz_u8;
            try mf.emit_inst(alloc, x);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, old, sp);
        }
        .AtomicFetchSub => {
            if args.len < 2_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let dv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], false, sp);
            let ndv = try mf.new_vreg(alloc, .Gpr);
            try emit_unary_r(alloc, mf, .Neg, ndv, dv, sp);
            let old = try mf.new_vreg(alloc, .Gpr);
            var x = mach_ir.inst_empty(.LockXadd, sp);
            x.dst = old;
            x.src0 = ndv;
            x.tied_src0 = true;
            x.mem = mach_ir.mem_base_disp(p, 0_i32);
            x.size_bytes = sz_u8;
            try mf.emit_inst(alloc, x);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, old, sp);
        }
        .AtomicSwap => {
            if args.len < 2_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let nv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], false, sp);
            let old = try mf.new_vreg(alloc, .Gpr);
            var x = mach_ir.inst_empty(.XchgMem, sp);
            x.dst = old;
            x.src0 = nv;
            x.tied_src0 = true;
            x.mem = mach_ir.mem_base_disp(p, 0_i32);
            x.size_bytes = sz_u8;
            try mf.emit_inst(alloc, x);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, old, sp);
        }
        .AtomicCas => {
            if args.len < 3_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let exp_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], false, sp);
            let des_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[2_usize], false, sp);
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(exp_v, mach_ir.PHYS_RAX, sp));
            var c = mach_ir.inst_empty(.LockCmpxchg, sp);
            c.src1 = des_v;
            c.mem = mach_ir.mem_base_disp(p, 0_i32);
            c.size_bytes = sz_u8;
            c.clobber_gprs = mach_ir.phys_bit(mach_ir.PHYS_RAX);
            try mf.emit_inst(alloc, c);
            let ok = try mf.new_vreg(alloc, .Gpr);
            try emit_setcc_zext(alloc, mf, .E, ok, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, ok, sp);
        }
        .MmioRead => {
            if args.len == 0_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, 0_i32), sz, env.is_signed_int(op.ty0), sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .MmioWrite => {
            if args.len < 2_usize { return; }
            let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], false, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(p, 0_i32), v, sz, sp);
        }
        .RawPtrFromUsize => {
            if args.len > 0_usize {
                let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[0_usize], true, sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
            }
        }
        .RawPtrAsUsize => {
            if args.len > 0_usize {
                let v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[0_usize], true, sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
            }
        }
        _ => {}
    }
    return;
}

fn emit_builtin_slice_array(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    inst_gid: u32,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
    sp: span.Span,
) -> !OutOfMemory {
    let raw_esz = env.x64_layout(op.ty0).size;
    let esz = if raw_esz == 0_usize { 1_usize } else { raw_esz };
    let proven_safe = (eir_prog.inst_proven_flags(inst_gid) & eir.PROVEN_BOUNDS_SAFE) != 0_u8;

    match op.kind {
        .SliceLen => {
            if args.len > 0_usize {
                let pr = try load_slice_pair(alloc, ctx, mf, args[0_usize], sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, pr.hi, sp);
            }
        }
        .StrLen => {
            if args.len > 0_usize {
                let pr = try load_slice_pair(alloc, ctx, mf, args[0_usize], sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, pr.hi, sp);
            }
        }
        .ArrayLen => {
            let alen = if args.len > 0_usize { array_len_from_arg(eir_prog, ctx.fn_id, env, args[0_usize]) } else { 0_u64 };
            let v = try emit_imm_vreg(alloc, mf, alen, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .StrAsBytes => {
            if args.len > 0_usize {
                try emit_copy_val_to_val(alloc, ctx, mf, eir_prog, env, dst, args[0_usize], sp);
            }
        }
        .BytesAsStr => {
            if args.len > 0_usize {
                let doff = ctx_val_loc(ctx, dst).stack_off;
                let ok_ty = env.get(ret_ty).primary;
                let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
                let pr = try load_slice_pair(alloc, ctx, mf, args[0_usize], sp);
                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(pr.lo, mach_ir.PHYS_RDI, sp));
                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(pr.hi, mach_ir.PHYS_RSI, sp));
                try emit_helper_call(alloc, mf, interner, "eon_rt_validate_utf8", sp);
                let ok_v = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
                try mf.emit_inst(alloc, mach_ir.inst_def_fixed(ok_v, mach_ir.PHYS_RAX, sp));

                let b_ok = try mf.add_block(alloc, ctx.cur_depth);
                let b_err = try mf.add_block(alloc, ctx.cur_depth);
                let b_done = try mf.add_block(alloc, ctx.cur_depth);
                try emit_test_rr(alloc, mf, ok_v, ok_v, false, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, b_err, sp));
                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
                mf.end_block_insts(ctx.cur_mbb);

                mf.begin_block_insts(b_ok);
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), pr.lo, 8_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), pr.hi, 8_usize, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
                mf.end_block_insts(b_ok);

                mf.begin_block_insts(b_err);
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 5_i64, 4_usize, sp);
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), 0_i64, 8_usize, sp);
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), 0_i64, 8_usize, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
                mf.end_block_insts(b_err);

                mf.begin_block_insts(b_done);
                ctx.cur_mbb = b_done;
            }
            _ = 0_u8;
        }
        .SliceAt => {
            if args.len < 2_usize { return; }
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_off = env.eu_ok_offset(types.TY_USIZE).trunc.[i32]();
            let pr = try load_slice_pair(alloc, ctx, mf, args[0_usize], sp);
            let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            if proven_safe {
                let elem_p = try mf.new_vreg(alloc, .Gpr);
                if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                    try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(pr.lo, idx_v, esz.trunc.[u8](), 0_i32), sp));
                } else {
                    let sc = try emit_scale_index(alloc, mf, idx_v, esz, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(pr.lo, sc, 1_u8, 0_i32), sp));
                }
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), elem_p, 8_usize, sp);
                return;
            }
            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_oob = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);
            try emit_cmp_rr(alloc, mf, idx_v, pr.hi, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_oob, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_ok);
            let elem_p = try mf.new_vreg(alloc, .Gpr);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(pr.lo, idx_v, esz.trunc.[u8](), 0_i32), sp));
            } else {
                let sc = try emit_scale_index(alloc, mf, idx_v, esz, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(pr.lo, sc, 1_u8, 0_i32), sp));
            }
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), elem_p, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_oob);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 4_i64, 4_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), 0_i64, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oob);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .ArrayAt => {
            if args.len < 2_usize { return; }
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_off = env.eu_ok_offset(types.TY_USIZE).trunc.[i32]();
            let alen = array_len_from_arg(eir_prog, ctx.fn_id, env, args[0_usize]);
            let base_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            if proven_safe {
                let elem_p = try mf.new_vreg(alloc, .Gpr);
                if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                    try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(base_p, idx_v, esz.trunc.[u8](), 0_i32), sp));
                } else {
                    let sc = try emit_scale_index(alloc, mf, idx_v, esz, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(base_p, sc, 1_u8, 0_i32), sp));
                }
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), elem_p, 8_usize, sp);
                return;
            }
            let len_v = try emit_imm_vreg(alloc, mf, alen, sp);
            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_oob = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);
            try emit_cmp_rr(alloc, mf, idx_v, len_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_oob, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_ok);
            let elem_p = try mf.new_vreg(alloc, .Gpr);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(base_p, idx_v, esz.trunc.[u8](), 0_i32), sp));
            } else {
                let sc = try emit_scale_index(alloc, mf, idx_v, esz, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(base_p, sc, 1_u8, 0_i32), sp));
            }
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), elem_p, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_oob);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 4_i64, 4_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), 0_i64, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oob);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .SliceGet => {
            if args.len < 2_usize { return; }
            let pr = try load_slice_pair(alloc, ctx, mf, args[0_usize], sp);
            let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            let elem_p = try mf.new_vreg(alloc, .Gpr);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(pr.lo, idx_v, esz.trunc.[u8](), 0_i32), sp));
            } else {
                let sc = try emit_scale_index(alloc, mf, idx_v, esz, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(pr.lo, sc, 1_u8, 0_i32), sp));
            }
            if proven_safe {
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, elem_p, sp);
                return;
            }
            let z = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            let res = try mf.new_vreg(alloc, .Gpr);
            try emit_cmp_rr(alloc, mf, idx_v, pr.hi, sp);
            try emit_cmov(alloc, mf, .Ae, res, elem_p, z, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .ArrayGet => {
            if args.len < 2_usize { return; }
            let alen = array_len_from_arg(eir_prog, ctx.fn_id, env, args[0_usize]);
            let base_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            let elem_p = try mf.new_vreg(alloc, .Gpr);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(base_p, idx_v, esz.trunc.[u8](), 0_i32), sp));
            } else {
                let sc = try emit_scale_index(alloc, mf, idx_v, esz, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(elem_p, mach_ir.mem_sib(base_p, sc, 1_u8, 0_i32), sp));
            }
            if proven_safe {
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, elem_p, sp);
                return;
            }
            let len_v = try emit_imm_vreg(alloc, mf, alen, sp);
            let z = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            let res = try mf.new_vreg(alloc, .Gpr);
            try emit_cmp_rr(alloc, mf, idx_v, len_v, sp);
            try emit_cmov(alloc, mf, .Ae, res, elem_p, z, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .SliceSub => {
            if args.len < 3_usize { return; }
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let pr = try load_slice_pair(alloc, ctx, mf, args[0_usize], sp);
            let lo_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            let hi_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[2_usize], true, sp);
            if proven_safe {
                let sub_len = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_rr(alloc, mf, .Sub, sub_len, hi_v, lo_v, sp);
                let sub_p = try mf.new_vreg(alloc, .Gpr);
                if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                    try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(pr.lo, lo_v, esz.trunc.[u8](), 0_i32), sp));
                } else {
                    let sc = try emit_scale_index(alloc, mf, lo_v, esz, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(pr.lo, sc, 1_u8, 0_i32), sp));
                }
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), sub_p, 8_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), sub_len, 8_usize, sp);
                return;
            }
            let b_chk2 = try mf.add_block(alloc, ctx.cur_depth);
            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_oob = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_cmp_rr(alloc, mf, lo_v, hi_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_oob, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk2, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_chk2);
            try emit_cmp_rr(alloc, mf, hi_v, pr.hi, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_oob, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(b_chk2);

            mf.begin_block_insts(b_ok);
            let sub_len = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Sub, sub_len, hi_v, lo_v, sp);
            let sub_p = try mf.new_vreg(alloc, .Gpr);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(pr.lo, lo_v, esz.trunc.[u8](), 0_i32), sp));
            } else {
                let sc = try emit_scale_index(alloc, mf, lo_v, esz, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(pr.lo, sc, 1_u8, 0_i32), sp));
            }
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), sub_p, 8_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), sub_len, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_oob);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 4_i64, 4_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), 0_i64, 8_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), 0_i64, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oob);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        .ArraySub => {
            if args.len < 3_usize { return; }
            let doff = ctx_val_loc(ctx, dst).stack_off;
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let alen = array_len_from_arg(eir_prog, ctx.fn_id, env, args[0_usize]);
            let base_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
            let lo_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[1_usize], true, sp);
            let hi_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[2_usize], true, sp);
            let len_v = try emit_imm_vreg(alloc, mf, alen, sp);
            if proven_safe {
                let sub_len = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_rr(alloc, mf, .Sub, sub_len, hi_v, lo_v, sp);
                let sub_p = try mf.new_vreg(alloc, .Gpr);
                if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                    try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(base_p, lo_v, esz.trunc.[u8](), 0_i32), sp));
                } else {
                    let sc = try emit_scale_index(alloc, mf, lo_v, esz, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(base_p, sc, 1_u8, 0_i32), sp));
                }
                try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), sub_p, 8_usize, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), sub_len, 8_usize, sp);
                return;
            }
            let b_chk2 = try mf.add_block(alloc, ctx.cur_depth);
            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_oob = try mf.add_block(alloc, ctx.cur_depth);
            let b_done = try mf.add_block(alloc, ctx.cur_depth);

            try emit_cmp_rr(alloc, mf, lo_v, hi_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_oob, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk2, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_chk2);
            try emit_cmp_rr(alloc, mf, hi_v, len_v, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_oob, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(b_chk2);

            mf.begin_block_insts(b_ok);
            let sub_len = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Sub, sub_len, hi_v, lo_v, sp);
            let sub_p = try mf.new_vreg(alloc, .Gpr);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(base_p, lo_v, esz.trunc.[u8](), 0_i32), sp));
            } else {
                let sc = try emit_scale_index(alloc, mf, lo_v, esz, sp);
                try mf.emit_inst(alloc, mach_ir.inst_lea(sub_p, mach_ir.mem_sib(base_p, sc, 1_u8, 0_i32), sp));
            }
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 0_i64, 4_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), sub_p, 8_usize, sp);
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), sub_len, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_oob);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff), 4_i64, 4_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off), 0_i64, 8_usize, sp);
            try emit_store_imm_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ok_off +% 8_i32), 0_i64, 8_usize, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_done, sp));
            mf.end_block_insts(b_oob);

            mf.begin_block_insts(b_done);
            ctx.cur_mbb = b_done;
        }
        _ => {}
    }
    return;
}

fn emit_builtin_math(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    sp: span.Span,
) -> !OutOfMemory {
    if args.len == 0_usize {
        return;
    }
    let aty = eir_prog.fn_val_ty(ctx.fn_id, args[0_usize]);
    let an = env.get(aty);
    let is_f64 = an.kind == .Float && an.u8_val == 64_u8;
    let bytes = env.x64_layout(aty).size;
    match op.kind {
        .MathSqrt => {
            let av = try load_val_float(alloc, ctx, mf, eir_prog, env, args[0_usize], sp);
            let res = try mf.new_vreg(alloc, .Vec128);
            var m = mach_ir.inst_empty(if is_f64 { .VSqrtSD } else { .VSqrtSS }, sp);
            m.dst = res;
            m.src0 = av;
            m.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
            try mf.emit_inst(alloc, m);
            try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .MathFma => {
            if args.len < 3_usize { return; }
            let av = try load_val_float(alloc, ctx, mf, eir_prog, env, args[0_usize], sp);
            let bv = try load_val_float(alloc, ctx, mf, eir_prog, env, args[1_usize], sp);
            let cv = try load_val_float(alloc, ctx, mf, eir_prog, env, args[2_usize], sp);
            if mf.target_avx2 {
                let res = try mf.new_vreg(alloc, .Vec128);
                var m = mach_ir.inst_empty(if is_f64 { .VFmadd231SD } else { .VFmadd231SS }, sp);
                m.dst = res;
                m.src0 = cv;
                m.src1 = av;
                m.src2 = bv;
                m.tied_src0 = true;
                m.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
                try mf.emit_inst(alloc, m);
                try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
            } else {
                let prod = try mf.new_vreg(alloc, .Vec128);
                var mm = mach_ir.inst_empty(if is_f64 { .VMulSD } else { .VMulSS }, sp);
                mm.dst = prod;
                mm.src0 = av;
                mm.src1 = bv;
                mm.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
                try mf.emit_inst(alloc, mm);
                let res = try mf.new_vreg(alloc, .Vec128);
                var ma = mach_ir.inst_empty(if is_f64 { .VAddSD } else { .VAddSS }, sp);
                ma.dst = res;
                ma.src0 = prod;
                ma.src1 = cv;
                ma.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
                try mf.emit_inst(alloc, ma);
                try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
            }
        }
        .MathLzcnt => {
            var sv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[0_usize], false, sp);
            if bytes < 4_usize {
                let z = try mf.new_vreg(alloc, .Gpr);
                try emit_extend(alloc, mf, z, sv, bytes.trunc.[u8](), false, sp);
                sv = z;
            }
            let raw_v = try mf.new_vreg(alloc, .Gpr);
            var m = mach_ir.inst_empty(.Lzcnt, sp);
            m.dst = raw_v;
            m.src0 = sv;
            m.size_bytes = if bytes >= 8_usize { 8_u8 } else { 4_u8 };
            try mf.emit_inst(alloc, m);
            var res = raw_v;
            if bytes < 4_usize {
                let adj = (32_usize -% (bytes *% 8_usize)).trunc.[i64]();
                let r2 = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_ri(alloc, mf, .SubImm, r2, raw_v, adj, sp);
                res = r2;
            }
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .MathTzcnt => {
            var sv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[0_usize], false, sp);
            if bytes < 4_usize {
                // Set bit at width so tzcnt of 0 returns `bytes * 8` cleanly in 2 insts!
                let z = try mf.new_vreg(alloc, .Gpr);
                try emit_extend(alloc, mf, z, sv, bytes.trunc.[u8](), false, sp);
                let top = 1_u64 <<% (bytes *% 8_usize).widen.[u64]();
                let o = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_ri(alloc, mf, .OrImm, o, z, top.bitcast.[i64](), sp);
                sv = o;
            }
            let res = try mf.new_vreg(alloc, .Gpr);
            var m = mach_ir.inst_empty(.Tzcnt, sp);
            m.dst = res;
            m.src0 = sv;
            m.size_bytes = if bytes >= 8_usize { 8_u8 } else { 4_u8 };
            try mf.emit_inst(alloc, m);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .MathPopcnt => {
            var sv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[0_usize], false, sp);
            if bytes < 8_usize {
                let z = try mf.new_vreg(alloc, .Gpr);
                try emit_extend(alloc, mf, z, sv, bytes.trunc.[u8](), false, sp);
                sv = z;
            }
            let res = try mf.new_vreg(alloc, .Gpr);
            var m = mach_ir.inst_empty(.Popcnt, sp);
            m.dst = res;
            m.src0 = sv;
            m.size_bytes = 8_u8;
            try mf.emit_inst(alloc, m);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .MathBswap => {
            let sv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[0_usize], false, sp);
            let res = try mf.new_vreg(alloc, .Gpr);
            var m = mach_ir.inst_empty(.Bswap, sp);
            m.dst = res;
            m.src0 = sv;
            m.tied_src0 = true;
            m.size_bytes = if bytes < 2_usize { 2_u8 } else if bytes > 8_usize { 8_u8 } else { bytes.trunc.[u8]() };
            try mf.emit_inst(alloc, m);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        _ => {}
    }
    return;
}

fn emit_builtin_vec(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    sp: span.Span,
) -> !OutOfMemory {
    match op.kind {
        .VecSplat => {
            if args.len == 0_usize { return; }
            let vn = env.get(op.ty0);
            let elem = vn.primary;
            let lanes = vn.u8_val.widen.[usize]();
            let en = env.get(elem);
            let esz_r = env.x64_layout(elem).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            let total_sz = env.x64_layout(op.ty0).size;

            if total_sz == 16_usize || total_sz == 32_usize {
                let l256 = total_sz == 32_usize;
                let vc: mach_ir.RegClass = if l256 { .Vec256 } else { .Vec128 };
                if en.kind == .Float && (en.u8_val == 32_u8 || en.u8_val == 64_u8) {
                    let is_f64 = en.u8_val == 64_u8;
                    if !is_f64 {
                        let didx_sp = dst.widen.[usize]();
                        let fvl_sp = ctx.fused_vec_load_gid.as_slice();
                        if didx_sp < fvl_sp.len && fvl_sp[didx_sp] != eir.EIR_NONE {
                            let lgid = fvl_sp[didx_sp].widen.[usize]();
                            let all_insts = eir_prog.funcs.insts.as_slice();
                            if lgid < all_insts.len {
                                let lp0 = all_insts[lgid];
                                if let place = eir_prog.get_place(lp0.aux0) {
                                    let pm = try compute_place_mem(alloc, ctx, mf, eir_prog, env, place, place.projs.len.widen.[usize](), sp);
                                    let res = try mf.new_vreg(alloc, vc);
                                    var bm = mach_ir.inst_empty(.VBroadcastSS, sp);
                                    bm.dst = res;
                                    bm.mem = pm.mem;
                                    bm.flag0 = l256;
                                    bm.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                                    try mf.emit_inst(alloc, bm);
                                    try store_vec_to_val(alloc, ctx, mf, dst, res, l256, sp);
                                    return;
                                }
                            }
                        }
                    }
                    let fv = try load_val_float(alloc, ctx, mf, eir_prog, env, args[0_usize], sp);
                    let res = try mf.new_vreg(alloc, vc);
                    var b = mach_ir.inst_empty(if is_f64 { .VBroadcastSD } else { .VBroadcastSS }, sp);
                    b.dst = res;
                    b.src0 = fv;
                    b.flag0 = l256;
                    b.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                    try mf.emit_inst(alloc, b);
                    try store_vec_to_val(alloc, ctx, mf, dst, res, l256, sp);
                    return;
                }
                if esz == 1_usize || esz == 4_usize {
                    let sv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, args[0_usize], false, sp);
                    let sx = try mf.new_vreg(alloc, .Vec128);
                    var to_x = mach_ir.inst_empty(.VMovDToXmm, sp);
                    to_x.dst = sx;
                    to_x.src0 = sv;
                    to_x.size_bytes = 4_u8;
                    try mf.emit_inst(alloc, to_x);
                    let res = try mf.new_vreg(alloc, vc);
                    var b = mach_ir.inst_empty(if esz == 1_usize { .VPBroadcastB } else { .VPBroadcastD }, sp);
                    b.dst = res;
                    b.src0 = sx;
                    b.flag0 = l256;
                    b.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                    try mf.emit_inst(alloc, b);
                    try store_vec_to_val(alloc, ctx, mf, dst, res, l256, sp);
                    return;
                }
            }
            // Fallback splat via stack
            let dloc = ctx_val_loc(ctx, dst);
            let doff = if dloc.kind == .Stack { dloc.stack_off } else { ensure_scratch_vec_off(ctx, mf) };
            var li: usize = 0_usize;
            while li < lanes {
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(doff +% (li *% esz).trunc.[i32]()), args[0_usize], elem, sp);
                li = li +% 1_usize;
            }
            if dloc.kind != .Stack {
                try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_stack_slot(doff), op.ty0, sp);
            }
        }
        .VecLen => {
            let v = try emit_imm_vreg(alloc, mf, op.len_u8.widen.[u64](), sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
        }
        .VecCmp => {
            if args.len < 2_usize { return; }
            let vn = env.get(op.ty0);
            if vn.kind != .Vec { return; }
            let elem = vn.primary;
            let lanes = vn.u8_val.widen.[usize]();
            // Hardware AVX2/SSE fast path for u8x16 / i8x16 equality!
            if (elem == types.TY_U8 || elem == types.TY_I8) && lanes == 16_usize && op.bin_op == .Eq {
                let va = try load_val_vec(alloc, ctx, mf, args[0_usize], false, sp);
                let vb = try load_val_vec(alloc, ctx, mf, args[1_usize], false, sp);
                let cmp = try mf.new_vreg(alloc, .Vec128);
                var ce = mach_ir.inst_empty(.VPCmpEqB, sp);
                ce.dst = cmp;
                ce.src0 = va;
                ce.src1 = vb;
                ce.size_bytes = 16_u8;
                try mf.emit_inst(alloc, ce);
                // Normalize 0xFF -> 0x01 per byte so `vec[bool, 16]` has exact 0/1 booleans
                let one_g = try emit_imm_vreg(alloc, mf, 1_u64, sp);
                let one_x = try mf.new_vreg(alloc, .Vec128);
                var md = mach_ir.inst_empty(.VMovDToXmm, sp);
                md.dst = one_x;
                md.src0 = one_g;
                md.size_bytes = 4_u8;
                try mf.emit_inst(alloc, md);
                let ones = try mf.new_vreg(alloc, .Vec128);
                var bc = mach_ir.inst_empty(.VPBroadcastB, sp);
                bc.dst = ones;
                bc.src0 = one_x;
                bc.size_bytes = 16_u8;
                try mf.emit_inst(alloc, bc);
                let res = try mf.new_vreg(alloc, .Vec128);
                var an = mach_ir.inst_empty(.VPAnd, sp);
                an.dst = res;
                an.src0 = cmp;
                an.src1 = ones;
                an.size_bytes = 16_u8;
                try mf.emit_inst(alloc, an);
                try store_vec_to_val(alloc, ctx, mf, dst, res, false, sp);
                return;
            }
            // General lane-by-lane compare into vec[bool, N]
            let esz_r = env.x64_layout(elem).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            let en = env.get(elem);
            let sgn = env.is_signed_int(elem);
            let total_sz = env.x64_layout(op.ty0).size;
            let aoff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, args[0_usize], sp);
            let boff = if ctx_val_loc(ctx, args[1_usize]).kind == .Stack {
                ctx_val_loc(ctx, args[1_usize]).stack_off
            } else {
                let t = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(t), args[1_usize], op.ty0, sp);
                t
            };
            let dloc = ctx_val_loc(ctx, dst);
            let doff = if dloc.kind == .Stack { dloc.stack_off } else { mf.alloc_stack_slot(if lanes < 8_usize { 8_usize } else { lanes }, 16_usize) };
            var li: usize = 0_usize;
            while li < lanes {
                let ao = aoff +% (li *% esz).trunc.[i32]();
                let bo = boff +% (li *% esz).trunc.[i32]();
                let bres = try mf.new_vreg(alloc, .Gpr);
                if en.kind == .Float {
                    let is_f64 = en.u8_val == 64_u8;
                    let fa = try mf.new_vreg(alloc, .Vec128);
                    let fb = try mf.new_vreg(alloc, .Vec128);
                    var la = mach_ir.inst_empty(if is_f64 { .VMovSDLoad } else { .VMovSSLoad }, sp);
                    la.dst = fa;
                    la.mem = mach_ir.mem_stack_slot(ao);
                    try mf.emit_inst(alloc, la);
                    var lb = mach_ir.inst_empty(if is_f64 { .VMovSDLoad } else { .VMovSSLoad }, sp);
                    lb.dst = fb;
                    lb.mem = mach_ir.mem_stack_slot(bo);
                    try mf.emit_inst(alloc, lb);
                    let ucop: mach_ir.MachOp = if is_f64 { .VUcomiSD } else { .VUcomiSS };
                    match op.bin_op {
                        .Eq => {
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = fa; u.src1 = fb; try mf.emit_inst(alloc, u);
                            let s1 = try mf.new_vreg(alloc, .Gpr); let s2 = try mf.new_vreg(alloc, .Gpr);
                            var i1 = mach_ir.inst_empty(.Setcc, sp); i1.dst = s1; i1.cc = .E; i1.size_bytes = 1_u8; try mf.emit_inst(alloc, i1);
                            var i2 = mach_ir.inst_empty(.Setcc, sp); i2.dst = s2; i2.cc = .Np; i2.size_bytes = 1_u8; try mf.emit_inst(alloc, i2);
                            try emit_alu_rr(alloc, mf, .And, bres, s1, s2, sp);
                        }
                        .NotEq => {
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = fa; u.src1 = fb; try mf.emit_inst(alloc, u);
                            let s1 = try mf.new_vreg(alloc, .Gpr); let s2 = try mf.new_vreg(alloc, .Gpr);
                            var i1 = mach_ir.inst_empty(.Setcc, sp); i1.dst = s1; i1.cc = .Ne; i1.size_bytes = 1_u8; try mf.emit_inst(alloc, i1);
                            var i2 = mach_ir.inst_empty(.Setcc, sp); i2.dst = s2; i2.cc = .P; i2.size_bytes = 1_u8; try mf.emit_inst(alloc, i2);
                            try emit_alu_rr(alloc, mf, .Or, bres, s1, s2, sp);
                        }
                        .Lt => {
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = fb; u.src1 = fa; try mf.emit_inst(alloc, u);
                            try emit_setcc_zext(alloc, mf, .A, bres, sp);
                        }
                        .LtEq => {
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = fb; u.src1 = fa; try mf.emit_inst(alloc, u);
                            try emit_setcc_zext(alloc, mf, .Ae, bres, sp);
                        }
                        .Gt => {
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = fa; u.src1 = fb; try mf.emit_inst(alloc, u);
                            try emit_setcc_zext(alloc, mf, .A, bres, sp);
                        }
                        _ => {
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = fa; u.src1 = fb; try mf.emit_inst(alloc, u);
                            try emit_setcc_zext(alloc, mf, .Ae, bres, sp);
                        }
                    }
                    _ = 0_u8;
                } else {
                    let a = try mf.new_vreg(alloc, .Gpr);
                    let b = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, a, mach_ir.mem_stack_slot(ao), esz, sgn, sp);
                    try emit_load_mem(alloc, mf, b, mach_ir.mem_stack_slot(bo), esz, sgn, sp);
                    try emit_cmp_rr(alloc, mf, a, b, sp);
                    let cc: x64_asm.Cond = match op.bin_op {
                        .Eq => { .E }
                        .NotEq => { .Ne }
                        .Lt => { if sgn { .L } else { .B } }
                        .LtEq => { if sgn { .Le } else { .Be } }
                        .Gt => { if sgn { .G } else { .A } }
                        _ => { if sgn { .Ge } else { .Ae } }
                    };
                    try emit_setcc_zext(alloc, mf, cc, bres, sp);
                }
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% li.trunc.[i32]()), bres, 1_usize, sp);
                li = li +% 1_usize;
            }
            if dloc.kind != .Stack {
                let dty = eir_prog.fn_val_ty(ctx.fn_id, dst);
                try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_stack_slot(doff), dty, sp);
            }
        }
        .VecBitmask => {
            if args.len == 0_usize { return; }
            // Check fused `VecBitmask(VecCmp(u8x16/u8x32, Eq, a, b))` -> 2 hardware instructions!
            let didx = dst.widen.[usize]();
            let fbc = ctx.fused_bitmask_cmp.as_slice();
            if didx < fbc.len && fbc[didx] != eir.EIR_NONE {
                let all_insts = eir_prog.funcs.insts.as_slice();
                let cg = fbc[didx].widen.[usize]();
                if cg < all_insts.len {
                    if let cbc = eir_prog.get_builtin_call(all_insts[cg].aux0) {
                        let cargs = eir_prog.vals_slice(cbc.args);
                        if cargs.len >= 2_usize {
                            let l256 = op.len_u8 == 32_u8;
                            let ascii_src = match_ascii_signbit_src(eir_prog, ctx, cargs[0_usize], cargs[1_usize]);
                            if ascii_src != eir.EIR_NONE {
                                // `((x & splat(0x80)) == splat(0)).bitmask()` == `vpmovmskb(x) ^ all_ones`!
                                let vx = try load_val_vec(alloc, ctx, mf, ascii_src, l256, sp);
                                let raw_msk = try mf.new_vreg(alloc, .Gpr);
                                var pm = mach_ir.inst_empty(.VPMovMskB, sp);
                                pm.dst = raw_msk;
                                pm.src0 = vx;
                                pm.flag0 = l256;
                                pm.size_bytes = 4_u8;
                                try mf.emit_inst(alloc, pm);
                                let inv_msk = try mf.new_vreg(alloc, .Gpr);
                                if l256 {
                                    let all32 = try emit_imm_vreg(alloc, mf, 0xFFFFFFFF_u64, sp);
                                    try emit_alu_rr(alloc, mf, .Xor, inv_msk, raw_msk, all32, sp);
                                } else {
                                    try emit_alu_ri(alloc, mf, .XorImm, inv_msk, raw_msk, 0xFFFF_i64, sp);
                                }
                                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, inv_msk, sp);
                                return;
                            }
                            let va = try load_val_vec(alloc, ctx, mf, cargs[0_usize], l256, sp);
                            let vb = try load_val_vec(alloc, ctx, mf, cargs[1_usize], l256, sp);
                            let cmp = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
                            var ce = mach_ir.inst_empty(.VPCmpEqB, sp);
                            ce.dst = cmp;
                            ce.src0 = va;
                            ce.src1 = vb;
                            ce.flag0 = l256;
                            ce.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                            try mf.emit_inst(alloc, ce);
                            let msk = try mf.new_vreg(alloc, .Gpr);
                            var pm = mach_ir.inst_empty(.VPMovMskB, sp);
                            pm.dst = msk;
                            pm.src0 = cmp;
                            pm.flag0 = l256;
                            pm.size_bytes = 4_u8;
                            try mf.emit_inst(alloc, pm);
                            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, msk, sp);
                            return;
                        }
                    }
                }
            }
            let lanes = op.len_u8.widen.[usize]();
            if lanes == 16_usize || lanes == 32_usize {
                let l256 = lanes == 32_usize;
                let mv = try load_val_vec(alloc, ctx, mf, args[0_usize], l256, sp);
                let sh = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
                var sl = mach_ir.inst_empty(.VPSllWImm, sp);
                sl.dst = sh;
                sl.src0 = mv;
                sl.imm = 7_i64;
                sl.flag0 = l256;
                sl.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                try mf.emit_inst(alloc, sl);
                let msk = try mf.new_vreg(alloc, .Gpr);
                var pm = mach_ir.inst_empty(.VPMovMskB, sp);
                pm.dst = msk;
                pm.src0 = sh;
                pm.flag0 = l256;
                pm.size_bytes = 4_u8;
                try mf.emit_inst(alloc, pm);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, msk, sp);
                return;
            }
            let aoff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, args[0_usize], sp);
            var acc = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            var li: usize = 0_usize;
            while li < lanes {
                let b = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, b, mach_ir.mem_stack_slot(aoff +% li.trunc.[i32]()), 1_usize, false, sp);
                let m = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_ri(alloc, mf, .AndImm, m, b, 1_i64, sp);
                var bit = m;
                if li > 0_usize {
                    let s = try mf.new_vreg(alloc, .Gpr);
                    try emit_alu_ri(alloc, mf, .ShlImm, s, m, li.trunc.[i64](), sp);
                    bit = s;
                }
                let nxt = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_rr(alloc, mf, .Or, nxt, acc, bit, sp);
                acc = nxt;
                li = li +% 1_usize;
            }
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, acc, sp);
        }
        .VecMaskAny => {
            if args.len == 0_usize { return; }
            let didx = dst.widen.[usize]();
            let fbc = ctx.fused_bitmask_cmp.as_slice();
            if didx < fbc.len && fbc[didx] != eir.EIR_NONE {
                let all_insts = eir_prog.funcs.insts.as_slice();
                let cg = fbc[didx].widen.[usize]();
                if cg < all_insts.len {
                    if let cbc = eir_prog.get_builtin_call(all_insts[cg].aux0) {
                        let cargs = eir_prog.vals_slice(cbc.args);
                        if cargs.len >= 2_usize {
                            let l256 = op.len_u8 == 32_u8;
                            let va = try load_val_vec(alloc, ctx, mf, cargs[0_usize], l256, sp);
                            let vb = try load_val_vec(alloc, ctx, mf, cargs[1_usize], l256, sp);
                            let cmp = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
                            var ce = mach_ir.inst_empty(.VPCmpEqB, sp);
                            ce.dst = cmp;
                            ce.src0 = va;
                            ce.src1 = vb;
                            ce.flag0 = l256;
                            ce.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                            try mf.emit_inst(alloc, ce);
                            let msk = try mf.new_vreg(alloc, .Gpr);
                            var pm = mach_ir.inst_empty(.VPMovMskB, sp);
                            pm.dst = msk;
                            pm.src0 = cmp;
                            pm.flag0 = l256;
                            pm.size_bytes = 4_u8;
                            try mf.emit_inst(alloc, pm);
                            try emit_test_rr(alloc, mf, msk, msk, true, sp);
                            let res = try mf.new_vreg(alloc, .Gpr);
                            try emit_setcc_zext(alloc, mf, .Ne, res, sp);
                            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
                            return;
                        }
                    }
                }
            }
            let lanes = op.len_u8.widen.[usize]();
            if lanes == 16_usize || lanes == 32_usize {
                let l256 = lanes == 32_usize;
                let mv = try load_val_vec(alloc, ctx, mf, args[0_usize], l256, sp);
                let sh = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
                var sl = mach_ir.inst_empty(.VPSllWImm, sp);
                sl.dst = sh;
                sl.src0 = mv;
                sl.imm = 7_i64;
                sl.flag0 = l256;
                try mf.emit_inst(alloc, sl);
                let msk = try mf.new_vreg(alloc, .Gpr);
                var pm = mach_ir.inst_empty(.VPMovMskB, sp);
                pm.dst = msk;
                pm.src0 = sh;
                pm.flag0 = l256;
                try mf.emit_inst(alloc, pm);
                try emit_test_rr(alloc, mf, msk, msk, true, sp);
                let res = try mf.new_vreg(alloc, .Gpr);
                try emit_setcc_zext(alloc, mf, .Ne, res, sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
                return;
            }
            let aoff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, args[0_usize], sp);
            var acc = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            var li: usize = 0_usize;
            while li < lanes {
                let b = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, b, mach_ir.mem_stack_slot(aoff +% li.trunc.[i32]()), 1_usize, false, sp);
                let nxt = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_rr(alloc, mf, .Or, nxt, acc, b, sp);
                acc = nxt;
                li = li +% 1_usize;
            }
            try emit_test_rr(alloc, mf, acc, acc, true, sp);
            let res = try mf.new_vreg(alloc, .Gpr);
            try emit_setcc_zext(alloc, mf, .Ne, res, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .VecMaskAll => {
            if args.len == 0_usize { return; }
            let didx = dst.widen.[usize]();
            let fbc = ctx.fused_bitmask_cmp.as_slice();
            if didx < fbc.len && fbc[didx] != eir.EIR_NONE {
                let all_insts = eir_prog.funcs.insts.as_slice();
                let cg = fbc[didx].widen.[usize]();
                if cg < all_insts.len {
                    if let cbc = eir_prog.get_builtin_call(all_insts[cg].aux0) {
                        let cargs = eir_prog.vals_slice(cbc.args);
                        if cargs.len >= 2_usize {
                            let l256 = op.len_u8 == 32_u8;
                            let va = try load_val_vec(alloc, ctx, mf, cargs[0_usize], l256, sp);
                            let vb = try load_val_vec(alloc, ctx, mf, cargs[1_usize], l256, sp);
                            let cmp = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
                            var ce = mach_ir.inst_empty(.VPCmpEqB, sp);
                            ce.dst = cmp;
                            ce.src0 = va;
                            ce.src1 = vb;
                            ce.flag0 = l256;
                            ce.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                            try mf.emit_inst(alloc, ce);
                            let msk = try mf.new_vreg(alloc, .Gpr);
                            var pm = mach_ir.inst_empty(.VPMovMskB, sp);
                            pm.dst = msk;
                            pm.src0 = cmp;
                            pm.flag0 = l256;
                            pm.size_bytes = 4_u8;
                            try mf.emit_inst(alloc, pm);
                            let full_m = try emit_imm_vreg(alloc, mf, if l256 { 0xFFFFFFFF_u64 } else { 0xFFFF_u64 }, sp);
                            try emit_cmp_rr(alloc, mf, msk, full_m, sp);
                            let res = try mf.new_vreg(alloc, .Gpr);
                            try emit_setcc_zext(alloc, mf, .E, res, sp);
                            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
                            return;
                        }
                    }
                }
            }
            let lanes = op.len_u8.widen.[usize]();
            if lanes == 16_usize || lanes == 32_usize {
                let l256 = lanes == 32_usize;
                let mv = try load_val_vec(alloc, ctx, mf, args[0_usize], l256, sp);
                let sh = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
                var sl = mach_ir.inst_empty(.VPSllWImm, sp);
                sl.dst = sh;
                sl.src0 = mv;
                sl.imm = 7_i64;
                sl.flag0 = l256;
                try mf.emit_inst(alloc, sl);
                let msk = try mf.new_vreg(alloc, .Gpr);
                var pm = mach_ir.inst_empty(.VPMovMskB, sp);
                pm.dst = msk;
                pm.src0 = sh;
                pm.flag0 = l256;
                try mf.emit_inst(alloc, pm);
                let full_m = try emit_imm_vreg(alloc, mf, if l256 { 0xFFFFFFFF_u64 } else { 0xFFFF_u64 }, sp);
                try emit_cmp_rr(alloc, mf, msk, full_m, sp);
                let res = try mf.new_vreg(alloc, .Gpr);
                try emit_setcc_zext(alloc, mf, .E, res, sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
                return;
            }
            let aoff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, args[0_usize], sp);
            var acc = try emit_imm_vreg(alloc, mf, 1_u64, sp);
            var li: usize = 0_usize;
            while li < lanes {
                let b = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, b, mach_ir.mem_stack_slot(aoff +% li.trunc.[i32]()), 1_usize, false, sp);
                let nxt = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_rr(alloc, mf, .And, nxt, acc, b, sp);
                acc = nxt;
                li = li +% 1_usize;
            }
            let res = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_ri(alloc, mf, .AndImm, res, acc, 1_i64, sp);
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        }
        .VecMin => {
            if args.len < 2_usize { return; }
            let vn = env.get(op.ty0);
            let elem = vn.primary;
            let en = env.get(elem);
            let total_sz = env.x64_layout(op.ty0).size;
            if (total_sz == 16_usize || total_sz == 32_usize) && ((en.kind == .Float && (en.u8_val == 32_u8 || en.u8_val == 64_u8)) || (en.kind == .Int && en.u8_val == 32_u8 && env.is_signed_int(elem))) {
                let l256 = total_sz == 32_usize;
                let va = try load_val_vec(alloc, ctx, mf, args[0_usize], l256, sp);
                let vb = try load_val_vec(alloc, ctx, mf, args[1_usize], l256, sp);
                let res = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
                let mop: mach_ir.MachOp = if en.kind == .Float {
                    if en.u8_val == 64_u8 { .VMinPD } else { .VMinPS }
                } else {
                    .VPMinSD
                };
                var m = mach_ir.inst_empty(mop, sp);
                m.dst = res;
                m.src0 = va;
                m.src1 = vb;
                m.flag0 = l256;
                m.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                try mf.emit_inst(alloc, m);
                try store_vec_to_val(alloc, ctx, mf, dst, res, l256, sp);
                return;
            }
            try emit_vec_minmax_fallback(alloc, ctx, mf, eir_prog, env, dst, op, args, true, sp);
        }
        .VecMax => {
            if args.len < 2_usize { return; }
            let vn = env.get(op.ty0);
            let elem = vn.primary;
            let en = env.get(elem);
            let total_sz = env.x64_layout(op.ty0).size;
            if (total_sz == 16_usize || total_sz == 32_usize) && ((en.kind == .Float && (en.u8_val == 32_u8 || en.u8_val == 64_u8)) || (en.kind == .Int && en.u8_val == 32_u8 && env.is_signed_int(elem))) {
                let l256 = total_sz == 32_usize;
                let va = try load_val_vec(alloc, ctx, mf, args[0_usize], l256, sp);
                let vb = try load_val_vec(alloc, ctx, mf, args[1_usize], l256, sp);
                let res = try mf.new_vreg(alloc, if l256 { .Vec256 } else { .Vec128 });
                let mop: mach_ir.MachOp = if en.kind == .Float {
                    if en.u8_val == 64_u8 { .VMaxPD } else { .VMaxPS }
                } else {
                    .VPMaxSD
                };
                var m = mach_ir.inst_empty(mop, sp);
                m.dst = res;
                m.src0 = va;
                m.src1 = vb;
                m.flag0 = l256;
                m.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                try mf.emit_inst(alloc, m);
                try store_vec_to_val(alloc, ctx, mf, dst, res, l256, sp);
                return;
            }
            try emit_vec_minmax_fallback(alloc, ctx, mf, eir_prog, env, dst, op, args, false, sp);
        }
        .VecFma => {
            if args.len < 3_usize { return; }
            let vn = env.get(op.ty0);
            let elem = vn.primary;
            let en = env.get(elem);
            let total_sz = env.x64_layout(op.ty0).size;
            if mf.target_avx2 && en.kind == .Float && (total_sz == 16_usize || total_sz == 32_usize) && (en.u8_val == 32_u8 || en.u8_val == 64_u8) {
                let l256 = total_sz == 32_usize;
                let is_f64 = en.u8_val == 64_u8;
                let va = try load_val_vec(alloc, ctx, mf, args[0_usize], l256, sp);
                let vb = try load_val_vec(alloc, ctx, mf, args[1_usize], l256, sp);
                let vc = try load_val_vec(alloc, ctx, mf, args[2_usize], l256, sp);
                let cls: mach_ir.RegClass = if l256 { .Vec256 } else { .Vec128 };
                let res = try mf.new_vreg(alloc, cls);
                var mf_inst = mach_ir.inst_empty(if is_f64 { .VFmadd231PD } else { .VFmadd231PS }, sp);
                mf_inst.dst = res;
                mf_inst.src0 = vc;
                mf_inst.src1 = va;
                mf_inst.src2 = vb;
                mf_inst.tied_src0 = true;
                mf_inst.flag0 = l256;
                mf_inst.size_bytes = if l256 { 32_u8 } else { 16_u8 };
                try mf.emit_inst(alloc, mf_inst);
                try store_vec_to_val(alloc, ctx, mf, dst, res, l256, sp);
                return;
            }
            try emit_vec_fma_fallback(alloc, ctx, mf, eir_prog, env, dst, op, args, sp);
        }
        .VecReduceAdd => { try emit_vec_reduce_or_dot(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecReduceMin => { try emit_vec_reduce_or_dot(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecReduceMax => { try emit_vec_reduce_or_dot(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecDot => { try emit_vec_reduce_or_dot(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecSelect => {
            if args.len < 3_usize { return; }
            let vn = env.get(op.ty0);
            let elem = vn.primary;
            let lanes = vn.u8_val.widen.[usize]();
            let esz_r = env.x64_layout(elem).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            let total_sz = env.x64_layout(op.ty0).size;
            let moff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, args[0_usize], sp);
            let aoff = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
            let boff = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
            try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(aoff), args[1_usize], op.ty0, sp);
            try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(boff), args[2_usize], op.ty0, sp);
            let dloc = ctx_val_loc(ctx, dst);
            let doff = if dloc.kind == .Stack { dloc.stack_off } else { mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize) };
            var li: usize = 0_usize;
            while li < lanes {
                let ld = (li *% esz).trunc.[i32]();
                let bv = try mf.new_vreg(alloc, .Gpr);
                let av = try mf.new_vreg(alloc, .Gpr);
                let mv = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, bv, mach_ir.mem_stack_slot(boff +% ld), esz, false, sp);
                try emit_load_mem(alloc, mf, av, mach_ir.mem_stack_slot(aoff +% ld), esz, false, sp);
                try emit_load_mem(alloc, mf, mv, mach_ir.mem_stack_slot(moff +% li.trunc.[i32]()), 1_usize, false, sp);
                try emit_test_rr(alloc, mf, mv, mv, true, sp);
                let res = try mf.new_vreg(alloc, .Gpr);
                try emit_cmov(alloc, mf, .Ne, res, bv, av, sp);
                try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ld), res, esz, sp);
                li = li +% 1_usize;
            }
            if dloc.kind != .Stack {
                try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_stack_slot(doff), op.ty0, sp);
            }
        }
        .VecShuffle => {
            try emit_vec_shuffle(alloc, ctx, mf, eir_prog, env, dst, op, args, sp);
        }
        _ => {}
    }
    return;
}

fn emit_vec_minmax_fallback(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    is_min: bool,
    sp: span.Span,
) -> !OutOfMemory {
    let vn = env.get(op.ty0);
    if args.len < 2_usize { return; }
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let esz_r = env.x64_layout(elem).size;
    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
    let total_sz = env.x64_layout(op.ty0).size;
    let sgn = env.is_signed_int(elem);
    let aoff = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
    let boff = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(aoff), args[0_usize], op.ty0, sp);
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(boff), args[1_usize], op.ty0, sp);
    let dloc = ctx_val_loc(ctx, dst);
    let doff = if dloc.kind == .Stack { dloc.stack_off } else { mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize) };
    let cc: x64_asm.Cond = if is_min { if sgn { .L } else { .B } } else { if sgn { .G } else { .A } };
    var li: usize = 0_usize;
    while li < lanes {
        let ld = (li *% esz).trunc.[i32]();
        let a = try mf.new_vreg(alloc, .Gpr);
        let b = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, a, mach_ir.mem_stack_slot(aoff +% ld), esz, sgn, sp);
        try emit_load_mem(alloc, mf, b, mach_ir.mem_stack_slot(boff +% ld), esz, sgn, sp);
        try emit_cmp_rr(alloc, mf, b, a, sp);
        let r = try mf.new_vreg(alloc, .Gpr);
        try emit_cmov(alloc, mf, cc, r, a, b, sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ld), r, esz, sp);
        li = li +% 1_usize;
    }
    if dloc.kind != .Stack {
        try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_stack_slot(doff), op.ty0, sp);
    }
    return;
}

fn emit_vec_fma_fallback(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    sp: span.Span,
) -> !OutOfMemory {
    let vn = env.get(op.ty0);
    if args.len < 3_usize { return; }
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let esz_r = env.x64_layout(elem).size;
    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
    let total_sz = env.x64_layout(op.ty0).size;
    let aoff = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
    let boff = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
    let coff = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(aoff), args[0_usize], op.ty0, sp);
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(boff), args[1_usize], op.ty0, sp);
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(coff), args[2_usize], op.ty0, sp);
    let dloc = ctx_val_loc(ctx, dst);
    let doff = if dloc.kind == .Stack { dloc.stack_off } else { mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize) };
    let sgn = env.is_signed_int(elem);
    var li: usize = 0_usize;
    while li < lanes {
        let ld = (li *% esz).trunc.[i32]();
        let a = try mf.new_vreg(alloc, .Gpr);
        let b = try mf.new_vreg(alloc, .Gpr);
        let c = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, a, mach_ir.mem_stack_slot(aoff +% ld), esz, sgn, sp);
        try emit_load_mem(alloc, mf, b, mach_ir.mem_stack_slot(boff +% ld), esz, sgn, sp);
        try emit_load_mem(alloc, mf, c, mach_ir.mem_stack_slot(coff +% ld), esz, sgn, sp);
        let p = try mf.new_vreg(alloc, .Gpr);
        let r = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .Mul, p, a, b, sp);
        try emit_alu_rr(alloc, mf, .Add, r, p, c, sp);
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% ld), r, esz, sp);
        li = li +% 1_usize;
    }
    if dloc.kind != .Stack {
        try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_stack_slot(doff), op.ty0, sp);
    }
    return;
}

fn emit_vec_reduce_or_dot(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    sp: span.Span,
) -> !OutOfMemory {
    if args.len == 0_usize { return; }
    let vn = env.get(op.ty0);
    if vn.kind != .Vec { return; }
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem);
    let is_dot = op.kind == .VecDot;

    // Fast in-register XMM reduction for f32x4 and f64x2 (ZERO stack spills, exact left-to-right IEEE-754!)
    if en.kind == .Float && ((en.u8_val == 32_u8 && lanes == 4_usize) || (en.u8_val == 64_u8 && lanes == 2_usize)) {
        let is_f64 = en.u8_val == 64_u8;
        var vec_v = try load_val_vec(alloc, ctx, mf, args[0_usize], false, sp);
        if is_dot && args.len > 1_usize {
            let vb = try load_val_vec(alloc, ctx, mf, args[1_usize], false, sp);
            let prod = try mf.new_vreg(alloc, .Vec128);
            var pm = mach_ir.inst_empty(if is_f64 { .VMulPD } else { .VMulPS }, sp);
            pm.dst = prod;
            pm.src0 = vec_v;
            pm.src1 = vb;
            pm.size_bytes = 16_u8;
            try mf.emit_inst(alloc, pm);
            vec_v = prod;
        }
        let sop: mach_ir.MachOp = if op.kind == .VecReduceMin {
            if is_f64 { .VMinSD } else { .VMinSS }
        } else if op.kind == .VecReduceMax {
            if is_f64 { .VMaxSD } else { .VMaxSS }
        } else {
            if is_f64 { .VAddSD } else { .VAddSS }
        };
        if is_f64 {
            let hi = try mf.new_vreg(alloc, .Vec128);
            var sh = mach_ir.inst_empty(.VShufPS, sp);
            sh.dst = hi; sh.src0 = vec_v; sh.src1 = vec_v; sh.imm = 0xEE_i64; sh.size_bytes = 16_u8;
            try mf.emit_inst(alloc, sh);
            let res = try mf.new_vreg(alloc, .Vec128);
            var m = mach_ir.inst_empty(sop, sp);
            m.dst = res; m.src0 = vec_v; m.src1 = hi; m.size_bytes = 8_u8;
            try mf.emit_inst(alloc, m);
            try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
            return;
        }
        // f32x4 left-to-right: (((l0 op l1) op l2) op l3)
        let l1 = try mf.new_vreg(alloc, .Vec128);
        var s1 = mach_ir.inst_empty(.VShufPS, sp); s1.dst = l1; s1.src0 = vec_v; s1.src1 = vec_v; s1.imm = 0x55_i64; s1.size_bytes = 16_u8; try mf.emit_inst(alloc, s1);
        let a1 = try mf.new_vreg(alloc, .Vec128);
        var m1 = mach_ir.inst_empty(sop, sp); m1.dst = a1; m1.src0 = vec_v; m1.src1 = l1; m1.size_bytes = 4_u8; try mf.emit_inst(alloc, m1);

        let l2 = try mf.new_vreg(alloc, .Vec128);
        var s2 = mach_ir.inst_empty(.VShufPS, sp); s2.dst = l2; s2.src0 = vec_v; s2.src1 = vec_v; s2.imm = 0xAA_i64; s2.size_bytes = 16_u8; try mf.emit_inst(alloc, s2);
        let a2 = try mf.new_vreg(alloc, .Vec128);
        var m2 = mach_ir.inst_empty(sop, sp); m2.dst = a2; m2.src0 = a1; m2.src1 = l2; m2.size_bytes = 4_u8; try mf.emit_inst(alloc, m2);

        let l3 = try mf.new_vreg(alloc, .Vec128);
        var s3 = mach_ir.inst_empty(.VShufPS, sp); s3.dst = l3; s3.src0 = vec_v; s3.src1 = vec_v; s3.imm = 0xFF_i64; s3.size_bytes = 16_u8; try mf.emit_inst(alloc, s3);
        let res = try mf.new_vreg(alloc, .Vec128);
        var m3 = mach_ir.inst_empty(sop, sp); m3.dst = res; m3.src0 = a2; m3.src1 = l3; m3.size_bytes = 4_u8; try mf.emit_inst(alloc, m3);
        try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, res, sp);
        return;
    }

    // General reduction via stack materialization
    let esz_r = env.x64_layout(elem).size;
    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
    let total_sz = env.x64_layout(op.ty0).size;
    let aoff = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(aoff), args[0_usize], op.ty0, sp);
    var boff: i32 = 0_i32;
    if is_dot && args.len > 1_usize {
        boff = mf.alloc_stack_slot(if total_sz < 8_usize { 8_usize } else { total_sz }, 16_usize);
        try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(boff), args[1_usize], op.ty0, sp);
    }

    if en.kind == .Float {
        let is_f64 = en.u8_val == 64_u8;
        let sop: mach_ir.MachOp = if op.kind == .VecReduceMin {
            if is_f64 { .VMinSD } else { .VMinSS }
        } else if op.kind == .VecReduceMax {
            if is_f64 { .VMaxSD } else { .VMaxSS }
        } else {
            if is_f64 { .VAddSD } else { .VAddSS }
        };
        var acc = mach_ir.VREG_NONE;
        var li: usize = 0_usize;
        while li < lanes {
            let ld = (li *% esz).trunc.[i32]();
            var cur = try mf.new_vreg(alloc, .Vec128);
            var la = mach_ir.inst_empty(if is_f64 { .VMovSDLoad } else { .VMovSSLoad }, sp);
            la.dst = cur; la.mem = mach_ir.mem_stack_slot(aoff +% ld);
            try mf.emit_inst(alloc, la);
            if is_dot {
                let b = try mf.new_vreg(alloc, .Vec128);
                var lb = mach_ir.inst_empty(if is_f64 { .VMovSDLoad } else { .VMovSSLoad }, sp);
                lb.dst = b; lb.mem = mach_ir.mem_stack_slot(boff +% ld);
                try mf.emit_inst(alloc, lb);
                let p = try mf.new_vreg(alloc, .Vec128);
                var pm = mach_ir.inst_empty(if is_f64 { .VMulSD } else { .VMulSS }, sp);
                pm.dst = p; pm.src0 = cur; pm.src1 = b;
                try mf.emit_inst(alloc, pm);
                cur = p;
            }
            if li == 0_usize {
                acc = cur;
            } else {
                let nxt = try mf.new_vreg(alloc, .Vec128);
                var m = mach_ir.inst_empty(sop, sp);
                m.dst = nxt; m.src0 = acc; m.src1 = cur;
                try mf.emit_inst(alloc, m);
                acc = nxt;
            }
            li = li +% 1_usize;
        }
        if acc != mach_ir.VREG_NONE {
            try store_float_to_val(alloc, ctx, mf, eir_prog, env, dst, acc, sp);
        }
        return;
    }

    let sgn = env.is_signed_int(elem);
    var acc = try emit_imm_vreg(alloc, mf, 0_u64, sp);
    var li: usize = 0_usize;
    while li < lanes {
        let ld = (li *% esz).trunc.[i32]();
        var cur = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, cur, mach_ir.mem_stack_slot(aoff +% ld), esz, sgn, sp);
        if is_dot {
            let b = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, b, mach_ir.mem_stack_slot(boff +% ld), esz, sgn, sp);
            let p = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Mul, p, cur, b, sp);
            cur = p;
        }
        if li == 0_usize {
            acc = cur;
        } else if op.kind == .VecReduceMin {
            try emit_cmp_rr(alloc, mf, cur, acc, sp);
            let nxt = try mf.new_vreg(alloc, .Gpr);
            try emit_cmov(alloc, mf, if sgn { .L } else { .B }, nxt, acc, cur, sp);
            acc = nxt;
        } else if op.kind == .VecReduceMax {
            try emit_cmp_rr(alloc, mf, cur, acc, sp);
            let nxt = try mf.new_vreg(alloc, .Gpr);
            try emit_cmov(alloc, mf, if sgn { .G } else { .A }, nxt, acc, cur, sp);
            acc = nxt;
        } else {
            let nxt = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Add, nxt, acc, cur, sp);
            acc = nxt;
        }
        li = li +% 1_usize;
    }
    acc = try emit_norm_subword(alloc, mf, env, elem, acc, sp);
    try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, acc, sp);
    return;
}

fn emit_vec_shuffle(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    sp: span.Span,
) -> !OutOfMemory {
    let sn = env.get(op.ty0);
    let in_n = env.get(op.ty1);
    if sn.kind != .Vec || in_n.kind != .Vec { return; }
    let elem = sn.primary;
    let src_lanes = sn.u8_val.widen.[usize]();
    let out_lanes = in_n.u8_val.widen.[usize]();
    let idx_esz_r = env.x64_layout(in_n.primary).size;
    let idx_esz = if idx_esz_r == 0_usize { 1_usize } else { idx_esz_r };
    let esz_r = env.x64_layout(elem).size;
    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
    let two_src = op.flag;
    if args.len < 2_usize || (two_src && args.len < 3_usize) { return; }
    let total_lanes = if two_src { src_lanes *% 2_usize } else { src_lanes };
    if total_lanes == 0_usize { return; }

    let src_sz = env.x64_layout(op.ty0).size;
    let idx_sz = env.x64_layout(op.ty1).size;
    let dty = eir_prog.fn_val_ty(ctx.fn_id, dst);
    let dst_sz = env.x64_layout(dty).size;
    let aoff = mf.alloc_stack_slot(if src_sz < 8_usize { 8_usize } else { src_sz }, 16_usize);
    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(aoff), args[0_usize], op.ty0, sp);
    var boff = aoff;
    var ioff: i32 = 0_i32;
    if two_src && args.len >= 3_usize {
        boff = mf.alloc_stack_slot(if src_sz < 8_usize { 8_usize } else { src_sz }, 16_usize);
        try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(boff), args[1_usize], op.ty0, sp);
        ioff = mf.alloc_stack_slot(if idx_sz < 8_usize { 8_usize } else { idx_sz }, 16_usize);
        try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(ioff), args[2_usize], op.ty1, sp);
    } else {
        ioff = mf.alloc_stack_slot(if idx_sz < 8_usize { 8_usize } else { idx_sz }, 16_usize);
        try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(ioff), args[1_usize], op.ty1, sp);
    }
    let dloc = ctx_val_loc(ctx, dst);
    let doff = if dloc.kind == .Stack { dloc.stack_off } else { mf.alloc_stack_slot(if dst_sz < 8_usize { 8_usize } else { dst_sz }, 16_usize) };
    let max_idx = try emit_imm_vreg(alloc, mf, (total_lanes -% 1_usize).widen.[u64](), sp);
    let a_base = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(a_base, mach_ir.mem_stack_slot(aoff), sp));
    let b_base = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(b_base, mach_ir.mem_stack_slot(boff), sp));
    let sl_v = try emit_imm_vreg(alloc, mf, src_lanes.widen.[u64](), sp);

    var li: usize = 0_usize;
    while li < out_lanes {
        let raw_i = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, raw_i, mach_ir.mem_stack_slot(ioff +% (li *% idx_esz).trunc.[i32]()), idx_esz, false, sp);
        try emit_cmp_rr(alloc, mf, raw_i, max_idx, sp);
        var idx = try mf.new_vreg(alloc, .Gpr);
        try emit_cmov(alloc, mf, .A, idx, raw_i, max_idx, sp);
        var base = a_base;
        if two_src {
            let sub_i = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_rr(alloc, mf, .Sub, sub_i, idx, sl_v, sp);
            try emit_cmp_rr(alloc, mf, idx, sl_v, sp);
            let idx2 = try mf.new_vreg(alloc, .Gpr);
            try emit_cmov(alloc, mf, .Ae, idx2, idx, sub_i, sp);
            let base2 = try mf.new_vreg(alloc, .Gpr);
            try emit_cmov(alloc, mf, .Ae, base2, a_base, b_base, sp);
            idx = idx2;
            base = base2;
        }
        let val = try mf.new_vreg(alloc, .Gpr);
        if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
            try emit_load_mem(alloc, mf, val, mach_ir.mem_sib(base, idx, esz.trunc.[u8](), 0_i32), esz, false, sp);
        } else {
            let sc = try emit_scale_index(alloc, mf, idx, esz, sp);
            try emit_load_mem(alloc, mf, val, mach_ir.mem_sib(base, sc, 1_u8, 0_i32), esz, false, sp);
        }
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(doff +% (li *% esz).trunc.[i32]()), val, esz, sp);
        li = li +% 1_usize;
    }
    if dloc.kind != .Stack {
        try load_val_from_mem(alloc, ctx, mf, eir_prog, env, dst, mach_ir.mem_stack_slot(doff), dty, sp);
    }
    return;
}

fn emit_builtin_call_inst(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    inst_gid: u32,
    dst: eir.EirValue,
    bc_id: u32,
    sp: span.Span,
) -> !OutOfMemory {
    let bc = eir_prog.get_builtin_call(bc_id) orelse { return; };
    let op = bc.op;
    let args = eir_prog.vals_slice(bc.args);
    let arg_slots = eir_prog.arg_slots_slice(bc.arg_slots);
    let ret_ty = bc.ret_ty;

    match op.kind {
        .ArenaInit => { try emit_builtin_arena(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .ArenaAlloc => { try emit_builtin_arena(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .ArenaReset => { try emit_builtin_arena(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .ArenaDestroy => { try emit_builtin_arena(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .ArenaUsedBytes => { try emit_builtin_arena(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .ArenaCapacity => { try emit_builtin_arena(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .AllocCapLiveAllocs => { try emit_builtin_arena(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .AllocCapUsedBytes => { try emit_builtin_arena(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .AllocCapPeakBytes => { try emit_builtin_arena(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }

        .ArenaPoolInit => { try emit_builtin_arena_pool(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .ArenaPoolPush => { try emit_builtin_arena_pool(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .ArenaPoolIdAt => { try emit_builtin_arena_pool(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .ArenaPoolReset => { try emit_builtin_arena_pool(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .ArenaPoolLen => { try emit_builtin_arena_pool(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }

        .SlotPoolInit => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .SlotPoolInsert => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .SlotPoolTryInsert => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .SlotPoolRemove => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .SlotPoolGet => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .SlotPoolAt => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .SlotPoolLen => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .SlotPoolCap => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .SlotPoolIsAlive => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .SlotPoolIdAt => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }
        .SlotPoolDestroy => { try emit_builtin_slot_pool(alloc, ctx, mf, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, sp); }

        .BufInit => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufPush => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufPushSlice => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufPop => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufLen => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufCap => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufClear => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufAsSlice => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufAt => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufGet => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufSub => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BufDestroy => { try emit_builtin_buf(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }

        .AtomicNew => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }
        .AtomicLoad => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }
        .AtomicStore => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }
        .AtomicFetchAdd => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }
        .AtomicFetchSub => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }
        .AtomicSwap => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }
        .AtomicCas => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }
        .MmioRead => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }
        .MmioWrite => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }
        .RawPtrFromUsize => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }
        .RawPtrAsUsize => { try emit_builtin_atomic_mmio(alloc, ctx, mf, eir_prog, env, dst, op, args, arg_slots, sp); }

        .SliceLen => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .ArrayLen => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .StrLen => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .StrAsBytes => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .BytesAsStr => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .SliceAt => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .ArrayAt => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .SliceGet => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .ArrayGet => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .SliceSub => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }
        .ArraySub => { try emit_builtin_slice_array(alloc, ctx, mf, eir_prog, env, interner, inst_gid, dst, op, args, arg_slots, ret_ty, sp); }

        .MathSqrt => { try emit_builtin_math(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .MathFma => { try emit_builtin_math(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .MathLzcnt => { try emit_builtin_math(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .MathTzcnt => { try emit_builtin_math(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .MathPopcnt => { try emit_builtin_math(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .MathBswap => { try emit_builtin_math(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }

        .VecSplat => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecLen => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecCmp => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecMaskAny => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecMaskAll => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecBitmask => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecSelect => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecMin => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecMax => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecFma => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecReduceAdd => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecReduceMin => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecReduceMax => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecDot => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }
        .VecShuffle => { try emit_builtin_vec(alloc, ctx, mf, eir_prog, env, dst, op, args, sp); }

        .ClockNowNs => {
            try emit_helper_call(alloc, mf, interner, "eon_rt_now_ns", sp);
            if dst != eir.EIR_NONE {
                let rv = try mf.new_vreg_hint(alloc, .Gpr, mach_ir.PHYS_RAX);
                try mf.emit_inst(alloc, mach_ir.inst_def_fixed(rv, mach_ir.PHYS_RAX, sp));
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, rv, sp);
            }
        }
        .ArgsLen => {
            if args.len > 0_usize {
                let p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, args[0_usize], get_arg_slot(arg_slots, 0_usize), sp);
                let v = try mf.new_vreg(alloc, .Gpr);
                try emit_load_mem(alloc, mf, v, mach_ir.mem_base_disp(p, 0_i32), 8_usize, false, sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, dst, v, sp);
            }
        }
        .ScheduleBuild => {}
        _ => {}
    }
    return;
}

// ===========================================================================
// Section 9: Domain Super-Opt #3 — 8-Wide AVX2 SoA Loop Auto-Vectorizer
// ===========================================================================

enum Avx2OpKind : u8 {
    LoadCol = 0,     // col_slot -> dst_ymm
    StoreCol = 1,    // val_ymm -> col_slot (optional pred_mask_id >= 0)
    ConstF32 = 2,    // bits_u32 -> dst_ymm (hoisted broadcast)
    BinF32 = 3,      // Add / Sub / Mul / Div (IEEE-754 bit-exact!)
    NegF32 = 4,      // VXorPS with hoisted sign mask
    SqrtF32 = 5,     // VSqrtPS
    FmaF32 = 6,      // VFmadd231PS (only when source explicitly wrote @fma!)
    CmpF32 = 7,      // VCmpPS -> pred mask YMM (with optional parent_pred AND)
    InvertPred = 8,  // VXorPS(pred, all_ones) (& optional parent_pred)
    CopyYmm = 9,     // Copy scalar/vec alias
}

struct Avx2ColRef {
    pool_base: eir.EirPlaceBase;
    pool_is_ptr: bool;
    col_idx: u32;
    ncols: usize;
    is_written: bool;
}

struct Avx2GuardedPool {
    pool_base: eir.EirPlaceBase;
    pool_is_ptr: bool;
    ncols: usize;
}

struct Avx2TraceOp {
    kind: Avx2OpKind;
    bin_op: ast.BinaryOp;
    dst_eir: eir.EirValue; // EIR value produced (or EIR_NONE for StoreCol/Pred)
    src0_eir: eir.EirValue;
    src1_eir: eir.EirValue;
    src2_eir: eir.EirValue;
    col_slot: u32;
    bits_u32: u32;
    pred_id: i32;          // >= 0: active predicate index (for StoreCol or parent mask)
    out_pred_id: i32;      // >= 0: predicate index produced by CmpF32 / InvertPred
}

linear struct Avx2LoopPlan {
    ok: bool;
    hdr_bb: eir.BlockId;
    pre_bb: eir.BlockId;
    latch_bb: eir.BlockId;
    body_bb: eir.BlockId;
    exit_bb: eir.BlockId;
    ind_val: eir.EirValue;
    start_val: eir.EirValue;
    bound_val: eir.EirValue;
    ind_signed: bool;
    can_cache_writes: bool;
    cols: col.DynBuf[Avx2ColRef];
    guarded_pools: col.DynBuf[Avx2GuardedPool];
    ops: col.DynBuf[Avx2TraceOp];
    n_preds: usize;
}

impl Avx2LoopPlan {
    fn init_empty(alloc: *mut AllocCap) -> Avx2LoopPlan ! OutOfMemory {
        let cols = try col.DynBuf.[Avx2ColRef].init(alloc, 8_usize);
        errdefer cols.destroy(alloc);
        let gp = try col.DynBuf.[Avx2GuardedPool].init(alloc, 4_usize);
        errdefer gp.destroy(alloc);
        let ops = try col.DynBuf.[Avx2TraceOp].init(alloc, 32_usize);
        errdefer ops.destroy(alloc);
        return Avx2LoopPlan.{
            ok: false,
            hdr_bb: eir.EIR_NONE,
            pre_bb: eir.EIR_NONE,
            latch_bb: eir.EIR_NONE,
            body_bb: eir.EIR_NONE,
            exit_bb: eir.EIR_NONE,
            ind_val: eir.EIR_NONE,
            start_val: eir.EIR_NONE,
            bound_val: eir.EIR_NONE,
            ind_signed: false,
            can_cache_writes: false,
            cols: cols,
            guarded_pools: gp,
            ops: ops,
            n_preds: 0_usize,
        };
    }

    fn destroy(self: Avx2LoopPlan, alloc: *mut AllocCap) {
        let Avx2LoopPlan.{
            ok: _, hdr_bb: _, pre_bb: _, latch_bb: _, body_bb: _, exit_bb: _,
            ind_val: _, start_val: _, bound_val: _, ind_signed: _, can_cache_writes: _,
            cols, guarded_pools, ops, n_preds: _,
        } = self;
        cols.destroy(alloc);
        guarded_pools.destroy(alloc);
        ops.destroy(alloc);
    }
}

fn pool_base_eq(a: eir.EirPlaceBase, a_ptr: bool, b: eir.EirPlaceBase, b_ptr: bool) -> bool {
    return a.kind == b.kind && a.id == b.id && a_ptr == b_ptr;
}

fn intern_avx2_col(
    alloc: *mut AllocCap,
    plan: *mut Avx2LoopPlan,
    pool_base: eir.EirPlaceBase,
    pool_is_ptr: bool,
    col_idx: u32,
    ncols: usize,
    is_written: bool,
) -> u32 ! OutOfMemory {
    let cs = plan.cols.as_mut_slice();
    var i: usize = 0_usize;
    while i < cs.len {
        if pool_base_eq(cs[i].pool_base, cs[i].pool_is_ptr, pool_base, pool_is_ptr) && cs[i].col_idx == col_idx {
            if is_written {
                cs[i].is_written = true;
            }
            return i.trunc.[u32]();
        }
        i = i +% 1_usize;
    }
    let idx = plan.cols.len().trunc.[u32]();
    try plan.cols.push(alloc, Avx2ColRef.{
        pool_base: pool_base,
        pool_is_ptr: pool_is_ptr,
        col_idx: col_idx,
        ncols: ncols,
        is_written: is_written,
    });
    return idx;
}

fn add_avx2_guarded_pool(
    alloc: *mut AllocCap,
    plan: *mut Avx2LoopPlan,
    pool_base: eir.EirPlaceBase,
    pool_is_ptr: bool,
    ncols: usize,
) -> !OutOfMemory {
    let gs = plan.guarded_pools.as_slice();
    var i: usize = 0_usize;
    while i < gs.len {
        if pool_base_eq(gs[i].pool_base, gs[i].pool_is_ptr, pool_base, pool_is_ptr) {
            return;
        }
        i = i +% 1_usize;
    }
    try plan.guarded_pools.push(alloc, Avx2GuardedPool.{
        pool_base: pool_base,
        pool_is_ptr: pool_is_ptr,
        ncols: ncols,
    });
    return;
}

fn avx2_val_is_ind(
    eir_prog: *eir.EirProgram,
    ctx: *IselCtx,
    v: eir.EirValue,
    ind_val: eir.EirValue,
) -> bool {
    var cur = v;
    var depth: u32 = 0_u32;
    let all_insts = eir_prog.funcs.insts.as_slice();
    while depth < 6_u32 {
        if cur == ind_val {
            return true;
        }
        let gid = ctx_def_inst_gid(ctx, cur);
        if gid == eir.EIR_NONE || gid.widen.[usize]() >= all_insts.len {
            return false;
        }
        let di = all_insts[gid.widen.[usize]()];
        if di.kind == .Copy {
            cur = di.v0;
        } else if di.kind == .Cast && di.cast_kind == .Trunc {
            cur = di.v0;
        } else if di.kind == .UnwrapErrorOk {
            let egid = ctx_def_inst_gid(ctx, di.v0);
            if egid != eir.EIR_NONE && egid.widen.[usize]() < all_insts.len {
                let ei = all_insts[egid.widen.[usize]()];
                if ei.kind == .BuiltinCall {
                    if let bc = eir_prog.get_builtin_call(ei.aux0) {
                        if bc.op.kind == .ArenaPoolIdAt {
                            let args = eir_prog.vals_slice(bc.args);
                            if args.len >= 2_usize {
                                cur = args[1_usize];
                                depth = depth +% 1_u32;
                                continue;
                            }
                        }
                    }
                }
            }
            return false;
        } else {
            return false;
        }
        depth = depth +% 1_u32;
    }
    return false;
}

fn avx2_is_f32_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    let n = env.get(ty);
    return n.kind == .Float && n.u8_val == 32_u8;
}

struct Avx2PoolBase {
    base: eir.EirPlaceBase;
    is_ptr: bool;
}

fn avx2_resolve_pool_base(
    eir_prog: *eir.EirProgram,
    ctx: *IselCtx,
    base: eir.EirPlaceBase,
    is_ptr: bool,
) -> Avx2PoolBase {
    if base.kind == .Val {
        let gid = ctx_def_inst_gid(ctx, base.id);
        let all_i = eir_prog.funcs.insts.as_slice();
        if gid != eir.EIR_NONE && gid.widen.[usize]() < all_i.len {
            let di = all_i[gid.widen.[usize]()];
            if di.kind == .SlotAddr {
                return Avx2PoolBase.{ base: eir.place_base_slot(di.aux0), is_ptr: false };
            }
            if di.kind == .Cast && di.cast_kind == .MutToConst {
                let gid2 = ctx_def_inst_gid(ctx, di.v0);
                if gid2 != eir.EIR_NONE && gid2.widen.[usize]() < all_i.len {
                    let di2 = all_i[gid2.widen.[usize]()];
                    if di2.kind == .SlotAddr {
                        return Avx2PoolBase.{ base: eir.place_base_slot(di2.aux0), is_ptr: false };
                    }
                }
            }
        }
    }
    return Avx2PoolBase.{ base: base, is_ptr: is_ptr };
}

fn avx2_trace_block_insts(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ctx: *IselCtx,
    bb: eir.BlockId,
    pred_id: i32,
    plan: *mut Avx2LoopPlan,
    step_val: eir.EirValue,
) -> bool ! OutOfMemory {
    let blk = eir_prog.fn_block(ctx.fn_id, bb) orelse { return false; };
    if blk.phis.len > 0_u32 {
        return false;
    }
    let insts = eir_prog.insts_slice(blk.insts);
    var ii: usize = 0_usize;
    while ii < insts.len {
        let inst = insts[ii];
        match inst.kind {
            .SlotAddr => {
                // Pure stack slot address (used by ArenaPoolIdAt / PoolColumnLoad / PoolColumnStore)
            }
            .LoadSlot => {
                // Allow dead/by-value pool header LoadSlot used only as arg0 to ArenaPoolIdAt
                let sn = env.get(inst.ty0);
                if sn.kind != .Builtin {
                    return false;
                }
            }
            .Const => {
                if avx2_is_f32_ty(env, inst.ty0) && ctx_is_const_flt(ctx, inst.dst) {
                    try plan.ops.push(alloc, Avx2TraceOp.{
                        kind: .ConstF32,
                        bin_op: .Add,
                        dst_eir: inst.dst,
                        src0_eir: eir.EIR_NONE,
                        src1_eir: eir.EIR_NONE,
                        src2_eir: eir.EIR_NONE,
                        col_slot: 0_u32,
                        bits_u32: ctx_const_flt_bits(ctx, inst.dst).trunc.[u32](),
                        pred_id: pred_id,
                        out_pred_id: -1_i32,
                    });
                } else if ctx_is_const_int(ctx, inst.dst) {
                    // Allowed integer constant (e.g. step `1`)
                } else {
                    return false;
                }
                _ = 0_u8;
            }
            .Copy => {
                if avx2_is_f32_ty(env, inst.ty0) {
                    try plan.ops.push(alloc, Avx2TraceOp.{
                        kind: .CopyYmm,
                        bin_op: .Add,
                        dst_eir: inst.dst,
                        src0_eir: inst.v0,
                        src1_eir: eir.EIR_NONE,
                        src2_eir: eir.EIR_NONE,
                        col_slot: 0_u32,
                        bits_u32: 0_u32,
                        pred_id: pred_id,
                        out_pred_id: -1_i32,
                    });
                } else if !avx2_val_is_ind(eir_prog, ctx, inst.v0, plan.ind_val) {
                    return false;
                }
                _ = 0_u8;
            }
            .Cast => {
                if inst.cast_kind == .Trunc && avx2_val_is_ind(eir_prog, ctx, inst.v0, plan.ind_val) {
                    // Index narrowing allowed
                } else if inst.cast_kind == .MutToConst {
                    // Pointer mutability cast on pool address allowed
                } else {
                    return false;
                }
                _ = 0_u8;
            }
            .IsError => {
                // Only allowed on ArenaPoolIdAt checked at block terminator
            }
            .UnwrapErrorOk => {
                if !avx2_val_is_ind(eir_prog, ctx, inst.dst, plan.ind_val) {
                    return false;
                }
            }
            .PoolColumnLoad => {
                let op = eir_prog.get_pool_col_op(inst.aux0) orelse { return false; };
                if op.is_slot_pool || !avx2_is_f32_ty(env, op.elem_ty) {
                    return false;
                }
                if !avx2_val_is_ind(eir_prog, ctx, op.index, plan.ind_val) {
                    return false;
                }
                let pty = place_base_ty(eir_prog, ctx.fn_id, op.pool_base);
                let ncols = pool_ncols_from_arg_ty(env, pty);
                let res_pb = avx2_resolve_pool_base(eir_prog, ctx, op.pool_base, op.pool_is_ptr);
                let cslot = try intern_avx2_col(alloc, plan, res_pb.base, res_pb.is_ptr, op.col_idx, ncols, false);
                try plan.ops.push(alloc, Avx2TraceOp.{
                    kind: .LoadCol,
                    bin_op: .Add,
                    dst_eir: inst.dst,
                    src0_eir: eir.EIR_NONE,
                    src1_eir: eir.EIR_NONE,
                    src2_eir: eir.EIR_NONE,
                    col_slot: cslot,
                    bits_u32: 0_u32,
                    pred_id: pred_id,
                    out_pred_id: -1_i32,
                });
            }
            .PoolColumnStore => {
                let op = eir_prog.get_pool_col_op(inst.aux0) orelse { return false; };
                if op.is_slot_pool || !avx2_is_f32_ty(env, op.elem_ty) {
                    return false;
                }
                if !avx2_val_is_ind(eir_prog, ctx, op.index, plan.ind_val) {
                    return false;
                }
                let pty = place_base_ty(eir_prog, ctx.fn_id, op.pool_base);
                let ncols = pool_ncols_from_arg_ty(env, pty);
                let res_pb = avx2_resolve_pool_base(eir_prog, ctx, op.pool_base, op.pool_is_ptr);
                let cslot = try intern_avx2_col(alloc, plan, res_pb.base, res_pb.is_ptr, op.col_idx, ncols, true);
                try plan.ops.push(alloc, Avx2TraceOp.{
                    kind: .StoreCol,
                    bin_op: .Add,
                    dst_eir: eir.EIR_NONE,
                    src0_eir: inst.v0,
                    src1_eir: eir.EIR_NONE,
                    src2_eir: eir.EIR_NONE,
                    col_slot: cslot,
                    bits_u32: 0_u32,
                    pred_id: pred_id,
                    out_pred_id: -1_i32,
                });
            }
            .Unary => {
                if inst.unary_op == .Neg && avx2_is_f32_ty(env, inst.ty0) {
                    try plan.ops.push(alloc, Avx2TraceOp.{
                        kind: .NegF32,
                        bin_op: .Add,
                        dst_eir: inst.dst,
                        src0_eir: inst.v0,
                        src1_eir: eir.EIR_NONE,
                        src2_eir: eir.EIR_NONE,
                        col_slot: 0_u32,
                        bits_u32: 0_u32,
                        pred_id: pred_id,
                        out_pred_id: -1_i32,
                    });
                } else {
                    return false;
                }
                _ = 0_u8;
            }
            .Binary => {
                if inst.dst == step_val {
                    // Induction variable increment `i + 1` handled by vector loop `v_i += 8`
                } else if avx2_is_f32_ty(env, inst.ty1) {
                    let bo = inst.bin_op;
                    if bo == .Add || bo == .Sub || bo == .Mul || bo == .Div {
                        try plan.ops.push(alloc, Avx2TraceOp.{
                            kind: .BinF32,
                            bin_op: bo,
                            dst_eir: inst.dst,
                            src0_eir: inst.v0,
                            src1_eir: inst.v1,
                            src2_eir: eir.EIR_NONE,
                            col_slot: 0_u32,
                            bits_u32: 0_u32,
                            pred_id: pred_id,
                            out_pred_id: -1_i32,
                        });
                    } else if bo == .Lt || bo == .LtEq || bo == .Gt || bo == .GtEq || bo == .Eq || bo == .NotEq {
                        // Float comparison consumed by a diamond Branch terminator (handled by terminator tracer)
                    } else {
                        return false;
                    }
                    _ = 0_u8;
                } else {
                    return false;
                }
                _ = 0_u8;
            }
            .BuiltinCall => {
                let bc = eir_prog.get_builtin_call(inst.aux0) orelse { return false; };
                let bargs = eir_prog.vals_slice(bc.args);
                let bslots = eir_prog.arg_slots_slice(bc.arg_slots);
                if bc.op.kind == .ArenaPoolIdAt && bargs.len >= 2_usize && avx2_val_is_ind(eir_prog, ctx, bargs[1_usize], plan.ind_val) {
                    let s0 = get_arg_slot(bslots, 0_usize);
                    let pty = eir_prog.fn_val_ty(ctx.fn_id, bargs[0_usize]);
                    let ncols = pool_ncols_from_arg_ty(env, pty);
                    let pbase = if s0 != eir.EIR_NONE { eir.place_base_slot(s0) } else { eir.place_base_val(bargs[0_usize]) };
                    let pis_ptr = if s0 != eir.EIR_NONE {
                        if let si = eir_prog.fn_slot(ctx.fn_id, s0) {
                            env.get(si.ty).kind == .Borrow || env.get(si.ty).kind == .RawPtr
                        } else {
                            false
                        }
                    } else {
                        env.get(pty).kind == .Borrow || env.get(pty).kind == .RawPtr
                    };
                    let res_gp = avx2_resolve_pool_base(eir_prog, ctx, pbase, pis_ptr);
                    try add_avx2_guarded_pool(alloc, plan, res_gp.base, res_gp.is_ptr, ncols);
                } else if bc.op.kind == .MathSqrt && bargs.len == 1_usize && avx2_is_f32_ty(env, eir_prog.fn_val_ty(ctx.fn_id, bargs[0_usize])) {
                    try plan.ops.push(alloc, Avx2TraceOp.{
                        kind: .SqrtF32,
                        bin_op: .Add,
                        dst_eir: inst.dst,
                        src0_eir: bargs[0_usize],
                        src1_eir: eir.EIR_NONE,
                        src2_eir: eir.EIR_NONE,
                        col_slot: 0_u32,
                        bits_u32: 0_u32,
                        pred_id: pred_id,
                        out_pred_id: -1_i32,
                    });
                } else if bc.op.kind == .MathFma && bargs.len >= 3_usize && avx2_is_f32_ty(env, eir_prog.fn_val_ty(ctx.fn_id, bargs[0_usize])) {
                    try plan.ops.push(alloc, Avx2TraceOp.{
                        kind: .FmaF32,
                        bin_op: .Add,
                        dst_eir: inst.dst,
                        src0_eir: bargs[0_usize],
                        src1_eir: bargs[1_usize],
                        src2_eir: bargs[2_usize],
                        col_slot: 0_u32,
                        bits_u32: 0_u32,
                        pred_id: pred_id,
                        out_pred_id: -1_i32,
                    });
                } else {
                    return false;
                }
                _ = 0_u8;
            }
            _ => {
                return false;
            }
        }
        ii = ii +% 1_usize;
    }
    return true;
}

/// Checks if `br_bb` ends in a simple `f32` compare diamond (or 2-level `if ... else if ...` chain!)
/// that merges at `join_bb` (with 0 phis). If so, emits predicated ops into `plan` and returns `join_bb`.
@recursive
fn avx2_try_trace_f32_diamond(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ctx: *IselCtx,
    cond_v: eir.EirValue,
    then_bb: eir.BlockId,
    else_bb: eir.BlockId,
    parent_pred: i32,
    depth_rem: u32,
    plan: *mut Avx2LoopPlan,
    step_val: eir.EirValue,
) -> eir.BlockId ! OutOfMemory {
    if depth_rem == 0_u32 {
        return eir.EIR_NONE;
    }
    let gid = ctx_def_inst_gid(ctx, cond_v);
    let all_insts = eir_prog.funcs.insts.as_slice();
    if gid == eir.EIR_NONE || gid.widen.[usize]() >= all_insts.len {
        return eir.EIR_NONE;
    }
    let ci = all_insts[gid.widen.[usize]()];
    if ci.kind != .Binary || !avx2_is_f32_ty(env, ci.ty1) {
        return eir.EIR_NONE;
    }
    let bo = ci.bin_op;
    if bo != .Lt && bo != .LtEq && bo != .Gt && bo != .GtEq && bo != .Eq && bo != .NotEq {
        return eir.EIR_NONE;
    }

    // `then_bb` must be a single straight-line block ending in Goto(join_bb)
    let tblk = eir_prog.fn_block(ctx.fn_id, then_bb) orelse { return eir.EIR_NONE; };
    if tblk.term.kind != .Goto {
        return eir.EIR_NONE;
    }
    var join_bb = tblk.term.bb0;
    // Strip empty forwarding Gotos on `join_bb` so `if ... else if ...` chains merge cleanly!
    var jhops: usize = 0_usize;
    while jhops < 6_usize {
        let jchk = eir_prog.fn_block(ctx.fn_id, join_bb) orelse { break; };
        if jchk.phis.len == 0_u32 && jchk.insts.len == 0_u32 && jchk.term.kind == .Goto && jchk.term.bb0 != join_bb {
            join_bb = jchk.term.bb0;
            jhops = jhops +% 1_usize;
        } else {
            break;
        }
    }
    let jblk = eir_prog.fn_block(ctx.fn_id, join_bb) orelse { return eir.EIR_NONE; };
    if jblk.phis.len > 0_u32 {
        return eir.EIR_NONE;
    }

    // Allocate predicate for `then` arm: `then_pred = VCmpPS(ci.v0, ci.v1, bo) & parent_pred`
    let then_pred = plan.n_preds.trunc.[i32]();
    plan.n_preds = plan.n_preds +% 1_usize;
    try plan.ops.push(alloc, Avx2TraceOp.{
        kind: .CmpF32,
        bin_op: bo,
        dst_eir: eir.EIR_NONE,
        src0_eir: ci.v0,
        src1_eir: ci.v1,
        src2_eir: eir.EIR_NONE,
        col_slot: 0_u32,
        bits_u32: 0_u32,
        pred_id: parent_pred,
        out_pred_id: then_pred,
    });

    if !(try avx2_trace_block_insts(alloc, eir_prog, env, ctx, then_bb, then_pred, plan, step_val)) {
        return eir.EIR_NONE;
    }

    if avx2_is_empty_goto_to(eir_prog, ctx.fn_id, else_bb, join_bb) {
        return join_bb;
    }

    // Compute `else_pred = (~then_pred) & parent_pred`
    let else_pred = plan.n_preds.trunc.[i32]();
    plan.n_preds = plan.n_preds +% 1_usize;
    try plan.ops.push(alloc, Avx2TraceOp.{
        kind: .InvertPred,
        bin_op: .Add,
        dst_eir: eir.EIR_NONE,
        src0_eir: eir.EIR_NONE,
        src1_eir: eir.EIR_NONE,
        src2_eir: eir.EIR_NONE,
        col_slot: 0_u32,
        bits_u32: then_pred.bitcast.[u32](),
        pred_id: parent_pred,
        out_pred_id: else_pred,
    });

    let eblk = eir_prog.fn_block(ctx.fn_id, else_bb) orelse { return eir.EIR_NONE; };
    if eblk.term.kind == .Goto && avx2_is_empty_goto_to(eir_prog, ctx.fn_id, eblk.term.bb0, join_bb) {
        if !(try avx2_trace_block_insts(alloc, eir_prog, env, ctx, else_bb, else_pred, plan, step_val)) {
            return eir.EIR_NONE;
        }
        return join_bb;
    }
    // Nested `else if` diamond (like `if px < min_xz { ... } else if px > max_xz { ... }` in sys_collide_bounds!)
    if eblk.term.kind == .Branch {
        if !(try avx2_trace_block_insts(alloc, eir_prog, env, ctx, else_bb, else_pred, plan, step_val)) {
            return eir.EIR_NONE;
        }
        let nested_join = try avx2_try_trace_f32_diamond(
            alloc, eir_prog, env, ctx,
            eblk.term.val, eblk.term.bb0, eblk.term.bb1,
            else_pred, depth_rem -% 1_u32, plan, step_val,
        );
        if nested_join != eir.EIR_NONE && avx2_is_empty_goto_to(eir_prog, ctx.fn_id, nested_join, join_bb) {
            return join_bb;
        }
    }
    return eir.EIR_NONE;
}

fn avx2_is_empty_goto_to(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    start_bb: eir.BlockId,
    target_bb: eir.BlockId,
) -> bool {
    var cur = start_bb;
    var hops: usize = 0_usize;
    while hops < 8_usize {
        if cur == target_bb {
            return true;
        }
        let blk = eir_prog.fn_block(fn_id, cur) orelse { return false; };
        if blk.phis.len != 0_u32 || blk.insts.len != 0_u32 || blk.term.kind != .Goto {
            return false;
        }
        cur = blk.term.bb0;
        hops = hops +% 1_usize;
    }
    return false;
}

fn try_analyze_avx2_soa_loop(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ctx: *IselCtx,
    hdr_bb: eir.BlockId,
) -> Avx2LoopPlan ! OutOfMemory {
    var plan = try Avx2LoopPlan.init_empty(alloc);
    errdefer plan.destroy(alloc);

    let blks = eir_prog.fn_blocks(ctx.fn_id);
    let nblks = blks.len;
    let hblk = eir_prog.fn_block(ctx.fn_id, hdr_bb) orelse { return plan; };
    let hphis = eir_prog.phis_slice(hblk.phis);
    let hpreds = eir_prog.preds_slice(hblk.preds);
    if hphis.len != 1_usize || hpreds.len != 2_usize {
        return plan;
    }

    var pre_bb = eir.EIR_NONE;
    var latch_bb = eir.EIR_NONE;
    if eir_prog.dominates_block(ctx.fn_id, hdr_bb, hpreds[0_usize]) && !eir_prog.dominates_block(ctx.fn_id, hdr_bb, hpreds[1_usize]) {
        latch_bb = hpreds[0_usize];
        pre_bb = hpreds[1_usize];
    } else if eir_prog.dominates_block(ctx.fn_id, hdr_bb, hpreds[1_usize]) && !eir_prog.dominates_block(ctx.fn_id, hdr_bb, hpreds[0_usize]) {
        latch_bb = hpreds[1_usize];
        pre_bb = hpreds[0_usize];
    } else {
        return plan;
    }

    let ind_phi = hphis[0_usize];
    let ind_val = ind_phi.dst;
    if env.x64_layout(ind_phi.ty).size != 8_usize || env.get(ind_phi.ty).kind != .Int {
        return plan;
    }
    let incs = eir_prog.phi_incoming(ind_phi.incoming);
    if incs.len != 2_usize {
        return plan;
    }
    var start_val = eir.EIR_NONE;
    var step_val = eir.EIR_NONE;
    if incs[0_usize].pred_bb == pre_bb {
        start_val = incs[0_usize].val;
        step_val = incs[1_usize].val;
    } else if incs[1_usize].pred_bb == pre_bb {
        start_val = incs[1_usize].val;
        step_val = incs[0_usize].val;
    } else {
        return plan;
    }

    // Header terminator must be `Branch(Lt(ind_val, bound_val), body_bb, exit_bb)`
    if hblk.term.kind != .Branch {
        return plan;
    }
    let cond_gid = ctx_def_inst_gid(ctx, hblk.term.val);
    let all_insts = eir_prog.funcs.insts.as_slice();
    if cond_gid == eir.EIR_NONE || cond_gid.widen.[usize]() >= all_insts.len {
        return plan;
    }
    let cond_i = all_insts[cond_gid.widen.[usize]()];
    if cond_i.kind != .Binary || cond_i.bin_op != .Lt || cond_i.v0 != ind_val {
        return plan;
    }
    let bound_val = cond_i.v1;
    let body_bb = hblk.term.bb0;
    let exit_bb = hblk.term.bb1;
    if body_bb == hdr_bb || body_bb == exit_bb {
        return plan;
    }

    // Check `step_val == ind_val + 1`
    let step_gid = ctx_def_inst_gid(ctx, step_val);
    if step_gid == eir.EIR_NONE || step_gid.widen.[usize]() >= all_insts.len {
        return plan;
    }
    let step_i = all_insts[step_gid.widen.[usize]()];
    if step_i.kind != .Binary || (step_i.bin_op != .Add && step_i.bin_op != .AddWrap) {
        return plan;
    }
    let step_ok = (step_i.v0 == ind_val && ctx_is_const_int(ctx, step_i.v1) && ctx_const_int(ctx, step_i.v1) == 1_u64)
        || (step_i.v1 == ind_val && ctx_is_const_int(ctx, step_i.v0) && ctx_const_int(ctx, step_i.v0) == 1_u64);
    if !step_ok {
        return plan;
    }

    // Header must have no side-effecting instructions
    let hinsts = eir_prog.insts_slice(hblk.insts);
    var hi: usize = 0_usize;
    while hi < hinsts.len {
        let hk = hinsts[hi].kind;
        if hk != .Binary && hk != .Const && hk != .Copy {
            return plan;
        }
        hi = hi +% 1_usize;
    }

    // Ensure `pre_bb` is a simple edge not already claimed by another AVX2 loop
    let ex_loops = ctx.avx2_loops.as_slice();
    var li: usize = 0_usize;
    while li < ex_loops.len {
        if ex_loops[li].pre_bb == pre_bb || ex_loops[li].hdr_bb == hdr_bb {
            return plan;
        }
        li = li +% 1_usize;
    }

    plan.hdr_bb = hdr_bb;
    plan.pre_bb = pre_bb;
    plan.latch_bb = latch_bb;
    plan.body_bb = body_bb;
    plan.exit_bb = exit_bb;
    plan.ind_val = ind_val;
    plan.start_val = start_val;
    plan.bound_val = bound_val;
    plan.ind_signed = env.is_signed_int(ind_phi.ty);

    // Ensure `start_val` and `bound_val` are defined outside the loop
    if bound_val != eir.EIR_NONE {
        let bdef = ctx_def_bb(ctx, bound_val);
        if bdef != eir.EIR_NONE && eir_prog.dominates_block(ctx.fn_id, hdr_bb, bdef) {
            return plan;
        }
    }

    // Trace loop body from `body_bb` until reaching `hdr_bb` via `latch_bb`
    var cur_bb = body_bb;
    var steps: usize = 0_usize;
    var reached_hdr = false;
    while steps < 64_usize && steps < nblks {
        if !(try avx2_trace_block_insts(alloc, eir_prog, env, ctx, cur_bb, -1_i32, &mut plan, step_val)) {
            return plan;
        }
        let cblk = eir_prog.fn_block(ctx.fn_id, cur_bb) orelse { return plan; };
        if cblk.term.kind == .Goto {
            let nxt = cblk.term.bb0;
            if nxt == hdr_bb {
                if cur_bb != latch_bb {
                    return plan;
                }
                reached_hdr = true;
                break;
            }
            cur_bb = nxt;
            steps = steps +% 1_usize;
            continue;
        }
        if cblk.term.kind == .Branch {
            // Case 1: `ArenaPoolIdAt` error guard: `Branch(IsError(eu), err_bb, ok_bb)`
            let cg = ctx_def_inst_gid(ctx, cblk.term.val);
            if cg != eir.EIR_NONE && cg.widen.[usize]() < all_insts.len {
                let ci = all_insts[cg.widen.[usize]()];
                if ci.kind == .IsError
                    && (avx2_is_empty_goto_to(eir_prog, ctx.fn_id, cblk.term.bb0, latch_bb)
                        || avx2_is_empty_goto_to(eir_prog, ctx.fn_id, cblk.term.bb0, exit_bb))
                {
                    cur_bb = cblk.term.bb1;
                    steps = steps +% 1_usize;
                    continue;
                }
            }
            // Case 2: Predicated `f32` diamond / if-else-if chain (`sys_collide_bounds`)
            let jbb = try avx2_try_trace_f32_diamond(
                alloc, eir_prog, env, ctx,
                cblk.term.val, cblk.term.bb0, cblk.term.bb1,
                -1_i32, 3_u32, &mut plan, step_val,
            );
            if jbb != eir.EIR_NONE {
                if jbb == hdr_bb {
                    reached_hdr = true;
                    break;
                }
                cur_bb = jbb;
                steps = steps +% 1_usize;
                continue;
            }
            return plan;
        }
        return plan;
    }
    if !reached_hdr {
        return plan;
    }

    // Must have at least 1 PoolColumnStore
    var has_store = false;
    let ops_ro = plan.ops.as_slice();
    var oi: usize = 0_usize;
    while oi < ops_ro.len {
        if ops_ro[oi].kind == .StoreCol {
            has_store = true;
            break;
        }
        oi = oi +% 1_usize;
    }
    if !has_store {
        return plan;
    }

    // Check soundness of column writeback caching:
    // Sound iff every column written does not share a `col_idx` with a DIFFERENT `pool_base`.
    var can_cache = true;
    let cs = plan.cols.as_slice();
    var ci_a: usize = 0_usize;
    while ci_a < cs.len && can_cache {
        if cs[ci_a].is_written {
            var ci_b: usize = 0_usize;
            while ci_b < cs.len {
                if ci_b != ci_a && cs[ci_b].col_idx == cs[ci_a].col_idx
                    && !pool_base_eq(cs[ci_a].pool_base, cs[ci_a].pool_is_ptr, cs[ci_b].pool_base, cs[ci_b].pool_is_ptr)
                {
                    can_cache = false;
                    break;
                }
                ci_b = ci_b +% 1_usize;
            }
        }
        ci_a = ci_a +% 1_usize;
    }
    // If predicated stores are present, we require `can_cache` so read-modify-write blends are sound!
    if plan.n_preds > 0_usize && !can_cache {
        return plan;
    }
    // Verify all pool bases & external f32 inputs are defined outside the loop
    ci_a = 0_usize;
    while ci_a < cs.len {
        if cs[ci_a].pool_base.kind == .Val {
            let pdef = ctx_def_bb(ctx, cs[ci_a].pool_base.id);
            if pdef != eir.EIR_NONE && eir_prog.dominates_block(ctx.fn_id, hdr_bb, pdef) {
                return plan;
            }
        }
        ci_a = ci_a +% 1_usize;
    }
    let gs = plan.guarded_pools.as_slice();
    var gi: usize = 0_usize;
    while gi < gs.len {
        if gs[gi].pool_base.kind == .Val {
            let pdef = ctx_def_bb(ctx, gs[gi].pool_base.id);
            if pdef != eir.EIR_NONE && eir_prog.dominates_block(ctx.fn_id, hdr_bb, pdef) {
                return plan;
            }
        }
        gi = gi +% 1_usize;
    }

    // Verify no value defined inside the loop is used outside the loop (only step_val feeds ind_phi)
    var val_def_in_body = try col.BitSet.init(alloc, eir_prog.fn_value_tys(ctx.fn_id).len);
    errdefer val_def_in_body.destroy(alloc);
    oi = 0_usize;
    while oi < ops_ro.len {
        if ops_ro[oi].dst_eir != eir.EIR_NONE {
            val_def_in_body.set(ops_ro[oi].dst_eir.widen.[usize]());
        }
        oi = oi +% 1_usize;
    }
    // Check all blocks outside the loop don't reference any value in `val_def_in_body`
    var bi: usize = 0_usize;
    while bi < blks.len {
        let bbid = bi.trunc.[u32]();
        if !eir_prog.dominates_block(ctx.fn_id, hdr_bb, bbid) {
            let b = blks[bi];
            let bphis = eir_prog.phis_slice(b.phis);
            var pi: usize = 0_usize;
            while pi < bphis.len {
                let incs2 = eir_prog.phi_incoming(bphis[pi].incoming);
                var ii2: usize = 0_usize;
                while ii2 < incs2.len {
                    if val_def_in_body.test(incs2[ii2].val.widen.[usize]()) {
                        val_def_in_body.destroy(alloc);
                        return plan;
                    }
                    ii2 = ii2 +% 1_usize;
                }
                pi = pi +% 1_usize;
            }
        }
        bi = bi +% 1_usize;
    }
    val_def_in_body.destroy(alloc);

    plan.can_cache_writes = can_cache;
    plan.ok = true;
    return plan;
}

fn avx2_vcmp_imm(op: ast.BinaryOp) -> u8 {
    match op {
        .Eq => { return 0_u8; }     // EQ_OQ
        .Lt => { return 1_u8; }     // LT_OS
        .LtEq => { return 2_u8; }   // LE_OS
        .NotEq => { return 4_u8; }  // NEQ_UQ
        .GtEq => { return 13_u8; }  // GE_OS
        .Gt => { return 14_u8; }    // GT_OS
        _ => { return 0_u8; }
    }
}

fn avx2_resolve_ymm(
    alloc: *mut AllocCap,
    mf: *mut mach_ir.MachFunc,
    eir_to_ymm: *[mach_ir.VReg],
    inv_ymm_map: *mut col.DynBuf[mach_ir.VReg],
    v: eir.EirValue,
    sp: span.Span,
) -> mach_ir.VReg ! OutOfMemory {
    let idx = v.widen.[usize]();
    if idx < eir_to_ymm.len && eir_to_ymm[idx] != mach_ir.VREG_NONE {
        return eir_to_ymm[idx];
    }
    let inv = inv_ymm_map.as_slice();
    if idx < inv.len && inv[idx] != mach_ir.VREG_NONE {
        return inv[idx];
    }
    // Safety fallback (unreachable when preheader hoists all external inputs)
    let z = try emit_imm_vreg(alloc, mf, 0_u64, sp);
    let sx = try mf.new_vreg(alloc, .Vec128);
    var md = mach_ir.inst_empty(.VMovDToXmm, sp);
    md.dst = sx; md.src0 = z; md.size_bytes = 4_u8;
    try mf.emit_inst(alloc, md);
    let y = try mf.new_vreg(alloc, .Vec256);
    var bc = mach_ir.inst_empty(.VBroadcastSS, sp);
    bc.dst = y; bc.src0 = sx; bc.flag0 = true; bc.size_bytes = 32_u8;
    try mf.emit_inst(alloc, bc);
    return y;
}

/// Emits the complete 8-wide AVX2 YMM pre-loop (`v_pre -> v_hdr -> v_body -> v_exit -> scalar_hdr`)
/// and returns `v_pre` block ID!
fn emit_avx2_soa_preloop(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    plan: *Avx2LoopPlan,
    sp: span.Span,
) -> u32 ! OutOfMemory {
    let hdr_depth = eir_prog.block_depth(ctx.fn_id, plan.hdr_bb);
    let body_depth = if hdr_depth > 0_u8 { hdr_depth } else { 1_u8 };
    let pre_depth = body_depth -% 1_u8;
    let v_pre = try mf.add_block(alloc, pre_depth);
    let v_hdr = try mf.add_block(alloc, body_depth);
    let v_body = try mf.add_block(alloc, body_depth);
    let v_exit = try mf.add_block(alloc, pre_depth);

    let nvals = eir_prog.fn_value_tys(ctx.fn_id).len;
    let ncols = plan.cols.len();
    var col_ptrs = try col.DynBuf.[mach_ir.VReg].init(alloc, if ncols > 4_usize { ncols } else { 4_usize });
    errdefer col_ptrs.destroy(alloc);
    var eir_to_ymm = try col.DynBuf.[mach_ir.VReg].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer eir_to_ymm.destroy(alloc);
    var inv_ymm = try col.DynBuf.[mach_ir.VReg].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer inv_ymm.destroy(alloc);
    var vi: usize = 0_usize;
    while vi < nvals {
        try eir_to_ymm.push(alloc, mach_ir.VREG_NONE);
        try inv_ymm.push(alloc, mach_ir.VREG_NONE);
        vi = vi +% 1_usize;
    }

    // Identify which values are produced inside the trace
    var defined_in_trace = try col.BitSet.init(alloc, nvals);
    errdefer defined_in_trace.destroy(alloc);
    let ops = plan.ops.as_slice();
    var oi: usize = 0_usize;
    while oi < ops.len {
        if ops[oi].dst_eir != eir.EIR_NONE {
            defined_in_trace.set(ops[oi].dst_eir.widen.[usize]());
        }
        oi = oi +% 1_usize;
    }

    // ---- 1. Emit `v_pre`: compute clamped bound, hoist column pointers & f32 broadcasts ----
    mf.begin_block_insts(v_pre);
    ctx.cur_mbb = v_pre;
    let v_start = try load_val_gpr(alloc, ctx, mf, eir_prog, env, plan.start_val, true, sp);
    var v_bound = try load_val_gpr(alloc, ctx, mf, eir_prog, env, plan.bound_val, true, sp);

    // Initialize `v_i_phi <- v_start` unconditionally BEFORE any branch to `v_exit`!
    let v_i_phi = try mf.new_vreg(alloc, .Gpr);
    let p_init = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_i_phi, v_start);
    try mf.emit_parallel_copy(alloc, p_init, 1_u32, sp);

    // Clamp `v_bound` against every `guarded_pool.len` so all `id_at(i)` checks are 100% eliminated!
    let gps = plan.guarded_pools.as_slice();
    var gi: usize = 0_usize;
    while gi < gps.len {
        let gp_v = try load_pool_base_vreg(alloc, ctx, mf, eir_prog, env, gps[gi].pool_base, gps[gi].pool_is_ptr, sp);
        let plen = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, plen, mach_ir.mem_base_disp(gp_v, (gps[gi].ncols *% 8_usize).trunc.[i32]()), 8_usize, false, sp);
        try emit_cmp_rr(alloc, mf, plen, v_bound, sp);
        let nxt_b = try mf.new_vreg(alloc, .Gpr);
        try emit_cmov(alloc, mf, if plan.ind_signed { .L } else { .B }, nxt_b, v_bound, plen, sp);
        v_bound = nxt_b;
        gi = gi +% 1_usize;
    }

    // Check `v_start < v_bound` and `v_bound - v_start >= 8`
    let b_chk_len = try mf.add_block(alloc, pre_depth);
    let b_hoist = try mf.add_block(alloc, pre_depth);

    try emit_cmp_rr(alloc, mf, v_start, v_bound, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(if plan.ind_signed { .Ge } else { .Ae }, v_exit, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_len, sp));
    mf.end_block_insts(v_pre);

    mf.begin_block_insts(b_chk_len);
    let v_rem = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Sub, v_rem, v_bound, v_start, sp);
    try emit_cmp_ri(alloc, mf, v_rem, 8_i32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, v_exit, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_hoist, sp));
    mf.end_block_insts(b_chk_len);

    mf.begin_block_insts(b_hoist);
    ctx.cur_mbb = b_hoist;
    let v_limit = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .SubImm, v_limit, v_bound, 8_i64, sp);

    // Hoist all column base pointers
    let cs = plan.cols.as_slice();
    var ci: usize = 0_usize;
    while ci < cs.len {
        let pbase_v = try load_pool_base_vreg(alloc, ctx, mf, eir_prog, env, cs[ci].pool_base, cs[ci].pool_is_ptr, sp);
        let cp = try mf.new_vreg(alloc, .Gpr);
        try emit_load_mem(alloc, mf, cp, mach_ir.mem_base_disp(pbase_v, cs[ci].col_idx.trunc.[i32]() *% 8_i32), 8_usize, false, sp);
        try col_ptrs.push(alloc, cp);
        ci = ci +% 1_usize;
    }

    // Hoist all ConstF32 ops & external loop-invariant f32 operands via VBroadcastSS (l256 = true)!
    var need_sign_mask = false;
    var need_all_ones = false;
    oi = 0_usize;
    while oi < ops.len {
        let op = ops[oi];
        if op.kind == .NegF32 { need_sign_mask = true; }
        if op.kind == .InvertPred { need_all_ones = true; }
        if op.kind == .ConstF32 && op.dst_eir != eir.EIR_NONE {
            let gv = try emit_imm_vreg(alloc, mf, op.bits_u32.widen.[u64](), sp);
            let sx = try mf.new_vreg(alloc, .Vec128);
            var md = mach_ir.inst_empty(.VMovDToXmm, sp);
            md.dst = sx; md.src0 = gv; md.size_bytes = 4_u8;
            try mf.emit_inst(alloc, md);
            let y = try mf.new_vreg(alloc, .Vec256);
            var bc = mach_ir.inst_empty(.VBroadcastSS, sp);
            bc.dst = y; bc.src0 = sx; bc.flag0 = true; bc.size_bytes = 32_u8;
            try mf.emit_inst(alloc, bc);
            let didx = op.dst_eir.widen.[usize]();
            let em = eir_to_ymm.as_mut_slice();
            if didx < em.len { em[didx] = y; }
        }
        // Check src0/src1/src2 for loop-invariant external f32 values
        let srcs: [3]eir.EirValue = [op.src0_eir, op.src1_eir, op.src2_eir];
        var si: usize = 0_usize;
        while si < 3_usize {
            let sv = srcs[si];
            if sv != eir.EIR_NONE {
                let sidx = sv.widen.[usize]();
                if !defined_in_trace.test(sidx) {
                    let im = inv_ymm.as_mut_slice();
                    if sidx < im.len && im[sidx] == mach_ir.VREG_NONE {
                        let fv = try load_val_float(alloc, ctx, mf, eir_prog, env, sv, sp);
                        let y = try mf.new_vreg(alloc, .Vec256);
                        var bc = mach_ir.inst_empty(.VBroadcastSS, sp);
                        bc.dst = y; bc.src0 = fv; bc.flag0 = true; bc.size_bytes = 32_u8;
                        try mf.emit_inst(alloc, bc);
                        im[sidx] = y;
                    }
                }
            }
            si = si +% 1_usize;
        }
        oi = oi +% 1_usize;
    }

    var sign_mask_ymm = mach_ir.VREG_NONE;
    if need_sign_mask {
        let sg = try emit_imm_vreg(alloc, mf, 0x80000000_u64, sp);
        let sx = try mf.new_vreg(alloc, .Vec128);
        var md = mach_ir.inst_empty(.VMovDToXmm, sp); md.dst = sx; md.src0 = sg; md.size_bytes = 4_u8;
        try mf.emit_inst(alloc, md);
        sign_mask_ymm = try mf.new_vreg(alloc, .Vec256);
        var bc = mach_ir.inst_empty(.VBroadcastSS, sp); bc.dst = sign_mask_ymm; bc.src0 = sx; bc.flag0 = true; bc.size_bytes = 32_u8;
        try mf.emit_inst(alloc, bc);
    }
    var all_ones_ymm = mach_ir.VREG_NONE;
    if need_all_ones {
        let og = try emit_imm_vreg(alloc, mf, 0xFFFFFFFF_u64, sp);
        let ox = try mf.new_vreg(alloc, .Vec128);
        var md = mach_ir.inst_empty(.VMovDToXmm, sp); md.dst = ox; md.src0 = og; md.size_bytes = 4_u8;
        try mf.emit_inst(alloc, md);
        all_ones_ymm = try mf.new_vreg(alloc, .Vec256);
        var bc = mach_ir.inst_empty(.VBroadcastSS, sp); bc.dst = all_ones_ymm; bc.src0 = ox; bc.flag0 = true; bc.size_bytes = 32_u8;
        try mf.emit_inst(alloc, bc);
    }
    try mf.emit_inst(alloc, mach_ir.inst_jmp(v_hdr, sp));
    mf.end_block_insts(b_hoist);

    // ---- 2. Emit `v_hdr`: `cmp v_i, v_limit; ja v_exit; jmp v_body` ----
    mf.begin_block_insts(v_hdr);
    try emit_cmp_rr(alloc, mf, v_i_phi, v_limit, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(if plan.ind_signed { .G } else { .A }, v_exit, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(v_body, sp));
    mf.end_block_insts(v_hdr);

    // ---- 3. Emit `v_body`: 8-wide AVX2 YMM vector body with writeback column caching ----
    mf.begin_block_insts(v_body);
    ctx.cur_mbb = v_body;
    var col_cache = try col.DynBuf.[mach_ir.VReg].init(alloc, if ncols > 4_usize { ncols } else { 4_usize });
    errdefer col_cache.destroy(alloc);
    var col_dirty = try col.DynBuf.[u8].init(alloc, if ncols > 4_usize { ncols } else { 4_usize });
    errdefer col_dirty.destroy(alloc);
    ci = 0_usize;
    while ci < ncols {
        try col_cache.push(alloc, mach_ir.VREG_NONE);
        try col_dirty.push(alloc, 0_u8);
        ci = ci +% 1_usize;
    }
    var pred_ymms = try col.DynBuf.[mach_ir.VReg].init(alloc, if plan.n_preds > 2_usize { plan.n_preds } else { 2_usize });
    errdefer pred_ymms.destroy(alloc);
    var pi_init: usize = 0_usize;
    while pi_init < plan.n_preds {
        try pred_ymms.push(alloc, mach_ir.VREG_NONE);
        pi_init = pi_init +% 1_usize;
    }

    let cptr_ro = col_ptrs.as_slice();
    oi = 0_usize;
    while oi < ops.len {
        let op = ops[oi];
        match op.kind {
            .ConstF32 => {
                // Already hoisted in `v_pre`!
            }
            .CopyYmm => {
                let sv = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src0_eir, sp);
                let didx = op.dst_eir.widen.[usize]();
                let em = eir_to_ymm.as_mut_slice();
                if didx < em.len { em[didx] = sv; }
            }
            .LoadCol => {
                let cidx = op.col_slot.widen.[usize]();
                var y = mach_ir.VREG_NONE;
                var cache_hit = false;
                if plan.can_cache_writes {
                    let cc_ro = col_cache.as_slice();
                    if cidx < cc_ro.len && cc_ro[cidx] != mach_ir.VREG_NONE {
                        y = cc_ro[cidx];
                        cache_hit = true;
                    }
                }
                if !cache_hit && cidx < cptr_ro.len {
                    let cptr = cptr_ro[cidx];
                    y = try mf.new_vreg(alloc, .Vec256);
                    var ld = mach_ir.inst_empty(.VMovUpsLoad, sp);
                    ld.dst = y;
                    ld.mem = mach_ir.mem_sib(cptr, v_i_phi, 4_u8, 0_i32);
                    ld.flag0 = true;
                    ld.size_bytes = 32_u8;
                    try mf.emit_inst(alloc, ld);
                    if plan.can_cache_writes {
                        let cc = col_cache.as_mut_slice();
                        if cidx < cc.len { cc[cidx] = y; }
                    }
                }
                let didx = op.dst_eir.widen.[usize]();
                let em = eir_to_ymm.as_mut_slice();
                if didx < em.len { em[didx] = y; }
            }
            .StoreCol => {
                let cidx = op.col_slot.widen.[usize]();
                let new_y = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src0_eir, sp);
                if op.pred_id >= 0_i32 {
                    // Predicated store: `v_blended = VBlendVPS(old_col, new_y, pred_mask, l256=true)`!
                    var old_y = mach_ir.VREG_NONE;
                    let cc_ro = col_cache.as_slice();
                    if cidx < cc_ro.len && cc_ro[cidx] != mach_ir.VREG_NONE {
                        old_y = cc_ro[cidx];
                    } else if cidx < cptr_ro.len {
                        let cptr = cptr_ro[cidx];
                        old_y = try mf.new_vreg(alloc, .Vec256);
                        var ld = mach_ir.inst_empty(.VMovUpsLoad, sp);
                        ld.dst = old_y;
                        ld.mem = mach_ir.mem_sib(cptr, v_i_phi, 4_u8, 0_i32);
                        ld.flag0 = true;
                        ld.size_bytes = 32_u8;
                        try mf.emit_inst(alloc, ld);
                    }
                    let pidx = op.pred_id.bitcast.[u32]().widen.[usize]();
                    let pm_ro = pred_ymms.as_slice();
                    if pidx < pm_ro.len && old_y != mach_ir.VREG_NONE {
                        let pm_v = pm_ro[pidx];
                        let blended = try mf.new_vreg(alloc, .Vec256);
                        var bl = mach_ir.inst_empty(.VBlendVPS, sp);
                        bl.dst = blended;
                        bl.src0 = old_y;
                        bl.src1 = new_y;
                        bl.src2 = pm_v;
                        bl.flag0 = true;
                        bl.size_bytes = 32_u8;
                        try mf.emit_inst(alloc, bl);
                        let cc = col_cache.as_mut_slice();
                        if cidx < cc.len {
                            cc[cidx] = blended;
                        }
                        let cd = col_dirty.as_mut_slice();
                        if cidx < cd.len {
                            cd[cidx] = 1_u8;
                        }
                    }
                } else if plan.can_cache_writes {
                    let cc = col_cache.as_mut_slice();
                    if cidx < cc.len {
                        cc[cidx] = new_y;
                    }
                    let cd = col_dirty.as_mut_slice();
                    if cidx < cd.len {
                        cd[cidx] = 1_u8;
                    }
                } else if cidx < cptr_ro.len {
                    let cptr = cptr_ro[cidx];
                    var st = mach_ir.inst_empty(.VMovUpsStore, sp);
                    st.src0 = new_y;
                    st.mem = mach_ir.mem_sib(cptr, v_i_phi, 4_u8, 0_i32);
                    st.flag0 = true;
                    st.size_bytes = 32_u8;
                    try mf.emit_inst(alloc, st);
                }
                _ = 0_u8;
            }
            .BinF32 => {
                let ya = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src0_eir, sp);
                let yb = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src1_eir, sp);
                let mop: mach_ir.MachOp = match op.bin_op {
                    .Add => { .VAddPS }
                    .Sub => { .VSubPS }
                    .Mul => { .VMulPS }
                    _ => { .VDivPS }
                };
                let dst_y = try mf.new_vreg(alloc, .Vec256);
                var m = mach_ir.inst_empty(mop, sp);
                m.dst = dst_y;
                m.src0 = ya;
                m.src1 = yb;
                m.flag0 = true;
                m.size_bytes = 32_u8;
                try mf.emit_inst(alloc, m);
                let didx = op.dst_eir.widen.[usize]();
                let em = eir_to_ymm.as_mut_slice();
                if didx < em.len { em[didx] = dst_y; }
            }
            .NegF32 => {
                let ya = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src0_eir, sp);
                let dst_y = try mf.new_vreg(alloc, .Vec256);
                var m = mach_ir.inst_empty(.VXorPS, sp);
                m.dst = dst_y;
                m.src0 = ya;
                m.src1 = sign_mask_ymm;
                m.flag0 = true;
                m.size_bytes = 32_u8;
                try mf.emit_inst(alloc, m);
                let didx = op.dst_eir.widen.[usize]();
                let em = eir_to_ymm.as_mut_slice();
                if didx < em.len { em[didx] = dst_y; }
            }
            .SqrtF32 => {
                let ya = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src0_eir, sp);
                let dst_y = try mf.new_vreg(alloc, .Vec256);
                var m = mach_ir.inst_empty(.VSqrtPS, sp);
                m.dst = dst_y;
                m.src0 = ya;
                m.flag0 = true;
                m.size_bytes = 32_u8;
                try mf.emit_inst(alloc, m);
                let didx = op.dst_eir.widen.[usize]();
                let em = eir_to_ymm.as_mut_slice();
                if didx < em.len { em[didx] = dst_y; }
            }
            .FmaF32 => {
                let ya = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src0_eir, sp);
                let yb = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src1_eir, sp);
                let yc = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src2_eir, sp);
                let dst_y = try mf.new_vreg(alloc, .Vec256);
                var m = mach_ir.inst_empty(.VFmadd231PS, sp);
                m.dst = dst_y;
                m.src0 = yc;
                m.src1 = ya;
                m.src2 = yb;
                m.tied_src0 = true;
                m.flag0 = true;
                m.size_bytes = 32_u8;
                try mf.emit_inst(alloc, m);
                let didx = op.dst_eir.widen.[usize]();
                let em = eir_to_ymm.as_mut_slice();
                if didx < em.len { em[didx] = dst_y; }
            }
            .CmpF32 => {
                let ya = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src0_eir, sp);
                let yb = try avx2_resolve_ymm(alloc, mf, eir_to_ymm.as_slice(), &mut inv_ymm, op.src1_eir, sp);
                var msk = try mf.new_vreg(alloc, .Vec256);
                var cm = mach_ir.inst_empty(.VCmpPS, sp);
                cm.dst = msk;
                cm.src0 = ya;
                cm.src1 = yb;
                cm.imm = avx2_vcmp_imm(op.bin_op).widen.[i64]();
                cm.flag0 = true;
                cm.size_bytes = 32_u8;
                try mf.emit_inst(alloc, cm);
                if op.pred_id >= 0_i32 {
                    let pidx = op.pred_id.bitcast.[u32]().widen.[usize]();
                    let pm_ro = pred_ymms.as_slice();
                    if pidx < pm_ro.len {
                        let pm_v = pm_ro[pidx];
                        let comb = try mf.new_vreg(alloc, .Vec256);
                        var an = mach_ir.inst_empty(.VAndPS, sp);
                        an.dst = comb;
                        an.src0 = msk;
                        an.src1 = pm_v;
                        an.flag0 = true;
                        an.size_bytes = 32_u8;
                        try mf.emit_inst(alloc, an);
                        msk = comb;
                    }
                }
                if op.out_pred_id >= 0_i32 {
                    let oidx = op.out_pred_id.bitcast.[u32]().widen.[usize]();
                    let pm_mut = pred_ymms.as_mut_slice();
                    if oidx < pm_mut.len { pm_mut[oidx] = msk; }
                }
            }
            .InvertPred => {
                let src_pid = op.bits_u32.widen.[usize]();
                let pm_ro = pred_ymms.as_slice();
                if src_pid < pm_ro.len {
                    let src_pm = pm_ro[src_pid];
                    var inv_m = try mf.new_vreg(alloc, .Vec256);
                    var xr = mach_ir.inst_empty(.VXorPS, sp);
                    xr.dst = inv_m;
                    xr.src0 = src_pm;
                    xr.src1 = all_ones_ymm;
                    xr.flag0 = true;
                    xr.size_bytes = 32_u8;
                    try mf.emit_inst(alloc, xr);
                    if op.pred_id >= 0_i32 {
                        let pidx = op.pred_id.bitcast.[u32]().widen.[usize]();
                        let pm_ro2 = pred_ymms.as_slice();
                        if pidx < pm_ro2.len {
                            let par_pm = pm_ro2[pidx];
                            let comb = try mf.new_vreg(alloc, .Vec256);
                            var an = mach_ir.inst_empty(.VAndPS, sp);
                            an.dst = comb;
                            an.src0 = inv_m;
                            an.src1 = par_pm;
                            an.flag0 = true;
                            an.size_bytes = 32_u8;
                            try mf.emit_inst(alloc, an);
                            inv_m = comb;
                        }
                    }
                    if op.out_pred_id >= 0_i32 {
                        let oidx = op.out_pred_id.bitcast.[u32]().widen.[usize]();
                        let pm_mut = pred_ymms.as_mut_slice();
                        if oidx < pm_mut.len { pm_mut[oidx] = inv_m; }
                    }
                }
            }
        }
        oi = oi +% 1_usize;
    }

    // Flush all dirty cached columns ONCE at the end of `v_body`!
    if plan.can_cache_writes {
        let cc_ro = col_cache.as_slice();
        let cd_ro = col_dirty.as_slice();
        ci = 0_usize;
        while ci < ncols && ci < cptr_ro.len && ci < cc_ro.len && ci < cd_ro.len {
            if cd_ro[ci] != 0_u8 && cc_ro[ci] != mach_ir.VREG_NONE {
                var st = mach_ir.inst_empty(.VMovUpsStore, sp);
                st.src0 = cc_ro[ci];
                st.mem = mach_ir.mem_sib(cptr_ro[ci], v_i_phi, 4_u8, 0_i32);
                st.flag0 = true;
                st.size_bytes = 32_u8;
                try mf.emit_inst(alloc, st);
            }
            ci = ci +% 1_usize;
        }
    }

    // Step `v_i += 8` and branch back to `v_hdr`
    let v_i_next = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(v_i_next, mach_ir.mem_base_disp(v_i_phi, 8_i32), sp));
    let p_step = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_i_phi, v_i_next);
    try mf.emit_parallel_copy(alloc, p_step, 1_u32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(v_hdr, sp));
    mf.end_block_insts(v_body);

    // ---- 4. Emit `v_exit`: hand off leftover index `v_i_phi` to scalar loop header ----
    mf.begin_block_insts(v_exit);
    let ind_loc = ctx_val_loc(ctx, plan.ind_val);
    if ind_loc.kind == .Gpr {
        let p_ex = mf.pcopy_pairs.len().trunc.[u32]();
        try mf.add_pcopy_pair(alloc, ind_loc.vreg0, v_i_phi);
        try mf.emit_parallel_copy(alloc, p_ex, 1_u32, sp);
    } else if ind_loc.kind == .Stack {
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(ind_loc.stack_off), v_i_phi, 8_usize, sp);
    }
    try mf.emit_inst(alloc, mach_ir.inst_jmp(ctx_mbb_for_eir(ctx, plan.hdr_bb), sp));
    mf.end_block_insts(v_exit);

    pred_ymms.destroy(alloc);
    col_dirty.destroy(alloc);
    col_cache.destroy(alloc);
    defined_in_trace.destroy(alloc);
    inv_ymm.destroy(alloc);
    eir_to_ymm.destroy(alloc);
    col_ptrs.destroy(alloc);

    mf.uses_ymm = true;
    ctx.uses_avx2_loop = true;
    return v_pre;
}

// ===========================================================================
// Section 10: Phi Edges, Fused Branch, Jump-Table Switch, Return & Driver
// ===========================================================================

fn block_has_phi_for_pred(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    from_bb: eir.BlockId,
    to_bb: eir.BlockId,
) -> bool {
    let phis = eir_prog.block_phis(fn_id, to_bb);
    var pi: usize = 0_usize;
    while pi < phis.len {
        let incs = eir_prog.phi_incoming(phis[pi].incoming);
        var ii: usize = 0_usize;
        while ii < incs.len {
            if incs[ii].pred_bb == from_bb && incs[ii].val != phis[pi].dst {
                return true;
            }
            ii = ii +% 1_usize;
        }
        pi = pi +% 1_usize;
    }
    return false;
}

struct StackPhiPair {
    dst: eir.EirValue;
    src: eir.EirValue;
    ty: types.TyId;
    snap_off: i32;
}

/// Emits cycle-safe parallel phi copies on edge `(from_bb -> to_bb)`:
/// - Register phis (`Gpr`/`PairGpr`/`Float32`/`Float64`/`Vec128`/`Vec256`) go into ONE `ParallelCopy`!
/// - Stack aggregate phis snapshot into scratch stack slots if there are multiple, then copy to dsts!
fn emit_phi_edge(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    from_bb: eir.BlockId,
    to_bb: eir.BlockId,
    sp: span.Span,
) -> !OutOfMemory {
    let phis = eir_prog.block_phis(ctx.fn_id, to_bb);
    if phis.len == 0_usize {
        return;
    }
    var reg_dsts = try col.DynBuf.[mach_ir.VReg].init(alloc, 8_usize);
    errdefer reg_dsts.destroy(alloc);
    var reg_srcs = try col.DynBuf.[mach_ir.VReg].init(alloc, 8_usize);
    errdefer reg_srcs.destroy(alloc);
    var stk_phis = try col.DynBuf.[StackPhiPair].init(alloc, 4_usize);
    errdefer stk_phis.destroy(alloc);

    var pi: usize = 0_usize;
    while pi < phis.len {
        let ph = phis[pi];
        let incs = eir_prog.phi_incoming(ph.incoming);
        var src_v = eir.EIR_NONE;
        var ii: usize = 0_usize;
        while ii < incs.len {
            if incs[ii].pred_bb == from_bb {
                src_v = incs[ii].val;
                break;
            }
            ii = ii +% 1_usize;
        }
        if src_v != eir.EIR_NONE && src_v != ph.dst {
            let dl = ctx_val_loc(ctx, ph.dst);
            let sl = ctx_val_loc(ctx, src_v);
            match dl.kind {
                .Zst => {}
                .Gpr => {
                    let sv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, src_v, false, sp);
                    try reg_dsts.push(alloc, dl.vreg0);
                    try reg_srcs.push(alloc, sv);
                }
                .PairGpr => {
                    let pr = try load_slice_pair(alloc, ctx, mf, src_v, sp);
                    try reg_dsts.push(alloc, dl.vreg0);
                    try reg_srcs.push(alloc, pr.lo);
                    try reg_dsts.push(alloc, dl.vreg1);
                    try reg_srcs.push(alloc, pr.hi);
                }
                .SliceEuPair => {}
                .Float32 => {
                    let fv = try load_val_float(alloc, ctx, mf, eir_prog, env, src_v, sp);
                    try reg_dsts.push(alloc, dl.vreg0);
                    try reg_srcs.push(alloc, fv);
                }
                .Float64 => {
                    let fv = try load_val_float(alloc, ctx, mf, eir_prog, env, src_v, sp);
                    try reg_dsts.push(alloc, dl.vreg0);
                    try reg_srcs.push(alloc, fv);
                }
                .Vec128 => {
                    let vv = try load_val_vec(alloc, ctx, mf, src_v, false, sp);
                    try reg_dsts.push(alloc, dl.vreg0);
                    try reg_srcs.push(alloc, vv);
                }
                .Vec256 => {
                    let vv = try load_val_vec(alloc, ctx, mf, src_v, true, sp);
                    try reg_dsts.push(alloc, dl.vreg0);
                    try reg_srcs.push(alloc, vv);
                }
                .Stack => {
                    let _ = sl;
                    let ty = eir_prog.fn_val_ty(ctx.fn_id, ph.dst);
                    let lay = env.x64_layout(ty);
                    if lay.size > 0_usize {
                        try stk_phis.push(alloc, StackPhiPair.{
                            dst: ph.dst,
                            src: src_v,
                            ty: ty,
                            snap_off: 0_i32,
                        });
                    }
                }
            }
        }
        pi = pi +% 1_usize;
    }

    // Handle stack phis safely (snapshot if > 1 to guarantee cycle-free parallel semantics!)
    let n_stk = stk_phis.len();
    if n_stk == 1_usize {
        let sp_ro = stk_phis.as_slice();
        if sp_ro.len > 0_usize {
            let p0 = sp_ro[0_usize];
            try emit_copy_val_to_val(alloc, ctx, mf, eir_prog, env, p0.dst, p0.src, sp);
        }
    } else if n_stk > 1_usize {
        var si: usize = 0_usize;
        while si < n_stk {
            let sp_ro = stk_phis.as_slice();
            if si >= sp_ro.len { break; }
            let p = sp_ro[si];
            let lay = env.x64_layout(p.ty);
            let soff = mf.alloc_stack_slot(lay.size, if lay.align < 8_usize { 8_usize } else { 16_usize });
            let sm = stk_phis.as_mut_slice();
            if si < sm.len { sm[si].snap_off = soff; }
            try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(soff), p.src, p.ty, sp);
            si = si +% 1_usize;
        }
        let sp_ro2 = stk_phis.as_slice();
        si = 0_usize;
        while si < sp_ro2.len {
            let p = sp_ro2[si];
            try load_val_from_mem(alloc, ctx, mf, eir_prog, env, p.dst, mach_ir.mem_stack_slot(p.snap_off), p.ty, sp);
            si = si +% 1_usize;
        }
    }

    // Emit single ParallelCopy for ALL register phis (coalesced & cycle-broken by mach_regalloc!)
    let rd = reg_dsts.as_slice();
    let rs = reg_srcs.as_slice();
    if rd.len > 0_usize && rd.len == rs.len {
        let pstart = mf.pcopy_pairs.len().trunc.[u32]();
        var ri: usize = 0_usize;
        while ri < rd.len {
            try mf.add_pcopy_pair(alloc, rd[ri], rs[ri]);
            ri = ri +% 1_usize;
        }
        try mf.emit_parallel_copy(alloc, pstart, rd.len.trunc.[u32](), sp);
    }

    stk_phis.destroy(alloc);
    reg_srcs.destroy(alloc);
    reg_dsts.destroy(alloc);
    return;
}

fn find_avx2_redirect(ctx: *IselCtx, from_bb: eir.BlockId, to_bb: eir.BlockId) -> u32 {
    let ls = ctx.avx2_loops.as_slice();
    var i: usize = 0_usize;
    while i < ls.len {
        if ls[i].pre_bb == from_bb && ls[i].hdr_bb == to_bb && ls[i].v_pre_mbb != eir.EIR_NONE {
            return ls[i].v_pre_mbb;
        }
        i = i +% 1_usize;
    }
    return eir.EIR_NONE;
}

fn emit_return_term(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    has_val: bool,
    val: eir.EirValue,
    sp: span.Span,
) -> !OutOfMemory {
    let rc = ctx.ret_class;
    match rc.kind {
        .Void => {
            try mf.emit_inst(alloc, mach_ir.inst_ret(sp));
        }
        .IntReg => {
            let rv = if has_val {
                try load_val_gpr(alloc, ctx, mf, eir_prog, env, val, true, sp)
            } else {
                try emit_imm_vreg(alloc, mf, 0_u64, sp)
            };
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(rv, mach_ir.PHYS_RAX, sp));
            try mf.emit_inst(alloc, mach_ir.inst_ret(sp));
        }
        .TwoIntRegs => {
            var r0 = mach_ir.VREG_NONE;
            var r1 = mach_ir.VREG_NONE;
            if has_val {
                let loc = ctx_val_loc(ctx, val);
                if loc.kind == .PairGpr {
                    r0 = loc.vreg0;
                    r1 = loc.vreg1;
                } else {
                    let lay = env.x64_layout(ctx.ret_ty);
                    let soff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, val, sp);
                    r0 = try mf.new_vreg(alloc, .Gpr);
                    r1 = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, r0, mach_ir.mem_stack_slot(soff), 8_usize, false, sp);
                    if lay.size > 8_usize {
                        try emit_load_mem(alloc, mf, r1, mach_ir.mem_stack_slot(soff +% 8_i32), lay.size - 8_usize, false, sp);
                    } else {
                        try emit_mov_imm(alloc, mf, r1, 0_u64, sp);
                    }
                    _ = 0_u8;
                }
                _ = 0_u8;
            } else {
                r0 = try emit_imm_vreg(alloc, mf, 0_u64, sp);
                r1 = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            }
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(r0, mach_ir.PHYS_RAX, sp));
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(r1, mach_ir.PHYS_RDX, sp));
            try mf.emit_inst(alloc, mach_ir.inst_ret(sp));
        }
        .FloatReg => {
            let rv = if has_val {
                try load_val_float(alloc, ctx, mf, eir_prog, env, val, sp)
            } else {
                let z = try emit_imm_vreg(alloc, mf, 0_u64, sp);
                let x = try mf.new_vreg(alloc, .Vec128);
                var m = mach_ir.inst_empty(.VMovQToXmm, sp);
                m.dst = x; m.src0 = z; m.size_bytes = 8_u8;
                try mf.emit_inst(alloc, m);
                x
            };
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(rv, PHYS_XMM0, sp));
            try mf.emit_inst(alloc, mach_ir.inst_ret(sp));
        }
        .Sret => {
            if has_val {
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_base_disp(ctx.sret_vreg, 0_i32), val, ctx.ret_ty, sp);
            }
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(ctx.sret_vreg, mach_ir.PHYS_RAX, sp));
            try mf.emit_inst(alloc, mach_ir.inst_ret(sp));
        }
        .ErrorUnion => {
            if !has_val {
                let z = try emit_imm_vreg(alloc, mf, 0_u64, sp);
                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z, mach_ir.PHYS_R15, sp));
                try mf.emit_inst(alloc, mach_ir.inst_empty(.Clc, sp));
                try mf.emit_inst(alloc, mach_ir.inst_ret(sp));
                return;
            }
            // Fused `Return(WrapOk(v))` / `Return(WrapErr(e))`: ZERO stack store/reload/branch!
            if ctx_should_skip(ctx, val) {
                let rgid = ctx_def_inst_gid(ctx, val);
                let all_i = eir_prog.funcs.insts.as_slice();
                if rgid != eir.EIR_NONE && rgid.widen.[usize]() < all_i.len {
                    let ri = all_i[rgid.widen.[usize]()];
                    if ri.kind == .Cast && ri.cast_kind == .WrapErr {
                        let etag = try load_val_gpr(alloc, ctx, mf, eir_prog, env, ri.v0, false, sp);
                        try mf.emit_inst(alloc, mach_ir.inst_use_fixed(etag, mach_ir.PHYS_R15, sp));
                        try mf.emit_inst(alloc, mach_ir.inst_empty(.Stc, sp));
                        try mf.emit_inst(alloc, mach_ir.inst_ret(sp));
                        return;
                    }
                    if ri.kind == .Cast && ri.cast_kind == .WrapOk {
                        let ok_v = ri.v0;
                        let ok_lay = env.x64_layout(rc.ok_ty);
                        let z_r15 = try emit_imm_vreg(alloc, mf, 0_u64, sp);
                        match rc.ok_kind {
                            .Void => {
                                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z_r15, mach_ir.PHYS_R15, sp));
                            }
                            .IntReg => {
                                let r0 = if ok_v != eir.EIR_NONE {
                                    try load_val_gpr(alloc, ctx, mf, eir_prog, env, ok_v, true, sp)
                                } else {
                                    try emit_imm_vreg(alloc, mf, 0_u64, sp)
                                };
                                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(r0, mach_ir.PHYS_RAX, sp));
                                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z_r15, mach_ir.PHYS_R15, sp));
                            }
                            .TwoIntRegs => {
                                var r0 = mach_ir.VREG_NONE;
                                var r1 = mach_ir.VREG_NONE;
                                if ok_v != eir.EIR_NONE {
                                    let oloc = ctx_val_loc(ctx, ok_v);
                                    if oloc.kind == .PairGpr {
                                        r0 = oloc.vreg0;
                                        r1 = oloc.vreg1;
                                    } else {
                                        let ooff = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, ok_v, sp);
                                        r0 = try mf.new_vreg(alloc, .Gpr);
                                        r1 = try mf.new_vreg(alloc, .Gpr);
                                        try emit_load_mem(alloc, mf, r0, mach_ir.mem_stack_slot(ooff), 8_usize, false, sp);
                                        if ok_lay.size > 8_usize {
                                            try emit_load_mem(alloc, mf, r1, mach_ir.mem_stack_slot(ooff +% 8_i32), ok_lay.size - 8_usize, false, sp);
                                        } else {
                                            try emit_mov_imm(alloc, mf, r1, 0_u64, sp);
                                        }
                                    }
                                    _ = 0_u8;
                                } else {
                                    r0 = try emit_imm_vreg(alloc, mf, 0_u64, sp);
                                    r1 = try emit_imm_vreg(alloc, mf, 0_u64, sp);
                                }
                                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(r0, mach_ir.PHYS_RAX, sp));
                                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(r1, mach_ir.PHYS_RDX, sp));
                                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z_r15, mach_ir.PHYS_R15, sp));
                            }
                            .FloatReg => {
                                let rx = try load_val_float(alloc, ctx, mf, eir_prog, env, ok_v, sp);
                                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(rx, PHYS_XMM0, sp));
                                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z_r15, mach_ir.PHYS_R15, sp));
                            }
                            .Sret => {
                                if ok_v != eir.EIR_NONE {
                                    try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_base_disp(ctx.sret_vreg, 0_i32), ok_v, rc.ok_ty, sp);
                                }
                                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(ctx.sret_vreg, mach_ir.PHYS_RAX, sp));
                                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z_r15, mach_ir.PHYS_R15, sp));
                            }
                            .ErrorUnion => {}
                        }
                        try mf.emit_inst(alloc, mach_ir.inst_empty(.Clc, sp));
                        try mf.emit_inst(alloc, mach_ir.inst_ret(sp));
                        return;
                    }
                }
            }
            let soff = ctx_val_loc(ctx, val).stack_off;
            let err_tag = try mf.new_vreg(alloc, .Gpr);
            try emit_load_mem(alloc, mf, err_tag, mach_ir.mem_stack_slot(soff), 4_usize, false, sp);

            let b_ok = try mf.add_block(alloc, ctx.cur_depth);
            let b_err = try mf.add_block(alloc, ctx.cur_depth);
            try emit_test_rr(alloc, mf, err_tag, err_tag, true, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, b_err, sp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
            mf.end_block_insts(ctx.cur_mbb);

            mf.begin_block_insts(b_ok);
            let ok_off = env.eu_ok_offset(rc.ok_ty).trunc.[i32]();
            let ok_lay = env.x64_layout(rc.ok_ty);
            let z_r15 = try emit_imm_vreg(alloc, mf, 0_u64, sp);
            match rc.ok_kind {
                .Void => {
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z_r15, mach_ir.PHYS_R15, sp));
                }
                .IntReg => {
                    let r0 = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, r0, mach_ir.mem_stack_slot(soff +% ok_off), ok_lay.size, env.is_signed_int(rc.ok_ty), sp);
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(r0, mach_ir.PHYS_RAX, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z_r15, mach_ir.PHYS_R15, sp));
                }
                .TwoIntRegs => {
                    let r0 = try mf.new_vreg(alloc, .Gpr);
                    let r1 = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, r0, mach_ir.mem_stack_slot(soff +% ok_off), 8_usize, false, sp);
                    if ok_lay.size > 8_usize {
                        try emit_load_mem(alloc, mf, r1, mach_ir.mem_stack_slot(soff +% ok_off +% 8_i32), ok_lay.size - 8_usize, false, sp);
                    } else {
                        try emit_mov_imm(alloc, mf, r1, 0_u64, sp);
                    }
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(r0, mach_ir.PHYS_RAX, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(r1, mach_ir.PHYS_RDX, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z_r15, mach_ir.PHYS_R15, sp));
                }
                .FloatReg => {
                    let is_f64 = env.get(rc.ok_ty).u8_val == 64_u8;
                    let rx = try mf.new_vreg(alloc, .Vec128);
                    var ld = mach_ir.inst_empty(if is_f64 { .VMovSDLoad } else { .VMovSSLoad }, sp);
                    ld.dst = rx;
                    ld.mem = mach_ir.mem_stack_slot(soff +% ok_off);
                    ld.size_bytes = if is_f64 { 8_u8 } else { 4_u8 };
                    try mf.emit_inst(alloc, ld);
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(rx, PHYS_XMM0, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z_r15, mach_ir.PHYS_R15, sp));
                }
                .Sret => {
                    try emit_copy_mem(alloc, mf, mach_ir.mem_base_disp(ctx.sret_vreg, 0_i32), mach_ir.mem_stack_slot(soff +% ok_off), ok_lay.size, sp);
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(ctx.sret_vreg, mach_ir.PHYS_RAX, sp));
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(z_r15, mach_ir.PHYS_R15, sp));
                }
                .ErrorUnion => {}
            }
            try mf.emit_inst(alloc, mach_ir.inst_empty(.Clc, sp));
            try mf.emit_inst(alloc, mach_ir.inst_ret(sp));
            mf.end_block_insts(b_ok);

            mf.begin_block_insts(b_err);
            ctx.cur_mbb = b_err;
            try mf.emit_inst(alloc, mach_ir.inst_use_fixed(err_tag, mach_ir.PHYS_R15, sp));
            try mf.emit_inst(alloc, mach_ir.inst_empty(.Stc, sp));
            try mf.emit_inst(alloc, mach_ir.inst_ret(sp));
        }
    }
    return;
}

/// Emits fused compare-and-branch (or plain Test32 + Jcc) to `(then_mbb, else_mbb)`.
/// Closes `ctx.cur_mbb`!
fn emit_branch_to_targets(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    cond_v: eir.EirValue,
    then_mbb: u32,
    else_mbb: u32,
    sp: span.Span,
) -> !OutOfMemory {
    if ctx_should_skip(ctx, cond_v) {
        let gid = ctx_def_inst_gid(ctx, cond_v);
        let all_insts = eir_prog.funcs.insts.as_slice();
        if gid != eir.EIR_NONE && gid.widen.[usize]() < all_insts.len {
            let ci = all_insts[gid.widen.[usize]()];
            if ci.kind == .Binary {
                let tn = env.get(ci.ty1);
                if tn.kind == .Float {
                    let is_f64 = tn.u8_val == 64_u8;
                    let lv = try load_val_float(alloc, ctx, mf, eir_prog, env, ci.v0, sp);
                    let rv = try load_val_float(alloc, ctx, mf, eir_prog, env, ci.v1, sp);
                    let ucop: mach_ir.MachOp = if is_f64 { .VUcomiSD } else { .VUcomiSS };
                    match ci.bin_op {
                        .Eq => {
                            let b_ord = try mf.add_block(alloc, ctx.cur_depth);
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = lv; u.src1 = rv; try mf.emit_inst(alloc, u);
                            try mf.emit_inst(alloc, mach_ir.inst_jcc(.P, else_mbb, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ord, sp));
                            mf.end_block_insts(ctx.cur_mbb);
                            mf.begin_block_insts(b_ord);
                            ctx.cur_mbb = b_ord;
                            try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, then_mbb, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                            mf.end_block_insts(ctx.cur_mbb);
                            return;
                        }
                        .NotEq => {
                            let b_ord = try mf.add_block(alloc, ctx.cur_depth);
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = lv; u.src1 = rv; try mf.emit_inst(alloc, u);
                            try mf.emit_inst(alloc, mach_ir.inst_jcc(.P, then_mbb, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ord, sp));
                            mf.end_block_insts(ctx.cur_mbb);
                            mf.begin_block_insts(b_ord);
                            ctx.cur_mbb = b_ord;
                            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, then_mbb, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                            mf.end_block_insts(ctx.cur_mbb);
                            return;
                        }
                        .Lt => {
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = rv; u.src1 = lv; try mf.emit_inst(alloc, u);
                            try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, then_mbb, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                            mf.end_block_insts(ctx.cur_mbb);
                            return;
                        }
                        .LtEq => {
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = rv; u.src1 = lv; try mf.emit_inst(alloc, u);
                            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, then_mbb, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                            mf.end_block_insts(ctx.cur_mbb);
                            return;
                        }
                        .Gt => {
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = lv; u.src1 = rv; try mf.emit_inst(alloc, u);
                            try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, then_mbb, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                            mf.end_block_insts(ctx.cur_mbb);
                            return;
                        }
                        _ => {
                            var u = mach_ir.inst_empty(ucop, sp); u.src0 = lv; u.src1 = rv; try mf.emit_inst(alloc, u);
                            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, then_mbb, sp));
                            try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                            mf.end_block_insts(ctx.cur_mbb);
                            return;
                        }
                    }
                }
                // Integer fused compare-and-branch (with immediate folding & Test 0!)
                let signed = env.is_signed_int(ci.ty1);
                let lv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, ci.v0, true, sp);
                if ctx_is_const_int(ctx, ci.v1) && fits_i32(ctx_const_int(ctx, ci.v1).bitcast.[i64]()) {
                    let imm = ctx_const_int(ctx, ci.v1).bitcast.[i64]().trunc.[i32]();
                    if imm == 0_i32 && (ci.bin_op == .Eq || ci.bin_op == .NotEq) {
                        try emit_test_rr(alloc, mf, lv, lv, false, sp);
                    } else {
                        try emit_cmp_ri(alloc, mf, lv, imm, sp);
                    }
                } else {
                    let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, ci.v1, true, sp);
                    try emit_cmp_rr(alloc, mf, lv, rv, sp);
                }
                let cc: x64_asm.Cond = match ci.bin_op {
                    .Eq => { .E }
                    .NotEq => { .Ne }
                    .Lt => { if signed { .L } else { .B } }
                    .LtEq => { if signed { .Le } else { .Be } }
                    .Gt => { if signed { .G } else { .A } }
                    _ => { if signed { .Ge } else { .Ae } }
                };
                try mf.emit_inst(alloc, mach_ir.inst_jcc(cc, then_mbb, sp));
                try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                mf.end_block_insts(ctx.cur_mbb);
                return;
            }
            if ci.kind == .IsNonNull {
                let cc = try emit_is_non_null_flags(alloc, ctx, mf, eir_prog, env, ci.v0, ci.ty1, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jcc(cc, then_mbb, sp));
                try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                mf.end_block_insts(ctx.cur_mbb);
                return;
            }
            if ci.kind == .IsError {
                let sloc = ctx_val_loc(ctx, ci.v0);
                // Fused `Branch(IsError(SliceSub / ArraySub))` -> zero-stack register-only slice!
                if sloc.kind == .SliceEuPair && ctx_should_skip(ctx, ci.v0) {
                    let egid = ctx_def_inst_gid(ctx, ci.v0);
                    if egid != eir.EIR_NONE && egid.widen.[usize]() < all_insts.len {
                        let ei = all_insts[egid.widen.[usize]()];
                        if let ebc = eir_prog.get_builtin_call(ei.aux0) {
                            let eargs = eir_prog.vals_slice(ebc.args);
                            let eslots = eir_prog.arg_slots_slice(ebc.arg_slots);
                            let proven_safe = (eir_prog.inst_proven_flags(egid) & eir.PROVEN_BOUNDS_SAFE) != 0_u8;
                            let esz_r = env.x64_layout(ebc.op.ty0).size;
                            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                            if ebc.op.kind == .SliceSub && eargs.len >= 3_usize {
                                let pr = try load_slice_pair(alloc, ctx, mf, eargs[0_usize], sp);
                                let lo_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eargs[1_usize], true, sp);
                                let hi_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eargs[2_usize], true, sp);
                                if !proven_safe {
                                    let b_chk2 = try mf.add_block(alloc, ctx.cur_depth);
                                    let b_ok = try mf.add_block(alloc, ctx.cur_depth);
                                    try emit_cmp_rr(alloc, mf, lo_v, hi_v, sp);
                                    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, then_mbb, sp));
                                    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk2, sp));
                                    mf.end_block_insts(ctx.cur_mbb);

                                    mf.begin_block_insts(b_chk2);
                                    try emit_cmp_rr(alloc, mf, hi_v, pr.hi, sp);
                                    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, then_mbb, sp));
                                    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
                                    mf.end_block_insts(b_chk2);

                                    mf.begin_block_insts(b_ok);
                                    ctx.cur_mbb = b_ok;
                                }
                                try emit_alu_rr(alloc, mf, .Sub, sloc.vreg1, hi_v, lo_v, sp);
                                if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                                    try mf.emit_inst(alloc, mach_ir.inst_lea(sloc.vreg0, mach_ir.mem_sib(pr.lo, lo_v, esz.trunc.[u8](), 0_i32), sp));
                                } else {
                                    let sc = try emit_scale_index(alloc, mf, lo_v, esz, sp);
                                    try mf.emit_inst(alloc, mach_ir.inst_lea(sloc.vreg0, mach_ir.mem_sib(pr.lo, sc, 1_u8, 0_i32), sp));
                                }
                                try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                                mf.end_block_insts(ctx.cur_mbb);
                                return;
                            }
                            if ebc.op.kind == .ArraySub && eargs.len >= 3_usize {
                                let alen = array_len_from_arg(eir_prog, ctx.fn_id, env, eargs[0_usize]);
                                let base_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, eargs[0_usize], get_arg_slot(eslots, 0_usize), sp);
                                let lo_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eargs[1_usize], true, sp);
                                let hi_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eargs[2_usize], true, sp);
                                if !proven_safe {
                                    let len_v = try emit_imm_vreg(alloc, mf, alen, sp);
                                    let b_chk2 = try mf.add_block(alloc, ctx.cur_depth);
                                    let b_ok = try mf.add_block(alloc, ctx.cur_depth);
                                    try emit_cmp_rr(alloc, mf, lo_v, hi_v, sp);
                                    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, then_mbb, sp));
                                    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk2, sp));
                                    mf.end_block_insts(ctx.cur_mbb);

                                    mf.begin_block_insts(b_chk2);
                                    try emit_cmp_rr(alloc, mf, hi_v, len_v, sp);
                                    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, then_mbb, sp));
                                    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
                                    mf.end_block_insts(b_chk2);

                                    mf.begin_block_insts(b_ok);
                                    ctx.cur_mbb = b_ok;
                                }
                                try emit_alu_rr(alloc, mf, .Sub, sloc.vreg1, hi_v, lo_v, sp);
                                if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                                    try mf.emit_inst(alloc, mach_ir.inst_lea(sloc.vreg0, mach_ir.mem_sib(base_p, lo_v, esz.trunc.[u8](), 0_i32), sp));
                                } else {
                                    let sc = try emit_scale_index(alloc, mf, lo_v, esz, sp);
                                    try mf.emit_inst(alloc, mach_ir.inst_lea(sloc.vreg0, mach_ir.mem_sib(base_p, sc, 1_u8, 0_i32), sp));
                                }
                                try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                                mf.end_block_insts(ctx.cur_mbb);
                                return;
                            }
                        }
                    }
                }
                // Fused `Branch(IsError(ArenaPoolIdAt / ArenaPoolPush / BufPush))`!
                if sloc.kind == .PairGpr && ctx_should_skip(ctx, ci.v0) {
                    let egid = ctx_def_inst_gid(ctx, ci.v0);
                    if egid != eir.EIR_NONE && egid.widen.[usize]() < all_insts.len {
                        let ei = all_insts[egid.widen.[usize]()];
                        if ei.kind == .Call {
                            try emit_call_inst_core(alloc, ctx, mf, eir_prog, env, interner, ei.dst, ei.aux0, ei.span, true, then_mbb, else_mbb);
                            return;
                        }
                        if let ebc = eir_prog.get_builtin_call(ei.aux0) {
                            let eargs = eir_prog.vals_slice(ebc.args);
                            let eslots = eir_prog.arg_slots_slice(ebc.arg_slots);
                            if ebc.op.kind == .ArenaPoolIdAt && eargs.len >= 2_usize {
                                let idx_v = try load_val_gpr(alloc, ctx, mf, eir_prog, env, eargs[1_usize], true, sp);
                                try emit_extend(alloc, mf, sloc.vreg1, idx_v, 4_u8, false, sp);
                                if (eir_prog.inst_proven_flags(egid) & eir.PROVEN_BOUNDS_SAFE) != 0_u8 {
                                    try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                                    mf.end_block_insts(ctx.cur_mbb);
                                    return;
                                }
                                let ncols = pool_ncols_from_arg_ty(env, eir_prog.fn_val_ty(ctx.fn_id, eargs[0_usize]));
                                let len_off = (ncols *% 8_usize).trunc.[i32]();
                                var len_v = if get_arg_slot(eslots, 0_usize) == eir.EIR_NONE {
                                    find_hoisted_pool_col(ctx, eargs[0_usize], len_off)
                                } else {
                                    mach_ir.VREG_NONE
                                };
                                if len_v == mach_ir.VREG_NONE {
                                    let pool_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, eargs[0_usize], get_arg_slot(eslots, 0_usize), sp);
                                    len_v = try mf.new_vreg(alloc, .Gpr);
                                    try emit_load_mem(alloc, mf, len_v, mach_ir.mem_base_disp(pool_p, len_off), 8_usize, false, sp);
                                }
                                let b_err_tag = try mf.add_block(alloc, 0_u8);
                                try emit_cmp_rr(alloc, mf, idx_v, len_v, sp);
                                try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_err_tag, sp));
                                try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                                mf.end_block_insts(ctx.cur_mbb);
                                mf.begin_block_insts(b_err_tag);
                                try emit_mov_imm(alloc, mf, sloc.vreg0, 4_u64, sp);
                                try mf.emit_inst(alloc, mach_ir.inst_jmp(then_mbb, sp));
                                mf.end_block_insts(b_err_tag);
                                return;
                            }
                            if ebc.op.kind == .ArenaPoolPush && eargs.len >= 1_usize {
                                let pdef = env.get(ebc.op.ty0).primary;
                                let ncols = pool_ncols_from_ty(env, ebc.op.ty0);
                                let pool_arg_slot = get_arg_slot(eslots, 0_usize);
                                let pool_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, eargs[0_usize], pool_arg_slot, sp);
                                let cur_len = try mf.new_vreg(alloc, .Gpr);
                                let len_off = (ncols *% 8_usize).trunc.[i32]();
                                let cap_off = ((ncols +% 1_usize) *% 8_usize).trunc.[i32]();
                                try emit_load_mem(alloc, mf, cur_len, mach_ir.mem_base_disp(pool_p, len_off), 8_usize, false, sp);
                                var cur_cap = if pool_arg_slot == eir.EIR_NONE {
                                    find_hoisted_pool_col(ctx, eargs[0_usize], cap_off)
                                } else {
                                    mach_ir.VREG_NONE
                                };
                                if cur_cap == mach_ir.VREG_NONE {
                                    cur_cap = try mf.new_vreg(alloc, .Gpr);
                                    try emit_load_mem(alloc, mf, cur_cap, mach_ir.mem_base_disp(pool_p, cap_off), 8_usize, false, sp);
                                }
                                let b_ok = try mf.add_block(alloc, ctx.cur_depth);
                                let b_oom = try mf.add_block(alloc, 0_u8);
                                try emit_cmp_rr(alloc, mf, cur_len, cur_cap, sp);
                                try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_oom, sp));
                                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
                                mf.end_block_insts(ctx.cur_mbb);

                                mf.begin_block_insts(b_ok);
                                let nxt_len = try mf.new_vreg(alloc, .Gpr);
                                try mf.emit_inst(alloc, mach_ir.inst_lea(nxt_len, mach_ir.mem_base_disp(cur_len, 1_i32), sp));
                                try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(pool_p, len_off), nxt_len, 8_usize, sp);
                                if eargs.len > 1_usize {
                                    let row_v = eargs[1_usize];
                                    var did_direct_agg = false;
                                    if ctx_should_skip(ctx, row_v) {
                                        let agid = ctx_def_inst_gid(ctx, row_v);
                                        if agid != eir.EIR_NONE && agid.widen.[usize]() < all_insts.len {
                                            let ai = all_insts[agid.widen.[usize]()];
                                            if ai.kind == .Aggregate {
                                                let elems = eir_prog.vals_slice(ai.range);
                                                if let pm = env.get_pool(pdef) {
                                                    let cols = env.pool_cols_range(pm.columns);
                                                    if elems.len == cols.len {
                                                        did_direct_agg = true;
                                                        var ci2: usize = 0_usize;
                                                        while ci2 < cols.len {
                                                            let esz_r = env.x64_layout_impl(cols[ci2].ty, false).size;
                                                            let col_esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                                                            let col_hdr_off = (ci2 *% 8_usize).trunc.[i32]();
                                                            var col_p = if pool_arg_slot == eir.EIR_NONE {
                                                                find_hoisted_pool_col(ctx, eargs[0_usize], col_hdr_off)
                                                            } else {
                                                                mach_ir.VREG_NONE
                                                            };
                                                            if col_p == mach_ir.VREG_NONE {
                                                                col_p = try mf.new_vreg(alloc, .Gpr);
                                                                try emit_load_mem(alloc, mf, col_p, mach_ir.mem_base_disp(pool_p, col_hdr_off), 8_usize, false, sp);
                                                            }
                                                            var dst_mem = mach_ir.mem_none();
                                                            if col_esz == 1_usize || col_esz == 2_usize || col_esz == 4_usize || col_esz == 8_usize {
                                                                dst_mem = mach_ir.mem_sib(col_p, cur_len, col_esz.trunc.[u8](), 0_i32);
                                                            } else {
                                                                let sc = try emit_scale_index(alloc, mf, cur_len, col_esz, sp);
                                                                let dst_addr = try mf.new_vreg(alloc, .Gpr);
                                                                try mf.emit_inst(alloc, mach_ir.inst_lea(dst_addr, mach_ir.mem_sib(col_p, sc, 1_u8, 0_i32), sp));
                                                                dst_mem = mach_ir.mem_base_disp(dst_addr, 0_i32);
                                                            }
                                                            if col_esz == 4_usize && env.is_link_or_opt_link(cols[ci2].ty) {
                                                                let lv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, elems[ci2], false, sp);
                                                                try emit_store_mem(alloc, mf, dst_mem, lv, 4_usize, sp);
                                                            } else {
                                                                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, dst_mem, elems[ci2], cols[ci2].ty, sp);
                                                            }
                                                            ci2 = ci2 +% 1_usize;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if !did_direct_agg {
                                        let row_off = try materialize_val_to_stack(alloc, ctx, mf, eir_prog, env, row_v, sp);
                                        let row_ty = eir_prog.fn_val_ty(ctx.fn_id, row_v);
                                        if let pm = env.get_pool(pdef) {
                                            let cols = env.pool_cols_range(pm.columns);
                                            var ci2: usize = 0_usize;
                                            while ci2 < cols.len {
                                                let foff = env.struct_field_offset(row_ty, ci2).offset;
                                                let esz_r = env.x64_layout_impl(cols[ci2].ty, false).size;
                                                let col_esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                                                let col_hdr_off = (ci2 *% 8_usize).trunc.[i32]();
                                                var col_p = if pool_arg_slot == eir.EIR_NONE {
                                                    find_hoisted_pool_col(ctx, eargs[0_usize], col_hdr_off)
                                                } else {
                                                    mach_ir.VREG_NONE
                                                };
                                                if col_p == mach_ir.VREG_NONE {
                                                    col_p = try mf.new_vreg(alloc, .Gpr);
                                                    try emit_load_mem(alloc, mf, col_p, mach_ir.mem_base_disp(pool_p, col_hdr_off), 8_usize, false, sp);
                                                }
                                                if col_esz == 1_usize || col_esz == 2_usize || col_esz == 4_usize || col_esz == 8_usize {
                                                    let tv = try mf.new_vreg(alloc, .Gpr);
                                                    try emit_load_mem(alloc, mf, tv, mach_ir.mem_stack_slot(row_off +% foff.trunc.[i32]()), col_esz, false, sp);
                                                    try emit_store_mem(alloc, mf, mach_ir.mem_sib(col_p, cur_len, col_esz.trunc.[u8](), 0_i32), tv, col_esz, sp);
                                                } else {
                                                    let sc = try emit_scale_index(alloc, mf, cur_len, col_esz, sp);
                                                    let dst_addr = try mf.new_vreg(alloc, .Gpr);
                                                    try mf.emit_inst(alloc, mach_ir.inst_lea(dst_addr, mach_ir.mem_sib(col_p, sc, 1_u8, 0_i32), sp));
                                                    try emit_copy_mem(alloc, mf, mach_ir.mem_base_disp(dst_addr, 0_i32), mach_ir.mem_stack_slot(row_off +% foff.trunc.[i32]()), col_esz, sp);
                                                }
                                                ci2 = ci2 +% 1_usize;
                                            }
                                        }
                                    }
                                }
                                try emit_extend(alloc, mf, sloc.vreg1, cur_len, 4_u8, false, sp);
                                try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                                mf.end_block_insts(b_ok);

                                mf.begin_block_insts(b_oom);
                                try emit_mov_imm(alloc, mf, sloc.vreg0, 7_u64, sp);
                                try mf.emit_inst(alloc, mach_ir.inst_jmp(then_mbb, sp));
                                mf.end_block_insts(b_oom);
                                return;
                            }
                            if ebc.op.kind == .BufPush && eargs.len >= 2_usize {
                                let esz_raw = env.x64_layout(ebc.op.ty0).size;
                                let esz = if esz_raw == 0_usize { 1_usize } else { esz_raw };
                                let val_arg = if eargs.len >= 3_usize { eargs[2_usize] } else { eargs[1_usize] };
                                let buf_p = try load_ptr_arg(alloc, ctx, mf, eir_prog, env, eargs[0_usize], get_arg_slot(eslots, 0_usize), sp);
                                let len_v = try mf.new_vreg(alloc, .Gpr);
                                let cap_v = try mf.new_vreg(alloc, .Gpr);
                                try emit_load_mem(alloc, mf, len_v, mach_ir.mem_base_disp(buf_p, 8_i32), 8_usize, false, sp);
                                try emit_load_mem(alloc, mf, cap_v, mach_ir.mem_base_disp(buf_p, 16_i32), 8_usize, false, sp);
                                let b_ok = try mf.add_block(alloc, ctx.cur_depth);
                                let b_full = try mf.add_block(alloc, 0_u8);
                                try emit_cmp_rr(alloc, mf, len_v, cap_v, sp);
                                try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_full, sp));
                                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_ok, sp));
                                mf.end_block_insts(ctx.cur_mbb);

                                mf.begin_block_insts(b_ok);
                                let nxt_len = try mf.new_vreg(alloc, .Gpr);
                                try mf.emit_inst(alloc, mach_ir.inst_lea(nxt_len, mach_ir.mem_base_disp(len_v, 1_i32), sp));
                                try emit_store_mem(alloc, mf, mach_ir.mem_base_disp(buf_p, 8_i32), nxt_len, 8_usize, sp);
                                let data_p = try mf.new_vreg(alloc, .Gpr);
                                try emit_load_mem(alloc, mf, data_p, mach_ir.mem_base_disp(buf_p, 0_i32), 8_usize, false, sp);
                                try emit_buf_push_elem(alloc, ctx, mf, eir_prog, env, data_p, len_v, esz, val_arg, ebc.op.ty0, sp);
                                try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                                mf.end_block_insts(b_ok);

                                mf.begin_block_insts(b_full);
                                try emit_mov_imm(alloc, mf, sloc.vreg0, 7_u64, sp);
                                try mf.emit_inst(alloc, mach_ir.inst_jmp(then_mbb, sp));
                                mf.end_block_insts(b_full);
                                return;
                            }
                        }
                    }
                }
                if sloc.kind == .PairGpr {
                    try emit_test_rr(alloc, mf, sloc.vreg0, sloc.vreg0, true, sp);
                } else {
                    let tag = try mf.new_vreg(alloc, .Gpr);
                    try emit_load_mem(alloc, mf, tag, mach_ir.mem_stack_slot(sloc.stack_off), 4_usize, false, sp);
                    try emit_test_rr(alloc, mf, tag, tag, true, sp);
                }
                try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, then_mbb, sp));
                try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
                mf.end_block_insts(ctx.cur_mbb);
                return;
            }
        }
    }
    let cv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, cond_v, false, sp);
    try emit_test_rr(alloc, mf, cv, cv, true, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, then_mbb, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(else_mbb, sp));
    mf.end_block_insts(ctx.cur_mbb);
    return;
}

fn build_switch_jump_table(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    interner: *mut span.SymInterner,
    targets: *[cfg_ir.SwitchTarget],
    tm_ro: *[u32],
    def_mbb: u32,
    min_v: i64,
    range_sz: usize,
) -> u32 ! OutOfMemory {
    var tbl = try col.DynBuf.[u32].init(alloc, range_sz);
    errdefer tbl.destroy(alloc);
    var ri: usize = 0_usize;
    while ri < range_sz {
        try tbl.push(alloc, def_mbb);
        ri = ri +% 1_usize;
    }
    let tbl_mut = tbl.as_mut_slice();
    var ti: usize = 0_usize;
    while ti < targets.len && ti < tm_ro.len {
        let off = (targets[ti].val.lo -% min_v.bitcast.[u64]()).trunc.[usize]();
        if off < tbl_mut.len {
            tbl_mut[off] = tm_ro[ti];
        }
        ti = ti +% 1_usize;
    }
    let jt_idx_num = ctx.jt_counter;
    ctx.jt_counter = ctx.jt_counter +% 1_u64;
    let jt_sym = try intern_jt_sym(alloc, interner, ctx.fn_sym_id, jt_idx_num);
    let jt_id = try mf.add_jump_table(alloc, jt_sym, tbl.as_slice(), def_mbb);
    tbl.destroy(alloc);
    return jt_id;
}

fn mbb_min_depth(mf: *mach_ir.MachFunc, mbb: u32, cur_depth: u8) -> u8 {
    let bs = mf.blocks.as_slice();
    let idx = mbb.widen.[usize]();
    if idx < bs.len {
        let d = bs[idx].loop_depth;
        if d < cur_depth {
            return d;
        }
    }
    return cur_depth;
}

fn emit_switch_term(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    bb: eir.BlockId,
    term: *eir.EirTerm,
) -> !OutOfMemory {
    let sp = term.span;
    let discr = try load_val_gpr(alloc, ctx, mf, eir_prog, env, term.val, true, sp);
    let targets = eir_prog.switch_targets_slice(term.targets);
    let def_bb = term.bb0;

    // Pre-allocate trampolines for any target needing phi copies (with min(src, dst) loop_depth)!
    let def_redir = find_avx2_redirect(ctx, bb, def_bb);
    let def_needs_phi = def_redir == eir.EIR_NONE && block_has_phi_for_pred(eir_prog, ctx.fn_id, bb, def_bb);
    let def_mbb = if def_redir != eir.EIR_NONE {
        def_redir
    } else if def_needs_phi {
        let dm = ctx_mbb_for_eir(ctx, def_bb);
        try mf.add_block(alloc, mbb_min_depth(mf, dm, ctx.cur_depth))
    } else {
        ctx_mbb_for_eir(ctx, def_bb)
    };

    var targ_mbbs = try col.DynBuf.[u32].init(alloc, if targets.len > 4_usize { targets.len } else { 4_usize });
    errdefer targ_mbbs.destroy(alloc);
    var targ_is_tramp = try col.DynBuf.[u8].init(alloc, if targets.len > 4_usize { targets.len } else { 4_usize });
    errdefer targ_is_tramp.destroy(alloc);

    var ti: usize = 0_usize;
    while ti < targets.len {
        let tbb = targets[ti].target;
        let redir = find_avx2_redirect(ctx, bb, tbb);
        if redir != eir.EIR_NONE {
            try targ_mbbs.push(alloc, redir);
            try targ_is_tramp.push(alloc, 0_u8);
        } else if block_has_phi_for_pred(eir_prog, ctx.fn_id, bb, tbb) {
            let tm = ctx_mbb_for_eir(ctx, tbb);
            let tr = try mf.add_block(alloc, mbb_min_depth(mf, tm, ctx.cur_depth));
            try targ_mbbs.push(alloc, tr);
            try targ_is_tramp.push(alloc, 1_u8);
        } else {
            try targ_mbbs.push(alloc, ctx_mbb_for_eir(ctx, tbb));
            try targ_is_tramp.push(alloc, 0_u8);
        }
        ti = ti +% 1_usize;
    }

    // Check if eligible for a dense O(1) PIE-safe Jump Table (>= 5 cases, range <= 256, density >= 50%)
    var use_jt = false;
    var min_v: i64 = 0_i64;
    var max_v: i64 = 0_i64;
    var range_u: u64 = 0_u64;
    if targets.len >= 5_usize {
        var all_i64 = true;
        min_v = targets[0_usize].val.lo.bitcast.[i64]();
        max_v = min_v;
        ti = 0_usize;
        while ti < targets.len {
            let iv = targets[ti].val;
            let v64 = iv.lo.bitcast.[i64]();
            if iv.hi != 0_i64 && iv.hi != -1_i64 {
                all_i64 = false;
                break;
            }
            if v64 < min_v { min_v = v64; }
            if v64 > max_v { max_v = v64; }
            ti = ti +% 1_usize;
        }
        if all_i64 && fits_i32(min_v) && max_v >= min_v {
            let diff = max_v.bitcast.[u64]() -% min_v.bitcast.[u64]();
            if diff < 256_u64 {
                range_u = diff +% 1_u64;
                if range_u <= (targets.len.widen.[u64]() *% 2_u64) {
                    use_jt = true;
                }
            }
        }
    }

    let tm_ro = targ_mbbs.as_slice();
    if use_jt {
        let range_sz = range_u.trunc.[usize]();
        let jt_id = try build_switch_jump_table(alloc, ctx, mf, interner, targets, tm_ro, def_mbb, min_v, range_sz);

        var idx_v = discr;
        if min_v != 0_i64 {
            idx_v = try mf.new_vreg(alloc, .Gpr);
            try emit_alu_ri(alloc, mf, .SubImm, idx_v, discr, min_v, sp);
        }
        let b_jt = try mf.add_block(alloc, ctx.cur_depth);
        try emit_cmp_ri(alloc, mf, idx_v, range_u.trunc.[i32](), sp);
        try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, def_mbb, sp));
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_jt, sp));
        mf.end_block_insts(ctx.cur_mbb);

        mf.begin_block_insts(b_jt);
        var jti = mach_ir.inst_empty(.JmpTable, sp);
        jti.src0 = idx_v;
        jti.imm = jt_id.widen.[i64]();
        try mf.emit_inst(alloc, jti);
        mf.end_block_insts(b_jt);
    } else {
        // Linear compare chain (each step is a clean pure MachBlock!)
        ti = 0_usize;
        while ti < targets.len && ti < tm_ro.len {
            let cv = targets[ti].val.lo;
            if fits_i32(cv.bitcast.[i64]()) {
                try emit_cmp_ri(alloc, mf, discr, cv.bitcast.[i64]().trunc.[i32](), sp);
            } else {
                let c_reg = try emit_imm_vreg(alloc, mf, cv, sp);
                try emit_cmp_rr(alloc, mf, discr, c_reg, sp);
            }
            if ti +% 1_usize < targets.len {
                let b_next = try mf.add_block(alloc, ctx.cur_depth);
                try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, tm_ro[ti], sp));
                try mf.emit_inst(alloc, mach_ir.inst_jmp(b_next, sp));
                mf.end_block_insts(ctx.cur_mbb);
                mf.begin_block_insts(b_next);
                ctx.cur_mbb = b_next;
            } else {
                try mf.emit_inst(alloc, mach_ir.inst_jcc(.E, tm_ro[ti], sp));
                try mf.emit_inst(alloc, mach_ir.inst_jmp(def_mbb, sp));
                mf.end_block_insts(ctx.cur_mbb);
            }
            ti = ti +% 1_usize;
        }
        if targets.len == 0_usize {
            try mf.emit_inst(alloc, mach_ir.inst_jmp(def_mbb, sp));
            mf.end_block_insts(ctx.cur_mbb);
        }
    }

    // Emit any allocated phi trampolines!
    let tr_ro = targ_is_tramp.as_slice();
    ti = 0_usize;
    while ti < targets.len && ti < tm_ro.len && ti < tr_ro.len {
        if tr_ro[ti] != 0_u8 {
            mf.begin_block_insts(tm_ro[ti]);
            ctx.cur_mbb = tm_ro[ti];
            try emit_phi_edge(alloc, ctx, mf, eir_prog, env, bb, targets[ti].target, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(ctx_mbb_for_eir(ctx, targets[ti].target), sp));
            mf.end_block_insts(ctx.cur_mbb);
        }
        ti = ti +% 1_usize;
    }
    if def_needs_phi {
        mf.begin_block_insts(def_mbb);
        ctx.cur_mbb = def_mbb;
        try emit_phi_edge(alloc, ctx, mf, eir_prog, env, bb, def_bb, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jmp(ctx_mbb_for_eir(ctx, def_bb), sp));
        mf.end_block_insts(ctx.cur_mbb);
    }

    targ_is_tramp.destroy(alloc);
    targ_mbbs.destroy(alloc);
    return;
}

fn emit_eir_inst(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    inst_gid: u32,
    inst: *eir.EirInst,
) -> !OutOfMemory {
    let dv = eir.inst_def(inst);
    if dv != eir.EIR_NONE && ctx_should_skip(ctx, dv) {
        return;
    }
    let sp = inst.span;
    match inst.kind {
        .Const => {
            try emit_const_inst(alloc, ctx, mf, eir_prog, env, ct, interner, inst.dst, inst.aux0, inst.ty0, sp);
        }
        .Copy => {
            try emit_copy_val_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, inst.v0, sp);
        }
        .LoadSlot => {
            let soff = ctx_slot_off(ctx, inst.aux0);
            let ty = eir_prog.fn_val_ty(ctx.fn_id, inst.dst);
            try load_val_from_mem(alloc, ctx, mf, eir_prog, env, inst.dst, mach_ir.mem_stack_slot(soff), ty, sp);
        }
        .StoreSlot => {
            let soff = ctx_slot_off(ctx, inst.aux0);
            let ty = eir_prog.fn_val_ty(ctx.fn_id, inst.v0);
            if ctx_should_skip(ctx, inst.v0) {
                try emit_memzero(alloc, mf, mach_ir.mem_stack_slot(soff), env.x64_layout(ty).size, sp);
            } else {
                try store_val_to_mem(alloc, ctx, mf, eir_prog, env, mach_ir.mem_stack_slot(soff), inst.v0, ty, sp);
            }
            _ = 0_u8;
        }
        .SlotAddr => {
            let soff = ctx_slot_off(ctx, inst.aux0);
            let r = try mf.new_vreg(alloc, .Gpr);
            try mf.emit_inst(alloc, mach_ir.inst_lea(r, mach_ir.mem_stack_slot(soff), sp));
            try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, r, sp);
        }
        .LoadPlace => {
            try emit_load_place(alloc, ctx, mf, eir_prog, env, inst.dst, inst.aux0, sp);
        }
        .StorePlace => {
            try emit_store_place(alloc, ctx, mf, eir_prog, env, inst.aux0, inst.v0, sp);
        }
        .PlaceAddr => {
            if let place = eir_prog.get_place(inst.aux0) {
                let pm = try compute_place_mem(alloc, ctx, mf, eir_prog, env, place, place.projs.len.widen.[usize](), sp);
                let addr = try materialize_mem_to_vreg(alloc, mf, pm.mem, sp);
                try store_gpr_to_val(alloc, ctx, mf, eir_prog, env, inst.dst, addr, sp);
            }
        }
        .PoolColumnLoad => {
            try emit_pool_col_load(alloc, ctx, mf, eir_prog, env, inst.dst, inst.aux0, sp);
        }
        .PoolColumnStore => {
            try emit_pool_col_store(alloc, ctx, mf, eir_prog, env, inst.aux0, inst.v0, sp);
        }
        .Unary => {
            try emit_unary_inst(alloc, ctx, mf, eir_prog, env, inst.dst, inst.unary_op, inst.v0, inst.ty0, sp);
        }
        .Binary => {
            try emit_binary_inst(alloc, ctx, mf, eir_prog, env, inst_gid, inst.dst, inst.bin_op, inst.v0, inst.v1, inst.ty0, inst.ty1, sp);
        }
        .Cast => {
            try emit_cast_inst(alloc, ctx, mf, eir_prog, env, inst.dst, inst.cast_kind, inst.v0, inst.ty1, inst.ty0, sp);
        }
        .Slice => {
            try emit_slice_inst(alloc, ctx, mf, eir_prog, env, inst.dst, inst.v0, inst.v1, inst.v2, inst.ty1, sp);
        }
        .Aggregate => {
            try emit_aggregate_inst(alloc, ctx, mf, eir_prog, env, inst.dst, inst.aux0, inst.range, inst.ty0, sp);
        }
        .Call => {
            try emit_call_inst(alloc, ctx, mf, eir_prog, env, interner, inst.dst, inst.aux0, sp);
        }
        .BuiltinCall => {
            try emit_builtin_call_inst(alloc, ctx, mf, eir_prog, env, interner, inst_gid, inst.dst, inst.aux0, sp);
        }
        .ParForHint => {}
        .VecLoad => {
            let base_ptr = if inst.flag0 {
                try load_val_gpr(alloc, ctx, mf, eir_prog, env, inst.v0, false, sp)
            } else {
                (try load_slice_pair(alloc, ctx, mf, inst.v0, sp)).lo
            };
            let idx_g = try load_val_gpr(alloc, ctx, mf, eir_prog, env, inst.v1, false, sp);
            let esz = env.x64_layout(inst.ty1).size;
            let vsz = env.x64_layout(inst.ty0).size;
            let is_256 = vsz == 32_usize;
            var mem = mach_ir.mem_sib(base_ptr, idx_g, 1_u8, 0_i32);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                mem = mach_ir.mem_sib(base_ptr, idx_g, esz.trunc.[u8](), 0_i32);
            } else {
                let sc = try emit_imm_vreg(alloc, mf, esz.widen.[u64](), sp);
                let off = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_rr(alloc, mf, .Mul, off, idx_g, sc, sp);
                mem = mach_ir.mem_sib(base_ptr, off, 1_u8, 0_i32);
            }
            let vdst = try mf.new_vreg(alloc, if is_256 { .Vec256 } else { .Vec128 });
            var ld = mach_ir.inst_empty(.VMovUpsLoad, sp);
            ld.dst = vdst;
            ld.mem = mem;
            ld.flag0 = is_256;
            ld.size_bytes = if is_256 { 32_u8 } else { 16_u8 };
            try mf.emit_inst(alloc, ld);
            try store_vec_to_val(alloc, ctx, mf, inst.dst, vdst, is_256, sp);
        }
        .VecStore => {
            let base_ptr = if inst.flag0 {
                try load_val_gpr(alloc, ctx, mf, eir_prog, env, inst.v0, false, sp)
            } else {
                (try load_slice_pair(alloc, ctx, mf, inst.v0, sp)).lo
            };
            let idx_g = try load_val_gpr(alloc, ctx, mf, eir_prog, env, inst.v1, false, sp);
            let esz = env.x64_layout(inst.ty1).size;
            let vsz = env.x64_layout(inst.ty0).size;
            let is_256 = vsz == 32_usize;
            let sv = try load_val_vec(alloc, ctx, mf, inst.v2, is_256, sp);
            var mem = mach_ir.mem_sib(base_ptr, idx_g, 1_u8, 0_i32);
            if esz == 1_usize || esz == 2_usize || esz == 4_usize || esz == 8_usize {
                mem = mach_ir.mem_sib(base_ptr, idx_g, esz.trunc.[u8](), 0_i32);
            } else {
                let sc = try emit_imm_vreg(alloc, mf, esz.widen.[u64](), sp);
                let off = try mf.new_vreg(alloc, .Gpr);
                try emit_alu_rr(alloc, mf, .Mul, off, idx_g, sc, sp);
                mem = mach_ir.mem_sib(base_ptr, off, 1_u8, 0_i32);
            }
            var st = mach_ir.inst_empty(.VMovUpsStore, sp);
            st.src0 = sv;
            st.mem = mem;
            st.flag0 = is_256;
            st.size_bytes = if is_256 { 32_u8 } else { 16_u8 };
            try mf.emit_inst(alloc, st);
        }
        .VecFma => {
            let vn = env.get(inst.ty0);
            let vsz = env.x64_layout(inst.ty0).size;
            let is_256 = vsz == 32_usize;
            let is_f64 = env.get(vn.primary).kind == .Float && env.get(vn.primary).u8_val == 64_u8;
            let va = try load_val_vec(alloc, ctx, mf, inst.v0, is_256, sp);
            let vb = try load_val_vec(alloc, ctx, mf, inst.v1, is_256, sp);
            let vc = try load_val_vec(alloc, ctx, mf, inst.v2, is_256, sp);
            if ctx.cfg.target_avx2 {
                let res = try mf.new_vreg(alloc, if is_256 { .Vec256 } else { .Vec128 });
                var fma = mach_ir.inst_empty(if is_f64 { .VFmadd231PD } else { .VFmadd231PS }, sp);
                fma.dst = res;
                fma.src0 = vc;
                fma.src1 = va;
                fma.src2 = vb;
                fma.tied_src0 = true;
                fma.flag0 = is_256;
                fma.size_bytes = if is_256 { 32_u8 } else { 16_u8 };
                try mf.emit_inst(alloc, fma);
                try store_vec_to_val(alloc, ctx, mf, inst.dst, res, is_256, sp);
            } else {
                let prod = try mf.new_vreg(alloc, if is_256 { .Vec256 } else { .Vec128 });
                var mul_i = mach_ir.inst_empty(if is_f64 { .VMulPD } else { .VMulPS }, sp);
                mul_i.dst = prod;
                mul_i.src0 = va;
                mul_i.src1 = vb;
                mul_i.flag0 = is_256;
                mul_i.size_bytes = if is_256 { 32_u8 } else { 16_u8 };
                try mf.emit_inst(alloc, mul_i);
                let sum = try mf.new_vreg(alloc, if is_256 { .Vec256 } else { .Vec128 });
                var add_i = mach_ir.inst_empty(if is_f64 { .VAddPD } else { .VAddPS }, sp);
                add_i.dst = sum;
                add_i.src0 = prod;
                add_i.src1 = vc;
                add_i.flag0 = is_256;
                add_i.size_bytes = if is_256 { 32_u8 } else { 16_u8 };
                try mf.emit_inst(alloc, add_i);
                try store_vec_to_val(alloc, ctx, mf, inst.dst, sum, is_256, sp);
            }
        }
        _ => {
            try emit_unwrap_and_extract(alloc, ctx, mf, eir_prog, env, interner, inst);
        }
    }
    return;
}

/// Branchless `Cmov` if-conversion for empty-arm integer comparison diamonds (`min`/`max`/`select`):
///   Branch(int_cmp, then_bb, else_bb) where 1 or both arms are empty `Goto(join_bb)`
///   and `join_bb` has 1..2 GPR-only Phis -> `cmp; cmovcc; ParallelCopy; jmp join_bb`!
fn try_emit_cmov_diamond(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    bb: eir.BlockId,
    cond_v: eir.EirValue,
    then_bb: eir.BlockId,
    else_bb: eir.BlockId,
    sp: span.Span,
) -> bool ! OutOfMemory {
    if !ctx_should_skip(ctx, cond_v) {
        return false;
    }
    if find_avx2_redirect(ctx, bb, then_bb) != eir.EIR_NONE || find_avx2_redirect(ctx, bb, else_bb) != eir.EIR_NONE {
        return false;
    }
    let gid = ctx_def_inst_gid(ctx, cond_v);
    let all_insts = eir_prog.funcs.insts.as_slice();
    if gid == eir.EIR_NONE || gid.widen.[usize]() >= all_insts.len {
        return false;
    }
    let ci = all_insts[gid.widen.[usize]()];
    if ci.kind != .Binary {
        return false;
    }
    let op = ci.bin_op;
    if op != .Eq && op != .NotEq && op != .Lt && op != .LtEq && op != .Gt && op != .GtEq {
        return false;
    }
    let tn = env.get(ci.ty1);
    if tn.kind == .Float || tn.kind == .Vec || env.x64_layout(ci.ty1).size > 8_usize {
        return false;
    }

    // Check if `(then_bb, else_bb)` forms an empty-arm diamond into `join_bb`
    var join_bb = eir.EIR_NONE;
    var then_pred = eir.EIR_NONE;
    var else_pred = eir.EIR_NONE;
    var then_empty_to = eir.EIR_NONE;
    var else_empty_to = eir.EIR_NONE;
    if let tb = eir_prog.fn_block(ctx.fn_id, then_bb) {
        if tb.phis.len == 0_u32 && tb.insts.len == 0_u32 && tb.term.kind == .Goto {
            then_empty_to = tb.term.bb0;
        }
    }
    if let eb = eir_prog.fn_block(ctx.fn_id, else_bb) {
        if eb.phis.len == 0_u32 && eb.insts.len == 0_u32 && eb.term.kind == .Goto {
            else_empty_to = eb.term.bb0;
        }
    }
    if then_empty_to == else_bb && else_bb != eir.EIR_NONE {
        join_bb = else_bb;
        then_pred = then_bb;
        else_pred = bb;
    } else if else_empty_to == then_bb && then_bb != eir.EIR_NONE {
        join_bb = then_bb;
        then_pred = bb;
        else_pred = else_bb;
    } else if then_empty_to != eir.EIR_NONE && then_empty_to == else_empty_to && then_bb != else_bb {
        join_bb = then_empty_to;
        then_pred = then_bb;
        else_pred = else_bb;
    } else {
        return false;
    }
    if join_bb == bb || find_avx2_redirect(ctx, bb, join_bb) != eir.EIR_NONE {
        return false;
    }

    let phis = eir_prog.block_phis(ctx.fn_id, join_bb);
    if phis.len == 0_usize || phis.len > 2_usize {
        return false;
    }
    var dst_vregs: [2]mach_ir.VReg = [mach_ir.VREG_NONE; 2];
    var t_vals: [2]eir.EirValue = [eir.EIR_NONE; 2];
    var e_vals: [2]eir.EirValue = [eir.EIR_NONE; 2];
    var pi: usize = 0_usize;
    while pi < phis.len && pi < 2_usize {
        let ph = phis[pi];
        let dl = ctx_val_loc(ctx, ph.dst);
        if dl.kind != .Gpr {
            return false;
        }
        let incs = eir_prog.phi_incoming(ph.incoming);
        var tv = eir.EIR_NONE;
        var ev = eir.EIR_NONE;
        var ii: usize = 0_usize;
        while ii < incs.len {
            if incs[ii].pred_bb == then_pred { tv = incs[ii].val; }
            if incs[ii].pred_bb == else_pred { ev = incs[ii].val; }
            ii = ii +% 1_usize;
        }
        if tv == eir.EIR_NONE || ev == eir.EIR_NONE {
            return false;
        }
        dst_vregs[pi] = dl.vreg0;
        t_vals[pi] = tv;
        e_vals[pi] = ev;
        pi = pi +% 1_usize;
    }

    // Load all candidate phi values BEFORE setting CPU flags!
    var t_regs: [2]mach_ir.VReg = [mach_ir.VREG_NONE; 2];
    var e_regs: [2]mach_ir.VReg = [mach_ir.VREG_NONE; 2];
    pi = 0_usize;
    while pi < phis.len && pi < 2_usize {
        t_regs[pi] = try load_val_gpr(alloc, ctx, mf, eir_prog, env, t_vals[pi], false, sp);
        e_regs[pi] = try load_val_gpr(alloc, ctx, mf, eir_prog, env, e_vals[pi], false, sp);
        pi = pi +% 1_usize;
    }

    // Emit the integer compare (identical to `emit_branch_to_targets`)
    let signed = env.is_signed_int(ci.ty1);
    let lv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, ci.v0, true, sp);
    if ctx_is_const_int(ctx, ci.v1) && fits_i32(ctx_const_int(ctx, ci.v1).bitcast.[i64]()) {
        let imm = ctx_const_int(ctx, ci.v1).bitcast.[i64]().trunc.[i32]();
        if imm == 0_i32 && (op == .Eq || op == .NotEq) {
            try emit_test_rr(alloc, mf, lv, lv, false, sp);
        } else {
            try emit_cmp_ri(alloc, mf, lv, imm, sp);
        }
    } else {
        let rv = try load_val_gpr(alloc, ctx, mf, eir_prog, env, ci.v1, true, sp);
        try emit_cmp_rr(alloc, mf, lv, rv, sp);
    }
    let cc: x64_asm.Cond = match op {
        .Eq => { .E }
        .NotEq => { .Ne }
        .Lt => { if signed { .L } else { .B } }
        .LtEq => { if signed { .Le } else { .Be } }
        .Gt => { if signed { .G } else { .A } }
        _ => { if signed { .Ge } else { .Ae } }
    };

    var res_regs: [2]mach_ir.VReg = [mach_ir.VREG_NONE; 2];
    pi = 0_usize;
    while pi < phis.len && pi < 2_usize {
        if t_vals[pi] == e_vals[pi] {
            res_regs[pi] = e_regs[pi];
        } else {
            let tmp = try mf.new_vreg(alloc, .Gpr);
            try emit_cmov(alloc, mf, cc, tmp, e_regs[pi], t_regs[pi], sp);
            res_regs[pi] = tmp;
        }
        pi = pi +% 1_usize;
    }

    let pstart = mf.pcopy_pairs.len().trunc.[u32]();
    var pcnt: u32 = 0_u32;
    pi = 0_usize;
    while pi < phis.len && pi < 2_usize {
        try mf.add_pcopy_pair(alloc, dst_vregs[pi], res_regs[pi]);
        pcnt = pcnt +% 1_u32;
        pi = pi +% 1_usize;
    }
    if pcnt > 0_u32 {
        try mf.emit_parallel_copy(alloc, pstart, pcnt, sp);
    }
    try mf.emit_inst(alloc, mach_ir.inst_jmp(ctx_mbb_for_eir(ctx, join_bb), sp));
    mf.end_block_insts(ctx.cur_mbb);
    return true;
}

fn emit_eir_term(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    bb: eir.BlockId,
    term: *eir.EirTerm,
) -> !OutOfMemory {
    let sp = term.span;
    match term.kind {
        .Goto => {
            let redir = find_avx2_redirect(ctx, bb, term.bb0);
            if redir != eir.EIR_NONE {
                try mf.emit_inst(alloc, mach_ir.inst_jmp(redir, sp));
                mf.end_block_insts(ctx.cur_mbb);
                return;
            }
            try emit_phi_edge(alloc, ctx, mf, eir_prog, env, bb, term.bb0, sp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(ctx_mbb_for_eir(ctx, term.bb0), sp));
            mf.end_block_insts(ctx.cur_mbb);
        }
        .Branch => {
            let then_bb = term.bb0;
            let else_bb = term.bb1;
            let did_cmov = try try_emit_cmov_diamond(alloc, ctx, mf, eir_prog, env, bb, term.val, then_bb, else_bb, sp);
            if did_cmov {
                return;
            }
            let then_redir = find_avx2_redirect(ctx, bb, then_bb);
            let else_redir = find_avx2_redirect(ctx, bb, else_bb);
            let then_needs_phi = then_redir == eir.EIR_NONE && block_has_phi_for_pred(eir_prog, ctx.fn_id, bb, then_bb);
            let else_needs_phi = else_redir == eir.EIR_NONE && block_has_phi_for_pred(eir_prog, ctx.fn_id, bb, else_bb);

            let then_mbb = if then_redir != eir.EIR_NONE {
                then_redir
            } else if then_needs_phi {
                let tm = ctx_mbb_for_eir(ctx, then_bb);
                try mf.add_block(alloc, mbb_min_depth(mf, tm, ctx.cur_depth))
            } else {
                ctx_mbb_for_eir(ctx, then_bb)
            };
            let else_mbb = if else_redir != eir.EIR_NONE {
                else_redir
            } else if else_needs_phi {
                let em = ctx_mbb_for_eir(ctx, else_bb);
                try mf.add_block(alloc, mbb_min_depth(mf, em, ctx.cur_depth))
            } else {
                ctx_mbb_for_eir(ctx, else_bb)
            };

            try emit_branch_to_targets(alloc, ctx, mf, eir_prog, env, interner, term.val, then_mbb, else_mbb, sp);

            if then_needs_phi {
                mf.begin_block_insts(then_mbb);
                ctx.cur_mbb = then_mbb;
                try emit_phi_edge(alloc, ctx, mf, eir_prog, env, bb, then_bb, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jmp(ctx_mbb_for_eir(ctx, then_bb), sp));
                mf.end_block_insts(ctx.cur_mbb);
            }
            if else_needs_phi {
                mf.begin_block_insts(else_mbb);
                ctx.cur_mbb = else_mbb;
                try emit_phi_edge(alloc, ctx, mf, eir_prog, env, bb, else_bb, sp);
                try mf.emit_inst(alloc, mach_ir.inst_jmp(ctx_mbb_for_eir(ctx, else_bb), sp));
                mf.end_block_insts(ctx.cur_mbb);
            }
        }
        .SwitchInt => {
            try emit_switch_term(alloc, ctx, mf, eir_prog, env, interner, bb, term);
        }
        .Return => {
            try emit_return_term(alloc, ctx, mf, eir_prog, env, term.flag, term.val, sp);
            mf.end_block_insts(ctx.cur_mbb);
        }
        .Unreachable => {
            try mf.emit_inst(alloc, mach_ir.inst_empty(.Ud2, sp));
            mf.end_block_insts(ctx.cur_mbb);
        }
    }
    return;
}

// ===========================================================================
// Public Entry Point: `lower_fn_to_mach_ir`
// ===========================================================================

/// Widens tight `f32x4` slice FMA loops (`while j < len { c[j] = aik.fma(b[j], c[j]); j += 1; }`)
/// into a 256-bit AVX2 YMM 2x-unrolled pre-loop (16 floats / 64 bytes per iter, exact same 2-rounding
/// `VMulPS + VAddPS` semantics, with runtime non-overlap guard & scalar tail handoff!).
fn try_emit_avx2_vec_fma_loop(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    hdr_bb: eir.BlockId,
    sp: span.Span,
) -> !OutOfMemory {
    let hblk = eir_prog.fn_block(ctx.fn_id, hdr_bb) orelse { return; };
    let hphis = eir_prog.phis_slice(hblk.phis);
    let hpreds = eir_prog.preds_slice(hblk.preds);
    if hphis.len != 1_usize || hpreds.len != 2_usize || hblk.term.kind != .Branch {
        return;
    }
    var pre_bb = eir.EIR_NONE;
    var latch_bb = eir.EIR_NONE;
    if eir_prog.dominates_block(ctx.fn_id, hdr_bb, hpreds[0_usize]) && !eir_prog.dominates_block(ctx.fn_id, hdr_bb, hpreds[1_usize]) {
        latch_bb = hpreds[0_usize];
        pre_bb = hpreds[1_usize];
    } else if eir_prog.dominates_block(ctx.fn_id, hdr_bb, hpreds[1_usize]) && !eir_prog.dominates_block(ctx.fn_id, hdr_bb, hpreds[0_usize]) {
        latch_bb = hpreds[1_usize];
        pre_bb = hpreds[0_usize];
    } else {
        return;
    }
    let ind_phi = hphis[0_usize];
    let ind_val = ind_phi.dst;
    if env.x64_layout(ind_phi.ty).size != 8_usize || env.get(ind_phi.ty).kind != .Int || env.is_signed_int(ind_phi.ty) {
        return;
    }
    let incs = eir_prog.phi_incoming(ind_phi.incoming);
    if incs.len != 2_usize {
        return;
    }
    var start_val = eir.EIR_NONE;
    var step_val = eir.EIR_NONE;
    if incs[0_usize].pred_bb == pre_bb {
        start_val = incs[0_usize].val;
        step_val = incs[1_usize].val;
    } else if incs[1_usize].pred_bb == pre_bb {
        start_val = incs[1_usize].val;
        step_val = incs[0_usize].val;
    } else {
        return;
    }
    let all_insts = eir_prog.funcs.insts.as_slice();
    let cond_gid = ctx_def_inst_gid(ctx, hblk.term.val);
    if cond_gid == eir.EIR_NONE || cond_gid.widen.[usize]() >= all_insts.len {
        return;
    }
    let cond_i = all_insts[cond_gid.widen.[usize]()];
    if cond_i.kind != .Binary || cond_i.bin_op != .Lt || cond_i.v0 != ind_val {
        return;
    }
    let bound_val = cond_i.v1;
    let body_bb = hblk.term.bb0;
    let exit_bb = hblk.term.bb1;
    if body_bb != latch_bb || body_bb == hdr_bb || body_bb == exit_bb {
        return;
    }
    // Check `bound_val` defined outside loop
    if bound_val != eir.EIR_NONE {
        let bdef = ctx_def_bb(ctx, bound_val);
        if bdef != eir.EIR_NONE && eir_prog.dominates_block(ctx.fn_id, hdr_bb, bdef) {
            return;
        }
    }
    // Check `step_val == ind_val + 1`
    let step_gid = ctx_def_inst_gid(ctx, step_val);
    if step_gid == eir.EIR_NONE || step_gid.widen.[usize]() >= all_insts.len {
        return;
    }
    let step_i = all_insts[step_gid.widen.[usize]()];
    if step_i.kind != .Binary || (step_i.bin_op != .Add && step_i.bin_op != .AddWrap) {
        return;
    }
    let step_ok = (step_i.v0 == ind_val && ctx_is_const_int(ctx, step_i.v1) && ctx_const_int(ctx, step_i.v1) == 1_u64)
        || (step_i.v1 == ind_val && ctx_is_const_int(ctx, step_i.v0) && ctx_const_int(ctx, step_i.v0) == 1_u64);
    if !step_ok {
        return;
    }
    // Ensure pre_bb/hdr_bb not already claimed
    let ex_loops = ctx.avx2_loops.as_slice();
    var li: usize = 0_usize;
    while li < ex_loops.len {
        if ex_loops[li].pre_bb == pre_bb || ex_loops[li].hdr_bb == hdr_bb {
            return;
        }
        li = li +% 1_usize;
    }

    // Body must be single block ending in Goto(hdr_bb), containing ONLY:
    //   b_v = LoadPlace(b_slice, [Index(ind_val)])   (f32x4)
    //   c_v = LoadPlace(c_slice, [Index(ind_val)])   (f32x4)
    //   res = BuiltinCall(.VecFma, [aik, b_v, c_v])  (aik loop-invariant f32x4)
    //   StorePlace(c_slice, [Index(ind_val)], res)
    //   step_val = ind_val + 1
    let bblk = eir_prog.fn_block(ctx.fn_id, body_bb) orelse { return; };
    if bblk.phis.len != 0_u32 || bblk.term.kind != .Goto || bblk.term.bb0 != hdr_bb {
        return;
    }
    let binsts = eir_prog.insts_slice(bblk.insts);
    var ld0_val = eir.EIR_NONE;
    var ld0_slice = eir.EIR_NONE;
    var ld1_val = eir.EIR_NONE;
    var ld1_slice = eir.EIR_NONE;
    var fma_dst = eir.EIR_NONE;
    var fma_a = eir.EIR_NONE;
    var fma_b = eir.EIR_NONE;
    var fma_c = eir.EIR_NONE;
    var st_slice = eir.EIR_NONE;
    var st_val = eir.EIR_NONE;
    var n_loads: usize = 0_usize;
    var n_fmas: usize = 0_usize;
    var n_stores: usize = 0_usize;

    var ii: usize = 0_usize;
    while ii < binsts.len {
        let inst = binsts[ii];
        match inst.kind {
            .Const => {
                if !ctx_is_const_int(ctx, inst.dst) { return; }
            }
            .Binary => {
                if inst.dst != step_val { return; }
            }
            .LoadPlace => {
                let pl = eir_prog.get_place(inst.aux0) orelse { return; };
                if pl.base.kind != .Val { return; }
                let bty = eir_prog.fn_val_ty(ctx.fn_id, pl.base.id);
                if !is_slice_or_str_ty(bty, env) { return; }
                let ps = eir_prog.projs_slice(pl.projs);
                if ps.len != 1_usize || ps[0_usize].kind != .Index || ps[0_usize].index != ind_val { return; }
                let vn = env.get(pl.ty);
                if vn.kind != .Vec || vn.u8_val != 4_u8 || !avx2_is_f32_ty(env, vn.primary) { return; }
                if n_loads == 0_usize {
                    ld0_val = inst.dst;
                    ld0_slice = pl.base.id;
                } else if n_loads == 1_usize {
                    ld1_val = inst.dst;
                    ld1_slice = pl.base.id;
                } else {
                    return;
                }
                n_loads = n_loads +% 1_usize;
            }
            .BuiltinCall => {
                let bc = eir_prog.get_builtin_call(inst.aux0) orelse { return; };
                if bc.op.kind != .VecFma { return; }
                let vn = env.get(bc.op.ty0);
                if vn.kind != .Vec || vn.u8_val != 4_u8 || !avx2_is_f32_ty(env, vn.primary) { return; }
                let args = eir_prog.vals_slice(bc.args);
                if args.len != 3_usize || n_fmas != 0_usize { return; }
                fma_dst = inst.dst;
                fma_a = args[0_usize];
                fma_b = args[1_usize];
                fma_c = args[2_usize];
                n_fmas = 1_usize;
            }
            .StorePlace => {
                let pl = eir_prog.get_place(inst.aux0) orelse { return; };
                if pl.base.kind != .Val { return; }
                let bty = eir_prog.fn_val_ty(ctx.fn_id, pl.base.id);
                if !is_slice_or_str_ty(bty, env) { return; }
                let ps = eir_prog.projs_slice(pl.projs);
                if ps.len != 1_usize || ps[0_usize].kind != .Index || ps[0_usize].index != ind_val { return; }
                let vn = env.get(pl.ty);
                if vn.kind != .Vec || vn.u8_val != 4_u8 || !avx2_is_f32_ty(env, vn.primary) { return; }
                if n_stores != 0_usize { return; }
                st_slice = pl.base.id;
                st_val = inst.v0;
                n_stores = 1_usize;
            }
            _ => { return; }
        }
        ii = ii +% 1_usize;
    }

    if n_loads != 2_usize || n_fmas != 1_usize || n_stores != 1_usize || st_val != fma_dst {
        return;
    }
    // Identify which load is `c_slice` (`st_slice`) and which is `b_slice`, and which FMA arg is invariant `aik`!
    var b_slice = eir.EIR_NONE;
    var c_load_v = eir.EIR_NONE;
    var b_load_v = eir.EIR_NONE;
    if ld0_slice == st_slice && ld1_slice != st_slice {
        c_load_v = ld0_val;
        b_load_v = ld1_val;
        b_slice = ld1_slice;
    } else if ld1_slice == st_slice && ld0_slice != st_slice {
        c_load_v = ld1_val;
        b_load_v = ld0_val;
        b_slice = ld0_slice;
    } else {
        return;
    }
    if fma_c != c_load_v {
        return;
    }
    var aik_v = eir.EIR_NONE;
    if fma_b == b_load_v {
        aik_v = fma_a;
    } else if fma_a == b_load_v {
        aik_v = fma_b;
    } else {
        return;
    }
    // Verify `aik_v`, `b_slice`, `st_slice` are defined outside the loop and `ld0_val`/`ld1_val`/`fma_dst` only used inside
    let adef = ctx_def_bb(ctx, aik_v);
    let bdef = ctx_def_bb(ctx, b_slice);
    let cdef = ctx_def_bb(ctx, st_slice);
    if (adef != eir.EIR_NONE && eir_prog.dominates_block(ctx.fn_id, hdr_bb, adef))
        || (bdef != eir.EIR_NONE && eir_prog.dominates_block(ctx.fn_id, hdr_bb, bdef))
        || (cdef != eir.EIR_NONE && eir_prog.dominates_block(ctx.fn_id, hdr_bb, cdef))
    {
        return;
    }
    if ctx_use_count(ctx, ld0_val) != 1_u32 || ctx_use_count(ctx, ld1_val) != 1_u32 || ctx_use_count(ctx, fma_dst) != 1_u32 {
        return;
    }

    // ---- Emit 256-bit YMM 4x-unrolled byte-stepped pre-loop (8 f32x4 = 32 floats = 128B per iteration!) ----
    let hdr_depth = eir_prog.block_depth(ctx.fn_id, hdr_bb);
    let body_depth = if hdr_depth > 0_u8 { hdr_depth } else { 1_u8 };
    let pre_depth = body_depth -% 1_u8;
    let v_pre = try mf.add_block(alloc, pre_depth);
    let b_chk_len = try mf.add_block(alloc, pre_depth);
    let b_chk_alias = try mf.add_block(alloc, pre_depth);
    let b_hoist = try mf.add_block(alloc, pre_depth);
    let v_hdr = try mf.add_block(alloc, body_depth);
    let v_body = try mf.add_block(alloc, body_depth);
    let v_exit_early = try mf.add_block(alloc, pre_depth);
    let v_exit = try mf.add_block(alloc, pre_depth);

    mf.begin_block_insts(v_pre);
    ctx.cur_mbb = v_pre;
    let start_is_zero = ctx_is_const_int(ctx, start_val) && ctx_const_int(ctx, start_val) == 0_u64;
    let v_start = try load_val_gpr(alloc, ctx, mf, eir_prog, env, start_val, true, sp);
    let v_bound = try load_val_gpr(alloc, ctx, mf, eir_prog, env, bound_val, true, sp);
    let b_pair = try load_slice_pair(alloc, ctx, mf, b_slice, sp);
    let c_pair = try load_slice_pair(alloc, ctx, mf, st_slice, sp);

    // Clamp effective bound against both slice lengths for 100% bounds safety
    var eff_bound = v_bound;
    if b_pair.hi != eff_bound {
        try emit_cmp_rr(alloc, mf, b_pair.hi, eff_bound, sp);
        let bnd1 = try mf.new_vreg(alloc, .Gpr);
        try emit_cmov(alloc, mf, .B, bnd1, eff_bound, b_pair.hi, sp);
        eff_bound = bnd1;
    }
    if c_pair.hi != eff_bound {
        try emit_cmp_rr(alloc, mf, c_pair.hi, eff_bound, sp);
        let bnd2 = try mf.new_vreg(alloc, .Gpr);
        try emit_cmov(alloc, mf, .B, bnd2, eff_bound, c_pair.hi, sp);
        eff_bound = bnd2;
    }

    if start_is_zero {
        try emit_cmp_ri(alloc, mf, eff_bound, 8_i32, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, v_exit_early, sp));
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_alias, sp));
        mf.end_block_insts(v_pre);

        mf.begin_block_insts(b_chk_len);
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_alias, sp));
        mf.end_block_insts(b_chk_len);
    } else {
        try emit_cmp_rr(alloc, mf, v_start, eff_bound, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, v_exit_early, sp));
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_len, sp));
        mf.end_block_insts(v_pre);

        mf.begin_block_insts(b_chk_len);
        let v_rem = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_rr(alloc, mf, .Sub, v_rem, eff_bound, v_start, sp);
        try emit_cmp_ri(alloc, mf, v_rem, 8_i32, sp);
        try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, v_exit_early, sp));
        try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_alias, sp));
        mf.end_block_insts(b_chk_len);
    }

    // Runtime non-overlap check: `c_ptr + eff_bound*16 <= b_ptr || b_ptr + eff_bound*16 <= c_ptr`
    mf.begin_block_insts(b_chk_alias);
    let b_chk_alias2 = try mf.add_block(alloc, pre_depth);
    let total_bytes = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, total_bytes, eff_bound, 4_i64, sp);
    let c_end_ptr = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, c_end_ptr, c_pair.lo, total_bytes, sp);
    try emit_cmp_rr(alloc, mf, c_end_ptr, b_pair.lo, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Be, b_hoist, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_alias2, sp));
    mf.end_block_insts(b_chk_alias);

    mf.begin_block_insts(b_chk_alias2);
    let b_end_ptr = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, b_end_ptr, b_pair.lo, total_bytes, sp);
    try emit_cmp_rr(alloc, mf, b_end_ptr, c_pair.lo, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Be, b_hoist, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(v_exit_early, sp));
    mf.end_block_insts(b_chk_alias2);

    // Hoist 256-bit `ymm_a` (1-cycle VBroadcastSS if VecSplat!) and byte offsets `(v_off_phi, v_off_limit)`
    mf.begin_block_insts(b_hoist);
    ctx.cur_mbb = b_hoist;
    let v_limit_idx = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .SubImm, v_limit_idx, eff_bound, 8_i64, sp);
    let v_off_limit = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, v_off_limit, v_limit_idx, 4_i64, sp);
    let v_off_init = if start_is_zero {
        try emit_imm_vreg(alloc, mf, 0_u64, sp)
    } else {
        let oi = try mf.new_vreg(alloc, .Gpr);
        try emit_alu_ri(alloc, mf, .ShlImm, oi, v_start, 4_i64, sp);
        oi
    };
    let v_off_phi = try mf.new_vreg(alloc, .Gpr);
    let p_init = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_off_phi, v_off_init);
    try mf.emit_parallel_copy(alloc, p_init, 1_u32, sp);

    let aik_x = try load_val_vec(alloc, ctx, mf, aik_v, false, sp);
    let aik_y = try mf.new_vreg(alloc, .Vec256);
    var is_splat_a = false;
    let agid_a = ctx_def_inst_gid(ctx, aik_v);
    if agid_a != eir.EIR_NONE && agid_a.widen.[usize]() < all_insts.len {
        let ai_a = all_insts[agid_a.widen.[usize]()];
        if ai_a.kind == .BuiltinCall {
            if let abc = eir_prog.get_builtin_call(ai_a.aux0) {
                if abc.op.kind == .VecSplat {
                    is_splat_a = true;
                }
            }
        }
    }
    if is_splat_a {
        var bca = mach_ir.inst_empty(.VBroadcastSS, sp);
        bca.dst = aik_y;
        bca.src0 = aik_x;
        bca.flag0 = true;
        bca.size_bytes = 32_u8;
        try mf.emit_inst(alloc, bca);
    } else {
        let sc = ensure_scratch_vec_off(ctx, mf);
        var sa0 = mach_ir.inst_empty(.VMovUpsStore, sp);
        sa0.src0 = aik_x; sa0.mem = mach_ir.mem_stack_slot(sc); sa0.size_bytes = 16_u8;
        try mf.emit_inst(alloc, sa0);
        var sa1 = mach_ir.inst_empty(.VMovUpsStore, sp);
        sa1.src0 = aik_x; sa1.mem = mach_ir.mem_stack_slot(sc +% 16_i32); sa1.size_bytes = 16_u8;
        try mf.emit_inst(alloc, sa1);
        var lay = mach_ir.inst_empty(.VMovUpsLoad, sp);
        lay.dst = aik_y; lay.mem = mach_ir.mem_stack_slot(sc); lay.flag0 = true; lay.size_bytes = 32_u8;
        try mf.emit_inst(alloc, lay);
    }

    try mf.emit_inst(alloc, mach_ir.inst_jmp(v_hdr, sp));
    mf.end_block_insts(b_hoist);

    mf.begin_block_insts(v_hdr);
    try emit_cmp_rr(alloc, mf, v_off_phi, v_off_limit, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, v_exit, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(v_body, sp));
    mf.end_block_insts(v_hdr);

    // 4x-unrolled 256-bit YMM hardware FMA3 memory-operand body: 32 f32s (128B) per iter (12 insns vs 20)!
    mf.begin_block_insts(v_body);
    let yc0 = try mf.new_vreg(alloc, .Vec256);
    var lc0 = mach_ir.inst_empty(.VMovUpsLoad, sp);
    lc0.dst = yc0; lc0.mem = mach_ir.mem_sib(c_pair.lo, v_off_phi, 1_u8, 0_i32); lc0.flag0 = true; lc0.size_bytes = 32_u8;
    try mf.emit_inst(alloc, lc0);

    let yc1 = try mf.new_vreg(alloc, .Vec256);
    var lc1 = mach_ir.inst_empty(.VMovUpsLoad, sp);
    lc1.dst = yc1; lc1.mem = mach_ir.mem_sib(c_pair.lo, v_off_phi, 1_u8, 32_i32); lc1.flag0 = true; lc1.size_bytes = 32_u8;
    try mf.emit_inst(alloc, lc1);

    let yc2 = try mf.new_vreg(alloc, .Vec256);
    var lc2 = mach_ir.inst_empty(.VMovUpsLoad, sp);
    lc2.dst = yc2; lc2.mem = mach_ir.mem_sib(c_pair.lo, v_off_phi, 1_u8, 64_i32); lc2.flag0 = true; lc2.size_bytes = 32_u8;
    try mf.emit_inst(alloc, lc2);

    let yc3 = try mf.new_vreg(alloc, .Vec256);
    var lc3 = mach_ir.inst_empty(.VMovUpsLoad, sp);
    lc3.dst = yc3; lc3.mem = mach_ir.mem_sib(c_pair.lo, v_off_phi, 1_u8, 96_i32); lc3.flag0 = true; lc3.size_bytes = 32_u8;
    try mf.emit_inst(alloc, lc3);

    let s0 = try mf.new_vreg(alloc, .Vec256);
    var fm0 = mach_ir.inst_empty(.VFmadd231PSMem, sp);
    fm0.dst = s0; fm0.src0 = yc0; fm0.src1 = aik_y; fm0.tied_src0 = true;
    fm0.mem = mach_ir.mem_sib(b_pair.lo, v_off_phi, 1_u8, 0_i32); fm0.flag0 = true; fm0.size_bytes = 32_u8;
    try mf.emit_inst(alloc, fm0);

    let s1 = try mf.new_vreg(alloc, .Vec256);
    var fm1 = mach_ir.inst_empty(.VFmadd231PSMem, sp);
    fm1.dst = s1; fm1.src0 = yc1; fm1.src1 = aik_y; fm1.tied_src0 = true;
    fm1.mem = mach_ir.mem_sib(b_pair.lo, v_off_phi, 1_u8, 32_i32); fm1.flag0 = true; fm1.size_bytes = 32_u8;
    try mf.emit_inst(alloc, fm1);

    let s2 = try mf.new_vreg(alloc, .Vec256);
    var fm2 = mach_ir.inst_empty(.VFmadd231PSMem, sp);
    fm2.dst = s2; fm2.src0 = yc2; fm2.src1 = aik_y; fm2.tied_src0 = true;
    fm2.mem = mach_ir.mem_sib(b_pair.lo, v_off_phi, 1_u8, 64_i32); fm2.flag0 = true; fm2.size_bytes = 32_u8;
    try mf.emit_inst(alloc, fm2);

    let s3 = try mf.new_vreg(alloc, .Vec256);
    var fm3 = mach_ir.inst_empty(.VFmadd231PSMem, sp);
    fm3.dst = s3; fm3.src0 = yc3; fm3.src1 = aik_y; fm3.tied_src0 = true;
    fm3.mem = mach_ir.mem_sib(b_pair.lo, v_off_phi, 1_u8, 96_i32); fm3.flag0 = true; fm3.size_bytes = 32_u8;
    try mf.emit_inst(alloc, fm3);

    var st0 = mach_ir.inst_empty(.VMovUpsStore, sp);
    st0.src0 = s0; st0.mem = mach_ir.mem_sib(c_pair.lo, v_off_phi, 1_u8, 0_i32); st0.flag0 = true; st0.size_bytes = 32_u8;
    try mf.emit_inst(alloc, st0);

    var st1 = mach_ir.inst_empty(.VMovUpsStore, sp);
    st1.src0 = s1; st1.mem = mach_ir.mem_sib(c_pair.lo, v_off_phi, 1_u8, 32_i32); st1.flag0 = true; st1.size_bytes = 32_u8;
    try mf.emit_inst(alloc, st1);

    var st2 = mach_ir.inst_empty(.VMovUpsStore, sp);
    st2.src0 = s2; st2.mem = mach_ir.mem_sib(c_pair.lo, v_off_phi, 1_u8, 64_i32); st2.flag0 = true; st2.size_bytes = 32_u8;
    try mf.emit_inst(alloc, st2);

    var st3 = mach_ir.inst_empty(.VMovUpsStore, sp);
    st3.src0 = s3; st3.mem = mach_ir.mem_sib(c_pair.lo, v_off_phi, 1_u8, 96_i32); st3.flag0 = true; st3.size_bytes = 32_u8;
    try mf.emit_inst(alloc, st3);

    let v_off_next = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .AddImm, v_off_next, v_off_phi, 128_i64, sp);
    let p_step = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_off_phi, v_off_next);
    try mf.emit_parallel_copy(alloc, p_step, 1_u32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(v_hdr, sp));
    mf.end_block_insts(v_body);

    // Early bailout: hand off original `v_start` untouched (100% overflow-safe!)
    let ind_loc = ctx_val_loc(ctx, ind_val);
    mf.begin_block_insts(v_exit_early);
    if ind_loc.kind == .Gpr {
        let p_ee = mf.pcopy_pairs.len().trunc.[u32]();
        try mf.add_pcopy_pair(alloc, ind_loc.vreg0, v_start);
        try mf.emit_parallel_copy(alloc, p_ee, 1_u32, sp);
    } else if ind_loc.kind == .Stack {
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(ind_loc.stack_off), v_start, 8_usize, sp);
    }
    try mf.emit_inst(alloc, mach_ir.inst_jmp(ctx_mbb_for_eir(ctx, hdr_bb), sp));
    mf.end_block_insts(v_exit_early);

    // Normal exit from vector loop: convert byte offset `v_off_phi >> 4` back to f32x4 index!
    mf.begin_block_insts(v_exit);
    let v_j_final = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShrImm, v_j_final, v_off_phi, 4_i64, sp);
    if ind_loc.kind == .Gpr {
        let p_ex = mf.pcopy_pairs.len().trunc.[u32]();
        try mf.add_pcopy_pair(alloc, ind_loc.vreg0, v_j_final);
        try mf.emit_parallel_copy(alloc, p_ex, 1_u32, sp);
    } else if ind_loc.kind == .Stack {
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(ind_loc.stack_off), v_j_final, 8_usize, sp);
    }
    try mf.emit_inst(alloc, mach_ir.inst_jmp(ctx_mbb_for_eir(ctx, hdr_bb), sp));
    mf.end_block_insts(v_exit);

    ctx.uses_avx2_loop = true;
    try ctx.avx2_loops.push(alloc, Avx2LoopEntry.{
        hdr_bb: hdr_bb,
        pre_bb: pre_bb,
        latch_bb: latch_bb,
        body_bb: body_bb,
        exit_bb: exit_bb,
        ind_val: ind_val,
        start_val: start_val,
        bound_val: bound_val,
        v_pre_mbb: v_pre,
    });
    return;
}

/// Checks if `v` is defined outside the loop rooted at `hdr_bb` (i.e. loop-invariant).
fn is_loop_inv_val(ctx: *IselCtx, eir_prog: *eir.EirProgram, hdr_bb: eir.BlockId, v: eir.EirValue) -> bool {
    if v == eir.EIR_NONE {
        return true;
    }
    let dbb = ctx_def_bb(ctx, v);
    if dbb == eir.EIR_NONE {
        return true;
    }
    return !eir_prog.dominates_block(ctx.fn_id, hdr_bb, dbb);
}

/// Matches `val == base + inv` or `inv + base` (`Add` or `AddWrap`) and returns `inv`.
fn match_add_with_base(all_insts: *[eir.EirInst], ctx: *IselCtx, val: eir.EirValue, base: eir.EirValue) -> eir.EirValue {
    let gid = ctx_def_inst_gid(ctx, val);
    if gid == eir.EIR_NONE || gid.widen.[usize]() >= all_insts.len {
        return eir.EIR_NONE;
    }
    let inst = all_insts[gid.widen.[usize]()];
    if inst.kind != .Binary || (inst.bin_op != .Add && inst.bin_op != .AddWrap) {
        return eir.EIR_NONE;
    }
    if inst.v0 == base {
        return inst.v1;
    }
    if inst.v1 == base {
        return inst.v0;
    }
    return eir.EIR_NONE;
}

/// Universal 2D Loop-Interchange + 8-YMM Register-Blocked Tile Optimizer for counted outer `k` loops
/// accumulating into a fixed `f32x4` slice `c_tile[0..len]` from row slices `b[k*stride + jb .. k*stride + j_end]`
/// scaled by `a_row[k]` (`c_tile[j] = fma(splat(a_row[k]), b_tile[j], c_tile[j])`).
/// Keeps `c_tile[j..j+64]` in `ymm0..ymm7` across all `k = kb..k_end` iterations with bit-exact IEEE-754 FMA order!
fn try_emit_avx2_2d_fma_tile_loop(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    outer_hdr: eir.BlockId,
    sp: span.Span,
) -> bool ! OutOfMemory {
    let hblk = eir_prog.fn_block(ctx.fn_id, outer_hdr) orelse { return false; };
    let hphis = eir_prog.phis_slice(hblk.phis);
    let hpreds = eir_prog.preds_slice(hblk.preds);
    if (hphis.len != 1_usize && hphis.len != 2_usize) || hpreds.len != 2_usize || hblk.term.kind != .Branch {
        return false;
    }
    var outer_pre = eir.EIR_NONE;
    var outer_latch = eir.EIR_NONE;
    if eir_prog.dominates_block(ctx.fn_id, outer_hdr, hpreds[0_usize]) && !eir_prog.dominates_block(ctx.fn_id, outer_hdr, hpreds[1_usize]) {
        outer_latch = hpreds[0_usize];
        outer_pre = hpreds[1_usize];
    } else if eir_prog.dominates_block(ctx.fn_id, outer_hdr, hpreds[1_usize]) && !eir_prog.dominates_block(ctx.fn_id, outer_hdr, hpreds[0_usize]) {
        outer_latch = hpreds[1_usize];
        outer_pre = hpreds[0_usize];
    } else {
        return false;
    }

    let all_insts = eir_prog.funcs.insts.as_slice();
    let cond_gid = ctx_def_inst_gid(ctx, hblk.term.val);
    if cond_gid == eir.EIR_NONE || cond_gid.widen.[usize]() >= all_insts.len {
        return false;
    }
    let cond_i = all_insts[cond_gid.widen.[usize]()];
    if cond_i.kind != .Binary || cond_i.bin_op != .Lt {
        return false;
    }
    let k_val = cond_i.v0;
    let k_end_val = cond_i.v1;
    let outer_body0 = hblk.term.bb0;
    let outer_exit = hblk.term.bb1;
    if outer_body0 == outer_hdr || outer_body0 == outer_exit || !is_loop_inv_val(ctx, eir_prog, outer_hdr, k_end_val) {
        return false;
    }

    // Identify `k_phi` and optional strength-reduced `b_base_phi` (`b_base = phi(kb*stride, b_base + stride)`)
    var k_start_val = eir.EIR_NONE;
    var k_step_val = eir.EIR_NONE;
    var has_sec_phi = false;
    var sec_phi_val = eir.EIR_NONE;
    var sec_init_val = eir.EIR_NONE;
    var sec_stride_val = eir.EIR_NONE;
    var found_k_phi = false;
    var pi: usize = 0_usize;
    while pi < hphis.len {
        let ph = hphis[pi];
        let incs = eir_prog.phi_incoming(ph.incoming);
        if incs.len != 2_usize {
            return false;
        }
        var init_v = eir.EIR_NONE;
        var next_v = eir.EIR_NONE;
        if incs[0_usize].pred_bb == outer_pre {
            init_v = incs[0_usize].val;
            next_v = incs[1_usize].val;
        } else if incs[1_usize].pred_bb == outer_pre {
            init_v = incs[1_usize].val;
            next_v = incs[0_usize].val;
        } else {
            return false;
        }
        if env.x64_layout(ph.ty).size != 8_usize || env.get(ph.ty).kind != .Int || env.is_signed_int(ph.ty) {
            return false;
        }
        if ph.dst == k_val {
            found_k_phi = true;
            k_start_val = init_v;
            k_step_val = next_v;
        } else {
            // Secondary induction variable must be `sec_next = sec + inv_stride` with `sec_init = k_start * inv_stride`
            let st_v = match_add_with_base(all_insts, ctx, next_v, ph.dst);
            if st_v == eir.EIR_NONE || !is_loop_inv_val(ctx, eir_prog, outer_hdr, st_v) {
                return false;
            }
            has_sec_phi = true;
            sec_phi_val = ph.dst;
            sec_init_val = init_v;
            sec_stride_val = st_v;
        }
        pi = pi +% 1_usize;
    }
    if !found_k_phi {
        return false;
    }
    // Verify `k_step_val == k_val + 1`
    let kstep_gid = ctx_def_inst_gid(ctx, k_step_val);
    if kstep_gid == eir.EIR_NONE || kstep_gid.widen.[usize]() >= all_insts.len {
        return false;
    }
    let kstep_i = all_insts[kstep_gid.widen.[usize]()];
    if kstep_i.kind != .Binary || (kstep_i.bin_op != .Add && kstep_i.bin_op != .AddWrap) {
        return false;
    }
    let kstep_ok = (kstep_i.v0 == k_val && ctx_is_const_int(ctx, kstep_i.v1) && ctx_const_int(ctx, kstep_i.v1) == 1_u64)
        || (kstep_i.v1 == k_val && ctx_is_const_int(ctx, kstep_i.v0) && ctx_const_int(ctx, kstep_i.v0) == 1_u64);
    if !kstep_ok {
        return false;
    }
    // Check `outer_exit` has no phis depending on outer loop values, and `outer_hdr` not already claimed
    let ex_blk = eir_prog.fn_block(ctx.fn_id, outer_exit) orelse { return false; };
    if ex_blk.phis.len != 0_u32 {
        return false;
    }
    let ex_loops = ctx.avx2_loops.as_slice();
    var li: usize = 0_usize;
    while li < ex_loops.len {
        if ex_loops[li].pre_bb == outer_pre || ex_loops[li].hdr_bb == outer_hdr {
            return false;
        }
        li = li +% 1_usize;
    }

    // Walk straight-line outer loop prelude blocks (`outer_body0` -> optional `k < a_row.len` -> `SliceSub` -> optional `c_tile.len <= b_tile.len` -> `inner_hdr`)
    var a_slice = eir.EIR_NONE;
    var aik_val = eir.EIR_NONE;
    var b_slice = eir.EIR_NONE;
    var b_stride = eir.EIR_NONE;
    var jb_val = eir.EIR_NONE;
    var j_end_val = eir.EIR_NONE;
    var b_tile_val = eir.EIR_NONE;
    var inner_hdr = eir.EIR_NONE;

    var cur_bb = outer_body0;
    var steps: usize = 0_usize;
    while steps < 8_usize {
        let cb = eir_prog.fn_block(ctx.fn_id, cur_bb) orelse { return false; };
        let cinsts = eir_prog.insts_slice(cb.insts);
        var ii: usize = 0_usize;
        while ii < cinsts.len {
            let inst = cinsts[ii];
            match inst.kind {
                .Const => {}
                .Copy => {}
                .Binary => {
                    // Reject side-effecting ops (Div/Mod)
                    if inst.bin_op == .Div || inst.bin_op == .Mod {
                        return false;
                    }
                }
                .LoadPlace => {
                    let pl = eir_prog.get_place(inst.aux0) orelse { return false; };
                    if pl.base.kind != .Val { return false; }
                    let ps = eir_prog.projs_slice(pl.projs);
                    if ps.len != 1_usize || ps[0_usize].kind != .Index || ps[0_usize].index != k_val { return false; }
                    if !avx2_is_f32_ty(env, pl.ty) || !is_slice_or_str_ty(eir_prog.fn_val_ty(ctx.fn_id, pl.base.id), env) {
                        return false;
                    }
                    a_slice = pl.base.id;
                }
                .BuiltinCall => {
                    let bc = eir_prog.get_builtin_call(inst.aux0) orelse { return false; };
                    if bc.op.kind == .VecSplat {
                        let vn = env.get(bc.op.ty0);
                        if vn.kind != .Vec || vn.u8_val != 4_u8 || !avx2_is_f32_ty(env, vn.primary) { return false; }
                        aik_val = inst.dst;
                    } else if bc.op.kind == .SliceLen {
                        // ok (for k < a_row.len or c_tile.len <= b_tile.len)
                    } else if bc.op.kind == .SliceSub {
                        let bargs = eir_prog.vals_slice(bc.args);
                        if bargs.len < 3_usize { return false; }
                        let b_cand = bargs[0_usize];
                        let lo_v = bargs[1_usize];
                        let hi_v = bargs[2_usize];
                        let b_elem = eir_prog.fn_val_ty(ctx.fn_id, b_cand);
                        if !is_slice_or_str_ty(b_elem, env) { return false; }
                        // Match `lo_v = b_base + jb`, `hi_v = b_base + j_end` where `b_base = k * stride` or `sec_phi_val`
                        let lo_gid = ctx_def_inst_gid(ctx, lo_v);
                        if lo_gid == eir.EIR_NONE || lo_gid.widen.[usize]() >= all_insts.len { return false; }
                        let lo_i = all_insts[lo_gid.widen.[usize]()];
                        if lo_i.kind != .Binary || (lo_i.bin_op != .Add && lo_i.bin_op != .AddWrap) { return false; }
                        var base_cand = eir.EIR_NONE;
                        var jb_cand = eir.EIR_NONE;
                        if has_sec_phi && lo_i.v0 == sec_phi_val {
                            base_cand = sec_phi_val;
                            jb_cand = lo_i.v1;
                            b_stride = sec_stride_val;
                        } else if has_sec_phi && lo_i.v1 == sec_phi_val {
                            base_cand = sec_phi_val;
                            jb_cand = lo_i.v0;
                            b_stride = sec_stride_val;
                        } else {
                            // Check if lo_i.v0 or lo_i.v1 is `k * stride`
                            let bg0 = ctx_def_inst_gid(ctx, lo_i.v0);
                            if bg0 != eir.EIR_NONE && bg0.widen.[usize]() < all_insts.len {
                                let bi0 = all_insts[bg0.widen.[usize]()];
                                if bi0.kind == .Binary && (bi0.bin_op == .Mul || bi0.bin_op == .MulWrap) {
                                    if bi0.v0 == k_val {
                                        base_cand = lo_i.v0; jb_cand = lo_i.v1; b_stride = bi0.v1;
                                    } else if bi0.v1 == k_val {
                                        base_cand = lo_i.v0; jb_cand = lo_i.v1; b_stride = bi0.v0;
                                    }
                                }
                            }
                            if base_cand == eir.EIR_NONE {
                                let bg1 = ctx_def_inst_gid(ctx, lo_i.v1);
                                if bg1 != eir.EIR_NONE && bg1.widen.[usize]() < all_insts.len {
                                    let bi1 = all_insts[bg1.widen.[usize]()];
                                    if bi1.kind == .Binary && (bi1.bin_op == .Mul || bi1.bin_op == .MulWrap) {
                                        if bi1.v0 == k_val {
                                            base_cand = lo_i.v1; jb_cand = lo_i.v0; b_stride = bi1.v1;
                                        } else if bi1.v1 == k_val {
                                            base_cand = lo_i.v1; jb_cand = lo_i.v0; b_stride = bi1.v0;
                                        }
                                    }
                                }
                            }
                        }
                        if base_cand == eir.EIR_NONE || b_stride == eir.EIR_NONE { return false; }
                        let je_cand = match_add_with_base(all_insts, ctx, hi_v, base_cand);
                        if je_cand == eir.EIR_NONE { return false; }
                        b_slice = b_cand;
                        jb_val = jb_cand;
                        j_end_val = je_cand;
                    } else {
                        return false;
                    }
                }
                .IsError => {}
                .UnwrapErrorOk => {
                    b_tile_val = inst.dst;
                }
                _ => { return false; }
            }
            ii = ii +% 1_usize;
        }
        if cb.term.kind == .Goto {
            let nxt = cb.term.bb0;
            let nb = eir_prog.fn_block(ctx.fn_id, nxt) orelse { return false; };
            if nb.phis.len == 1_u32 && nb.term.kind == .Branch {
                inner_hdr = nxt;
                break;
            }
            cur_bb = nxt;
            steps = steps +% 1_usize;
            continue;
        }
        if cb.term.kind == .Branch {
            let b0 = cb.term.bb0;
            let b1 = cb.term.bb1;
            let tg = ctx_def_inst_gid(ctx, cb.term.val);
            if tg != eir.EIR_NONE && tg.widen.[usize]() < all_insts.len {
                let ti = all_insts[tg.widen.[usize]()];
                if ti.kind == .IsError {
                    // `IsError(b_tile)` -> then=err, else=ok!
                    cur_bb = b1;
                    steps = steps +% 1_usize;
                    continue;
                }
                if ti.kind == .Binary && (ti.bin_op == .Lt || ti.bin_op == .LtEq) {
                    // Guard `k < a_row.len` or `c_tile.len <= b_tile.len`: false branch must go to outer_latch!
                    if b1 == outer_latch || avx2_is_empty_goto_to(eir_prog, ctx.fn_id, b1, outer_latch) {
                        let nb = eir_prog.fn_block(ctx.fn_id, b0) orelse { return false; };
                        if nb.phis.len == 1_u32 && nb.term.kind == .Branch {
                            inner_hdr = b0;
                            break;
                        }
                        cur_bb = b0;
                        steps = steps +% 1_usize;
                        continue;
                    }
                }
            }
            return false;
        }
        return false;
    }

    if inner_hdr == eir.EIR_NONE || a_slice == eir.EIR_NONE || aik_val == eir.EIR_NONE
        || b_slice == eir.EIR_NONE || b_stride == eir.EIR_NONE || jb_val == eir.EIR_NONE
        || j_end_val == eir.EIR_NONE || b_tile_val == eir.EIR_NONE
    {
        return false;
    }
    if !is_loop_inv_val(ctx, eir_prog, outer_hdr, a_slice)
        || !is_loop_inv_val(ctx, eir_prog, outer_hdr, b_slice)
        || !is_loop_inv_val(ctx, eir_prog, outer_hdr, b_stride)
        || !is_loop_inv_val(ctx, eir_prog, outer_hdr, jb_val)
        || !is_loop_inv_val(ctx, eir_prog, outer_hdr, j_end_val)
    {
        return false;
    }

    // Verify `inner_hdr` is the exact `j in 0..c_tile.len` f32x4 FMA loop exiting to `outer_latch`!
    let ih = eir_prog.fn_block(ctx.fn_id, inner_hdr) orelse { return false; };
    let iphis = eir_prog.phis_slice(ih.phis);
    let ipreds = eir_prog.preds_slice(ih.preds);
    if iphis.len != 1_usize || ipreds.len != 2_usize || ih.term.kind != .Branch {
        return false;
    }
    let j_phi = iphis[0_usize];
    let j_val = j_phi.dst;
    let j_incs = eir_prog.phi_incoming(j_phi.incoming);
    if j_incs.len != 2_usize {
        return false;
    }
    let inner_body = ih.term.bb0;
    let inner_exit = ih.term.bb1;
    if inner_exit != outer_latch && !avx2_is_empty_goto_to(eir_prog, ctx.fn_id, inner_exit, outer_latch) {
        return false;
    }
    var j_start = eir.EIR_NONE;
    var j_step = eir.EIR_NONE;
    if j_incs[0_usize].pred_bb == inner_body {
        j_step = j_incs[0_usize].val;
        j_start = j_incs[1_usize].val;
    } else if j_incs[1_usize].pred_bb == inner_body {
        j_step = j_incs[1_usize].val;
        j_start = j_incs[0_usize].val;
    } else {
        return false;
    }
    if !ctx_is_const_int(ctx, j_start) || ctx_const_int(ctx, j_start) != 0_u64 {
        return false;
    }
    let icond_gid = ctx_def_inst_gid(ctx, ih.term.val);
    if icond_gid == eir.EIR_NONE || icond_gid.widen.[usize]() >= all_insts.len {
        return false;
    }
    let icond_i = all_insts[icond_gid.widen.[usize]()];
    if icond_i.kind != .Binary || icond_i.bin_op != .Lt || icond_i.v0 != j_val {
        return false;
    }
    let j_bound = icond_i.v1;
    if !is_loop_inv_val(ctx, eir_prog, outer_hdr, j_bound) {
        return false;
    }
    let jst_gid = ctx_def_inst_gid(ctx, j_step);
    if jst_gid == eir.EIR_NONE || jst_gid.widen.[usize]() >= all_insts.len {
        return false;
    }
    let jst_i = all_insts[jst_gid.widen.[usize]()];
    if jst_i.kind != .Binary || (jst_i.bin_op != .Add && jst_i.bin_op != .AddWrap) {
        return false;
    }
    let jst_ok = (jst_i.v0 == j_val && ctx_is_const_int(ctx, jst_i.v1) && ctx_const_int(ctx, jst_i.v1) == 1_u64)
        || (jst_i.v1 == j_val && ctx_is_const_int(ctx, jst_i.v0) && ctx_const_int(ctx, jst_i.v0) == 1_u64);
    if !jst_ok {
        return false;
    }

    // Verify `inner_body` contains ONLY: Load(b_tile[j]), Load(c_tile[j]), VecFma(aik, b_v, c_v), Store(c_tile[j], res), j+1
    let ib = eir_prog.fn_block(ctx.fn_id, inner_body) orelse { return false; };
    if ib.phis.len != 0_u32 || ib.term.kind != .Goto || ib.term.bb0 != inner_hdr {
        return false;
    }
    let ib_insts = eir_prog.insts_slice(ib.insts);
    var ld0_v = eir.EIR_NONE;
    var ld0_sl = eir.EIR_NONE;
    var ld1_v = eir.EIR_NONE;
    var ld1_sl = eir.EIR_NONE;
    var fma_dst = eir.EIR_NONE;
    var fma_a = eir.EIR_NONE;
    var fma_b = eir.EIR_NONE;
    var fma_c = eir.EIR_NONE;
    var c_slice = eir.EIR_NONE;
    var st_v = eir.EIR_NONE;
    var n_ld: usize = 0_usize;
    var n_fm: usize = 0_usize;
    var n_st: usize = 0_usize;
    var bi_i: usize = 0_usize;
    while bi_i < ib_insts.len {
        let inst = ib_insts[bi_i];
        match inst.kind {
            .Const => { if !ctx_is_const_int(ctx, inst.dst) { return false; } }
            .Binary => { if inst.dst != j_step { return false; } }
            .LoadPlace => {
                let pl = eir_prog.get_place(inst.aux0) orelse { return false; };
                if pl.base.kind != .Val { return false; }
                let ps = eir_prog.projs_slice(pl.projs);
                if ps.len != 1_usize || ps[0_usize].kind != .Index || ps[0_usize].index != j_val { return false; }
                let vn = env.get(pl.ty);
                if vn.kind != .Vec || vn.u8_val != 4_u8 || !avx2_is_f32_ty(env, vn.primary) { return false; }
                if n_ld == 0_usize { ld0_v = inst.dst; ld0_sl = pl.base.id; }
                else if n_ld == 1_usize { ld1_v = inst.dst; ld1_sl = pl.base.id; }
                else { return false; }
                n_ld = n_ld +% 1_usize;
            }
            .BuiltinCall => {
                let bc = eir_prog.get_builtin_call(inst.aux0) orelse { return false; };
                if bc.op.kind != .VecFma || n_fm != 0_usize { return false; }
                let vn = env.get(bc.op.ty0);
                if vn.kind != .Vec || vn.u8_val != 4_u8 || !avx2_is_f32_ty(env, vn.primary) { return false; }
                let args = eir_prog.vals_slice(bc.args);
                if args.len != 3_usize { return false; }
                fma_dst = inst.dst; fma_a = args[0_usize]; fma_b = args[1_usize]; fma_c = args[2_usize];
                n_fm = 1_usize;
            }
            .StorePlace => {
                let pl = eir_prog.get_place(inst.aux0) orelse { return false; };
                if pl.base.kind != .Val || n_st != 0_usize { return false; }
                let ps = eir_prog.projs_slice(pl.projs);
                if ps.len != 1_usize || ps[0_usize].kind != .Index || ps[0_usize].index != j_val { return false; }
                let vn = env.get(pl.ty);
                if vn.kind != .Vec || vn.u8_val != 4_u8 || !avx2_is_f32_ty(env, vn.primary) { return false; }
                c_slice = pl.base.id;
                st_v = inst.v0;
                n_st = 1_usize;
            }
            _ => { return false; }
        }
        bi_i = bi_i +% 1_usize;
    }
    if n_ld != 2_usize || n_fm != 1_usize || n_st != 1_usize || st_v != fma_dst {
        return false;
    }
    if !is_loop_inv_val(ctx, eir_prog, outer_hdr, c_slice) {
        return false;
    }
    var c_ld_v = eir.EIR_NONE;
    var b_ld_v = eir.EIR_NONE;
    if ld0_sl == c_slice && ld1_sl == b_tile_val {
        c_ld_v = ld0_v; b_ld_v = ld1_v;
    } else if ld1_sl == c_slice && ld0_sl == b_tile_val {
        c_ld_v = ld1_v; b_ld_v = ld0_v;
    } else {
        return false;
    }
    if fma_c != c_ld_v { return false; }
    if !((fma_a == aik_val && fma_b == b_ld_v) || (fma_b == aik_val && fma_a == b_ld_v)) {
        return false;
    }

    // Verify `outer_latch` ONLY computes `k + 1` (and optional `sec + stride`) and jumps back to `outer_hdr`!
    let ol = eir_prog.fn_block(ctx.fn_id, outer_latch) orelse { return false; };
    if ol.phis.len != 0_u32 || ol.term.kind != .Goto || ol.term.bb0 != outer_hdr {
        return false;
    }
    let ol_insts = eir_prog.insts_slice(ol.insts);
    var oli: usize = 0_usize;
    while oli < ol_insts.len {
        let inst = ol_insts[oli];
        if inst.kind != .Const && inst.kind != .Binary && inst.kind != .Copy {
            return false;
        }
        if inst.kind == .Binary && (inst.bin_op == .Div || inst.bin_op == .Mod) {
            return false;
        }
        oli = oli +% 1_usize;
    }

    // ---- Emit 8-YMM (64-float) Register-Blocked Interchanged Tile Loop (`j_blk` outer, `k` inner) ----
    let out_depth = eir_prog.block_depth(ctx.fn_id, outer_hdr);
    let pre_d = if out_depth > 0_u8 { out_depth -% 1_u8 } else { 0_u8 };
    let mid_d = out_depth +% 1_u8;
    let in_d = out_depth +% 2_u8;

    let v_pre = try mf.add_block(alloc, pre_d);
    let b_chk1 = try mf.add_block(alloc, pre_d);
    let b_chk2 = try mf.add_block(alloc, pre_d);
    let b_chk3 = try mf.add_block(alloc, pre_d);
    let b_chk4 = try mf.add_block(alloc, pre_d);
    let b_chk_al1 = try mf.add_block(alloc, pre_d);
    let b_chk_al2 = try mf.add_block(alloc, pre_d);
    let b_chk_al3 = try mf.add_block(alloc, pre_d);
    let b_setup = try mf.add_block(alloc, pre_d);
    let b_j_hdr = try mf.add_block(alloc, mid_d);
    let b_j_load = try mf.add_block(alloc, mid_d);
    let b_k_loop = try mf.add_block(alloc, in_d);
    let b_j_store = try mf.add_block(alloc, mid_d);
    let b_tail_hdr = try mf.add_block(alloc, mid_d);
    let b_tail_ld = try mf.add_block(alloc, mid_d);
    let b_tail_k = try mf.add_block(alloc, in_d);
    let b_tail_st = try mf.add_block(alloc, mid_d);
    let b_bail = try mf.add_block(alloc, pre_d);

    mf.begin_block_insts(v_pre);
    ctx.cur_mbb = v_pre;
    let v_kb = try load_val_gpr(alloc, ctx, mf, eir_prog, env, k_start_val, true, sp);
    let v_kend = try load_val_gpr(alloc, ctx, mf, eir_prog, env, k_end_val, true, sp);
    let v_jb = try load_val_gpr(alloc, ctx, mf, eir_prog, env, jb_val, true, sp);
    let v_jend = try load_val_gpr(alloc, ctx, mf, eir_prog, env, j_end_val, true, sp);
    let v_stride = try load_val_gpr(alloc, ctx, mf, eir_prog, env, b_stride, true, sp);
    let v_jbound = try load_val_gpr(alloc, ctx, mf, eir_prog, env, j_bound, true, sp);
    let a_pair = try load_slice_pair(alloc, ctx, mf, a_slice, sp);
    let b_pair = try load_slice_pair(alloc, ctx, mf, b_slice, sp);
    let c_pair = try load_slice_pair(alloc, ctx, mf, c_slice, sp);

    // Pre-check 0: `kb < k_end && k_end <= a_row.len && jb <= j_end`
    try emit_cmp_rr(alloc, mf, v_kb, v_kend, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, b_bail, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk1, sp));
    mf.end_block_insts(v_pre);

    mf.begin_block_insts(b_chk1);
    try emit_cmp_rr(alloc, mf, v_kend, a_pair.hi, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_bail, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk2, sp));
    mf.end_block_insts(b_chk1);

    mf.begin_block_insts(b_chk2);
    try emit_cmp_rr(alloc, mf, v_jb, v_jend, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_bail, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk3, sp));
    mf.end_block_insts(b_chk2);

    // Pre-check 3: `c_tile.len <= (j_end - jb) && j_bound == c_tile.len && c_tile.len >= 16`
    mf.begin_block_insts(b_chk3);
    let v_tile_w = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Sub, v_tile_w, v_jend, v_jb, sp);
    try emit_cmp_rr(alloc, mf, c_pair.hi, v_tile_w, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_bail, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk4, sp));
    mf.end_block_insts(b_chk3);

    // Pre-check 4: overflow-safe `k_end <= 0x10000000 && stride <= 0x10000000 && (k_end - 1)*stride + j_end <= b.len && eff_j >= 16`
    let b_chk4b = try mf.add_block(alloc, pre_d);
    let b_chk4c = try mf.add_block(alloc, pre_d);
    mf.begin_block_insts(b_chk4);
    let v_eff_j = try mf.new_vreg(alloc, .Gpr);
    try emit_cmp_rr(alloc, mf, v_jbound, c_pair.hi, sp);
    try emit_cmov(alloc, mf, .B, v_eff_j, c_pair.hi, v_jbound, sp);
    try emit_cmp_ri(alloc, mf, v_eff_j, 16_i32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, b_bail, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk4b, sp));
    mf.end_block_insts(b_chk4);

    mf.begin_block_insts(b_chk4b);
    let v_lim_ov = try emit_imm_vreg(alloc, mf, 0x10000000_u64, sp);
    try emit_cmp_rr(alloc, mf, v_kend, v_lim_ov, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_bail, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk4c, sp));
    mf.end_block_insts(b_chk4b);

    let b_chk4d = try mf.add_block(alloc, pre_d);
    mf.begin_block_insts(b_chk4c);
    try emit_cmp_rr(alloc, mf, v_stride, v_lim_ov, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_bail, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk4d, sp));
    mf.end_block_insts(b_chk4c);

    mf.begin_block_insts(b_chk4d);
    let v_klast = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .SubImm, v_klast, v_kend, 1_i64, sp);
    let v_bmax0 = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Mul, v_bmax0, v_klast, v_stride, sp);
    let v_bmax = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_bmax, v_bmax0, v_jend, sp);
    try emit_cmp_rr(alloc, mf, v_bmax, b_pair.hi, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_bail, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_al1, sp));
    mf.end_block_insts(b_chk4d);

    // Non-overlap check: `c_tile` disjoint from `b` and `a_row`
    let b_chk_al1b = try mf.add_block(alloc, pre_d);
    mf.begin_block_insts(b_chk_al1);
    let v_c_bytes = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, v_c_bytes, v_eff_j, 4_i64, sp);
    let v_c_end = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_c_end, c_pair.lo, v_c_bytes, sp);
    let v_b_bytes = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, v_b_bytes, b_pair.hi, 4_i64, sp);
    let v_b_end = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_b_end, b_pair.lo, v_b_bytes, sp);
    try emit_cmp_rr(alloc, mf, v_c_end, b_pair.lo, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Be, b_chk_al2, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_al1b, sp));
    mf.end_block_insts(b_chk_al1);

    mf.begin_block_insts(b_chk_al1b);
    try emit_cmp_rr(alloc, mf, v_b_end, c_pair.lo, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Be, b_chk_al2, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_bail, sp));
    mf.end_block_insts(b_chk_al1b);

    mf.begin_block_insts(b_chk_al2);
    let v_a_bytes = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, v_a_bytes, a_pair.hi, 2_i64, sp);
    let v_a_end_all = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_a_end_all, a_pair.lo, v_a_bytes, sp);
    try emit_cmp_rr(alloc, mf, v_c_end, a_pair.lo, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Be, b_setup, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_chk_al3, sp));
    mf.end_block_insts(b_chk_al2);

    mf.begin_block_insts(b_chk_al3);
    try emit_cmp_rr(alloc, mf, v_a_end_all, c_pair.lo, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Be, b_setup, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_bail, sp));
    mf.end_block_insts(b_chk_al3);

    // Setup invariant base pointers for the interchanged (j_blk -> k) loop!
    mf.begin_block_insts(b_setup);
    let v_stride_bytes = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, v_stride_bytes, v_stride, 4_i64, sp);
    let v_a_start = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(v_a_start, mach_ir.mem_sib(a_pair.lo, v_kb, 4_u8, 0_i32), sp));
    let v_a_end = try mf.new_vreg(alloc, .Gpr);
    try mf.emit_inst(alloc, mach_ir.inst_lea(v_a_end, mach_ir.mem_sib(a_pair.lo, v_kend, 4_u8, 0_i32), sp));
    let v_kb_mul = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Mul, v_kb_mul, v_kb, v_stride, sp);
    let v_b0_idx = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_b0_idx, v_kb_mul, v_jb, sp);
    let v_b0_off = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, v_b0_off, v_b0_idx, 4_i64, sp);
    let v_b_base0 = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_b_base0, b_pair.lo, v_b0_off, sp);

    // `j_lim_bytes = (v_eff_j - 16) * 16` (step by 256 bytes = 16 f32x4 = 8 YMM = 64 floats!)
    let v_j_lim_idx = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .SubImm, v_j_lim_idx, v_eff_j, 16_i64, sp);
    let v_j_lim = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, v_j_lim, v_j_lim_idx, 4_i64, sp);
    let v_j_total = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .ShlImm, v_j_total, v_eff_j, 4_i64, sp);

    let v_j_off = try mf.new_vreg(alloc, .Gpr);
    let v_zero0 = try emit_imm_vreg(alloc, mf, 0_u64, sp);
    let p_ji = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_j_off, v_zero0);
    try mf.emit_parallel_copy(alloc, p_ji, 1_u32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_j_hdr, sp));
    mf.end_block_insts(b_setup);

    // Outer `j_off` header (step +256B = 8 YMMs)
    mf.begin_block_insts(b_j_hdr);
    try emit_cmp_rr(alloc, mf, v_j_off, v_j_lim, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.A, b_tail_hdr, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_j_load, sp));
    mf.end_block_insts(b_j_hdr);

    // Load 8 YMMs of `c_tile[j_off .. j_off + 256]` ONCE directly into `y0..y7` before entire `k` loop!
    mf.begin_block_insts(b_j_load);
    let y0 = try mf.new_vreg(alloc, .Vec256);
    let y1 = try mf.new_vreg(alloc, .Vec256);
    let y2 = try mf.new_vreg(alloc, .Vec256);
    let y3 = try mf.new_vreg(alloc, .Vec256);
    let y4 = try mf.new_vreg(alloc, .Vec256);
    let y5 = try mf.new_vreg(alloc, .Vec256);
    let y6 = try mf.new_vreg(alloc, .Vec256);
    let y7 = try mf.new_vreg(alloc, .Vec256);
    let v_c_cur = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_c_cur, c_pair.lo, v_j_off, sp);
    let v_b_cur0 = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_b_cur0, v_b_base0, v_j_off, sp);

    var l0 = mach_ir.inst_empty(.VMovUpsLoad, sp); l0.dst = y0; l0.mem = mach_ir.mem_base_disp(v_c_cur, 0_i32); l0.flag0 = true; l0.size_bytes = 32_u8; try mf.emit_inst(alloc, l0);
    var l1 = mach_ir.inst_empty(.VMovUpsLoad, sp); l1.dst = y1; l1.mem = mach_ir.mem_base_disp(v_c_cur, 32_i32); l1.flag0 = true; l1.size_bytes = 32_u8; try mf.emit_inst(alloc, l1);
    var l2 = mach_ir.inst_empty(.VMovUpsLoad, sp); l2.dst = y2; l2.mem = mach_ir.mem_base_disp(v_c_cur, 64_i32); l2.flag0 = true; l2.size_bytes = 32_u8; try mf.emit_inst(alloc, l2);
    var l3 = mach_ir.inst_empty(.VMovUpsLoad, sp); l3.dst = y3; l3.mem = mach_ir.mem_base_disp(v_c_cur, 96_i32); l3.flag0 = true; l3.size_bytes = 32_u8; try mf.emit_inst(alloc, l3);
    var l4 = mach_ir.inst_empty(.VMovUpsLoad, sp); l4.dst = y4; l4.mem = mach_ir.mem_base_disp(v_c_cur, 128_i32); l4.flag0 = true; l4.size_bytes = 32_u8; try mf.emit_inst(alloc, l4);
    var l5 = mach_ir.inst_empty(.VMovUpsLoad, sp); l5.dst = y5; l5.mem = mach_ir.mem_base_disp(v_c_cur, 160_i32); l5.flag0 = true; l5.size_bytes = 32_u8; try mf.emit_inst(alloc, l5);
    var l6 = mach_ir.inst_empty(.VMovUpsLoad, sp); l6.dst = y6; l6.mem = mach_ir.mem_base_disp(v_c_cur, 192_i32); l6.flag0 = true; l6.size_bytes = 32_u8; try mf.emit_inst(alloc, l6);
    var l7 = mach_ir.inst_empty(.VMovUpsLoad, sp); l7.dst = y7; l7.mem = mach_ir.mem_base_disp(v_c_cur, 224_i32); l7.flag0 = true; l7.size_bytes = 32_u8; try mf.emit_inst(alloc, l7);

    let v_ak = try mf.new_vreg(alloc, .Gpr);
    let v_bk = try mf.new_vreg(alloc, .Gpr);
    let p_ki = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_ak, v_a_start);
    try mf.add_pcopy_pair(alloc, v_bk, v_b_cur0);
    try mf.emit_parallel_copy(alloc, p_ki, 2_u32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_k_loop, sp));
    mf.end_block_insts(b_j_load);

    // ULTRA-TIGHT INNER `k` LOOP: 64 float FMAs in 13 hardware instructions (in-place y0..y7, 0 spills, 0 vmovaps)!
    mf.begin_block_insts(b_k_loop);
    let y_a = try mf.new_vreg(alloc, .Vec256);
    var bca = mach_ir.inst_empty(.VBroadcastSS, sp);
    bca.dst = y_a; bca.mem = mach_ir.mem_base_disp(v_ak, 0_i32); bca.flag0 = true; bca.size_bytes = 32_u8;
    try mf.emit_inst(alloc, bca);

    var f0 = mach_ir.inst_empty(.VFmadd231PSMem, sp); f0.dst = y0; f0.src0 = y0; f0.src1 = y_a; f0.tied_src0 = true; f0.mem = mach_ir.mem_base_disp(v_bk, 0_i32); f0.flag0 = true; f0.size_bytes = 32_u8; try mf.emit_inst(alloc, f0);
    var f1 = mach_ir.inst_empty(.VFmadd231PSMem, sp); f1.dst = y1; f1.src0 = y1; f1.src1 = y_a; f1.tied_src0 = true; f1.mem = mach_ir.mem_base_disp(v_bk, 32_i32); f1.flag0 = true; f1.size_bytes = 32_u8; try mf.emit_inst(alloc, f1);
    var f2 = mach_ir.inst_empty(.VFmadd231PSMem, sp); f2.dst = y2; f2.src0 = y2; f2.src1 = y_a; f2.tied_src0 = true; f2.mem = mach_ir.mem_base_disp(v_bk, 64_i32); f2.flag0 = true; f2.size_bytes = 32_u8; try mf.emit_inst(alloc, f2);
    var f3 = mach_ir.inst_empty(.VFmadd231PSMem, sp); f3.dst = y3; f3.src0 = y3; f3.src1 = y_a; f3.tied_src0 = true; f3.mem = mach_ir.mem_base_disp(v_bk, 96_i32); f3.flag0 = true; f3.size_bytes = 32_u8; try mf.emit_inst(alloc, f3);
    var f4 = mach_ir.inst_empty(.VFmadd231PSMem, sp); f4.dst = y4; f4.src0 = y4; f4.src1 = y_a; f4.tied_src0 = true; f4.mem = mach_ir.mem_base_disp(v_bk, 128_i32); f4.flag0 = true; f4.size_bytes = 32_u8; try mf.emit_inst(alloc, f4);
    var f5 = mach_ir.inst_empty(.VFmadd231PSMem, sp); f5.dst = y5; f5.src0 = y5; f5.src1 = y_a; f5.tied_src0 = true; f5.mem = mach_ir.mem_base_disp(v_bk, 160_i32); f5.flag0 = true; f5.size_bytes = 32_u8; try mf.emit_inst(alloc, f5);
    var f6 = mach_ir.inst_empty(.VFmadd231PSMem, sp); f6.dst = y6; f6.src0 = y6; f6.src1 = y_a; f6.tied_src0 = true; f6.mem = mach_ir.mem_base_disp(v_bk, 192_i32); f6.flag0 = true; f6.size_bytes = 32_u8; try mf.emit_inst(alloc, f6);
    var f7 = mach_ir.inst_empty(.VFmadd231PSMem, sp); f7.dst = y7; f7.src0 = y7; f7.src1 = y_a; f7.tied_src0 = true; f7.mem = mach_ir.mem_base_disp(v_bk, 224_i32); f7.flag0 = true; f7.size_bytes = 32_u8; try mf.emit_inst(alloc, f7);

    let v_ak_next = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .AddImm, v_ak_next, v_ak, 4_i64, sp);
    let v_bk_next = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_bk_next, v_bk, v_stride_bytes, sp);
    let p_kn = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_ak, v_ak_next);
    try mf.add_pcopy_pair(alloc, v_bk, v_bk_next);
    try mf.emit_parallel_copy(alloc, p_kn, 2_u32, sp);
    try emit_cmp_rr(alloc, mf, v_ak, v_a_end, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, b_k_loop, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_j_store, sp));
    mf.end_block_insts(b_k_loop);

    // Store 8 YMMs back to `c_tile[j_off .. j_off + 256]` ONCE and advance `j_off += 256`!
    mf.begin_block_insts(b_j_store);
    var s0 = mach_ir.inst_empty(.VMovUpsStore, sp); s0.src0 = y0; s0.mem = mach_ir.mem_base_disp(v_c_cur, 0_i32); s0.flag0 = true; s0.size_bytes = 32_u8; try mf.emit_inst(alloc, s0);
    var s1 = mach_ir.inst_empty(.VMovUpsStore, sp); s1.src0 = y1; s1.mem = mach_ir.mem_base_disp(v_c_cur, 32_i32); s1.flag0 = true; s1.size_bytes = 32_u8; try mf.emit_inst(alloc, s1);
    var s2 = mach_ir.inst_empty(.VMovUpsStore, sp); s2.src0 = y2; s2.mem = mach_ir.mem_base_disp(v_c_cur, 64_i32); s2.flag0 = true; s2.size_bytes = 32_u8; try mf.emit_inst(alloc, s2);
    var s3 = mach_ir.inst_empty(.VMovUpsStore, sp); s3.src0 = y3; s3.mem = mach_ir.mem_base_disp(v_c_cur, 96_i32); s3.flag0 = true; s3.size_bytes = 32_u8; try mf.emit_inst(alloc, s3);
    var s4 = mach_ir.inst_empty(.VMovUpsStore, sp); s4.src0 = y4; s4.mem = mach_ir.mem_base_disp(v_c_cur, 128_i32); s4.flag0 = true; s4.size_bytes = 32_u8; try mf.emit_inst(alloc, s4);
    var s5 = mach_ir.inst_empty(.VMovUpsStore, sp); s5.src0 = y5; s5.mem = mach_ir.mem_base_disp(v_c_cur, 160_i32); s5.flag0 = true; s5.size_bytes = 32_u8; try mf.emit_inst(alloc, s5);
    var s6 = mach_ir.inst_empty(.VMovUpsStore, sp); s6.src0 = y6; s6.mem = mach_ir.mem_base_disp(v_c_cur, 192_i32); s6.flag0 = true; s6.size_bytes = 32_u8; try mf.emit_inst(alloc, s6);
    var s7 = mach_ir.inst_empty(.VMovUpsStore, sp); s7.src0 = y7; s7.mem = mach_ir.mem_base_disp(v_c_cur, 224_i32); s7.flag0 = true; s7.size_bytes = 32_u8; try mf.emit_inst(alloc, s7);

    let v_j_next = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .AddImm, v_j_next, v_j_off, 256_i64, sp);
    let p_jn = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_j_off, v_j_next);
    try mf.emit_parallel_copy(alloc, p_jn, 1_u32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_j_hdr, sp));
    mf.end_block_insts(b_j_store);

    // 1-XMM (`f32x4`) tail loop for any remaining `c_tile.len % 16` columns (handles ANY width!)
    mf.begin_block_insts(b_tail_hdr);
    try emit_cmp_rr(alloc, mf, v_j_off, v_j_total, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ae, ctx_mbb_for_eir(ctx, outer_exit), sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_tail_ld, sp));
    mf.end_block_insts(b_tail_hdr);

    mf.begin_block_insts(b_tail_ld);
    let v_tc = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_tc, c_pair.lo, v_j_off, sp);
    let v_tb0 = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_tb0, v_b_base0, v_j_off, sp);
    let tx = try mf.new_vreg(alloc, .Vec128);
    var tl = mach_ir.inst_empty(.VMovUpsLoad, sp); tl.dst = tx; tl.mem = mach_ir.mem_base_disp(v_tc, 0_i32); tl.size_bytes = 16_u8; try mf.emit_inst(alloc, tl);
    let v_tak = try mf.new_vreg(alloc, .Gpr);
    let v_tbk = try mf.new_vreg(alloc, .Gpr);
    let p_ti = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_tak, v_a_start);
    try mf.add_pcopy_pair(alloc, v_tbk, v_tb0);
    try mf.emit_parallel_copy(alloc, p_ti, 2_u32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_tail_k, sp));
    mf.end_block_insts(b_tail_ld);

    mf.begin_block_insts(b_tail_k);
    let xa = try mf.new_vreg(alloc, .Vec128);
    var tbc = mach_ir.inst_empty(.VBroadcastSS, sp);
    tbc.dst = xa; tbc.mem = mach_ir.mem_base_disp(v_tak, 0_i32); tbc.size_bytes = 16_u8;
    try mf.emit_inst(alloc, tbc);
    var tf = mach_ir.inst_empty(.VFmadd231PSMem, sp);
    tf.dst = tx; tf.src0 = tx; tf.src1 = xa; tf.tied_src0 = true; tf.mem = mach_ir.mem_base_disp(v_tbk, 0_i32); tf.size_bytes = 16_u8;
    try mf.emit_inst(alloc, tf);
    let v_tak_n = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .AddImm, v_tak_n, v_tak, 4_i64, sp);
    let v_tbk_n = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_rr(alloc, mf, .Add, v_tbk_n, v_tbk, v_stride_bytes, sp);
    let p_tn = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_tak, v_tak_n);
    try mf.add_pcopy_pair(alloc, v_tbk, v_tbk_n);
    try mf.emit_parallel_copy(alloc, p_tn, 2_u32, sp);
    try emit_cmp_rr(alloc, mf, v_tak, v_a_end, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jcc(.B, b_tail_k, sp));
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_tail_st, sp));
    mf.end_block_insts(b_tail_k);

    mf.begin_block_insts(b_tail_st);
    var ts = mach_ir.inst_empty(.VMovUpsStore, sp); ts.src0 = tx; ts.mem = mach_ir.mem_base_disp(v_tc, 0_i32); ts.size_bytes = 16_u8; try mf.emit_inst(alloc, ts);
    let v_tj_n = try mf.new_vreg(alloc, .Gpr);
    try emit_alu_ri(alloc, mf, .AddImm, v_tj_n, v_j_off, 16_i64, sp);
    let p_tjn = mf.pcopy_pairs.len().trunc.[u32]();
    try mf.add_pcopy_pair(alloc, v_j_off, v_tj_n);
    try mf.emit_parallel_copy(alloc, p_tjn, 1_u32, sp);
    try mf.emit_inst(alloc, mach_ir.inst_jmp(b_tail_hdr, sp));
    mf.end_block_insts(b_tail_st);

    // Safe bailout: initialize `outer_hdr` phis with original entry values and jump to unmodified `outer_hdr`
    mf.begin_block_insts(b_bail);
    let k_loc = ctx_val_loc(ctx, k_val);
    if k_loc.kind == .Gpr {
        let p_bk = mf.pcopy_pairs.len().trunc.[u32]();
        try mf.add_pcopy_pair(alloc, k_loc.vreg0, v_kb);
        try mf.emit_parallel_copy(alloc, p_bk, 1_u32, sp);
    } else if k_loc.kind == .Stack {
        try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(k_loc.stack_off), v_kb, 8_usize, sp);
    }
    if has_sec_phi {
        let v_sec_init = try load_val_gpr(alloc, ctx, mf, eir_prog, env, sec_init_val, true, sp);
        let s_loc = ctx_val_loc(ctx, sec_phi_val);
        if s_loc.kind == .Gpr {
            let p_bs = mf.pcopy_pairs.len().trunc.[u32]();
            try mf.add_pcopy_pair(alloc, s_loc.vreg0, v_sec_init);
            try mf.emit_parallel_copy(alloc, p_bs, 1_u32, sp);
        } else if s_loc.kind == .Stack {
            try emit_store_mem(alloc, mf, mach_ir.mem_stack_slot(s_loc.stack_off), v_sec_init, 8_usize, sp);
        }
    }
    try mf.emit_inst(alloc, mach_ir.inst_jmp(ctx_mbb_for_eir(ctx, outer_hdr), sp));
    mf.end_block_insts(b_bail);

    ctx.uses_avx2_loop = true;
    try ctx.avx2_loops.push(alloc, Avx2LoopEntry.{
        hdr_bb: outer_hdr,
        pre_bb: outer_pre,
        latch_bb: outer_latch,
        body_bb: outer_body0,
        exit_bb: outer_exit,
        ind_val: k_val,
        start_val: k_start_val,
        bound_val: k_end_val,
        v_pre_mbb: v_pre,
    });
    return true;
}

fn try_emit_avx2_loop_for_block(
    alloc: *mut AllocCap,
    ctx: *mut IselCtx,
    mf: *mut mach_ir.MachFunc,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    bbid: u32,
    sp: span.Span,
) -> !OutOfMemory {
    let lplan = try try_analyze_avx2_soa_loop(alloc, eir_prog, env, ctx, bbid);
    errdefer lplan.destroy(alloc);
    let did_soa = lplan.ok;
    if did_soa {
        let v_pre = try emit_avx2_soa_preloop(alloc, ctx, mf, eir_prog, env, &lplan, sp);
        try ctx.avx2_loops.push(alloc, Avx2LoopEntry.{
            hdr_bb: lplan.hdr_bb,
            pre_bb: lplan.pre_bb,
            latch_bb: lplan.latch_bb,
            body_bb: lplan.body_bb,
            exit_bb: lplan.exit_bb,
            ind_val: lplan.ind_val,
            start_val: lplan.start_val,
            bound_val: lplan.bound_val,
            v_pre_mbb: v_pre,
        });
    }
    if !did_soa {
        let did_2d = try try_emit_avx2_2d_fma_tile_loop(alloc, ctx, mf, eir_prog, env, bbid, sp);
        if !did_2d {
            try try_emit_avx2_vec_fma_loop(alloc, ctx, mf, eir_prog, env, bbid, sp);
        }
    }
    lplan.destroy(alloc);
    return;
}

pub fn lower_fn_to_mach_ir(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    fn_sym_id: u32,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    cfg: eir.EirOptConfig,
    sanitize: bool,
    is_linux: bool,
    mf: *mut mach_ir.MachFunc,
) -> IselResult ! OutOfMemory {
    if !precheck_fn_eligible(eir_prog, fn_id, env) {
        return IselResult.{ ok: false, uses_avx2_loop: false };
    }
    let f = eir_prog.get_fn(fn_id) orelse {
        return IselResult.{ ok: false, uses_avx2_loop: false };
    };

    mf.target_avx2 = cfg.target_avx2;
    var ctx = try init_ctx_and_plan(alloc, eir_prog, fn_id, fn_sym_id, env, cfg, sanitize, is_linux, mf);
    errdefer ctx.destroy(alloc);

    // Phase A: Detect & emit 8-wide AVX2 SoA pre-loops (Super-Opt #3) BEFORE lowering EIR blocks!
    if cfg.target_avx2 && cfg.opt_level >= 2_u8 && !cfg.opt_size {
        let blks = eir_prog.fn_blocks(fn_id);
        var bi: usize = 0_usize;
        while bi < blks.len {
            let bbid = bi.trunc.[u32]();
            try try_emit_avx2_loop_for_block(alloc, &mut ctx, mf, eir_prog, env, bbid, f.body_span);
            bi = bi +% 1_usize;
        }
    }

    // Phase B: Lower every EIR block in RPO order (with prologue param reception in entry block)
    let rpo = eir_prog.fn_rpo(fn_id);
    let blks = eir_prog.fn_blocks(fn_id);
    var visited = try col.BitSet.init(alloc, blks.len);
    errdefer visited.destroy(alloc);

    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bbid = rpo[ri];
        let bidx = bbid.widen.[usize]();
        if bidx < blks.len && !visited.test(bidx) {
            visited.set(bidx);
            let mbb = ctx_mbb_for_eir(&ctx, bbid);
            ctx.cur_mbb = mbb;
            ctx.cur_depth = eir_prog.block_depth(fn_id, bbid);
            mf.begin_block_insts(mbb);
            if bbid == f.entry {
                try emit_receive_params(alloc, &mut ctx, mf, eir_prog, env, f.body_span);
            }
            let blk = blks[bidx];
            let insts = eir_prog.insts_slice(blk.insts);
            var ii: usize = 0_usize;
            while ii < insts.len {
                let inst = insts[ii];
                let gid = blk.insts.start +% ii.trunc.[u32]();
                try emit_eir_inst(alloc, &mut ctx, mf, eir_prog, env, ct, interner, gid, &inst);
                ii = ii +% 1_usize;
            }
            if bbid == f.entry && ctx.hoisted_cols_cnt > 0_usize {
                try emit_hoisted_pool_cols(alloc, &mut ctx, mf, eir_prog, env, f.body_span);
            }
            try emit_eir_term(alloc, &mut ctx, mf, eir_prog, env, interner, bbid, &blk.term);
        }
        ri = ri +% 1_usize;
    }

    // Ensure any unreachable blocks still have valid explicit terminator (Ud2) for mach_regalloc
    var bi: usize = 0_usize;
    while bi < blks.len {
        if !visited.test(bi) {
            let bbid = bi.trunc.[u32]();
            let mbb = ctx_mbb_for_eir(&ctx, bbid);
            mf.begin_block_insts(mbb);
            try mf.emit_inst(alloc, mach_ir.inst_empty(.Ud2, f.body_span));
            mf.end_block_insts(mbb);
        }
        bi = bi +% 1_usize;
    }

    let used_avx2 = ctx.uses_avx2_loop;
    visited.destroy(alloc);
    ctx.destroy(alloc);

    return IselResult.{ ok: true, uses_avx2_loop: used_avx2 };
}
