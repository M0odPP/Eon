module eonc.parser;

import core.col;
import core.str;
import eonc.span;
import eonc.diag;
import eonc.tok;
import eonc.lexer;
import eonc.ast;

// ---------------------------------------------------------------------------
// Constants, Precedence Categories, and Small Value Results
// ---------------------------------------------------------------------------

const MAX_RECURSION_DEPTH: u32 = 128_u32;

enum PrecCat : u8 {
    Other = 0,
    Bitwise = 1,
    Arith = 2,
    Cmp = 3,
    LogAnd = 4,
    LogOr = 5,
}

struct InfixInfo {
    op: ast.BinaryOp;
    l_bp: u8;
    r_bp: u8;
    cat: PrecCat;
}

struct ExprPrec {
    id: u32;
    cat: PrecCat;
}

struct ModuleHeader {
    path: ast.IdRange;
    is_hal: bool;
    has_hal_span: bool;
    hal_span: span.Span;
}

struct ParamName {
    ident: ast.IdentSpan;
    is_self: bool;
}

struct BorrowTargetRes {
    kind: ast.BorrowTargetKind;
    inner: u32;
}

struct CatchRhs {
    kind: ast.BodyKind;
    id: u32;
    span: span.Span;
}

struct MatchParts {
    scrutinee: u32;
    arms: ast.IdRange;
    end_span: span.Span;
}

struct ExternKindRes {
    ok: bool;
    kind: ast.DeclKind;
    payload: u32;
}

struct RangeEndRes {
    has_range: bool;
    range_kind: ast.RangeKind;
    end_expr: u32;
}

fn truncate_buf[T](buf: *mut col.DynBuf[T], mark: usize) {
    while buf.len() > mark {
        _ = buf.pop();
    }
}

view fn slice_from[T](all: *[T], mark: usize) -> *[T] {
    let s = all.sub(mark, all.len) catch {
        return all.sub(0_usize, 0_usize) catch {
            return all;
        };
    };
    return s;
}

view fn slice_span_bytes(src: *[u8], sp: span.Span) -> *[u8] {
    let empty: *str = "";
    let s = src.sub(sp.start.widen.[usize](), sp.end.widen.[usize]()) catch {
        return empty.as_bytes();
    };
    return s;
}

// ---------------------------------------------------------------------------
// Reusable LIFO Scratch Stacks (zero per-node heap allocations during parse)
// ---------------------------------------------------------------------------

linear struct ScratchMeta {
    imports: col.DynBuf[ast.ImportNode];
    import_items: col.DynBuf[ast.ImportItemNode];
    attrs: col.DynBuf[ast.AttrNode];
    attr_args: col.DynBuf[ast.AttrArgNode];
    idents: col.DynBuf[ast.IdentSpan];
    generic_params: col.DynBuf[ast.GenericParamNode];
    generic_args: col.DynBuf[ast.GenericArgNode];
    decl_ids: col.DynBuf[u32];
}

impl ScratchMeta {
    fn init(alloc: *mut AllocCap) -> ScratchMeta ! OutOfMemory {
        let imports = try col.DynBuf.[ast.ImportNode].init(alloc, 16_usize);
        errdefer imports.destroy(alloc);
        let import_items = try col.DynBuf.[ast.ImportItemNode].init(alloc, 16_usize);
        errdefer import_items.destroy(alloc);
        let attrs = try col.DynBuf.[ast.AttrNode].init(alloc, 16_usize);
        errdefer attrs.destroy(alloc);
        let attr_args = try col.DynBuf.[ast.AttrArgNode].init(alloc, 16_usize);
        errdefer attr_args.destroy(alloc);
        let idents = try col.DynBuf.[ast.IdentSpan].init(alloc, 32_usize);
        errdefer idents.destroy(alloc);
        let generic_params = try col.DynBuf.[ast.GenericParamNode].init(alloc, 16_usize);
        errdefer generic_params.destroy(alloc);
        let generic_args = try col.DynBuf.[ast.GenericArgNode].init(alloc, 16_usize);
        errdefer generic_args.destroy(alloc);
        let decl_ids = try col.DynBuf.[u32].init(alloc, 64_usize);
        errdefer decl_ids.destroy(alloc);
        return ScratchMeta.{
            imports: imports,
            import_items: import_items,
            attrs: attrs,
            attr_args: attr_args,
            idents: idents,
            generic_params: generic_params,
            generic_args: generic_args,
            decl_ids: decl_ids,
        };
    }

    fn destroy(self: ScratchMeta, alloc: *mut AllocCap) {
        let ScratchMeta.{
            imports,
            import_items,
            attrs,
            attr_args,
            idents,
            generic_params,
            generic_args,
            decl_ids,
        } = self;
        imports.destroy(alloc);
        import_items.destroy(alloc);
        attrs.destroy(alloc);
        attr_args.destroy(alloc);
        idents.destroy(alloc);
        generic_params.destroy(alloc);
        generic_args.destroy(alloc);
        decl_ids.destroy(alloc);
    }
}

linear struct ScratchDecl {
    params: col.DynBuf[ast.ParamNode];
    sys_params: col.DynBuf[ast.SysParamNode];
    fields: col.DynBuf[ast.FieldNode];
    enum_variants: col.DynBuf[ast.EnumVariantNode];
    union_variants: col.DynBuf[ast.UnionVariantNode];
    bitfield_members: col.DynBuf[ast.BitfieldMemberNode];
    iface_methods: col.DynBuf[ast.IfaceMethodNode];
    asm_ops: col.DynBuf[ast.AsmOperandNode];
}

impl ScratchDecl {
    fn init(alloc: *mut AllocCap) -> ScratchDecl ! OutOfMemory {
        let params = try col.DynBuf.[ast.ParamNode].init(alloc, 16_usize);
        errdefer params.destroy(alloc);
        let sys_params = try col.DynBuf.[ast.SysParamNode].init(alloc, 8_usize);
        errdefer sys_params.destroy(alloc);
        let fields = try col.DynBuf.[ast.FieldNode].init(alloc, 32_usize);
        errdefer fields.destroy(alloc);
        let enum_variants = try col.DynBuf.[ast.EnumVariantNode].init(alloc, 32_usize);
        errdefer enum_variants.destroy(alloc);
        let union_variants = try col.DynBuf.[ast.UnionVariantNode].init(alloc, 16_usize);
        errdefer union_variants.destroy(alloc);
        let bitfield_members = try col.DynBuf.[ast.BitfieldMemberNode].init(alloc, 8_usize);
        errdefer bitfield_members.destroy(alloc);
        let iface_methods = try col.DynBuf.[ast.IfaceMethodNode].init(alloc, 16_usize);
        errdefer iface_methods.destroy(alloc);
        let asm_ops = try col.DynBuf.[ast.AsmOperandNode].init(alloc, 8_usize);
        errdefer asm_ops.destroy(alloc);
        return ScratchDecl.{
            params: params,
            sys_params: sys_params,
            fields: fields,
            enum_variants: enum_variants,
            union_variants: union_variants,
            bitfield_members: bitfield_members,
            iface_methods: iface_methods,
            asm_ops: asm_ops,
        };
    }

    fn destroy(self: ScratchDecl, alloc: *mut AllocCap) {
        let ScratchDecl.{
            params,
            sys_params,
            fields,
            enum_variants,
            union_variants,
            bitfield_members,
            iface_methods,
            asm_ops,
        } = self;
        params.destroy(alloc);
        sys_params.destroy(alloc);
        fields.destroy(alloc);
        enum_variants.destroy(alloc);
        union_variants.destroy(alloc);
        bitfield_members.destroy(alloc);
        iface_methods.destroy(alloc);
        asm_ops.destroy(alloc);
    }
}

linear struct ScratchTree {
    type_ids: col.DynBuf[u32];
    pat_ids: col.DynBuf[u32];
    pat_fields: col.DynBuf[ast.PatFieldNode];
    stmt_ids: col.DynBuf[u32];
    match_arms: col.DynBuf[ast.MatchArmNode];
    expr_ids: col.DynBuf[u32];
    field_inits: col.DynBuf[ast.FieldInitNode];
}

impl ScratchTree {
    fn init(alloc: *mut AllocCap) -> ScratchTree ! OutOfMemory {
        let type_ids = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer type_ids.destroy(alloc);
        let pat_ids = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer pat_ids.destroy(alloc);
        let pat_fields = try col.DynBuf.[ast.PatFieldNode].init(alloc, 16_usize);
        errdefer pat_fields.destroy(alloc);
        let stmt_ids = try col.DynBuf.[u32].init(alloc, 64_usize);
        errdefer stmt_ids.destroy(alloc);
        let match_arms = try col.DynBuf.[ast.MatchArmNode].init(alloc, 16_usize);
        errdefer match_arms.destroy(alloc);
        let expr_ids = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer expr_ids.destroy(alloc);
        let field_inits = try col.DynBuf.[ast.FieldInitNode].init(alloc, 16_usize);
        errdefer field_inits.destroy(alloc);
        return ScratchTree.{
            type_ids: type_ids,
            pat_ids: pat_ids,
            pat_fields: pat_fields,
            stmt_ids: stmt_ids,
            match_arms: match_arms,
            expr_ids: expr_ids,
            field_inits: field_inits,
        };
    }

    fn destroy(self: ScratchTree, alloc: *mut AllocCap) {
        let ScratchTree.{
            type_ids,
            pat_ids,
            pat_fields,
            stmt_ids,
            match_arms,
            expr_ids,
            field_inits,
        } = self;
        type_ids.destroy(alloc);
        pat_ids.destroy(alloc);
        pat_fields.destroy(alloc);
        stmt_ids.destroy(alloc);
        match_arms.destroy(alloc);
        expr_ids.destroy(alloc);
        field_inits.destroy(alloc);
    }
}

linear struct ParseScratch {
    meta: ScratchMeta;
    decl: ScratchDecl;
    tree: ScratchTree;
}

impl ParseScratch {
    fn init(alloc: *mut AllocCap) -> ParseScratch ! OutOfMemory {
        let meta = try ScratchMeta.init(alloc);
        errdefer meta.destroy(alloc);
        let decl = try ScratchDecl.init(alloc);
        errdefer decl.destroy(alloc);
        let tree = try ScratchTree.init(alloc);
        errdefer tree.destroy(alloc);
        return ParseScratch.{ meta: meta, decl: decl, tree: tree };
    }

    fn destroy(self: ParseScratch, alloc: *mut AllocCap) {
        let ParseScratch.{ meta, decl, tree } = self;
        meta.destroy(alloc);
        decl.destroy(alloc);
        tree.destroy(alloc);
    }
}

// ---------------------------------------------------------------------------
// Token Classification & Operator Precedence Tables
// ---------------------------------------------------------------------------

fn is_base_type_start(kind: tok.TokenKind) -> bool {
    match kind {
        .Question => { return true; }
        .Star => { return true; }
        .LBracket => { return true; }
        .KwDyn => { return true; }
        .KwFn => { return true; }
        .KwStruct => { return true; }
        .LParen => { return true; }
        .KwVoid => { return true; }
        .KwNever => { return true; }
        .KwType => { return true; }
        .KwSelfType => { return true; }
        .Ident => { return true; }
        _ => { return false; }
    }
}

fn is_stmt_sync_stop(kind: tok.TokenKind) -> bool {
    match kind {
        .RBrace => { return true; }
        .KwFn => { return true; }
        .KwSys => { return true; }
        .KwStruct => { return true; }
        .KwPool => { return true; }
        .KwEnum => { return true; }
        .KwUnion => { return true; }
        .KwBitfield => { return true; }
        .KwIface => { return true; }
        .KwImpl => { return true; }
        .KwError => { return true; }
        .KwType => { return true; }
        .KwConst => { return true; }
        .KwPub => { return true; }
        .KwLet => { return true; }
        .KwVar => { return true; }
        .KwReturn => { return true; }
        .KwIf => { return true; }
        .KwMatch => { return true; }
        .KwWhile => { return true; }
        .KwFor => { return true; }
        .KwPar => { return true; }
        .KwLoop => { return true; }
        .KwDefer => { return true; }
        .KwErrdefer => { return true; }
        _ => { return false; }
    }
}

fn is_decl_sync_stop(kind: tok.TokenKind) -> bool {
    match kind {
        .At => { return true; }
        .KwPub => { return true; }
        .KwFn => { return true; }
        .KwSys => { return true; }
        .KwStruct => { return true; }
        .KwLinear => { return true; }
        .KwPool => { return true; }
        .KwEnum => { return true; }
        .KwUnion => { return true; }
        .KwBitfield => { return true; }
        .KwIface => { return true; }
        .KwImpl => { return true; }
        .KwError => { return true; }
        .KwType => { return true; }
        .KwConst => { return true; }
        .KwExtern => { return true; }
        .KwComptime => { return true; }
        .KwView => { return true; }
        .RBrace => { return true; }
        _ => { return false; }
    }
}

fn is_value_builtin_name(bytes: *[u8]) -> bool {
    return str.bytes_eq(bytes, "sqrt".as_bytes())
        || str.bytes_eq(bytes, "fma".as_bytes())
        || str.bytes_eq(bytes, "lzcnt".as_bytes())
        || str.bytes_eq(bytes, "tzcnt".as_bytes())
        || str.bytes_eq(bytes, "popcnt".as_bytes())
        || str.bytes_eq(bytes, "bswap".as_bytes());
}

fn is_tuple_type_disqualifying_op(kind: tok.TokenKind) -> bool {
    match kind {
        .Plus => { return true; }
        .Minus => { return true; }
        .Slash => { return true; }
        .Percent => { return true; }
        .EqEq => { return true; }
        .NotEq => { return true; }
        .Lt => { return true; }
        .Gt => { return true; }
        .AndAnd => { return true; }
        .OrOr => { return true; }
        .Amp => { return true; }
        .Pipe => { return true; }
        .Caret => { return true; }
        .Shl => { return true; }
        .Shr => { return true; }
        _ => { return false; }
    }
}

fn infix_binding_power(kind: tok.TokenKind) -> ?InfixInfo {
    match kind {
        .Star => { return InfixInfo.{ op: .Mul, l_bp: 21_u8, r_bp: 22_u8, cat: .Arith }; }
        .Slash => { return InfixInfo.{ op: .Div, l_bp: 21_u8, r_bp: 22_u8, cat: .Arith }; }
        .Percent => { return InfixInfo.{ op: .Mod, l_bp: 21_u8, r_bp: 22_u8, cat: .Arith }; }
        .StarWrap => { return InfixInfo.{ op: .MulWrap, l_bp: 21_u8, r_bp: 22_u8, cat: .Arith }; }
        .StarSat => { return InfixInfo.{ op: .MulSat, l_bp: 21_u8, r_bp: 22_u8, cat: .Arith }; }
        .StarCheck => { return InfixInfo.{ op: .MulCheck, l_bp: 21_u8, r_bp: 22_u8, cat: .Arith }; }
        .SlashCheck => { return InfixInfo.{ op: .DivCheck, l_bp: 21_u8, r_bp: 22_u8, cat: .Arith }; }
        .PercentCheck => { return InfixInfo.{ op: .ModCheck, l_bp: 21_u8, r_bp: 22_u8, cat: .Arith }; }

        .Plus => { return InfixInfo.{ op: .Add, l_bp: 19_u8, r_bp: 20_u8, cat: .Arith }; }
        .Minus => { return InfixInfo.{ op: .Sub, l_bp: 19_u8, r_bp: 20_u8, cat: .Arith }; }
        .PlusWrap => { return InfixInfo.{ op: .AddWrap, l_bp: 19_u8, r_bp: 20_u8, cat: .Arith }; }
        .MinusWrap => { return InfixInfo.{ op: .SubWrap, l_bp: 19_u8, r_bp: 20_u8, cat: .Arith }; }
        .PlusSat => { return InfixInfo.{ op: .AddSat, l_bp: 19_u8, r_bp: 20_u8, cat: .Arith }; }
        .MinusSat => { return InfixInfo.{ op: .SubSat, l_bp: 19_u8, r_bp: 20_u8, cat: .Arith }; }
        .PlusCheck => { return InfixInfo.{ op: .AddCheck, l_bp: 19_u8, r_bp: 20_u8, cat: .Arith }; }
        .MinusCheck => { return InfixInfo.{ op: .SubCheck, l_bp: 19_u8, r_bp: 20_u8, cat: .Arith }; }

        .Shl => { return InfixInfo.{ op: .Shl, l_bp: 17_u8, r_bp: 18_u8, cat: .Bitwise }; }
        .Shr => { return InfixInfo.{ op: .Shr, l_bp: 17_u8, r_bp: 18_u8, cat: .Bitwise }; }
        .ShlWrap => { return InfixInfo.{ op: .ShlWrap, l_bp: 17_u8, r_bp: 18_u8, cat: .Bitwise }; }

        .Amp => { return InfixInfo.{ op: .BitAnd, l_bp: 15_u8, r_bp: 16_u8, cat: .Bitwise }; }
        .Caret => { return InfixInfo.{ op: .BitXor, l_bp: 13_u8, r_bp: 14_u8, cat: .Bitwise }; }
        .Pipe => { return InfixInfo.{ op: .BitOr, l_bp: 11_u8, r_bp: 12_u8, cat: .Bitwise }; }

        .EqEq => { return InfixInfo.{ op: .Eq, l_bp: 9_u8, r_bp: 10_u8, cat: .Cmp }; }
        .NotEq => { return InfixInfo.{ op: .NotEq, l_bp: 9_u8, r_bp: 10_u8, cat: .Cmp }; }
        .Lt => { return InfixInfo.{ op: .Lt, l_bp: 9_u8, r_bp: 10_u8, cat: .Cmp }; }
        .LtEq => { return InfixInfo.{ op: .LtEq, l_bp: 9_u8, r_bp: 10_u8, cat: .Cmp }; }
        .Gt => { return InfixInfo.{ op: .Gt, l_bp: 9_u8, r_bp: 10_u8, cat: .Cmp }; }
        .GtEq => { return InfixInfo.{ op: .GtEq, l_bp: 9_u8, r_bp: 10_u8, cat: .Cmp }; }

        .AndAnd => { return InfixInfo.{ op: .And, l_bp: 7_u8, r_bp: 8_u8, cat: .LogAnd }; }
        .OrOr => { return InfixInfo.{ op: .Or, l_bp: 5_u8, r_bp: 6_u8, cat: .LogOr }; }

        _ => { return null; }
    }
}

fn token_assign_op(kind: tok.TokenKind) -> ?ast.AssignOp {
    match kind {
        .Eq => { return .Assign; }
        .PlusEq => { return .AddAssign; }
        .MinusEq => { return .SubAssign; }
        .StarEq => { return .MulAssign; }
        .PlusWrapEq => { return .AddWrapAssign; }
        .MinusWrapEq => { return .SubWrapAssign; }
        .StarWrapEq => { return .MulWrapAssign; }
        .PlusSatEq => { return .AddSatAssign; }
        .MinusSatEq => { return .SubSatAssign; }
        .StarSatEq => { return .MulSatAssign; }
        .AmpEq => { return .BitAndAssign; }
        .PipeEq => { return .BitOrAssign; }
        .CaretEq => { return .BitXorAssign; }
        .ShlEq => { return .ShlAssign; }
        .ShrEq => { return .ShrAssign; }
        _ => { return null; }
    }
}

// ---------------------------------------------------------------------------
// Parser State (second-class `view struct`, passed by `*mut Parser`)
// ---------------------------------------------------------------------------

view struct Parser {
    alloc: *mut AllocCap;
    fid: u32;
    profile: span.FileProfile;
    src: *[u8];
    lexed: *lexer.LexOutput;
    tokens: *[tok.Token];
    pos: usize;
    interner: *mut span.SymInterner;
    diags: *mut diag.DiagBag;
    arena: *mut ast.AstArena;
    scratch: *mut ParseScratch;
    msg_buf: *mut str.StrBuf;
    depth: u32;
    allow_return_as_expr: bool;
    in_ensures_or_where: bool;
}

impl Parser {
    // --- Token navigation & spans ---

    fn cur(self: *Self) -> tok.Token {
        if self.pos < self.tokens.len {
            return self.tokens[self.pos];
        }
        if self.tokens.len > 0_usize {
            return self.tokens[self.tokens.len - 1_usize];
        }
        return tok.Token.simple(.Eof, 0_u32, 0_u32);
    }

    fn kind(self: *Self) -> tok.TokenKind {
        return self.cur().kind;
    }

    fn peek_kind(self: *Self, offset: usize) -> tok.TokenKind {
        if offset < self.tokens.len && self.pos < self.tokens.len - offset {
            return self.tokens[self.pos + offset].kind;
        }
        return .Eof;
    }

    fn tok_span(self: *Self, t: tok.Token) -> span.Span {
        return span.span_new(self.fid, t.start, t.end);
    }

    fn span(self: *Self) -> span.Span {
        return self.tok_span(self.cur());
    }

    view fn slice(self: *Self, sp: span.Span) -> *[u8] {
        let empty: *str = "";
        let s = self.src.sub(sp.start.widen.[usize](), sp.end.widen.[usize]()) catch {
            return empty.as_bytes();
        };
        return s;
    }

    fn at(self: *Self, k: tok.TokenKind) -> bool {
        return self.kind() == k;
    }

    fn at_eof(self: *Self) -> bool {
        return self.kind() == .Eof;
    }

    fn bump(self: *mut Self) -> tok.Token {
        let t = self.cur();
        if self.tokens.len > 1_usize && self.pos < self.tokens.len - 1_usize {
            self.pos = self.pos +% 1_usize;
        }
        return t;
    }

    fn eat(self: *mut Self, k: tok.TokenKind) -> bool {
        if self.at(k) {
            _ = self.bump();
            return true;
        }
        return false;
    }

    fn prev_end_span(self: *Self) -> span.Span {
        if self.pos > 0_usize && self.pos <= self.tokens.len {
            return self.tok_span(self.tokens[self.pos - 1_usize]);
        }
        return self.span();
    }

    fn enter_depth(self: *mut Self) -> bool ! OutOfMemory {
        if self.depth >= MAX_RECURSION_DEPTH {
            _ = try self.diags.emit_error(
                self.alloc,
                diag.E0005,
                self.span(),
                "maximum syntactic nesting depth exceeded",
            );
            return false;
        }
        self.depth = self.depth +% 1_u32;
        return true;
    }

    fn leave_depth(self: *mut Self) {
        if self.depth > 0_u32 {
            self.depth = self.depth - 1_u32;
        }
    }

    // --- Arena span accessors ---

    fn expr_span(self: *Self, id: u32) -> span.Span {
        if let e = self.arena.get_expr(id) {
            return e.span;
        }
        return self.span();
    }

    fn type_span(self: *Self, id: u32) -> span.Span {
        if let t = self.arena.get_type(id) {
            return t.span;
        }
        return self.span();
    }

    fn pat_span(self: *Self, id: u32) -> span.Span {
        if let p = self.arena.get_pat(id) {
            return p.span;
        }
        return self.span();
    }

    fn block_span(self: *Self, id: u32) -> span.Span {
        if let b = self.arena.get_block(id) {
            return b.span;
        }
        return self.span();
    }

    fn if_span(self: *Self, id: u32) -> span.Span {
        if let n = self.arena.get_if(id) {
            return n.span;
        }
        return self.span();
    }

    fn if_has_else(self: *Self, id: u32) -> bool {
        if let n = self.arena.get_if(id) {
            return n.else_kind != .None;
        }
        return false;
    }

    // --- Scratch stack committers ---

    fn commit_imports(self: *mut Self, mark: usize) -> ast.IdRange ! OutOfMemory {
        var r = ast.range_empty();
        if self.scratch.meta.imports.len() > mark {
            let sub = slice_from.[ast.ImportNode](self.scratch.meta.imports.as_slice(), mark);
            r = try self.arena.push_imports(self.alloc, sub);
        }
        truncate_buf.[ast.ImportNode](&mut self.scratch.meta.imports, mark);
        return r;
    }

    fn commit_import_items(self: *mut Self, mark: usize) -> ast.IdRange ! OutOfMemory {
        var r = ast.range_empty();
        if self.scratch.meta.import_items.len() > mark {
            let sub = slice_from.[ast.ImportItemNode](self.scratch.meta.import_items.as_slice(), mark);
            r = try self.arena.push_import_items(self.alloc, sub);
        }
        truncate_buf.[ast.ImportItemNode](&mut self.scratch.meta.import_items, mark);
        return r;
    }

    fn commit_attrs(self: *mut Self, mark: usize) -> ast.IdRange ! OutOfMemory {
