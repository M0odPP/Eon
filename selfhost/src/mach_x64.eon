    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 40_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 48_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 16_i32, .Rax, 8_usize);
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_read_err);
    try cg.buf.add_ri32(alloc, .Rsp, 4096_i32);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 96_i32, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 24_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp +% 48_i32, 8_usize, false);
    try cg_call_free_raw(alloc, cg, interner);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg_helper_call(alloc, cg, interner, "eon_rt_close_fd");
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 96_i32, 8_usize, false);
    try cg.buf.jmp_label(alloc, l_open_err);

    cg.buf.bind_label(l_oom_free);
    try cg.buf.add_ri32(alloc, .Rsp, 4096_i32);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 24_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp +% 48_i32, 8_usize, false);
    try cg_call_free_raw(alloc, cg, interner);
    cg.buf.bind_label(l_oom_close);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg_helper_call(alloc, cg, interner, "eon_rt_close_fd");
    try cg.buf.mov_ri64(alloc, .Rax, 7_u64);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg_emit_memzero(alloc, cg, .Rbp, doff +% ok_off, 24_usize);
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_inval);
    try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFFFFFFFFEA_u64);
    cg.buf.bind_label(l_open_err);
    try cg.buf.mov_rr(alloc, .Rdi, .Rax);
    try cg_emit_map_errno(alloc, cg, .Rdi, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg_emit_memzero(alloc, cg, .Rbp, doff +% ok_off, 24_usize);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_io_nop_roundtrip(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    count_v: eir.EirValue,
    ret_ty: types.TyId,
) -> !OutOfMemory {
    let doff = cg_val_stack_off(cg, dst);
    let ok_ty = env.get(ret_ty).primary;
    let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
    let tmp = cg.frame.temp_copy_off;
    let l_zero = try cg.buf.new_label(alloc);
    let l_fail_close = try cg.buf.new_label(alloc);
    let l_fail = try cg.buf.new_label(alloc);
    let l_batch = try cg.buf.new_label(alloc);
    let l_ring_ok = try cg.buf.new_label(alloc);
    let l_done = try cg.buf.new_label(alloc);

    try cg_load_scalar_val(alloc, cg, eir_prog, env, count_v, .Rax);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_zero);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 8_i32, .Rax, 8_usize);
    try cg.buf.xor_rr32(alloc, .Rcx, .Rcx);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 16_i32, .Rcx, 8_usize);
    try cg.buf.mov_ri64(alloc, .Rdi, 64_u64);
    try cg_helper_call(alloc, cg, interner, "eon_iouring_create");
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_fail);
    try cg.buf.store_mem(alloc, .Rbp, tmp, .Rax, 8_usize);

    cg.buf.bind_label(l_batch);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp +% 8_i32, 8_usize, false);
    try cg.buf.test_rr(alloc, .Rcx, .Rcx);
    try cg.buf.jcc_label(alloc, .E, l_ring_ok);
    try cg.buf.load_mem(alloc, .R8, .Rbp, tmp, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rdx, .R8, 120_i32, 8_usize, false);
    try cg.buf.cmp_rr(alloc, .Rcx, .Rdx);
    try cg.buf.cmovcc(alloc, .A, .Rcx, .Rdx);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 24_i32, .Rcx, 8_usize);

    try cg.buf.load_mem(alloc, .R9, .R8, 64_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .R9, .R9, 0_i32, 4_usize, false);
    try cg.buf.load_mem(alloc, .R10, .R8, 72_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .R11, .R8, 40_i32, 8_usize, false);
    try cg.buf.xor_rr32(alloc, .Rdi, .Rdi);
    let l_fill = try cg.buf.new_label(alloc);
    let l_fill_done = try cg.buf.new_label(alloc);
    cg.buf.bind_label(l_fill);
    try cg.buf.cmp_rr(alloc, .Rdi, .Rcx);
    try cg.buf.jcc_label(alloc, .Ae, l_fill_done);
    try cg.buf.mov_rr(alloc, .Rax, .R9);
    try cg.buf.add_rr(alloc, .Rax, .Rdi);
    try cg.buf.and_rr(alloc, .Rax, .R10);
    try cg.buf.mov_rr(alloc, .Rsi, .Rax);
    try cg.buf.shl_imm(alloc, .Rsi, 6_u8);
    try cg.buf.add_rr(alloc, .Rsi, .R11);
    try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
    var qoff: i32 = 0_i32;
    while qoff < 64_i32 {
        try cg.buf.store_mem(alloc, .Rsi, qoff, .Rdx, 8_usize);
        qoff = qoff +% 8_i32;
    }
    try cg.buf.load_mem(alloc, .Rsi, .R8, 80_i32, 8_usize, false);
    try cg.buf.mov_rr(alloc, .Rdx, .Rax);
    try cg.buf.shl_imm(alloc, .Rdx, 2_u8);
    try cg.buf.add_rr(alloc, .Rsi, .Rdx);
    try cg.buf.store_mem(alloc, .Rsi, 0_i32, .Rax, 4_usize);
    try cg.buf.add_ri32(alloc, .Rdi, 1_i32);
    try cg.buf.jmp_label(alloc, l_fill);
    cg.buf.bind_label(l_fill_done);

    try cg.buf.sfence(alloc);
    try cg.buf.add_rr(alloc, .R9, .Rcx);
    try cg.buf.load_mem(alloc, .Rdx, .R8, 64_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rdx, 0_i32, .R9, 4_usize);

    try cg.buf.load_mem(alloc, .Rdi, .R8, 0_i32, 8_usize, false);
    try cg.buf.mov_rr(alloc, .Rsi, .Rcx);
    try cg.buf.mov_rr(alloc, .Rdx, .Rcx);
    try cg.buf.mov_ri64(alloc, .R10, 1_u64);
    try cg.buf.xor_rr32(alloc, .R8, .R8);
    try cg.buf.xor_rr32(alloc, .R9, .R9);
    try cg.buf.mov_ri64(alloc, .Rax, 426_u64);
    try cg.buf.syscall(alloc);
    try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
    try cg.buf.jcc_label(alloc, .L, l_fail_close);

    try cg.buf.load_mem(alloc, .R8, .Rbp, tmp, 8_usize, false);
    try cg.buf.load_mem(alloc, .R9, .R8, 88_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .R10, .R9, 0_i32, 4_usize, false);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp +% 24_i32, 8_usize, false);
    try cg.buf.add_rr(alloc, .R10, .Rcx);
    try cg.buf.store_mem(alloc, .R9, 0_i32, .R10, 4_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg.buf.add_rr(alloc, .Rax, .Rcx);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 16_i32, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 8_i32, 8_usize, false);
    try cg.buf.sub_rr(alloc, .Rax, .Rcx);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 8_i32, .Rax, 8_usize);
    try cg.buf.jmp_label(alloc, l_batch);

    cg.buf.bind_label(l_ring_ok);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp, 8_usize, false);
    try cg_helper_call(alloc, cg, interner, "eon_iouring_destroy");
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_zero);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_fail_close);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 32_i32, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp, 8_usize, false);
    try cg_helper_call(alloc, cg, interner, "eon_iouring_destroy");
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg_emit_map_errno(alloc, cg, .Rdi, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_fail);
    try cg.buf.mov_ri64(alloc, .Rax, 17_u64);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_builtin_sys_io(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
) -> !OutOfMemory {
    match op.kind {
        .ClockNowNs => {
            try cg_helper_call(alloc, cg, interner, "eon_rt_now_ns");
            if dst != eir.EIR_NONE { try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax); }
        }
        .ArgsLen => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .ArgsGet => {
            if args.len < 2_usize { return; }
            let doff = cg_val_stack_off(cg, dst);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .R9, .R8, 0_i32, 8_usize, false);
            try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R10);
            let l_oob = try cg.buf.new_label(alloc);
            let l_strlen = try cg.buf.new_label(alloc);
            let l_strlen_done = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, .R10, .R9);
            try cg.buf.jcc_label(alloc, .Ae, l_oob);
            try cg.buf.load_mem(alloc, .R11, .R8, 8_i32, 8_usize, false);
            try cg.buf.shl_imm(alloc, .R10, 3_u8);
            try cg.buf.add_rr(alloc, .R11, .R10);
            try cg.buf.load_mem(alloc, .Rax, .R11, 0_i32, 8_usize, false);
            try cg.buf.test_rr(alloc, .Rax, .Rax);
            try cg.buf.jcc_label(alloc, .E, l_oob);
            try cg.buf.xor_rr32(alloc, .Rcx, .Rcx);
            cg.buf.bind_label(l_strlen);
            try cg.buf.mov_rr(alloc, .Rdi, .Rax);
            try cg.buf.add_rr(alloc, .Rdi, .Rcx);
            try cg.buf.load_mem(alloc, .Rdx, .Rdi, 0_i32, 1_usize, false);
            try cg.buf.test_rr32(alloc, .Rdx, .Rdx);
            try cg.buf.jcc_label(alloc, .E, l_strlen_done);
            try cg.buf.add_ri32(alloc, .Rcx, 1_i32);
            try cg.buf.jmp_label(alloc, l_strlen);
            cg.buf.bind_label(l_strlen_done);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% 8_i32, .Rcx, 8_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 8_usize);
            try cg.buf.mov_ri64(alloc, .Rcx, 0xFFFFFFFFFFFFFFFF_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff +% 8_i32, .Rcx, 8_usize);
            cg.buf.bind_label(l_done);
        }
        .FsOpenDir => { try cg_emit_fs_open_dir(alloc, cg, eir_prog, env, interner, false, dst, args, arg_slots, ret_ty); }
        .DirSubDir => { try cg_emit_fs_open_dir(alloc, cg, eir_prog, env, interner, true, dst, args, arg_slots, ret_ty); }
        .FsReadFile => { try cg_emit_fs_read_file(alloc, cg, eir_prog, env, interner, false, dst, args, arg_slots, ret_ty); }
        .DirReadFile => { try cg_emit_fs_read_file(alloc, cg, eir_prog, env, interner, true, dst, args, arg_slots, ret_ty); }
        .FsWriteFile => { try cg_emit_fs_write_file(alloc, cg, eir_prog, env, interner, false, false, dst, args, arg_slots); }
        .DirWriteFile => { try cg_emit_fs_write_file(alloc, cg, eir_prog, env, interner, true, false, dst, args, arg_slots); }
        .FsWriteExecutable => { try cg_emit_fs_write_file(alloc, cg, eir_prog, env, interner, false, true, dst, args, arg_slots); }
        .FsIsDir => {
            if args.len < 2_usize { return; }
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rdi, .R8, 0_i32, 8_usize, false);
            let poff = cg_val_stack_off(cg, args[1_usize]);
            try cg.buf.load_mem(alloc, .Rsi, .Rbp, poff, 8_usize, false);
            try cg.buf.load_mem(alloc, .Rdx, .Rbp, poff +% 8_i32, 8_usize, false);
            try cg_helper_call(alloc, cg, interner, "eon_rt_is_dir");
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .FsMkdirAll => {
            if args.len < 2_usize { return; }
            let doff = cg_val_stack_off(cg, dst);
            let l_err = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rdi, .R8, 0_i32, 8_usize, false);
            let poff = cg_val_stack_off(cg, args[1_usize]);
            try cg.buf.load_mem(alloc, .Rsi, .Rbp, poff, 8_usize, false);
            try cg.buf.load_mem(alloc, .Rdx, .Rbp, poff +% 8_i32, 8_usize, false);
            try cg_helper_call(alloc, cg, interner, "eon_rt_mkdir_all");
            try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
            try cg.buf.jcc_label(alloc, .L, l_err);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_err);
            try cg.buf.mov_rr(alloc, .Rdi, .Rax);
            try cg_emit_map_errno(alloc, cg, .Rdi, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            cg.buf.bind_label(l_done);
        }
        .FsListDir => { try cg_emit_fs_list_dir(alloc, cg, eir_prog, env, interner, dst, args, arg_slots, ret_ty); }
        .FsSpawnWait => {
            if args.len < 3_usize { return; }
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let l_err = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            let poff = cg_val_stack_off(cg, args[1_usize]);
            try cg.buf.load_mem(alloc, .Rdi, .Rbp, poff, 8_usize, false);
            try cg.buf.load_mem(alloc, .Rsi, .Rbp, poff +% 8_i32, 8_usize, false);
            let aoff = cg_val_stack_off(cg, args[2_usize]);
            try cg.buf.load_mem(alloc, .Rdx, .Rbp, aoff, 8_usize, false);
            try cg.buf.load_mem(alloc, .Rcx, .Rbp, aoff +% 8_i32, 8_usize, false);
            try cg_helper_call(alloc, cg, interner, "eon_rt_spawn_wait");
            try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
            try cg.buf.jcc_label(alloc, .L, l_err);
            try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rdx, 4_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_err);
            try cg.buf.mov_rr(alloc, .Rdi, .Rax);
            try cg_emit_map_errno(alloc, cg, .Rdi, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 4_usize);
            cg.buf.bind_label(l_done);
        }
        .DirClose => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rdi, .R8, 0_i32, 8_usize, false);
            try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFFFFFFFFFF_u64);
            try cg.buf.store_mem(alloc, .R8, 0_i32, .Rax, 8_usize);
            let l_skip = try cg.buf.new_label(alloc);
            try cg.buf.cmp_ri32(alloc, .Rdi, 0_i32);
            try cg.buf.jcc_label(alloc, .L, l_skip);
            try cg_helper_call(alloc, cg, interner, "eon_rt_close_fd");
            cg.buf.bind_label(l_skip);
        }
        .NetRestrictHost => {
            if dst != eir.EIR_NONE {
                try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
                try cg.buf.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
                try cg.buf.add_ri32(alloc, .Rax, 1_i32);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            }
        }
        .IoNopRoundtrip => {
            if args.len > 1_usize {
                try cg_emit_io_nop_roundtrip(alloc, cg, eir_prog, env, interner, dst, args[1_usize], ret_ty);
            }
        }
        .IoRunFibers => {
            if args.len > 2_usize {
                try cg_emit_io_run_fibers(alloc, cg, eir_prog, env, interner, dst, args[1_usize], args[2_usize], ret_ty);
            }
        }
        .BuildOutPath => {
            if dst != eir.EIR_NONE {
                try cg_emit_memzero(alloc, cg, .Rbp, cg_val_stack_off(cg, dst), 16_usize);
            }
        }
        _ => {}
    }
    return;
}

fn cg_emit_fs_open_dir(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    confined: bool,
    dst: eir.EirValue,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
) -> !OutOfMemory {
    if args.len < 2_usize { return; }
    let doff = cg_val_stack_off(cg, dst);
    let ok_ty = env.get(ret_ty).primary;
    let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
    let l_inval = try cg.buf.new_label(alloc);
    let l_err = try cg.buf.new_label(alloc);
    let l_done = try cg.buf.new_label(alloc);
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg.buf.load_mem(alloc, .Rdi, .R8, 0_i32, 8_usize, false);
    // O_RDONLY | O_DIRECTORY | O_CLOEXEC = 0x90000
    try cg_emit_open_str(alloc, cg, interner, confined, .Rdi, args[1_usize], 0x90000_u64, 0_u64, l_inval);
    try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
    try cg.buf.jcc_label(alloc, .L, l_err);
    try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rdx, 4_usize);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    try cg.buf.jmp_label(alloc, l_done);
    cg.buf.bind_label(l_inval);
    try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFFFFFFFFEA_u64);
    cg.buf.bind_label(l_err);
    try cg.buf.mov_rr(alloc, .Rdi, .Rax);
    try cg_emit_map_errno(alloc, cg, .Rdi, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFFFFFFFFFF_u64);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_io_run_fibers(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    count_v: eir.EirValue,
    stack_bytes_v: eir.EirValue,
    ret_ty: types.TyId,
) -> !OutOfMemory {
    let doff = cg_val_stack_off(cg, dst);
    let ok_ty = env.get(ret_ty).primary;
    let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
    let l_inval = try cg.buf.new_label(alloc);
    let l_zero = try cg.buf.new_label(alloc);
    let l_err = try cg.buf.new_label(alloc);
    let l_done = try cg.buf.new_label(alloc);
    try cg_load_scalar_val(alloc, cg, eir_prog, env, stack_bytes_v, .Rsi);
    try cg.buf.test_rr(alloc, .Rsi, .Rsi);
    try cg.buf.jcc_label(alloc, .E, l_inval);
    try cg_load_scalar_val(alloc, cg, eir_prog, env, count_v, .Rdi);
    try cg.buf.test_rr(alloc, .Rdi, .Rdi);
    try cg.buf.jcc_label(alloc, .E, l_zero);
    try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
    try cg.buf.xor_rr32(alloc, .Rcx, .Rcx);
    try cg.buf.mov_ri64(alloc, .R8, if cg.sanitize { 1_u64 } else { 0_u64 });
    try cg_helper_call(alloc, cg, interner, "eon_run_fibers_iouring");
    try cg_load_scalar_val(alloc, cg, eir_prog, env, count_v, .Rcx);
    try cg.buf.cmp_rr(alloc, .Rax, .Rcx);
    try cg.buf.jcc_label(alloc, .B, l_err);
    try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rdx, 4_usize);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    try cg.buf.jmp_label(alloc, l_done);
    cg.buf.bind_label(l_zero);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    try cg.buf.jmp_label(alloc, l_done);
    cg.buf.bind_label(l_inval);
    try cg.buf.mov_ri64(alloc, .Rax, 16_u64);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    try cg.buf.jmp_label(alloc, l_done);
    cg.buf.bind_label(l_err);
    try cg.buf.mov_ri64(alloc, .Rax, 17_u64);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    cg.buf.bind_label(l_done);
    return;
}

// --- Schedule Execution (Single-System Fast Path & Multi-System DAG Wave) ---

fn cg_match_sched_arg(env: *types.TypeEnv, arg_ty: types.TyId, param_ty: types.TyId) -> u8 {
    if arg_ty == param_ty {
        return 1_u8;
    }
    let an = env.get(arg_ty);
    let pn = env.get(param_ty);
    if an.kind == .Borrow && an.borrow_kind == .Single && an.primary == param_ty {
        return 2_u8;
    }
    if pn.kind == .Borrow && pn.borrow_kind == .Single && pn.primary == arg_ty {
        return 3_u8;
    }
    if an.kind == .Borrow && pn.kind == .Borrow && an.borrow_kind == .Single && pn.borrow_kind == .Single && an.primary == pn.primary {
        return 1_u8;
    }
    return 0_u8;
}

fn cg_emit_schedule_single_sys(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    sys_def: u32,
    run_args: *[eir.EirValue],
    run_slots: *[eir.EirSlot],
) -> !OutOfMemory {
    let sys_fid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(sys_def)) orelse {
        return;
    };
    let sys_params = eir_prog.fn_params(sys_fid);
    let sys_sym = try fn_sym_name_id(alloc, cfg_ir.fn_key_top_def(sys_def), eir_prog, interner);

    var gp_i: usize = 0_usize;
    var flt_i: usize = 0_usize;
    var pi: usize = 0_usize;
    while pi < sys_params.len {
        let pty = eir_prog.fn_val_ty(sys_fid, sys_params[pi]);
        var best_k: usize = run_args.len;
        var best_kind: u8 = 99_u8;
        var ki: usize = 0_usize;
        while ki < run_args.len {
            let k = cg_match_sched_arg(env, eir_prog.fn_val_ty(cg.fn_id, run_args[ki]), pty);
            if k != 0_u8 && k < best_kind {
                best_k = ki;
                best_kind = k;
            }
            ki = ki +% 1_usize;
        }
        if best_k >= run_args.len && pi < run_args.len {
            best_k = pi;
            best_kind = 1_u8;
        }
        if best_k < run_args.len {
            let av = run_args[best_k];
            let cls = classify_arg(pty, env);
            match cls {
                .Zst => {}
                .IntReg => {
                    if let r = gp_arg_reg(false, gp_i) {
                        if best_kind == 2_u8 {
                            try cg_load_scalar_raw(alloc, cg, eir_prog, env, av, .Rax);
                            try cg.buf.load_mem(alloc, r, .Rax, 0_i32, env.x64_layout(pty).size, false);
                        } else if best_kind == 3_u8 {
                            try cg_load_ptr_arg(alloc, cg, eir_prog, env, av, get_arg_slot(run_slots, best_k), r);
                        } else {
                            try cg_load_scalar_raw(alloc, cg, eir_prog, env, av, r);
                        }
                        gp_i = gp_i +% 1_usize;
                    }
                }
                .TwoIntRegs => {
                    let r0_o = gp_arg_reg(false, gp_i);
                    let r1_o = gp_arg_reg(false, gp_i +% 1_usize);
                    if let r0 = r0_o {
                        if let r1 = r1_o {
                            let soff = cg_val_stack_off(cg, av);
                            try cg.buf.load_mem(alloc, r0, .Rbp, soff, 8_usize, false);
                            try cg.buf.load_mem(alloc, r1, .Rbp, soff +% 8_i32, 8_usize, false);
                            gp_i = gp_i +% 2_usize;
                        }
                    }
                }
                .FloatReg => {
                    if let xr = float_arg_reg(flt_i) {
                        try cg_load_float_val(alloc, cg, eir_prog, env, interner, av, xr);
                        flt_i = flt_i +% 1_usize;
                    }
                }
                .ByPtr => {
                    if let r = gp_arg_reg(false, gp_i) {
                        if best_kind == 2_u8 {
                            try cg_load_scalar_raw(alloc, cg, eir_prog, env, av, r);
                        } else {
                            try cg_val_addr_into(alloc, cg, av, r);
                        }
                        gp_i = gp_i +% 1_usize;
                    }
                }
            }
        }
        pi = pi +% 1_usize;
    }
    try cg.buf.call_sym(alloc, sys_sym);
    return;
}

fn cg_emit_schedule_dag(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    sched_id: u32,
    run_args: *[eir.EirValue],
    run_slots: *[eir.EirSlot],
) -> !OutOfMemory {
    let waves = eir_prog.schedule_waves(sched_id);
    var wi: usize = 0_usize;
    while wi < waves.len {
        let syss = eir_prog.wave_systems(waves[wi].systems);
        var si: usize = 0_usize;
        while si < syss.len {
            try cg_emit_schedule_single_sys(alloc, cg, eir_prog, env, interner, syss[si], run_args, run_slots);
            si = si +% 1_usize;
        }
        wi = wi +% 1_usize;
    }
    return;
}

fn cg_emit_schedule_run(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
) -> !OutOfMemory {
    if args.len == 0_usize || eir_prog.schedule_count() == 0_u32 {
        return;
    }
    let sched_v = args[0_usize];
    let run_args = args.sub(1_usize, args.len) catch { return; };
    let run_slots = if arg_slots.len > 1_usize {
        arg_slots.sub(1_usize, arg_slots.len) catch { arg_slots }
    } else {
        arg_slots.sub(0_usize, 0_usize) catch { arg_slots }
    };
    let sty = eir_prog.fn_val_ty(cg.fn_id, sched_v);
    let sn = env.get(sty);
    if sn.kind == .Borrow || sn.kind == .RawPtr {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, sched_v, .Rax);
        try cg.buf.load_mem(alloc, .Rax, .Rax, 0_i32, 8_usize, false);
    } else {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, sched_v, .Rax);
    }
    let nsched = eir_prog.schedule_count();
    let l_done = try cg.buf.new_label(alloc);
    var si: u32 = 0_u32;
    while si < nsched {
        let l_next = try cg.buf.new_label(alloc);
        try cg.buf.cmp_ri32(alloc, .Rax, si.bitcast.[i32]());
        try cg.buf.jcc_label(alloc, .Ne, l_next);
        try cg_emit_schedule_dag(alloc, cg, eir_prog, env, interner, si, run_args, run_slots);
        try cg.buf.jmp_label(alloc, l_done);
        cg.buf.bind_label(l_next);
        si = si +% 1_u32;
    }
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_builtin_call(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    bc_id: u32,
) -> !OutOfMemory {
    let bc = eir_prog.get_builtin_call(bc_id) orelse {
        return;
    };
    let op = bc.op;
    let args = eir_prog.vals_slice(bc.args);
    let arg_slots = eir_prog.arg_slots_slice(bc.arg_slots);
    let ret_ty = bc.ret_ty;

    match op.kind {
        .ArenaInit => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaAlloc => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaReset => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaDestroy => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaUsedBytes => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaCapacity => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .AllocCapLiveAllocs => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .AllocCapUsedBytes => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .AllocCapPeakBytes => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .AllocCapSubBudget => { try cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }

        .ArenaPoolInit => { try cg_emit_builtin_arena_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaPoolPush => { try cg_emit_builtin_arena_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaPoolIdAt => { try cg_emit_builtin_arena_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaPoolReset => { try cg_emit_builtin_arena_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArenaPoolLen => { try cg_emit_builtin_arena_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }

        .SlotPoolInit => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SlotPoolInsert => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SlotPoolTryInsert => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SlotPoolRemove => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SlotPoolGet => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SlotPoolAt => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SlotPoolLen => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SlotPoolCap => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SlotPoolIsAlive => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SlotPoolIdAt => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SlotPoolDestroy => { try cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }

        .BufInit => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufPush => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufPushSlice => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufPop => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufLen => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufCap => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufClear => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufAsSlice => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufAt => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufGet => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufSub => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BufDestroy => { try cg_emit_builtin_buf(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }

        .AtomicNew => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }
        .AtomicLoad => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }
        .AtomicStore => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }
        .AtomicFetchAdd => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }
        .AtomicFetchSub => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }
        .AtomicSwap => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }
        .AtomicCas => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }
        .MmioRead => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }
        .MmioWrite => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }
        .RawPtrFromUsize => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }
        .RawPtrAsUsize => { try cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, op, args, arg_slots); }

        .SliceLen => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArrayLen => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .StrLen => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .StrAsBytes => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .BytesAsStr => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SliceAt => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArrayAt => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SliceGet => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArrayGet => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .SliceSub => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
        .ArraySub => { try cg_emit_builtin_slice_array(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }

        .MathSqrt => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .MathFma => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .MathLzcnt => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .MathTzcnt => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .MathPopcnt => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .MathBswap => { try cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, op, args); }

        .VecSplat => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecLen => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecCmp => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecMaskAny => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecMaskAll => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecBitmask => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecSelect => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecMin => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecMax => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecFma => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecReduceAdd => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecReduceMin => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecReduceMax => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecDot => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .VecShuffle => { try cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, op, args); }

        .ParReduce => { try cg_emit_par_reduce(alloc, cg, eir_prog, env, interner, dst, op, args); }
        .ScheduleBuild => {}
        .ScheduleRun => { try cg_emit_schedule_run(alloc, cg, eir_prog, env, interner, args, arg_slots); }

        .GpuGlobalId => { try cg_fail(alloc, cg, "x86_64 codegen error: GPU intrinsic cannot be emitted in CPU function"); }
        .GpuLocalId => { try cg_fail(alloc, cg, "x86_64 codegen error: GPU intrinsic cannot be emitted in CPU function"); }
        .GpuWorkgroupId => { try cg_fail(alloc, cg, "x86_64 codegen error: GPU intrinsic cannot be emitted in CPU function"); }
        .GpuWorkgroupBarrier => { try cg_fail(alloc, cg, "x86_64 codegen error: GPU intrinsic cannot be emitted in CPU function"); }

        _ => { try cg_emit_builtin_sys_io(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty); }
    }
    return;
}

// ===========================================================================
// Section 8: Instruction Dispatch, Phi Edges, Terminators, ParFor & Fn Compile
// ===========================================================================

fn cg_emit_inst(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    inst: *eir.EirInst,
) -> !OutOfMemory {
    if cg.is_naked && inst.kind != .InlineAsm {
        return;
    }
    if cg.frame.live_active
        && inst.dst != eir.EIR_NONE
        && !cg.frame.val_is_live(inst.dst)
        && (inst.kind == .Const || inst.kind == .Copy || inst.kind == .LoadSlot || inst.kind == .SlotAddr)
    {
        return;
    }
    try cg_record_line(alloc, cg, sm, inst.span);
    match inst.kind {
        .Const => {
            try cg_emit_const(alloc, cg, eir_prog, env, ct, interner, inst.dst, inst.aux0, inst.ty0);
        }
        .Copy => {
            try cg_copy_val_to_val(alloc, cg, eir_prog, env, inst.dst, inst.v0);
        }
        .LoadSlot => {
            let ty = eir_prog.fn_val_ty(cg.fn_id, inst.dst);
            if !cg.in_par_worker {
                let soff = cg_slot_off(cg, inst.aux0);
                try cg_load_val_from_mem(alloc, cg, eir_prog, env, inst.dst, .Rbp, soff, ty);
            } else {
                try cg_emit_slot_addr(alloc, cg, inst.aux0, .R8);
                try cg_load_val_from_mem(alloc, cg, eir_prog, env, inst.dst, .R8, 0_i32, ty);
            }
        }
        .StoreSlot => {
            let ty = eir_prog.fn_val_ty(cg.fn_id, inst.v0);
            if !cg.in_par_worker {
                let soff = cg_slot_off(cg, inst.aux0);
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, soff, inst.v0, ty);
            } else {
                try cg_emit_slot_addr(alloc, cg, inst.aux0, .R8);
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .R8, 0_i32, inst.v0, ty);
            }
        }
        .SlotAddr => {
            try cg_emit_slot_addr(alloc, cg, inst.aux0, .Rax);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, .Rax);
        }
        .LoadPlace => {
            try cg_emit_load_place(alloc, cg, eir_prog, env, inst.dst, inst.aux0);
        }
        .StorePlace => {
            try cg_emit_store_place(alloc, cg, eir_prog, env, inst.aux0, inst.v0);
        }
        .PlaceAddr => {
            if let place = eir_prog.get_place(inst.aux0) {
                _ = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, place.projs.len.widen.[usize](), .R8);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, .R8);
            }
        }
        .PoolColumnLoad => {
            try cg_emit_pool_col_load(alloc, cg, eir_prog, env, inst.dst, inst.aux0);
        }
        .PoolColumnStore => {
            try cg_emit_pool_col_store(alloc, cg, eir_prog, env, inst.aux0, inst.v0);
        }
        .Unary => {
            try cg_emit_unary(alloc, cg, eir_prog, env, interner, inst.dst, inst.unary_op, inst.v0, inst.ty0);
        }
        .Binary => {
            try cg_emit_binary(alloc, cg, eir_prog, env, interner, inst.dst, inst.bin_op, inst.v0, inst.v1, inst.ty0, inst.ty1);
        }
        .Cast => {
            try cg_emit_cast(alloc, cg, eir_prog, env, interner, inst.dst, inst.cast_kind, inst.v0, inst.ty1, inst.ty0);
        }
        .Slice => {
            try cg_emit_slice(alloc, cg, eir_prog, env, inst.dst, inst.v0, inst.v1, inst.v2, inst.ty1);
        }
        .VecLoad => {
            let vlay = env.x64_layout(inst.ty0);
            let esz_r = env.x64_layout(inst.ty1).size;
            let esz = if esz_r == 0_usize { 4_usize } else { esz_r };
            let soff = cg_val_stack_off(cg, inst.v0);
            try cg.buf.load_mem(alloc, .R8, .Rbp, soff, 8_usize, false);
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v1, .R9);
            if esz == 4_usize { try cg.buf.shl_imm(alloc, .R9, 2_u8); }
            else if esz == 8_usize { try cg.buf.shl_imm(alloc, .R9, 3_u8); }
            else if esz == 2_usize { try cg.buf.shl_imm(alloc, .R9, 1_u8); }
            try cg.buf.add_rr(alloc, .R8, .R9);
            let doff = cg_val_stack_off(cg, inst.dst);
            var boff: usize = 0_usize;
            while boff +% 8_usize <= vlay.size {
                try cg.buf.load_mem(alloc, .Rax, .R8, boff.trunc.[i32](), 8_usize, false);
                try cg.buf.store_mem(alloc, .Rbp, doff +% boff.trunc.[i32](), .Rax, 8_usize);
                boff = boff +% 8_usize;
            }
        }
        .VecStore => {
            let vlay = env.x64_layout(inst.ty0);
            let esz_r = env.x64_layout(inst.ty1).size;
            let esz = if esz_r == 0_usize { 4_usize } else { esz_r };
            let soff = cg_val_stack_off(cg, inst.v0);
            try cg.buf.load_mem(alloc, .R8, .Rbp, soff, 8_usize, false);
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v1, .R9);
            if esz == 4_usize { try cg.buf.shl_imm(alloc, .R9, 2_u8); }
            else if esz == 8_usize { try cg.buf.shl_imm(alloc, .R9, 3_u8); }
            else if esz == 2_usize { try cg.buf.shl_imm(alloc, .R9, 1_u8); }
            try cg.buf.add_rr(alloc, .R8, .R9);
            let voff = cg_val_stack_off(cg, inst.v2);
            var boff: usize = 0_usize;
            while boff +% 8_usize <= vlay.size {
                try cg.buf.load_mem(alloc, .Rax, .Rbp, voff +% boff.trunc.[i32](), 8_usize, false);
                try cg.buf.store_mem(alloc, .R8, boff.trunc.[i32](), .Rax, 8_usize);
                boff = boff +% 8_usize;
            }
        }
        .VecFma => {
            let vn = env.get(inst.ty0);
            let lanes = vn.u8_val.widen.[usize]();
            let is_f64 = env.get(vn.primary).u8_val == 64_u8;
            let esz: usize = if is_f64 { 8_usize } else { 4_usize };
            let aoff = cg_val_stack_off(cg, inst.v0);
            let boff = cg_val_stack_off(cg, inst.v1);
            let coff = cg_val_stack_off(cg, inst.v2);
            let doff = cg_val_stack_off(cg, inst.dst);
            var li: usize = 0_usize;
            while li < lanes {
                let off_i = (li *% esz).trunc.[i32]();
                if is_f64 {
                    try cg.buf.movsd_load(alloc, .Xmm0, .Rbp, aoff +% off_i);
                    try cg.buf.movsd_load(alloc, .Xmm1, .Rbp, boff +% off_i);
                    try cg.buf.movsd_load(alloc, .Xmm2, .Rbp, coff +% off_i);
                    try cg.buf.sse_bin(alloc, true, 0x59_u8, .Xmm0, .Xmm1);
                    try cg.buf.sse_bin(alloc, true, 0x58_u8, .Xmm0, .Xmm2);
                    try cg.buf.movsd_store(alloc, .Rbp, doff +% off_i, .Xmm0);
                } else {
                    try cg.buf.movss_load(alloc, .Xmm0, .Rbp, aoff +% off_i);
                    try cg.buf.movss_load(alloc, .Xmm1, .Rbp, boff +% off_i);
                    try cg.buf.movss_load(alloc, .Xmm2, .Rbp, coff +% off_i);
                    try cg.buf.sse_bin(alloc, false, 0x59_u8, .Xmm0, .Xmm1);
                    try cg.buf.sse_bin(alloc, false, 0x58_u8, .Xmm0, .Xmm2);
                    try cg.buf.movss_store(alloc, .Rbp, doff +% off_i, .Xmm0);
                }
                li = li +% 1_usize;
            }
        }
        .Aggregate => {
            try cg_emit_aggregate(alloc, cg, eir_prog, env, inst.dst, inst.aux0, inst.range, inst.ty0);
        }
        .Call => {
            try cg_emit_call(alloc, cg, eir_prog, env, interner, inst.dst, inst.aux0);
        }
        .BuiltinCall => {
            try cg_emit_builtin_call(alloc, cg, eir_prog, env, interner, inst.dst, inst.aux0);
        }
        .ParForHint => {}
        .GetVar => {
            try cg_fail(alloc, cg, "x86_64 codegen error: unlowered GetVar pseudo-instruction");
        }
        .SetVar => {
            try cg_fail(alloc, cg, "x86_64 codegen error: unlowered SetVar pseudo-instruction");
        }
        _ => {
            try cg_emit_unwrap_and_extract(alloc, cg, eir_prog, env, interner, inst);
        }
    }
    return;
}

struct PhiCopyPair {
    dst: eir.EirValue;
    src: eir.EirValue;
}

fn cg_block_has_phi_for_pred(
    cg: *FnCodegen,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    from_bb: eir.BlockId,
    to_bb: eir.BlockId,
) -> bool {
    let phis = eir_prog.block_phis(fn_id, to_bb);
    var i: usize = 0_usize;
    while i < phis.len {
        if !cg.frame.val_is_live(phis[i].dst) {
            i = i +% 1_usize;
            continue;
        }
        let inc = eir_prog.phi_incoming(phis[i].incoming);
        var j: usize = 0_usize;
        while j < inc.len {
            if inc[j].pred_bb == from_bb && inc[j].val != phis[i].dst {
                return true;
            }
            j = j +% 1_usize;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn cg_emit_phi_edge(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    from_bb: eir.BlockId,
    to_bb: eir.BlockId,
) -> !OutOfMemory {
    let phis = eir_prog.block_phis(cg.fn_id, to_bb);
    if phis.len == 0_usize {
        return;
    }
    var pairs = try col.DynBuf.[PhiCopyPair].init(alloc, phis.len);
    errdefer pairs.destroy(alloc);
    var i: usize = 0_usize;
    while i < phis.len {
        if !cg.frame.val_is_live(phis[i].dst) {
            i = i +% 1_usize;
            continue;
        }
        let inc = eir_prog.phi_incoming(phis[i].incoming);
        var j: usize = 0_usize;
        while j < inc.len {
            if inc[j].pred_bb == from_bb && inc[j].val != phis[i].dst {
                try pairs.push(alloc, PhiCopyPair.{ dst: phis[i].dst, src: inc[j].val });
                break;
            }
            j = j +% 1_usize;
        }
        i = i +% 1_usize;
    }
    if pairs.is_empty() {
        pairs.destroy(alloc);
        return;
    }

    // Full parallel-copy semantics for ALL phis (registers, stack scalars, and >8B aggregates!).
    let ps = pairs.as_slice();
    var has_conflict = false;
    if ps.len > 1_usize {
        var i_c: usize = 0_usize;
        while i_c < ps.len && !has_conflict {
            let sloc = cg_val_loc(cg, ps[i_c].src);
            var j_c: usize = 0_usize;
            while j_c < i_c {
                if ps[j_c].dst == ps[i_c].src {
                    has_conflict = true;
                    break;
                }
                let dloc = cg_val_loc(cg, ps[j_c].dst);
                if sloc.kind == .Reg && dloc.kind == .Reg && sloc.reg == dloc.reg {
                    has_conflict = true;
                    break;
                }
                if sloc.kind == .Stack && dloc.kind == .Stack && sloc.stack_off == dloc.stack_off {
                    has_conflict = true;
                    break;
                }
                j_c = j_c +% 1_usize;
            }
            i_c = i_c +% 1_usize;
        }
    }

    if !has_conflict {
        var pi: usize = 0_usize;
        while pi < ps.len {
            try cg_copy_val_to_val(alloc, cg, eir_prog, env, ps[pi].dst, ps[pi].src);
            pi = pi +% 1_usize;
        }
        pairs.destroy(alloc);
        return;
    }

    // Conflict detected (e.g. `prev = cur; cur = next` or swap `a = b; b = a`):
    // snapshot every source onto temporary stack space, then write every destination!
    var snap_offs = try col.DynBuf.[i32].init(alloc, ps.len);
    errdefer snap_offs.destroy(alloc);
    var total_snap: usize = 0_usize;
    var pi: usize = 0_usize;
    while pi < ps.len {
        try snap_offs.push(alloc, total_snap.trunc.[i32]());
        let ty = eir_prog.fn_val_ty(cg.fn_id, ps[pi].dst);
        let lay = env.x64_layout(ty);
        let slot_sz = if lay.size == 0_usize {
            0_usize
        } else {
            types.align_up_usize(if lay.size < 8_usize { 8_usize } else { lay.size }, 8_usize)
        };
        total_snap = total_snap +% slot_sz;
        pi = pi +% 1_usize;
    }
    let pad = types.align_up_usize(total_snap, 16_usize);
    if pad > 0_usize {
        try cg.buf.sub_ri32(alloc, .Rsp, pad.trunc.[i32]());
    }
    let so_s = snap_offs.as_slice();
    pi = 0_usize;
    while pi < ps.len && pi < so_s.len {
        let ty = eir_prog.fn_val_ty(cg.fn_id, ps[pi].dst);
        let lay = env.x64_layout(ty);
        if lay.size > 0_usize && lay.size <= 8_usize {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, ps[pi].src, .Rax);
            try cg.buf.store_mem(alloc, .Rsp, so_s[pi], .Rax, 8_usize);
        } else if lay.size > 8_usize {
            let sloc = cg_val_loc(cg, ps[pi].src);
            try cg_emit_copy_mem(alloc, cg, .Rsp, so_s[pi], .Rbp, sloc.stack_off, lay.size);
        }
        pi = pi +% 1_usize;
    }
    pi = 0_usize;
    while pi < ps.len && pi < so_s.len {
        let ty = eir_prog.fn_val_ty(cg.fn_id, ps[pi].dst);
        let lay = env.x64_layout(ty);
        if lay.size > 0_usize && lay.size <= 8_usize {
            try cg.buf.load_mem(alloc, .Rax, .Rsp, so_s[pi], 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, ps[pi].dst, .Rax);
        } else if lay.size > 8_usize {
            let dloc = cg_val_loc(cg, ps[pi].dst);
            try cg_emit_copy_mem(alloc, cg, .Rbp, dloc.stack_off, .Rsp, so_s[pi], lay.size);
        }
        pi = pi +% 1_usize;
    }
    if pad > 0_usize {
        try cg.buf.add_ri32(alloc, .Rsp, pad.trunc.[i32]());
    }
    snap_offs.destroy(alloc);
    pairs.destroy(alloc);
    return;
}

fn cg_emit_return_term(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    has_val: bool,
    val: eir.EirValue,
) -> !OutOfMemory {
    if cg.is_naked {
        return;
    }
    let rc = cg.ret_class;
    match rc.kind {
        .Void => {
            try cg_emit_epilogue_preserving_flags(alloc, cg);
            if cg.is_interrupt { try cg.buf.iretq(alloc); } else { try cg.buf.ret(alloc); }
        }
        .IntReg => {
            if has_val {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, val, .Rax);
            } else {
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            }
            try cg_emit_epilogue_preserving_flags(alloc, cg);
            if cg.is_interrupt { try cg.buf.iretq(alloc); } else { try cg.buf.ret(alloc); }
        }
        .TwoIntRegs => {
            if has_val {
                let soff = cg_val_stack_off(cg, val);
                let lay = env.x64_layout(cg.ret_ty);
                try cg.buf.load_mem(alloc, .Rax, .Rbp, soff, 8_usize, false);
                if lay.size > 8_usize {
                    try cg.buf.load_mem(alloc, .Rdx, .Rbp, soff +% 8_i32, lay.size - 8_usize, false);
                } else {
                    try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
                }
            } else {
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
            }
            try cg_emit_epilogue_preserving_flags(alloc, cg);
            if cg.is_interrupt { try cg.buf.iretq(alloc); } else { try cg.buf.ret(alloc); }
        }
        .FloatReg => {
            if has_val {
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, val, .Xmm0);
            } else {
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.movq_xmm_r64(alloc, .Xmm0, .Rax);
            }
            try cg_emit_epilogue_preserving_flags(alloc, cg);
            if cg.is_interrupt { try cg.buf.iretq(alloc); } else { try cg.buf.ret(alloc); }
        }
        .Sret => {
            try cg.buf.load_mem(alloc, .R8, .Rbp, cg.frame.sret_off, 8_usize, false);
            if has_val {
                let lay = env.x64_layout(cg.ret_ty);
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .R8, 0_i32, val, cg.ret_ty);
                try cg.buf.mov_rr(alloc, .Rax, .R8);
                _ = lay;
            }
            try cg_emit_epilogue_preserving_flags(alloc, cg);
            if cg.is_interrupt { try cg.buf.iretq(alloc); } else { try cg.buf.ret(alloc); }
        }
        .ErrorUnion => {
            // Wave 0 CRITICAL FIX: bare `Return(None)` in ErrorUnion MUST clear r15 & CF!
            if !has_val {
                try cg.buf.xor_rr32(alloc, .R15, .R15);
                try cg_emit_epilogue_preserving_flags(alloc, cg);
                try cg.buf.clc(alloc);
                if cg.is_interrupt { try cg.buf.iretq(alloc); } else { try cg.buf.ret(alloc); }
                return;
            }
            let soff = cg_val_stack_off(cg, val);
            let l_err = try cg.buf.new_label(alloc);
            try cg.buf.load_mem(alloc, .R15, .Rbp, soff, 4_usize, false);
            try cg.buf.test_rr32(alloc, .R15, .R15);
            try cg.buf.jcc_label(alloc, .Ne, l_err);

            // Ok path (r15 == 0, CF = 0)
            let ok_off = env.eu_ok_offset(rc.ok_ty).trunc.[i32]();
            let ok_lay = env.x64_layout(rc.ok_ty);
            match rc.ok_kind {
                .Void => {}
                .IntReg => {
                    try cg.buf.load_mem(alloc, .Rax, .Rbp, soff +% ok_off, ok_lay.size, env.is_signed_int(rc.ok_ty));
                }
                .TwoIntRegs => {
                    try cg.buf.load_mem(alloc, .Rax, .Rbp, soff +% ok_off, 8_usize, false);
                    if ok_lay.size > 8_usize {
                        try cg.buf.load_mem(alloc, .Rdx, .Rbp, soff +% ok_off +% 8_i32, ok_lay.size - 8_usize, false);
                    } else {
                        try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
                    }
                }
                .FloatReg => {
                    if env.get(rc.ok_ty).u8_val == 64_u8 {
                        try cg.buf.movsd_load(alloc, .Xmm0, .Rbp, soff +% ok_off);
                    } else {
                        try cg.buf.movss_load(alloc, .Xmm0, .Rbp, soff +% ok_off);
                    }
                }
                .Sret => {
                    try cg.buf.load_mem(alloc, .R8, .Rbp, cg.frame.sret_off, 8_usize, false);
                    try cg_emit_copy_mem(alloc, cg, .R8, 0_i32, .Rbp, soff +% ok_off, ok_lay.size);
                    try cg.buf.mov_rr(alloc, .Rax, .R8);
                }
                .ErrorUnion => {}
            }
            try cg_emit_epilogue_preserving_flags(alloc, cg);
            try cg.buf.clc(alloc);
            if cg.is_interrupt { try cg.buf.iretq(alloc); } else { try cg.buf.ret(alloc); }

            // Error path (r15 != 0, CF = 1)
            cg.buf.bind_label(l_err);
            try cg_emit_epilogue_preserving_flags(alloc, cg);
            try cg.buf.stc(alloc);
            if cg.is_interrupt { try cg.buf.iretq(alloc); } else { try cg.buf.ret(alloc); }
        }
    }
    return;
}

fn o0_invert_cond(cc: x64_asm.Cond) -> x64_asm.Cond {
    match cc {
        .E => { return .Ne; }
        .Ne => { return .E; }
        .L => { return .Ge; }
        .Le => { return .G; }
        .G => { return .Le; }
        .Ge => { return .L; }
        .B => { return .Ae; }
        .Be => { return .A; }
        .A => { return .Be; }
        .Ae => { return .B; }
        .O => { return .No; }
        .No => { return .O; }
        .S => { return .Ns; }
        .Ns => { return .S; }
        .P => { return .Np; }
        .Np => { return .P; }
    }
}

fn cg_emit_branch_after_flags(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    bb: eir.BlockId,
    then_bb: eir.BlockId,
    else_bb: eir.BlockId,
    cc_then: x64_asm.Cond,
    next_bb: eir.BlockId,
) -> !OutOfMemory {
    let then_has = cg_block_has_phi_for_pred(cg, eir_prog, cg.fn_id, bb, then_bb);
    let else_has = cg_block_has_phi_for_pred(cg, eir_prog, cg.fn_id, bb, else_bb);
    let lbl_then = cg_block_label(cg, then_bb);
    let lbl_else_t = cg_block_label(cg, else_bb);
    if !then_has && !else_has {
        if else_bb == next_bb {
            try cg.buf.jcc_label(alloc, cc_then, lbl_then);
        } else if then_bb == next_bb {
            try cg.buf.jcc_label(alloc, o0_invert_cond(cc_then), lbl_else_t);
        } else {
            try cg.buf.jcc_label(alloc, cc_then, lbl_then);
            try cg.buf.jmp_label(alloc, lbl_else_t);
        }
    } else if !then_has {
        try cg.buf.jcc_label(alloc, cc_then, lbl_then);
        try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, else_bb);
        if else_bb != next_bb {
            try cg.buf.jmp_label(alloc, lbl_else_t);
        }
    } else if !else_has {
        try cg.buf.jcc_label(alloc, o0_invert_cond(cc_then), lbl_else_t);
        try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, then_bb);
        if then_bb != next_bb {
            try cg.buf.jmp_label(alloc, lbl_then);
        }
    } else {
        let l_else = try cg.buf.new_label(alloc);
        try cg.buf.jcc_label(alloc, o0_invert_cond(cc_then), l_else);
        try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, then_bb);
        try cg.buf.jmp_label(alloc, lbl_then);
        cg.buf.bind_label(l_else);
        try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, else_bb);
        if else_bb != next_bb {
            try cg.buf.jmp_label(alloc, lbl_else_t);
        }
    }
    return;
}

fn cg_emit_fused_cmp_branch(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    bb: eir.BlockId,
    cmp_inst: *eir.EirInst,
    term: *eir.EirTerm,
    next_bb: eir.BlockId,
) -> !OutOfMemory {
    try cg_record_line(alloc, cg, sm, cmp_inst.span);
    let op_ty = cmp_inst.ty1;
    let signed = env.is_signed_int(op_ty);
    let op_lay = env.x64_layout(op_ty);
    let rhs_imm_opt = if env.is_concrete_integer(op_ty) { cg.frame.val_imm32(cmp_inst.v1) } else { null };
    let lloc = cg_val_loc(cg, cmp_inst.v0);
    var lhs_reg: x64_asm.Reg = .Rax;
    if lloc.kind == .Reg && op_lay.size == 8_usize {
        lhs_reg = lloc.reg;
    } else {
        try cg_load_scalar_val(alloc, cg, eir_prog, env, cmp_inst.v0, .Rax);
    }
    if let im = rhs_imm_opt {
        if im == 0_i32 && (cmp_inst.bin_op == .Eq || cmp_inst.bin_op == .NotEq) {
            try cg.buf.test_rr(alloc, lhs_reg, lhs_reg);
        } else {
            try cg.buf.cmp_ri32(alloc, lhs_reg, im);
        }
    } else {
        let rloc = cg_val_loc(cg, cmp_inst.v1);
        var rhs_reg: x64_asm.Reg = .Rcx;
        if rloc.kind == .Reg && op_lay.size == 8_usize {
            rhs_reg = rloc.reg;
        } else {
            try cg_load_scalar_val(alloc, cg, eir_prog, env, cmp_inst.v1, .Rcx);
        }
        try cg.buf.cmp_rr(alloc, lhs_reg, rhs_reg);
    }
    var cc: x64_asm.Cond = .E;
    match cmp_inst.bin_op {
        .Eq => { cc = .E; }
        .NotEq => { cc = .Ne; }
        .Lt => { cc = if signed { .L } else { .B }; }
        .LtEq => { cc = if signed { .Le } else { .Be }; }
        .Gt => { cc = if signed { .G } else { .A }; }
        .GtEq => { cc = if signed { .Ge } else { .Ae }; }
        _ => {}
    }
    try cg_emit_branch_after_flags(alloc, cg, eir_prog, env, bb, term.bb0, term.bb1, cc, next_bb);
    return;
}

fn cg_emit_term(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    bb: eir.BlockId,
    term: *eir.EirTerm,
    next_bb: eir.BlockId,
) -> !OutOfMemory {
    try cg_record_line(alloc, cg, sm, term.span);
    match term.kind {
        .Goto => {
            if cg.in_par_worker && term.bb0 == cg.par_worker_end_label {
                let step_lbl = cg_block_label(cg, cg.par_worker_end_label);
                try cg.buf.jmp_label(alloc, step_lbl);
                return;
            }
            try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, term.bb0);
            if term.bb0 != next_bb {
                let lbl0 = cg_block_label(cg, term.bb0);
                try cg.buf.jmp_label(alloc, lbl0);
            }
        }
        .Branch => {
            let vloc = cg_val_loc(cg, term.val);
            if vloc.kind == .Reg {
                try cg.buf.test_rr32(alloc, vloc.reg, vloc.reg);
            } else {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, term.val, .Rax);
                try cg.buf.test_rr32(alloc, .Rax, .Rax);
            }
            try cg_emit_branch_after_flags(alloc, cg, eir_prog, env, bb, term.bb0, term.bb1, .Ne, next_bb);
        }
        .SwitchInt => {
            let targets = eir_prog.switch_targets_slice(term.targets);
            try cg_load_scalar_val(alloc, cg, eir_prog, env, term.val, .Rax);
            var ti: usize = 0_usize;
            while ti < targets.len {
                let t = targets[ti];
                let has_phi = cg_block_has_phi_for_pred(cg, eir_prog, cg.fn_id, bb, t.target);
                let tlbl = cg_block_label(cg, t.target);
                if t.val.hi == 0_i64 && t.val.lo <= 0x7FFFFFFF_u64 {
                    try cg.buf.cmp_ri32(alloc, .Rax, t.val.lo.trunc.[i32]());
                } else {
                    try cg.buf.mov_ri64(alloc, .Rcx, t.val.lo);
                    try cg.buf.cmp_rr(alloc, .Rax, .Rcx);
                }
                if !has_phi {
                    try cg.buf.jcc_label(alloc, .E, tlbl);
                } else {
                    let l_skip = try cg.buf.new_label(alloc);
                    try cg.buf.jcc_label(alloc, .Ne, l_skip);
                    try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, t.target);
                    try cg.buf.jmp_label(alloc, tlbl);
                    cg.buf.bind_label(l_skip);
                }
                ti = ti +% 1_usize;
            }
            try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, term.bb0);
            if term.bb0 != next_bb {
                let lbl_oth = cg_block_label(cg, term.bb0);
                try cg.buf.jmp_label(alloc, lbl_oth);
            }
        }
        .Return => {
            try cg_emit_return_term(alloc, cg, eir_prog, env, interner, term.flag, term.val);
        }
        .Unreachable => {
            try cg.buf.ud2(alloc);
        }
    }
    return;
}

// --- `par for` Outlining (Worker Launch + Out-of-Line Worker Emission) ---

fn cg_find_par_for_by_header(cg: *FnCodegen, header_bb: eir.BlockId) -> ?usize {
    let ps = cg.par_for_plans.as_slice();
    var i: usize = 0_usize;
    while i < ps.len {
        if ps[i].header_bb == header_bb {
            return i;
        }
        i = i +% 1_usize;
    }
    return null;
}

fn cg_is_par_for_outlined_bb(cg: *FnCodegen, bb: eir.BlockId) -> bool {
    let ps = cg.par_for_plans.as_slice();
    let bbs = cg.par_for_body_bbs.as_slice();
    var pi: usize = 0_usize;
    while pi < ps.len {
        if bb == ps[pi].step_bb {
            return true;
        }
        let st = ps[pi].body_blocks_start.widen.[usize]();
        let ln = ps[pi].body_blocks_len.widen.[usize]();
        var k: usize = 0_usize;
        while k < ln {
            let idx = st +% k;
            if idx >= bbs.len {
                break;
            }
            if bbs[idx] == bb {
                return true;
            }
            k = k +% 1_usize;
        }
        pi = pi +% 1_usize;
    }
    return false;
}

fn cg_build_par_for_plans(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    interner: *mut span.SymInterner,
) -> !OutOfMemory {
    let regs = eir_prog.fn_par_for_regions(cg.fn_id);
    if regs.len == 0_usize || !cg.is_linux {
        return;
    }
    let blks = eir_prog.fn_blocks(cg.fn_id);
    var ri: usize = 0_usize;
    while ri < regs.len {
        let r = regs[ri];
        var vis = try col.DynBuf.[u8].init(alloc, if blks.len > 4_usize { blks.len } else { 4_usize });
        errdefer vis.destroy(alloc);
        var vi: usize = 0_usize;
        while vi < blks.len {
            try vis.push(alloc, 0_u8);
            vi = vi +% 1_usize;
        }
        var queue = try col.DynBuf.[eir.BlockId].init(alloc, 8_usize);
        errdefer queue.destroy(alloc);
        try queue.push(alloc, r.body_bb);
        let bstart = cg.par_for_body_bbs.len().trunc.[u32]();
        var valid = true;
        var qi: usize = 0_usize;
        while qi < queue.len() {
            let qs = queue.as_slice();
            if qi >= qs.len {
                break;
            }
            let cur = qs[qi];
            qi = qi +% 1_usize;
            if cur == r.step_bb || cur == r.header_bb {
                continue;
            }
            if cur == r.exit_bb {
                valid = false;
                break;
            }
            let cidx = cur.widen.[usize]();
            if cidx >= blks.len {
                continue;
            }
            let vmut = vis.as_mut_slice();
            if cidx < vmut.len && vmut[cidx] != 0_u8 {
                continue;
            }
            if cidx < vmut.len {
                vmut[cidx] = 1_u8;
            }
            try cg.par_for_body_bbs.push(alloc, cur);
            let blk = blks[cidx];
            if blk.term.kind == .Return {
                valid = false;
                break;
            }
            let sc = eir_prog.term_successor_count(&blk.term);
            var si: usize = 0_usize;
            while si < sc {
                try queue.push(alloc, eir_prog.term_successor_at(&blk.term, si));
                si = si +% 1_usize;
            }
        }
        let blen = cg.par_for_body_bbs.len().trunc.[u32]() -% bstart;
        if valid && blen > 0_u32 {
            let wsym = try intern_sym_u64_2(alloc, interner, "eon_par_worker_", cg.fn_id.widen.[u64](), ri.widen.[u64]());
            try cg.par_for_plans.push(alloc, ParForPlan.{
                header_bb: r.header_bb,
                body_bb: r.body_bb,
                step_bb: r.step_bb,
                exit_bb: r.exit_bb,
                idx_slot: r.idx_slot,
                end_slot: r.end_slot,
                chunk_size: if r.chunk_size == 0_u64 { 64_u64 } else { r.chunk_size },
                worker_sym: wsym,
                body_blocks_start: bstart,
                body_blocks_len: blen,
            });
        }
        queue.destroy(alloc);
        vis.destroy(alloc);
        ri = ri +% 1_usize;
    }
    return;
}

fn cg_emit_par_for_launch(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    interner: *mut span.SymInterner,
    plan_idx: usize,
) -> !OutOfMemory {
    let ps = cg.par_for_plans.as_slice();
    if plan_idx >= ps.len {
        return;
    }
    let p = ps[plan_idx];
    // eon_par_for(rdi = total = end - start, rsi = chunk, rdx = worker_fn, rcx = ctx = rbp)
    let start_off = cg_slot_off(cg, p.idx_slot);
    let end_off = cg_slot_off(cg, p.end_slot);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, end_off, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, start_off, 8_usize, false);
    let l_empty = try cg.buf.new_label(alloc);
    try cg.buf.cmp_rr(alloc, .Rdi, .Rax);
    try cg.buf.jcc_label(alloc, .Be, l_empty);
    try cg.buf.sub_rr(alloc, .Rdi, .Rax);
    // Adaptive chunk sizing: target ~32 chunks (min 1) so both small chunked par_for (0..64)
    // and large element par_for (0..131072) parallelize across all workers with minimal contention!
    try cg.buf.mov_rr(alloc, .Rsi, .Rdi);
    try cg.buf.shr_imm(alloc, .Rsi, 5_u8);
    try cg.buf.mov_ri64(alloc, .Rax, 1_u64);
    try cg.buf.cmp_rr(alloc, .Rsi, .Rax);
    try cg.buf.cmovcc(alloc, .B, .Rsi, .Rax);
    try cg.buf.lea_rip_sym(alloc, .Rdx, p.worker_sym, 0_i64);
    try cg.buf.mov_rr(alloc, .Rcx, .Rbp);
    try cg_helper_call(alloc, cg, interner, "eon_par_for");
    try cg.buf.load_mem(alloc, .Rax, .Rbp, end_off, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, start_off, .Rax, 8_usize);
    cg.buf.bind_label(l_empty);
    let exit_lbl = cg_block_label(cg, p.exit_bb);
    try cg.buf.jmp_label(alloc, exit_lbl);
    return;
}

fn cg_mark_inst_slots(
    eir_prog: *eir.EirProgram,
    inst: *eir.EirInst,
    out_flags: *mut [u8],
) {
    match inst.kind {
        .LoadPlace => {
            if let pl = eir_prog.get_place(inst.aux0) {
                if pl.base.kind == .Slot {
                    let sidx = pl.base.id.widen.[usize]();
                    if sidx < out_flags.len { out_flags[sidx] = 1_u8; }
                }
            }
        }
        .StorePlace => {
            if let pl = eir_prog.get_place(inst.aux0) {
                if pl.base.kind == .Slot {
                    let sidx = pl.base.id.widen.[usize]();
                    if sidx < out_flags.len { out_flags[sidx] = 1_u8; }
                }
            }
        }
        .PlaceAddr => {
            if let pl = eir_prog.get_place(inst.aux0) {
                if pl.base.kind == .Slot {
                    let sidx = pl.base.id.widen.[usize]();
                    if sidx < out_flags.len { out_flags[sidx] = 1_u8; }
                }
            }
        }
        .PoolColumnLoad => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Slot {
                    let sidx = op.pool_base.id.widen.[usize]();
                    if sidx < out_flags.len { out_flags[sidx] = 1_u8; }
                }
            }
        }
        .PoolColumnStore => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Slot {
                    let sidx = op.pool_base.id.widen.[usize]();
                    if sidx < out_flags.len { out_flags[sidx] = 1_u8; }
                }
            }
        }
        .BuiltinCall => {
            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                let sls = eir_prog.arg_slots_slice(bc.arg_slots);
                var si: usize = 0_usize;
                while si < sls.len {
                    if sls[si] != eir.EIR_NONE {
                        let sidx = sls[si].widen.[usize]();
                        if sidx < out_flags.len { out_flags[sidx] = 1_u8; }
                    }
                    si = si +% 1_usize;
                }
            }
        }
        _ => {}
    }
}

fn cg_compute_par_cap_slots(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    p: *ParForPlan,
) -> !OutOfMemory {
    let blks = eir_prog.fn_blocks(cg.fn_id);
    let nslots = eir_prog.fn_slots(cg.fn_id).len;
    cg.par_worker_cap_slots.clear();
    var si0: usize = 0_usize;
    while si0 < nslots {
        try cg.par_worker_cap_slots.push(alloc, 0_u8);
        si0 = si0 +% 1_usize;
    }
    var is_body_bb = try col.DynBuf.[u8].init(alloc, if blks.len > 4_usize { blks.len } else { 4_usize });
    errdefer is_body_bb.destroy(alloc);
    var b0: usize = 0_usize;
    while b0 < blks.len {
        try is_body_bb.push(alloc, 0_u8);
        b0 = b0 +% 1_usize;
    }
    let bstart = p.body_blocks_start.widen.[usize]();
    let blen = p.body_blocks_len.widen.[usize]();
    var bk: usize = 0_usize;
    while bk < blen {
        let bbs = cg.par_for_body_bbs.as_slice();
        let bidx = bstart +% bk;
        if bidx < bbs.len {
            let bi_u = bbs[bidx].widen.[usize]();
            let bm = is_body_bb.as_mut_slice();
            if bi_u < bm.len { bm[bi_u] = 1_u8; }
        }
        bk = bk +% 1_usize;
    }
    let bm_s = is_body_bb.as_slice();
    var bi_scan: usize = 0_usize;
    while bi_scan < blks.len {
        if bi_scan < bm_s.len && bm_s[bi_scan] == 0_u8 {
            let ins_s = eir_prog.insts_slice(blks[bi_scan].insts);
            var ii_s: usize = 0_usize;
            while ii_s < ins_s.len {
                let ins_c = ins_s[ii_s];
                cg_mark_inst_slots(eir_prog, &ins_c, cg.par_worker_cap_slots.as_mut_slice());
                ii_s = ii_s +% 1_usize;
            }
        }
        bi_scan = bi_scan +% 1_usize;
    }
    let idx_u = p.idx_slot.widen.[usize]();
    let caps_mut = cg.par_worker_cap_slots.as_mut_slice();
    if idx_u < caps_mut.len {
        caps_mut[idx_u] = 0_u8;
    }
    is_body_bb.destroy(alloc);
    return;
}

fn cg_emit_par_for_workers(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
) -> !OutOfMemory {
    let nplans = cg.par_for_plans.len();
    var pi: usize = 0_usize;
    while pi < nplans {
        let pslice = cg.par_for_plans.as_slice();
        if pi >= pslice.len {
            break;
        }
        let p = pslice[pi];
        cg.buf.clear();
        cg.block_labels.clear();
        let blks = eir_prog.fn_blocks(cg.fn_id);
        var bi: usize = 0_usize;
        while bi < blks.len {
            let l = try cg.buf.new_label(alloc);
            try cg.block_labels.push(alloc, l);
            bi = bi +% 1_usize;
        }

        try cg_compute_par_cap_slots(alloc, cg, eir_prog, &p);
        let bstart = p.body_blocks_start.widen.[usize]();
        let blen = p.body_blocks_len.widen.[usize]();

        // Worker signature (System V ABI from eon_par_for):
        //   rdi = start, rsi = end, rdx = ctx (parent RBP)
        // Push 8B align pad + [rbx, r12, r13, r14, r15] (48B) BEFORE `push rbp` (56B + 8B retaddr = 64B,
        // keeping RBP 16-byte aligned and preserving all System V callee-saved regs including R15,
        // which internal Eon functions in --dev may clobber for error-union return tags).
        let ctx_off = cg.frame.temp_copy_off;
        let cur_off = ctx_off +% 8_i32;
        let end_off = ctx_off +% 16_i32;
        let base_idx_off = cg_slot_off(cg, p.idx_slot);
        let saved_bytes = cg.frame.saved_regs.len() *% 8_usize;
        let frame_total = types.align_up_usize(cg.frame.frame_size.bitcast.[u32]().widen.[usize]() +% saved_bytes, 16_usize);
        try cg.buf.sub_ri32(alloc, .Rsp, 8_i32);
        try cg.buf.push(alloc, .Rbx);
        try cg.buf.push(alloc, .R12);
        try cg.buf.push(alloc, .R13);
        try cg.buf.push(alloc, .R14);
        try cg.buf.push(alloc, .R15);
        try cg.buf.push(alloc, .Rbp);
        try cg.buf.mov_rr(alloc, .Rbp, .Rsp);
        if frame_total > 0_usize {
            try cg.buf.sub_ri32(alloc, .Rsp, frame_total.trunc.[i32]());
        }
        try cg.buf.mov_rr(alloc, .R12, .Rdi); // start
        try cg.buf.mov_rr(alloc, .R13, .Rsi); // end
        try cg.buf.mov_rr(alloc, .R14, .Rdx); // parent_rbp
        // Snapshot parent frame's read-only SSA values into worker frame so outer EirValues work via [rbp + off].
        if frame_total > 0_usize {
            let neg_ft = 0_i32 -% frame_total.trunc.[i32]();
            try cg.buf.lea_mem(alloc, .Rdi, .Rbp, neg_ft);
            try cg.buf.lea_mem(alloc, .Rsi, .R14, neg_ft);
            try cg.buf.mov_ri64(alloc, .Rcx, frame_total.widen.[u64]());
            try cg.buf.rep_movsb(alloc);
        }
        try cg.buf.store_mem(alloc, .Rbp, ctx_off, .R14, 8_usize);
        // base_start = *(parent_rbp + base_idx_off); cur = base_start + start; lim = base_start + end
        try cg.buf.load_mem(alloc, .Rax, .R14, base_idx_off, 8_usize, false);
        try cg.buf.add_rr(alloc, .R12, .Rax);
        try cg.buf.add_rr(alloc, .R13, .Rax);
        try cg.buf.store_mem(alloc, .Rbp, cur_off, .R12, 8_usize);
        try cg.buf.store_mem(alloc, .Rbp, end_off, .R13, 8_usize);

        let l_loop = try cg.buf.new_label(alloc);
        let l_done = try cg.buf.new_label(alloc);
        cg.buf.bind_label(l_loop);
        try cg.buf.load_mem(alloc, .Rax, .Rbp, cur_off, 8_usize, false);
        try cg.buf.load_mem(alloc, .Rcx, .Rbp, end_off, 8_usize, false);
        try cg.buf.cmp_rr(alloc, .Rax, .Rcx);
        try cg.buf.jcc_label(alloc, .Ae, l_done);
        try cg.buf.store_mem(alloc, .Rbp, base_idx_off, .Rax, 8_usize);

        cg.in_par_worker = true;
        cg.par_worker_end_label = p.step_bb;
        cg.par_worker_ctx_off = ctx_off;
        cg.par_worker_idx_slot = p.idx_slot;
        var k: usize = 0_usize;
        while k < blen {
            let bbs = cg.par_for_body_bbs.as_slice();
            let bidx = bstart +% k;
            if bidx < bbs.len {
                let bbid = bbs[bidx];
                let blbl = cg_block_label(cg, bbid);
                cg.buf.bind_label(blbl);
                if let blk = eir_prog.fn_block(cg.fn_id, bbid) {
                    let insts = eir_prog.insts_slice(blk.insts);
                    var ii: usize = 0_usize;
                    while ii < insts.len {
                        let ins = insts[ii];
                        try cg_emit_inst(alloc, cg, sm, eir_prog, env, ct, interner, &ins);
                        ii = ii +% 1_usize;
                    }
                    let t = blk.term;
                    try cg_emit_term(alloc, cg, sm, eir_prog, env, interner, bbid, &t, eir.EIR_NONE);
                }
            }
            k = k +% 1_usize;
        }
        cg.in_par_worker = false;
        let step_lbl = cg_block_label(cg, p.step_bb);
        cg.buf.bind_label(step_lbl);
        try cg.buf.load_mem(alloc, .Rax, .Rbp, cur_off, 8_usize, false);
        try cg.buf.add_ri32(alloc, .Rax, 1_i32);
        try cg.buf.store_mem(alloc, .Rbp, cur_off, .Rax, 8_usize);
        try cg.buf.jmp_label(alloc, l_loop);

        cg.buf.bind_label(l_done);
        try cg.buf.mov_rr(alloc, .Rsp, .Rbp);
        try cg.buf.pop(alloc, .Rbp);
        try cg.buf.pop(alloc, .R15);
        try cg.buf.pop(alloc, .R14);
        try cg.buf.pop(alloc, .R13);
        try cg.buf.pop(alloc, .R12);
        try cg.buf.pop(alloc, .Rbx);
        try cg.buf.add_ri32(alloc, .Rsp, 8_i32);
        try cg.buf.ret(alloc);
        _ = cg.buf.finish();

        let coff = cg.extra_code.len().trunc.[u32]();
        let clen = cg.buf.code.len().trunc.[u32]();
        try cg.extra_code.push_slice(alloc, cg.buf.code.as_slice());
        let rstart = cg.extra_relocs.len().trunc.[u32]();
        let rlen = cg.buf.relocs.len().trunc.[u32]();
        try cg.extra_relocs.push_slice(alloc, cg.buf.relocs.as_slice());
        try cg.extra_fns.push(alloc, ExtraFnEntry.{
            sym_id: p.worker_sym,
            code_off: coff,
            code_len: clen,
            reloc_start: rstart,
            reloc_len: rlen,
        });
        pi = pi +% 1_usize;
    }
    return;
}

pub linear struct CompileFnOutcome {
    pub ok: bool;
    pub blob: CompiledFnBlob;
    pub extra_fns: col.DynBuf[ExtraFnEntry];
    pub extra_code: col.DynBuf[u8];
    pub extra_relocs: col.DynBuf[x64_asm.FnReloc];
    pub err_msg: str.StrBuf;
}

impl CompileFnOutcome {
    pub fn destroy(self: CompileFnOutcome, alloc: *mut AllocCap) {
        let CompileFnOutcome.{ ok: _, blob, extra_fns, extra_code, extra_relocs, err_msg } = self;
        blob.destroy(alloc);
        extra_fns.destroy(alloc);
        extra_code.destroy(alloc);
        extra_relocs.destroy(alloc);
        err_msg.destroy(alloc);
    }
}

struct DwarfTypeTag {
    size_bytes: u8;
    encoding: u8;
}

fn classify_dwarf_type(ty: types.TyId, env: *types.TypeEnv) -> ?DwarfTypeTag {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize || lay.size > 8_usize {
        return null;
    }
    let n = env.get(ty);
    match n.kind {
        .Bool => { return DwarfTypeTag.{ size_bytes: 1_u8, encoding: 0x02_u8 }; }
        .Char => { return DwarfTypeTag.{ size_bytes: 4_u8, encoding: 0x07_u8 }; }
        .Int => {
            if lay.size == 1_usize || lay.size == 2_usize || lay.size == 4_usize || lay.size == 8_usize {
                return DwarfTypeTag.{
                    size_bytes: lay.size.trunc.[u8](),
                    encoding: if env.is_signed_int(ty) { 0x05_u8 } else { 0x07_u8 },
                };
            }
            return null;
        }
        .Float => {
            if lay.size == 4_usize || lay.size == 8_usize {
                return DwarfTypeTag.{ size_bytes: lay.size.trunc.[u8](), encoding: 0x04_u8 };
            }
            return null;
        }
        .Enum => {
            if lay.size == 1_usize || lay.size == 2_usize || lay.size == 4_usize || lay.size == 8_usize {
                return DwarfTypeTag.{ size_bytes: lay.size.trunc.[u8](), encoding: 0x07_u8 };
            }
            return null;
        }
        .RawPtr => {
            if lay.size == 8_usize { return DwarfTypeTag.{ size_bytes: 8_u8, encoding: 0x01_u8 }; }
            return null;
        }
        .Borrow => {
            if lay.size == 8_usize { return DwarfTypeTag.{ size_bytes: 8_u8, encoding: 0x01_u8 }; }
            return null;
        }
        .PhysAddr => { return DwarfTypeTag.{ size_bytes: 8_u8, encoding: 0x01_u8 }; }
        .VirtAddr => { return DwarfTypeTag.{ size_bytes: 8_u8, encoding: 0x01_u8 }; }
        .DmaAddr => { return DwarfTypeTag.{ size_bytes: 8_u8, encoding: 0x01_u8 }; }
        .FnPtr => {
            if lay.size == 8_usize { return DwarfTypeTag.{ size_bytes: 8_u8, encoding: 0x01_u8 }; }
            return null;
        }
        _ => { return null; }
    }
}

fn x64_reg_to_dwarf(r: x64_asm.Reg) -> u8 {
    match r {
        .Rax => { return 0_u8; }
        .Rdx => { return 1_u8; }
        .Rcx => { return 2_u8; }
        .Rbx => { return 3_u8; }
        .Rsi => { return 4_u8; }
        .Rdi => { return 5_u8; }
        .Rbp => { return 6_u8; }
        .Rsp => { return 7_u8; }
        .R8 => { return 8_u8; }
        .R9 => { return 9_u8; }
        .R10 => { return 10_u8; }
        .R11 => { return 11_u8; }
        .R12 => { return 12_u8; }
        .R13 => { return 13_u8; }
        .R14 => { return 14_u8; }
        .R15 => { return 15_u8; }
    }
}

fn sym_in_slice(s: *[u32], target: u32) -> bool {
    var i: usize = 0_usize;
    while i < s.len {
        if s[i] == target {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn collect_dev_debug_vars(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    fn_sym: u32,
    env: *types.TypeEnv,
    frame: *FnFramePlan,
    out: *mut col.DynBuf[elf64.DebugVarEntry],
) -> !OutOfMemory {
    let pnames = eir_prog.fn_param_names(fn_id);
    let slots = eir_prog.fn_slots(fn_id);
    let soffs = frame.slot_offs.as_slice();

    var emitted_names = try col.DynBuf.[u32].init(alloc, 8_usize);
    errdefer emitted_names.destroy(alloc);

    // 1. Named stack slots (all `var` / `let` locals and slot-backed parameters in `--dev`)
    var si: usize = 0_usize;
    while si < slots.len && si < soffs.len {
        let sl = slots[si];
        let off = soffs[si];
        if sl.has_name && sl.name != span.SYM_EMPTY && off < 0_i32 && !sym_in_slice(emitted_names.as_slice(), sl.name) {
            if let dt = classify_dwarf_type(sl.ty, env) {
                try out.push(alloc, elf64.DebugVarEntry.{
                    fn_sym: fn_sym,
                    name_sym: sl.name,
                    rbp_off: off,
                    size_bytes: dt.size_bytes,
                    encoding: dt.encoding,
                    reg_num: 255_u8,
                    is_param: sym_in_slice(pnames, sl.name),
                });
                try emitted_names.push(alloc, sl.name);
            }
        }
        si = si +% 1_usize;
    }

    // 2. Direct SSA function parameters not backed by a named slot
    let params = eir_prog.fn_params(fn_id);
    let vlocs = frame.val_locs.as_slice();
    var pi: usize = 0_usize;
    while pi < params.len && pi < pnames.len {
        let pn = pnames[pi];
        let pv = params[pi];
        let pvu = pv.widen.[usize]();
        if pn != span.SYM_EMPTY && pvu < vlocs.len && !sym_in_slice(emitted_names.as_slice(), pn) {
            let pty = eir_prog.fn_val_ty(fn_id, pv);
            if let dt = classify_dwarf_type(pty, env) {
                let vl = vlocs[pvu];
                if vl.kind == .Stack && vl.stack_off < 0_i32 {
                    try out.push(alloc, elf64.DebugVarEntry.{
                        fn_sym: fn_sym,
                        name_sym: pn,
                        rbp_off: vl.stack_off,
                        size_bytes: dt.size_bytes,
                        encoding: dt.encoding,
                        reg_num: 255_u8,
                        is_param: true,
                    });
                    try emitted_names.push(alloc, pn);
                } else if vl.kind == .Reg {
                    try out.push(alloc, elf64.DebugVarEntry.{
                        fn_sym: fn_sym,
                        name_sym: pn,
                        rbp_off: 0_i32,
                        size_bytes: dt.size_bytes,
                        encoding: dt.encoding,
                        reg_num: x64_reg_to_dwarf(vl.reg),
                        is_param: true,
                    });
                    try emitted_names.push(alloc, pn);
                }
            }
        }
        pi = pi +% 1_usize;
    }

    // 3. Named SSA locals from `eir_prog.fn_val_names` (reverse order so latest merged SSA def wins!)
    let vnames = eir_prog.fn_val_names(fn_id);
    var vni = vnames.len;
    while vni > 0_usize {
        vni = vni - 1_usize;
        let vn = vnames[vni];
        let vidx = vn.val.widen.[usize]();
        let is_live = !frame.live_active || frame.live_vals.test(vidx);
        let is_folded_imm = frame.imm32_mask.test(vidx);
        if vn.sym != span.SYM_EMPTY && vidx < vlocs.len && is_live && !is_folded_imm
            && !sym_in_slice(emitted_names.as_slice(), vn.sym)
        {
            let vty = eir_prog.fn_val_ty(fn_id, vn.val);
            if let dt = classify_dwarf_type(vty, env) {
                let vl = vlocs[vidx];
                if vl.kind == .Stack && vl.stack_off < 0_i32 {
                    try out.push(alloc, elf64.DebugVarEntry.{
                        fn_sym: fn_sym,
                        name_sym: vn.sym,
                        rbp_off: vl.stack_off,
                        size_bytes: dt.size_bytes,
                        encoding: dt.encoding,
                        reg_num: 255_u8,
                        is_param: false,
                    });
                    try emitted_names.push(alloc, vn.sym);
                } else if vl.kind == .Reg {
                    try out.push(alloc, elf64.DebugVarEntry.{
                        fn_sym: fn_sym,
                        name_sym: vn.sym,
                        rbp_off: 0_i32,
                        size_bytes: dt.size_bytes,
                        encoding: dt.encoding,
                        reg_num: x64_reg_to_dwarf(vl.reg),
                        is_param: false,
                    });
                    try emitted_names.push(alloc, vn.sym);
                }
            }
        }
    }

    emitted_names.destroy(alloc);
    return;
}

pub fn compile_function_x64(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
) -> CompileFnOutcome ! OutOfMemory {
    var fn_sym = span.SYM_EMPTY;
    var fn_body_sp = span.Span.{ file: 0_u32, start: 0_u32, end: 0_u32 };
    if let f = eir_prog.get_fn(fn_id) {
        fn_sym = try fn_sym_name_id(alloc, f.key, eir_prog, interner);
        fn_body_sp = f.body_span;
    }
    var cg = try FnCodegen.init(alloc, eir_prog, fn_id, fn_sym, env, opts);
    errdefer cg.destroy(alloc);

    let blks = eir_prog.fn_blocks(fn_id);
    var bi: usize = 0_usize;
    while bi < blks.len {
        let l = try cg.buf.new_label(alloc);
        try cg.block_labels.push(alloc, l);
        bi = bi +% 1_usize;
    }
    try cg_build_par_for_plans(alloc, &mut cg, eir_prog, interner);

    if fn_body_sp.end > fn_body_sp.start {
        try cg_record_line(alloc, &mut cg, sm, fn_body_sp);
    }
    try cg_emit_prologue(alloc, &mut cg);
    try cg_receive_params(alloc, &mut cg, eir_prog, env);

    let rpo = eir_prog.fn_rpo(fn_id);
    if rpo.len > 0_usize {
        var ri: usize = 0_usize;
        while ri < rpo.len && !cg.has_err {
            let bbid = rpo[ri];
            if cg_is_par_for_outlined_bb(&cg, bbid) {
                ri = ri +% 1_usize;
                continue;
            }
            let blbl = cg_block_label(&cg, bbid);
            cg.buf.bind_label(blbl);
            if let pidx = cg_find_par_for_by_header(&cg, bbid) {
                try cg_emit_par_for_launch(alloc, &mut cg, interner, pidx);
                ri = ri +% 1_usize;
                continue;
            }
            var next_bb = eir.EIR_NONE;
            var nri = ri +% 1_usize;
            while nri < rpo.len {
                if !cg_is_par_for_outlined_bb(&cg, rpo[nri]) {
                    next_bb = rpo[nri];
                    break;
                }
                nri = nri +% 1_usize;
            }
            if let blk = eir_prog.fn_block(fn_id, bbid) {
                let insts = eir_prog.insts_slice(blk.insts);
                let t = blk.term;
                var fuse_last = false;
                if cg.frame.live_active && !cg.is_naked && insts.len > 0_usize {
                    let last_i = insts[insts.len - 1_usize];
                    if o0_is_fusible_cmp(env, &last_i, &t) && cg.frame.val_uses(last_i.dst) == 1_u32 {
                        fuse_last = true;
                    }
                }
                let emit_end = if fuse_last && insts.len > 0_usize { insts.len - 1_usize } else { insts.len };
                var ii: usize = 0_usize;
                while ii < emit_end && !cg.has_err {
                    let ins = insts[ii];
                    try cg_emit_inst(alloc, &mut cg, sm, eir_prog, env, ct, interner, &ins);
                    ii = ii +% 1_usize;
                }
                if !cg.has_err {
                    if fuse_last && insts.len > 0_usize {
                        let cmp_ins = insts[insts.len - 1_usize];
                        try cg_emit_fused_cmp_branch(alloc, &mut cg, sm, eir_prog, env, bbid, &cmp_ins, &t, next_bb);
                    } else {
                        try cg_emit_term(alloc, &mut cg, sm, eir_prog, env, interner, bbid, &t, next_bb);
                    }
                }
            }
            ri = ri +% 1_usize;
        }
    } else {
        var idx: usize = 0_usize;
        while idx < blks.len && !cg.has_err {
            let bbid = blks[idx].id;
            let blbl2 = cg_block_label(&cg, bbid);
            cg.buf.bind_label(blbl2);
            let next_bb2 = if idx +% 1_usize < blks.len { blks[idx +% 1_usize].id } else { eir.EIR_NONE };
            let insts = eir_prog.insts_slice(blks[idx].insts);
            var ii: usize = 0_usize;
            while ii < insts.len && !cg.has_err {
                let ins = insts[ii];
                try cg_emit_inst(alloc, &mut cg, sm, eir_prog, env, ct, interner, &ins);
                ii = ii +% 1_usize;
            }
            if !cg.has_err {
                let t = blks[idx].term;
                try cg_emit_term(alloc, &mut cg, sm, eir_prog, env, interner, bbid, &t, next_bb2);
            }
            idx = idx +% 1_usize;
        }
    }

    if !cg.has_err {
        let fin_ok = cg.buf.finish();
        if !fin_ok {
            try cg_fail(alloc, &mut cg, "x86_64 codegen error: unresolved internal branch label");
        }
    }

    var blob = try CompiledFnBlob.init(alloc, fn_sym);
    errdefer blob.destroy(alloc);
    if cg.is_naked {
        blob.own_stack_bytes = 8_u64;
    } else {
        let entry_b: u64 = if cg.is_interrupt {
            40_u64 +% 112_u64 +% (if cg.frame.save_simd { 256_u64 } else { 0_u64 })
        } else {
            8_u64
        };
        let saved_b = (cg.frame.saved_regs.len() *% 8_usize).widen.[u64]();
        let frame_b: u64 = if cg.frame.frame_size > 0_i32 {
            cg.frame.frame_size.bitcast.[u32]().widen.[u64]()
        } else {
            0_u64
        };
        blob.own_stack_bytes = entry_b +% 8_u64 +% saved_b +% frame_b +% cg.max_call_stack_bytes;
    }
    try blob.code.push_slice(alloc, cg.buf.code.as_slice());
    try blob.relocs.push_slice(alloc, cg.buf.relocs.as_slice());
    try blob.rodata_items.push_slice(alloc, cg.rodata_items.as_slice());
    try blob.rodata_bytes.push_slice(alloc, cg.rodata_bytes.as_slice());
    try blob.rodata_relocs.push_slice(alloc, cg.rodata_relocs.as_slice());
    try blob.used_helpers.push_slice(alloc, cg.used_helpers.as_slice());
    try blob.line_entries.push_slice(alloc, cg.line_entries.as_slice());
    if opts.emit_debug_line && !cg.is_naked {
        try collect_dev_debug_vars(alloc, eir_prog, fn_id, fn_sym, env, &cg.frame, &mut blob.debug_vars);
    }
    try blob.fn_ref_thunks.push_slice(alloc, cg.fn_ref_thunks.as_slice());

    if !cg.has_err && cg.par_for_plans.len() > 0_usize {
        try cg_emit_par_for_workers(alloc, &mut cg, sm, eir_prog, env, ct, interner);
    }

    var efns = try col.DynBuf.[ExtraFnEntry].init(alloc, if cg.extra_fns.len() > 2_usize { cg.extra_fns.len() } else { 2_usize });
    errdefer efns.destroy(alloc);
    try efns.push_slice(alloc, cg.extra_fns.as_slice());
    var ecode = try col.DynBuf.[u8].init(alloc, if cg.extra_code.len() > 4_usize { cg.extra_code.len() } else { 4_usize });
    errdefer ecode.destroy(alloc);
    try ecode.push_slice(alloc, cg.extra_code.as_slice());
    var erel = try col.DynBuf.[x64_asm.FnReloc].init(alloc, if cg.extra_relocs.len() > 2_usize { cg.extra_relocs.len() } else { 2_usize });
    errdefer erel.destroy(alloc);
    try erel.push_slice(alloc, cg.extra_relocs.as_slice());
    var emsg = try str.StrBuf.init(alloc, 32_usize);
    errdefer emsg.destroy(alloc);
    try emsg.push_bytes_grow(alloc, cg.err_msg.as_bytes());
    let ok = !cg.has_err;

    cg.destroy(alloc);
    return CompileFnOutcome.{
        ok: ok,
        blob: blob,
        extra_fns: efns,
        extra_code: ecode,
        extra_relocs: erel,
        err_msg: emsg,
    };
}

// ===========================================================================
// Section 9: `.emi` Per-Function Incremental Machine-Code Cache Integration
// ===========================================================================

fn push_u32_le_buf(alloc: *mut AllocCap, out: *mut col.DynBuf[u8], v: u32) -> !OutOfMemory {
    try out.push(alloc, (v & 0xFF_u32).trunc.[u8]());
    try out.push(alloc, ((v >> 8_u32) & 0xFF_u32).trunc.[u8]());
    try out.push(alloc, ((v >> 16_u32) & 0xFF_u32).trunc.[u8]());
    try out.push(alloc, ((v >> 24_u32) & 0xFF_u32).trunc.[u8]());
    return;
}

fn push_u64_le_buf(alloc: *mut AllocCap, out: *mut col.DynBuf[u8], v: u64) -> !OutOfMemory {
    try push_u32_le_buf(alloc, out, (v & 0xFFFFFFFF_u64).trunc.[u32]());
    try push_u32_le_buf(alloc, out, (v >> 32_u64).trunc.[u32]());
    return;
}

fn push_sym_bytes_le(
    alloc: *mut AllocCap,
    out: *mut col.DynBuf[u8],
    interner: *span.SymInterner,
    sym_id: u32,
) -> !OutOfMemory {
    let bs = interner.get(sym_id);
    try push_u32_le_buf(alloc, out, bs.len.trunc.[u32]());
    try out.push_slice(alloc, bs);
    return;
}

struct ByteCursor {
    pos: usize;
}

fn read_u32_le_at(bs: *[u8], cur: *mut ByteCursor) -> ?u32 {
    let p0 = cur.pos;
    let p1 = p0 +% 1_usize;
    let p2 = p0 +% 2_usize;
    let p3 = p0 +% 3_usize;
    if p0 >= bs.len || p1 >= bs.len || p2 >= bs.len || p3 >= bs.len {
        return null;
    }
    let b0 = bs[p0].widen.[u32]();
    let b1 = bs[p1].widen.[u32]() <<% 8_u32;
    let b2 = bs[p2].widen.[u32]() <<% 16_u32;
    let b3 = bs[p3].widen.[u32]() <<% 24_u32;
    cur.pos = p0 +% 4_usize;
    return b0 | b1 | b2 | b3;
}

fn read_u64_le_at(bs: *[u8], cur: *mut ByteCursor) -> ?u64 {
    let lo = read_u32_le_at(bs, cur) orelse { return null; };
    let hi = read_u32_le_at(bs, cur) orelse { return null; };
    return lo.widen.[u64]() | (hi.widen.[u64]() <<% 32_u64);
}

fn read_sym_le_at(
    alloc: *mut AllocCap,
    bs: *[u8],
    cur: *mut ByteCursor,
    interner: *mut span.SymInterner,
) -> ?u32 ! OutOfMemory {
    let slen = read_u32_le_at(bs, cur) orelse { return null; };
    let p = cur.pos;
    let end = p +% slen.widen.[usize]();
    if end > bs.len {
        return null;
    }
    let slice = bs.sub(p, end) catch { return null; };
    cur.pos = end;
    let sid = try interner.intern(alloc, slice);
    return sid;
}

fn reloc_kind_to_u8(k: x64_asm.RelocKindX64) -> u8 {
    match k {
        .Rel32 => { return 0_u8; }
        .Abs64 => { return 1_u8; }
        .GotPcRel32 => { return 2_u8; }
        .Plt32 => { return 3_u8; }
        .TpOff32 => { return 4_u8; }
    }
}

fn reloc_kind_from_u8(v: u8) -> x64_asm.RelocKindX64 {
    match v {
        0_u8 => { return .Rel32; }
        1_u8 => { return .Abs64; }
        2_u8 => { return .GotPcRel32; }
        3_u8 => { return .Plt32; }
        _ => { return .TpOff32; }
    }
}

pub fn compute_opts_hash(opts: *CompileOptions) -> [32]u8 {
    // Domain-separated build/ABI/format tag + all codegen & optimization options.
    var b: [64]u8 = [0_u8; 64];
    b[0_usize] = match opts.mode.kind {
        .LinuxPie => 1_u8,
        .LinuxShared => 2_u8,
        .Freestanding => 3_u8,
    };
    b[1_usize] = if opts.sanitize { 1_u8 } else { 0_u8 };
    b[2_usize] = if opts.emit_debug_line { 1_u8 } else { 0_u8 };
    b[3_usize] = if opts.mode.multiboot2 { 1_u8 } else { 0_u8 };
    let la = opts.mode.load_addr;
    var i: usize = 0_usize;
    while i < 8_usize {
        let sh = ((i *% 8_usize).widen.[u64]()) & 63_u64;
        b[4_usize +% i] = ((la >> sh) & 0xFF_u64).trunc.[u8]();
        i = i +% 1_usize;
    }
    b[12_usize] = opts.opt.opt_level;
    b[13_usize] = if opts.opt.target_avx2 { 1_u8 } else { 0_u8 };
    b[14_usize] = (if opts.opt.verify_opt { 1_u8 } else { 0_u8 }) | (if opts.opt.opt_size { 2_u8 } else { 0_u8 });
    b[15_usize] = if opts.opt.incremental_cgu { 1_u8 } else { 0_u8 };
    let ob = opts.opt.opt_bisect.bitcast.[u64]();
    i = 0_usize;
    while i < 8_usize {
        let sh = ((i *% 8_usize).widen.[u64]()) & 63_u64;
        b[16_usize +% i] = ((ob >> sh) & 0xFF_u64).trunc.[u8]();
        i = i +% 1_usize;
    }
    // Mix in compiler ABI / format version constants (`EMI_VERSION`, `INC_MANIFEST_VERSION`, x86_64 Linux ABI v1).
    let ev = emi.EMI_VERSION;
    let mv = emi.INC_MANIFEST_VERSION;
    b[24_usize] = (ev & 0xFF_u32).trunc.[u8]();
    b[25_usize] = ((ev >> 8_u32) & 0xFF_u32).trunc.[u8]();
    b[26_usize] = ((ev >> 16_u32) & 0xFF_u32).trunc.[u8]();
    b[27_usize] = ((ev >> 24_u32) & 0xFF_u32).trunc.[u8]();
    b[28_usize] = (mv & 0xFF_u32).trunc.[u8]();
    b[29_usize] = ((mv >> 8_u32) & 0xFF_u32).trunc.[u8]();
    b[30_usize] = ((mv >> 16_u32) & 0xFF_u32).trunc.[u8]();
    b[31_usize] = ((mv >> 24_u32) & 0xFF_u32).trunc.[u8]();
    let tag = "eonc-selfhost-target-abi2\n".as_bytes();
    var ti: usize = 0_usize;
    while ti < 26_usize && ti < tag.len {
        b[32_usize +% ti] = tag[ti];
        ti = ti +% 1_usize;
    }
    b[58_usize] = match opts.target_spec.arch {
        .X86_64 => 1_u8,
        .AArch64 => 2_u8,
        .RiscV64 => 3_u8,
    };
    b[59_usize] = match opts.target_spec.os {
        .Linux => 1_u8,
        .Windows => 2_u8,
        .MacOS => 3_u8,
        .Android => 4_u8,
        .IOS => 5_u8,
        .NoStd => 6_u8,
    };
    b[60_usize] = match opts.target_spec.fmt {
        .Elf64 => 1_u8,
        .PeCoff => 2_u8,
        .MachO => 3_u8,
    };
    b[61_usize] = match opts.target_spec.abi {
        .SysV => 1_u8,
        .Win64 => 2_u8,
        .Aapcs64 => 3_u8,
        .Lp64d => 4_u8,
    };
    b[62_usize] = (if opts.target_spec.is_pie { 1_u8 } else { 0_u8 })
        | (if opts.target_spec.is_shared { 2_u8 } else { 0_u8 })
        | (if opts.target_spec.is_nostd { 4_u8 } else { 0_u8 });
    b[63_usize] = (if opts.target_spec.has_avx2 { 1_u8 } else { 0_u8 })
        | (if opts.target_spec.has_neon { 2_u8 } else { 0_u8 })
        | (if opts.target_spec.has_rvc { 4_u8 } else { 0_u8 });
    let d = tcb_audit.sha256(&b);
    return d.bytes;
}

fn hash_eir_function(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    fn_sym: u32,
    interner: *span.SymInterner,
    opts_hash: *[32]u8,
) -> [32]u8 ! OutOfMemory {
    var sig_buf = try col.DynBuf.[u8].init(alloc, 64_usize);
    errdefer sig_buf.destroy(alloc);
    var body_buf = try col.DynBuf.[u8].init(alloc, 256_usize);
    errdefer body_buf.destroy(alloc);

    if let f = eir_prog.get_fn(fn_id) {
        try push_u32_le_buf(alloc, &mut sig_buf, f.sig.ret);
        let ps = eir_prog.fn_params(fn_id);
        try push_u32_le_buf(alloc, &mut sig_buf, ps.len.trunc.[u32]());
        var pi: usize = 0_usize;
        while pi < ps.len {
            try push_u32_le_buf(alloc, &mut sig_buf, eir_prog.fn_val_ty(fn_id, ps[pi]));
            pi = pi +% 1_usize;
        }
        let blks = eir_prog.fn_blocks(fn_id);
        try push_u32_le_buf(alloc, &mut body_buf, blks.len.trunc.[u32]());
        var bi: usize = 0_usize;
        while bi < blks.len {
            let blk = blks[bi];
            try push_u32_le_buf(alloc, &mut body_buf, blk.id);
            let insts = eir_prog.insts_slice(blk.insts);
            try push_u32_le_buf(alloc, &mut body_buf, insts.len.trunc.[u32]());
            var ii: usize = 0_usize;
            while ii < insts.len {
                let ins = insts[ii];
                try push_u32_le_buf(alloc, &mut body_buf, ins.dst);
                try push_u32_le_buf(alloc, &mut body_buf, ins.v0);
                try push_u32_le_buf(alloc, &mut body_buf, ins.v1);
                try push_u32_le_buf(alloc, &mut body_buf, ins.aux0);
                try push_u32_le_buf(alloc, &mut body_buf, ins.ty0);
                try push_u32_le_buf(alloc, &mut body_buf, ins.ty1);
                ii = ii +% 1_usize;
            }
            try push_u32_le_buf(alloc, &mut body_buf, blk.term.val);
            try push_u32_le_buf(alloc, &mut body_buf, blk.term.bb0);
            try push_u32_le_buf(alloc, &mut body_buf, blk.term.bb1);
            bi = bi +% 1_usize;
        }
    }
    let digest = try emi.compute_fn_hash(
        alloc,
        interner.get(fn_sym),
        sig_buf.as_slice(),
        body_buf.as_slice(),
        opts_hash,
    );
    body_buf.destroy(alloc);
    sig_buf.destroy(alloc);
    return digest.bytes;
}

fn serialize_blob_meta(
    alloc: *mut AllocCap,
    blob: *CompiledFnBlob,
    interner: *span.SymInterner,
    out: *mut col.DynBuf[u8],
) -> !OutOfMemory {
    // Magic header "MB02"
    try out.push_slice(alloc, "MB02".as_bytes());
    let rels = blob.relocs.as_slice();
    try push_u32_le_buf(alloc, out, rels.len.trunc.[u32]());
    var i: usize = 0_usize;
    while i < rels.len {
        let r = rels[i];
        try push_u32_le_buf(alloc, out, r.offset);
        try out.push(alloc, reloc_kind_to_u8(r.kind));
        try push_sym_bytes_le(alloc, out, interner, r.sym_id);
        try push_u64_le_buf(alloc, out, r.addend.bitcast.[u64]());
        i = i +% 1_usize;
    }
    let ro_items = blob.rodata_items.as_slice();
    let ro_bytes = blob.rodata_bytes.as_slice();
    try push_u32_le_buf(alloc, out, ro_items.len.trunc.[u32]());
    i = 0_usize;
    while i < ro_items.len {
        let it = ro_items[i];
        try push_sym_bytes_le(alloc, out, interner, it.sym_id);
        try push_u32_le_buf(alloc, out, it.align);
        try push_u32_le_buf(alloc, out, it.reloc_start);
        try push_u32_le_buf(alloc, out, it.reloc_len);
        try push_u32_le_buf(alloc, out, it.data_len);
        let s = it.data_off.widen.[usize]();
        let e = s +% it.data_len.widen.[usize]();
        if e <= ro_bytes.len {
            let sub = ro_bytes.sub(s, e) catch { return; };
            try out.push_slice(alloc, sub);
        }
        i = i +% 1_usize;
    }
    let ro_rels = blob.rodata_relocs.as_slice();
    try push_u32_le_buf(alloc, out, ro_rels.len.trunc.[u32]());
    i = 0_usize;
    while i < ro_rels.len {
        let rr = ro_rels[i];
        try push_u32_le_buf(alloc, out, rr.offset);
        try push_sym_bytes_le(alloc, out, interner, rr.target_sym);
        try push_u64_le_buf(alloc, out, rr.addend.bitcast.[u64]());
        i = i +% 1_usize;
    }
    let helpers = blob.used_helpers.as_slice();
    try push_u32_le_buf(alloc, out, helpers.len.trunc.[u32]());
    i = 0_usize;
    while i < helpers.len {
        try push_sym_bytes_le(alloc, out, interner, helpers[i]);
        i = i +% 1_usize;
    }
    let lines = blob.line_entries.as_slice();
    try push_u32_le_buf(alloc, out, lines.len.trunc.[u32]());
    i = 0_usize;
    while i < lines.len {
        try push_u32_le_buf(alloc, out, lines[i].code_offset);
        try push_u32_le_buf(alloc, out, lines[i].file_idx);
        try push_u32_le_buf(alloc, out, lines[i].line);
        try push_u32_le_buf(alloc, out, lines[i].col);
        i = i +% 1_usize;
    }
    return;
}

fn deserialize_blob_meta(
    alloc: *mut AllocCap,
    meta: *[u8],
    interner: *mut span.SymInterner,
    blob: *mut CompiledFnBlob,
) -> bool ! OutOfMemory {
    if meta.len < 4_usize || meta[0_usize] != b'M' || meta[1_usize] != b'B'
        || meta[2_usize] != b'0' || meta[3_usize] != b'2'
    {
        return false;
    }
    var cur = ByteCursor.{ pos: 4_usize };
    let nrel = read_u32_le_at(meta, &mut cur) orelse { return false; };
    var i: u32 = 0_u32;
    while i < nrel {
        let roff = read_u32_le_at(meta, &mut cur) orelse { return false; };
        if cur.pos >= meta.len { return false; }
        let kind = reloc_kind_from_u8(meta[cur.pos]);
        cur.pos = cur.pos +% 1_usize;
        let sym = (try read_sym_le_at(alloc, meta, &mut cur, interner)) orelse { return false; };
        let add = read_u64_le_at(meta, &mut cur) orelse { return false; };
        try blob.relocs.push(alloc, x64_asm.FnReloc.{
            offset: roff,
            kind: kind,
            sym_id: sym,
            addend: add.bitcast.[i64](),
        });
        i = i +% 1_u32;
    }
    let nro = read_u32_le_at(meta, &mut cur) orelse { return false; };
    i = 0_u32;
    while i < nro {
        let sym = (try read_sym_le_at(alloc, meta, &mut cur, interner)) orelse { return false; };
        let align = read_u32_le_at(meta, &mut cur) orelse { return false; };
        let rstart = read_u32_le_at(meta, &mut cur) orelse { return false; };
        let rlen = read_u32_le_at(meta, &mut cur) orelse { return false; };
        let dlen = read_u32_le_at(meta, &mut cur) orelse { return false; };
        let end = cur.pos +% dlen.widen.[usize]();
        if end > meta.len { return false; }
        let slice = meta.sub(cur.pos, end) catch { return false; };
        cur.pos = end;
        let doff = blob.rodata_bytes.len().trunc.[u32]();
        try blob.rodata_bytes.push_slice(alloc, slice);
        try blob.rodata_items.push(alloc, RodataItemMeta.{
            sym_id: sym,
            data_off: doff,
            data_len: dlen,
            align: align,
            reloc_start: rstart,
            reloc_len: rlen,
        });
        i = i +% 1_u32;
    }
    let nror = read_u32_le_at(meta, &mut cur) orelse { return false; };
    i = 0_u32;
    while i < nror {
        let roff = read_u32_le_at(meta, &mut cur) orelse { return false; };
        let sym = (try read_sym_le_at(alloc, meta, &mut cur, interner)) orelse { return false; };
        let add = read_u64_le_at(meta, &mut cur) orelse { return false; };
        try blob.rodata_relocs.push(alloc, RodataReloc.{
            offset: roff,
            target_sym: sym,
            addend: add.bitcast.[i64](),
        });
        i = i +% 1_u32;
    }
    let nh = read_u32_le_at(meta, &mut cur) orelse { return false; };
    i = 0_u32;
    while i < nh {
        let sym = (try read_sym_le_at(alloc, meta, &mut cur, interner)) orelse { return false; };
        try blob.used_helpers.push(alloc, sym);
        i = i +% 1_u32;
    }
    let nl = read_u32_le_at(meta, &mut cur) orelse { return false; };
    i = 0_u32;
    while i < nl {
        let coff = read_u32_le_at(meta, &mut cur) orelse { return false; };
        let fidx = read_u32_le_at(meta, &mut cur) orelse { return false; };
        let line = read_u32_le_at(meta, &mut cur) orelse { return false; };
        let col = read_u32_le_at(meta, &mut cur) orelse { return false; };
        try blob.line_entries.push(alloc, elf64.LineEntry.{
            code_offset: coff,
            file_idx: fidx,
            line: line,
            col: col,
        });
        i = i +% 1_u32;
    }
    return true;
}

// ===========================================================================
// Section 10: Linux `_start`, Vtables, FnRef Thunks, Tree-Shaking & ELF64 Link
// ===========================================================================

fn pad_dyn_u8(alloc: *mut AllocCap, buf: *mut col.DynBuf[u8], align: usize) -> !OutOfMemory {
    let target = types.align_up_usize(buf.len(), align);
    while buf.len() < target {
        try buf.push(alloc, 0_u8);
    }
    return;
}

fn find_entry_by_name(
    eir_prog: *eir.EirProgram,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    target_name: *str,
) -> ?u32 {
    let nfns = eir_prog.fn_count();
    let tbytes = target_name.as_bytes();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if let f = eir_prog.get_fn(fi) {
            if f.key.kind == .TopDef && str.bytes_eq(interner.get(f.name), tbytes) {
                if let d = prog.get_def(f.key.a) {
                    if d.kind == .Fn {
                        return fi;
                    }
                } else {
                    return fi;
                }
            }
        }
        fi = fi +% 1_u32;
    }
    return null;
}

fn find_entry_fn_id(
    eir_prog: *eir.EirProgram,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    mode: elf64.ElfMode,
) -> ?u32 {
    if mode.kind == .LinuxShared {
        return null;
    }
    if let id0 = find_entry_by_name(eir_prog, prog, interner, "main") { return id0; }
    if let id1 = find_entry_by_name(eir_prog, prog, interner, "_start") { return id1; }
    if let id2 = find_entry_by_name(eir_prog, prog, interner, "kmain") { return id2; }
    if mode.kind == .Freestanding {
        let nfns = eir_prog.fn_count();
        var fi: u32 = 0_u32;
        while fi < nfns {
            if let f = eir_prog.get_fn(fi) {
                if !f.sig.effects.is_gpu {
                    return fi;
                }
            }
            fi = fi +% 1_u32;
        }
    }
    return null;
}

fn emit_linux_start_into(
    alloc: *mut AllocCap,
    main_fid: u32,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
    needed_libs: *[u32],
    has_sched: bool,
    out_buf: *mut x64_asm.X64Buf,
    needed_helpers: *mut col.DynBuf[u32],
) -> bool ! OutOfMemory {
    out_buf.clear();
    let mf = eir_prog.get_fn(main_fid) orelse { return false; };

    // Step A: Parse argc / argv / envp / auxv (AT_BASE -> R13, AT_SYSINFO_EHDR -> R14, envp -> R15).
    try out_buf.mov_rr(alloc, .R12, .Rsp);
    try out_buf.load_mem(alloc, .Rdi, .R12, 0_i32, 8_usize, false);
    try out_buf.lea_mem(alloc, .Rax, .Rdi, 2_i32);
    try out_buf.shl_imm(alloc, .Rax, 3_u8);
    try out_buf.add_rr(alloc, .Rax, .R12);
    try out_buf.mov_rr(alloc, .R15, .Rax);

    let l_env = try out_buf.new_label(alloc);
    out_buf.bind_label(l_env);
    try out_buf.load_mem(alloc, .Rcx, .Rax, 0_i32, 8_usize, false);
    try out_buf.add_ri32(alloc, .Rax, 8_i32);
    try out_buf.test_rr(alloc, .Rcx, .Rcx);
    try out_buf.jcc_label(alloc, .Ne, l_env);

    try out_buf.xor_rr32(alloc, .R13, .R13);
    try out_buf.xor_rr32(alloc, .R14, .R14);
    let l_aux = try out_buf.new_label(alloc);
    let l_aux_done = try out_buf.new_label(alloc);
    let l_chk_vdso = try out_buf.new_label(alloc);
    let l_aux_next = try out_buf.new_label(alloc);
    out_buf.bind_label(l_aux);
    try out_buf.load_mem(alloc, .Rcx, .Rax, 0_i32, 8_usize, false);
    try out_buf.test_rr(alloc, .Rcx, .Rcx);
    try out_buf.jcc_label(alloc, .E, l_aux_done);
    try out_buf.load_mem(alloc, .Rdx, .Rax, 8_i32, 8_usize, false);
    try out_buf.cmp_ri32(alloc, .Rcx, 7_i32);
    try out_buf.jcc_label(alloc, .Ne, l_chk_vdso);
    try out_buf.mov_rr(alloc, .R13, .Rdx);
    try out_buf.jmp_label(alloc, l_aux_next);
    out_buf.bind_label(l_chk_vdso);
    try out_buf.cmp_ri32(alloc, .Rcx, 33_i32);
    try out_buf.jcc_label(alloc, .Ne, l_aux_next);
    try out_buf.mov_rr(alloc, .R14, .Rdx);
    out_buf.bind_label(l_aux_next);
    try out_buf.add_ri32(alloc, .Rax, 16_i32);
    try out_buf.jmp_label(alloc, l_aux);
    out_buf.bind_label(l_aux_done);

    // Step B: Self-relocate Static PIE when needed_libs is empty and AT_BASE == 0.
    if needed_libs.len == 0_usize {
        let l_skip_reloc = try out_buf.new_label(alloc);
        let l_rel_lp = try out_buf.new_label(alloc);
        let l_rel_next = try out_buf.new_label(alloc);
        let s_ehdr = try interner.intern_str(alloc, "__eon_ehdr_start");
        let s_rstart = try interner.intern_str(alloc, "__eon_rela_dyn_start");
        let s_rend = try interner.intern_str(alloc, "__eon_rela_dyn_end");
        try out_buf.test_rr(alloc, .R13, .R13);
        try out_buf.jcc_label(alloc, .Ne, l_skip_reloc);
        try out_buf.lea_rip_sym(alloc, .R8, s_ehdr, 0_i64);
        try out_buf.lea_rip_sym(alloc, .R9, s_rstart, 0_i64);
        try out_buf.lea_rip_sym(alloc, .R10, s_rend, 0_i64);
        out_buf.bind_label(l_rel_lp);
        try out_buf.cmp_rr(alloc, .R9, .R10);
        try out_buf.jcc_label(alloc, .Ae, l_skip_reloc);
        try out_buf.load_mem(alloc, .Rcx, .R9, 8_i32, 4_usize, false);
        try out_buf.cmp_ri32(alloc, .Rcx, 8_i32);
        try out_buf.jcc_label(alloc, .Ne, l_rel_next);
        try out_buf.load_mem(alloc, .Rax, .R9, 0_i32, 8_usize, false);
        try out_buf.load_mem(alloc, .Rdx, .R9, 16_i32, 8_usize, false);
        try out_buf.add_rr(alloc, .Rax, .R8);
        try out_buf.add_rr(alloc, .Rdx, .R8);
        try out_buf.store_mem(alloc, .Rax, 0_i32, .Rdx, 8_usize);
        out_buf.bind_label(l_rel_next);
        try out_buf.add_ri32(alloc, .R9, 24_i32);
        try out_buf.jmp_label(alloc, l_rel_lp);
        out_buf.bind_label(l_skip_reloc);
    }

    // Step C: Store __eon_envp, init TLS, vDSO, optional sanitizer signal handler.
    let s_envp = try interner.intern_str(alloc, "__eon_envp");
    try out_buf.mov_rip_store(alloc, s_envp, 0_i64, .R15);
    let s_tls = try interner.intern_str(alloc, "eon_rt_tls_init");
    try out_buf.call_sym(alloc, s_tls);
    try needed_helpers.push(alloc, s_tls);

    let l_no_vdso = try out_buf.new_label(alloc);
    try out_buf.test_rr(alloc, .R14, .R14);
    try out_buf.jcc_label(alloc, .E, l_no_vdso);
    try out_buf.mov_rr(alloc, .Rdi, .R14);
    let s_vdso = try interner.intern_str(alloc, "eon_rt_parse_vdso");
    try out_buf.call_sym(alloc, s_vdso);
    try needed_helpers.push(alloc, s_vdso);
    out_buf.bind_label(l_no_vdso);

    if opts.sanitize {
        let s_san = try interner.intern_str(alloc, "eon_rt_install_san_handler");
        try out_buf.call_sym(alloc, s_san);
        try needed_helpers.push(alloc, s_san);
    }

    // Step D: Build Env / AllocCap if main expects one, then call main.
    let sig_ps = env.params_range(mf.sig.params);
    var takes_env = false;
    var takes_alloc = false;
    if mf.params.len == 1_u32 && sig_ps.len >= 1_usize {
        var p0_ty = sig_ps[0_usize].ty;
        let p0n = env.get(p0_ty);
        if (p0n.kind == .Borrow && p0n.borrow_kind == .Single) || p0n.kind == .RawPtr {
            p0_ty = p0n.primary;
        }
        let dn = env.get(p0_ty);
        if dn.kind == .Builtin && dn.builtin_kind == .Env {
            takes_env = true;
        } else if dn.kind == .Builtin && dn.builtin_kind == .AllocCap {
            takes_alloc = true;
        }
    }

    if takes_env {
        try out_buf.sub_ri32(alloc, .Rsp, 96_i32);
        try out_buf.xor_rr32(alloc, .Rax, .Rax);
        var off: i32 = 0_i32;
        while off < 88_i32 {
            try out_buf.store_mem(alloc, .Rsp, off, .Rax, 8_usize);
            off = off +% 8_i32;
        }
        try out_buf.mov_ri64(alloc, .Rax, 0xFFFFFFFFFFFFFF9C_u64); // AT_FDCWD = -100
        try out_buf.store_mem(alloc, .Rsp, 40_i32, .Rax, 8_usize);
        try out_buf.mov_ri64(alloc, .Rax, 1_u64);
        try out_buf.store_mem(alloc, .Rsp, 56_i32, .Rax, 8_usize);
        try out_buf.store_mem(alloc, .Rsp, 64_i32, .Rax, 8_usize);
        try out_buf.load_mem(alloc, .Rax, .R12, 0_i32, 8_usize, false);
        try out_buf.store_mem(alloc, .Rsp, 72_i32, .Rax, 8_usize);
        try out_buf.lea_mem(alloc, .Rax, .R12, 8_i32);
        try out_buf.store_mem(alloc, .Rsp, 80_i32, .Rax, 8_usize);
        try out_buf.mov_rr(alloc, .Rdi, .Rsp);
    } else if takes_alloc {
        try out_buf.sub_ri32(alloc, .Rsp, 48_i32);
        try out_buf.xor_rr32(alloc, .Rax, .Rax);
        var off: i32 = 0_i32;
        while off < 40_i32 {
            try out_buf.store_mem(alloc, .Rsp, off, .Rax, 8_usize);
            off = off +% 8_i32;
        }
        try out_buf.mov_rr(alloc, .Rdi, .Rsp);
    }

    let main_sym = try fn_sym_name_id(alloc, mf.key, eir_prog, interner);
    try out_buf.call_sym(alloc, main_sym);

    // Compute exit code in callee-saved Rbx before optional scheduler shutdown.
    let rn = env.get(mf.sig.ret);
    if rn.kind == .Int {
        try out_buf.mov_rr(alloc, .Rbx, .Rax);
    } else if rn.kind == .ErrorUnion {
        let l_err = try out_buf.new_label(alloc);
        let l_exit = try out_buf.new_label(alloc);
        try out_buf.jcc_label(alloc, .B, l_err);
        if rn.primary == types.TY_VOID || rn.primary == types.TY_NEVER {
            try out_buf.xor_rr32(alloc, .Rbx, .Rbx);
        } else {
            try out_buf.mov_rr(alloc, .Rbx, .Rax);
        }
        try out_buf.jmp_label(alloc, l_exit);
        out_buf.bind_label(l_err);
        try out_buf.mov_rr(alloc, .Rbx, .R15);
        out_buf.bind_label(l_exit);
    } else {
        try out_buf.xor_rr32(alloc, .Rbx, .Rbx);
    }

    // Step E: Clean scheduler shutdown & SYS_exit_group(231).
    if has_sched {
        let s_sd = try interner.intern_str(alloc, "eon_sched_shutdown");
        try out_buf.call_sym(alloc, s_sd);
        try needed_helpers.push(alloc, s_sd);
    }
    try out_buf.mov_rr(alloc, .Rdi, .Rbx);
    try out_buf.mov_ri64(alloc, .Rax, 231_u64);
    try out_buf.syscall(alloc);
    try out_buf.ud2(alloc);
    return out_buf.finish();
}

/// Emit Win64 PE32+ entry point (`mainCRTStartup`) setting up `Env`/`AllocCap`, calling Eon `main`, and calling `ExitProcess`.
fn emit_win64_start_into(
    alloc: *mut AllocCap,
    main_fid: u32,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    out_buf: *mut x64_asm.X64Buf,
) -> bool ! OutOfMemory {
    out_buf.clear();
    let mf = eir_prog.get_fn(main_fid) orelse { return false; };
    // At entry to PE32+ entry point, RSP is 8 mod 16; `push rbp` aligns RSP to 0 mod 16.
    try out_buf.push(alloc, .Rbp);
    try out_buf.mov_rr(alloc, .Rbp, .Rsp);
    try out_buf.sub_ri32(alloc, .Rsp, 128_i32); // 32B shadow space + 96B Env/AllocCap
    try out_buf.xor_rr32(alloc, .Rax, .Rax);
    var off: i32 = 32_i32;
    while off < 128_i32 {
        try out_buf.store_mem(alloc, .Rsp, off, .Rax, 8_usize);
        off = off +% 8_i32;
    }
    let sig_ps = env.params_range(mf.sig.params);
    if mf.params.len == 1_u32 && sig_ps.len >= 1_usize {
        try out_buf.lea_mem(alloc, .Rdi, .Rsp, 32_i32);
    }
    let main_sym = try fn_sym_name_id(alloc, mf.key, eir_prog, interner);
    try out_buf.call_sym(alloc, main_sym);

    let rn = env.get(mf.sig.ret);
    if rn.kind == .Int {
        try out_buf.mov_rr(alloc, .Rcx, .Rax);
    } else if rn.kind == .ErrorUnion {
        let l_err = try out_buf.new_label(alloc);
        let l_done = try out_buf.new_label(alloc);
        try out_buf.jcc_label(alloc, .B, l_err);
        if rn.primary == types.TY_VOID || rn.primary == types.TY_NEVER {
            try out_buf.xor_rr32(alloc, .Rcx, .Rcx);
        } else {
            try out_buf.mov_rr(alloc, .Rcx, .Rax);
        }
        try out_buf.jmp_label(alloc, l_done);
        out_buf.bind_label(l_err);
        try out_buf.mov_rr(alloc, .Rcx, .R15);
        out_buf.bind_label(l_done);
    } else {
        try out_buf.xor_rr32(alloc, .Rcx, .Rcx);
    }
    let s_exit = try interner.intern_str(alloc, "ExitProcess");
    try out_buf.call_sym(alloc, s_exit);
    try out_buf.ud2(alloc);
    return out_buf.finish();
}

/// Emit Darwin x86_64 `_main(argc=rdi, argv=rsi) -> exit_code=rax` entry point.
fn emit_darwin_x64_start_into(
    alloc: *mut AllocCap,
    main_fid: u32,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    out_buf: *mut x64_asm.X64Buf,
) -> bool ! OutOfMemory {
    out_buf.clear();
    let mf = eir_prog.get_fn(main_fid) orelse { return false; };
    try out_buf.push(alloc, .Rbp);
    try out_buf.mov_rr(alloc, .Rbp, .Rsp);
    try out_buf.sub_ri32(alloc, .Rsp, 96_i32);
    try out_buf.xor_rr32(alloc, .Rax, .Rax);
    var off: i32 = 0_i32;
    while off < 96_i32 {
        try out_buf.store_mem(alloc, .Rsp, off, .Rax, 8_usize);
        off = off +% 8_i32;
    }
    try out_buf.store_mem(alloc, .Rsp, 72_i32, .Rdi, 8_usize);
    try out_buf.store_mem(alloc, .Rsp, 80_i32, .Rsi, 8_usize);
    let sig_ps = env.params_range(mf.sig.params);
    if mf.params.len == 1_u32 && sig_ps.len >= 1_usize {
        try out_buf.mov_rr(alloc, .Rdi, .Rsp);
    }
    let main_sym = try fn_sym_name_id(alloc, mf.key, eir_prog, interner);
    try out_buf.call_sym(alloc, main_sym);
    let rn = env.get(mf.sig.ret);
    if rn.kind == .ErrorUnion {
        let l_err = try out_buf.new_label(alloc);
        let l_done = try out_buf.new_label(alloc);
        try out_buf.jcc_label(alloc, .B, l_err);
        if rn.primary == types.TY_VOID || rn.primary == types.TY_NEVER {
            try out_buf.xor_rr32(alloc, .Rax, .Rax);
        }
        try out_buf.jmp_label(alloc, l_done);
        out_buf.bind_label(l_err);
        try out_buf.mov_rr(alloc, .Rax, .R15);
        out_buf.bind_label(l_done);
    } else if rn.kind != .Int {
        try out_buf.xor_rr32(alloc, .Rax, .Rax);
    }
    try out_buf.add_ri32(alloc, .Rsp, 96_i32);
    try out_buf.pop(alloc, .Rbp);
    try out_buf.ret(alloc);
    return out_buf.finish();
}

fn emit_dyn_vtables_x64(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    input: *mut elf64.ElfLinkInput,
) -> !OutOfMemory {
    let pairs = eir_prog.dyn_impl_pairs_slice();
    let impls = env.decls.impls.as_slice();
    var pi: usize = 0_usize;
    while pi < pairs.len {
        let pair = pairs[pi];
        if let imeta = env.get_iface(pair.iface_def) {
            let cn = env.get(pair.concrete_ty);
            var has_target = false;
            var tkind: types.MethodTargetKind = .Def;
            var tdef: u32 = 0_u32;
            var tbk: resolve.BuiltinKind = .Prim;
            if cn.kind == .Struct || cn.kind == .Pool || cn.kind == .Enum || cn.kind == .Union || cn.kind == .Bitfield {
                has_target = true;
                tkind = .Def;
                tdef = cn.primary;
            } else if cn.kind == .Builtin {
                has_target = true;
                tkind = .Builtin;
                tbk = cn.builtin_kind;
            }
            if has_target {
                var found_impl: usize = impls.len;
                var ii: usize = 0_usize;
                while ii < impls.len {
                    let im = impls[ii];
                    if im.has_iface && im.iface_def == pair.iface_def && im.target.kind == tkind {
                        if (tkind == .Def && im.target.def_id == tdef)
                            || (tkind == .Builtin && im.target.builtin == tbk)
                        {
                            found_impl = ii;
                            break;
                        }
                    }
                    ii = ii +% 1_usize;
                }
                if found_impl < impls.len {
                    try pad_dyn_u8(alloc, &mut input.data_rel_ro, 8_usize);
                    let vt_off = input.data_rel_ro.len().widen.[u64]();
                    let vt_sym = try intern_sym_u64_2(alloc, interner, "eon_vtable_", pair.iface_def.widen.[u64](), pair.concrete_ty.widen.[u64]());
                    let imethods = env.iface_methods_range(imeta.methods);
                    let vt_cnt = if imethods.len == 0_usize { 1_usize } else { imethods.len };
                    try input.symbols.push(alloc, elf64.ElfSymbol.{
                        name_sym: vt_sym,
                        section: .DataRelRo,
                        offset: vt_off,
                        size: (vt_cnt *% 8_usize).widen.[u64](),
                        is_global: true,
                        is_func: false,
                    });
                    if imethods.len == 0_usize {
                        var zi: usize = 0_usize;
                        while zi < 8_usize { try input.data_rel_ro.push(alloc, 0_u8); zi = zi +% 1_usize; }
                    } else {
                        let impl_ms = env.impl_methods_range(impls[found_impl].methods);
                        var mi: usize = 0_usize;
                        while mi < imethods.len {
                            let mname = imethods[mi].name;
                            var matched_sub: u32 = eir.EIR_NONE;
                            var k: usize = 0_usize;
                            while k < impl_ms.len {
                                if impl_ms[k].sig.name == mname {
                                    matched_sub = impl_ms[k].sub_idx;
                                    break;
                                }
                                k = k +% 1_usize;
                            }
                            if matched_sub == eir.EIR_NONE {
                                var zi: usize = 0_usize;
                                while zi < 8_usize { try input.data_rel_ro.push(alloc, 0_u8); zi = zi +% 1_usize; }
                            } else {
                                let target_sym = try fn_sym_name_id(alloc, cfg_ir.fn_key_impl_method(found_impl.trunc.[u32](), matched_sub), eir_prog, interner);
                                var tb = try x64_asm.X64Buf.init(alloc);
                                errdefer tb.destroy(alloc);
                                try tb.jmp_sym(alloc, target_sym);
                                _ = tb.finish();
                                try pad_dyn_u8(alloc, &mut input.text, 8_usize);
                                let toff = input.text.len().widen.[u64]();
                                let tsym = try intern_sym_u64_3(alloc, interner, "eon_thunk_", pair.iface_def.widen.[u64](), pair.concrete_ty.widen.[u64](), mi.widen.[u64]());
                                try input.symbols.push(alloc, elf64.ElfSymbol.{
                                    name_sym: tsym,
                                    section: .Text,
                                    offset: toff,
                                    size: tb.code.len().widen.[u64](),
                                    is_global: true,
                                    is_func: true,
                                });
                                let trels = tb.relocs.as_slice();
                                var ri: usize = 0_usize;
                                while ri < trels.len {
                                    try input.relocs.push(alloc, elf64.ElfReloc.{
                                        section: .Text,
                                        offset: toff +% trels[ri].offset.widen.[u64](),
                                        kind: x64_reloc_to_elf(trels[ri].kind),
                                        target_sym: trels[ri].sym_id,
                                        addend: trels[ri].addend,
                                    });
                                    ri = ri +% 1_usize;
                                }
                                try input.text.push_slice(alloc, tb.code.as_slice());

                                let slot_off = input.data_rel_ro.len().widen.[u64]();
                                var zi: usize = 0_usize;
                                while zi < 8_usize { try input.data_rel_ro.push(alloc, 0_u8); zi = zi +% 1_usize; }
                                try input.relocs.push(alloc, elf64.ElfReloc.{
                                    section: .DataRelRo,
                                    offset: slot_off,
                                    kind: .Abs64,
                                    target_sym: tsym,
                                    addend: 0_i64,
                                });
                                tb.destroy(alloc);
                            }
                            mi = mi +% 1_usize;
                        }
                    }
                }
            }
        }
        pi = pi +% 1_usize;
    }
    return;
}

fn emit_fnref_thunks_x64(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    is_linux: bool,
    reqs: *[FnRefThunkReq],
    input: *mut elf64.ElfLinkInput,
) -> !OutOfMemory {
    var seen = try col.HashMap.[u32].init(alloc, 16_usize);
    errdefer seen.destroy(alloc);
    let ext_fns = eir_prog.extern_fns_slice();
    var ri: usize = 0_usize;
    while ri < reqs.len {
        let req = reqs[ri];
        let key = req.target_def.widen.[u64]();
        if seen.contains(key) {
            ri = ri +% 1_usize;
            continue;
        }
        try seen.insert(alloc, key, 1_u32);

        let target_sym = try fn_sym_name_id(alloc, cfg_ir.fn_key_top_def(req.target_def), eir_prog, interner);
        var start_idx: usize = 0_usize;
        var user_gp: usize = 0_usize;
        var is_c_abi = false;
        if let fid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(req.target_def)) {
            if let f = eir_prog.get_fn(fid) {
                is_c_abi = f.sig.effects.is_export_c;
                let rc = classify_ret(f.sig.ret, env);
                if ret_uses_sret(rc) { start_idx = 1_usize; }
                let ps = env.params_range(f.sig.params);
                var pi: usize = 0_usize;
                while pi < ps.len {
                    let cls = classify_arg(ps[pi].ty, env);
                    if cls == .IntReg || cls == .ByPtr { user_gp = user_gp +% 1_usize; }
                    else if cls == .TwoIntRegs { user_gp = user_gp +% 2_usize; }
                    pi = pi +% 1_usize;
                }
            }
        } else if let fsig = env.get_fn(req.target_def) {
            let rc = classify_ret(fsig.ret, env);
            if ret_uses_sret(rc) { start_idx = 1_usize; }
            let ps = env.params_range(fsig.params);
            var pi: usize = 0_usize;
            while pi < ps.len {
                let cls = classify_arg(ps[pi].ty, env);
                if cls == .IntReg || cls == .ByPtr { user_gp = user_gp +% 1_usize; }
                else if cls == .TwoIntRegs { user_gp = user_gp +% 2_usize; }
                pi = pi +% 1_usize;
            }
        }

        var is_ext_only = false;
        if eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(req.target_def)) == null {
            var ei: usize = 0_usize;
            while ei < ext_fns.len {
                if ext_fns[ei] == req.target_def {
                    is_ext_only = true;
                    break;
                }
                ei = ei +% 1_usize;
            }
        }
        if is_ext_only { is_c_abi = true; }

        var tb = try x64_asm.X64Buf.init(alloc);
        errdefer tb.destroy(alloc);
        if !is_c_abi {
            var gi = start_idx;
            while gi < 7_usize {
                if let r0 = gp_arg_reg(false, gi) {
                    if let r1 = gp_arg_reg(false, gi +% 1_usize) {
                        try tb.mov_rr(alloc, r0, r1);
                    }
                }
                gi = gi +% 1_usize;
            }
            if start_idx +% user_gp == 8_usize {
                try tb.load_mem(alloc, .R11, .Rsp, 8_i32, 8_usize, false);
            }
        }
        if is_ext_only && is_linux && !is_builtin_rt_helper(interner.get(target_sym)) {
            try tb.jmp_plt_sym(alloc, target_sym);
        } else {
            try tb.jmp_sym(alloc, target_sym);
        }
        _ = tb.finish();

        try pad_dyn_u8(alloc, &mut input.text, 8_usize);
        let toff = input.text.len().widen.[u64]();
        try input.symbols.push(alloc, elf64.ElfSymbol.{
            name_sym: req.thunk_sym,
            section: .Text,
            offset: toff,
            size: tb.code.len().widen.[u64](),
            is_global: true,
            is_func: true,
        });
        let trels = tb.relocs.as_slice();
        var ti: usize = 0_usize;
        while ti < trels.len {
            try input.relocs.push(alloc, elf64.ElfReloc.{
                section: .Text,
                offset: toff +% trels[ti].offset.widen.[u64](),
                kind: x64_reloc_to_elf(trels[ti].kind),
                target_sym: trels[ti].sym_id,
                addend: trels[ti].addend,
            });
            ti = ti +% 1_usize;
        }
        try input.text.push_slice(alloc, tb.code.as_slice());
        tb.destroy(alloc);
        ri = ri +% 1_usize;
    }
    seen.destroy(alloc);
    return;
}

fn append_blob_to_link_input(
    alloc: *mut AllocCap,
    blob: *CompiledFnBlob,
    input: *mut elf64.ElfLinkInput,
    helper_queue: *mut col.DynBuf[u32],
    helper_seen: *mut col.HashMap[u32],
    all_fnref_thunks: *mut col.DynBuf[FnRefThunkReq],
) -> !OutOfMemory {
    try pad_dyn_u8(alloc, &mut input.text, 16_usize);
    let fn_off = input.text.len().widen.[u64]();
    try input.symbols.push(alloc, elf64.ElfSymbol.{
        name_sym: blob.sym_id,
        section: .Text,
        offset: fn_off,
        size: blob.code.len().widen.[u64](),
        is_global: true,
        is_func: true,
    });
    let rels = blob.relocs.as_slice();
    var i: usize = 0_usize;
    while i < rels.len {
        let r = rels[i];
        try input.relocs.push(alloc, elf64.ElfReloc.{
            section: .Text,
            offset: fn_off +% r.offset.widen.[u64](),
            kind: x64_reloc_to_elf(r.kind),
            target_sym: r.sym_id,
            addend: r.addend,
        });
        i = i +% 1_usize;
    }
    try input.text.push_slice(alloc, blob.code.as_slice());

    let ro_items = blob.rodata_items.as_slice();
    let ro_bytes = blob.rodata_bytes.as_slice();
    let ro_rels = blob.rodata_relocs.as_slice();
    i = 0_usize;
    while i < ro_items.len {
        let it = ro_items[i];
        let al = if it.align == 0_u32 { 1_usize } else { it.align.widen.[usize]() };
        try pad_dyn_u8(alloc, &mut input.rodata, al);
        let ro_off = input.rodata.len().widen.[u64]();
        try input.symbols.push(alloc, elf64.ElfSymbol.{
            name_sym: it.sym_id,
            section: .Rodata,
            offset: ro_off,
            size: it.data_len.widen.[u64](),
            is_global: false,
            is_func: false,
        });
        let s = it.data_off.widen.[usize]();
        let e = s +% it.data_len.widen.[usize]();
        if e <= ro_bytes.len {
            let slice = ro_bytes.sub(s, e) catch { return; };
            try input.rodata.push_slice(alloc, slice);
        }
        let rs = it.reloc_start.widen.[usize]();
        let rl = it.reloc_len.widen.[usize]();
        var k: usize = 0_usize;
        while k < rl {
            let ridx = rs +% k;
            if ridx >= ro_rels.len {
                break;
            }
            let rr = ro_rels[ridx];
            try input.relocs.push(alloc, elf64.ElfReloc.{
                section: .Rodata,
                offset: ro_off +% rr.offset.widen.[u64](),
                kind: .Abs64,
                target_sym: rr.target_sym,
                addend: rr.addend,
            });
            k = k +% 1_usize;
        }
        i = i +% 1_usize;
    }

    let lines = blob.line_entries.as_slice();
    i = 0_usize;
    while i < lines.len {
        let le = lines[i];
        try input.line_entries.push(alloc, elf64.LineEntry.{
            code_offset: fn_off.trunc.[u32]() +% le.code_offset,
            file_idx: le.file_idx,
            line: le.line,
            col: le.col,
        });
        i = i +% 1_usize;
    }
    try input.debug_vars.push_slice(alloc, blob.debug_vars.as_slice());

    let hs = blob.used_helpers.as_slice();
    i = 0_usize;
    while i < hs.len {
        let hsym = hs[i];
        let hkey = hsym.widen.[u64]();
        if !helper_seen.contains(hkey) {
            try helper_seen.insert(alloc, hkey, 1_u32);
            try helper_queue.push(alloc, hsym);
        }
        i = i +% 1_usize;
    }

    try all_fnref_thunks.push_slice(alloc, blob.fn_ref_thunks.as_slice());
    return;
}

fn emit_rt_bss_into_input(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    input: *mut elf64.ElfLinkInput,
) -> !OutOfMemory {
    var bss_syms = try col.DynBuf.[x64_asm.RtBssSym].init(alloc, 16_usize);
    errdefer bss_syms.destroy(alloc);
    try x64_asm.emit_rt_bss_symbols(alloc, interner, &mut bss_syms);
    let bs = bss_syms.as_slice();
    var bi: usize = 0_usize;
    while bi < bs.len {
        let b = bs[bi];
        let al = if b.align == 0_u64 { 1_u64 } else { b.align };
        input.bss_size = types.align_up_u64(input.bss_size, al);
        let boff = input.bss_size;
        input.bss_size = input.bss_size +% b.size;
        try input.symbols.push(alloc, elf64.ElfSymbol.{
            name_sym: b.sym_id,
            section: .Bss,
            offset: boff,
            size: b.size,
            is_global: true,
            is_func: false,
        });
        bi = bi +% 1_usize;
    }
    bss_syms.destroy(alloc);
    return;
}

fn expand_rt_helper_deps(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    helper_queue: *mut col.DynBuf[u32],
    helper_seen: *mut col.HashMap[u32],
) -> !OutOfMemory {
    var deps_tmp = try col.DynBuf.[u32].init(alloc, 8_usize);
    errdefer deps_tmp.destroy(alloc);
    var qi: usize = 0_usize;
    while qi < helper_queue.len() {
        let hqs = helper_queue.as_slice();
        if qi >= hqs.len {
            break;
        }
        let hsym = hqs[qi];
        qi = qi +% 1_usize;
        deps_tmp.clear();
        try x64_asm.rt_helper_deps(alloc, interner.get(hsym), interner, &mut deps_tmp);
        let ds = deps_tmp.as_slice();
        var di: usize = 0_usize;
        while di < ds.len {
            let dsym = ds[di];
            let dk = dsym.widen.[u64]();
            if !helper_seen.contains(dk) {
                try helper_seen.insert(alloc, dk, 1_u32);
                try helper_queue.push(alloc, dsym);
            }
            di = di +% 1_usize;
        }
    }
    deps_tmp.destroy(alloc);
    return;
}

fn emit_rt_helpers_and_bss(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    target_os: target.TargetOs,
    helper_queue: *mut col.DynBuf[u32],
    helper_seen: *mut col.HashMap[u32],
    input: *mut elf64.ElfLinkInput,
) -> !OutOfMemory {
    try emit_rt_bss_into_input(alloc, interner, input);
    try expand_rt_helper_deps(alloc, interner, helper_queue, helper_seen);

    var hbuf = try x64_asm.X64Buf.init(alloc);
    errdefer hbuf.destroy(alloc);
    var hi: usize = 0_usize;
    while hi < helper_queue.len() {
        let hq = helper_queue.as_slice();
        if hi >= hq.len { break; }
        let hsym = hq[hi];
        hi = hi +% 1_usize;
        let hname = interner.get(hsym);
        let ok = if target_os == .Windows {
            try x64_asm.emit_win64_rt_helper_by_name(alloc, hname, interner, &mut hbuf)
        } else if target_os == .MacOS || target_os == .IOS {
            try x64_asm.emit_darwin_x64_rt_helper_by_name(alloc, hname, interner, &mut hbuf)
        } else {
            try x64_asm.emit_rt_helper_by_name(alloc, hname, interner, &mut hbuf)
        };
        if ok {
            try pad_dyn_u8(alloc, &mut input.text, 16_usize);
            let hoff = input.text.len().widen.[u64]();
            try input.symbols.push(alloc, elf64.ElfSymbol.{
                name_sym: hsym,
                section: .Text,
                offset: hoff,
                size: hbuf.code.len().widen.[u64](),
                is_global: true,
                is_func: true,
            });
            let hrels = hbuf.relocs.as_slice();
            var ri: usize = 0_usize;
            while ri < hrels.len {
                let r = hrels[ri];
                try input.relocs.push(alloc, elf64.ElfReloc.{
                    section: .Text,
                    offset: hoff +% r.offset.widen.[u64](),
                    kind: x64_reloc_to_elf(r.kind),
                    target_sym: r.sym_id,
                    addend: r.addend,
                });
                if is_builtin_rt_helper(interner.get(r.sym_id)) {
                    let dk = r.sym_id.widen.[u64]();
                    if !helper_seen.contains(dk) {
                        try helper_seen.insert(alloc, dk, 1_u32);
                        try helper_queue.push(alloc, r.sym_id);
                    }
                }
                ri = ri +% 1_usize;
            }
            try input.text.push_slice(alloc, hbuf.code.as_slice());
        }
    }
    hbuf.destroy(alloc);
    return;
}

fn intern_sanitized_sym(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    name_sym: u32,
) -> u32 ! OutOfMemory {
    var plain_sb = try str.StrBuf.init(alloc, 32_usize);
    errdefer plain_sb.destroy(alloc);
    try sanitize_sym_into(alloc, interner.get(name_sym), &mut plain_sb);
    let plain_sym = try interner.intern(alloc, plain_sb.as_bytes());
    plain_sb.destroy(alloc);
    return plain_sym;
}

fn populate_shared_exports_and_externals(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    interner: *mut span.SymInterner,
    mode: elf64.ElfMode,
    input: *mut elf64.ElfLinkInput,
) -> !OutOfMemory {
    // 1. Export `pub fn` symbols for LinuxShared
    if mode.kind == .LinuxShared {
        var text_off_map = try col.HashMap.[u64].init(alloc, 32_usize);
        errdefer text_off_map.destroy(alloc);
        var text_sz_map = try col.HashMap.[u64].init(alloc, 32_usize);
        errdefer text_sz_map.destroy(alloc);
        var exp_seen = try col.HashMap.[u32].init(alloc, 32_usize);
        errdefer exp_seen.destroy(alloc);
        let syms = input.symbols.as_slice();
        var si: usize = 0_usize;
        while si < syms.len {
            if syms[si].section == .Text {
                let k = syms[si].name_sym.widen.[u64]();
                try text_off_map.insert(alloc, k, syms[si].offset);
                try text_sz_map.insert(alloc, k, syms[si].size);
            }
            si = si +% 1_usize;
        }
        let nfns = eir_prog.fn_count();
        var fi: u32 = 0_u32;
        while fi < nfns {
            if let f = eir_prog.get_fn(fi) {
                if !f.sig.effects.is_gpu && f.sig.is_pub && f.key.kind == .TopDef {
                    let sym = try fn_sym_name_id(alloc, f.key, eir_prog, interner);
                    let sk = sym.widen.[u64]();
                    if !exp_seen.contains(sk) {
                        try exp_seen.insert(alloc, sk, 1_u32);
                        try input.exported_syms.push(alloc, sym);
                    }
                    let plain_sym = try intern_sanitized_sym(alloc, interner, f.name);
                    let pk = plain_sym.widen.[u64]();
                    if !f.sig.effects.is_export_c && plain_sym != sym && !text_off_map.contains(pk) {
                        if let toff = text_off_map.get(sk) {
                            let tsz = text_sz_map.get(sk) orelse 0_u64;
                            try input.symbols.push(alloc, elf64.ElfSymbol.{
                                name_sym: plain_sym,
                                section: .Text,
                                offset: toff,
                                size: tsz,
                                is_global: true,
                                is_func: true,
                            });
                            if !exp_seen.contains(pk) {
                                try exp_seen.insert(alloc, pk, 1_u32);
                                try input.exported_syms.push(alloc, plain_sym);
                            }
                        }
                    }
                }
            }
            fi = fi +% 1_u32;
        }
        exp_seen.destroy(alloc);
        text_sz_map.destroy(alloc);
        text_off_map.destroy(alloc);
    }

    // 2. Collect unresolved external dynamic symbols referenced via PLT/GOT/Abs64
    var def_set = try col.HashMap.[u32].init(alloc, 64_usize);
    errdefer def_set.destroy(alloc);
    let syms2 = input.symbols.as_slice();
    var si2: usize = 0_usize;
    while si2 < syms2.len {
        try def_set.insert(alloc, syms2[si2].name_sym.widen.[u64](), 1_u32);
        si2 = si2 +% 1_usize;
    }
    var ext_seen = try col.HashMap.[u32].init(alloc, 16_usize);
    errdefer ext_seen.destroy(alloc);
    let rels = input.relocs.as_slice();
    var ri: usize = 0_usize;
    while ri < rels.len {
        let r = rels[ri];
        if r.kind == .Plt32 || r.kind == .GotPcRel32 || r.kind == .Abs64 {
            let tk = r.target_sym.widen.[u64]();
            if !def_set.contains(tk) && !ext_seen.contains(tk) {
                let nb = interner.get(r.target_sym);
                let is_synth = str.bytes_eq(nb, "__eon_ehdr_start".as_bytes())
                    || str.bytes_eq(nb, "__eon_rela_dyn_start".as_bytes())
                    || str.bytes_eq(nb, "__eon_rela_dyn_end".as_bytes())
                    || str.bytes_eq(nb, "__eon_tdata_start".as_bytes())
                    || str.bytes_eq(nb, "__eon_tdata_end".as_bytes());
                if !is_synth {
                    try ext_seen.insert(alloc, tk, 1_u32);
                    try input.external_syms.push(alloc, r.target_sym);
                }
            }
        }
        ri = ri +% 1_usize;
    }
    ext_seen.destroy(alloc);
    def_set.destroy(alloc);
    return;
}

struct WaveRange {
    start: u32;
    len: u32;
}

struct PendingIpra {
    fn_id: u32;
    gprs: u32;
    xmms: u32;
}

fn sort_u32_asc_cg(xs: *mut [u32]) {
    let n = xs.len;
    if n <= 1_usize {
        return;
    }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third {
        gap = (gap *% 3_usize) +% 1_usize;
    }
    while gap > 0_usize {
        var i = gap;
        while i < n {
            let cur = xs[i];
            var j = i;
            while j >= gap && j < n {
                let prev = j - gap;
                let p = xs[prev];
                if p <= cur {
                    break;
                }
                xs[j] = p;
                j = prev;
            }
            xs[j] = cur;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

fn fn_blk_weight_cg(eir_prog: *eir.EirProgram, fi: u32) -> u32 {
    if let f = eir_prog.get_fn(fi) {
        return f.blocks.len;
    }
    return 0_u32;
}

fn sort_wave_lpt(order: *mut [u32], wave_fns: *[u32], eir_prog: *eir.EirProgram) {
    let n = order.len;
    if n <= 1_usize {
        return;
    }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third {
        gap = (gap *% 3_usize) +% 1_usize;
    }
    while gap > 0_usize {
        var i = gap;
        while i < order.len {
            let cur = order[i];
            let cu = cur.widen.[usize]();
            let cw = if cu < wave_fns.len { fn_blk_weight_cg(eir_prog, wave_fns[cu]) } else { 0_u32 };
            var j = i;
            while j >= gap && j < order.len {
                let prev = j - gap;
                let pv = order[prev];
                let pu = pv.widen.[usize]();
                let pw = if pu < wave_fns.len { fn_blk_weight_cg(eir_prog, wave_fns[pu]) } else { 0_u32 };
                if pw > cw || (pw == cw && pv <= cur) {
                    break;
                }
                order[j] = pv;
                j = prev;
            }
            order[j] = cur;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

fn auto_cg_workers(jobs: u32, n_fns: usize) -> usize {
    if jobs == 1_u32 {
        return 1_usize;
    }
    if jobs > 1_u32 {
        let j = jobs.widen.[usize]();
        return if j > 12_usize { 12_usize } else { j };
    }
    if n_fns < 32_usize {
        return 1_usize;
    }
    return 4_usize;
}

/// Builds deterministic bottom-up topological waves of compilable EIR functions.
/// Every acyclic callee sits in a strictly earlier wave than all of its callers,
/// allowing wave-parallel codegen with 100% deterministic IPRA identical to `-j 1`.
fn build_bottom_up_waves(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    opt_level: u8,
    order_out: *mut col.DynBuf[u32],
    waves_out: *mut col.DynBuf[WaveRange],
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count().widen.[usize]();
    if nfns == 0_usize {
        return;
    }
    var active = try col.DynBuf.[u8].init(alloc, nfns);
    errdefer active.destroy(alloc);
    var active_cnt: usize = 0_usize;
    var i0: usize = 0_usize;
    while i0 < nfns {
        var is_act: u8 = 0_u8;
        if let f = eir_prog.get_fn(i0.trunc.[u32]()) {
            if !f.sig.effects.is_gpu && !f.is_emi_stub && f.blocks.len > 0_u32 {
                is_act = 1_u8;
                active_cnt = active_cnt +% 1_usize;
            }
        }
        try active.push(alloc, is_act);
        i0 = i0 +% 1_usize;
    }
    if active_cnt == 0_usize {
        active.destroy(alloc);
        return;
    }

    if opt_level == 0_u8 {
        let act_s = active.as_slice();
        var fi0: usize = 0_usize;
        while fi0 < nfns {
            if fi0 < act_s.len && act_s[fi0] != 0_u8 {
                try order_out.push(alloc, fi0.trunc.[u32]());
            }
            fi0 = fi0 +% 1_usize;
        }
        try waves_out.push(alloc, WaveRange.{ start: 0_u32, len: order_out.len().trunc.[u32]() });
        active.destroy(alloc);
        return;
    }

    var out_deg = try col.DynBuf.[u32].init(alloc, nfns);
    errdefer out_deg.destroy(alloc);
    var caller_head = try col.DynBuf.[u32].init(alloc, nfns);
    errdefer caller_head.destroy(alloc);
    var seen_stamp = try col.DynBuf.[u32].init(alloc, nfns);
    errdefer seen_stamp.destroy(alloc);
    var i1: usize = 0_usize;
    while i1 < nfns {
        try out_deg.push(alloc, 0_u32);
        try caller_head.push(alloc, eir.EIR_NONE);
        try seen_stamp.push(alloc, 0_u32);
        i1 = i1 +% 1_usize;
    }
    var caller_id = try col.DynBuf.[u32].init(alloc, nfns *% 2_usize +% 16_usize);
    errdefer caller_id.destroy(alloc);
    var caller_next = try col.DynBuf.[u32].init(alloc, nfns *% 2_usize +% 16_usize);
    errdefer caller_next.destroy(alloc);

    var fi: usize = 0_usize;
    while fi < nfns {
        let act_s = active.as_slice();
        if fi >= act_s.len || act_s[fi] == 0_u8 {
            fi = fi +% 1_usize;
            continue;
        }
        let fi_u32 = fi.trunc.[u32]();
        let stamp = fi_u32 +% 1_u32;
        var deg: u32 = 0_u32;
        let blks = eir_prog.fn_blocks(fi_u32);
        var bi: usize = 0_usize;
        while bi < blks.len {
            let insts = eir_prog.insts_slice(blks[bi].insts);
            var ii: usize = 0_usize;
            while ii < insts.len {
                let inst = insts[ii];
                if inst.kind == .Call {
                    if let cd = eir_prog.get_call(inst.aux0) {
                        var has_callee = false;
                        var callee_fid: u32 = 0_u32;
                        match cd.callee.kind {
                            .DirectFn => {
                                if let cid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(cd.callee.a)) {
                                    callee_fid = cid;
                                    has_callee = true;
                                }
                            }
                            .Method => {
                                if let cid = eir_prog.find_fn_by_key(cfg_ir.fn_key_impl_method(cd.callee.a, cd.callee.b)) {
                                    callee_fid = cid;
                                    has_callee = true;
                                }
                            }
                            .GenericInst => {
                                if let cid = eir_prog.find_fn_by_key(cfg_ir.fn_key_generic_inst(cd.callee.a)) {
                                    callee_fid = cid;
                                    has_callee = true;
                                }
                            }
                            _ => {}
                        }
                        if has_callee && callee_fid != fi_u32 {
                            let cidx = callee_fid.widen.[usize]();
                            let act_c = active.as_slice();
                            if cidx < act_c.len && act_c[cidx] != 0_u8 {
                                var already = false;
                                let ss = seen_stamp.as_mut_slice();
                                if cidx < ss.len {
                                    if ss[cidx] == stamp {
                                        already = true;
                                    } else {
                                        ss[cidx] = stamp;
                                    }
                                }
                                if !already {
                                    deg = deg +% 1_u32;
                                    let eid = caller_id.len().trunc.[u32]();
                                    var prev_h = eir.EIR_NONE;
                                    let ch_ro = caller_head.as_slice();
                                    if cidx < ch_ro.len {
                                        prev_h = ch_ro[cidx];
                                    }
                                    try caller_id.push(alloc, fi_u32);
                                    try caller_next.push(alloc, prev_h);
                                    let ch_m = caller_head.as_mut_slice();
                                    if cidx < ch_m.len {
                                        ch_m[cidx] = eid;
                                    }
                                }
                            }
                        }
                    }
                }
                ii = ii +% 1_usize;
            }
            bi = bi +% 1_usize;
        }
        let od_m = out_deg.as_mut_slice();
        if fi < od_m.len {
            od_m[fi] = deg;
        }
        fi = fi +% 1_usize;
    }

    var placed = try col.DynBuf.[u8].init(alloc, nfns);
    errdefer placed.destroy(alloc);
    var cur_wave = try col.DynBuf.[u32].init(alloc, 64_usize);
    errdefer cur_wave.destroy(alloc);
    var next_wave = try col.DynBuf.[u32].init(alloc, 64_usize);
    errdefer next_wave.destroy(alloc);
    var p0: usize = 0_usize;
    while p0 < nfns {
        var pl: u8 = 0_u8;
        let act_s = active.as_slice();
        let od_s = out_deg.as_slice();
        if p0 < act_s.len && act_s[p0] != 0_u8 && p0 < od_s.len && od_s[p0] == 0_u32 {
            try cur_wave.push(alloc, p0.trunc.[u32]());
            pl = 1_u8;
        }
        try placed.push(alloc, pl);
        p0 = p0 +% 1_usize;
    }

    while !cur_wave.is_empty() {
        let w_start = order_out.len().trunc.[u32]();
        let cw_s = cur_wave.as_slice();
        try order_out.push_slice(alloc, cw_s);
        try waves_out.push(alloc, WaveRange.{ start: w_start, len: cw_s.len.trunc.[u32]() });

        next_wave.clear();
        var wi: usize = 0_usize;
        while wi < cw_s.len {
            let callee = cw_s[wi].widen.[usize]();
            var edge = eir.EIR_NONE;
            let ch_s = caller_head.as_slice();
            if callee < ch_s.len {
                edge = ch_s[callee];
            }
            while edge != eir.EIR_NONE {
                let eu = edge.widen.[usize]();
                var caller_u32: u32 = 0_u32;
                var nxt_e = eir.EIR_NONE;
                let cid_s = caller_id.as_slice();
                if eu < cid_s.len {
                    caller_u32 = cid_s[eu];
                }
                let cn_s = caller_next.as_slice();
                if eu < cn_s.len {
                    nxt_e = cn_s[eu];
                }
                let cu = caller_u32.widen.[usize]();
                var became_zero = false;
                let od_m = out_deg.as_mut_slice();
                if cu < od_m.len && od_m[cu] > 0_u32 {
                    od_m[cu] = od_m[cu] -% 1_u32;
                    if od_m[cu] == 0_u32 {
                        became_zero = true;
                    }
                }
                if became_zero {
                    var should_push = false;
                    let pl_m = placed.as_mut_slice();
                    if cu < pl_m.len && pl_m[cu] == 0_u8 {
                        pl_m[cu] = 1_u8;
                        should_push = true;
                    }
                    if should_push {
                        try next_wave.push(alloc, caller_u32);
                    }
                }
                edge = nxt_e;
            }
            wi = wi +% 1_usize;
        }
        sort_u32_asc_cg(next_wave.as_mut_slice());
        cur_wave.clear();
        try cur_wave.push_slice(alloc, next_wave.as_slice());
    }

    // Any remaining active functions belong to mutual-recursion cycles: emit deterministically as a final wave.
    let rem_start = order_out.len().trunc.[u32]();
    var rem_cnt: u32 = 0_u32;
    var r0: usize = 0_usize;
    while r0 < nfns {
        let act_s = active.as_slice();
        let pl_s = placed.as_slice();
        if r0 < act_s.len && act_s[r0] != 0_u8 && r0 < pl_s.len && pl_s[r0] == 0_u8 {
            try order_out.push(alloc, r0.trunc.[u32]());
            rem_cnt = rem_cnt +% 1_u32;
        }
        r0 = r0 +% 1_usize;
    }
    if rem_cnt > 0_u32 {
        try waves_out.push(alloc, WaveRange.{ start: rem_start, len: rem_cnt });
    }

    next_wave.destroy(alloc);
    cur_wave.destroy(alloc);
    placed.destroy(alloc);
    caller_next.destroy(alloc);
    caller_id.destroy(alloc);
    seen_stamp.destroy(alloc);
    caller_head.destroy(alloc);
    out_deg.destroy(alloc);
    active.destroy(alloc);
    return;
}

fn try_compile_fn_optimized_core(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    fn_sym: u32,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
    blob_out: *mut CompiledFnBlob,
    out_has_ipra: *mut bool,
    out_ipra_gprs: *mut u32,
    out_ipra_xmms: *mut u32,
) -> bool ! OutOfMemory {
    out_has_ipra.* = false;
    out_ipra_gprs.* = 0xFFFFFFFF_u32;
    out_ipra_xmms.* = 0xFFFFFFFF_u32;

    if opts.target_spec.abi == .Win64 {
        // Route Win64 C ABI callbacks and Win32 API callers through the exact Win64 C ABI codegen path.
        if let f = eir_prog.get_fn(fn_id) {
            if f.sig.effects.is_export_c { return false; }
            let blks = eir_prog.fn_blocks(fn_id);
            var bi: usize = 0_usize;
            while bi < blks.len {
                let insts = eir_prog.insts_slice(blks[bi].insts);
                var ii: usize = 0_usize;
                while ii < insts.len {
                    if insts[ii].kind == .Call {
                        if let cd = eir_prog.get_call(insts[ii].aux0) {
                            if cd.callee.kind == .ExternFn && !is_builtin_rt_helper(interner.get(cd.callee.b)) {
                                return false;
                            }
                            if cd.callee.kind == .DirectFn {
                                if let cfid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(cd.callee.a)) {
                                    if let cf = eir_prog.get_fn(cfid) {
                                        if cf.sig.effects.is_export_c { return false; }
                                    }
                                }
                            }
                        }
                    }
                    ii = ii +% 1_usize;
                }
                bi = bi +% 1_usize;
            }
        }
    }

    var mf = try mach_ir.MachFunc.init_for_target(alloc, fn_sym, fn_id, opts.target_spec);
    errdefer mf.destroy(alloc);

    let isel_res = try mach_isel.lower_fn_to_mach_ir(
        alloc,
        eir_prog,
        fn_id,
        fn_sym,
        env,
        ct,
        interner,
        opts.opt,
        opts.sanitize,
        opts.mode.kind != .Freestanding,
        &mut mf,
    );
    if !isel_res.ok {
        mf.destroy(alloc);
        return false;
    }

    try mach_regalloc.allocate_registers(alloc, &mut mf);

    var allow_ipra = opts.mode.kind != .LinuxShared && !opts.opt.incremental_cgu;
    if allow_ipra {
        if let f = eir_prog.get_fn(fn_id) {
            if f.sig.effects.is_export_c {
                allow_ipra = false;
            }
        }
    }
    if allow_ipra {
        out_has_ipra.* = true;
        out_ipra_gprs.* = mf.ipra_clobber_gprs;
        out_ipra_xmms.* = mf.ipra_clobber_xmms;
    }

    try mach_opt_x64.run_post_ra_passes(alloc, &mut mf, opts.opt);

    let emit_out = try mach_opt_x64.emit_mach_func_x64(alloc, &mf, sm, opts.emit_debug_line);
    errdefer emit_out.destroy(alloc);
    if !emit_out.ok {
        emit_out.destroy(alloc);
        mf.destroy(alloc);
        out_has_ipra.* = false;
        return false;
    }

    blob_out.own_stack_bytes = emit_out.own_stack_bytes;
    try blob_out.code.push_slice(alloc, emit_out.code.as_slice());
    try blob_out.relocs.push_slice(alloc, emit_out.relocs.as_slice());
    let ro_items = emit_out.rodata_items.as_slice();
    var ri: usize = 0_usize;
    while ri < ro_items.len {
        let it = ro_items[ri];
        try blob_out.rodata_items.push(alloc, RodataItemMeta.{
            sym_id: it.sym_id,
            data_off: it.data_off,
            data_len: it.data_len,
            align: it.align,
            reloc_start: it.reloc_start,
            reloc_len: it.reloc_len,
        });
        ri = ri +% 1_usize;
    }
    try blob_out.rodata_bytes.push_slice(alloc, emit_out.rodata_bytes.as_slice());
    let ro_rels = emit_out.rodata_relocs.as_slice();
    var rri: usize = 0_usize;
    while rri < ro_rels.len {
        let rr = ro_rels[rri];
        try blob_out.rodata_relocs.push(alloc, RodataReloc.{
            offset: rr.offset,
            target_sym: rr.target_sym,
            addend: rr.addend,
        });
        rri = rri +% 1_usize;
    }
    try blob_out.used_helpers.push_slice(alloc, emit_out.used_helpers.as_slice());
    try blob_out.line_entries.push_slice(alloc, emit_out.line_entries.as_slice());

    emit_out.destroy(alloc);
    mf.destroy(alloc);
    return true;
}

fn try_compile_fn_optimized(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    fn_sym: u32,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
    blob_out: *mut CompiledFnBlob,
) -> bool ! OutOfMemory {
    var has_ipra = false;
    var ipra_gprs: u32 = 0xFFFFFFFF_u32;
    var ipra_xmms: u32 = 0xFFFFFFFF_u32;
    let ok = try try_compile_fn_optimized_core(
        alloc, sm, eir_prog, fn_id, fn_sym, env, ct, interner, opts, blob_out,
        &mut has_ipra, &mut ipra_gprs, &mut ipra_xmms,
    );
    if ok && has_ipra {
        try eir_prog.set_fn_ipra(alloc, fn_id, ipra_gprs, ipra_xmms);
    }
    return ok;
}

struct WorkerCgItem {
    wave_pos: u32;
    fn_id: u32;
    fn_sym: u32;
    ok: bool;
    has_ipra: bool;
    ipra_gprs: u32;
    ipra_xmms: u32;
    own_stack_bytes: u64;
    code_off: u32;
    code_len: u32;
    reloc_off: u32;
    reloc_len: u32;
    ro_item_off: u32;
    ro_item_len: u32;
    ro_byte_off: u32;
    ro_byte_len: u32;
    ro_reloc_off: u32;
    ro_reloc_len: u32;
    helper_off: u32;
    helper_len: u32;
    line_off: u32;
    line_len: u32;
    dvar_off: u32;
    dvar_len: u32;
    thunk_off: u32;
    thunk_len: u32;
    extra_fn_off: u32;
    extra_fn_len: u32;
    extra_code_off: u32;
    extra_code_len: u32;
    extra_reloc_off: u32;
    extra_reloc_len: u32;
    err_off: u32;
    err_len: u32;
}

linear struct WorkerCgState {
    interner: span.SymInterner;
    sym_remap: col.DynBuf[u32];
    oom: bool;
    items: col.DynBuf[WorkerCgItem];
    code_pool: col.DynBuf[u8];
    relocs_pool: col.DynBuf[x64_asm.FnReloc];
    ro_items_pool: col.DynBuf[RodataItemMeta];
    ro_bytes_pool: col.DynBuf[u8];
    ro_relocs_pool: col.DynBuf[RodataReloc];
    helpers_pool: col.DynBuf[u32];
    lines_pool: col.DynBuf[elf64.LineEntry];
    dvars_pool: col.DynBuf[elf64.DebugVarEntry];
    thunks_pool: col.DynBuf[FnRefThunkReq];
    extra_fns_pool: col.DynBuf[ExtraFnEntry];
    extra_code_pool: col.DynBuf[u8];
    extra_relocs_pool: col.DynBuf[x64_asm.FnReloc];
    err_pool: col.DynBuf[u8];
}

impl WorkerCgState {
    fn init_with(alloc: *mut AllocCap, src: *span.SymInterner, do_clone: bool) -> WorkerCgState ! OutOfMemory {
        let interner = if do_clone {
            try src.clone(alloc)
        } else {
            try span.SymInterner.init(alloc)
        };
        errdefer interner.destroy(alloc);
        let sym_remap = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer sym_remap.destroy(alloc);
        let items = try col.DynBuf.[WorkerCgItem].init(alloc, 32_usize);
        errdefer items.destroy(alloc);
        let code_pool = try col.DynBuf.[u8].init(alloc, 4096_usize);
        errdefer code_pool.destroy(alloc);
        let relocs_pool = try col.DynBuf.[x64_asm.FnReloc].init(alloc, 64_usize);
        errdefer relocs_pool.destroy(alloc);
        let ro_items_pool = try col.DynBuf.[RodataItemMeta].init(alloc, 16_usize);
        errdefer ro_items_pool.destroy(alloc);
        let ro_bytes_pool = try col.DynBuf.[u8].init(alloc, 256_usize);
        errdefer ro_bytes_pool.destroy(alloc);
        let ro_relocs_pool = try col.DynBuf.[RodataReloc].init(alloc, 8_usize);
        errdefer ro_relocs_pool.destroy(alloc);
        let helpers_pool = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer helpers_pool.destroy(alloc);
        let lines_pool = try col.DynBuf.[elf64.LineEntry].init(alloc, 64_usize);
        errdefer lines_pool.destroy(alloc);
        let dvars_pool = try col.DynBuf.[elf64.DebugVarEntry].init(alloc, 16_usize);
        errdefer dvars_pool.destroy(alloc);
        let thunks_pool = try col.DynBuf.[FnRefThunkReq].init(alloc, 4_usize);
        errdefer thunks_pool.destroy(alloc);
        let extra_fns_pool = try col.DynBuf.[ExtraFnEntry].init(alloc, 4_usize);
        errdefer extra_fns_pool.destroy(alloc);
        let extra_code_pool = try col.DynBuf.[u8].init(alloc, 32_usize);
        errdefer extra_code_pool.destroy(alloc);
        let extra_relocs_pool = try col.DynBuf.[x64_asm.FnReloc].init(alloc, 4_usize);
        errdefer extra_relocs_pool.destroy(alloc);
        let err_pool = try col.DynBuf.[u8].init(alloc, 16_usize);
        errdefer err_pool.destroy(alloc);
        return WorkerCgState.{
            interner: interner,
            sym_remap: sym_remap,
            oom: false,
            items: items,
            code_pool: code_pool,
            relocs_pool: relocs_pool,
            ro_items_pool: ro_items_pool,
            ro_bytes_pool: ro_bytes_pool,
            ro_relocs_pool: ro_relocs_pool,
            helpers_pool: helpers_pool,
            lines_pool: lines_pool,
            dvars_pool: dvars_pool,
            thunks_pool: thunks_pool,
            extra_fns_pool: extra_fns_pool,
            extra_code_pool: extra_code_pool,
            extra_relocs_pool: extra_relocs_pool,
            err_pool: err_pool,
        };
    }

    fn clear_wave(self: *mut Self) {
        self.oom = false;
        self.items.clear();
        self.code_pool.clear();
        self.relocs_pool.clear();
        self.ro_items_pool.clear();
        self.ro_bytes_pool.clear();
        self.ro_relocs_pool.clear();
        self.helpers_pool.clear();
        self.lines_pool.clear();
        self.dvars_pool.clear();
        self.thunks_pool.clear();
        self.extra_fns_pool.clear();
        self.extra_code_pool.clear();
        self.extra_relocs_pool.clear();
        self.err_pool.clear();
    }

    fn destroy(self: WorkerCgState, alloc: *mut AllocCap) {
        let WorkerCgState.{
            interner,
            sym_remap,
            oom: _,
            items,
            code_pool,
            relocs_pool,
            ro_items_pool,
            ro_bytes_pool,
            ro_relocs_pool,
            helpers_pool,
            lines_pool,
            dvars_pool,
            thunks_pool,
            extra_fns_pool,
            extra_code_pool,
            extra_relocs_pool,
            err_pool,
        } = self;
        err_pool.destroy(alloc);
        extra_relocs_pool.destroy(alloc);
        extra_code_pool.destroy(alloc);
        extra_fns_pool.destroy(alloc);
        thunks_pool.destroy(alloc);
        dvars_pool.destroy(alloc);
        lines_pool.destroy(alloc);
        helpers_pool.destroy(alloc);
        ro_relocs_pool.destroy(alloc);
        ro_bytes_pool.destroy(alloc);
        ro_items_pool.destroy(alloc);
        relocs_pool.destroy(alloc);
        code_pool.destroy(alloc);
        items.destroy(alloc);
        sym_remap.destroy(alloc);
        interner.destroy(alloc);
    }
}

fn pack_worker_item(
    alloc: *mut AllocCap,
    out: *mut WorkerCgState,
    wave_pos: u32,
    fn_id: u32,
    fn_sym: u32,
    ok: bool,
    has_ipra: bool,
    ipra_gprs: u32,
    ipra_xmms: u32,
    blob: *CompiledFnBlob,
    extra_fns: *[ExtraFnEntry],
    extra_code: *[u8],
    extra_relocs: *[x64_asm.FnReloc],
    err_bytes: *[u8],
) -> !OutOfMemory {
    let code_off = out.code_pool.len().trunc.[u32]();
    try out.code_pool.push_slice(alloc, blob.code.as_slice());
    let reloc_off = out.relocs_pool.len().trunc.[u32]();
    try out.relocs_pool.push_slice(alloc, blob.relocs.as_slice());
    let ro_item_off = out.ro_items_pool.len().trunc.[u32]();
    try out.ro_items_pool.push_slice(alloc, blob.rodata_items.as_slice());
    let ro_byte_off = out.ro_bytes_pool.len().trunc.[u32]();
    try out.ro_bytes_pool.push_slice(alloc, blob.rodata_bytes.as_slice());
    let ro_reloc_off = out.ro_relocs_pool.len().trunc.[u32]();
    try out.ro_relocs_pool.push_slice(alloc, blob.rodata_relocs.as_slice());
    let helper_off = out.helpers_pool.len().trunc.[u32]();
    try out.helpers_pool.push_slice(alloc, blob.used_helpers.as_slice());
    let line_off = out.lines_pool.len().trunc.[u32]();
    try out.lines_pool.push_slice(alloc, blob.line_entries.as_slice());
    let dvar_off = out.dvars_pool.len().trunc.[u32]();
    try out.dvars_pool.push_slice(alloc, blob.debug_vars.as_slice());
    let thunk_off = out.thunks_pool.len().trunc.[u32]();
    try out.thunks_pool.push_slice(alloc, blob.fn_ref_thunks.as_slice());
    let extra_fn_off = out.extra_fns_pool.len().trunc.[u32]();
    try out.extra_fns_pool.push_slice(alloc, extra_fns);
    let extra_code_off = out.extra_code_pool.len().trunc.[u32]();
    try out.extra_code_pool.push_slice(alloc, extra_code);
    let extra_reloc_off = out.extra_relocs_pool.len().trunc.[u32]();
    try out.extra_relocs_pool.push_slice(alloc, extra_relocs);
    let err_off = out.err_pool.len().trunc.[u32]();
    try out.err_pool.push_slice(alloc, err_bytes);

    try out.items.push(alloc, WorkerCgItem.{
        wave_pos: wave_pos,
        fn_id: fn_id,
        fn_sym: fn_sym,
        ok: ok,
        has_ipra: has_ipra,
        ipra_gprs: ipra_gprs,
        ipra_xmms: ipra_xmms,
        own_stack_bytes: blob.own_stack_bytes,
        code_off: code_off,
        code_len: blob.code.len().trunc.[u32](),
        reloc_off: reloc_off,
        reloc_len: blob.relocs.len().trunc.[u32](),
        ro_item_off: ro_item_off,
        ro_item_len: blob.rodata_items.len().trunc.[u32](),
        ro_byte_off: ro_byte_off,
        ro_byte_len: blob.rodata_bytes.len().trunc.[u32](),
        ro_reloc_off: ro_reloc_off,
        ro_reloc_len: blob.rodata_relocs.len().trunc.[u32](),
        helper_off: helper_off,
        helper_len: blob.used_helpers.len().trunc.[u32](),
        line_off: line_off,
        line_len: blob.line_entries.len().trunc.[u32](),
        dvar_off: dvar_off,
        dvar_len: blob.debug_vars.len().trunc.[u32](),
        thunk_off: thunk_off,
        thunk_len: blob.fn_ref_thunks.len().trunc.[u32](),
        extra_fn_off: extra_fn_off,
        extra_fn_len: extra_fns.len.trunc.[u32](),
        extra_code_off: extra_code_off,
        extra_code_len: extra_code.len.trunc.[u32](),
        extra_reloc_off: extra_reloc_off,
        extra_reloc_len: extra_relocs.len.trunc.[u32](),
        err_off: err_off,
        err_len: err_bytes.len.trunc.[u32](),
    });
    return;
}

fn cg_worker_loop(
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    wave_fns: *[u32],
    pre_fn_syms: *[u32],
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    opts: *CompileOptions,
    out: *mut WorkerCgState,
) -> !OutOfMemory {
    var opt_blob = try CompiledFnBlob.init(alloc, 0_u32);
    errdefer opt_blob.destroy(alloc);
    let empty_ef: [0]ExtraFnEntry = [];
    let empty_ec: [0]u8 = [];
    let empty_er: [0]x64_asm.FnReloc = [];
    let empty_err: *str = "";

    loop {
        let pos = next_pos.fetch_add(1_u64, .AcqRel);
        let pu = pos.trunc.[usize]();
        if pu >= work_order.len {
            break;
        }
        let wpos = work_order[pu];
        let wu = wpos.widen.[usize]();
        if wu >= wave_fns.len {
            continue;
        }
        let fi = wave_fns[wu];
        let fiu = fi.widen.[usize]();
        let fn_sym = if fiu < pre_fn_syms.len { pre_fn_syms[fiu] } else { span.SYM_EMPTY };

        var used_opt = false;
        if opts.opt.opt_level > 0_u8 {
            clear_compiled_blob(&mut opt_blob, fn_sym);
            var has_ipra = false;
            var ipra_gprs: u32 = 0xFFFFFFFF_u32;
            var ipra_xmms: u32 = 0xFFFFFFFF_u32;
            let ok_opt = try try_compile_fn_optimized_core(
                alloc, sm, eir_prog, fi, fn_sym, env, ct, &mut out.interner, opts, &mut opt_blob,
                &mut has_ipra, &mut ipra_gprs, &mut ipra_xmms,
            );
            if ok_opt {
                try pack_worker_item(
                    alloc, out, wpos, fi, fn_sym, true, has_ipra, ipra_gprs, ipra_xmms,
                    &opt_blob, &empty_ef, &empty_ec, &empty_er, empty_err.as_bytes(),
                );
                used_opt = true;
            }
        }
        if !used_opt {
            let outcome = try compile_function_x64(alloc, sm, eir_prog, fi, env, ct, &mut out.interner, opts);
            errdefer outcome.destroy(alloc);
            try pack_worker_item(
                alloc, out, wpos, fi, fn_sym, outcome.ok, false, 0xFFFFFFFF_u32, 0xFFFFFFFF_u32,
                &outcome.blob, outcome.extra_fns.as_slice(), outcome.extra_code.as_slice(),
                outcome.extra_relocs.as_slice(), outcome.err_msg.as_bytes(),
            );
            outcome.destroy(alloc);
        }
    }

    opt_blob.destroy(alloc);
    return;
}

fn run_cg_worker_entry(
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    wave_fns: *[u32],
    pre_fn_syms: *[u32],
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    opts: *CompileOptions,
    out: *mut WorkerCgState,
) {
    cg_worker_loop(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, out) catch {
        out.oom = true;
    };
}

fn dispatch_cg_workers(
    n_workers: usize,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    wave_fns: *[u32],
    pre_fn_syms: *[u32],
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    opts: *CompileOptions,
    w0: *mut WorkerCgState,
    w1: *mut WorkerCgState,
    w2: *mut WorkerCgState,
    w3: *mut WorkerCgState,
    w4: *mut WorkerCgState,
    w5: *mut WorkerCgState,
    w6: *mut WorkerCgState,
    w7: *mut WorkerCgState,
    w8: *mut WorkerCgState,
    w9: *mut WorkerCgState,
    w10: *mut WorkerCgState,
    w11: *mut WorkerCgState,
) {
    par for wi in 0_usize..n_workers {
        if wi == 0_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w0);
        } else if wi == 1_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w1);
        } else if wi == 2_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w2);
        } else if wi == 3_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w3);
        } else if wi == 4_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w4);
        } else if wi == 5_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w5);
        } else if wi == 6_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w6);
        } else if wi == 7_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w7);
        } else if wi == 8_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w8);
        } else if wi == 9_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w9);
        } else if wi == 10_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w10);
        } else if wi == 11_usize {
            run_cg_worker_entry(alloc, next_pos, work_order, wave_fns, pre_fn_syms, sm, eir_prog, env, ct, opts, w11);
        }
    }
}

fn remap_worker_sym(
    alloc: *mut AllocCap,
    w: *mut WorkerCgState,
    base_sym_len: u32,
    global_interner: *mut span.SymInterner,
    sid: u32,
) -> u32 ! OutOfMemory {
    if sid < base_sym_len {
        return sid;
    }
    let idx = (sid -% base_sym_len).widen.[usize]();
    while w.sym_remap.len() <= idx {
        try w.sym_remap.push(alloc, 0xFFFFFFFF_u32);
    }
    let rm_ro = w.sym_remap.as_slice();
    if idx < rm_ro.len && rm_ro[idx] != 0xFFFFFFFF_u32 {
        return rm_ro[idx];
    }
    let bytes = w.interner.get(sid);
    let gsid = try global_interner.intern(alloc, bytes);
    let rm_m = w.sym_remap.as_mut_slice();
    if idx < rm_m.len {
        rm_m[idx] = gsid;
    }
    return gsid;
}

fn index_worker_items(
    w_tag: u8,
    w: *WorkerCgState,
    loc_w: *mut [u8],
    loc_idx: *mut [u32],
) {
    let items = w.items.as_slice();
    var i: usize = 0_usize;
    while i < items.len {
        let wp = items[i].wave_pos.widen.[usize]();
        if wp < loc_w.len {
            loc_w[wp] = w_tag;
        }
        if wp < loc_idx.len {
            loc_idx[wp] = i.trunc.[u32]();
        }
        i = i +% 1_usize;
    }
}

fn commit_worker_cg_item(
    alloc: *mut AllocCap,
    w: *mut WorkerCgState,
    item_idx: usize,
    base_sym_len: u32,
    eir_prog: *mut eir.EirProgram,
    interner: *mut span.SymInterner,
    fn_own_stack: *mut col.DynBuf[u64],
    merge_blob: *mut CompiledFnBlob,
    input: *mut elf64.ElfLinkInput,
    helper_queue: *mut col.DynBuf[u32],
    helper_seen: *mut col.HashMap[u32],
    all_fnref_thunks: *mut col.DynBuf[FnRefThunkReq],
    cap_ok: *mut bool,
    capture_opt: ?*mut CapturedProgramBlobs,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let items_s = w.items.as_slice();
    if item_idx >= items_s.len {
        return true;
    }
    let it = items_s[item_idx];
    if !it.ok {
        let eb = slice_u32_sub(w.err_pool.as_slice(), it.err_off, it.err_len);
        try err_out.push_bytes_grow(alloc, eb);
        return false;
    }

    let fi = it.fn_id;
    let fi_u = fi.widen.[usize]();
    let os_s = fn_own_stack.as_mut_slice();
    if fi_u < os_s.len {
        os_s[fi_u] = it.own_stack_bytes;
    }
    if it.has_ipra {
        try eir_prog.set_fn_ipra(alloc, fi, it.ipra_gprs, it.ipra_xmms);
    }

    let g_fn_sym = try remap_worker_sym(alloc, w, base_sym_len, interner, it.fn_sym);
    clear_compiled_blob(merge_blob, g_fn_sym);
    merge_blob.own_stack_bytes = it.own_stack_bytes;

    // Code & lines & rodata bytes (no sym_id fields)
    try merge_blob.code.push_slice(alloc, slice_u32_sub(w.code_pool.as_slice(), it.code_off, it.code_len));
    try merge_blob.rodata_bytes.push_slice(alloc, slice_u32_sub(w.ro_bytes_pool.as_slice(), it.ro_byte_off, it.ro_byte_len));
    let l_start = it.line_off.widen.[usize]();
    let l_len = it.line_len.widen.[usize]();
    var li: usize = 0_usize;
    while li < l_len {
        let lpos = l_start +% li;
        let ls = w.lines_pool.as_slice();
        if lpos < ls.len {
            try merge_blob.line_entries.push(alloc, ls[lpos]);
        }
        li = li +% 1_usize;
    }

    // Remap relocs
    let r_start = it.reloc_off.widen.[usize]();
    let r_len = it.reloc_len.widen.[usize]();
    var ri: usize = 0_usize;
    while ri < r_len {
        let rpos = r_start +% ri;
        var rel = x64_asm.FnReloc.{ offset: 0_u32, kind: .Rel32, sym_id: 0_u32, addend: 0_i64 };
        var has_r = false;
        let rs = w.relocs_pool.as_slice();
        if rpos < rs.len {
            rel = rs[rpos];
            has_r = true;
        }
        if has_r {
            rel.sym_id = try remap_worker_sym(alloc, w, base_sym_len, interner, rel.sym_id);
            try merge_blob.relocs.push(alloc, rel);
        }
        ri = ri +% 1_usize;
    }

    // Remap rodata items
    let roi_start = it.ro_item_off.widen.[usize]();
    let roi_len = it.ro_item_len.widen.[usize]();
    var roii: usize = 0_usize;
    while roii < roi_len {
        let pos = roi_start +% roii;
        var rm = RodataItemMeta.{ sym_id: 0_u32, data_off: 0_u32, data_len: 0_u32, align: 1_u32, reloc_start: 0_u32, reloc_len: 0_u32 };
        var has_rm = false;
        let rms = w.ro_items_pool.as_slice();
        if pos < rms.len {
            rm = rms[pos];
            has_rm = true;
        }
        if has_rm {
            rm.sym_id = try remap_worker_sym(alloc, w, base_sym_len, interner, rm.sym_id);
            try merge_blob.rodata_items.push(alloc, rm);
        }
        roii = roii +% 1_usize;
    }

    // Remap rodata relocs
    let ror_start = it.ro_reloc_off.widen.[usize]();
    let ror_len = it.ro_reloc_len.widen.[usize]();
    var rori: usize = 0_usize;
    while rori < ror_len {
        let pos = ror_start +% rori;
        var rr = RodataReloc.{ offset: 0_u32, target_sym: 0_u32, addend: 0_i64 };
        var has_rr = false;
        let rrs = w.ro_relocs_pool.as_slice();
        if pos < rrs.len {
            rr = rrs[pos];
            has_rr = true;
        }
        if has_rr {
            rr.target_sym = try remap_worker_sym(alloc, w, base_sym_len, interner, rr.target_sym);
            try merge_blob.rodata_relocs.push(alloc, rr);
        }
        rori = rori +% 1_usize;
    }

    // Remap used helpers
    let h_start = it.helper_off.widen.[usize]();
    let h_len = it.helper_len.widen.[usize]();
    var hi: usize = 0_usize;
    while hi < h_len {
        let pos = h_start +% hi;
        var hsym: u32 = 0_u32;
        var has_h = false;
        let hs = w.helpers_pool.as_slice();
        if pos < hs.len {
            hsym = hs[pos];
            has_h = true;
        }
        if has_h {
            let ghs = try remap_worker_sym(alloc, w, base_sym_len, interner, hsym);
            try merge_blob.used_helpers.push(alloc, ghs);
        }
        hi = hi +% 1_usize;
    }

    // Remap debug_vars
    let dv_start = it.dvar_off.widen.[usize]();
    let dv_len = it.dvar_len.widen.[usize]();
    var dvi: usize = 0_usize;
    while dvi < dv_len {
        let pos = dv_start +% dvi;
        var dv = elf64.DebugVarEntry.{
            fn_sym: 0_u32,
            name_sym: 0_u32,
            rbp_off: 0_i32,
            size_bytes: 0_u8,
            encoding: 0_u8,
            reg_num: 255_u8,
            is_param: false,
        };
        var has_dv = false;
        let dvs = w.dvars_pool.as_slice();
        if pos < dvs.len {
            dv = dvs[pos];
            has_dv = true;
        }
        if has_dv {
            dv.fn_sym = try remap_worker_sym(alloc, w, base_sym_len, interner, dv.fn_sym);
            dv.name_sym = try remap_worker_sym(alloc, w, base_sym_len, interner, dv.name_sym);
            try merge_blob.debug_vars.push(alloc, dv);
        }
        dvi = dvi +% 1_usize;
    }

    // Remap fn_ref_thunks
    let t_start = it.thunk_off.widen.[usize]();
    let t_len = it.thunk_len.widen.[usize]();
    var ti: usize = 0_usize;
    while ti < t_len {
        let pos = t_start +% ti;
        var th = FnRefThunkReq.{ thunk_sym: 0_u32, target_def: 0_u32 };
        var has_t = false;
        let ts = w.thunks_pool.as_slice();
        if pos < ts.len {
            th = ts[pos];
            has_t = true;
        }
        if has_t {
            th.thunk_sym = try remap_worker_sym(alloc, w, base_sym_len, interner, th.thunk_sym);
            try merge_blob.fn_ref_thunks.push(alloc, th);
        }
        ti = ti +% 1_usize;
    }

    try append_blob_to_link_input(alloc, merge_blob, input, helper_queue, helper_seen, all_fnref_thunks);

    if cap_ok.* {
        if it.extra_fn_len > 0_u32 || merge_blob.fn_ref_thunks.len() > 0_usize {
            cap_ok.* = false;
            if let cap = capture_opt {
                cap.can_inc = false;
            }
        } else if let cap = capture_opt {
            var f_mod = span.SYM_EMPTY;
            var f_key = cfg_ir.fn_key_top_def(0_u32);
            if let f = eir_prog.get_fn(fi) {
                f_mod = f.mod_name;
                f_key = f.key;
            }
            var meta_buf = try col.DynBuf.[u8].init(alloc, 64_usize);
            errdefer meta_buf.destroy(alloc);
            try serialize_blob_meta(alloc, merge_blob, interner, &mut meta_buf);
            try cap.push_fn(alloc, f_mod, g_fn_sym, f_key, merge_blob.code.as_slice(), meta_buf.as_slice());
            meta_buf.destroy(alloc);
        }
    }

    // Append any outlined par-for workers with remapped symbols
    let ef_start = it.extra_fn_off.widen.[usize]();
    let ef_len = it.extra_fn_len.widen.[usize]();
    let ec_base = it.extra_code_off.widen.[usize]();
    let er_base = it.extra_reloc_off.widen.[usize]();
    var ei: usize = 0_usize;
    while ei < ef_len {
        let epos = ef_start +% ei;
        var ef = ExtraFnEntry.{ sym_id: 0_u32, code_off: 0_u32, code_len: 0_u32, reloc_start: 0_u32, reloc_len: 0_u32 };
        var has_ef = false;
        let efs = w.extra_fns_pool.as_slice();
        if epos < efs.len {
            ef = efs[epos];
            has_ef = true;
        }
        if has_ef {
            let gef_sym = try remap_worker_sym(alloc, w, base_sym_len, interner, ef.sym_id);
            try pad_dyn_u8(alloc, &mut input.text, 16_usize);
            let eoff = input.text.len().widen.[u64]();
            try input.symbols.push(alloc, elf64.ElfSymbol.{
                name_sym: gef_sym,
                section: .Text,
                offset: eoff,
                size: ef.code_len.widen.[u64](),
                is_global: true,
                is_func: true,
            });
            let cs = ec_base +% ef.code_off.widen.[usize]();
            let ce = cs +% ef.code_len.widen.[usize]();
            let ecode_all = w.extra_code_pool.as_slice();
            if ce <= ecode_all.len {
                let sub = ecode_all.sub(cs, ce) catch { break; };
                try input.text.push_slice(alloc, sub);
            }
            let rs_off = er_base +% ef.reloc_start.widen.[usize]();
            let rl = ef.reloc_len.widen.[usize]();
            var ri2: usize = 0_usize;
            while ri2 < rl {
                let ridx = rs_off +% ri2;
                var r = x64_asm.FnReloc.{ offset: 0_u32, kind: .Rel32, sym_id: 0_u32, addend: 0_i64 };
                var has_er = false;
                let ers = w.extra_relocs_pool.as_slice();
                if ridx < ers.len {
                    r = ers[ridx];
                    has_er = true;
                }
                if !has_er {
                    break;
                }
                let gr_sym = try remap_worker_sym(alloc, w, base_sym_len, interner, r.sym_id);
                try input.relocs.push(alloc, elf64.ElfReloc.{
                    section: .Text,
                    offset: eoff +% r.offset.widen.[u64](),
                    kind: x64_reloc_to_elf(r.kind),
                    target_sym: gr_sym,
                    addend: r.addend,
                });
                ri2 = ri2 +% 1_usize;
            }
        }
        ei = ei +% 1_usize;
    }
    return true;
}

view fn slice_u32_sub(all: *[u8], off: u32, len: u32) -> *[u8] {
    let empty: *str = "";
    let start = off.widen.[usize]();
    let end = start +% len.widen.[usize]();
    let s = all.sub(start, end) catch {
        return empty.as_bytes();
    };
    return s;
}

pub struct CapturedFnRec {
    pub mod_sym: u32;
    pub fn_sym: u32;
    pub key: cfg_ir.CfgFnKey;
    pub code_off: u32;
    pub code_len: u32;
    pub meta_off: u32;
    pub meta_len: u32;
}

pub linear struct CapturedProgramBlobs {
    pub can_inc: bool;
    pub start_code: col.DynBuf[u8];
    pub start_meta: col.DynBuf[u8];
    pub fns: col.DynBuf[CapturedFnRec];
    pub code_pool: col.DynBuf[u8];
    pub meta_pool: col.DynBuf[u8];
}

impl CapturedProgramBlobs {
    pub fn init(alloc: *mut AllocCap) -> CapturedProgramBlobs ! OutOfMemory {
        let start_code = try col.DynBuf.[u8].init(alloc, 256_usize);
        errdefer start_code.destroy(alloc);
        let start_meta = try col.DynBuf.[u8].init(alloc, 256_usize);
        errdefer start_meta.destroy(alloc);
        let fns = try col.DynBuf.[CapturedFnRec].init(alloc, 64_usize);
        errdefer fns.destroy(alloc);
        let code_pool = try col.DynBuf.[u8].init(alloc, 4096_usize);
        errdefer code_pool.destroy(alloc);
        let meta_pool = try col.DynBuf.[u8].init(alloc, 1024_usize);
        errdefer meta_pool.destroy(alloc);
        return CapturedProgramBlobs.{
            can_inc: false,
            start_code: start_code,
            start_meta: start_meta,
            fns: fns,
            code_pool: code_pool,
            meta_pool: meta_pool,
        };
    }

    pub fn push_fn(
        self: *mut Self,
        alloc: *mut AllocCap,
        mod_sym: u32,
        fn_sym: u32,
        key: cfg_ir.CfgFnKey,
        code: *[u8],
        meta: *[u8],
    ) -> !OutOfMemory {
        let coff = self.code_pool.len().trunc.[u32]();
        let clen = code.len.trunc.[u32]();
        try self.code_pool.push_slice(alloc, code);
        let moff = self.meta_pool.len().trunc.[u32]();
        let mlen = meta.len.trunc.[u32]();
        try self.meta_pool.push_slice(alloc, meta);
        try self.fns.push(
            alloc,
            CapturedFnRec.{
                mod_sym: mod_sym,
                fn_sym: fn_sym,
                key: key,
                code_off: coff,
                code_len: clen,
                meta_off: moff,
                meta_len: mlen,
            },
        );
        return;
    }

    pub view fn fn_code(self: *Self, idx: usize) -> *[u8] {
        let empty: *str = "";
        let fs = self.fns.as_slice();
        if idx < fs.len {
            let r = fs[idx];
            return slice_u32_sub(self.code_pool.as_slice(), r.code_off, r.code_len);
        }
        return empty.as_bytes();
    }

    pub view fn fn_meta(self: *Self, idx: usize) -> *[u8] {
        let empty: *str = "";
        let fs = self.fns.as_slice();
        if idx < fs.len {
            let r = fs[idx];
            return slice_u32_sub(self.meta_pool.as_slice(), r.meta_off, r.meta_len);
        }
        return empty.as_bytes();
    }

    pub fn destroy(self: CapturedProgramBlobs, alloc: *mut AllocCap) {
        let CapturedProgramBlobs.{
            can_inc: _,
            start_code,
            start_meta,
            fns,
            code_pool,
            meta_pool,
        } = self;
        start_code.destroy(alloc);
        start_meta.destroy(alloc);
        fns.destroy(alloc);
        code_pool.destroy(alloc);
        meta_pool.destroy(alloc);
    }
}

fn fn_eligible_for_inc_cache(f: *eir.EirFunction) -> bool {
    if f.mod_name == span.SYM_EMPTY {
        return false;
    }
    if f.key.kind != .TopDef && f.key.kind != .ImplMethod {
        return false;
    }
    if f.par_for_regions.len > 0_u32 {
        return false;
    }
    let e = f.sig.effects;
    if e.is_pure
        || e.is_noalloc
        || e.is_noblock
        || e.is_no_panic
        || e.is_interrupt
        || e.is_naked
        || e.is_export_c
        || e.is_gpu
        || e.has_stack_limit
    {
        return false;
    }
    return true;
}

fn clear_compiled_blob(blob: *mut CompiledFnBlob, sym_id: u32) {
    blob.sym_id = sym_id;
    blob.own_stack_bytes = 0_u64;
    blob.code.clear();
    blob.relocs.clear();
    blob.rodata_items.clear();
    blob.rodata_bytes.clear();
    blob.rodata_relocs.clear();
    blob.used_helpers.clear();
    blob.line_entries.clear();
    blob.debug_vars.clear();
    blob.fn_ref_thunks.clear();
}

fn sat_add_stack(a: u64, b: u64) -> u64 {
    let s = a +% b;
    if s < a {
        return 0xFFFFFFFFFFFFFFFF_u64;
    }
    return s;
}

@recursive
fn compute_native_stack_dfs(
    fi: u32,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    own_stack: *[u64],
    vis: *mut [u8],
    memo_tot: *mut [u64],
    memo_unb: *mut [bool],
) -> u64 {
    let idx = fi.widen.[usize]();
    if idx >= vis.len || idx >= memo_tot.len || idx >= memo_unb.len {
        return 0_u64;
    }
    if vis[idx] == 2_u8 {
        return memo_tot[idx];
    }
    if vis[idx] == 1_u8 {
        memo_unb[idx] = true;
        return 0_u64;
    }
    vis[idx] = 1_u8;
    let own = if idx < own_stack.len { own_stack[idx] } else { 0_u64 };
    var max_callee: u64 = 0_u64;
    var unb = false;

    let blks = eir_prog.fn_blocks(fi);
    var bi: usize = 0_usize;
    while bi < blks.len {
        let insts = eir_prog.insts_slice(blks[bi].insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let ins = insts[ii];
            if ins.kind == .Call {
                if let cd = eir_prog.get_call(ins.aux0) {
                    match cd.callee.kind {
                        .DirectFn => {
                            if let cid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(cd.callee.a)) {
                                let ctot = compute_native_stack_dfs(cid, eir_prog, env, own_stack, vis, memo_tot, memo_unb);
                                let cu = cid.widen.[usize]();
                                if cu < memo_unb.len && memo_unb[cu] {
                                    unb = true;
                                }
                                if ctot > max_callee {
                                    max_callee = ctot;
                                }
                            }
                        }
                        .Method => {
                            if let cid = eir_prog.find_fn_by_key(cfg_ir.fn_key_impl_method(cd.callee.a, cd.callee.b)) {
                                let ctot = compute_native_stack_dfs(cid, eir_prog, env, own_stack, vis, memo_tot, memo_unb);
                                let cu = cid.widen.[usize]();
                                if cu < memo_unb.len && memo_unb[cu] {
                                    unb = true;
                                }
                                if ctot > max_callee {
                                    max_callee = ctot;
                                }
                            }
                        }
                        .GenericInst => {
                            if let cid = eir_prog.find_fn_by_key(cfg_ir.fn_key_generic_inst(cd.callee.a)) {
                                let ctot = compute_native_stack_dfs(cid, eir_prog, env, own_stack, vis, memo_tot, memo_unb);
                                let cu = cid.widen.[usize]();
                                if cu < memo_unb.len && memo_unb[cu] {
                                    unb = true;
                                }
                                if ctot > max_callee {
                                    max_callee = ctot;
                                }
                            }
                        }
                        .DynCall => {
                            var dyn_bounded = false;
                            if let im = env.get_iface(cd.callee.a) {
                                let ms = env.iface_methods_range(im.methods);
                                let mi = cd.callee.b.widen.[usize]();
                                if mi < ms.len && ms[mi].effects.has_stack_limit {
                                    let lim = ms[mi].effects.stack_limit;
                                    if lim > max_callee {
                                        max_callee = lim;
                                    }
                                    dyn_bounded = true;
                                }
                            }
                            if !dyn_bounded {
                                unb = true;
                            }
                        }
                        .ExternFn => {
                            unb = true;
                        }
                        .FnPtr => {
                            unb = true;
                        }
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        bi = bi +% 1_usize;
    }

    let tot = sat_add_stack(own, max_callee);
    if idx < memo_tot.len && idx < memo_unb.len && idx < vis.len {
        memo_tot[idx] = tot;
        memo_unb[idx] = unb;
        vis[idx] = 2_u8;
    }
    return tot;
}

fn verify_native_stack_budgets(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    own_stack: *[u64],
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let nfns = eir_prog.fn_count();
    var any_budget = false;
    var fi: u32 = 0_u32;
    while fi < nfns {
        if let f = eir_prog.get_fn(fi) {
            if f.sig.effects.has_stack_limit && !f.sig.effects.is_gpu && !f.is_emi_stub && f.blocks.len > 0_u32 {
                any_budget = true;
                break;
            }
        }
        fi = fi +% 1_u32;
    }
    if !any_budget {
        return true;
    }

    let n = nfns.widen.[usize]();
    var vis = try col.DynBuf.[u8].init(alloc, n);
    errdefer vis.destroy(alloc);
    var memo_tot = try col.DynBuf.[u64].init(alloc, n);
    errdefer memo_tot.destroy(alloc);
    var memo_unb = try col.DynBuf.[bool].init(alloc, n);
    errdefer memo_unb.destroy(alloc);
    var zi: usize = 0_usize;
    while zi < n {
        try vis.push(alloc, 0_u8);
        try memo_tot.push(alloc, 0_u64);
        try memo_unb.push(alloc, false);
        zi = zi +% 1_usize;
    }

    var ok = true;
    fi = 0_u32;
    while fi < nfns {
        if let f = eir_prog.get_fn(fi) {
            if f.sig.effects.has_stack_limit && !f.sig.effects.is_gpu && !f.is_emi_stub && f.blocks.len > 0_u32 {
                let tot = compute_native_stack_dfs(
                    fi, eir_prog, env, own_stack,
                    vis.as_mut_slice(), memo_tot.as_mut_slice(), memo_unb.as_mut_slice(),
                );
                let idx = fi.widen.[usize]();
                let is_unb = if let p = memo_unb.get(idx) { p.* } else { false };
                let own = if idx < own_stack.len { own_stack[idx] } else { 0_u64 };
                let lim = f.sig.effects.stack_limit;
                if is_unb {
                    ok = false;
                    try err_out.push_str_grow(alloc, "error[E0701]: final native stack usage of `");
                    try err_out.push_bytes_grow(alloc, interner.get(f.name));
                    try err_out.push_str_grow(alloc, "` is unbounded (indirect/extern/recursive call) inside `@stack(");
                    try err_out.push_u64_grow(alloc, lim);
                    try err_out.push_str_grow(alloc, ")`\n");
                } else if tot > lim {
                    ok = false;
                    let callee_part = if tot >= own { tot - own } else { 0_u64 };
                    try err_out.push_str_grow(alloc, "error[E0701]: final native stack usage of `");
                    try err_out.push_bytes_grow(alloc, interner.get(f.name));
                    try err_out.push_str_grow(alloc, "` is ");
                    try err_out.push_u64_grow(alloc, tot);
                    try err_out.push_str_grow(alloc, " bytes (own machine frame = ");
                    try err_out.push_u64_grow(alloc, own);
                    try err_out.push_str_grow(alloc, ", max callee chain = ");
                    try err_out.push_u64_grow(alloc, callee_part);
                    try err_out.push_str_grow(alloc, "), exceeding `@stack(");
                    try err_out.push_u64_grow(alloc, lim);
                    try err_out.push_str_grow(alloc, ")` budget\n");
                }
            }
        }
        fi = fi +% 1_u32;
    }

    memo_unb.destroy(alloc);
    memo_tot.destroy(alloc);
    vis.destroy(alloc);
    return ok;
}

fn compile_wave_sequential(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
    opts_hash: *[32]u8,
    wave_fns: *[u32],
    pre_fn_syms: *[u32],
    has_cache: bool,
    cache_opt: ?*mut emi.EmiModuleCache,
    cap_ok: *mut bool,
    capture_opt: ?*mut CapturedProgramBlobs,
    fn_own_stack: *mut col.DynBuf[u64],
    input: *mut elf64.ElfLinkInput,
    helper_queue: *mut col.DynBuf[u32],
    helper_seen: *mut col.HashMap[u32],
    all_fnref_thunks: *mut col.DynBuf[FnRefThunkReq],
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    var pending_ipra = try col.DynBuf.[PendingIpra].init(alloc, if wave_fns.len > 4_usize { wave_fns.len } else { 4_usize });
    errdefer pending_ipra.destroy(alloc);
    var opt_blob = try CompiledFnBlob.init(alloc, 0_u32);
    errdefer opt_blob.destroy(alloc);

    var wi: usize = 0_usize;
    while wi < wave_fns.len {
        let fi = wave_fns[wi];
        let fiu = fi.widen.[usize]();
        let fn_sym = if fiu < pre_fn_syms.len { pre_fn_syms[fiu] } else { span.SYM_EMPTY };
        var f_mod = span.SYM_EMPTY;
        var f_key = cfg_ir.fn_key_top_def(0_u32);
        var f_pf_len: u32 = 0_u32;
        if let f = eir_prog.get_fn(fi) {
            f_mod = f.mod_name;
            f_key = f.key;
            f_pf_len = f.par_for_regions.len;
        }
        var reused = false;
        if has_cache && f_pf_len == 0_u32 {
            if let cptr = cache_opt {
                let fhash = try hash_eir_function(alloc, eir_prog, fi, fn_sym, interner, opts_hash);
                if cptr.is_fn_fresh(fn_sym, &fhash) {
                    if let entry = cptr.lookup_entry(fn_sym) {
                        var cblob = try CompiledFnBlob.init(alloc, fn_sym);
                        errdefer cblob.destroy(alloc);
                        try cblob.code.push_slice(alloc, cptr.entry_code(&entry));
                        let meta_ok = try deserialize_blob_meta(alloc, cptr.entry_relocs(&entry), interner, &mut cblob);
                        if meta_ok {
                            try append_blob_to_link_input(alloc, &cblob, input, helper_queue, helper_seen, all_fnref_thunks);
                            reused = true;
                        }
                        cblob.destroy(alloc);
                    }
                }
            }
        }
        if !reused {
            var used_opt_backend = false;
            if opts.opt.opt_level > 0_u8 {
                clear_compiled_blob(&mut opt_blob, fn_sym);
                var has_ipra = false;
                var ipra_gprs: u32 = 0xFFFFFFFF_u32;
                var ipra_xmms: u32 = 0xFFFFFFFF_u32;
                let opt_ok = try try_compile_fn_optimized_core(
                    alloc, sm, eir_prog, fi, fn_sym, env, ct, interner, opts, &mut opt_blob,
                    &mut has_ipra, &mut ipra_gprs, &mut ipra_xmms,
                );
                if opt_ok {
                    if has_ipra {
                        try pending_ipra.push(alloc, PendingIpra.{ fn_id: fi, gprs: ipra_gprs, xmms: ipra_xmms });
                    }
                    let os_s = fn_own_stack.as_mut_slice();
                    if fiu < os_s.len {
                        os_s[fiu] = opt_blob.own_stack_bytes;
                    }
                    try append_blob_to_link_input(
                        alloc, &opt_blob, input, helper_queue, helper_seen, all_fnref_thunks,
                    );
                    if cap_ok.* {
                        if let cap = capture_opt {
                            var meta_buf = try col.DynBuf.[u8].init(alloc, 64_usize);
                            errdefer meta_buf.destroy(alloc);
                            try serialize_blob_meta(alloc, &opt_blob, interner, &mut meta_buf);
                            try cap.push_fn(alloc, f_mod, fn_sym, f_key, opt_blob.code.as_slice(), meta_buf.as_slice());
                            meta_buf.destroy(alloc);
                        }
                    } else if has_cache && f_pf_len == 0_u32 {
                        if let cptr = cache_opt {
                            let fhash = try hash_eir_function(alloc, eir_prog, fi, fn_sym, interner, opts_hash);
                            var meta_buf = try col.DynBuf.[u8].init(alloc, 64_usize);
                            errdefer meta_buf.destroy(alloc);
                            try serialize_blob_meta(alloc, &opt_blob, interner, &mut meta_buf);
                            try cptr.put_entry(alloc, fn_sym, fhash, opt_blob.code.as_slice(), meta_buf.as_slice());
                            meta_buf.destroy(alloc);
                        }
                    }
                    used_opt_backend = true;
                }
            }
            if !used_opt_backend {
                let outcome = try compile_function_x64(alloc, sm, eir_prog, fi, env, ct, interner, opts);
                errdefer outcome.destroy(alloc);
                if !outcome.ok {
                    try err_out.push_bytes_grow(alloc, outcome.err_msg.as_bytes());
                    outcome.destroy(alloc);
                    opt_blob.destroy(alloc);
                    pending_ipra.destroy(alloc);
                    return false;
                }
                let os_s2 = fn_own_stack.as_mut_slice();
                if fiu < os_s2.len {
                    os_s2[fiu] = outcome.blob.own_stack_bytes;
                }
                try append_blob_to_link_input(alloc, &outcome.blob, input, helper_queue, helper_seen, all_fnref_thunks);
                if cap_ok.* {
                    if outcome.extra_fns.len() > 0_usize || outcome.blob.fn_ref_thunks.len() > 0_usize {
                        cap_ok.* = false;
                        if let cap = capture_opt {
                            cap.can_inc = false;
                        }
                    } else if let cap = capture_opt {
                        var meta_buf = try col.DynBuf.[u8].init(alloc, 64_usize);
                        errdefer meta_buf.destroy(alloc);
                        try serialize_blob_meta(alloc, &outcome.blob, interner, &mut meta_buf);
                        try cap.push_fn(alloc, f_mod, fn_sym, f_key, outcome.blob.code.as_slice(), meta_buf.as_slice());
                        meta_buf.destroy(alloc);
                    }
                }
                let efns = outcome.extra_fns.as_slice();
                let ecode = outcome.extra_code.as_slice();
                var ei: usize = 0_usize;
                while ei < efns.len {
                    let ef = efns[ei];
                    try pad_dyn_u8(alloc, &mut input.text, 16_usize);
                    let eoff = input.text.len().widen.[u64]();
                    try input.symbols.push(alloc, elf64.ElfSymbol.{
                        name_sym: ef.sym_id,
                        section: .Text,
                        offset: eoff,
                        size: ef.code_len.widen.[u64](),
                        is_global: true,
                        is_func: true,
                    });
                    let cs = ef.code_off.widen.[usize]();
                    let ce = cs +% ef.code_len.widen.[usize]();
                    if ce <= ecode.len {
                        let sub = ecode.sub(cs, ce) catch { break; };
                        try input.text.push_slice(alloc, sub);
                    }
                    let rs = ef.reloc_start.widen.[usize]();
                    let rl = ef.reloc_len.widen.[usize]();
                    var ri2: usize = 0_usize;
                    while ri2 < rl {
                        let ridx = rs +% ri2;
                        if let rp = outcome.extra_relocs.get(ridx) {
                            let r = rp.*;
                            try input.relocs.push(alloc, elf64.ElfReloc.{
                                section: .Text,
                                offset: eoff +% r.offset.widen.[u64](),
                                kind: x64_reloc_to_elf(r.kind),
                                target_sym: r.sym_id,
                                addend: r.addend,
                            });
                        } else {
                            break;
                        }
                        ri2 = ri2 +% 1_usize;
                    }
                    ei = ei +% 1_usize;
                }
                if !cap_ok.* && has_cache && f_pf_len == 0_u32 {
                    if let cptr = cache_opt {
                        let fhash = try hash_eir_function(alloc, eir_prog, fi, fn_sym, interner, opts_hash);
                        var meta_buf = try col.DynBuf.[u8].init(alloc, 64_usize);
                        errdefer meta_buf.destroy(alloc);
                        try serialize_blob_meta(alloc, &outcome.blob, interner, &mut meta_buf);
                        try cptr.put_entry(alloc, fn_sym, fhash, outcome.blob.code.as_slice(), meta_buf.as_slice());
                        meta_buf.destroy(alloc);
                    }
                }
                outcome.destroy(alloc);
            }
        }
        wi = wi +% 1_usize;
    }

    // Commit wave IPRA masks at wave barrier (matches parallel wave semantics bit-exactly!).
    let pis = pending_ipra.as_slice();
    var pi: usize = 0_usize;
    while pi < pis.len {
        let p = pis[pi];
        try eir_prog.set_fn_ipra(alloc, p.fn_id, p.gprs, p.xmms);
        pi = pi +% 1_usize;
    }

    opt_blob.destroy(alloc);
    pending_ipra.destroy(alloc);
    return true;
}

fn compile_all_waves_parallel(
    alloc: *mut AllocCap,
    n_workers: usize,
    sm: *span.SourceMap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
    opts_hash: *[32]u8,
    fn_order: *[u32],
    wave_ranges: *[WaveRange],
    pre_fn_syms: *[u32],
    cap_ok: *mut bool,
    capture_opt: ?*mut CapturedProgramBlobs,
    fn_own_stack: *mut col.DynBuf[u64],
    input: *mut elf64.ElfLinkInput,
    helper_queue: *mut col.DynBuf[u32],
    helper_seen: *mut col.HashMap[u32],
    all_fnref_thunks: *mut col.DynBuf[FnRefThunkReq],
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let base_sym_len = interner.len();
    var w0 = try WorkerCgState.init_with(alloc, interner, true);
    errdefer w0.destroy(alloc);
    var w1 = try WorkerCgState.init_with(alloc, interner, n_workers > 1_usize);
    errdefer w1.destroy(alloc);
    var w2 = try WorkerCgState.init_with(alloc, interner, n_workers > 2_usize);
    errdefer w2.destroy(alloc);
    var w3 = try WorkerCgState.init_with(alloc, interner, n_workers > 3_usize);
    errdefer w3.destroy(alloc);
    var w4 = try WorkerCgState.init_with(alloc, interner, n_workers > 4_usize);
    errdefer w4.destroy(alloc);
    var w5 = try WorkerCgState.init_with(alloc, interner, n_workers > 5_usize);
    errdefer w5.destroy(alloc);
    var w6 = try WorkerCgState.init_with(alloc, interner, n_workers > 6_usize);
    errdefer w6.destroy(alloc);
    var w7 = try WorkerCgState.init_with(alloc, interner, n_workers > 7_usize);
    errdefer w7.destroy(alloc);
    var w8 = try WorkerCgState.init_with(alloc, interner, n_workers > 8_usize);
    errdefer w8.destroy(alloc);
    var w9 = try WorkerCgState.init_with(alloc, interner, n_workers > 9_usize);
    errdefer w9.destroy(alloc);
    var w10 = try WorkerCgState.init_with(alloc, interner, n_workers > 10_usize);
    errdefer w10.destroy(alloc);
    var w11 = try WorkerCgState.init_with(alloc, interner, n_workers > 11_usize);
    errdefer w11.destroy(alloc);

    var work_order = try col.DynBuf.[u32].init(alloc, 64_usize);
    errdefer work_order.destroy(alloc);
    var loc_w = try col.DynBuf.[u8].init(alloc, 64_usize);
    errdefer loc_w.destroy(alloc);
    var loc_idx = try col.DynBuf.[u32].init(alloc, 64_usize);
    errdefer loc_idx.destroy(alloc);
    var merge_blob = try CompiledFnBlob.init(alloc, 0_u32);
    errdefer merge_blob.destroy(alloc);

    var all_ok = true;
    var wri: usize = 0_usize;
    while wri < wave_ranges.len && all_ok {
        let wr = wave_ranges[wri];
        let ws = wr.start.widen.[usize]();
        let wl = wr.len.widen.[usize]();
        if wl == 0_usize || ws +% wl > fn_order.len {
            wri = wri +% 1_usize;
            continue;
        }
        let wave_fns = fn_order.sub(ws, ws +% wl) catch { break; };
        if wl < 8_usize {
            let seq_ok = try compile_wave_sequential(
                alloc, sm, eir_prog, env, ct, interner, opts, opts_hash, wave_fns, pre_fn_syms,
                false, null, cap_ok, capture_opt, fn_own_stack, input, helper_queue, helper_seen, all_fnref_thunks, err_out,
            );
            if !seq_ok {
                all_ok = false;
                break;
            }
            wri = wri +% 1_usize;
            continue;
        }

        work_order.clear();
        loc_w.clear();
        loc_idx.clear();
        var k: usize = 0_usize;
        while k < wl {
            try work_order.push(alloc, k.trunc.[u32]());
            try loc_w.push(alloc, 255_u8);
            try loc_idx.push(alloc, 0_u32);
            k = k +% 1_usize;
        }
        sort_wave_lpt(work_order.as_mut_slice(), wave_fns, eir_prog);

        w0.clear_wave();
        w1.clear_wave();
        w2.clear_wave();
        w3.clear_wave();
        w4.clear_wave();
        w5.clear_wave();
        w6.clear_wave();
        w7.clear_wave();
        w8.clear_wave();
        w9.clear_wave();
        w10.clear_wave();
        w11.clear_wave();

        var next_pos = sync.AtomicCounter.init(0_u64);
        let eff_workers = if wl < n_workers { wl } else { n_workers };
        dispatch_cg_workers(
            eff_workers, alloc, &mut next_pos, work_order.as_slice(), wave_fns, pre_fn_syms,
            sm, eir_prog, env, ct, opts,
            &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
            &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
        );

        if w0.oom || w1.oom || w2.oom || w3.oom || w4.oom || w5.oom
            || w6.oom || w7.oom || w8.oom || w9.oom || w10.oom || w11.oom
        {
            return .OutOfMemory;
        }

        index_worker_items(0_u8, &w0, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(1_u8, &w1, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(2_u8, &w2, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(3_u8, &w3, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(4_u8, &w4, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(5_u8, &w5, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(6_u8, &w6, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(7_u8, &w7, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(8_u8, &w8, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(9_u8, &w9, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(10_u8, &w10, loc_w.as_mut_slice(), loc_idx.as_mut_slice());
        index_worker_items(11_u8, &w11, loc_w.as_mut_slice(), loc_idx.as_mut_slice());

        // Merge wave results in exact deterministic wave_pos = 0..wl-1 order.
        var wp: usize = 0_usize;
        while wp < wl && all_ok {
            var wt: u8 = 255_u8;
            var li: usize = 0_usize;
            let lw_s = loc_w.as_slice();
            if wp < lw_s.len {
                wt = lw_s[wp];
            }
            let lx_s = loc_idx.as_slice();
            if wp < lx_s.len {
                li = lx_s[wp].widen.[usize]();
            }
            if wt == 0_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w0, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 1_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w1, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 2_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w2, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 3_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w3, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 4_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w4, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 5_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w5, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 6_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w6, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 7_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w7, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 8_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w8, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 9_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w9, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 10_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w10, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            } else if wt == 11_u8 {
                all_ok = try commit_worker_cg_item(alloc, &mut w11, li, base_sym_len, eir_prog, interner, fn_own_stack, &mut merge_blob, input, helper_queue, helper_seen, all_fnref_thunks, cap_ok, capture_opt, err_out);
            }
            wp = wp +% 1_usize;
        }
        wri = wri +% 1_usize;
    }

    merge_blob.destroy(alloc);
    loc_idx.destroy(alloc);
    loc_w.destroy(alloc);
    work_order.destroy(alloc);
    w11.destroy(alloc);
    w10.destroy(alloc);
    w9.destroy(alloc);
    w8.destroy(alloc);
    w7.destroy(alloc);
    w6.destroy(alloc);
    w5.destroy(alloc);
    w4.destroy(alloc);
    w3.destroy(alloc);
    w2.destroy(alloc);
    w1.destroy(alloc);
    w0.destroy(alloc);
    return all_ok;
}

fn compile_and_link_impl(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *mut eir.EirProgram,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
    needed_libs: *[u32],
    has_cache: bool,
    cache_opt: ?*mut emi.EmiModuleCache,
    capture_opt: ?*mut CapturedProgramBlobs,
) -> CompileResult ! OutOfMemory {
    var input = try elf64.ElfLinkInput.init(alloc);
    errdefer input.destroy(alloc);
    input.mode = opts.mode;
    input.emit_debug_line = opts.emit_debug_line;
    try input.needed_libs.push_slice(alloc, needed_libs);

    // Populate DWARF5 debug file table from SourceMap
    let nfiles = sm.file_count();
    var dfi: u32 = 0_u32;
    while dfi < nfiles {
        let fname = sm.file_name(dfi);
        let fsym = try interner.intern(alloc, fname);
        try input.debug_files.push(alloc, fsym);
        dfi = dfi +% 1_u32;
    }

    var helper_queue = try col.DynBuf.[u32].init(alloc, 16_usize);
    errdefer helper_queue.destroy(alloc);
    var helper_seen = try col.HashMap.[u32].init(alloc, 32_usize);
    errdefer helper_seen.destroy(alloc);
    var all_fnref_thunks = try col.DynBuf.[FnRefThunkReq].init(alloc, 8_usize);
    errdefer all_fnref_thunks.destroy(alloc);

    let opts_hash = compute_opts_hash(opts);
    let nfns = eir_prog.fn_count();
    var has_sched = eir_prog.schedule_count() > 0_u32;
    var cap_ok = opts.mode.kind == .LinuxPie
        && needed_libs.len == 0_usize
        && !has_sched
        && eir_prog.aux.dyn_impl_pairs.len() == 0_usize;
    if let cap = capture_opt {
        cap.can_inc = cap_ok;
    } else {
        cap_ok = false;
    }

    var fn_own_stack = try col.DynBuf.[u64].init(
        alloc,
        if nfns > 4_u32 { nfns.widen.[usize]() } else { 4_usize },
    );
    errdefer fn_own_stack.destroy(alloc);
    var pre_fn_syms = try col.DynBuf.[u32].init(
        alloc,
        if nfns > 4_u32 { nfns.widen.[usize]() } else { 4_usize },
    );
    errdefer pre_fn_syms.destroy(alloc);
    var si_stk: u32 = 0_u32;
    while si_stk < nfns {
        try fn_own_stack.push(alloc, 0_u64);
        try pre_fn_syms.push(alloc, span.SYM_EMPTY);
        si_stk = si_stk +% 1_u32;
    }

    var fn_order = try col.DynBuf.[u32].init(
        alloc,
        if nfns > 4_u32 { nfns.widen.[usize]() } else { 4_usize },
    );
    errdefer fn_order.destroy(alloc);
    var wave_ranges = try col.DynBuf.[WaveRange].init(alloc, 32_usize);
    errdefer wave_ranges.destroy(alloc);
    try build_bottom_up_waves(alloc, eir_prog, opts.opt.opt_level, &mut fn_order, &mut wave_ranges);

    // Pre-intern all active function symbols & check par_for / inc-cache eligibility deterministically.
    let ord_pre = fn_order.as_slice();
    var oi_pre: usize = 0_usize;
    while oi_pre < ord_pre.len {
        let fi = ord_pre[oi_pre];
        if let f = eir_prog.get_fn(fi) {
            if f.par_for_regions.len > 0_u32 {
                has_sched = true;
            }
            if cap_ok && !fn_eligible_for_inc_cache(f) {
                cap_ok = false;
                if let cap = capture_opt {
                    cap.can_inc = false;
                }
            }
            let fn_sym = try fn_sym_name_id(alloc, f.key, eir_prog, interner);
            let pfs = pre_fn_syms.as_mut_slice();
            let fiu = fi.widen.[usize]();
            if fiu < pfs.len {
                pfs[fiu] = fn_sym;
            }
        }
        oi_pre = oi_pre +% 1_usize;
    }

    // 1. Compile (or reuse from .emi cache) every active EIR function wave-by-wave (parallel when >= 2 workers).
    var stk_err = try str.StrBuf.init(alloc, 16_usize);
    errdefer stk_err.destroy(alloc);
    let n_workers = if has_cache { 1_usize } else { auto_cg_workers(opts.jobs, fn_order.len()) };
    var cg_ok = true;
    if n_workers <= 1_usize {
        let wrs = wave_ranges.as_slice();
        let ord_s = fn_order.as_slice();
        var wri: usize = 0_usize;
        while wri < wrs.len && cg_ok {
            let wr = wrs[wri];
            let ws = wr.start.widen.[usize]();
            let wl = wr.len.widen.[usize]();
            if wl > 0_usize && ws +% wl <= ord_s.len {
                let wave_fns = ord_s.sub(ws, ws +% wl) catch { break; };
                cg_ok = try compile_wave_sequential(
                    alloc, sm, eir_prog, env, ct, interner, opts, &opts_hash, wave_fns, pre_fn_syms.as_slice(),
                    has_cache, cache_opt, &mut cap_ok, capture_opt, &mut fn_own_stack,
                    &mut input, &mut helper_queue, &mut helper_seen, &mut all_fnref_thunks, &mut stk_err,
                );
            }
            wri = wri +% 1_usize;
        }
    } else {
        cg_ok = try compile_all_waves_parallel(
            alloc, n_workers, sm, eir_prog, env, ct, interner, opts, &opts_hash,
            fn_order.as_slice(), wave_ranges.as_slice(), pre_fn_syms.as_slice(),
            &mut cap_ok, capture_opt, &mut fn_own_stack,
            &mut input, &mut helper_queue, &mut helper_seen, &mut all_fnref_thunks, &mut stk_err,
        );
    }
    if !cg_ok {
        let empty_elf = try elf64.LinkedElf.empty(alloc);
        errdefer empty_elf.destroy(alloc);
        wave_ranges.destroy(alloc);
        fn_order.destroy(alloc);
        pre_fn_syms.destroy(alloc);
        fn_own_stack.destroy(alloc);
        all_fnref_thunks.destroy(alloc);
        helper_seen.destroy(alloc);
        helper_queue.destroy(alloc);
        input.destroy(alloc);
        return CompileResult.{ ok: false, elf: empty_elf, err_msg: stk_err };
    }

    // 1b. Post-codegen verification of `@stack(N)` budgets against real machine frames
    let stk_ok = try verify_native_stack_budgets(
        alloc, eir_prog, env, interner, fn_own_stack.as_slice(), &mut stk_err,
    );
    if !stk_ok {
        let empty_elf = try elf64.LinkedElf.empty(alloc);
        errdefer empty_elf.destroy(alloc);
        wave_ranges.destroy(alloc);
        fn_order.destroy(alloc);
        pre_fn_syms.destroy(alloc);
        fn_own_stack.destroy(alloc);
        all_fnref_thunks.destroy(alloc);
        helper_seen.destroy(alloc);
        helper_queue.destroy(alloc);
        input.destroy(alloc);
        return CompileResult.{ ok: false, elf: empty_elf, err_msg: stk_err };
    }

    let is_windows = opts.target_spec.os == .Windows;
    let is_darwin = opts.target_spec.is_darwin();
    let is_android = opts.target_spec.os == .Android;
    if is_android {
        input.mode = elf64.ElfMode.linux_shared(0_u32, 0_u32).with_arch(.X86_64);
        try input.set_soname(alloc, "libmain.so".as_bytes());
        var bli: usize = 0_usize;
        while bli < 4_usize {
            let lname: *str = if bli == 0_usize { "libc.so" } else if bli == 1_usize { "libandroid.so" } else if bli == 2_usize { "liblog.so" } else { "libvulkan.so" };
            let lsym = try interner.intern_str(alloc, lname);
            var dup = false;
            let nl = input.needed_libs.as_slice();
            var nli: usize = 0_usize;
            while nli < nl.len {
                if nl[nli] == lsym { dup = true; break; }
                nli = nli +% 1_usize;
            }
            if !dup { try input.needed_libs.push(alloc, lsym); }
            bli = bli +% 1_usize;
        }
    }

    // 2. Emit OS entry wrapper (`_start` LinuxPie, `mainCRTStartup` Win64, `_main` Darwin) or Freestanding entry
    var captured_start = false;
    if let entry_fid = find_entry_fn_id(eir_prog, prog, interner, opts.mode) {
        if is_windows && !opts.target_spec.is_shared && opts.mode.kind != .LinuxShared {
            var sbuf = try x64_asm.X64Buf.init(alloc);
            errdefer sbuf.destroy(alloc);
            let s_ok = try emit_win64_start_into(alloc, entry_fid, eir_prog, env, interner, &mut sbuf);
            if s_ok {
                try pad_dyn_u8(alloc, &mut input.text, 16_usize);
                let soff = input.text.len().widen.[u64]();
                let start_sym = try interner.intern_str(alloc, "mainCRTStartup");
                input.entry_sym = start_sym;
                try input.symbols.push(alloc, elf64.ElfSymbol.{
                    name_sym: start_sym,
                    section: .Text,
                    offset: soff,
                    size: sbuf.code.len().widen.[u64](),
                    is_global: true,
                    is_func: true,
                });
                let srels = sbuf.relocs.as_slice();
                var sri: usize = 0_usize;
                while sri < srels.len {
                    try input.relocs.push(alloc, elf64.ElfReloc.{
                        section: .Text,
                        offset: soff +% srels[sri].offset.widen.[u64](),
                        kind: x64_reloc_to_elf(srels[sri].kind),
                        target_sym: srels[sri].sym_id,
                        addend: srels[sri].addend,
                    });
                    sri = sri +% 1_usize;
                }
                try input.text.push_slice(alloc, sbuf.code.as_slice());
            }
            sbuf.destroy(alloc);
        } else if is_darwin && !opts.target_spec.is_shared && opts.mode.kind != .LinuxShared {
            var sbuf = try x64_asm.X64Buf.init(alloc);
            errdefer sbuf.destroy(alloc);
            let s_ok = try emit_darwin_x64_start_into(alloc, entry_fid, eir_prog, env, interner, &mut sbuf);
            if s_ok {
                try pad_dyn_u8(alloc, &mut input.text, 16_usize);
                let soff = input.text.len().widen.[u64]();
                let start_sym = try interner.intern_str(alloc, "_main");
                input.entry_sym = start_sym;
                try input.symbols.push(alloc, elf64.ElfSymbol.{
                    name_sym: start_sym,
                    section: .Text,
                    offset: soff,
                    size: sbuf.code.len().widen.[u64](),
                    is_global: true,
                    is_func: true,
                });
                let srels = sbuf.relocs.as_slice();
                var sri: usize = 0_usize;
                while sri < srels.len {
                    try input.relocs.push(alloc, elf64.ElfReloc.{
                        section: .Text,
                        offset: soff +% srels[sri].offset.widen.[u64](),
                        kind: x64_reloc_to_elf(srels[sri].kind),
                        target_sym: srels[sri].sym_id,
                        addend: srels[sri].addend,
                    });
                    sri = sri +% 1_usize;
                }
                try input.text.push_slice(alloc, sbuf.code.as_slice());
            }
            sbuf.destroy(alloc);
        } else if opts.mode.kind == .LinuxPie {
            var sbuf = try x64_asm.X64Buf.init(alloc);
            errdefer sbuf.destroy(alloc);
            var start_helpers = try col.DynBuf.[u32].init(alloc, 8_usize);
            errdefer start_helpers.destroy(alloc);
            let s_ok = try emit_linux_start_into(alloc, entry_fid, eir_prog, env, interner, opts, needed_libs, has_sched, &mut sbuf, &mut start_helpers);
            if s_ok {
                try pad_dyn_u8(alloc, &mut input.text, 16_usize);
                let soff = input.text.len().widen.[u64]();
                let start_sym = try interner.intern_str(alloc, "_start");
                input.entry_sym = start_sym;
                try input.symbols.push(alloc, elf64.ElfSymbol.{
                    name_sym: start_sym,
                    section: .Text,
                    offset: soff,
                    size: sbuf.code.len().widen.[u64](),
                    is_global: true,
                    is_func: true,
                });
                let srels = sbuf.relocs.as_slice();
                var sri: usize = 0_usize;
                while sri < srels.len {
                    try input.relocs.push(alloc, elf64.ElfReloc.{
                        section: .Text,
                        offset: soff +% srels[sri].offset.widen.[u64](),
                        kind: x64_reloc_to_elf(srels[sri].kind),
                        target_sym: srels[sri].sym_id,
                        addend: srels[sri].addend,
                    });
                    sri = sri +% 1_usize;
                }
                try input.text.push_slice(alloc, sbuf.code.as_slice());
                let shs = start_helpers.as_slice();
                var shi: usize = 0_usize;
                while shi < shs.len {
                    let hk = shs[shi].widen.[u64]();
                    if !helper_seen.contains(hk) {
                        try helper_seen.insert(alloc, hk, 1_u32);
                        try helper_queue.push(alloc, shs[shi]);
                    }
                    shi = shi +% 1_usize;
                }
                if cap_ok {
                    if let cap = capture_opt {
                        var sblob = try CompiledFnBlob.init(alloc, start_sym);
                        errdefer sblob.destroy(alloc);
                        try sblob.relocs.push_slice(alloc, sbuf.relocs.as_slice());
                        try sblob.used_helpers.push_slice(alloc, start_helpers.as_slice());
                        cap.start_code.clear();
                        try cap.start_code.push_slice(alloc, sbuf.code.as_slice());
                        cap.start_meta.clear();
                        try serialize_blob_meta(alloc, &sblob, interner, &mut cap.start_meta);
                        sblob.destroy(alloc);
                        captured_start = true;
                    }
                }
            }
            start_helpers.destroy(alloc);
            sbuf.destroy(alloc);
        } else if opts.mode.kind == .Freestanding {
            if let ef = eir_prog.get_fn(entry_fid) {
                input.entry_sym = try fn_sym_name_id(alloc, ef.key, eir_prog, interner);
            }
        }
    }

    // 3. Emit dynamic vtables & FnRef thunks
    try emit_dyn_vtables_x64(alloc, eir_prog, env, interner, &mut input);
    try emit_fnref_thunks_x64(alloc, eir_prog, env, interner, opts.mode.kind != .Freestanding && !is_windows && !is_darwin, all_fnref_thunks.as_slice(), &mut input);

    // 4. Emit runtime `.bss` symbols and tree-shaken runtime helpers
    try emit_rt_helpers_and_bss(alloc, interner, opts.target_spec.os, &mut helper_queue, &mut helper_seen, &mut input);

    // 5. Collect LinuxShared exports & external dynamic PLT/GOT symbols
    try populate_shared_exports_and_externals(alloc, eir_prog, interner, input.mode, &mut input);

    if let cap = capture_opt {
        if !cap_ok || !captured_start || all_fnref_thunks.len() > 0_usize || input.external_syms.len() > 0_usize || has_sched {
            cap.can_inc = false;
        }
    }

    // 6. Release EIR pools before link-time GC+ICF & native executable emission to minimize Peak RSS
    try eir_prog.release_pools(alloc);
    try elf64.gc_and_icf_link_input(alloc, &mut input, interner, opts.opt.opt_level >= 2_u8 || opts.opt.opt_size);
    let link_res = if is_windows {
        try pe_coff.link_pe64(alloc, &input, interner, opts.target_spec, opts.win_gui)
    } else if is_darwin {
        try macho.link_macho64(alloc, &input, interner, opts.target_spec)
    } else {
        try elf64.link_elf64(alloc, &input, interner)
    };
    stk_err.destroy(alloc);
    wave_ranges.destroy(alloc);
    fn_order.destroy(alloc);
    pre_fn_syms.destroy(alloc);
    fn_own_stack.destroy(alloc);
    all_fnref_thunks.destroy(alloc);
    helper_seen.destroy(alloc);
    helper_queue.destroy(alloc);
    input.destroy(alloc);

    let elf64.LinkResult.{ ok: lok, elf: lelf, err_msg: lerr } = link_res;
    return CompileResult.{ ok: lok, elf: lelf, err_msg: lerr };
}

pub fn compile_and_link_x64_capture(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *mut eir.EirProgram,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
    needed_libs: *[u32],
    capture: *mut CapturedProgramBlobs,
) -> CompileResult ! OutOfMemory {
    return try compile_and_link_impl(
        alloc,
        sm,
        eir_prog,
        prog,
        env,
        ct,
        interner,
        opts,
        needed_libs,
        false,
        null,
        capture,
    );
}

pub fn compile_dirty_eir_to_blobs(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
    out_blobs: *mut CapturedProgramBlobs,
) -> bool ! OutOfMemory {
    if eir_prog.schedule_count() > 0_u32 || eir_prog.aux.dyn_impl_pairs.len() > 0_usize {
        out_blobs.can_inc = false;
        return false;
    }
    out_blobs.can_inc = true;
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if let f = eir_prog.get_fn(fi) {
            if f.sig.effects.is_gpu || f.is_emi_stub || f.blocks.len == 0_u32 {
                fi = fi +% 1_u32;
                continue;
            }
            if !fn_eligible_for_inc_cache(f) {
                out_blobs.can_inc = false;
                return false;
            }
            let f_mod = f.mod_name;
            let f_key = f.key;
            let fn_sym = try fn_sym_name_id(alloc, f_key, eir_prog, interner);
            var used_opt = false;
            if opts.opt.opt_level > 0_u8 {
                var opt_blob = try CompiledFnBlob.init(alloc, fn_sym);
                errdefer opt_blob.destroy(alloc);
                let ok_opt = try try_compile_fn_optimized(
                    alloc, sm, eir_prog, fi, fn_sym, env, ct, interner, opts, &mut opt_blob,
                );
                if ok_opt {
                    if opt_blob.fn_ref_thunks.len() > 0_usize {
                        opt_blob.destroy(alloc);
                        out_blobs.can_inc = false;
                        return false;
                    }
                    var meta_buf = try col.DynBuf.[u8].init(alloc, 64_usize);
                    errdefer meta_buf.destroy(alloc);
                    try serialize_blob_meta(alloc, &opt_blob, interner, &mut meta_buf);
                    try out_blobs.push_fn(alloc, f_mod, fn_sym, f_key, opt_blob.code.as_slice(), meta_buf.as_slice());
                    meta_buf.destroy(alloc);
                    used_opt = true;
                }
                opt_blob.destroy(alloc);
            }
            if !used_opt {
                let outcome = try compile_function_x64(alloc, sm, eir_prog, fi, env, ct, interner, opts);
                errdefer outcome.destroy(alloc);
                if !outcome.ok || outcome.extra_fns.len() > 0_usize || outcome.blob.fn_ref_thunks.len() > 0_usize {
                    outcome.destroy(alloc);
                    out_blobs.can_inc = false;
                    return false;
                }
                var meta_buf = try col.DynBuf.[u8].init(alloc, 64_usize);
                errdefer meta_buf.destroy(alloc);
                try serialize_blob_meta(alloc, &outcome.blob, interner, &mut meta_buf);
                try out_blobs.push_fn(alloc, f_mod, fn_sym, f_key, outcome.blob.code.as_slice(), meta_buf.as_slice());
                meta_buf.destroy(alloc);
                outcome.destroy(alloc);
            }
        }
        fi = fi +% 1_u32;
    }
    return true;
}

pub linear struct IncLinkSession {
    input: elf64.ElfLinkInput;
    helper_queue: col.DynBuf[u32];
    helper_seen: col.HashMap[u32];
    all_fnref_thunks: col.DynBuf[FnRefThunkReq];
    scratch_blob: CompiledFnBlob;
    enable_icf: bool;
}

impl IncLinkSession {
    pub fn init(alloc: *mut AllocCap, opts: *CompileOptions) -> IncLinkSession ! OutOfMemory {
        var input = try elf64.ElfLinkInput.init(alloc);
        errdefer input.destroy(alloc);
        input.mode = opts.mode;
        input.emit_debug_line = false;
        let helper_queue = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer helper_queue.destroy(alloc);
        let helper_seen = try col.HashMap.[u32].init(alloc, 32_usize);
        errdefer helper_seen.destroy(alloc);
        let all_fnref_thunks = try col.DynBuf.[FnRefThunkReq].init(alloc, 4_usize);
        errdefer all_fnref_thunks.destroy(alloc);
        let scratch_blob = try CompiledFnBlob.init(alloc, 0_u32);
        errdefer scratch_blob.destroy(alloc);
        return IncLinkSession.{
            input: input,
            helper_queue: helper_queue,
            helper_seen: helper_seen,
            all_fnref_thunks: all_fnref_thunks,
            scratch_blob: scratch_blob,
            enable_icf: opts.opt.opt_level >= 2_u8 || opts.opt.opt_size,
        };
    }

    pub fn append_emi_cache(
        self: *mut Self,
        alloc: *mut AllocCap,
        cache: *emi.EmiModuleCache,
        interner: *mut span.SymInterner,
    ) -> bool ! OutOfMemory {
        let entries = cache.entries.as_slice();
        var i: usize = 0_usize;
        while i < entries.len {
            let e = entries[i];
            clear_compiled_blob(&mut self.scratch_blob, e.fn_sym);
            try self.scratch_blob.code.push_slice(alloc, cache.entry_code(&e));
            let ok = try deserialize_blob_meta(alloc, cache.entry_relocs(&e), interner, &mut self.scratch_blob);
            if !ok {
                return false;
            }
            self.scratch_blob.line_entries.clear();
            try append_blob_to_link_input(
                alloc,
                &self.scratch_blob,
                &mut self.input,
                &mut self.helper_queue,
                &mut self.helper_seen,
                &mut self.all_fnref_thunks,
            );
            i = i +% 1_usize;
        }
        return true;
    }

    pub fn finish(
        self: IncLinkSession,
        alloc: *mut AllocCap,
        start_code: *[u8],
        start_meta: *[u8],
        interner: *mut span.SymInterner,
    ) -> CompileResult ! OutOfMemory {
        let IncLinkSession.{
            input: input0,
            helper_queue: hq0,
            helper_seen: hs0,
            all_fnref_thunks: aft0,
            scratch_blob: sb0,
            enable_icf: enable_icf,
        } = self;
        var input = input0;
        errdefer input.destroy(alloc);
        var helper_queue = hq0;
        errdefer helper_queue.destroy(alloc);
        var helper_seen = hs0;
        errdefer helper_seen.destroy(alloc);
        var all_fnref_thunks = aft0;
        errdefer all_fnref_thunks.destroy(alloc);
        var scratch_blob = sb0;
        errdefer scratch_blob.destroy(alloc);

        let start_sym = try interner.intern_str(alloc, "_start");
        clear_compiled_blob(&mut scratch_blob, start_sym);
        try scratch_blob.code.push_slice(alloc, start_code);
        let sok = try deserialize_blob_meta(alloc, start_meta, interner, &mut scratch_blob);
        if !sok {
            let empty_elf = try elf64.LinkedElf.empty(alloc);
            errdefer empty_elf.destroy(alloc);
            var emsg = try str.StrBuf.init(alloc, 32_usize);
            errdefer emsg.destroy(alloc);
            try emsg.push_str_grow(alloc, "invalid cached _start metadata");
            scratch_blob.destroy(alloc);
            all_fnref_thunks.destroy(alloc);
            helper_seen.destroy(alloc);
            helper_queue.destroy(alloc);
            input.destroy(alloc);
            return CompileResult.{ ok: false, elf: empty_elf, err_msg: emsg };
        }
        scratch_blob.line_entries.clear();
        input.entry_sym = start_sym;
        try append_blob_to_link_input(
            alloc,
            &scratch_blob,
            &mut input,
            &mut helper_queue,
            &mut helper_seen,
            &mut all_fnref_thunks,
        );
        try emit_rt_helpers_and_bss(alloc, interner, .Linux, &mut helper_queue, &mut helper_seen, &mut input);
        try elf64.gc_and_icf_link_input(alloc, &mut input, interner, enable_icf);
        let link_res = try elf64.link_elf64(alloc, &input, interner);

        scratch_blob.destroy(alloc);
        all_fnref_thunks.destroy(alloc);
        helper_seen.destroy(alloc);
        helper_queue.destroy(alloc);
        input.destroy(alloc);

        let elf64.LinkResult.{ ok: lok, elf: lelf, err_msg: lerr } = link_res;
        return CompileResult.{ ok: lok, elf: lelf, err_msg: lerr };
    }

    pub fn destroy(self: IncLinkSession, alloc: *mut AllocCap) {
        let IncLinkSession.{
            input,
            helper_queue,
            helper_seen,
            all_fnref_thunks,
            scratch_blob,
            enable_icf: _,
        } = self;
        scratch_blob.destroy(alloc);
        all_fnref_thunks.destroy(alloc);
        helper_seen.destroy(alloc);
        helper_queue.destroy(alloc);
        input.destroy(alloc);
    }
}

pub fn compile_and_link_x64_with_cache(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *mut eir.EirProgram,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
    needed_libs: *[u32],
    cache: *mut emi.EmiModuleCache,
) -> CompileResult ! OutOfMemory {
    return try compile_and_link_impl(
        alloc,
        sm,
        eir_prog,
        prog,
        env,
        ct,
        interner,
        opts,
        needed_libs,
        opts.has_emi_cache,
        cache,
        null,
    );
}

pub fn compile_and_link_x64(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *mut eir.EirProgram,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *CompileOptions,
    needed_libs: *[u32],
) -> CompileResult ! OutOfMemory {
    return try compile_and_link_impl(
        alloc,
        sm,
        eir_prog,
        prog,
        env,
        ct,
        interner,
        opts,
        needed_libs,
        false,
        null,
        null,
    );
}
