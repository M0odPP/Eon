    try cg.buf.store_mem(alloc, .Rbp, tmp +% 32_i32, .Rax, 8_usize);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 48_i32, .R8, 8_usize);
    try cg.buf.jmp_label(alloc, l_cap_chk);

    cg.buf.bind_label(l_cap_ok);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 40_i32, 8_usize, false);
    try cg.buf.add_rr(alloc, .Rdi, .Rax);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 72_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp +% 80_i32, 8_usize, false);
    try cg.buf.rep_movsb(alloc);
    try cg.buf.mov_ri64(alloc, .Rax, 10_u64);
    try cg.buf.store_mem(alloc, .Rdi, 0_i32, .Rax, 1_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 40_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp +% 80_i32, 8_usize, false);
