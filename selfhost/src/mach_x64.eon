pub struct CompileOptions {
    pub mode: elf64.ElfMode;
    pub target_spec: target.TargetSpec;
    pub sanitize: bool;
    pub emit_debug_line: bool;
    pub has_emi_cache: bool;
    pub win_gui: bool;
    pub opt: eir.EirOptConfig;
    pub jobs: u32;
}

pub fn compile_options_default() -> CompileOptions {
    return CompileOptions.{
        mode: elf64.ElfMode.linux_pie(),
        target_spec: target.TargetSpec.host_default(),
        sanitize: false,
        emit_debug_line: true,
        has_emi_cache: false,
        win_gui: false,
        opt: eir.opt_config_dev(),
        jobs: 0_u32,
    };
}

pub linear struct CompileResult {
    pub ok: bool;
    pub elf: elf64.LinkedElf;
    pub err_msg: str.StrBuf;
}

impl CompileResult {
    pub fn destroy(self: CompileResult, alloc: *mut AllocCap) {
        let CompileResult.{ ok: _, elf, err_msg } = self;
        elf.destroy(alloc);
        err_msg.destroy(alloc);
    }
}

pub struct RodataItemMeta {
    pub sym_id: u32;
    pub data_off: u32;
    pub data_len: u32;
    pub align: u32;
    pub reloc_start: u32;
    pub reloc_len: u32;
}

pub struct RodataReloc {
    pub offset: u32;
    pub target_sym: u32;
    pub addend: i64;
}

pub struct FnRefThunkReq {
    pub thunk_sym: u32;
    pub target_def: u32;
}

pub linear struct CompiledFnBlob {
    pub sym_id: u32;
    pub own_stack_bytes: u64;
    pub code: col.DynBuf[u8];
    pub relocs: col.DynBuf[x64_asm.FnReloc];
    pub rodata_items: col.DynBuf[RodataItemMeta];
    pub rodata_bytes: col.DynBuf[u8];
    pub rodata_relocs: col.DynBuf[RodataReloc];
    pub used_helpers: col.DynBuf[u32];
    pub line_entries: col.DynBuf[elf64.LineEntry];
    pub debug_vars: col.DynBuf[elf64.DebugVarEntry];
    pub fn_ref_thunks: col.DynBuf[FnRefThunkReq];
}

impl CompiledFnBlob {
    pub fn init(alloc: *mut AllocCap, sym_id: u32) -> CompiledFnBlob ! OutOfMemory {
        let code = try col.DynBuf.[u8].init(alloc, 128_usize);
        errdefer code.destroy(alloc);
        let relocs = try col.DynBuf.[x64_asm.FnReloc].init(alloc, 8_usize);
        errdefer relocs.destroy(alloc);
        let rodata_items = try col.DynBuf.[RodataItemMeta].init(alloc, 4_usize);
        errdefer rodata_items.destroy(alloc);
        let rodata_bytes = try col.DynBuf.[u8].init(alloc, 32_usize);
        errdefer rodata_bytes.destroy(alloc);
        let rodata_relocs = try col.DynBuf.[RodataReloc].init(alloc, 4_usize);
        errdefer rodata_relocs.destroy(alloc);
        let used_helpers = try col.DynBuf.[u32].init(alloc, 8_usize);
        errdefer used_helpers.destroy(alloc);
        let line_entries = try col.DynBuf.[elf64.LineEntry].init(alloc, 16_usize);
        errdefer line_entries.destroy(alloc);
        let debug_vars = try col.DynBuf.[elf64.DebugVarEntry].init(alloc, 4_usize);
        errdefer debug_vars.destroy(alloc);
        let fn_ref_thunks = try col.DynBuf.[FnRefThunkReq].init(alloc, 4_usize);
        errdefer fn_ref_thunks.destroy(alloc);
        return CompiledFnBlob.{
            sym_id: sym_id,
            own_stack_bytes: 0_u64,
            code: code,
            relocs: relocs,
            rodata_items: rodata_items,
            rodata_bytes: rodata_bytes,
            rodata_relocs: rodata_relocs,
            used_helpers: used_helpers,
            line_entries: line_entries,
            debug_vars: debug_vars,
            fn_ref_thunks: fn_ref_thunks,
        };
    }

    pub fn destroy(self: CompiledFnBlob, alloc: *mut AllocCap) {
        let CompiledFnBlob.{
            sym_id: _,
            own_stack_bytes: _,
            code,
            relocs,
            rodata_items,
            rodata_bytes,
            rodata_relocs,
            used_helpers,
            line_entries,
            debug_vars,
            fn_ref_thunks,
        } = self;
        code.destroy(alloc);
        relocs.destroy(alloc);
        rodata_items.destroy(alloc);
        rodata_bytes.destroy(alloc);
        rodata_relocs.destroy(alloc);
        used_helpers.destroy(alloc);
        line_entries.destroy(alloc);
        debug_vars.destroy(alloc);
        fn_ref_thunks.destroy(alloc);
    }
}

// --- EonCall & SysV C ABI Register Tables ---

fn gp_arg_reg_abi(is_c: bool, is_win64: bool, idx: usize) -> ?x64_asm.Reg {
    if is_c && is_win64 {
        match idx {
            0_usize => { return .Rcx; }
            1_usize => { return .Rdx; }
            2_usize => { return .R8; }
            3_usize => { return .R9; }
            _ => { return null; }
        }
    }
    return gp_arg_reg(is_c, idx);
}

fn gp_arg_reg(is_c: bool, idx: usize) -> ?x64_asm.Reg {
    let limit: usize = if is_c { 6_usize } else { 8_usize };
    if idx >= limit {
        return null;
    }
    match idx {
        0_usize => { return .Rdi; }
        1_usize => { return .Rsi; }
        2_usize => { return .Rdx; }
        3_usize => { return .Rcx; }
        4_usize => { return .R8; }
        5_usize => { return .R9; }
        6_usize => { return .R10; }
        7_usize => { return .R11; }
        _ => { return null; }
    }
}

fn float_arg_reg(idx: usize) -> ?x64_asm.Xmm {
    match idx {
        0_usize => { return .Xmm0; }
        1_usize => { return .Xmm1; }
        2_usize => { return .Xmm2; }
        3_usize => { return .Xmm3; }
        4_usize => { return .Xmm4; }
        5_usize => { return .Xmm5; }
        6_usize => { return .Xmm6; }
        7_usize => { return .Xmm7; }
        _ => { return null; }
    }
}

fn linear_scan_reg(idx: usize) -> x64_asm.Reg {
    match idx {
        0_usize => { return .Rbx; }
        1_usize => { return .R12; }
        2_usize => { return .R13; }
        _ => { return .R14; }
    }
}

const LINEAR_SCAN_REG_COUNT: usize = 4_usize;

enum ArgClass : u8 {
    Zst = 0,
    IntReg = 1,
    TwoIntRegs = 2,
    FloatReg = 3,
    ByPtr = 4,
}

enum RetClassKind : u8 {
    Void = 0,
    IntReg = 1,
    TwoIntRegs = 2,
    FloatReg = 3,
    Sret = 4,
    ErrorUnion = 5,
}

struct RetClass {
    kind: RetClassKind;
    ok_ty: types.TyId;
    ok_kind: RetClassKind;
}

fn ret_class_simple(k: RetClassKind) -> RetClass {
    return RetClass.{ kind: k, ok_ty: types.TY_VOID, ok_kind: .Void };
}

fn classify_arg(ty: types.TyId, env: *types.TypeEnv) -> ArgClass {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return .Zst;
    }
    let n = env.get(ty);
    if n.kind == .Float {
        if n.u8_val == 32_u8 || n.u8_val == 64_u8 {
            return .FloatReg;
        }
        return .IntReg;
    }
    if n.kind == .Bool || n.kind == .Char || n.kind == .Int || n.kind == .Enum
        || n.kind == .ErrorSet || n.kind == .Bitfield || n.kind == .RawPtr
        || n.kind == .PhysAddr || n.kind == .VirtAddr || n.kind == .DmaAddr
    {
        if lay.size <= 8_usize {
            return .IntReg;
        }
        return .TwoIntRegs;
    }
    if n.kind == .Borrow {
        if n.borrow_kind == .Single && lay.size <= 8_usize {
            return .IntReg;
        }
        return .TwoIntRegs;
    }
    if n.kind == .Str || n.kind == .Dyn || n.kind == .FnPtr {
        return .TwoIntRegs;
    }
    if n.kind == .Builtin {
        if n.builtin_kind == .IdBrand || n.builtin_kind == .Link
            || n.builtin_kind == .FsCap || n.builtin_kind == .DirCap
            || n.builtin_kind == .NetCap || n.builtin_kind == .ClockCap
            || n.builtin_kind == .IoCap || n.builtin_kind == .BuildCap
            || n.builtin_kind == .MmioReg
        {
            return .IntReg;
        }
        if n.builtin_kind == .GenId {
            return .IntReg;
        }
    }
    if lay.size <= 8_usize {
        return .IntReg;
    }
    if lay.size <= 16_usize {
        return .TwoIntRegs;
    }
    return .ByPtr;
}

fn classify_ret_inner(ty: types.TyId, env: *types.TypeEnv) -> RetClassKind {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return .Void;
    }
    let n = env.get(ty);
    if n.kind == .Float {
        if n.u8_val == 32_u8 || n.u8_val == 64_u8 {
            return .FloatReg;
        }
        return .IntReg;
    }
    if lay.size <= 8_usize {
        return .IntReg;
    }
    if lay.size <= 16_usize {
        return .TwoIntRegs;
    }
    return .Sret;
}

fn classify_ret(ty: types.TyId, env: *types.TypeEnv) -> RetClass {
    let n = env.get(ty);
    if n.kind == .ErrorUnion {
        let ok_ty = n.primary;
        let ok_k = classify_ret_inner(ok_ty, env);
        return RetClass.{ kind: .ErrorUnion, ok_ty: ok_ty, ok_kind: ok_k };
    }
    return ret_class_simple(classify_ret_inner(ty, env));
}

fn ret_uses_sret(rc: RetClass) -> bool {
    if rc.kind == .Sret {
        return true;
    }
    if rc.kind == .ErrorUnion && rc.ok_kind == .Sret {
        return true;
    }
    return false;
}

fn x64_reloc_to_elf(k: x64_asm.RelocKindX64) -> elf64.RelocKind {
    match k {
        .Rel32 => { return .Rel32; }
        .Abs64 => { return .Abs64; }
        .GotPcRel32 => { return .GotPcRel32; }
        .Plt32 => { return .Plt32; }
        .TpOff32 => { return .TpOff32; }
    }
}

fn is_builtin_rt_helper(name: *[u8]) -> bool {
    return str.bytes_eq(name, "eon_rt_print_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_bytes".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_u64".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_i64".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_f32".as_bytes())
        || str.bytes_eq(name, "eon_rt_print_nl".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_bytes".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_nl".as_bytes())
        || str.bytes_eq(name, "eon_rt_validate_utf8".as_bytes())
        || str.bytes_eq(name, "eon_rt_is_dir".as_bytes())
        || str.bytes_eq(name, "eon_rt_mkdir_all".as_bytes())
        || str.bytes_eq(name, "eon_rt_spawn_wait".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw_uninit".as_bytes())
        || str.bytes_eq(name, "eon_free_raw".as_bytes())
        || str.bytes_eq(name, "eon_alloc_raw_san".as_bytes())
        || str.bytes_eq(name, "eon_free_raw_san".as_bytes())
        || str.bytes_eq(name, "eon_arena_alloc_aligned".as_bytes())
        || str.bytes_eq(name, "eon_rt_arena_reset_san".as_bytes())
        || str.bytes_eq(name, "eon_rt_install_san_handler".as_bytes())
        || str.bytes_eq(name, "eon_rt_tls_init".as_bytes())
        || str.bytes_eq(name, "eon_rt_parse_vdso".as_bytes())
        || str.bytes_eq(name, "eon_rt_now_ns".as_bytes())
        || str.bytes_eq(name, "eon_rt_openat2_beneath".as_bytes())
        || str.bytes_eq(name, "eon_rt_read_fd".as_bytes())
        || str.bytes_eq(name, "eon_rt_write_fd".as_bytes())
        || str.bytes_eq(name, "eon_rt_close_fd".as_bytes())
        || str.bytes_eq(name, "eon_f16_to_f32".as_bytes())
        || str.bytes_eq(name, "eon_f32_to_f16".as_bytes())
        || str.bytes_eq(name, "eon_sched_init".as_bytes())
        || str.bytes_eq(name, "eon_sched_shutdown".as_bytes())
        || str.bytes_eq(name, "eon_par_for".as_bytes())
        || str.bytes_eq(name, "eon_sched_run_dag".as_bytes())
        || str.bytes_eq(name, "eon_fiber_switch".as_bytes())
        || str.bytes_eq(name, "eon_iouring_create".as_bytes())
        || str.bytes_eq(name, "eon_iouring_destroy".as_bytes())
        || str.bytes_eq(name, "eon_run_fibers_iouring".as_bytes());
}

fn sanitize_sym_into(alloc: *mut AllocCap, bytes: *[u8], out: *mut str.StrBuf) -> !OutOfMemory {
    var i: usize = 0_usize;
    while i < bytes.len {
        let c = bytes[i];
        let ok = (c >= b'a' && c <= b'z')
            || (c >= b'A' && c <= b'Z')
            || (c >= b'0' && c <= b'9')
            || c == b'_';
        if ok {
            try out.push_byte_grow(alloc, c);
        } else {
            try out.push_byte_grow(alloc, b'_');
        }
        i = i +% 1_usize;
    }
    return;
}

pub fn stable_top_fn_sym_id(
    alloc: *mut AllocCap,
    mod_name: *[u8],
    fn_name: *[u8],
    interner: *mut span.SymInterner,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 48_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, "eon_fn_");
    try sb.push_u64_grow(alloc, mod_name.len.widen.[u64]());
    try sb.push_byte_grow(alloc, b'_');
    try sanitize_sym_into(alloc, mod_name, &mut sb);
    try sb.push_str_grow(alloc, "__");
    try sanitize_sym_into(alloc, fn_name, &mut sb);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

pub fn stable_impl_fn_sym_id(
    alloc: *mut AllocCap,
    mod_name: *[u8],
    impl_decl_idx: u32,
    sub_idx: u32,
    fn_name: *[u8],
    interner: *mut span.SymInterner,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 48_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, "eon_m_");
    try sb.push_u64_grow(alloc, mod_name.len.widen.[u64]());
    try sb.push_byte_grow(alloc, b'_');
    try sanitize_sym_into(alloc, mod_name, &mut sb);
    try sb.push_str_grow(alloc, "__");
    try sb.push_u64_grow(alloc, impl_decl_idx.widen.[u64]());
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, sub_idx.widen.[u64]());
    try sb.push_byte_grow(alloc, b'_');
    try sanitize_sym_into(alloc, fn_name, &mut sb);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn fn_sym_name_id(
    alloc: *mut AllocCap,
    key: cfg_ir.CfgFnKey,
    eir_prog: *eir.EirProgram,
    interner: *mut span.SymInterner,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 48_usize);
    errdefer sb.destroy(alloc);
    if let fid = eir_prog.find_fn_by_key(key) {
        if let f = eir_prog.get_fn(fid) {
            if f.sig.effects.is_export_c {
                let raw_name = interner.get(f.name);
                try sb.push_bytes_grow(alloc, raw_name);
                let sid = try interner.intern(alloc, sb.as_bytes());
                sb.destroy(alloc);
                return sid;
            }
            match key.kind {
                .TopDef => {
                    try sb.push_str_grow(alloc, "eon_fn_");
                    if f.mod_name != span.SYM_EMPTY {
                        let mb = interner.get(f.mod_name);
                        try sb.push_u64_grow(alloc, mb.len.widen.[u64]());
                        try sb.push_byte_grow(alloc, b'_');
                        try sanitize_sym_into(alloc, mb, &mut sb);
                        try sb.push_str_grow(alloc, "__");
                    } else {
                        try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                        try sb.push_byte_grow(alloc, b'_');
                    }
                    try sanitize_sym_into(alloc, interner.get(f.name), &mut sb);
                }
                .ImplMethod => {
                    try sb.push_str_grow(alloc, "eon_m_");
                    if f.mod_name != span.SYM_EMPTY {
                        let mb = interner.get(f.mod_name);
                        try sb.push_u64_grow(alloc, mb.len.widen.[u64]());
                        try sb.push_byte_grow(alloc, b'_');
                        try sanitize_sym_into(alloc, mb, &mut sb);
                        try sb.push_str_grow(alloc, "__");
                        try sb.push_u64_grow(alloc, f.impl_decl_idx.widen.[u64]());
                    } else {
                        try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                    }
                    try sb.push_byte_grow(alloc, b'_');
                    try sb.push_u64_grow(alloc, key.b.widen.[u64]());
                    try sb.push_byte_grow(alloc, b'_');
                    try sanitize_sym_into(alloc, interner.get(f.name), &mut sb);
                }
                .GenericInst => {
                    try sb.push_str_grow(alloc, "eon_g_");
                    try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                    try sb.push_byte_grow(alloc, b'_');
                    try sanitize_sym_into(alloc, interner.get(f.name), &mut sb);
                }
                .Closure => {
                    try sb.push_str_grow(alloc, "eon_c_");
                    try sb.push_u64_grow(alloc, key.a.widen.[u64]());
                }
            }
            let sid = try interner.intern(alloc, sb.as_bytes());
            sb.destroy(alloc);
            return sid;
        }
    }
    match key.kind {
        .TopDef => {
            try sb.push_str_grow(alloc, "eon_fn_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
        }
        .ImplMethod => {
            try sb.push_str_grow(alloc, "eon_m_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
            try sb.push_byte_grow(alloc, b'_');
            try sb.push_u64_grow(alloc, key.b.widen.[u64]());
        }
        .GenericInst => {
            try sb.push_str_grow(alloc, "eon_g_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
        }
        .Closure => {
            try sb.push_str_grow(alloc, "eon_c_");
            try sb.push_u64_grow(alloc, key.a.widen.[u64]());
        }
    }
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn intern_sym_u64(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    prefix: *str,
    a: u64,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 40_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, prefix);
    try sb.push_u64_grow(alloc, a);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn intern_sym_u64_2(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    prefix: *str,
    a: u64,
    b: u64,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 48_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, prefix);
    try sb.push_u64_grow(alloc, a);
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, b);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn intern_sym_u64_3(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    prefix: *str,
    a: u64,
    b: u64,
    c: u64,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 56_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, prefix);
    try sb.push_u64_grow(alloc, a);
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, b);
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, c);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn intern_rodata_sym(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    fn_sym_id: u32,
    idx: u64,
) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 64_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, ".Lro_");
    try sb.push_bytes_grow(alloc, interner.get(fn_sym_id));
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, idx);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

// --- Float Literal Parsing & IEEE 754 Conversions (f64 / f32 / f16) ---

fn parse_f64_lit(src: *[u8]) -> f64 {
    var end = src.len;
    if end >= 4_usize {
        let a = src[end - 4_usize];
        let b = src[end - 3_usize];
        let c = src[end - 2_usize];
        let d = src[end - 1_usize];
        if a == b'_' && b == b'f'
            && ((c == b'1' && d == b'6') || (c == b'3' && d == b'2') || (c == b'6' && d == b'4'))
        {
            end = end - 4_usize;
        }
    } else if end >= 3_usize {
        let b = src[end - 3_usize];
        let c = src[end - 2_usize];
        let d = src[end - 1_usize];
        if b == b'f'
            && ((c == b'1' && d == b'6') || (c == b'3' && d == b'2') || (c == b'6' && d == b'4'))
        {
            end = end - 3_usize;
        }
    }
    var i: usize = 0_usize;
    var neg = false;
    if i < end && src[i] == b'-' {
        neg = true;
        i = i +% 1_usize;
    } else if i < end && src[i] == b'+' {
        i = i +% 1_usize;
    }
    var int_part: f64 = 0.0_f64;
    while i < end {
        let ch = src[i];
        if ch == b'_' {
            i = i +% 1_usize;
            continue;
        }
        if ch >= b'0' && ch <= b'9' {
            int_part = int_part * 10.0_f64 + (ch - b'0').widen.[u64]().to_float.[f64]();
            i = i +% 1_usize;
        } else {
            break;
        }
    }
    var frac_part: f64 = 0.0_f64;
    var frac_div: f64 = 1.0_f64;
    if i < end && src[i] == b'.' {
        i = i +% 1_usize;
        while i < end {
            let ch = src[i];
            if ch == b'_' {
                i = i +% 1_usize;
                continue;
            }
            if ch >= b'0' && ch <= b'9' {
                frac_part = frac_part * 10.0_f64 + (ch - b'0').widen.[u64]().to_float.[f64]();
                frac_div = frac_div * 10.0_f64;
                i = i +% 1_usize;
            } else {
                break;
            }
        }
    }
    var val: f64 = int_part + (frac_part / frac_div);
    if i < end && (src[i] == b'e' || src[i] == b'E') {
        i = i +% 1_usize;
        var exp_neg = false;
        if i < end && src[i] == b'-' {
            exp_neg = true;
            i = i +% 1_usize;
        } else if i < end && src[i] == b'+' {
            i = i +% 1_usize;
        }
        var exp_acc: i32 = 0_i32;
        while i < end {
            let ch = src[i];
            if ch == b'_' {
                i = i +% 1_usize;
                continue;
            }
            if ch >= b'0' && ch <= b'9' {
                if exp_acc < 1000_i32 {
                    exp_acc = exp_acc *% 10_i32 +% (ch - b'0').widen.[i32]();
                }
                i = i +% 1_usize;
            } else {
                break;
            }
        }
        var pow10: f64 = 1.0_f64;
        var base: f64 = 10.0_f64;
        var e: i32 = exp_acc;
        while e > 0_i32 {
            if (e & 1_i32) != 0_i32 {
                pow10 = pow10 * base;
            }
            base = base * base;
            e = e >> 1_i32;
        }
        if exp_neg {
            val = val / pow10;
        } else {
            val = val * pow10;
        }
    }
    if neg {
        val = -val;
    }
    return val;
}

fn f32_bits_to_f16_bits(bits: u32) -> u16 {
    let sign = ((bits >> 16_u32) & 0x8000_u32).trunc.[u16]();
    let exp = ((bits >> 23_u32) & 0xFF_u32).bitcast.[i32]() -% 127_i32;
    let frac = bits & 0x007FFFFF_u32;
    if exp == 128_i32 {
        if frac != 0_u32 {
            return sign | 0x7E00_u16 | ((frac >> 13_u32).trunc.[u16]() & 0x03FF_u16);
        }
        return sign | 0x7C00_u16;
    }
    if exp > 15_i32 {
        return sign | 0x7C00_u16;
    }
    if exp < -14_i32 {
        if exp < -24_i32 {
            return sign;
        }
        let m = frac | 0x00800000_u32;
        let shift = (14_i32 -% exp +% 13_i32).bitcast.[u32]();
        if shift >= 32_u32 {
            return sign;
        }
        return sign | (m >> shift).trunc.[u16]();
    }
    let hexp = ((exp +% 15_i32).bitcast.[u32]() & 0x1F_u32) <<% 10_u32;
    return sign | hexp.trunc.[u16]() | (frac >> 13_u32).trunc.[u16]();
}

// ===========================================================================
// Section 2: EIR Liveness, Linear Scan Regalloc & Stack Frame Plan
// ===========================================================================

enum ValLocKind : u8 {
    Reg = 0,
    Stack = 1,
}

struct ValLoc {
    kind: ValLocKind;
    reg: x64_asm.Reg;
    stack_off: i32;
}

fn val_loc_reg(r: x64_asm.Reg) -> ValLoc {
    return ValLoc.{ kind: .Reg, reg: r, stack_off: 0_i32 };
}

fn val_loc_stack(off: i32) -> ValLoc {
    return ValLoc.{ kind: .Stack, reg: .Rax, stack_off: off };
}

fn eir_inst_collect_uses(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    inst: *eir.EirInst,
    out: *mut col.DynBuf[eir.EirValue],
) -> !OutOfMemory {
    match inst.kind {
        .Copy => { try out.push(alloc, inst.v0); }
        .StoreSlot => { try out.push(alloc, inst.v0); }
        .LoadPlace => { try collect_place_uses(alloc, eir_prog, inst.aux0, out); }
        .StorePlace => {
            try collect_place_uses(alloc, eir_prog, inst.aux0, out);
            try out.push(alloc, inst.v0);
        }
        .PlaceAddr => { try collect_place_uses(alloc, eir_prog, inst.aux0, out); }
        .PoolColumnLoad => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Val {
                    try out.push(alloc, op.pool_base.id);
                }
                try out.push(alloc, op.index);
            }
        }
        .PoolColumnStore => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Val {
                    try out.push(alloc, op.pool_base.id);
                }
                try out.push(alloc, op.index);
            }
            try out.push(alloc, inst.v0);
        }
        .Unary => { try out.push(alloc, inst.v0); }
        .Binary => {
            try out.push(alloc, inst.v0);
            try out.push(alloc, inst.v1);
        }
        .Cast => { try out.push(alloc, inst.v0); }
        .Slice => {
            try out.push(alloc, inst.v0);
            if inst.v1 != eir.EIR_NONE { try out.push(alloc, inst.v1); }
            if inst.v2 != eir.EIR_NONE { try out.push(alloc, inst.v2); }
        }
        .VecLoad => {
            try out.push(alloc, inst.v0);
            try out.push(alloc, inst.v1);
        }
        .VecStore => {
            try out.push(alloc, inst.v0);
            try out.push(alloc, inst.v1);
            try out.push(alloc, inst.v2);
        }
        .VecFma => {
            try out.push(alloc, inst.v0);
            try out.push(alloc, inst.v1);
            try out.push(alloc, inst.v2);
        }
        .Aggregate => {
            let elems = eir_prog.vals_slice(inst.range);
            var i: usize = 0_usize;
            while i < elems.len {
                try out.push(alloc, elems[i]);
                i = i +% 1_usize;
            }
        }
        .UnwrapOptional => { try out.push(alloc, inst.v0); }
        .UnwrapErrorOk => { try out.push(alloc, inst.v0); }
        .UnwrapErrorErr => { try out.push(alloc, inst.v0); }
        .IsNonNull => { try out.push(alloc, inst.v0); }
        .IsError => { try out.push(alloc, inst.v0); }
        .MatchTag => { try out.push(alloc, inst.v0); }
        .FieldExtract => { try out.push(alloc, inst.v0); }
        .MakeDyn => { try out.push(alloc, inst.v0); }
        .MakeClosure => {
            if inst.v0 != eir.EIR_NONE { try out.push(alloc, inst.v0); }
        }
        .Call => {
            if let cd = eir_prog.get_call(inst.aux0) {
                if cd.callee.kind == .FnPtr {
                    try out.push(alloc, cd.callee.a);
                }
                let args = eir_prog.vals_slice(cd.args);
                var i: usize = 0_usize;
                while i < args.len {
                    try out.push(alloc, args[i]);
                    i = i +% 1_usize;
                }
            }
        }
        .BuiltinCall => {
            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                let args = eir_prog.vals_slice(bc.args);
                var i: usize = 0_usize;
                while i < args.len {
                    try out.push(alloc, args[i]);
                    i = i +% 1_usize;
                }
            }
        }
        .InlineAsm => {
            if let ad = eir_prog.get_asm(inst.aux0) {
                let ins = eir_prog.asm_inputs_slice(ad.inputs);
                var i: usize = 0_usize;
                while i < ins.len {
                    try out.push(alloc, ins[i].val);
                    i = i +% 1_usize;
                }
            }
        }
        _ => {}
    }
    return;
}

fn collect_place_uses(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    place_id: u32,
    out: *mut col.DynBuf[eir.EirValue],
) -> !OutOfMemory {
    if let p = eir_prog.get_place(place_id) {
        if p.base.kind == .Val {
            try out.push(alloc, p.base.id);
        }
        let projs = eir_prog.projs_slice(p.projs);
        var i: usize = 0_usize;
        while i < projs.len {
            if projs[i].kind == .Index {
                try out.push(alloc, projs[i].index);
            }
            i = i +% 1_usize;
        }
    }
    return;
}

fn eir_term_use(term: *eir.EirTerm) -> eir.EirValue {
    match term.kind {
        .Branch => { return term.val; }
        .SwitchInt => { return term.val; }
        .Return => {
            if term.flag {
                return term.val;
            }
            return eir.EIR_NONE;
        }
        _ => { return eir.EIR_NONE; }
    }
}

fn is_scalar_reg_candidate(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize || lay.size > 8_usize {
        return false;
    }
    let n = env.get(ty);
    match n.kind {
        .Bool => { return true; }
        .Char => { return true; }
        .Int => { return true; }
        .Enum => { return true; }
        .ErrorSet => { return true; }
        .Bitfield => { return true; }
        .RawPtr => { return true; }
        .PhysAddr => { return true; }
        .VirtAddr => { return true; }
        .DmaAddr => { return true; }
        .Borrow => { return n.borrow_kind == .Single; }
        .Builtin => {
            return n.builtin_kind == .IdBrand
                || n.builtin_kind == .GenId
                || n.builtin_kind == .Link;
        }
        _ => { return false; }
    }
}

struct LiveInterval {
    val: u32;
    start: u32;
    end: u32;
}

struct ActiveInterval {
    end: u32;
    reg_idx: usize;
}

struct ActiveSpill {
    end: u32;
    off: i32;
}

fn try_extract_const_imm32(
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    const_id: u32,
    ty: types.TyId,
) -> ?i32 {
    if !env.is_concrete_integer(ty) {
        return null;
    }
    let c = eir_prog.get_const(const_id) orelse {
        return null;
    };
    if c.kind != .Int || c.int_val.hi != 0_i64 || c.int_val.lo > 0x7FFFFFFF_u64 {
        return null;
    }
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize || lay.size > 8_usize {
        return null;
    }
    if env.is_signed_int(ty) && lay.size < 8_usize {
        let bits = env.int_bits(ty);
        if bits > 1_u8 && bits < 64_u8 {
            let max_pos = (1_u64 <<% (bits -% 1_u8).widen.[u64]()) -% 1_u64;
            if c.int_val.lo > max_pos {
                return null;
            }
        }
    }
    return c.int_val.lo.trunc.[i32]();
}

fn o0_binop_folds_rhs_imm32(op: ast.BinaryOp, imm: i32) -> bool {
    match op {
        .Add => { return true; }
        .AddWrap => { return true; }
        .Sub => { return true; }
        .SubWrap => { return true; }
        .BitAnd => { return true; }
        .BitOr => { return true; }
        .BitXor => { return true; }
        .Eq => { return true; }
        .NotEq => { return true; }
        .Lt => { return true; }
        .LtEq => { return true; }
        .Gt => { return true; }
        .GtEq => { return true; }
        .Shl => { return imm >= 0_i32 && imm < 64_i32; }
        .ShlWrap => { return imm >= 0_i32 && imm < 64_i32; }
        .Shr => { return imm >= 0_i32 && imm < 64_i32; }
        _ => { return false; }
    }
}

fn o0_is_fusible_cmp(
    env: *types.TypeEnv,
    ins: *eir.EirInst,
    term: *eir.EirTerm,
) -> bool {
    if term.kind != .Branch || ins.kind != .Binary || ins.dst == eir.EIR_NONE || ins.dst != term.val {
        return false;
    }
    let is_cmp = ins.bin_op == .Eq
        || ins.bin_op == .NotEq
        || ins.bin_op == .Lt
        || ins.bin_op == .LtEq
        || ins.bin_op == .Gt
        || ins.bin_op == .GtEq;
    if !is_cmp {
        return false;
    }
    let op_node = env.get(ins.ty1);
    if op_node.kind == .Float || op_node.kind == .Vec {
        return false;
    }
    let lay = env.x64_layout(ins.ty1);
    return lay.size > 0_usize && lay.size <= 8_usize;
}

fn sort_intervals(iv: *mut [LiveInterval]) {
    let n = iv.len;
    if n <= 1_usize {
        return;
    }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third {
        gap = (gap *% 3_usize) +% 1_usize;
    }
    while gap > 0_usize {
        var i = gap;
        while i < n {
            let cur = iv[i];
            var j = i;
            while j >= gap && j < n {
                let prev = j - gap;
                let p = iv[prev];
                if p.start < cur.start || (p.start == cur.start && p.val <= cur.val) {
                    break;
                }
                iv[j] = p;
                j = prev;
            }
            iv[j] = cur;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

linear struct FnFramePlan {
    has_sret: bool;
    sret_off: i32;
    temp_copy_off: i32;
    slot_offs: col.DynBuf[i32];
    val_locs: col.DynBuf[ValLoc];
    saved_regs: col.DynBuf[x64_asm.Reg];
    live_vals: col.BitSet;
    imm32_mask: col.BitSet;
    imm32_vals: col.DynBuf[i32];
    val_use_cnt: col.DynBuf[u32];
    live_active: bool;
    frame_size: i32;
    save_simd: bool;
}

impl FnFramePlan {
    fn val_is_live(self: *Self, v: u32) -> bool {
        if !self.live_active {
            return true;
        }
        return self.live_vals.test(v.widen.[usize]());
    }

    fn val_imm32(self: *Self, v: u32) -> ?i32 {
        let vu = v.widen.[usize]();
        if !self.live_active || !self.imm32_mask.test(vu) {
            return null;
        }
        let s = self.imm32_vals.as_slice();
        if vu < s.len {
            return s[vu];
        }
        return null;
    }

    fn val_uses(self: *Self, v: u32) -> u32 {
        let vu = v.widen.[usize]();
        let s = self.val_use_cnt.as_slice();
        if vu < s.len {
            return s[vu];
        }
        return 0_u32;
    }

    fn destroy(self: FnFramePlan, alloc: *mut AllocCap) {
        let FnFramePlan.{
            has_sret: _,
            sret_off: _,
            temp_copy_off: _,
            slot_offs,
            val_locs,
            saved_regs,
            live_vals,
            imm32_mask,
            imm32_vals,
            val_use_cnt,
            live_active: _,
            frame_size: _,
            save_simd: _,
        } = self;
        slot_offs.destroy(alloc);
        val_locs.destroy(alloc);
        saved_regs.destroy(alloc);
        live_vals.destroy(alloc);
        imm32_mask.destroy(alloc);
        imm32_vals.destroy(alloc);
        val_use_cnt.destroy(alloc);
    }
}

fn compute_o0_liveness(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    nvals: usize,
    nslots: usize,
    live_vals: *mut col.BitSet,
    used_slots: *mut col.BitSet,
    imm32_mask: *mut col.BitSet,
    imm32_vals: *mut col.DynBuf[i32],
    val_use_cnt: *mut col.DynBuf[u32],
) -> !OutOfMemory {
    // 0 = none/root, 1 = phi, 2 = Copy, 3 = LoadSlot/SlotAddr, 4 = Const
    var def_kind = try col.DynBuf.[u8].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer def_kind.destroy(alloc);
    var def_blk = try col.DynBuf.[u32].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer def_blk.destroy(alloc);
    var def_idx = try col.DynBuf.[u32].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer def_idx.destroy(alloc);
    var vi0: usize = 0_usize;
    while vi0 < nvals {
        try def_kind.push(alloc, 0_u8);
        try def_blk.push(alloc, 0_u32);
        try def_idx.push(alloc, 0_u32);
        try imm32_vals.push(alloc, 0_i32);
        try val_use_cnt.push(alloc, 0_u32);
        vi0 = vi0 +% 1_usize;
    }

    // Pre-scan scalar imm32 integer Consts so Binary RHS uses can fold directly without emitting the Const.
    let blks = eir_prog.fn_blocks(fn_id);
    var bi_c: usize = 0_usize;
    while bi_c < blks.len {
        let insts = eir_prog.insts_slice(blks[bi_c].insts);
        var ii_c: usize = 0_usize;
        while ii_c < insts.len {
            let ins = insts[ii_c];
            if ins.kind == .Const && ins.dst != eir.EIR_NONE {
                if let imm = try_extract_const_imm32(eir_prog, env, ins.aux0, ins.ty0) {
                    let dv = ins.dst.widen.[usize]();
                    if dv < nvals {
                        imm32_mask.set(dv);
                        let ivs = imm32_vals.as_mut_slice();
                        if dv < ivs.len {
                            ivs[dv] = imm;
                        }
                    }
                }
            }
            ii_c = ii_c +% 1_usize;
        }
        bi_c = bi_c +% 1_usize;
    }

    var work = try col.DynBuf.[u32].init(alloc, 32_usize);
    errdefer work.destroy(alloc);
    var uses = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
    errdefer uses.destroy(alloc);

    // Function parameters always keep their slots/locations for cg_receive_params.
    let params = eir_prog.fn_params(fn_id);
    var pi0: usize = 0_usize;
    while pi0 < params.len {
        let pv = params[pi0].widen.[usize]();
        if pv < nvals && !live_vals.test(pv) {
            live_vals.set(pv);
            try work.push(alloc, params[pi0]);
        }
        pi0 = pi0 +% 1_usize;
    }

    var bi: usize = 0_usize;
    while bi < blks.len {
        let blk = blks[bi];
        let b_u32 = bi.trunc.[u32]();
        let phis = eir_prog.phis_slice(blk.phis);
        var pi: usize = 0_usize;
        while pi < phis.len {
            let dv = phis[pi].dst.widen.[usize]();
            let dks = def_kind.as_mut_slice();
            if dv < dks.len { dks[dv] = 1_u8; }
            let dbs = def_blk.as_mut_slice();
            if dv < dbs.len { dbs[dv] = b_u32; }
            let dis = def_idx.as_mut_slice();
            if dv < dis.len { dis[dv] = pi.trunc.[u32](); }
            pi = pi +% 1_usize;
        }
        let insts = eir_prog.insts_slice(blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let ins = insts[ii];
            let d = eir.inst_def(&ins);
            let is_pure_skippable = d != eir.EIR_NONE
                && (ins.kind == .Const || ins.kind == .Copy || ins.kind == .LoadSlot || ins.kind == .SlotAddr);
            if is_pure_skippable {
                let dv = d.widen.[usize]();
                let kind_code: u8 = if ins.kind == .Copy {
                    2_u8
                } else if ins.kind == .Const {
                    4_u8
                } else {
                    3_u8
                };
                let dks = def_kind.as_mut_slice();
                if dv < dks.len { dks[dv] = kind_code; }
                let dbs = def_blk.as_mut_slice();
                if dv < dbs.len { dbs[dv] = b_u32; }
                let dis = def_idx.as_mut_slice();
                if dv < dis.len { dis[dv] = ii.trunc.[u32](); }
            } else {
                // Non-skippable root: mark dst & all non-folded operand uses live, plus referenced stack slots.
                if d != eir.EIR_NONE {
                    let dv = d.widen.[usize]();
                    if dv < nvals && !live_vals.test(dv) {
                        live_vals.set(dv);
                        try work.push(alloc, d);
                    }
                }
                if ins.kind == .StoreSlot {
                    let su = ins.aux0.widen.[usize]();
                    if su < nslots { used_slots.set(su); }
                } else if ins.kind == .LoadPlace || ins.kind == .StorePlace || ins.kind == .PlaceAddr {
                    if let p = eir_prog.get_place(ins.aux0) {
                        if p.base.kind == .Slot {
                            let su = p.base.id.widen.[usize]();
                            if su < nslots { used_slots.set(su); }
                        }
                    }
                }
                var skip_v1 = false;
                if ins.kind == .Binary && ins.v1 != ins.v0 && env.is_concrete_integer(ins.ty1) {
                    let v1u = ins.v1.widen.[usize]();
                    if v1u < nvals && imm32_mask.test(v1u) {
                        let ivs_ro = imm32_vals.as_slice();
                        if v1u < ivs_ro.len && o0_binop_folds_rhs_imm32(ins.bin_op, ivs_ro[v1u]) {
                            skip_v1 = true;
                        }
                    }
                }
                uses.clear();
                try eir_inst_collect_uses(alloc, eir_prog, &ins, &mut uses);
                let us = uses.as_slice();
                var ui: usize = 0_usize;
                while ui < us.len {
                    if !(skip_v1 && ui == 1_usize && us[ui] == ins.v1) {
                        let uv = us[ui].widen.[usize]();
                        if uv < nvals && !live_vals.test(uv) {
                            live_vals.set(uv);
                            try work.push(alloc, us[ui]);
                        }
                    }
                    ui = ui +% 1_usize;
                }
            }
            ii = ii +% 1_usize;
        }
        let tu = eir_term_use(&blk.term);
        if tu != eir.EIR_NONE {
            let tv = tu.widen.[usize]();
            if tv < nvals && !live_vals.test(tv) {
                live_vals.set(tv);
                try work.push(alloc, tu);
            }
        }
        bi = bi +% 1_usize;
    }

    // Propagate liveness backward through live Phis, Copies, LoadSlots, and SlotAddrs.
    while !work.is_empty() {
        let v = work.pop() orelse { break; };
        let vu = v.widen.[usize]();
        let dks = def_kind.as_slice();
        let dbs = def_blk.as_slice();
        let dis = def_idx.as_slice();
        if vu >= dks.len || vu >= dbs.len || vu >= dis.len {
            continue;
        }
        let dk = dks[vu];
        if dk == 1_u8 {
            let bidx = dbs[vu].widen.[usize]();
            let pidx = dis[vu].widen.[usize]();
            if bidx < blks.len {
                let phis = eir_prog.phis_slice(blks[bidx].phis);
                if pidx < phis.len {
                    let inc = eir_prog.phi_incoming(phis[pidx].incoming);
                    var ji: usize = 0_usize;
                    while ji < inc.len {
                        let inc_val = inc[ji].val;
                        let iv = inc_val.widen.[usize]();
                        if iv < nvals && !live_vals.test(iv) {
                            live_vals.set(iv);
                            try work.push(alloc, inc_val);
                        }
                        ji = ji +% 1_usize;
                    }
                }
            }
        } else if dk == 2_u8 {
            let bidx = dbs[vu].widen.[usize]();
            let iidx = dis[vu].widen.[usize]();
            if bidx < blks.len {
                let insts = eir_prog.insts_slice(blks[bidx].insts);
                if iidx < insts.len {
                    let src = insts[iidx].v0;
                    if src != eir.EIR_NONE {
                        let sv = src.widen.[usize]();
                        if sv < nvals && !live_vals.test(sv) {
                            live_vals.set(sv);
                            try work.push(alloc, src);
                        }
                    }
                }
            }
        } else if dk == 3_u8 {
            let bidx = dbs[vu].widen.[usize]();
            let iidx = dis[vu].widen.[usize]();
            if bidx < blks.len {
                let insts = eir_prog.insts_slice(blks[bidx].insts);
                if iidx < insts.len {
                    let su = insts[iidx].aux0.widen.[usize]();
                    if su < nslots {
                        used_slots.set(su);
                    }
                }
            }
        }
    }

    // Count live uses of every SSA value (used for single-use Cmp+Branch fusion).
    bi = 0_usize;
    while bi < blks.len {
        let blk = blks[bi];
        let phis = eir_prog.phis_slice(blk.phis);
        var pi: usize = 0_usize;
        while pi < phis.len {
            if live_vals.test(phis[pi].dst.widen.[usize]()) {
                let inc = eir_prog.phi_incoming(phis[pi].incoming);
                var ji: usize = 0_usize;
                while ji < inc.len {
                    let iv = inc[ji].val.widen.[usize]();
                    let ucs = val_use_cnt.as_mut_slice();
                    if iv < ucs.len { ucs[iv] = ucs[iv] +% 1_u32; }
                    ji = ji +% 1_usize;
                }
            }
            pi = pi +% 1_usize;
        }
        let insts = eir_prog.insts_slice(blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let ins = insts[ii];
            let d = eir.inst_def(&ins);
            if d != eir.EIR_NONE
                && !live_vals.test(d.widen.[usize]())
                && (ins.kind == .Const || ins.kind == .Copy || ins.kind == .LoadSlot || ins.kind == .SlotAddr)
            {
                ii = ii +% 1_usize;
                continue;
            }
            uses.clear();
            try eir_inst_collect_uses(alloc, eir_prog, &ins, &mut uses);
            let us = uses.as_slice();
            var ui: usize = 0_usize;
            while ui < us.len {
                let uv = us[ui].widen.[usize]();
                let ucs = val_use_cnt.as_mut_slice();
                if uv < ucs.len { ucs[uv] = ucs[uv] +% 1_u32; }
                ui = ui +% 1_usize;
            }
            ii = ii +% 1_usize;
        }
        let tu = eir_term_use(&blk.term);
        if tu != eir.EIR_NONE {
            let tv = tu.widen.[usize]();
            let ucs = val_use_cnt.as_mut_slice();
            if tv < ucs.len { ucs[tv] = ucs[tv] +% 1_u32; }
        }
        bi = bi +% 1_usize;
    }

    uses.destroy(alloc);
    work.destroy(alloc);
    def_idx.destroy(alloc);
    def_blk.destroy(alloc);
    def_kind.destroy(alloc);
    return;
}

fn record_live_point(
    v: u32,
    pt: u32,
    def_pt: *mut [u32],
    last_use: *mut [u32],
) {
    let idx = v.widen.[usize]();
    if idx < def_pt.len && idx < last_use.len {
        if def_pt[idx] == eir.EIR_NONE || pt < def_pt[idx] {
            def_pt[idx] = pt;
        }
        if last_use[idx] == eir.EIR_NONE || pt > last_use[idx] {
            last_use[idx] = pt;
        }
    }
}

fn extend_loop_intervals(dp: *[u32], lu: *mut [u32], loop_lo: u32, loop_hi: u32) -> bool {
    var changed = false;
    var k: usize = 0_usize;
    while k < dp.len && k < lu.len {
        if dp[k] != eir.EIR_NONE && dp[k] <= loop_lo && lu[k] >= loop_lo && lu[k] < loop_hi {
            lu[k] = loop_hi;
            changed = true;
        }
        k = k +% 1_usize;
    }
    return changed;
}

fn extend_back_edges_and_phis(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    live_active: bool,
    live_vals: *col.BitSet,
    bs_s: *[u32],
    be_s: *[u32],
    def_pt: *mut col.DynBuf[u32],
    last_use: *mut col.DynBuf[u32],
) {
    let blks = eir_prog.fn_blocks(fn_id);
    // Record live phi incoming points first so loop back-edges extend them accurately too.
    var bki: usize = 0_usize;
    while bki < blks.len {
        let phis = eir_prog.phis_slice(blks[bki].phis);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len {
            if !live_active || live_vals.test(phis[phi_i].dst.widen.[usize]()) {
                let inc = eir_prog.phi_incoming(phis[phi_i].incoming);
                var inc_i: usize = 0_usize;
                while inc_i < inc.len {
                    let pbb = inc[inc_i].pred_bb.widen.[usize]();
                    if pbb < be_s.len {
                        record_live_point(inc[inc_i].val, be_s[pbb], def_pt.as_mut_slice(), last_use.as_mut_slice());
                    }
                    inc_i = inc_i +% 1_usize;
                }
            }
            phi_i = phi_i +% 1_usize;
        }
        bki = bki +% 1_usize;
    }

    var iter: usize = 0_usize;
    while iter < 4_usize {
        var any_ch = false;
        bki = 0_usize;
        while bki < blks.len {
            let blk = blks[bki];
            let succ_cnt = eir_prog.term_successor_count(&blk.term);
            var si: usize = 0_usize;
            while si < succ_cnt {
                let sbb = eir_prog.term_successor_at(&blk.term, si).widen.[usize]();
                if sbb < bs_s.len && bki < be_s.len {
                    let loop_lo = bs_s[sbb];
                    let loop_hi = be_s[bki];
                    if loop_lo <= loop_hi {
                        if extend_loop_intervals(def_pt.as_slice(), last_use.as_mut_slice(), loop_lo, loop_hi) {
                            any_ch = true;
                        }
                    }
                }
                si = si +% 1_usize;
            }
            bki = bki +% 1_usize;
        }
        if !any_ch {
            break;
        }
        iter = iter +% 1_usize;
    }
}

fn compute_val_intervals(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    live_active: bool,
    live_vals: *col.BitSet,
    out_ivs: *mut col.DynBuf[LiveInterval],
) -> !OutOfMemory {
    let val_tys = eir_prog.fn_value_tys(fn_id);
    let nvals = val_tys.len;
    var def_pt = try col.DynBuf.[u32].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer def_pt.destroy(alloc);
    var last_use = try col.DynBuf.[u32].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer last_use.destroy(alloc);
    var addr_taken = try col.DynBuf.[u8].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer addr_taken.destroy(alloc);
    var vi: usize = 0_usize;
    while vi < nvals {
        try def_pt.push(alloc, eir.EIR_NONE);
        try last_use.push(alloc, eir.EIR_NONE);
        try addr_taken.push(alloc, 0_u8);
        vi = vi +% 1_usize;
    }

    let params = eir_prog.fn_params(fn_id);
    var pi: usize = 0_usize;
    while pi < params.len {
        record_live_point(params[pi], 0_u32, def_pt.as_mut_slice(), last_use.as_mut_slice());
        pi = pi +% 1_usize;
    }

    var uses = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
    errdefer uses.destroy(alloc);
    let rpo = eir_prog.fn_rpo(fn_id);
    let blks = eir_prog.fn_blocks(fn_id);
    let nblks = blks.len;
    var blk_start = try col.DynBuf.[u32].init(alloc, if nblks > 4_usize { nblks } else { 4_usize });
    errdefer blk_start.destroy(alloc);
    var blk_end = try col.DynBuf.[u32].init(alloc, if nblks > 4_usize { nblks } else { 4_usize });
    errdefer blk_end.destroy(alloc);
    var bi0: usize = 0_usize;
    while bi0 < nblks {
        try blk_start.push(alloc, 0_u32);
        try blk_end.push(alloc, 0_u32);
        bi0 = bi0 +% 1_usize;
    }

    var pt: u32 = 1_u32;
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bbid = rpo[ri];
        let bidx = bbid.widen.[usize]();
        if bidx < blks.len {
            let bs = blk_start.as_mut_slice();
            if bidx < bs.len { bs[bidx] = pt; }
            let blk = blks[bidx];
            let phis = eir_prog.phis_slice(blk.phis);
            var phi_i: usize = 0_usize;
            while phi_i < phis.len {
                if !live_active || live_vals.test(phis[phi_i].dst.widen.[usize]()) {
                    record_live_point(phis[phi_i].dst, pt, def_pt.as_mut_slice(), last_use.as_mut_slice());
                    let inc = eir_prog.phi_incoming(phis[phi_i].incoming);
                    var inc_i: usize = 0_usize;
                    while inc_i < inc.len {
                        record_live_point(inc[inc_i].val, pt, def_pt.as_mut_slice(), last_use.as_mut_slice());
                        inc_i = inc_i +% 1_usize;
                    }
                    pt = pt +% 1_u32;
                }
                phi_i = phi_i +% 1_usize;
            }
            let insts = eir_prog.insts_slice(blk.insts);
            var ii: usize = 0_usize;
            while ii < insts.len {
                let inst = insts[ii];
                let d = eir.inst_def(&inst);
                if live_active
                    && d != eir.EIR_NONE
                    && !live_vals.test(d.widen.[usize]())
                    && (inst.kind == .Const || inst.kind == .Copy || inst.kind == .LoadSlot || inst.kind == .SlotAddr)
                {
                    ii = ii +% 1_usize;
                    continue;
                }
                if d != eir.EIR_NONE {
                    record_live_point(d, pt, def_pt.as_mut_slice(), last_use.as_mut_slice());
                }
                if inst.kind == .PlaceAddr {
                    if let p = eir_prog.get_place(inst.aux0) {
                        if p.base.kind == .Val {
                            let at = addr_taken.as_mut_slice();
                            let uidx = p.base.id.widen.[usize]();
                            if uidx < at.len { at[uidx] = 1_u8; }
                        }
                    }
                }
                uses.clear();
                try eir_inst_collect_uses(alloc, eir_prog, &inst, &mut uses);
                let us = uses.as_slice();
                var ui: usize = 0_usize;
                while ui < us.len {
                    record_live_point(us[ui], pt, def_pt.as_mut_slice(), last_use.as_mut_slice());
                    ui = ui +% 1_usize;
                }
                pt = pt +% 1_u32;
                ii = ii +% 1_usize;
            }
            let tu = eir_term_use(&blk.term);
            if tu != eir.EIR_NONE {
                record_live_point(tu, pt, def_pt.as_mut_slice(), last_use.as_mut_slice());
            }
            let be = blk_end.as_mut_slice();
            if bidx < be.len { be[bidx] = pt; }
            pt = pt +% 1_u32;
        }
        ri = ri +% 1_usize;
    }

    // Extend intervals across back-edges and live phi incoming predecessors.
    extend_back_edges_and_phis(
        eir_prog,
        fn_id,
        live_active,
        live_vals,
        blk_start.as_slice(),
        blk_end.as_slice(),
        &mut def_pt,
        &mut last_use,
    );

    let dp_s = def_pt.as_slice();
    let lu_s = last_use.as_slice();
    let at_s = addr_taken.as_slice();
    vi = 0_usize;
    while vi < val_tys.len {
        if vi < dp_s.len && vi < lu_s.len && vi < at_s.len {
            if (!live_active || live_vals.test(vi)) && at_s[vi] == 0_u8 && dp_s[vi] != eir.EIR_NONE && is_scalar_reg_candidate(val_tys[vi], env) {
                try out_ivs.push(alloc, LiveInterval.{
                    val: vi.trunc.[u32](),
                    start: dp_s[vi],
                    end: lu_s[vi],
                });
            }
        }
        vi = vi +% 1_usize;
    }

    blk_end.destroy(alloc);
    blk_start.destroy(alloc);
    uses.destroy(alloc);
    addr_taken.destroy(alloc);
    last_use.destroy(alloc);
    def_pt.destroy(alloc);
    return;
}

fn build_frame_plan(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    is_win64: bool,
) -> FnFramePlan ! OutOfMemory {
    let f = eir_prog.get_fn(fn_id) orelse {
        let empty_slots = try col.DynBuf.[i32].init(alloc, 1_usize);
        errdefer empty_slots.destroy(alloc);
        let empty_vals = try col.DynBuf.[ValLoc].init(alloc, 1_usize);
        errdefer empty_vals.destroy(alloc);
        let empty_regs = try col.DynBuf.[x64_asm.Reg].init(alloc, 1_usize);
        errdefer empty_regs.destroy(alloc);
        let empty_live = try col.BitSet.init(alloc, 0_usize);
        errdefer empty_live.destroy(alloc);
        let empty_im = try col.BitSet.init(alloc, 0_usize);
        errdefer empty_im.destroy(alloc);
        let empty_iv = try col.DynBuf.[i32].init(alloc, 1_usize);
        errdefer empty_iv.destroy(alloc);
        let empty_uc = try col.DynBuf.[u32].init(alloc, 1_usize);
        errdefer empty_uc.destroy(alloc);
        return FnFramePlan.{
            has_sret: false,
            sret_off: 0_i32,
            temp_copy_off: 0_i32,
            slot_offs: empty_slots,
            val_locs: empty_vals,
            saved_regs: empty_regs,
            live_vals: empty_live,
            imm32_mask: empty_im,
            imm32_vals: empty_iv,
            val_use_cnt: empty_uc,
            live_active: false,
            frame_size: 0_i32,
            save_simd: false,
        };
    };

    let ret_class = classify_ret(f.sig.ret, env);
    let has_sret = ret_uses_sret(ret_class);
    let has_par_for = f.par_for_regions.len > 0_u32;

    let val_tys = eir_prog.fn_value_tys(fn_id);
    let nvals = val_tys.len;
    let slots = eir_prog.fn_slots(fn_id);
    let nslots = slots.len;

    let live_active = !has_par_for && !f.sig.effects.is_naked && nvals > 0_usize;
    var live_vals = try col.BitSet.init(alloc, if live_active { nvals } else { 0_usize });
    errdefer live_vals.destroy(alloc);
    var used_slots = try col.BitSet.init(alloc, if live_active { nslots } else { 0_usize });
    errdefer used_slots.destroy(alloc);
    var imm32_mask = try col.BitSet.init(alloc, if live_active { nvals } else { 0_usize });
    errdefer imm32_mask.destroy(alloc);
    var imm32_vals = try col.DynBuf.[i32].init(alloc, if live_active && nvals > 4_usize { nvals } else { 4_usize });
    errdefer imm32_vals.destroy(alloc);
    var val_use_cnt = try col.DynBuf.[u32].init(alloc, if live_active && nvals > 4_usize { nvals } else { 4_usize });
    errdefer val_use_cnt.destroy(alloc);
    if live_active {
        try compute_o0_liveness(
            alloc, eir_prog, fn_id, env, nvals, nslots,
            &mut live_vals, &mut used_slots, &mut imm32_mask, &mut imm32_vals, &mut val_use_cnt,
        );
    }

    var reg_assign = try col.DynBuf.[u8].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer reg_assign.destroy(alloc);
    var spill_off = try col.DynBuf.[i32].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer spill_off.destroy(alloc);
    var ri0: usize = 0_usize;
    while ri0 < nvals {
        try reg_assign.push(alloc, 255_u8);
        try spill_off.push(alloc, 0_i32);
        ri0 = ri0 +% 1_usize;
    }

    var intervals = try col.DynBuf.[LiveInterval].init(alloc, 32_usize);
    errdefer intervals.destroy(alloc);
    var used_mask: u8 = 0_u8;
    if !has_par_for && !f.sig.effects.is_naked {
        try compute_val_intervals(alloc, eir_prog, fn_id, env, live_active, &live_vals, &mut intervals);
        sort_intervals(intervals.as_mut_slice());

        var free_reg: [4]bool = [true, true, true, true];
        var active = try col.DynBuf.[ActiveInterval].init(alloc, 4_usize);
        errdefer active.destroy(alloc);
        let ivs = intervals.as_slice();
        var ii: usize = 0_usize;
        while ii < ivs.len {
            let iv = ivs[ii];
            // Expire finished intervals
            var keep: usize = 0_usize;
            var ai: usize = 0_usize;
            let alen = active.len();
            let amut = active.as_mut_slice();
            while ai < alen && ai < amut.len {
                if amut[ai].end < iv.start {
                    let ridx = amut[ai].reg_idx;
                    if ridx < 4_usize { free_reg[ridx] = true; }
                } else {
                    if keep < amut.len {
                        amut[keep] = amut[ai];
                    }
                    keep = keep +% 1_usize;
                }
                ai = ai +% 1_usize;
            }
            while active.len() > keep {
                _ = active.pop();
            }
            var chosen: usize = 4_usize;
            var k: usize = 0_usize;
            while k < LINEAR_SCAN_REG_COUNT {
                if free_reg[k] {
                    chosen = k;
                    break;
                }
                k = k +% 1_usize;
            }
            if chosen < LINEAR_SCAN_REG_COUNT {
                free_reg[chosen] = false;
                used_mask = used_mask | (1_u8 <<% chosen.trunc.[u8]());
                let ra = reg_assign.as_mut_slice();
                let vidx = iv.val.widen.[usize]();
                if vidx < ra.len {
                    ra[vidx] = chosen.trunc.[u8]();
                }
                try active.push(alloc, ActiveInterval.{ end: iv.end, reg_idx: chosen });
            }
            ii = ii +% 1_usize;
        }
        active.destroy(alloc);
    }

    var saved_regs = try col.DynBuf.[x64_asm.Reg].init(alloc, 8_usize);
    errdefer saved_regs.destroy(alloc);
    var rk: usize = 0_usize;
    while rk < LINEAR_SCAN_REG_COUNT {
        if (used_mask & (1_u8 <<% rk.trunc.[u8]())) != 0_u8 {
            try saved_regs.push(alloc, linear_scan_reg(rk));
        }
        rk = rk +% 1_usize;
    }
    if is_win64 && f.sig.effects.is_export_c {
        // Win64 ABI requires callee preservation of Rdi, Rsi, and R15 across C callbacks (e.g. WndProc).
        try saved_regs.push(alloc, .Rdi);
        try saved_regs.push(alloc, .Rsi);
        try saved_regs.push(alloc, .R15);
    }

    // Reserve space below callee-saved pushes from rbp.
    let saved_bytes = saved_regs.len() *% 8_usize;
    var cursor: usize = saved_bytes;

    var sret_off: i32 = 0_i32;
    if has_sret {
        cursor = types.align_up_usize(cursor, 8_usize) +% 8_usize;
        sret_off = 0_i32 -% cursor.trunc.[i32]();
    }

    var slot_offs = try col.DynBuf.[i32].init(alloc, if slots.len > 4_usize { slots.len } else { 4_usize });
    errdefer slot_offs.destroy(alloc);
    var si: usize = 0_usize;
    while si < slots.len {
        if live_active && !used_slots.test(si) {
            try slot_offs.push(alloc, 0_i32);
        } else {
            let lay = env.x64_layout(slots[si].ty);
            let raw_sz = if lay.size < 8_usize { 8_usize } else { lay.size };
            let sz = types.align_up_usize(raw_sz, 8_usize);
            let al = if lay.align < 8_usize { 8_usize } else if lay.align > 16_usize { 16_usize } else { lay.align };
            cursor = types.align_up_usize(cursor +% sz, al);
            try slot_offs.push(alloc, 0_i32 -% cursor.trunc.[i32]());
        }
        si = si +% 1_usize;
    }

    // Linear-scan stack-slot coloring for spilled scalar SSA temporaries (keeps disp8 -128..127!).
    if !intervals.is_empty() {
        var free_spills = try col.DynBuf.[i32].init(alloc, 16_usize);
        errdefer free_spills.destroy(alloc);
        var active_spills = try col.DynBuf.[ActiveSpill].init(alloc, 16_usize);
        errdefer active_spills.destroy(alloc);
        let ivs2 = intervals.as_slice();
        let ra_ro = reg_assign.as_slice();
        var ii2: usize = 0_usize;
        while ii2 < ivs2.len {
            let iv = ivs2[ii2];
            let vidx = iv.val.widen.[usize]();
            if vidx < ra_ro.len && ra_ro[vidx] >= 4_u8 {
                var keep_s: usize = 0_usize;
                var as_i: usize = 0_usize;
                let as_len = active_spills.len();
                let as_mut = active_spills.as_mut_slice();
                while as_i < as_len && as_i < as_mut.len {
                    if as_mut[as_i].end < iv.start {
                        try free_spills.push(alloc, as_mut[as_i].off);
                    } else {
                        if keep_s < as_mut.len {
                            as_mut[keep_s] = as_mut[as_i];
                        }
                        keep_s = keep_s +% 1_usize;
                    }
                    as_i = as_i +% 1_usize;
                }
                while active_spills.len() > keep_s {
                    _ = active_spills.pop();
                }
                var chosen_off: i32 = 0_i32;
                if let reused = free_spills.pop() {
                    chosen_off = reused;
                } else {
                    cursor = types.align_up_usize(cursor +% 8_usize, 8_usize);
                    chosen_off = 0_i32 -% cursor.trunc.[i32]();
                }
                let so_m = spill_off.as_mut_slice();
                if vidx < so_m.len {
                    so_m[vidx] = chosen_off;
                }
                try active_spills.push(alloc, ActiveSpill.{ end: iv.end, off: chosen_off });
            }
            ii2 = ii2 +% 1_usize;
        }
        active_spills.destroy(alloc);
        free_spills.destroy(alloc);
    }

    var val_locs = try col.DynBuf.[ValLoc].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer val_locs.destroy(alloc);
    let ra_s = reg_assign.as_slice();
    let sp_s = spill_off.as_slice();
    var vi: usize = 0_usize;
    while vi < val_tys.len {
        if live_active && !live_vals.test(vi) {
            try val_locs.push(alloc, val_loc_stack(0_i32));
        } else {
            let assigned = if vi < ra_s.len { ra_s[vi] } else { 255_u8 };
            if assigned < 4_u8 {
                try val_locs.push(alloc, val_loc_reg(linear_scan_reg(assigned.widen.[usize]())));
            } else if vi < sp_s.len && sp_s[vi] != 0_i32 {
                try val_locs.push(alloc, val_loc_stack(sp_s[vi]));
            } else {
                let lay = env.x64_layout(val_tys[vi]);
                if lay.size == 0_usize {
                    try val_locs.push(alloc, val_loc_stack(0_i32));
                } else {
                    let raw_sz = if lay.size < 8_usize { 8_usize } else { lay.size };
                    let sz = types.align_up_usize(raw_sz, 8_usize);
                    let al = if lay.align < 8_usize { 8_usize } else if lay.align > 16_usize { 16_usize } else { lay.align };
                    cursor = types.align_up_usize(cursor +% sz, al);
                    try val_locs.push(alloc, val_loc_stack(0_i32 -% cursor.trunc.[i32]()));
                }
            }
        }
        vi = vi +% 1_usize;
    }

    intervals.destroy(alloc);
    spill_off.destroy(alloc);
    reg_assign.destroy(alloc);
    used_slots.destroy(alloc);

    // Reserve 128B 16-byte-aligned scratch area for fs/io/pool/schedule/reduce helpers.
    cursor = types.align_up_usize(cursor +% 128_usize, 16_usize);
    let temp_copy_off = 0_i32 -% cursor.trunc.[i32]();

    // Ensure total frame (saved_bytes + local_alloc) is 16-byte aligned after `push rbp`.
    let total_aligned = types.align_up_usize(cursor, 16_usize);
    let local_bytes = if total_aligned >= saved_bytes {
        total_aligned - saved_bytes
    } else {
        0_usize
    };

    return FnFramePlan.{
        has_sret: has_sret,
        sret_off: sret_off,
        temp_copy_off: temp_copy_off,
        slot_offs: slot_offs,
        val_locs: val_locs,
        saved_regs: saved_regs,
        live_vals: live_vals,
        imm32_mask: imm32_mask,
        imm32_vals: imm32_vals,
        val_use_cnt: val_use_cnt,
        live_active: live_active,
        frame_size: local_bytes.trunc.[i32](),
        save_simd: f.sig.effects.save_simd,
    };
}

// ===========================================================================
// Section 3: FnCodegen State & Low-Level Value / Memory / Rodata Helpers
// ===========================================================================

struct ExtraFnEntry {
    sym_id: u32;
    code_off: u32;
    code_len: u32;
    reloc_start: u32;
    reloc_len: u32;
}

struct DeferredSchedWrap {
    wrap_sym: u32;
    sys_def_id: u32;
    arg_count: usize;
}

struct ParForPlan {
    header_bb: eir.BlockId;
    body_bb: eir.BlockId;
    step_bb: eir.BlockId;
    exit_bb: eir.BlockId;
    idx_slot: eir.EirSlot;
    end_slot: eir.EirSlot;
    chunk_size: u64;
    worker_sym: u32;
    body_blocks_start: u32;
    body_blocks_len: u32;
}

linear struct FnCodegen {
    fn_id: u32;
    fn_sym_id: u32;
    ret_ty: types.TyId;
    ret_class: RetClass;
    is_export_c: bool;
    is_interrupt: bool;
    is_naked: bool;
    max_call_stack_bytes: u64;
    sanitize: bool;
    emit_debug_line: bool;
    is_linux: bool;
    is_shared: bool;
    is_win64: bool;
    buf: x64_asm.X64Buf;
    frame: FnFramePlan;
    block_labels: col.DynBuf[u32];
    rodata_items: col.DynBuf[RodataItemMeta];
    rodata_bytes: col.DynBuf[u8];
    rodata_relocs: col.DynBuf[RodataReloc];
    rodata_counter: u64;
    used_helpers: col.DynBuf[u32];
    used_helper_set: col.HashMap[u32];
    line_entries: col.DynBuf[elf64.LineEntry];
    last_file: u32;
    last_line: u32;
    fn_ref_thunks: col.DynBuf[FnRefThunkReq];
    extra_fns: col.DynBuf[ExtraFnEntry];
    extra_code: col.DynBuf[u8];
    extra_relocs: col.DynBuf[x64_asm.FnReloc];
    sched_wrappers: col.DynBuf[DeferredSchedWrap];
    par_for_plans: col.DynBuf[ParForPlan];
    par_for_body_bbs: col.DynBuf[eir.BlockId];
    in_par_worker: bool;
    par_worker_end_label: u32;
    par_worker_ctx_off: i32;
    par_worker_idx_slot: eir.EirSlot;
    par_worker_cap_slots: col.DynBuf[u8];
    has_err: bool;
    err_msg: str.StrBuf;
}

impl FnCodegen {
    fn init(
        alloc: *mut AllocCap,
        eir_prog: *eir.EirProgram,
        fn_id: u32,
        fn_sym_id: u32,
        env: *types.TypeEnv,
        opts: *CompileOptions,
    ) -> FnCodegen ! OutOfMemory {
        let is_win64 = opts.target_spec.abi == .Win64;
        let frame = try build_frame_plan(alloc, eir_prog, fn_id, env, is_win64);
        errdefer frame.destroy(alloc);
        let buf = try x64_asm.X64Buf.init(alloc);
        errdefer buf.destroy(alloc);
        let block_labels = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer block_labels.destroy(alloc);
        let rodata_items = try col.DynBuf.[RodataItemMeta].init(alloc, 4_usize);
        errdefer rodata_items.destroy(alloc);
        let rodata_bytes = try col.DynBuf.[u8].init(alloc, 32_usize);
        errdefer rodata_bytes.destroy(alloc);
        let rodata_relocs = try col.DynBuf.[RodataReloc].init(alloc, 4_usize);
        errdefer rodata_relocs.destroy(alloc);
        let used_helpers = try col.DynBuf.[u32].init(alloc, 8_usize);
        errdefer used_helpers.destroy(alloc);
        let used_helper_set = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer used_helper_set.destroy(alloc);
        let line_entries = try col.DynBuf.[elf64.LineEntry].init(alloc, 16_usize);
        errdefer line_entries.destroy(alloc);
        let fn_ref_thunks = try col.DynBuf.[FnRefThunkReq].init(alloc, 4_usize);
        errdefer fn_ref_thunks.destroy(alloc);
        let extra_fns = try col.DynBuf.[ExtraFnEntry].init(alloc, 4_usize);
        errdefer extra_fns.destroy(alloc);
        let extra_code = try col.DynBuf.[u8].init(alloc, 32_usize);
        errdefer extra_code.destroy(alloc);
        let extra_relocs = try col.DynBuf.[x64_asm.FnReloc].init(alloc, 4_usize);
        errdefer extra_relocs.destroy(alloc);
        let sched_wrappers = try col.DynBuf.[DeferredSchedWrap].init(alloc, 4_usize);
        errdefer sched_wrappers.destroy(alloc);
        let par_for_plans = try col.DynBuf.[ParForPlan].init(alloc, 4_usize);
        errdefer par_for_plans.destroy(alloc);
        let par_for_body_bbs = try col.DynBuf.[eir.BlockId].init(alloc, 8_usize);
        errdefer par_for_body_bbs.destroy(alloc);
        let par_worker_cap_slots = try col.DynBuf.[u8].init(alloc, 8_usize);
        errdefer par_worker_cap_slots.destroy(alloc);
        let err_msg = try str.StrBuf.init(alloc, 32_usize);
        errdefer err_msg.destroy(alloc);

        var ret_ty = types.TY_VOID;
        var is_export_c = false;
        var is_interrupt = false;
        var is_naked = false;
        if let f = eir_prog.get_fn(fn_id) {
            ret_ty = f.sig.ret;
            is_export_c = f.sig.effects.is_export_c;
            is_interrupt = f.sig.effects.is_interrupt;
            is_naked = f.sig.effects.is_naked;
        }
        let ret_class = classify_ret(ret_ty, env);
        let is_linux = opts.mode.kind != .Freestanding && opts.target_spec.fmt == .Elf64;
        let is_shared = opts.mode.kind == .LinuxShared || opts.target_spec.is_shared;

        return FnCodegen.{
            fn_id: fn_id,
            fn_sym_id: fn_sym_id,
            ret_ty: ret_ty,
            ret_class: ret_class,
            is_export_c: is_export_c,
            is_interrupt: is_interrupt,
            is_naked: is_naked,
            max_call_stack_bytes: 0_u64,
            sanitize: opts.sanitize,
            emit_debug_line: opts.emit_debug_line,
            is_linux: is_linux,
            is_shared: is_shared,
            is_win64: is_win64,
            buf: buf,
            frame: frame,
            block_labels: block_labels,
            rodata_items: rodata_items,
            rodata_bytes: rodata_bytes,
            rodata_relocs: rodata_relocs,
            rodata_counter: 0_u64,
            used_helpers: used_helpers,
            used_helper_set: used_helper_set,
            line_entries: line_entries,
            last_file: 4294967295_u32,
            last_line: 0_u32,
            fn_ref_thunks: fn_ref_thunks,
            extra_fns: extra_fns,
            extra_code: extra_code,
            extra_relocs: extra_relocs,
            sched_wrappers: sched_wrappers,
            par_for_plans: par_for_plans,
            par_for_body_bbs: par_for_body_bbs,
            in_par_worker: false,
            par_worker_end_label: 0_u32,
            par_worker_ctx_off: 0_i32,
            par_worker_idx_slot: eir.EIR_NONE,
            par_worker_cap_slots: par_worker_cap_slots,
            has_err: false,
            err_msg: err_msg,
        };
    }

    fn destroy(self: FnCodegen, alloc: *mut AllocCap) {
        let FnCodegen.{
            fn_id: _,
            fn_sym_id: _,
            ret_ty: _,
            ret_class: _,
            is_export_c: _,
            is_interrupt: _,
            is_naked: _,
            max_call_stack_bytes: _,
            sanitize: _,
            emit_debug_line: _,
            is_linux: _,
            is_shared: _,
            is_win64: _,
            buf,
            frame,
            block_labels,
            rodata_items,
            rodata_bytes,
            rodata_relocs,
            rodata_counter: _,
            used_helpers,
            used_helper_set,
            line_entries,
            last_file: _,
            last_line: _,
            fn_ref_thunks,
            extra_fns,
            extra_code,
            extra_relocs,
            sched_wrappers,
            par_for_plans,
            par_for_body_bbs,
            in_par_worker: _,
            par_worker_end_label: _,
            par_worker_ctx_off: _,
            par_worker_idx_slot: _,
            par_worker_cap_slots,
            has_err: _,
            err_msg,
        } = self;
        buf.destroy(alloc);
        frame.destroy(alloc);
        block_labels.destroy(alloc);
        rodata_items.destroy(alloc);
        rodata_bytes.destroy(alloc);
        rodata_relocs.destroy(alloc);
        used_helpers.destroy(alloc);
        used_helper_set.destroy(alloc);
        line_entries.destroy(alloc);
        fn_ref_thunks.destroy(alloc);
        extra_fns.destroy(alloc);
        extra_code.destroy(alloc);
        extra_relocs.destroy(alloc);
        sched_wrappers.destroy(alloc);
        par_for_plans.destroy(alloc);
        par_for_body_bbs.destroy(alloc);
        par_worker_cap_slots.destroy(alloc);
        err_msg.destroy(alloc);
    }
}

fn cg_fail(alloc: *mut AllocCap, cg: *mut FnCodegen, msg: *str) -> !OutOfMemory {
    if !cg.has_err {
        cg.has_err = true;
        cg.err_msg.clear();
        try cg.err_msg.push_str_grow(alloc, msg);
    }
    return;
}

fn cg_val_loc(cg: *FnCodegen, v: eir.EirValue) -> ValLoc {
    let s = cg.frame.val_locs.as_slice();
    let idx = v.widen.[usize]();
    if idx < s.len {
        return s[idx];
    }
    return val_loc_stack(0_i32);
}

fn cg_val_stack_off(cg: *FnCodegen, v: eir.EirValue) -> i32 {
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Stack {
        return loc.stack_off;
    }
    return 0_i32;
}

fn cg_slot_off(cg: *FnCodegen, slot: eir.EirSlot) -> i32 {
    let s = cg.frame.slot_offs.as_slice();
    let idx = slot.widen.[usize]();
    if idx < s.len {
        return s[idx];
    }
    return 0_i32;
}

fn cg_block_label(cg: *FnCodegen, bb: eir.BlockId) -> u32 {
    let s = cg.block_labels.as_slice();
    let idx = bb.widen.[usize]();
    if idx < s.len {
        return s[idx];
    }
    return 0_u32;
}

fn cg_record_line(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    sm: *span.SourceMap,
    sp: span.Span,
) -> !OutOfMemory {
    if !cg.emit_debug_line || cg.in_par_worker {
        return;
    }
    if sp.start == 0_u32 && sp.end == 0_u32 {
        return;
    }
    let lc = sm.line_col(sp.file, sp.start);
    if lc.line == 0_u32 {
        return;
    }
    if sp.file == cg.last_file && lc.line == cg.last_line {
        return;
    }
    cg.last_file = sp.file;
    cg.last_line = lc.line;
    try cg.line_entries.push(alloc, elf64.LineEntry.{
        code_offset: cg.buf.pos(),
        file_idx: sp.file +% 1_u32,
        line: lc.line,
        col: lc.col,
    });
    return;
}

fn cg_note_helper(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    sym_id: u32,
) -> !OutOfMemory {
    let key = sym_id.widen.[u64]();
    if !cg.used_helper_set.contains(key) {
        try cg.used_helper_set.insert(alloc, key, 1_u32);
        try cg.used_helpers.push(alloc, sym_id);
    }
    return;
}

fn cg_helper_call(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    interner: *mut span.SymInterner,
    name: *str,
) -> !OutOfMemory {
    let sid = try interner.intern_str(alloc, name);
    try cg_note_helper(alloc, cg, sid);
    try cg.buf.call_sym(alloc, sid);
    return;
}

fn cg_call_alloc_raw(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    interner: *mut span.SymInterner,
) -> !OutOfMemory {
    if cg.sanitize {
        try cg_helper_call(alloc, cg, interner, "eon_alloc_raw_san");
    } else {
        try cg_helper_call(alloc, cg, interner, "eon_alloc_raw");
    }
    return;
}

fn cg_call_free_raw(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    interner: *mut span.SymInterner,
) -> !OutOfMemory {
    if cg.sanitize {
        try cg_helper_call(alloc, cg, interner, "eon_free_raw_san");
    } else {
        try cg_helper_call(alloc, cg, interner, "eon_free_raw");
    }
    return;
}

fn cg_intern_rodata(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    interner: *mut span.SymInterner,
    bytes: *[u8],
    align: u32,
) -> u32 ! OutOfMemory {
    let idx = cg.rodata_counter;
    cg.rodata_counter = cg.rodata_counter +% 1_u64;
    let sym_id = try intern_rodata_sym(alloc, interner, cg.fn_sym_id, idx);
    let data_off = cg.rodata_bytes.len().trunc.[u32]();
    try cg.rodata_bytes.push_slice(alloc, bytes);
    let al = if align == 0_u32 { 1_u32 } else { align };
    try cg.rodata_items.push(alloc, RodataItemMeta.{
        sym_id: sym_id,
        data_off: data_off,
        data_len: bytes.len.trunc.[u32](),
        align: al,
        reloc_start: cg.rodata_relocs.len().trunc.[u32](),
        reloc_len: 0_u32,
    });
    return sym_id;
}

fn cg_emit_align_check(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    ptr_reg: x64_asm.Reg,
    align: usize,
) -> !OutOfMemory {
    if !cg.sanitize || align <= 1_usize {
        return;
    }
    let mask = (align - 1_usize).trunc.[i32]();
    let l_ok = try cg.buf.new_label(alloc);
    try cg.buf.mov_rr(alloc, .R11, ptr_reg);
    try cg.buf.and_ri32(alloc, .R11, mask);
    try cg.buf.test_rr(alloc, .R11, .R11);
    try cg.buf.jcc_label(alloc, .E, l_ok);
    try cg.buf.ud2(alloc);
    cg.buf.bind_label(l_ok);
    return;
}

fn cg_emit_copy_mem(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    dst_base: x64_asm.Reg,
    dst_disp: i32,
    src_base: x64_asm.Reg,
    src_disp: i32,
    size: usize,
) -> !OutOfMemory {
    if size == 0_usize {
        return;
    }
    if size <= 16_usize {
        var off: usize = 0_usize;
        while off +% 8_usize <= size {
            let d = off.trunc.[i32]();
            try cg.buf.load_mem(alloc, .Rax, src_base, src_disp +% d, 8_usize, false);
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% d, .Rax, 8_usize);
            off = off +% 8_usize;
        }
        if off +% 4_usize <= size {
            let d = off.trunc.[i32]();
            try cg.buf.load_mem(alloc, .Rax, src_base, src_disp +% d, 4_usize, false);
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% d, .Rax, 4_usize);
            off = off +% 4_usize;
        }
        if off +% 2_usize <= size {
            let d = off.trunc.[i32]();
            try cg.buf.load_mem(alloc, .Rax, src_base, src_disp +% d, 2_usize, false);
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% d, .Rax, 2_usize);
            off = off +% 2_usize;
        }
        if off < size {
            let d = off.trunc.[i32]();
            try cg.buf.load_mem(alloc, .Rax, src_base, src_disp +% d, 1_usize, false);
            try cg.buf.store_mem(alloc, dst_base, dst_disp +% d, .Rax, 1_usize);
        }
        return;
    }
    if src_base == .Rdi && dst_base == .Rsi {
        try cg.buf.lea_mem(alloc, .Rax, src_base, src_disp);
        try cg.buf.push(alloc, .Rax);
        try cg.buf.lea_mem(alloc, .Rdi, dst_base, dst_disp);
        try cg.buf.pop(alloc, .Rsi);
    } else if dst_base == .Rsi {
        try cg.buf.lea_mem(alloc, .Rdi, dst_base, dst_disp);
        try cg.buf.lea_mem(alloc, .Rsi, src_base, src_disp);
    } else {
        try cg.buf.lea_mem(alloc, .Rsi, src_base, src_disp);
        try cg.buf.lea_mem(alloc, .Rdi, dst_base, dst_disp);
    }
    if (size & 7_usize) == 0_usize {
        try cg.buf.mov_ri64(alloc, .Rcx, (size >> 3_usize).widen.[u64]());
        try cg.buf.rep_movsq(alloc);
    } else {
        try cg.buf.mov_ri64(alloc, .Rcx, size.widen.[u64]());
        try cg.buf.rep_movsb(alloc);
    }
    return;
}

fn cg_emit_memzero(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    base: x64_asm.Reg,
    disp: i32,
    size: usize,
) -> !OutOfMemory {
    if size == 0_usize {
        return;
    }
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    if size <= 16_usize {
        var off: usize = 0_usize;
        while off +% 8_usize <= size {
            try cg.buf.store_mem(alloc, base, disp +% off.trunc.[i32](), .Rax, 8_usize);
            off = off +% 8_usize;
        }
        if off +% 4_usize <= size {
            try cg.buf.store_mem(alloc, base, disp +% off.trunc.[i32](), .Rax, 4_usize);
            off = off +% 4_usize;
        }
        if off +% 2_usize <= size {
            try cg.buf.store_mem(alloc, base, disp +% off.trunc.[i32](), .Rax, 2_usize);
            off = off +% 2_usize;
        }
        if off < size {
            try cg.buf.store_mem(alloc, base, disp +% off.trunc.[i32](), .Rax, 1_usize);
        }
        return;
    }
    try cg.buf.lea_mem(alloc, .Rdi, base, disp);
    if (size & 7_usize) == 0_usize {
        try cg.buf.mov_ri64(alloc, .Rcx, (size >> 3_usize).widen.[u64]());
        try cg.buf.rep_stosq(alloc);
    } else {
        try cg.buf.mov_ri64(alloc, .Rcx, size.widen.[u64]());
        try cg.buf.rep_stosb(alloc);
    }
    return;
}

fn cg_load_scalar_raw(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    v: eir.EirValue,
    dst: x64_asm.Reg,
) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        try cg.buf.xor_rr32(alloc, dst, dst);
        return;
    }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        try cg.buf.mov_rr(alloc, dst, loc.reg);
    } else {
        let bytes = if lay.size <= 8_usize { lay.size } else { 8_usize };
        try cg.buf.load_mem(alloc, dst, .Rbp, loc.stack_off, bytes, false);
    }
    return;
}

fn cg_load_scalar_val(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    v: eir.EirValue,
    dst: x64_asm.Reg,
) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        try cg.buf.xor_rr32(alloc, dst, dst);
        return;
    }
    let signed = env.is_signed_int(ty);
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        if lay.size < 8_usize {
            try cg.buf.extend_reg(alloc, dst, loc.reg, (lay.size *% 8_usize).trunc.[u8](), signed);
        } else {
            try cg.buf.mov_rr(alloc, dst, loc.reg);
        }
    } else {
        let bytes = if lay.size <= 8_usize { lay.size } else { 8_usize };
        try cg.buf.load_mem(alloc, dst, .Rbp, loc.stack_off, bytes, signed);
    }
    return;
}

fn cg_store_scalar_val(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    v: eir.EirValue,
    src: x64_asm.Reg,
) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return;
    }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        if lay.size < 8_usize {
            let signed = env.is_signed_int(ty);
            try cg.buf.extend_reg(alloc, loc.reg, src, (lay.size *% 8_usize).trunc.[u8](), signed);
        } else {
            try cg.buf.mov_rr(alloc, loc.reg, src);
        }
    } else {
        let bytes = if lay.size <= 8_usize { lay.size } else { 8_usize };
        try cg.buf.store_mem(alloc, .Rbp, loc.stack_off, src, bytes);
    }
    return;
}

fn cg_load_float_val(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    v: eir.EirValue,
    dst: x64_asm.Xmm,
) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let n = env.get(ty);
    if n.kind == .Float && n.u8_val == 16_u8 {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, v, .Rdi);
        try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        if dst != .Xmm0 {
            try cg.buf.sse_bin(alloc, false, 0x10_u8, dst, .Xmm0);
        }
        return;
    }
    let off = cg_val_stack_off(cg, v);
    if n.kind == .Float && n.u8_val == 64_u8 {
        try cg.buf.movsd_load(alloc, dst, .Rbp, off);
    } else {
        try cg.buf.movss_load(alloc, dst, .Rbp, off);
    }
    return;
}

fn cg_store_float_val(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    v: eir.EirValue,
    src: x64_asm.Xmm,
) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let n = env.get(ty);
    if n.kind == .Float && n.u8_val == 16_u8 {
        if src != .Xmm0 {
            try cg.buf.sse_bin(alloc, false, 0x10_u8, .Xmm0, src);
        }
        try cg_helper_call(alloc, cg, interner, "eon_f32_to_f16");
        try cg_store_scalar_val(alloc, cg, eir_prog, env, v, .Rax);
        return;
    }
    let off = cg_val_stack_off(cg, v);
    if n.kind == .Float && n.u8_val == 64_u8 {
        try cg.buf.movsd_store(alloc, .Rbp, off, src);
    } else {
        try cg.buf.movss_store(alloc, .Rbp, off, src);
    }
    return;
}

fn cg_val_addr_into(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    v: eir.EirValue,
    dst: x64_asm.Reg,
) -> !OutOfMemory {
    let off = cg_val_stack_off(cg, v);
    try cg.buf.lea_mem(alloc, dst, .Rbp, off);
    return;
}

fn cg_copy_val_to_val(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    src: eir.EirValue,
) -> !OutOfMemory {
    if dst == src {
        return;
    }
    let ty = eir_prog.fn_val_ty(cg.fn_id, dst);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return;
    }
    let dloc = cg_val_loc(cg, dst);
    let sloc = cg_val_loc(cg, src);
    if dloc.kind == .Reg && sloc.kind == .Reg {
        if lay.size < 8_usize {
            try cg.buf.extend_reg(alloc, dloc.reg, sloc.reg, (lay.size *% 8_usize).trunc.[u8](), env.is_signed_int(ty));
        } else if dloc.reg != sloc.reg {
            try cg.buf.mov_rr(alloc, dloc.reg, sloc.reg);
        }
        return;
    }
    if dloc.kind == .Reg {
        let bytes = if lay.size <= 8_usize { lay.size } else { 8_usize };
        try cg.buf.load_mem(alloc, dloc.reg, .Rbp, sloc.stack_off, bytes, env.is_signed_int(ty));
        return;
    }
    if sloc.kind == .Reg {
        let bytes = if lay.size <= 8_usize { lay.size } else { 8_usize };
        try cg.buf.store_mem(alloc, .Rbp, dloc.stack_off, sloc.reg, bytes);
        return;
    }
    if dloc.stack_off == sloc.stack_off {
        return;
    }
    try cg_emit_copy_mem(alloc, cg, .Rbp, dloc.stack_off, .Rbp, sloc.stack_off, lay.size);
    return;
}

fn cg_store_val_to_mem(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    base: x64_asm.Reg,
    disp: i32,
    v: eir.EirValue,
    ty: types.TyId,
) -> !OutOfMemory {
    _ = eir_prog;
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return;
    }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        try cg.buf.store_mem(alloc, base, disp, loc.reg, lay.size);
    } else {
        try cg_emit_copy_mem(alloc, cg, base, disp, .Rbp, loc.stack_off, lay.size);
    }
    return;
}

fn cg_load_val_from_mem(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    v: eir.EirValue,
    base: x64_asm.Reg,
    disp: i32,
    ty: types.TyId,
) -> !OutOfMemory {
    _ = eir_prog;
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return;
    }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        let signed = env.is_signed_int(ty);
        try cg.buf.load_mem(alloc, loc.reg, base, disp, lay.size, signed);
    } else {
        try cg_emit_copy_mem(alloc, cg, .Rbp, loc.stack_off, base, disp, lay.size);
    }
    return;
}

fn cg_emit_norm_subword(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    env: *types.TypeEnv,
    ty: types.TyId,
    reg: x64_asm.Reg,
) -> !OutOfMemory {
    let bits = env.int_bits(ty);
    if bits > 0_u8 && bits < 64_u8 {
        try cg.buf.extend_reg(alloc, reg, reg, bits, env.is_signed_int(ty));
    }
    return;
}

fn cg_emit_opt_null(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    opt_ty: types.TyId,
) -> !OutOfMemory {
    let n = env.get(opt_ty);
    if n.kind != .Optional {
        if n.kind == .Builtin && n.builtin_kind == .IdBrand {
            try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFF_u64);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            return;
        }
        let lay = env.x64_layout(opt_ty);
        if lay.size > 0_usize {
            let loc = cg_val_loc(cg, dst);
            if loc.kind == .Reg {
                try cg.buf.xor_rr32(alloc, loc.reg, loc.reg);
            } else {
                try cg_emit_memzero(alloc, cg, .Rbp, loc.stack_off, lay.size);
            }
        }
        return;
    }
    let inner = n.primary;
    let niche = env.opt_niche(inner);
    let loc = cg_val_loc(cg, dst);
    match niche.kind {
        .IdBrand => {
            try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFF_u64);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .GenId => {
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .Link => {
            if loc.kind == .Reg {
                try cg.buf.xor_rr32(alloc, loc.reg, loc.reg);
            } else {
                let lay = env.x64_layout(opt_ty);
                let zsz = if lay.size < 8_usize { 8_usize } else { lay.size };
                try cg_emit_memzero(alloc, cg, .Rbp, loc.stack_off, zsz);
            }
        }
        .NullPtr => {
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .FatPtrNullFirst => {
            try cg_emit_memzero(alloc, cg, .Rbp, loc.stack_off, 16_usize);
        }
        .SliceMaxLen => {
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, loc.stack_off, .Rax, 8_usize);
            try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFFFFFFFFFF_u64);
            try cg.buf.store_mem(alloc, .Rbp, loc.stack_off +% 8_i32, .Rax, 8_usize);
        }
        .BoolTag => {
            try cg.buf.mov_ri64(alloc, .Rax, 2_u64);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .ScalarSentinel => {
            try cg.buf.mov_ri64(alloc, .Rax, niche.sentinel);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .None => {
            let lay = env.x64_layout(opt_ty);
            if loc.kind == .Reg {
                try cg.buf.xor_rr32(alloc, loc.reg, loc.reg);
            } else {
                try cg_emit_memzero(alloc, cg, .Rbp, loc.stack_off, lay.size);
            }
        }
    }
    return;
}

fn cg_load_ptr_arg(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    arg_val: eir.EirValue,
    arg_slot: eir.EirSlot,
    dst: x64_asm.Reg,
) -> !OutOfMemory {
    if arg_slot != eir.EIR_NONE {
        try cg_emit_slot_addr(alloc, cg, arg_slot, dst);
        if let sinfo = eir_prog.fn_slot(cg.fn_id, arg_slot) {
            let sn = env.get(sinfo.ty);
            if sn.kind == .Borrow || sn.kind == .RawPtr {
                try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_usize, false);
            }
        }
        return;
    }
    let ty = eir_prog.fn_val_ty(cg.fn_id, arg_val);
    let n = env.get(ty);
    if n.kind == .Borrow || n.kind == .RawPtr {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, arg_val, dst);
        return;
    }
    let loc = cg_val_loc(cg, arg_val);
    if loc.kind == .Stack {
        try cg.buf.lea_mem(alloc, dst, .Rbp, loc.stack_off);
    } else {
        try cg.buf.mov_rr(alloc, dst, loc.reg);
    }
    return;
}

fn cg_emit_slot_addr(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    slot: eir.EirSlot,
    dst: x64_asm.Reg,
) -> !OutOfMemory {
    if cg.in_par_worker && slot != cg.par_worker_idx_slot {
        let caps = cg.par_worker_cap_slots.as_slice();
        let sidx = slot.widen.[usize]();
        if sidx < caps.len && caps[sidx] != 0_u8 {
            // Inside outlined par-for worker, captured outer slot lives on parent frame [rbp + par_worker_ctx_off].
            try cg.buf.load_mem(alloc, dst, .Rbp, cg.par_worker_ctx_off, 8_usize, false);
            let soff = cg_slot_off(cg, slot);
            if soff != 0_i32 {
                try cg.buf.lea_mem(alloc, dst, dst, soff);
            }
            return;
        }
    }
    let soff = cg_slot_off(cg, slot);
    try cg.buf.lea_mem(alloc, dst, .Rbp, soff);
    return;
}

// ===========================================================================
// Section 4: Place Resolution, Bitfields, Pool Columns, Prologue & Epilogue
// ===========================================================================

struct BitfieldAccess {
    has_bf: bool;
    base_bytes: usize;
    lo: u8;
    width: u8;
    member_ty: types.TyId;
}

fn bitfield_access_none() -> BitfieldAccess {
    return BitfieldAccess.{
        has_bf: false,
        base_bytes: 0_usize,
        lo: 0_u8,
        width: 0_u8,
        member_ty: types.TY_VOID,
    };
}

fn lookup_bitfield_member(
    env: *types.TypeEnv,
    bf_def: u32,
    field_idx: usize,
) -> BitfieldAccess {
    let bm = env.get_bitfield(bf_def) orelse {
        return bitfield_access_none();
    };
    let mems = env.bitfield_members_range(bm.members);
    if field_idx >= mems.len {
        return bitfield_access_none();
    }
    let m = mems[field_idx];
    let width = m.hi -% m.lo;
    let base_bytes = ((bm.base_bits.widen.[usize]() +% 7_usize) / 8_usize);
    return BitfieldAccess.{
        has_bf: true,
        base_bytes: base_bytes,
        lo: m.lo,
        width: width,
        member_ty: m.ty,
    };
}

fn place_base_ty(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    base: eir.EirPlaceBase,
) -> types.TyId {
    if base.kind == .Slot {
        if let s = eir_prog.fn_slot(fn_id, base.id) {
            return s.ty;
        }
        return types.TY_ERROR;
    }
    return eir_prog.fn_val_ty(fn_id, base.id);
}

fn cg_load_pool_base_into_r8(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    base: eir.EirPlaceBase,
    pool_is_ptr: bool,
) -> !OutOfMemory {
    if base.kind == .Slot {
        try cg_emit_slot_addr(alloc, cg, base.id, .R8);
        if pool_is_ptr {
            try cg.buf.load_mem(alloc, .R8, .R8, 0_i32, 8_usize, false);
        }
        return;
    }
    if pool_is_ptr {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, base.id, .R8);
    } else {
        try cg_val_addr_into(alloc, cg, base.id, .R8);
    }
    return;
}

fn cg_compute_place_addr(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    place: *eir.EirPlace,
    n_projs: usize,
    dst: x64_asm.Reg,
) -> types.TyId ! OutOfMemory {
    var cur_ty = place_base_ty(eir_prog, cg.fn_id, place.base);
    let projs = eir_prog.projs_slice(place.projs);
    var pi: usize = 0_usize;
    var fast_slot_deref = false;
    if place.base.kind == .Slot && !cg.in_par_worker && n_projs > 0_usize && projs.len > 0_usize && projs[0_usize].kind == .Deref {
        let cn0 = env.get(cur_ty);
        let inner0 = if cn0.kind == .Borrow || cn0.kind == .RawPtr { cn0.primary } else { cur_ty };
        if env.get(inner0).kind != .Pool {
            let soff0 = cg_slot_off(cg, place.base.id);
            try cg.buf.load_mem(alloc, dst, .Rbp, soff0, 8_usize, false);
            cur_ty = inner0;
            let inner_lay0 = env.x64_layout(cur_ty);
            try cg_emit_align_check(alloc, cg, dst, inner_lay0.align);
            pi = 1_usize;
            fast_slot_deref = true;
        }
    }
    if !fast_slot_deref {
        if place.base.kind == .Slot {
            try cg_emit_slot_addr(alloc, cg, place.base.id, dst);
        } else {
            let loc = cg_val_loc(cg, place.base.id);
            let n = env.get(cur_ty);
            let is_row_view_val = n.kind == .Borrow && n.borrow_kind == .Single && env.get(n.primary).kind == .Pool;
            if (n.kind == .Borrow && n.borrow_kind == .Single && !is_row_view_val) || n.kind == .RawPtr {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, place.base.id, dst);
            } else if loc.kind == .Stack {
                try cg.buf.lea_mem(alloc, dst, .Rbp, loc.stack_off);
            } else {
                try cg.buf.mov_rr(alloc, dst, loc.reg);
            }
        }
    }

    while pi < n_projs && pi < projs.len {
        let pr = projs[pi];
        match pr.kind {
            .Deref => {
                let cn = env.get(cur_ty);
                let inner_ty = if cn.kind == .Borrow || cn.kind == .RawPtr { cn.primary } else { cur_ty };
                let inner_is_pool = env.get(inner_ty).kind == .Pool;
                if !inner_is_pool {
                    let base_is_reg_ptr = pi == 0_usize && place.base.kind == .Val
                        && ((cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr);
                    if !base_is_reg_ptr {
                        try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_usize, false);
                    }
                }
                cur_ty = inner_ty;
                if !inner_is_pool {
                    let inner_lay = env.x64_layout(cur_ty);
                    try cg_emit_align_check(alloc, cg, dst, inner_lay.align);
                }
            }
            .Field => {
                let cn = env.get(cur_ty);
                let is_ptr = (cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr;
                let deref_ty = if is_ptr { cn.primary } else { cur_ty };
                if env.get(deref_ty).kind == .Pool && is_ptr {
                    // RowView { pool_ptr (+0), index (+8) }!
                    try cg.buf.load_mem(alloc, .R9, dst, 0_i32, 8_usize, false);
                    try cg.buf.load_mem(alloc, .R10, dst, 8_i32, 4_usize, false);
                    try cg.buf.load_mem(alloc, dst, .R9, pr.index.trunc.[i32]() *% 8_i32, 8_usize, false);
                    let elem_sz_r = env.x64_layout_impl(pr.ty, true).size;
                    let elem_sz = if elem_sz_r == 0_usize { 1_usize } else { elem_sz_r };
                    if elem_sz != 1_usize {
                        try cg.buf.imul_rri32(alloc, .R10, .R10, elem_sz.trunc.[i32]());
                    }
                    try cg.buf.add_rr(alloc, dst, .R10);
                } else {
                    if is_ptr {
                        let base_already_ptr = pi == 0_usize && place.base.kind == .Val;
                        if !base_already_ptr {
                            try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_usize, false);
                        }
                        cur_ty = deref_ty;
                    }
                    let foff = env.struct_field_offset(cur_ty, pr.index.widen.[usize]());
                    if foff.offset > 0_usize {
                        try cg.buf.add_ri32(alloc, dst, foff.offset.trunc.[i32]());
                    }
                }
                cur_ty = pr.ty;
            }
            .TupleField => {
                let cn = env.get(cur_ty);
                let is_ptr = (cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr;
                if is_ptr {
                    let base_already_ptr = pi == 0_usize && place.base.kind == .Val;
                    if !base_already_ptr {
                        try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_usize, false);
                    }
                    cur_ty = cn.primary;
                }
                let foff = env.struct_field_offset(cur_ty, pr.index.widen.[usize]());
                if foff.offset > 0_usize {
                    try cg.buf.add_ri32(alloc, dst, foff.offset.trunc.[i32]());
                }
                cur_ty = pr.ty;
            }
            .PoolCol => {
                let cn = env.get(cur_ty);
                if (cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr {
                    let base_already_ptr = pi == 0_usize && place.base.kind == .Val;
                    if !base_already_ptr {
                        try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_usize, false);
                    }
                }
                let col_hdr_off = (pr.index.trunc.[i32]() *% 8_i32);
                try cg.buf.load_mem(alloc, dst, dst, col_hdr_off, 8_usize, false);
                if pi +% 1_usize < n_projs && pi +% 1_usize < projs.len && projs[pi +% 1_usize].kind == .Index {
                    let next_pr = projs[pi +% 1_usize];
                    try cg.buf.push(alloc, dst);
                    try cg_load_scalar_raw(alloc, cg, eir_prog, env, next_pr.index, .Rcx);
                    try cg.buf.pop(alloc, dst);
                    if pr.is_slot_pool {
                        try cg.buf.extend_reg(alloc, .Rcx, .Rcx, 32_u8, false);
                    }
                    let esz_r = env.x64_layout_impl(pr.ty, pr.is_slot_pool).size;
                    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                    if esz > 1_usize {
                        try cg.buf.mov_ri64(alloc, .R11, esz.widen.[u64]());
                        try cg.buf.imul_rr(alloc, .Rcx, .R11);
                    }
                    try cg.buf.add_rr(alloc, dst, .Rcx);
                    cur_ty = next_pr.ty;
                    pi = pi +% 2_usize;
                    continue;
                }
                cur_ty = pr.ty;
            }
            .Index => {
                let cn = env.get(cur_ty);
                let elem_ty = pr.ty;
                let elem_sz = env.x64_layout(elem_ty).size;
                // Preserve base address across index load
                try cg.buf.push(alloc, dst);
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, pr.index, .Rcx);
                try cg.buf.pop(alloc, dst);
                if cn.kind == .Borrow && (cn.borrow_kind == .Slice || cn.borrow_kind == .Str) {
                    try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_usize, false);
                } else if cn.kind == .Str {
                    try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_usize, false);
                } else if cn.kind == .Borrow && cn.borrow_kind == .Single {
                    let base_already_ptr = pi == 0_usize && place.base.kind == .Val;
                    if !base_already_ptr {
                        try cg.buf.load_mem(alloc, dst, dst, 0_i32, 8_usize, false);
                    }
                }
                if elem_sz > 1_usize {
                    try cg.buf.mov_ri64(alloc, .R11, elem_sz.widen.[u64]());
                    try cg.buf.imul_rr(alloc, .Rcx, .R11);
                }
                try cg.buf.add_rr(alloc, dst, .Rcx);
                cur_ty = elem_ty;
            }
        }
        pi = pi +% 1_usize;
    }
    return cur_ty;
}

fn cg_split_bitfield_tail(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    place: *eir.EirPlace,
) -> BitfieldAccess {
    let projs = eir_prog.projs_slice(place.projs);
    if projs.len == 0_usize {
        return bitfield_access_none();
    }
    let last = projs[projs.len - 1_usize];
    if last.kind != .Field {
        return bitfield_access_none();
    }
    var cur_ty = place_base_ty(eir_prog, fn_id, place.base);
    var i: usize = 0_usize;
    while i + 1_usize < projs.len {
        let pr = projs[i];
        match pr.kind {
            .Deref => {
                let cn = env.get(cur_ty);
                if cn.kind == .Borrow || cn.kind == .RawPtr {
                    cur_ty = cn.primary;
                }
            }
            _ => {
                cur_ty = pr.ty;
            }
        }
        i = i +% 1_usize;
    }
    var cn = env.get(cur_ty);
    if cn.kind == .Borrow && cn.borrow_kind == .Single {
        cur_ty = cn.primary;
        cn = env.get(cur_ty);
    }
    if cn.kind == .Bitfield {
        return lookup_bitfield_member(env, cn.primary, last.index.widen.[usize]());
    }
    return bitfield_access_none();
}

fn cg_emit_load_place(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    place_id: u32,
) -> !OutOfMemory {
    let place = eir_prog.get_place(place_id) orelse {
        return;
    };
    let bf = cg_split_bitfield_tail(eir_prog, cg.fn_id, env, place);
    let projs_len = place.projs.len.widen.[usize]();
    if bf.has_bf && projs_len > 0_usize {
        _ = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs_len - 1_usize, .R8);
        try cg.buf.load_mem(alloc, .Rax, .R8, 0_i32, bf.base_bytes, false);
        if bf.lo > 0_u8 {
            try cg.buf.shr_imm(alloc, .Rax, bf.lo);
        }
        if bf.width < 64_u8 {
            let mask = (1_u64 <<% bf.width.widen.[u64]()) -% 1_u64;
            try cg.buf.mov_ri64(alloc, .Rcx, mask);
            try cg.buf.and_rr(alloc, .Rax, .Rcx);
            if env.is_signed_int(bf.member_ty) {
                let sh = 64_u8 -% bf.width;
                try cg.buf.shl_imm(alloc, .Rax, sh);
                try cg.buf.sar_imm(alloc, .Rax, sh);
            }
        }
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        return;
    }
    let projs = eir_prog.projs_slice(place.projs);
    if projs.len > 0_usize && projs[projs.len - 1_usize].kind == .PoolCol {
        let last_pr = projs[projs.len - 1_usize];
        let pool_ty = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs.len - 1_usize, .R8);
        let pn = env.get(pool_ty);
        var deref_ty = pool_ty;
        if pn.kind == .Borrow && pn.borrow_kind == .Single {
            let base_already_ptr = projs.len == 1_usize && place.base.kind == .Val;
            if !base_already_ptr {
                try cg.buf.load_mem(alloc, .R8, .R8, 0_i32, 8_usize, false);
            }
            deref_ty = pn.primary;
        }
        let dn = env.get(deref_ty);
        let ncols = if dn.kind == .Builtin { env.pool_col_count(env.node_gval_list(&dn)) } else { 0_usize };
        let len_off: i32 = if last_pr.is_slot_pool {
            ((ncols +% 2_usize) *% 8_usize).trunc.[i32]()
        } else {
            (ncols *% 8_usize).trunc.[i32]()
        };
        let col_off = (last_pr.index.trunc.[i32]() *% 8_i32);
        try cg.buf.load_mem(alloc, .Rax, .R8, col_off, 8_usize, false);
        try cg.buf.load_mem(alloc, .Rdx, .R8, len_off, 8_usize, false);
        let doff = cg_val_stack_off(cg, dst);
        try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 8_usize);
        try cg.buf.store_mem(alloc, .Rbp, doff +% 8_i32, .Rdx, 8_usize);
        return;
    }
    _ = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs_len, .R8);
    let ty = eir_prog.fn_val_ty(cg.fn_id, dst);
    try cg_load_val_from_mem(alloc, cg, eir_prog, env, dst, .R8, 0_i32, ty);
    return;
}

fn cg_emit_store_place(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    place_id: u32,
    val: eir.EirValue,
) -> !OutOfMemory {
    let place = eir_prog.get_place(place_id) orelse {
        return;
    };
    let bf = cg_split_bitfield_tail(eir_prog, cg.fn_id, env, place);
    let projs_len = place.projs.len.widen.[usize]();
    if bf.has_bf && projs_len > 0_usize {
        _ = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs_len - 1_usize, .R8);
        try cg.buf.load_mem(alloc, .R9, .R8, 0_i32, bf.base_bytes, false);
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, val, .Rax);
        let mask: u64 = if bf.width >= 64_u8 {
            0xFFFFFFFFFFFFFFFF_u64
        } else {
            (1_u64 <<% bf.width.widen.[u64]()) -% 1_u64
        };
        try cg.buf.mov_ri64(alloc, .Rcx, mask);
        try cg.buf.and_rr(alloc, .Rax, .Rcx);
        if bf.lo > 0_u8 {
            try cg.buf.shl_imm(alloc, .Rax, bf.lo);
            try cg.buf.shl_imm(alloc, .Rcx, bf.lo);
        }
        try cg.buf.not_r(alloc, .Rcx);
        try cg.buf.and_rr(alloc, .R9, .Rcx);
        try cg.buf.or_rr(alloc, .R9, .Rax);
        try cg.buf.store_mem(alloc, .R8, 0_i32, .R9, bf.base_bytes);
        return;
    }
    _ = try cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs_len, .R8);
    let ty = eir_prog.fn_val_ty(cg.fn_id, val);
    try cg_store_val_to_mem(alloc, cg, eir_prog, env, .R8, 0_i32, val, ty);
    return;
}

fn cg_emit_pool_col_load(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op_id: u32,
) -> !OutOfMemory {
    let op = eir_prog.get_pool_col_op(op_id) orelse {
        return;
    };
    try cg_load_pool_base_into_r8(alloc, cg, eir_prog, env, op.pool_base, op.pool_is_ptr);
    let hdr_off = op.col_idx.trunc.[i32]() *% 8_i32;
    try cg.buf.load_mem(alloc, .R8, .R8, hdr_off, 8_usize, false);
    try cg_load_scalar_raw(alloc, cg, eir_prog, env, op.index, .Rcx);
    // GenId / Link slot index is always in low 32 bits!
    try cg.buf.extend_reg(alloc, .Rcx, .Rcx, 32_u8, false);
    let elem_lay = env.x64_layout_impl(op.elem_ty, op.is_slot_pool);
    if elem_lay.size > 1_usize {
        try cg.buf.mov_ri64(alloc, .R11, elem_lay.size.widen.[u64]());
        try cg.buf.imul_rr(alloc, .Rcx, .R11);
    }
    try cg.buf.add_rr(alloc, .R8, .Rcx);
    if op.is_slot_pool && env.is_link_or_opt_link(op.elem_ty) {
        try cg.buf.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        return;
    }
    try cg_load_val_from_mem(alloc, cg, eir_prog, env, dst, .R8, 0_i32, op.elem_ty);
    return;
}

fn cg_emit_pool_col_store(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    op_id: u32,
    val: eir.EirValue,
) -> !OutOfMemory {
    let op = eir_prog.get_pool_col_op(op_id) orelse {
        return;
    };
    try cg_load_pool_base_into_r8(alloc, cg, eir_prog, env, op.pool_base, op.pool_is_ptr);
    let hdr_off = op.col_idx.trunc.[i32]() *% 8_i32;
    try cg.buf.load_mem(alloc, .R8, .R8, hdr_off, 8_usize, false);
    try cg_load_scalar_raw(alloc, cg, eir_prog, env, op.index, .Rcx);
    try cg.buf.extend_reg(alloc, .Rcx, .Rcx, 32_u8, false);
    let elem_lay = env.x64_layout_impl(op.elem_ty, op.is_slot_pool);
    if elem_lay.size > 1_usize {
        try cg.buf.mov_ri64(alloc, .R11, elem_lay.size.widen.[u64]());
        try cg.buf.imul_rr(alloc, .Rcx, .R11);
    }
    try cg.buf.add_rr(alloc, .R8, .Rcx);
    if op.is_slot_pool && env.is_link_or_opt_link(op.elem_ty) {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, val, .Rax);
        try cg.buf.store_mem(alloc, .R8, 0_i32, .Rax, 8_usize);
        return;
    }
    try cg_store_val_to_mem(alloc, cg, eir_prog, env, .R8, 0_i32, val, op.elem_ty);
    return;
}

// --- Function Prologue, Parameter Reception, and Flag-Preserving Epilogue ---

fn cg_emit_prologue(alloc: *mut AllocCap, cg: *mut FnCodegen) -> !OutOfMemory {
    if cg.is_naked {
        return;
    }
    if cg.is_interrupt {
        try cg.buf.push(alloc, .Rax);
        try cg.buf.push(alloc, .Rcx);
        try cg.buf.push(alloc, .Rdx);
        try cg.buf.push(alloc, .Rsi);
        try cg.buf.push(alloc, .Rdi);
        try cg.buf.push(alloc, .R8);
        try cg.buf.push(alloc, .R9);
        try cg.buf.push(alloc, .R10);
        try cg.buf.push(alloc, .R11);
        try cg.buf.push(alloc, .Rbx);
        try cg.buf.push(alloc, .R12);
        try cg.buf.push(alloc, .R13);
        try cg.buf.push(alloc, .R14);
        try cg.buf.push(alloc, .R15);
        if cg.frame.save_simd {
            try cg.buf.sub_ri32(alloc, .Rsp, 256_i32);
            var xi: u8 = 0_u8;
            while xi < 16_u8 {
                try cg.buf.movdqu_store_n(alloc, .Rsp, (xi.widen.[u32]() *% 16_u32).bitcast.[i32](), xi);
                xi = xi +% 1_u8;
            }
        }
    }
    try cg.buf.push(alloc, .Rbp);
    try cg.buf.mov_rr(alloc, .Rbp, .Rsp);
    let saved = cg.frame.saved_regs.as_slice();
    var si: usize = 0_usize;
    while si < saved.len {
        try cg.buf.push(alloc, saved[si]);
        si = si +% 1_usize;
    }
    if cg.frame.frame_size > 0_i32 {
        try cg.buf.sub_ri32(alloc, .Rsp, cg.frame.frame_size);
    }
    return;
}

fn cg_emit_epilogue_preserving_flags(alloc: *mut AllocCap, cg: *mut FnCodegen) -> !OutOfMemory {
    if cg.is_naked {
        return;
    }
    let saved = cg.frame.saved_regs.as_slice();
    let saved_bytes = (saved.len *% 8_usize).trunc.[i32]();
    // LEA and POP do not modify RFLAGS (preserving CF for ErrorUnion returns!)
    try cg.buf.lea_mem(alloc, .Rsp, .Rbp, 0_i32 -% saved_bytes);
    var si = saved.len;
    while si > 0_usize {
        si = si - 1_usize;
        try cg.buf.pop(alloc, saved[si]);
    }
    try cg.buf.pop(alloc, .Rbp);
    if cg.is_interrupt {
        if cg.frame.save_simd {
            var xi: u8 = 0_u8;
            while xi < 16_u8 {
                try cg.buf.movdqu_load_n(alloc, xi, .Rsp, (xi.widen.[u32]() *% 16_u32).bitcast.[i32]());
                xi = xi +% 1_u8;
            }
            try cg.buf.lea_mem(alloc, .Rsp, .Rsp, 256_i32);
        }
        try cg.buf.pop(alloc, .R15);
        try cg.buf.pop(alloc, .R14);
        try cg.buf.pop(alloc, .R13);
        try cg.buf.pop(alloc, .R12);
        try cg.buf.pop(alloc, .Rbx);
        try cg.buf.pop(alloc, .R11);
        try cg.buf.pop(alloc, .R10);
        try cg.buf.pop(alloc, .R9);
        try cg.buf.pop(alloc, .R8);
        try cg.buf.pop(alloc, .Rdi);
        try cg.buf.pop(alloc, .Rsi);
        try cg.buf.pop(alloc, .Rdx);
        try cg.buf.pop(alloc, .Rcx);
        try cg.buf.pop(alloc, .Rax);
    }
    return;
}

fn cg_receive_params(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    if cg.is_naked {
        return;
    }
    let is_c = cg.is_export_c;
    let is_w64 = is_c && cg.is_win64;
    var gp_i: usize = 0_usize;
    var flt_i: usize = 0_usize;
    var stk_off: i32 = if is_w64 { 48_i32 } else { 16_i32 };

    if cg.frame.has_sret {
        if let r = gp_arg_reg_abi(is_c, cg.is_win64, gp_i) {
            try cg.buf.store_mem(alloc, .Rbp, cg.frame.sret_off, r, 8_usize);
            gp_i = gp_i +% 1_usize;
            if is_w64 { flt_i = gp_i; }
        }
    }

    let params = eir_prog.fn_params(cg.fn_id);
    var pi: usize = 0_usize;
    while pi < params.len {
        let pv = params[pi];
        let ty = eir_prog.fn_val_ty(cg.fn_id, pv);
        let lay = env.x64_layout(ty);
        let cls = classify_arg(ty, env);
        match cls {
            .Zst => {}
            .IntReg => {
                if let r = gp_arg_reg_abi(is_c, cg.is_win64, gp_i) {
                    try cg_store_scalar_val(alloc, cg, eir_prog, env, pv, r);
                    gp_i = gp_i +% 1_usize;
                    if is_w64 { flt_i = gp_i; }
                } else {
                    try cg.buf.load_mem(alloc, .Rax, .Rbp, stk_off, lay.size, env.is_signed_int(ty));
                    try cg_store_scalar_val(alloc, cg, eir_prog, env, pv, .Rax);
                    stk_off = stk_off +% 8_i32;
                }
            }
            .TwoIntRegs => {
                let dst_off = cg_val_stack_off(cg, pv);
                let hi_sz = if lay.size > 8_usize { lay.size - 8_usize } else { 0_usize };
                let r0_opt = gp_arg_reg_abi(is_c, cg.is_win64, gp_i);
                let r1_opt = gp_arg_reg_abi(is_c, cg.is_win64, gp_i +% 1_usize);
                var have_both = false;
                var r0_val: x64_asm.Reg = .Rax;
                var r1_val: x64_asm.Reg = .Rax;
                if let r0 = r0_opt {
                    r0_val = r0;
                    if let r1 = r1_opt {
                        r1_val = r1;
                        have_both = true;
                    }
                }
                if have_both {
                    try cg.buf.store_mem(alloc, .Rbp, dst_off, r0_val, 8_usize);
                    if hi_sz > 0_usize {
                        try cg.buf.store_mem(alloc, .Rbp, dst_off +% 8_i32, r1_val, hi_sz);
                    }
                    gp_i = gp_i +% 2_usize;
                    if is_w64 { flt_i = gp_i; }
                } else {
                    try cg_emit_copy_mem(alloc, cg, .Rbp, dst_off, .Rbp, stk_off, lay.size);
                    stk_off = stk_off +% 16_i32;
                }
            }
            .FloatReg => {
                let dst_off = cg_val_stack_off(cg, pv);
                let is_f64 = env.get(ty).u8_val == 64_u8;
                let max_flt: usize = if is_w64 { 4_usize } else { 8_usize };
                let xr_opt = if flt_i < max_flt { float_arg_reg(flt_i) } else { null };
                if let xr = xr_opt {
                    if is_f64 {
                        try cg.buf.movsd_store(alloc, .Rbp, dst_off, xr);
                    } else {
                        try cg.buf.movss_store(alloc, .Rbp, dst_off, xr);
                    }
                    flt_i = flt_i +% 1_usize;
                    if is_w64 { gp_i = flt_i; }
                } else {
                    let b = if is_f64 { 8_usize } else { 4_usize };
                    try cg_emit_copy_mem(alloc, cg, .Rbp, dst_off, .Rbp, stk_off, b);
                    stk_off = stk_off +% 8_i32;
                }
            }
            .ByPtr => {
                let dst_off = cg_val_stack_off(cg, pv);
                if let r = gp_arg_reg_abi(is_c, cg.is_win64, gp_i) {
                    if lay.size <= 16_usize {
                        try cg_emit_copy_mem(alloc, cg, .Rbp, dst_off, r, 0_i32, lay.size);
                    } else {
                        // Preserve live incoming GP argument registers (Rdi, Rsi, Rcx) across rep movs!
                        try cg.buf.mov_rr(alloc, .Rax, r);
                        try cg.buf.push(alloc, .Rdi);
                        try cg.buf.push(alloc, .Rsi);
                        try cg.buf.push(alloc, .Rcx);
                        try cg.buf.mov_rr(alloc, .Rsi, .Rax);
                        try cg.buf.lea_mem(alloc, .Rdi, .Rbp, dst_off);
                        if (lay.size & 7_usize) == 0_usize {
                            try cg.buf.mov_ri64(alloc, .Rcx, (lay.size >> 3_usize).widen.[u64]());
                            try cg.buf.rep_movsq(alloc);
                        } else {
                            try cg.buf.mov_ri64(alloc, .Rcx, lay.size.widen.[u64]());
                            try cg.buf.rep_movsb(alloc);
                        }
                        try cg.buf.pop(alloc, .Rcx);
                        try cg.buf.pop(alloc, .Rsi);
                        try cg.buf.pop(alloc, .Rdi);
                    }
                    gp_i = gp_i +% 1_usize;
                    if is_w64 { flt_i = gp_i; }
                } else {
                    if lay.size <= 16_usize {
                        try cg.buf.load_mem(alloc, .Rdi, .Rbp, stk_off, 8_usize, false);
                        try cg_emit_copy_mem(alloc, cg, .Rbp, dst_off, .Rdi, 0_i32, lay.size);
                    } else {
                        try cg.buf.load_mem(alloc, .Rax, .Rbp, stk_off, 8_usize, false);
                        try cg.buf.push(alloc, .Rdi);
                        try cg.buf.push(alloc, .Rsi);
                        try cg.buf.push(alloc, .Rcx);
                        try cg.buf.mov_rr(alloc, .Rsi, .Rax);
                        try cg.buf.lea_mem(alloc, .Rdi, .Rbp, dst_off);
                        if (lay.size & 7_usize) == 0_usize {
                            try cg.buf.mov_ri64(alloc, .Rcx, (lay.size >> 3_usize).widen.[u64]());
                            try cg.buf.rep_movsq(alloc);
                        } else {
                            try cg.buf.mov_ri64(alloc, .Rcx, lay.size.widen.[u64]());
                            try cg.buf.rep_movsb(alloc);
                        }
                        try cg.buf.pop(alloc, .Rcx);
                        try cg.buf.pop(alloc, .Rsi);
                        try cg.buf.pop(alloc, .Rdi);
                    }
                    stk_off = stk_off +% 8_i32;
                }
            }
        }
        pi = pi +% 1_usize;
    }
    return;
}

// ===========================================================================
// Section 5: Const, Unary, Binary, Cast, Slice, Aggregate & Tag/Extract Ops
// ===========================================================================

fn f64_bits_to_f32_bits(bits: u64) -> u32 {
    let sign = ((bits >> 32_u64) & 0x80000000_u64).trunc.[u32]();
    let exp = ((bits >> 52_u64) & 0x7FF_u64).trunc.[i32]();
    let frac = bits & 0x000FFFFFFFFFFFFF_u64;
    if exp == 0x7FF_i32 {
        if frac != 0_u64 {
            let payload = (frac >> 29_u64).trunc.[u32]();
            return sign | 0x7F800000_u32 | (if payload == 0_u32 { 1_u32 } else { payload });
        }
        return sign | 0x7F800000_u32;
    }
    if exp == 0_i32 {
        return sign;
    }
    let unbiased = exp -% 1023_i32;
    if unbiased > 127_i32 {
        return sign | 0x7F800000_u32;
    }
    if unbiased < -149_i32 {
        return sign;
    }
    if unbiased < -126_i32 {
        let full = frac | 0x0010000000000000_u64;
        let shift = (((-126_i32 -% unbiased).bitcast.[u32]() +% 29_u32).widen.[u64]()) & 63_u64;
        let mant = (full >> shift).trunc.[u32]();
        let rem = full & ((1_u64 <<% shift) -% 1_u64);
        let half = 1_u64 <<% (shift -% 1_u64);
        let round: u32 = if rem > half || (rem == half && (mant & 1_u32) != 0_u32) { 1_u32 } else { 0_u32 };
        return sign | (mant +% round);
    }
    let f_exp = ((unbiased +% 127_i32).bitcast.[u32]()) <<% 23_u32;
    let mant = (frac >> 29_u64).trunc.[u32]();
    let rem = frac & 0x1FFFFFFF_u64;
    let round: u32 = if rem > 0x10000000_u64 || (rem == 0x10000000_u64 && (mant & 1_u32) != 0_u32) {
        1_u32
    } else {
        0_u32
    };
    return sign | (f_exp +% mant +% round);
}

fn cg_emit_const_scalar_u64(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    val: u64,
) -> !OutOfMemory {
    let ty = eir_prog.fn_val_ty(cg.fn_id, dst);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return;
    }
    let loc = cg_val_loc(cg, dst);
    if loc.kind == .Reg {
        try cg.buf.mov_ri64(alloc, loc.reg, val);
        if lay.size < 8_usize {
            let signed = env.is_signed_int(ty);
            if signed || val >= (1_u64 <<% (lay.size *% 8_usize).trunc.[u64]()) {
                try cg.buf.extend_reg(alloc, loc.reg, loc.reg, (lay.size *% 8_usize).trunc.[u8](), signed);
            }
        }
    } else {
        try cg.buf.mov_ri64(alloc, .Rax, val);
        let bytes = if lay.size <= 8_usize { lay.size } else { 8_usize };
        try cg.buf.store_mem(alloc, .Rbp, loc.stack_off, .Rax, bytes);
    }
    return;
}

fn cg_emit_const(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    const_id: u32,
    ty: types.TyId,
) -> !OutOfMemory {
    let c = eir_prog.get_const(const_id) orelse {
        return;
    };
    let lay = env.x64_layout(ty);
    match c.kind {
        .Void => {}
        .Bool => {
            let v: u64 = if c.bool_val { 1_u64 } else { 0_u64 };
            try cg_emit_const_scalar_u64(alloc, cg, eir_prog, env, dst, v);
        }
        .Char => {
            try cg_emit_const_scalar_u64(alloc, cg, eir_prog, env, dst, c.aux_u32.widen.[u64]());
        }
        .Int => {
            if lay.size == 16_usize {
                let off = cg_val_stack_off(cg, dst);
                try cg.buf.mov_ri64(alloc, .Rax, c.int_val.lo);
                try cg.buf.store_mem(alloc, .Rbp, off, .Rax, 8_usize);
                try cg.buf.mov_ri64(alloc, .Rax, c.int_val.hi.bitcast.[u64]());
                try cg.buf.store_mem(alloc, .Rbp, off +% 8_i32, .Rax, 8_usize);
            } else {
                try cg_emit_const_scalar_u64(alloc, cg, eir_prog, env, dst, c.int_val.lo);
            }
        }
        .Float => {
            let flt_bytes = eir_prog.bytes_slice(c.bytes);
            let fval = parse_f64_lit(flt_bytes);
            let f64_bits = fval.bitcast.[u64]();
            let n = env.get(ty);
            if n.kind == .Float && n.u8_val == 64_u8 {
                let off = cg_val_stack_off(cg, dst);
                try cg.buf.mov_ri64(alloc, .Rax, f64_bits);
                try cg.buf.store_mem(alloc, .Rbp, off, .Rax, 8_usize);
            } else if n.kind == .Float && n.u8_val == 16_u8 {
                let f32_b = f64_bits_to_f32_bits(f64_bits);
                let f16_b = f32_bits_to_f16_bits(f32_b);
                try cg.buf.mov_ri64(alloc, .Rax, f16_b.widen.[u64]());
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            } else {
                let off = cg_val_stack_off(cg, dst);
                let f32_b = f64_bits_to_f32_bits(f64_bits);
                try cg.buf.mov_ri64(alloc, .Rax, f32_b.widen.[u64]());
                try cg.buf.store_mem(alloc, .Rbp, off, .Rax, 4_usize);
            }
        }
        .Str => {
            let bytes = eir_prog.bytes_slice(c.bytes);
            let ro_sym = try cg_intern_rodata(alloc, cg, interner, bytes, 1_u32);
            let off = cg_val_stack_off(cg, dst);
            try cg.buf.lea_rip_sym(alloc, .Rax, ro_sym, 0_i64);
            try cg.buf.store_mem(alloc, .Rbp, off, .Rax, 8_usize);
            try cg.buf.mov_ri64(alloc, .Rax, bytes.len.widen.[u64]());
            try cg.buf.store_mem(alloc, .Rbp, off +% 8_i32, .Rax, 8_usize);
        }
        .Bytes => {
            let bytes = eir_prog.bytes_slice(c.bytes);
            let ro_sym = try cg_intern_rodata(alloc, cg, interner, bytes, 4_u32);
            let off = cg_val_stack_off(cg, dst);
            try cg.buf.lea_rip_sym(alloc, .Rax, ro_sym, 0_i64);
            try cg.buf.store_mem(alloc, .Rbp, off, .Rax, 8_usize);
            try cg.buf.mov_ri64(alloc, .Rax, bytes.len.widen.[u64]());
            try cg.buf.store_mem(alloc, .Rbp, off +% 8_i32, .Rax, 8_usize);
        }
        .Null => {
            try cg_emit_opt_null(alloc, cg, eir_prog, env, dst, ty);
        }
        .EnumTag => {
            try cg.buf.mov_ri64(alloc, .Rax, c.int_val.lo);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .ErrorTag => {
            try cg.buf.mov_ri64(alloc, .Rax, c.aux_u32.widen.[u64]());
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .FnRef => {
            let def_id = c.aux_u32;
            let thunk_sym = try intern_sym_u64(alloc, interner, "eon_fnref_thunk_", def_id.widen.[u64]());
            try cg.fn_ref_thunks.push(alloc, FnRefThunkReq.{ thunk_sym: thunk_sym, target_def: def_id });
            let off = cg_val_stack_off(cg, dst);
            try cg.buf.lea_rip_sym(alloc, .Rax, thunk_sym, 0_i64);
            try cg.buf.store_mem(alloc, .Rbp, off, .Rax, 8_usize);
            if lay.size >= 16_usize {
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, off +% 8_i32, .Rax, 8_usize);
            }
        }
        .ConstDef => {
            try cg_emit_const_def(alloc, cg, eir_prog, env, ct, interner, dst, c.aux_u32, ty);
        }
    }
    return;
}

fn cg_emit_const_def(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    def_id: u32,
    ty: types.TyId,
) -> !OutOfMemory {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize {
        return;
    }
    if let val_id = ct.get_const_val(def_id) {
        var enc = try col.DynBuf.[u8].init(alloc, if lay.size > 8_usize { lay.size } else { 8_usize });
        errdefer enc.destroy(alloc);
        let ok = try ctvm.encode_ct_val_bytes(alloc, ct, val_id, ty, env, &mut enc);
        if ok && enc.len() > 0_usize {
            let al = if lay.align == 0_usize { 1_usize } else { lay.align };
            let ro_sym = try cg_intern_rodata(alloc, cg, interner, enc.as_slice(), al.trunc.[u32]());
            try cg.buf.lea_rip_sym(alloc, .R8, ro_sym, 0_i64);
            try cg_load_val_from_mem(alloc, cg, eir_prog, env, dst, .R8, 0_i32, ty);
            enc.destroy(alloc);
            return;
        }
        enc.destroy(alloc);
    }
    if let cm = env.get_const(def_id) {
        if cm.has_int_val {
            try cg.buf.mov_ri64(alloc, .Rax, cm.int_val.lo);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            return;
        }
    }
    let loc = cg_val_loc(cg, dst);
    if loc.kind == .Reg {
        try cg.buf.xor_rr32(alloc, loc.reg, loc.reg);
    } else {
        try cg_emit_memzero(alloc, cg, .Rbp, loc.stack_off, lay.size);
    }
    return;
}

fn cg_emit_unary(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: ast.UnaryOp,
    operand: eir.EirValue,
    ty: types.TyId,
) -> !OutOfMemory {
    let n = env.get(ty);
    if n.kind == .Float && op == .Neg {
        if n.u8_val == 16_u8 {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, .Rax);
            try cg.buf.mov_ri64(alloc, .Rcx, 0x8000_u64);
            try cg.buf.xor_rr(alloc, .Rax, .Rcx);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            return;
        }
        try cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, .Xmm0);
        if n.u8_val == 64_u8 {
            try cg.buf.movq_r64_xmm(alloc, .Rax, .Xmm0);
            try cg.buf.mov_ri64(alloc, .Rcx, 0x8000000000000000_u64);
            try cg.buf.xor_rr(alloc, .Rax, .Rcx);
            try cg.buf.movq_xmm_r64(alloc, .Xmm0, .Rax);
        } else {
            try cg.buf.movd_r32_xmm(alloc, .Rax, .Xmm0);
            try cg.buf.mov_ri64(alloc, .Rcx, 0x80000000_u64);
            try cg.buf.xor_rr(alloc, .Rax, .Rcx);
            try cg.buf.movd_xmm_r32(alloc, .Xmm0, .Rax);
        }
        try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
        return;
    }
    if n.kind == .Vec && op == .Neg {
        let elem_ty = n.primary;
        let lanes = n.u8_val.widen.[usize]();
        let esz = env.x64_layout(elem_ty).size;
        let is_flt = env.get(elem_ty).kind == .Float;
        let dst_off = cg_val_stack_off(cg, dst);
        let src_off = cg_val_stack_off(cg, operand);
        var li: usize = 0_usize;
        while li < lanes {
            let ldisp = (li *% esz).trunc.[i32]();
            if is_flt {
                if esz == 8_usize {
                    try cg.buf.load_mem(alloc, .Rax, .Rbp, src_off +% ldisp, 8_usize, false);
                    try cg.buf.mov_ri64(alloc, .Rcx, 0x8000000000000000_u64);
                    try cg.buf.xor_rr(alloc, .Rax, .Rcx);
                    try cg.buf.store_mem(alloc, .Rbp, dst_off +% ldisp, .Rax, 8_usize);
                } else {
                    try cg.buf.load_mem(alloc, .Rax, .Rbp, src_off +% ldisp, 4_usize, false);
                    try cg.buf.mov_ri64(alloc, .Rcx, 0x80000000_u64);
                    try cg.buf.xor_rr(alloc, .Rax, .Rcx);
                    try cg.buf.store_mem(alloc, .Rbp, dst_off +% ldisp, .Rax, 4_usize);
                }
            } else {
                try cg.buf.load_mem(alloc, .Rax, .Rbp, src_off +% ldisp, esz, env.is_signed_int(elem_ty));
                try cg.buf.neg_r(alloc, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, dst_off +% ldisp, .Rax, esz);
            }
            li = li +% 1_usize;
        }
        return;
    }
    try cg_load_scalar_val(alloc, cg, eir_prog, env, operand, .Rax);
    match op {
        .Neg => {
            try cg.buf.neg_r(alloc, .Rax);
            try cg_emit_norm_subword(alloc, cg, env, ty, .Rax);
        }
        .Not => {
            try cg.buf.xor_ri32(alloc, .Rax, 1_i32);
            try cg.buf.and_ri32(alloc, .Rax, 1_i32);
        }
        .BitNot => {
            try cg.buf.not_r(alloc, .Rax);
            try cg_emit_norm_subword(alloc, cg, env, ty, .Rax);
        }
        _ => {}
    }
    try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
    return;
}

fn cg_emit_binary_float(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
) -> !OutOfMemory {
    let is_f16 = env.get(op_ty).u8_val == 16_u8;
    let is_f64 = env.get(op_ty).u8_val == 64_u8;
    if is_f16 {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, rhs, .Rdi);
        try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        try cg.buf.movss_store(alloc, .Rbp, cg.frame.temp_copy_off, .Xmm0);
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, lhs, .Rdi);
        try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        try cg.buf.movss_load(alloc, .Xmm1, .Rbp, cg.frame.temp_copy_off);
    } else {
        try cg_load_float_val(alloc, cg, eir_prog, env, interner, lhs, .Xmm0);
        try cg_load_float_val(alloc, cg, eir_prog, env, interner, rhs, .Xmm1);
    }
    match op {
        .Add => {
            try cg.buf.sse_bin(alloc, is_f64, 0x58_u8, .Xmm0, .Xmm1);
            try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
        }
        .Sub => {
            try cg.buf.sse_bin(alloc, is_f64, 0x5C_u8, .Xmm0, .Xmm1);
            try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
        }
        .Mul => {
            try cg.buf.sse_bin(alloc, is_f64, 0x59_u8, .Xmm0, .Xmm1);
            try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
        }
        .Div => {
            try cg.buf.sse_bin(alloc, is_f64, 0x5E_u8, .Xmm0, .Xmm1);
            try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
        }
        .Eq => {
            try cg.buf.ucomi(alloc, is_f64, .Xmm0, .Xmm1);
            try cg.buf.setcc(alloc, .E, .Rax);
            try cg.buf.setcc(alloc, .Np, .Rcx);
            try cg.buf.and_rr(alloc, .Rax, .Rcx);
            try cg.buf.extend_reg(alloc, .Rax, .Rax, 8_u8, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .NotEq => {
            try cg.buf.ucomi(alloc, is_f64, .Xmm0, .Xmm1);
            try cg.buf.setcc(alloc, .Ne, .Rax);
            try cg.buf.setcc(alloc, .P, .Rcx);
            try cg.buf.or_rr(alloc, .Rax, .Rcx);
            try cg.buf.extend_reg(alloc, .Rax, .Rax, 8_u8, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .Lt => {
            try cg.buf.ucomi(alloc, is_f64, .Xmm1, .Xmm0);
            try cg.buf.setcc(alloc, .A, .Rax);
            try cg.buf.extend_reg(alloc, .Rax, .Rax, 8_u8, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .LtEq => {
            try cg.buf.ucomi(alloc, is_f64, .Xmm1, .Xmm0);
            try cg.buf.setcc(alloc, .Ae, .Rax);
            try cg.buf.extend_reg(alloc, .Rax, .Rax, 8_u8, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .Gt => {
            try cg.buf.ucomi(alloc, is_f64, .Xmm0, .Xmm1);
            try cg.buf.setcc(alloc, .A, .Rax);
            try cg.buf.extend_reg(alloc, .Rax, .Rax, 8_u8, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .GtEq => {
            try cg.buf.ucomi(alloc, is_f64, .Xmm0, .Xmm1);
            try cg.buf.setcc(alloc, .Ae, .Rax);
            try cg.buf.extend_reg(alloc, .Rax, .Rax, 8_u8, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        _ => {}
    }
    return;
}

fn cg_emit_binary_vec(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
) -> !OutOfMemory {
    let vn = env.get(op_ty);
    let elem_ty = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem_ty);
    let esz = env.x64_layout(elem_ty).size;
    let dst_off = cg_val_stack_off(cg, dst);
    let lhs_off = cg_val_stack_off(cg, lhs);
    let rhs_off = cg_val_stack_off(cg, rhs);

    // SSE2 packed fast path for 16-byte float vectors: vec[f32,4] and vec[f64,2]
    if en.kind == .Float && ((en.u8_val == 32_u8 && lanes == 4_usize) || (en.u8_val == 64_u8 && lanes == 2_usize)) {
        var opc: u8 = 0_u8;
        match op {
            .Add => { opc = 0x58_u8; }
            .Sub => { opc = 0x5C_u8; }
            .Mul => { opc = 0x59_u8; }
            .Div => { opc = 0x5E_u8; }
            _ => {}
        }
        if opc != 0_u8 {
            try cg.buf.movups_load(alloc, .Xmm0, .Rbp, lhs_off);
            try cg.buf.movups_load(alloc, .Xmm1, .Rbp, rhs_off);
            if en.u8_val == 64_u8 {
                try cg.buf.sse_66_bin(alloc, opc, .Xmm0, .Xmm1);
            } else {
                try cg.buf.sse_ps_bin(alloc, opc, .Xmm0, .Xmm1);
            }
            try cg.buf.movups_store(alloc, .Rbp, dst_off, .Xmm0);
            return;
        }
    }

    // Scalar lane-by-lane loop for all other vector sizes/types/ops
    let signed = env.is_signed_int(elem_ty);
    var li: usize = 0_usize;
    while li < lanes {
        let ld = (li *% esz).trunc.[i32]();
        if en.kind == .Float {
            let is_f64 = en.u8_val == 64_u8;
            if is_f64 {
                try cg.buf.movsd_load(alloc, .Xmm0, .Rbp, lhs_off +% ld);
                try cg.buf.movsd_load(alloc, .Xmm1, .Rbp, rhs_off +% ld);
            } else {
                try cg.buf.movss_load(alloc, .Xmm0, .Rbp, lhs_off +% ld);
                try cg.buf.movss_load(alloc, .Xmm1, .Rbp, rhs_off +% ld);
            }
            match op {
                .Add => { try cg.buf.sse_bin(alloc, is_f64, 0x58_u8, .Xmm0, .Xmm1); }
                .Sub => { try cg.buf.sse_bin(alloc, is_f64, 0x5C_u8, .Xmm0, .Xmm1); }
                .Mul => { try cg.buf.sse_bin(alloc, is_f64, 0x59_u8, .Xmm0, .Xmm1); }
                .Div => { try cg.buf.sse_bin(alloc, is_f64, 0x5E_u8, .Xmm0, .Xmm1); }
                _ => {}
            }
            if is_f64 {
                try cg.buf.movsd_store(alloc, .Rbp, dst_off +% ld, .Xmm0);
            } else {
                try cg.buf.movss_store(alloc, .Rbp, dst_off +% ld, .Xmm0);
            }
        } else {
            try cg.buf.load_mem(alloc, .Rax, .Rbp, lhs_off +% ld, esz, signed);
            try cg.buf.load_mem(alloc, .Rcx, .Rbp, rhs_off +% ld, esz, signed);
            match op {
                .Add => { try cg.buf.add_rr(alloc, .Rax, .Rcx); }
                .AddWrap => { try cg.buf.add_rr(alloc, .Rax, .Rcx); }
                .Sub => { try cg.buf.sub_rr(alloc, .Rax, .Rcx); }
                .SubWrap => { try cg.buf.sub_rr(alloc, .Rax, .Rcx); }
                .Mul => { try cg.buf.imul_rr(alloc, .Rax, .Rcx); }
                .MulWrap => { try cg.buf.imul_rr(alloc, .Rax, .Rcx); }
                .BitAnd => { try cg.buf.and_rr(alloc, .Rax, .Rcx); }
                .BitOr => { try cg.buf.or_rr(alloc, .Rax, .Rcx); }
                .BitXor => { try cg.buf.xor_rr(alloc, .Rax, .Rcx); }
                .Shl => { try cg.buf.shl_cl(alloc, .Rax); }
                .ShlWrap => { try cg.buf.shl_cl(alloc, .Rax); }
                .Shr => {
                    if signed { try cg.buf.sar_cl(alloc, .Rax); } else { try cg.buf.shr_cl(alloc, .Rax); }
                }
                _ => {}
            }
            try cg.buf.store_mem(alloc, .Rbp, dst_off +% ld, .Rax, esz);
        }
        li = li +% 1_usize;
    }
    return;
}

fn cg_emit_binary_checked(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
) -> !OutOfMemory {
    let signed = env.is_signed_int(op_ty);
    let bits = env.int_bits(op_ty);
    let ok_sz = env.x64_layout(op_ty).size;
    let ok_off = env.eu_ok_offset(op_ty).trunc.[i32]();
    let dst_off = cg_val_stack_off(cg, dst);

    try cg_load_scalar_val(alloc, cg, eir_prog, env, lhs, .Rax);
    try cg_load_scalar_val(alloc, cg, eir_prog, env, rhs, .Rcx);

    let l_ovf = try cg.buf.new_label(alloc);
    let l_done = try cg.buf.new_label(alloc);
    let bnds = types.int_bounds(env.get(op_ty));

    if op == .DivCheck || op == .ModCheck {
        let l_div_zero = try cg.buf.new_label(alloc);
        try cg.buf.test_rr(alloc, .Rcx, .Rcx);
        try cg.buf.jcc_label(alloc, .E, l_div_zero);
        if signed {
            let l_ok_div = try cg.buf.new_label(alloc);
            try cg.buf.mov_ri64(alloc, .Rdx, bnds.min.lo);
            try cg.buf.cmp_rr(alloc, .Rax, .Rdx);
            try cg.buf.jcc_label(alloc, .Ne, l_ok_div);
            try cg.buf.cmp_ri32(alloc, .Rcx, -1_i32);
            try cg.buf.jcc_label(alloc, .E, l_ovf);
            cg.buf.bind_label(l_ok_div);
            try cg.buf.cqo(alloc);
            try cg.buf.idiv_r(alloc, .Rcx);
        } else {
            try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
            try cg.buf.div_r(alloc, .Rcx);
        }
        let res_reg: x64_asm.Reg = if op == .DivCheck { .Rax } else { .Rdx };
        try cg.buf.xor_rr32(alloc, .R8, .R8);
        try cg.buf.store_mem(alloc, .Rbp, dst_off, .R8, 4_usize);
        try cg.buf.store_mem(alloc, .Rbp, dst_off +% ok_off, res_reg, ok_sz);
        try cg.buf.jmp_label(alloc, l_done);
        cg.buf.bind_label(l_div_zero);
        // ArithError.DivByZero = 2
        try cg.buf.mov_ri64(alloc, .R8, 2_u64);
        try cg.buf.store_mem(alloc, .Rbp, dst_off, .R8, 4_usize);
        try cg.buf.jmp_label(alloc, l_done);
    } else if bits < 64_u8 {
        if !signed && op == .SubCheck {
            try cg.buf.sub_rr(alloc, .Rax, .Rcx);
            try cg.buf.jcc_label(alloc, .B, l_ovf);
        } else {
            match op {
                .AddCheck => { try cg.buf.add_rr(alloc, .Rax, .Rcx); }
                .SubCheck => { try cg.buf.sub_rr(alloc, .Rax, .Rcx); }
                .MulCheck => { try cg.buf.imul_rr(alloc, .Rax, .Rcx); }
                _ => {}
            }
            if signed {
                try cg.buf.mov_ri64(alloc, .Rdx, bnds.min.lo);
                try cg.buf.cmp_rr(alloc, .Rax, .Rdx);
                try cg.buf.jcc_label(alloc, .L, l_ovf);
            }
            try cg.buf.mov_ri64(alloc, .Rdx, bnds.max.lo);
            try cg.buf.cmp_rr(alloc, .Rax, .Rdx);
            try cg.buf.jcc_label(alloc, if signed { .G } else { .A }, l_ovf);
        }
        try cg.buf.xor_rr32(alloc, .R8, .R8);
        try cg.buf.store_mem(alloc, .Rbp, dst_off, .R8, 4_usize);
        try cg.buf.store_mem(alloc, .Rbp, dst_off +% ok_off, .Rax, ok_sz);
        try cg.buf.jmp_label(alloc, l_done);
    } else {
        if op == .AddCheck {
            try cg.buf.add_rr(alloc, .Rax, .Rcx);
            try cg.buf.jcc_label(alloc, if signed { .O } else { .B }, l_ovf);
        } else if op == .SubCheck {
            try cg.buf.sub_rr(alloc, .Rax, .Rcx);
            try cg.buf.jcc_label(alloc, if signed { .O } else { .B }, l_ovf);
        } else if op == .MulCheck {
            if signed {
                try cg.buf.imul_rr(alloc, .Rax, .Rcx);
                try cg.buf.jcc_label(alloc, .O, l_ovf);
            } else {
                try cg.buf.mul_r(alloc, .Rcx);
                try cg.buf.jcc_label(alloc, .O, l_ovf);
            }
        }
        try cg.buf.xor_rr32(alloc, .R8, .R8);
        try cg.buf.store_mem(alloc, .Rbp, dst_off, .R8, 4_usize);
        try cg.buf.store_mem(alloc, .Rbp, dst_off +% ok_off, .Rax, ok_sz);
        try cg.buf.jmp_label(alloc, l_done);
    }

    cg.buf.bind_label(l_ovf);
    // ArithError.Overflow = 1
    try cg.buf.mov_ri64(alloc, .R8, 1_u64);
    try cg.buf.store_mem(alloc, .Rbp, dst_off, .R8, 4_usize);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_binary_sat(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
) -> !OutOfMemory {
    let signed = env.is_signed_int(op_ty);
    let bits = env.int_bits(op_ty);
    let bnds = types.int_bounds(env.get(op_ty));
    try cg_load_scalar_val(alloc, cg, eir_prog, env, lhs, .Rax);
    try cg_load_scalar_val(alloc, cg, eir_prog, env, rhs, .Rcx);

    let l_done = try cg.buf.new_label(alloc);
    if bits < 64_u8 {
        if !signed && op == .SubSat {
            try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
            try cg.buf.sub_rr(alloc, .Rax, .Rcx);
            try cg.buf.cmovcc(alloc, .B, .Rax, .Rdx);
        } else {
            match op {
                .AddSat => { try cg.buf.add_rr(alloc, .Rax, .Rcx); }
                .SubSat => { try cg.buf.sub_rr(alloc, .Rax, .Rcx); }
                .MulSat => { try cg.buf.imul_rr(alloc, .Rax, .Rcx); }
                _ => {}
            }
            if signed {
                try cg.buf.mov_ri64(alloc, .Rdx, bnds.min.lo);
                try cg.buf.cmp_rr(alloc, .Rax, .Rdx);
                try cg.buf.cmovcc(alloc, .L, .Rax, .Rdx);
            }
            try cg.buf.mov_ri64(alloc, .Rdx, bnds.max.lo);
            try cg.buf.cmp_rr(alloc, .Rax, .Rdx);
            try cg.buf.cmovcc(alloc, if signed { .G } else { .A }, .Rax, .Rdx);
        }
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        return;
    }

    if !signed {
        if op == .AddSat {
            try cg.buf.add_rr(alloc, .Rax, .Rcx);
            try cg.buf.jcc_label(alloc, .Ae, l_done);
            try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFFFFFFFFFF_u64);
        } else if op == .SubSat {
            try cg.buf.sub_rr(alloc, .Rax, .Rcx);
            try cg.buf.jcc_label(alloc, .Ae, l_done);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
        } else {
            try cg.buf.mul_r(alloc, .Rcx);
            try cg.buf.jcc_label(alloc, .Ae, l_done);
            try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFFFFFFFFFF_u64);
        }
        cg.buf.bind_label(l_done);
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        return;
    }

    // Signed 64-bit saturating add / sub / mul
    try cg.buf.mov_rr(alloc, .R8, .Rax);
    try cg.buf.mov_rr(alloc, .R9, .Rcx);
    if op == .AddSat {
        try cg.buf.add_rr(alloc, .Rax, .Rcx);
        try cg.buf.jcc_label(alloc, .No, l_done);
        try cg.buf.mov_ri64(alloc, .Rax, 0x7FFFFFFFFFFFFFFF_u64);
        try cg.buf.mov_ri64(alloc, .Rdx, 0x8000000000000000_u64);
        try cg.buf.test_rr(alloc, .R8, .R8);
        try cg.buf.cmovcc(alloc, .S, .Rax, .Rdx);
    } else if op == .SubSat {
        try cg.buf.sub_rr(alloc, .Rax, .Rcx);
        try cg.buf.jcc_label(alloc, .No, l_done);
        try cg.buf.mov_ri64(alloc, .Rax, 0x7FFFFFFFFFFFFFFF_u64);
        try cg.buf.mov_ri64(alloc, .Rdx, 0x8000000000000000_u64);
        try cg.buf.test_rr(alloc, .R8, .R8);
        try cg.buf.cmovcc(alloc, .S, .Rax, .Rdx);
    } else {
        try cg.buf.imul_rr(alloc, .Rax, .Rcx);
        try cg.buf.jcc_label(alloc, .No, l_done);
        try cg.buf.xor_rr(alloc, .R8, .R9);
        try cg.buf.mov_ri64(alloc, .Rax, 0x7FFFFFFFFFFFFFFF_u64);
        try cg.buf.mov_ri64(alloc, .Rdx, 0x8000000000000000_u64);
        try cg.buf.test_rr(alloc, .R8, .R8);
        try cg.buf.cmovcc(alloc, .S, .Rax, .Rdx);
    }
    cg.buf.bind_label(l_done);
    try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
    return;
}

fn cg_emit_binary(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    dst_ty: types.TyId,
    op_ty: types.TyId,
) -> !OutOfMemory {
    let op_node = env.get(op_ty);
    if op_node.kind == .Float {
        try cg_emit_binary_float(alloc, cg, eir_prog, env, interner, dst, op, lhs, rhs, op_ty);
        return;
    }
    if op_node.kind == .Vec {
        try cg_emit_binary_vec(alloc, cg, env, dst, op, lhs, rhs, op_ty);
        return;
    }
    if op == .AddCheck || op == .SubCheck || op == .MulCheck || op == .DivCheck || op == .ModCheck {
        try cg_emit_binary_checked(alloc, cg, eir_prog, env, dst, op, lhs, rhs, op_ty);
        return;
    }
    if op == .AddSat || op == .SubSat || op == .MulSat {
        try cg_emit_binary_sat(alloc, cg, eir_prog, env, dst, op, lhs, rhs, op_ty);
        return;
    }

    let signed = env.is_signed_int(op_ty);
    let op_lay = env.x64_layout(op_ty);
    let rhs_imm_opt = if env.is_concrete_integer(op_ty) { cg.frame.val_imm32(rhs) } else { null };
    var use_imm = false;
    var rhs_imm: i32 = 0_i32;
    if let im = rhs_imm_opt {
        if o0_binop_folds_rhs_imm32(op, im) {
            use_imm = true;
            rhs_imm = im;
        }
    }

    try cg_load_scalar_val(alloc, cg, eir_prog, env, lhs, .Rax);
    var rhs_reg: x64_asm.Reg = .Rcx;
    if !use_imm {
        let rloc = cg_val_loc(cg, rhs);
        let need_rcx = op == .Shl || op == .ShlWrap || op == .Shr;
        if !need_rcx && rloc.kind == .Reg && op_lay.size == 8_usize {
            rhs_reg = rloc.reg;
        } else {
            try cg_load_scalar_val(alloc, cg, eir_prog, env, rhs, .Rcx);
        }
    }

    match op {
        .Add => {
            if use_imm { try cg.buf.add_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.add_rr(alloc, .Rax, rhs_reg); }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .AddWrap => {
            if use_imm { try cg.buf.add_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.add_rr(alloc, .Rax, rhs_reg); }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .Sub => {
            if use_imm { try cg.buf.sub_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.sub_rr(alloc, .Rax, rhs_reg); }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .SubWrap => {
            if use_imm { try cg.buf.sub_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.sub_rr(alloc, .Rax, rhs_reg); }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .Mul => {
            try cg.buf.imul_rr(alloc, .Rax, rhs_reg);
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .MulWrap => {
            try cg.buf.imul_rr(alloc, .Rax, rhs_reg);
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .Div => {
            if signed {
                try cg.buf.cqo(alloc);
                try cg.buf.idiv_r(alloc, rhs_reg);
            } else {
                try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
                try cg.buf.div_r(alloc, rhs_reg);
            }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .Mod => {
            if signed {
                try cg.buf.cqo(alloc);
                try cg.buf.idiv_r(alloc, rhs_reg);
            } else {
                try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
                try cg.buf.div_r(alloc, rhs_reg);
            }
            try cg.buf.mov_rr(alloc, .Rax, .Rdx);
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .BitAnd => {
            if use_imm { try cg.buf.and_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.and_rr(alloc, .Rax, rhs_reg); }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .BitOr => {
            if use_imm { try cg.buf.or_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.or_rr(alloc, .Rax, rhs_reg); }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .BitXor => {
            if use_imm { try cg.buf.xor_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.xor_rr(alloc, .Rax, rhs_reg); }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .And => {
            try cg.buf.and_rr(alloc, .Rax, rhs_reg);
            try cg.buf.and_ri32(alloc, .Rax, 1_i32);
        }
        .Or => {
            try cg.buf.or_rr(alloc, .Rax, rhs_reg);
            try cg.buf.and_ri32(alloc, .Rax, 1_i32);
        }
        .Shl => {
            if use_imm {
                try cg.buf.shl_imm(alloc, .Rax, rhs_imm.trunc.[u8]());
            } else {
                try cg.buf.shl_cl(alloc, .Rax);
            }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .ShlWrap => {
            let bits = env.int_bits(op_ty);
            if use_imm {
                let sh = if bits > 0_u8 && bits < 64_u8 {
                    rhs_imm.trunc.[u8]() & (bits -% 1_u8)
                } else {
                    rhs_imm.trunc.[u8]() & 63_u8
                };
                try cg.buf.shl_imm(alloc, .Rax, sh);
            } else {
                if bits > 0_u8 && bits < 64_u8 {
                    try cg.buf.and_ri32(alloc, .Rcx, (bits -% 1_u8).widen.[i32]());
                }
                try cg.buf.shl_cl(alloc, .Rax);
            }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .Shr => {
            if use_imm {
                if signed {
                    try cg.buf.sar_imm(alloc, .Rax, rhs_imm.trunc.[u8]());
                } else {
                    try cg.buf.shr_imm(alloc, .Rax, rhs_imm.trunc.[u8]());
                }
            } else {
                if signed {
                    try cg.buf.sar_cl(alloc, .Rax);
                } else {
                    try cg.buf.shr_cl(alloc, .Rax);
                }
            }
            try cg_emit_norm_subword(alloc, cg, env, dst_ty, .Rax);
        }
        .Eq => {
            if use_imm {
                if rhs_imm == 0_i32 { try cg.buf.test_rr(alloc, .Rax, .Rax); } else { try cg.buf.cmp_ri32(alloc, .Rax, rhs_imm); }
            } else {
                try cg.buf.cmp_rr(alloc, .Rax, rhs_reg);
            }
            try cg.buf.setcc(alloc, .E, .Rax);
        }
        .NotEq => {
            if use_imm {
                if rhs_imm == 0_i32 { try cg.buf.test_rr(alloc, .Rax, .Rax); } else { try cg.buf.cmp_ri32(alloc, .Rax, rhs_imm); }
            } else {
                try cg.buf.cmp_rr(alloc, .Rax, rhs_reg);
            }
            try cg.buf.setcc(alloc, .Ne, .Rax);
        }
        .Lt => {
            if use_imm { try cg.buf.cmp_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.cmp_rr(alloc, .Rax, rhs_reg); }
            try cg.buf.setcc(alloc, if signed { .L } else { .B }, .Rax);
        }
        .LtEq => {
            if use_imm { try cg.buf.cmp_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.cmp_rr(alloc, .Rax, rhs_reg); }
            try cg.buf.setcc(alloc, if signed { .Le } else { .Be }, .Rax);
        }
        .Gt => {
            if use_imm { try cg.buf.cmp_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.cmp_rr(alloc, .Rax, rhs_reg); }
            try cg.buf.setcc(alloc, if signed { .G } else { .A }, .Rax);
        }
        .GtEq => {
            if use_imm { try cg.buf.cmp_ri32(alloc, .Rax, rhs_imm); } else { try cg.buf.cmp_rr(alloc, .Rax, rhs_reg); }
            try cg.buf.setcc(alloc, if signed { .Ge } else { .Ae }, .Rax);
        }
        _ => {}
    }
    try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
    return;
}

fn cg_emit_cast(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    kind: cfg_ir.CastKind,
    operand: eir.EirValue,
    from_ty: types.TyId,
    to_ty: types.TyId,
) -> !OutOfMemory {
    let from_n = env.get(from_ty);
    let to_n = env.get(to_ty);
    match kind {
        .Widen => {
            if from_n.kind == .Float && to_n.kind == .Float {
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, .Xmm0);
                if from_n.u8_val != 64_u8 && to_n.u8_val == 64_u8 {
                    try cg.buf.cvtss2sd(alloc, .Xmm0, .Xmm0);
                }
                try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
                return;
            }
            try cg_load_scalar_val(alloc, cg, eir_prog, env, operand, .Rax);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .Trunc => {
            if from_n.kind == .Float && to_n.kind == .Float {
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, .Xmm0);
                if from_n.u8_val == 64_u8 && to_n.u8_val != 64_u8 {
                    try cg.buf.cvtsd2ss(alloc, .Xmm0, .Xmm0);
                }
                try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
                return;
            }
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, .Rax);
            try cg_emit_norm_subword(alloc, cg, env, to_ty, .Rax);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .Clamp => {
            try cg_load_scalar_val(alloc, cg, eir_prog, env, operand, .Rax);
            let src_signed = env.is_signed_int(from_ty);
            let dst_signed = env.is_signed_int(to_ty);
            let bnds = types.int_bounds(to_n);
            if src_signed && !dst_signed {
                try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
                try cg.buf.test_rr(alloc, .Rax, .Rax);
                try cg.buf.cmovcc(alloc, .S, .Rax, .Rdx);
                if env.int_bits(to_ty) < 64_u8 {
                    try cg.buf.mov_ri64(alloc, .Rdx, bnds.max.lo);
                    try cg.buf.cmp_rr(alloc, .Rax, .Rdx);
                    try cg.buf.cmovcc(alloc, .A, .Rax, .Rdx);
                }
            } else {
                try cg.buf.mov_ri64(alloc, .Rdx, bnds.min.lo);
                try cg.buf.cmp_rr(alloc, .Rax, .Rdx);
                try cg.buf.cmovcc(alloc, if src_signed { .L } else { .B }, .Rax, .Rdx);
                try cg.buf.mov_ri64(alloc, .Rdx, bnds.max.lo);
                try cg.buf.cmp_rr(alloc, .Rax, .Rdx);
                try cg.buf.cmovcc(alloc, if src_signed { .G } else { .A }, .Rax, .Rdx);
            }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .ToFloat => {
            let is_f64 = to_n.u8_val == 64_u8;
            try cg_load_scalar_val(alloc, cg, eir_prog, env, operand, .Rax);
            try cg.buf.cvtsi2f(alloc, is_f64, .Xmm0, .Rax);
            try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
        }
        .TruncToInt => {
            let is_f64 = from_n.u8_val == 64_u8;
            try cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, .Xmm0);
            try cg.buf.cvttf2si(alloc, is_f64, .Rax, .Xmm0);
            try cg_emit_norm_subword(alloc, cg, env, to_ty, .Rax);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .Bitcast => {
            let sz = env.x64_layout(to_ty).size;
            if sz == 0_usize {
                return;
            }
            let dloc = cg_val_loc(cg, dst);
            let sloc = cg_val_loc(cg, operand);
            if dloc.kind == .Reg || sloc.kind == .Reg {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, .Rax);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            } else {
                try cg_emit_copy_mem(alloc, cg, .Rbp, dloc.stack_off, .Rbp, sloc.stack_off, sz);
            }
        }
        .AsU64 => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, .Rax);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .MutToConst => {
            try cg_copy_val_to_val(alloc, cg, eir_prog, env, dst, operand);
        }
        .ArrayBorrowToSlice => {
            let mut_arr_ty = from_n.primary;
            let arr_len = env.get(mut_arr_ty).u64_val;
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, .Rax);
            let dst_off = cg_val_stack_off(cg, dst);
            try cg.buf.store_mem(alloc, .Rbp, dst_off, .Rax, 8_usize);
            try cg.buf.mov_ri64(alloc, .Rax, arr_len);
            try cg.buf.store_mem(alloc, .Rbp, dst_off +% 8_i32, .Rax, 8_usize);
        }
        .WrapOptional => {
            let inner_ty = to_n.primary;
            let niche = env.opt_niche(inner_ty);
            if niche.kind != .None {
                try cg_copy_val_to_val(alloc, cg, eir_prog, env, dst, operand);
            } else {
                let dst_off = cg_val_stack_off(cg, dst);
                let val_off = env.opt_val_offset(inner_ty).trunc.[i32]();
                try cg.buf.mov_ri64(alloc, .Rax, 1_u64);
                try cg.buf.store_mem(alloc, .Rbp, dst_off, .Rax, 1_usize);
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off +% val_off, operand, inner_ty);
            }
        }
        .WrapOk => {
            let ok_ty = to_n.primary;
            let dst_off = cg_val_stack_off(cg, dst);
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, dst_off, .Rax, 4_usize);
            if env.x64_layout(ok_ty).size > 0_usize {
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off +% ok_off, operand, ok_ty);
            }
        }
        .WrapErr => {
            let dst_off = cg_val_stack_off(cg, dst);
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, dst_off, .Rax, 4_usize);
        }
    }
    return;
}

fn cg_emit_slice(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    base: eir.EirValue,
    lo_val: eir.EirValue,
    hi_val: eir.EirValue,
    base_ty: types.TyId,
) -> !OutOfMemory {
    let bn = env.get(base_ty);
    var elem_sz: usize = 1_usize;
    if bn.kind == .Array {
        elem_sz = env.x64_layout(bn.primary).size;
        try cg_val_addr_into(alloc, cg, base, .R8);
        try cg.buf.mov_ri64(alloc, .R9, bn.u64_val);
    } else if bn.kind == .Borrow && bn.borrow_kind == .Single {
        let inner = env.get(bn.primary);
        if inner.kind == .Array {
            elem_sz = env.x64_layout(inner.primary).size;
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, base, .R8);
            try cg.buf.mov_ri64(alloc, .R9, inner.u64_val);
        }
    } else if bn.kind == .Borrow && bn.borrow_kind == .Slice {
        elem_sz = env.x64_layout(bn.primary).size;
        let boff = cg_val_stack_off(cg, base);
        try cg.buf.load_mem(alloc, .R8, .Rbp, boff, 8_usize, false);
        try cg.buf.load_mem(alloc, .R9, .Rbp, boff +% 8_i32, 8_usize, false);
    } else {
        // Str / *str
        elem_sz = 1_usize;
        let boff = cg_val_stack_off(cg, base);
        try cg.buf.load_mem(alloc, .R8, .Rbp, boff, 8_usize, false);
        try cg.buf.load_mem(alloc, .R9, .Rbp, boff +% 8_i32, 8_usize, false);
    }

    if lo_val != eir.EIR_NONE {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, lo_val, .Rcx);
    } else {
        try cg.buf.xor_rr32(alloc, .Rcx, .Rcx);
    }
    if hi_val != eir.EIR_NONE {
        try cg_load_scalar_raw(alloc, cg, eir_prog, env, hi_val, .Rdx);
    } else {
        try cg.buf.mov_rr(alloc, .Rdx, .R9);
    }
    // new_len = hi - lo, new_ptr = base_ptr + lo * elem_sz
    try cg.buf.sub_rr(alloc, .Rdx, .Rcx);
    if elem_sz > 1_usize {
        try cg.buf.mov_ri64(alloc, .R11, elem_sz.widen.[u64]());
        try cg.buf.imul_rr(alloc, .Rcx, .R11);
    }
    try cg.buf.add_rr(alloc, .R8, .Rcx);

    let dst_off = cg_val_stack_off(cg, dst);
    try cg.buf.store_mem(alloc, .Rbp, dst_off, .R8, 8_usize);
    try cg.buf.store_mem(alloc, .Rbp, dst_off +% 8_i32, .Rdx, 8_usize);
    return;
}

fn o0_is_dense_scalar_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    let k = env.get(ty).kind;
    return k == .Int || k == .Float || k == .Bool || k == .Char || k == .Enum || k == .RawPtr || k == .FnPtr;
}

fn o0_struct_has_no_padding(env: *types.TypeEnv, dst_ty: types.TyId, n_elems: usize, total_size: usize) -> bool {
    var expected: usize = 0_usize;
    var i: usize = 0_usize;
    while i < n_elems {
        let foff = env.struct_field_offset(dst_ty, i);
        if foff.offset != expected || !o0_is_dense_scalar_ty(env, foff.ty) {
            return false;
        }
        expected = expected +% env.x64_layout(foff.ty).size;
        i = i +% 1_usize;
    }
    return expected == total_size;
}

fn cg_emit_aggregate(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    agg_id: u32,
    elems_range: ast.IdRange,
    dst_ty: types.TyId,
) -> !OutOfMemory {
    let agg = eir_prog.get_aggregate(agg_id) orelse {
        return;
    };
    let elems = eir_prog.vals_slice(elems_range);
    let dst_lay = env.x64_layout(dst_ty);
    if dst_lay.size == 0_usize {
        return;
    }
    let dst_loc = cg_val_loc(cg, dst);

    if agg.tag == .Bitfield {
        try cg.buf.xor_rr32(alloc, .R9, .R9);
        if let bm = env.get_bitfield(agg.def_id) {
            let mems = env.bitfield_members_range(bm.members);
            var i: usize = 0_usize;
            while i < elems.len && i < mems.len {
                let m = mems[i];
                let width = m.hi -% m.lo;
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, elems[i], .Rax);
                if width < 64_u8 {
                    let mask = (1_u64 <<% width.widen.[u64]()) -% 1_u64;
                    try cg.buf.mov_ri64(alloc, .Rcx, mask);
                    try cg.buf.and_rr(alloc, .Rax, .Rcx);
                }
                if m.lo > 0_u8 {
                    try cg.buf.shl_imm(alloc, .Rax, m.lo);
                }
                try cg.buf.or_rr(alloc, .R9, .Rax);
                i = i +% 1_usize;
            }
        }
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .R9);
        return;
    }

    let dst_off = dst_loc.stack_off;
    var skip_memzero = false;
    if agg.tag == .Struct || agg.tag == .AnonStruct || agg.tag == .Tuple {
        skip_memzero = o0_struct_has_no_padding(env, dst_ty, elems.len, dst_lay.size);
    } else if agg.tag == .Array || agg.tag == .Vec {
        let esz0 = env.x64_layout(agg.elem_ty).size;
        skip_memzero = o0_is_dense_scalar_ty(env, agg.elem_ty) && elems.len *% esz0 == dst_lay.size;
    }
    if dst_loc.kind == .Stack && !skip_memzero {
        try cg_emit_memzero(alloc, cg, .Rbp, dst_off, dst_lay.size);
    }

    match agg.tag {
        .Struct => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off +% foff.offset.trunc.[i32](), elems[i], foff.ty);
                i = i +% 1_usize;
            }
        }
        .AnonStruct => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off +% foff.offset.trunc.[i32](), elems[i], foff.ty);
                i = i +% 1_usize;
            }
        }
        .Tuple => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off +% foff.offset.trunc.[i32](), elems[i], foff.ty);
                i = i +% 1_usize;
            }
        }
        .PoolRow => {
            var i: usize = 0_usize;
            while i < elems.len {
                let foff = env.struct_field_offset(dst_ty, i);
                let is_link = env.is_link_or_opt_link(foff.ty);
                let ev_ty = eir_prog.fn_val_ty(cg.fn_id, elems[i]);
                let ev_sz = env.x64_layout(ev_ty).size;
                if !agg.is_slot_pool && is_link && ev_sz == 4_usize {
                    try cg_load_scalar_raw(alloc, cg, eir_prog, env, elems[i], .Rax);
                    try cg.buf.store_mem(alloc, .Rbp, dst_off +% foff.offset.trunc.[i32](), .Rax, 4_usize);
                    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                    try cg.buf.store_mem(alloc, .Rbp, dst_off +% foff.offset.trunc.[i32]() +% 4_i32, .Rax, 4_usize);
                } else {
                    let store_ty = if agg.is_slot_pool && is_link { ev_ty } else { foff.ty };
                    try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off +% foff.offset.trunc.[i32](), elems[i], store_ty);
                }
                i = i +% 1_usize;
            }
        }
        .Array => {
            let esz = env.x64_layout(agg.elem_ty).size;
            var i: usize = 0_usize;
            while i < elems.len {
                let fdisp = (i *% esz).trunc.[i32]();
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off +% fdisp, elems[i], agg.elem_ty);
                i = i +% 1_usize;
            }
        }
        .ArrayRepeat => {
            if elems.len > 0_usize {
                var is_zero_repeat = false;
                if env.is_concrete_integer(agg.elem_ty) {
                    if let im = cg.frame.val_imm32(elems[0_usize]) {
                        if im == 0_i32 {
                            is_zero_repeat = true;
                        }
                    }
                }
                if !is_zero_repeat {
                    let esz = env.x64_layout(agg.elem_ty).size;
                    let cnt = agg.count.trunc.[usize]();
                    if cnt <= 4_usize {
                        var i: usize = 0_usize;
                        while i < cnt {
                            try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off +% (i *% esz).trunc.[i32](), elems[0_usize], agg.elem_ty);
                            i = i +% 1_usize;
                        }
                    } else if esz == 8_usize && o0_is_dense_scalar_ty(env, agg.elem_ty) {
                        try cg_load_scalar_raw(alloc, cg, eir_prog, env, elems[0_usize], .Rax);
                        try cg.buf.lea_mem(alloc, .Rdi, .Rbp, dst_off);
                        try cg.buf.mov_ri64(alloc, .Rcx, agg.count);
                        try cg.buf.rep_stosq(alloc);
                    } else {
                        try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off, elems[0_usize], agg.elem_ty);
                        let l_lp = try cg.buf.new_label(alloc);
                        try cg.buf.lea_mem(alloc, .R8, .Rbp, dst_off);
                        try cg.buf.mov_ri64(alloc, .R9, 1_u64);
                        cg.buf.bind_label(l_lp);
                        try cg.buf.add_ri32(alloc, .R8, esz.trunc.[i32]());
                        try cg_emit_copy_mem(alloc, cg, .R8, 0_i32, .Rbp, dst_off, esz);
                        try cg.buf.add_ri32(alloc, .R9, 1_i32);
                        try cg.buf.mov_ri64(alloc, .R10, agg.count);
                        try cg.buf.cmp_rr(alloc, .R9, .R10);
                        try cg.buf.jcc_label(alloc, .B, l_lp);
                    }
                }
            }
        }
        .UnionVariant => {
            try cg.buf.mov_ri64(alloc, .Rax, agg.variant_idx.widen.[u64]());
            try cg.buf.store_mem(alloc, .Rbp, dst_off, .Rax, 4_usize);
            if elems.len > 0_usize {
                let pay_off = env.union_payload_offset(agg.def_id).trunc.[i32]();
                let pty = eir_prog.fn_val_ty(cg.fn_id, elems[0_usize]);
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off +% pay_off, elems[0_usize], pty);
            }
        }
        .Vec => {
            let esz = env.x64_layout(agg.elem_ty).size;
            var i: usize = 0_usize;
            while i < elems.len {
                let fdisp = (i *% esz).trunc.[i32]();
                try cg_store_val_to_mem(alloc, cg, eir_prog, env, .Rbp, dst_off +% fdisp, elems[i], agg.elem_ty);
                i = i +% 1_usize;
            }
        }
        _ => {}
    }
    return;
}

fn cg_emit_is_non_null(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    src: eir.EirValue,
    src_ty: types.TyId,
) -> !OutOfMemory {
    let inner = env.get(src_ty).primary;
    let niche = env.opt_niche(inner);
    let sloc = cg_val_loc(cg, src);
    match niche.kind {
        .IdBrand => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, src, .Rax);
            try cg.buf.mov_ri64(alloc, .Rcx, 0xFFFFFFFF_u64);
            try cg.buf.cmp_rr(alloc, .Rax, .Rcx);
            try cg.buf.setcc(alloc, .Ne, .Rax);
        }
        .GenId => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, src, .Rax);
            try cg.buf.shr_imm(alloc, .Rax, 32_u8);
            try cg.buf.test_rr32(alloc, .Rax, .Rax);
            try cg.buf.setcc(alloc, .Ne, .Rax);
        }
        .Link => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, src, .Rax);
            try cg.buf.shr_imm(alloc, .Rax, 32_u8);
            try cg.buf.test_rr32(alloc, .Rax, .Rax);
            try cg.buf.setcc(alloc, .Ne, .Rax);
        }
        .NullPtr => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, src, .Rax);
            try cg.buf.test_rr(alloc, .Rax, .Rax);
            try cg.buf.setcc(alloc, .Ne, .Rax);
        }
        .FatPtrNullFirst => {
            try cg.buf.load_mem(alloc, .Rax, .Rbp, sloc.stack_off, 8_usize, false);
            try cg.buf.test_rr(alloc, .Rax, .Rax);
            try cg.buf.setcc(alloc, .Ne, .Rax);
        }
        .SliceMaxLen => {
            try cg.buf.load_mem(alloc, .Rax, .Rbp, sloc.stack_off +% 8_i32, 8_usize, false);
            try cg.buf.mov_ri64(alloc, .Rcx, 0xFFFFFFFFFFFFFFFF_u64);
            try cg.buf.cmp_rr(alloc, .Rax, .Rcx);
            try cg.buf.setcc(alloc, .Ne, .Rax);
        }
        .BoolTag => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, src, .Rax);
            try cg.buf.cmp_ri32(alloc, .Rax, 2_i32);
            try cg.buf.setcc(alloc, .Ne, .Rax);
        }
        .ScalarSentinel => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, src, .Rax);
            try cg.buf.mov_ri64(alloc, .Rcx, niche.sentinel);
            try cg.buf.cmp_rr(alloc, .Rax, .Rcx);
            try cg.buf.setcc(alloc, .Ne, .Rax);
        }
        .None => {
            try cg.buf.load_mem(alloc, .Rax, .Rbp, sloc.stack_off, 1_usize, false);
            try cg.buf.test_rr(alloc, .Rax, .Rax);
            try cg.buf.setcc(alloc, .Ne, .Rax);
        }
    }
    try cg.buf.extend_reg(alloc, .Rax, .Rax, 8_u8, false);
    try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
    return;
}

fn cg_emit_unwrap_and_extract(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    inst: *eir.EirInst,
) -> !OutOfMemory {
    match inst.kind {
        .UnwrapOptional => {
            let inner_ty = inst.ty0;
            let niche = env.opt_niche(inner_ty);
            if niche.kind != .None {
                try cg_copy_val_to_val(alloc, cg, eir_prog, env, inst.dst, inst.v0);
            } else {
                let soff = cg_val_stack_off(cg, inst.v0);
                let voff = env.opt_val_offset(inner_ty).trunc.[i32]();
                try cg_load_val_from_mem(alloc, cg, eir_prog, env, inst.dst, .Rbp, soff +% voff, inner_ty);
            }
        }
        .UnwrapErrorOk => {
            let ok_ty = inst.ty0;
            if env.x64_layout(ok_ty).size > 0_usize {
                let soff = cg_val_stack_off(cg, inst.v0);
                let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
                try cg_load_val_from_mem(alloc, cg, eir_prog, env, inst.dst, .Rbp, soff +% ok_off, ok_ty);
            }
        }
        .UnwrapErrorErr => {
            let soff = cg_val_stack_off(cg, inst.v0);
            try cg.buf.load_mem(alloc, .Rax, .Rbp, soff, 4_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, .Rax);
        }
        .IsNonNull => {
            try cg_emit_is_non_null(alloc, cg, eir_prog, env, inst.dst, inst.v0, inst.ty1);
        }
        .IsError => {
            let soff = cg_val_stack_off(cg, inst.v0);
            try cg.buf.load_mem(alloc, .Rax, .Rbp, soff, 4_usize, false);
            try cg.buf.test_rr32(alloc, .Rax, .Rax);
            try cg.buf.setcc(alloc, .Ne, .Rax);
            try cg.buf.extend_reg(alloc, .Rax, .Rax, 8_u8, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, .Rax);
        }
        .MatchTag => {
            let src_n = env.get(inst.ty1);
            if src_n.kind == .Union || src_n.kind == .ErrorUnion {
                let soff = cg_val_stack_off(cg, inst.v0);
                try cg.buf.load_mem(alloc, .Rax, .Rbp, soff, 4_usize, false);
            } else {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, .Rax);
            }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, .Rax);
        }
        .FieldExtract => {
            let src_n = env.get(inst.ty1);
            if src_n.kind == .Union {
                let pay_off = env.union_payload_offset(src_n.primary).trunc.[i32]();
                let soff = cg_val_stack_off(cg, inst.v0);
                try cg_load_val_from_mem(alloc, cg, eir_prog, env, inst.dst, .Rbp, soff +% pay_off, inst.ty0);
                return;
            }
            if src_n.kind == .Bitfield {
                let bf = lookup_bitfield_member(env, src_n.primary, inst.aux0.widen.[usize]());
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, .Rax);
                if bf.lo > 0_u8 {
                    try cg.buf.shr_imm(alloc, .Rax, bf.lo);
                }
                if bf.width < 64_u8 {
                    let mask = (1_u64 <<% bf.width.widen.[u64]()) -% 1_u64;
                    try cg.buf.mov_ri64(alloc, .Rcx, mask);
                    try cg.buf.and_rr(alloc, .Rax, .Rcx);
                    if env.is_signed_int(bf.member_ty) {
                        let sh = 64_u8 -% bf.width;
                        try cg.buf.shl_imm(alloc, .Rax, sh);
                        try cg.buf.sar_imm(alloc, .Rax, sh);
                    }
                }
                try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, .Rax);
                return;
            }
            let foff = env.struct_field_offset(inst.ty1, inst.aux0.widen.[usize]());
            let sloc = cg_val_loc(cg, inst.v0);
            if sloc.kind == .Reg {
                try cg.buf.mov_rr(alloc, .Rax, sloc.reg);
                if foff.offset > 0_usize {
                    try cg.buf.shr_imm(alloc, .Rax, (foff.offset *% 8_usize).trunc.[u8]());
                }
                try cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, .Rax);
            } else {
                try cg_load_val_from_mem(alloc, cg, eir_prog, env, inst.dst, .Rbp, sloc.stack_off +% foff.offset.trunc.[i32](), inst.ty0);
            }
        }
        .MakeDyn => {
            let vt_sym = try intern_sym_u64_2(alloc, interner, "eon_vtable_", inst.aux0.widen.[u64](), inst.ty1.widen.[u64]());
            let dst_off = cg_val_stack_off(cg, inst.dst);
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, dst_off, .Rax, 8_usize);
            try cg.buf.lea_rip_sym(alloc, .Rax, vt_sym, 0_i64);
            try cg.buf.store_mem(alloc, .Rbp, dst_off +% 8_i32, .Rax, 8_usize);
        }
        .MakeClosure => {
            let csym = try fn_sym_name_id(alloc, cfg_ir.fn_key_closure(inst.aux0), eir_prog, interner);
            let dst_off = cg_val_stack_off(cg, inst.dst);
            try cg.buf.lea_rip_sym(alloc, .Rax, csym, 0_i64);
            try cg.buf.store_mem(alloc, .Rbp, dst_off, .Rax, 8_usize);
            if inst.v0 != eir.EIR_NONE {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, .Rax);
            } else {
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            }
            try cg.buf.store_mem(alloc, .Rbp, dst_off +% 8_i32, .Rax, 8_usize);
        }
        .InlineAsm => {
            if let ad = eir_prog.get_asm(inst.aux0) {
                let ins = eir_prog.asm_inputs_slice(ad.inputs);
                var i: usize = 0_usize;
                while i < ins.len {
                    if let r = gp_arg_reg(false, i) {
                        try cg_load_scalar_raw(alloc, cg, eir_prog, env, ins[i].val, r);
                    }
                    i = i +% 1_usize;
                }
                let tmpl = eir_prog.bytes_slice(ad.template);
                let ok = try x64_asm.encode_inline_asm(alloc, &mut cg.buf, tmpl);
                if !ok {
                    try cg_fail(alloc, cg, "x86_64 codegen error: unsupported inline asm template");
                }
            }
        }
        _ => {}
    }
    return;
}

// ===========================================================================
// Section 6: Function Call Lowering (EonCall, SysV C, Dyn, FnPtr, r15+CF)
// ===========================================================================

struct CallArgSlot {
    val: eir.EirValue;
    ty: types.TyId;
    cls: ArgClass;
    is_reg: bool;
    gp_idx: usize;
    flt_idx: usize;
    stk_off: i32;
}

fn cg_emit_call_capture_ret(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    ret_ty: types.TyId,
    rc: RetClass,
) -> !OutOfMemory {
    if dst == eir.EIR_NONE {
        return;
    }
    let lay = env.x64_layout(ret_ty);
    match rc.kind {
        .Void => {}
        .IntReg => {
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .TwoIntRegs => {
            let off = cg_val_stack_off(cg, dst);
            try cg.buf.store_mem(alloc, .Rbp, off, .Rax, 8_usize);
            if lay.size > 8_usize {
                try cg.buf.store_mem(alloc, .Rbp, off +% 8_i32, .Rdx, lay.size - 8_usize);
            }
        }
        .FloatReg => {
            try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
        }
        .Sret => {}
        .ErrorUnion => {
            let l_err = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            let off = cg_val_stack_off(cg, dst);
            try cg.buf.jcc_label(alloc, .B, l_err);
            // Ok path (CF == 0): tag = 0
            try cg.buf.xor_rr32(alloc, .R8, .R8);
            try cg.buf.store_mem(alloc, .Rbp, off, .R8, 4_usize);
            let ok_off = env.eu_ok_offset(rc.ok_ty).trunc.[i32]();
            let ok_lay = env.x64_layout(rc.ok_ty);
            match rc.ok_kind {
                .Void => {}
                .IntReg => {
                    try cg.buf.store_mem(alloc, .Rbp, off +% ok_off, .Rax, ok_lay.size);
                }
                .TwoIntRegs => {
                    try cg.buf.store_mem(alloc, .Rbp, off +% ok_off, .Rax, 8_usize);
                    if ok_lay.size > 8_usize {
                        try cg.buf.store_mem(alloc, .Rbp, off +% ok_off +% 8_i32, .Rdx, ok_lay.size - 8_usize);
                    }
                }
                .FloatReg => {
                    if env.get(rc.ok_ty).u8_val == 64_u8 {
                        try cg.buf.movsd_store(alloc, .Rbp, off +% ok_off, .Xmm0);
                    } else {
                        try cg.buf.movss_store(alloc, .Rbp, off +% ok_off, .Xmm0);
                    }
                }
                .Sret => {}
                .ErrorUnion => {}
            }
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_err);
            // Error path (CF == 1): error tag in r15
            try cg.buf.store_mem(alloc, .Rbp, off, .R15, 4_usize);
            cg.buf.bind_label(l_done);
        }
    }
    return;
}

fn cg_emit_call(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    call_id: u32,
) -> !OutOfMemory {
    let cd = eir_prog.get_call(call_id) orelse {
        return;
    };
    let callee = cd.callee;
    let args = eir_prog.vals_slice(cd.args);
    let ret_ty = cd.ret_ty;
    let rc = classify_ret(ret_ty, env);
    let uses_sret = ret_uses_sret(rc);

    var is_c = false;
    if callee.kind == .ExternFn {
        // Internal Eon runtime helpers use EonCall/SysV register layout on all OSes;
        // external OS/C libraries use the target's native C ABI (Win64 on Windows, SysV on POSIX).
        is_c = !is_builtin_rt_helper(interner.get(callee.b));
    } else if callee.kind == .DirectFn {
        if let fid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(callee.a)) {
            if let f = eir_prog.get_fn(fid) {
                is_c = f.sig.effects.is_export_c;
            }
        }
    }
    let is_w64 = is_c && cg.is_win64;

    var gp_i: usize = 0_usize;
    var flt_i: usize = 0_usize;
    var stk_bytes: usize = if is_w64 { 32_usize } else { 0_usize };

    var sret_gp_idx: usize = 0_usize;
    if uses_sret {
        sret_gp_idx = gp_i;
        gp_i = gp_i +% 1_usize;
        if is_w64 { flt_i = gp_i; }
    }

    var env_gp_idx: usize = 99_usize;
    var dyn_gp_idx: usize = 99_usize;
    var start_arg: usize = 0_usize;
    if callee.kind == .FnPtr {
        env_gp_idx = gp_i;
        gp_i = gp_i +% 1_usize;
    } else if callee.kind == .DynCall {
        dyn_gp_idx = gp_i;
        gp_i = gp_i +% 1_usize;
        start_arg = 1_usize;
    }

    var plan = try col.DynBuf.[CallArgSlot].init(alloc, if args.len > 4_usize { args.len } else { 4_usize });
    errdefer plan.destroy(alloc);
    var ai = start_arg;
    while ai < args.len {
        let av = args[ai];
        let aty = eir_prog.fn_val_ty(cg.fn_id, av);
        let cls = classify_arg(aty, env);
        match cls {
            .Zst => {}
            .IntReg => {
                if let _ = gp_arg_reg_abi(is_c, cg.is_win64, gp_i) {
                    try plan.push(alloc, CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32 });
                    gp_i = gp_i +% 1_usize;
                    if is_w64 { flt_i = gp_i; }
                } else {
                    try plan.push(alloc, CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32]() });
                    stk_bytes = stk_bytes +% 8_usize;
                }
            }
            .TwoIntRegs => {
                let r0 = gp_arg_reg_abi(is_c, cg.is_win64, gp_i);
                let r1 = gp_arg_reg_abi(is_c, cg.is_win64, gp_i +% 1_usize);
                if r0 != null && r1 != null {
                    try plan.push(alloc, CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32 });
                    gp_i = gp_i +% 2_usize;
                    if is_w64 { flt_i = gp_i; }
                } else {
                    try plan.push(alloc, CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32]() });
                    stk_bytes = stk_bytes +% 16_usize;
                }
            }
            .FloatReg => {
                let max_flt: usize = if is_w64 { 4_usize } else { 8_usize };
                let fx = if flt_i < max_flt { float_arg_reg(flt_i) } else { null };
                if fx != null {
                    try plan.push(alloc, CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: 0_usize, flt_idx: flt_i, stk_off: 0_i32 });
                    flt_i = flt_i +% 1_usize;
                    if is_w64 { gp_i = flt_i; }
                } else {
                    try plan.push(alloc, CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32]() });
                    stk_bytes = stk_bytes +% 8_usize;
                }
            }
            .ByPtr => {
                if let _ = gp_arg_reg_abi(is_c, cg.is_win64, gp_i) {
                    try plan.push(alloc, CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, gp_idx: gp_i, flt_idx: 0_usize, stk_off: 0_i32 });
                    gp_i = gp_i +% 1_usize;
                    if is_w64 { flt_i = gp_i; }
                } else {
                    try plan.push(alloc, CallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, gp_idx: 0_usize, flt_idx: 0_usize, stk_off: stk_bytes.trunc.[i32]() });
                    stk_bytes = stk_bytes +% 8_usize;
                }
            }
        }
        ai = ai +% 1_usize;
    }

    var discard_sret_bytes: usize = 0_usize;
    if uses_sret && dst == eir.EIR_NONE {
        let sret_ty = if rc.kind == .ErrorUnion { rc.ok_ty } else { ret_ty };
        discard_sret_bytes = types.align_up_usize(env.x64_layout(sret_ty).size, 16_usize);
        if discard_sret_bytes == 0_usize {
            discard_sret_bytes = 16_usize;
        }
    }
    let aligned_stk = types.align_up_usize(stk_bytes +% discard_sret_bytes, 16_usize);
    if aligned_stk > 0_usize {
        if aligned_stk.widen.[u64]() > cg.max_call_stack_bytes {
            cg.max_call_stack_bytes = aligned_stk.widen.[u64]();
        }
        try cg.buf.sub_ri32(alloc, .Rsp, aligned_stk.trunc.[i32]());
    }

    // 1. Populate stack arguments first (safe to clobber Rax/Rcx/etc.)
    let ps = plan.as_slice();
    var pi: usize = 0_usize;
    while pi < ps.len {
        let slot = ps[pi];
        if !slot.is_reg {
            let lay = env.x64_layout(slot.ty);
            if slot.cls == .IntReg {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, slot.val, .Rax);
                try cg.buf.store_mem(alloc, .Rsp, slot.stk_off, .Rax, 8_usize);
            } else if slot.cls == .TwoIntRegs {
                let soff = cg_val_stack_off(cg, slot.val);
                try cg_emit_copy_mem(alloc, cg, .Rsp, slot.stk_off, .Rbp, soff, lay.size);
            } else if slot.cls == .FloatReg {
                let soff = cg_val_stack_off(cg, slot.val);
                let sz = if env.get(slot.ty).u8_val == 64_u8 { 8_usize } else { 4_usize };
                try cg_emit_copy_mem(alloc, cg, .Rsp, slot.stk_off, .Rbp, soff, sz);
            } else if slot.cls == .ByPtr {
                try cg_val_addr_into(alloc, cg, slot.val, .Rax);
                try cg.buf.store_mem(alloc, .Rsp, slot.stk_off, .Rax, 8_usize);
            }
        }
        pi = pi +% 1_usize;
    }

    // 2. Populate register arguments (all sources are on stack or callee-saved Rbx/R12/R13/R14!)
    pi = 0_usize;
    while pi < ps.len {
        let slot = ps[pi];
        if slot.is_reg {
            let lay = env.x64_layout(slot.ty);
            if slot.cls == .IntReg {
                if let r = gp_arg_reg_abi(is_c, cg.is_win64, slot.gp_idx) {
                    try cg_load_scalar_val(alloc, cg, eir_prog, env, slot.val, r);
                }
            } else if slot.cls == .TwoIntRegs {
                let soff = cg_val_stack_off(cg, slot.val);
                if let r0 = gp_arg_reg_abi(is_c, cg.is_win64, slot.gp_idx) {
                    try cg.buf.load_mem(alloc, r0, .Rbp, soff, 8_usize, false);
                }
                if let r1 = gp_arg_reg_abi(is_c, cg.is_win64, slot.gp_idx +% 1_usize) {
                    if lay.size > 8_usize {
                        try cg.buf.load_mem(alloc, r1, .Rbp, soff +% 8_i32, lay.size - 8_usize, false);
                    } else {
                        try cg.buf.xor_rr32(alloc, r1, r1);
                    }
                }
            } else if slot.cls == .FloatReg {
                if let xr = float_arg_reg(slot.flt_idx) {
                    let soff = cg_val_stack_off(cg, slot.val);
                    if env.get(slot.ty).u8_val == 64_u8 {
                        try cg.buf.movsd_load(alloc, xr, .Rbp, soff);
                    } else {
                        try cg.buf.movss_load(alloc, xr, .Rbp, soff);
                    }
                }
            } else if slot.cls == .ByPtr {
                if let r = gp_arg_reg_abi(is_c, cg.is_win64, slot.gp_idx) {
                    try cg_val_addr_into(alloc, cg, slot.val, r);
                }
            }
        }
        pi = pi +% 1_usize;
    }

    // 3. Populate hidden sret, closure env, or dyn data_ptr + indirect target in Rax
    if uses_sret {
        if let sr = gp_arg_reg_abi(is_c, cg.is_win64, sret_gp_idx) {
            if dst == eir.EIR_NONE {
                try cg.buf.lea_mem(alloc, sr, .Rsp, stk_bytes.trunc.[i32]());
            } else {
                var sret_disp = cg_val_stack_off(cg, dst);
                if rc.kind == .ErrorUnion {
                    sret_disp = sret_disp +% env.eu_ok_offset(rc.ok_ty).trunc.[i32]();
                }
                try cg.buf.lea_mem(alloc, sr, .Rbp, sret_disp);
            }
        }
    }
    if callee.kind == .FnPtr {
        let foff = cg_val_stack_off(cg, callee.a);
        if let er = gp_arg_reg(false, env_gp_idx) {
            try cg.buf.load_mem(alloc, er, .Rbp, foff +% 8_i32, 8_usize, false);
        }
        try cg.buf.load_mem(alloc, .Rax, .Rbp, foff, 8_usize, false);
    } else if callee.kind == .DynCall && args.len > 0_usize {
        let doff = cg_val_stack_off(cg, args[0_usize]);
        if let dr = gp_arg_reg(false, dyn_gp_idx) {
            try cg.buf.load_mem(alloc, dr, .Rbp, doff, 8_usize, false);
        }
        try cg.buf.load_mem(alloc, .Rax, .Rbp, doff +% 8_i32, 8_usize, false);
        let mdisp = (callee.b.widen.[usize]() *% 8_usize).trunc.[i32]();
        try cg.buf.load_mem(alloc, .Rax, .Rax, mdisp, 8_usize, false);
    }

    // 4. Emit the call instruction
    match callee.kind {
        .DirectFn => {
            let sym = try fn_sym_name_id(alloc, cfg_ir.fn_key_top_def(callee.a), eir_prog, interner);
            try cg.buf.call_sym(alloc, sym);
        }
        .Method => {
            let sym = try fn_sym_name_id(alloc, cfg_ir.fn_key_impl_method(callee.a, callee.b), eir_prog, interner);
            try cg.buf.call_sym(alloc, sym);
        }
        .GenericInst => {
            let sym = try fn_sym_name_id(alloc, cfg_ir.fn_key_generic_inst(callee.a), eir_prog, interner);
            try cg.buf.call_sym(alloc, sym);
        }
        .ExternFn => {
            let ext_sym = callee.b;
            let name_bytes = interner.get(ext_sym);
            if is_builtin_rt_helper(name_bytes) {
                try cg_note_helper(alloc, cg, ext_sym);
                try cg.buf.call_sym(alloc, ext_sym);
            } else if cg.is_linux {
                try cg.buf.call_plt_sym(alloc, ext_sym);
            } else {
                try cg.buf.call_sym(alloc, ext_sym);
            }
        }
        .DynCall => {
            try cg.buf.call_reg(alloc, .Rax);
        }
        .FnPtr => {
            try cg.buf.call_reg(alloc, .Rax);
        }
    }

    // 5. Restore stack WITHOUT clobbering RFLAGS (LEA preserves CF for ErrorUnion!)
    if aligned_stk > 0_usize {
        try cg.buf.lea_mem(alloc, .Rsp, .Rsp, aligned_stk.trunc.[i32]());
    }

    // 6. Capture return value
    try cg_emit_call_capture_ret(alloc, cg, eir_prog, env, interner, dst, ret_ty, rc);
    plan.destroy(alloc);
    return;
}

// ===========================================================================
// Section 7A: Builtin Ops — Arena, AllocCap, Pools, Buf, Atomic, Slice, Math
// ===========================================================================

fn get_arg_slot(arg_slots: *[eir.EirSlot], idx: usize) -> eir.EirSlot {
    if idx < arg_slots.len {
        return arg_slots[idx];
    }
    return eir.EIR_NONE;
}

fn cg_builtin_ptr_arg(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    idx: usize,
    dst: x64_asm.Reg,
) -> !OutOfMemory {
    if idx < args.len {
        try cg_load_ptr_arg(alloc, cg, eir_prog, env, args[idx], get_arg_slot(arg_slots, idx), dst);
    }
    return;
}

fn pool_ncols_from_ty(env: *types.TypeEnv, elem_ty: types.TyId) -> usize {
    let n = env.get(elem_ty);
    if n.kind == .Pool {
        if let pm = env.get_pool(n.primary) {
            return pm.columns.len.widen.[usize]();
        }
    }
    return 0_usize;
}

fn pool_ncols_from_arg_ty(env: *types.TypeEnv, arg_ty: types.TyId) -> usize {
    var cur = arg_ty;
    let n0 = env.get(cur);
    if n0.kind == .Borrow && n0.borrow_kind == .Single {
        cur = n0.primary;
    }
    let n1 = env.get(cur);
    if n1.kind == .Builtin {
        return env.pool_col_count(env.node_gval_list(&n1));
    }
    return 0_usize;
}

fn cg_emit_builtin_arena(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
) -> !OutOfMemory {
    match op.kind {
        .ArenaInit => {
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .Rdi);
            if args.len > 1_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .Rsi);
            }
            try cg.buf.mov_ri64(alloc, .Rdx, 64_u64);
            try cg_call_alloc_raw(alloc, cg, interner);
            if args.len > 1_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .Rcx);
            } else {
                try cg.buf.xor_rr32(alloc, .Rcx, .Rcx);
            }
            let l_ok = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.test_rr(alloc, .Rax, .Rax);
            try cg.buf.jcc_label(alloc, .Ne, l_ok);
            try cg.buf.test_rr(alloc, .Rcx, .Rcx);
            try cg.buf.jcc_label(alloc, .E, l_ok);
            try cg.buf.mov_ri64(alloc, .Rdx, 7_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rdx, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_ok);
            try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rdx, 4_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .Rcx, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 16_i32, .Rdx, 8_usize);
            cg.buf.bind_label(l_done);
        }
        .ArenaAlloc => {
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .Rdi);
            if args.len > 1_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .Rsi);
            }
            try cg.buf.mov_ri64(alloc, .Rdx, 16_u64);
            try cg_helper_call(alloc, cg, interner, "eon_arena_alloc_aligned");
            if args.len > 1_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .Rcx);
            } else {
                try cg.buf.xor_rr32(alloc, .Rcx, .Rcx);
            }
            let l_ok = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.test_rr(alloc, .Rax, .Rax);
            try cg.buf.jcc_label(alloc, .Ne, l_ok);
            try cg.buf.test_rr(alloc, .Rcx, .Rcx);
            try cg.buf.jcc_label(alloc, .E, l_ok);
            try cg.buf.mov_ri64(alloc, .Rdx, 7_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rdx, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_ok);
            try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rdx, 4_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .Rcx, 8_usize);
            cg.buf.bind_label(l_done);
        }
        .ArenaReset => {
            if cg.sanitize {
                try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .Rdi);
                try cg_helper_call(alloc, cg, interner, "eon_rt_arena_reset_san");
            } else {
                try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .R8, 16_i32, .Rax, 8_usize);
            }
        }
        .ArenaDestroy => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
            try cg.buf.load_mem(alloc, .Rsi, .R8, 0_i32, 8_usize, false);
            try cg.buf.load_mem(alloc, .Rdx, .R8, 8_i32, 8_usize, false);
            try cg_call_free_raw(alloc, cg, interner);
        }
        .ArenaUsedBytes => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, 16_i32, 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .ArenaCapacity => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, 8_i32, 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .AllocCapLiveAllocs => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .AllocCapUsedBytes => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, 8_i32, 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .AllocCapPeakBytes => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, 16_i32, 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .AllocCapSubBudget => {
            let doff = cg_val_stack_off(cg, dst);
            try cg_emit_memzero(alloc, cg, .Rbp, doff, 40_usize);
            if args.len > 1_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff +% 24_i32, .Rax, 8_usize);
            }
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff +% 32_i32, .Rax, 8_usize);
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_arena_pool(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
) -> !OutOfMemory {
    match op.kind {
        .ArenaPoolInit => {
            let pdef = env.get(op.ty0).primary;
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let ncols = pool_ncols_from_ty(env, op.ty0);
            try cg_emit_memzero(alloc, cg, .Rbp, doff, env.x64_layout(ret_ty).size);
            if args.len > 1_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), .Rax, 8_usize);
            }
            let l_fail = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let esz_raw = env.x64_layout_impl(cols[ci].ty, false).size;
                    let esz = if esz_raw == 0_usize { 1_usize } else { esz_raw };
                    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .Rdi);
                    if args.len > 1_usize {
                        try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .Rsi);
                    }
                    let l_nz = try cg.buf.new_label(alloc);
                    try cg.buf.test_rr(alloc, .Rsi, .Rsi);
                    try cg.buf.jcc_label(alloc, .Ne, l_nz);
                    try cg.buf.mov_ri64(alloc, .Rsi, 1_u64);
                    cg.buf.bind_label(l_nz);
                    if esz != 1_usize {
                        try cg.buf.imul_rri32(alloc, .Rsi, .Rsi, esz.trunc.[i32]());
                    }
                    try cg.buf.mov_ri64(alloc, .Rdx, 64_u64);
                    try cg_helper_call(alloc, cg, interner, "eon_arena_alloc_aligned");
                    try cg.buf.test_rr(alloc, .Rax, .Rax);
                    try cg.buf.jcc_label(alloc, .E, l_fail);
                    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% (ci *% 8_usize).trunc.[i32](), .Rax, 8_usize);
                    ci = ci +% 1_usize;
                }
            }
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_fail);
            try cg.buf.mov_ri64(alloc, .Rax, 7_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            cg.buf.bind_label(l_done);
        }
        .ArenaPoolPush => {
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let doff = cg_val_stack_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_U32).trunc.[i32]();
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .R9, .R8, (ncols *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg.buf.load_mem(alloc, .R10, .R8, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
            let l_oom = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, .R9, .R10);
            try cg.buf.jcc_label(alloc, .Ae, l_oom);
            try cg.buf.lea_mem(alloc, .Rax, .R9, 1_i32);
            try cg.buf.store_mem(alloc, .R8, (ncols *% 8_usize).trunc.[i32](), .Rax, 8_usize);
            if args.len > 1_usize {
                let row_v = args[1_usize];
                let row_off = cg_val_stack_off(cg, row_v);
                let row_ty = eir_prog.fn_val_ty(cg.fn_id, row_v);
                if let pm = env.get_pool(pdef) {
                    let cols = env.pool_cols_range(pm.columns);
                    var ci: usize = 0_usize;
                    while ci < cols.len {
                        let foff = env.struct_field_offset(row_ty, ci).offset;
                        let esz_r = env.x64_layout_impl(cols[ci].ty, false).size;
                        let col_esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                        try cg.buf.load_mem(alloc, .R10, .R8, (ci *% 8_usize).trunc.[i32](), 8_usize, false);
                        try cg.buf.mov_rr(alloc, .R11, .R9);
                        if col_esz != 1_usize {
                            try cg.buf.imul_rri32(alloc, .R11, .R11, col_esz.trunc.[i32]());
                        }
                        try cg.buf.add_rr(alloc, .R10, .R11);
                        try cg_emit_copy_mem(alloc, cg, .R10, 0_i32, .Rbp, row_off +% foff.trunc.[i32](), col_esz);
                        ci = ci +% 1_usize;
                    }
                }
            }
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R9, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_oom);
            try cg.buf.mov_ri64(alloc, .Rax, 7_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFF_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 4_usize);
            cg.buf.bind_label(l_done);
        }
        .ArenaPoolIdAt => {
            let ncols = if args.len > 0_usize { pool_ncols_from_arg_ty(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            let doff = cg_val_stack_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_U32).trunc.[i32]();
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9);
            }
            try cg.buf.load_mem(alloc, .R10, .R8, (ncols *% 8_usize).trunc.[i32](), 8_usize, false);
            let l_oob = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, .R9, .R10);
            try cg.buf.jcc_label(alloc, .Ae, l_oob);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R9, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            try cg.buf.mov_ri64(alloc, .Rax, 4_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFF_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 4_usize);
            cg.buf.bind_label(l_done);
        }
        .ArenaPoolReset => {
            let ncols = pool_ncols_from_ty(env, op.ty0);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .R8, (ncols *% 8_usize).trunc.[i32](), .Rax, 8_usize);
            if dst != eir.EIR_NONE {
                try cg_load_val_from_mem(alloc, cg, eir_prog, env, dst, .R8, 0_i32, ret_ty);
            }
        }
        .ArenaPoolLen => {
            let ncols = if args.len > 0_usize { pool_ncols_from_arg_ty(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, (ncols *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        _ => {}
    }
    return;
}

fn cg_emit_slot_pool_init(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    elem_ty: types.TyId,
    dst: eir.EirValue,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
) -> !OutOfMemory {
    let pdef = env.get(elem_ty).primary;
    let ncols = pool_ncols_from_ty(env, elem_ty);
    let doff = cg_val_stack_off(cg, dst);
    let ok_ty = env.get(ret_ty).primary;
    let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
    let tmp = cg.frame.temp_copy_off;
    try cg_emit_memzero(alloc, cg, .Rbp, doff, env.x64_layout(ret_ty).size);
    if args.len > 1_usize {
        try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .Rax);
    } else {
        try cg.buf.mov_ri64(alloc, .Rax, 4_u64);
    }
    let l_nz = try cg.buf.new_label(alloc);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .Ne, l_nz);
    try cg.buf.mov_ri64(alloc, .Rax, 4_u64);
    cg.buf.bind_label(l_nz);
    try cg.buf.store_mem(alloc, .Rbp, tmp, .Rax, 8_usize); // cap
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), .Rax, 8_usize);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), .Rax, 8_usize);

    let l_fail = try cg.buf.new_label(alloc);
    let l_done = try cg.buf.new_label(alloc);
    if let pm = env.get_pool(pdef) {
        let cols = env.pool_cols_range(pm.columns);
        var ci: usize = 0_usize;
        while ci < cols.len {
            let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .Rdi);
            try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp, 8_usize, false);
            if esz != 1_usize {
                try cg.buf.imul_rri32(alloc, .Rsi, .Rsi, esz.trunc.[i32]());
            }
            try cg.buf.mov_ri64(alloc, .Rdx, 64_u64);
            try cg_call_alloc_raw(alloc, cg, interner);
            try cg.buf.test_rr(alloc, .Rax, .Rax);
            try cg.buf.jcc_label(alloc, .E, l_fail);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% (ci *% 8_usize).trunc.[i32](), .Rax, 8_usize);
            ci = ci +% 1_usize;
        }
    }
    // Allocate gen array (cap * 4, zeroed)
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .Rdi);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp, 8_usize, false);
    try cg.buf.shl_imm(alloc, .Rsi, 2_u8);
    try cg.buf.mov_ri64(alloc, .Rdx, 4_u64);
    try cg_call_alloc_raw(alloc, cg, interner);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_fail);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% (ncols *% 8_usize).trunc.[i32](), .Rax, 8_usize);
    try cg.buf.mov_rr(alloc, .Rdi, .Rax);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp, 8_usize, false);
    try cg.buf.shl_imm(alloc, .Rcx, 2_u8);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.rep_stosb(alloc);

    // Allocate free_stack (cap * 4), fill free_stack[cap - 1 - k] = k
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .Rdi);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp, 8_usize, false);
    try cg.buf.shl_imm(alloc, .Rsi, 2_u8);
    try cg.buf.mov_ri64(alloc, .Rdx, 4_u64);
    try cg_call_alloc_raw(alloc, cg, interner);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_fail);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), .Rax, 8_usize);
    try cg.buf.xor_rr32(alloc, .R9, .R9);
    try cg.buf.load_mem(alloc, .R10, .Rbp, tmp, 8_usize, false);
    let l_fk = try cg.buf.new_label(alloc);
    let l_fk_end = try cg.buf.new_label(alloc);
    cg.buf.bind_label(l_fk);
    try cg.buf.cmp_rr(alloc, .R9, .R10);
    try cg.buf.jcc_label(alloc, .Ae, l_fk_end);
    try cg.buf.mov_rr(alloc, .R11, .R10);
    try cg.buf.sub_ri32(alloc, .R11, 1_i32);
    try cg.buf.sub_rr(alloc, .R11, .R9);
    try cg.buf.shl_imm(alloc, .R11, 2_u8);
    try cg.buf.add_rr(alloc, .R11, .Rax);
    try cg.buf.store_mem(alloc, .R11, 0_i32, .R9, 4_usize);
    try cg.buf.add_ri32(alloc, .R9, 1_i32);
    try cg.buf.jmp_label(alloc, l_fk);
    cg.buf.bind_label(l_fk_end);
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_fail);
    try cg.buf.mov_ri64(alloc, .Rax, 7_u64);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_slot_pool_grow(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    pdef: u32,
    ncols: usize,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    l_oom: u32,
) -> !OutOfMemory {
    let tmp = cg.frame.temp_copy_off;
    try cg.buf.load_mem(alloc, .Rax, .R8, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_usize, false); // oc
    try cg.buf.store_mem(alloc, .Rbp, tmp, .Rax, 8_usize);
    try cg.buf.shl_imm(alloc, .Rax, 1_u8);
    let l_nc_ok = try cg.buf.new_label(alloc);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .Ne, l_nc_ok);
    try cg.buf.mov_ri64(alloc, .Rax, 4_u64);
    cg.buf.bind_label(l_nc_ok);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 8_i32, .Rax, 8_usize); // nc

    // Grow gen array (zero-init then copy old)
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 8_i32, 8_usize, false);
    try cg.buf.shl_imm(alloc, .Rsi, 2_u8);
    try cg.buf.mov_ri64(alloc, .Rdx, 4_u64);
    try cg_call_alloc_raw(alloc, cg, interner);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_oom);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 16_i32, .Rax, 8_usize);
    try cg.buf.mov_rr(alloc, .Rdi, .Rax);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp +% 8_i32, 8_usize, false);
    try cg.buf.shl_imm(alloc, .Rcx, 2_u8);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.rep_stosb(alloc);
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rsi, .R8, (ncols *% 8_usize).trunc.[i32](), 8_usize, false);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp, 8_usize, false);
    try cg.buf.shl_imm(alloc, .Rcx, 2_u8);
    try cg.buf.rep_movsb(alloc);
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
    try cg.buf.load_mem(alloc, .Rsi, .R8, (ncols *% 8_usize).trunc.[i32](), 8_usize, false);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp, 8_usize, false);
    try cg.buf.shl_imm(alloc, .Rdx, 2_u8);
    try cg_call_free_raw(alloc, cg, interner);
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .R8, (ncols *% 8_usize).trunc.[i32](), .Rax, 8_usize);

    // Grow free_stack
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 8_i32, 8_usize, false);
    try cg.buf.shl_imm(alloc, .Rsi, 2_u8);
    try cg.buf.mov_ri64(alloc, .Rdx, 4_u64);
    try cg_call_alloc_raw(alloc, cg, interner);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_oom);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 16_i32, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .R9, .Rbp, tmp, 8_usize, false);
    try cg.buf.load_mem(alloc, .R10, .Rbp, tmp +% 8_i32, 8_usize, false);
    let l_fk = try cg.buf.new_label(alloc);
    let l_fk_end = try cg.buf.new_label(alloc);
    cg.buf.bind_label(l_fk);
    try cg.buf.cmp_rr(alloc, .R9, .R10);
    try cg.buf.jcc_label(alloc, .Ae, l_fk_end);
    try cg.buf.mov_rr(alloc, .R11, .R10);
    try cg.buf.sub_ri32(alloc, .R11, 1_i32);
    try cg.buf.sub_rr(alloc, .R11, .R9);
    try cg.buf.shl_imm(alloc, .R11, 2_u8);
    try cg.buf.add_rr(alloc, .R11, .Rax);
    try cg.buf.store_mem(alloc, .R11, 0_i32, .R9, 4_usize);
    try cg.buf.add_ri32(alloc, .R9, 1_i32);
    try cg.buf.jmp_label(alloc, l_fk);
    cg.buf.bind_label(l_fk_end);
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
    try cg.buf.load_mem(alloc, .Rsi, .R8, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp, 8_usize, false);
    try cg.buf.shl_imm(alloc, .Rdx, 2_u8);
    try cg_call_free_raw(alloc, cg, interner);
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .R8, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), .Rax, 8_usize);

    // Grow each column
    if let pm = env.get_pool(pdef) {
        let cols = env.pool_cols_range(pm.columns);
        var ci: usize = 0_usize;
        while ci < cols.len {
            let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
            try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 8_i32, 8_usize, false);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .Rsi, .Rsi, esz.trunc.[i32]()); }
            try cg.buf.mov_ri64(alloc, .Rdx, 64_u64);
            try cg_call_alloc_raw(alloc, cg, interner);
            try cg.buf.test_rr(alloc, .Rax, .Rax);
            try cg.buf.jcc_label(alloc, .E, l_oom);
            try cg.buf.store_mem(alloc, .Rbp, tmp +% 16_i32, .Rax, 8_usize);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.mov_rr(alloc, .Rdi, .Rax);
            try cg.buf.load_mem(alloc, .Rsi, .R8, (ci *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp, 8_usize, false);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .Rcx, .Rcx, esz.trunc.[i32]()); }
            try cg.buf.rep_movsb(alloc);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
            try cg.buf.load_mem(alloc, .Rsi, .R8, (ci *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp, 8_usize, false);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .Rdx, .Rdx, esz.trunc.[i32]()); }
            try cg_call_free_raw(alloc, cg, interner);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 16_i32, 8_usize, false);
            try cg.buf.store_mem(alloc, .R8, (ci *% 8_usize).trunc.[i32](), .Rax, 8_usize);
            ci = ci +% 1_usize;
        }
    }
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 8_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .R8, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp, 8_usize, false);
    try cg.buf.sub_rr(alloc, .Rax, .Rcx);
    try cg.buf.store_mem(alloc, .R8, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), .Rax, 8_usize);
    try cg.buf.mov_rr(alloc, .R9, .Rax);
    return;
}

fn cg_emit_slot_pool_insert(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    elem_ty: types.TyId,
    dst: eir.EirValue,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
    may_grow: bool,
) -> !OutOfMemory {
    let pdef = env.get(elem_ty).primary;
    let ncols = pool_ncols_from_ty(env, elem_ty);
    let doff = cg_val_stack_off(cg, dst);
    let ok_ty = env.get(ret_ty).primary;
    let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
    let row_arg_idx: usize = if may_grow { 2_usize } else { 1_usize };

    let l_has_slot = try cg.buf.new_label(alloc);
    let l_oom = try cg.buf.new_label(alloc);
    let l_done = try cg.buf.new_label(alloc);

    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg.buf.load_mem(alloc, .R9, .R8, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), 8_usize, false); // free_top
    try cg.buf.test_rr(alloc, .R9, .R9);
    try cg.buf.jcc_label(alloc, .Ne, l_has_slot);
    if may_grow {
        try cg_emit_slot_pool_grow(alloc, cg, eir_prog, env, interner, pdef, ncols, args, arg_slots, l_oom);
    } else {
        try cg.buf.jmp_label(alloc, l_oom);
    }

    cg.buf.bind_label(l_has_slot);
    try cg.buf.sub_ri32(alloc, .R9, 1_i32);
    try cg.buf.store_mem(alloc, .R8, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), .R9, 8_usize);
    try cg.buf.load_mem(alloc, .R10, .R8, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
    try cg.buf.shl_imm(alloc, .R9, 2_u8);
    try cg.buf.add_rr(alloc, .R10, .R9);
    try cg.buf.load_mem(alloc, .R9, .R10, 0_i32, 4_usize, false); // idx

    try cg.buf.load_mem(alloc, .R10, .R8, (ncols *% 8_usize).trunc.[i32](), 8_usize, false);
    try cg.buf.mov_rr(alloc, .R11, .R9);
    try cg.buf.shl_imm(alloc, .R11, 2_u8);
    try cg.buf.add_rr(alloc, .R10, .R11);
    try cg.buf.load_mem(alloc, .Rax, .R10, 0_i32, 4_usize, false);
    try cg.buf.add_ri32(alloc, .Rax, 1_i32);
    try cg.buf.store_mem(alloc, .R10, 0_i32, .Rax, 4_usize);

    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R9, 4_usize);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 4_i32, .Rax, 4_usize);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);

    try cg.buf.load_mem(alloc, .Rax, .R8, ((ncols +% 2_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
    try cg.buf.add_ri32(alloc, .Rax, 1_i32);
    try cg.buf.store_mem(alloc, .R8, ((ncols +% 2_usize) *% 8_usize).trunc.[i32](), .Rax, 8_usize);

    if row_arg_idx < args.len {
        let row_v = args[row_arg_idx];
        let row_off = cg_val_stack_off(cg, row_v);
        let row_ty = eir_prog.fn_val_ty(cg.fn_id, row_v);
        if let pm = env.get_pool(pdef) {
            let cols = env.pool_cols_range(pm.columns);
            var ci: usize = 0_usize;
            while ci < cols.len {
                let foff = env.struct_field_offset(row_ty, ci).offset;
                let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
                let col_esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                try cg.buf.load_mem(alloc, .R10, .R8, (ci *% 8_usize).trunc.[i32](), 8_usize, false);
                try cg.buf.mov_rr(alloc, .R11, .R9);
                if col_esz != 1_usize { try cg.buf.imul_rri32(alloc, .R11, .R11, col_esz.trunc.[i32]()); }
                try cg.buf.add_rr(alloc, .R10, .R11);
                try cg_emit_copy_mem(alloc, cg, .R10, 0_i32, .Rbp, row_off +% foff.trunc.[i32](), col_esz);
                ci = ci +% 1_usize;
            }
        }
    }
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_oom);
    try cg.buf.mov_ri64(alloc, .Rax, 7_u64);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_slot_pool_validate_gid(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    ncols: usize,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    l_stale: u32,
) -> !OutOfMemory {
    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    if args.len > 1_usize {
        let gid_v = args[1_usize];
        let loc = cg_val_loc(cg, gid_v);
        if loc.kind == .Reg {
            try cg.buf.extend_reg(alloc, .R9, loc.reg, 32_u8, false);
            try cg.buf.mov_rr(alloc, .R10, loc.reg);
            try cg.buf.shr_imm(alloc, .R10, 32_u8);
        } else {
            try cg.buf.load_mem(alloc, .R9, .Rbp, loc.stack_off, 4_usize, false);
            try cg.buf.load_mem(alloc, .R10, .Rbp, loc.stack_off +% 4_i32, 4_usize, false);
        }
    }
    try cg.buf.test_rr32(alloc, .R10, .R10);
    try cg.buf.jcc_label(alloc, .E, l_stale);
    try cg.buf.mov_rr(alloc, .Rax, .R10);
    try cg.buf.and_ri32(alloc, .Rax, 1_i32);
    try cg.buf.test_rr32(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_stale);
    try cg.buf.load_mem(alloc, .Rax, .R8, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
    try cg.buf.cmp_rr(alloc, .R9, .Rax);
    try cg.buf.jcc_label(alloc, .Ae, l_stale);
    try cg.buf.load_mem(alloc, .R11, .R8, (ncols *% 8_usize).trunc.[i32](), 8_usize, false);
    try cg.buf.mov_rr(alloc, .Rax, .R9);
    try cg.buf.shl_imm(alloc, .Rax, 2_u8);
    try cg.buf.add_rr(alloc, .R11, .Rax);
    try cg.buf.load_mem(alloc, .Rax, .R11, 0_i32, 4_usize, false);
    try cg.buf.cmp_rr(alloc, .Rax, .R10);
    try cg.buf.jcc_label(alloc, .Ne, l_stale);
    return;
}

fn cg_emit_builtin_slot_pool(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
) -> !OutOfMemory {
    match op.kind {
        .SlotPoolInit => {
            try cg_emit_slot_pool_init(alloc, cg, eir_prog, env, interner, op.ty0, dst, args, arg_slots, ret_ty);
        }
        .SlotPoolInsert => {
            try cg_emit_slot_pool_insert(alloc, cg, eir_prog, env, interner, op.ty0, dst, args, arg_slots, ret_ty, true);
        }
        .SlotPoolTryInsert => {
            try cg_emit_slot_pool_insert(alloc, cg, eir_prog, env, interner, op.ty0, dst, args, arg_slots, ret_ty, false);
        }
        .SlotPoolRemove => {
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let l_stale = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg_emit_slot_pool_validate_gid(alloc, cg, eir_prog, env, ncols, args, arg_slots, l_stale);
            try cg_emit_memzero(alloc, cg, .Rbp, doff, env.x64_layout(ret_ty).size);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let foff = env.struct_field_offset(ok_ty, ci).offset;
                    let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
                    let col_esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                    try cg.buf.load_mem(alloc, .R10, .R8, (ci *% 8_usize).trunc.[i32](), 8_usize, false);
                    try cg.buf.mov_rr(alloc, .Rax, .R9);
                    if col_esz != 1_usize { try cg.buf.imul_rri32(alloc, .Rax, .Rax, col_esz.trunc.[i32]()); }
                    try cg.buf.add_rr(alloc, .R10, .Rax);
                    try cg_emit_copy_mem(alloc, cg, .Rbp, doff +% ok_off +% foff.trunc.[i32](), .R10, 0_i32, col_esz);
                    ci = ci +% 1_usize;
                }
            }
            // Bump gen, push onto free_stack, len -= 1
            try cg.buf.load_mem(alloc, .Rax, .R11, 0_i32, 4_usize, false);
            try cg.buf.add_ri32(alloc, .Rax, 1_i32);
            try cg.buf.store_mem(alloc, .R11, 0_i32, .Rax, 4_usize);
            try cg.buf.load_mem(alloc, .R10, .R8, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg.buf.load_mem(alloc, .R11, .R8, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg.buf.mov_rr(alloc, .Rax, .R10);
            try cg.buf.shl_imm(alloc, .Rax, 2_u8);
            try cg.buf.add_rr(alloc, .R11, .Rax);
            try cg.buf.store_mem(alloc, .R11, 0_i32, .R9, 4_usize);
            try cg.buf.add_ri32(alloc, .R10, 1_i32);
            try cg.buf.store_mem(alloc, .R8, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), .R10, 8_usize);
            try cg.buf.load_mem(alloc, .Rax, .R8, ((ncols +% 2_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg.buf.sub_ri32(alloc, .Rax, 1_i32);
            try cg.buf.store_mem(alloc, .R8, ((ncols +% 2_usize) *% 8_usize).trunc.[i32](), .Rax, 8_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_stale);
            try cg.buf.mov_ri64(alloc, .Rax, 11_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            cg.buf.bind_label(l_done);
        }
        .SlotPoolGet => {
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let doff = cg_val_stack_off(cg, dst);
            let l_stale = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg_emit_slot_pool_validate_gid(alloc, cg, eir_prog, env, ncols, args, arg_slots, l_stale);
            try cg.buf.store_mem(alloc, .Rbp, doff, .R8, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% 8_i32, .R9, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_stale);
            try cg_emit_opt_null(alloc, cg, eir_prog, env, dst, ret_ty);
            cg.buf.bind_label(l_done);
        }
        .SlotPoolAt => {
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let l_stale = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg_emit_slot_pool_validate_gid(alloc, cg, eir_prog, env, ncols, args, arg_slots, l_stale);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R8, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .R9, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_stale);
            try cg.buf.mov_ri64(alloc, .Rax, 11_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .Rax, 8_usize);
            cg.buf.bind_label(l_done);
        }
        .SlotPoolLen => {
            let ncols = if args.len > 0_usize { pool_ncols_from_arg_ty(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, ((ncols +% 2_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .SlotPoolCap => {
            let ncols = if args.len > 0_usize { pool_ncols_from_arg_ty(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .SlotPoolIsAlive => {
            let ncols = pool_ncols_from_ty(env, op.ty0);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9); }
            try cg.buf.load_mem(alloc, .R10, .R8, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
            let l_false = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, .R9, .R10);
            try cg.buf.jcc_label(alloc, .Ae, l_false);
            try cg.buf.load_mem(alloc, .R10, .R8, (ncols *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg.buf.shl_imm(alloc, .R9, 2_u8);
            try cg.buf.add_rr(alloc, .R10, .R9);
            try cg.buf.load_mem(alloc, .Rax, .R10, 0_i32, 4_usize, false);
            try cg.buf.and_ri32(alloc, .Rax, 1_i32);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_false);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            cg.buf.bind_label(l_done);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .SlotPoolIdAt => {
            let ncols = pool_ncols_from_ty(env, op.ty0);
            let doff = cg_val_stack_off(cg, dst);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9); }
            try cg.buf.load_mem(alloc, .R10, .R8, (ncols *% 8_usize).trunc.[i32](), 8_usize, false);
            try cg.buf.mov_rr(alloc, .R11, .R9);
            try cg.buf.shl_imm(alloc, .R11, 2_u8);
            try cg.buf.add_rr(alloc, .R10, .R11);
            try cg.buf.load_mem(alloc, .Rax, .R10, 0_i32, 4_usize, false);
            try cg.buf.store_mem(alloc, .Rbp, doff, .R9, 4_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% 4_i32, .Rax, 4_usize);
        }
        .SlotPoolDestroy => {
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_from_ty(env, op.ty0);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let esz_r = env.x64_layout_impl(cols[ci].ty, true).size;
                    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
                    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
                    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
                    try cg.buf.load_mem(alloc, .Rsi, .R8, (ci *% 8_usize).trunc.[i32](), 8_usize, false);
                    try cg.buf.load_mem(alloc, .Rdx, .R8, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
                    if esz != 1_usize { try cg.buf.imul_rri32(alloc, .Rdx, .Rdx, esz.trunc.[i32]()); }
                    try cg_call_free_raw(alloc, cg, interner);
                    ci = ci +% 1_usize;
                }
            }
            var ex: usize = ncols;
            while ex <= ncols +% 1_usize {
                try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
                try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
                try cg.buf.load_mem(alloc, .Rsi, .R8, (ex *% 8_usize).trunc.[i32](), 8_usize, false);
                try cg.buf.load_mem(alloc, .Rdx, .R8, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_usize, false);
                try cg.buf.shl_imm(alloc, .Rdx, 2_u8);
                try cg_call_free_raw(alloc, cg, interner);
                ex = ex +% 1_usize;
            }
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_buf(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
) -> !OutOfMemory {
    let elay = env.x64_layout(op.ty0);
    let esz = if elay.size == 0_usize { 1_usize } else { elay.size };
    let ealign = if elay.align == 0_usize { 1_usize } else { elay.align };
    match op.kind {
        .BufInit => {
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .Rdi);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .Rsi); }
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .Rsi, .Rsi, esz.trunc.[i32]()); }
            try cg.buf.mov_ri64(alloc, .Rdx, ealign.widen.[u64]());
            try cg_call_alloc_raw(alloc, cg, interner);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .Rcx); }
            let l_ok = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.test_rr(alloc, .Rax, .Rax);
            try cg.buf.jcc_label(alloc, .Ne, l_ok);
            try cg.buf.test_rr(alloc, .Rcx, .Rcx);
            try cg.buf.jcc_label(alloc, .E, l_ok);
            try cg.buf.mov_ri64(alloc, .Rdx, 7_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rdx, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_ok);
            try cg.buf.xor_rr32(alloc, .Rdx, .Rdx);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rdx, 4_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .Rdx, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 16_i32, .Rcx, 8_usize);
            cg.buf.bind_label(l_done);
        }
        .BufPush => {
            let doff = cg_val_stack_off(cg, dst);
            let val_arg = if args.len >= 3_usize { args[2_usize] } else if args.len > 1_usize { args[1_usize] } else { 0_u32 };
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .R9, .R8, 8_i32, 8_usize, false);
            try cg.buf.load_mem(alloc, .R10, .R8, 16_i32, 8_usize, false);
            let l_full = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, .R9, .R10);
            try cg.buf.jcc_label(alloc, .Ae, l_full);
            try cg.buf.lea_mem(alloc, .Rax, .R9, 1_i32);
            try cg.buf.store_mem(alloc, .R8, 8_i32, .Rax, 8_usize);
            try cg.buf.load_mem(alloc, .R8, .R8, 0_i32, 8_usize, false);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
            try cg.buf.add_rr(alloc, .R8, .R9);
            try cg_store_val_to_mem(alloc, cg, eir_prog, env, .R8, 0_i32, val_arg, op.ty0);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_full);
            try cg.buf.mov_ri64(alloc, .Rax, 7_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            cg.buf.bind_label(l_done);
        }
        .BufPushSlice => {
            let doff = cg_val_stack_off(cg, dst);
            let slice_arg = if args.len >= 3_usize { args[2_usize] } else if args.len > 1_usize { args[1_usize] } else { 0_u32 };
            let soff = cg_val_stack_off(cg, slice_arg);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .R9, .R8, 8_i32, 8_usize, false);
            try cg.buf.load_mem(alloc, .R10, .R8, 16_i32, 8_usize, false);
            try cg.buf.load_mem(alloc, .R11, .Rbp, soff +% 8_i32, 8_usize, false);
            try cg.buf.mov_rr(alloc, .Rax, .R10);
            try cg.buf.sub_rr(alloc, .Rax, .R9);
            let l_full = try cg.buf.new_label(alloc);
            let l_copy_done = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, .Rax, .R11);
            try cg.buf.jcc_label(alloc, .B, l_full);
            try cg.buf.mov_rr(alloc, .Rax, .R9);
            try cg.buf.add_rr(alloc, .Rax, .R11);
            try cg.buf.store_mem(alloc, .R8, 8_i32, .Rax, 8_usize);
            try cg.buf.mov_rr(alloc, .Rcx, .R11);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .Rcx, .Rcx, esz.trunc.[i32]()); }
            try cg.buf.test_rr(alloc, .Rcx, .Rcx);
            try cg.buf.jcc_label(alloc, .E, l_copy_done);
            try cg.buf.load_mem(alloc, .Rdi, .R8, 0_i32, 8_usize, false);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
            try cg.buf.add_rr(alloc, .Rdi, .R9);
            try cg.buf.load_mem(alloc, .Rsi, .Rbp, soff, 8_usize, false);
            try cg.buf.rep_movsb(alloc);
            cg.buf.bind_label(l_copy_done);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_full);
            try cg.buf.mov_ri64(alloc, .Rax, 7_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            cg.buf.bind_label(l_done);
        }
        .BufPop => {
            let doff = cg_val_stack_off(cg, dst);
            let voff = env.opt_val_offset(op.ty0).trunc.[i32]();
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .R9, .R8, 8_i32, 8_usize, false);
            let l_empty = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.test_rr(alloc, .R9, .R9);
            try cg.buf.jcc_label(alloc, .E, l_empty);
            try cg.buf.sub_ri32(alloc, .R9, 1_i32);
            try cg.buf.store_mem(alloc, .R8, 8_i32, .R9, 8_usize);
            try cg.buf.load_mem(alloc, .R8, .R8, 0_i32, 8_usize, false);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
            try cg.buf.add_rr(alloc, .R8, .R9);
            if env.is_niche_id_opt(op.ty0) {
                try cg_load_val_from_mem(alloc, cg, eir_prog, env, dst, .R8, 0_i32, op.ty0);
            } else {
                try cg.buf.mov_ri64(alloc, .Rax, 1_u64);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 1_usize);
                try cg_emit_copy_mem(alloc, cg, .Rbp, doff +% voff, .R8, 0_i32, esz);
            }
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_empty);
            try cg_emit_opt_null(alloc, cg, eir_prog, env, dst, ret_ty);
            cg.buf.bind_label(l_done);
        }
        .BufLen => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, 8_i32, 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .BufCap => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, 16_i32, 8_usize, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .BufClear => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .R8, 8_i32, .Rax, 8_usize);
        }
        .BufAsSlice => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            let doff = cg_val_stack_off(cg, dst);
            try cg.buf.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
            try cg.buf.load_mem(alloc, .Rdx, .R8, 8_i32, 8_usize, false);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% 8_i32, .Rdx, 8_usize);
        }
        .BufAt => {
            let doff = cg_val_stack_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_USIZE).trunc.[i32]();
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9); }
            try cg.buf.load_mem(alloc, .R10, .R8, 8_i32, 8_usize, false);
            let l_oob = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, .R9, .R10);
            try cg.buf.jcc_label(alloc, .Ae, l_oob);
            try cg.buf.load_mem(alloc, .R8, .R8, 0_i32, 8_usize, false);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
            try cg.buf.add_rr(alloc, .R8, .R9);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R8, 8_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            try cg.buf.mov_ri64(alloc, .Rax, 4_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
            cg.buf.bind_label(l_done);
        }
        .BufGet => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9); }
            try cg.buf.load_mem(alloc, .R10, .R8, 8_i32, 8_usize, false);
            let l_oob = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, .R9, .R10);
            try cg.buf.jcc_label(alloc, .Ae, l_oob);
            try cg.buf.load_mem(alloc, .R8, .R8, 0_i32, 8_usize, false);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
            try cg.buf.add_rr(alloc, .R8, .R9);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .R8);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            cg.buf.bind_label(l_done);
        }
        .BufSub => {
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .R11, .R8, 8_i32, 8_usize, false);
            try cg.buf.load_mem(alloc, .R8, .R8, 0_i32, 8_usize, false);
            if args.len > 1_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9); }
            if args.len > 2_usize { try cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], .R10); }
            let l_oob = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.cmp_rr(alloc, .R9, .R10);
            try cg.buf.jcc_label(alloc, .A, l_oob);
            try cg.buf.cmp_rr(alloc, .R10, .R11);
            try cg.buf.jcc_label(alloc, .A, l_oob);
            try cg.buf.sub_rr(alloc, .R10, .R9);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
            try cg.buf.add_rr(alloc, .R8, .R9);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R8, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .R10, 8_usize);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            try cg.buf.mov_ri64(alloc, .Rax, 4_u64);
            try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .Rax, 8_usize);
            cg.buf.bind_label(l_done);
        }
        .BufDestroy => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
            try cg.buf.load_mem(alloc, .Rsi, .R8, 0_i32, 8_usize, false);
            try cg.buf.load_mem(alloc, .Rdx, .R8, 16_i32, 8_usize, false);
            if esz != 1_usize { try cg.buf.imul_rri32(alloc, .Rdx, .Rdx, esz.trunc.[i32]()); }
            try cg_call_free_raw(alloc, cg, interner);
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_atomic_mmio(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
) -> !OutOfMemory {
    let raw_sz = env.x64_layout(op.ty0).size;
    let sz = if raw_sz < 1_usize { 1_usize } else if raw_sz > 8_usize { 8_usize } else { raw_sz };
    match op.kind {
        .AtomicNew => {
            if args.len > 0_usize {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], .Rax);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            }
        }
        .AtomicLoad => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, 0_i32, sz, env.is_signed_int(op.ty0));
            try cg.buf.lfence(alloc);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .AtomicStore => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], .Rax); }
            try cg.buf.xchg_mem(alloc, .R8, .Rax, sz);
        }
        .AtomicFetchAdd => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], .Rax); }
            try cg.buf.lock_xadd(alloc, .R8, .Rax, sz);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .AtomicFetchSub => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], .Rax); }
            try cg.buf.neg_r(alloc, .Rax);
            try cg.buf.lock_xadd(alloc, .R8, .Rax, sz);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .AtomicSwap => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], .Rax); }
            try cg.buf.xchg_mem(alloc, .R8, .Rax, sz);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .AtomicCas => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], .Rax); }
            if args.len > 2_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[2_usize], .Rcx); }
            try cg.buf.lock_cmpxchg(alloc, .R8, .Rcx, sz);
            try cg.buf.setcc(alloc, .E, .Rax);
            try cg.buf.extend_reg(alloc, .Rax, .Rax, 8_u8, false);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .MmioRead => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            try cg.buf.load_mem(alloc, .Rax, .R8, 0_i32, sz, env.is_signed_int(op.ty0));
            try cg.buf.lfence(alloc);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .MmioWrite => {
            try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
            if args.len > 1_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], .Rax); }
            try cg.buf.store_mem(alloc, .R8, 0_i32, .Rax, sz);
            try cg.buf.sfence(alloc);
        }
        .RawPtrFromUsize => {
            if args.len > 0_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[0_usize], .Rax);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            }
        }
        .RawPtrAsUsize => {
            if args.len > 0_usize {
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[0_usize], .Rax);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            }
        }
        _ => {}
    }
    return;
}

fn array_len_from_arg(eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, v: eir.EirValue) -> u64 {
    var ty = eir_prog.fn_val_ty(fn_id, v);
    let n0 = env.get(ty);
    if n0.kind == .Borrow && n0.borrow_kind == .Single {
        ty = n0.primary;
    }
    let n1 = env.get(ty);
    if n1.kind == .Array {
        return n1.u64_val;
    }
    return 0_u64;
}

fn cg_emit_builtin_slice_array(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
) -> !OutOfMemory {
    let raw_esz = env.x64_layout(op.ty0).size;
    let esz = if raw_esz == 0_usize { 1_usize } else { raw_esz };
    match op.kind {
        .SliceLen => {
            if args.len > 0_usize {
                let soff = cg_val_stack_off(cg, args[0_usize]);
                try cg.buf.load_mem(alloc, .Rax, .Rbp, soff +% 8_i32, 8_usize, false);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            }
        }
        .StrLen => {
            if args.len > 0_usize {
                let soff = cg_val_stack_off(cg, args[0_usize]);
                try cg.buf.load_mem(alloc, .Rax, .Rbp, soff +% 8_i32, 8_usize, false);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
            }
        }
        .ArrayLen => {
            let alen = if args.len > 0_usize { array_len_from_arg(eir_prog, cg.fn_id, env, args[0_usize]) } else { 0_u64 };
            try cg.buf.mov_ri64(alloc, .Rax, alen);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .StrAsBytes => {
            if args.len > 0_usize {
                try cg_copy_val_to_val(alloc, cg, eir_prog, env, dst, args[0_usize]);
            }
        }
        .BytesAsStr => {
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            if args.len > 0_usize {
                let soff = cg_val_stack_off(cg, args[0_usize]);
                try cg.buf.load_mem(alloc, .Rdi, .Rbp, soff, 8_usize, false);
                try cg.buf.load_mem(alloc, .Rsi, .Rbp, soff +% 8_i32, 8_usize, false);
                try cg_helper_call(alloc, cg, interner, "eon_rt_validate_utf8");
                let l_err = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.test_rr(alloc, .Rax, .Rax);
                try cg.buf.jcc_label(alloc, .E, l_err);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
                try cg.buf.load_mem(alloc, .R8, .Rbp, soff, 8_usize, false);
                try cg.buf.load_mem(alloc, .R9, .Rbp, soff +% 8_i32, 8_usize, false);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R8, 8_usize);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .R9, 8_usize);
                try cg.buf.jmp_label(alloc, l_done);
                cg.buf.bind_label(l_err);
                try cg.buf.mov_ri64(alloc, .Rax, 5_u64);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .Rax, 8_usize);
                cg.buf.bind_label(l_done);
            }
        }
        .SliceAt => {
            let doff = cg_val_stack_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_USIZE).trunc.[i32]();
            if args.len > 1_usize {
                let soff = cg_val_stack_off(cg, args[0_usize]);
                try cg.buf.load_mem(alloc, .R8, .Rbp, soff, 8_usize, false);
                try cg.buf.load_mem(alloc, .R10, .Rbp, soff +% 8_i32, 8_usize, false);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, .R9, .R10);
                try cg.buf.jcc_label(alloc, .Ae, l_oob);
                if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
                try cg.buf.add_rr(alloc, .R8, .R9);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R8, 8_usize);
                try cg.buf.jmp_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.mov_ri64(alloc, .Rax, 4_u64);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
                cg.buf.bind_label(l_done);
            }
        }
        .ArrayAt => {
            let doff = cg_val_stack_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_USIZE).trunc.[i32]();
            if args.len > 1_usize {
                let alen = array_len_from_arg(eir_prog, cg.fn_id, env, args[0_usize]);
                try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9);
                try cg.buf.mov_ri64(alloc, .R10, alen);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, .R9, .R10);
                try cg.buf.jcc_label(alloc, .Ae, l_oob);
                if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
                try cg.buf.add_rr(alloc, .R8, .R9);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R8, 8_usize);
                try cg.buf.jmp_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.mov_ri64(alloc, .Rax, 4_u64);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
                cg.buf.bind_label(l_done);
            }
        }
        .SliceGet => {
            if args.len > 1_usize {
                let soff = cg_val_stack_off(cg, args[0_usize]);
                try cg.buf.load_mem(alloc, .R8, .Rbp, soff, 8_usize, false);
                try cg.buf.load_mem(alloc, .R10, .Rbp, soff +% 8_i32, 8_usize, false);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, .R9, .R10);
                try cg.buf.jcc_label(alloc, .Ae, l_oob);
                if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
                try cg.buf.add_rr(alloc, .R8, .R9);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .R8);
                try cg.buf.jmp_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
                cg.buf.bind_label(l_done);
            }
        }
        .ArrayGet => {
            if args.len > 1_usize {
                let alen = array_len_from_arg(eir_prog, cg.fn_id, env, args[0_usize]);
                try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9);
                try cg.buf.mov_ri64(alloc, .R10, alen);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, .R9, .R10);
                try cg.buf.jcc_label(alloc, .Ae, l_oob);
                if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
                try cg.buf.add_rr(alloc, .R8, .R9);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .R8);
                try cg.buf.jmp_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
                cg.buf.bind_label(l_done);
            }
        }
        .SliceSub => {
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            if args.len > 2_usize {
                let soff = cg_val_stack_off(cg, args[0_usize]);
                try cg.buf.load_mem(alloc, .R8, .Rbp, soff, 8_usize, false);
                try cg.buf.load_mem(alloc, .R11, .Rbp, soff +% 8_i32, 8_usize, false);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], .R10);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, .R9, .R10);
                try cg.buf.jcc_label(alloc, .A, l_oob);
                try cg.buf.cmp_rr(alloc, .R10, .R11);
                try cg.buf.jcc_label(alloc, .A, l_oob);
                try cg.buf.sub_rr(alloc, .R10, .R9);
                if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
                try cg.buf.add_rr(alloc, .R8, .R9);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R8, 8_usize);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .R10, 8_usize);
                try cg.buf.jmp_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.mov_ri64(alloc, .Rax, 4_u64);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .Rax, 8_usize);
                cg.buf.bind_label(l_done);
            }
        }
        .ArraySub => {
            let doff = cg_val_stack_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            if args.len > 2_usize {
                let alen = array_len_from_arg(eir_prog, cg.fn_id, env, args[0_usize]);
                try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
                try cg.buf.mov_ri64(alloc, .R11, alen);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], .R9);
                try cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], .R10);
                let l_oob = try cg.buf.new_label(alloc);
                let l_done = try cg.buf.new_label(alloc);
                try cg.buf.cmp_rr(alloc, .R9, .R10);
                try cg.buf.jcc_label(alloc, .A, l_oob);
                try cg.buf.cmp_rr(alloc, .R10, .R11);
                try cg.buf.jcc_label(alloc, .A, l_oob);
                try cg.buf.sub_rr(alloc, .R10, .R9);
                if esz != 1_usize { try cg.buf.imul_rri32(alloc, .R9, .R9, esz.trunc.[i32]()); }
                try cg.buf.add_rr(alloc, .R8, .R9);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .R8, 8_usize);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .R10, 8_usize);
                try cg.buf.jmp_label(alloc, l_done);
                cg.buf.bind_label(l_oob);
                try cg.buf.mov_ri64(alloc, .Rax, 4_u64);
                try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
                try cg.buf.xor_rr32(alloc, .Rax, .Rax);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .Rax, 8_usize);
                cg.buf.bind_label(l_done);
            }
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_math(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
) -> !OutOfMemory {
    if args.len == 0_usize {
        return;
    }
    let aty = eir_prog.fn_val_ty(cg.fn_id, args[0_usize]);
    let an = env.get(aty);
    let is_f64 = an.kind == .Float && an.u8_val == 64_u8;
    let bytes = env.x64_layout(aty).size;
    let is_64 = bytes >= 8_usize;
    match op.kind {
        .MathSqrt => {
            try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[0_usize], .Xmm0);
            try cg.buf.sqrt_f(alloc, is_f64, .Xmm0, .Xmm0);
            try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
        }
        .MathFma => {
            if args.len >= 3_usize {
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[0_usize], .Xmm0);
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[1_usize], .Xmm1);
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[2_usize], .Xmm2);
                try cg.buf.vfmadd213(alloc, is_f64, .Xmm0, .Xmm1, .Xmm2);
                try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
            }
        }
        .MathLzcnt => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], .Rcx);
            if bytes < 4_usize {
                try cg.buf.extend_reg(alloc, .Rcx, .Rcx, (bytes *% 8_usize).trunc.[u8](), false);
            }
            let l_z = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.test_rr(alloc, .Rcx, .Rcx);
            try cg.buf.jcc_label(alloc, .E, l_z);
            try cg.buf.bsr(alloc, is_64, .Rax, .Rcx);
            let top = if is_64 { 63_u64 } else { ((bytes *% 8_usize) -% 1_usize).widen.[u64]() };
            try cg.buf.mov_ri64(alloc, .Rdx, top);
            try cg.buf.sub_rr(alloc, .Rdx, .Rax);
            try cg.buf.mov_rr(alloc, .Rax, .Rdx);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_z);
            try cg.buf.mov_ri64(alloc, .Rax, (bytes *% 8_usize).widen.[u64]());
            cg.buf.bind_label(l_done);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .MathTzcnt => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], .Rcx);
            if bytes < 4_usize {
                try cg.buf.extend_reg(alloc, .Rcx, .Rcx, (bytes *% 8_usize).trunc.[u8](), false);
            }
            let l_z = try cg.buf.new_label(alloc);
            let l_done = try cg.buf.new_label(alloc);
            try cg.buf.test_rr(alloc, .Rcx, .Rcx);
            try cg.buf.jcc_label(alloc, .E, l_z);
            try cg.buf.bsf(alloc, is_64, .Rax, .Rcx);
            try cg.buf.jmp_label(alloc, l_done);
            cg.buf.bind_label(l_z);
            try cg.buf.mov_ri64(alloc, .Rax, (bytes *% 8_usize).widen.[u64]());
            cg.buf.bind_label(l_done);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .MathPopcnt => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], .Rcx);
            if bytes < 8_usize {
                try cg.buf.extend_reg(alloc, .Rcx, .Rcx, (bytes *% 8_usize).trunc.[u8](), false);
            }
            try cg.buf.popcnt(alloc, true, .Rax, .Rcx);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .MathBswap => {
            try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], .Rax);
            try cg.buf.bswap(alloc, bytes, .Rax);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        _ => {}
    }
    return;
}

// ===========================================================================
// Section 7B: Builtin Ops — Vec, ParReduce, Fs/Io/Sys, Schedule & Dispatcher
// ===========================================================================

fn cg_emit_vec_cmp(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    cmp_op: ast.BinaryOp,
    vec_ty: types.TyId,
    args: *[eir.EirValue],
) -> !OutOfMemory {
    if args.len < 2_usize {
        return;
    }
    let vn = env.get(vec_ty);
    if vn.kind != .Vec {
        return;
    }
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let aoff = cg_val_stack_off(cg, args[0_usize]);
    let boff = cg_val_stack_off(cg, args[1_usize]);
    let doff = cg_val_stack_off(cg, dst);
    if (elem == types.TY_U8 || elem == types.TY_I8) && lanes == 16_usize && cmp_op == .Eq {
        try cg.buf.movups_load(alloc, .Xmm0, .Rbp, aoff);
        try cg.buf.movups_load(alloc, .Xmm1, .Rbp, boff);
        try cg.buf.sse_66_bin(alloc, 0x74_u8, .Xmm0, .Xmm1);
        try cg.buf.mov_ri64(alloc, .Rax, 0x0101010101010101_u64);
        try cg.buf.movq_xmm_r64(alloc, .Xmm1, .Rax);
        try cg.buf.sse_66_bin(alloc, 0x6C_u8, .Xmm1, .Xmm1);
        try cg.buf.sse_66_bin(alloc, 0xDB_u8, .Xmm0, .Xmm1);
        try cg.buf.movups_store(alloc, .Rbp, doff, .Xmm0);
        return;
    }
    let esz_r = env.x64_layout(elem).size;
    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
    let en = env.get(elem);
    let sgn = env.is_signed_int(elem);
    var li: usize = 0_usize;
    while li < lanes {
        let ao = aoff +% (li *% esz).trunc.[i32]();
        let bo = boff +% (li *% esz).trunc.[i32]();
        if en.kind == .Float {
            let is_f16 = en.u8_val == 16_u8;
            let is_f64 = en.u8_val == 64_u8;
            if is_f16 {
                try cg.buf.load_mem(alloc, .Rdi, .Rbp, bo, 2_usize, false);
                try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
                try cg.buf.movss_store(alloc, .Rbp, cg.frame.temp_copy_off, .Xmm0);
                try cg.buf.load_mem(alloc, .Rdi, .Rbp, ao, 2_usize, false);
                try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
                try cg.buf.movss_load(alloc, .Xmm1, .Rbp, cg.frame.temp_copy_off);
            } else if is_f64 {
                try cg.buf.movsd_load(alloc, .Xmm0, .Rbp, ao);
                try cg.buf.movsd_load(alloc, .Xmm1, .Rbp, bo);
            } else {
                try cg.buf.movss_load(alloc, .Xmm0, .Rbp, ao);
                try cg.buf.movss_load(alloc, .Xmm1, .Rbp, bo);
            }
            let use_f64 = !is_f16 && is_f64;
            match cmp_op {
                .Eq => {
                    try cg.buf.ucomi(alloc, use_f64, .Xmm0, .Xmm1);
                    try cg.buf.setcc(alloc, .E, .Rax);
                    try cg.buf.setcc(alloc, .Np, .Rcx);
                    try cg.buf.and_rr(alloc, .Rax, .Rcx);
                }
                .NotEq => {
                    try cg.buf.ucomi(alloc, use_f64, .Xmm0, .Xmm1);
                    try cg.buf.setcc(alloc, .Ne, .Rax);
                    try cg.buf.setcc(alloc, .P, .Rcx);
                    try cg.buf.or_rr(alloc, .Rax, .Rcx);
                }
                .Lt => {
                    try cg.buf.ucomi(alloc, use_f64, .Xmm1, .Xmm0);
                    try cg.buf.setcc(alloc, .A, .Rax);
                }
                .LtEq => {
                    try cg.buf.ucomi(alloc, use_f64, .Xmm1, .Xmm0);
                    try cg.buf.setcc(alloc, .Ae, .Rax);
                }
                .Gt => {
                    try cg.buf.ucomi(alloc, use_f64, .Xmm0, .Xmm1);
                    try cg.buf.setcc(alloc, .A, .Rax);
                }
                _ => {
                    try cg.buf.ucomi(alloc, use_f64, .Xmm0, .Xmm1);
                    try cg.buf.setcc(alloc, .Ae, .Rax);
                }
            }
        } else {
            try cg.buf.load_mem(alloc, .Rax, .Rbp, ao, esz, sgn);
            try cg.buf.load_mem(alloc, .Rcx, .Rbp, bo, esz, sgn);
            try cg.buf.cmp_rr(alloc, .Rax, .Rcx);
            var cc: x64_asm.Cond = .E;
            match cmp_op {
                .Eq => { cc = .E; }
                .NotEq => { cc = .Ne; }
                .Lt => { cc = if sgn { .L } else { .B }; }
                .LtEq => { cc = if sgn { .Le } else { .Be }; }
                .Gt => { cc = if sgn { .G } else { .A }; }
                _ => { cc = if sgn { .Ge } else { .Ae }; }
            }
            try cg.buf.setcc(alloc, cc, .Rax);
        }
        try cg.buf.store_mem(alloc, .Rbp, doff +% li.trunc.[i32](), .Rax, 1_usize);
        li = li +% 1_usize;
    }
    return;
}

fn cg_emit_vec_reduce_or_dot(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
) -> !OutOfMemory {
    if args.len == 0_usize {
        return;
    }
    let vn = env.get(op.ty0);
    if vn.kind != .Vec {
        return;
    }
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem);
    let esz_r = env.x64_layout(elem).size;
    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
    let sgn = env.is_signed_int(elem);
    let aoff = cg_val_stack_off(cg, args[0_usize]);
    let is_dot = op.kind == .VecDot;
    let boff: i32 = if is_dot && args.len > 1_usize { cg_val_stack_off(cg, args[1_usize]) } else { 0_i32 };

    if en.kind == .Float {
        let is_f64 = en.u8_val == 64_u8;
        var li: usize = 0_usize;
        while li < lanes {
            let ld = (li *% esz).trunc.[i32]();
            if is_f64 { try cg.buf.movsd_load(alloc, .Xmm1, .Rbp, aoff +% ld); }
            else { try cg.buf.movss_load(alloc, .Xmm1, .Rbp, aoff +% ld); }
            if is_dot {
                if is_f64 { try cg.buf.movsd_load(alloc, .Xmm2, .Rbp, boff +% ld); }
                else { try cg.buf.movss_load(alloc, .Xmm2, .Rbp, boff +% ld); }
                try cg.buf.sse_bin(alloc, is_f64, 0x59_u8, .Xmm1, .Xmm2);
            }
            if li == 0_usize {
                try cg.buf.sse_bin(alloc, is_f64, 0x10_u8, .Xmm0, .Xmm1);
            } else {
                let opc: u8 = if op.kind == .VecReduceMin { 0x5D_u8 } else if op.kind == .VecReduceMax { 0x5F_u8 } else { 0x58_u8 };
                try cg.buf.sse_bin(alloc, is_f64, opc, .Xmm0, .Xmm1);
            }
            li = li +% 1_usize;
        }
        try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0);
        return;
    }

    var li: usize = 0_usize;
    while li < lanes {
        let ld = (li *% esz).trunc.[i32]();
        try cg.buf.load_mem(alloc, .Rcx, .Rbp, aoff +% ld, esz, sgn);
        if is_dot {
            try cg.buf.load_mem(alloc, .Rdx, .Rbp, boff +% ld, esz, sgn);
            try cg.buf.imul_rr(alloc, .Rcx, .Rdx);
        }
        if li == 0_usize {
            try cg.buf.mov_rr(alloc, .Rax, .Rcx);
        } else if op.kind == .VecReduceMin {
            try cg.buf.cmp_rr(alloc, .Rcx, .Rax);
            try cg.buf.cmovcc(alloc, if sgn { .L } else { .B }, .Rax, .Rcx);
        } else if op.kind == .VecReduceMax {
            try cg.buf.cmp_rr(alloc, .Rcx, .Rax);
            try cg.buf.cmovcc(alloc, if sgn { .G } else { .A }, .Rax, .Rcx);
        } else {
            try cg.buf.add_rr(alloc, .Rax, .Rcx);
        }
        li = li +% 1_usize;
    }
    try cg_emit_norm_subword(alloc, cg, env, elem, .Rax);
    try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
    return;
}

fn cg_emit_builtin_vec(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
) -> !OutOfMemory {
    match op.kind {
        .VecSplat => {
            if args.len == 0_usize { return; }
            let vn = env.get(op.ty0);
            let elem = vn.primary;
            let lanes = vn.u8_val.widen.[usize]();
            let esz_r = env.x64_layout(elem).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            let doff = cg_val_stack_off(cg, dst);
            let en = env.get(elem);
            if en.kind == .Float && en.u8_val != 16_u8 {
                let is_f64 = en.u8_val == 64_u8;
                try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[0_usize], .Xmm0);
                var li: usize = 0_usize;
                while li < lanes {
                    if is_f64 { try cg.buf.movsd_store(alloc, .Rbp, doff +% (li *% esz).trunc.[i32](), .Xmm0); }
                    else { try cg.buf.movss_store(alloc, .Rbp, doff +% (li *% esz).trunc.[i32](), .Xmm0); }
                    li = li +% 1_usize;
                }
            } else {
                try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], .Rax);
                var li: usize = 0_usize;
                while li < lanes {
                    try cg.buf.store_mem(alloc, .Rbp, doff +% (li *% esz).trunc.[i32](), .Rax, esz);
                    li = li +% 1_usize;
                }
            }
        }
        .VecLen => {
            try cg.buf.mov_ri64(alloc, .Rax, op.len_u8.widen.[u64]());
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .VecCmp => {
            try cg_emit_vec_cmp(alloc, cg, env, interner, dst, op.bin_op, op.ty0, args);
        }
        .VecMaskAny => {
            if args.len == 0_usize { return; }
            let lanes = op.len_u8.widen.[usize]();
            let aoff = cg_val_stack_off(cg, args[0_usize]);
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            var li: usize = 0_usize;
            while li < lanes {
                try cg.buf.load_mem(alloc, .Rcx, .Rbp, aoff +% li.trunc.[i32](), 1_usize, false);
                try cg.buf.or_rr(alloc, .Rax, .Rcx);
                li = li +% 1_usize;
            }
            try cg.buf.test_rr32(alloc, .Rax, .Rax);
            try cg.buf.setcc(alloc, .Ne, .Rax);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .VecMaskAll => {
            if args.len == 0_usize { return; }
            let lanes = op.len_u8.widen.[usize]();
            let aoff = cg_val_stack_off(cg, args[0_usize]);
            try cg.buf.mov_ri64(alloc, .Rax, 1_u64);
            var li: usize = 0_usize;
            while li < lanes {
                try cg.buf.load_mem(alloc, .Rcx, .Rbp, aoff +% li.trunc.[i32](), 1_usize, false);
                try cg.buf.and_rr(alloc, .Rax, .Rcx);
                li = li +% 1_usize;
            }
            try cg.buf.and_ri32(alloc, .Rax, 1_i32);
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .VecBitmask => {
            if args.len == 0_usize { return; }
            let lanes = op.len_u8.widen.[usize]();
            let aoff = cg_val_stack_off(cg, args[0_usize]);
            if lanes == 16_usize {
                try cg.buf.movups_load(alloc, .Xmm0, .Rbp, aoff);
                try cg.buf.psllw_imm(alloc, .Xmm0, 7_u8);
                try cg.buf.pmovmskb(alloc, .Rax, .Xmm0);
                try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
                return;
            }
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            var li: usize = 0_usize;
            while li < lanes {
                try cg.buf.load_mem(alloc, .Rcx, .Rbp, aoff +% li.trunc.[i32](), 1_usize, false);
                try cg.buf.and_ri32(alloc, .Rcx, 1_i32);
                if li > 0_usize { try cg.buf.shl_imm(alloc, .Rcx, li.trunc.[u8]()); }
                try cg.buf.or_rr(alloc, .Rax, .Rcx);
                li = li +% 1_usize;
            }
            try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        }
        .VecSelect => {
            if args.len < 3_usize { return; }
            let vn = env.get(op.ty0);
            let elem = vn.primary;
            let lanes = vn.u8_val.widen.[usize]();
            let esz_r = env.x64_layout(elem).size;
            let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
            let moff = cg_val_stack_off(cg, args[0_usize]);
            let aoff = cg_val_stack_off(cg, args[1_usize]);
            let boff = cg_val_stack_off(cg, args[2_usize]);
            let doff = cg_val_stack_off(cg, dst);
            var li: usize = 0_usize;
            while li < lanes {
                let ld = (li *% esz).trunc.[i32]();
                try cg.buf.load_mem(alloc, .Rax, .Rbp, boff +% ld, esz, false);
                try cg.buf.load_mem(alloc, .Rcx, .Rbp, aoff +% ld, esz, false);
                try cg.buf.load_mem(alloc, .Rdx, .Rbp, moff +% li.trunc.[i32](), 1_usize, false);
                try cg.buf.test_rr32(alloc, .Rdx, .Rdx);
                try cg.buf.cmovcc(alloc, .Ne, .Rax, .Rcx);
                try cg.buf.store_mem(alloc, .Rbp, doff +% ld, .Rax, esz);
                li = li +% 1_usize;
            }
        }
        .VecMin => {
            try cg_emit_vec_minmax_fma(alloc, cg, env, dst, op, args);
        }
        .VecMax => {
            try cg_emit_vec_minmax_fma(alloc, cg, env, dst, op, args);
        }
        .VecFma => {
            try cg_emit_vec_minmax_fma(alloc, cg, env, dst, op, args);
        }
        .VecReduceAdd => {
            try cg_emit_vec_reduce_or_dot(alloc, cg, eir_prog, env, interner, dst, op, args);
        }
        .VecReduceMin => {
            try cg_emit_vec_reduce_or_dot(alloc, cg, eir_prog, env, interner, dst, op, args);
        }
        .VecReduceMax => {
            try cg_emit_vec_reduce_or_dot(alloc, cg, eir_prog, env, interner, dst, op, args);
        }
        .VecDot => {
            try cg_emit_vec_reduce_or_dot(alloc, cg, eir_prog, env, interner, dst, op, args);
        }
        .VecShuffle => {
            try cg_emit_vec_shuffle(alloc, cg, env, dst, op, args);
        }
        _ => {}
    }
    return;
}

fn cg_emit_vec_minmax_fma(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
) -> !OutOfMemory {
    if args.len < 2_usize { return; }
    let vn = env.get(op.ty0);
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem);
    let esz_r = env.x64_layout(elem).size;
    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
    let sgn = env.is_signed_int(elem);
    let aoff = cg_val_stack_off(cg, args[0_usize]);
    let boff = cg_val_stack_off(cg, args[1_usize]);
    let coff: i32 = if op.kind == .VecFma && args.len > 2_usize { cg_val_stack_off(cg, args[2_usize]) } else { 0_i32 };
    let doff = cg_val_stack_off(cg, dst);
    var li: usize = 0_usize;
    while li < lanes {
        let ld = (li *% esz).trunc.[i32]();
        if en.kind == .Float {
            let is_f64 = en.u8_val == 64_u8;
            if is_f64 {
                try cg.buf.movsd_load(alloc, .Xmm0, .Rbp, aoff +% ld);
                try cg.buf.movsd_load(alloc, .Xmm1, .Rbp, boff +% ld);
            } else {
                try cg.buf.movss_load(alloc, .Xmm0, .Rbp, aoff +% ld);
                try cg.buf.movss_load(alloc, .Xmm1, .Rbp, boff +% ld);
            }
            if op.kind == .VecFma {
                if is_f64 { try cg.buf.movsd_load(alloc, .Xmm2, .Rbp, coff +% ld); }
                else { try cg.buf.movss_load(alloc, .Xmm2, .Rbp, coff +% ld); }
                try cg.buf.sse_bin(alloc, is_f64, 0x59_u8, .Xmm0, .Xmm1);
                try cg.buf.sse_bin(alloc, is_f64, 0x58_u8, .Xmm0, .Xmm2);
            } else {
                let opc: u8 = if op.kind == .VecMin { 0x5D_u8 } else { 0x5F_u8 };
                try cg.buf.sse_bin(alloc, is_f64, opc, .Xmm0, .Xmm1);
            }
            if is_f64 { try cg.buf.movsd_store(alloc, .Rbp, doff +% ld, .Xmm0); }
            else { try cg.buf.movss_store(alloc, .Rbp, doff +% ld, .Xmm0); }
        } else {
            try cg.buf.load_mem(alloc, .Rax, .Rbp, aoff +% ld, esz, sgn);
            try cg.buf.load_mem(alloc, .Rcx, .Rbp, boff +% ld, esz, sgn);
            try cg.buf.cmp_rr(alloc, .Rcx, .Rax);
            let cc: x64_asm.Cond = if op.kind == .VecMin {
                if sgn { .L } else { .B }
            } else {
                if sgn { .G } else { .A }
            };
            try cg.buf.cmovcc(alloc, cc, .Rax, .Rcx);
            try cg.buf.store_mem(alloc, .Rbp, doff +% ld, .Rax, esz);
        }
        li = li +% 1_usize;
    }
    return;
}

fn cg_emit_vec_shuffle(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    env: *types.TypeEnv,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
) -> !OutOfMemory {
    let sn = env.get(op.ty0);
    let in_n = env.get(op.ty1);
    if sn.kind != .Vec || in_n.kind != .Vec {
        return;
    }
    let elem = sn.primary;
    let src_lanes = sn.u8_val.widen.[usize]();
    let out_lanes = in_n.u8_val.widen.[usize]();
    let idx_esz_r = env.x64_layout(in_n.primary).size;
    let idx_esz = if idx_esz_r == 0_usize { 1_usize } else { idx_esz_r };
    let esz_r = env.x64_layout(elem).size;
    let esz = if esz_r == 0_usize { 1_usize } else { esz_r };
    let two_src = op.flag;
    if args.len < 2_usize {
        return;
    }
    if two_src && args.len < 3_usize {
        return;
    }
    let aoff = cg_val_stack_off(cg, args[0_usize]);
    let boff: i32 = if two_src { cg_val_stack_off(cg, args[1_usize]) } else { aoff };
    var ioff: i32 = cg_val_stack_off(cg, args[1_usize]);
    if two_src {
        if args.len >= 3_usize {
            ioff = cg_val_stack_off(cg, args[2_usize]);
        }
    }
    let doff = cg_val_stack_off(cg, dst);
    let total_lanes = if two_src { src_lanes *% 2_usize } else { src_lanes };
    if total_lanes == 0_usize {
        return;
    }
    var li: usize = 0_usize;
    while li < out_lanes {
        try cg.buf.load_mem(alloc, .Rcx, .Rbp, ioff +% (li *% idx_esz).trunc.[i32](), idx_esz, false);
        try cg.buf.mov_ri64(alloc, .Rdx, (total_lanes -% 1_usize).widen.[u64]());
        try cg.buf.cmp_rr(alloc, .Rcx, .Rdx);
        try cg.buf.cmovcc(alloc, .A, .Rcx, .Rdx);
        try cg.buf.lea_mem(alloc, .R8, .Rbp, aoff);
        if two_src {
            let l_first = try cg.buf.new_label(alloc);
            try cg.buf.mov_ri64(alloc, .R9, src_lanes.widen.[u64]());
            try cg.buf.cmp_rr(alloc, .Rcx, .R9);
            try cg.buf.jcc_label(alloc, .B, l_first);
            try cg.buf.sub_rr(alloc, .Rcx, .R9);
            try cg.buf.lea_mem(alloc, .R8, .Rbp, boff);
            cg.buf.bind_label(l_first);
        }
        if esz != 1_usize { try cg.buf.imul_rri32(alloc, .Rcx, .Rcx, esz.trunc.[i32]()); }
        try cg.buf.add_rr(alloc, .R8, .Rcx);
        try cg.buf.load_mem(alloc, .Rax, .R8, 0_i32, esz, false);
        try cg.buf.store_mem(alloc, .Rbp, doff +% (li *% esz).trunc.[i32](), .Rax, esz);
        li = li +% 1_usize;
    }
    return;
}

fn cg_emit_par_reduce(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    op: cfg_ir.CfgBuiltinOp,
    args: *[eir.EirValue],
) -> !OutOfMemory {
    if args.len == 0_usize {
        return;
    }
    let elem_ty = op.ty0;
    let op_name = interner.get(op.sym);
    let en = env.get(elem_ty);
    let is_flt = en.kind == .Float;
    let is_f16 = is_flt && en.u8_val == 16_u8;
    let is_f64 = is_flt && en.u8_val == 64_u8;
    let raw_sz = env.x64_layout(elem_ty).size;
    let esz = if raw_sz < 1_usize { 1_usize } else if raw_sz > 8_usize { 8_usize } else { raw_sz };
    let signed = env.is_signed_int(elem_ty);
    let soff = cg_val_stack_off(cg, args[0_usize]);
    let tmp = cg.frame.temp_copy_off;

    if is_f16 {
        try cg.buf.load_mem(alloc, .R8, .Rbp, soff, 8_usize, false);
        try cg.buf.load_mem(alloc, .R9, .Rbp, soff +% 8_i32, 8_usize, false);
        try cg.buf.store_mem(alloc, .Rbp, tmp, .R8, 8_usize);
        try cg.buf.store_mem(alloc, .Rbp, tmp +% 8_i32, .R9, 8_usize);
        if args.len > 2_usize { try cg_load_scalar_raw(alloc, cg, eir_prog, env, args[2_usize], .Rax); }
        else { try cg.buf.xor_rr32(alloc, .Rax, .Rax); }
        try cg.buf.store_mem(alloc, .Rbp, tmp +% 16_i32, .Rax, 2_usize);
        let l_hd = try cg.buf.new_label(alloc);
        let l_end = try cg.buf.new_label(alloc);
        cg.buf.bind_label(l_hd);
        try cg.buf.load_mem(alloc, .R9, .Rbp, tmp +% 8_i32, 8_usize, false);
        try cg.buf.test_rr(alloc, .R9, .R9);
        try cg.buf.jcc_label(alloc, .E, l_end);
        try cg.buf.sub_ri32(alloc, .R9, 1_i32);
        try cg.buf.store_mem(alloc, .Rbp, tmp +% 8_i32, .R9, 8_usize);
        try cg.buf.load_mem(alloc, .R8, .Rbp, tmp, 8_usize, false);
        try cg.buf.load_mem(alloc, .Rdi, .R8, 0_i32, 2_usize, false);
        try cg.buf.add_ri32(alloc, .R8, 2_i32);
        try cg.buf.store_mem(alloc, .Rbp, tmp, .R8, 8_usize);
        try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        try cg.buf.movss_store(alloc, .Rbp, tmp +% 24_i32, .Xmm0);
        try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 2_usize, false);
        try cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        try cg.buf.movss_load(alloc, .Xmm1, .Rbp, tmp +% 24_i32);
        let opc: u8 = if str.bytes_eq(op_name, "Mul".as_bytes()) { 0x59_u8 }
            else if str.bytes_eq(op_name, "Min".as_bytes()) { 0x5D_u8 }
            else if str.bytes_eq(op_name, "Max".as_bytes()) { 0x5F_u8 }
            else { 0x58_u8 };
        try cg.buf.sse_bin(alloc, false, opc, .Xmm0, .Xmm1);
        try cg_helper_call(alloc, cg, interner, "eon_f32_to_f16");
        try cg.buf.store_mem(alloc, .Rbp, tmp +% 16_i32, .Rax, 2_usize);
        try cg.buf.jmp_label(alloc, l_hd);
        cg.buf.bind_label(l_end);
        try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 16_i32, 2_usize, false);
        try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax);
        return;
    }

    try cg.buf.load_mem(alloc, .R8, .Rbp, soff, 8_usize, false);
    try cg.buf.load_mem(alloc, .R9, .Rbp, soff +% 8_i32, 8_usize, false);
    try cg.buf.xor_rr32(alloc, .R10, .R10);
    if is_flt {
        if args.len > 2_usize { try cg_load_float_val(alloc, cg, eir_prog, env, interner, args[2_usize], .Xmm0); }
        else {
            try cg.buf.xor_rr32(alloc, .Rax, .Rax);
            try cg.buf.movq_xmm_r64(alloc, .Xmm0, .Rax);
        }
    } else if args.len > 2_usize {
        try cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], .Rax);
    } else {
        try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    }
    let l_hd = try cg.buf.new_label(alloc);
    let l_end = try cg.buf.new_label(alloc);
    cg.buf.bind_label(l_hd);
    try cg.buf.cmp_rr(alloc, .R10, .R9);
    try cg.buf.jcc_label(alloc, .Ae, l_end);
    if is_flt {
        if is_f64 { try cg.buf.movsd_load(alloc, .Xmm1, .R8, 0_i32); }
        else { try cg.buf.movss_load(alloc, .Xmm1, .R8, 0_i32); }
        let opc: u8 = if str.bytes_eq(op_name, "Mul".as_bytes()) { 0x59_u8 }
            else if str.bytes_eq(op_name, "Min".as_bytes()) { 0x5D_u8 }
            else if str.bytes_eq(op_name, "Max".as_bytes()) { 0x5F_u8 }
            else { 0x58_u8 };
        try cg.buf.sse_bin(alloc, is_f64, opc, .Xmm0, .Xmm1);
    } else {
        try cg.buf.load_mem(alloc, .Rcx, .R8, 0_i32, esz, signed);
        if str.bytes_eq(op_name, "Min".as_bytes()) {
            try cg.buf.cmp_rr(alloc, .Rcx, .Rax);
            try cg.buf.cmovcc(alloc, if signed { .L } else { .B }, .Rax, .Rcx);
        } else if str.bytes_eq(op_name, "Max".as_bytes()) {
            try cg.buf.cmp_rr(alloc, .Rcx, .Rax);
            try cg.buf.cmovcc(alloc, if signed { .G } else { .A }, .Rax, .Rcx);
        } else if str.bytes_eq(op_name, "Mul".as_bytes()) {
            try cg.buf.imul_rr(alloc, .Rax, .Rcx);
            try cg_emit_norm_subword(alloc, cg, env, elem_ty, .Rax);
        } else if str.bytes_eq(op_name, "And".as_bytes()) || str.bytes_eq(op_name, "BitAnd".as_bytes()) {
            try cg.buf.and_rr(alloc, .Rax, .Rcx);
        } else if str.bytes_eq(op_name, "Or".as_bytes()) || str.bytes_eq(op_name, "BitOr".as_bytes()) {
            try cg.buf.or_rr(alloc, .Rax, .Rcx);
        } else if str.bytes_eq(op_name, "Xor".as_bytes()) || str.bytes_eq(op_name, "BitXor".as_bytes()) {
            try cg.buf.xor_rr(alloc, .Rax, .Rcx);
        } else {
            try cg.buf.add_rr(alloc, .Rax, .Rcx);
            try cg_emit_norm_subword(alloc, cg, env, elem_ty, .Rax);
        }
    }
    try cg.buf.add_ri32(alloc, .R8, esz.trunc.[i32]());
    try cg.buf.add_ri32(alloc, .R10, 1_i32);
    try cg.buf.jmp_label(alloc, l_hd);
    cg.buf.bind_label(l_end);
    if is_flt { try cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, .Xmm0); }
    else { try cg_store_scalar_val(alloc, cg, eir_prog, env, dst, .Rax); }
    return;
}

fn cg_emit_open_str(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    interner: *mut span.SymInterner,
    confined: bool,
    dirfd_reg: x64_asm.Reg,
    path_val: eir.EirValue,
    flags: u64,
    mode: u64,
    l_inval: u32,
) -> !OutOfMemory {
    let tmp = cg.frame.temp_copy_off;
    try cg.buf.store_mem(alloc, .Rbp, tmp, dirfd_reg, 8_usize);
    let poff = cg_val_stack_off(cg, path_val);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, poff, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, poff +% 8_i32, 8_usize, false);
    try cg.buf.test_rr(alloc, .Rsi, .Rsi);
    try cg.buf.jcc_label(alloc, .E, l_inval);
    try cg.buf.test_rr(alloc, .Rcx, .Rcx);
    try cg.buf.jcc_label(alloc, .E, l_inval);
    try cg.buf.mov_ri64(alloc, .Rax, 4096_u64);
    try cg.buf.cmp_rr(alloc, .Rcx, .Rax);
    try cg.buf.jcc_label(alloc, .Ae, l_inval);

    try cg.buf.xor_rr32(alloc, .R10, .R10);
    let l_scan = try cg.buf.new_label(alloc);
    let l_scan_ok = try cg.buf.new_label(alloc);
    cg.buf.bind_label(l_scan);
    try cg.buf.cmp_rr(alloc, .R10, .Rcx);
    try cg.buf.jcc_label(alloc, .Ae, l_scan_ok);
    try cg.buf.mov_rr(alloc, .Rdi, .Rsi);
    try cg.buf.add_rr(alloc, .Rdi, .R10);
    try cg.buf.load_mem(alloc, .Rax, .Rdi, 0_i32, 1_usize, false);
    try cg.buf.test_rr32(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_inval);
    try cg.buf.add_ri32(alloc, .R10, 1_i32);
    try cg.buf.jmp_label(alloc, l_scan);
    cg.buf.bind_label(l_scan_ok);

    try cg.buf.lea_mem(alloc, .Rax, .Rcx, 16_i32);
    try cg.buf.and_ri32(alloc, .Rax, -16_i32);
    try cg.buf.sub_rr(alloc, .Rsp, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 8_i32, .Rax, 8_usize);
    try cg.buf.mov_rr(alloc, .Rdi, .Rsp);
    try cg.buf.rep_movsb(alloc);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rdi, 0_i32, .Rax, 1_usize);

    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp, 8_usize, false);
    try cg.buf.mov_rr(alloc, .Rsi, .Rsp);
    try cg.buf.mov_ri64(alloc, .Rdx, flags);
    try cg.buf.mov_ri64(alloc, .Rcx, mode);
    if confined {
        try cg_helper_call(alloc, cg, interner, "eon_rt_openat2_beneath");
    } else {
        try cg.buf.mov_rr(alloc, .R10, .Rcx);
        try cg.buf.mov_ri64(alloc, .Rax, 257_u64);
        try cg.buf.syscall(alloc);
    }
    try cg.buf.mov_rr(alloc, .R8, .Rax);
    try cg.buf.load_mem(alloc, .R9, .Rbp, tmp +% 8_i32, 8_usize, false);
    try cg.buf.add_rr(alloc, .Rsp, .R9);
    try cg.buf.mov_rr(alloc, .Rax, .R8);
    return;
}

fn cg_emit_map_errno(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    errno_reg: x64_asm.Reg,
    dst_reg: x64_asm.Reg,
) -> !OutOfMemory {
    let l_done = try cg.buf.new_label(alloc);
    let l_nf = try cg.buf.new_label(alloc);
    let l_perm = try cg.buf.new_label(alloc);
    let l_esc = try cg.buf.new_label(alloc);
    let l_ex = try cg.buf.new_label(alloc);
    let l_inv = try cg.buf.new_label(alloc);

    try cg.buf.cmp_ri32(alloc, errno_reg, -2_i32);
    try cg.buf.jcc_label(alloc, .E, l_nf);
    try cg.buf.cmp_ri32(alloc, errno_reg, -20_i32);
    try cg.buf.jcc_label(alloc, .E, l_nf);
    try cg.buf.cmp_ri32(alloc, errno_reg, -13_i32);
    try cg.buf.jcc_label(alloc, .E, l_perm);
    try cg.buf.cmp_ri32(alloc, errno_reg, -1_i32);
    try cg.buf.jcc_label(alloc, .E, l_perm);
    try cg.buf.cmp_ri32(alloc, errno_reg, -18_i32);
    try cg.buf.jcc_label(alloc, .E, l_esc);
    try cg.buf.cmp_ri32(alloc, errno_reg, -40_i32);
    try cg.buf.jcc_label(alloc, .E, l_esc);
    try cg.buf.cmp_ri32(alloc, errno_reg, -17_i32);
    try cg.buf.jcc_label(alloc, .E, l_ex);
    try cg.buf.cmp_ri32(alloc, errno_reg, -22_i32);
    try cg.buf.jcc_label(alloc, .E, l_inv);
    try cg.buf.cmp_ri32(alloc, errno_reg, -36_i32);
    try cg.buf.jcc_label(alloc, .E, l_inv);
    try cg.buf.cmp_ri32(alloc, errno_reg, -21_i32);
    try cg.buf.jcc_label(alloc, .E, l_inv);
    try cg.buf.mov_ri64(alloc, dst_reg, 17_u64);
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_nf);
    try cg.buf.mov_ri64(alloc, dst_reg, 12_u64);
    try cg.buf.jmp_label(alloc, l_done);
    cg.buf.bind_label(l_perm);
    try cg.buf.mov_ri64(alloc, dst_reg, 13_u64);
    try cg.buf.jmp_label(alloc, l_done);
    cg.buf.bind_label(l_esc);
    try cg.buf.mov_ri64(alloc, dst_reg, 14_u64);
    try cg.buf.jmp_label(alloc, l_done);
    cg.buf.bind_label(l_ex);
    try cg.buf.mov_ri64(alloc, dst_reg, 15_u64);
    try cg.buf.jmp_label(alloc, l_done);
    cg.buf.bind_label(l_inv);
    try cg.buf.mov_ri64(alloc, dst_reg, 16_u64);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_fs_read_file(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    confined: bool,
    dst: eir.EirValue,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
) -> !OutOfMemory {
    if args.len < 3_usize { return; }
    let doff = cg_val_stack_off(cg, dst);
    let ok_ty = env.get(ret_ty).primary;
    let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
    let tmp = cg.frame.temp_copy_off;
    let l_inval = try cg.buf.new_label(alloc);
    let l_open_err = try cg.buf.new_label(alloc);
    let l_oom_close = try cg.buf.new_label(alloc);
    let l_oom_free = try cg.buf.new_label(alloc);
    let l_read_err = try cg.buf.new_label(alloc);
    let l_read_lp = try cg.buf.new_label(alloc);
    let l_have_room = try cg.buf.new_label(alloc);
    let l_read_pos = try cg.buf.new_label(alloc);
    let l_eof = try cg.buf.new_label(alloc);
    let l_done = try cg.buf.new_label(alloc);

    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg.buf.load_mem(alloc, .Rdi, .R8, 0_i32, 8_usize, false);
    try cg_emit_open_str(alloc, cg, interner, confined, .Rdi, args[2_usize], 0x80000_u64, 0_u64, l_inval);
    try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
    try cg.buf.jcc_label(alloc, .L, l_open_err);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 16_i32, .Rax, 8_usize);

    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 24_i32, .Rdi, 8_usize);
    try cg.buf.mov_ri64(alloc, .Rsi, 4096_u64);
    try cg.buf.mov_ri64(alloc, .Rdx, 16_u64);
    try cg_call_alloc_raw(alloc, cg, interner);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_oom_close);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 32_i32, .Rax, 8_usize);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 40_i32, .Rax, 8_usize);
    try cg.buf.mov_ri64(alloc, .Rax, 4096_u64);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 48_i32, .Rax, 8_usize);

    cg.buf.bind_label(l_read_lp);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp +% 40_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .R8, .Rbp, tmp +% 48_i32, 8_usize, false);
    try cg.buf.cmp_rr(alloc, .Rcx, .R8);
    try cg.buf.jcc_label(alloc, .B, l_have_room);
    try cg.buf.shl_imm(alloc, .R8, 1_u8);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 56_i32, .R8, 8_usize);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 24_i32, 8_usize, false);
    try cg.buf.mov_rr(alloc, .Rsi, .R8);
    try cg.buf.mov_ri64(alloc, .Rdx, 16_u64);
    try cg_call_alloc_raw(alloc, cg, interner);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_oom_free);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 64_i32, .Rax, 8_usize);
    try cg.buf.mov_rr(alloc, .Rdi, .Rax);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp +% 40_i32, 8_usize, false);
    try cg.buf.rep_movsb(alloc);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 24_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp +% 48_i32, 8_usize, false);
    try cg_call_free_raw(alloc, cg, interner);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 64_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .R8, .Rbp, tmp +% 56_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 32_i32, .Rax, 8_usize);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 48_i32, .R8, 8_usize);

    cg.buf.bind_label(l_have_room);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 40_i32, 8_usize, false);
    try cg.buf.add_rr(alloc, .Rsi, .Rax);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp +% 48_i32, 8_usize, false);
    try cg.buf.sub_rr(alloc, .Rdx, .Rax);
    try cg_helper_call(alloc, cg, interner, "eon_rt_read_fd");
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_eof);
    try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
    try cg.buf.jcc_label(alloc, .G, l_read_pos);
    try cg.buf.cmp_ri32(alloc, .Rax, -4_i32);
    try cg.buf.jcc_label(alloc, .E, l_read_lp);
    try cg.buf.jmp_label(alloc, l_read_err);

    cg.buf.bind_label(l_read_pos);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp +% 40_i32, 8_usize, false);
    try cg.buf.add_rr(alloc, .Rcx, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 40_i32, .Rcx, 8_usize);
    try cg.buf.jmp_label(alloc, l_read_lp);

    cg.buf.bind_label(l_eof);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg_helper_call(alloc, cg, interner, "eon_rt_close_fd");
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 40_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 8_i32, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 48_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, doff +% ok_off +% 16_i32, .Rax, 8_usize);
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_read_err);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 56_i32, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 24_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp +% 48_i32, 8_usize, false);
    try cg_call_free_raw(alloc, cg, interner);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg_helper_call(alloc, cg, interner, "eon_rt_close_fd");
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 56_i32, 8_usize, false);
    try cg.buf.jmp_label(alloc, l_open_err);

    cg.buf.bind_label(l_oom_free);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 24_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp +% 48_i32, 8_usize, false);
    try cg_call_free_raw(alloc, cg, interner);
    cg.buf.bind_label(l_oom_close);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg_helper_call(alloc, cg, interner, "eon_rt_close_fd");
    try cg.buf.mov_ri64(alloc, .Rax, 7_u64);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg_emit_memzero(alloc, cg, .Rbp, doff +% ok_off, 24_usize);
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_inval);
    try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFFFFFFFFEA_u64);
    cg.buf.bind_label(l_open_err);
    try cg.buf.mov_rr(alloc, .Rdi, .Rax);
    try cg_emit_map_errno(alloc, cg, .Rdi, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg_emit_memzero(alloc, cg, .Rbp, doff +% ok_off, 24_usize);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_fs_write_file(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    confined: bool,
    executable: bool,
    dst: eir.EirValue,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
) -> !OutOfMemory {
    if args.len < 3_usize { return; }
    let doff = cg_val_stack_off(cg, dst);
    let tmp = cg.frame.temp_copy_off;
    let mode: u64 = if executable { 493_u64 } else { 420_u64 }; // 0o755 or 0o644
    let l_inval = try cg.buf.new_label(alloc);
    let l_open_err = try cg.buf.new_label(alloc);
    let l_wr_lp = try cg.buf.new_label(alloc);
    let l_wr_pos = try cg.buf.new_label(alloc);
    let l_wr_ok = try cg.buf.new_label(alloc);
    let l_wr_err = try cg.buf.new_label(alloc);
    let l_done = try cg.buf.new_label(alloc);

    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg.buf.load_mem(alloc, .Rdi, .R8, 0_i32, 8_usize, false);
    // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC = 0x80241
    try cg_emit_open_str(alloc, cg, interner, confined, .Rdi, args[1_usize], 0x80241_u64, mode, l_inval);
    try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
    try cg.buf.jcc_label(alloc, .L, l_open_err);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 16_i32, .Rax, 8_usize);

    let data_off = cg_val_stack_off(cg, args[2_usize]);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, data_off, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 24_i32, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, data_off +% 8_i32, 8_usize, false);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 32_i32, .Rax, 8_usize);

    cg.buf.bind_label(l_wr_lp);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.test_rr(alloc, .Rdx, .Rdx);
    try cg.buf.jcc_label(alloc, .E, l_wr_ok);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rsi, .Rbp, tmp +% 24_i32, 8_usize, false);
    try cg_helper_call(alloc, cg, interner, "eon_rt_write_fd");
    try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
    try cg.buf.jcc_label(alloc, .G, l_wr_pos);
    try cg.buf.cmp_ri32(alloc, .Rax, -4_i32);
    try cg.buf.jcc_label(alloc, .E, l_wr_lp);
    try cg.buf.jmp_label(alloc, l_wr_err);

    cg.buf.bind_label(l_wr_pos);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp +% 24_i32, 8_usize, false);
    try cg.buf.add_rr(alloc, .Rcx, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 24_i32, .Rcx, 8_usize);
    try cg.buf.load_mem(alloc, .Rcx, .Rbp, tmp +% 32_i32, 8_usize, false);
    try cg.buf.sub_rr(alloc, .Rcx, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 32_i32, .Rcx, 8_usize);
    try cg.buf.jmp_label(alloc, l_wr_lp);

    cg.buf.bind_label(l_wr_ok);
    if executable {
        try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
        try cg.buf.mov_ri64(alloc, .Rsi, 493_u64);
        try cg.buf.mov_ri64(alloc, .Rax, 91_u64);
        try cg.buf.syscall(alloc);
        try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
        try cg.buf.jcc_label(alloc, .L, l_wr_err);
    }
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg_helper_call(alloc, cg, interner, "eon_rt_close_fd");
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    try cg.buf.jmp_label(alloc, l_done);

    cg.buf.bind_label(l_wr_err);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 40_i32, .Rax, 8_usize);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg_helper_call(alloc, cg, interner, "eon_rt_close_fd");
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 40_i32, 8_usize, false);
    try cg.buf.jmp_label(alloc, l_open_err);

    cg.buf.bind_label(l_inval);
    try cg.buf.mov_ri64(alloc, .Rax, 0xFFFFFFFFFFFFFFEA_u64);
    cg.buf.bind_label(l_open_err);
    try cg.buf.mov_rr(alloc, .Rdi, .Rax);
    try cg_emit_map_errno(alloc, cg, .Rdi, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, doff, .Rax, 4_usize);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_fs_list_dir(
    alloc: *mut AllocCap,
    cg: *mut FnCodegen,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    dst: eir.EirValue,
    args: *[eir.EirValue],
    arg_slots: *[eir.EirSlot],
    ret_ty: types.TyId,
) -> !OutOfMemory {
    if args.len < 3_usize { return; }
    let doff = cg_val_stack_off(cg, dst);
    let ok_ty = env.get(ret_ty).primary;
    let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
    let tmp = cg.frame.temp_copy_off;
    let l_inval = try cg.buf.new_label(alloc);
    let l_open_err = try cg.buf.new_label(alloc);
    let l_oom_close = try cg.buf.new_label(alloc);
    let l_oom_free = try cg.buf.new_label(alloc);
    let l_read_err = try cg.buf.new_label(alloc);
    let l_getdents_lp = try cg.buf.new_label(alloc);
    let l_have_ents = try cg.buf.new_label(alloc);
    let l_ent_lp = try cg.buf.new_label(alloc);
    let l_strlen_lp = try cg.buf.new_label(alloc);
    let l_strlen_done = try cg.buf.new_label(alloc);
    let l_chk_dotdot = try cg.buf.new_label(alloc);
    let l_append = try cg.buf.new_label(alloc);
    let l_cap_chk = try cg.buf.new_label(alloc);
    let l_cap_ok = try cg.buf.new_label(alloc);
    let l_ent_next = try cg.buf.new_label(alloc);
    let l_eof = try cg.buf.new_label(alloc);
    let l_done = try cg.buf.new_label(alloc);

    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, .R8);
    try cg.buf.load_mem(alloc, .Rdi, .R8, 0_i32, 8_usize, false);
    try cg_emit_open_str(alloc, cg, interner, false, .Rdi, args[2_usize], 0x90000_u64, 0_u64, l_inval);
    try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
    try cg.buf.jcc_label(alloc, .L, l_open_err);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 16_i32, .Rax, 8_usize);

    try cg_builtin_ptr_arg(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, .Rdi);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 24_i32, .Rdi, 8_usize);
    try cg.buf.mov_ri64(alloc, .Rsi, 4096_u64);
    try cg.buf.mov_ri64(alloc, .Rdx, 16_u64);
    try cg_call_alloc_raw(alloc, cg, interner);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_oom_close);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 32_i32, .Rax, 8_usize);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 40_i32, .Rax, 8_usize);
    try cg.buf.mov_ri64(alloc, .Rax, 4096_u64);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 48_i32, .Rax, 8_usize);
    try cg.buf.sub_ri32(alloc, .Rsp, 4096_i32);

    cg.buf.bind_label(l_getdents_lp);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 16_i32, 8_usize, false);
    try cg.buf.mov_rr(alloc, .Rsi, .Rsp);
    try cg.buf.mov_ri64(alloc, .Rdx, 4096_u64);
    try cg.buf.mov_ri64(alloc, .Rax, 217_u64);
    try cg.buf.syscall(alloc);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_eof);
    try cg.buf.cmp_ri32(alloc, .Rax, 0_i32);
    try cg.buf.jcc_label(alloc, .G, l_have_ents);
    try cg.buf.cmp_ri32(alloc, .Rax, -4_i32);
    try cg.buf.jcc_label(alloc, .E, l_getdents_lp);
    try cg.buf.jmp_label(alloc, l_read_err);

    cg.buf.bind_label(l_have_ents);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 56_i32, .Rax, 8_usize);
    try cg.buf.xor_rr32(alloc, .Rax, .Rax);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 64_i32, .Rax, 8_usize);

    cg.buf.bind_label(l_ent_lp);
    try cg.buf.load_mem(alloc, .R8, .Rbp, tmp +% 64_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .R9, .Rbp, tmp +% 56_i32, 8_usize, false);
    try cg.buf.cmp_rr(alloc, .R8, .R9);
    try cg.buf.jcc_label(alloc, .Ae, l_getdents_lp);
    try cg.buf.mov_rr(alloc, .R10, .Rsp);
    try cg.buf.add_rr(alloc, .R10, .R8);
    try cg.buf.load_mem(alloc, .Rax, .R10, 16_i32, 2_usize, false);
    try cg.buf.test_rr(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_getdents_lp);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 88_i32, .Rax, 8_usize);
    try cg.buf.lea_mem(alloc, .R11, .R10, 19_i32);
    try cg.buf.xor_rr32(alloc, .Rcx, .Rcx);
    cg.buf.bind_label(l_strlen_lp);
    try cg.buf.mov_rr(alloc, .Rdi, .R11);
    try cg.buf.add_rr(alloc, .Rdi, .Rcx);
    try cg.buf.load_mem(alloc, .Rax, .Rdi, 0_i32, 1_usize, false);
    try cg.buf.test_rr32(alloc, .Rax, .Rax);
    try cg.buf.jcc_label(alloc, .E, l_strlen_done);
    try cg.buf.add_ri32(alloc, .Rcx, 1_i32);
    try cg.buf.jmp_label(alloc, l_strlen_lp);

    cg.buf.bind_label(l_strlen_done);
    try cg.buf.test_rr(alloc, .Rcx, .Rcx);
    try cg.buf.jcc_label(alloc, .E, l_ent_next);
    try cg.buf.cmp_ri32(alloc, .Rcx, 1_i32);
    try cg.buf.jcc_label(alloc, .Ne, l_chk_dotdot);
    try cg.buf.load_mem(alloc, .Rax, .R11, 0_i32, 1_usize, false);
    try cg.buf.cmp_ri32(alloc, .Rax, 46_i32);
    try cg.buf.jcc_label(alloc, .E, l_ent_next);
    try cg.buf.jmp_label(alloc, l_append);

    cg.buf.bind_label(l_chk_dotdot);
    try cg.buf.cmp_ri32(alloc, .Rcx, 2_i32);
    try cg.buf.jcc_label(alloc, .Ne, l_append);
    try cg.buf.load_mem(alloc, .Rax, .R11, 0_i32, 1_usize, false);
    try cg.buf.cmp_ri32(alloc, .Rax, 46_i32);
    try cg.buf.jcc_label(alloc, .Ne, l_append);
    try cg.buf.load_mem(alloc, .Rax, .R11, 1_i32, 1_usize, false);
    try cg.buf.cmp_ri32(alloc, .Rax, 46_i32);
    try cg.buf.jcc_label(alloc, .E, l_ent_next);

    cg.buf.bind_label(l_append);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 72_i32, .R11, 8_usize);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 80_i32, .Rcx, 8_usize);
    cg.buf.bind_label(l_cap_chk);
    try cg.buf.load_mem(alloc, .Rax, .Rbp, tmp +% 40_i32, 8_usize, false);
    try cg.buf.load_mem(alloc, .Rdx, .Rbp, tmp +% 80_i32, 8_usize, false);
    try cg.buf.add_rr(alloc, .Rax, .Rdx);
    try cg.buf.add_ri32(alloc, .Rax, 1_i32);
    try cg.buf.load_mem(alloc, .R8, .Rbp, tmp +% 48_i32, 8_usize, false);
    try cg.buf.cmp_rr(alloc, .Rax, .R8);
    try cg.buf.jcc_label(alloc, .Be, l_cap_ok);
    try cg.buf.shl_imm(alloc, .R8, 1_u8);
    try cg.buf.store_mem(alloc, .Rbp, tmp +% 96_i32, .R8, 8_usize);
    try cg.buf.load_mem(alloc, .Rdi, .Rbp, tmp +% 24_i32, 8_usize, false);
    try cg.buf.mov_rr(alloc, .Rsi, .R8);
    try cg.buf.mov_ri64(alloc, .Rdx, 16_u64);
    try cg_call_alloc_raw(alloc, cg, interner);
