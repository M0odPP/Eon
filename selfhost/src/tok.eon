        .Shl => { try out.push_str_grow(alloc, "Shl"); return true; }
        .Shr => { try out.push_str_grow(alloc, "Shr"); return true; }
        .ShlWrap => { try out.push_str_grow(alloc, "ShlWrap"); return true; }
        _ => { return false; }
    }
}

fn write_kind_name_part4(alloc: *mut AllocCap, kind: TokenKind, out: *mut str.StrBuf) -> bool ! OutOfMemory {
    match kind {
        .Amp => { try out.push_str_grow(alloc, "Amp"); return true; }
        .Pipe => { try out.push_str_grow(alloc, "Pipe"); return true; }
        .Caret => { try out.push_str_grow(alloc, "Caret"); return true; }
        .Tilde => { try out.push_str_grow(alloc, "Tilde"); return true; }
        .Bang => { try out.push_str_grow(alloc, "Bang"); return true; }
        .AndAnd => { try out.push_str_grow(alloc, "AndAnd"); return true; }
        .OrOr => { try out.push_str_grow(alloc, "OrOr"); return true; }
        .Eq => { try out.push_str_grow(alloc, "Eq"); return true; }
        .EqEq => { try out.push_str_grow(alloc, "EqEq"); return true; }
        .NotEq => { try out.push_str_grow(alloc, "NotEq"); return true; }
        .Lt => { try out.push_str_grow(alloc, "Lt"); return true; }
        .LtEq => { try out.push_str_grow(alloc, "LtEq"); return true; }
        .Gt => { try out.push_str_grow(alloc, "Gt"); return true; }
        .GtEq => { try out.push_str_grow(alloc, "GtEq"); return true; }
        .PlusEq => { try out.push_str_grow(alloc, "PlusEq"); return true; }
        .MinusEq => { try out.push_str_grow(alloc, "MinusEq"); return true; }
        .StarEq => { try out.push_str_grow(alloc, "StarEq"); return true; }
        .PlusWrapEq => { try out.push_str_grow(alloc, "PlusWrapEq"); return true; }
        .MinusWrapEq => { try out.push_str_grow(alloc, "MinusWrapEq"); return true; }
        .StarWrapEq => { try out.push_str_grow(alloc, "StarWrapEq"); return true; }
        .PlusSatEq => { try out.push_str_grow(alloc, "PlusSatEq"); return true; }
        .MinusSatEq => { try out.push_str_grow(alloc, "MinusSatEq"); return true; }
        .StarSatEq => { try out.push_str_grow(alloc, "StarSatEq"); return true; }
        .AmpEq => { try out.push_str_grow(alloc, "AmpEq"); return true; }
        .PipeEq => { try out.push_str_grow(alloc, "PipeEq"); return true; }
        .CaretEq => { try out.push_str_grow(alloc, "CaretEq"); return true; }
        .ShlEq => { try out.push_str_grow(alloc, "ShlEq"); return true; }
        .ShrEq => { try out.push_str_grow(alloc, "ShrEq"); return true; }
        .Error => { try out.push_str_grow(alloc, "Error"); return true; }
        .Eof => { try out.push_str_grow(alloc, "Eof"); return true; }
        _ => { return false; }
    }
}

/// Formats `tok.kind` (plus its payload) identically to Rust `format!("{:?}", tok.kind)`.
pub fn write_token_kind_debug(alloc: *mut AllocCap, tok: *Token, out: *mut str.StrBuf) -> !OutOfMemory {
    match tok.kind {
        .IntLit => {
            try out.push_str_grow(alloc, "IntLit(NumLitId(");
            try out.push_u64_grow(alloc, tok.payload.widen.[u64]());
            try out.push_str_grow(alloc, "))");
            return;
        }
        .FloatLit => {
            try out.push_str_grow(alloc, "FloatLit(NumLitId(");
            try out.push_u64_grow(alloc, tok.payload.widen.[u64]());
            try out.push_str_grow(alloc, "))");
            return;
        }
        .StringLit => {
            try out.push_str_grow(alloc, "StringLit(StrLitId(");
            try out.push_u64_grow(alloc, tok.payload.widen.[u64]());
            try out.push_str_grow(alloc, "))");
            return;
        }
        .RawStringLit => {
            try out.push_str_grow(alloc, "RawStringLit(StrLitId(");
            try out.push_u64_grow(alloc, tok.payload.widen.[u64]());
            try out.push_str_grow(alloc, "))");
            return;
        }
        .ByteStringLit => {
            try out.push_str_grow(alloc, "ByteStringLit(ByteStrLitId(");
            try out.push_u64_grow(alloc, tok.payload.widen.[u64]());
            try out.push_str_grow(alloc, "))");
            return;
        }
        .CharLit => {
            try out.push_str_grow(alloc, "CharLit(");
            try write_rust_char_debug(alloc, tok.payload, out);
            try out.push_byte_grow(alloc, b')');
            return;
        }
        .ByteCharLit => {
            try out.push_str_grow(alloc, "ByteCharLit(");
            try out.push_u64_grow(alloc, (tok.payload & 0xFF_u32).widen.[u64]());
            try out.push_byte_grow(alloc, b')');
            return;
        }
        _ => {}
    }
    if try write_kind_name_part1(alloc, tok.kind, out) { return; }
    if try write_kind_name_part2(alloc, tok.kind, out) { return; }
    if try write_kind_name_part3(alloc, tok.kind, out) { return; }
    if try write_kind_name_part4(alloc, tok.kind, out) { return; }
    return;
}

// ---------------------------------------------------------------------------
// Human-readable descriptions (matching `TokenKind::description`)
// ---------------------------------------------------------------------------

fn write_kind_desc_part1(alloc: *mut AllocCap, kind: TokenKind, out: *mut str.StrBuf) -> bool ! OutOfMemory {
    match kind {
        .Ident => { try out.push_str_grow(alloc, "identifier"); return true; }
        .Underscore => { try out.push_str_grow(alloc, "`_`"); return true; }
        .Label => { try out.push_str_grow(alloc, "loop label"); return true; }
        .IntLit => { try out.push_str_grow(alloc, "integer literal"); return true; }
        .FloatLit => { try out.push_str_grow(alloc, "float literal"); return true; }
        .StringLit => { try out.push_str_grow(alloc, "string literal"); return true; }
        .RawStringLit => { try out.push_str_grow(alloc, "raw string literal"); return true; }
        .ByteStringLit => { try out.push_str_grow(alloc, "byte string literal"); return true; }
        .CharLit => { try out.push_str_grow(alloc, "character literal"); return true; }
        .ByteCharLit => { try out.push_str_grow(alloc, "byte character literal"); return true; }
        .KwModule => { try out.push_str_grow(alloc, "`module`"); return true; }
        .KwImport => { try out.push_str_grow(alloc, "`import`"); return true; }
        .KwPub => { try out.push_str_grow(alloc, "`pub`"); return true; }
        .KwFn => { try out.push_str_grow(alloc, "`fn`"); return true; }
        .KwSys => { try out.push_str_grow(alloc, "`sys`"); return true; }
        .KwLet => { try out.push_str_grow(alloc, "`let`"); return true; }
        .KwVar => { try out.push_str_grow(alloc, "`var`"); return true; }
        .KwConst => { try out.push_str_grow(alloc, "`const`"); return true; }
        .KwType => { try out.push_str_grow(alloc, "`type`"); return true; }
        .KwStruct => { try out.push_str_grow(alloc, "`struct`"); return true; }
        .KwLinear => { try out.push_str_grow(alloc, "`linear`"); return true; }
        .KwPool => { try out.push_str_grow(alloc, "`pool`"); return true; }
        .KwEnum => { try out.push_str_grow(alloc, "`enum`"); return true; }
        .KwUnion => { try out.push_str_grow(alloc, "`union`"); return true; }
        .KwBitfield => { try out.push_str_grow(alloc, "`bitfield`"); return true; }
        .KwIface => { try out.push_str_grow(alloc, "`iface`"); return true; }
        .KwImpl => { try out.push_str_grow(alloc, "`impl`"); return true; }
        .KwError => { try out.push_str_grow(alloc, "`error`"); return true; }
        .KwExtern => { try out.push_str_grow(alloc, "`extern`"); return true; }
        .KwComptime => { try out.push_str_grow(alloc, "`comptime`"); return true; }
        .KwView => { try out.push_str_grow(alloc, "`view`"); return true; }
        .KwIf => { try out.push_str_grow(alloc, "`if`"); return true; }
        .KwElse => { try out.push_str_grow(alloc, "`else`"); return true; }
        .KwMatch => { try out.push_str_grow(alloc, "`match`"); return true; }
        _ => { return false; }
    }
}

