        _ => { return false; }
    }
}

fn write_kind_name_part3(alloc: *mut AllocCap, kind: TokenKind, out: *mut str.StrBuf) -> bool ! OutOfMemory {
    match kind {
        .LBrace => { try out.push_str_grow(alloc, "LBrace"); return true; }
        .RBrace => { try out.push_str_grow(alloc, "RBrace"); return true; }
        .Semi => { try out.push_str_grow(alloc, "Semi"); return true; }
        .Colon => { try out.push_str_grow(alloc, "Colon"); return true; }
        .Comma => { try out.push_str_grow(alloc, "Comma"); return true; }
        .Dot => { try out.push_str_grow(alloc, "Dot"); return true; }
        .DotStar => { try out.push_str_grow(alloc, "DotStar"); return true; }
        .DotDot => { try out.push_str_grow(alloc, "DotDot"); return true; }
        .DotDotEq => { try out.push_str_grow(alloc, "DotDotEq"); return true; }
        .Arrow => { try out.push_str_grow(alloc, "Arrow"); return true; }
        .FatArrow => { try out.push_str_grow(alloc, "FatArrow"); return true; }
