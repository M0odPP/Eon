fn write_kind_desc_part3(alloc: *mut AllocCap, kind: TokenKind, out: *mut str.StrBuf) -> bool ! OutOfMemory {
    match kind {
        .LParen => { try out.push_str_grow(alloc, "`(`"); return true; }
        .RParen => { try out.push_str_grow(alloc, "`)`"); return true; }
        .LBracket => { try out.push_str_grow(alloc, "`[`"); return true; }
        .RBracket => { try out.push_str_grow(alloc, "`]`"); return true; }
        .LBrace => { try out.push_str_grow(alloc, "`{`"); return true; }
        .RBrace => { try out.push_str_grow(alloc, "`}`"); return true; }
        .Semi => { try out.push_str_grow(alloc, "`;`"); return true; }
        .Colon => { try out.push_str_grow(alloc, "`:`"); return true; }
        .Comma => { try out.push_str_grow(alloc, "`,`"); return true; }
        .Dot => { try out.push_str_grow(alloc, "`.`"); return true; }
        .DotStar => { try out.push_str_grow(alloc, "`.*`"); return true; }
        .DotDot => { try out.push_str_grow(alloc, "`..`"); return true; }
        .DotDotEq => { try out.push_str_grow(alloc, "`..=`"); return true; }
        .Arrow => { try out.push_str_grow(alloc, "`->`"); return true; }
        .FatArrow => { try out.push_str_grow(alloc, "`=>`"); return true; }
        .At => { try out.push_str_grow(alloc, "`@`"); return true; }
        .Question => { try out.push_str_grow(alloc, "`?`"); return true; }
        .Plus => { try out.push_str_grow(alloc, "`+`"); return true; }
        .Minus => { try out.push_str_grow(alloc, "`-`"); return true; }
        .Star => { try out.push_str_grow(alloc, "`*`"); return true; }
        .Slash => { try out.push_str_grow(alloc, "`/`"); return true; }
        .Percent => { try out.push_str_grow(alloc, "`%`"); return true; }
        .PlusWrap => { try out.push_str_grow(alloc, "`+%`"); return true; }
        .MinusWrap => { try out.push_str_grow(alloc, "`-%`"); return true; }
        .StarWrap => { try out.push_str_grow(alloc, "`*%`"); return true; }
        .PlusSat => { try out.push_str_grow(alloc, "`+|`"); return true; }
        .MinusSat => { try out.push_str_grow(alloc, "`-|`"); return true; }
        .StarSat => { try out.push_str_grow(alloc, "`*|`"); return true; }
        .PlusCheck => { try out.push_str_grow(alloc, "`+?`"); return true; }
        .MinusCheck => { try out.push_str_grow(alloc, "`-?`"); return true; }
        .StarCheck => { try out.push_str_grow(alloc, "`*?`"); return true; }
        .SlashCheck => { try out.push_str_grow(alloc, "`/?`"); return true; }
        .PercentCheck => { try out.push_str_grow(alloc, "`%?`"); return true; }
        _ => { return false; }
    }
}

fn write_kind_desc_part4(alloc: *mut AllocCap, kind: TokenKind, out: *mut str.StrBuf) -> bool ! OutOfMemory {
    match kind {
        .Shl => { try out.push_str_grow(alloc, "`<<`"); return true; }
        .Shr => { try out.push_str_grow(alloc, "`>>`"); return true; }
        .ShlWrap => { try out.push_str_grow(alloc, "`<<%`"); return true; }
        .Amp => { try out.push_str_grow(alloc, "`&`"); return true; }
        .Pipe => { try out.push_str_grow(alloc, "`|`"); return true; }
        .Caret => { try out.push_str_grow(alloc, "`^`"); return true; }
        .Tilde => { try out.push_str_grow(alloc, "`~`"); return true; }
        .Bang => { try out.push_str_grow(alloc, "`!`"); return true; }
        .AndAnd => { try out.push_str_grow(alloc, "`&&`"); return true; }
        .OrOr => { try out.push_str_grow(alloc, "`||`"); return true; }
        .Eq => { try out.push_str_grow(alloc, "`=`"); return true; }
        .EqEq => { try out.push_str_grow(alloc, "`==`"); return true; }
        .NotEq => { try out.push_str_grow(alloc, "`!=`"); return true; }
        .Lt => { try out.push_str_grow(alloc, "`<`"); return true; }
        .LtEq => { try out.push_str_grow(alloc, "`<=`"); return true; }
        .Gt => { try out.push_str_grow(alloc, "`>`"); return true; }
        .GtEq => { try out.push_str_grow(alloc, "`>=`"); return true; }
        .PlusEq => { try out.push_str_grow(alloc, "`+=`"); return true; }
        .MinusEq => { try out.push_str_grow(alloc, "`-=`"); return true; }
        .StarEq => { try out.push_str_grow(alloc, "`*=`"); return true; }
        .PlusWrapEq => { try out.push_str_grow(alloc, "`+%=`"); return true; }
        .MinusWrapEq => { try out.push_str_grow(alloc, "`-%=`"); return true; }
        .StarWrapEq => { try out.push_str_grow(alloc, "`*%=`"); return true; }
        .PlusSatEq => { try out.push_str_grow(alloc, "`+|=`"); return true; }
        .MinusSatEq => { try out.push_str_grow(alloc, "`-|=`"); return true; }
        .StarSatEq => { try out.push_str_grow(alloc, "`*|=`"); return true; }
        .AmpEq => { try out.push_str_grow(alloc, "`&=`"); return true; }
        .PipeEq => { try out.push_str_grow(alloc, "`|=`"); return true; }
        .CaretEq => { try out.push_str_grow(alloc, "`^=`"); return true; }
        .ShlEq => { try out.push_str_grow(alloc, "`<<=`"); return true; }
        .ShrEq => { try out.push_str_grow(alloc, "`>>=`"); return true; }
        .Error => { try out.push_str_grow(alloc, "invalid token"); return true; }
        .Eof => { try out.push_str_grow(alloc, "end of file"); return true; }
        _ => { return false; }
    }
}

/// Writes the diagnostic display string matching `compiler/src/lexer.rs::TokenKind::description`.
pub fn write_token_kind_description(alloc: *mut AllocCap, kind: TokenKind, out: *mut str.StrBuf) -> !OutOfMemory {
    if try write_kind_desc_part1(alloc, kind, out) { return; }
    if try write_kind_desc_part2(alloc, kind, out) { return; }
    if try write_kind_desc_part3(alloc, kind, out) { return; }
    if try write_kind_desc_part4(alloc, kind, out) { return; }
    return;
}
