        .PlusWrap => { try out.push_str_grow(alloc, "PlusWrap"); return true; }
        .MinusWrap => { try out.push_str_grow(alloc, "MinusWrap"); return true; }
        .StarWrap => { try out.push_str_grow(alloc, "StarWrap"); return true; }
        .PlusSat => { try out.push_str_grow(alloc, "PlusSat"); return true; }
        .MinusSat => { try out.push_str_grow(alloc, "MinusSat"); return true; }
        .StarSat => { try out.push_str_grow(alloc, "StarSat"); return true; }
        .PlusCheck => { try out.push_str_grow(alloc, "PlusCheck"); return true; }
        .MinusCheck => { try out.push_str_grow(alloc, "MinusCheck"); return true; }
        .StarCheck => { try out.push_str_grow(alloc, "StarCheck"); return true; }
