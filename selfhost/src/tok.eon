module eonc.tok;

import core.str;

/// Exact 1:1 mirror of `compiler/src/lexer.rs::TokenKind` (133 variants).
///
/// Payload-bearing Rust variants store their `u32` payload in `Token.payload`:
/// - `IntLit`, `FloatLit`: `NumLitId` index
/// - `StringLit`, `RawStringLit`: `StrLitId` index
/// - `ByteStringLit`: `ByteStrLitId` index
/// - `CharLit`: Unicode scalar value (`u32`)
/// - `ByteCharLit`: byte value (`0..=255`)
pub enum TokenKind : u16 {
    // Identifiers & special token `_` (3)
    Ident = 0,
    Underscore = 1,
    Label = 2,

    // Literals (7)
    IntLit = 3,
    FloatLit = 4,
    StringLit = 5,
    RawStringLit = 6,
    ByteStringLit = 7,
    CharLit = 8,
    ByteCharLit = 9,

    // Keywords: Declarations (21)
    KwModule = 10,
    KwImport = 11,
    KwPub = 12,
    KwFn = 13,
    KwSys = 14,
    KwLet = 15,
    KwVar = 16,
    KwConst = 17,
    KwType = 18,
    KwStruct = 19,
    KwLinear = 20,
    KwPool = 21,
    KwEnum = 22,
    KwUnion = 23,
    KwBitfield = 24,
    KwIface = 25,
    KwImpl = 26,
    KwError = 27,
    KwExtern = 28,
    KwComptime = 29,
    KwView = 30,

    // Keywords: Control flow (16)
    KwIf = 31,
    KwElse = 32,
    KwMatch = 33,
    KwWhile = 34,
    KwFor = 35,
    KwPar = 36,
    KwLoop = 37,
    KwBreak = 38,
    KwContinue = 39,
    KwReturn = 40,
    KwDefer = 41,
    KwErrdefer = 42,
    KwTry = 43,
    KwCatch = 44,
    KwOrelse = 45,
    KwUnreachable = 46,

    // Keywords: Modifiers & contracts (9)
    KwMut = 47,
    KwMove = 48,
    KwCopy = 49,
    KwWhere = 50,
    KwEnsures = 51,
    KwIn = 52,
    KwAs = 53,
    KwIs = 54,
    KwFrom = 55,

    // Keywords: Literals & special names (8)
    KwTrue = 56,
    KwFalse = 57,
    KwNull = 58,
    KwVoid = 59,
    KwNever = 60,
    KwSelf = 61,
    KwSelfType = 62,
    KwDyn = 63,

    // Keywords: HAL-only (3)
    KwRaw = 64,
    KwAsm = 65,
    KwVolatile = 66,

    // Delimiters & punctuation (17)
    LParen = 67,
    RParen = 68,
    LBracket = 69,
    RBracket = 70,
    LBrace = 71,
    RBrace = 72,
    Semi = 73,
    Colon = 74,
    Comma = 75,
    Dot = 76,
    DotStar = 77,
    DotDot = 78,
    DotDotEq = 79,
    Arrow = 80,
    FatArrow = 81,
    At = 82,
    Question = 83,

    // Operators (33)
    Plus = 84,
    Minus = 85,
    Star = 86,
    Slash = 87,
    Percent = 88,
    PlusWrap = 89,
    MinusWrap = 90,
    StarWrap = 91,
    PlusSat = 92,
    MinusSat = 93,
    StarSat = 94,
    PlusCheck = 95,
    MinusCheck = 96,
    StarCheck = 97,
    SlashCheck = 98,
    PercentCheck = 99,
    Shl = 100,
    Shr = 101,
    ShlWrap = 102,
    Amp = 103,
    Pipe = 104,
    Caret = 105,
    Tilde = 106,
    Bang = 107,
    AndAnd = 108,
    OrOr = 109,
    Eq = 110,
    EqEq = 111,
    NotEq = 112,
    Lt = 113,
    LtEq = 114,
    Gt = 115,
    GtEq = 116,

    // Compound assignments (14)
    PlusEq = 117,
    MinusEq = 118,
    StarEq = 119,
    PlusWrapEq = 120,
    MinusWrapEq = 121,
    StarWrapEq = 122,
    PlusSatEq = 123,
    MinusSatEq = 124,
    StarSatEq = 125,
    AmpEq = 126,
    PipeEq = 127,
    CaretEq = 128,
    ShlEq = 129,
    ShrEq = 130,

    // Special (2)
    Error = 131,
    Eof = 132,
}

/// Numeric literal slice metadata matching `compiler/src/lexer.rs::NumLitData`.
pub struct NumLitData {
    pub raw_start: u32;
    pub raw_end: u32;
    pub suffix_start: u32;
    pub suffix_end: u32;
    pub has_suffix: bool;
}

/// Documentation comment span metadata matching `compiler/src/lexer.rs::DocComment`.
pub struct DocComment {
    pub is_module_doc: bool;
    pub start: u32;
    pub end: u32;
}

/// Compact 16-byte token carrying kind, byte span `[start, end)`, and optional payload.
pub struct Token {
    pub kind: TokenKind;
    pub start: u32;
    pub end: u32;
    pub payload: u32;
}

impl Token {
    pub fn simple(kind: TokenKind, start: u32, end: u32) -> Token {
        return Token.{ kind: kind, start: start, end: end, payload: 0_u32 };
    }

    pub fn with_payload(kind: TokenKind, payload: u32, start: u32, end: u32) -> Token {
        return Token.{ kind: kind, start: start, end: end, payload: payload };
    }
}

// ---------------------------------------------------------------------------
// Keyword lookup (57 keywords, matching `TokenKind::from_keyword`)
// ---------------------------------------------------------------------------

fn kw_len2(bytes: *[u8]) -> ?TokenKind {
    if str.bytes_eq(bytes, "fn".as_bytes()) { return .KwFn; }
    if str.bytes_eq(bytes, "if".as_bytes()) { return .KwIf; }
    if str.bytes_eq(bytes, "in".as_bytes()) { return .KwIn; }
    if str.bytes_eq(bytes, "as".as_bytes()) { return .KwAs; }
    if str.bytes_eq(bytes, "is".as_bytes()) { return .KwIs; }
    return null;
}

fn kw_len3(bytes: *[u8]) -> ?TokenKind {
    if str.bytes_eq(bytes, "pub".as_bytes()) { return .KwPub; }
    if str.bytes_eq(bytes, "sys".as_bytes()) { return .KwSys; }
    if str.bytes_eq(bytes, "let".as_bytes()) { return .KwLet; }
    if str.bytes_eq(bytes, "var".as_bytes()) { return .KwVar; }
    if str.bytes_eq(bytes, "for".as_bytes()) { return .KwFor; }
    if str.bytes_eq(bytes, "par".as_bytes()) { return .KwPar; }
    if str.bytes_eq(bytes, "try".as_bytes()) { return .KwTry; }
    if str.bytes_eq(bytes, "mut".as_bytes()) { return .KwMut; }
    if str.bytes_eq(bytes, "dyn".as_bytes()) { return .KwDyn; }
    if str.bytes_eq(bytes, "raw".as_bytes()) { return .KwRaw; }
    if str.bytes_eq(bytes, "asm".as_bytes()) { return .KwAsm; }
    return null;
}

fn kw_len4(bytes: *[u8]) -> ?TokenKind {
    if str.bytes_eq(bytes, "type".as_bytes()) { return .KwType; }
    if str.bytes_eq(bytes, "pool".as_bytes()) { return .KwPool; }
    if str.bytes_eq(bytes, "enum".as_bytes()) { return .KwEnum; }
    if str.bytes_eq(bytes, "impl".as_bytes()) { return .KwImpl; }
    if str.bytes_eq(bytes, "view".as_bytes()) { return .KwView; }
    if str.bytes_eq(bytes, "else".as_bytes()) { return .KwElse; }
    if str.bytes_eq(bytes, "loop".as_bytes()) { return .KwLoop; }
    if str.bytes_eq(bytes, "move".as_bytes()) { return .KwMove; }
    if str.bytes_eq(bytes, "copy".as_bytes()) { return .KwCopy; }
    if str.bytes_eq(bytes, "from".as_bytes()) { return .KwFrom; }
    if str.bytes_eq(bytes, "true".as_bytes()) { return .KwTrue; }
    if str.bytes_eq(bytes, "null".as_bytes()) { return .KwNull; }
    if str.bytes_eq(bytes, "void".as_bytes()) { return .KwVoid; }
    if str.bytes_eq(bytes, "self".as_bytes()) { return .KwSelf; }
    if str.bytes_eq(bytes, "Self".as_bytes()) { return .KwSelfType; }
    return null;
}

fn kw_len5(bytes: *[u8]) -> ?TokenKind {
    if str.bytes_eq(bytes, "const".as_bytes()) { return .KwConst; }
    if str.bytes_eq(bytes, "union".as_bytes()) { return .KwUnion; }
    if str.bytes_eq(bytes, "iface".as_bytes()) { return .KwIface; }
    if str.bytes_eq(bytes, "error".as_bytes()) { return .KwError; }
    if str.bytes_eq(bytes, "match".as_bytes()) { return .KwMatch; }
    if str.bytes_eq(bytes, "while".as_bytes()) { return .KwWhile; }
    if str.bytes_eq(bytes, "break".as_bytes()) { return .KwBreak; }
    if str.bytes_eq(bytes, "defer".as_bytes()) { return .KwDefer; }
    if str.bytes_eq(bytes, "catch".as_bytes()) { return .KwCatch; }
    if str.bytes_eq(bytes, "where".as_bytes()) { return .KwWhere; }
    if str.bytes_eq(bytes, "false".as_bytes()) { return .KwFalse; }
    if str.bytes_eq(bytes, "never".as_bytes()) { return .KwNever; }
    return null;
}

fn kw_len6(bytes: *[u8]) -> ?TokenKind {
    if str.bytes_eq(bytes, "module".as_bytes()) { return .KwModule; }
    if str.bytes_eq(bytes, "import".as_bytes()) { return .KwImport; }
    if str.bytes_eq(bytes, "struct".as_bytes()) { return .KwStruct; }
    if str.bytes_eq(bytes, "linear".as_bytes()) { return .KwLinear; }
    if str.bytes_eq(bytes, "extern".as_bytes()) { return .KwExtern; }
    if str.bytes_eq(bytes, "return".as_bytes()) { return .KwReturn; }
    if str.bytes_eq(bytes, "orelse".as_bytes()) { return .KwOrelse; }
    return null;
}

fn kw_len7_plus(bytes: *[u8]) -> ?TokenKind {
    if bytes.len == 7_usize {
        if str.bytes_eq(bytes, "ensures".as_bytes()) { return .KwEnsures; }
        return null;
    }
    if bytes.len == 8_usize {
        if str.bytes_eq(bytes, "bitfield".as_bytes()) { return .KwBitfield; }
        if str.bytes_eq(bytes, "comptime".as_bytes()) { return .KwComptime; }
        if str.bytes_eq(bytes, "continue".as_bytes()) { return .KwContinue; }
        if str.bytes_eq(bytes, "errdefer".as_bytes()) { return .KwErrdefer; }
        if str.bytes_eq(bytes, "volatile".as_bytes()) { return .KwVolatile; }
        return null;
    }
    if bytes.len == 11_usize {
        if str.bytes_eq(bytes, "unreachable".as_bytes()) { return .KwUnreachable; }
        return null;
    }
    return null;
}

/// Maps an identifier byte slice to its `TokenKind` keyword variant, or `null`.
pub fn keyword_kind(bytes: *[u8]) -> ?TokenKind {
    if bytes.len == 2_usize { return kw_len2(bytes); }
    if bytes.len == 3_usize { return kw_len3(bytes); }
    if bytes.len == 4_usize { return kw_len4(bytes); }
    if bytes.len == 5_usize { return kw_len5(bytes); }
    if bytes.len == 6_usize { return kw_len6(bytes); }
    if bytes.len >= 7_usize && bytes.len <= 11_usize {
        return kw_len7_plus(bytes);
    }
    return null;
}

// ---------------------------------------------------------------------------
// Rust `{char:?}` and `{str:?}` debug escaping
// ---------------------------------------------------------------------------

fn is_rust_debug_printable(cp: u32) -> bool {
    if cp < 0x80_u32 {
        return cp >= 0x20_u32 && cp <= 0x7E_u32;
    }
    if cp <= 0x00A0_u32 || cp == 0x00AD_u32 {
        return false;
    }
    if cp >= 0x0300_u32 && cp <= 0x036F_u32 {
        return false;
    }
    if cp == 0x034F_u32 || cp == 0x061C_u32 || cp == 0x1680_u32 || cp == 0x180E_u32 {
        return false;
    }
    if (cp >= 0x2000_u32 && cp <= 0x200F_u32) || (cp >= 0x2028_u32 && cp <= 0x202F_u32) {
        return false;
    }
    if (cp >= 0x205F_u32 && cp <= 0x206F_u32) || cp == 0x3000_u32 {
        return false;
    }
    if cp >= 0xD800_u32 && cp <= 0xF8FF_u32 {
        return false;
    }
    if cp == 0xFEFF_u32 || (cp >= 0xFFF9_u32 && cp <= 0xFFFB_u32) {
        return false;
    }
    if cp == 0xFFFE_u32 || cp == 0xFFFF_u32 || cp >= 0xE0000_u32 {
        return false;
    }
    return true;
}

fn write_utf8_scalar(alloc: *mut AllocCap, cp: u32, out: *mut str.StrBuf) -> !OutOfMemory {
    if cp < 0x80_u32 {
        try out.push_byte_grow(alloc, cp.trunc.[u8]());
        return;
    }
    if cp < 0x800_u32 {
        let b0 = 0xC0_u8 | (cp >> 6_u32).trunc.[u8]();
        let b1 = 0x80_u8 | (cp & 0x3F_u32).trunc.[u8]();
        try out.push_byte_grow(alloc, b0);
        try out.push_byte_grow(alloc, b1);
        return;
    }
    if cp < 0x10000_u32 {
        let b0 = 0xE0_u8 | (cp >> 12_u32).trunc.[u8]();
        let b1 = 0x80_u8 | ((cp >> 6_u32) & 0x3F_u32).trunc.[u8]();
        let b2 = 0x80_u8 | (cp & 0x3F_u32).trunc.[u8]();
        try out.push_byte_grow(alloc, b0);
        try out.push_byte_grow(alloc, b1);
        try out.push_byte_grow(alloc, b2);
        return;
    }
    if cp <= 0x10FFFF_u32 {
        let b0 = 0xF0_u8 | (cp >> 18_u32).trunc.[u8]();
        let b1 = 0x80_u8 | ((cp >> 12_u32) & 0x3F_u32).trunc.[u8]();
        let b2 = 0x80_u8 | ((cp >> 6_u32) & 0x3F_u32).trunc.[u8]();
        let b3 = 0x80_u8 | (cp & 0x3F_u32).trunc.[u8]();
        try out.push_byte_grow(alloc, b0);
        try out.push_byte_grow(alloc, b1);
        try out.push_byte_grow(alloc, b2);
        try out.push_byte_grow(alloc, b3);
        return;
    }
    try out.push_str_grow(alloc, "\\u{");
    try out.push_hex_u64_grow(alloc, cp.widen.[u64]());
    try out.push_byte_grow(alloc, b'}');
    return;
}

fn write_escaped_scalar(
    alloc: *mut AllocCap,
    cp: u32,
    escape_single: bool,
    escape_double: bool,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    if cp == 0x00_u32 {
        try out.push_str_grow(alloc, "\\0");
        return;
    }
    if cp == 0x09_u32 {
        try out.push_str_grow(alloc, "\\t");
        return;
    }
    if cp == 0x0A_u32 {
        try out.push_str_grow(alloc, "\\n");
        return;
    }
    if cp == 0x0D_u32 {
        try out.push_str_grow(alloc, "\\r");
        return;
    }
    if cp == 0x5C_u32 {
        try out.push_str_grow(alloc, "\\\\");
        return;
    }
    if cp == 0x27_u32 {
        if escape_single {
            try out.push_str_grow(alloc, "\\'");
        } else {
            try out.push_byte_grow(alloc, b'\'');
        }
        return;
    }
    if cp == 0x22_u32 {
        if escape_double {
            try out.push_str_grow(alloc, "\\\"");
        } else {
            try out.push_byte_grow(alloc, b'"');
        }
        return;
    }
    if is_rust_debug_printable(cp) {
        try write_utf8_scalar(alloc, cp, out);
        return;
    }
    try out.push_str_grow(alloc, "\\u{");
    try out.push_hex_u64_grow(alloc, cp.widen.[u64]());
    try out.push_byte_grow(alloc, b'}');
    return;
}

/// Formats a Unicode scalar value identically to Rust `format!("{c:?}")`.
pub fn write_rust_char_debug(alloc: *mut AllocCap, cp: u32, out: *mut str.StrBuf) -> !OutOfMemory {
    try out.push_byte_grow(alloc, b'\'');
    try write_escaped_scalar(alloc, cp, true, false, out);
    try out.push_byte_grow(alloc, b'\'');
    return;
}

/// Formats a UTF-8 byte slice identically to Rust `format!("{text:?}")`.
pub fn write_rust_str_debug(alloc: *mut AllocCap, bytes: *[u8], out: *mut str.StrBuf) -> !OutOfMemory {
    try out.push_byte_grow(alloc, b'"');
    var pos: usize = 0_usize;
    while pos < bytes.len {
        let d = str.decode_utf8_char(bytes, pos);
        if d.len == 0_usize {
            break;
        }
        try write_escaped_scalar(alloc, d.cp, false, true, out);
        pos = pos +% d.len;
    }
    try out.push_byte_grow(alloc, b'"');
    return;
}

// ---------------------------------------------------------------------------
// Exact Rust `{tok.kind:?}` formatting
// ---------------------------------------------------------------------------

fn write_kind_name_part1(alloc: *mut AllocCap, kind: TokenKind, out: *mut str.StrBuf) -> bool ! OutOfMemory {
    match kind {
        .Ident => { try out.push_str_grow(alloc, "Ident"); return true; }
        .Underscore => { try out.push_str_grow(alloc, "Underscore"); return true; }
        .Label => { try out.push_str_grow(alloc, "Label"); return true; }
        .KwModule => { try out.push_str_grow(alloc, "KwModule"); return true; }
        .KwImport => { try out.push_str_grow(alloc, "KwImport"); return true; }
        .KwPub => { try out.push_str_grow(alloc, "KwPub"); return true; }
        .KwFn => { try out.push_str_grow(alloc, "KwFn"); return true; }
        .KwSys => { try out.push_str_grow(alloc, "KwSys"); return true; }
        .KwLet => { try out.push_str_grow(alloc, "KwLet"); return true; }
        .KwVar => { try out.push_str_grow(alloc, "KwVar"); return true; }
        .KwConst => { try out.push_str_grow(alloc, "KwConst"); return true; }
        .KwType => { try out.push_str_grow(alloc, "KwType"); return true; }
        .KwStruct => { try out.push_str_grow(alloc, "KwStruct"); return true; }
        .KwLinear => { try out.push_str_grow(alloc, "KwLinear"); return true; }
        .KwPool => { try out.push_str_grow(alloc, "KwPool"); return true; }
        .KwEnum => { try out.push_str_grow(alloc, "KwEnum"); return true; }
        .KwUnion => { try out.push_str_grow(alloc, "KwUnion"); return true; }
        .KwBitfield => { try out.push_str_grow(alloc, "KwBitfield"); return true; }
        .KwIface => { try out.push_str_grow(alloc, "KwIface"); return true; }
        .KwImpl => { try out.push_str_grow(alloc, "KwImpl"); return true; }
        .KwError => { try out.push_str_grow(alloc, "KwError"); return true; }
        .KwExtern => { try out.push_str_grow(alloc, "KwExtern"); return true; }
        .KwComptime => { try out.push_str_grow(alloc, "KwComptime"); return true; }
        .KwView => { try out.push_str_grow(alloc, "KwView"); return true; }
        .KwIf => { try out.push_str_grow(alloc, "KwIf"); return true; }
        .KwElse => { try out.push_str_grow(alloc, "KwElse"); return true; }
        .KwMatch => { try out.push_str_grow(alloc, "KwMatch"); return true; }
        .KwWhile => { try out.push_str_grow(alloc, "KwWhile"); return true; }
        .KwFor => { try out.push_str_grow(alloc, "KwFor"); return true; }
        .KwPar => { try out.push_str_grow(alloc, "KwPar"); return true; }
        .KwLoop => { try out.push_str_grow(alloc, "KwLoop"); return true; }
        .KwBreak => { try out.push_str_grow(alloc, "KwBreak"); return true; }
        _ => { return false; }
    }
}

