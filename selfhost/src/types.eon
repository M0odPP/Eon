        var struct_fields = try col.DynBuf.[FieldMeta].init(alloc, src.struct_fields.len() +% 1_usize);
        errdefer struct_fields.destroy(alloc);
        try struct_fields.push_slice(alloc, src.struct_fields.as_slice());
        var pools = try col.DynBuf.[PoolMeta].init(alloc, src.pools.len() +% 1_usize);
        errdefer pools.destroy(alloc);
