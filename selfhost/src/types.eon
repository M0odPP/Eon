    pub target_id: u32;
}

// ===========================================================================
// Section 4: Linear Storage Pools & TypeEnv
// ===========================================================================

view fn slice_id_range[T](all: *[T], r: ast.IdRange) -> *[T] {
    let start = r.start.widen.[usize]();
    let end = start +% r.len.widen.[usize]();
    let s = all.sub(start, end) catch {
        return all.sub(0_usize, 0_usize) catch {
            return all;
        };
    };
    return s;
}

pub linear struct TyInternPools {
    pub nodes: col.DynBuf[TyNode];
    pub ty_list: col.DynBuf[TyId];
    pub gval_list: col.DynBuf[GenericVal];
    pub err_src_list: col.DynBuf[ErrorSource];
    pub anon_fields: col.DynBuf[AnonField];
    pub intern_head: col.HashMap[u32];
    pub intern_next: col.DynBuf[u32];
}

impl TyInternPools {
    pub fn init(alloc: *mut AllocCap) -> TyInternPools ! OutOfMemory {
        let nodes = try col.DynBuf.[TyNode].init(alloc, 128_usize);
        errdefer nodes.destroy(alloc);
        let ty_list = try col.DynBuf.[TyId].init(alloc, 128_usize);
        errdefer ty_list.destroy(alloc);
        let gval_list = try col.DynBuf.[GenericVal].init(alloc, 64_usize);
        errdefer gval_list.destroy(alloc);
        let err_src_list = try col.DynBuf.[ErrorSource].init(alloc, 32_usize);
        errdefer err_src_list.destroy(alloc);
        let anon_fields = try col.DynBuf.[AnonField].init(alloc, 32_usize);
        errdefer anon_fields.destroy(alloc);
        let intern_head = try col.HashMap.[u32].init(alloc, 128_usize);
        errdefer intern_head.destroy(alloc);
        let intern_next = try col.DynBuf.[u32].init(alloc, 128_usize);
        errdefer intern_next.destroy(alloc);
        return TyInternPools.{
            nodes: nodes,
            ty_list: ty_list,
            gval_list: gval_list,
            err_src_list: err_src_list,
            anon_fields: anon_fields,
            intern_head: intern_head,
            intern_next: intern_next,
        };
    }

    pub fn destroy(self: TyInternPools, alloc: *mut AllocCap) {
        let TyInternPools.{
            nodes,
            ty_list,
            gval_list,
            err_src_list,
            anon_fields,
            intern_head,
            intern_next,
        } = self;
        nodes.destroy(alloc);
        ty_list.destroy(alloc);
        gval_list.destroy(alloc);
        err_src_list.destroy(alloc);
        anon_fields.destroy(alloc);
        intern_head.destroy(alloc);
        intern_next.destroy(alloc);
    }

    pub fn clone_from(alloc: *mut AllocCap, src: *TyInternPools) -> TyInternPools ! OutOfMemory {
        var nodes = try col.DynBuf.[TyNode].init(alloc, src.nodes.len() +% 16_usize);
        errdefer nodes.destroy(alloc);
        try nodes.push_slice(alloc, src.nodes.as_slice());
        var ty_list = try col.DynBuf.[TyId].init(alloc, src.ty_list.len() +% 16_usize);
        errdefer ty_list.destroy(alloc);
        try ty_list.push_slice(alloc, src.ty_list.as_slice());
        var gval_list = try col.DynBuf.[GenericVal].init(alloc, src.gval_list.len() +% 16_usize);
        errdefer gval_list.destroy(alloc);
        try gval_list.push_slice(alloc, src.gval_list.as_slice());
        var err_src_list = try col.DynBuf.[ErrorSource].init(alloc, src.err_src_list.len() +% 8_usize);
        errdefer err_src_list.destroy(alloc);
        try err_src_list.push_slice(alloc, src.err_src_list.as_slice());
        var anon_fields = try col.DynBuf.[AnonField].init(alloc, src.anon_fields.len() +% 8_usize);
        errdefer anon_fields.destroy(alloc);
        try anon_fields.push_slice(alloc, src.anon_fields.as_slice());
        var intern_head = try col.HashMap.[u32].init(alloc, src.intern_head.cap());
        errdefer intern_head.destroy(alloc);
        try intern_head.copy_from(alloc, &src.intern_head);
        var intern_next = try col.DynBuf.[u32].init(alloc, src.intern_next.len() +% 16_usize);
        errdefer intern_next.destroy(alloc);
        try intern_next.push_slice(alloc, src.intern_next.as_slice());
        return TyInternPools.{
            nodes: nodes,
            ty_list: ty_list,
            gval_list: gval_list,
            err_src_list: err_src_list,
            anon_fields: anon_fields,
            intern_head: intern_head,
            intern_next: intern_next,
        };
    }

    pub fn sync_from(self: *mut Self, alloc: *mut AllocCap, src: *TyInternPools) -> !OutOfMemory {
        self.nodes.clear();
        try self.nodes.push_slice(alloc, src.nodes.as_slice());
        self.ty_list.clear();
        try self.ty_list.push_slice(alloc, src.ty_list.as_slice());
        self.gval_list.clear();
        try self.gval_list.push_slice(alloc, src.gval_list.as_slice());
        self.err_src_list.clear();
        try self.err_src_list.push_slice(alloc, src.err_src_list.as_slice());
        self.anon_fields.clear();
        try self.anon_fields.push_slice(alloc, src.anon_fields.as_slice());
        try self.intern_head.copy_from(alloc, &src.intern_head);
        self.intern_next.clear();
        try self.intern_next.push_slice(alloc, src.intern_next.as_slice());
        return;
    }
}

pub linear struct TypeDefPools {
