        has_gpu_local_size: false,
        gpu_local_x: 1_u32,
        gpu_local_y: 1_u32,
        gpu_local_z: 1_u32,
        is_recursive: false,
        is_hot: false,
        is_inline: false,
        save_simd: false,
        is_simd: false,
        has_stack_limit: false,
        stack_limit: 0_u64,
