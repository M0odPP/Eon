    pub fn clone_from(alloc: *mut AllocCap, src: *TypeDefPools) -> TypeDefPools ! OutOfMemory {
        var structs = try col.DynBuf.[StructMeta].init(alloc, src.structs.len() +% 1_usize);
        errdefer structs.destroy(alloc);
