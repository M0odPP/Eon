        }
        return null;
    }

    pub view fn get_sys_accesses(self: *Self, def_id: u32) -> *[SysColAccess] {
        let all = self.sigs.sys_accesses.as_slice();
        if let idx = self.index.sys_access_by_def.get(def_id.widen.[u64]()) {
            if let r = self.sigs.sys_access_ranges.get(idx.widen.[usize]()) {
                return slice_id_range.[SysColAccess](all, ast.range_new(r.start, r.len));
            }
        }
        return all.sub(0_usize, 0_usize) catch {
            return all;
        };
    }

    pub view fn struct_fields_range(self: *Self, r: ast.IdRange) -> *[FieldMeta] {
        return slice_id_range.[FieldMeta](self.defs.struct_fields.as_slice(), r);
    }

    pub view fn pool_cols_range(self: *Self, r: ast.IdRange) -> *[PoolColumnMeta] {
