}

// ===========================================================================
// Section 6: Type Predicates, Pool Links, and Generic Substitution
// ===========================================================================

impl TypeEnv {
    pub fn is_integer(self: *Self, id: TyId) -> bool {
        let k = self.get(id).kind;
        return k == .Int || k == .ComptimeInt;
    }

    pub fn is_concrete_integer(self: *Self, id: TyId) -> bool {
        return self.get(id).kind == .Int;
    }

    pub fn is_signed_integer(self: *Self, id: TyId) -> bool {
        let n = self.get(id);
        return (n.kind == .Int && n.flag0) || n.kind == .ComptimeInt;
    }

    pub fn is_signed_int(self: *Self, id: TyId) -> bool {
        let n = self.get(id);
        return n.kind == .Int && n.flag0;
    }

    pub fn is_float(self: *Self, id: TyId) -> bool {
        let k = self.get(id).kind;
        return k == .Float || k == .ComptimeFloat;
    }

    pub fn is_numeric(self: *Self, id: TyId) -> bool {
        return self.is_integer(id) || self.is_float(id);
    }

    pub fn is_address(self: *Self, id: TyId) -> bool {
        let k = self.get(id).kind;
        return k == .PhysAddr || k == .VirtAddr || k == .DmaAddr;
    }

    @recursive
    pub fn contains_type_type(self: *Self, id: TyId) -> bool {
        let n = self.get(id);
        match n.kind {
            .TypeType => { return true; }
            .Optional => { return self.contains_type_type(n.primary); }
            .Array => { return self.contains_type_type(n.primary); }
            .Tuple => {
                let elems = self.node_ty_list(&n);
                var i: usize = 0_usize;
                while i < elems.len {
                    if self.contains_type_type(elems[i]) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            .AnonStruct => {
                let fs = self.node_anon_fields(&n);
                var i: usize = 0_usize;
                while i < fs.len {
                    if self.contains_type_type(fs[i].ty) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            _ => { return false; }
        }
    }

    @recursive
    pub fn contains_second_class_ref(self: *Self, id: TyId) -> bool {
        let n = self.get(id);
        match n.kind {
            .Borrow => { return true; }
            .FnPtr => { return true; }
            .Optional => { return self.contains_second_class_ref(n.primary); }
            .Array => { return self.contains_second_class_ref(n.primary); }
            .ErrorUnion => { return self.contains_second_class_ref(n.primary); }
            .Tuple => {
                let elems = self.node_ty_list(&n);
                var i: usize = 0_usize;
                while i < elems.len {
                    if self.contains_second_class_ref(elems[i]) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            .AnonStruct => {
                let fs = self.node_anon_fields(&n);
                var i: usize = 0_usize;
                while i < fs.len {
                    if self.contains_second_class_ref(fs[i].ty) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            .Struct => {
                if let sm = self.get_struct(n.primary) {
                    if sm.is_view {
                        return true;
                    }
                    let fs = self.struct_fields_range(sm.fields);
                    var i: usize = 0_usize;
                    while i < fs.len {
                        if self.contains_second_class_ref(fs[i].ty) {
                            return true;
                        }
                        i = i +% 1_usize;
                    }
                }
                return false;
            }
            .Union => {
                if let um = self.get_union(n.primary) {
                    let vs = self.union_variants_range(um.variants);
                    var i: usize = 0_usize;
                    while i < vs.len {
                        if vs[i].has_payload && self.contains_second_class_ref(vs[i].payload) {
                            return true;
                        }
                        i = i +% 1_usize;
                    }
                }
                return false;
            }
            _ => { return false; }
        }
    }

    @recursive
    pub fn is_borrow_or_view(self: *Self, id: TyId) -> bool {
        let n = self.get(id);
        match n.kind {
            .Borrow => { return true; }
            .Builtin => {
                return n.builtin_kind == .ArenaPool || n.builtin_kind == .ArenaStr;
            }
            .Struct => {
                if let sm = self.get_struct(n.primary) {
                    if sm.is_view {
                        return true;
                    }
                    let fs = self.struct_fields_range(sm.fields);
                    var i: usize = 0_usize;
                    while i < fs.len {
                        if self.is_borrow_or_view(fs[i].ty) {
                            return true;
                        }
                        i = i +% 1_usize;
                    }
                }
                return false;
            }
            .Optional => { return self.is_borrow_or_view(n.primary); }
            .Array => { return self.is_borrow_or_view(n.primary); }
            .ErrorUnion => { return self.is_borrow_or_view(n.primary); }
            .Tuple => {
                let elems = self.node_ty_list(&n);
                var i: usize = 0_usize;
                while i < elems.len {
                    if self.is_borrow_or_view(elems[i]) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            .AnonStruct => {
                let fs = self.node_anon_fields(&n);
                var i: usize = 0_usize;
                while i < fs.len {
                    if self.is_borrow_or_view(fs[i].ty) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            _ => { return false; }
        }
    }

    @recursive
    pub fn contains_borrowing_value(self: *Self, id: TyId) -> bool {
        let n = self.get(id);
        match n.kind {
            .Builtin => {
                return n.builtin_kind == .ArenaPool || n.builtin_kind == .ArenaStr;
            }
            .Optional => { return self.contains_borrowing_value(n.primary); }
            .Array => { return self.contains_borrowing_value(n.primary); }
            .ErrorUnion => { return self.contains_borrowing_value(n.primary); }
            .Tuple => {
                let elems = self.node_ty_list(&n);
                var i: usize = 0_usize;
                while i < elems.len {
                    if self.contains_borrowing_value(elems[i]) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            .AnonStruct => {
                let fs = self.node_anon_fields(&n);
                var i: usize = 0_usize;
                while i < fs.len {
                    if self.contains_borrowing_value(fs[i].ty) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            _ => { return false; }
        }
    }

    @recursive
    pub fn contains_id_brand(self: *Self, id: TyId) -> bool {
        let n = self.get(id);
        match n.kind {
            .Builtin => { return n.builtin_kind == .IdBrand; }
            .Optional => { return self.contains_id_brand(n.primary); }
            .Array => { return self.contains_id_brand(n.primary); }
            .ErrorUnion => { return self.contains_id_brand(n.primary); }
            .Tuple => {
                let elems = self.node_ty_list(&n);
                var i: usize = 0_usize;
                while i < elems.len {
                    if self.contains_id_brand(elems[i]) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            .AnonStruct => {
                let fs = self.node_anon_fields(&n);
                var i: usize = 0_usize;
                while i < fs.len {
                    if self.contains_id_brand(fs[i].ty) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            _ => { return false; }
        }
    }

    pub fn gen_id_schema(self: *Self, id: TyId) -> ?TyId {
        let n = self.get(id);
        if n.kind == .Builtin && n.builtin_kind == .GenId {
            let args = self.node_gval_list(&n);
            if args.len > 0_usize && args[0_usize].kind == .Ty {
                return args[0_usize].id;
            }
        }
        return null;
    }

    pub fn is_gen_id_of(self: *Self, id: TyId, schema: TyId) -> bool {
        if let s = self.gen_id_schema(id) {
            return s == schema;
        }
        return false;
    }

    @recursive
    pub fn is_linear(self: *Self, id: TyId) -> bool {
        let n = self.get(id);
        match n.kind {
            .Struct => {
                if let m = self.get_struct(n.primary) {
                    return m.is_linear;
                }
                return false;
            }
            .Union => {
                if let m = self.get_union(n.primary) {
                    return m.is_linear;
                }
                return false;
            }
            .Array => { return self.is_linear(n.primary); }
            .Optional => { return self.is_linear(n.primary); }
            .ErrorUnion => { return self.is_linear(n.primary); }
            .Tuple => {
                let elems = self.node_ty_list(&n);
                var i: usize = 0_usize;
                while i < elems.len {
                    if self.is_linear(elems[i]) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            .AnonStruct => {
                let fs = self.node_anon_fields(&n);
                var i: usize = 0_usize;
                while i < fs.len {
                    if self.is_linear(fs[i].ty) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            .Builtin => {
                return n.builtin_kind == .Arena
                    || n.builtin_kind == .SlotPool
                    || n.builtin_kind == .LinearBuf
                    || n.builtin_kind == .DirCap;
            }
            _ => { return false; }
        }
    }

    pub fn is_copy(self: *Self, id: TyId) -> bool {
        if self.is_linear(id) {
            return false;
        }
        let sz = self.eon_layout(id).size;
        if sz <= 16_u64 {
            return true;
        }
        return self.get(id).kind == .Vec && sz <= 32_u64;
    }

    pub fn is_trivial_copy(self: *Self, id: TyId) -> bool {
        return self.is_copy(id);
    }

    @recursive
    pub fn has_niche_forbidden_for_bitcast(self: *Self, id: TyId) -> bool {
        let n = self.get(id);
        match n.kind {
            .Bool => { return true; }
            .Char => { return true; }
            .Optional => { return true; }
            .Borrow => { return true; }
            .Enum => { return true; }
            .ErrorSet => { return true; }
            .ErrorUnion => { return true; }
            .Union => { return true; }
            .Dyn => { return true; }
            .FnPtr => { return true; }
            .Int => {
                if !n.flag1 {
                    let b = n.u8_val;
                    return b != 8_u8 && b != 16_u8 && b != 32_u8 && b != 64_u8 && b != 128_u8;
                }
                return false;
            }
            .Array => { return self.has_niche_forbidden_for_bitcast(n.primary); }
            .Tuple => {
                let elems = self.node_ty_list(&n);
                var i: usize = 0_usize;
                while i < elems.len {
                    if self.has_niche_forbidden_for_bitcast(elems[i]) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            .AnonStruct => {
                let fs = self.node_anon_fields(&n);
                var i: usize = 0_usize;
                while i < fs.len {
                    if self.has_niche_forbidden_for_bitcast(fs[i].ty) {
                        return true;
                    }
                    i = i +% 1_usize;
                }
                return false;
            }
            .Struct => {
                if let sm = self.get_struct(n.primary) {
                    let fs = self.struct_fields_range(sm.fields);
                    var i: usize = 0_usize;
                    while i < fs.len {
                        if self.has_niche_forbidden_for_bitcast(fs[i].ty) {
                            return true;
                        }
                        i = i +% 1_usize;
                    }
                }
                return false;
            }
            _ => { return false; }
        }
    }

    pub fn error_sources_have_variant(
        self: *Self,
        errors: *[ErrorSource],
        variant_sym: u32,
        interner: *span.SymInterner,
    ) -> bool {
        let vname = interner.get(variant_sym);
        var i: usize = 0_usize;
        while i < errors.len {
            let src = errors[i];
            if src.kind == .User {
                if let meta = self.get_error(src.def_id) {
                    let vs = self.error_variants_range(meta.variants);
                    var vi: usize = 0_usize;
                    while vi < vs.len {
                        if vs[vi] == variant_sym {
                            return true;
                        }
                        vi = vi +% 1_usize;
                    }
                }
            } else {
                if builtin_error_has_variant(src.builtin, vname) {
                    return true;
                }
            }
            i = i +% 1_usize;
        }
        return false;
    }

    @recursive
    pub fn resolve_pool_link_ty(
        self: *mut Self,
        alloc: *mut AllocCap,
        ty: TyId,
        expected_pool_ty: TyId,
        kind: PoolHandleKind,
    ) -> TyId ! OutOfMemory {
        let n = self.get(ty);
        match n.kind {
            .Builtin => {
                if n.builtin_kind != .Link {
                    return ty;
                }
                var target_ty = expected_pool_ty;
                let args = self.node_gval_list(&n);
                if args.len > 0_usize && args[0_usize].kind == .Ty {
                    target_ty = args[0_usize].id;
                }
                if target_ty != expected_pool_ty {
                    return ty;
                }
                if kind.tag == .ArenaPool {
                    let a: [1]GenericVal = [gval_variant(kind.brand)];
                    return try self.intern_builtin(alloc, .IdBrand, &a);
                }
                let a: [1]GenericVal = [gval_ty(target_ty)];
                return try self.intern_builtin(alloc, .GenId, &a);
            }
            .Optional => {
                let r = try self.resolve_pool_link_ty(alloc, n.primary, expected_pool_ty, kind);
                if r != n.primary {
                    return try self.intern_optional(alloc, r);
                }
                return ty;
            }
            .Array => {
                let r = try self.resolve_pool_link_ty(alloc, n.primary, expected_pool_ty, kind);
                if r != n.primary {
                    return try self.intern_array(alloc, n.u64_val, r);
                }
                return ty;
            }
            .ErrorUnion => {
                let r = try self.resolve_pool_link_ty(alloc, n.primary, expected_pool_ty, kind);
                if r != n.primary {
                    var errs = try col.DynBuf.[ErrorSource].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
                    errdefer errs.destroy(alloc);
                    try errs.push_slice(alloc, self.node_err_src_list(&n));
                    let res = try self.intern_error_union(alloc, r, errs.as_slice());
                    errs.destroy(alloc);
                    return res;
                }
                return ty;
            }
            .Tuple => {
                var orig = try col.DynBuf.[TyId].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
                errdefer orig.destroy(alloc);
                try orig.push_slice(alloc, self.node_ty_list(&n));
                var mapped = try col.DynBuf.[TyId].init(alloc, orig.len() +% 1_usize);
                errdefer mapped.destroy(alloc);
                var changed = false;
                let os = orig.as_slice();
                var i: usize = 0_usize;
                while i < os.len {
                    let r = try self.resolve_pool_link_ty(alloc, os[i], expected_pool_ty, kind);
                    if r != os[i] {
                        changed = true;
                    }
                    try mapped.push(alloc, r);
                    i = i +% 1_usize;
                }
                let res = if changed {
                    try self.intern_tuple(alloc, mapped.as_slice())
                } else {
                    ty
                };
                mapped.destroy(alloc);
                orig.destroy(alloc);
                return res;
            }
            .AnonStruct => {
                var orig = try col.DynBuf.[AnonField].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
                errdefer orig.destroy(alloc);
                try orig.push_slice(alloc, self.node_anon_fields(&n));
                var mapped = try col.DynBuf.[AnonField].init(alloc, orig.len() +% 1_usize);
                errdefer mapped.destroy(alloc);
                var changed = false;
                let os = orig.as_slice();
                var i: usize = 0_usize;
                while i < os.len {
                    let r = try self.resolve_pool_link_ty(alloc, os[i].ty, expected_pool_ty, kind);
                    if r != os[i].ty {
                        changed = true;
                    }
                    try mapped.push(alloc, AnonField.{ name: os[i].name, ty: r });
                    i = i +% 1_usize;
                }
                let res = if changed {
                    try self.intern_anon_struct(alloc, mapped.as_slice())
                } else {
                    ty
                };
                mapped.destroy(alloc);
                orig.destroy(alloc);
                return res;
            }
            .Borrow => {
                if n.borrow_kind == .Str {
                    return ty;
                }
                let r = try self.resolve_pool_link_ty(alloc, n.primary, expected_pool_ty, kind);
                if r != n.primary {
                    return try self.intern_borrow(alloc, n.flag0, n.borrow_kind, r);
                }
                return ty;
            }
            _ => { return ty; }
        }
    }

    /// Read-only generic substitution (matches `codegen_x64::subst_ty_id`) using already-interned types.
    @recursive
    pub fn subst_ty(self: *Self, ty: TyId, gargs: *[GenericVal]) -> TyId {
        if gargs.len == 0_usize {
            return ty;
        }
        let n = self.get(ty);
        match n.kind {
            .GenericParam => {
                let idx = n.primary.widen.[usize]();
                if idx < gargs.len && gargs[idx].kind == .Ty {
                    return gargs[idx].id;
                }
                return ty;
            }
            .Struct => {
                if n.list_len == 0_u32 || n.list_len > 16_u32 {
                    return ty;
                }
                let args = self.node_gval_list(&n);
                var tmp: [16]GenericVal = [gval_ty(TY_VOID); 16];
                var i: usize = 0_usize;
                while i < args.len && i < 16_usize {
                    let gv = args[i];
                    if gv.kind == .Ty {
                        tmp[i] = gval_ty(self.subst_ty(gv.id, gargs));
                    } else {
                        tmp[i] = gv;
                    }
                    i = i +% 1_usize;
                }
                let tref: *[GenericVal] = &tmp;
                let sub = tref.sub(0_usize, args.len) catch {
                    return ty;
                };
                return self.find_struct(n.primary, sub) orelse ty;
            }
            .RawPtr => {
                let si = self.subst_ty(n.primary, gargs);
                return self.find_raw_ptr(n.flag0, si) orelse ty;
            }
            .Borrow => {
                if n.borrow_kind == .Str {
                    return ty;
                }
                let si = self.subst_ty(n.primary, gargs);
                return self.find_borrow(n.flag0, n.borrow_kind, si) orelse ty;
            }
            .Optional => {
                let si = self.subst_ty(n.primary, gargs);
                return self.find_optional(si) orelse ty;
            }
            .Array => {
                let si = self.subst_ty(n.primary, gargs);
                return self.find_array(n.u64_val, si) orelse ty;
            }
            .Builtin => {
                if n.list_len == 0_u32 || n.list_len > 16_u32 {
                    return ty;
                }
                let args = self.node_gval_list(&n);
                var tmp: [16]GenericVal = [gval_ty(TY_VOID); 16];
                var i: usize = 0_usize;
                while i < args.len && i < 16_usize {
                    let gv = args[i];
                    if gv.kind == .Ty {
                        tmp[i] = gval_ty(self.subst_ty(gv.id, gargs));
                    } else {
                        tmp[i] = gv;
                    }
                    i = i +% 1_usize;
                }
                let tref: *[GenericVal] = &tmp;
                let sub = tref.sub(0_usize, args.len) catch {
                    return ty;
                };
                return self.find_builtin(n.builtin_kind, sub) orelse ty;
            }
            _ => { return ty; }
        }
    }

    /// Full interning generic substitution across all `TyKind`s (for `check.eon` & monomorphization).
    @recursive
    pub fn subst_ty_intern(
        self: *mut Self,
        alloc: *mut AllocCap,
        ty: TyId,
        gargs: *[GenericVal],
    ) -> TyId ! OutOfMemory {
        if gargs.len == 0_usize {
            return ty;
        }
        let n = self.get(ty);
        match n.kind {
            .GenericParam => {
                let idx = n.primary.widen.[usize]();
                if idx < gargs.len && gargs[idx].kind == .Ty {
                    return gargs[idx].id;
                }
                return ty;
            }
            .Optional => {
                let r = try self.subst_ty_intern(alloc, n.primary, gargs);
                return if r != n.primary { try self.intern_optional(alloc, r) } else { ty };
            }
            .RawPtr => {
                let r = try self.subst_ty_intern(alloc, n.primary, gargs);
                return if r != n.primary { try self.intern_raw_ptr(alloc, n.flag0, r) } else { ty };
            }
            .Borrow => {
                if n.borrow_kind == .Str {
                    return ty;
                }
                let r = try self.subst_ty_intern(alloc, n.primary, gargs);
                return if r != n.primary {
                    try self.intern_borrow(alloc, n.flag0, n.borrow_kind, r)
                } else {
                    ty
                };
            }
            .Array => {
                let r = try self.subst_ty_intern(alloc, n.primary, gargs);
                return if r != n.primary { try self.intern_array(alloc, n.u64_val, r) } else { ty };
            }
            .Vec => {
                let r = try self.subst_ty_intern(alloc, n.primary, gargs);
                return if r != n.primary { try self.intern_vec(alloc, r, n.u8_val) } else { ty };
            }
            .ErrorUnion => {
                let r = try self.subst_ty_intern(alloc, n.primary, gargs);
                if r != n.primary {
                    var errs = try col.DynBuf.[ErrorSource].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
                    errdefer errs.destroy(alloc);
                    try errs.push_slice(alloc, self.node_err_src_list(&n));
                    let res = try self.intern_error_union(alloc, r, errs.as_slice());
                    errs.destroy(alloc);
                    return res;
                }
                return ty;
            }
            .Tuple => {
                return try self.subst_ty_list_intern(alloc, ty, &n, gargs, false);
            }
            .FnPtr => {
                return try self.subst_ty_list_intern(alloc, ty, &n, gargs, true);
            }
            .AnonStruct => {
                return try self.subst_anon_struct_intern(alloc, ty, &n, gargs);
            }
            .Struct => {
                return try self.subst_gval_ty_intern(alloc, ty, &n, gargs);
            }
            .Pool => {
                return try self.subst_gval_ty_intern(alloc, ty, &n, gargs);
            }
            .Union => {
                return try self.subst_gval_ty_intern(alloc, ty, &n, gargs);
            }
            .Builtin => {
                return try self.subst_gval_ty_intern(alloc, ty, &n, gargs);
            }
            _ => { return ty; }
        }
    }

    @recursive
    fn subst_ty_list_intern(
        self: *mut Self,
        alloc: *mut AllocCap,
        ty: TyId,
        n: *TyNode,
        gargs: *[GenericVal],
        is_fn_ptr: bool,
    ) -> TyId ! OutOfMemory {
        var orig = try col.DynBuf.[TyId].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
        errdefer orig.destroy(alloc);
        try orig.push_slice(alloc, self.node_ty_list(n));
        var mapped = try col.DynBuf.[TyId].init(alloc, orig.len() +% 1_usize);
        errdefer mapped.destroy(alloc);
        var changed = false;
        let os = orig.as_slice();
        var i: usize = 0_usize;
        while i < os.len {
            let r = try self.subst_ty_intern(alloc, os[i], gargs);
            if r != os[i] {
                changed = true;
            }
            try mapped.push(alloc, r);
            i = i +% 1_usize;
        }
        var new_ret = n.primary;
        if is_fn_ptr {
            new_ret = try self.subst_ty_intern(alloc, n.primary, gargs);
            if new_ret != n.primary {
                changed = true;
            }
        }
        let res = if !changed {
            ty
        } else if is_fn_ptr {
            try self.intern_fn_ptr(alloc, mapped.as_slice(), new_ret)
        } else {
            try self.intern_tuple(alloc, mapped.as_slice())
        };
        mapped.destroy(alloc);
        orig.destroy(alloc);
        return res;
    }

    @recursive
    fn subst_anon_struct_intern(
        self: *mut Self,
        alloc: *mut AllocCap,
        ty: TyId,
        n: *TyNode,
        gargs: *[GenericVal],
    ) -> TyId ! OutOfMemory {
        var orig = try col.DynBuf.[AnonField].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
        errdefer orig.destroy(alloc);
        try orig.push_slice(alloc, self.node_anon_fields(n));
        var mapped = try col.DynBuf.[AnonField].init(alloc, orig.len() +% 1_usize);
        errdefer mapped.destroy(alloc);
        var changed = false;
        let os = orig.as_slice();
        var i: usize = 0_usize;
        while i < os.len {
            let r = try self.subst_ty_intern(alloc, os[i].ty, gargs);
            if r != os[i].ty {
                changed = true;
            }
            try mapped.push(alloc, AnonField.{ name: os[i].name, ty: r });
            i = i +% 1_usize;
        }
        let res = if changed {
            try self.intern_anon_struct(alloc, mapped.as_slice())
        } else {
            ty
        };
        mapped.destroy(alloc);
        orig.destroy(alloc);
        return res;
    }

    @recursive
    fn subst_gval_ty_intern(
        self: *mut Self,
        alloc: *mut AllocCap,
        ty: TyId,
        n: *TyNode,
        gargs: *[GenericVal],
    ) -> TyId ! OutOfMemory {
        if n.list_len == 0_u32 {
            return ty;
        }
        var orig = try col.DynBuf.[GenericVal].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
        errdefer orig.destroy(alloc);
        try orig.push_slice(alloc, self.node_gval_list(n));
        var mapped = try col.DynBuf.[GenericVal].init(alloc, orig.len() +% 1_usize);
        errdefer mapped.destroy(alloc);
        var changed = false;
        let os = orig.as_slice();
        var i: usize = 0_usize;
        while i < os.len {
            let gv = os[i];
            if gv.kind == .Ty {
                let r = try self.subst_ty_intern(alloc, gv.id, gargs);
                if r != gv.id {
                    changed = true;
                }
                try mapped.push(alloc, gval_ty(r));
            } else {
                try mapped.push(alloc, gv);
            }
            i = i +% 1_usize;
        }
        var res = ty;
        if changed {
            match n.kind {
                .Struct => { res = try self.intern_struct(alloc, n.primary, mapped.as_slice()); }
                .Pool => { res = try self.intern_pool(alloc, n.primary, mapped.as_slice()); }
                .Union => { res = try self.intern_union(alloc, n.primary, mapped.as_slice()); }
                .Builtin => { res = try self.intern_builtin(alloc, n.builtin_kind, mapped.as_slice()); }
                _ => {}
            }
        }
        mapped.destroy(alloc);
        orig.destroy(alloc);
        return res;
    }
}

fn builtin_error_has_variant(b: BuiltinErrorKind, vname: *[u8]) -> bool {
    match b {
        .ArithError => {
            return str.bytes_eq(vname, "Overflow".as_bytes())
                || str.bytes_eq(vname, "DivByZero".as_bytes())
                || str.bytes_eq(vname, "Underflow".as_bytes());
        }
        .BoundsError => {
            return str.bytes_eq(vname, "OutOfBounds".as_bytes());
        }
        .Utf8Error => {
            return str.bytes_eq(vname, "InvalidUtf8".as_bytes())
                || str.bytes_eq(vname, "UnexpectedEof".as_bytes());
        }
        .OutOfMemory => {
            return str.bytes_eq(vname, "OutOfMemory".as_bytes());
        }
        .MemError => {
            return str.bytes_eq(vname, "OutOfMemory".as_bytes())
                || str.bytes_eq(vname, "InvalidSize".as_bytes())
                || str.bytes_eq(vname, "BadAlignment".as_bytes())
                || str.bytes_eq(vname, "AllocFailed".as_bytes());
        }
        .StaleId => {
            return str.bytes_eq(vname, "StaleId".as_bytes());
        }
        .IoError => {
            return str.bytes_eq(vname, "NotFound".as_bytes())
                || str.bytes_eq(vname, "PermissionDenied".as_bytes())
                || str.bytes_eq(vname, "PathEscape".as_bytes())
                || str.bytes_eq(vname, "AlreadyExists".as_bytes())
                || str.bytes_eq(vname, "InvalidInput".as_bytes())
                || str.bytes_eq(vname, "Other".as_bytes());
        }
    }
}

// ===========================================================================
// Section 7: Eon Spec Layout & Exact x86_64 ABI Layout & ?T Niches
// ===========================================================================

fn max_u64(a: u64, b: u64) -> u64 {
    return if a > b { a } else { b };
}

fn max_usize(a: usize, b: usize) -> usize {
    return if a > b { a } else { b };
}

impl TypeEnv {
    @recursive
    fn eon_layout_builtin(self: *Self, n: *TyNode) -> EonLayout {
        match n.builtin_kind {
            .Ordering => { return EonLayout.{ size: 1_u64, align: 1_u64, has_niche: true }; }
            .IdBrand => { return EonLayout.{ size: 4_u64, align: 4_u64, has_niche: true }; }
            .GenId => { return EonLayout.{ size: 8_u64, align: 4_u64, has_niche: true }; }
            .Link => { return EonLayout.{ size: 8_u64, align: 4_u64, has_niche: true }; }
            .MmioReg => {
                let args = self.node_gval_list(n);
                if args.len > 0_usize && args[0_usize].kind == .Ty {
                    return self.eon_layout(args[0_usize].id);
                }
                return EonLayout.{ size: 4_u64, align: 4_u64, has_niche: false };
            }
            .Arena => { return EonLayout.{ size: 32_u64, align: 8_u64, has_niche: false }; }
            .ArenaPool => { return EonLayout.{ size: 32_u64, align: 8_u64, has_niche: false }; }
            .SlotPool => { return EonLayout.{ size: 32_u64, align: 8_u64, has_niche: false }; }
            .Buf => { return EonLayout.{ size: 32_u64, align: 8_u64, has_niche: false }; }
            .LinearBuf => { return EonLayout.{ size: 32_u64, align: 8_u64, has_niche: false }; }
            .ArenaStr => { return EonLayout.{ size: 16_u64, align: 8_u64, has_niche: true }; }
            .AllocCap => { return EonLayout.{ size: 40_u64, align: 8_u64, has_niche: false }; }
            .Env => { return EonLayout.{ size: 88_u64, align: 8_u64, has_niche: false }; }
            .ArgsCap => { return EonLayout.{ size: 16_u64, align: 8_u64, has_niche: false }; }
            .BuildCap => { return EonLayout.{ size: 16_u64, align: 8_u64, has_niche: false }; }
            .Atomic => {
                let args = self.node_gval_list(n);
                if args.len > 0_usize && args[0_usize].kind == .Ty {
                    let l = self.eon_layout(args[0_usize].id);
                    return EonLayout.{
                        size: max_u64(l.size, 1_u64),
                        align: max_u64(l.align, 1_u64),
                        has_niche: false,
                    };
                }
                return EonLayout.{ size: 8_u64, align: 8_u64, has_niche: false };
            }
            _ => { return EonLayout.{ size: 8_u64, align: 8_u64, has_niche: false }; }
        }
    }

    @recursive
    fn eon_layout_tuple_sorted(self: *Self, elems: *[TyId]) -> EonLayout {
        var offset: u64 = 0_u64;
        var max_align: u64 = 1_u64;
        var niche = false;
        var ceiling: u64 = 0xFFFFFFFFFFFFFFFF_u64;
        loop {
            var cur_a: u64 = 0_u64;
            var i: usize = 0_usize;
            while i < elems.len {
                let al = self.eon_layout(elems[i]).align;
                if al < ceiling && al > cur_a {
                    cur_a = al;
                }
                i = i +% 1_usize;
            }
            if cur_a == 0_u64 {
                break;
            }
            var j: usize = 0_usize;
            while j < elems.len {
                let l = self.eon_layout(elems[j]);
                if l.align == cur_a {
                    offset = align_up_u64(offset, l.align);
                    offset = offset +% l.size;
                    max_align = max_u64(max_align, l.align);
                    if l.has_niche {
                        niche = true;
                    }
                }
                j = j +% 1_usize;
            }
            ceiling = cur_a;
        }
        return EonLayout.{
            size: align_up_u64(offset, max_align),
            align: max_align,
            has_niche: niche,
        };
    }

    @recursive
    fn eon_layout_anon_sorted(self: *Self, fields: *[AnonField]) -> EonLayout {
        var offset: u64 = 0_u64;
        var max_align: u64 = 1_u64;
        var niche = false;
        var ceiling: u64 = 0xFFFFFFFFFFFFFFFF_u64;
        loop {
            var cur_a: u64 = 0_u64;
            var i: usize = 0_usize;
            while i < fields.len {
                let al = self.eon_layout(fields[i].ty).align;
                if al < ceiling && al > cur_a {
                    cur_a = al;
                }
                i = i +% 1_usize;
            }
            if cur_a == 0_u64 {
                break;
            }
            var j: usize = 0_usize;
            while j < fields.len {
                let l = self.eon_layout(fields[j].ty);
                if l.align == cur_a {
                    offset = align_up_u64(offset, l.align);
                    offset = offset +% l.size;
                    max_align = max_u64(max_align, l.align);
                    if l.has_niche {
                        niche = true;
                    }
                }
                j = j +% 1_usize;
            }
            ceiling = cur_a;
        }
        return EonLayout.{
            size: align_up_u64(offset, max_align),
            align: max_align,
            has_niche: niche,
        };
    }

    /// Language-level Eon layout (matching `compiler/src/types.rs::TypeEnv::layout`).
    @recursive
    pub fn eon_layout(self: *Self, id: TyId) -> EonLayout {
        let n = self.get(id);
        match n.kind {
            .Void => { return EonLayout.{ size: 0_u64, align: 1_u64, has_niche: false }; }
            .Never => { return EonLayout.{ size: 0_u64, align: 1_u64, has_niche: false }; }
            .TypeType => { return EonLayout.{ size: 0_u64, align: 1_u64, has_niche: false }; }
            .Error => { return EonLayout.{ size: 0_u64, align: 1_u64, has_niche: false }; }
            .ComptimeInt => { return EonLayout.{ size: 0_u64, align: 1_u64, has_niche: false }; }
            .ComptimeFloat => { return EonLayout.{ size: 0_u64, align: 1_u64, has_niche: false }; }
            .Str => { return EonLayout.{ size: 0_u64, align: 1_u64, has_niche: false }; }
            .Dyn => { return EonLayout.{ size: 0_u64, align: 1_u64, has_niche: false }; }
            .Pool => { return EonLayout.{ size: 0_u64, align: 1_u64, has_niche: false }; }
            .Bool => { return EonLayout.{ size: 1_u64, align: 1_u64, has_niche: true }; }
            .Char => { return EonLayout.{ size: 4_u64, align: 4_u64, has_niche: true }; }
            .Int => {
                if n.flag1 {
                    return EonLayout.{ size: 8_u64, align: 8_u64, has_niche: false };
                }
                let b = n.u8_val;
                let bytes: u64 = if b <= 8_u8 {
                    1_u64
                } else if b <= 16_u8 {
                    2_u64
                } else if b <= 32_u8 {
                    4_u64
                } else if b <= 64_u8 {
                    8_u64
                } else {
                    16_u64
                };
                let niche = b != 8_u8 && b != 16_u8 && b != 32_u8 && b != 64_u8 && b != 128_u8;
                return EonLayout.{ size: bytes, align: bytes, has_niche: niche };
            }
            .Float => {
                let bytes = (n.u8_val / 8_u8).widen.[u64]();
                return EonLayout.{ size: bytes, align: bytes, has_niche: false };
            }
            .PhysAddr => { return EonLayout.{ size: 8_u64, align: 8_u64, has_niche: false }; }
            .VirtAddr => { return EonLayout.{ size: 8_u64, align: 8_u64, has_niche: false }; }
            .DmaAddr => { return EonLayout.{ size: 8_u64, align: 8_u64, has_niche: false }; }
            .Vec => {
                let el = self.eon_layout(n.primary);
                let sz = sat_mul_u64(el.size, n.u8_val.widen.[u64]());
                let clamped = if sz < 1_u64 {
                    1_u64
                } else if sz > 32_u64 {
                    32_u64
                } else {
                    sz
                };
                let p2 = next_pow2_u64(clamped);
                let al = if p2 > 32_u64 { 32_u64 } else { p2 };
                return EonLayout.{ size: sz, align: al, has_niche: false };
            }
            .Borrow => {
                if n.borrow_kind == .Single {
                    let is_fat = self.get(n.primary).kind == .Dyn;
                    return EonLayout.{
                        size: if is_fat { 16_u64 } else { 8_u64 },
                        align: 8_u64,
                        has_niche: true,
                    };
                }
                return EonLayout.{ size: 16_u64, align: 8_u64, has_niche: true };
            }
            .RawPtr => { return EonLayout.{ size: 8_u64, align: 8_u64, has_niche: true }; }
            .FnPtr => { return EonLayout.{ size: 16_u64, align: 8_u64, has_niche: true }; }
            .Array => {
                let el = self.eon_layout(n.primary);
                return EonLayout.{
                    size: sat_mul_u64(el.size, n.u64_val),
                    align: el.align,
                    has_niche: n.u64_val > 0_u64 && el.has_niche,
                };
            }
            .Tuple => {
                return self.eon_layout_tuple_sorted(self.node_ty_list(&n));
            }
            .AnonStruct => {
                return self.eon_layout_anon_sorted(self.node_anon_fields(&n));
            }
            .Optional => {
                let l = self.eon_layout(n.primary);
                if l.has_niche {
                    return EonLayout.{ size: l.size, align: l.align, has_niche: false };
                }
                return EonLayout.{
                    size: align_up_u64(l.size +% 1_u64, l.align),
                    align: l.align,
                    has_niche: false,
                };
            }
            .ErrorSet => { return EonLayout.{ size: 2_u64, align: 2_u64, has_niche: true }; }
            .ErrorUnion => {
                let l = self.eon_layout(n.primary);
                if l.size == 0_u64 {
                    return EonLayout.{ size: 2_u64, align: 2_u64, has_niche: false };
                }
                let al = max_u64(l.align, 2_u64);
                return EonLayout.{
                    size: align_up_u64(l.size +% 2_u64, al),
                    align: al,
                    has_niche: false,
                };
            }
            .Struct => {
                if let m = self.get_struct(n.primary) {
                    return m.layout;
                }
                return EonLayout.{ size: 0_u64, align: 1_u64, has_niche: false };
            }
            .Enum => {
                if let e = self.get_enum(n.primary) {
                    var l = self.eon_layout(e.repr_ty);
                    l.has_niche = e.has_niche;
                    return l;
                }
                return EonLayout.{ size: 1_u64, align: 1_u64, has_niche: true };
            }
            .Union => {
                if let u = self.get_union(n.primary) {
                    return u.layout;
                }
                return EonLayout.{ size: 1_u64, align: 1_u64, has_niche: false };
            }
            .Bitfield => {
                if let b = self.get_bitfield(n.primary) {
                    return self.eon_layout(b.base_ty);
                }
                return EonLayout.{ size: 8_u64, align: 8_u64, has_niche: false };
            }
            .GenericParam => { return EonLayout.{ size: 8_u64, align: 8_u64, has_niche: false }; }
            .Builtin => { return self.eon_layout_builtin(&n); }
        }
    }

    // --- Exact x86_64 `?T` Niche Classification (matching `codegen_x64.rs`) ---

    pub fn opt_niche(self: *Self, inner: TyId) -> OptNiche {
        let none = OptNiche.{ kind: .None, size: 0_usize, sentinel: 0_u64 };
        let n = self.get(inner);
        match n.kind {
            .Builtin => {
                match n.builtin_kind {
                    .IdBrand => { return OptNiche.{ kind: .IdBrand, size: 0_usize, sentinel: 0_u64 }; }
                    .GenId => { return OptNiche.{ kind: .GenId, size: 0_usize, sentinel: 0_u64 }; }
                    .Link => { return OptNiche.{ kind: .Link, size: 0_usize, sentinel: 0_u64 }; }
                    _ => { return none; }
                }
            }
            .Bool => { return OptNiche.{ kind: .BoolTag, size: 0_usize, sentinel: 0_u64 }; }
            .Char => { return OptNiche.{ kind: .ScalarSentinel, size: 4_usize, sentinel: 4294967295_u64 }; }
            .ErrorSet => { return OptNiche.{ kind: .ScalarSentinel, size: 4_usize, sentinel: 0_u64 }; }
            .Enum => {
                if let meta = self.get_enum(n.primary) {
                    if meta.has_niche {
                        let vars = self.enum_variants_range(meta.variants);
                        var cand: u32 = 4294967295_u32;
                        loop {
                            var used = false;
                            var vi: usize = 0_usize;
                            while vi < vars.len {
                                if vars[vi].val.lo.trunc.[u32]() == cand {
                                    used = true;
                                    break;
                                }
                                vi = vi +% 1_usize;
                            }
                            if !used {
                                break;
                            }
                            cand = cand -% 1_u32;
                        }
                        return OptNiche.{
                            kind: .ScalarSentinel,
                            size: 4_usize,
                            sentinel: cand.widen.[u64](),
                        };
                    }
                }
                return none;
            }
            .Int => {
                let b = n.u8_val;
                if !n.flag1 && b != 8_u8 && b != 16_u8 && b != 32_u8 && b != 64_u8 && b != 128_u8 {
                    let sz: usize = if b <= 8_u8 {
                        1_usize
                    } else if b <= 16_u8 {
                        2_usize
                    } else if b <= 32_u8 {
                        4_usize
                    } else {
                        8_usize
                    };
                    let shift = ((sz *% 8_usize) -% 1_usize).trunc.[u64]();
                    let sentinel = 1_u64 <<% shift;
                    return OptNiche.{ kind: .ScalarSentinel, size: sz, sentinel: sentinel };
                }
                return none;
            }
            .Borrow => {
                if n.borrow_kind == .Single {
                    let tk = self.get(n.primary).kind;
                    if tk == .Pool || tk == .Dyn {
                        return OptNiche.{ kind: .FatPtrNullFirst, size: 0_usize, sentinel: 0_u64 };
                    }
                    return OptNiche.{ kind: .NullPtr, size: 0_usize, sentinel: 0_u64 };
                }
                return OptNiche.{ kind: .SliceMaxLen, size: 0_usize, sentinel: 0_u64 };
            }
            .RawPtr => { return OptNiche.{ kind: .NullPtr, size: 0_usize, sentinel: 0_u64 }; }
            .FnPtr => { return OptNiche.{ kind: .FatPtrNullFirst, size: 0_usize, sentinel: 0_u64 }; }
            _ => { return none; }
        }
        return none;
    }

    pub fn is_niche_id_opt(self: *Self, inner: TyId) -> bool {
        return self.opt_niche(inner).kind != .None;
    }

    pub fn is_link_or_opt_link(self: *Self, ty: TyId) -> bool {
        let n = self.get(ty);
        if n.kind == .Builtin && n.builtin_kind == .Link {
            return true;
        }
        if n.kind == .Optional {
            let inn = self.get(n.primary);
            return inn.kind == .Builtin && inn.builtin_kind == .Link;
        }
        return false;
    }

    pub fn pool_def_of_gargs(self: *Self, args: *[GenericVal]) -> ?u32 {
        if args.len > 0_usize && args[0_usize].kind == .Ty {
            let pn = self.get(args[0_usize].id);
            if pn.kind == .Pool {
                return pn.primary;
            }
        }
        return null;
    }

    pub fn pool_col_count(self: *Self, args: *[GenericVal]) -> usize {
        if let d = self.pool_def_of_gargs(args) {
            if let m = self.get_pool(d) {
                return m.columns.len.widen.[usize]();
            }
        }
        return 0_usize;
    }

    // --- Exact x86_64 Layout & Field Offsets (matching `codegen_x64.rs`) ---

    @recursive
    pub fn x64_layout(self: *Self, ty: TyId) -> Layout {
        return self.x64_layout_impl(ty, false);
    }

    @recursive
    fn x64_layout_builtin(self: *Self, n: *TyNode, link_is_slot: bool) -> Layout {
        match n.builtin_kind {
            .Arena => { return Layout.{ size: 24_usize, align: 8_usize }; }
            .Buf => { return Layout.{ size: 24_usize, align: 8_usize }; }
            .LinearBuf => { return Layout.{ size: 24_usize, align: 8_usize }; }
            .AllocCap => { return Layout.{ size: 40_usize, align: 8_usize }; }
            .Env => { return Layout.{ size: 88_usize, align: 8_usize }; }
            .ArgsCap => { return Layout.{ size: 16_usize, align: 8_usize }; }
            .BuildCap => { return Layout.{ size: 16_usize, align: 8_usize }; }
            .ArenaStr => { return Layout.{ size: 16_usize, align: 8_usize }; }
            .GpuBuf => { return Layout.{ size: 16_usize, align: 8_usize }; }
            .GpuImage2D => { return Layout.{ size: 16_usize, align: 8_usize }; }
            .Ordering => { return Layout.{ size: 4_usize, align: 4_usize }; }
            .IdBrand => { return Layout.{ size: 4_usize, align: 4_usize }; }
            .GenId => { return Layout.{ size: 8_usize, align: 4_usize }; }
            .Link => {
                if link_is_slot {
                    return Layout.{ size: 8_usize, align: 4_usize };
                }
                return Layout.{ size: 4_usize, align: 4_usize };
            }
            .ArenaPool => {
                let ncols = self.pool_col_count(self.node_gval_list(n));
                return Layout.{ size: (ncols +% 2_usize) *% 8_usize, align: 8_usize };
            }
            .SlotPool => {
                let ncols = self.pool_col_count(self.node_gval_list(n));
                return Layout.{ size: (ncols +% 5_usize) *% 8_usize, align: 8_usize };
            }
            .Atomic => {
                let args = self.node_gval_list(n);
                let el = if args.len > 0_usize && args[0_usize].kind == .Ty {
                    args[0_usize].id
                } else {
                    TY_U64
                };
                return self.x64_layout(el);
            }
            .MmioReg => {
                let args = self.node_gval_list(n);
                let el = if args.len > 0_usize && args[0_usize].kind == .Ty {
                    args[0_usize].id
                } else {
                    TY_U64
                };
                return self.x64_layout(el);
            }
            _ => { return Layout.{ size: 8_usize, align: 8_usize }; }
        }
    }

    @recursive
    fn x64_layout_aggregates(self: *Self, n: *TyNode, link_is_slot: bool) -> Layout {
        match n.kind {
            .Optional => {
                if self.is_niche_id_opt(n.primary) {
                    return self.x64_layout_impl(n.primary, link_is_slot);
                }
                let il = self.x64_layout_impl(n.primary, link_is_slot);
                let align = max_usize(il.align, 1_usize);
                let val_off = align_up_usize(1_usize, align);
                let size = align_up_usize(val_off +% max_usize(il.size, 1_usize), align);
                return Layout.{ size: size, align: align };
            }
            .ErrorUnion => {
                let ol = if n.primary == TY_VOID || n.primary == TY_NEVER {
                    Layout.{ size: 1_usize, align: 1_usize }
                } else {
                    self.x64_layout_impl(n.primary, link_is_slot)
                };
                let align = max_usize(ol.align, 4_usize);
                let ok_off = align_up_usize(4_usize, max_usize(ol.align, 1_usize));
                let size = align_up_usize(ok_off +% max_usize(ol.size, 1_usize), align);
                return Layout.{ size: size, align: align };
            }
            .Array => {
                let el = self.x64_layout(n.primary);
                let count = max_usize(n.u64_val.trunc.[usize](), 1_usize);
                return Layout.{
                    size: max_usize(el.size, 1_usize) *% count,
                    align: max_usize(el.align, 1_usize),
                };
            }
            .Tuple => {
                let elems = self.node_ty_list(n);
                if elems.len == 0_usize {
                    return Layout.{ size: 1_usize, align: 1_usize };
                }
                var off: usize = 0_usize;
                var max_a: usize = 1_usize;
                var i: usize = 0_usize;
                while i < elems.len {
                    let l = self.x64_layout(elems[i]);
                    let a = max_usize(l.align, 1_usize);
                    max_a = max_usize(max_a, a);
                    off = align_up_usize(off, a) +% max_usize(l.size, 1_usize);
                    i = i +% 1_usize;
                }
                return Layout.{ size: align_up_usize(off, max_a), align: max_a };
            }
            .AnonStruct => {
                let fs = self.node_anon_fields(n);
                if fs.len == 0_usize {
                    return Layout.{ size: 1_usize, align: 1_usize };
                }
                var off: usize = 0_usize;
                var max_a: usize = 1_usize;
                var i: usize = 0_usize;
                while i < fs.len {
                    let l = self.x64_layout(fs[i].ty);
                    let a = max_usize(l.align, 1_usize);
                    max_a = max_usize(max_a, a);
                    off = align_up_usize(off, a) +% max_usize(l.size, 1_usize);
                    i = i +% 1_usize;
                }
                return Layout.{ size: align_up_usize(off, max_a), align: max_a };
            }
            .Struct => {
                let m = self.get_struct(n.primary) orelse {
                    return Layout.{ size: 1_usize, align: 1_usize };
                };
                let fs = self.struct_fields_range(m.fields);
                if fs.len == 0_usize {
                    return Layout.{ size: 1_usize, align: 1_usize };
                }
                let args = self.node_gval_list(n);
                var off: usize = 0_usize;
                var max_a: usize = 1_usize;
                var i: usize = 0_usize;
                while i < fs.len {
                    let fty = if args.len == 0_usize {
                        fs[i].ty
                    } else {
                        self.subst_ty(fs[i].ty, args)
                    };
                    let l = self.x64_layout(fty);
                    let a = if m.is_packed { 1_usize } else { max_usize(l.align, 1_usize) };
                    max_a = max_usize(max_a, a);
                    let f_off = if fs[i].has_explicit_offset {
                        fs[i].offset.trunc.[usize]()
                    } else {
                        align_up_usize(off, a)
                    };
                    let end_off = f_off +% max_usize(l.size, 1_usize);
                    if end_off > off {
                        off = end_off;
                    }
                    i = i +% 1_usize;
                }
                return Layout.{ size: align_up_usize(off, max_a), align: max_a };
            }
            .Pool => {
                let m = self.get_pool(n.primary) orelse {
                    return Layout.{ size: 1_usize, align: 1_usize };
                };
                let cols = self.pool_cols_range(m.columns);
                if cols.len == 0_usize {
                    return Layout.{ size: 1_usize, align: 1_usize };
                }
                var off: usize = 0_usize;
                var max_a: usize = 1_usize;
                var i: usize = 0_usize;
                while i < cols.len {
                    let l = self.x64_layout_impl(cols[i].ty, true);
                    let a = max_usize(l.align, 1_usize);
                    max_a = max_usize(max_a, a);
                    off = align_up_usize(off, a) +% max_usize(l.size, 1_usize);
                    i = i +% 1_usize;
                }
                return Layout.{ size: align_up_usize(off, max_a), align: max_a };
            }
            .Union => {
                let m = self.get_union(n.primary) orelse {
                    return Layout.{ size: 4_usize, align: 4_usize };
                };
                let vs = self.union_variants_range(m.variants);
                var max_psz: usize = 1_usize;
                var max_pa: usize = 1_usize;
                var i: usize = 0_usize;
                while i < vs.len {
                    if vs[i].has_payload {
                        let l = self.x64_layout(vs[i].payload);
                        max_psz = max_usize(max_psz, max_usize(l.size, 1_usize));
                        max_pa = max_usize(max_pa, max_usize(l.align, 1_usize));
                    }
                    i = i +% 1_usize;
                }
                let align = max_usize(max_pa, 4_usize);
                let p_off = align_up_usize(4_usize, max_pa);
                return Layout.{ size: align_up_usize(p_off +% max_psz, align), align: align };
            }
            _ => { return Layout.{ size: 8_usize, align: 8_usize }; }
        }
    }

    @recursive
    pub fn x64_layout_impl(self: *Self, ty: TyId, link_is_slot: bool) -> Layout {
        let n = self.get(ty);
        match n.kind {
            .Void => { return Layout.{ size: 0_usize, align: 1_usize }; }
            .Never => { return Layout.{ size: 0_usize, align: 1_usize }; }
            .Bool => { return Layout.{ size: 1_usize, align: 1_usize }; }
            .Char => { return Layout.{ size: 4_usize, align: 4_usize }; }
            .Enum => { return Layout.{ size: 4_usize, align: 4_usize }; }
            .ErrorSet => { return Layout.{ size: 4_usize, align: 4_usize }; }
            .Int => {
                let sz: usize = if n.flag1 {
                    8_usize
                } else if n.u8_val <= 8_u8 {
                    1_usize
                } else if n.u8_val <= 16_u8 {
                    2_usize
                } else if n.u8_val <= 32_u8 {
                    4_usize
                } else if n.u8_val <= 64_u8 {
                    8_usize
                } else {
                    16_usize
                };
                let al = if sz < 8_usize { sz } else { 8_usize };
                return Layout.{ size: sz, align: al };
            }
            .Float => {
                let sz: usize = if n.u8_val == 16_u8 {
                    2_usize
                } else if n.u8_val == 32_u8 {
                    4_usize
                } else {
                    8_usize
                };
                return Layout.{ size: sz, align: sz };
            }
            .PhysAddr => { return Layout.{ size: 8_usize, align: 8_usize }; }
            .VirtAddr => { return Layout.{ size: 8_usize, align: 8_usize }; }
            .DmaAddr => { return Layout.{ size: 8_usize, align: 8_usize }; }
            .RawPtr => { return Layout.{ size: 8_usize, align: 8_usize }; }
            .FnPtr => { return Layout.{ size: 16_usize, align: 8_usize }; }
            .Str => { return Layout.{ size: 16_usize, align: 8_usize }; }
            .Dyn => { return Layout.{ size: 16_usize, align: 8_usize }; }
            .Borrow => {
                if n.borrow_kind == .Single {
                    let tk = self.get(n.primary).kind;
                    if tk == .Pool || tk == .Dyn {
                        return Layout.{ size: 16_usize, align: 8_usize };
                    }
                    return Layout.{ size: 8_usize, align: 8_usize };
                }
                return Layout.{ size: 16_usize, align: 8_usize };
            }
            .Bitfield => {
                let bty = if let m = self.get_bitfield(n.primary) { m.base_ty } else { TY_U32 };
                return self.x64_layout(bty);
            }
            .Vec => {
                let el = self.x64_layout(n.primary);
                let lanes = max_usize(n.u8_val.widen.[usize](), 1_usize);
                return Layout.{
                    size: max_usize(el.size, 1_usize) *% lanes,
                    align: max_usize(el.align, 4_usize),
                };
            }
            .Builtin => { return self.x64_layout_builtin(&n, link_is_slot); }
            .Optional => { return self.x64_layout_aggregates(&n, link_is_slot); }
            .ErrorUnion => { return self.x64_layout_aggregates(&n, link_is_slot); }
            .Array => { return self.x64_layout_aggregates(&n, link_is_slot); }
            .Tuple => { return self.x64_layout_aggregates(&n, link_is_slot); }
            .AnonStruct => { return self.x64_layout_aggregates(&n, link_is_slot); }
            .Struct => { return self.x64_layout_aggregates(&n, link_is_slot); }
            .Pool => { return self.x64_layout_aggregates(&n, link_is_slot); }
            .Union => { return self.x64_layout_aggregates(&n, link_is_slot); }
            _ => { return Layout.{ size: 8_usize, align: 8_usize }; }
        }
    }

    @recursive
    pub fn struct_field_offset(self: *Self, ty: TyId, field_idx: usize) -> FieldOffTy {
        let fallback = FieldOffTy.{ offset: 0_usize, ty: TY_U64 };
        let n = self.get(ty);
        match n.kind {
            .Struct => {
                let m = self.get_struct(n.primary) orelse { return fallback; };
                let fs = self.struct_fields_range(m.fields);
                let args = self.node_gval_list(&n);
                var off: usize = 0_usize;
                var i: usize = 0_usize;
                while i < fs.len {
                    let fty = if args.len == 0_usize {
                        fs[i].ty
                    } else {
                        self.subst_ty(fs[i].ty, args)
                    };
                    let l = self.x64_layout(fty);
                    let a = if m.is_packed { 1_usize } else { max_usize(l.align, 1_usize) };
                    let f_off = if fs[i].has_explicit_offset {
                        fs[i].offset.trunc.[usize]()
                    } else {
                        align_up_usize(off, a)
                    };
                    if i == field_idx {
                        return FieldOffTy.{ offset: f_off, ty: fty };
                    }
                    let end_off = f_off +% max_usize(l.size, 1_usize);
                    if end_off > off {
                        off = end_off;
                    }
                    i = i +% 1_usize;
                }
                return fallback;
            }
            .Pool => {
                let m = self.get_pool(n.primary) orelse { return fallback; };
                let cols = self.pool_cols_range(m.columns);
                var off: usize = 0_usize;
                var i: usize = 0_usize;
                while i < cols.len {
                    let l = self.x64_layout_impl(cols[i].ty, true);
                    off = align_up_usize(off, max_usize(l.align, 1_usize));
                    if i == field_idx {
                        return FieldOffTy.{ offset: off, ty: cols[i].ty };
                    }
                    off = off +% max_usize(l.size, 1_usize);
                    i = i +% 1_usize;
                }
                return fallback;
            }
            .AnonStruct => {
                let fs = self.node_anon_fields(&n);
                var off: usize = 0_usize;
                var i: usize = 0_usize;
                while i < fs.len {
                    let l = self.x64_layout(fs[i].ty);
                    off = align_up_usize(off, max_usize(l.align, 1_usize));
                    if i == field_idx {
                        return FieldOffTy.{ offset: off, ty: fs[i].ty };
                    }
                    off = off +% max_usize(l.size, 1_usize);
                    i = i +% 1_usize;
                }
                return fallback;
            }
            .Tuple => {
                let es = self.node_ty_list(&n);
                var off: usize = 0_usize;
                var i: usize = 0_usize;
                while i < es.len {
                    let l = self.x64_layout(es[i]);
                    off = align_up_usize(off, max_usize(l.align, 1_usize));
                    if i == field_idx {
                        return FieldOffTy.{ offset: off, ty: es[i] };
                    }
                    off = off +% max_usize(l.size, 1_usize);
                    i = i +% 1_usize;
                }
                return fallback;
            }
            .Vec => {
                let el = self.x64_layout(n.primary);
                return FieldOffTy.{
                    offset: field_idx *% max_usize(el.size, 1_usize),
                    ty: n.primary,
                };
            }
            .Builtin => {
                if n.builtin_kind != .Env {
                    return fallback;
                }
                var off: usize = 0_usize;
                var bk: resolve.BuiltinKind = .AllocCap;
                if field_idx == 1_usize {
                    off = 40_usize;
                    bk = .FsCap;
                } else if field_idx == 2_usize {
                    off = 48_usize;
                    bk = .NetCap;
                } else if field_idx == 3_usize {
                    off = 56_usize;
                    bk = .ClockCap;
                } else if field_idx == 4_usize {
                    off = 64_usize;
                    bk = .IoCap;
                } else if field_idx == 5_usize {
                    off = 72_usize;
                    bk = .ArgsCap;
                }
                let fty = self.find_builtin_empty(bk) orelse TY_U64;
                return FieldOffTy.{ offset: off, ty: fty };
            }
            _ => { return fallback; }
        }
    }

    pub fn opt_val_offset(self: *Self, inner: TyId) -> usize {
        let il = self.x64_layout(inner);
        return align_up_usize(1_usize, max_usize(il.align, 1_usize));
    }

    pub fn eu_ok_offset(self: *Self, ok: TyId) -> usize {
        if ok == TY_VOID || ok == TY_NEVER {
            return 4_usize;
        }
        let ol = self.x64_layout(ok);
        return align_up_usize(4_usize, max_usize(ol.align, 1_usize));
    }

    pub fn union_payload_offset(self: *Self, def_id: u32) -> usize {
        let m = self.get_union(def_id) orelse {
            return 4_usize;
        };
        let vs = self.union_variants_range(m.variants);
        var max_a: usize = 1_usize;
        var i: usize = 0_usize;
        while i < vs.len {
            if vs[i].has_payload {
                max_a = max_usize(max_a, max_usize(self.x64_layout(vs[i].payload).align, 1_usize));
            }
            i = i +% 1_usize;
        }
        return align_up_usize(4_usize, max_a);
    }

    @recursive
    pub fn int_bits(self: *Self, ty: TyId) -> u8 {
        let n = self.get(ty);
        match n.kind {
            .Int => { return if n.flag1 { 64_u8 } else { n.u8_val }; }
            .Bool => { return 8_u8; }
            .Char => { return 32_u8; }
            .Enum => { return 32_u8; }
            .ErrorSet => { return 32_u8; }
            .Bitfield => {
                let bty = if let m = self.get_bitfield(n.primary) { m.base_ty } else { TY_U32 };
                return self.int_bits(bty);
            }
            _ => { return 64_u8; }
        }
    }
}

// ===========================================================================
// Section 8: Type Formatting (Canonical & Diagnostic)
// ===========================================================================

pub fn write_def_qualified_name(
    alloc: *mut AllocCap,
    prog: *resolve.ResolvedProgram,
    def_id: u32,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    let d = prog.get_def(def_id) orelse {
        try out.push_str_grow(alloc, "def#");
        try out.push_u64_grow(alloc, def_id.widen.[u64]());
        return;
    };
    if let m = prog.get_module(d.module_id) {
        let mname = interner.get(m.path_sym);
        if mname.len > 0_usize {
            try out.push_bytes_grow(alloc, mname);
            try out.push_byte_grow(alloc, b'.');
        }
    }
    try out.push_bytes_grow(alloc, interner.get(d.name));
    return;
}

fn write_builtin_error_name(
    alloc: *mut AllocCap,
    b: BuiltinErrorKind,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    match b {
        .ArithError => { try out.push_str_grow(alloc, "ArithError"); }
        .BoundsError => { try out.push_str_grow(alloc, "BoundsError"); }
        .Utf8Error => { try out.push_str_grow(alloc, "Utf8Error"); }
        .OutOfMemory => { try out.push_str_grow(alloc, "OutOfMemory"); }
        .MemError => { try out.push_str_grow(alloc, "MemError"); }
        .StaleId => { try out.push_str_grow(alloc, "StaleId"); }
        .IoError => { try out.push_str_grow(alloc, "IoError"); }
    }
    return;
}

fn write_error_source_resolved(
    alloc: *mut AllocCap,
    src: ErrorSource,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    if src.kind == .User {
        try write_def_qualified_name(alloc, prog, src.def_id, interner, out);
    } else {
        try write_builtin_error_name(alloc, src.builtin, out);
    }
    return;
}

fn write_error_source_short(
    alloc: *mut AllocCap,
    src: ErrorSource,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    if src.kind == .User {
        try out.push_str_grow(alloc, "err#");
        try out.push_u64_grow(alloc, src.def_id.widen.[u64]());
    } else {
        try write_builtin_error_name(alloc, src.builtin, out);
    }
    return;
}

fn write_builtin_prefix_arged(
    alloc: *mut AllocCap,
    bk: resolve.BuiltinKind,
    out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    match bk {
        .Atomic => { try out.push_str_grow(alloc, "Atomic["); return true; }
        .GpuBuf => { try out.push_str_grow(alloc, "GpuBuf["); return true; }
        .GpuImage2D => { try out.push_str_grow(alloc, "GpuImage2D["); return true; }
        .MmioReg => { try out.push_str_grow(alloc, "MmioReg["); return true; }
        .ArenaPool => { try out.push_str_grow(alloc, "ArenaPool["); return true; }
        .SlotPool => { try out.push_str_grow(alloc, "SlotPool["); return true; }
        .Buf => { try out.push_str_grow(alloc, "Buf["); return true; }
        .LinearBuf => { try out.push_str_grow(alloc, "LinearBuf["); return true; }
        .IdBrand => { try out.push_str_grow(alloc, "Id["); return true; }
        .GenId => { try out.push_str_grow(alloc, "GenId["); return true; }
        .Link => { try out.push_str_grow(alloc, "Link["); return true; }
        _ => { return false; }
    }
}

fn write_builtin_plain(
    alloc: *mut AllocCap,
    bk: resolve.BuiltinKind,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    match bk {
        .Arena => { try out.push_str_grow(alloc, "Arena"); }
        .ArenaStr => { try out.push_str_grow(alloc, "ArenaStr"); }
        .AllocCap => { try out.push_str_grow(alloc, "AllocCap"); }
        .Env => { try out.push_str_grow(alloc, "Env"); }
        .FsCap => { try out.push_str_grow(alloc, "FsCap"); }
        .DirCap => { try out.push_str_grow(alloc, "DirCap"); }
        .NetCap => { try out.push_str_grow(alloc, "NetCap"); }
        .ClockCap => { try out.push_str_grow(alloc, "ClockCap"); }
        .IoCap => { try out.push_str_grow(alloc, "IoCap"); }
        .ArgsCap => { try out.push_str_grow(alloc, "ArgsCap"); }
        .BuildCap => { try out.push_str_grow(alloc, "BuildCap"); }
        .IoError => { try out.push_str_grow(alloc, "IoError"); }
        .Schedule => { try out.push_str_grow(alloc, "Schedule"); }
        _ => {
            try resolve.write_builtin_debug(alloc, resolve.encode_builtin_simple(bk), out);
        }
    }
    return;
}

fn format_ty_scalar(
    alloc: *mut AllocCap,
    n: *TyNode,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    match n.kind {
        .Void => { try out.push_str_grow(alloc, "void"); return true; }
        .Never => { try out.push_str_grow(alloc, "never"); return true; }
        .Bool => { try out.push_str_grow(alloc, "bool"); return true; }
        .Char => { try out.push_str_grow(alloc, "char"); return true; }
        .Str => { try out.push_str_grow(alloc, "str"); return true; }
        .TypeType => { try out.push_str_grow(alloc, "type"); return true; }
        .ComptimeInt => { try out.push_str_grow(alloc, "comptime_int"); return true; }
        .ComptimeFloat => { try out.push_str_grow(alloc, "comptime_float"); return true; }
        .Int => {
            if n.flag1 {
                if n.flag0 {
                    try out.push_str_grow(alloc, "isize");
                } else {
                    try out.push_str_grow(alloc, "usize");
                }
            } else {
                try out.push_byte_grow(alloc, if n.flag0 { b'i' } else { b'u' });
                try out.push_u64_grow(alloc, n.u8_val.widen.[u64]());
            }
            return true;
        }
        .Float => {
            try out.push_byte_grow(alloc, b'f');
            try out.push_u64_grow(alloc, n.u8_val.widen.[u64]());
            return true;
        }
        .PhysAddr => { try out.push_str_grow(alloc, "PhysAddr"); return true; }
        .VirtAddr => { try out.push_str_grow(alloc, "VirtAddr"); return true; }
        .DmaAddr => { try out.push_str_grow(alloc, "DmaAddr"); return true; }
        .GenericParam => {
            try out.push_bytes_grow(alloc, interner.get(n.aux));
            return true;
        }
        .Error => { try out.push_str_grow(alloc, "<error>"); return true; }
        _ => { return false; }
    }
}

impl TypeEnv {
    @recursive
    fn format_gval_resolved(
        self: *Self,
        alloc: *mut AllocCap,
        gv: GenericVal,
        prog: *resolve.ResolvedProgram,
        interner: *span.SymInterner,
        out: *mut str.StrBuf,
    ) -> !OutOfMemory {
        match gv.kind {
            .Ty => { try self.format_ty(alloc, gv.id, prog, interner, out); }
            .Int => { try push_int_val_grow(alloc, gv.int_val, out); }
            .Variant => { try out.push_bytes_grow(alloc, interner.get(gv.id)); }
        }
        return;
    }

    @recursive
    fn format_gval_short(
        self: *Self,
        alloc: *mut AllocCap,
        gv: GenericVal,
        interner: *span.SymInterner,
        out: *mut str.StrBuf,
    ) -> !OutOfMemory {
        match gv.kind {
            .Ty => { try self.format_ty_short(alloc, gv.id, interner, out); }
            .Int => { try push_int_val_grow(alloc, gv.int_val, out); }
            .Variant => { try out.push_bytes_grow(alloc, interner.get(gv.id)); }
        }
        return;
    }

    @recursive
    fn format_ty_named_def(
        self: *Self,
        alloc: *mut AllocCap,
        n: *TyNode,
        prog: *resolve.ResolvedProgram,
        interner: *span.SymInterner,
        out: *mut str.StrBuf,
    ) -> !OutOfMemory {
        try write_def_qualified_name(alloc, prog, n.primary, interner, out);
        let args = self.node_gval_list(n);
        if args.len > 0_usize {
            try out.push_byte_grow(alloc, b'[');
            var i: usize = 0_usize;
            while i < args.len {
                if i > 0_usize {
                    try out.push_str_grow(alloc, ", ");
                }
                try self.format_gval_resolved(alloc, args[i], prog, interner, out);
                i = i +% 1_usize;
            }
            try out.push_byte_grow(alloc, b']');
        }
        return;
    }

    @recursive
    fn format_ty_compound(
        self: *Self,
        alloc: *mut AllocCap,
        n: *TyNode,
        prog: *resolve.ResolvedProgram,
        interner: *span.SymInterner,
        out: *mut str.StrBuf,
    ) -> !OutOfMemory {
        match n.kind {
            .Tuple => {
                try out.push_byte_grow(alloc, b'(');
                let elems = self.node_ty_list(n);
                var i: usize = 0_usize;
                while i < elems.len {
                    if i > 0_usize {
                        try out.push_str_grow(alloc, ", ");
                    }
                    try self.format_ty(alloc, elems[i], prog, interner, out);
                    i = i +% 1_usize;
                }
                try out.push_byte_grow(alloc, b')');
            }
            .FnPtr => {
                try out.push_str_grow(alloc, "fn(");
                let ps = self.node_ty_list(n);
                var i: usize = 0_usize;
                while i < ps.len {
                    if i > 0_usize {
                        try out.push_str_grow(alloc, ", ");
                    }
                    try self.format_ty(alloc, ps[i], prog, interner, out);
                    i = i +% 1_usize;
                }
                try out.push_str_grow(alloc, ") -> ");
                try self.format_ty(alloc, n.primary, prog, interner, out);
            }
            .Struct => { try self.format_ty_named_def(alloc, n, prog, interner, out); }
            .Pool => { try self.format_ty_named_def(alloc, n, prog, interner, out); }
            .Union => { try self.format_ty_named_def(alloc, n, prog, interner, out); }
            .Enum => { try write_def_qualified_name(alloc, prog, n.primary, interner, out); }
            .Bitfield => { try write_def_qualified_name(alloc, prog, n.primary, interner, out); }
            .Dyn => {
                try out.push_str_grow(alloc, "dyn ");
                try write_def_qualified_name(alloc, prog, n.primary, interner, out);
            }
            .AnonStruct => {
                try out.push_str_grow(alloc, "struct { ");
                let fs = self.node_anon_fields(n);
                var i: usize = 0_usize;
                while i < fs.len {
                    if i > 0_usize {
                        try out.push_str_grow(alloc, ", ");
                    }
                    try out.push_bytes_grow(alloc, interner.get(fs[i].name));
                    try out.push_str_grow(alloc, ": ");
                    try self.format_ty(alloc, fs[i].ty, prog, interner, out);
                    i = i +% 1_usize;
                }
                try out.push_str_grow(alloc, " }");
            }
            .ErrorSet => {
                try write_error_source_resolved(alloc, node_error_source(n), prog, interner, out);
            }
            .Builtin => {
                if try write_builtin_prefix_arged(alloc, n.builtin_kind, out) {
                    let args = self.node_gval_list(n);
                    if args.len > 0_usize {
                        try self.format_gval_resolved(alloc, args[0_usize], prog, interner, out);
                    }
                    try out.push_byte_grow(alloc, b']');
                } else {
                    try write_builtin_plain(alloc, n.builtin_kind, out);
                }
            }
            _ => {}
        }
        return;
    }

    /// Canonical resolved type formatter (matches `compiler/src/types.rs::format_ty_resolved` byte-for-byte).
    @recursive
    pub fn format_ty(
        self: *Self,
        alloc: *mut AllocCap,
        ty: TyId,
        prog: *resolve.ResolvedProgram,
        interner: *span.SymInterner,
        out: *mut str.StrBuf,
    ) -> !OutOfMemory {
        let n = self.get(ty);
        if try format_ty_scalar(alloc, &n, interner, out) {
            return;
        }
        match n.kind {
            .Vec => {
                try out.push_str_grow(alloc, "vec[");
                try self.format_ty(alloc, n.primary, prog, interner, out);
                try out.push_str_grow(alloc, ", ");
                try out.push_u64_grow(alloc, n.u8_val.widen.[u64]());
                try out.push_byte_grow(alloc, b']');
            }
            .Optional => {
                try out.push_byte_grow(alloc, b'?');
                try self.format_ty(alloc, n.primary, prog, interner, out);
            }
            .ErrorUnion => {
                if n.primary == TY_VOID {
                    try out.push_byte_grow(alloc, b'!');
                } else {
                    try self.format_ty(alloc, n.primary, prog, interner, out);
                    try out.push_str_grow(alloc, " ! ");
                }
                let errs = self.node_err_src_list(&n);
                var i: usize = 0_usize;
                while i < errs.len {
                    if i > 0_usize {
                        try out.push_str_grow(alloc, " | ");
                    }
                    try write_error_source_resolved(alloc, errs[i], prog, interner, out);
                    i = i +% 1_usize;
                }
            }
            .Borrow => {
                try out.push_byte_grow(alloc, b'*');
                if n.flag0 {
                    try out.push_str_grow(alloc, "mut ");
                }
                match n.borrow_kind {
                    .Single => {
                        try self.format_ty(alloc, n.primary, prog, interner, out);
                    }
                    .Slice => {
                        try out.push_byte_grow(alloc, b'[');
                        try self.format_ty(alloc, n.primary, prog, interner, out);
                        try out.push_byte_grow(alloc, b']');
                    }
                    .Str => {
                        try out.push_str_grow(alloc, "str");
                    }
                }
            }
            .RawPtr => {
                if n.flag0 {
                    try out.push_str_grow(alloc, "rawptr_mut[");
                } else {
                    try out.push_str_grow(alloc, "rawptr[");
                }
                try self.format_ty(alloc, n.primary, prog, interner, out);
                try out.push_byte_grow(alloc, b']');
            }
            .Array => {
                try out.push_byte_grow(alloc, b'[');
                try out.push_u64_grow(alloc, n.u64_val);
                try out.push_byte_grow(alloc, b']');
                try self.format_ty(alloc, n.primary, prog, interner, out);
            }
            _ => {
                try self.format_ty_compound(alloc, &n, prog, interner, out);
            }
        }
        return;
    }

    /// Diagnostic short formatter without `ResolvedProgram` (matches `compiler/src/types.rs::format_ty`).
    @recursive
    pub fn format_ty_short(
        self: *Self,
        alloc: *mut AllocCap,
        ty: TyId,
        interner: *span.SymInterner,
        out: *mut str.StrBuf,
    ) -> !OutOfMemory {
        let n = self.get(ty);
        if try format_ty_scalar(alloc, &n, interner, out) {
            return;
        }
        match n.kind {
            .Vec => {
                try out.push_str_grow(alloc, "vec[");
                try self.format_ty_short(alloc, n.primary, interner, out);
                try out.push_str_grow(alloc, ", ");
                try out.push_u64_grow(alloc, n.u8_val.widen.[u64]());
                try out.push_byte_grow(alloc, b']');
            }
            .Optional => {
                try out.push_byte_grow(alloc, b'?');
                try self.format_ty_short(alloc, n.primary, interner, out);
            }
            .ErrorUnion => {
                if n.primary == TY_VOID {
                    try out.push_byte_grow(alloc, b'!');
                } else {
                    try self.format_ty_short(alloc, n.primary, interner, out);
                    try out.push_str_grow(alloc, " ! ");
                }
                let errs = self.node_err_src_list(&n);
                var i: usize = 0_usize;
                while i < errs.len {
                    if i > 0_usize {
                        try out.push_str_grow(alloc, " | ");
                    }
                    try write_error_source_short(alloc, errs[i], out);
                    i = i +% 1_usize;
                }
            }
            .Borrow => {
                try out.push_byte_grow(alloc, b'*');
                if n.flag0 {
                    try out.push_str_grow(alloc, "mut ");
                }
                match n.borrow_kind {
                    .Single => { try self.format_ty_short(alloc, n.primary, interner, out); }
                    .Slice => {
                        try out.push_byte_grow(alloc, b'[');
                        try self.format_ty_short(alloc, n.primary, interner, out);
                        try out.push_byte_grow(alloc, b']');
                    }
                    .Str => { try out.push_str_grow(alloc, "str"); }
                }
            }
            .RawPtr => {
                if n.flag0 {
                    try out.push_str_grow(alloc, "rawptr_mut[");
                } else {
                    try out.push_str_grow(alloc, "rawptr[");
                }
                try self.format_ty_short(alloc, n.primary, interner, out);
                try out.push_byte_grow(alloc, b']');
            }
            .Array => {
                try out.push_byte_grow(alloc, b'[');
                try out.push_u64_grow(alloc, n.u64_val);
                try out.push_byte_grow(alloc, b']');
                try self.format_ty_short(alloc, n.primary, interner, out);
            }
            .Tuple => {
                try out.push_byte_grow(alloc, b'(');
                let elems = self.node_ty_list(&n);
                var i: usize = 0_usize;
                while i < elems.len {
                    if i > 0_usize {
                        try out.push_str_grow(alloc, ", ");
                    }
                    try self.format_ty_short(alloc, elems[i], interner, out);
                    i = i +% 1_usize;
                }
                try out.push_byte_grow(alloc, b')');
            }
            .FnPtr => {
                try out.push_str_grow(alloc, "fn(");
                let ps = self.node_ty_list(&n);
                var i: usize = 0_usize;
                while i < ps.len {
                    if i > 0_usize {
                        try out.push_str_grow(alloc, ", ");
                    }
                    try self.format_ty_short(alloc, ps[i], interner, out);
                    i = i +% 1_usize;
                }
                try out.push_str_grow(alloc, ") -> ");
                try self.format_ty_short(alloc, n.primary, interner, out);
            }
            .AnonStruct => { try out.push_str_grow(alloc, "struct { ... }"); }
            .ErrorSet => { try write_error_source_short(alloc, node_error_source(&n), out); }
            .Builtin => {
                if try write_builtin_prefix_arged(alloc, n.builtin_kind, out) {
                    let args = self.node_gval_list(&n);
                    if args.len > 0_usize {
                        try self.format_gval_short(alloc, args[0_usize], interner, out);
                    }
                    try out.push_byte_grow(alloc, b']');
                } else {
                    try write_builtin_plain(alloc, n.builtin_kind, out);
                }
            }
            _ => {
                try out.push_str_grow(alloc, "type#");
                try out.push_u64_grow(alloc, n.primary.widen.[u64]());
            }
        }
        return;
    }

    pub fn format_ty_named(
        self: *Self,
        alloc: *mut AllocCap,
        ty: TyId,
        prog: *resolve.ResolvedProgram,
        interner: *span.SymInterner,
        out: *mut str.StrBuf,
    ) -> !OutOfMemory {
        let n = self.get(ty);
        match n.kind {
            .Struct => {
                if let d = prog.get_def(n.primary) {
                    try out.push_bytes_grow(alloc, interner.get(d.name));
                    return;
                }
            }
            .Pool => {
                if let d = prog.get_def(n.primary) {
                    try out.push_bytes_grow(alloc, interner.get(d.name));
                    return;
                }
            }
            .Enum => {
                if let d = prog.get_def(n.primary) {
                    try out.push_bytes_grow(alloc, interner.get(d.name));
                    return;
                }
            }
            .Union => {
                if let d = prog.get_def(n.primary) {
                    try out.push_bytes_grow(alloc, interner.get(d.name));
                    return;
                }
            }
            .Bitfield => {
                if let d = prog.get_def(n.primary) {
                    try out.push_bytes_grow(alloc, interner.get(d.name));
                    return;
                }
            }
            .Dyn => {
                try out.push_str_grow(alloc, "dyn ");
                if let d = prog.get_def(n.primary) {
                    try out.push_bytes_grow(alloc, interner.get(d.name));
                    return;
                }
            }
            _ => {}
        }
        try self.format_ty_short(alloc, ty, interner, out);
        return;
    }
}

// ===========================================================================
// Section 9: Primitives, Integer Bounds, and Constant Integer Evaluation
// ===========================================================================

pub fn prim_to_ty_id(prim: resolve.PrimKind, bits: u8) -> TyId {
    match prim {
        .UInt => {
            if bits == 8_u8 { return TY_U8; }
            if bits == 16_u8 { return TY_U16; }
            if bits == 32_u8 { return TY_U32; }
            if bits == 64_u8 { return TY_U64; }
            if bits == 128_u8 { return TY_U128; }
            return TY_U64;
        }
        .USize => { return TY_USIZE; }
        .IInt => {
            if bits == 8_u8 { return TY_I8; }
            if bits == 16_u8 { return TY_I16; }
            if bits == 32_u8 { return TY_I32; }
            if bits == 64_u8 { return TY_I64; }
            if bits == 128_u8 { return TY_I128; }
            return TY_I64;
        }
        .ISize => { return TY_ISIZE; }
        .F16 => { return TY_F16; }
        .F32 => { return TY_F32; }
        .F64 => { return TY_F64; }
        .Bool => { return TY_BOOL; }
        .Char => { return TY_CHAR; }
        .Void => { return TY_VOID; }
        .Never => { return TY_NEVER; }
        .TypeType => { return TY_TYPE_TYPE; }
        .Str => { return TY_STR; }
        .PhysAddr => { return TY_PHYS_ADDR; }
        .VirtAddr => { return TY_VIRT_ADDR; }
        .DmaAddr => { return TY_DMA_ADDR; }
    }
}

pub fn prim_to_ty_id_in_env(
    alloc: *mut AllocCap,
    prim: resolve.PrimKind,
    bits: u8,
    env: *mut TypeEnv,
) -> TyId ! OutOfMemory {
    if prim == .UInt {
        if bits != 8_u8 && bits != 16_u8 && bits != 32_u8 && bits != 64_u8 && bits != 128_u8 {
            return try env.intern_int(alloc, false, bits, false);
        }
    } else if prim == .IInt {
        if bits != 8_u8 && bits != 16_u8 && bits != 32_u8 && bits != 64_u8 && bits != 128_u8 {
            return try env.intern_int(alloc, true, bits, false);
        }
    }
    return prim_to_ty_id(prim, bits);
}

pub fn int_bounds(n: TyNode) -> IntBounds {
    if n.kind != .Int {
        return IntBounds.{ valid: false, has_max: false, min: int_val_zero(), max: int_val_zero() };
    }
    let signed = n.flag0;
    let bits: u8 = if n.flag1 { 64_u8 } else { n.u8_val };
    if signed {
        if bits >= 128_u8 {
            return IntBounds.{ valid: true, has_max: true, min: int_val_min_i128(), max: int_val_max_i128() };
        }
        if bits <= 1_u8 {
            return IntBounds.{ valid: true, has_max: true, min: int_val_from_i64(-1_i64), max: int_val_zero() };
        }
        let half = int_val_shl(int_val_from_u64(1_u64), (bits -% 1_u8).widen.[u32]());
        let max_v = int_val_checked_sub(half, int_val_from_u64(1_u64)) orelse int_val_max_i128();
        let min_v = int_val_checked_neg(half) orelse int_val_min_i128();
        return IntBounds.{ valid: true, has_max: true, min: min_v, max: max_v };
    }
    if bits >= 128_u8 {
        // u128 upper bound (2^128 - 1) exceeds signed i128 IntVal domain; mark `has_max: false`
        // so abstract intervals and match coverage treat upper bound conservatively as unbounded.
        return IntBounds.{ valid: true, has_max: false, min: int_val_zero(), max: int_val_max_i128() };
    }
    if bits == 127_u8 {
        return IntBounds.{ valid: true, has_max: true, min: int_val_zero(), max: int_val_max_i128() };
    }
    let top = int_val_shl(int_val_from_u64(1_u64), bits.widen.[u32]());
    let max_v = int_val_checked_sub(top, int_val_from_u64(1_u64)) orelse int_val_max_i128();
    return IntBounds.{ valid: true, has_max: true, min: int_val_zero(), max: max_v };
}

fn eval_const_int_bin(op: ast.BinaryOp, l: IntVal, r: IntVal) -> ?IntVal {
    match op {
        .Add => { return int_val_checked_add(l, r); }
        .AddWrap => { return int_val_checked_add(l, r); }
        .Sub => { return int_val_checked_sub(l, r); }
        .SubWrap => { return int_val_checked_sub(l, r); }
        .Mul => { return int_val_checked_mul(l, r); }
        .MulWrap => { return int_val_checked_mul(l, r); }
        .Div => { return int_val_checked_div(l, r); }
        .Mod => { return int_val_checked_rem(l, r); }
        .Shl => {
            if let s = int_val_to_u64(r) {
                if s < 128_u64 {
                    return int_val_shl(l, s.trunc.[u32]());
                }
            }
            return null;
        }
        .Shr => {
            if let s = int_val_to_u64(r) {
                if s < 128_u64 {
                    return int_val_shr(l, s.trunc.[u32]());
                }
            }
            return null;
        }
        .BitAnd => {
            return IntVal.{
                lo: l.lo & r.lo,
                hi: (l.hi.bitcast.[u64]() & r.hi.bitcast.[u64]()).bitcast.[i64](),
            };
        }
        .BitOr => {
            return IntVal.{
                lo: l.lo | r.lo,
                hi: (l.hi.bitcast.[u64]() | r.hi.bitcast.[u64]()).bitcast.[i64](),
            };
        }
        .BitXor => {
            return IntVal.{
                lo: l.lo ^ r.lo,
                hi: (l.hi.bitcast.[u64]() ^ r.hi.bitcast.[u64]()).bitcast.[i64](),
            };
        }
        _ => { return null; }
    }
}

@recursive
pub fn eval_const_int(
    alloc: *mut AllocCap,
    expr_id: u32,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> ?IntVal ! OutOfMemory {
    let e = arena.get_expr(expr_id) orelse {
        return null;
    };
    match e.kind {
        .IntLit => {
            let v = parse_int_literal_u128(interner.get(e.a)) orelse {
                return null;
            };
            return u128_to_signed(v, false);
        }
        .Paren => {
            return try eval_const_int(alloc, e.a, mod_id, ctx, arena, prog, env, interner, diags);
        }
        .Unary => {
            if e.unary_op != .Neg {
                return null;
            }
            if let inn = arena.get_expr(e.a) {
                if inn.kind == .IntLit {
                    let v = parse_int_literal_u128(interner.get(inn.a)) orelse {
                        return null;
                    };
                    if v.hi == 0x8000000000000000_u64 && v.lo == 0_u64 {
                        return int_val_min_i128();
                    }
                    let pos = u128_to_signed(v, false) orelse {
                        return null;
                    };
                    return int_val_checked_neg(pos);
                }
            }
            let inner_v = try eval_const_int(alloc, e.a, mod_id, ctx, arena, prog, env, interner, diags) orelse {
                return null;
            };
            return int_val_checked_neg(inner_v);
        }
        .Ident => {
            if let cv = ctx.find_comptime_val(e.a) {
                return cv;
            }
            if let ent = prog.lookup_in_module(mod_id, e.a) {
                if ent.kind == .Def {
                    if let cm = env.get_const(ent.target_id) {
                        if cm.has_int_val {
                            return cm.int_val;
                        }
                    }
                }
            }
            return null;
        }
        .Binary => {
            let l = try eval_const_int(alloc, e.a, mod_id, ctx, arena, prog, env, interner, diags) orelse {
                return null;
            };
            let r = try eval_const_int(alloc, e.b, mod_id, ctx, arena, prog, env, interner, diags) orelse {
                return null;
            };
            return eval_const_int_bin(e.bin_op, l, r);
        }
        .Builtin => {
            let bname = interner.get(e.ident.sym);
            let is_size_of = str.bytes_eq(bname, "size_of".as_bytes());
            let is_align_of = str.bytes_eq(bname, "align_of".as_bytes());
            if (!is_size_of && !is_align_of) || e.list.len != 1_u32 {
                return null;
            }
            let args = arena.generic_args_range(e.list);
            if args.len != 1_usize {
                return null;
            }
            let arg = args[0_usize];
            let saved_diags = diags.count();
            var ty = TY_ERROR;
            if arg.kind == .Type {
                ty = try resolve_type_expr(alloc, arg.node_id, mod_id, ctx, arena, prog, env, interner, diags);
            } else if arg.kind == .TypeOrConst {
                ty = try resolve_type_path(
                    alloc, arg.segs, ast.range_empty(), arg.span, mod_id, ctx, arena, prog, env, interner, diags,
                );
            } else {
                return null;
            }
            diags.truncate(saved_diags);
            if ty == TY_ERROR {
                return null;
            }
            let l = env.eon_layout(ty);
            return int_val_from_u64(if is_size_of { l.size } else { l.align });
        }
        _ => { return null; }
    }
}

// ===========================================================================
// Section 10: Path, Generic, and Type Expression Resolution
// ===========================================================================

fn module_scope_contains(prog: *resolve.ResolvedProgram, mod_id: u32, sym: u32) -> bool {
    let sc = prog.module_scopes(mod_id);
    var lo: usize = 0_usize;
    var hi: usize = sc.len;
    while lo < hi {
        let mid = lo +% ((hi -% lo) >> 1_usize);
        if mid < sc.len {
            let k = sc[mid].name;
            if k == sym {
                return true;
            }
            if k < sym {
                lo = mid +% 1_usize;
            } else {
                hi = mid;
            }
        } else {
            break;
        }
    }
    return false;
}

fn emit_diag_fmt2(
    alloc: *mut AllocCap,
    diags: *mut diag.DiagBag,
    code: u32,
    sp: span.Span,
    p0: *str,
    s0: *[u8],
    p1: *str,
) -> !OutOfMemory {
    var buf = try str.StrBuf.init(alloc, 96_usize);
    errdefer buf.destroy(alloc);
    try buf.push_str_grow(alloc, p0);
    try buf.push_bytes_grow(alloc, s0);
    try buf.push_str_grow(alloc, p1);
    _ = try diags.emit_error_bytes(alloc, code, sp, buf.as_bytes());
    buf.destroy(alloc);
    return;
}

fn emit_diag_fmt3(
    alloc: *mut AllocCap,
    diags: *mut diag.DiagBag,
    code: u32,
    sp: span.Span,
    p0: *str,
    s0: *[u8],
    p1: *str,
    s1: *[u8],
    p2: *str,
) -> !OutOfMemory {
    var buf = try str.StrBuf.init(alloc, 128_usize);
    errdefer buf.destroy(alloc);
    try buf.push_str_grow(alloc, p0);
    try buf.push_bytes_grow(alloc, s0);
    try buf.push_str_grow(alloc, p1);
    try buf.push_bytes_grow(alloc, s1);
    try buf.push_str_grow(alloc, p2);
    _ = try diags.emit_error_bytes(alloc, code, sp, buf.as_bytes());
    buf.destroy(alloc);
    return;
}

pub fn resolve_path_segments(
    alloc: *mut AllocCap,
    segments: *[ast.IdentSpan],
    mod_id: u32,
    prog: *mut resolve.ResolvedProgram,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
) -> ?PathTarget ! OutOfMemory {
    if segments.len == 0_usize {
        return null;
    }
    let first = segments[0_usize];
    let first_ent = prog.lookup_in_module(mod_id, first.sym) orelse {
        try emit_diag_fmt2(alloc, diags, diag.E0132, first.span, "unresolved name `", interner.get(first.sym), "`");
        return null;
    };
    prog.mark_module_binding_used(mod_id, first.sym);

    var cur_kind = first_ent.kind;
    var cur_id = first_ent.target_id;
    var i: usize = 1_usize;
    while i < segments.len {
        let seg = segments[i];
        if cur_kind == .Module {
            let target_mod = cur_id;
            if let exp = prog.lookup_export(target_mod, seg.sym) {
                if exp.kind == .Def {
                    prog.mark_def_used(exp.target_id);
                }
                cur_kind = exp.kind;
                cur_id = exp.target_id;
            } else {
                var m_sym = span.SYM_EMPTY;
                if let tm = prog.get_module(target_mod) {
                    m_sym = tm.path_sym;
                }
                if module_scope_contains(prog, target_mod, seg.sym) {
                    try emit_diag_fmt3(
                        alloc, diags, diag.E0133, seg.span,
                        "symbol `", interner.get(seg.sym),
                        "` in module `", interner.get(m_sym), "` is private",
                    );
                } else {
                    try emit_diag_fmt3(
                        alloc, diags, diag.E0132, seg.span,
                        "symbol `", interner.get(seg.sym),
                        "` not found in module `", interner.get(m_sym), "`",
                    );
                }
                return null;
            }
        } else {
            try emit_diag_fmt2(alloc, diags, diag.E0132, seg.span, "`", interner.get(seg.sym), "` is not a module");
            return null;
        }
        i = i +% 1_usize;
    }
    return PathTarget.{ kind: cur_kind, target_id: cur_id };
}

enum IfaceTargetKind : u8 {
    User = 0,
    BuiltinOrd = 1,
    BuiltinEq = 2,
}

struct IfaceTarget {
    kind: IfaceTargetKind;
    def_id: u32;
}

fn resolve_iface_target_only(
    alloc: *mut AllocCap,
    type_id: u32,
    mod_id: u32,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
) -> ?IfaceTarget ! OutOfMemory {
    let te = arena.get_type(type_id) orelse {
        return null;
    };
    if te.kind != .Path {
        return null;
    }
    let segs = arena.idents_range(te.list);
    let target = try resolve_path_segments(alloc, segs, mod_id, prog, interner, diags) orelse {
        return null;
    };
    if target.kind == .Def {
        if let d = prog.get_def(target.target_id) {
            if d.kind == .Iface {
                return IfaceTarget.{ kind: .User, def_id: target.target_id };
            }
        }
    } else if target.kind == .Builtin {
        let info = resolve.decode_builtin(target.target_id);
        if info.kind == .OrdIface {
            return IfaceTarget.{ kind: .BuiltinOrd, def_id: 0_u32 };
        }
        if info.kind == .EqIface {
            return IfaceTarget.{ kind: .BuiltinEq, def_id: 0_u32 };
        }
    }
    _ = try diags.emit_error(alloc, diag.E0501, te.span, "expected an interface name");
    return null;
}

struct ResolvedBounds {
    bounds: ast.IdRange;
    builtin_ord: bool;
    builtin_eq: bool;
}

fn resolve_generic_param_bounds(
    alloc: *mut AllocCap,
    bounds_range: ast.IdRange,
    mod_id: u32,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
) -> ResolvedBounds ! OutOfMemory {
    let b_ids = arena.type_list_range(bounds_range);
    var local_bounds = try col.DynBuf.[u32].init(alloc, b_ids.len +% 1_usize);
    errdefer local_bounds.destroy(alloc);
    var builtin_ord = false;
    var builtin_eq = false;
    var bi: usize = 0_usize;
    while bi < b_ids.len {
        if let it = try resolve_iface_target_only(alloc, b_ids[bi], mod_id, arena, prog, interner, diags) {
            match it.kind {
                .User => { try local_bounds.push(alloc, it.def_id); }
                .BuiltinOrd => { builtin_ord = true; }
                .BuiltinEq => { builtin_eq = true; }
            }
        }
        bi = bi +% 1_usize;
    }
    let b_start = env.sigs.generic_bounds.len().trunc.[u32]();
    try env.sigs.generic_bounds.push_slice(alloc, local_bounds.as_slice());
    let b_range = ast.range_new(b_start, local_bounds.len().trunc.[u32]());
    local_bounds.destroy(alloc);
    return ResolvedBounds.{ bounds: b_range, builtin_ord: builtin_ord, builtin_eq: builtin_eq };
}

@recursive
pub fn resolve_generic_params(
    alloc: *mut AllocCap,
    gens_range: ast.IdRange,
    parent_generics: ast.IdRange,
    mod_id: u32,
    ctx: *mut GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> ast.IdRange ! OutOfMemory {
    let ast_gens = arena.generic_params_range(gens_range);
    let total_est = parent_generics.len.widen.[usize]() +% ast_gens.len +% 1_usize;
    var local_gens = try col.DynBuf.[GenericParamMeta].init(alloc, total_est);
    errdefer local_gens.destroy(alloc);

    if parent_generics.len > 0_u32 {
        try local_gens.push_slice(alloc, env.generic_params_range(parent_generics));
    }

    var i: usize = 0_usize;
    while i < ast_gens.len {
        let g = ast_gens[i];
        let idx = ctx.params.len().trunc.[u32]();
        try ctx.params.push(
            alloc,
            GenericCtxParam.{ name: g.name.sym, idx: idx, is_comptime: g.is_comptime },
        );
        var has_ct_ty = false;
        var ct_ty = TY_ERROR;
        if g.comptime_ty != ast.NONE_ID {
            has_ct_ty = true;
            ct_ty = try resolve_type_expr(alloc, g.comptime_ty, mod_id, ctx, arena, prog, env, interner, diags);
        }
        let rb = try resolve_generic_param_bounds(alloc, g.bounds, mod_id, arena, prog, env, interner, diags);
        try local_gens.push(
            alloc,
            GenericParamMeta.{
                name: g.name.sym,
                is_comptime: g.is_comptime,
                has_comptime_ty: has_ct_ty,
                comptime_ty: ct_ty,
                bounds: rb.bounds,
                builtin_ord: rb.builtin_ord,
                builtin_eq: rb.builtin_eq,
            },
        );
        i = i +% 1_usize;
    }

    let g_start = env.sigs.generic_params.len().trunc.[u32]();
    try env.sigs.generic_params.push_slice(alloc, local_gens.as_slice());
    let g_range = ast.range_new(g_start, local_gens.len().trunc.[u32]());
    local_gens.destroy(alloc);
    return g_range;
}

@recursive
fn resolve_generic_args_into(
    alloc: *mut AllocCap,
    args_range: ast.IdRange,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    out: *mut col.DynBuf[GenericVal],
) -> !OutOfMemory {
    let args = arena.generic_args_range(args_range);
    var i: usize = 0_usize;
    while i < args.len {
        let a = args[i];
        match a.kind {
            .Type => {
                let ty = try resolve_type_expr(alloc, a.node_id, mod_id, ctx, arena, prog, env, interner, diags);
                try out.push(alloc, gval_ty(ty));
            }
            .TypeOrConst => {
                let segs = arena.idents_range(a.segs);
                if segs.len == 1_usize {
                    if let val = ctx.find_comptime_val(segs[0_usize].sym) {
                        try out.push(alloc, gval_int(val));
                        i = i +% 1_usize;
                        continue;
                    }
                }
                let ty = try resolve_type_path(
                    alloc, a.segs, ast.range_empty(), a.span, mod_id, ctx, arena, prog, env, interner, diags,
                );
                try out.push(alloc, gval_ty(ty));
            }
            .Expr => {
                var pushed = false;
                if let expr = arena.get_expr(a.node_id) {
                    if expr.kind == .EnumLit {
                        try out.push(alloc, gval_variant(expr.ident.sym));
                        pushed = true;
                    }
                }
                if !pushed {
                    if let n = try eval_const_int(alloc, a.node_id, mod_id, ctx, arena, prog, env, interner, diags) {
                        try out.push(alloc, gval_int(n));
                    } else {
                        try out.push(alloc, gval_int(int_val_zero()));
                    }
                }
            }
        }
        i = i +% 1_usize;
    }
    return;
}

@recursive
fn resolve_builtin_vec_type(
    alloc: *mut AllocCap,
    generics_range: ast.IdRange,
    sp: span.Span,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> TyId ! OutOfMemory {
    let args = arena.generic_args_range(generics_range);
    if args.len != 2_usize {
        _ = try diags.emit_error(
            alloc, diag.E0230, sp, "`vec[T, N]` expects 2 arguments: scalar element type and lane count",
        );
        return TY_ERROR;
    }
    let a0 = args[0_usize];
    var elem = TY_ERROR;
    if a0.kind == .Type {
        elem = try resolve_type_expr(alloc, a0.node_id, mod_id, ctx, arena, prog, env, interner, diags);
    } else if a0.kind == .TypeOrConst {
        elem = try resolve_type_path(
            alloc, a0.segs, ast.range_empty(), a0.span, mod_id, ctx, arena, prog, env, interner, diags,
        );
    } else {
        _ = try diags.emit_error(alloc, diag.E0230, a0.span, "expected element type for `vec`");
    }
    if elem != TY_ERROR && !env.is_numeric(elem) && elem != TY_BOOL {
        _ = try diags.emit_error(alloc, diag.E0230, a0.span, "`vec` element type must be a scalar number or `bool`");
    }
    let a1 = args[1_usize];
    var have_len = false;
    var len_iv = int_val_zero();
    if a1.kind == .Expr {
        if let v = try eval_const_int(alloc, a1.node_id, mod_id, ctx, arena, prog, env, interner, diags) {
            have_len = true;
            len_iv = v;
        }
    } else if a1.kind == .TypeOrConst {
        let segs = arena.idents_range(a1.segs);
        if segs.len == 1_usize {
            if let v = ctx.find_comptime_val(segs[0_usize].sym) {
                have_len = true;
                len_iv = v;
            }
        }
    }
    var lane_count: u8 = 4_u8;
    var valid_len = false;
    if have_len {
        if let lu = int_val_to_u64(len_iv) {
            if lu >= 2_u64 && lu <= 64_u64 && (lu & (lu -% 1_u64)) == 0_u64 {
                lane_count = lu.trunc.[u8]();
                valid_len = true;
            }
        }
    }
    if !valid_len {
        _ = try diags.emit_error(
            alloc, diag.E0230, a1.span, "`vec[T, N]` lane count `N` must be a power of 2 in `2..=64`",
        );
    }
    return try env.intern_vec(alloc, elem, lane_count);
}

@recursive
fn resolve_builtin_type(
    alloc: *mut AllocCap,
    builtin_id: u32,
    generics_range: ast.IdRange,
    sp: span.Span,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> TyId ! OutOfMemory {
    let info = resolve.decode_builtin(builtin_id);
    match info.kind {
        .Prim => { return try prim_to_ty_id_in_env(alloc, info.prim, info.prim_bits, env); }
        .SimdAlias => {
            let elem = try prim_to_ty_id_in_env(alloc, info.prim, info.prim_bits, env);
            return try env.intern_vec(alloc, elem, info.lanes);
        }
        .VecType => {
            return try resolve_builtin_vec_type(
                alloc, generics_range, sp, mod_id, ctx, arena, prog, env, interner, diags,
            );
        }
        .ArithError => { return TY_ARITH_ERROR; }
        .BoundsError => { return TY_BOUNDS_ERROR; }
        .Utf8Error => { return TY_UTF8_ERROR; }
        .OutOfMemory => { return TY_OUT_OF_MEMORY; }
        .MemError => { return TY_MEM_ERROR; }
        .StaleId => { return TY_STALE_ID; }
        .IoError => { return TY_IO_ERROR; }
        .Ordering => { return TY_ORDERING; }
        .RawPtr => {
            if let m = prog.get_module(mod_id) {
                if m.profile == .Safe {
                    _ = try diags.emit_error(
                        alloc,
                        diag.E0111,
                        sp,
                        "ZM-11: raw pointers (`rawptr`/`rawptr_mut`) are forbidden outside `.hal.eon` modules",
                    );
                }
            }
            var gargs = try col.DynBuf.[GenericVal].init(alloc, 2_usize);
            errdefer gargs.destroy(alloc);
            try resolve_generic_args_into(
                alloc, generics_range, mod_id, ctx, arena, prog, env, interner, diags, &mut gargs,
            );
            let gs = gargs.as_slice();
            var inner = TY_ERROR;
            if gs.len > 0_usize && gs[0_usize].kind == .Ty {
                inner = gs[0_usize].id;
            } else {
                _ = try diags.emit_error(alloc, diag.E0230, sp, "expected element type in `rawptr[T]`");
            }
            let res = try env.intern_raw_ptr(alloc, info.is_mut, inner);
            gargs.destroy(alloc);
            return res;
        }
        .IdBrand => {
            let args = arena.generic_args_range(generics_range);
            if args.len != 1_usize {
                _ = try diags.emit_error(alloc, diag.E0230, sp, "`Id[pool]` expects 1 pool brand argument");
                return TY_ERROR;
            }
            let a0 = args[0_usize];
            var brand_sym = ast.NONE_ID;
            if a0.kind == .TypeOrConst {
                let segs = arena.idents_range(a0.segs);
                if segs.len == 1_usize {
                    brand_sym = segs[0_usize].sym;
                }
            } else if a0.kind == .Expr {
                if let e = arena.get_expr(a0.node_id) {
                    if e.kind == .Ident {
                        brand_sym = e.a;
                    }
                }
            } else if a0.kind == .Type {
                if let t = arena.get_type(a0.node_id) {
                    if t.kind == .Path {
                        let segs = arena.idents_range(t.list);
                        if segs.len == 1_usize {
                            brand_sym = segs[0_usize].sym;
                        }
                    }
                }
            }
            if brand_sym == ast.NONE_ID {
                _ = try diags.emit_error(alloc, diag.E0330, a0.span, "`Id[p]` brand must name a pool variable or parameter");
                return TY_ERROR;
            }
            let gv: [1]GenericVal = [gval_variant(brand_sym)];
            return try env.intern_builtin(alloc, .IdBrand, &gv);
        }
        _ => {
            return try resolve_builtin_generic_type(
                alloc, info.kind, generics_range, sp, mod_id, ctx, arena, prog, env, interner, diags,
            );
        }
    }
}

@recursive
fn resolve_builtin_generic_type(
    alloc: *mut AllocCap,
    bk: resolve.BuiltinKind,
    generics_range: ast.IdRange,
    sp: span.Span,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> TyId ! OutOfMemory {
    var gargs = try col.DynBuf.[GenericVal].init(alloc, generics_range.len.widen.[usize]() +% 1_usize);
    errdefer gargs.destroy(alloc);
    try resolve_generic_args_into(
        alloc, generics_range, mod_id, ctx, arena, prog, env, interner, diags, &mut gargs,
    );
    let gs = gargs.as_slice();
    if bk == .Buf && gs.len > 0_usize && gs[0_usize].kind == .Ty {
        let elem = gs[0_usize].id;
        if env.is_linear(elem) {
            _ = try diags.emit_error(
                alloc, diag.E0326, sp, "linear element type cannot be stored in `Buf[T]`; use `LinearBuf[T]` with `.drain()`",
            );
        } else if env.contains_second_class_ref(elem) {
            _ = try diags.emit_error(
                alloc, diag.E0310, sp, "second-class reference or closure cannot be stored in `Buf[T]`",
            );
        } else if env.contains_borrowing_value(elem) {
            _ = try diags.emit_error(alloc, diag.E0311, sp, "borrowing value cannot be stored in `Buf[T]`");
        }
    } else if bk == .Atomic && gs.len > 0_usize && gs[0_usize].kind == .Ty {
        let elem = gs[0_usize].id;
        let en = env.get(elem);
        var lock_free = en.kind == .Bool
            || en.kind == .PhysAddr
            || en.kind == .VirtAddr
            || en.kind == .GenericParam
            || en.kind == .Error;
        if en.kind == .Int {
            let b = if en.flag1 { 64_u8 } else { en.u8_val };
            lock_free = b == 8_u8 || b == 16_u8 || b == 32_u8 || b == 64_u8;
        }
        if !lock_free {
            var msg = try str.StrBuf.init(alloc, 128_usize);
            errdefer msg.destroy(alloc);
            try msg.push_str_grow(alloc, "`Atomic[");
            try env.format_ty_short(alloc, elem, interner, &mut msg);
            try msg.push_str_grow(
                alloc,
                "]` is not hardware lock-free (allowed: bool, u8..u64, usize, i8..i64, isize, PhysAddr, VirtAddr)",
            );
            _ = try diags.emit_error_bytes(alloc, diag.E0610, sp, msg.as_bytes());
            msg.destroy(alloc);
        }
    }
    let res = try env.intern_builtin(alloc, bk, gargs.as_slice());
    gargs.destroy(alloc);
    return res;
}

@recursive
fn resolve_type_path(
    alloc: *mut AllocCap,
    segs_range: ast.IdRange,
    gens_range: ast.IdRange,
    sp: span.Span,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> TyId ! OutOfMemory {
    let segs = arena.idents_range(segs_range);
    if segs.len == 1_usize {
        let seg = segs[0_usize];
        if let gp = ctx.find_param(seg.sym) {
            return try env.intern_generic_param(alloc, gp.idx, seg.sym, gp.is_comptime);
        }
    }
    let target = try resolve_path_segments(alloc, segs, mod_id, prog, interner, diags) orelse {
        return TY_ERROR;
    };
    match target.kind {
        .Builtin => {
            return try resolve_builtin_type(
                alloc, target.target_id, gens_range, sp, mod_id, ctx, arena, prog, env, interner, diags,
            );
        }
        .Def => {
            let d = target.target_id;
            try ensure_def_resolved(alloc, d, arena, prog, env, interner, diags);
            var gargs = try col.DynBuf.[GenericVal].init(alloc, gens_range.len.widen.[usize]() +% 1_usize);
            errdefer gargs.destroy(alloc);
            try resolve_generic_args_into(
                alloc, gens_range, mod_id, ctx, arena, prog, env, interner, diags, &mut gargs,
            );
            var def_kind: resolve.TopDefKind = .Fn;
            var def_name = span.SYM_EMPTY;
            if let td = prog.get_def(d) {
                def_kind = td.kind;
                def_name = td.name;
            }
            var res = TY_ERROR;
            match def_kind {
                .Struct => { res = try env.intern_struct(alloc, d, gargs.as_slice()); }
                .ExternStruct => { res = try env.intern_struct(alloc, d, gargs.as_slice()); }
                .Pool => { res = try env.intern_pool(alloc, d, gargs.as_slice()); }
                .Enum => { res = try env.intern_enum(alloc, d); }
                .Union => { res = try env.intern_union(alloc, d, gargs.as_slice()); }
                .ExternUnion => { res = try env.intern_union(alloc, d, gargs.as_slice()); }
                .Bitfield => { res = try env.intern_bitfield(alloc, d); }
                .Error => { res = try env.intern_error_set(alloc, err_src_user(d)); }
                .TypeAlias => {
                    var alias_ty = TY_ERROR;
                    var alias_gen_len: u32 = 0_u32;
                    if let ta = env.get_type_alias(d) {
                        alias_ty = ta.ty;
                        alias_gen_len = ta.generics.len;
                    }
                    if alias_gen_len > 0_u32 && gargs.len() > 0_usize {
                        res = try env.subst_ty_intern(alloc, alias_ty, gargs.as_slice());
                    } else {
                        res = alias_ty;
                    }
                }
                .Iface => {
                    _ = try diags.emit_error(
                        alloc,
                        diag.E0230,
                        sp,
                        "interface cannot be used directly as a value type; use `dyn Interface` or a generic bound",
                    );
                }
                _ => {
                    try emit_diag_fmt2(alloc, diags, diag.E0230, sp, "`", interner.get(def_name), "` is not a type");
                }
            }
            gargs.destroy(alloc);
            return res;
        }
        .Module => {
            _ = try diags.emit_error(alloc, diag.E0230, sp, "expected type, found module");
            return TY_ERROR;
        }
    }
}

@recursive
fn resolve_type_dyn(
    alloc: *mut AllocCap,
    te: *ast.TypeNode,
    mod_id: u32,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> TyId ! OutOfMemory {
    let segs = arena.idents_range(te.list);
    let target = try resolve_path_segments(alloc, segs, mod_id, prog, interner, diags) orelse {
        return TY_ERROR;
    };
    if target.kind != .Def {
        _ = try diags.emit_error(alloc, diag.E0501, te.span, "`dyn` requires an interface name");
        return TY_ERROR;
    }
    let d = target.target_id;
    var is_iface = false;
    var iface_name = span.SYM_EMPTY;
    if let td = prog.get_def(d) {
        is_iface = td.kind == .Iface;
        iface_name = td.name;
    }
    if !is_iface {
        _ = try diags.emit_error(alloc, diag.E0501, te.span, "`dyn` requires an interface name");
        return TY_ERROR;
    }
    try ensure_def_resolved(alloc, d, arena, prog, env, interner, diags);
    let dyn_ty = try env.intern_dyn(alloc, d);
    if let im = env.get_iface(d) {
        let ms = env.iface_methods_range(im.methods);
        var mi: usize = 0_usize;
        while mi < ms.len {
            let m = ms[mi];
            let ps = env.params_range(m.params);
            var self_ok = false;
            if ps.len > 0_usize {
                let p0 = ps[0_usize];
                if p0.is_self && env.get(p0.ty).kind == .Borrow {
                    self_ok = true;
                }
            }
            if m.generics.len > 0_u32 {
                try emit_diag_fmt3(
                    alloc, diags, diag.E0512, te.span,
                    "interface `", interner.get(iface_name),
                    "` is not dyn-compatible: method `", interner.get(m.name), "` has generic parameters",
                );
            } else if m.ret == dyn_ty {
                try emit_diag_fmt3(
                    alloc, diags, diag.E0512, te.span,
                    "interface `", interner.get(iface_name),
                    "` is not dyn-compatible: method `", interner.get(m.name), "` returns `Self` by value",
                );
            } else if !self_ok {
                try emit_diag_fmt3(
                    alloc, diags, diag.E0512, te.span,
                    "interface `", interner.get(iface_name),
                    "` is not dyn-compatible: method `", interner.get(m.name), "` must take `*Self` or `*mut Self`",
                );
            }
            mi = mi +% 1_usize;
        }
    }
    return dyn_ty;
}

@recursive
fn resolve_type_compound(
    alloc: *mut AllocCap,
    te: *ast.TypeNode,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> TyId ! OutOfMemory {
    match te.kind {
        .Array => {
            let elem_ty = try resolve_type_expr(alloc, te.primary, mod_id, ctx, arena, prog, env, interner, diags);
            let elem_sp = if let et = arena.get_type(te.primary) { et.span } else { te.span };
            if env.contains_second_class_ref(elem_ty) {
                _ = try diags.emit_error(
                    alloc, diag.E0310, elem_sp, "second-class reference or closure cannot be stored inside an array `[N]T`",
                );
            } else if env.contains_borrowing_value(elem_ty) {
                _ = try diags.emit_error(
                    alloc, diag.E0311, elem_sp, "borrowing value cannot be stored inside an array `[N]T`",
                );
            } else if env.contains_id_brand(elem_ty) {
                _ = try diags.emit_error(
                    alloc, diag.E0332, elem_sp, "branded `Id[p]` cannot be stored inside an array `[N]T`",
                );
            }
            let len_sp = if let le = arena.get_expr(te.aux) { le.span } else { te.span };
            var len_u64: u64 = 0_u64;
            var len_ok = false;
            if let iv = try eval_const_int(alloc, te.aux, mod_id, ctx, arena, prog, env, interner, diags) {
                if let lu = int_val_to_u64(iv) {
                    len_u64 = lu;
                    len_ok = true;
                }
            }
            if !len_ok {
                _ = try diags.emit_error(
                    alloc, diag.E0230, len_sp, "fixed array length must be a non-negative constant integer",
                );
            }
            return try env.intern_array(alloc, len_u64, elem_ty);
        }
        .Tuple => {
            let elems = arena.type_list_range(te.list);
            var ts = try col.DynBuf.[TyId].init(alloc, elems.len +% 1_usize);
            errdefer ts.destroy(alloc);
            var i: usize = 0_usize;
            while i < elems.len {
                let t = try resolve_type_expr(alloc, elems[i], mod_id, ctx, arena, prog, env, interner, diags);
                try ts.push(alloc, t);
                i = i +% 1_usize;
            }
            let res = try env.intern_tuple(alloc, ts.as_slice());
            ts.destroy(alloc);
            return res;
        }
        .FnPtr => {
            let ps_ids = arena.type_list_range(te.list);
            var ps = try col.DynBuf.[TyId].init(alloc, ps_ids.len +% 1_usize);
            errdefer ps.destroy(alloc);
            var i: usize = 0_usize;
            while i < ps_ids.len {
                let t = try resolve_type_expr(alloc, ps_ids[i], mod_id, ctx, arena, prog, env, interner, diags);
                try ps.push(alloc, t);
                i = i +% 1_usize;
            }
            let ret = if te.primary != ast.NONE_ID {
                try resolve_type_expr(alloc, te.primary, mod_id, ctx, arena, prog, env, interner, diags)
            } else {
                TY_VOID
            };
            let res = try env.intern_fn_ptr(alloc, ps.as_slice(), ret);
            ps.destroy(alloc);
            return res;
        }
        .InlineStruct => {
            let f_nodes = arena.fields_range(te.list);
            var fs = try col.DynBuf.[AnonField].init(alloc, f_nodes.len +% 1_usize);
            errdefer fs.destroy(alloc);
            var i: usize = 0_usize;
            while i < f_nodes.len {
                let f = f_nodes[i];
                let ft = try resolve_type_expr(alloc, f.ty, mod_id, ctx, arena, prog, env, interner, diags);
                let fsp = if let ftn = arena.get_type(f.ty) { ftn.span } else { f.span };
                try validate_aggregate_field_ty(alloc, env, ft, fsp, "inline struct field", diags);
                try fs.push(alloc, AnonField.{ name: f.name.sym, ty: ft });
                i = i +% 1_usize;
            }
            let res = try env.intern_anon_struct(alloc, fs.as_slice());
            fs.destroy(alloc);
            return res;
        }
        .ErrorUnion => {
            let ok_ty = if te.primary != ast.NONE_ID {
                try resolve_type_expr(alloc, te.primary, mod_id, ctx, arena, prog, env, interner, diags)
            } else {
                TY_VOID
            };
            let err_ids = arena.type_list_range(te.list);
            var srcs = try col.DynBuf.[ErrorSource].init(alloc, err_ids.len +% 1_usize);
            errdefer srcs.destroy(alloc);
            var i: usize = 0_usize;
            while i < err_ids.len {
                let ety = try resolve_type_expr(alloc, err_ids[i], mod_id, ctx, arena, prog, env, interner, diags);
                let en = env.get(ety);
                if en.kind == .ErrorSet {
                    try srcs.push(alloc, node_error_source(&en));
                } else if en.kind != .Error {
                    let esp = if let etn = arena.get_type(err_ids[i]) { etn.span } else { te.span };
                    _ = try diags.emit_error(alloc, diag.E0230, esp, "right side of `!` must be an `error` set");
                }
                i = i +% 1_usize;
            }
            let res = try env.intern_error_union(alloc, ok_ty, srcs.as_slice());
            srcs.destroy(alloc);
            return res;
        }
        _ => { return TY_ERROR; }
    }
}

@recursive
pub fn resolve_type_expr(
    alloc: *mut AllocCap,
    type_id: u32,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> TyId ! OutOfMemory {
    let te = arena.get_type(type_id) orelse {
        return TY_ERROR;
    };
    match te.kind {
        .Void => { return TY_VOID; }
        .Never => { return TY_NEVER; }
        .TypeType => { return TY_TYPE_TYPE; }
        .SelfType => {
            if ctx.has_self_ty {
                return ctx.self_ty;
            }
            _ = try diags.emit_error(
                alloc, diag.E0230, te.span, "`Self` is not valid outside an `impl`, `iface`, or `pool`",
            );
            return TY_ERROR;
        }
        .Inferred => { return TY_ERROR; }
        .Error => { return TY_ERROR; }
        .Optional => {
            let inner = try resolve_type_expr(alloc, te.primary, mod_id, ctx, arena, prog, env, interner, diags);
            return try env.intern_optional(alloc, inner);
        }
        .Borrow => {
            match te.borrow_target {
                .Str => { return try env.intern_borrow(alloc, te.is_mut, .Str, TY_VOID); }
                .Slice => {
                    let inner = try resolve_type_expr(alloc, te.primary, mod_id, ctx, arena, prog, env, interner, diags);
                    return try env.intern_borrow(alloc, te.is_mut, .Slice, inner);
                }
                .Single => {
                    let inner = try resolve_type_expr(alloc, te.primary, mod_id, ctx, arena, prog, env, interner, diags);
                    return try env.intern_borrow(alloc, te.is_mut, .Single, inner);
                }
            }
        }
        .Dyn => {
            return try resolve_type_dyn(alloc, te, mod_id, arena, prog, env, interner, diags);
        }
        .Path => {
            return try resolve_type_path(
                alloc, te.list, te.list2, te.span, mod_id, ctx, arena, prog, env, interner, diags,
            );
        }
        _ => {
            return try resolve_type_compound(alloc, te, mod_id, ctx, arena, prog, env, interner, diags);
        }
    }
    return TY_ERROR;
}

// ===========================================================================
// Section 11: Definition & Signature Builders (`build_type_env`)
// ===========================================================================

fn validate_view_struct_field_ty(
    alloc: *mut AllocCap,
    env: *TypeEnv,
    ty: TyId,
    sp: span.Span,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    if env.contains_type_type(ty) {
        _ = try diags.emit_error(
            alloc, diag.E0210, sp, "comptime `type` cannot be stored in a view struct field",
        );
    } else if env.contains_id_brand(ty) {
        _ = try diags.emit_error(
            alloc, diag.E0332, sp, "branded `Id[p]` cannot be stored in a view struct field; use `GenId[T]`",
        );
    }
    return;
}

fn validate_aggregate_field_ty(
    alloc: *mut AllocCap,
    env: *TypeEnv,
    ty: TyId,
    sp: span.Span,
    where_label: *str,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    if env.contains_type_type(ty) {
        try emit_diag_fmt2(
            alloc, diags, diag.E0210, sp, "comptime `type` cannot be stored in a ", where_label.as_bytes(), "",
        );
    } else if env.contains_second_class_ref(ty) {
        try emit_diag_fmt2(
            alloc,
            diags,
            diag.E0310,
            sp,
            "second-class reference or closure cannot be stored in a ",
            where_label.as_bytes(),
            "",
        );
    } else if env.contains_borrowing_value(ty) {
        try emit_diag_fmt2(
            alloc,
            diags,
            diag.E0311,
            sp,
            "borrowing value (`ArenaPool` / `ArenaStr`) cannot be stored in a ",
            where_label.as_bytes(),
            "",
        );
    } else if env.contains_id_brand(ty) {
        try emit_diag_fmt2(
            alloc,
            diags,
            diag.E0332,
            sp,
            "branded `Id[p]` cannot be stored in a ",
            where_label.as_bytes(),
            "; use `Link[Self]` inside own pool or `GenId[T]`",
        );
    }
    return;
}

fn compute_struct_layout(
    alloc: *mut AllocCap,
    fields: *mut [FieldMeta],
    mode: StructLayoutMode,
    is_packed: bool,
    has_explicit_align: bool,
    explicit_align: u64,
    env: *TypeEnv,
) -> EonLayout ! OutOfMemory {
    var order = try col.DynBuf.[usize].init(alloc, fields.len +% 1_usize);
    errdefer order.destroy(alloc);
    var oi: usize = 0_usize;
    while oi < fields.len {
        try order.push(alloc, oi);
        oi = oi +% 1_usize;
    }

    var any_explicit_offset = false;
    var eoi: usize = 0_usize;
    while eoi < fields.len {
        if fields[eoi].has_explicit_offset {
            any_explicit_offset = true;
            break;
        }
        eoi = eoi +% 1_usize;
    }

    if mode == .Eon && !is_packed && !any_explicit_offset && order.len() > 1_usize {
        let ord_mut = order.as_mut_slice();
        var i: usize = 1_usize;
        while i < ord_mut.len {
            let cur = ord_mut[i];
            let cur_a = if cur < fields.len { env.eon_layout(fields[cur].ty).align } else { 1_u64 };
            var j = i;
            while j > 0_usize {
                let prev = ord_mut[j - 1_usize];
                let prev_a = if prev < fields.len { env.eon_layout(fields[prev].ty).align } else { 1_u64 };
                if prev_a > cur_a || (prev_a == cur_a && prev < cur) {
                    break;
                }
                ord_mut[j] = prev;
                j = j - 1_usize;
            }
            ord_mut[j] = cur;
            i = i +% 1_usize;
        }
    }

    var offset: u64 = 0_u64;
    var max_align: u64 = 1_u64;
    var has_niche = false;
    let ord = order.as_slice();
    var k: usize = 0_usize;
    while k < ord.len {
        let idx = ord[k];
        if idx < fields.len {
            let fty = fields[idx].ty;
            let fl = env.eon_layout(fty);
            var field_align = fl.align;
            if is_packed {
                field_align = 1_u64;
            } else if mode == .Std430 {
                let fn_node = env.get(fty);
                if fn_node.kind == .Vec && fn_node.u8_val == 3_u8 {
                    field_align = env.eon_layout(fn_node.primary).size *% 4_u64;
                }
            }
            if fields[idx].has_explicit_offset {
                let f_off = fields[idx].offset;
                let end_off = f_off +% fl.size;
                if end_off > offset {
                    offset = end_off;
                }
            } else {
                offset = align_up_u64(offset, field_align);
                fields[idx].offset = offset;
                offset = offset +% fl.size;
            }
            fields[idx].misaligned_in_packed = is_packed && fl.align > 1_u64;
            max_align = max_u64(max_align, field_align);
            if fl.has_niche {
                has_niche = true;
            }
        }
        k = k +% 1_usize;
    }

    order.destroy(alloc);
    let final_align = if is_packed {
        if has_explicit_align { explicit_align } else { 1_u64 }
    } else if has_explicit_align {
        max_u64(explicit_align, max_align)
    } else {
        max_align
    };
    return EonLayout.{
        size: align_up_u64(offset, final_align),
        align: final_align,
        has_niche: has_niche,
    };
}

struct StructAttrsParsed {
    layout_mode: StructLayoutMode;
    is_packed: bool;
    has_explicit_align: bool;
    explicit_align: u64;
}

@recursive
fn parse_struct_attrs(
    alloc: *mut AllocCap,
    attrs_range: ast.IdRange,
    mod_id: u32,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> StructAttrsParsed ! OutOfMemory {
    var res = StructAttrsParsed.{
        layout_mode: .Eon,
        is_packed: false,
        has_explicit_align: false,
        explicit_align: 0_u64,
    };
    let empty_ctx = try GenericCtx.init(alloc);
    errdefer empty_ctx.destroy(alloc);
    let attrs = arena.attrs_range(attrs_range);
    var ai: usize = 0_usize;
    while ai < attrs.len {
        let attr = attrs[ai];
        let aname = interner.get(attr.name.sym);
        if str.bytes_eq(aname, "layout".as_bytes()) {
            let args = arena.attr_args_range(attr.args);
            if args.len > 0_usize {
                let arg = args[0_usize];
                if let expr = arena.get_expr(arg.value) {
                    if expr.kind == .Ident {
                        let mname = interner.get(expr.a);
                        if str.bytes_eq(mname, "eon".as_bytes()) {
                            res.layout_mode = .Eon;
                        } else if str.bytes_eq(mname, "c".as_bytes()) {
                            res.layout_mode = .C;
                        } else if str.bytes_eq(mname, "std430".as_bytes()) {
                            res.layout_mode = .Std430;
                        } else {
                            try emit_diag_fmt2(
                                alloc,
                                diags,
                                diag.E0230,
                                arg.span,
                                "unknown layout mode `",
                                mname,
                                "` (expected `eon`, `c`, or `std430`)",
                            );
                        }
                    }
                }
            }
        } else if str.bytes_eq(aname, "packed".as_bytes()) {
            res.is_packed = true;
            res.layout_mode = .C;
        } else if str.bytes_eq(aname, "align".as_bytes()) {
            let args = arena.attr_args_range(attr.args);
            if args.len > 0_usize {
                let arg = args[0_usize];
                if let iv = try eval_const_int(
                    alloc, arg.value, mod_id, &empty_ctx, arena, prog, env, interner, diags,
                ) {
                    var ok = false;
                    if let vu = int_val_to_u64(iv) {
                        if vu >= 1_u64 && (vu & (vu -% 1_u64)) == 0_u64 {
                            res.has_explicit_align = true;
                            res.explicit_align = vu;
                            ok = true;
                        }
                    }
                    if !ok {
                        _ = try diags.emit_error(
                            alloc, diag.E0230, arg.span, "`@align(N)` requires a power-of-two alignment >= 1",
                        );
                    }
                }
            }
        }
        ai = ai +% 1_usize;
    }
    empty_ctx.destroy(alloc);
    return res;
}

@recursive
fn resolve_struct_def(
    alloc: *mut AllocCap,
    def_id: u32,
    mod_id: u32,
    decl: *ast.DeclNode,
    s: *ast.StructDeclNode,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    let sa = try parse_struct_attrs(alloc, decl.attrs, mod_id, arena, prog, env, interner, diags);
    var ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    let generics = try resolve_generic_params(
        alloc, s.generics, ast.range_empty(), mod_id, &mut ctx, arena, prog, env, interner, diags,
    );

    let ast_fields = arena.fields_range(s.fields);
    var local_fields = try col.DynBuf.[FieldMeta].init(alloc, ast_fields.len +% 1_usize);
    errdefer local_fields.destroy(alloc);
    var any_linear = false;

    var fi: usize = 0_usize;
    while fi < ast_fields.len {
        let f = ast_fields[fi];
        let existing = local_fields.as_slice();
        var dup = false;
        var ei: usize = 0_usize;
        while ei < existing.len {
            if existing[ei].name == f.name.sym {
                dup = true;
                break;
            }
            ei = ei +% 1_usize;
        }
        if dup {
            try emit_diag_fmt2(
                alloc, diags, diag.E0132, f.name.span, "duplicate field `", interner.get(f.name.sym), "` in struct",
            );
        }
        let ty = try resolve_type_expr(alloc, f.ty, mod_id, &ctx, arena, prog, env, interner, diags);
        let fsp = if let ftn = arena.get_type(f.ty) { ftn.span } else { f.span };
        if s.is_view {
            try validate_view_struct_field_ty(alloc, env, ty, fsp, diags);
        } else {
            try validate_aggregate_field_ty(alloc, env, ty, fsp, "struct field", diags);
        }
        if env.is_linear(ty) {
            any_linear = true;
        }
        var f_has_off = false;
        var f_off_val: u64 = 0_u64;
        let fattrs = arena.attrs_range(f.attrs);
        var fai: usize = 0_usize;
        while fai < fattrs.len {
            let fattr = fattrs[fai];
            if str.bytes_eq(interner.get(fattr.name.sym), "offset".as_bytes()) {
                let fargs = arena.attr_args_range(fattr.args);
                if fargs.len > 0_usize {
                    if let iv = try eval_const_int(
                        alloc, fargs[0_usize].value, mod_id, &ctx, arena, prog, env, interner, diags,
                    ) {
                        if let vu = int_val_to_u64(iv) {
                            f_has_off = true;
                            f_off_val = vu;
                        }
                    }
                }
            }
            fai = fai +% 1_usize;
        }
        try local_fields.push(
            alloc,
            FieldMeta.{
                name: f.name.sym,
                span: f.span,
                is_pub: f.is_pub,
                ty: ty,
                has_default: f.default != ast.NONE_ID,
                has_explicit_offset: f_has_off,
                offset: f_off_val,
                misaligned_in_packed: false,
            },
        );
        fi = fi +% 1_usize;
    }

    if any_linear && !s.is_linear {
        try emit_diag_fmt2(
            alloc,
            diags,
            diag.E0322,
            s.name.span,
            "struct `",
            interner.get(s.name.sym),
            "` contains a `linear` field and must be declared as `linear struct`",
        );
    }

    let layout = try compute_struct_layout(
        alloc,
        local_fields.as_mut_slice(),
        sa.layout_mode,
        sa.is_packed,
        sa.has_explicit_align,
        sa.explicit_align,
        env,
    );

    let f_start = env.defs.struct_fields.len().trunc.[u32]();
    try env.defs.struct_fields.push_slice(alloc, local_fields.as_slice());
    let f_range = ast.range_new(f_start, local_fields.len().trunc.[u32]());

    let meta_idx = env.defs.structs.len().trunc.[u32]();
    try env.defs.structs.push(
        alloc,
        StructMeta.{
            def_id: def_id,
            module_id: mod_id,
            is_linear: s.is_linear || any_linear,
            is_view: s.is_view,
            layout_mode: sa.layout_mode,
            is_packed: sa.is_packed,
            has_explicit_align: sa.has_explicit_align,
            explicit_align: sa.explicit_align,
            generics: generics,
            fields: f_range,
            layout: layout,
        },
    );
    try env.index.struct_by_def.insert(alloc, def_id.widen.[u64](), meta_idx);
    local_fields.destroy(alloc);
    ctx.destroy(alloc);
    return;
}

@recursive
fn resolve_extern_agg_def(
    alloc: *mut AllocCap,
    def_id: u32,
    mod_id: u32,
    fields_range: ast.IdRange,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    let ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    let ast_fields = arena.fields_range(fields_range);
    var local_fields = try col.DynBuf.[FieldMeta].init(alloc, ast_fields.len +% 1_usize);
    errdefer local_fields.destroy(alloc);
    var fi: usize = 0_usize;
    while fi < ast_fields.len {
        let f = ast_fields[fi];
        let ty = try resolve_type_expr(alloc, f.ty, mod_id, &ctx, arena, prog, env, interner, diags);
        let fsp = if let ftn = arena.get_type(f.ty) { ftn.span } else { f.span };
        try validate_aggregate_field_ty(alloc, env, ty, fsp, "extern struct field", diags);
        try local_fields.push(
            alloc,
            FieldMeta.{
                name: f.name.sym,
                span: f.span,
                is_pub: true,
                ty: ty,
                has_default: f.default != ast.NONE_ID,
                has_explicit_offset: false,
                offset: 0_u64,
                misaligned_in_packed: false,
            },
        );
        fi = fi +% 1_usize;
    }
    let layout = try compute_struct_layout(
        alloc, local_fields.as_mut_slice(), .C, false, false, 0_u64, env,
    );
    let f_start = env.defs.struct_fields.len().trunc.[u32]();
    try env.defs.struct_fields.push_slice(alloc, local_fields.as_slice());
    let f_range = ast.range_new(f_start, local_fields.len().trunc.[u32]());

    let meta_idx = env.defs.structs.len().trunc.[u32]();
    try env.defs.structs.push(
        alloc,
        StructMeta.{
            def_id: def_id,
            module_id: mod_id,
            is_linear: false,
            is_view: false,
            layout_mode: .C,
            is_packed: false,
            has_explicit_align: false,
            explicit_align: 0_u64,
            generics: ast.range_empty(),
            fields: f_range,
            layout: layout,
        },
    );
    try env.index.struct_by_def.insert(alloc, def_id.widen.[u64](), meta_idx);
    local_fields.destroy(alloc);
    ctx.destroy(alloc);
    return;
}

@recursive
fn resolve_pool_def(
    alloc: *mut AllocCap,
    def_id: u32,
    mod_id: u32,
    p: *ast.StructDeclNode,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    var ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    let generics = try resolve_generic_params(
        alloc, p.generics, ast.range_empty(), mod_id, &mut ctx, arena, prog, env, interner, diags,
    );
    ctx.has_self_ty = true;
    ctx.self_ty = try env.intern_pool_empty(alloc, def_id);

    let ast_fields = arena.fields_range(p.fields);
    var local_cols = try col.DynBuf.[PoolColumnMeta].init(alloc, ast_fields.len +% 1_usize);
    errdefer local_cols.destroy(alloc);
    var fi: usize = 0_usize;
    while fi < ast_fields.len {
        let f = ast_fields[fi];
        let existing = local_cols.as_slice();
        var dup = false;
        var ei: usize = 0_usize;
        while ei < existing.len {
            if existing[ei].name == f.name.sym {
                dup = true;
                break;
            }
            ei = ei +% 1_usize;
        }
        if dup {
            try emit_diag_fmt2(
                alloc, diags, diag.E0132, f.name.span, "duplicate column `", interner.get(f.name.sym), "` in pool",
            );
        }
        let ty = try resolve_type_expr(alloc, f.ty, mod_id, &ctx, arena, prog, env, interner, diags);
        let fsp = if let ftn = arena.get_type(f.ty) { ftn.span } else { f.span };
        try validate_aggregate_field_ty(alloc, env, ty, fsp, "pool column", diags);
        let elem_layout = env.eon_layout(ty);
        try local_cols.push(
            alloc,
            PoolColumnMeta.{
                name: f.name.sym,
                span: f.span,
                is_pub: f.is_pub,
                ty: ty,
                elem_layout: elem_layout,
                col_align: 64_u64,
            },
        );
        fi = fi +% 1_usize;
    }

    let c_start = env.defs.pool_cols.len().trunc.[u32]();
    try env.defs.pool_cols.push_slice(alloc, local_cols.as_slice());
    let c_range = ast.range_new(c_start, local_cols.len().trunc.[u32]());

    let meta_idx = env.defs.pools.len().trunc.[u32]();
    try env.defs.pools.push(
        alloc,
        PoolMeta.{
            def_id: def_id,
            module_id: mod_id,
            generics: generics,
            columns: c_range,
        },
    );
    try env.index.pool_by_def.insert(alloc, def_id.widen.[u64](), meta_idx);
    local_cols.destroy(alloc);
    ctx.destroy(alloc);
    return;
}

fn resolve_enum_repr_ty(
    alloc: *mut AllocCap,
    e: *ast.EnumDeclNode,
    num_vars: usize,
    prog: *resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
) -> TyId ! OutOfMemory {
    if ast.ident_is_some(e.repr_int) {
        if let bid = prog.lookup_prelude(e.repr_int.sym) {
            let info = resolve.decode_builtin(bid);
            if info.kind == .Prim {
                if info.prim == .UInt || info.prim == .IInt || info.prim == .USize || info.prim == .ISize {
                    return try prim_to_ty_id_in_env(alloc, info.prim, info.prim_bits, env);
                }
            }
        }
        try emit_diag_fmt2(
            alloc,
            diags,
            diag.E0230,
            e.repr_int.span,
            "invalid enum representation type `",
            interner.get(e.repr_int.sym),
            "`",
        );
        return TY_U8;
    }
    if num_vars <= 256_usize {
        return TY_U8;
    }
    if num_vars <= 65536_usize {
        return TY_U16;
    }
    return TY_U32;
}

@recursive
fn resolve_enum_def(
    alloc: *mut AllocCap,
    def_id: u32,
    mod_id: u32,
    e: *ast.EnumDeclNode,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    let ast_vars = arena.enum_variants_range(e.variants);
    let repr_ty = try resolve_enum_repr_ty(alloc, e, ast_vars.len, prog, env, interner, diags);
    let b = int_bounds(env.get(repr_ty));
    let min_v = if b.valid { b.min } else { int_val_zero() };
    let max_v = if b.valid { b.max } else { int_val_from_u64(255_u64) };

    let ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    var local_vars = try col.DynBuf.[EnumVariantMeta].init(alloc, ast_vars.len +% 1_usize);
    errdefer local_vars.destroy(alloc);
    var next_val = int_val_zero();
    let one = int_val_from_u64(1_u64);

    var vi: usize = 0_usize;
    while vi < ast_vars.len {
        let v = ast_vars[vi];
        let prev = local_vars.as_slice();
        var dup_name = false;
        var pi: usize = 0_usize;
        while pi < prev.len {
            if prev[pi].name == v.name.sym {
                dup_name = true;
                break;
            }
            pi = pi +% 1_usize;
        }
        if dup_name {
            try emit_diag_fmt2(
                alloc, diags, diag.E0132, v.name.span, "duplicate enum variant `", interner.get(v.name.sym), "`",
            );
        }
        var val = next_val;
        if v.value != ast.NONE_ID {
            if let n = try eval_const_int(alloc, v.value, mod_id, &ctx, arena, prog, env, interner, diags) {
                val = n;
                next_val = int_val_checked_add(n, one) orelse n;
            } else {
                let vsp = if let ve = arena.get_expr(v.value) { ve.span } else { v.span };
                _ = try diags.emit_error(alloc, diag.E0230, vsp, "enum discriminant must be a constant integer");
                next_val = int_val_checked_add(next_val, one) orelse next_val;
            }
        } else {
            next_val = int_val_checked_add(next_val, one) orelse next_val;
        }

        if int_val_cmp(val, min_v) < 0_i32 || int_val_cmp(val, max_v) > 0_i32 {
            var msg = try str.StrBuf.init(alloc, 96_usize);
            errdefer msg.destroy(alloc);
            try msg.push_str_grow(alloc, "enum discriminant `");
            try push_int_val_grow(alloc, val, &mut msg);
            try msg.push_str_grow(alloc, "` out of range for `");
            try env.format_ty_short(alloc, repr_ty, interner, &mut msg);
            try msg.push_byte_grow(alloc, b'`');
            _ = try diags.emit_error_bytes(alloc, diag.E0201, v.span, msg.as_bytes());
            msg.destroy(alloc);
        }

        let prev2 = local_vars.as_slice();
        var dup_val = false;
        var qi: usize = 0_usize;
        while qi < prev2.len {
            if int_val_eq(prev2[qi].val, val) {
                dup_val = true;
                break;
            }
            qi = qi +% 1_usize;
        }
        if dup_val {
            var msg = try str.StrBuf.init(alloc, 64_usize);
            errdefer msg.destroy(alloc);
            try msg.push_str_grow(alloc, "duplicate enum discriminant value `");
            try push_int_val_grow(alloc, val, &mut msg);
            try msg.push_byte_grow(alloc, b'`');
            _ = try diags.emit_error_bytes(alloc, diag.E0230, v.span, msg.as_bytes());
            msg.destroy(alloc);
        }
        try local_vars.push(alloc, EnumVariantMeta.{ name: v.name.sym, val: val });
        vi = vi +% 1_usize;
    }

    var has_niche = true;
    if let diff = int_val_checked_sub(max_v, min_v) {
        if diff.hi == 0_i64 {
            has_niche = local_vars.len().widen.[u64]() <= diff.lo;
        }
    }

    let v_start = env.defs.enum_variants.len().trunc.[u32]();
    try env.defs.enum_variants.push_slice(alloc, local_vars.as_slice());
    let v_range = ast.range_new(v_start, local_vars.len().trunc.[u32]());

    let meta_idx = env.defs.enums.len().trunc.[u32]();
    try env.defs.enums.push(
        alloc,
        EnumMeta.{
            def_id: def_id,
            repr_ty: repr_ty,
            variants: v_range,
            has_niche: has_niche,
        },
    );
    try env.index.enum_by_def.insert(alloc, def_id.widen.[u64](), meta_idx);
    local_vars.destroy(alloc);
    ctx.destroy(alloc);
    return;
}

@recursive
fn resolve_union_def(
    alloc: *mut AllocCap,
    def_id: u32,
    mod_id: u32,
    u: *ast.UnionDeclNode,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    var ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    let generics = try resolve_generic_params(
        alloc, u.generics, ast.range_empty(), mod_id, &mut ctx, arena, prog, env, interner, diags,
    );

    let ast_vars = arena.union_variants_range(u.variants);
    var local_vars = try col.DynBuf.[UnionVariantMeta].init(alloc, ast_vars.len +% 1_usize);
    errdefer local_vars.destroy(alloc);
    var max_payload_size: u64 = 0_u64;
    var max_payload_align: u64 = 1_u64;
    var any_linear = false;

    var vi: usize = 0_usize;
    while vi < ast_vars.len {
        let v = ast_vars[vi];
        let prev = local_vars.as_slice();
        var dup = false;
        var pi: usize = 0_usize;
        while pi < prev.len {
            if prev[pi].name == v.name.sym {
                dup = true;
                break;
            }
            pi = pi +% 1_usize;
        }
        if dup {
            try emit_diag_fmt2(
                alloc, diags, diag.E0132, v.name.span, "duplicate union variant `", interner.get(v.name.sym), "`",
            );
        }
        var has_payload = false;
        var payload_ty = TY_VOID;
        if v.ty != ast.NONE_ID {
            has_payload = true;
            payload_ty = try resolve_type_expr(alloc, v.ty, mod_id, &ctx, arena, prog, env, interner, diags);
            let tsp = if let tn = arena.get_type(v.ty) { tn.span } else { v.span };
            try validate_aggregate_field_ty(alloc, env, payload_ty, tsp, "union variant", diags);
            if env.is_linear(payload_ty) {
                any_linear = true;
            }
            let l = env.eon_layout(payload_ty);
            max_payload_size = max_u64(max_payload_size, l.size);
            max_payload_align = max_u64(max_payload_align, l.align);
        }
        try local_vars.push(
            alloc,
            UnionVariantMeta.{
                name: v.name.sym,
                span: v.span,
                has_payload: has_payload,
                payload: payload_ty,
            },
        );
        vi = vi +% 1_usize;
    }

    if any_linear && !u.is_linear {
        try emit_diag_fmt2(
            alloc,
            diags,
            diag.E0322,
            u.name.span,
            "union `",
            interner.get(u.name.sym),
            "` contains a `linear` variant and must be declared as `linear union`",
        );
    }

    let nvars = local_vars.len();
    let tag_bytes: u64 = if nvars <= 256_usize { 1_u64 } else { 2_u64 };
    let align = max_u64(max_payload_align, tag_bytes);
    let size = align_up_u64(max_payload_size +% tag_bytes, align);
    let has_niche = nvars < 255_usize;

    let v_start = env.defs.union_variants.len().trunc.[u32]();
    try env.defs.union_variants.push_slice(alloc, local_vars.as_slice());
    let v_range = ast.range_new(v_start, local_vars.len().trunc.[u32]());

    let meta_idx = env.defs.unions.len().trunc.[u32]();
    try env.defs.unions.push(
        alloc,
        UnionMeta.{
            def_id: def_id,
            is_linear: u.is_linear || any_linear,
            generics: generics,
            variants: v_range,
            layout: EonLayout.{ size: size, align: align, has_niche: has_niche },
        },
    );
    try env.index.union_by_def.insert(alloc, def_id.widen.[u64](), meta_idx);
    local_vars.destroy(alloc);
    ctx.destroy(alloc);
    return;
}

struct BitfieldState {
    occ_lo: u64;
    occ_hi: u64;
    next_bit: u8;
}

@recursive
fn resolve_bitfield_member(
    alloc: *mut AllocCap,
    m: *ast.BitfieldMemberNode,
    mod_id: u32,
    base_bits: u8,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    st: *mut BitfieldState,
) -> BitfieldMemberMeta ! OutOfMemory {
    var m_ty = TY_U8;
    var m_bits: u8 = 8_u8;
    var m_ok = false;
    if let bid = prog.lookup_prelude(m.ty.sym) {
        let info = resolve.decode_builtin(bid);
        if info.kind == .Prim && info.prim == .UInt {
            m_ty = try prim_to_ty_id_in_env(alloc, info.prim, info.prim_bits, env);
            m_bits = info.prim_bits;
            m_ok = true;
        }
    }
    if !m_ok {
        try emit_diag_fmt2(
            alloc,
            diags,
            diag.E0220,
            m.ty.span,
            "bitfield member type `",
            interner.get(m.ty.sym),
            "` must be an unsigned integer `u1..u128`",
        );
    }

    var lo: u8 = 0_u8;
    var hi: u8 = 0_u8;
    if m.has_bits {
        let lo_opt = try eval_const_int(alloc, m.bits_lo, mod_id, ctx, arena, prog, env, interner, diags);
        let hi_opt = try eval_const_int(alloc, m.bits_hi, mod_id, ctx, arena, prog, env, interner, diags);
        if let lo_iv = lo_opt {
            if let hi_iv = hi_opt {
                let bmax = int_val_from_u64(base_bits.widen.[u64]());
                if int_val_is_neg(lo_iv) || int_val_cmp(hi_iv, lo_iv) <= 0_i32 || int_val_cmp(hi_iv, bmax) > 0_i32 {
                    var msg = try str.StrBuf.init(alloc, 96_usize);
                    errdefer msg.destroy(alloc);
                    try msg.push_str_grow(alloc, "bit range `");
                    try push_int_val_grow(alloc, lo_iv, &mut msg);
                    try msg.push_str_grow(alloc, "..");
                    try push_int_val_grow(alloc, hi_iv, &mut msg);
                    try msg.push_str_grow(alloc, "` is out of bounds for ");
                    try msg.push_u64_grow(alloc, base_bits.widen.[u64]());
                    try msg.push_str_grow(alloc, "-bit backing type");
                    _ = try diags.emit_error_bytes(alloc, diag.E0220, m.span, msg.as_bytes());
                    msg.destroy(alloc);
                } else {
                    lo = lo_iv.lo.trunc.[u8]();
                    hi = hi_iv.lo.trunc.[u8]();
                    if (hi -% lo) != m_bits {
                        _ = try diags.emit_error(
                            alloc, diag.E0220, m.span, "bit range width does not match member type",
                        );
                    }
                }
            } else {
                _ = try diags.emit_error(alloc, diag.E0220, m.span, "`@bits(lo..hi)` bounds must be constant integers");
            }
        } else {
            _ = try diags.emit_error(alloc, diag.E0220, m.span, "`@bits(lo..hi)` bounds must be constant integers");
        }
    } else {
        lo = st.next_bit;
        let raw_hi = lo.widen.[u16]() +% m_bits.widen.[u16]();
        hi = if raw_hi > 255_u16 { 255_u8 } else { raw_hi.trunc.[u8]() };
        if hi > base_bits {
            _ = try diags.emit_error(alloc, diag.E0220, m.span, "bitfield member overflows backing type");
        }
        st.next_bit = hi;
    }

    if hi > lo && hi <= 128_u8 {
        var m_lo: u64 = 0_u64;
        var m_hi: u64 = 0_u64;
        var bit = lo;
        while bit < hi {
            if bit < 64_u8 {
                m_lo = m_lo | (1_u64 <<% bit.widen.[u64]());
            } else {
                m_hi = m_hi | (1_u64 <<% (bit -% 64_u8).widen.[u64]());
            }
            bit = bit +% 1_u8;
        }
        if (st.occ_lo & m_lo) != 0_u64 || (st.occ_hi & m_hi) != 0_u64 {
            var omsg = try str.StrBuf.init(alloc, 96_usize);
            errdefer omsg.destroy(alloc);
            try omsg.push_str_grow(alloc, "bit range `@bits(");
            try omsg.push_u64_grow(alloc, lo.widen.[u64]());
            try omsg.push_str_grow(alloc, "..");
            try omsg.push_u64_grow(alloc, hi.widen.[u64]());
            try omsg.push_str_grow(alloc, ")` overlaps with another bitfield member");
            _ = try diags.emit_error_bytes(alloc, diag.E0220, m.span, omsg.as_bytes());
            omsg.destroy(alloc);
        }
        st.occ_lo = st.occ_lo | m_lo;
        st.occ_hi = st.occ_hi | m_hi;
    }

    return BitfieldMemberMeta.{ name: m.name.sym, span: m.span, ty: m_ty, lo: lo, hi: hi };
}

@recursive
fn resolve_bitfield_def(
    alloc: *mut AllocCap,
    def_id: u32,
    mod_id: u32,
    b: *ast.BitfieldDeclNode,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    var base_ty = TY_U64;
    var base_ok = false;
    if let bid = prog.lookup_prelude(b.base_int.sym) {
        let info = resolve.decode_builtin(bid);
        if info.kind == .Prim && info.prim == .UInt {
            let bits = info.prim_bits;
            if bits == 8_u8 || bits == 16_u8 || bits == 32_u8 || bits == 64_u8 || bits == 128_u8 {
                base_ty = try prim_to_ty_id_in_env(alloc, info.prim, bits, env);
                base_ok = true;
            }
        }
    }
    if !base_ok {
        try emit_diag_fmt2(
            alloc,
            diags,
            diag.E0220,
            b.base_int.span,
            "bitfield backing type `",
            interner.get(b.base_int.sym),
            "` must be an unsigned integer (`u8`, `u16`, `u32`, `u64`, `u128`)",
        );
    }
    let bn = env.get(base_ty);
    let base_bits: u8 = if bn.kind == .Int { bn.u8_val } else { 64_u8 };

    let ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    let ast_members = arena.bitfield_members_range(b.members);
    var local_ms = try col.DynBuf.[BitfieldMemberMeta].init(alloc, ast_members.len +% 1_usize);
    errdefer local_ms.destroy(alloc);
    var st = BitfieldState.{ occ_lo: 0_u64, occ_hi: 0_u64, next_bit: 0_u8 };

    var mi: usize = 0_usize;
    while mi < ast_members.len {
        let m = ast_members[mi];
        let prev = local_ms.as_slice();
        var dup = false;
        var pi: usize = 0_usize;
        while pi < prev.len {
            if prev[pi].name == m.name.sym {
                dup = true;
                break;
            }
            pi = pi +% 1_usize;
        }
        if dup {
            try emit_diag_fmt2(
                alloc, diags, diag.E0132, m.name.span, "duplicate bitfield member `", interner.get(m.name.sym), "`",
            );
        }
        let mm = try resolve_bitfield_member(
            alloc, &m, mod_id, base_bits, &ctx, arena, prog, env, interner, diags, &mut st,
        );
        try local_ms.push(alloc, mm);
        mi = mi +% 1_usize;
    }

    let m_start = env.defs.bitfield_members.len().trunc.[u32]();
    try env.defs.bitfield_members.push_slice(alloc, local_ms.as_slice());
    let m_range = ast.range_new(m_start, local_ms.len().trunc.[u32]());

    let meta_idx = env.defs.bitfields.len().trunc.[u32]();
    try env.defs.bitfields.push(
        alloc,
        BitfieldMeta.{
            def_id: def_id,
            base_ty: base_ty,
            base_bits: base_bits,
            members: m_range,
        },
    );
    try env.index.bitfield_by_def.insert(alloc, def_id.widen.[u64](), meta_idx);
    local_ms.destroy(alloc);
    ctx.destroy(alloc);
    return;
}

fn resolve_error_def(
    alloc: *mut AllocCap,
    def_id: u32,
    er: *ast.ErrorDeclNode,
    arena: *ast.AstArena,
    env: *mut TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    let ast_vars = arena.idents_range(er.variants);
    var local_vars = try col.DynBuf.[u32].init(alloc, ast_vars.len +% 1_usize);
    errdefer local_vars.destroy(alloc);
    var i: usize = 0_usize;
    while i < ast_vars.len {
        let v = ast_vars[i];
        let prev = local_vars.as_slice();
        var dup = false;
        var pi: usize = 0_usize;
        while pi < prev.len {
            if prev[pi] == v.sym {
                dup = true;
                break;
            }
            pi = pi +% 1_usize;
        }
        if dup {
            try emit_diag_fmt2(
                alloc, diags, diag.E0230, v.span, "duplicate error variant `", interner.get(v.sym), "`",
            );
        } else {
            try local_vars.push(alloc, v.sym);
        }
        i = i +% 1_usize;
    }
    let v_start = env.decls.error_variants.len().trunc.[u32]();
    try env.decls.error_variants.push_slice(alloc, local_vars.as_slice());
    let v_range = ast.range_new(v_start, local_vars.len().trunc.[u32]());

    let meta_idx = env.decls.errors.len().trunc.[u32]();
    try env.decls.errors.push(alloc, ErrorMeta.{ def_id: def_id, variants: v_range });
    try env.index.error_by_def.insert(alloc, def_id.widen.[u64](), meta_idx);
    local_vars.destroy(alloc);
    return;
}

@recursive
fn resolve_iface_method(
    alloc: *mut AllocCap,
    m: *ast.IfaceMethodNode,
    mod_id: u32,
    parent_ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> FnSig ! OutOfMemory {
    var m_ctx = try GenericCtx.clone_from(alloc, parent_ctx);
    errdefer m_ctx.destroy(alloc);
    let m_gens = try resolve_generic_params(
        alloc, m.generics, ast.range_empty(), mod_id, &mut m_ctx, arena, prog, env, interner, diags,
    );
    let ast_ps = arena.params_range(m.params);
    var local_ps = try col.DynBuf.[ParamSig].init(alloc, ast_ps.len +% 1_usize);
    errdefer local_ps.destroy(alloc);
    var pi: usize = 0_usize;
    while pi < ast_ps.len {
        let p = ast_ps[pi];
        let pty = try resolve_type_expr(alloc, p.ty, mod_id, &m_ctx, arena, prog, env, interner, diags);
        try local_ps.push(
            alloc,
            ParamSig.{
                name: p.name.sym,
                span: p.span,
                is_self: p.is_self,
                is_comptime: p.is_comptime,
                modifier: p.modifier,
                access: p.access,
                ty: pty,
                has_gpu_binding: false,
                gpu_set: 0_u32,
                gpu_binding: 0_u32,
                is_push_const: false,
            },
        );
        pi = pi +% 1_usize;
    }
    let p_start = env.sigs.params.len().trunc.[u32]();
    try env.sigs.params.push_slice(alloc, local_ps.as_slice());
    let p_range = ast.range_new(p_start, local_ps.len().trunc.[u32]());
    let ret = if m.ret_type != ast.NONE_ID {
        try resolve_type_expr(alloc, m.ret_type, mod_id, &m_ctx, arena, prog, env, interner, diags)
    } else {
        TY_VOID
    };
    let effects = try parse_effect_set(
        alloc, m.attrs, m.effects, mod_id, &m_ctx, arena, prog, env, interner, diags,
    );
    local_ps.destroy(alloc);
    m_ctx.destroy(alloc);
    return FnSig.{
        has_def: false,
        def_id: 0_u32,
        module_id: mod_id,
        name: m.name.sym,
        is_pub: true,
        is_view: m.is_view,
        is_comptime: false,
        is_extern: false,
        generics: m_gens,
        params: p_range,
        ret: ret,
        has_gpu_attr: effects.is_gpu,
        effects: effects,
    };
}

@recursive
fn resolve_iface_def(
    alloc: *mut AllocCap,
    def_id: u32,
    mod_id: u32,
    ic: *ast.IfaceDeclNode,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    var ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    let generics = try resolve_generic_params(
        alloc, ic.generics, ast.range_empty(), mod_id, &mut ctx, arena, prog, env, interner, diags,
    );
    ctx.has_self_ty = true;
    ctx.self_ty = try env.intern_dyn(alloc, def_id);

    let ast_ms = arena.iface_methods_range(ic.methods);
    var local_ms = try col.DynBuf.[FnSig].init(alloc, ast_ms.len +% 1_usize);
    errdefer local_ms.destroy(alloc);
    var mi: usize = 0_usize;
    while mi < ast_ms.len {
        let m = ast_ms[mi];
        let sig = try resolve_iface_method(alloc, &m, mod_id, &ctx, arena, prog, env, interner, diags);
        try local_ms.push(alloc, sig);
        mi = mi +% 1_usize;
    }

    let ms_start = env.decls.iface_methods.len().trunc.[u32]();
    try env.decls.iface_methods.push_slice(alloc, local_ms.as_slice());
    let ms_range = ast.range_new(ms_start, local_ms.len().trunc.[u32]());

    let meta_idx = env.decls.ifaces.len().trunc.[u32]();
    try env.decls.ifaces.push(
        alloc,
        IfaceMeta.{
            def_id: def_id,
            module_id: mod_id,
            generics: generics,
            methods: ms_range,
        },
    );
    try env.index.iface_by_def.insert(alloc, def_id.widen.[u64](), meta_idx);
    local_ms.destroy(alloc);
    ctx.destroy(alloc);
    return;
}

@recursive
fn resolve_type_alias_def(
    alloc: *mut AllocCap,
    def_id: u32,
    mod_id: u32,
    ta: *ast.TypeAliasDeclNode,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    var ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    let generics = try resolve_generic_params(
        alloc, ta.generics, ast.range_empty(), mod_id, &mut ctx, arena, prog, env, interner, diags,
    );
    let ty = try resolve_type_expr(alloc, ta.ty, mod_id, &ctx, arena, prog, env, interner, diags);
    let meta_idx = env.decls.type_aliases.len().trunc.[u32]();
    try env.decls.type_aliases.push(
        alloc,
        TypeAliasMeta.{ def_id: def_id, generics: generics, ty: ty },
    );
    try env.index.alias_by_def.insert(alloc, def_id.widen.[u64](), meta_idx);
    ctx.destroy(alloc);
    return;
}

@recursive
fn ensure_def_resolved(
    alloc: *mut AllocCap,
    def_id: u32,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    let def = prog.get_def(def_id) orelse { return; };
    let def_mod = def.module_id;
    let m = prog.get_module(def_mod) orelse { return; };
    if m.unit_id == resolve.UNIT_NONE {
        return;
    }
    let decl = arena.get_decl(def.decl_id) orelse { return; };
    let def_key = def_id.widen.[u64]();
    let def_bit = def_id.widen.[usize]();

    match decl.kind {
        .Struct => {
            if env.index.struct_by_def.contains(def_key) { return; }
            let s = arena.get_struct_decl(decl.payload) orelse { return; };
            if env.index.visiting.contains(def_bit) {
                try emit_diag_fmt2(
                    alloc, diags, diag.E0230, decl.span,
                    "recursive struct `", interner.get(s.name.sym), "` has infinite size",
                );
                return;
            }
            try env.index.visiting.set_grow(alloc, def_bit);
            try resolve_struct_def(alloc, def_id, def_mod, decl, s, arena, prog, env, interner, diags);
            env.index.visiting.unset(def_bit);
        }
        .ExternStruct => {
            if env.index.struct_by_def.contains(def_key) { return; }
            if env.index.visiting.contains(def_bit) { return; }
            let ex = arena.get_extern_decl(decl.payload) orelse { return; };
            try env.index.visiting.set_grow(alloc, def_bit);
            try resolve_extern_agg_def(alloc, def_id, def_mod, ex.fields, arena, prog, env, interner, diags);
            env.index.visiting.unset(def_bit);
        }
        .Pool => {
            if env.index.pool_by_def.contains(def_key) { return; }
            if env.index.visiting.contains(def_bit) { return; }
            let p = arena.get_struct_decl(decl.payload) orelse { return; };
            try env.index.visiting.set_grow(alloc, def_bit);
            try resolve_pool_def(alloc, def_id, def_mod, p, arena, prog, env, interner, diags);
            env.index.visiting.unset(def_bit);
        }
        .Enum => {
            if env.index.enum_by_def.contains(def_key) { return; }
            let e = arena.get_enum_decl(decl.payload) orelse { return; };
            try resolve_enum_def(alloc, def_id, def_mod, e, arena, prog, env, interner, diags);
        }
        .Union => {
            if env.index.union_by_def.contains(def_key) { return; }
            let u = arena.get_union_decl(decl.payload) orelse { return; };
            if env.index.visiting.contains(def_bit) {
                try emit_diag_fmt2(
                    alloc, diags, diag.E0230, decl.span,
                    "recursive union `", interner.get(u.name.sym), "` has infinite size",
                );
                return;
            }
            try env.index.visiting.set_grow(alloc, def_bit);
            try resolve_union_def(alloc, def_id, def_mod, u, arena, prog, env, interner, diags);
            env.index.visiting.unset(def_bit);
        }
        .Bitfield => {
            if env.index.bitfield_by_def.contains(def_key) { return; }
            let b = arena.get_bitfield_decl(decl.payload) orelse { return; };
            try resolve_bitfield_def(alloc, def_id, def_mod, b, arena, prog, env, interner, diags);
        }
        .Error => {
            if env.index.error_by_def.contains(def_key) { return; }
            let er = arena.get_error_decl(decl.payload) orelse { return; };
            try resolve_error_def(alloc, def_id, er, arena, env, interner, diags);
        }
        .Iface => {
            if env.index.iface_by_def.contains(def_key) { return; }
            let ic = arena.get_iface_decl(decl.payload) orelse { return; };
            try resolve_iface_def(alloc, def_id, def_mod, ic, arena, prog, env, interner, diags);
        }
        .TypeAlias => {
            if env.index.alias_by_def.contains(def_key) { return; }
            let ta = arena.get_type_decl(decl.payload) orelse { return; };
            if env.index.visiting.contains(def_bit) {
                try emit_diag_fmt2(
                    alloc, diags, diag.E0230, decl.span,
                    "cyclic type alias `", interner.get(ta.name.sym), "`",
                );
                return;
            }
            try env.index.visiting.set_grow(alloc, def_bit);
            try resolve_type_alias_def(alloc, def_id, def_mod, ta, arena, prog, env, interner, diags);
            env.index.visiting.unset(def_bit);
        }
        _ => {}
    }
    return;
}

@recursive
fn apply_effect_attr(
    alloc: *mut AllocCap,
    a: ast.AttrNode,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    es: *mut EffectSet,
) -> !OutOfMemory {
    let name = interner.get(a.name.sym);
    if str.bytes_eq(name, "pure".as_bytes()) {
        es.is_pure = true;
        es.is_noalloc = true;
        es.is_noblock = true;
        if !es.has_effect_span { es.has_effect_span = true; es.effect_span = a.span; }
    } else if str.bytes_eq(name, "noalloc".as_bytes()) {
        es.is_noalloc = true;
        if !es.has_effect_span { es.has_effect_span = true; es.effect_span = a.span; }
    } else if str.bytes_eq(name, "noblock".as_bytes()) {
        es.is_noblock = true;
        if !es.has_effect_span { es.has_effect_span = true; es.effect_span = a.span; }
    } else if str.bytes_eq(name, "no_panic".as_bytes()) {
        es.is_no_panic = true;
    } else if str.bytes_eq(name, "interrupt".as_bytes()) {
        es.is_interrupt = true;
        es.is_noalloc = true;
        es.is_noblock = true;
        if !es.has_effect_span { es.has_effect_span = true; es.effect_span = a.span; }
    } else if str.bytes_eq(name, "naked".as_bytes()) {
        es.is_naked = true;
    } else if str.bytes_eq(name, "extern".as_bytes()) || str.bytes_eq(name, "export_c".as_bytes()) {
        es.is_export_c = true;
    } else if str.bytes_eq(name, "recursive".as_bytes()) {
        es.is_recursive = true;
    } else if str.bytes_eq(name, "hot".as_bytes()) || str.bytes_eq(name, "specialize".as_bytes()) {
        es.is_hot = true;
    } else if str.bytes_eq(name, "inline".as_bytes()) {
        es.is_inline = true;
    } else if str.bytes_eq(name, "save_simd".as_bytes()) {
        es.save_simd = true;
    } else if str.bytes_eq(name, "simd".as_bytes()) {
        es.is_simd = true;
        es.save_simd = true;
    } else if str.bytes_eq(name, "stack".as_bytes()) {
        es.has_stack_span = true;
        es.stack_span = a.span;
        let args = arena.attr_args_range(a.args);
        if args.len > 0_usize {
            if let iv = try eval_const_int(
                alloc, args[0_usize].value, mod_id, ctx, arena, prog, env, interner, diags,
            ) {
                if let vu = int_val_to_u64(iv) {
                    es.has_stack_limit = true;
                    es.stack_limit = vu;
                }
            }
        }
    } else if str.bytes_eq(name, "gpu".as_bytes()) {
        es.is_gpu = true;
        es.is_noalloc = true;
        es.is_noblock = true;
        if !es.has_effect_span { es.has_effect_span = true; es.effect_span = a.span; }
        es.has_gpu_local_size = true;
        es.gpu_local_x = 1_u32;
        es.gpu_local_y = 1_u32;
        es.gpu_local_z = 1_u32;
        let args = arena.attr_args_range(a.args);
        var ai: usize = 0_usize;
        while ai < args.len {
            let arg = args[ai];
            if ast.ident_is_some(arg.name) && str.bytes_eq(interner.get(arg.name.sym), "local_size".as_bytes()) {
                if let e = arena.get_expr(arg.value) {
                    if e.kind == .Tuple {
                        let ts = arena.expr_list_range(e.list);
                        if ts.len > 0_usize {
                            if let iv = try eval_const_int(alloc, ts[0_usize], mod_id, ctx, arena, prog, env, interner, diags) {
                                if let vu = int_val_to_u64(iv) {
                                    es.gpu_local_x = if vu < 1_u64 { 1_u32 } else { vu.trunc.[u32]() };
                                }
                            }
                        }
                        if ts.len > 1_usize {
                            if let iv = try eval_const_int(alloc, ts[1_usize], mod_id, ctx, arena, prog, env, interner, diags) {
                                if let vu = int_val_to_u64(iv) {
                                    es.gpu_local_y = if vu < 1_u64 { 1_u32 } else { vu.trunc.[u32]() };
                                }
                            }
                        }
                        if ts.len > 2_usize {
                            if let iv = try eval_const_int(alloc, ts[2_usize], mod_id, ctx, arena, prog, env, interner, diags) {
                                if let vu = int_val_to_u64(iv) {
                                    es.gpu_local_z = if vu < 1_u64 { 1_u32 } else { vu.trunc.[u32]() };
                                }
                            }
                        }
                    }
                }
            }
            ai = ai +% 1_usize;
        }
    }
    return;
}

@recursive
fn parse_effect_set(
    alloc: *mut AllocCap,
    decl_attrs: ast.IdRange,
    fn_effects: ast.IdRange,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> EffectSet ! OutOfMemory {
    var es = effect_set_empty();
    let da = arena.attrs_range(decl_attrs);
    var i: usize = 0_usize;
    while i < da.len {
        try apply_effect_attr(alloc, da[i], mod_id, ctx, arena, prog, env, interner, diags, &mut es);
        i = i +% 1_usize;
    }
    let fe = arena.attrs_range(fn_effects);
    var j: usize = 0_usize;
    while j < fe.len {
        try apply_effect_attr(alloc, fe[j], mod_id, ctx, arena, prog, env, interner, diags, &mut es);
        j = j +% 1_usize;
    }
    return es;
}

@recursive
fn resolve_params(
    alloc: *mut AllocCap,
    params_range: ast.IdRange,
    mod_id: u32,
    ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> ast.IdRange ! OutOfMemory {
    let ast_ps = arena.params_range(params_range);
    var local_ps = try col.DynBuf.[ParamSig].init(alloc, ast_ps.len +% 1_usize);
    errdefer local_ps.destroy(alloc);
    var pi: usize = 0_usize;
    while pi < ast_ps.len {
        let p = ast_ps[pi];
        let ty = try resolve_type_expr(alloc, p.ty, mod_id, ctx, arena, prog, env, interner, diags);
        if !p.is_comptime && env.contains_type_type(ty) {
            let psp = if let ptn = arena.get_type(p.ty) { ptn.span } else { p.span };
            _ = try diags.emit_error(
                alloc, diag.E0210, psp, "comptime `type` parameter must be marked `comptime`",
            );
        }
        var has_gpu = false;
        var gpu_s: u32 = 0_u32;
        var gpu_b: u32 = 0_u32;
        var is_pc = false;
        let attrs = arena.attrs_range(p.attrs);
        var ai: usize = 0_usize;
        while ai < attrs.len {
            let an = interner.get(attrs[ai].name.sym);
            if str.bytes_eq(an, "binding".as_bytes()) {
                has_gpu = true;
                let aargs = arena.attr_args_range(attrs[ai].args);
                if aargs.len > 0_usize {
                    if let iv = try eval_const_int(alloc, aargs[0_usize].value, mod_id, ctx, arena, prog, env, interner, diags) {
                        gpu_s = iv.lo.trunc.[u32]();
                    }
                }
                if aargs.len > 1_usize {
                    if let iv = try eval_const_int(alloc, aargs[1_usize].value, mod_id, ctx, arena, prog, env, interner, diags) {
                        gpu_b = iv.lo.trunc.[u32]();
                    }
                }
            } else if str.bytes_eq(an, "push_const".as_bytes()) {
                is_pc = true;
            }
            ai = ai +% 1_usize;
        }
        try local_ps.push(
            alloc,
            ParamSig.{
                name: p.name.sym,
                span: p.span,
                is_self: p.is_self,
                is_comptime: p.is_comptime,
                modifier: p.modifier,
                access: p.access,
                ty: ty,
                has_gpu_binding: has_gpu,
                gpu_set: gpu_s,
                gpu_binding: gpu_b,
                is_push_const: is_pc,
            },
        );
        pi = pi +% 1_usize;
    }
    let start = env.sigs.params.len().trunc.[u32]();
    try env.sigs.params.push_slice(alloc, local_ps.as_slice());
    let r = ast.range_new(start, local_ps.len().trunc.[u32]());
    local_ps.destroy(alloc);
    return r;
}

@recursive
fn resolve_fn_sig_with_parent(
    alloc: *mut AllocCap,
    has_def: bool,
    def_id: u32,
    mod_id: u32,
    is_pub: bool,
    decl_attrs: ast.IdRange,
    f: *ast.FnDeclNode,
    has_self_ty: bool,
    self_ty: TyId,
    parent_ctx: ?*GenericCtx,
    parent_generics: ast.IdRange,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> FnSig ! OutOfMemory {
    var ctx = if let pc = parent_ctx {
        try GenericCtx.clone_from(alloc, pc)
    } else {
        try GenericCtx.init(alloc)
    };
    errdefer ctx.destroy(alloc);
    ctx.has_self_ty = has_self_ty;
    ctx.self_ty = self_ty;

    let generics = try resolve_generic_params(
        alloc, f.generics, parent_generics, mod_id, &mut ctx, arena, prog, env, interner, diags,
    );
    let params = try resolve_params(alloc, f.params, mod_id, &ctx, arena, prog, env, interner, diags);
    let ret = if f.ret_type != ast.NONE_ID {
        try resolve_type_expr(alloc, f.ret_type, mod_id, &ctx, arena, prog, env, interner, diags)
    } else {
        TY_VOID
    };
    let ret_sp = if f.ret_type != ast.NONE_ID {
        if let rtn = arena.get_type(f.ret_type) { rtn.span } else { f.name.span }
    } else {
        f.name.span
    };
    if !f.is_view {
        if env.contains_second_class_ref(ret) {
            _ = try diags.emit_error(
                alloc,
                diag.E0310,
                ret_sp,
                "cannot return second-class reference or closure from a non-`view` function; mark with `view fn`",
            );
        } else if env.contains_borrowing_value(ret) {
            _ = try diags.emit_error(
                alloc,
                diag.E0311,
                ret_sp,
                "cannot return borrowing value (`ArenaPool` / `ArenaStr`) from a non-`view` function",
            );
        }
    }
    let effects = try parse_effect_set(
        alloc, decl_attrs, f.effects, mod_id, &ctx, arena, prog, env, interner, diags,
    );
    if effects.is_export_c {
        let rn = env.get(ret);
        let bad_ret = rn.kind == .ErrorUnion
            || (rn.kind == .Borrow && (rn.borrow_kind == .Slice || rn.borrow_kind == .Str))
            || rn.kind == .Dyn
            || env.is_linear(ret);
        if bad_ret {
            var msg = try str.StrBuf.init(alloc, 96_usize);
            errdefer msg.destroy(alloc);
            try msg.push_str_grow(alloc, "`@extern(\"C\")` function cannot return Eon-specific type `");
            try env.format_ty_short(alloc, ret, interner, &mut msg);
            try msg.push_byte_grow(alloc, b'`');
            _ = try diags.emit_error_bytes(alloc, diag.E0810, ret_sp, msg.as_bytes());
            msg.destroy(alloc);
        }
    }
    ctx.destroy(alloc);
    return FnSig.{
        has_def: has_def,
        def_id: def_id,
        module_id: mod_id,
        name: f.name.sym,
        is_pub: is_pub,
        is_view: f.is_view,
        is_comptime: f.is_comptime,
        is_extern: false,
        generics: generics,
        params: params,
        ret: ret,
        has_gpu_attr: effects.is_gpu,
        effects: effects,
    };
}

fn commit_sys_access_cols(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    p_columns: ast.IdRange,
    pdef: u32,
    env: *mut TypeEnv,
) -> ast.IdRange ! OutOfMemory {
    var cols = try col.DynBuf.[u32].init(alloc, 8_usize);
    errdefer cols.destroy(alloc);
    let pcols = arena.idents_range(p_columns);
    if pcols.len == 0_usize {
        if let pm = env.get_pool(pdef) {
            let mcs = env.pool_cols_range(pm.columns);
            var ci: usize = 0_usize;
            while ci < mcs.len {
                try cols.push(alloc, mcs[ci].name);
                ci = ci +% 1_usize;
            }
        }
    } else {
        var ci: usize = 0_usize;
        while ci < pcols.len {
            try cols.push(alloc, pcols[ci].sym);
            ci = ci +% 1_usize;
        }
    }
    let col_start = env.sigs.sys_access_cols.len().trunc.[u32]();
    try env.sigs.sys_access_cols.push_slice(alloc, cols.as_slice());
    let col_range = ast.range_new(col_start, cols.len().trunc.[u32]());
    cols.destroy(alloc);
    return col_range;
}

@recursive
fn resolve_sys_sig(
    alloc: *mut AllocCap,
    def_id: u32,
    mod_id: u32,
    is_pub: bool,
    decl_attrs: ast.IdRange,
    s: *ast.SysDeclNode,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> FnSig ! OutOfMemory {
    var ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    let generics = try resolve_generic_params(
        alloc, s.generics, ast.range_empty(), mod_id, &mut ctx, arena, prog, env, interner, diags,
    );

    let ast_ps = arena.sys_params_range(s.params);
    var local_ps = try col.DynBuf.[ParamSig].init(alloc, ast_ps.len +% 1_usize);
    errdefer local_ps.destroy(alloc);
    var local_acc = try col.DynBuf.[SysColAccess].init(alloc, ast_ps.len +% 1_usize);
    errdefer local_acc.destroy(alloc);

    var pidx: usize = 0_usize;
    while pidx < ast_ps.len {
        let p = ast_ps[pidx];
        let ty = try resolve_type_expr(alloc, p.ty, mod_id, &ctx, arena, prog, env, interner, diags);
        if p.access != .None {
            let tn = env.get(ty);
            var has_pdef = false;
            var pdef: u32 = 0_u32;
            if tn.kind == .Pool {
                has_pdef = true;
                pdef = tn.primary;
            } else if tn.kind == .Builtin && (tn.builtin_kind == .ArenaPool || tn.builtin_kind == .SlotPool) {
                if let pd = env.pool_def_of_gargs(env.node_gval_list(&tn)) {
                    has_pdef = true;
                    pdef = pd;
                }
            }
            if has_pdef {
                let col_range = try commit_sys_access_cols(alloc, arena, p.columns, pdef, env);
                try local_acc.push(
                    alloc,
                    SysColAccess.{
                        param_idx: pidx,
                        mode: p.access,
                        pool_def: pdef,
                        columns: col_range,
                        span: p.span,
                    },
                );
            }
        }
        try local_ps.push(
            alloc,
            ParamSig.{
                name: p.name.sym,
                span: p.span,
                is_self: p.is_self,
                is_comptime: p.is_comptime,
                modifier: p.modifier,
                access: p.access,
                ty: ty,
                has_gpu_binding: false,
                gpu_set: 0_u32,
                gpu_binding: 0_u32,
                is_push_const: false,
            },
        );
        pidx = pidx +% 1_usize;
    }

    let p_start = env.sigs.params.len().trunc.[u32]();
    try env.sigs.params.push_slice(alloc, local_ps.as_slice());
    let p_range = ast.range_new(p_start, local_ps.len().trunc.[u32]());

    let a_start = env.sigs.sys_accesses.len().trunc.[u32]();
    try env.sigs.sys_accesses.push_slice(alloc, local_acc.as_slice());
    let a_range = ast.range_new(a_start, local_acc.len().trunc.[u32]());
    let r_idx = env.sigs.sys_access_ranges.len().trunc.[u32]();
    try env.sigs.sys_access_ranges.push(alloc, a_range);
    try env.index.sys_access_by_def.insert(alloc, def_id.widen.[u64](), r_idx);

    let ret = if s.ret_type != ast.NONE_ID {
        try resolve_type_expr(alloc, s.ret_type, mod_id, &ctx, arena, prog, env, interner, diags)
    } else {
        TY_VOID
    };
    let effects = try parse_effect_set(
        alloc, decl_attrs, s.effects, mod_id, &ctx, arena, prog, env, interner, diags,
    );
    local_acc.destroy(alloc);
    local_ps.destroy(alloc);
    ctx.destroy(alloc);
    return FnSig.{
        has_def: true,
        def_id: def_id,
        module_id: mod_id,
        name: s.name.sym,
        is_pub: is_pub,
        is_view: false,
        is_comptime: false,
        is_extern: false,
        generics: generics,
        params: p_range,
        ret: ret,
        has_gpu_attr: effects.is_gpu,
        effects: effects,
    };
}

@recursive
fn resolve_extern_fn_sig(
    alloc: *mut AllocCap,
    def_id: u32,
    mod_id: u32,
    is_pub: bool,
    decl_attrs: ast.IdRange,
    ef: *ast.ExternDeclNode,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> FnSig ! OutOfMemory {
    let ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    let ast_ps = arena.params_range(ef.params);
    var local_ps = try col.DynBuf.[ParamSig].init(alloc, ast_ps.len +% 1_usize);
    errdefer local_ps.destroy(alloc);
    var pi: usize = 0_usize;
    while pi < ast_ps.len {
        let p = ast_ps[pi];
        let ty = try resolve_type_expr(alloc, p.ty, mod_id, &ctx, arena, prog, env, interner, diags);
        try local_ps.push(
            alloc,
            ParamSig.{
                name: p.name.sym,
                span: p.span,
                is_self: p.is_self,
                is_comptime: p.is_comptime,
                modifier: p.modifier,
                access: p.access,
                ty: ty,
                has_gpu_binding: false,
                gpu_set: 0_u32,
                gpu_binding: 0_u32,
                is_push_const: false,
            },
        );
        pi = pi +% 1_usize;
    }
    let p_start = env.sigs.params.len().trunc.[u32]();
    try env.sigs.params.push_slice(alloc, local_ps.as_slice());
    let p_range = ast.range_new(p_start, local_ps.len().trunc.[u32]());

    let ret = if ef.ret_type != ast.NONE_ID {
        try resolve_type_expr(alloc, ef.ret_type, mod_id, &ctx, arena, prog, env, interner, diags)
    } else {
        TY_VOID
    };
    let effects = try parse_effect_set(
        alloc, decl_attrs, ast.range_empty(), mod_id, &ctx, arena, prog, env, interner, diags,
    );
    local_ps.destroy(alloc);
    ctx.destroy(alloc);
    return FnSig.{
        has_def: true,
        def_id: def_id,
        module_id: mod_id,
        name: ef.name.sym,
        is_pub: is_pub,
        is_view: false,
        is_comptime: false,
        is_extern: true,
        generics: ast.range_empty(),
        params: p_range,
        ret: ret,
        has_gpu_attr: effects.is_gpu,
        effects: effects,
    };
}

fn check_impl_orphan_and_float_rules(
    alloc: *mut AllocCap,
    impl_info: *resolve.ImplInfo,
    target_ty: TyId,
    has_target_key: bool,
    target_key: MethodTarget,
    iface_opt: ?IfaceTarget,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    let it = iface_opt orelse { return; };
    if target_ty == TY_F16 || target_ty == TY_F32 || target_ty == TY_F64 {
        match it.kind {
            .BuiltinOrd => {
                _ = try diags.emit_error(
                    alloc, diag.E0501, impl_info.span,
                    "floating-point types do not implement `Ord` due to `NaN` semantics",
                );
            }
            .BuiltinEq => {
                _ = try diags.emit_error(
                    alloc, diag.E0501, impl_info.span,
                    "floating-point types do not implement `Eq` due to `NaN` semantics",
                );
            }
            .User => {
                if let d = prog.get_def(it.def_id) {
                    let iname = interner.get(d.name);
                    if str.bytes_eq(iname, "Ord".as_bytes()) || str.bytes_eq(iname, "Eq".as_bytes()) {
                        try emit_diag_fmt2(
                            alloc, diags, diag.E0501, impl_info.span,
                            "floating-point types do not implement `", iname, "` due to `NaN` semantics",
                        );
                    }
                }
            }
        }
    }

    if it.kind == .User && has_target_key {
        var iface_mod = resolve.MODULE_NONE;
        if let id_def = prog.get_def(it.def_id) {
            iface_mod = id_def.module_id;
        }
        var type_owned_here = false;
        if target_key.kind == .Def {
            if let td = prog.get_def(target_key.def_id) {
                type_owned_here = td.module_id == impl_info.module_id;
            }
        }
        if impl_info.module_id != iface_mod && !type_owned_here {
            _ = try diags.emit_error(
                alloc,
                diag.E0501,
                impl_info.span,
                "orphan rule violation: `impl Interface for Type` must be in the module defining either the interface or the type",
            );
        }
    } else if it.kind == .BuiltinOrd || it.kind == .BuiltinEq {
        var type_owned_here = false;
        if has_target_key && target_key.kind == .Def {
            if let td = prog.get_def(target_key.def_id) {
                type_owned_here = td.module_id == impl_info.module_id;
            }
        }
        if !type_owned_here && target_ty != TY_F16 && target_ty != TY_F32 && target_ty != TY_F64 {
            _ = try diags.emit_error(
                alloc,
                diag.E0501,
                impl_info.span,
                "orphan rule violation: `impl` of built-in interface for foreign type",
            );
        }
    }
    return;
}

@recursive
fn resolve_impl_block(
    alloc: *mut AllocCap,
    impl_info: *resolve.ImplInfo,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    let decl = arena.get_decl(impl_info.decl_id) orelse { return; };
    if decl.kind != .Impl {
        return;
    }
    let im = arena.get_impl_decl(decl.payload) orelse { return; };
    var ctx = try GenericCtx.init(alloc);
    errdefer ctx.destroy(alloc);
    let impl_gens = try resolve_generic_params(
        alloc, im.generics, ast.range_empty(), impl_info.module_id, &mut ctx, arena, prog, env, interner, diags,
    );
    let target_ty = try resolve_type_expr(
        alloc, im.target_type, impl_info.module_id, &ctx, arena, prog, env, interner, diags,
    );
    ctx.has_self_ty = true;
    ctx.self_ty = target_ty;

    let iface_opt: ?IfaceTarget = if im.iface_type != ast.NONE_ID {
        try resolve_iface_target_only(alloc, im.iface_type, impl_info.module_id, arena, prog, interner, diags)
    } else {
        null
    };
    var has_iface = false;
    var iface_def: u32 = 0_u32;
    if let it = iface_opt {
        if it.kind == .User {
            has_iface = true;
            iface_def = it.def_id;
        }
    }

    let tn = env.get(target_ty);
    var has_tkey = false;
    var tkey = MethodTarget.{ kind: .Def, def_id: 0_u32, builtin: .Prim };
    match tn.kind {
        .Struct => { has_tkey = true; tkey = MethodTarget.{ kind: .Def, def_id: tn.primary, builtin: .Prim }; }
        .Pool => { has_tkey = true; tkey = MethodTarget.{ kind: .Def, def_id: tn.primary, builtin: .Prim }; }
        .Enum => { has_tkey = true; tkey = MethodTarget.{ kind: .Def, def_id: tn.primary, builtin: .Prim }; }
        .Union => { has_tkey = true; tkey = MethodTarget.{ kind: .Def, def_id: tn.primary, builtin: .Prim }; }
        .Bitfield => { has_tkey = true; tkey = MethodTarget.{ kind: .Def, def_id: tn.primary, builtin: .Prim }; }
        .Builtin => { has_tkey = true; tkey = MethodTarget.{ kind: .Builtin, def_id: 0_u32, builtin: tn.builtin_kind }; }
        _ => {}
    }

    try check_impl_orphan_and_float_rules(
        alloc, impl_info, target_ty, has_tkey, tkey, iface_opt, prog, interner, diags,
    );

    let sub_ids = arena.decl_list_range(im.decls);
    var local_ms = try col.DynBuf.[ImplMethodMeta].init(alloc, sub_ids.len +% 1_usize);
    errdefer local_ms.destroy(alloc);
    var si: usize = 0_usize;
    while si < sub_ids.len {
        let sub_id = sub_ids[si];
        if let sub_decl = arena.get_decl(sub_id) {
            if sub_decl.kind == .Fn {
                if let f = arena.get_fn_decl(sub_decl.payload) {
                    let sig = try resolve_fn_sig_with_parent(
                        alloc,
                        false,
                        0_u32,
                        impl_info.module_id,
                        sub_decl.is_pub,
                        sub_decl.attrs,
                        f,
                        true,
                        target_ty,
                        &ctx,
                        impl_gens,
                        arena,
                        prog,
                        env,
                        interner,
                        diags,
                    );
                    try local_ms.push(
                        alloc,
                        ImplMethodMeta.{
                            sub_idx: si.trunc.[u32](),
                            decl_id: sub_id,
                            sig: sig,
                        },
                    );
                }
            }
        }
        si = si +% 1_usize;
    }

    let ms_start = env.decls.impl_methods.len().trunc.[u32]();
    try env.decls.impl_methods.push_slice(alloc, local_ms.as_slice());
    let ms_range = ast.range_new(ms_start, local_ms.len().trunc.[u32]());

    if has_tkey {
        try env.decls.impls.push(
            alloc,
            ImplMeta.{
                module_id: impl_info.module_id,
                impl_decl_idx: impl_info.decl_idx,
                impl_decl_id: impl_info.decl_id,
                has_iface: has_iface,
                iface_def: iface_def,
                target: tkey,
                target_ty: target_ty,
                generics: impl_gens,
                methods: ms_range,
            },
        );
    }
    local_ms.destroy(alloc);
    ctx.destroy(alloc);
    return;
}

fn resolve_pass2_def(
    alloc: *mut AllocCap,
    def_id: u32,
    empty_ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    let def = prog.get_def(def_id) orelse { return; };
    let def_mod = def.module_id;
    let def_decl_id = def.decl_id;
    let m = prog.get_module(def_mod) orelse { return; };
    if m.unit_id == resolve.UNIT_NONE {
        return;
    }
    let decl = arena.get_decl(def_decl_id) orelse { return; };
    match decl.kind {
        .Fn => {
            if let f = arena.get_fn_decl(decl.payload) {
                let sig = try resolve_fn_sig_with_parent(
                    alloc, true, def_id, def_mod, decl.is_pub, decl.attrs, f,
                    false, TY_ERROR, null, ast.range_empty(),
                    arena, prog, env, interner, diags,
                );
                let fidx = env.decls.fns.len().trunc.[u32]();
                try env.decls.fns.push(alloc, sig);
                try env.index.fn_by_def.insert(alloc, def_id.widen.[u64](), fidx);
            }
        }
        .Sys => {
            if let s = arena.get_sys_decl(decl.payload) {
                let sig = try resolve_sys_sig(
                    alloc, def_id, def_mod, decl.is_pub, decl.attrs, s,
                    arena, prog, env, interner, diags,
                );
                let fidx = env.decls.fns.len().trunc.[u32]();
                try env.decls.fns.push(alloc, sig);
                try env.index.fn_by_def.insert(alloc, def_id.widen.[u64](), fidx);
            }
        }
        .ExternFn => {
            if let ef = arena.get_extern_decl(decl.payload) {
                let sig = try resolve_extern_fn_sig(
                    alloc, def_id, def_mod, decl.is_pub, decl.attrs, ef,
                    arena, prog, env, interner, diags,
                );
                let fidx = env.decls.fns.len().trunc.[u32]();
                try env.decls.fns.push(alloc, sig);
                try env.index.fn_by_def.insert(alloc, def_id.widen.[u64](), fidx);
            }
        }
        .Const => {
            if let c = arena.get_const_decl(decl.payload) {
                let ty = try resolve_type_expr(
                    alloc, c.ty, def_mod, empty_ctx, arena, prog, env, interner, diags,
                );
                var has_iv = false;
                var iv = int_val_zero();
                if let val = try eval_const_int(
                    alloc, c.value, def_mod, empty_ctx, arena, prog, env, interner, diags,
                ) {
                    has_iv = true;
                    iv = val;
                }
                let cidx = env.decls.consts.len().trunc.[u32]();
                try env.decls.consts.push(
                    alloc,
                    ConstMeta.{ def_id: def_id, ty: ty, has_int_val: has_iv, int_val: iv },
                );
                try env.index.const_by_def.insert(alloc, def_id.widen.[u64](), cidx);
            }
        }
        _ => {}
    }
    return;
}

fn retry_unresolved_consts(
    alloc: *mut AllocCap,
    empty_ctx: *GenericCtx,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut TypeEnv,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    var ci: usize = 0_usize;
    let c_len = env.decls.consts.len();
    while ci < c_len {
        var needs_eval = false;
        var c_def_id: u32 = 0_u32;
        let cs_ro = env.decls.consts.as_slice();
        if ci < cs_ro.len && !cs_ro[ci].has_int_val {
            needs_eval = true;
            c_def_id = cs_ro[ci].def_id;
        }
        if needs_eval {
            if let def = prog.get_def(c_def_id) {
                let cmod = def.module_id;
                let cdecl_id = def.decl_id;
                if let decl = arena.get_decl(cdecl_id) {
                    if decl.kind == .Const {
                        if let c = arena.get_const_decl(decl.payload) {
                            if let val = try eval_const_int(
                                alloc, c.value, cmod, empty_ctx, arena, prog, env, interner, diags,
                            ) {
                                let cs_mut = env.decls.consts.as_mut_slice();
                                if ci < cs_mut.len {
                                    cs_mut[ci].has_int_val = true;
                                    cs_mut[ci].int_val = val;
                                }
                            }
                        }
                    }
                }
            }
        }
        ci = ci +% 1_usize;
    }
    return;
}

pub fn build_type_env(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> TypeEnv ! OutOfMemory {
    var env = try TypeEnv.init(alloc);
    errdefer env.destroy(alloc);

    let def_cnt = prog.def_count();

    // Pass 1: Resolve all type definitions.
    var d1: u32 = 0_u32;
    while d1 < def_cnt {
        try ensure_def_resolved(alloc, d1, arena, prog, &mut env, interner, diags);
        d1 = d1 +% 1_u32;
    }

    // Pass 2: Signatures of functions, systems, extern functions, and constants.
    let empty_ctx = try GenericCtx.init(alloc);
    errdefer empty_ctx.destroy(alloc);
    var d2: u32 = 0_u32;
    while d2 < def_cnt {
        try resolve_pass2_def(alloc, d2, &empty_ctx, arena, prog, &mut env, interner, diags);
        d2 = d2 +% 1_u32;
    }

    // Pass 2.2: Retry any unresolved integer `const`s (handles forward const references).
    try retry_unresolved_consts(alloc, &empty_ctx, arena, prog, &mut env, interner, diags);

    // Pass 3: Resolve `impl` blocks & orphan rules.
    let impl_cnt = prog.impl_count();
    var ii: u32 = 0_u32;
    while ii < impl_cnt {
        let imps = prog.impls.as_slice();
        let idx = ii.widen.[usize]();
        if idx < imps.len {
            let info = imps[idx];
            try resolve_impl_block(alloc, &info, arena, prog, &mut env, interner, diags);
        }
        ii = ii +% 1_u32;
    }

    empty_ctx.destroy(alloc);
    return env;
}

// ===========================================================================
// Section 12: Canonical Type Dumper (`dump_types_canonical`)
// ===========================================================================

struct DumpEntry {
    key_off: u32;
    key_len: u32;
    body_off: u32;
    body_len: u32;
}

fn cmp_bytes_lex(a: *[u8], b: *[u8]) -> i32 {
    let min_len = if a.len < b.len { a.len } else { b.len };
    var i: usize = 0_usize;
    while i < min_len {
        if i < a.len && i < b.len {
            let ca = a[i];
            let cb = b[i];
            if ca < cb { return -1_i32; }
            if ca > cb { return 1_i32; }
        }
        i = i +% 1_usize;
    }
    if a.len < b.len { return -1_i32; }
    if a.len > b.len { return 1_i32; }
    return 0_i32;
}

fn cmp_dump_entries(keys: *[u8], bodies: *[u8], a: DumpEntry, b: DumpEntry) -> i32 {
    let ka = slice_id_range.[u8](keys, ast.range_new(a.key_off, a.key_len));
    let kb = slice_id_range.[u8](keys, ast.range_new(b.key_off, b.key_len));
    let ord = cmp_bytes_lex(ka, kb);
    if ord != 0_i32 {
        return ord;
    }
    let ba = slice_id_range.[u8](bodies, ast.range_new(a.body_off, a.body_len));
    let bb = slice_id_range.[u8](bodies, ast.range_new(b.body_off, b.body_len));
    return cmp_bytes_lex(ba, bb);
}

fn sort_dump_entries(keys: *[u8], bodies: *[u8], entries: *mut [DumpEntry]) {
    let n = entries.len;
    if n <= 1_usize {
        return;
    }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third {
        gap = (gap *% 3_usize) +% 1_usize;
    }
    while gap > 0_usize {
        var i = gap;
        while i < n {
            let cur = entries[i];
            var j = i;
            while j >= gap {
                let prev = j - gap;
                if cmp_dump_entries(keys, bodies, entries[prev], cur) <= 0_i32 {
                    break;
                }
                entries[j] = entries[prev];
                j = prev;
            }
            entries[j] = cur;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

fn write_generic_param_names(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    gens: ast.IdRange,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    let ps = env.generic_params_range(gens);
    if ps.len == 0_usize {
        return;
    }
    try out.push_byte_grow(alloc, b'[');
    var i: usize = 0_usize;
    while i < ps.len {
        if i > 0_usize {
            try out.push_str_grow(alloc, ", ");
        }
        try out.push_bytes_grow(alloc, interner.get(ps[i].name));
        i = i +% 1_usize;
    }
    try out.push_byte_grow(alloc, b']');
    return;
}

fn write_fn_sig_canonical(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    qname: *[u8],
    sig: *FnSig,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    if sig.is_pub { try out.push_str_grow(alloc, "pub "); }
    if sig.is_comptime { try out.push_str_grow(alloc, "comptime "); }
    if sig.is_extern { try out.push_str_grow(alloc, "extern "); }
    try out.push_str_grow(alloc, "fn ");
    try out.push_bytes_grow(alloc, qname);
    try write_generic_param_names(env, alloc, sig.generics, interner, out);
    try out.push_byte_grow(alloc, b'(');
    let ps = env.params_range(sig.params);
    var i: usize = 0_usize;
    while i < ps.len {
        if i > 0_usize {
            try out.push_str_grow(alloc, ", ");
        }
        let p = ps[i];
        if p.is_self {
            try out.push_str_grow(alloc, "self");
        } else {
            try out.push_bytes_grow(alloc, interner.get(p.name));
        }
        try out.push_str_grow(alloc, ": ");
        try env.format_ty(alloc, p.ty, prog, interner, out);
        i = i +% 1_usize;
    }
    try out.push_str_grow(alloc, ") -> ");
    try env.format_ty(alloc, sig.ret, prog, interner, out);
    return;
}

fn dump_struct_uninterned(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    meta: *StructMeta,
    qname: *[u8],
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    bodies: *mut str.StrBuf,
) -> !OutOfMemory {
    let fs = env.struct_fields_range(meta.fields);
    var offs = try col.DynBuf.[usize].init(alloc, fs.len +% 1_usize);
    errdefer offs.destroy(alloc);
    var szs = try col.DynBuf.[usize].init(alloc, fs.len +% 1_usize);
    errdefer szs.destroy(alloc);
    var lay = Layout.{ size: 1_usize, align: 1_usize };
    if fs.len > 0_usize {
        var off: usize = 0_usize;
        var max_a: usize = 1_usize;
        var fi: usize = 0_usize;
        while fi < fs.len {
            let l = env.x64_layout(fs[fi].ty);
            let a = if meta.is_packed { 1_usize } else { max_usize(l.align, 1_usize) };
            max_a = max_usize(max_a, a);
            off = align_up_usize(off, a);
            try offs.push(alloc, off);
            try szs.push(alloc, l.size);
            off = off +% max_usize(l.size, 1_usize);
            fi = fi +% 1_usize;
        }
        lay = Layout.{ size: align_up_usize(off, max_a), align: max_a };
    }
    try bodies.push_str_grow(alloc, "struct ");
    try bodies.push_bytes_grow(alloc, qname);
    try write_generic_param_names(env, alloc, meta.generics, interner, bodies);
    try bodies.push_str_grow(alloc, " size=");
    try bodies.push_u64_grow(alloc, lay.size.widen.[u64]());
    try bodies.push_str_grow(alloc, " align=");
    try bodies.push_u64_grow(alloc, lay.align.widen.[u64]());
    try bodies.push_byte_grow(alloc, 10_u8);
    let os = offs.as_slice();
    let ss_sz = szs.as_slice();
    var fi: usize = 0_usize;
    while fi < fs.len && fi < os.len && fi < ss_sz.len {
        try bodies.push_str_grow(alloc, "  field ");
        try bodies.push_bytes_grow(alloc, interner.get(fs[fi].name));
        try bodies.push_str_grow(alloc, ": ");
        try env.format_ty(alloc, fs[fi].ty, prog, interner, bodies);
        try bodies.push_str_grow(alloc, " offset=");
        try bodies.push_u64_grow(alloc, os[fi].widen.[u64]());
        try bodies.push_str_grow(alloc, " size=");
        try bodies.push_u64_grow(alloc, ss_sz[fi].widen.[u64]());
        try bodies.push_byte_grow(alloc, 10_u8);
        fi = fi +% 1_usize;
    }
    szs.destroy(alloc);
    offs.destroy(alloc);
    return;
}

fn push_dump_struct_entries(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    keys: *mut str.StrBuf,
    bodies: *mut str.StrBuf,
    entries: *mut col.DynBuf[DumpEntry],
    qname_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    let ss = env.defs.structs.as_slice();
    var si: usize = 0_usize;
    while si < ss.len {
        let meta = ss[si];
        qname_buf.clear();
        try write_def_qualified_name(alloc, prog, meta.def_id, interner, qname_buf);
        let qname = qname_buf.as_bytes();

        let key_off = keys.len().trunc.[u32]();
        try keys.push_str_grow(alloc, "0:");
        try keys.push_bytes_grow(alloc, qname);
        let key_len = keys.len().trunc.[u32]() -% key_off;

        let body_off = bodies.len().trunc.[u32]();
        if let tid = env.find_struct_empty(meta.def_id) {
            let lay = env.x64_layout(tid);
            try bodies.push_str_grow(alloc, "struct ");
            try bodies.push_bytes_grow(alloc, qname);
            try write_generic_param_names(env, alloc, meta.generics, interner, bodies);
            try bodies.push_str_grow(alloc, " size=");
            try bodies.push_u64_grow(alloc, lay.size.widen.[u64]());
            try bodies.push_str_grow(alloc, " align=");
            try bodies.push_u64_grow(alloc, lay.align.widen.[u64]());
            try bodies.push_byte_grow(alloc, 10_u8);
            let fs = env.struct_fields_range(meta.fields);
            var fi: usize = 0_usize;
            while fi < fs.len {
                let fo = env.struct_field_offset(tid, fi);
                let fsz = env.x64_layout(fo.ty).size;
                try bodies.push_str_grow(alloc, "  field ");
                try bodies.push_bytes_grow(alloc, interner.get(fs[fi].name));
                try bodies.push_str_grow(alloc, ": ");
                try env.format_ty(alloc, fo.ty, prog, interner, bodies);
                try bodies.push_str_grow(alloc, " offset=");
                try bodies.push_u64_grow(alloc, fo.offset.widen.[u64]());
                try bodies.push_str_grow(alloc, " size=");
                try bodies.push_u64_grow(alloc, fsz.widen.[u64]());
                try bodies.push_byte_grow(alloc, 10_u8);
                fi = fi +% 1_usize;
            }
        } else {
            try dump_struct_uninterned(env, alloc, &meta, qname, prog, interner, bodies);
        }
        let body_len = bodies.len().trunc.[u32]() -% body_off;
        try entries.push(
            alloc,
            DumpEntry.{ key_off: key_off, key_len: key_len, body_off: body_off, body_len: body_len },
        );
        si = si +% 1_usize;
    }
    return;
}

fn dump_pool_body(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    meta: *PoolMeta,
    qname: *[u8],
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    bodies: *mut str.StrBuf,
) -> !OutOfMemory {
    let cols = env.pool_cols_range(meta.columns);
    var offs = try col.DynBuf.[usize].init(alloc, cols.len +% 1_usize);
    errdefer offs.destroy(alloc);
    var szs = try col.DynBuf.[usize].init(alloc, cols.len +% 1_usize);
    errdefer szs.destroy(alloc);
    var lay = Layout.{ size: 1_usize, align: 1_usize };
    if cols.len > 0_usize {
        var off: usize = 0_usize;
        var max_a: usize = 1_usize;
        var ci: usize = 0_usize;
        while ci < cols.len {
            let l = env.x64_layout_impl(cols[ci].ty, true);
            let a = max_usize(l.align, 1_usize);
            max_a = max_usize(max_a, a);
            off = align_up_usize(off, a);
            try offs.push(alloc, off);
            try szs.push(alloc, l.size);
            off = off +% max_usize(l.size, 1_usize);
            ci = ci +% 1_usize;
        }
        lay = Layout.{ size: align_up_usize(off, max_a), align: max_a };
    }
    try bodies.push_str_grow(alloc, "pool ");
    try bodies.push_bytes_grow(alloc, qname);
    try write_generic_param_names(env, alloc, meta.generics, interner, bodies);
    try bodies.push_str_grow(alloc, " size=");
    try bodies.push_u64_grow(alloc, lay.size.widen.[u64]());
    try bodies.push_str_grow(alloc, " align=");
    try bodies.push_u64_grow(alloc, lay.align.widen.[u64]());
    try bodies.push_byte_grow(alloc, 10_u8);
    let os = offs.as_slice();
    let cs = szs.as_slice();
    var ci: usize = 0_usize;
    while ci < cols.len && ci < os.len && ci < cs.len {
        try bodies.push_str_grow(alloc, "  field ");
        try bodies.push_bytes_grow(alloc, interner.get(cols[ci].name));
        try bodies.push_str_grow(alloc, ": ");
        try env.format_ty(alloc, cols[ci].ty, prog, interner, bodies);
        try bodies.push_str_grow(alloc, " offset=");
        try bodies.push_u64_grow(alloc, os[ci].widen.[u64]());
        try bodies.push_str_grow(alloc, " size=");
        try bodies.push_u64_grow(alloc, cs[ci].widen.[u64]());
        try bodies.push_byte_grow(alloc, 10_u8);
        ci = ci +% 1_usize;
    }
    szs.destroy(alloc);
    offs.destroy(alloc);
    return;
}

fn push_dump_pool_entries(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    keys: *mut str.StrBuf,
    bodies: *mut str.StrBuf,
    entries: *mut col.DynBuf[DumpEntry],
    qname_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    let ps = env.defs.pools.as_slice();
    var pi: usize = 0_usize;
    while pi < ps.len {
        let meta = ps[pi];
        qname_buf.clear();
        try write_def_qualified_name(alloc, prog, meta.def_id, interner, qname_buf);
        let qname = qname_buf.as_bytes();

        let key_off = keys.len().trunc.[u32]();
        try keys.push_str_grow(alloc, "1:");
        try keys.push_bytes_grow(alloc, qname);
        let key_len = keys.len().trunc.[u32]() -% key_off;

        let body_off = bodies.len().trunc.[u32]();
        try dump_pool_body(env, alloc, &meta, qname, prog, interner, bodies);
        let body_len = bodies.len().trunc.[u32]() -% body_off;
        try entries.push(
            alloc,
            DumpEntry.{ key_off: key_off, key_len: key_len, body_off: body_off, body_len: body_len },
        );
        pi = pi +% 1_usize;
    }
    return;
}

fn push_dump_union_entries(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    keys: *mut str.StrBuf,
    bodies: *mut str.StrBuf,
    entries: *mut col.DynBuf[DumpEntry],
    qname_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    let us = env.defs.unions.as_slice();
    var ui: usize = 0_usize;
    while ui < us.len {
        let meta = us[ui];
        qname_buf.clear();
        try write_def_qualified_name(alloc, prog, meta.def_id, interner, qname_buf);
        let qname = qname_buf.as_bytes();
        let vs = env.union_variants_range(meta.variants);
        var max_psz: usize = 1_usize;
        var max_pa: usize = 1_usize;
        var vi: usize = 0_usize;
        while vi < vs.len {
            if vs[vi].has_payload {
                let l = env.x64_layout(vs[vi].payload);
                max_psz = max_usize(max_psz, max_usize(l.size, 1_usize));
                max_pa = max_usize(max_pa, max_usize(l.align, 1_usize));
            }
            vi = vi +% 1_usize;
        }
        let p_off = align_up_usize(4_usize, max_pa);
        let align = max_usize(max_pa, 4_usize);
        let lay = if let tid = env.find_union_empty(meta.def_id) {
            env.x64_layout(tid)
        } else {
            Layout.{ size: align_up_usize(p_off +% max_psz, align), align: align }
        };

        let key_off = keys.len().trunc.[u32]();
        try keys.push_str_grow(alloc, "2:");
        try keys.push_bytes_grow(alloc, qname);
        let key_len = keys.len().trunc.[u32]() -% key_off;

        let body_off = bodies.len().trunc.[u32]();
        try bodies.push_str_grow(alloc, "union ");
        try bodies.push_bytes_grow(alloc, qname);
        try write_generic_param_names(env, alloc, meta.generics, interner, bodies);
        try bodies.push_str_grow(alloc, " size=");
        try bodies.push_u64_grow(alloc, lay.size.widen.[u64]());
        try bodies.push_str_grow(alloc, " align=");
        try bodies.push_u64_grow(alloc, lay.align.widen.[u64]());
        try bodies.push_byte_grow(alloc, 10_u8);
        var vj: usize = 0_usize;
        while vj < vs.len {
            let v = vs[vj];
            try bodies.push_str_grow(alloc, "  field ");
            try bodies.push_bytes_grow(alloc, interner.get(v.name));
            try bodies.push_str_grow(alloc, ": ");
            if v.has_payload {
                let psz = env.x64_layout(v.payload).size;
                try env.format_ty(alloc, v.payload, prog, interner, bodies);
                try bodies.push_str_grow(alloc, " offset=");
                try bodies.push_u64_grow(alloc, p_off.widen.[u64]());
                try bodies.push_str_grow(alloc, " size=");
                try bodies.push_u64_grow(alloc, psz.widen.[u64]());
            } else {
                try bodies.push_str_grow(alloc, "void offset=");
                try bodies.push_u64_grow(alloc, p_off.widen.[u64]());
                try bodies.push_str_grow(alloc, " size=0");
            }
            try bodies.push_byte_grow(alloc, 10_u8);
            vj = vj +% 1_usize;
        }
        let body_len = bodies.len().trunc.[u32]() -% body_off;
        try entries.push(
            alloc,
            DumpEntry.{ key_off: key_off, key_len: key_len, body_off: body_off, body_len: body_len },
        );
        ui = ui +% 1_usize;
    }
    return;
}

fn push_dump_enum_entries(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    keys: *mut str.StrBuf,
    bodies: *mut str.StrBuf,
    entries: *mut col.DynBuf[DumpEntry],
    qname_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    let es = env.defs.enums.as_slice();
    var ei: usize = 0_usize;
    while ei < es.len {
        let meta = es[ei];
        qname_buf.clear();
        try write_def_qualified_name(alloc, prog, meta.def_id, interner, qname_buf);
        let qname = qname_buf.as_bytes();
        let lay = if let tid = env.find_enum(meta.def_id) {
            env.x64_layout(tid)
        } else {
            Layout.{ size: 4_usize, align: 4_usize }
        };

        let key_off = keys.len().trunc.[u32]();
        try keys.push_str_grow(alloc, "3:");
        try keys.push_bytes_grow(alloc, qname);
        let key_len = keys.len().trunc.[u32]() -% key_off;

        let body_off = bodies.len().trunc.[u32]();
        try bodies.push_str_grow(alloc, "enum ");
        try bodies.push_bytes_grow(alloc, qname);
        try bodies.push_str_grow(alloc, " size=");
        try bodies.push_u64_grow(alloc, lay.size.widen.[u64]());
        try bodies.push_str_grow(alloc, " align=");
        try bodies.push_u64_grow(alloc, lay.align.widen.[u64]());
        try bodies.push_str_grow(alloc, " repr=");
        try env.format_ty(alloc, meta.repr_ty, prog, interner, bodies);
        try bodies.push_byte_grow(alloc, 10_u8);
        let vars = env.enum_variants_range(meta.variants);
        var vi: usize = 0_usize;
        while vi < vars.len {
            try bodies.push_str_grow(alloc, "  variant ");
            try bodies.push_bytes_grow(alloc, interner.get(vars[vi].name));
            try bodies.push_str_grow(alloc, " = ");
            try push_int_val_grow(alloc, vars[vi].val, bodies);
            try bodies.push_byte_grow(alloc, 10_u8);
            vi = vi +% 1_usize;
        }
        let body_len = bodies.len().trunc.[u32]() -% body_off;
        try entries.push(
            alloc,
            DumpEntry.{ key_off: key_off, key_len: key_len, body_off: body_off, body_len: body_len },
        );
        ei = ei +% 1_usize;
    }
    return;
}

fn push_dump_bitfield_entries(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    keys: *mut str.StrBuf,
    bodies: *mut str.StrBuf,
    entries: *mut col.DynBuf[DumpEntry],
    qname_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    let bfs = env.defs.bitfields.as_slice();
    var bi: usize = 0_usize;
    while bi < bfs.len {
        let meta = bfs[bi];
        qname_buf.clear();
        try write_def_qualified_name(alloc, prog, meta.def_id, interner, qname_buf);
        let qname = qname_buf.as_bytes();
        let lay = if let tid = env.find_bitfield(meta.def_id) {
            env.x64_layout(tid)
        } else {
            env.x64_layout(meta.base_ty)
        };

        let key_off = keys.len().trunc.[u32]();
        try keys.push_str_grow(alloc, "4:");
        try keys.push_bytes_grow(alloc, qname);
        let key_len = keys.len().trunc.[u32]() -% key_off;

        let body_off = bodies.len().trunc.[u32]();
        try bodies.push_str_grow(alloc, "bitfield ");
        try bodies.push_bytes_grow(alloc, qname);
        try bodies.push_str_grow(alloc, " size=");
        try bodies.push_u64_grow(alloc, lay.size.widen.[u64]());
        try bodies.push_str_grow(alloc, " align=");
        try bodies.push_u64_grow(alloc, lay.align.widen.[u64]());
        try bodies.push_str_grow(alloc, " base=");
        try env.format_ty(alloc, meta.base_ty, prog, interner, bodies);
        try bodies.push_byte_grow(alloc, 10_u8);
        let ms = env.bitfield_members_range(meta.members);
        var mi: usize = 0_usize;
        while mi < ms.len {
            try bodies.push_str_grow(alloc, "  field ");
            try bodies.push_bytes_grow(alloc, interner.get(ms[mi].name));
            try bodies.push_str_grow(alloc, ": ");
            try env.format_ty(alloc, ms[mi].ty, prog, interner, bodies);
            try bodies.push_str_grow(alloc, " bits=");
            try bodies.push_u64_grow(alloc, ms[mi].lo.widen.[u64]());
            try bodies.push_str_grow(alloc, "..");
            try bodies.push_u64_grow(alloc, ms[mi].hi.widen.[u64]());
            try bodies.push_byte_grow(alloc, 10_u8);
            mi = mi +% 1_usize;
        }
        let body_len = bodies.len().trunc.[u32]() -% body_off;
        try entries.push(
            alloc,
            DumpEntry.{ key_off: key_off, key_len: key_len, body_off: body_off, body_len: body_len },
        );
        bi = bi +% 1_usize;
    }
    return;
}

fn push_dump_fn_entries(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    keys: *mut str.StrBuf,
    bodies: *mut str.StrBuf,
    entries: *mut col.DynBuf[DumpEntry],
    qname_buf: *mut str.StrBuf,
    prefix_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    let fns = env.decls.fns.as_slice();
    var fi: usize = 0_usize;
    while fi < fns.len {
        let sig = fns[fi];
        qname_buf.clear();
        try write_def_qualified_name(alloc, prog, sig.def_id, interner, qname_buf);
        let qname = qname_buf.as_bytes();

        let key_off = keys.len().trunc.[u32]();
        try keys.push_bytes_grow(alloc, qname);
        let key_len = keys.len().trunc.[u32]() -% key_off;

        let body_off = bodies.len().trunc.[u32]();
        try write_fn_sig_canonical(env, alloc, qname, &sig, prog, interner, bodies);
        let body_len = bodies.len().trunc.[u32]() -% body_off;
        try entries.push(
            alloc,
            DumpEntry.{ key_off: key_off, key_len: key_len, body_off: body_off, body_len: body_len },
        );
        fi = fi +% 1_usize;
    }

    let ims = env.decls.impls.as_slice();
    var ii: usize = 0_usize;
    while ii < ims.len {
        let im = ims[ii];
        prefix_buf.clear();
        if im.target.kind == .Def {
            try write_def_qualified_name(alloc, prog, im.target.def_id, interner, prefix_buf);
        } else {
            try resolve.write_builtin_debug(
                alloc, resolve.encode_builtin_simple(im.target.builtin), prefix_buf,
            );
        }
        if im.has_iface {
            try prefix_buf.push_byte_grow(alloc, b'(');
            try write_def_qualified_name(alloc, prog, im.iface_def, interner, prefix_buf);
            try prefix_buf.push_byte_grow(alloc, b')');
        }
        let pfx = prefix_buf.as_bytes();
        let ms = env.impl_methods_range(im.methods);
        var mi: usize = 0_usize;
        while mi < ms.len {
            let msig = ms[mi].sig;
            qname_buf.clear();
            try qname_buf.push_bytes_grow(alloc, pfx);
            try qname_buf.push_byte_grow(alloc, b'.');
            try qname_buf.push_bytes_grow(alloc, interner.get(msig.name));
            let qname = qname_buf.as_bytes();

            let key_off = keys.len().trunc.[u32]();
            try keys.push_bytes_grow(alloc, qname);
            let key_len = keys.len().trunc.[u32]() -% key_off;

            let body_off = bodies.len().trunc.[u32]();
            try write_fn_sig_canonical(env, alloc, qname, &msig, prog, interner, bodies);
            let body_len = bodies.len().trunc.[u32]() -% body_off;
            try entries.push(
                alloc,
                DumpEntry.{ key_off: key_off, key_len: key_len, body_off: body_off, body_len: body_len },
            );
            mi = mi +% 1_usize;
        }
        ii = ii +% 1_usize;
    }
    return;
}

fn dump_types_section(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    qname_buf: *mut str.StrBuf,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    var t_keys = try str.StrBuf.init(alloc, 512_usize);
    errdefer t_keys.destroy(alloc);
    var t_bodies = try str.StrBuf.init(alloc, 2048_usize);
    errdefer t_bodies.destroy(alloc);
    var t_entries = try col.DynBuf.[DumpEntry].init(alloc, 32_usize);
    errdefer t_entries.destroy(alloc);

    try push_dump_struct_entries(env, alloc, prog, interner, &mut t_keys, &mut t_bodies, &mut t_entries, qname_buf);
    try push_dump_pool_entries(env, alloc, prog, interner, &mut t_keys, &mut t_bodies, &mut t_entries, qname_buf);
    try push_dump_union_entries(env, alloc, prog, interner, &mut t_keys, &mut t_bodies, &mut t_entries, qname_buf);
    try push_dump_enum_entries(env, alloc, prog, interner, &mut t_keys, &mut t_bodies, &mut t_entries, qname_buf);
    try push_dump_bitfield_entries(env, alloc, prog, interner, &mut t_keys, &mut t_bodies, &mut t_entries, qname_buf);

    sort_dump_entries(t_keys.as_bytes(), t_bodies.as_bytes(), t_entries.as_mut_slice());
    let tb = t_bodies.as_bytes();
    let tes = t_entries.as_slice();
    var ti: usize = 0_usize;
    while ti < tes.len {
        let e = tes[ti];
        try out.push_bytes_grow(alloc, slice_id_range.[u8](tb, ast.range_new(e.body_off, e.body_len)));
        ti = ti +% 1_usize;
    }
    t_entries.destroy(alloc);
    t_bodies.destroy(alloc);
    t_keys.destroy(alloc);
    return;
}

fn dump_fns_section(
    env: *TypeEnv,
    alloc: *mut AllocCap,
    prog: *resolve.ResolvedProgram,
    interner: *span.SymInterner,
    qname_buf: *mut str.StrBuf,
    prefix_buf: *mut str.StrBuf,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    var f_keys = try str.StrBuf.init(alloc, 512_usize);
    errdefer f_keys.destroy(alloc);
    var f_bodies = try str.StrBuf.init(alloc, 2048_usize);
    errdefer f_bodies.destroy(alloc);
    var f_entries = try col.DynBuf.[DumpEntry].init(alloc, 64_usize);
    errdefer f_entries.destroy(alloc);

    try push_dump_fn_entries(
        env, alloc, prog, interner, &mut f_keys, &mut f_bodies, &mut f_entries, qname_buf, prefix_buf,
    );
    sort_dump_entries(f_keys.as_bytes(), f_bodies.as_bytes(), f_entries.as_mut_slice());
    let fb = f_bodies.as_bytes();
    let fes = f_entries.as_slice();
    var fi: usize = 0_usize;
    while fi < fes.len {
        let e = fes[fi];
        try out.push_bytes_grow(alloc, slice_id_range.[u8](fb, ast.range_new(e.body_off, e.body_len)));
        try out.push_byte_grow(alloc, 10_u8);
        fi = fi +% 1_usize;
    }
    f_entries.destroy(alloc);
    f_bodies.destroy(alloc);
    f_keys.destroy(alloc);
    return;
}

impl TypeEnv {
    /// Canonical type dump matching `compiler/src/types.rs::dump_types_canonical` byte-for-byte.
    pub fn dump_types_canonical(
        self: *Self,
        alloc: *mut AllocCap,
        prog: *resolve.ResolvedProgram,
        interner: *span.SymInterner,
        out: *mut str.StrBuf,
    ) -> !OutOfMemory {
        var qname_buf = try str.StrBuf.init(alloc, 128_usize);
        errdefer qname_buf.destroy(alloc);
        var prefix_buf = try str.StrBuf.init(alloc, 128_usize);
        errdefer prefix_buf.destroy(alloc);

        try dump_types_section(self, alloc, prog, interner, &mut qname_buf, out);
        try dump_fns_section(self, alloc, prog, interner, &mut qname_buf, &mut prefix_buf, out);

        prefix_buf.destroy(alloc);
        qname_buf.destroy(alloc);
        return;
    }
}
