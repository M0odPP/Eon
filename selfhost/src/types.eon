pub linear struct GenericCtx {
    pub params: col.DynBuf[GenericCtxParam];
    pub has_self_ty: bool;
    pub self_ty: TyId;
    pub comptime_vals: col.DynBuf[ComptimeBinding];
}

impl GenericCtx {
    pub fn init(alloc: *mut AllocCap) -> GenericCtx ! OutOfMemory {
        let params = try col.DynBuf.[GenericCtxParam].init(alloc, 4_usize);
        errdefer params.destroy(alloc);
        let comptime_vals = try col.DynBuf.[ComptimeBinding].init(alloc, 4_usize);
        errdefer comptime_vals.destroy(alloc);
        return GenericCtx.{
            params: params,
            has_self_ty: false,
            self_ty: TY_ERROR,
            comptime_vals: comptime_vals,
        };
    }

    pub fn clone_from(alloc: *mut AllocCap, src: *GenericCtx) -> GenericCtx ! OutOfMemory {
        var out = try GenericCtx.init(alloc);
        errdefer out.destroy(alloc);
        try out.params.push_slice(alloc, src.params.as_slice());
        try out.comptime_vals.push_slice(alloc, src.comptime_vals.as_slice());
        out.has_self_ty = src.has_self_ty;
        out.self_ty = src.self_ty;
        return out;
    }

    pub fn find_param(self: *Self, name: u32) -> ?GenericCtxParam {
        let ps = self.params.as_slice();
        var i: usize = 0_usize;
        while i < ps.len {
            if ps[i].name == name {
                return ps[i];
            }
            i = i +% 1_usize;
        }
        return null;
    }

    pub fn find_comptime_val(self: *Self, name: u32) -> ?IntVal {
        let vs = self.comptime_vals.as_slice();
        var i: usize = 0_usize;
        while i < vs.len {
            if vs[i].name == name {
                return vs[i].val;
            }
            i = i +% 1_usize;
        }
        return null;
    }

    pub fn destroy(self: GenericCtx, alloc: *mut AllocCap) {
        let GenericCtx.{ params, has_self_ty: _, self_ty: _, comptime_vals } = self;
        params.destroy(alloc);
        comptime_vals.destroy(alloc);
    }
}

pub struct PathTarget {
