// ===========================================================================
// Section 1: Type IDs, Pre-Interned Constants, and Exact 128-bit Integers
// ===========================================================================

pub type TyId = u32;

pub const TY_NONE: TyId = 4294967295_u32;

// Pre-interned TyId constants matching `compiler/src/types.rs` (0..=34)
pub const TY_VOID: TyId = 0_u32;
pub const TY_NEVER: TyId = 1_u32;
pub const TY_BOOL: TyId = 2_u32;
pub const TY_CHAR: TyId = 3_u32;
pub const TY_STR: TyId = 4_u32;
pub const TY_TYPE_TYPE: TyId = 5_u32;
pub const TY_COMPTIME_INT: TyId = 6_u32;
pub const TY_COMPTIME_FLOAT: TyId = 7_u32;
pub const TY_U8: TyId = 8_u32;
pub const TY_U16: TyId = 9_u32;
pub const TY_U32: TyId = 10_u32;
pub const TY_U64: TyId = 11_u32;
pub const TY_U128: TyId = 12_u32;
pub const TY_USIZE: TyId = 13_u32;
pub const TY_I8: TyId = 14_u32;
pub const TY_I16: TyId = 15_u32;
pub const TY_I32: TyId = 16_u32;
pub const TY_I64: TyId = 17_u32;
pub const TY_I128: TyId = 18_u32;
pub const TY_ISIZE: TyId = 19_u32;
pub const TY_F16: TyId = 20_u32;
pub const TY_F32: TyId = 21_u32;
pub const TY_F64: TyId = 22_u32;
pub const TY_PHYS_ADDR: TyId = 23_u32;
pub const TY_VIRT_ADDR: TyId = 24_u32;
pub const TY_DMA_ADDR: TyId = 25_u32;
pub const TY_ORDERING: TyId = 26_u32;
pub const TY_ARITH_ERROR: TyId = 27_u32;
pub const TY_BOUNDS_ERROR: TyId = 28_u32;
pub const TY_UTF8_ERROR: TyId = 29_u32;
pub const TY_OUT_OF_MEMORY: TyId = 30_u32;
pub const TY_ERROR: TyId = 31_u32;
pub const TY_MEM_ERROR: TyId = 32_u32;
pub const TY_STALE_ID: TyId = 33_u32;
pub const TY_IO_ERROR: TyId = 34_u32;

/// Exact two's-complement 128-bit signed integer represented in 64-bit limbs.
pub struct IntVal {
    pub lo: u64;
    pub hi: i64;
}

pub struct U128Val {
    pub lo: u64;
    pub hi: u64;
}

pub struct IntBounds {
    pub valid: bool;
    pub has_max: bool;
    pub min: IntVal;
    pub max: IntVal;
}

pub fn int_val_zero() -> IntVal {
    return IntVal.{ lo: 0_u64, hi: 0_i64 };
}

pub fn int_val_from_u64(v: u64) -> IntVal {
    return IntVal.{ lo: v, hi: 0_i64 };
}

pub fn int_val_from_i64(v: i64) -> IntVal {
    let hi: i64 = if v < 0_i64 { -1_i64 } else { 0_i64 };
    return IntVal.{ lo: v.bitcast.[u64](), hi: hi };
}

pub fn int_val_min_i128() -> IntVal {
    return IntVal.{ lo: 0_u64, hi: 0x8000000000000000_u64.bitcast.[i64]() };
}

pub fn int_val_max_i128() -> IntVal {
    return IntVal.{ lo: 0xFFFFFFFFFFFFFFFF_u64, hi: 0x7FFFFFFFFFFFFFFF_i64 };
}

pub fn int_val_eq(a: IntVal, b: IntVal) -> bool {
    return a.lo == b.lo && a.hi == b.hi;
}

pub fn int_val_cmp(a: IntVal, b: IntVal) -> i32 {
    if a.hi < b.hi {
        return -1_i32;
    }
    if a.hi > b.hi {
        return 1_i32;
    }
    if a.lo < b.lo {
        return -1_i32;
    }
    if a.lo > b.lo {
        return 1_i32;
    }
    return 0_i32;
}

pub fn int_val_is_neg(v: IntVal) -> bool {
    return v.hi < 0_i64;
}

pub fn int_val_is_zero(v: IntVal) -> bool {
    return v.lo == 0_u64 && v.hi == 0_i64;
}

pub fn int_val_to_u64(v: IntVal) -> ?u64 {
    if v.hi == 0_i64 {
        return v.lo;
    }
    return null;
}

pub fn int_val_to_i64(v: IntVal) -> ?i64 {
    if v.hi == 0_i64 && v.lo <= 0x7FFFFFFFFFFFFFFF_u64 {
        return v.lo.bitcast.[i64]();
    }
    if v.hi == -1_i64 && v.lo >= 0x8000000000000000_u64 {
        return v.lo.bitcast.[i64]();
    }
    return null;
}

fn u128_add(a: U128Val, b: U128Val) -> ?U128Val {
    let lo = a.lo +% b.lo;
    let carry: u64 = if lo < a.lo { 1_u64 } else { 0_u64 };
    let h1 = a.hi +% b.hi;
    if h1 < a.hi {
        return null;
    }
    let hi = h1 +% carry;
    if hi < h1 {
        return null;
    }
    return U128Val.{ lo: lo, hi: hi };
}

fn u128_mul_u64(a: U128Val, b: u64) -> ?U128Val {
    let a_lo0 = a.lo & 0xFFFFFFFF_u64;
    let a_lo1 = a.lo >> 32_u64;
    let b0 = b & 0xFFFFFFFF_u64;
    let b1 = b >> 32_u64;

    let p00 = a_lo0 *% b0;
    let p01 = a_lo0 *% b1;
    let p10 = a_lo1 *% b0;
    let p11 = a_lo1 *% b1;

    let mid = (p00 >> 32_u64) +% (p01 & 0xFFFFFFFF_u64) +% (p10 & 0xFFFFFFFF_u64);
    let lo = (p00 & 0xFFFFFFFF_u64) | (mid <<% 32_u64);
    let carry_lo = p11 +% (p01 >> 32_u64) +% (p10 >> 32_u64) +% (mid >> 32_u64);

    if a.hi != 0_u64 && b != 0_u64 {
        let hi_prod = (a.hi *? b) catch {
            return null;
        };
        let hi = (hi_prod +? carry_lo) catch {
            return null;
        };
        return U128Val.{ lo: lo, hi: hi };
    }
    return U128Val.{ lo: lo, hi: carry_lo };
}

fn u128_mul_checked(a: U128Val, b: U128Val) -> ?U128Val {
    if a.hi != 0_u64 && b.hi != 0_u64 {
        return null;
    }
    if b.hi == 0_u64 {
        return u128_mul_u64(a, b.lo);
    }
    return u128_mul_u64(b, a.lo);
}

fn u128_ge(a: U128Val, b: U128Val) -> bool {
    if a.hi != b.hi {
        return a.hi > b.hi;
    }
    return a.lo >= b.lo;
}

fn u128_sub_wrap(a: U128Val, b: U128Val) -> U128Val {
    let lo = a.lo -% b.lo;
    let borrow: u64 = if a.lo < b.lo { 1_u64 } else { 0_u64 };
    return U128Val.{ lo: lo, hi: a.hi -% b.hi -% borrow };
}

struct U128DivMod {
    q: U128Val;
    r: U128Val;
}

fn u128_divmod(n: U128Val, d: U128Val) -> U128DivMod {
    var q = U128Val.{ lo: 0_u64, hi: 0_u64 };
    var r = U128Val.{ lo: 0_u64, hi: 0_u64 };
    var i: u32 = 128_u32;
    while i > 0_u32 {
        i = i -% 1_u32;
        let bit: u64 = if i >= 64_u32 {
            (n.hi >> (i -% 64_u32).widen.[u64]()) & 1_u64
        } else {
            (n.lo >> i.widen.[u64]()) & 1_u64
        };
        r = U128Val.{
            lo: (r.lo <<% 1_u64) | bit,
            hi: (r.hi <<% 1_u64) | (r.lo >> 63_u64),
        };
        if u128_ge(r, d) {
            r = u128_sub_wrap(r, d);
            if i >= 64_u32 {
                q.hi = q.hi | (1_u64 <<% (i -% 64_u32).widen.[u64]());
            } else {
                q.lo = q.lo | (1_u64 <<% i.widen.[u64]());
            }
        }
    }
    return U128DivMod.{ q: q, r: r };
}

fn int_val_abs_u128(v: IntVal) -> U128Val {
    if v.hi >= 0_i64 {
        return U128Val.{ lo: v.lo, hi: v.hi.bitcast.[u64]() };
    }
    let inv_lo = ~v.lo;
    let inv_hi = ~(v.hi.bitcast.[u64]());
    let lo = inv_lo +% 1_u64;
    let carry: u64 = if lo == 0_u64 { 1_u64 } else { 0_u64 };
    return U128Val.{ lo: lo, hi: inv_hi +% carry };
}

fn u128_to_signed(mag: U128Val, neg: bool) -> ?IntVal {
    if !neg {
        if mag.hi >= 0x8000000000000000_u64 {
            return null;
        }
        return IntVal.{ lo: mag.lo, hi: mag.hi.bitcast.[i64]() };
    }
    if mag.hi > 0x8000000000000000_u64 {
        return null;
    }
    if mag.hi == 0x8000000000000000_u64 && mag.lo != 0_u64 {
        return null;
    }
    let inv_lo = ~mag.lo;
    let inv_hi = ~mag.hi;
    let lo = inv_lo +% 1_u64;
    let carry: u64 = if lo == 0_u64 { 1_u64 } else { 0_u64 };
    return IntVal.{ lo: lo, hi: (inv_hi +% carry).bitcast.[i64]() };
}

pub fn int_val_checked_neg(v: IntVal) -> ?IntVal {
    if v.lo == 0_u64 && v.hi.bitcast.[u64]() == 0x8000000000000000_u64 {
        return null;
    }
    let inv_lo = ~v.lo;
    let inv_hi = ~(v.hi.bitcast.[u64]());
    let lo = inv_lo +% 1_u64;
    let carry: u64 = if lo == 0_u64 { 1_u64 } else { 0_u64 };
    return IntVal.{ lo: lo, hi: (inv_hi +% carry).bitcast.[i64]() };
}

pub fn int_val_checked_add(a: IntVal, b: IntVal) -> ?IntVal {
    let lo = a.lo +% b.lo;
    let carry: i64 = if lo < a.lo { 1_i64 } else { 0_i64 };
    let hi = a.hi +% b.hi +% carry;
    let a_neg = a.hi < 0_i64;
    let b_neg = b.hi < 0_i64;
    let r_neg = hi < 0_i64;
    if a_neg == b_neg && r_neg != a_neg {
        return null;
    }
    return IntVal.{ lo: lo, hi: hi };
}

pub fn int_val_checked_sub(a: IntVal, b: IntVal) -> ?IntVal {
    let lo = a.lo -% b.lo;
    let borrow: i64 = if a.lo < b.lo { 1_i64 } else { 0_i64 };
    let hi = a.hi -% b.hi -% borrow;
    let a_neg = a.hi < 0_i64;
    let b_neg = b.hi < 0_i64;
    let r_neg = hi < 0_i64;
    if a_neg != b_neg && r_neg != a_neg {
        return null;
    }
    return IntVal.{ lo: lo, hi: hi };
}

pub fn int_val_checked_mul(a: IntVal, b: IntVal) -> ?IntVal {
    let neg = (a.hi < 0_i64) != (b.hi < 0_i64);
    let ma = int_val_abs_u128(a);
    let mb = int_val_abs_u128(b);
    let prod = u128_mul_checked(ma, mb) orelse {
        return null;
    };
    return u128_to_signed(prod, neg);
}

pub fn int_val_checked_div(a: IntVal, b: IntVal) -> ?IntVal {
    if int_val_is_zero(b) {
        return null;
    }
    if a.lo == 0_u64 && a.hi.bitcast.[u64]() == 0x8000000000000000_u64
        && b.lo == 0xFFFFFFFFFFFFFFFF_u64 && b.hi == -1_i64
    {
        return null;
    }
    let neg = (a.hi < 0_i64) != (b.hi < 0_i64);
    let dm = u128_divmod(int_val_abs_u128(a), int_val_abs_u128(b));
    return u128_to_signed(dm.q, neg);
}

pub fn int_val_checked_rem(a: IntVal, b: IntVal) -> ?IntVal {
    if int_val_is_zero(b) {
        return null;
    }
    if a.lo == 0_u64 && a.hi.bitcast.[u64]() == 0x8000000000000000_u64
        && b.lo == 0xFFFFFFFFFFFFFFFF_u64 && b.hi == -1_i64
    {
        return null;
    }
    let neg = a.hi < 0_i64;
    let dm = u128_divmod(int_val_abs_u128(a), int_val_abs_u128(b));
    return u128_to_signed(dm.r, neg);
}

pub fn int_val_shl(a: IntVal, shift: u32) -> IntVal {
    let s = shift & 127_u32;
    if s == 0_u32 {
        return a;
    }
    if s >= 64_u32 {
        let hi = (a.lo <<% (s -% 64_u32).widen.[u64]()).bitcast.[i64]();
        return IntVal.{ lo: 0_u64, hi: hi };
    }
    let su = s.widen.[u64]();
    let lo = a.lo <<% su;
    let hi_u = (a.hi.bitcast.[u64]() <<% su) | (a.lo >> (64_u64 -% su));
    return IntVal.{ lo: lo, hi: hi_u.bitcast.[i64]() };
}

pub fn int_val_shr(a: IntVal, shift: u32) -> IntVal {
    let s = shift & 127_u32;
    if s == 0_u32 {
        return a;
    }
    if s >= 64_u32 {
        let si = (s -% 64_u32).widen.[i64]() & 63_i64;
        let lo = (a.hi >> si).bitcast.[u64]();
        let hi: i64 = if a.hi < 0_i64 { -1_i64 } else { 0_i64 };
        return IntVal.{ lo: lo, hi: hi };
    }
    let su = s.widen.[u64]() & 63_u64;
    let si = s.widen.[i64]() & 63_i64;
    let lo = (a.lo >> su) | (a.hi.bitcast.[u64]() <<% (64_u64 -% su));
    let hi = a.hi >> si;
    return IntVal.{ lo: lo, hi: hi };
}

pub fn push_int_val_grow(
    alloc: *mut AllocCap,
    v: IntVal,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    if v.hi == 0_i64 {
        try out.push_u64_grow(alloc, v.lo);
        return;
    }
    if let small = int_val_to_i64(v) {
        try out.push_i64_grow(alloc, small);
        return;
    }
    if v.hi < 0_i64 {
        try out.push_byte_grow(alloc, b'-');
    }
    var cur = int_val_abs_u128(v);
    let ten = U128Val.{ lo: 10_u64, hi: 0_u64 };
    var digits: [40]u8 = [0_u8; 40];
    var count: usize = 0_usize;
    while (cur.hi != 0_u64 || cur.lo != 0_u64) && count < 40_usize {
        let dm = u128_divmod(cur, ten);
        digits[count] = b'0' +% dm.r.lo.trunc.[u8]();
        cur = dm.q;
        count = count +% 1_usize;
    }
    if count == 0_usize {
        try out.push_byte_grow(alloc, b'0');
        return;
    }
    var idx = count;
    while idx > 0_usize {
        idx = idx - 1_usize;
        if idx < 40_usize {
            try out.push_byte_grow(alloc, digits[idx]);
        }
    }
    return;
}

pub fn parse_int_literal_u128(bytes: *[u8]) -> ?U128Val {
    var radix: u64 = 10_u64;
    var start: usize = 0_usize;
    if bytes.len >= 2_usize && bytes[0_usize] == b'0' {
        let p = bytes[1_usize];
        if p == b'x' {
            radix = 16_u64;
            start = 2_usize;
        } else if p == b'b' {
            radix = 2_u64;
            start = 2_usize;
        } else if p == b'o' {
            radix = 8_u64;
            start = 2_usize;
        }
    }
    var acc = U128Val.{ lo: 0_u64, hi: 0_u64 };
    var i = start;
    while i < bytes.len {
        let b = bytes[i];
        if b == b'_' {
            i = i +% 1_usize;
            continue;
        }
        var d: u64 = 0_u64;
        if b >= b'0' && b <= b'9' {
            d = (b - b'0').widen.[u64]();
        } else if b >= b'a' && b <= b'f' {
            d = (b - b'a').widen.[u64]() +% 10_u64;
        } else if b >= b'A' && b <= b'F' {
            d = (b - b'A').widen.[u64]() +% 10_u64;
        } else {
            return null;
        }
        if d >= radix {
            return null;
        }
        let mul = u128_mul_u64(acc, radix) orelse {
            return null;
        };
        acc = u128_add(mul, U128Val.{ lo: d, hi: 0_u64 }) orelse {
            return null;
        };
        i = i +% 1_usize;
    }
    return acc;
}

// ===========================================================================
// Section 2: Type IR Enums & Structs
// ===========================================================================

pub enum TyKind : u8 {
    Error = 0,
    Void = 1,
    Never = 2,
    Bool = 3,
    Char = 4,
    Int = 5,
    Float = 6,
    Str = 7,
    TypeType = 8,
    PhysAddr = 9,
    VirtAddr = 10,
    DmaAddr = 11,
    ComptimeInt = 12,
    ComptimeFloat = 13,
    RawPtr = 14,
    Borrow = 15,
    Optional = 16,
    ErrorUnion = 17,
    ErrorSet = 18,
    Array = 19,
    Tuple = 20,
    AnonStruct = 21,
    Struct = 22,
    Pool = 23,
    Enum = 24,
    Union = 25,
    Bitfield = 26,
    Dyn = 27,
    FnPtr = 28,
    Vec = 29,
    Builtin = 30,
    GenericParam = 31,
}

pub enum BuiltinErrorKind : u8 {
    ArithError = 0,
    BoundsError = 1,
    Utf8Error = 2,
    OutOfMemory = 3,
    MemError = 4,
    StaleId = 5,
    IoError = 6,
}

pub enum ErrorSourceKind : u8 {
    User = 0,
    Builtin = 1,
}

pub struct ErrorSource {
    pub kind: ErrorSourceKind;
    pub def_id: u32;
    pub builtin: BuiltinErrorKind;
}

pub fn err_src_user(def_id: u32) -> ErrorSource {
    return ErrorSource.{ kind: .User, def_id: def_id, builtin: .ArithError };
}

pub fn err_src_builtin(b: BuiltinErrorKind) -> ErrorSource {
    return ErrorSource.{ kind: .Builtin, def_id: 0_u32, builtin: b };
}

pub enum BorrowInnerKind : u8 {
    Single = 0,
    Slice = 1,
    Str = 2,
}

pub enum GenericValKind : u8 {
    Ty = 0,
    Int = 1,
    Variant = 2,
}

pub struct GenericVal {
    pub kind: GenericValKind;
    pub id: u32;
    pub int_val: IntVal;
}

pub fn gval_ty(ty: TyId) -> GenericVal {
    return GenericVal.{ kind: .Ty, id: ty, int_val: int_val_zero() };
}

pub fn gval_int(v: IntVal) -> GenericVal {
    return GenericVal.{ kind: .Int, id: 0_u32, int_val: v };
}

pub fn gval_variant(sym: u32) -> GenericVal {
    return GenericVal.{ kind: .Variant, id: sym, int_val: int_val_zero() };
}

pub struct AnonField {
    pub name: u32;
    pub ty: TyId;
}

pub enum PoolHandleKindTag : u8 {
    ArenaPool = 0,
    SlotPool = 1,
}

pub struct PoolHandleKind {
    pub tag: PoolHandleKindTag;
    pub brand: u32;
}

pub struct TyNode {
    pub kind: TyKind;
    pub flag0: bool;
    pub flag1: bool;
    pub u8_val: u8;
    pub borrow_kind: BorrowInnerKind;
    pub builtin_kind: resolve.BuiltinKind;
    pub primary: u32;
    pub aux: u32;
    pub list_start: u32;
    pub list_len: u32;
    pub u64_val: u64;
}

pub fn ty_node_zero(kind: TyKind) -> TyNode {
    return TyNode.{
        kind: kind,
        flag0: false,
        flag1: false,
        u8_val: 0_u8,
        borrow_kind: .Single,
        builtin_kind: .Prim,
        primary: 0_u32,
        aux: 0_u32,
        list_start: 0_u32,
        list_len: 0_u32,
        u64_val: 0_u64,
    };
}

// ===========================================================================
// Section 3: Layout, Niche, and Declaration Metadata Structs
// ===========================================================================

pub struct Layout {
    pub size: usize;
    pub align: usize;
}

pub struct EonLayout {
    pub size: u64;
    pub align: u64;
    pub has_niche: bool;
}

pub struct FieldOffTy {
    pub offset: usize;
    pub ty: TyId;
}

pub enum OptNicheKind : u8 {
    None = 0,
    IdBrand = 1,
    GenId = 2,
    Link = 3,
    NullPtr = 4,
    FatPtrNullFirst = 5,
    SliceMaxLen = 6,
    BoolTag = 7,
    ScalarSentinel = 8,
}

pub struct OptNiche {
    pub kind: OptNicheKind;
    pub size: usize;
    pub sentinel: u64;
}

pub enum StructLayoutMode : u8 {
    Eon = 0,
    C = 1,
    Std430 = 2,
}

pub struct FieldMeta {
    pub name: u32;
    pub span: span.Span;
    pub is_pub: bool;
    pub ty: TyId;
    pub has_default: bool;
    pub has_explicit_offset: bool;
    pub offset: u64;
    pub misaligned_in_packed: bool;
}

pub struct StructMeta {
    pub def_id: u32;
    pub module_id: u32;
    pub is_linear: bool;
    pub is_view: bool;
    pub layout_mode: StructLayoutMode;
    pub is_packed: bool;
    pub has_explicit_align: bool;
    pub explicit_align: u64;
    pub generics: ast.IdRange;
    pub fields: ast.IdRange;
    pub layout: EonLayout;
}

pub struct PoolColumnMeta {
    pub name: u32;
    pub span: span.Span;
    pub is_pub: bool;
    pub ty: TyId;
    pub elem_layout: EonLayout;
    pub col_align: u64;
}

pub struct PoolMeta {
    pub def_id: u32;
    pub module_id: u32;
    pub generics: ast.IdRange;
    pub columns: ast.IdRange;
}

pub struct EnumVariantMeta {
    pub name: u32;
    pub val: IntVal;
}

pub struct EnumMeta {
    pub def_id: u32;
    pub repr_ty: TyId;
    pub variants: ast.IdRange;
    pub has_niche: bool;
}

pub struct UnionVariantMeta {
    pub name: u32;
    pub span: span.Span;
    pub has_payload: bool;
    pub payload: TyId;
}

pub struct UnionMeta {
    pub def_id: u32;
    pub is_linear: bool;
    pub generics: ast.IdRange;
    pub variants: ast.IdRange;
    pub layout: EonLayout;
}

pub struct BitfieldMemberMeta {
    pub name: u32;
    pub span: span.Span;
    pub ty: TyId;
    pub lo: u8;
    pub hi: u8;
}

pub struct BitfieldMeta {
    pub def_id: u32;
    pub base_ty: TyId;
    pub base_bits: u8;
    pub members: ast.IdRange;
}

pub struct ErrorMeta {
    pub def_id: u32;
    pub variants: ast.IdRange;
}

pub struct GenericParamMeta {
    pub name: u32;
    pub is_comptime: bool;
    pub has_comptime_ty: bool;
    pub comptime_ty: TyId;
    pub bounds: ast.IdRange;
    pub builtin_ord: bool;
    pub builtin_eq: bool;
}

