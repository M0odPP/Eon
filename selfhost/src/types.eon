        return slice_id_range.[EnumVariantMeta](self.defs.enum_variants.as_slice(), r);
    }

    pub view fn union_variants_range(self: *Self, r: ast.IdRange) -> *[UnionVariantMeta] {
        return slice_id_range.[UnionVariantMeta](self.defs.union_variants.as_slice(), r);
    }

    pub view fn bitfield_members_range(self: *Self, r: ast.IdRange) -> *[BitfieldMemberMeta] {
        return slice_id_range.[BitfieldMemberMeta](self.defs.bitfield_members.as_slice(), r);
    }

    pub view fn error_variants_range(self: *Self, r: ast.IdRange) -> *[u32] {
        return slice_id_range.[u32](self.decls.error_variants.as_slice(), r);
    }

