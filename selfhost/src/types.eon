    pub view fn generic_bounds_range(self: *Self, r: ast.IdRange) -> *[u32] {
        return slice_id_range.[u32](self.sigs.generic_bounds.as_slice(), r);
    }

    pub view fn params_range(self: *Self, r: ast.IdRange) -> *[ParamSig] {
        return slice_id_range.[ParamSig](self.sigs.params.as_slice(), r);
