        return null;
    }

    pub view fn get_iface(self: *Self, def_id: u32) -> ?*IfaceMeta {
        if let idx = self.index.iface_by_def.get(def_id.widen.[u64]()) {
            return self.decls.ifaces.get(idx.widen.[usize]());
        }
        return null;
    }

    pub view fn get_type_alias(self: *Self, def_id: u32) -> ?*TypeAliasMeta {
        if let idx = self.index.alias_by_def.get(def_id.widen.[u64]()) {
            return self.decls.type_aliases.get(idx.widen.[usize]());
