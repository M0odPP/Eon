    pub view fn sys_access_cols_range(self: *Self, r: ast.IdRange) -> *[u32] {
        return slice_id_range.[u32](self.sigs.sys_access_cols.as_slice(), r);
    }

    // --- Core Collision-Safe Structural Interning Primitives ---

    fn commit_interned(self: *mut Self, alloc: *mut AllocCap, h: u64, node: TyNode) -> TyId ! OutOfMemory {
        let new_id = self.intern.nodes.len().trunc.[u32]();
        let prev = self.intern.intern_head.get(h) orelse TY_NONE;
        try self.intern.nodes.push(alloc, node);
        try self.intern.intern_next.push(alloc, prev);
        try self.intern.intern_head.insert(alloc, h, new_id);
        return new_id;
    }

    fn find_simple_node(self: *Self, cand: *TyNode) -> ?TyId {
        let h = hash_ty_node_base(cand, 0_u32);
        let head = self.intern.intern_head.get(h) orelse {
            return null;
        };
        let ns = self.intern.nodes.as_slice();
        let nexts = self.intern.intern_next.as_slice();
        var cur = head;
        while cur != TY_NONE {
            let idx = cur.widen.[usize]();
            if idx >= ns.len || idx >= nexts.len {
                break;
            }
            let ex = ns[idx];
            if ex.list_len == 0_u32 && ty_node_scalar_eq(&ex, cand) {
                return cur;
            }
            cur = nexts[idx];
        }
        return null;
    }

    fn intern_simple_node(self: *mut Self, alloc: *mut AllocCap, cand: TyNode) -> TyId ! OutOfMemory {
        if let existing = self.find_simple_node(&cand) {
            return existing;
        }
        let h = hash_ty_node_base(&cand, 0_u32);
        return try self.commit_interned(alloc, h, cand);
    }

    fn find_ty_list_node(self: *Self, cand: *TyNode, tys: *[TyId]) -> ?TyId {
        var h = hash_ty_node_base(cand, tys.len.trunc.[u32]());
        var i: usize = 0_usize;
        while i < tys.len {
            h = fnv_u32(h, tys[i]);
            i = i +% 1_usize;
        }
        let head = self.intern.intern_head.get(h) orelse {
            return null;
        };
        let ns = self.intern.nodes.as_slice();
        let nexts = self.intern.intern_next.as_slice();
        let all = self.intern.ty_list.as_slice();
        var cur = head;
        while cur != TY_NONE {
            let idx = cur.widen.[usize]();
            if idx >= ns.len || idx >= nexts.len {
                break;
            }
            let ex = ns[idx];
            if ex.list_len.widen.[usize]() == tys.len && ty_node_scalar_eq(&ex, cand) {
                let slice = slice_id_range.[TyId](all, ast.range_new(ex.list_start, ex.list_len));
                var eq = slice.len == tys.len;
                var k: usize = 0_usize;
                while eq && k < tys.len && k < slice.len {
                    if slice[k] != tys[k] {
                        eq = false;
                    }
                    k = k +% 1_usize;
                }
                if eq {
                    return cur;
                }
            }
            cur = nexts[idx];
        }
        return null;
    }

    fn intern_ty_list_node(
        self: *mut Self,
        alloc: *mut AllocCap,
        cand_in: TyNode,
        tys: *[TyId],
    ) -> TyId ! OutOfMemory {
        var cand = cand_in;
        if let existing = self.find_ty_list_node(&cand, tys) {
            return existing;
        }
        var h = hash_ty_node_base(&cand, tys.len.trunc.[u32]());
        var i: usize = 0_usize;
        while i < tys.len {
            h = fnv_u32(h, tys[i]);
            i = i +% 1_usize;
        }
        let start = self.intern.ty_list.len().trunc.[u32]();
        try self.intern.ty_list.push_slice(alloc, tys);
        cand.list_start = start;
        cand.list_len = tys.len.trunc.[u32]();
        return try self.commit_interned(alloc, h, cand);
    }

    fn find_gval_list_node(self: *Self, cand: *TyNode, gvals: *[GenericVal]) -> ?TyId {
        var h = hash_ty_node_base(cand, gvals.len.trunc.[u32]());
        var i: usize = 0_usize;
        while i < gvals.len {
            h = hash_gval(h, gvals[i]);
            i = i +% 1_usize;
        }
        let head = self.intern.intern_head.get(h) orelse {
            return null;
        };
        let ns = self.intern.nodes.as_slice();
        let nexts = self.intern.intern_next.as_slice();
        let all = self.intern.gval_list.as_slice();
        var cur = head;
        while cur != TY_NONE {
            let idx = cur.widen.[usize]();
            if idx >= ns.len || idx >= nexts.len {
                break;
            }
            let ex = ns[idx];
            if ex.list_len.widen.[usize]() == gvals.len && ty_node_scalar_eq(&ex, cand) {
                let slice = slice_id_range.[GenericVal](all, ast.range_new(ex.list_start, ex.list_len));
                var eq = slice.len == gvals.len;
                var k: usize = 0_usize;
                while eq && k < gvals.len && k < slice.len {
                    if !gval_eq(slice[k], gvals[k]) {
                        eq = false;
                    }
                    k = k +% 1_usize;
                }
                if eq {
                    return cur;
                }
            }
            cur = nexts[idx];
        }
        return null;
    }

    fn intern_gval_list_node(
        self: *mut Self,
        alloc: *mut AllocCap,
        cand_in: TyNode,
        gvals: *[GenericVal],
    ) -> TyId ! OutOfMemory {
        var cand = cand_in;
        if let existing = self.find_gval_list_node(&cand, gvals) {
            return existing;
        }
        var h = hash_ty_node_base(&cand, gvals.len.trunc.[u32]());
        var i: usize = 0_usize;
        while i < gvals.len {
            h = hash_gval(h, gvals[i]);
            i = i +% 1_usize;
        }
        let start = self.intern.gval_list.len().trunc.[u32]();
        try self.intern.gval_list.push_slice(alloc, gvals);
        cand.list_start = start;
        cand.list_len = gvals.len.trunc.[u32]();
        return try self.commit_interned(alloc, h, cand);
    }

    fn find_err_src_node(self: *Self, cand: *TyNode, errs: *[ErrorSource]) -> ?TyId {
        var h = hash_ty_node_base(cand, errs.len.trunc.[u32]());
        var i: usize = 0_usize;
        while i < errs.len {
            h = hash_err_src(h, errs[i]);
            i = i +% 1_usize;
        }
        let head = self.intern.intern_head.get(h) orelse {
            return null;
        };
        let ns = self.intern.nodes.as_slice();
        let nexts = self.intern.intern_next.as_slice();
        let all = self.intern.err_src_list.as_slice();
        var cur = head;
        while cur != TY_NONE {
            let idx = cur.widen.[usize]();
            if idx >= ns.len || idx >= nexts.len {
                break;
            }
            let ex = ns[idx];
            if ex.list_len.widen.[usize]() == errs.len && ty_node_scalar_eq(&ex, cand) {
                let slice = slice_id_range.[ErrorSource](all, ast.range_new(ex.list_start, ex.list_len));
                var eq = slice.len == errs.len;
                var k: usize = 0_usize;
                while eq && k < errs.len && k < slice.len {
                    if !err_src_eq(slice[k], errs[k]) {
                        eq = false;
                    }
                    k = k +% 1_usize;
                }
                if eq {
                    return cur;
                }
            }
            cur = nexts[idx];
        }
        return null;
    }

    fn intern_err_src_node(
        self: *mut Self,
        alloc: *mut AllocCap,
        cand_in: TyNode,
        errs: *[ErrorSource],
    ) -> TyId ! OutOfMemory {
        var cand = cand_in;
        if let existing = self.find_err_src_node(&cand, errs) {
            return existing;
        }
        var h = hash_ty_node_base(&cand, errs.len.trunc.[u32]());
        var i: usize = 0_usize;
        while i < errs.len {
            h = hash_err_src(h, errs[i]);
            i = i +% 1_usize;
        }
        let start = self.intern.err_src_list.len().trunc.[u32]();
        try self.intern.err_src_list.push_slice(alloc, errs);
        cand.list_start = start;
        cand.list_len = errs.len.trunc.[u32]();
        return try self.commit_interned(alloc, h, cand);
    }

    fn find_anon_struct_node(self: *Self, cand: *TyNode, fields: *[AnonField]) -> ?TyId {
        var h = hash_ty_node_base(cand, fields.len.trunc.[u32]());
        var i: usize = 0_usize;
        while i < fields.len {
            h = fnv_u32(fnv_u32(h, fields[i].name), fields[i].ty);
            i = i +% 1_usize;
        }
        let head = self.intern.intern_head.get(h) orelse {
            return null;
        };
        let ns = self.intern.nodes.as_slice();
        let nexts = self.intern.intern_next.as_slice();
        let all = self.intern.anon_fields.as_slice();
        var cur = head;
        while cur != TY_NONE {
            let idx = cur.widen.[usize]();
            if idx >= ns.len || idx >= nexts.len {
                break;
            }
            let ex = ns[idx];
            if ex.list_len.widen.[usize]() == fields.len && ty_node_scalar_eq(&ex, cand) {
                let slice = slice_id_range.[AnonField](all, ast.range_new(ex.list_start, ex.list_len));
                var eq = slice.len == fields.len;
                var k: usize = 0_usize;
                while eq && k < fields.len && k < slice.len {
                    if slice[k].name != fields[k].name || slice[k].ty != fields[k].ty {
                        eq = false;
                    }
                    k = k +% 1_usize;
                }
                if eq {
                    return cur;
                }
            }
            cur = nexts[idx];
        }
        return null;
    }

    fn intern_anon_struct_node(
        self: *mut Self,
        alloc: *mut AllocCap,
        cand_in: TyNode,
        fields: *[AnonField],
    ) -> TyId ! OutOfMemory {
        var cand = cand_in;
        if let existing = self.find_anon_struct_node(&cand, fields) {
            return existing;
        }
        var h = hash_ty_node_base(&cand, fields.len.trunc.[u32]());
        var i: usize = 0_usize;
        while i < fields.len {
            h = fnv_u32(fnv_u32(h, fields[i].name), fields[i].ty);
            i = i +% 1_usize;
        }
        let start = self.intern.anon_fields.len().trunc.[u32]();
        try self.intern.anon_fields.push_slice(alloc, fields);
        cand.list_start = start;
        cand.list_len = fields.len.trunc.[u32]();
        return try self.commit_interned(alloc, h, cand);
    }

    // --- Typed Public Intern & Find Helpers ---

    pub fn intern_int(
        self: *mut Self,
        alloc: *mut AllocCap,
        signed: bool,
        bits: u8,
        is_ptr_sized: bool,
    ) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.Int);
        n.flag0 = signed;
        n.flag1 = is_ptr_sized;
        n.u8_val = bits;
        return try self.intern_simple_node(alloc, n);
    }

    pub fn intern_float(self: *mut Self, alloc: *mut AllocCap, bits: u8) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.Float);
        n.u8_val = bits;
        return try self.intern_simple_node(alloc, n);
    }

    pub fn intern_vec(self: *mut Self, alloc: *mut AllocCap, elem: TyId, len: u8) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.Vec);
        n.primary = elem;
        n.u8_val = len;
        return try self.intern_simple_node(alloc, n);
    }

    pub fn find_vec(self: *Self, elem: TyId, len: u8) -> ?TyId {
        var n = ty_node_zero(.Vec);
        n.primary = elem;
        n.u8_val = len;
        return self.find_simple_node(&n);
    }

    pub fn preintern_opt_vec_tys(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        _ = try self.intern_vec(alloc, TY_F32, 4_u8);
        _ = try self.intern_vec(alloc, TY_F32, 8_u8);
        _ = try self.intern_vec(alloc, TY_F64, 2_u8);
        _ = try self.intern_vec(alloc, TY_F64, 4_u8);
        _ = try self.intern_vec(alloc, TY_I32, 4_u8);
        _ = try self.intern_vec(alloc, TY_I32, 8_u8);
        _ = try self.intern_vec(alloc, TY_U32, 4_u8);
        _ = try self.intern_vec(alloc, TY_U32, 8_u8);
        return;
    }

    pub fn intern_optional(self: *mut Self, alloc: *mut AllocCap, inner: TyId) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.Optional);
        n.primary = inner;
        return try self.intern_simple_node(alloc, n);
    }

    pub fn find_optional(self: *Self, inner: TyId) -> ?TyId {
        var n = ty_node_zero(.Optional);
        n.primary = inner;
        return self.find_simple_node(&n);
    }

    pub fn intern_error_union(
        self: *mut Self,
        alloc: *mut AllocCap,
        ok: TyId,
        errors: *[ErrorSource],
    ) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.ErrorUnion);
        n.primary = ok;
        return try self.intern_err_src_node(alloc, n, errors);
    }

    pub fn intern_error_set(self: *mut Self, alloc: *mut AllocCap, src: ErrorSource) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.ErrorSet);
        if src.kind == .Builtin {
            n.flag0 = true;
            n.u8_val = builtin_err_to_u8(src.builtin);
        } else {
            n.flag0 = false;
            n.primary = src.def_id;
        }
        return try self.intern_simple_node(alloc, n);
    }

    pub fn intern_borrow(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_mut: bool,
        bkind: BorrowInnerKind,
        inner: TyId,
    ) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.Borrow);
        n.flag0 = is_mut;
        n.borrow_kind = bkind;
        n.primary = if bkind == .Str { 0_u32 } else { inner };
        return try self.intern_simple_node(alloc, n);
    }

    pub fn find_borrow(self: *Self, is_mut: bool, bkind: BorrowInnerKind, inner: TyId) -> ?TyId {
        var n = ty_node_zero(.Borrow);
        n.flag0 = is_mut;
        n.borrow_kind = bkind;
        n.primary = if bkind == .Str { 0_u32 } else { inner };
        return self.find_simple_node(&n);
    }

    pub fn intern_raw_ptr(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_mut: bool,
        inner: TyId,
    ) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.RawPtr);
        n.flag0 = is_mut;
        n.primary = inner;
        return try self.intern_simple_node(alloc, n);
    }

    pub fn find_raw_ptr(self: *Self, is_mut: bool, inner: TyId) -> ?TyId {
        var n = ty_node_zero(.RawPtr);
        n.flag0 = is_mut;
        n.primary = inner;
        return self.find_simple_node(&n);
    }

    pub fn intern_array(self: *mut Self, alloc: *mut AllocCap, len: u64, elem: TyId) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.Array);
        n.primary = elem;
        n.u64_val = len;
        return try self.intern_simple_node(alloc, n);
    }

    pub fn find_array(self: *Self, len: u64, elem: TyId) -> ?TyId {
        var n = ty_node_zero(.Array);
        n.primary = elem;
        n.u64_val = len;
        return self.find_simple_node(&n);
    }

    pub fn intern_tuple(self: *mut Self, alloc: *mut AllocCap, elems: *[TyId]) -> TyId ! OutOfMemory {
        return try self.intern_ty_list_node(alloc, ty_node_zero(.Tuple), elems);
    }

    pub fn intern_fn_ptr(
        self: *mut Self,
        alloc: *mut AllocCap,
        params: *[TyId],
        ret: TyId,
    ) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.FnPtr);
        n.primary = ret;
        return try self.intern_ty_list_node(alloc, n, params);
    }

    pub fn intern_struct(
        self: *mut Self,
        alloc: *mut AllocCap,
        def_id: u32,
        args: *[GenericVal],
    ) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.Struct);
        n.primary = def_id;
