        var enum_variants = try col.DynBuf.[EnumVariantMeta].init(alloc, src.enum_variants.len() +% 1_usize);
        errdefer enum_variants.destroy(alloc);
        try enum_variants.push_slice(alloc, src.enum_variants.as_slice());
        var unions = try col.DynBuf.[UnionMeta].init(alloc, src.unions.len() +% 1_usize);
        errdefer unions.destroy(alloc);
        try unions.push_slice(alloc, src.unions.as_slice());
        var union_variants = try col.DynBuf.[UnionVariantMeta].init(alloc, src.union_variants.len() +% 1_usize);
        errdefer union_variants.destroy(alloc);
        try union_variants.push_slice(alloc, src.union_variants.as_slice());
        var bitfields = try col.DynBuf.[BitfieldMeta].init(alloc, src.bitfields.len() +% 1_usize);
        errdefer bitfields.destroy(alloc);
        try bitfields.push_slice(alloc, src.bitfields.as_slice());
        var bitfield_members = try col.DynBuf.[BitfieldMemberMeta].init(alloc, src.bitfield_members.len() +% 1_usize);
        errdefer bitfield_members.destroy(alloc);
        try bitfield_members.push_slice(alloc, src.bitfield_members.as_slice());
        return TypeDefPools.{
            structs: structs,
