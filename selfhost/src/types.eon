}

impl SigDetailPools {
    pub fn init(alloc: *mut AllocCap) -> SigDetailPools ! OutOfMemory {
        let generic_params = try col.DynBuf.[GenericParamMeta].init(alloc, 32_usize);
        errdefer generic_params.destroy(alloc);
        let generic_bounds = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer generic_bounds.destroy(alloc);
        let params = try col.DynBuf.[ParamSig].init(alloc, 128_usize);
        errdefer params.destroy(alloc);
        let sys_accesses = try col.DynBuf.[SysColAccess].init(alloc, 8_usize);
        errdefer sys_accesses.destroy(alloc);
        let sys_access_cols = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer sys_access_cols.destroy(alloc);
        let sys_access_ranges = try col.DynBuf.[ast.IdRange].init(alloc, 8_usize);
        errdefer sys_access_ranges.destroy(alloc);
        return SigDetailPools.{
            generic_params: generic_params,
            generic_bounds: generic_bounds,
            params: params,
            sys_accesses: sys_accesses,
            sys_access_cols: sys_access_cols,
            sys_access_ranges: sys_access_ranges,
        };
    }

    pub fn destroy(self: SigDetailPools, alloc: *mut AllocCap) {
        let SigDetailPools.{
            generic_params,
            generic_bounds,
            params,
            sys_accesses,
            sys_access_cols,
            sys_access_ranges,
        } = self;
        generic_params.destroy(alloc);
        generic_bounds.destroy(alloc);
        params.destroy(alloc);
        sys_accesses.destroy(alloc);
        sys_access_cols.destroy(alloc);
        sys_access_ranges.destroy(alloc);
    }

    pub fn clone_from(alloc: *mut AllocCap, src: *SigDetailPools) -> SigDetailPools ! OutOfMemory {
        var generic_params = try col.DynBuf.[GenericParamMeta].init(alloc, src.generic_params.len() +% 1_usize);
        errdefer generic_params.destroy(alloc);
        try generic_params.push_slice(alloc, src.generic_params.as_slice());
        var generic_bounds = try col.DynBuf.[u32].init(alloc, src.generic_bounds.len() +% 1_usize);
        errdefer generic_bounds.destroy(alloc);
        try generic_bounds.push_slice(alloc, src.generic_bounds.as_slice());
        var params = try col.DynBuf.[ParamSig].init(alloc, src.params.len() +% 16_usize);
        errdefer params.destroy(alloc);
        try params.push_slice(alloc, src.params.as_slice());
        var sys_accesses = try col.DynBuf.[SysColAccess].init(alloc, src.sys_accesses.len() +% 1_usize);
        errdefer sys_accesses.destroy(alloc);
        try sys_accesses.push_slice(alloc, src.sys_accesses.as_slice());
        var sys_access_cols = try col.DynBuf.[u32].init(alloc, src.sys_access_cols.len() +% 1_usize);
        errdefer sys_access_cols.destroy(alloc);
        try sys_access_cols.push_slice(alloc, src.sys_access_cols.as_slice());
        var sys_access_ranges = try col.DynBuf.[ast.IdRange].init(alloc, src.sys_access_ranges.len() +% 1_usize);
        errdefer sys_access_ranges.destroy(alloc);
        try sys_access_ranges.push_slice(alloc, src.sys_access_ranges.as_slice());
        return SigDetailPools.{
            generic_params: generic_params,
            generic_bounds: generic_bounds,
            params: params,
            sys_accesses: sys_accesses,
            sys_access_cols: sys_access_cols,
            sys_access_ranges: sys_access_ranges,
        };
    }
}

pub linear struct TypeDefIndex {
    pub struct_by_def: col.HashMap[u32];
    pub pool_by_def: col.HashMap[u32];
    pub enum_by_def: col.HashMap[u32];
    pub union_by_def: col.HashMap[u32];
    pub bitfield_by_def: col.HashMap[u32];
    pub error_by_def: col.HashMap[u32];
    pub iface_by_def: col.HashMap[u32];
    pub alias_by_def: col.HashMap[u32];
    pub const_by_def: col.HashMap[u32];
    pub fn_by_def: col.HashMap[u32];
    pub sys_access_by_def: col.HashMap[u32];
    pub visiting: col.BitSet;
}

impl TypeDefIndex {
    pub fn init(alloc: *mut AllocCap) -> TypeDefIndex ! OutOfMemory {
        let struct_by_def = try col.HashMap.[u32].init(alloc, 32_usize);
        errdefer struct_by_def.destroy(alloc);
        let pool_by_def = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer pool_by_def.destroy(alloc);
        let enum_by_def = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer enum_by_def.destroy(alloc);
        let union_by_def = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer union_by_def.destroy(alloc);
        let bitfield_by_def = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer bitfield_by_def.destroy(alloc);
        let error_by_def = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer error_by_def.destroy(alloc);
        let iface_by_def = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer iface_by_def.destroy(alloc);
        let alias_by_def = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer alias_by_def.destroy(alloc);
        let const_by_def = try col.HashMap.[u32].init(alloc, 32_usize);
        errdefer const_by_def.destroy(alloc);
        let fn_by_def = try col.HashMap.[u32].init(alloc, 64_usize);
        errdefer fn_by_def.destroy(alloc);
        let sys_access_by_def = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer sys_access_by_def.destroy(alloc);
        let visiting = try col.BitSet.init(alloc, 128_usize);
        errdefer visiting.destroy(alloc);
        return TypeDefIndex.{
            struct_by_def: struct_by_def,
            pool_by_def: pool_by_def,
            enum_by_def: enum_by_def,
            union_by_def: union_by_def,
            bitfield_by_def: bitfield_by_def,
            error_by_def: error_by_def,
            iface_by_def: iface_by_def,
            alias_by_def: alias_by_def,
            const_by_def: const_by_def,
            fn_by_def: fn_by_def,
            sys_access_by_def: sys_access_by_def,
            visiting: visiting,
        };
    }

    pub fn destroy(self: TypeDefIndex, alloc: *mut AllocCap) {
        let TypeDefIndex.{
            struct_by_def,
            pool_by_def,
            enum_by_def,
            union_by_def,
            bitfield_by_def,
            error_by_def,
            iface_by_def,
            alias_by_def,
            const_by_def,
            fn_by_def,
            sys_access_by_def,
            visiting,
        } = self;
        struct_by_def.destroy(alloc);
        pool_by_def.destroy(alloc);
        enum_by_def.destroy(alloc);
        union_by_def.destroy(alloc);
        bitfield_by_def.destroy(alloc);
        error_by_def.destroy(alloc);
        iface_by_def.destroy(alloc);
        alias_by_def.destroy(alloc);
        const_by_def.destroy(alloc);
        fn_by_def.destroy(alloc);
        sys_access_by_def.destroy(alloc);
        visiting.destroy(alloc);
    }

    pub fn clone_from(alloc: *mut AllocCap, src: *TypeDefIndex) -> TypeDefIndex ! OutOfMemory {
        var struct_by_def = try col.HashMap.[u32].init(alloc, src.struct_by_def.cap());
        errdefer struct_by_def.destroy(alloc);
        try struct_by_def.copy_from(alloc, &src.struct_by_def);
        var pool_by_def = try col.HashMap.[u32].init(alloc, src.pool_by_def.cap());
        errdefer pool_by_def.destroy(alloc);
        try pool_by_def.copy_from(alloc, &src.pool_by_def);
        var enum_by_def = try col.HashMap.[u32].init(alloc, src.enum_by_def.cap());
        errdefer enum_by_def.destroy(alloc);
        try enum_by_def.copy_from(alloc, &src.enum_by_def);
        var union_by_def = try col.HashMap.[u32].init(alloc, src.union_by_def.cap());
        errdefer union_by_def.destroy(alloc);
        try union_by_def.copy_from(alloc, &src.union_by_def);
        var bitfield_by_def = try col.HashMap.[u32].init(alloc, src.bitfield_by_def.cap());
        errdefer bitfield_by_def.destroy(alloc);
        try bitfield_by_def.copy_from(alloc, &src.bitfield_by_def);
        var error_by_def = try col.HashMap.[u32].init(alloc, src.error_by_def.cap());
        errdefer error_by_def.destroy(alloc);
        try error_by_def.copy_from(alloc, &src.error_by_def);
        var iface_by_def = try col.HashMap.[u32].init(alloc, src.iface_by_def.cap());
        errdefer iface_by_def.destroy(alloc);
        try iface_by_def.copy_from(alloc, &src.iface_by_def);
        var alias_by_def = try col.HashMap.[u32].init(alloc, src.alias_by_def.cap());
        errdefer alias_by_def.destroy(alloc);
        try alias_by_def.copy_from(alloc, &src.alias_by_def);
        var const_by_def = try col.HashMap.[u32].init(alloc, src.const_by_def.cap());
        errdefer const_by_def.destroy(alloc);
        try const_by_def.copy_from(alloc, &src.const_by_def);
        var fn_by_def = try col.HashMap.[u32].init(alloc, src.fn_by_def.cap());
        errdefer fn_by_def.destroy(alloc);
        try fn_by_def.copy_from(alloc, &src.fn_by_def);
        var sys_access_by_def = try col.HashMap.[u32].init(alloc, src.sys_access_by_def.cap());
        errdefer sys_access_by_def.destroy(alloc);
        try sys_access_by_def.copy_from(alloc, &src.sys_access_by_def);
        let visiting = try col.BitSet.init(alloc, src.visiting.len());
        errdefer visiting.destroy(alloc);
        return TypeDefIndex.{
            struct_by_def: struct_by_def,
            pool_by_def: pool_by_def,
            enum_by_def: enum_by_def,
            union_by_def: union_by_def,
            bitfield_by_def: bitfield_by_def,
            error_by_def: error_by_def,
            iface_by_def: iface_by_def,
            alias_by_def: alias_by_def,
            const_by_def: const_by_def,
            fn_by_def: fn_by_def,
            sys_access_by_def: sys_access_by_def,
            visiting: visiting,
        };
    }
}

pub linear struct TypeEnv {
    pub intern: TyInternPools;
    pub defs: TypeDefPools;
    pub decls: DeclMetaPools;
    pub sigs: SigDetailPools;
    pub index: TypeDefIndex;
    pub target_spec: target.TargetSpec;
}

// ===========================================================================
// Section 5: FNV-1a Structural Hashing, Equality, Interning, and Lookup
// ===========================================================================

const FNV_OFFSET: u64 = 0xCBF29CE484222325_u64;
const FNV_PRIME: u64 = 0x100000001B3_u64;

fn fnv_u8(h: u64, b: u8) -> u64 {
    return (h ^ b.widen.[u64]()) *% FNV_PRIME;
}

fn fnv_bool(h: u64, v: bool) -> u64 {
    return fnv_u8(h, if v { 1_u8 } else { 0_u8 });
}

fn fnv_u32(h: u64, v: u32) -> u64 {
    var cur = fnv_u8(h, (v & 0xFF_u32).trunc.[u8]());
    cur = fnv_u8(cur, ((v >> 8_u32) & 0xFF_u32).trunc.[u8]());
    cur = fnv_u8(cur, ((v >> 16_u32) & 0xFF_u32).trunc.[u8]());
    cur = fnv_u8(cur, ((v >> 24_u32) & 0xFF_u32).trunc.[u8]());
    return cur;
}

fn fnv_u64(h: u64, v: u64) -> u64 {
    let lo = (v & 0xFFFFFFFF_u64).trunc.[u32]();
    let hi = (v >> 32_u64).trunc.[u32]();
    return fnv_u32(fnv_u32(h, lo), hi);
}

fn ty_kind_u8(k: TyKind) -> u8 {
    match k {
        .Error => { return 0_u8; }
        .Void => { return 1_u8; }
        .Never => { return 2_u8; }
        .Bool => { return 3_u8; }
        .Char => { return 4_u8; }
        .Int => { return 5_u8; }
        .Float => { return 6_u8; }
        .Str => { return 7_u8; }
        .TypeType => { return 8_u8; }
        .PhysAddr => { return 9_u8; }
        .VirtAddr => { return 10_u8; }
        .DmaAddr => { return 11_u8; }
        .ComptimeInt => { return 12_u8; }
        .ComptimeFloat => { return 13_u8; }
        .RawPtr => { return 14_u8; }
        .Borrow => { return 15_u8; }
        .Optional => { return 16_u8; }
        .ErrorUnion => { return 17_u8; }
        .ErrorSet => { return 18_u8; }
        .Array => { return 19_u8; }
        .Tuple => { return 20_u8; }
        .AnonStruct => { return 21_u8; }
        .Struct => { return 22_u8; }
        .Pool => { return 23_u8; }
        .Enum => { return 24_u8; }
        .Union => { return 25_u8; }
        .Bitfield => { return 26_u8; }
        .Dyn => { return 27_u8; }
        .FnPtr => { return 28_u8; }
        .Vec => { return 29_u8; }
        .Builtin => { return 30_u8; }
        .GenericParam => { return 31_u8; }
    }
}

fn builtin_err_to_u8(b: BuiltinErrorKind) -> u8 {
    match b {
        .ArithError => { return 0_u8; }
        .BoundsError => { return 1_u8; }
        .Utf8Error => { return 2_u8; }
        .OutOfMemory => { return 3_u8; }
        .MemError => { return 4_u8; }
        .StaleId => { return 5_u8; }
        .IoError => { return 6_u8; }
    }
}

fn builtin_err_from_u8(v: u8) -> BuiltinErrorKind {
    match v {
        0_u8 => { return .ArithError; }
        1_u8 => { return .BoundsError; }
        2_u8 => { return .Utf8Error; }
        3_u8 => { return .OutOfMemory; }
        4_u8 => { return .MemError; }
        5_u8 => { return .StaleId; }
        6_u8 => { return .IoError; }
        _ => { return .ArithError; }
    }
}

fn borrow_kind_u8(b: BorrowInnerKind) -> u8 {
    match b {
        .Single => { return 0_u8; }
        .Slice => { return 1_u8; }
        .Str => { return 2_u8; }
    }
}

fn gval_kind_u8(k: GenericValKind) -> u8 {
    match k {
        .Ty => { return 0_u8; }
        .Int => { return 1_u8; }
        .Variant => { return 2_u8; }
    }
}

fn err_src_kind_u8(k: ErrorSourceKind) -> u8 {
    match k {
        .User => { return 0_u8; }
        .Builtin => { return 1_u8; }
    }
}

fn hash_ty_node_base(n: *TyNode, list_len: u32) -> u64 {
    var h = FNV_OFFSET;
    h = fnv_u8(h, ty_kind_u8(n.kind));
    h = fnv_bool(h, n.flag0);
    h = fnv_bool(h, n.flag1);
    h = fnv_u8(h, n.u8_val);
    h = fnv_u8(h, borrow_kind_u8(n.borrow_kind));
    h = fnv_u32(h, resolve.encode_builtin_simple(n.builtin_kind));
    h = fnv_u32(h, n.primary);
    h = fnv_u32(h, n.aux);
    h = fnv_u64(h, n.u64_val);
    h = fnv_u32(h, list_len);
    return h;
}

fn hash_gval(h: u64, g: GenericVal) -> u64 {
    var cur = fnv_u8(h, gval_kind_u8(g.kind));
    cur = fnv_u32(cur, g.id);
    cur = fnv_u64(cur, g.int_val.lo);
    cur = fnv_u64(cur, g.int_val.hi.bitcast.[u64]());
    return cur;
}

fn hash_err_src(h: u64, e: ErrorSource) -> u64 {
    var cur = fnv_u8(h, err_src_kind_u8(e.kind));
    cur = fnv_u32(cur, e.def_id);
    cur = fnv_u8(cur, builtin_err_to_u8(e.builtin));
    return cur;
}

fn ty_node_scalar_eq(a: *TyNode, b: *TyNode) -> bool {
    return a.kind == b.kind
        && a.flag0 == b.flag0
        && a.flag1 == b.flag1
        && a.u8_val == b.u8_val
        && a.borrow_kind == b.borrow_kind
        && a.builtin_kind == b.builtin_kind
        && a.primary == b.primary
        && a.aux == b.aux
        && a.u64_val == b.u64_val;
}

fn gval_eq(a: GenericVal, b: GenericVal) -> bool {
    if a.kind != b.kind {
        return false;
    }
    match a.kind {
        .Ty => { return a.id == b.id; }
        .Variant => { return a.id == b.id; }
        .Int => { return int_val_eq(a.int_val, b.int_val); }
    }
}

fn err_src_eq(a: ErrorSource, b: ErrorSource) -> bool {
    if a.kind != b.kind {
        return false;
    }
    match a.kind {
        .User => { return a.def_id == b.def_id; }
        .Builtin => { return a.builtin == b.builtin; }
    }
}

pub fn align_up_u64(offset: u64, align: u64) -> u64 {
    if align <= 1_u64 {
        return offset;
    }
    let mask = align -% 1_u64;
    return (offset +% mask) & (~mask);
}

pub fn align_up_usize(offset: usize, align: usize) -> usize {
    if align <= 1_usize {
        return offset;
    }
    let mask = align -% 1_usize;
    return (offset +% mask) & (~mask);
}

fn next_pow2_u64(v: u64) -> u64 {
    if v <= 1_u64 {
        return 1_u64;
    }
    var p: u64 = 1_u64;
    while p < v && p < 0x8000000000000000_u64 {
        p = p <<% 1_u64;
    }
    return p;
}

fn sat_mul_u64(a: u64, b: u64) -> u64 {
    let prod = (a *? b) catch {
        return 0xFFFFFFFFFFFFFFFF_u64;
    };
    return prod;
}

fn node_error_source(n: *TyNode) -> ErrorSource {
    if n.flag0 {
        return err_src_builtin(builtin_err_from_u8(n.u8_val));
    }
    return err_src_user(n.primary);
}

impl TypeEnv {
    fn init_empty(alloc: *mut AllocCap) -> TypeEnv ! OutOfMemory {
        let intern = try TyInternPools.init(alloc);
        errdefer intern.destroy(alloc);
        let defs = try TypeDefPools.init(alloc);
        errdefer defs.destroy(alloc);
        let decls = try DeclMetaPools.init(alloc);
        errdefer decls.destroy(alloc);
        let sigs = try SigDetailPools.init(alloc);
        errdefer sigs.destroy(alloc);
        let index = try TypeDefIndex.init(alloc);
        errdefer index.destroy(alloc);
        return TypeEnv.{
            intern: intern,
            defs: defs,
            decls: decls,
            sigs: sigs,
            index: index,
            target_spec: target.TargetSpec.host_default(),
        };
    }

    pub fn init(alloc: *mut AllocCap) -> TypeEnv ! OutOfMemory {
        var env = try TypeEnv.init_empty(alloc);
        errdefer env.destroy(alloc);
        try env.seed_primitives(alloc);
        return env;
    }

    pub fn set_target(self: *mut Self, spec: target.TargetSpec) {
        self.target_spec = spec;
    }

    @inline
    pub fn target_ptr_size(self: *Self) -> u64 {
        return self.target_spec.ptr_size();
    }

    @inline
    pub fn target_c_long_size(self: *Self) -> u64 {
        return self.target_spec.c_long_size();
    }

    pub fn destroy(self: TypeEnv, alloc: *mut AllocCap) {
        let TypeEnv.{ intern, defs, decls, sigs, index, target_spec: _ } = self;
        intern.destroy(alloc);
        defs.destroy(alloc);
        decls.destroy(alloc);
        sigs.destroy(alloc);
        index.destroy(alloc);
    }

    pub fn clone_for_worker(self: *Self, alloc: *mut AllocCap) -> TypeEnv ! OutOfMemory {
        let intern = try TyInternPools.clone_from(alloc, &self.intern);
        errdefer intern.destroy(alloc);
        let defs = try TypeDefPools.clone_from(alloc, &self.defs);
        errdefer defs.destroy(alloc);
        let decls = try DeclMetaPools.clone_from(alloc, &self.decls);
        errdefer decls.destroy(alloc);
        let sigs = try SigDetailPools.clone_from(alloc, &self.sigs);
        errdefer sigs.destroy(alloc);
        let index = try TypeDefIndex.clone_from(alloc, &self.index);
        return TypeEnv.{
            intern: intern,
            defs: defs,
            decls: decls,
            sigs: sigs,
            index: index,
            target_spec: self.target_spec,
        };
    }

    pub fn sync_intern_and_params_from(
        self: *mut Self,
        alloc: *mut AllocCap,
        src: *TypeEnv,
    ) -> !OutOfMemory {
        try self.intern.sync_from(alloc, &src.intern);
        self.sigs.params.clear();
        try self.sigs.params.push_slice(alloc, src.sigs.params.as_slice());
        return;
    }

    /// Lazily re-interns any worker-created `TyId >= base_ty_count` into `self` in deterministic traversal order.
    @recursive
    pub fn remap_worker_ty_lazy(
        self: *mut Self,
        alloc: *mut AllocCap,
        worker_env: *TypeEnv,
        base_ty_count: u32,
        ty_remap: *mut col.DynBuf[TyId],
        ty: TyId,
    ) -> TyId ! OutOfMemory {
        if ty == TY_NONE || ty == TY_ERROR || ty < base_ty_count {
            return ty;
        }
        let tu = ty.widen.[usize]();
        let w_cnt = worker_env.ty_count().widen.[usize]();
        if tu >= w_cnt {
            return ty;
        }
        while ty_remap.len() < w_cnt {
            let idx = ty_remap.len().trunc.[u32]();
            try ty_remap.push(alloc, if idx < base_ty_count { idx } else { TY_NONE });
        }
        if let rp = ty_remap.get(tu) {
            if rp.* != TY_NONE {
                return rp.*;
            }
        }
        var n = worker_env.get(ty);
        var mapped = TY_ERROR;
        match n.kind {
            .Vec => {
                n.primary = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, n.primary);
                n.list_start = 0_u32;
                n.list_len = 0_u32;
                mapped = try self.intern_simple_node(alloc, n);
            }
            .Optional => {
                n.primary = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, n.primary);
                n.list_start = 0_u32;
                n.list_len = 0_u32;
                mapped = try self.intern_simple_node(alloc, n);
            }
            .RawPtr => {
                n.primary = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, n.primary);
                n.list_start = 0_u32;
                n.list_len = 0_u32;
                mapped = try self.intern_simple_node(alloc, n);
            }
            .Borrow => {
                n.primary = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, n.primary);
                n.list_start = 0_u32;
                n.list_len = 0_u32;
                mapped = try self.intern_simple_node(alloc, n);
            }
            .Array => {
                n.primary = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, n.primary);
                n.list_start = 0_u32;
                n.list_len = 0_u32;
                mapped = try self.intern_simple_node(alloc, n);
            }
            .ErrorUnion => {
                n.primary = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, n.primary);
                let errs = worker_env.node_err_src_list(&n);
                mapped = try self.intern_error_union(alloc, n.primary, errs);
            }
            .Tuple => {
                let src_ts = worker_env.node_ty_list(&n);
                var tmp = try col.DynBuf.[TyId].init(alloc, src_ts.len +% 1_usize);
                errdefer tmp.destroy(alloc);
                var i: usize = 0_usize;
                while i < src_ts.len {
                    try tmp.push(alloc, try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, src_ts[i]));
                    i = i +% 1_usize;
                }
                mapped = try self.intern_tuple(alloc, tmp.as_slice());
                tmp.destroy(alloc);
            }
            .FnPtr => {
                let ret_m = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, n.primary);
                let src_ps = worker_env.node_ty_list(&n);
                var tmp = try col.DynBuf.[TyId].init(alloc, src_ps.len +% 1_usize);
                errdefer tmp.destroy(alloc);
                var i: usize = 0_usize;
                while i < src_ps.len {
                    try tmp.push(alloc, try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, src_ps[i]));
                    i = i +% 1_usize;
                }
                mapped = try self.intern_fn_ptr(alloc, tmp.as_slice(), ret_m);
                tmp.destroy(alloc);
            }
            .AnonStruct => {
                let src_fs = worker_env.node_anon_fields(&n);
                var tmp = try col.DynBuf.[AnonField].init(alloc, src_fs.len +% 1_usize);
                errdefer tmp.destroy(alloc);
                var i: usize = 0_usize;
                while i < src_fs.len {
                    var af = src_fs[i];
                    af.ty = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, af.ty);
                    try tmp.push(alloc, af);
                    i = i +% 1_usize;
                }
                mapped = try self.intern_anon_struct(alloc, tmp.as_slice());
                tmp.destroy(alloc);
            }
            .Struct => {
                let src_gs = worker_env.node_gval_list(&n);
                var tmp = try col.DynBuf.[GenericVal].init(alloc, src_gs.len +% 1_usize);
                errdefer tmp.destroy(alloc);
                var i: usize = 0_usize;
                while i < src_gs.len {
                    var g = src_gs[i];
                    if g.kind == .Ty {
                        g.id = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, g.id);
                    }
                    try tmp.push(alloc, g);
                    i = i +% 1_usize;
                }
                n.list_start = 0_u32;
                n.list_len = 0_u32;
                mapped = try self.intern_gval_list_node(alloc, n, tmp.as_slice());
                tmp.destroy(alloc);
            }
            .Pool => {
                let src_gs = worker_env.node_gval_list(&n);
                var tmp = try col.DynBuf.[GenericVal].init(alloc, src_gs.len +% 1_usize);
                errdefer tmp.destroy(alloc);
                var i: usize = 0_usize;
                while i < src_gs.len {
                    var g = src_gs[i];
                    if g.kind == .Ty {
                        g.id = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, g.id);
                    }
                    try tmp.push(alloc, g);
                    i = i +% 1_usize;
                }
                n.list_start = 0_u32;
                n.list_len = 0_u32;
                mapped = try self.intern_gval_list_node(alloc, n, tmp.as_slice());
                tmp.destroy(alloc);
            }
            .Union => {
                let src_gs = worker_env.node_gval_list(&n);
                var tmp = try col.DynBuf.[GenericVal].init(alloc, src_gs.len +% 1_usize);
                errdefer tmp.destroy(alloc);
                var i: usize = 0_usize;
                while i < src_gs.len {
                    var g = src_gs[i];
                    if g.kind == .Ty {
                        g.id = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, g.id);
                    }
                    try tmp.push(alloc, g);
                    i = i +% 1_usize;
                }
                n.list_start = 0_u32;
                n.list_len = 0_u32;
                mapped = try self.intern_gval_list_node(alloc, n, tmp.as_slice());
                tmp.destroy(alloc);
            }
            .Builtin => {
                let src_gs = worker_env.node_gval_list(&n);
                var tmp = try col.DynBuf.[GenericVal].init(alloc, src_gs.len +% 1_usize);
                errdefer tmp.destroy(alloc);
                var i: usize = 0_usize;
                while i < src_gs.len {
                    var g = src_gs[i];
                    if g.kind == .Ty {
                        g.id = try self.remap_worker_ty_lazy(alloc, worker_env, base_ty_count, ty_remap, g.id);
                    }
                    try tmp.push(alloc, g);
                    i = i +% 1_usize;
                }
                n.list_start = 0_u32;
                n.list_len = 0_u32;
                mapped = try self.intern_gval_list_node(alloc, n, tmp.as_slice());
                tmp.destroy(alloc);
            }
            _ => {
                n.list_start = 0_u32;
                n.list_len = 0_u32;
                mapped = try self.intern_simple_node(alloc, n);
            }
        }
        let rms = ty_remap.as_mut_slice();
        if tu < rms.len {
            rms[tu] = mapped;
        }
        return mapped;
    }

    fn seed_primitives(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        _ = try self.intern_simple_node(alloc, ty_node_zero(.Void));
        _ = try self.intern_simple_node(alloc, ty_node_zero(.Never));
        _ = try self.intern_simple_node(alloc, ty_node_zero(.Bool));
        _ = try self.intern_simple_node(alloc, ty_node_zero(.Char));
        _ = try self.intern_simple_node(alloc, ty_node_zero(.Str));
        _ = try self.intern_simple_node(alloc, ty_node_zero(.TypeType));
        _ = try self.intern_simple_node(alloc, ty_node_zero(.ComptimeInt));
        _ = try self.intern_simple_node(alloc, ty_node_zero(.ComptimeFloat));
        _ = try self.intern_int(alloc, false, 8_u8, false);
        _ = try self.intern_int(alloc, false, 16_u8, false);
        _ = try self.intern_int(alloc, false, 32_u8, false);
        _ = try self.intern_int(alloc, false, 64_u8, false);
        _ = try self.intern_int(alloc, false, 128_u8, false);
        _ = try self.intern_int(alloc, false, 64_u8, true);
        _ = try self.intern_int(alloc, true, 8_u8, false);
        _ = try self.intern_int(alloc, true, 16_u8, false);
        _ = try self.intern_int(alloc, true, 32_u8, false);
        _ = try self.intern_int(alloc, true, 64_u8, false);
        _ = try self.intern_int(alloc, true, 128_u8, false);
        _ = try self.intern_int(alloc, true, 64_u8, true);
        _ = try self.intern_float(alloc, 16_u8);
        _ = try self.intern_float(alloc, 32_u8);
        _ = try self.intern_float(alloc, 64_u8);
        _ = try self.intern_simple_node(alloc, ty_node_zero(.PhysAddr));
        _ = try self.intern_simple_node(alloc, ty_node_zero(.VirtAddr));
        _ = try self.intern_simple_node(alloc, ty_node_zero(.DmaAddr));
        _ = try self.intern_builtin_empty(alloc, .Ordering);
        _ = try self.intern_error_set(alloc, err_src_builtin(.ArithError));
        _ = try self.intern_error_set(alloc, err_src_builtin(.BoundsError));
        _ = try self.intern_error_set(alloc, err_src_builtin(.Utf8Error));
        _ = try self.intern_error_set(alloc, err_src_builtin(.OutOfMemory));
        _ = try self.intern_simple_node(alloc, ty_node_zero(.Error));
        _ = try self.intern_error_set(alloc, err_src_builtin(.MemError));
        _ = try self.intern_error_set(alloc, err_src_builtin(.StaleId));
        _ = try self.intern_error_set(alloc, err_src_builtin(.IoError));
        return;
    }

    pub fn ty_count(self: *Self) -> u32 {
        return self.intern.nodes.len().trunc.[u32]();
    }

    pub fn get(self: *Self, id: TyId) -> TyNode {
        let idx = id.widen.[usize]();
        let ns = self.intern.nodes.as_slice();
        if idx < ns.len {
            return ns[idx];
        }
        return ty_node_zero(.Error);
    }

    pub view fn node_ty_list(self: *Self, n: *TyNode) -> *[TyId] {
        return slice_id_range.[TyId](
            self.intern.ty_list.as_slice(),
            ast.range_new(n.list_start, n.list_len),
        );
    }

    pub view fn node_gval_list(self: *Self, n: *TyNode) -> *[GenericVal] {
        return slice_id_range.[GenericVal](
            self.intern.gval_list.as_slice(),
            ast.range_new(n.list_start, n.list_len),
        );
    }

    pub view fn node_err_src_list(self: *Self, n: *TyNode) -> *[ErrorSource] {
        return slice_id_range.[ErrorSource](
            self.intern.err_src_list.as_slice(),
            ast.range_new(n.list_start, n.list_len),
        );
    }

    pub view fn node_anon_fields(self: *Self, n: *TyNode) -> *[AnonField] {
        return slice_id_range.[AnonField](
            self.intern.anon_fields.as_slice(),
            ast.range_new(n.list_start, n.list_len),
        );
    }

    // --- Metadata O(1) Lookups & Range View Accessors ---

    pub view fn get_struct(self: *Self, def_id: u32) -> ?*StructMeta {
        if let idx = self.index.struct_by_def.get(def_id.widen.[u64]()) {
            return self.defs.structs.get(idx.widen.[usize]());
        }
        return null;
    }

    pub view fn get_pool(self: *Self, def_id: u32) -> ?*PoolMeta {
        if let idx = self.index.pool_by_def.get(def_id.widen.[u64]()) {
            return self.defs.pools.get(idx.widen.[usize]());
