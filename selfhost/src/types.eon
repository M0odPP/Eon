    pub fn intern_enum(self: *mut Self, alloc: *mut AllocCap, def_id: u32) -> TyId ! OutOfMemory {
        var n = ty_node_zero(.Enum);
        n.primary = def_id;
        return try self.intern_simple_node(alloc, n);
    }

