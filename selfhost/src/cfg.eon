module eonc.cfg;

import core.col;
import core.str;
import core.sync;
import eonc.span;
import eonc.ast;
import eonc.resolve;
import eonc.types;
import eonc.ctvm;
import eonc.check;
import eonc.cfg_ir;

// ===========================================================================
// Section 1: Builder State, Scope/Loop Stacks, Parsing & Core Primitives
// ===========================================================================

enum ScopeEventKind : u8 {
    Local = 0,
    Defer = 1,
    Errdefer = 2,
}

struct ScopeEvent {
    kind: ScopeEventKind;
    local: cfg_ir.LocalId;
    body_kind: ast.BodyKind;
    body_id: u32;
    err_bind: ast.IdentSpan;
    span: span.Span;
}

struct ScopeVar {
    sym: u32;
    local: cfg_ir.LocalId;
}

struct ScopeMark {
    depth: u32;
    vars_start: u32;
    events_start: u32;
}

struct LoopTarget {
    has_label: bool;
    label: u32;
    continue_bb: cfg_ir.BlockId;
    exit_bb: cfg_ir.BlockId;
    has_break_dst: bool;
    break_dst_place: u32;
    break_origin_ty: types.TyId;
    scope_len_at_entry: usize;
    any_break: bool;
}

struct LocalConst {
    sym: u32;
    val: types.IntVal;
}

struct CapturedAlias {
    sym: u32;
    env_loc: cfg_ir.LocalId;
    field_idx: u32;
    ptr_ty: types.TyId;
    inner_ty: types.TyId;
}

linear struct LowerState {
    out_closures: col.DynBuf[cfg_ir.CfgFunction];
    next_closure_id: u32;
}

impl LowerState {
    fn init(alloc: *mut AllocCap) -> LowerState ! OutOfMemory {
        let out_closures = try col.DynBuf.[cfg_ir.CfgFunction].init(alloc, 8_usize);
        return LowerState.{
            out_closures: out_closures,
            next_closure_id: 0_u32,
        };
    }

    fn destroy(self: LowerState, alloc: *mut AllocCap) {
        let LowerState.{ out_closures, next_closure_id: _ } = self;
        out_closures.destroy(alloc);
    }
}

linear struct FnCfgBufs {
    params: col.DynBuf[cfg_ir.LocalId];
    locals: col.DynBuf[cfg_ir.CfgLocal];
    blocks: col.DynBuf[cfg_ir.CfgBlock];
    blk_stmt_head: col.DynBuf[u32];
    blk_stmt_tail: col.DynBuf[u32];
    blk_stmt_count: col.DynBuf[u32];
    stmts: col.DynBuf[cfg_ir.CfgStmt];
    stmt_next: col.DynBuf[u32];
}

impl FnCfgBufs {
    fn init(alloc: *mut AllocCap) -> FnCfgBufs ! OutOfMemory {
        let params = try col.DynBuf.[cfg_ir.LocalId].init(alloc, 8_usize);
        errdefer params.destroy(alloc);
        let locals = try col.DynBuf.[cfg_ir.CfgLocal].init(alloc, 16_usize);
        errdefer locals.destroy(alloc);
        let blocks = try col.DynBuf.[cfg_ir.CfgBlock].init(alloc, 8_usize);
        errdefer blocks.destroy(alloc);
        let blk_stmt_head = try col.DynBuf.[u32].init(alloc, 8_usize);
        errdefer blk_stmt_head.destroy(alloc);
        let blk_stmt_tail = try col.DynBuf.[u32].init(alloc, 8_usize);
        errdefer blk_stmt_tail.destroy(alloc);
        let blk_stmt_count = try col.DynBuf.[u32].init(alloc, 8_usize);
        errdefer blk_stmt_count.destroy(alloc);
        let stmts = try col.DynBuf.[cfg_ir.CfgStmt].init(alloc, 32_usize);
        errdefer stmts.destroy(alloc);
        let stmt_next = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer stmt_next.destroy(alloc);
        return FnCfgBufs.{
            params: params,
            locals: locals,
            blocks: blocks,
            blk_stmt_head: blk_stmt_head,
            blk_stmt_tail: blk_stmt_tail,
            blk_stmt_count: blk_stmt_count,
            stmts: stmts,
            stmt_next: stmt_next,
        };
    }

    fn destroy(self: FnCfgBufs, alloc: *mut AllocCap) {
        let FnCfgBufs.{
            params,
            locals,
            blocks,
            blk_stmt_head,
            blk_stmt_tail,
            blk_stmt_count,
            stmts,
            stmt_next,
        } = self;
        params.destroy(alloc);
        locals.destroy(alloc);
        blocks.destroy(alloc);
        blk_stmt_head.destroy(alloc);
        blk_stmt_tail.destroy(alloc);
        blk_stmt_count.destroy(alloc);
        stmts.destroy(alloc);
        stmt_next.destroy(alloc);
    }
}

linear struct FnScopeBufs {
    scopes: col.DynBuf[ScopeMark];
    scope_vars: col.DynBuf[ScopeVar];
    scope_events: col.DynBuf[ScopeEvent];
    loops: col.DynBuf[LoopTarget];
    consts: col.DynBuf[LocalConst];
    captured_aliases: col.DynBuf[CapturedAlias];
    generic_subst: col.DynBuf[types.GenericVal];
    par_for_regions: col.DynBuf[cfg_ir.ParForRegion];
    loop_invariants: col.DynBuf[cfg_ir.LoopInvariantEntry];
}

impl FnScopeBufs {
    fn init(alloc: *mut AllocCap) -> FnScopeBufs ! OutOfMemory {
        let scopes = try col.DynBuf.[ScopeMark].init(alloc, 8_usize);
        errdefer scopes.destroy(alloc);
        let scope_vars = try col.DynBuf.[ScopeVar].init(alloc, 16_usize);
        errdefer scope_vars.destroy(alloc);
        let scope_events = try col.DynBuf.[ScopeEvent].init(alloc, 32_usize);
        errdefer scope_events.destroy(alloc);
        let loops = try col.DynBuf.[LoopTarget].init(alloc, 4_usize);
        errdefer loops.destroy(alloc);
        let consts = try col.DynBuf.[LocalConst].init(alloc, 4_usize);
        errdefer consts.destroy(alloc);
        let captured_aliases = try col.DynBuf.[CapturedAlias].init(alloc, 4_usize);
        errdefer captured_aliases.destroy(alloc);
        let generic_subst = try col.DynBuf.[types.GenericVal].init(alloc, 4_usize);
        errdefer generic_subst.destroy(alloc);
        let par_for_regions = try col.DynBuf.[cfg_ir.ParForRegion].init(alloc, 2_usize);
        errdefer par_for_regions.destroy(alloc);
        let loop_invariants = try col.DynBuf.[cfg_ir.LoopInvariantEntry].init(alloc, 2_usize);
        errdefer loop_invariants.destroy(alloc);
        return FnScopeBufs.{
            scopes: scopes,
            scope_vars: scope_vars,
            scope_events: scope_events,
            loops: loops,
            consts: consts,
            captured_aliases: captured_aliases,
            generic_subst: generic_subst,
            par_for_regions: par_for_regions,
            loop_invariants: loop_invariants,
        };
    }

    fn destroy(self: FnScopeBufs, alloc: *mut AllocCap) {
        let FnScopeBufs.{
            scopes,
            scope_vars,
            scope_events,
            loops,
            consts,
            captured_aliases,
            generic_subst,
            par_for_regions,
            loop_invariants,
        } = self;
        scopes.destroy(alloc);
        scope_vars.destroy(alloc);
        scope_events.destroy(alloc);
        loops.destroy(alloc);
        consts.destroy(alloc);
        captured_aliases.destroy(alloc);
        generic_subst.destroy(alloc);
        par_for_regions.destroy(alloc);
        loop_invariants.destroy(alloc);
    }
}

linear struct FnBuildState {
    bufs: FnCfgBufs;
    sc: FnScopeBufs;
}

impl FnBuildState {
    fn init(alloc: *mut AllocCap) -> FnBuildState ! OutOfMemory {
        let bufs = try FnCfgBufs.init(alloc);
        errdefer bufs.destroy(alloc);
        let sc = try FnScopeBufs.init(alloc);
        errdefer sc.destroy(alloc);
        return FnBuildState.{ bufs: bufs, sc: sc };
    }

    fn destroy(self: FnBuildState, alloc: *mut AllocCap) {
        let FnBuildState.{ bufs, sc } = self;
        bufs.destroy(alloc);
        sc.destroy(alloc);
    }
}

view struct CfgBuilder {
    alloc: *mut AllocCap;
    arena: *ast.AstArena;
    prog: *resolve.ResolvedProgram;
    env: *mut types.TypeEnv;
    ct: *ctvm.CtArena;
    table: *check.TypeTable;
    interner: *span.SymInterner;
    cfg: *mut cfg_ir.CfgProgram;
    lstate: *mut LowerState;
    st: *mut FnBuildState;
    key: cfg_ir.CfgFnKey;
    module_id: u32;
    sig: types.FnSig;
    body_span: span.Span;
    is_sys: bool;
    where_clauses: ast.IdRange;
    ensures_clauses: ast.IdRange;
    has_base_generic: bool;
    base_generic_key: cfg_ir.CfgFnKey;
    base_generic_args: ast.IdRange;
    has_cur_bb: bool;
    cur_bb: cfg_ir.BlockId;
    cleanup_depth: u32;
    in_errdefer: bool;
    has_active_err_span: bool;
    active_err_span: span.Span;
    has_pool_row_is_slot: bool;
    pool_row_is_slot: bool;
    has_captured_self: bool;
    captured_self: CapturedAlias;
}

fn empty_captured_alias() -> CapturedAlias {
    return CapturedAlias.{
        sym: span.SYM_EMPTY,
        env_loc: 0_u32,
        field_idx: 0_u32,
        ptr_ty: types.TY_ERROR,
        inner_ty: types.TY_ERROR,
    };
}

fn expr_span(arena: *ast.AstArena, expr_id: u32) -> span.Span {
    if let e = arena.get_expr(expr_id) {
        return e.span;
    }
    return span.span_dummy();
}

fn pat_span(arena: *ast.AstArena, pat_id: u32) -> span.Span {
    if let p = arena.get_pat(pat_id) {
        return p.span;
    }
    return span.span_dummy();
}

fn is_wildcard_sym(interner: *span.SymInterner, sym: u32) -> bool {
    let bs = interner.get(sym);
    return bs.len == 1_usize && bs[0_usize] == b'_';
}

fn sym_is(interner: *span.SymInterner, sym: u32, s: *str) -> bool {
    return str.bytes_eq(interner.get(sym), s.as_bytes());
}

fn method_target_eq(a: types.MethodTarget, b: types.MethodTarget) -> bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == .Def {
        return a.def_id == b.def_id;
    }
    return a.builtin == b.builtin;
}

fn parse_uint_as_intval(raw_bytes: *[u8]) -> types.IntVal {
    if let u = types.parse_int_literal_u128(raw_bytes) {
        return types.IntVal.{ lo: u.lo, hi: u.hi.bitcast.[i64]() };
    }
    return types.int_val_zero();
}

fn parse_neg_uint_as_intval(raw_bytes: *[u8]) -> types.IntVal {
    let u = types.parse_int_literal_u128(raw_bytes) orelse {
        return types.int_val_zero();
    };
    if u.hi == 0x8000000000000000_u64 && u.lo == 0_u64 {
        return types.int_val_min_i128();
    }
    let pos = types.IntVal.{ lo: u.lo, hi: u.hi.bitcast.[i64]() };
    return types.int_val_checked_neg(pos) orelse types.int_val_zero();
}

fn parse_signed_int(raw_sym: u32, neg: bool, interner: *span.SymInterner) -> ?types.IntVal {
    let u = types.parse_int_literal_u128(interner.get(raw_sym)) orelse {
        return null;
    };
    if neg {
        if u.hi == 0x8000000000000000_u64 && u.lo == 0_u64 {
            return types.int_val_min_i128();
        }
        if u.hi >= 0x8000000000000000_u64 {
            return null;
        }
        return types.int_val_checked_neg(types.IntVal.{ lo: u.lo, hi: u.hi.bitcast.[i64]() });
    }
    if u.hi >= 0x8000000000000000_u64 {
        return null;
    }
    return types.IntVal.{ lo: u.lo, hi: u.hi.bitcast.[i64]() };
}

fn format_f64_into(alloc: *mut AllocCap, val: f64, out: *mut str.StrBuf) -> !OutOfMemory {
    out.clear();
    let bits = val.bitcast.[u64]();
    let exp = (bits >> 52_u64) & 0x7FF_u64;
    let mant = bits & 0xFFFFFFFFFFFFF_u64;
    if exp == 0x7FF_u64 && mant != 0_u64 {
        try out.push_str_grow(alloc, "NaN");
        return;
    }
    var v = val;
    let is_neg = (bits >> 63_u64) != 0_u64;
    if is_neg {
        try out.push_byte_grow(alloc, b'-');
        v = -v;
    }
    if exp == 0x7FF_u64 {
        try out.push_str_grow(alloc, "inf");
        return;
    }
    if v == 0.0_f64 {
        try out.push_byte_grow(alloc, b'0');
        return;
    }
    if v > 1.0e18_f64 {
        try out.push_str_grow(alloc, "inf");
        return;
    }
    let ipart = v.trunc_to_int.[u64]();
    try out.push_u64_grow(alloc, ipart);
    var frac = v - ipart.to_float.[f64]();
    if frac <= 1.0e-12_f64 {
        return;
    }
    var digits: [12]u8 = [0_u8; 12];
    var last_nz: usize = 0_usize;
    var di: usize = 0_usize;
    while di < 12_usize {
        frac = frac * 10.0_f64;
        var d = frac.trunc_to_int.[u64]();
        if d > 9_u64 {
            d = 9_u64;
        }
        frac = frac - d.to_float.[f64]();
        digits[di] = b'0' +% d.trunc.[u8]();
        if d != 0_u64 {
            last_nz = di +% 1_usize;
        }
        di = di +% 1_usize;
    }
    if last_nz > 0_usize {
        try out.push_byte_grow(alloc, b'.');
        var ki: usize = 0_usize;
        while ki < last_nz && ki < 12_usize {
            try out.push_byte_grow(alloc, digits[ki]);
            ki = ki +% 1_usize;
        }
    }
    return;
}

fn arena_stmt_at(arena: *ast.AstArena, r: ast.IdRange, i: usize) -> ?u32 {
    let xs = arena.stmt_list_range(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn arena_expr_at(arena: *ast.AstArena, r: ast.IdRange, i: usize) -> ?u32 {
    let xs = arena.expr_list_range(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn arena_pat_at(arena: *ast.AstArena, r: ast.IdRange, i: usize) -> ?u32 {
    let xs = arena.pat_list_range(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn arena_arm_at(arena: *ast.AstArena, r: ast.IdRange, i: usize) -> ?ast.MatchArmNode {
    let xs = arena.match_arms_range(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn arena_pat_field_at(arena: *ast.AstArena, r: ast.IdRange, i: usize) -> ?ast.PatFieldNode {
    let xs = arena.pat_fields_range(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn arena_asm_op_at(arena: *ast.AstArena, r: ast.IdRange, i: usize) -> ?ast.AsmOperandNode {
    let xs = arena.asm_ops_range(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn arena_field_init_at(arena: *ast.AstArena, r: ast.IdRange, i: usize) -> ?ast.FieldInitNode {
    let xs = arena.field_inits_range(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn arena_generic_arg_at(arena: *ast.AstArena, r: ast.IdRange, i: usize) -> ?ast.GenericArgNode {
    let xs = arena.generic_args_range(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn arena_param_at(arena: *ast.AstArena, r: ast.IdRange, i: usize) -> ?ast.ParamNode {
    let xs = arena.params_range(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn ct_elem_at(ct: *ctvm.CtArena, r: ast.IdRange, i: usize) -> ?u32 {
    let xs = ct.elems_slice(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn call_inst_arg_at(table: *check.TypeTable, r: ast.IdRange, i: usize) -> ?types.GenericVal {
    let xs = table.call_inst_args_slice(r);
    if i < xs.len { return xs[i]; }
    return null;
}

fn sym_byte_at(interner: *span.SymInterner, sym: u32, i: usize) -> u8 {
    let bs = interner.get(sym);
    if i < bs.len { return bs[i]; }
    return 0_u8;
}

fn make_param_sig_simple(name: u32, sp: span.Span, modifier: ast.ParamModifier, ty: types.TyId) -> types.ParamSig {
    return types.ParamSig.{
        name: name,
        span: sp,
        is_self: false,
        is_comptime: false,
        modifier: modifier,
        access: .None,
        ty: ty,
        has_gpu_binding: false,
        gpu_set: 0_u32,
        gpu_binding: 0_u32,
        is_push_const: false,
        has_gpu_location: false,
        gpu_location: 0_u32,
    };
}

fn push_env_params(
    alloc: *mut AllocCap,
    env: *mut types.TypeEnv,
    ps: *[types.ParamSig],
) -> ast.IdRange ! OutOfMemory {
    let start = env.sigs.params.len().trunc.[u32]();
    try env.sigs.params.push_slice(alloc, ps);
    return ast.range_new(start, ps.len.trunc.[u32]());
}

// ===========================================================================
// Section 2: CfgBuilder Core, Type Substitution, Places, and Coercions
// ===========================================================================

impl CfgBuilder {
    fn init_entry(self: *mut Self) -> !OutOfMemory {
        let entry = try self.new_block();
        self.has_cur_bb = true;
        self.cur_bb = entry;
        try self.st.sc.scopes.push(
            self.alloc,
            ScopeMark.{ depth: 0_u32, vars_start: 0_u32, events_start: 0_u32 },
        );
        return;
    }

    fn subst(self: *mut Self, ty: types.TyId) -> types.TyId ! OutOfMemory {
        if self.st.sc.generic_subst.is_empty() {
            return ty;
        }
        return try check.subst_ty(self.alloc, self.env, ty, self.st.sc.generic_subst.as_slice());
    }

    fn subst_gargs_into(
        self: *mut Self,
        args: *[types.GenericVal],
        out: *mut col.DynBuf[types.GenericVal],
    ) -> !OutOfMemory {
        out.clear();
        if self.st.sc.generic_subst.is_empty() {
            try out.push_slice(self.alloc, args);
            return;
        }
        var i: usize = 0_usize;
        while i < args.len {
            let g = args[i];
            if g.kind == .Ty {
                let st = try check.subst_ty(self.alloc, self.env, g.id, self.st.sc.generic_subst.as_slice());
                try out.push(self.alloc, types.gval_ty(st));
            } else {
                try out.push(self.alloc, g);
            }
            i = i +% 1_usize;
        }
        return;
    }

    fn intern_generic_inst(
        self: *mut Self,
        base_key: cfg_ir.CfgFnKey,
        gargs: *[types.GenericVal],
    ) -> u32 ! OutOfMemory {
        if let existing = self.cfg.find_generic_inst(base_key, gargs) {
            return existing;
        }
        let id = self.cfg.generic_inst_count();
        try self.cfg.register_generic_inst(self.alloc, base_key, gargs, id);
        return id;
    }

    fn new_block(self: *mut Self) -> cfg_ir.BlockId ! OutOfMemory {
        let id = self.st.bufs.blocks.len().trunc.[u32]();
        var bb = cfg_ir.block_new(id);
        if self.cleanup_depth > 0_u32 {
            bb.is_cleanup = true;
            bb.is_errdefer = self.in_errdefer;
            bb.has_error_site_span = self.has_active_err_span;
            bb.error_site_span = self.active_err_span;
        }
        try self.st.bufs.blocks.push(self.alloc, bb);
        try self.st.bufs.blk_stmt_head.push(self.alloc, cfg_ir.CFG_NONE);
        try self.st.bufs.blk_stmt_tail.push(self.alloc, cfg_ir.CFG_NONE);
        try self.st.bufs.blk_stmt_count.push(self.alloc, 0_u32);
        return id;
    }

    fn current_scope_depth(self: *Self) -> u32 {
        let scs = self.st.sc.scopes.as_slice();
        if scs.len == 0_usize {
            return 0_u32;
        }
        return scs[scs.len - 1_usize].depth;
    }

    fn new_local(
        self: *mut Self,
        has_name: bool,
        name: u32,
        sp: span.Span,
        raw_ty: types.TyId,
        is_mut: bool,
        is_param: bool,
        is_self: bool,
        is_temp: bool,
        has_param_index: bool,
        param_index: u32,
    ) -> cfg_ir.LocalId ! OutOfMemory {
        let ty = try self.subst(raw_ty);
        let id = self.st.bufs.locals.len().trunc.[u32]();
        let is_linear = self.env.get(ty).kind != .Borrow && self.env.is_linear(ty);
        let is_borrowing_val = self.env.contains_borrowing_value(ty);
        let scope_depth = self.current_scope_depth();
        var loc = cfg_ir.local_new(id, ty, sp);
        loc.has_name = has_name;
        loc.name = name;
        loc.is_mut = is_mut;
        loc.is_param = is_param;
        loc.is_self = is_self;
        loc.is_temp = is_temp;
        loc.is_linear = is_linear;
        loc.is_borrowing_val = is_borrowing_val;
        loc.scope_depth = scope_depth;
        loc.has_param_index = has_param_index;
        loc.param_index = param_index;
        try self.st.bufs.locals.push(self.alloc, loc);
        return id;
    }

    fn local_ty(self: *Self, id: cfg_ir.LocalId) -> types.TyId {
        let ls = self.st.bufs.locals.as_slice();
        let idx = id.widen.[usize]();
        if idx < ls.len {
            return ls[idx].ty;
        }
        return types.TY_ERROR;
    }

    fn local_span(self: *Self, id: cfg_ir.LocalId) -> span.Span {
        let ls = self.st.bufs.locals.as_slice();
        let idx = id.widen.[usize]();
        if idx < ls.len {
            return ls[idx].span;
        }
        return span.span_dummy();
    }

    fn local_is_mut(self: *Self, id: cfg_ir.LocalId) -> bool {
        let ls = self.st.bufs.locals.as_slice();
        let idx = id.widen.[usize]();
        if idx < ls.len {
            return ls[idx].is_mut;
        }
        return false;
    }

    fn local_is_self(self: *Self, id: cfg_ir.LocalId) -> bool {
        let ls = self.st.bufs.locals.as_slice();
        let idx = id.widen.[usize]();
        if idx < ls.len {
            return ls[idx].is_self;
        }
        return false;
    }

    fn push_stmt(self: *mut Self, stmt: cfg_ir.CfgStmt) -> !OutOfMemory {
        if !self.has_cur_bb {
            return;
        }
        let bb_idx = self.cur_bb.widen.[usize]();
        let sid = self.st.bufs.stmts.len().trunc.[u32]();
        try self.st.bufs.stmts.push(self.alloc, stmt);
        try self.st.bufs.stmt_next.push(self.alloc, cfg_ir.CFG_NONE);
        let heads = self.st.bufs.blk_stmt_head.as_mut_slice();
        let tails = self.st.bufs.blk_stmt_tail.as_mut_slice();
        let counts = self.st.bufs.blk_stmt_count.as_mut_slice();
        if bb_idx < heads.len && bb_idx < tails.len && bb_idx < counts.len {
            let prev_tail = tails[bb_idx];
            if prev_tail == cfg_ir.CFG_NONE {
                heads[bb_idx] = sid;
            } else {
                let nexts = self.st.bufs.stmt_next.as_mut_slice();
                let pt_idx = prev_tail.widen.[usize]();
                if pt_idx < nexts.len {
                    nexts[pt_idx] = sid;
                }
            }
            tails[bb_idx] = sid;
            counts[bb_idx] = counts[bb_idx] +% 1_u32;
        }
        return;
    }

    fn emit_assign(self: *mut Self, sp: span.Span, dst_place_id: u32, rv: cfg_ir.CfgRvalue) -> !OutOfMemory {
        let rv_id = try self.cfg.add_rvalue(self.alloc, rv);
        try self.push_stmt(cfg_ir.stmt_assign(sp, dst_place_id, rv_id));
        return;
    }

    fn set_term(self: *mut Self, term: cfg_ir.CfgTerm) {
        if !self.has_cur_bb {
            return;
        }
        let idx = self.cur_bb.widen.[usize]();
        let bs = self.st.bufs.blocks.as_mut_slice();
        if idx < bs.len {
            bs[idx].term = term;
        }
        self.has_cur_bb = false;
    }

    fn set_block_term(self: *mut Self, bb: cfg_ir.BlockId, term: cfg_ir.CfgTerm) {
        let idx = bb.widen.[usize]();
        let bs = self.st.bufs.blocks.as_mut_slice();
        if idx < bs.len {
            bs[idx].term = term;
        }
    }

    fn new_temp(self: *mut Self, ty: types.TyId, sp: span.Span) -> cfg_ir.LocalId ! OutOfMemory {
        let id = try self.new_local(false, span.SYM_EMPTY, sp, ty, true, false, false, true, false, 0_u32);
        try self.push_stmt(cfg_ir.stmt_storage_live(sp, id));
        if !self.st.sc.scopes.is_empty() {
            try self.st.sc.scope_events.push(
                self.alloc,
                ScopeEvent.{
                    kind: .Local,
                    local: id,
                    body_kind: .Block,
                    body_id: ast.NONE_ID,
                    err_bind: ast.ident_none(),
                    span: sp,
                },
            );
        }
        return id;
    }

    fn new_temp_place(self: *mut Self, ty: types.TyId, sp: span.Span) -> u32 ! OutOfMemory {
        let loc = try self.new_temp(ty, sp);
        let lty = self.local_ty(loc);
        return try self.cfg.add_local_place(self.alloc, loc, lty, sp);
    }

    fn bind_user_local(
        self: *mut Self,
        sym: u32,
        sp: span.Span,
        ty: types.TyId,
        is_mut: bool,
    ) -> cfg_ir.LocalId ! OutOfMemory {
        if is_wildcard_sym(self.interner, sym) {
            return try self.new_temp(ty, sp);
        }
        let id = try self.new_local(true, sym, sp, ty, is_mut, false, false, false, false, 0_u32);
        try self.push_stmt(cfg_ir.stmt_storage_live(sp, id));
        if !self.st.sc.scopes.is_empty() {
            try self.st.sc.scope_vars.push(self.alloc, ScopeVar.{ sym: sym, local: id });
            try self.st.sc.scope_events.push(
                self.alloc,
                ScopeEvent.{
                    kind: .Local,
                    local: id,
                    body_kind: .Block,
                    body_id: ast.NONE_ID,
                    err_bind: ast.ident_none(),
                    span: sp,
                },
            );
        }
        return id;
    }

    fn bind_params(self: *mut Self) -> !OutOfMemory {
        var ps_copy = try col.DynBuf.[types.ParamSig].init(self.alloc, self.sig.params.len.widen.[usize]() +% 1_usize);
        errdefer ps_copy.destroy(self.alloc);
        try ps_copy.push_slice(self.alloc, self.env.params_range(self.sig.params));
        let ps = ps_copy.as_slice();
        var i: usize = 0_usize;
        while i < ps.len {
            let p = ps[i];
            let is_mut = p.modifier == .Mut || p.access == .Write;
            let id = try self.new_local(
                true,
                p.name,
                p.span,
                p.ty,
                is_mut,
                true,
                p.is_self,
                false,
                true,
                i.trunc.[u32](),
            );
            try self.st.bufs.params.push(self.alloc, id);
            if !is_wildcard_sym(self.interner, p.name) && !self.st.sc.scopes.is_empty() {
                try self.st.sc.scope_vars.push(self.alloc, ScopeVar.{ sym: p.name, local: id });
                try self.st.sc.scope_events.push(
                    self.alloc,
                    ScopeEvent.{
                        kind: .Local,
                        local: id,
                        body_kind: .Block,
                        body_id: ast.NONE_ID,
                        err_bind: ast.ident_none(),
                        span: p.span,
                    },
                );
            }
            i = i +% 1_usize;
        }
        ps_copy.destroy(self.alloc);
        return;
    }

    fn lookup_local(self: *Self, sym: u32) -> ?cfg_ir.LocalId {
        let vs = self.st.sc.scope_vars.as_slice();
        var i = vs.len;
        while i > 0_usize {
            i = i - 1_usize;
            if vs[i].sym == sym {
                return vs[i].local;
            }
        }
        return null;
    }

    fn lookup_captured(self: *Self, sym: u32) -> ?CapturedAlias {
        let cs = self.st.sc.captured_aliases.as_slice();
        var i: usize = 0_usize;
        while i < cs.len {
            if cs[i].sym == sym {
                return cs[i];
            }
            i = i +% 1_usize;
        }
        return null;
    }

    fn lookup_local_const(self: *Self, sym: u32) -> ?types.IntVal {
        let cs = self.st.sc.consts.as_slice();
        var i = cs.len;
        while i > 0_usize {
            i = i - 1_usize;
            if cs[i].sym == sym {
                return cs[i].val;
            }
        }
        return null;
    }

    fn push_scope(self: *mut Self) -> !OutOfMemory {
        let depth = self.st.sc.scopes.len().trunc.[u32]();
        let vstart = self.st.sc.scope_vars.len().trunc.[u32]();
        let estart = self.st.sc.scope_events.len().trunc.[u32]();
        try self.st.sc.scopes.push(
            self.alloc,
            ScopeMark.{ depth: depth, vars_start: vstart, events_start: estart },
        );
        return;
    }

    fn pop_scope_discard(self: *mut Self) {
        let mark = self.st.sc.scopes.pop() orelse {
            return;
        };
        let vlim = mark.vars_start.widen.[usize]();
        while self.st.sc.scope_vars.len() > vlim {
            _ = self.st.sc.scope_vars.pop();
        }
        let elim = mark.events_start.widen.[usize]();
        while self.st.sc.scope_events.len() > elim {
            _ = self.st.sc.scope_events.pop();
        }
    }

    @recursive
    fn unwind_events(
        self: *mut Self,
        events: *[ScopeEvent],
        include_errdefer: bool,
        has_err_val: bool,
        err_val: cfg_ir.CfgOperand,
    ) -> !OutOfMemory {
        var i = events.len;
        while i > 0_usize {
            i = i - 1_usize;
            if !self.has_cur_bb {
                break;
            }
            let ev = events[i];
            match ev.kind {
                .Local => {
                    let sp = self.local_span(ev.local);
                    try self.push_stmt(cfg_ir.stmt_storage_dead(sp, ev.local));
                }
                .Defer => {
                    try self.lower_cleanup_body(
                        ev.body_kind,
                        ev.body_id,
                        false,
                        ast.ident_none(),
                        false,
                        cfg_ir.op_none(),
                        ev.span,
                    );
                }
                .Errdefer => {
                    if include_errdefer {
                        try self.lower_cleanup_body(
                            ev.body_kind,
                            ev.body_id,
                            true,
                            ev.err_bind,
                            has_err_val,
                            err_val,
                            ev.span,
                        );
                    }
                }
            }
        }
        return;
    }

    @recursive
    fn pop_scope_normal(self: *mut Self) -> !OutOfMemory {
        let mark = self.st.sc.scopes.pop() orelse {
            return;
        };
        let elim = mark.events_start.widen.[usize]();
        let total = self.st.sc.scope_events.len();
        let count = if total > elim { total - elim } else { 0_usize };
        var saved = try col.DynBuf.[ScopeEvent].init(self.alloc, count +% 1_usize);
        errdefer saved.destroy(self.alloc);
        if count > 0_usize {
            let all = self.st.sc.scope_events.as_slice();
            let sub = all.sub(elim, total) catch {
                all
            };
            if sub.len == count {
                try saved.push_slice(self.alloc, sub);
            }
        }
        let vlim = mark.vars_start.widen.[usize]();
        while self.st.sc.scope_vars.len() > vlim {
            _ = self.st.sc.scope_vars.pop();
        }
        while self.st.sc.scope_events.len() > elim {
            _ = self.st.sc.scope_events.pop();
        }
        if self.has_cur_bb && saved.len() > 0_usize {
            try self.unwind_events(saved.as_slice(), false, false, cfg_ir.op_none());
        }
        saved.destroy(self.alloc);
        return;
    }

    @recursive
    fn emit_unwind_to_scope(
        self: *mut Self,
        target_len: usize,
        include_errdefer: bool,
        has_err_val: bool,
        err_val: cfg_ir.CfgOperand,
    ) -> !OutOfMemory {
        let scs = self.st.sc.scopes.as_slice();
        if target_len >= scs.len {
            return;
        }
        let elim = scs[target_len].events_start.widen.[usize]();
        let total = self.st.sc.scope_events.len();
        if total <= elim {
            return;
        }
        let count = total - elim;
        var saved = try col.DynBuf.[ScopeEvent].init(self.alloc, count +% 1_usize);
        errdefer saved.destroy(self.alloc);
        let all = self.st.sc.scope_events.as_slice();
        let sub = all.sub(elim, total) catch {
            all
        };
        if sub.len == count {
            try saved.push_slice(self.alloc, sub);
        }
        try self.unwind_events(saved.as_slice(), include_errdefer, has_err_val, err_val);
        saved.destroy(self.alloc);
        return;
    }

    @recursive
    fn lower_cleanup_body(
        self: *mut Self,
        body_kind: ast.BodyKind,
        body_id: u32,
        is_errdefer: bool,
        err_bind: ast.IdentSpan,
        has_err_val: bool,
        err_val: cfg_ir.CfgOperand,
        sp: span.Span,
    ) -> !OutOfMemory {
        _ = sp;
        let saved_errdefer = self.in_errdefer;
        self.cleanup_depth = self.cleanup_depth +% 1_u32;
        if is_errdefer {
            self.in_errdefer = true;
        }
        let body_bb = try self.new_block();
        self.set_term(cfg_ir.term_goto(body_bb));
        self.has_cur_bb = true;
        self.cur_bb = body_bb;

        try self.push_scope();
        if ast.ident_is_some(err_bind) {
            var ety = types.TY_ERROR;
            if has_err_val {
                let vt = self.operand_ty(err_val);
                if vt != types.TY_ERROR {
                    ety = vt;
                }
            }
            if ety == types.TY_ERROR {
                ety = try self.enclosing_err_set_ty();
            }
            let loc = try self.bind_user_local(err_bind.sym, err_bind.span, ety, false);
            if has_err_val {
                let place_id = try self.cfg.add_local_place(self.alloc, loc, self.local_ty(loc), err_bind.span);
                try self.emit_assign(err_bind.span, place_id, cfg_ir.rvalue_use(err_val));
            }
        }
        if body_kind == .Block {
            var has_blk = false;
            var blk_stmts = ast.range_empty();
            var blk_tail: u32 = ast.NONE_ID;
            if let blk = self.arena.get_block(body_id) {
                has_blk = true;
                blk_stmts = blk.stmts;
                blk_tail = blk.tail_expr;
            }
            if has_blk {
                let n_stmts = blk_stmts.len.widen.[usize]();
                var i: usize = 0_usize;
                while i < n_stmts {
                    if !self.has_cur_bb {
                        break;
                    }
                    if let sid = arena_stmt_at(self.arena, blk_stmts, i) {
                        try self.lower_stmt(sid);
                    }
                    i = i +% 1_usize;
                }
                if self.has_cur_bb && blk_tail != ast.NONE_ID {
                    _ = try self.lower_expr_rvalue(blk_tail, types.TY_NONE);
                }
            }
        } else if body_kind == .Expr {
            _ = try self.lower_expr_rvalue(body_id, types.TY_NONE);
        }
        try self.pop_scope_normal();

        self.in_errdefer = saved_errdefer;
        self.cleanup_depth = self.cleanup_depth -% 1_u32;
        if self.has_cur_bb {
            let cont_bb = try self.new_block();
            self.set_term(cfg_ir.term_goto(cont_bb));
            self.has_cur_bb = true;
            self.cur_bb = cont_bb;
        }
        return;
    }

    fn finish_fn(self: *mut Self) -> cfg_ir.CfgFunction ! OutOfMemory {
        let n_blocks = self.st.bufs.blocks.len();
        let heads = self.st.bufs.blk_stmt_head.as_slice();
        let counts = self.st.bufs.blk_stmt_count.as_slice();
        let all_stmts = self.st.bufs.stmts.as_slice();
        let nexts = self.st.bufs.stmt_next.as_slice();

        var bi: usize = 0_usize;
        while bi < n_blocks {
            let st_start = self.cfg.funcs.stmts.len().trunc.[u32]();
            var cur = if bi < heads.len { heads[bi] } else { cfg_ir.CFG_NONE };
            while cur != cfg_ir.CFG_NONE {
                let ci = cur.widen.[usize]();
                if ci >= all_stmts.len || ci >= nexts.len {
                    break;
                }
                try self.cfg.funcs.stmts.push(self.alloc, all_stmts[ci]);
                cur = nexts[ci];
            }
            let cnt = if bi < counts.len { counts[bi] } else { 0_u32 };
            let bs_mut = self.st.bufs.blocks.as_mut_slice();
            if bi < bs_mut.len {
                bs_mut[bi].stmts = ast.range_new(st_start, cnt);
            }
            bi = bi +% 1_usize;
        }

        let params_r = try self.cfg.add_param_locals(self.alloc, self.st.bufs.params.as_slice());
        let locals_r = try self.cfg.add_locals(self.alloc, self.st.bufs.locals.as_slice());
        let blocks_r = try self.cfg.add_blocks(self.alloc, self.st.bufs.blocks.as_slice());
        let par_r = try self.cfg.add_par_for_regions(self.alloc, self.st.sc.par_for_regions.as_slice());
        let inv_r = try self.cfg.add_loop_invariants(self.alloc, self.st.sc.loop_invariants.as_slice());

        var f = cfg_ir.fn_new(self.key, self.module_id, self.sig.name, self.body_span, self.sig, self.is_sys);
        f.params = params_r;
        f.locals = locals_r;
        f.blocks = blocks_r;
        f.entry = 0_u32;
        f.where_clauses = self.where_clauses;
        f.ensures_clauses = self.ensures_clauses;
        f.loop_invariants = inv_r;
        f.has_base_generic = self.has_base_generic;
        f.base_generic_key = self.base_generic_key;
        f.base_generic_args = self.base_generic_args;
        f.par_for_regions = par_r;
        return f;
    }

    fn operand_ty(self: *Self, op: cfg_ir.CfgOperand) -> types.TyId {
        return self.cfg.operand_ty(0_u32, op, self.env);
    }

    fn place_ty(self: *Self, place_id: u32) -> types.TyId {
        if let p = self.cfg.get_place(place_id) {
            return p.ty;
        }
        return types.TY_ERROR;
    }

    fn operand_for_place(self: *Self, place_id: u32) -> cfg_ir.CfgOperand {
        let ty = self.place_ty(place_id);
        if self.env.is_linear(ty) {
            return cfg_ir.op_move(place_id);
        }
        return cfg_ir.op_copy(place_id);
    }

    fn extend_place(
        self: *mut Self,
        base_place_id: u32,
        extra: cfg_ir.CfgProj,
        new_ty: types.TyId,
        sp: span.Span,
    ) -> u32 ! OutOfMemory {
        var loc: cfg_ir.LocalId = 0_u32;
        if let bp = self.cfg.get_place(base_place_id) {
            loc = bp.local;
        }
        let existing = self.cfg.place_projs(base_place_id);
        var buf = try col.DynBuf.[cfg_ir.CfgProj].init(self.alloc, existing.len +% 1_usize);
        errdefer buf.destroy(self.alloc);
        try buf.push_slice(self.alloc, existing);
        try buf.push(self.alloc, extra);
        let pid = try self.cfg.add_place_with_projs(self.alloc, loc, buf.as_slice(), new_ty, sp);
        buf.destroy(self.alloc);
        return pid;
    }

    fn make_captured_place(self: *mut Self, cap: CapturedAlias, sp: span.Span) -> u32 ! OutOfMemory {
        let projs: [3]cfg_ir.CfgProj = [
            cfg_ir.proj_deref(),
            cfg_ir.proj_tuple_field(cap.field_idx, cap.ptr_ty),
            cfg_ir.proj_deref(),
        ];
        return try self.cfg.add_place_with_projs(self.alloc, cap.env_loc, &projs, cap.inner_ty, sp);
    }

    fn expr_ty(self: *mut Self, expr_id: u32, fallback: types.TyId) -> types.TyId ! OutOfMemory {
        var raw_ty = fallback;
        if let t = self.table.get_expr_ty(expr_id) {
            if t != types.TY_ERROR && t != types.TY_COMPTIME_INT && t != types.TY_COMPTIME_FLOAT {
                raw_ty = t;
            }
        } else if let t2 = self.table.get_span_ty(expr_span(self.arena, expr_id)) {
            if t2 != types.TY_ERROR && t2 != types.TY_COMPTIME_INT && t2 != types.TY_COMPTIME_FLOAT {
                raw_ty = t2;
            }
        }
        return try self.subst(raw_ty);
    }

    fn raw_ty_expr(self: *mut Self, expr_id: u32) -> types.TyId ! OutOfMemory {
        var raw_ty = types.TY_ERROR;
        if let t = self.table.get_expr_ty(expr_id) {
            raw_ty = t;
        } else if let t2 = self.table.get_span_ty(expr_span(self.arena, expr_id)) {
            raw_ty = t2;
        }
        return try self.subst(raw_ty);
    }

    fn raw_ty_span(self: *mut Self, sp: span.Span) -> types.TyId ! OutOfMemory {
        let raw_ty = self.table.get_span_ty(sp) orelse types.TY_ERROR;
        return try self.subst(raw_ty);
    }

    fn enclosing_err_set_ty(self: *mut Self) -> types.TyId ! OutOfMemory {
        let n = self.env.get(self.sig.ret);
        if n.kind == .ErrorUnion {
            var has_e0 = false;
            var e0 = types.err_src_user(0_u32);
            let errs = self.env.node_err_src_list(&n);
            if errs.len > 0_usize {
                has_e0 = true;
                e0 = errs[0_usize];
            }
            if has_e0 {
                return try self.env.intern_error_set(self.alloc, e0);
            }
        }
        return types.TY_U32;
    }

    fn pick_concrete_int_ty(self: *Self, ty: types.TyId, expected: types.TyId) -> types.TyId {
        if self.env.is_concrete_integer(ty) {
            return ty;
        }
        if expected != types.TY_NONE {
            if self.env.is_concrete_integer(expected) {
                return expected;
            }
            let en = self.env.get(expected);
            if (en.kind == .Optional || en.kind == .ErrorUnion) && self.env.is_concrete_integer(en.primary) {
                return en.primary;
            }
        }
        return types.TY_I64;
    }

    fn emit_bin_tmp(
        self: *mut Self,
        op: ast.BinaryOp,
        lhs: cfg_ir.CfgOperand,
        rhs: cfg_ir.CfgOperand,
        ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let dst = try self.new_temp_place(ty, sp);
        try self.emit_assign(sp, dst, cfg_ir.rvalue_binary(op, lhs, rhs));
        return cfg_ir.op_copy(dst);
    }

    fn emit_unary_tmp(
        self: *mut Self,
        op: ast.UnaryOp,
        operand: cfg_ir.CfgOperand,
        ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let dst = try self.new_temp_place(ty, sp);
        try self.emit_assign(sp, dst, cfg_ir.rvalue_unary(op, operand));
        return cfg_ir.op_copy(dst);
    }

    fn coerce_error_into_union(
        self: *mut Self,
        op: cfg_ir.CfgOperand,
        sp: span.Span,
        target_union: types.TyId,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let dst = try self.new_temp_place(target_union, sp);
        try self.emit_assign(sp, dst, cfg_ir.rvalue_cast(.WrapErr, op, target_union));
        return self.operand_for_place(dst);
    }

    @recursive
    fn coerce_operand(
        self: *mut Self,
        op: cfg_ir.CfgOperand,
        to_ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        if to_ty == types.TY_NONE || to_ty == types.TY_ERROR || to_ty == types.TY_VOID {
            return op;
        }
        let from_ty = self.operand_ty(op);
        if from_ty == to_ty || from_ty == types.TY_ERROR || from_ty == types.TY_NEVER {
            return op;
        }
        var is_const_int = false;
        var is_const_float = false;
        var is_const_err_tag = false;
        var is_const_null = false;
        var cint_val = types.int_val_zero();
        var cfloat_bytes = ast.range_empty();
        if op.kind == .Const {
            if let c = self.cfg.get_const(op.id) {
                if c.kind == .Int {
                    is_const_int = true;
                    cint_val = c.int_val;
                } else if c.kind == .Float {
                    is_const_float = true;
                    cfloat_bytes = c.bytes;
                } else if c.kind == .ErrorTag {
                    is_const_err_tag = true;
                } else if c.kind == .Null {
                    is_const_null = true;
                }
            }
        }
        if is_const_int && self.env.is_integer(to_ty) {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(cint_val, to_ty));
        }
        if is_const_float && self.env.is_float(to_ty) {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_float(cfloat_bytes, to_ty));
        }

        let fn_node = self.env.get(from_ty);
        let tn_node = self.env.get(to_ty);

        // `*T` / `*mut T` -> `*dyn Iface` / `*mut dyn Iface`
        if fn_node.kind == .Borrow && fn_node.borrow_kind == .Single
            && tn_node.kind == .Borrow && tn_node.borrow_kind == .Single
        {
            let concrete_ty = fn_node.primary;
            let dyn_node = self.env.get(tn_node.primary);
            if dyn_node.kind == .Dyn && self.env.get(concrete_ty).kind != .Dyn {
                let dst = try self.new_temp_place(to_ty, sp);
                try self.emit_assign(
                    sp,
                    dst,
                    cfg_ir.rvalue_make_dyn(op, dyn_node.primary, concrete_ty, tn_node.flag0),
                );
                return self.operand_for_place(dst);
            }
        }

        // Chained coercion into `T ! E`
        if tn_node.kind == .ErrorUnion && from_ty != tn_node.primary && !is_const_err_tag && fn_node.kind != .ErrorSet {
            let ok_ty = tn_node.primary;
            let coerced_ok = try self.coerce_operand(op, ok_ty, sp);
            if self.operand_ty(coerced_ok) == ok_ty {
                let dst = try self.new_temp_place(to_ty, sp);
                try self.emit_assign(sp, dst, cfg_ir.rvalue_cast(.WrapOk, coerced_ok, to_ty));
                return self.operand_for_place(dst);
            }
            return coerced_ok;
        }

        // Chained coercion into `?T`
        if tn_node.kind == .Optional && from_ty != tn_node.primary && !is_const_null {
            let inner = tn_node.primary;
            let coerced_inner = try self.coerce_operand(op, inner, sp);
            if self.operand_ty(coerced_inner) == inner {
                let dst = try self.new_temp_place(to_ty, sp);
                try self.emit_assign(sp, dst, cfg_ir.rvalue_cast(.WrapOptional, coerced_inner, to_ty));
                return self.operand_for_place(dst);
            }
            return coerced_inner;
        }

        var has_cast = false;
        var ck: cfg_ir.CastKind = .Widen;
        if tn_node.kind == .Optional && from_ty == tn_node.primary {
            has_cast = true;
            ck = .WrapOptional;
        } else if tn_node.kind == .ErrorUnion && from_ty == tn_node.primary {
            has_cast = true;
            ck = .WrapOk;
        } else if tn_node.kind == .ErrorUnion && (is_const_err_tag || fn_node.kind == .ErrorSet) {
            has_cast = true;
            ck = .WrapErr;
        } else if fn_node.kind == .Borrow && fn_node.flag0
            && tn_node.kind == .Borrow && !tn_node.flag0
            && fn_node.borrow_kind == tn_node.borrow_kind
            && (fn_node.borrow_kind == .Str || fn_node.primary == tn_node.primary)
        {
            has_cast = true;
            ck = .MutToConst;
        } else if fn_node.kind == .Borrow && fn_node.borrow_kind == .Single
            && tn_node.kind == .Borrow && tn_node.borrow_kind == .Slice
            && self.env.get(fn_node.primary).kind == .Array
        {
            has_cast = true;
            ck = .ArrayBorrowToSlice;
        }

        if has_cast {
            let dst = try self.new_temp_place(to_ty, sp);
            try self.emit_assign(sp, dst, cfg_ir.rvalue_cast(ck, op, to_ty));
            return self.operand_for_place(dst);
        }
        return op;
    }

    fn lower_try_into(
        self: *mut Self,
        rop: cfg_ir.CfgOperand,
        ret_ty: types.TyId,
        sym_for_tag: u32,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let from_ty = self.operand_ty(rop);
        let rn = self.env.get(ret_ty);
        let to_ty = if rn.kind == .ErrorUnion { rn.primary } else { ret_ty };
        let fn_node = self.env.get(from_ty);
        let tn_node = self.env.get(to_ty);
        let from_bits: u8 = if fn_node.flag1 { 64_u8 } else { fn_node.u8_val };
        let to_bits: u8 = if tn_node.flag1 { 64_u8 } else { tn_node.u8_val };
        let fb = types.int_bounds(fn_node);
        let tb = types.int_bounds(tn_node);
        if !fb.valid || !tb.valid {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        }
        let cast_kind: cfg_ir.CastKind = if to_bits > from_bits { .Widen } else { .Trunc };

        let res_place = try self.new_temp_place(ret_ty, sp);
        let ok_bb = try self.new_block();
        let err_bb = try self.new_block();
        let merge_bb = try self.new_block();

        var check_ops: [2]ast.BinaryOp = [.GtEq, .LtEq];
        var check_bounds: [2]types.IntVal = [types.int_val_zero(), types.int_val_zero()];
        var n_checks: usize = 0_usize;
        if types.int_val_cmp(tb.min, fb.min) > 0_i32 {
            check_ops[n_checks] = .GtEq;
            check_bounds[n_checks] = tb.min;
            n_checks = n_checks +% 1_usize;
        }
        if types.int_val_cmp(tb.max, fb.max) < 0_i32 {
            check_ops[n_checks] = .LtEq;
            check_bounds[n_checks] = tb.max;
            n_checks = n_checks +% 1_usize;
        }
        if n_checks == 0_usize {
            self.set_term(cfg_ir.term_goto(ok_bb));
        }
        var ci: usize = 0_usize;
        while ci < n_checks {
            let c_place = try self.new_temp_place(types.TY_BOOL, sp);
            let b_op = try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(check_bounds[ci], from_ty));
            try self.emit_assign(sp, c_place, cfg_ir.rvalue_binary(check_ops[ci], rop, b_op));
            let next_bb = if ci +% 1_usize == n_checks { ok_bb } else { try self.new_block() };
            self.set_term(cfg_ir.term_branch(cfg_ir.op_copy(c_place), next_bb, err_bb, sp, false));
            self.has_cur_bb = true;
            self.cur_bb = next_bb;
            ci = ci +% 1_usize;
        }

        self.has_cur_bb = true;
        self.cur_bb = ok_bb;
        let v_place = try self.new_temp_place(to_ty, sp);
        try self.emit_assign(sp, v_place, cfg_ir.rvalue_cast(cast_kind, rop, to_ty));
        let wrapped = try self.coerce_operand(cfg_ir.op_copy(v_place), ret_ty, sp);
        try self.emit_assign(sp, res_place, cfg_ir.rvalue_use(wrapped));
        self.set_term(cfg_ir.term_goto(merge_bb));

        self.has_cur_bb = true;
        self.cur_bb = err_bb;
        let tag = try self.cfg.add_const_op(self.alloc, cfg_ir.const_error_tag(ret_ty, sym_for_tag, 1_u32));
        try self.emit_assign(sp, res_place, cfg_ir.rvalue_cast(.WrapErr, tag, ret_ty));
        self.set_term(cfg_ir.term_goto(merge_bb));

        self.has_cur_bb = true;
        self.cur_bb = merge_bb;
        return cfg_ir.op_copy(res_place);
    }
}

// ===========================================================================
// Section 3: Body, Statements, Assignments, Jumps, Control Flow & Patterns
// ===========================================================================

fn assign_op_to_bin_op(op: ast.AssignOp) -> ast.BinaryOp {
    match op {
        .AddAssign => { return .Add; }
        .SubAssign => { return .Sub; }
        .MulAssign => { return .Mul; }
        .AddWrapAssign => { return .AddWrap; }
        .SubWrapAssign => { return .SubWrap; }
        .MulWrapAssign => { return .MulWrap; }
        .AddSatAssign => { return .AddSat; }
        .SubSatAssign => { return .SubSat; }
        .MulSatAssign => { return .MulSat; }
        .BitAndAssign => { return .BitAnd; }
        .BitOrAssign => { return .BitOr; }
        .BitXorAssign => { return .BitXor; }
        .ShlAssign => { return .Shl; }
        .ShrAssign => { return .Shr; }
        .Assign => { return .Add; }
    }
}

impl CfgBuilder {
    @recursive
    fn lower_body(self: *mut Self, body_id: u32) -> !OutOfMemory {
        var has_blk = false;
        var blk_tail: u32 = ast.NONE_ID;
        var blk_span = span.span_dummy();
        if let blk = self.arena.get_block(body_id) {
            has_blk = true;
            blk_tail = blk.tail_expr;
            blk_span = blk.span;
        }
        if !has_blk {
            self.pop_scope_discard();
            return;
        }
        let ret_ty = self.sig.ret;
        if ret_ty != types.TY_VOID && ret_ty != types.TY_NEVER && blk_tail != ast.NONE_ID {
            let ret_dst = try self.new_temp_place(ret_ty, blk_span);
            try self.lower_block_into(body_id, true, ret_dst, ret_ty);
            if self.has_cur_bb {
                let rv = self.operand_for_place(ret_dst);
                try self.emit_unwind_to_scope(0_usize, false, false, cfg_ir.op_none());
                self.set_term(cfg_ir.term_return_val(rv, blk_span));
            }
            self.pop_scope_discard();
            return;
        }
        try self.lower_block_into(body_id, false, cfg_ir.CFG_NONE, types.TY_NONE);
        if self.has_cur_bb {
            try self.emit_unwind_to_scope(0_usize, false, false, cfg_ir.op_none());
            self.set_term(cfg_ir.term_return_void(blk_span));
        }
        self.pop_scope_discard();
        return;
    }

    @recursive
    fn lower_block_into(
        self: *mut Self,
        block_id: u32,
        has_dst: bool,
        dst_place_id: u32,
        expected_ty: types.TyId,
    ) -> !OutOfMemory {
        var has_blk = false;
        var blk_stmts = ast.range_empty();
        var blk_tail: u32 = ast.NONE_ID;
        if let blk = self.arena.get_block(block_id) {
            has_blk = true;
            blk_stmts = blk.stmts;
            blk_tail = blk.tail_expr;
        }
        if !has_blk {
            return;
        }
        try self.push_scope();
        let n_stmts = blk_stmts.len.widen.[usize]();
        var i: usize = 0_usize;
        while i < n_stmts {
            if !self.has_cur_bb {
                break;
            }
            if let sid = arena_stmt_at(self.arena, blk_stmts, i) {
                try self.lower_stmt(sid);
            }
            i = i +% 1_usize;
        }
        if self.has_cur_bb && blk_tail != ast.NONE_ID {
            if has_dst {
                let exp = if expected_ty != types.TY_NONE { expected_ty } else { self.place_ty(dst_place_id) };
                try self.lower_expr_into(blk_tail, dst_place_id, exp);
            } else {
                _ = try self.lower_expr_rvalue(blk_tail, expected_ty);
            }
        }
        try self.pop_scope_normal();
        return;
    }

    fn resolve_binding_hint(
        self: *mut Self,
        ty_node_id: u32,
    ) -> types.TyId ! OutOfMemory {
        if ty_node_id != ast.NONE_ID {
            var has_tn = false;
            var tn_span = span.span_dummy();
            if let tn = self.arena.get_type(ty_node_id) {
                has_tn = true;
                tn_span = tn.span;
            }
            if has_tn {
                let t = try self.raw_ty_span(tn_span);
                if t != types.TY_ERROR {
                    return try self.subst(t);
                }
            }
        }
        return types.TY_NONE;
    }

    @recursive
    fn lower_stmt_let(
        self: *mut Self,
        pat_id: u32,
        ty_id: u32,
        init_id: u32,
        sp: span.Span,
    ) -> !OutOfMemory {
        let init_ty = try self.expr_ty(init_id, types.TY_ERROR);
        var is_wild = false;
        if let p = self.arena.get_pat(pat_id) {
            is_wild = p.kind == .Wildcard;
        }
        if is_wild && self.env.is_linear(init_ty) {
            var has_loc = false;
            var loc: cfg_ir.LocalId = 0_u32;
            if let ie = self.arena.get_expr(init_id) {
                if ie.kind == .Ident {
                    if let lid = self.lookup_local(ie.a) {
                        has_loc = true;
                        loc = lid;
                    }
                }
            }
            _ = try self.lower_expr_rvalue(init_id, types.TY_NONE);
            try self.push_stmt(cfg_ir.stmt_discard_linear_error(sp, has_loc, loc, sp));
            return;
        }
        let decl_ty = try self.resolve_binding_hint(ty_id);
        var hint = decl_ty;
        if hint == types.TY_NONE {
            let expected = try self.raw_ty_expr(init_id);
            if expected != types.TY_ERROR && expected != types.TY_COMPTIME_INT && expected != types.TY_COMPTIME_FLOAT {
                hint = expected;
            }
        }
        var val_op = try self.lower_expr_rvalue(init_id, hint);
        if !self.has_cur_bb {
            return;
        }
        if decl_ty != types.TY_NONE {
            val_op = try self.coerce_operand(val_op, decl_ty, expr_span(self.arena, init_id));
        }
        let val_ty = if decl_ty != types.TY_NONE { decl_ty } else { self.operand_ty(val_op) };
        try self.lower_bind_pattern(pat_id, val_op, val_ty, false);
        return;
    }

    @recursive
    fn lower_stmt_var(
        self: *mut Self,
        attrs_range: ast.IdRange,
        ty_id: u32,
        init_id: u32,
        ident: ast.IdentSpan,
        sp: span.Span,
    ) -> !OutOfMemory {
        let decl_ty = try self.resolve_binding_hint(ty_id);
        var hint = decl_ty;
        if hint == types.TY_NONE {
            let expected = try self.raw_ty_expr(init_id);
            if expected != types.TY_ERROR && expected != types.TY_COMPTIME_INT && expected != types.TY_COMPTIME_FLOAT {
                hint = expected;
            }
        }
        var val_op = try self.lower_expr_rvalue(init_id, hint);
        if !self.has_cur_bb {
            return;
        }
        if decl_ty != types.TY_NONE {
            val_op = try self.coerce_operand(val_op, decl_ty, expr_span(self.arena, init_id));
        }
        let val_ty = if decl_ty != types.TY_NONE { decl_ty } else { self.operand_ty(val_op) };
        let vloc = try self.bind_user_local(ident.sym, ident.span, val_ty, true);
        let vattrs = self.arena.attrs_range(attrs_range);
        var vai: usize = 0_usize;
        while vai < vattrs.len {
            if str.bytes_eq(self.interner.get(vattrs[vai].name.sym), "gpu_shared".as_bytes()) {
                var ls = self.st.bufs.locals.as_mut_slice();
                if vloc.widen.[usize]() < ls.len {
                    ls[vloc.widen.[usize]()].is_gpu_shared = true;
                }
                break;
            }
            vai = vai +% 1_usize;
        }
        let dst = try self.cfg.add_local_place(self.alloc, vloc, self.local_ty(vloc), ident.span);
        try self.emit_assign(sp, dst, cfg_ir.rvalue_use(val_op));
        return;
    }

    @recursive
    fn lower_stmt_const(self: *mut Self, const_id: u32, sp: span.Span) -> !OutOfMemory {
        var has_c = false;
        var c_value: u32 = ast.NONE_ID;
        var c_name = ast.ident_none();
        if let c = self.arena.get_const_decl(const_id) {
            has_c = true;
            c_value = c.value;
            c_name = c.name;
        }
        if !has_c {
            return;
        }
        let cty = try self.raw_ty_expr(c_value);
        if let iv = self.eval_simple_const_int(c_value) {
            try self.st.sc.consts.push(self.alloc, LocalConst.{ sym: c_name.sym, val: iv });
        }
        let val_op = try self.lower_expr_rvalue(c_value, cty);
        if !self.has_cur_bb {
            return;
        }
        let val_ty = if cty != types.TY_ERROR && cty != types.TY_COMPTIME_INT {
            cty
        } else {
            self.operand_ty(val_op)
        };
        let cloc = try self.bind_user_local(c_name.sym, c_name.span, val_ty, false);
        let dst = try self.cfg.add_local_place(self.alloc, cloc, self.local_ty(cloc), c_name.span);
        try self.emit_assign(sp, dst, cfg_ir.rvalue_use(val_op));
        return;
    }

    @recursive
    fn lower_stmt(self: *mut Self, stmt_id: u32) -> !OutOfMemory {
        var has_s = false;
        var s_kind: ast.StmtKind = .Expr;
        var s_a: u32 = ast.NONE_ID;
        var s_b: u32 = ast.NONE_ID;
        var s_c: u32 = ast.NONE_ID;
        var s_d: u32 = ast.NONE_ID;
        var s_ident = ast.ident_none();
        var s_list = ast.range_empty();
        var s_body_kind: ast.BodyKind = .Expr;
        var s_assign_op: ast.AssignOp = .Assign;
        var s_has_range = false;
        var s_range_kind: ast.RangeKind = .Exclusive;
        var s_span = span.span_dummy();
        if let s = self.arena.get_stmt(stmt_id) {
            has_s = true;
            s_kind = s.kind;
            s_a = s.a;
            s_b = s.b;
            s_c = s.c;
            s_d = s.d;
            s_ident = s.ident;
            s_list = s.list;
            s_body_kind = s.body_kind;
            s_assign_op = s.assign_op;
            s_has_range = s.has_range;
            s_range_kind = s.range_kind;
            s_span = s.span;
        }
        if !has_s {
            return;
        }
        match s_kind {
            .Let => { try self.lower_stmt_let(s_a, s_b, s_c, s_span); }
            .Var => { try self.lower_stmt_var(s_list, s_b, s_c, s_ident, s_span); }
            .Const => { try self.lower_stmt_const(s_a, s_span); }
            .Defer => {
                if !self.st.sc.scopes.is_empty() {
                    try self.st.sc.scope_events.push(
                        self.alloc,
                        ScopeEvent.{
                            kind: .Defer,
                            local: 0_u32,
                            body_kind: s_body_kind,
                            body_id: s_a,
                            err_bind: ast.ident_none(),
                            span: s_span,
                        },
                    );
                }
            }
            .Errdefer => {
                if !self.st.sc.scopes.is_empty() {
                    try self.st.sc.scope_events.push(
                        self.alloc,
                        ScopeEvent.{
                            kind: .Errdefer,
                            local: 0_u32,
                            body_kind: s_body_kind,
                            body_id: s_a,
                            err_bind: s_ident,
                            span: s_span,
                        },
                    );
                }
            }
            .Jump => { try self.lower_jump(s_a, s_span); }
            .If => { try self.lower_if(s_a, false, cfg_ir.CFG_NONE, types.TY_NONE); }
            .Match => { try self.lower_match(s_a, s_list, false, cfg_ir.CFG_NONE, types.TY_NONE, s_span); }
            .While => { try self.lower_while(s_ident, s_a, s_list, s_b, s_span); }
            .For => {
                try self.lower_for_inner(s_ident, s_a, s_c, s_has_range, s_range_kind, s_d, s_b, s_span, false);
            }
            .ParFor => {
                try self.lower_for_inner(ast.ident_none(), s_a, s_c, s_has_range, s_range_kind, s_d, s_b, s_span, true);
            }
            .Loop => { _ = try self.lower_loop(s_ident, s_a, false, cfg_ir.CFG_NONE, types.TY_NONE, s_span); }
            .ComptimeBlock => { try self.lower_block_into(s_a, false, cfg_ir.CFG_NONE, types.TY_NONE); }
            .RawBlock => { try self.lower_block_into(s_a, false, cfg_ir.CFG_NONE, types.TY_NONE); }
            .Assign => { try self.lower_assign(s_a, s_assign_op, s_b, s_span); }
            .Discard => {
                let ety = try self.expr_ty(s_a, types.TY_ERROR);
                if self.env.is_linear(ety) {
                    var has_loc = false;
                    var loc: cfg_ir.LocalId = 0_u32;
                    if let ie = self.arena.get_expr(s_a) {
                        if ie.kind == .Ident {
                            if let lid = self.lookup_local(ie.a) {
                                has_loc = true;
                                loc = lid;
                            }
                        }
                    }
                    _ = try self.lower_expr_rvalue(s_a, types.TY_NONE);
                    try self.push_stmt(cfg_ir.stmt_discard_linear_error(s_span, has_loc, loc, s_span));
                } else {
                    let op = try self.lower_expr_rvalue(s_a, types.TY_NONE);
                    if self.has_cur_bb && (op.kind == .Copy || op.kind == .Move) {
                        let oty = self.operand_ty(op);
                        if oty != types.TY_VOID && oty != types.TY_NEVER {
                            let dst = try self.new_temp_place(oty, s_span);
                            try self.emit_assign(s_span, dst, cfg_ir.rvalue_use(op));
                        }
                    }
                }
            }
            .Expr => {
                _ = try self.lower_expr_rvalue(s_a, types.TY_NONE);
            }
        }
        return;
    }

    fn is_pool_reset_assign(self: *Self, lhs_id: u32, rhs_id: u32) -> bool {
        let le = self.arena.get_expr(lhs_id) orelse { return false; };
        let re = self.arena.get_expr(rhs_id) orelse { return false; };
        if le.kind != .Ident || re.kind != .Call || re.list.len != 0_u32 {
            return false;
        }
        let ce = self.arena.get_expr(re.a) orelse { return false; };
        if ce.kind != .Field || !sym_is(self.interner, ce.ident.sym, "reset") {
            return false;
        }
        let be = self.arena.get_expr(ce.a) orelse { return false; };
        return be.kind == .Ident && be.a == le.a;
    }

    @recursive
    fn lower_assign(
        self: *mut Self,
        lhs_id: u32,
        op: ast.AssignOp,
        rhs_id: u32,
        sp: span.Span,
    ) -> !OutOfMemory {
        let lhs_sp = expr_span(self.arena, lhs_id);
        let rhs_sp = expr_span(self.arena, rhs_id);
        if op == .Assign && self.is_pool_reset_assign(lhs_id, rhs_id) {
            if let le = self.arena.get_expr(lhs_id) {
                if let pool_local = self.lookup_local(le.a) {
                    let pool_ty = self.local_ty(pool_local);
                    var elem_ty = types.TY_ERROR;
                    let pn = self.env.get(pool_ty);
                    if pn.kind == .Builtin && pn.builtin_kind == .ArenaPool {
                        let gs = self.env.node_gval_list(&pn);
                        if gs.len > 0_usize && gs[0_usize].kind == .Ty {
                            elem_ty = gs[0_usize].id;
                        }
                    }
                    let pool_place = try self.cfg.add_local_place(self.alloc, pool_local, pool_ty, lhs_sp);
                    let tmp_place = try self.new_temp_place(pool_ty, rhs_sp);
                    let cargs: [1]cfg_ir.CfgOperand = [cfg_ir.op_copy(pool_place)];
                    let cspans: [1]span.Span = [lhs_sp];
                    let cid = try self.cfg.add_call_data(
                        self.alloc,
                        cfg_ir.callee_builtin(cfg_ir.builtin_op_ty(.ArenaPoolReset, elem_ty)),
                        &cargs,
                        &cspans,
                        true,
                        pool_place,
                        true,
                        lhs_sp,
                        true,
                        false,
                    );
                    try self.push_stmt(cfg_ir.stmt_call(rhs_sp, tmp_place, cid));
                    try self.emit_assign(sp, pool_place, cfg_ir.rvalue_use(cfg_ir.op_move(tmp_place)));
                    try self.push_stmt(cfg_ir.stmt_pool_reset_epoch(sp, pool_local));
                    return;
                }
            }
        }

        let lhs_ty = try self.expr_ty(lhs_id, types.TY_ERROR);
        if op == .Assign {
            let rhs_raw = try self.lower_expr_rvalue(rhs_id, lhs_ty);
            if !self.has_cur_bb {
                return;
            }
            let rhs_op = try self.coerce_operand(rhs_raw, lhs_ty, rhs_sp);
            let lhs_place = try self.lower_place(lhs_id);
            try self.emit_assign(sp, lhs_place, cfg_ir.rvalue_use(rhs_op));
        } else {
            let lhs_place = try self.lower_place(lhs_id);
            let target_ty = self.place_ty(lhs_place);
            let cur_val = cfg_ir.op_copy(lhs_place);
            let rhs_raw = try self.lower_expr_rvalue(rhs_id, target_ty);
            if !self.has_cur_bb {
                return;
            }
            let rhs_op = try self.coerce_operand(rhs_raw, target_ty, rhs_sp);
            let bin = assign_op_to_bin_op(op);
            try self.emit_assign(sp, lhs_place, cfg_ir.rvalue_binary(bin, cur_val, rhs_op));
        }
        return;
    }

    fn find_loop_target(self: *Self, lbl: ast.IdentSpan) -> ?usize {
        let ls = self.st.sc.loops.as_slice();
        if ls.len == 0_usize {
            return null;
        }
        if ast.ident_is_some(lbl) {
            var i = ls.len;
            while i > 0_usize {
                i = i - 1_usize;
                if ls[i].has_label && ls[i].label == lbl.sym {
                    return i;
                }
            }
            return null;
        }
        return ls.len - 1_usize;
    }

    @recursive
    fn lower_jump(self: *mut Self, jump_id: u32, sp: span.Span) -> !OutOfMemory {
        var has_j = false;
        var j_kind: ast.JumpKind = .Unreachable;
        var j_value: u32 = ast.NONE_ID;
        var j_label = ast.ident_none();
        if let j = self.arena.get_jump(jump_id) {
            has_j = true;
            j_kind = j.kind;
            j_value = j.value;
            j_label = j.label;
        }
        if !has_j {
            return;
        }
        match j_kind {
            .Return => {
                let sig_ret = self.sig.ret;
                var is_err_return = false;
                var ret_val_span = sp;
                if j_value != ast.NONE_ID {
                    if let ve = self.arena.get_expr(j_value) {
                        ret_val_span = ve.span;
                        if ve.kind == .EnumLit {
                            let rn = self.env.get(sig_ret);
                            if rn.kind == .ErrorUnion {
                                let errs = self.env.node_err_src_list(&rn);
                                is_err_return = self.env.error_sources_have_variant(errs, ve.ident.sym, self.interner);
                            }
                        }
                    }
                }
                var has_prepared = false;
                var prepared = cfg_ir.op_none();
                if j_value != ast.NONE_ID {
                    let rn = self.env.get(sig_ret);
                    let hint = if is_err_return {
                        sig_ret
                    } else if rn.kind == .ErrorUnion {
                        rn.primary
                    } else {
                        sig_ret
                    };
                    let op = try self.lower_expr_rvalue(j_value, hint);
                    let cop = if is_err_return {
                        try self.coerce_error_into_union(op, ret_val_span, sig_ret)
                    } else {
                        try self.coerce_operand(op, sig_ret, ret_val_span)
                    };
                    has_prepared = true;
                    prepared = cop;
                }
                if !self.has_cur_bb {
                    return;
                }
                if has_prepared {
                    let rty = self.operand_ty(prepared);
                    let rtmp = try self.new_local(
                        false, span.SYM_EMPTY, ret_val_span, rty, false, false, false, true, false, 0_u32,
                    );
                    try self.push_stmt(cfg_ir.stmt_storage_live(ret_val_span, rtmp));
                    let rplace = try self.cfg.add_local_place(self.alloc, rtmp, self.local_ty(rtmp), ret_val_span);
                    try self.emit_assign(ret_val_span, rplace, cfg_ir.rvalue_use(prepared));
                    prepared = self.operand_for_place(rplace);
                }
                if is_err_return {
                    self.cleanup_depth = self.cleanup_depth +% 1_u32;
                    self.has_active_err_span = true;
                    self.active_err_span = sp;
                    try self.emit_unwind_to_scope(0_usize, true, has_prepared, prepared);
                    self.has_active_err_span = false;
                    self.cleanup_depth = self.cleanup_depth -% 1_u32;
                } else {
                    try self.emit_unwind_to_scope(0_usize, false, false, cfg_ir.op_none());
                }
                if self.has_cur_bb {
                    if has_prepared {
                        self.set_term(cfg_ir.term_return_val(prepared, ret_val_span));
                    } else {
                        self.set_term(cfg_ir.term_return_void(ret_val_span));
                    }
                }
            }
            .Break => {
                let idx = self.find_loop_target(j_label) orelse {
                    self.set_term(cfg_ir.term_unreachable(sp, false));
                    return;
                };
                if j_value != ast.NONE_ID {
                    var expect_ty = types.TY_ERROR;
                    var has_bdst = false;
                    var bdst = cfg_ir.CFG_NONE;
                    let ls = self.st.sc.loops.as_slice();
                    if idx < ls.len {
                        expect_ty = ls[idx].break_origin_ty;
                        has_bdst = ls[idx].has_break_dst;
                        bdst = ls[idx].break_dst_place;
                    }
                    let hint = if expect_ty != types.TY_ERROR { expect_ty } else { types.TY_NONE };
                    let op = try self.lower_expr_rvalue(j_value, hint);
                    if !self.has_cur_bb {
                        return;
                    }
                    if has_bdst {
                        let vsp = expr_span(self.arena, j_value);
                        let cop = try self.coerce_operand(op, self.place_ty(bdst), vsp);
                        try self.emit_assign(vsp, bdst, cfg_ir.rvalue_use(cop));
                    }
                }
                var scope_len: usize = 0_usize;
                var exit_bb: cfg_ir.BlockId = 0_u32;
                let ls_mut = self.st.sc.loops.as_mut_slice();
                if idx < ls_mut.len {
                    ls_mut[idx].any_break = true;
                    scope_len = ls_mut[idx].scope_len_at_entry;
                    exit_bb = ls_mut[idx].exit_bb;
                }
                try self.emit_unwind_to_scope(scope_len, false, false, cfg_ir.op_none());
                if self.has_cur_bb {
                    self.set_term(cfg_ir.term_goto(exit_bb));
                }
            }
            .Continue => {
                let idx = self.find_loop_target(j_label) orelse {
                    self.set_term(cfg_ir.term_unreachable(sp, false));
                    return;
                };
                var scope_len: usize = 0_usize;
                var cont_bb: cfg_ir.BlockId = 0_u32;
                let ls = self.st.sc.loops.as_slice();
                if idx < ls.len {
                    scope_len = ls[idx].scope_len_at_entry;
                    cont_bb = ls[idx].continue_bb;
                }
                try self.emit_unwind_to_scope(scope_len, false, false, cfg_ir.op_none());
                if self.has_cur_bb {
                    self.set_term(cfg_ir.term_goto(cont_bb));
                }
            }
            .Unreachable => {
                self.set_term(cfg_ir.term_unreachable(sp, true));
            }
        }
        return;
    }

    @recursive
    fn lower_if(
        self: *mut Self,
        if_id: u32,
        has_dst: bool,
        dst_place_id: u32,
        expected_ty: types.TyId,
    ) -> !OutOfMemory {
        var has_data = false;
        var d_is_comptime = false;
        var d_cond_kind: ast.IfCondKind = .Expr;
        var d_cond_expr: u32 = ast.NONE_ID;
        var d_cond_pat: u32 = ast.NONE_ID;
        var d_then_block: u32 = ast.NONE_ID;
        var d_else_kind: ast.ElseKind = .None;
        var d_else_id: u32 = ast.NONE_ID;
        var d_span = span.span_dummy();
        if let data = self.arena.get_if(if_id) {
            has_data = true;
            d_is_comptime = data.is_comptime;
            d_cond_kind = data.cond_kind;
            d_cond_expr = data.cond_expr;
            d_cond_pat = data.cond_pat;
            d_then_block = data.then_block;
            d_else_kind = data.else_kind;
            d_else_id = data.else_id;
            d_span = data.span;
        }
        if !has_data {
            return;
        }
        if d_is_comptime {
            let taken = self.table.get_comptime_branch(if_id) orelse true;
            if taken {
                try self.lower_block_into(d_then_block, has_dst, dst_place_id, expected_ty);
            } else if d_else_kind == .Block {
                try self.lower_block_into(d_else_id, has_dst, dst_place_id, expected_ty);
            } else if d_else_kind == .If {
                try self.lower_if(d_else_id, has_dst, dst_place_id, expected_ty);
            }
            return;
        }
        let merge_bb = try self.new_block();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        let m_idx = merge_bb.widen.[usize]();
        if m_idx < bs_mut.len {
            bs_mut[m_idx].has_join_span = true;
            bs_mut[m_idx].join_span = d_span;
        }

        let then_bb = try self.new_block();
        let else_bb = try self.new_block();
        var has_if_let = false;
        var if_let_pat = ast.NONE_ID;
        var if_let_unwrap = cfg_ir.op_none();
        var if_let_inner_ty = types.TY_ERROR;

        if d_cond_kind == .Expr {
            let csp = expr_span(self.arena, d_cond_expr);
            try self.lower_cond_branch(d_cond_expr, then_bb, else_bb, csp, true);
        } else {
            let esp = expr_span(self.arena, d_cond_expr);
            let eop = try self.lower_expr_rvalue(d_cond_expr, types.TY_NONE);
            if !self.has_cur_bb {
                return;
            }
            let ety = self.operand_ty(eop);
            let opt_place = try self.new_temp_place(ety, esp);
            try self.emit_assign(esp, opt_place, cfg_ir.rvalue_use(eop));
            let is_some_place = try self.new_temp_place(types.TY_BOOL, esp);
            try self.emit_assign(esp, is_some_place, cfg_ir.rvalue_is_non_null(cfg_ir.op_copy(opt_place)));
            let en = self.env.get(ety);
            let inner_ty = if en.kind == .Optional { en.primary } else { types.TY_ERROR };
            let unwrap_op = if self.env.is_linear(inner_ty) {
                cfg_ir.op_move(opt_place)
            } else {
                cfg_ir.op_copy(opt_place)
            };
            has_if_let = true;
            if_let_pat = d_cond_pat;
            if_let_unwrap = unwrap_op;
            if_let_inner_ty = inner_ty;
            self.set_term(cfg_ir.term_branch(cfg_ir.op_copy(is_some_place), then_bb, else_bb, esp, false));
        }

        var any_reach_merge = false;
        self.has_cur_bb = true;
        self.cur_bb = then_bb;
        if has_if_let {
            try self.push_scope();
            let psp = pat_span(self.arena, if_let_pat);
            let un_place = try self.new_temp_place(if_let_inner_ty, psp);
            try self.emit_assign(psp, un_place, cfg_ir.rvalue_unwrap_optional(if_let_unwrap));
            let un_op = self.operand_for_place(un_place);
            try self.lower_bind_pattern(if_let_pat, un_op, if_let_inner_ty, false);
            try self.lower_block_into(d_then_block, has_dst, dst_place_id, expected_ty);
            try self.pop_scope_normal();
        } else {
            try self.lower_block_into(d_then_block, has_dst, dst_place_id, expected_ty);
        }
        if self.has_cur_bb {
            any_reach_merge = true;
            self.set_term(cfg_ir.term_goto(merge_bb));
        }

        self.has_cur_bb = true;
        self.cur_bb = else_bb;
        if d_else_kind == .Block {
            try self.lower_block_into(d_else_id, has_dst, dst_place_id, expected_ty);
            if self.has_cur_bb {
                any_reach_merge = true;
                self.set_term(cfg_ir.term_goto(merge_bb));
            }
        } else if d_else_kind == .If {
            try self.lower_if(d_else_id, has_dst, dst_place_id, expected_ty);
            if self.has_cur_bb {
                any_reach_merge = true;
                self.set_term(cfg_ir.term_goto(merge_bb));
            }
        } else {
            any_reach_merge = true;
            self.set_term(cfg_ir.term_goto(merge_bb));
        }

        if any_reach_merge {
            self.has_cur_bb = true;
            self.cur_bb = merge_bb;
        } else {
            self.has_cur_bb = false;
        }
        return;
    }

    @recursive
    fn lower_cond_branch(
        self: *mut Self,
        cond_id: u32,
        then_bb: cfg_ir.BlockId,
        else_bb: cfg_ir.BlockId,
        sp: span.Span,
        is_user_if: bool,
    ) -> !OutOfMemory {
        if !self.has_cur_bb {
            return;
        }
        var has_ce = false;
        var ce_kind: ast.ExprKind = .Error;
        var ce_unary_op: ast.UnaryOp = .Not;
        var ce_bin_op: ast.BinaryOp = .Add;
        var ce_a: u32 = ast.NONE_ID;
        var ce_b: u32 = ast.NONE_ID;
        if let ce = self.arena.get_expr(cond_id) {
            has_ce = true;
            ce_kind = ce.kind;
            ce_unary_op = ce.unary_op;
            ce_bin_op = ce.bin_op;
            ce_a = ce.a;
            ce_b = ce.b;
        }
        if !has_ce {
            return;
        }
        if ce_kind == .Paren {
            try self.lower_cond_branch(ce_a, then_bb, else_bb, sp, is_user_if);
            return;
        }
        if ce_kind == .Unary && ce_unary_op == .Not {
            try self.lower_cond_branch(ce_a, else_bb, then_bb, sp, is_user_if);
            return;
        }
        if ce_kind == .Binary && ce_bin_op == .And {
            let mid_bb = try self.new_block();
            try self.lower_cond_branch(ce_a, mid_bb, else_bb, expr_span(self.arena, ce_a), false);
            self.has_cur_bb = true;
            self.cur_bb = mid_bb;
            try self.lower_cond_branch(ce_b, then_bb, else_bb, expr_span(self.arena, ce_b), false);
            return;
        }
        if ce_kind == .Binary && ce_bin_op == .Or {
            let mid_bb = try self.new_block();
            try self.lower_cond_branch(ce_a, then_bb, mid_bb, expr_span(self.arena, ce_a), false);
            self.has_cur_bb = true;
            self.cur_bb = mid_bb;
            try self.lower_cond_branch(ce_b, then_bb, else_bb, expr_span(self.arena, ce_b), false);
            return;
        }
        let cop = try self.lower_expr_rvalue(cond_id, types.TY_BOOL);
        if self.has_cur_bb {
            self.set_term(cfg_ir.term_branch(cop, then_bb, else_bb, sp, is_user_if));
        }
        return;
    }

    fn pat_is_irrefutable(self: *Self, pat_id: u32) -> bool {
        let p = self.arena.get_pat(pat_id) orelse {
            return true;
        };
        return p.kind == .Wildcard || p.kind == .Ident || p.kind == .Error;
    }

    @recursive
    fn lower_arm_body(
        self: *mut Self,
        body_kind: ast.BodyKind,
        body_id: u32,
        has_dst: bool,
        dst_place_id: u32,
        expected_ty: types.TyId,
        sp: span.Span,
    ) -> !OutOfMemory {
        match body_kind {
            .Block => { try self.lower_block_into(body_id, has_dst, dst_place_id, expected_ty); }
            .Expr => {
                if has_dst {
                    let exp = if expected_ty != types.TY_NONE { expected_ty } else { self.place_ty(dst_place_id) };
                    try self.lower_expr_into(body_id, dst_place_id, exp);
                } else {
                    _ = try self.lower_expr_rvalue(body_id, expected_ty);
                }
            }
            .Jump => { try self.lower_jump(body_id, sp); }
        }
        return;
    }

    @recursive
    fn lower_match(
        self: *mut Self,
        scrutinee_id: u32,
        arms_range: ast.IdRange,
        has_dst: bool,
        dst_place_id: u32,
        expected_ty: types.TyId,
        match_span: span.Span,
    ) -> !OutOfMemory {
        let scrut_op = try self.lower_expr_rvalue(scrutinee_id, types.TY_NONE);
        if !self.has_cur_bb {
            return;
        }
        let scrut_sp = expr_span(self.arena, scrutinee_id);
        let scrut_ty = self.operand_ty(scrut_op);
        let scrut_place = try self.new_temp_place(scrut_ty, scrut_sp);
        try self.emit_assign(scrut_sp, scrut_place, cfg_ir.rvalue_use(scrut_op));

        let merge_bb = try self.new_block();
        let m_idx = merge_bb.widen.[usize]();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        if m_idx < bs_mut.len {
            bs_mut[m_idx].has_join_span = true;
            bs_mut[m_idx].join_span = match_span;
        }
        var any_reach_merge = false;

        let n_arms = arms_range.len.widen.[usize]();
        if n_arms == 0_usize {
            self.set_term(cfg_ir.term_goto(merge_bb));
            self.has_cur_bb = true;
            self.cur_bb = merge_bb;
            return;
        }

        var i: usize = 0_usize;
        while i < n_arms {
            if !self.has_cur_bb {
                break;
            }
            let arm = arena_arm_at(self.arena, arms_range, i) orelse { break; };
            let is_last = (i +% 1_usize) == n_arms;
            let arm_body_bb = try self.new_block();
            let has_next_test = !is_last;
            let next_test_bb = if has_next_test { try self.new_block() } else { 0_u32 };

            let no_guard = arm.guard == ast.NONE_ID;
            let is_irrefutable = self.pat_is_irrefutable(arm.pat) && no_guard;
            if is_irrefutable || (is_last && no_guard) {
                self.set_term(cfg_ir.term_goto(arm_body_bb));
                self.has_cur_bb = true;
                self.cur_bb = arm_body_bb;
                try self.push_scope();
                let sop = if self.env.is_linear(scrut_ty) {
                    cfg_ir.op_move(scrut_place)
                } else {
                    cfg_ir.op_copy(scrut_place)
                };
                try self.lower_bind_pattern(arm.pat, sop, scrut_ty, false);
                try self.lower_arm_body(arm.body_kind, arm.body_id, has_dst, dst_place_id, expected_ty, arm.span);
                try self.pop_scope_normal();
                if self.has_cur_bb {
                    any_reach_merge = true;
                    self.set_term(cfg_ir.term_goto(merge_bb));
                }
                if is_irrefutable {
                    break;
                }
                self.has_cur_bb = has_next_test;
                self.cur_bb = next_test_bb;
                i = i +% 1_usize;
                continue;
            }

            let cond_op = try self.lower_pat_test(scrut_place, arm.pat, scrut_ty, arm.span);
            if !self.has_cur_bb {
                break;
            }
            let bind_bb = try self.new_block();
            let fail_bb = if has_next_test { next_test_bb } else { try self.new_block() };
            if !has_next_test {
                self.set_block_term(fail_bb, cfg_ir.term_unreachable(arm.span, false));
            }
            self.set_term(cfg_ir.term_branch(cond_op, bind_bb, fail_bb, arm.span, false));

            self.has_cur_bb = true;
            self.cur_bb = bind_bb;
            try self.push_scope();
            let sop = if self.env.is_linear(scrut_ty) && is_last {
                cfg_ir.op_move(scrut_place)
            } else {
                cfg_ir.op_copy(scrut_place)
            };
            try self.lower_bind_pattern(arm.pat, sop, scrut_ty, false);
            if arm.guard != ast.NONE_ID {
                let gop = try self.lower_expr_rvalue(arm.guard, types.TY_BOOL);
                if self.has_cur_bb {
                    let guard_fail = try self.new_block();
                    self.set_term(cfg_ir.term_branch(gop, arm_body_bb, guard_fail, expr_span(self.arena, arm.guard), false));
                    self.has_cur_bb = true;
                    self.cur_bb = guard_fail;
                    try self.pop_scope_normal();
                    if self.has_cur_bb {
                        self.set_term(cfg_ir.term_goto(fail_bb));
                    }
                    self.has_cur_bb = true;
                    self.cur_bb = arm_body_bb;
                }
            } else {
                self.set_term(cfg_ir.term_goto(arm_body_bb));
                self.has_cur_bb = true;
                self.cur_bb = arm_body_bb;
            }

            if self.has_cur_bb {
                try self.lower_arm_body(arm.body_kind, arm.body_id, has_dst, dst_place_id, expected_ty, arm.span);
                try self.pop_scope_normal();
                if self.has_cur_bb {
                    any_reach_merge = true;
                    self.set_term(cfg_ir.term_goto(merge_bb));
                }
            } else {
                self.pop_scope_discard();
            }

            self.has_cur_bb = has_next_test;
            self.cur_bb = next_test_bb;
            i = i +% 1_usize;
        }

        if any_reach_merge {
            self.has_cur_bb = true;
            self.cur_bb = merge_bb;
        } else {
            self.has_cur_bb = false;
        }
        return;
    }

    @recursive
    fn lower_pat_test(
        self: *mut Self,
        scrut_place: u32,
        pat_id: u32,
        scrut_ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        var has_pat = false;
        var p_kind: ast.PatKind = .Wildcard;
        var p_flag = false;
        var p_data0: u32 = 0_u32;
        var p_data1: u32 = 0_u32;
        var p_has_range = false;
        var p_range_kind: ast.RangeKind = .Exclusive;
        var p_range_neg = false;
        var p_ident = ast.ident_none();
        if let pat = self.arena.get_pat(pat_id) {
            has_pat = true;
            p_kind = pat.kind;
            p_flag = pat.flag;
            p_data0 = pat.data0;
            p_data1 = pat.data1;
            p_has_range = pat.has_range;
            p_range_kind = pat.range_kind;
            p_range_neg = pat.range_neg;
            p_ident = pat.ident;
        }
        if !has_pat {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(true));
        }
        match p_kind {
            .Wildcard => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(true)); }
            .Ident => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(true)); }
            .Error => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(true)); }
            .Tuple => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(true)); }
            .Struct => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(true)); }
            .BoolLit => {
                let c = try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(p_flag));
                return try self.emit_bin_tmp(.Eq, cfg_ir.op_copy(scrut_place), c, types.TY_BOOL, sp);
            }
            .Null => {
                let dst = try self.new_temp_place(types.TY_BOOL, sp);
                try self.emit_assign(sp, dst, cfg_ir.rvalue_is_non_null(cfg_ir.op_copy(scrut_place)));
                return try self.emit_unary_tmp(.Not, cfg_ir.op_copy(dst), types.TY_BOOL, sp);
            }
            .CharLit => {
                let clo = try self.cfg.add_const_op(self.alloc, cfg_ir.const_char(p_data0));
                if p_has_range {
                    let chi = try self.cfg.add_const_op(self.alloc, cfg_ir.const_char(p_data1));
                    let c1 = try self.emit_bin_tmp(.GtEq, cfg_ir.op_copy(scrut_place), clo, types.TY_BOOL, sp);
                    let cmp: ast.BinaryOp = if p_range_kind == .Inclusive { .LtEq } else { .Lt };
                    let c2 = try self.emit_bin_tmp(cmp, cfg_ir.op_copy(scrut_place), chi, types.TY_BOOL, sp);
                    return try self.emit_bin_tmp(.And, c1, c2, types.TY_BOOL, sp);
                }
                return try self.emit_bin_tmp(.Eq, cfg_ir.op_copy(scrut_place), clo, types.TY_BOOL, sp);
            }
            .IntLit => {
                let lo = parse_signed_int(p_data0, p_flag, self.interner) orelse types.int_val_zero();
                let clo = try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(lo, scrut_ty));
                if p_has_range {
                    let hi = parse_signed_int(p_data1, p_range_neg, self.interner) orelse types.int_val_zero();
                    let chi = try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(hi, scrut_ty));
                    let c1 = try self.emit_bin_tmp(.GtEq, cfg_ir.op_copy(scrut_place), clo, types.TY_BOOL, sp);
                    let cmp: ast.BinaryOp = if p_range_kind == .Inclusive { .LtEq } else { .Lt };
                    let c2 = try self.emit_bin_tmp(cmp, cfg_ir.op_copy(scrut_place), chi, types.TY_BOOL, sp);
                    return try self.emit_bin_tmp(.And, c1, c2, types.TY_BOOL, sp);
                }
                return try self.emit_bin_tmp(.Eq, cfg_ir.op_copy(scrut_place), clo, types.TY_BOOL, sp);
            }
            .Variant => {
                let sk = self.env.get(scrut_ty).kind;
                if sk == .Union {
                    let tag_dst = try self.new_temp_place(types.TY_U32, sp);
                    try self.emit_assign(sp, tag_dst, cfg_ir.rvalue_match_tag(cfg_ir.op_copy(scrut_place)));
                    let tv = self.variant_tag_index(scrut_ty, p_ident.sym) orelse 0_u32;
                    let c = try self.cfg.add_const_op(
                        self.alloc,
                        cfg_ir.const_int(types.int_val_from_u64(tv.widen.[u64]()), types.TY_U32),
                    );
                    return try self.emit_bin_tmp(.Eq, cfg_ir.op_copy(tag_dst), c, types.TY_BOOL, sp);
                }
                if sk == .ErrorSet || sk == .ErrorUnion {
                    let tag_dst = try self.new_temp_place(types.TY_U32, sp);
                    try self.emit_assign(sp, tag_dst, cfg_ir.rvalue_match_tag(cfg_ir.op_copy(scrut_place)));
                    let tv = self.error_variant_tag(scrut_ty, p_ident.sym);
                    let c = try self.cfg.add_const_op(
                        self.alloc,
                        cfg_ir.const_int(types.int_val_from_u64(tv.widen.[u64]()), types.TY_U32),
                    );
                    return try self.emit_bin_tmp(.Eq, cfg_ir.op_copy(tag_dst), c, types.TY_BOOL, sp);
                }
                let tv = self.variant_tag_index(scrut_ty, p_ident.sym) orelse 0_u32;
                let c = try self.cfg.add_const_op(
                    self.alloc,
                    cfg_ir.const_enum_tag(scrut_ty, p_ident.sym, types.int_val_from_u64(tv.widen.[u64]())),
                );
                return try self.emit_bin_tmp(.Eq, cfg_ir.op_copy(scrut_place), c, types.TY_BOOL, sp);
            }
        }
    }

    @recursive
    fn lower_bind_struct_pattern(
        self: *mut Self,
        pat_list: ast.IdRange,
        pat_span: span.Span,
        val: cfg_ir.CfgOperand,
        ty: types.TyId,
        is_mut: bool,
    ) -> !OutOfMemory {
        let tmp = try self.new_temp(ty, pat_span);
        let tmp_place = try self.cfg.add_local_place(self.alloc, tmp, self.local_ty(tmp), pat_span);
        try self.emit_assign(pat_span, tmp_place, cfg_ir.rvalue_use(val));

        let tn = self.env.get(ty);
        var has_sdef = false;
        var sdef = resolve.DEF_NONE;
        var eff_gargs = try col.DynBuf.[types.GenericVal].init(self.alloc, 4_usize);
        errdefer eff_gargs.destroy(self.alloc);
        if tn.kind == .Struct {
            has_sdef = true;
            sdef = tn.primary;
            let sg = self.env.node_gval_list(&tn);
            if sg.len > 0_usize {
                try eff_gargs.push_slice(self.alloc, sg);
            } else {
                try eff_gargs.push_slice(self.alloc, self.st.sc.generic_subst.as_slice());
            }
        } else {
            try eff_gargs.push_slice(self.alloc, self.st.sc.generic_subst.as_slice());
        }

        let n_fps = pat_list.len.widen.[usize]();
        var fi: usize = 0_usize;
        while fi < n_fps {
            let fp = arena_pat_field_at(self.arena, pat_list, fi) orelse { break; };
            var fidx: u32 = 0_u32;
            var raw_fty = types.TY_ERROR;
            if has_sdef {
                if let sm = self.env.get_struct(sdef) {
                    let mfs = self.env.struct_fields_range(sm.fields);
                    var k: usize = 0_usize;
                    while k < mfs.len {
                        if mfs[k].name == fp.name.sym {
                            fidx = k.trunc.[u32]();
                            raw_fty = mfs[k].ty;
                            break;
                        }
                        k = k +% 1_usize;
                    }
                }
            }
            let fty = if !eff_gargs.is_empty() {
                try check.subst_ty(self.alloc, self.env, raw_fty, eff_gargs.as_slice())
            } else {
                raw_fty
            };
            let fp_place = try self.extend_place(
                tmp_place,
                cfg_ir.proj_field(fp.name.sym, fidx, fty),
                fty,
                pat_span,
            );
            let fop = self.operand_for_place(fp_place);
            if fp.pat != ast.NONE_ID {
                try self.lower_bind_pattern(fp.pat, fop, fty, is_mut);
            } else if !is_wildcard_sym(self.interner, fp.name.sym) {
                let loc = try self.bind_user_local(fp.name.sym, fp.name.span, fty, is_mut);
                let dst = try self.cfg.add_local_place(self.alloc, loc, self.local_ty(loc), fp.name.span);
                try self.emit_assign(fp.span, dst, cfg_ir.rvalue_use(fop));
            }
            fi = fi +% 1_usize;
        }
        try self.push_stmt(cfg_ir.stmt_consume_destructured(pat_span, tmp));
        eff_gargs.destroy(self.alloc);
        return;
    }

    @recursive
    fn lower_bind_pattern(
        self: *mut Self,
        pat_id: u32,
        val: cfg_ir.CfgOperand,
        ty: types.TyId,
        is_mut: bool,
    ) -> !OutOfMemory {
        var has_pat = false;
        var p_kind: ast.PatKind = .Wildcard;
        var p_data0: u32 = 0_u32;
        var p_list = ast.range_empty();
        var p_ident = ast.ident_none();
        var p_span = span.span_dummy();
        if let pat = self.arena.get_pat(pat_id) {
            has_pat = true;
            p_kind = pat.kind;
            p_data0 = pat.data0;
            p_list = pat.list;
            p_ident = pat.ident;
            p_span = pat.span;
        }
        if !has_pat {
            return;
        }
        match p_kind {
            .Wildcard => {
                if (val.kind == .Copy || val.kind == .Move) && ty != types.TY_VOID && ty != types.TY_NEVER {
                    let dst = try self.new_temp_place(ty, p_span);
                    try self.emit_assign(p_span, dst, cfg_ir.rvalue_use(val));
                }
            }
            .Error => {}
            .Null => {}
            .BoolLit => {}
            .CharLit => {}
            .IntLit => {}
            .Ident => {
                if is_wildcard_sym(self.interner, p_data0) {
                    if (val.kind == .Copy || val.kind == .Move) && ty != types.TY_VOID && ty != types.TY_NEVER {
                        let dst = try self.new_temp_place(ty, p_span);
                        try self.emit_assign(p_span, dst, cfg_ir.rvalue_use(val));
                    }
                    return;
                }
                let loc = try self.bind_user_local(p_data0, p_span, ty, is_mut);
                let dst = try self.cfg.add_local_place(self.alloc, loc, self.local_ty(loc), p_span);
                try self.emit_assign(p_span, dst, cfg_ir.rvalue_use(val));
            }
            .Tuple => {
                let tmp = try self.new_temp(ty, p_span);
                let tmp_place = try self.cfg.add_local_place(self.alloc, tmp, self.local_ty(tmp), p_span);
                try self.emit_assign(p_span, tmp_place, cfg_ir.rvalue_use(val));
                var elems = try col.DynBuf.[types.TyId].init(self.alloc, 4_usize);
                errdefer elems.destroy(self.alloc);
                let tn = self.env.get(ty);
                if tn.kind == .Tuple {
                    try elems.push_slice(self.alloc, self.env.node_ty_list(&tn));
                }
                let n_ps = p_list.len.widen.[usize]();
                let es = elems.as_slice();
                var i: usize = 0_usize;
                while i < n_ps {
                    let ety = if i < es.len { es[i] } else { types.TY_ERROR };
                    let field_place = try self.extend_place(
                        tmp_place,
                        cfg_ir.proj_tuple_field(i.trunc.[u32](), ety),
                        ety,
                        p_span,
                    );
                    let fop = self.operand_for_place(field_place);
                    if let sub_pat = arena_pat_at(self.arena, p_list, i) {
                        try self.lower_bind_pattern(sub_pat, fop, ety, is_mut);
                    }
                    i = i +% 1_usize;
                }
                try self.push_stmt(cfg_ir.stmt_consume_destructured(p_span, tmp));
                elems.destroy(self.alloc);
            }
            .Struct => {
                try self.lower_bind_struct_pattern(p_list, p_span, val, ty, is_mut);
            }
            .Variant => {
                let tn = self.env.get(ty);
                if tn.kind == .Union {
                    if let arg0 = arena_pat_at(self.arena, p_list, 0_usize) {
                    var found = false;
                    var vidx: u32 = 0_u32;
                    var pty = types.TY_ERROR;
                    if let um = self.env.get_union(tn.primary) {
                        let vs = self.env.union_variants_range(um.variants);
                        var vi: usize = 0_usize;
                        while vi < vs.len {
                            if vs[vi].name == p_ident.sym && vs[vi].has_payload {
                                found = true;
                                vidx = vi.trunc.[u32]();
                                pty = vs[vi].payload;
                                break;
                            }
                            vi = vi +% 1_usize;
                        }
                    }
                    if found {
                        let dst = try self.new_temp_place(pty, p_span);
                        try self.emit_assign(p_span, dst, cfg_ir.rvalue_field_extract(val, vidx, pty));
                        let popped = self.operand_for_place(dst);
                        try self.lower_bind_pattern(arg0, popped, pty, is_mut);
                    }
                    }
                }
            }
        }
        return;
    }

    @recursive
    fn lower_while(
        self: *mut Self,
        label: ast.IdentSpan,
        cond_id: u32,
        where_range: ast.IdRange,
        body_id: u32,
        sp: span.Span,
    ) -> !OutOfMemory {
        let header_bb = try self.new_block();
        let body_bb = try self.new_block();
        let exit_bb = try self.new_block();
        let h_idx = header_bb.widen.[usize]();
        let has_depth = !self.st.sc.scopes.is_empty();
        let entry_depth = self.current_scope_depth();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        if h_idx < bs_mut.len {
            bs_mut[h_idx].is_loop_header = true;
            bs_mut[h_idx].has_loop_entry_depth = has_depth;
            bs_mut[h_idx].loop_entry_depth = entry_depth;
        }
        if where_range.len > 0_u32 {
            let exprs_r = try self.cfg.add_expr_ids(self.alloc, self.arena.expr_list_range(where_range));
            try self.st.sc.loop_invariants.push(
                self.alloc,
                cfg_ir.LoopInvariantEntry.{ block_id: header_bb, exprs: exprs_r },
            );
        }

        self.set_term(cfg_ir.term_goto(header_bb));
        self.has_cur_bb = true;
        self.cur_bb = header_bb;
        try self.lower_cond_branch(cond_id, body_bb, exit_bb, sp, false);

        try self.st.sc.loops.push(
            self.alloc,
            LoopTarget.{
                has_label: ast.ident_is_some(label),
                label: label.sym,
                continue_bb: header_bb,
                exit_bb: exit_bb,
                has_break_dst: false,
                break_dst_place: cfg_ir.CFG_NONE,
                break_origin_ty: types.TY_VOID,
                scope_len_at_entry: self.st.sc.scopes.len(),
                any_break: false,
            },
        );

        self.has_cur_bb = true;
        self.cur_bb = body_bb;
        try self.lower_block_into(body_id, false, cfg_ir.CFG_NONE, types.TY_NONE);
        if self.has_cur_bb {
            self.set_term(cfg_ir.term_goto(header_bb));
        }

        _ = self.st.sc.loops.pop();
        self.has_cur_bb = true;
        self.cur_bb = exit_bb;
        return;
    }

    @recursive
    fn lower_for_inner(
        self: *mut Self,
        label: ast.IdentSpan,
        pat_id: u32,
        iter_start: u32,
        has_range: bool,
        range_kind: ast.RangeKind,
        iter_end: u32,
        body_id: u32,
        sp: span.Span,
        is_par: bool,
    ) -> !OutOfMemory {
        if !has_range {
            try self.lower_for_seq(label, pat_id, iter_start, body_id, sp, is_par);
            return;
        }
        let end_ty = try self.expr_ty(iter_end, types.TY_USIZE);
        var idx_ty = try self.expr_ty(iter_start, end_ty);
        if idx_ty == types.TY_COMPTIME_INT {
            idx_ty = types.TY_USIZE;
        }
        let start_op = try self.lower_expr_rvalue(iter_start, idx_ty);
        let end_op = try self.lower_expr_rvalue(iter_end, idx_ty);
        if !self.has_cur_bb {
            return;
        }

        try self.push_scope();
        let start_sp = expr_span(self.arena, iter_start);
        let end_sp = expr_span(self.arena, iter_end);
        let idx_local = try self.new_temp(idx_ty, start_sp);
        let idx_place = try self.cfg.add_local_place(self.alloc, idx_local, self.local_ty(idx_local), start_sp);
        try self.emit_assign(start_sp, idx_place, cfg_ir.rvalue_use(start_op));
        let end_local = try self.new_temp(idx_ty, end_sp);
        let end_place = try self.cfg.add_local_place(self.alloc, end_local, self.local_ty(end_local), end_sp);
        try self.emit_assign(end_sp, end_place, cfg_ir.rvalue_use(end_op));

        let header_bb = try self.new_block();
        let body_bb = try self.new_block();
        let step_bb = try self.new_block();
        let exit_bb = try self.new_block();
        let h_idx = header_bb.widen.[usize]();
        let has_depth = !self.st.sc.scopes.is_empty();
        let entry_depth = self.current_scope_depth();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        if h_idx < bs_mut.len {
            bs_mut[h_idx].is_loop_header = true;
            bs_mut[h_idx].has_loop_entry_depth = has_depth;
            bs_mut[h_idx].loop_entry_depth = entry_depth;
        }
        if is_par && range_kind == .Exclusive {
            try self.st.sc.par_for_regions.push(
                self.alloc,
                cfg_ir.ParForRegion.{
                    header_bb: header_bb,
                    body_bb: body_bb,
                    step_bb: step_bb,
                    exit_bb: exit_bb,
                    idx_local: idx_local,
                    end_local: end_local,
                    chunk_size: 256_u64,
                },
            );
        }

        self.set_term(cfg_ir.term_goto(header_bb));
        self.has_cur_bb = true;
        self.cur_bb = header_bb;
        let cmp_op: ast.BinaryOp = if range_kind == .Inclusive { .LtEq } else { .Lt };
        let cond = try self.emit_bin_tmp(cmp_op, cfg_ir.op_copy(idx_place), cfg_ir.op_copy(end_place), types.TY_BOOL, sp);
        self.set_term(cfg_ir.term_branch(cond, body_bb, exit_bb, sp, false));

        try self.st.sc.loops.push(
            self.alloc,
            LoopTarget.{
                has_label: ast.ident_is_some(label),
                label: label.sym,
                continue_bb: step_bb,
                exit_bb: exit_bb,
                has_break_dst: false,
                break_dst_place: cfg_ir.CFG_NONE,
                break_origin_ty: types.TY_VOID,
                scope_len_at_entry: self.st.sc.scopes.len(),
                any_break: false,
            },
        );

        self.has_cur_bb = true;
        self.cur_bb = body_bb;
        try self.push_scope();
        try self.lower_bind_pattern(pat_id, cfg_ir.op_copy(idx_place), idx_ty, false);
        try self.lower_block_into(body_id, false, cfg_ir.CFG_NONE, types.TY_NONE);
        try self.pop_scope_normal();
        if self.has_cur_bb {
            self.set_term(cfg_ir.term_goto(step_bb));
        }

        self.has_cur_bb = true;
        self.cur_bb = step_bb;
        let one = try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(types.int_val_from_u64(1_u64), idx_ty));
        try self.emit_assign(sp, idx_place, cfg_ir.rvalue_binary(.AddWrap, cfg_ir.op_copy(idx_place), one));
        self.set_term(cfg_ir.term_goto(header_bb));

        _ = self.st.sc.loops.pop();
        self.has_cur_bb = true;
        self.cur_bb = exit_bb;
        try self.pop_scope_normal();
        return;
    }

    @recursive
    fn lower_for_slot_pool(
        self: *mut Self,
        label: ast.IdentSpan,
        pat_id: u32,
        actual_seq_expr: u32,
        elem_ty: types.TyId,
        body_id: u32,
        sp: span.Span,
        is_par: bool,
    ) -> !OutOfMemory {
        let ga: [1]types.GenericVal = [types.gval_ty(elem_ty)];
        let gen_id_ty = try self.env.intern_builtin(self.alloc, .GenId, &ga);
        let opt_gen_id_ty = try self.env.intern_optional(self.alloc, gen_id_ty);
        let pool_place = try self.lower_place(actual_seq_expr);
        if !self.has_cur_bb {
            return;
        }
        let aseq_sp = expr_span(self.arena, actual_seq_expr);
        try self.push_scope();
        let cap_local = try self.new_temp(types.TY_USIZE, sp);
        let cap_place = try self.cfg.add_local_place(self.alloc, cap_local, types.TY_USIZE, sp);
        let cap_args: [1]cfg_ir.CfgOperand = [cfg_ir.op_copy(pool_place)];
        let cap_spans: [1]span.Span = [aseq_sp];
        let cap_cid = try self.cfg.add_call_data(
            self.alloc,
            cfg_ir.callee_builtin(cfg_ir.builtin_op_simple(.SlotPoolCap)),
            &cap_args,
            &cap_spans,
            true,
            pool_place,
            true,
            aseq_sp,
            false,
            false,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, cap_place, cap_cid));

        let idx_local = try self.new_temp(types.TY_USIZE, sp);
        let idx_place = try self.cfg.add_local_place(self.alloc, idx_local, types.TY_USIZE, sp);
        let zero = try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(types.int_val_zero(), types.TY_USIZE));
        try self.emit_assign(sp, idx_place, cfg_ir.rvalue_use(zero));

        let header_bb = try self.new_block();
        let body_bb = try self.new_block();
        let alive_bb = try self.new_block();
        let step_bb = try self.new_block();
        let exit_bb = try self.new_block();
        let h_idx = header_bb.widen.[usize]();
        let has_depth = !self.st.sc.scopes.is_empty();
        let entry_depth = self.current_scope_depth();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        if h_idx < bs_mut.len {
            bs_mut[h_idx].is_loop_header = true;
            bs_mut[h_idx].has_loop_entry_depth = has_depth;
            bs_mut[h_idx].loop_entry_depth = entry_depth;
        }
        if is_par {
            try self.st.sc.par_for_regions.push(
                self.alloc,
                cfg_ir.ParForRegion.{
                    header_bb: header_bb,
                    body_bb: body_bb,
                    step_bb: step_bb,
                    exit_bb: exit_bb,
                    idx_local: idx_local,
                    end_local: cap_local,
                    chunk_size: 256_u64,
                },
            );
        }

        self.set_term(cfg_ir.term_goto(header_bb));
        self.has_cur_bb = true;
        self.cur_bb = header_bb;
        let cond = try self.emit_bin_tmp(.Lt, cfg_ir.op_copy(idx_place), cfg_ir.op_copy(cap_place), types.TY_BOOL, sp);
        self.set_term(cfg_ir.term_branch(cond, body_bb, exit_bb, sp, false));

        try self.st.sc.loops.push(
            self.alloc,
            LoopTarget.{
                has_label: ast.ident_is_some(label),
                label: label.sym,
                continue_bb: step_bb,
                exit_bb: exit_bb,
                has_break_dst: false,
                break_dst_place: cfg_ir.CFG_NONE,
                break_origin_ty: types.TY_VOID,
                scope_len_at_entry: self.st.sc.scopes.len(),
                any_break: false,
            },
        );

        self.has_cur_bb = true;
        self.cur_bb = body_bb;
        let opt_place = try self.new_temp_place(opt_gen_id_ty, sp);
        let id_args: [2]cfg_ir.CfgOperand = [cfg_ir.op_copy(pool_place), cfg_ir.op_copy(idx_place)];
        let id_spans: [2]span.Span = [aseq_sp, sp];
        let id_cid = try self.cfg.add_call_data(
            self.alloc,
            cfg_ir.callee_builtin(cfg_ir.builtin_op_ty(.SlotPoolIdAt, elem_ty)),
            &id_args,
            &id_spans,
            true,
            pool_place,
            true,
            aseq_sp,
            false,
            false,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, opt_place, id_cid));
        let is_some_place = try self.new_temp_place(types.TY_BOOL, sp);
        try self.emit_assign(sp, is_some_place, cfg_ir.rvalue_is_non_null(cfg_ir.op_copy(opt_place)));
        self.set_term(cfg_ir.term_branch(cfg_ir.op_copy(is_some_place), alive_bb, step_bb, sp, false));

        self.has_cur_bb = true;
        self.cur_bb = alive_bb;
        try self.push_scope();
        let psp = pat_span(self.arena, pat_id);
        let id_place = try self.new_temp_place(gen_id_ty, psp);
        try self.emit_assign(psp, id_place, cfg_ir.rvalue_unwrap_optional(cfg_ir.op_copy(opt_place)));
        try self.lower_bind_pattern(pat_id, cfg_ir.op_copy(id_place), gen_id_ty, false);
        try self.lower_block_into(body_id, false, cfg_ir.CFG_NONE, types.TY_NONE);
        try self.pop_scope_normal();
        if self.has_cur_bb {
            self.set_term(cfg_ir.term_goto(step_bb));
        }

        self.has_cur_bb = true;
        self.cur_bb = step_bb;
        let one = try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(types.int_val_from_u64(1_u64), types.TY_USIZE));
        try self.emit_assign(sp, idx_place, cfg_ir.rvalue_binary(.AddWrap, cfg_ir.op_copy(idx_place), one));
        self.set_term(cfg_ir.term_goto(header_bb));

        _ = self.st.sc.loops.pop();
        self.has_cur_bb = true;
        self.cur_bb = exit_bb;
        try self.pop_scope_normal();
        return;
    }

    @recursive
    fn lower_for_seq(
        self: *mut Self,
        label: ast.IdentSpan,
        pat_id: u32,
        seq_expr_id: u32,
        body_id: u32,
        sp: span.Span,
        is_par: bool,
    ) -> !OutOfMemory {
        var actual_seq = seq_expr_id;
        var has_borrow_mode = false;
        var borrow_is_mut = false;
        if let se = self.arena.get_expr(seq_expr_id) {
            if se.kind == .Call && se.list.len == 0_u32 {
                if let ce = self.arena.get_expr(se.a) {
                    if ce.kind == .Field {
                        if sym_is(self.interner, ce.ident.sym, "each_mut") {
                            actual_seq = ce.a;
                            has_borrow_mode = true;
                            borrow_is_mut = true;
                        } else if sym_is(self.interner, ce.ident.sym, "each") {
                            actual_seq = ce.a;
                            has_borrow_mode = true;
                            borrow_is_mut = false;
                        }
                    }
                }
            }
        }

        let seq_expr_ty = try self.expr_ty(actual_seq, types.TY_ERROR);
        let sn = self.env.get(seq_expr_ty);
        let seq_deref_ty = if sn.kind == .Borrow && sn.borrow_kind == .Single { sn.primary } else { seq_expr_ty };
        let sdn = self.env.get(seq_deref_ty);
        if sdn.kind == .Builtin && sdn.builtin_kind == .SlotPool {
            var elem_ty = types.TY_ERROR;
            let gs = self.env.node_gval_list(&sdn);
            if gs.len > 0_usize && gs[0_usize].kind == .Ty {
                elem_ty = gs[0_usize].id;
            }
            try self.lower_for_slot_pool(label, pat_id, actual_seq, elem_ty, body_id, sp, is_par);
            return;
        }

        let seq_op = try self.lower_expr_rvalue(actual_seq, types.TY_NONE);
        if !self.has_cur_bb {
            return;
        }
        let seq_sp = expr_span(self.arena, seq_expr_id);
        let seq_ty = self.operand_ty(seq_op);
        let stn = self.env.get(seq_ty);
        var elem_ty = types.TY_ERROR;
        var has_fixed_len = false;
        var fixed_len: u64 = 0_u64;
        if stn.kind == .Borrow && stn.borrow_kind == .Slice {
            elem_ty = stn.primary;
        } else if stn.kind == .Array {
            elem_ty = stn.primary;
            has_fixed_len = true;
            fixed_len = stn.u64_val;
        } else if (stn.kind == .Borrow && stn.borrow_kind == .Str) || stn.kind == .Str {
            elem_ty = types.TY_U8;
        }

        try self.push_scope();
        let seq_place = try self.new_temp_place(seq_ty, seq_sp);
        try self.emit_assign(seq_sp, seq_place, cfg_ir.rvalue_use(seq_op));

        let len_local = try self.new_temp(types.TY_USIZE, seq_sp);
        let len_place = try self.cfg.add_local_place(self.alloc, len_local, types.TY_USIZE, seq_sp);
        if has_fixed_len {
            let fc = try self.cfg.add_const_op(
                self.alloc,
                cfg_ir.const_int(types.int_val_from_u64(fixed_len), types.TY_USIZE),
            );
            try self.emit_assign(seq_sp, len_place, cfg_ir.rvalue_use(fc));
        } else {
            let is_str = (stn.kind == .Borrow && stn.borrow_kind == .Str) || stn.kind == .Str;
            let lop: cfg_ir.CfgBuiltinOpKind = if is_str { .StrLen } else { .SliceLen };
            let largs: [1]cfg_ir.CfgOperand = [cfg_ir.op_copy(seq_place)];
            let lspans: [1]span.Span = [seq_sp];
            let lcid = try self.cfg.add_call_data(
                self.alloc,
                cfg_ir.callee_builtin(cfg_ir.builtin_op_simple(lop)),
                &largs,
                &lspans,
                true,
                seq_place,
                true,
                seq_sp,
                false,
                false,
            );
            try self.push_stmt(cfg_ir.stmt_call(seq_sp, len_place, lcid));
        }

        let idx_local = try self.new_temp(types.TY_USIZE, sp);
        let idx_place = try self.cfg.add_local_place(self.alloc, idx_local, types.TY_USIZE, sp);
        let zero = try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(types.int_val_zero(), types.TY_USIZE));
        try self.emit_assign(sp, idx_place, cfg_ir.rvalue_use(zero));

        let header_bb = try self.new_block();
        let body_bb = try self.new_block();
        let step_bb = try self.new_block();
        let exit_bb = try self.new_block();
        let h_idx = header_bb.widen.[usize]();
        let has_depth = !self.st.sc.scopes.is_empty();
        let entry_depth = self.current_scope_depth();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        if h_idx < bs_mut.len {
            bs_mut[h_idx].is_loop_header = true;
            bs_mut[h_idx].has_loop_entry_depth = has_depth;
            bs_mut[h_idx].loop_entry_depth = entry_depth;
        }
        if is_par {
            try self.st.sc.par_for_regions.push(
                self.alloc,
                cfg_ir.ParForRegion.{
                    header_bb: header_bb,
                    body_bb: body_bb,
                    step_bb: step_bb,
                    exit_bb: exit_bb,
                    idx_local: idx_local,
                    end_local: len_local,
                    chunk_size: 256_u64,
                },
            );
        }

        self.set_term(cfg_ir.term_goto(header_bb));
        self.has_cur_bb = true;
        self.cur_bb = header_bb;
        let cond = try self.emit_bin_tmp(.Lt, cfg_ir.op_copy(idx_place), cfg_ir.op_copy(len_place), types.TY_BOOL, sp);
        self.set_term(cfg_ir.term_branch(cond, body_bb, exit_bb, sp, false));

        try self.st.sc.loops.push(
            self.alloc,
            LoopTarget.{
                has_label: ast.ident_is_some(label),
                label: label.sym,
                continue_bb: step_bb,
                exit_bb: exit_bb,
                has_break_dst: false,
                break_dst_place: cfg_ir.CFG_NONE,
                break_origin_ty: types.TY_VOID,
                scope_len_at_entry: self.st.sc.scopes.len(),
                any_break: false,
            },
        );

        self.has_cur_bb = true;
        self.cur_bb = body_bb;
        try self.push_scope();
        let idx_op_id = try self.cfg.add_operand(self.alloc, cfg_ir.op_copy(idx_place));
        let elem_place = try self.extend_place(
            seq_place,
            cfg_ir.proj_index(idx_op_id, false, types.int_val_zero(), false, span.SYM_EMPTY, elem_ty),
            elem_ty,
            seq_sp,
        );
        if has_borrow_mode {
            let psp = pat_span(self.arena, pat_id);
            let bind_ty = self.table.get_span_ty(psp) orelse elem_ty;
            let ref_place = try self.new_temp_place(bind_ty, psp);
            try self.emit_assign(psp, ref_place, cfg_ir.rvalue_borrow(borrow_is_mut, elem_place));
            try self.lower_bind_pattern(pat_id, cfg_ir.op_copy(ref_place), bind_ty, false);
        } else {
            try self.lower_bind_pattern(pat_id, cfg_ir.op_copy(elem_place), elem_ty, false);
        }
        try self.lower_block_into(body_id, false, cfg_ir.CFG_NONE, types.TY_NONE);
        try self.pop_scope_normal();
        if self.has_cur_bb {
            self.set_term(cfg_ir.term_goto(step_bb));
        }

        self.has_cur_bb = true;
        self.cur_bb = step_bb;
        let one = try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(types.int_val_from_u64(1_u64), types.TY_USIZE));
        try self.emit_assign(sp, idx_place, cfg_ir.rvalue_binary(.AddWrap, cfg_ir.op_copy(idx_place), one));
        self.set_term(cfg_ir.term_goto(header_bb));

        _ = self.st.sc.loops.pop();
        self.has_cur_bb = true;
        self.cur_bb = exit_bb;
        try self.pop_scope_normal();
        return;
    }

    @recursive
    fn lower_loop(
        self: *mut Self,
        label: ast.IdentSpan,
        body_id: u32,
        has_dst: bool,
        dst_place_id: u32,
        expected_ty: types.TyId,
        sp: span.Span,
    ) -> bool ! OutOfMemory {
        _ = sp;
        let header_bb = try self.new_block();
        let body_bb = try self.new_block();
        let exit_bb = try self.new_block();
        let h_idx = header_bb.widen.[usize]();
        let has_depth = !self.st.sc.scopes.is_empty();
        let entry_depth = self.current_scope_depth();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        if h_idx < bs_mut.len {
            bs_mut[h_idx].is_loop_header = true;
            bs_mut[h_idx].has_loop_entry_depth = has_depth;
            bs_mut[h_idx].loop_entry_depth = entry_depth;
        }

        self.set_term(cfg_ir.term_goto(header_bb));
        self.set_block_term(header_bb, cfg_ir.term_goto(body_bb));

        let orig_ty = if expected_ty != types.TY_NONE { expected_ty } else { types.TY_VOID };
        try self.st.sc.loops.push(
            self.alloc,
            LoopTarget.{
                has_label: ast.ident_is_some(label),
                label: label.sym,
                continue_bb: header_bb,
                exit_bb: exit_bb,
                has_break_dst: has_dst,
                break_dst_place: dst_place_id,
                break_origin_ty: orig_ty,
                scope_len_at_entry: self.st.sc.scopes.len(),
                any_break: false,
            },
        );

        self.has_cur_bb = true;
        self.cur_bb = body_bb;
        try self.lower_block_into(body_id, false, cfg_ir.CFG_NONE, types.TY_NONE);
        if self.has_cur_bb {
            self.set_term(cfg_ir.term_goto(header_bb));
        }

        let target = self.st.sc.loops.pop();
        var any_b = false;
        if let t = target {
            any_b = t.any_break;
        }
        if any_b {
            self.has_cur_bb = true;
            self.cur_bb = exit_bb;
            return true;
        }
        self.has_cur_bb = false;
        return false;
    }
}

// ===========================================================================
// Section 4: Expressions, Places, Aggregates, Error/Optional Flow & Comptime
// ===========================================================================

impl CfgBuilder {
    @recursive
    fn lower_expr_into(
        self: *mut Self,
        expr_id: u32,
        dst_place_id: u32,
        expected_ty: types.TyId,
    ) -> !OutOfMemory {
        let op = try self.lower_expr_rvalue(expr_id, expected_ty);
        if !self.has_cur_bb {
            return;
        }
        let sp = expr_span(self.arena, expr_id);
        let cop = try self.coerce_operand(op, self.place_ty(dst_place_id), sp);
        try self.emit_assign(sp, dst_place_id, cfg_ir.rvalue_use(cop));
        return;
    }

    @recursive
    fn lower_expr_unary(
        self: *mut Self,
        unary_op: ast.UnaryOp,
        operand_id: u32,
        sp: span.Span,
        ty: types.TyId,
        expected: types.TyId,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        match unary_op {
            .Neg => {
                var is_int_lit = false;
                var lit_sym: u32 = 0_u32;
                if let ie = self.arena.get_expr(operand_id) {
                    if ie.kind == .IntLit {
                        is_int_lit = true;
                        lit_sym = ie.a;
                    }
                }
                if is_int_lit {
                    let iv = parse_neg_uint_as_intval(self.interner.get(lit_sym));
                    let final_ty = self.pick_concrete_int_ty(ty, expected);
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(iv, final_ty));
                }
                let op_val = try self.lower_expr_rvalue(operand_id, ty);
                if !self.has_cur_bb {
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
                }
                return try self.emit_unary_tmp(.Neg, op_val, ty, sp);
            }
            .Not => {
                let op_val = try self.lower_expr_rvalue(operand_id, ty);
                if !self.has_cur_bb {
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
                }
                return try self.emit_unary_tmp(.Not, op_val, ty, sp);
            }
            .BitNot => {
                let op_val = try self.lower_expr_rvalue(operand_id, ty);
                if !self.has_cur_bb {
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
                }
                return try self.emit_unary_tmp(.BitNot, op_val, ty, sp);
            }
            .Borrow => {
                let place_id = try self.lower_place(operand_id);
                if !self.has_cur_bb {
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
                }
                let res_ty = if ty != types.TY_ERROR { ty } else { self.place_ty(place_id) };
                let dst = try self.new_temp_place(res_ty, sp);
                try self.emit_assign(sp, dst, cfg_ir.rvalue_borrow(false, place_id));
                return cfg_ir.op_copy(dst);
            }
            .BorrowMut => {
                let place_id = try self.lower_place(operand_id);
                if !self.has_cur_bb {
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
                }
                let res_ty = if ty != types.TY_ERROR { ty } else { self.place_ty(place_id) };
                let dst = try self.new_temp_place(res_ty, sp);
                try self.emit_assign(sp, dst, cfg_ir.rvalue_borrow(true, place_id));
                return cfg_ir.op_copy(dst);
            }
            .Move => {
                let place_id = try self.lower_place(operand_id);
                return cfg_ir.op_move(place_id);
            }
            .Copy => {
                let place_id = try self.lower_place(operand_id);
                return cfg_ir.op_copy(place_id);
            }
            .Try => {
                return try self.lower_try(operand_id, sp, ty);
            }
        }
    }

    @recursive
    fn lower_expr_binary(
        self: *mut Self,
        op: ast.BinaryOp,
        lhs_id: u32,
        rhs_id: u32,
        sp: span.Span,
        ty: types.TyId,
        expected: types.TyId,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        if (op == .And || op == .Or) && ty == types.TY_BOOL {
            return try self.lower_short_circuit(op, lhs_id, rhs_id, sp);
        }
        let lhs_ty = try self.expr_ty(lhs_id, types.TY_ERROR);
        let rhs_ty = try self.expr_ty(rhs_id, types.TY_ERROR);
        let is_cmp = op == .Eq || op == .NotEq || op == .Lt || op == .LtEq || op == .Gt || op == .GtEq;
        let op_ty = if lhs_ty != types.TY_ERROR {
            lhs_ty
        } else if rhs_ty != types.TY_ERROR {
            rhs_ty
        } else if !is_cmp {
            self.pick_concrete_int_ty(ty, expected)
        } else if expected != types.TY_NONE {
            expected
        } else {
            types.TY_ERROR
        };
        let l_raw = try self.lower_expr_rvalue(lhs_id, op_ty);
        let l_ty = self.operand_ty(l_raw);
        let l_concrete = if l_ty == types.TY_COMPTIME_INT {
            self.pick_concrete_int_ty(op_ty, expected)
        } else {
            l_ty
        };
        let r_raw = try self.lower_expr_rvalue(rhs_id, l_concrete);
        let l = try self.coerce_operand(l_raw, l_concrete, expr_span(self.arena, lhs_id));
        let r = try self.coerce_operand(r_raw, l_concrete, expr_span(self.arena, rhs_id));
        let is_chk = op == .AddCheck || op == .SubCheck || op == .MulCheck || op == .DivCheck || op == .ModCheck;
        let out_ty = if is_cmp {
            types.TY_BOOL
        } else if is_chk {
            ty
        } else {
            l_concrete
        };
        return try self.emit_bin_tmp(op, l, r, out_ty, sp);
    }

    @recursive
    fn lower_expr_tuple_or_array(
        self: *mut Self,
        ekind: ast.ExprKind,
        ea: u32,
        eb: u32,
        elist: ast.IdRange,
        esp: span.Span,
        ty: types.TyId,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        if ekind == .Tuple {
            var elem_tys = try col.DynBuf.[types.TyId].init(self.alloc, 4_usize);
            errdefer elem_tys.destroy(self.alloc);
            let tn = self.env.get(ty);
            if tn.kind == .Tuple {
                try elem_tys.push_slice(self.alloc, self.env.node_ty_list(&tn));
            }
            let n_es = elist.len.widen.[usize]();
            var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_es +% 1_usize);
            errdefer ops.destroy(self.alloc);
            let ets = elem_tys.as_slice();
            var i: usize = 0_usize;
            while i < n_es {
                let eid = arena_expr_at(self.arena, elist, i) orelse { break; };
                let et = if i < ets.len { ets[i] } else { types.TY_NONE };
                let op = try self.lower_expr_rvalue(eid, et);
                let cop = if et != types.TY_NONE {
                    try self.coerce_operand(op, et, expr_span(self.arena, eid))
                } else {
                    op
                };
                try ops.push(self.alloc, cop);
                i = i +% 1_usize;
            }
            let dst = try self.new_temp_place(ty, esp);
            let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_tuple());
            let elems_r = try self.cfg.add_operands(self.alloc, ops.as_slice());
            try self.emit_assign(esp, dst, cfg_ir.rvalue_aggregate(agg_id, elems_r));
            ops.destroy(self.alloc);
            elem_tys.destroy(self.alloc);
            return self.operand_for_place(dst);
        }
        if ekind == .ArrayLit {
            let tn = self.env.get(ty);
            let elem_ty = if tn.kind == .Array { tn.primary } else { types.TY_ERROR };
            let hint = if elem_ty != types.TY_ERROR { elem_ty } else { types.TY_NONE };
            let n_es = elist.len.widen.[usize]();
            var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_es +% 1_usize);
            errdefer ops.destroy(self.alloc);
            var i: usize = 0_usize;
            while i < n_es {
                let eid = arena_expr_at(self.arena, elist, i) orelse { break; };
                let op = try self.lower_expr_rvalue(eid, hint);
                let cop = if elem_ty != types.TY_ERROR {
                    try self.coerce_operand(op, elem_ty, expr_span(self.arena, eid))
                } else {
                    op
                };
                try ops.push(self.alloc, cop);
                i = i +% 1_usize;
            }
            let dst = try self.new_temp_place(ty, esp);
            let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_array(elem_ty));
            let elems_r = try self.cfg.add_operands(self.alloc, ops.as_slice());
            try self.emit_assign(esp, dst, cfg_ir.rvalue_aggregate(agg_id, elems_r));
            ops.destroy(self.alloc);
            return self.operand_for_place(dst);
        }
        // ArrayRepeat
        let tn = self.env.get(ty);
        let elem_ty = if tn.kind == .Array { tn.primary } else { types.TY_ERROR };
        let len: u64 = if tn.kind == .Array { tn.u64_val } else { 0_u64 };
        let hint = if elem_ty != types.TY_ERROR { elem_ty } else { types.TY_NONE };
        let vop = try self.lower_expr_rvalue(ea, hint);
        let cop = if elem_ty != types.TY_ERROR {
            try self.coerce_operand(vop, elem_ty, expr_span(self.arena, ea))
        } else {
            vop
        };
        _ = self.eval_simple_const_int(eb);
        let dst = try self.new_temp_place(ty, esp);
        let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_array_repeat(elem_ty, len));
        let one: [1]cfg_ir.CfgOperand = [cop];
        let elems_r = try self.cfg.add_operands(self.alloc, &one);
        try self.emit_assign(esp, dst, cfg_ir.rvalue_aggregate(agg_id, elems_r));
        return self.operand_for_place(dst);
    }

    @recursive
    fn lower_inline_asm(
        self: *mut Self,
        tmpl_list: ast.IdRange,
        ops_list: ast.IdRange,
        esp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let n_ops = ops_list.len.widen.[usize]();
        var inputs = try col.DynBuf.[cfg_ir.CfgAsmInput].init(self.alloc, n_ops +% 1_usize);
        errdefer inputs.destroy(self.alloc);
        var name_buf = try str.StrBuf.init(self.alloc, 32_usize);
        errdefer name_buf.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < n_ops {
            let op = arena_asm_op_at(self.arena, ops_list, i) orelse { break; };
            if op.kind == .Named {
                if op.arg != ast.NONE_ID {
                    name_buf.clear();
                    try name_buf.push_bytes_grow(self.alloc, self.interner.get(op.dir.sym));
                    try name_buf.push_byte_grow(self.alloc, b':');
                    if let ce = self.arena.get_expr(op.expr) {
                        if ce.kind == .StringLit || ce.kind == .RawStringLit {
                            try name_buf.push_bytes_grow(self.alloc, self.arena.str_bytes_range(ce.list));
                        }
                    }
                    let v = try self.lower_expr_rvalue(op.arg, types.TY_NONE);
                    let nr = try self.cfg.add_bytes(self.alloc, name_buf.as_bytes());
                    try inputs.push(self.alloc, cfg_ir.CfgAsmInput.{ name: nr, operand: v });
                }
            } else {
                let v = try self.lower_expr_rvalue(op.expr, types.TY_NONE);
                let nr = try self.cfg.add_str(self.alloc, "expr");
                try inputs.push(self.alloc, cfg_ir.CfgAsmInput.{ name: nr, operand: v });
            }
            i = i +% 1_usize;
        }
        let tmpl_r = try self.cfg.add_bytes(self.alloc, self.arena.str_bytes_range(tmpl_list));
        let in_r = try self.cfg.add_asm_inputs(self.alloc, inputs.as_slice());
        let dst = try self.new_temp_place(types.TY_VOID, esp);
        try self.emit_assign(esp, dst, cfg_ir.rvalue_inline_asm(tmpl_r, in_r));
        let res = try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        name_buf.destroy(self.alloc);
        inputs.destroy(self.alloc);
        return res;
    }

    @recursive
    fn lower_expr_rvalue(
        self: *mut Self,
        expr_id: u32,
        expected: types.TyId,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        var has_e = false;
        var e_kind: ast.ExprKind = .Error;
        var e_a: u32 = ast.NONE_ID;
        var e_b: u32 = ast.NONE_ID;
        var e_c: u32 = ast.NONE_ID;
        var e_flag = false;
        var e_unary_op: ast.UnaryOp = .Not;
        var e_bin_op: ast.BinaryOp = .Add;
        var e_body_kind: ast.BodyKind = .Expr;
        var e_ident = ast.ident_none();
        var e_list = ast.range_empty();
        var e_list2 = ast.range_empty();
        var e_span = span.span_dummy();
        if let e = self.arena.get_expr(expr_id) {
            has_e = true;
            e_kind = e.kind;
            e_a = e.a;
            e_b = e.b;
            e_c = e.c;
            e_flag = e.flag;
            e_unary_op = e.unary_op;
            e_bin_op = e.bin_op;
            e_body_kind = e.body_kind;
            e_ident = e.ident;
            e_list = e.list;
            e_list2 = e.list2;
            e_span = e.span;
        }
        if !has_e {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        }
        let exp_fallback = if expected != types.TY_NONE { expected } else { types.TY_ERROR };
        let ty = try self.expr_ty(expr_id, exp_fallback);

        match e_kind {
            .Ident => {
                if let loc = self.lookup_local(e_a) {
                    let p = try self.cfg.add_local_place(self.alloc, loc, self.local_ty(loc), e_span);
                    return self.operand_for_place(p);
                }
                if let cap = self.lookup_captured(e_a) {
                    let p = try self.make_captured_place(cap, e_span);
                    return self.operand_for_place(p);
                }
                if let target = self.prog.lookup_in_module(self.module_id, e_a) {
                    let et = if expected != types.TY_NONE { expected } else { ty };
                    return try self.lower_scope_target_const(target, et);
                }
                return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
            }
            .SelfVal => {
                if self.has_captured_self {
                    let p = try self.make_captured_place(self.captured_self, e_span);
                    return self.operand_for_place(p);
                }
                let ps = self.st.bufs.params.as_slice();
                if ps.len > 0_usize {
                    let self_loc = ps[0_usize];
                    let p = try self.cfg.add_local_place(self.alloc, self_loc, self.local_ty(self_loc), e_span);
                    return self.operand_for_place(p);
                }
                return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
            }
            .IntLit => {
                let iv = parse_uint_as_intval(self.interner.get(e_a));
                let final_ty = self.pick_concrete_int_ty(ty, expected);
                return try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(iv, final_ty));
            }
            .FloatLit => {
                let final_ty = if self.env.is_float(ty) {
                    ty
                } else if expected != types.TY_NONE && self.env.is_float(expected) {
                    expected
                } else {
                    types.TY_F64
                };
                return try self.cfg.add_const_float_op(self.alloc, self.interner.get(e_a), final_ty);
            }
            .BoolLit => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(e_flag)); }
            .CharLit => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_char(e_a)); }
            .ByteCharLit => {
                let b = (e_a & 0xFF_u32).widen.[u64]();
                return try self.cfg.add_const_op(
                    self.alloc,
                    cfg_ir.const_int(types.int_val_from_u64(b), types.TY_U8),
                );
            }
            .StringLit => { return try self.cfg.add_const_str_op(self.alloc, self.arena.str_bytes_range(e_list)); }
            .RawStringLit => { return try self.cfg.add_const_str_op(self.alloc, self.arena.str_bytes_range(e_list)); }
            .ByteStringLit => { return try self.cfg.add_const_bytes_op(self.alloc, self.arena.byte_bytes_range(e_list)); }
            .Null => {
                let nt = if ty != types.TY_ERROR { ty } else { exp_fallback };
                return try self.cfg.add_const_op(self.alloc, cfg_ir.const_null(nt));
            }
            .EnumLit => {
                let et = if ty != types.TY_ERROR { ty } else { exp_fallback };
                return try self.lower_enum_or_error_lit(e_ident, et);
            }
            .Paren => { return try self.lower_expr_rvalue(e_a, expected); }
            .ComptimeExpr => {
                if let cv_id = self.table.get_comptime_val(expr_id) {
                    let ct_ty = if ty != types.TY_ERROR { ty } else { exp_fallback };
                    return try self.lower_ct_val(cv_id, ct_ty, e_span);
                }
                return try self.lower_expr_rvalue(e_a, expected);
            }
            .Field => {
                let enum_ty = if ty != types.TY_ERROR { ty } else { exp_fallback };
                if let cop = try self.try_lower_assoc_const_or_enum(e_a, e_ident, enum_ty) {
                    return cop;
                }
                if let cv_id = self.table.get_comptime_val(e_a) {
                    if let fv_id = self.ct.get_struct_field(cv_id, e_ident.sym) {
                        let fty = if ty != types.TY_ERROR { ty } else { exp_fallback };
                        return try self.lower_ct_val(fv_id, fty, e_span);
                    }
                }
                if sym_is(self.interner, e_ident.sym, "len") {
                    if let lop = try self.try_lower_len_field(e_a, e_span) {
                        return lop;
                    }
                }
                let p = try self.lower_place(expr_id);
                return self.operand_for_place(p);
            }
            .Deref => {
                let p = try self.lower_place(expr_id);
                return self.operand_for_place(p);
            }
            .Index => {
                let p = try self.lower_place(expr_id);
                return self.operand_for_place(p);
            }
            .Unary => { return try self.lower_expr_unary(e_unary_op, e_a, e_span, ty, expected); }
            .Binary => { return try self.lower_expr_binary(e_bin_op, e_a, e_b, e_span, ty, expected); }
            .Slice => {
                let raw_bty = try self.expr_ty(e_a, types.TY_NONE);
                let raw_bn = self.env.get(raw_bty);
                let out_n = self.env.get(ty);
                let out_mut = out_n.kind == .Borrow && out_n.flag0;
                var b_op = cfg_ir.op_none();
                if raw_bn.kind == .Array {
                    // Borrow array place directly (zero value copy, prevents dangling stack slices in `view fn`).
                    let place_id = try self.lower_place(e_a);
                    if !self.has_cur_bb {
                        return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
                    }
                    let ptr_ty = try self.env.intern_borrow(self.alloc, out_mut, .Single, raw_bty);
                    let p_dst = try self.new_temp_place(ptr_ty, e_span);
                    try self.emit_assign(e_span, p_dst, cfg_ir.rvalue_borrow(out_mut, place_id));
                    let sl_ty = try self.env.intern_borrow(self.alloc, out_mut, .Slice, raw_bn.primary);
                    b_op = try self.coerce_operand(cfg_ir.op_copy(p_dst), sl_ty, e_span);
                } else {
                    b_op = try self.lower_expr_rvalue(e_a, types.TY_NONE);
                }
                let has_lo = e_b != ast.NONE_ID;
                let lo_op = if has_lo { try self.lower_expr_rvalue(e_b, types.TY_USIZE) } else { cfg_ir.op_none() };
                let has_hi = e_c != ast.NONE_ID;
                let hi_op = if has_hi { try self.lower_expr_rvalue(e_c, types.TY_USIZE) } else { cfg_ir.op_none() };
                let dst = try self.new_temp_place(ty, e_span);
                try self.emit_assign(e_span, dst, cfg_ir.rvalue_slice(b_op, has_lo, lo_op, has_hi, hi_op));
                return cfg_ir.op_copy(dst);
            }
            .If => {
                let res_ty = if ty != types.TY_ERROR {
                    ty
                } else if expected != types.TY_NONE {
                    expected
                } else {
                    types.TY_VOID
                };
                if res_ty == types.TY_VOID {
                    try self.lower_if(e_a, false, cfg_ir.CFG_NONE, types.TY_NONE);
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
                }
                let dst = try self.new_temp_place(res_ty, e_span);
                try self.lower_if(e_a, true, dst, res_ty);
                return self.operand_for_place(dst);
            }
            .Match => {
                let res_ty = if ty != types.TY_ERROR {
                    ty
                } else if expected != types.TY_NONE {
                    expected
                } else {
                    types.TY_VOID
                };
                if res_ty == types.TY_VOID {
                    try self.lower_match(e_a, e_list, false, cfg_ir.CFG_NONE, types.TY_NONE, e_span);
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
                }
                let dst = try self.new_temp_place(res_ty, e_span);
                try self.lower_match(e_a, e_list, true, dst, res_ty, e_span);
                return self.operand_for_place(dst);
            }
            .Loop => {
                let res_ty = if ty != types.TY_ERROR {
                    ty
                } else if expected != types.TY_NONE {
                    expected
                } else {
                    types.TY_VOID
                };
                if res_ty == types.TY_VOID {
                    _ = try self.lower_loop(e_ident, e_a, false, cfg_ir.CFG_NONE, types.TY_NONE, e_span);
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
                }
                let dst = try self.new_temp_place(res_ty, e_span);
                _ = try self.lower_loop(e_ident, e_a, true, dst, res_ty, e_span);
                return self.operand_for_place(dst);
            }
            .Orelse => { return try self.lower_orelse(e_a, e_body_kind, e_b, ty, e_span); }
            .Catch => { return try self.lower_catch(e_a, e_ident, e_body_kind, e_b, ty, e_span); }
            .Call => { return try self.lower_call(expr_id, e_a, e_list, ty, e_span); }
            .GenericApply => { return try self.lower_expr_rvalue(e_a, expected); }
            .Tuple => { return try self.lower_expr_tuple_or_array(e_kind, e_a, e_b, e_list, e_span, ty); }
            .ArrayLit => { return try self.lower_expr_tuple_or_array(e_kind, e_a, e_b, e_list, e_span, ty); }
            .ArrayRepeat => { return try self.lower_expr_tuple_or_array(e_kind, e_a, e_b, e_list, e_span, ty); }
            .AnonStructLit => { return try self.lower_struct_lit(ty, e_list, e_span); }
            .NamedStructLit => { return try self.lower_struct_lit(ty, e_list, e_span); }
            .Is => {
                let sop = try self.lower_expr_rvalue(e_a, types.TY_NONE);
                if !self.has_cur_bb {
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(false));
                }
                let st = self.operand_ty(sop);
                let isp = expr_span(self.arena, e_a);
                let splace = try self.new_temp_place(st, isp);
                try self.emit_assign(isp, splace, cfg_ir.rvalue_use(sop));
                return try self.lower_pat_test(splace, e_b, st, e_span);
            }
            .Builtin => { return try self.lower_builtin_expr(expr_id, e_ident, e_list, ty, e_span); }
            .ComptimeBlock => {
                let res_ty = if ty != types.TY_ERROR {
                    ty
                } else if expected != types.TY_NONE {
                    expected
                } else {
                    types.TY_VOID
                };
                if let cv_id = self.table.get_comptime_val(expr_id) {
                    return try self.lower_ct_val(cv_id, res_ty, e_span);
                }
                let dst = try self.new_temp_place(res_ty, e_span);
                try self.lower_block_into(e_a, true, dst, res_ty);
                return self.operand_for_place(dst);
            }
            .Closure => { return try self.lower_closure(e_list, e_a, ty, expected, e_span); }
            .Asm => { return try self.lower_inline_asm(e_list, e_list2, e_span); }
            .ReturnVal => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void()); }
            .Error => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void()); }
        }
    }

    fn find_field_init(
        self: *Self,
        fields_range: ast.IdRange,
        sym: u32,
    ) -> ?ast.FieldInitNode {
        let fis = self.arena.field_inits_range(fields_range);
        var i: usize = 0_usize;
        while i < fis.len {
            if ast.ident_is_some(fis[i].name) && fis[i].name.sym == sym {
                return fis[i];
            }
            i = i +% 1_usize;
        }
        return null;
    }

    @recursive
    fn lower_struct_lit(
        self: *mut Self,
        ty: types.TyId,
        fields_range: ast.IdRange,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let tn = self.env.get(ty);
        if tn.kind == .Struct {
            let def_id = tn.primary;
            var mfs = try col.DynBuf.[types.FieldMeta].init(self.alloc, 8_usize);
            errdefer mfs.destroy(self.alloc);
            if let sm = self.env.get_struct(def_id) {
                try mfs.push_slice(self.alloc, self.env.struct_fields_range(sm.fields));
            }
            var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, mfs.len() +% 1_usize);
            errdefer ops.destroy(self.alloc);
            let fs = mfs.as_slice();
            var i: usize = 0_usize;
            while i < fs.len {
                if let finit = self.find_field_init(fields_range, fs[i].name) {
                    let op = try self.lower_expr_rvalue(finit.value, fs[i].ty);
                    let cop = try self.coerce_operand(op, fs[i].ty, expr_span(self.arena, finit.value));
                    try ops.push(self.alloc, cop);
                } else {
                    try ops.push(self.alloc, try self.cfg.add_const_op(self.alloc, cfg_ir.const_null(fs[i].ty)));
                }
                i = i +% 1_usize;
            }
            let dst = try self.new_temp_place(ty, sp);
            let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_struct(def_id));
            let er = try self.cfg.add_operands(self.alloc, ops.as_slice());
            try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
            ops.destroy(self.alloc);
            mfs.destroy(self.alloc);
            return self.operand_for_place(dst);
        }
        if tn.kind == .Pool {
            let def_id = tn.primary;
            let is_slot_pool = if self.has_pool_row_is_slot { self.pool_row_is_slot } else { true };
            var cols = try col.DynBuf.[types.PoolColumnMeta].init(self.alloc, 8_usize);
            errdefer cols.destroy(self.alloc);
            if let pm = self.env.get_pool(def_id) {
                try cols.push_slice(self.alloc, self.env.pool_cols_range(pm.columns));
            }
            var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, cols.len() +% 1_usize);
            errdefer ops.destroy(self.alloc);
            let cs = cols.as_slice();
            var i: usize = 0_usize;
            while i < cs.len {
                if let finit = self.find_field_init(fields_range, cs[i].name) {
                    let cty = try self.raw_ty_expr(finit.value);
                    let hint = if cty != types.TY_ERROR { cty } else { cs[i].ty };
                    let op = try self.lower_expr_rvalue(finit.value, hint);
                    let cn = self.env.get(cs[i].ty);
                    var is_link = cn.kind == .Builtin && cn.builtin_kind == .Link;
                    if !is_link && cn.kind == .Optional {
                        let inn = self.env.get(cn.primary);
                        is_link = inn.kind == .Builtin && inn.builtin_kind == .Link;
                    }
                    let target_ty = if !is_link { cs[i].ty } else { self.operand_ty(op) };
                    let cop = try self.coerce_operand(op, target_ty, expr_span(self.arena, finit.value));
                    try ops.push(self.alloc, cop);
                }
                i = i +% 1_usize;
            }
            let dst = try self.new_temp_place(ty, sp);
            let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_pool_row(def_id, is_slot_pool));
            let er = try self.cfg.add_operands(self.alloc, ops.as_slice());
            try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
            ops.destroy(self.alloc);
            cols.destroy(self.alloc);
            return self.operand_for_place(dst);
        }
        if tn.kind == .AnonStruct {
            var afs = try col.DynBuf.[types.AnonField].init(self.alloc, tn.list_len.widen.[usize]() +% 1_usize);
            errdefer afs.destroy(self.alloc);
            try afs.push_slice(self.alloc, self.env.node_anon_fields(&tn));
            var names = try col.DynBuf.[u32].init(self.alloc, afs.len() +% 1_usize);
            errdefer names.destroy(self.alloc);
            var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, afs.len() +% 1_usize);
            errdefer ops.destroy(self.alloc);
            let fs = afs.as_slice();
            var i: usize = 0_usize;
            while i < fs.len {
                try names.push(self.alloc, fs[i].name);
                if let finit = self.find_field_init(fields_range, fs[i].name) {
                    let op = try self.lower_expr_rvalue(finit.value, fs[i].ty);
                    let cop = try self.coerce_operand(op, fs[i].ty, expr_span(self.arena, finit.value));
                    try ops.push(self.alloc, cop);
                }
                i = i +% 1_usize;
            }
            let dst = try self.new_temp_place(ty, sp);
            let nr = try self.cfg.add_syms(self.alloc, names.as_slice());
            let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_anon_struct(nr));
            let er = try self.cfg.add_operands(self.alloc, ops.as_slice());
            try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
            ops.destroy(self.alloc);
            names.destroy(self.alloc);
            afs.destroy(self.alloc);
            return self.operand_for_place(dst);
        }
        if tn.kind == .Bitfield {
            let def_id = tn.primary;
            var mbs = try col.DynBuf.[types.BitfieldMemberMeta].init(self.alloc, 8_usize);
            errdefer mbs.destroy(self.alloc);
            if let bm = self.env.get_bitfield(def_id) {
                try mbs.push_slice(self.alloc, self.env.bitfield_members_range(bm.members));
            }
            var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, mbs.len() +% 1_usize);
            errdefer ops.destroy(self.alloc);
            let ms = mbs.as_slice();
            var i: usize = 0_usize;
            while i < ms.len {
                if let finit = self.find_field_init(fields_range, ms[i].name) {
                    let op = try self.lower_expr_rvalue(finit.value, ms[i].ty);
                    let cop = try self.coerce_operand(op, ms[i].ty, expr_span(self.arena, finit.value));
                    try ops.push(self.alloc, cop);
                } else {
                    let z = try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(types.int_val_zero(), ms[i].ty));
                    try ops.push(self.alloc, z);
                }
                i = i +% 1_usize;
            }
            let dst = try self.new_temp_place(ty, sp);
            let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_bitfield(def_id));
            let er = try self.cfg.add_operands(self.alloc, ops.as_slice());
            try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
            ops.destroy(self.alloc);
            mbs.destroy(self.alloc);
            return self.operand_for_place(dst);
        }
        if tn.kind == .Vec {
            let elem = tn.primary;
            let vlen = tn.u8_val;
            let n_fis = fields_range.len.widen.[usize]();
            var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_fis +% 1_usize);
            errdefer ops.destroy(self.alloc);
            var i: usize = 0_usize;
            while i < n_fis {
                let finit = arena_field_init_at(self.arena, fields_range, i) orelse { break; };
                let fval = finit.value;
                let op = try self.lower_expr_rvalue(fval, elem);
                let cop = try self.coerce_operand(op, elem, expr_span(self.arena, fval));
                try ops.push(self.alloc, cop);
                i = i +% 1_usize;
            }
            let dst = try self.new_temp_place(ty, sp);
            let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_vec(elem, vlen));
            let er = try self.cfg.add_operands(self.alloc, ops.as_slice());
            try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
            ops.destroy(self.alloc);
            return self.operand_for_place(dst);
        }
        let n_fis = fields_range.len.widen.[usize]();
        var i: usize = 0_usize;
        while i < n_fis {
            let finit = arena_field_init_at(self.arena, fields_range, i) orelse { break; };
            _ = try self.lower_expr_rvalue(finit.value, types.TY_NONE);
            i = i +% 1_usize;
        }
        return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
    }

    @recursive
    fn lower_place_field(
        self: *mut Self,
        base_id: u32,
        field: ast.IdentSpan,
        expr_ty: types.TyId,
        sp: span.Span,
    ) -> u32 ! OutOfMemory {
        var bp = try self.lower_place(base_id);
        let bp_ty = self.place_ty(bp);
        let bn = self.env.get(bp_ty);
        let base_inner = if bn.kind == .Borrow && bn.borrow_kind == .Single { bn.primary } else { bp_ty };
        let bin = self.env.get(base_inner);

        if bin.kind == .Struct {
            var fidx: u32 = 0_u32;
            var fty = expr_ty;
            if let sm = self.env.get_struct(bin.primary) {
                let fs = self.env.struct_fields_range(sm.fields);
                var i: usize = 0_usize;
                while i < fs.len {
                    if fs[i].name == field.sym {
                        fidx = i.trunc.[u32]();
                        fty = fs[i].ty;
                        break;
                    }
                    i = i +% 1_usize;
                }
            }
            return try self.extend_place(bp, cfg_ir.proj_field(field.sym, fidx, fty), expr_ty, sp);
        }
        if bin.kind == .Pool {
            var fidx: u32 = 0_u32;
            var fty = expr_ty;
            if let pm = self.env.get_pool(bin.primary) {
                let cs = self.env.pool_cols_range(pm.columns);
                var i: usize = 0_usize;
                while i < cs.len {
                    if cs[i].name == field.sym {
                        fidx = i.trunc.[u32]();
                        fty = cs[i].ty;
                        break;
                    }
                    i = i +% 1_usize;
                }
            }
            return try self.extend_place(bp, cfg_ir.proj_field(field.sym, fidx, fty), expr_ty, sp);
        }
        if bin.kind == .AnonStruct {
            var fidx: u32 = 0_u32;
            var fty = expr_ty;
            let fs = self.env.node_anon_fields(&bin);
            var i: usize = 0_usize;
            while i < fs.len {
                if fs[i].name == field.sym {
                    fidx = i.trunc.[u32]();
                    fty = fs[i].ty;
                    break;
                }
                i = i +% 1_usize;
            }
            return try self.extend_place(bp, cfg_ir.proj_field(field.sym, fidx, fty), expr_ty, sp);
        }
        if bin.kind == .Tuple {
            let idx = (str.parse_u64(self.interner.get(field.sym)) catch 0_u64).trunc.[u32]();
            return try self.extend_place(bp, cfg_ir.proj_tuple_field(idx, expr_ty), expr_ty, sp);
        }
        if bin.kind == .Bitfield {
            var fidx: u32 = 0_u32;
            var fty = expr_ty;
            if let bm = self.env.get_bitfield(bin.primary) {
                let ms = self.env.bitfield_members_range(bm.members);
                var i: usize = 0_usize;
                while i < ms.len {
                    if ms[i].name == field.sym {
                        fidx = i.trunc.[u32]();
                        fty = ms[i].ty;
                        break;
                    }
                    i = i +% 1_usize;
                }
            }
            return try self.extend_place(bp, cfg_ir.proj_field(field.sym, fidx, fty), expr_ty, sp);
        }
        if bin.kind == .Vec {
            let elem = bin.primary;
            let flen = self.interner.get(field.sym).len;
            if flen >= 2_usize {
                if bn.kind == .Borrow && bn.borrow_kind == .Single {
                    bp = try self.extend_place(bp, cfg_ir.proj_deref(), base_inner, sp);
                }
                var elems = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, flen);
                errdefer elems.destroy(self.alloc);
                var ci: usize = 0_usize;
                while ci < flen {
                    let ch = sym_byte_at(self.interner, field.sym, ci);
                    let fidx: u32 = if ch == b'x' || ch == b'r' {
                        0_u32
                    } else if ch == b'y' || ch == b'g' {
                        1_u32
                    } else if ch == b'z' || ch == b'b' {
                        2_u32
                    } else {
                        3_u32
                    };
                    let lane_p = try self.extend_place(bp, cfg_ir.proj_field(field.sym, fidx, elem), elem, sp);
                    try elems.push(self.alloc, self.operand_for_place(lane_p));
                    ci = ci +% 1_usize;
                }
                let vlen = flen.trunc.[u8]();
                let out_ty = try self.env.intern_vec(self.alloc, elem, vlen);
                let dst = try self.new_temp_place(out_ty, sp);
                let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_vec(elem, vlen));
                let er = try self.cfg.add_operands(self.alloc, elems.as_slice());
                try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
                elems.destroy(self.alloc);
                return dst;
            }
            var fidx: u32 = 0_u32;
            if flen == 1_usize {
                let ch = sym_byte_at(self.interner, field.sym, 0_usize);
                if ch == b'y' || ch == b'g' {
                    fidx = 1_u32;
                } else if ch == b'z' || ch == b'b' {
                    fidx = 2_u32;
                } else if ch == b'w' || ch == b'a' {
                    fidx = 3_u32;
                }
            }
            return try self.extend_place(bp, cfg_ir.proj_field(field.sym, fidx, elem), expr_ty, sp);
        }
        if bin.kind == .Builtin && bin.builtin_kind == .Env {
            var fidx: u32 = 0_u32;
            if sym_is(self.interner, field.sym, "fs") {
                fidx = 1_u32;
            } else if sym_is(self.interner, field.sym, "net") {
                fidx = 2_u32;
            } else if sym_is(self.interner, field.sym, "clock") {
                fidx = 3_u32;
            } else if sym_is(self.interner, field.sym, "io") {
                fidx = 4_u32;
            } else if sym_is(self.interner, field.sym, "args") {
                fidx = 5_u32;
            }
            return try self.extend_place(bp, cfg_ir.proj_field(field.sym, fidx, expr_ty), expr_ty, sp);
        }
        if bin.kind == .Builtin && (bin.builtin_kind == .ArenaPool || bin.builtin_kind == .SlotPool) {
            var cidx: u32 = 0_u32;
            var cty = expr_ty;
            let gs = self.env.node_gval_list(&bin);
            if gs.len > 0_usize && gs[0_usize].kind == .Ty {
                let ptn = self.env.get(gs[0_usize].id);
                if ptn.kind == .Pool {
                    if let pm = self.env.get_pool(ptn.primary) {
                        let cs = self.env.pool_cols_range(pm.columns);
                        var i: usize = 0_usize;
                        while i < cs.len {
                            if cs[i].name == field.sym {
                                cidx = i.trunc.[u32]();
                                cty = cs[i].ty;
                                break;
                            }
                            i = i +% 1_usize;
                        }
                    }
                }
            }
            let en = self.env.get(expr_ty);
            let col_elem_ty = if en.kind == .Borrow && en.borrow_kind == .Slice { en.primary } else { cty };
            let is_slot = bin.builtin_kind == .SlotPool;
            return try self.extend_place(
                bp,
                cfg_ir.proj_pool_col(field.sym, cidx, is_slot, col_elem_ty),
                expr_ty,
                sp,
            );
        }
        return try self.extend_place(bp, cfg_ir.proj_field(field.sym, 0_u32, expr_ty), expr_ty, sp);
    }

    @recursive
    fn lower_place(self: *mut Self, expr_id: u32) -> u32 ! OutOfMemory {
        var has_e = false;
        var e_kind: ast.ExprKind = .Error;
        var e_a: u32 = ast.NONE_ID;
        var e_b: u32 = ast.NONE_ID;
        var e_ident = ast.ident_none();
        var e_span = span.span_dummy();
        if let e = self.arena.get_expr(expr_id) {
            has_e = true;
            e_kind = e.kind;
            e_a = e.a;
            e_b = e.b;
            e_ident = e.ident;
            e_span = e.span;
        }
        if !has_e {
            return try self.new_temp_place(types.TY_ERROR, span.span_dummy());
        }
        let expr_ty = try self.expr_ty(expr_id, types.TY_ERROR);
        match e_kind {
            .Ident => {
                if let loc = self.lookup_local(e_a) {
                    return try self.cfg.add_local_place(self.alloc, loc, self.local_ty(loc), e_span);
                }
                if let cap = self.lookup_captured(e_a) {
                    return try self.make_captured_place(cap, e_span);
                }
                if let target = self.prog.lookup_in_module(self.module_id, e_a) {
                    let cop = try self.lower_scope_target_const(target, expr_ty);
                    let cty = self.operand_ty(cop);
                    let use_ty = if cty != types.TY_ERROR { cty } else { expr_ty };
                    let place = try self.new_temp_place(use_ty, e_span);
                    try self.emit_assign(e_span, place, cfg_ir.rvalue_use(cop));
                    return place;
                }
                return try self.new_temp_place(expr_ty, e_span);
            }
            .SelfVal => {
                if self.has_captured_self {
                    return try self.make_captured_place(self.captured_self, e_span);
                }
                let ps = self.st.bufs.params.as_slice();
                if ps.len > 0_usize {
                    let loc = ps[0_usize];
                    return try self.cfg.add_local_place(self.alloc, loc, self.local_ty(loc), e_span);
                }
                return try self.new_temp_place(expr_ty, e_span);
            }
            .Paren => { return try self.lower_place(e_a); }
            .Deref => {
                let bp = try self.lower_place(e_a);
                let bty = self.place_ty(bp);
                let bn = self.env.get(bty);
                let deref_ty = if (bn.kind == .Borrow && bn.borrow_kind == .Single) || bn.kind == .RawPtr {
                    bn.primary
                } else {
                    expr_ty
                };
                return try self.extend_place(bp, cfg_ir.proj_deref(), deref_ty, e_span);
            }
            .Field => { return try self.lower_place_field(e_a, e_ident, expr_ty, e_span); }
            .Index => {
                let bp = try self.lower_place(e_a);
                let idx_ty = try self.expr_ty(e_b, types.TY_USIZE);
                let idx_op = try self.lower_expr_rvalue(e_b, idx_ty);
                var has_cidx = false;
                var cidx = types.int_val_zero();
                if let iv = self.eval_simple_const_int(e_b) {
                    has_cidx = true;
                    cidx = iv;
                }
                var has_key = false;
                var key_sym = span.SYM_EMPTY;
                if let ie = self.arena.get_expr(e_b) {
                    if ie.kind == .Ident {
                        has_key = true;
                        key_sym = ie.a;
                    }
                }
                var elem_ty = expr_ty;
                var from_pool_col = false;
                let bps = self.cfg.place_projs(bp);
                if bps.len > 0_usize {
                    let last = bps[bps.len - 1_usize];
                    if last.kind == .PoolCol {
                        elem_ty = last.ty;
                        from_pool_col = true;
                    }
                }
                if !from_pool_col {
                    let bn = self.env.get(self.place_ty(bp));
                    if bn.kind == .Array || (bn.kind == .Borrow && bn.borrow_kind == .Slice) {
                        elem_ty = bn.primary;
                    } else if (bn.kind == .Borrow && bn.borrow_kind == .Str) || bn.kind == .Str {
                        elem_ty = types.TY_U8;
                    } else if bn.kind == .Builtin && bn.builtin_kind == .GpuBuf {
                        let gs = self.env.node_gval_list(&bn);
                        if gs.len > 0_usize && gs[0_usize].kind == .Ty {
                            elem_ty = gs[0_usize].id;
                        }
                    }
                }
                let idx_op_id = try self.cfg.add_operand(self.alloc, idx_op);
                return try self.extend_place(
                    bp,
                    cfg_ir.proj_index(idx_op_id, has_cidx, cidx, has_key, key_sym, elem_ty),
                    elem_ty,
                    e_span,
                );
            }
            _ => {
                let val_op = try self.lower_expr_rvalue(expr_id, types.TY_NONE);
                let vty = self.operand_ty(val_op);
                let dst = try self.new_temp_place(vty, e_span);
                try self.emit_assign(e_span, dst, cfg_ir.rvalue_use(val_op));
                return dst;
            }
        }
    }

    @recursive
    fn lower_short_circuit(
        self: *mut Self,
        op: ast.BinaryOp,
        lhs_id: u32,
        rhs_id: u32,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let dst = try self.new_temp_place(types.TY_BOOL, sp);
        let l = try self.lower_expr_rvalue(lhs_id, types.TY_BOOL);
        if !self.has_cur_bb {
            return cfg_ir.op_copy(dst);
        }
        let rhs_bb = try self.new_block();
        let short_bb = try self.new_block();
        let merge_bb = try self.new_block();

        let is_and = op == .And;
        let then_bb = if is_and { rhs_bb } else { short_bb };
        let else_bb = if is_and { short_bb } else { rhs_bb };
        let short_val = !is_and;
        self.set_term(cfg_ir.term_branch(l, then_bb, else_bb, sp, false));

        self.has_cur_bb = true;
        self.cur_bb = short_bb;
        let sc = try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(short_val));
        try self.emit_assign(sp, dst, cfg_ir.rvalue_use(sc));
        self.set_term(cfg_ir.term_goto(merge_bb));

        self.has_cur_bb = true;
        self.cur_bb = rhs_bb;
        let r = try self.lower_expr_rvalue(rhs_id, types.TY_BOOL);
        if self.has_cur_bb {
            try self.emit_assign(expr_span(self.arena, rhs_id), dst, cfg_ir.rvalue_use(r));
            self.set_term(cfg_ir.term_goto(merge_bb));
        }

        self.has_cur_bb = true;
        self.cur_bb = merge_bb;
        return cfg_ir.op_copy(dst);
    }

    @recursive
    fn lower_try(
        self: *mut Self,
        inner_id: u32,
        sp: span.Span,
        ok_ty: types.TyId,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let eu_ty = try self.raw_ty_expr(inner_id);
        let hint = if eu_ty != types.TY_ERROR { eu_ty } else { types.TY_NONE };
        let eu_op = try self.lower_expr_rvalue(inner_id, hint);
        if !self.has_cur_bb {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        }
        let isp = expr_span(self.arena, inner_id);
        let actual_eu_ty = self.operand_ty(eu_op);
        let eu_place = try self.new_temp_place(actual_eu_ty, isp);
        try self.emit_assign(isp, eu_place, cfg_ir.rvalue_use(eu_op));

        let is_err_place = try self.new_temp_place(types.TY_BOOL, sp);
        try self.emit_assign(sp, is_err_place, cfg_ir.rvalue_is_error(cfg_ir.op_copy(eu_place)));

        let err_bb = try self.new_block();
        let ok_bb = try self.new_block();
        let e_idx = err_bb.widen.[usize]();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        if e_idx < bs_mut.len {
            bs_mut[e_idx].is_cleanup = true;
            bs_mut[e_idx].has_error_site_span = true;
            bs_mut[e_idx].error_site_span = sp;
        }
        self.set_term(cfg_ir.term_branch(cfg_ir.op_copy(is_err_place), err_bb, ok_bb, sp, false));

        self.has_cur_bb = true;
        self.cur_bb = err_bb;
        self.cleanup_depth = self.cleanup_depth +% 1_u32;
        self.has_active_err_span = true;
        self.active_err_span = sp;

        let err_ext_ty = try self.enclosing_err_set_ty();
        let ext_place = try self.new_temp_place(err_ext_ty, sp);
        try self.emit_assign(sp, ext_place, cfg_ir.rvalue_unwrap_error_err(cfg_ir.op_copy(eu_place)));
        let wrapped_err = try self.coerce_error_into_union(cfg_ir.op_copy(ext_place), sp, self.sig.ret);

        try self.emit_unwind_to_scope(0_usize, true, true, wrapped_err);
        if self.has_cur_bb {
            self.set_term(cfg_ir.term_return_val(wrapped_err, sp));
        }
        self.has_active_err_span = false;
        self.cleanup_depth = self.cleanup_depth -% 1_u32;

        self.has_cur_bb = true;
        self.cur_bb = ok_bb;
        let aen = self.env.get(actual_eu_ty);
        let final_ok_ty = if ok_ty != types.TY_ERROR {
            ok_ty
        } else if aen.kind == .ErrorUnion {
            aen.primary
        } else {
            types.TY_VOID
        };
        let ok_dst = try self.new_temp_place(final_ok_ty, sp);
        let src_op = if self.env.is_linear(final_ok_ty) {
            cfg_ir.op_move(eu_place)
        } else {
            cfg_ir.op_copy(eu_place)
        };
        try self.emit_assign(sp, ok_dst, cfg_ir.rvalue_unwrap_error_ok(src_op));
        return self.operand_for_place(ok_dst);
    }

    @recursive
    fn lower_catch_body(
        self: *mut Self,
        body_kind: ast.BodyKind,
        body_id: u32,
        dst_place_id: u32,
        sp: span.Span,
    ) -> !OutOfMemory {
        let dty = self.place_ty(dst_place_id);
        match body_kind {
            .Block => { try self.lower_block_into(body_id, true, dst_place_id, dty); }
            .Expr => { try self.lower_expr_into(body_id, dst_place_id, dty); }
            .Jump => { try self.lower_jump(body_id, sp); }
        }
        return;
    }

    @recursive
    fn lower_orelse(
        self: *mut Self,
        lhs_id: u32,
        rhs_kind: ast.BodyKind,
        rhs_id: u32,
        ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let opt_ty = try self.raw_ty_expr(lhs_id);
        let hint = if opt_ty != types.TY_ERROR { opt_ty } else { types.TY_NONE };
        let lop = try self.lower_expr_rvalue(lhs_id, hint);
        if !self.has_cur_bb {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        }
        let lsp = expr_span(self.arena, lhs_id);
        let actual_opt = self.operand_ty(lop);
        let opt_place = try self.new_temp_place(actual_opt, lsp);
        try self.emit_assign(lsp, opt_place, cfg_ir.rvalue_use(lop));

        let aon = self.env.get(actual_opt);
        let res_ty = if ty != types.TY_ERROR {
            ty
        } else if aon.kind == .Optional {
            aon.primary
        } else {
            types.TY_ERROR
        };
        let res_dst = try self.new_temp_place(res_ty, sp);
        let cond_dst = try self.new_temp_place(types.TY_BOOL, sp);
        try self.emit_assign(sp, cond_dst, cfg_ir.rvalue_is_non_null(cfg_ir.op_copy(opt_place)));

        let some_bb = try self.new_block();
        let none_bb = try self.new_block();
        let merge_bb = try self.new_block();
        let m_idx = merge_bb.widen.[usize]();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        if m_idx < bs_mut.len {
            bs_mut[m_idx].has_join_span = true;
            bs_mut[m_idx].join_span = sp;
        }
        self.set_term(cfg_ir.term_branch(cfg_ir.op_copy(cond_dst), some_bb, none_bb, sp, false));

        self.has_cur_bb = true;
        self.cur_bb = some_bb;
        let unwrap_src = if self.env.is_linear(res_ty) {
            cfg_ir.op_move(opt_place)
        } else {
            cfg_ir.op_copy(opt_place)
        };
        try self.emit_assign(sp, res_dst, cfg_ir.rvalue_unwrap_optional(unwrap_src));
        self.set_term(cfg_ir.term_goto(merge_bb));

        self.has_cur_bb = true;
        self.cur_bb = none_bb;
        try self.lower_catch_body(rhs_kind, rhs_id, res_dst, sp);
        if self.has_cur_bb {
            self.set_term(cfg_ir.term_goto(merge_bb));
        }

        self.has_cur_bb = true;
        self.cur_bb = merge_bb;
        return self.operand_for_place(res_dst);
    }

    @recursive
    fn lower_catch(
        self: *mut Self,
        lhs_id: u32,
        err_bind: ast.IdentSpan,
        rhs_kind: ast.BodyKind,
        rhs_id: u32,
        ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let eu_ty = try self.raw_ty_expr(lhs_id);
        let hint = if eu_ty != types.TY_ERROR { eu_ty } else { types.TY_NONE };
        let lop = try self.lower_expr_rvalue(lhs_id, hint);
        if !self.has_cur_bb {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        }
        let lsp = expr_span(self.arena, lhs_id);
        let actual_eu = self.operand_ty(lop);
        let eu_place = try self.new_temp_place(actual_eu, lsp);
        try self.emit_assign(lsp, eu_place, cfg_ir.rvalue_use(lop));

        let aen = self.env.get(actual_eu);
        let res_ty = if ty != types.TY_ERROR {
            ty
        } else if aen.kind == .ErrorUnion {
            aen.primary
        } else {
            types.TY_ERROR
        };
        let res_dst = try self.new_temp_place(res_ty, sp);
        let cond_dst = try self.new_temp_place(types.TY_BOOL, sp);
        try self.emit_assign(sp, cond_dst, cfg_ir.rvalue_is_error(cfg_ir.op_copy(eu_place)));

        let err_bb = try self.new_block();
        let ok_bb = try self.new_block();
        let merge_bb = try self.new_block();
        let m_idx = merge_bb.widen.[usize]();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        if m_idx < bs_mut.len {
            bs_mut[m_idx].has_join_span = true;
            bs_mut[m_idx].join_span = sp;
        }
        self.set_term(cfg_ir.term_branch(cfg_ir.op_copy(cond_dst), err_bb, ok_bb, sp, false));

        self.has_cur_bb = true;
        self.cur_bb = ok_bb;
        let unwrap_src = if self.env.is_linear(res_ty) {
            cfg_ir.op_move(eu_place)
        } else {
            cfg_ir.op_copy(eu_place)
        };
        try self.emit_assign(sp, res_dst, cfg_ir.rvalue_unwrap_error_ok(unwrap_src));
        self.set_term(cfg_ir.term_goto(merge_bb));

        self.has_cur_bb = true;
        self.cur_bb = err_bb;
        try self.push_scope();
        if ast.ident_is_some(err_bind) {
            var has_src = false;
            var src = types.err_src_builtin(.ArithError);
            if aen.kind == .ErrorUnion {
                let errs = self.env.node_err_src_list(&aen);
                if errs.len > 0_usize {
                    has_src = true;
                    src = errs[0_usize];
                }
            }
            let ety = if has_src {
                try self.env.intern_error_set(self.alloc, src)
            } else {
                try self.enclosing_err_set_ty()
            };
            let eloc = try self.bind_user_local(err_bind.sym, err_bind.span, ety, false);
            let dst = try self.cfg.add_local_place(self.alloc, eloc, self.local_ty(eloc), err_bind.span);
            try self.emit_assign(err_bind.span, dst, cfg_ir.rvalue_unwrap_error_err(cfg_ir.op_copy(eu_place)));
        }
        try self.lower_catch_body(rhs_kind, rhs_id, res_dst, sp);
        try self.pop_scope_normal();
        if self.has_cur_bb {
            self.set_term(cfg_ir.term_goto(merge_bb));
        }

        self.has_cur_bb = true;
        self.cur_bb = merge_bb;
        return self.operand_for_place(res_dst);
    }

    @recursive
    fn lower_ct_val(
        self: *mut Self,
        val_id: u32,
        ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let cv = self.ct.get_val(val_id);
        match cv.kind {
            .Void => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void()); }
            .Bool => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(cv.i_lo != 0_u64)); }
            .Char => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_char(cv.i_lo.trunc.[u32]())); }
            .Int => {
                let iv = types.IntVal.{ lo: cv.i_lo, hi: cv.i_hi.bitcast.[i64]() };
                let final_ty = if self.env.is_integer(ty) && ty != types.TY_COMPTIME_INT {
                    ty
                } else if self.env.is_integer(cv.ty) && cv.ty != types.TY_COMPTIME_INT {
                    cv.ty
                } else {
                    types.TY_USIZE
                };
                return try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(iv, final_ty));
            }
            .Float => {
                let final_ty = if self.env.is_float(ty) { ty } else { cv.ty };
                var fbuf = try str.StrBuf.init(self.alloc, 32_usize);
                errdefer fbuf.destroy(self.alloc);
                try format_f64_into(self.alloc, cv.i_lo.bitcast.[f64](), &mut fbuf);
                let op = try self.cfg.add_const_float_op(self.alloc, fbuf.as_bytes(), final_ty);
                fbuf.destroy(self.alloc);
                return op;
            }
            .Str => { return try self.cfg.add_const_str_op(self.alloc, self.ct.str_slice(val_id)); }
            .EnumSym => {
                let tv = types.IntVal.{ lo: cv.i_lo, hi: cv.i_hi.bitcast.[i64]() };
                return try self.cfg.add_const_op(self.alloc, cfg_ir.const_enum_tag(ty, cv.sym, tv));
            }
            .Array => {
                let n_elems = cv.range.len.widen.[usize]();
                var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_elems +% 1_usize);
                errdefer ops.destroy(self.alloc);
                var i: usize = 0_usize;
                while i < n_elems {
                    if let eid = ct_elem_at(self.ct, cv.range, i) {
                        try ops.push(self.alloc, try self.lower_ct_val(eid, cv.ty, sp));
                    }
                    i = i +% 1_usize;
                }
                let dst = try self.new_temp_place(ty, sp);
                let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_array(cv.ty));
                let er = try self.cfg.add_operands(self.alloc, ops.as_slice());
                try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
                ops.destroy(self.alloc);
                return self.operand_for_place(dst);
            }
            .Tuple => {
                var etys = try col.DynBuf.[types.TyId].init(self.alloc, 4_usize);
                errdefer etys.destroy(self.alloc);
                let tn = self.env.get(ty);
                if tn.kind == .Tuple {
                    try etys.push_slice(self.alloc, self.env.node_ty_list(&tn));
                }
                let n_elems = cv.range.len.widen.[usize]();
                var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_elems +% 1_usize);
                errdefer ops.destroy(self.alloc);
                let ets = etys.as_slice();
                var i: usize = 0_usize;
                while i < n_elems {
                    if let eid = ct_elem_at(self.ct, cv.range, i) {
                        let et = if i < ets.len { ets[i] } else { types.TY_ERROR };
                        try ops.push(self.alloc, try self.lower_ct_val(eid, et, sp));
                    }
                    i = i +% 1_usize;
                }
                let dst = try self.new_temp_place(ty, sp);
                let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_tuple());
                let er = try self.cfg.add_operands(self.alloc, ops.as_slice());
                try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
                ops.destroy(self.alloc);
                etys.destroy(self.alloc);
                return self.operand_for_place(dst);
            }
            .Struct => {
                let use_ty = if ty != types.TY_ERROR { ty } else { cv.ty };
                let tn = self.env.get(use_ty);
                if tn.kind == .AnonStruct {
                    var afs = try col.DynBuf.[types.AnonField].init(self.alloc, tn.list_len.widen.[usize]() +% 1_usize);
                    errdefer afs.destroy(self.alloc);
                    try afs.push_slice(self.alloc, self.env.node_anon_fields(&tn));
                    var names = try col.DynBuf.[u32].init(self.alloc, afs.len() +% 1_usize);
                    errdefer names.destroy(self.alloc);
                    var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, afs.len() +% 1_usize);
                    errdefer ops.destroy(self.alloc);
                    let fs = afs.as_slice();
                    var i: usize = 0_usize;
                    while i < fs.len {
                        try names.push(self.alloc, fs[i].name);
                        if let fv_id = self.ct.get_struct_field(val_id, fs[i].name) {
                            try ops.push(self.alloc, try self.lower_ct_val(fv_id, fs[i].ty, sp));
                        } else {
                            try ops.push(self.alloc, try self.cfg.add_const_op(self.alloc, cfg_ir.const_null(fs[i].ty)));
                        }
                        i = i +% 1_usize;
                    }
                    let dst = try self.new_temp_place(use_ty, sp);
                    let nr = try self.cfg.add_syms(self.alloc, names.as_slice());
                    let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_anon_struct(nr));
                    let er = try self.cfg.add_operands(self.alloc, ops.as_slice());
                    try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
                    ops.destroy(self.alloc);
                    names.destroy(self.alloc);
                    afs.destroy(self.alloc);
                    return self.operand_for_place(dst);
                }
                if tn.kind == .Struct {
                    let def_id = tn.primary;
                    var mfs = try col.DynBuf.[types.FieldMeta].init(self.alloc, 8_usize);
                    errdefer mfs.destroy(self.alloc);
                    if let sm = self.env.get_struct(def_id) {
                        try mfs.push_slice(self.alloc, self.env.struct_fields_range(sm.fields));
                    }
                    var ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, mfs.len() +% 1_usize);
                    errdefer ops.destroy(self.alloc);
                    let fs = mfs.as_slice();
                    var i: usize = 0_usize;
                    while i < fs.len {
                        if let fv_id = self.ct.get_struct_field(val_id, fs[i].name) {
                            try ops.push(self.alloc, try self.lower_ct_val(fv_id, fs[i].ty, sp));
                        } else {
                            try ops.push(self.alloc, try self.cfg.add_const_op(self.alloc, cfg_ir.const_null(fs[i].ty)));
                        }
                        i = i +% 1_usize;
                    }
                    let dst = try self.new_temp_place(use_ty, sp);
                    let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_struct(def_id));
                    let er = try self.cfg.add_operands(self.alloc, ops.as_slice());
                    try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
                    ops.destroy(self.alloc);
                    mfs.destroy(self.alloc);
                    return self.operand_for_place(dst);
                }
                return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
            }
            .TypeVal => { return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void()); }
        }
    }

    fn extract_static_idents(self: *Self, expr_id: u32, out: *mut col.DynBuf[u32]) -> bool ! OutOfMemory {
        out.clear();
        var cur = expr_id;
        loop {
            let e = self.arena.get_expr(cur) orelse {
                return false;
            };
            if e.kind == .Ident {
                if let _ = self.lookup_local(e.a) {
                    return false;
                }
                try out.push(self.alloc, e.a);
                break;
            }
            if e.kind == .Field {
                try out.push(self.alloc, e.ident.sym);
                cur = e.a;
            } else {
                return false;
            }
        }
        let s = out.as_mut_slice();
        var lo: usize = 0_usize;
        var hi: usize = if s.len > 0_usize { s.len - 1_usize } else { 0_usize };
        while lo < hi && hi < s.len {
            let tmp = s[lo];
            s[lo] = s[hi];
            s[hi] = tmp;
            lo = lo +% 1_usize;
            hi = hi - 1_usize;
        }
        return true;
    }

    fn prim_ty_by_name(self: *Self, sym: u32) -> ?types.TyId {
        let bs = self.interner.get(sym);
        if str.bytes_eq(bs, "u8".as_bytes()) { return types.TY_U8; }
        if str.bytes_eq(bs, "u16".as_bytes()) { return types.TY_U16; }
        if str.bytes_eq(bs, "u32".as_bytes()) { return types.TY_U32; }
        if str.bytes_eq(bs, "u64".as_bytes()) { return types.TY_U64; }
        if str.bytes_eq(bs, "u128".as_bytes()) { return types.TY_U128; }
        if str.bytes_eq(bs, "usize".as_bytes()) { return types.TY_USIZE; }
        if str.bytes_eq(bs, "i8".as_bytes()) { return types.TY_I8; }
        if str.bytes_eq(bs, "i16".as_bytes()) { return types.TY_I16; }
        if str.bytes_eq(bs, "i32".as_bytes()) { return types.TY_I32; }
        if str.bytes_eq(bs, "i64".as_bytes()) { return types.TY_I64; }
        if str.bytes_eq(bs, "i128".as_bytes()) { return types.TY_I128; }
        if str.bytes_eq(bs, "isize".as_bytes()) { return types.TY_ISIZE; }
        return null;
    }

    fn try_lower_assoc_const_or_enum(
        self: *mut Self,
        base_id: u32,
        field: ast.IdentSpan,
        fallback_ty: types.TyId,
    ) -> ?cfg_ir.CfgOperand ! OutOfMemory {
        var segs_buf = try col.DynBuf.[u32].init(self.alloc, 4_usize);
        errdefer segs_buf.destroy(self.alloc);
        let ok = try self.extract_static_idents(base_id, &mut segs_buf);
        if !ok {
            segs_buf.destroy(self.alloc);
            return null;
        }
        let segs = segs_buf.as_slice();
        if segs.len == 1_usize {
            let is_min = sym_is(self.interner, field.sym, "MIN");
            let is_max = sym_is(self.interner, field.sym, "MAX");
            if is_min || is_max {
                if let pt = self.prim_ty_by_name(segs[0_usize]) {
                    let b = types.int_bounds(self.env.get(pt));
                    if b.valid {
                        let v = if is_min { b.min } else { b.max };
                        let res = try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(v, pt));
                        segs_buf.destroy(self.alloc);
                        return res;
                    }
                }
            }
            if let entry = self.prog.lookup_in_module(self.module_id, segs[0_usize]) {
                if entry.kind == .Def {
                    if let meta = self.env.get_enum(entry.target_id) {
                        let vs = self.env.enum_variants_range(meta.variants);
                        var vi: usize = 0_usize;
                        while vi < vs.len {
                            if vs[vi].name == field.sym {
                                let tv = vs[vi].val;
                                let res = try self.cfg.add_const_op(
                                    self.alloc,
                                    cfg_ir.const_enum_tag(fallback_ty, field.sym, tv),
                                );
                                segs_buf.destroy(self.alloc);
                                return res;
                            }
                            vi = vi +% 1_usize;
                        }
                    }
                } else if entry.kind == .Module {
                    if let sub = self.prog.lookup_in_module(entry.target_id, field.sym) {
                        if sub.kind == .Def {
                            var is_c_or_fn = false;
                            if let _ = self.env.get_const(sub.target_id) {
                                is_c_or_fn = true;
                            } else if let _ = self.env.get_fn(sub.target_id) {
                                is_c_or_fn = true;
                            }
                            if is_c_or_fn {
                                let res = try self.lower_scope_target_const(sub, fallback_ty);
                                segs_buf.destroy(self.alloc);
                                return res;
                            }
                        }
                    }
                }
            }
        } else if segs.len == 2_usize {
            if let m_ent = self.prog.lookup_in_module(self.module_id, segs[0_usize]) {
                if m_ent.kind == .Module {
                    if let d_ent = self.prog.lookup_in_module(m_ent.target_id, segs[1_usize]) {
                        if d_ent.kind == .Def {
                            if let meta = self.env.get_enum(d_ent.target_id) {
                                let vs = self.env.enum_variants_range(meta.variants);
                                var vi: usize = 0_usize;
                                while vi < vs.len {
                                    if vs[vi].name == field.sym {
                                        let tv = vs[vi].val;
                                        let res = try self.cfg.add_const_op(
                                            self.alloc,
                                            cfg_ir.const_enum_tag(fallback_ty, field.sym, tv),
                                        );
                                        segs_buf.destroy(self.alloc);
                                        return res;
                                    }
                                    vi = vi +% 1_usize;
                                }
                            }
                        }
                    }
                }
            }
        }
        segs_buf.destroy(self.alloc);
        return null;
    }

    @recursive
    fn try_lower_len_field(self: *mut Self, base_id: u32, sp: span.Span) -> ?cfg_ir.CfgOperand ! OutOfMemory {
        let base_ty = try self.expr_ty(base_id, types.TY_ERROR);
        let bn = self.env.get(base_ty);
        let deref = if bn.kind == .Borrow && bn.borrow_kind == .Single { bn.primary } else { base_ty };
        let dn = self.env.get(deref);
        var has_op = false;
        var op_kind: cfg_ir.CfgBuiltinOpKind = .SliceLen;
        if bn.kind == .Borrow && bn.borrow_kind == .Slice {
            has_op = true;
            op_kind = .SliceLen;
        } else if (bn.kind == .Borrow && bn.borrow_kind == .Str) || bn.kind == .Str {
            has_op = true;
            op_kind = .StrLen;
        } else if dn.kind == .Array {
            has_op = true;
            op_kind = .ArrayLen;
        } else if dn.kind == .Builtin && dn.builtin_kind == .ArenaPool {
            has_op = true;
            op_kind = .ArenaPoolLen;
        } else if dn.kind == .Builtin && dn.builtin_kind == .SlotPool {
            has_op = true;
            op_kind = .SlotPoolLen;
        }
        if !has_op {
            return null;
        }
        var recv_op = cfg_ir.op_none();
        var has_rp = false;
        var rp = cfg_ir.CFG_NONE;
        if (op_kind == .ArrayLen || op_kind == .ArenaPoolLen || op_kind == .SlotPoolLen) && bn.kind != .Borrow {
            let p = try self.lower_place(base_id);
            recv_op = cfg_ir.op_copy(p);
            has_rp = true;
            rp = p;
        } else {
            let op_v = try self.lower_expr_rvalue(base_id, types.TY_NONE);
            recv_op = op_v;
            if let pid = cfg_ir.operand_place_id(op_v) {
                has_rp = true;
                rp = pid;
            }
        }
        let bsp = expr_span(self.arena, base_id);
        let dst_place = try self.new_temp_place(types.TY_USIZE, sp);
        let cargs: [1]cfg_ir.CfgOperand = [recv_op];
        let cspans: [1]span.Span = [bsp];
        let cid = try self.cfg.add_call_data(
            self.alloc,
            cfg_ir.callee_builtin(cfg_ir.builtin_op_simple(op_kind)),
            &cargs,
            &cspans,
            has_rp,
            rp,
            true,
            bsp,
            false,
            false,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, dst_place, cid));
        return cfg_ir.op_copy(dst_place);
    }

    fn lower_scope_target_const(
        self: *mut Self,
        target: resolve.ScopeEntry,
        expected_ty: types.TyId,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        if target.kind != .Def {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        }
        let d = target.target_id;
        if let c = self.env.get_const(d) {
            if c.has_int_val {
                return try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(c.int_val, c.ty));
            }
            if let cv_id = self.ct.get_const_val(d) {
                let cv = self.ct.get_val(cv_id);
                if cv.kind == .Bool {
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(cv.i_lo != 0_u64));
                }
                if cv.kind == .Str {
                    return try self.cfg.add_const_str_op(self.alloc, self.ct.str_slice(cv_id));
                }
                return try self.cfg.add_const_op(self.alloc, cfg_ir.const_def(d, c.ty));
            }
        }
        var has_fn = false;
        var sig_params_r = ast.range_empty();
        var sig_ret = types.TY_VOID;
        if let sig = self.env.get_fn(d) {
            has_fn = true;
            sig_params_r = sig.params;
            sig_ret = sig.ret;
        }
        if has_fn {
            var fn_ty = expected_ty;
            if self.env.get(expected_ty).kind != .FnPtr {
                let ps = self.env.params_range(sig_params_r);
                var ptys = try col.DynBuf.[types.TyId].init(self.alloc, ps.len +% 1_usize);
                errdefer ptys.destroy(self.alloc);
                var i: usize = 0_usize;
                while i < ps.len {
                    try ptys.push(self.alloc, ps[i].ty);
                    i = i +% 1_usize;
                }
                fn_ty = try self.env.intern_fn_ptr(self.alloc, ptys.as_slice(), sig_ret);
                ptys.destroy(self.alloc);
            }
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_fn_ref(d, fn_ty));
        }
        return try self.cfg.add_const_op(self.alloc, cfg_ir.const_null(expected_ty));
    }

    @recursive
    fn lower_enum_or_error_lit(
        self: *mut Self,
        v: ast.IdentSpan,
        ty: types.TyId,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let tn = self.env.get(ty);
        if tn.kind == .Enum {
            var tv = types.int_val_zero();
            if let meta = self.env.get_enum(tn.primary) {
                let vs = self.env.enum_variants_range(meta.variants);
                var i: usize = 0_usize;
                while i < vs.len {
                    if vs[i].name == v.sym {
                        tv = vs[i].val;
                        break;
                    }
                    i = i +% 1_usize;
                }
            }
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_enum_tag(ty, v.sym, tv));
        }
        if tn.kind == .Optional {
            let inner_op = try self.lower_enum_or_error_lit(v, tn.primary);
            return try self.coerce_operand(inner_op, ty, v.span);
        }
        if tn.kind == .ErrorSet {
            let tag_val = self.error_variant_tag(ty, v.sym);
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_error_tag(ty, v.sym, tag_val));
        }
        if tn.kind == .ErrorUnion {
            let errs = self.env.node_err_src_list(&tn);
            if self.env.error_sources_have_variant(errs, v.sym, self.interner) {
                let tag_val = self.error_variant_tag(ty, v.sym);
                return try self.cfg.add_const_op(self.alloc, cfg_ir.const_error_tag(ty, v.sym, tag_val));
            }
            let ok_op = try self.lower_enum_or_error_lit(v, tn.primary);
            return try self.coerce_operand(ok_op, ty, v.span);
        }
        if tn.kind == .Union {
            let vidx = self.variant_tag_index(ty, v.sym) orelse 0_u32;
            let dst = try self.new_temp_place(ty, v.span);
            let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_union_variant(tn.primary, vidx));
            try self.emit_assign(v.span, dst, cfg_ir.rvalue_aggregate(agg_id, ast.range_empty()));
            return self.operand_for_place(dst);
        }
        if tn.kind == .Builtin && tn.builtin_kind == .Ordering {
            let name = self.interner.get(v.sym);
            var tv: u64 = 4_u64;
            if str.bytes_eq(name, "Less".as_bytes()) || str.bytes_eq(name, "Relaxed".as_bytes()) {
                tv = 0_u64;
            } else if str.bytes_eq(name, "Equal".as_bytes()) || str.bytes_eq(name, "Acquire".as_bytes()) {
                tv = 1_u64;
            } else if str.bytes_eq(name, "Greater".as_bytes()) || str.bytes_eq(name, "Release".as_bytes()) {
                tv = 2_u64;
            } else if str.bytes_eq(name, "AcqRel".as_bytes()) {
                tv = 3_u64;
            }
            return try self.cfg.add_const_op(
                self.alloc,
                cfg_ir.const_enum_tag(ty, v.sym, types.int_val_from_u64(tv)),
            );
        }
        return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
    }

    fn variant_tag_index(self: *Self, ty: types.TyId, variant: u32) -> ?u32 {
        let tn = self.env.get(ty);
        if tn.kind == .Enum {
            if let meta = self.env.get_enum(tn.primary) {
                let vs = self.env.enum_variants_range(meta.variants);
                var i: usize = 0_usize;
                while i < vs.len {
                    if vs[i].name == variant {
                        return i.trunc.[u32]();
                    }
                    i = i +% 1_usize;
                }
            }
            return null;
        }
        if tn.kind == .Union {
            if let meta = self.env.get_union(tn.primary) {
                let vs = self.env.union_variants_range(meta.variants);
                var i: usize = 0_usize;
                while i < vs.len {
                    if vs[i].name == variant {
                        return i.trunc.[u32]();
                    }
                    i = i +% 1_usize;
                }
            }
            return null;
        }
        if tn.kind == .Builtin && tn.builtin_kind == .Ordering {
            if sym_is(self.interner, variant, "Less") { return 0_u32; }
            if sym_is(self.interner, variant, "Equal") { return 1_u32; }
            return 2_u32;
        }
        return null;
    }

    fn find_user_error_tag(self: *Self, srcs: *[types.ErrorSource], variant: u32) -> ?u32 {
        var i: usize = 0_usize;
        while i < srcs.len {
            if srcs[i].kind == .User {
                let d = srcs[i].def_id;
                if let meta = self.env.get_error(d) {
                    let vs = self.env.error_variants_range(meta.variants);
                    var vi: usize = 0_usize;
                    while vi < vs.len {
                        if vs[vi] == variant {
                            return 100_u32 +% (d *% 64_u32) +% vi.trunc.[u32]();
                        }
                        vi = vi +% 1_usize;
                    }
                }
            }
            i = i +% 1_usize;
        }
        return null;
    }

    fn error_variant_tag(self: *Self, ty: types.TyId, variant: u32) -> u32 {
        let name = self.interner.get(variant);
        if str.bytes_eq(name, "Overflow".as_bytes()) { return 1_u32; }
        if str.bytes_eq(name, "DivByZero".as_bytes()) { return 2_u32; }
        if str.bytes_eq(name, "Underflow".as_bytes()) { return 3_u32; }
        if str.bytes_eq(name, "OutOfBounds".as_bytes()) { return 4_u32; }
        if str.bytes_eq(name, "InvalidUtf8".as_bytes()) { return 5_u32; }
        if str.bytes_eq(name, "UnexpectedEof".as_bytes()) { return 6_u32; }
        if str.bytes_eq(name, "OutOfMemory".as_bytes()) { return 7_u32; }
        if str.bytes_eq(name, "InvalidSize".as_bytes()) { return 8_u32; }
        if str.bytes_eq(name, "BadAlignment".as_bytes()) { return 9_u32; }
        if str.bytes_eq(name, "AllocFailed".as_bytes()) { return 10_u32; }
        if str.bytes_eq(name, "StaleId".as_bytes()) { return 11_u32; }
        if str.bytes_eq(name, "NotFound".as_bytes()) { return 12_u32; }
        if str.bytes_eq(name, "PermissionDenied".as_bytes()) { return 13_u32; }
        if str.bytes_eq(name, "PathEscape".as_bytes()) { return 14_u32; }
        if str.bytes_eq(name, "AlreadyExists".as_bytes()) { return 15_u32; }
        if str.bytes_eq(name, "InvalidInput".as_bytes()) { return 16_u32; }
        if str.bytes_eq(name, "Other".as_bytes()) { return 17_u32; }

        let tn = self.env.get(ty);
        if tn.kind == .ErrorSet && !tn.flag0 {
            let one: [1]types.ErrorSource = [types.err_src_user(tn.primary)];
            if let tag = self.find_user_error_tag(&one, variant) {
                return tag;
            }
        } else if tn.kind == .ErrorUnion {
            if let tag = self.find_user_error_tag(self.env.node_err_src_list(&tn), variant) {
                return tag;
            }
        }
        let rn = self.env.get(self.sig.ret);
        if rn.kind == .ErrorUnion {
            if let tag = self.find_user_error_tag(self.env.node_err_src_list(&rn), variant) {
                return tag;
            }
        }
        return 99_u32;
    }

    @recursive
    fn eval_simple_const_int(self: *Self, expr_id: u32) -> ?types.IntVal {
        let e = self.arena.get_expr(expr_id) orelse {
            return null;
        };
        match e.kind {
            .IntLit => {
                let u = types.parse_int_literal_u128(self.interner.get(e.a)) orelse { return null; };
                if u.hi >= 0x8000000000000000_u64 {
                    return null;
                }
                return types.IntVal.{ lo: u.lo, hi: u.hi.bitcast.[i64]() };
            }
            .Paren => { return self.eval_simple_const_int(e.a); }
            .ComptimeExpr => { return self.eval_simple_const_int(e.a); }
            .Ident => {
                if let v = self.lookup_local_const(e.a) {
                    return v;
                }
                if let entry = self.prog.lookup_in_module(self.module_id, e.a) {
                    if entry.kind == .Def {
                        if let c = self.env.get_const(entry.target_id) {
                            if c.has_int_val {
                                return c.int_val;
                            }
                        }
                    }
                }
                return null;
            }
            .Field => {
                if let be = self.arena.get_expr(e.a) {
                    if be.kind == .Ident {
                        if let _ = self.lookup_local(be.a) {
                            return null;
                        }
                        if let m_ent = self.prog.lookup_in_module(self.module_id, be.a) {
                            if m_ent.kind == .Module {
                                if let d_ent = self.prog.lookup_in_module(m_ent.target_id, e.ident.sym) {
                                    if d_ent.kind == .Def {
                                        if let c = self.env.get_const(d_ent.target_id) {
                                            if c.has_int_val {
                                                return c.int_val;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                return null;
            }
            .Unary => {
                if e.unary_op == .Neg {
                    let v = self.eval_simple_const_int(e.a) orelse { return null; };
                    return types.int_val_checked_neg(v);
                }
                return null;
            }
            .Binary => {
                let l = self.eval_simple_const_int(e.a) orelse { return null; };
                let r = self.eval_simple_const_int(e.b) orelse { return null; };
                match e.bin_op {
                    .Add => { return types.int_val_checked_add(l, r); }
                    .AddWrap => { return types.int_val_checked_add(l, r); }
                    .AddCheck => { return types.int_val_checked_add(l, r); }
                    .Sub => { return types.int_val_checked_sub(l, r); }
                    .SubWrap => { return types.int_val_checked_sub(l, r); }
                    .SubCheck => { return types.int_val_checked_sub(l, r); }
                    .Mul => { return types.int_val_checked_mul(l, r); }
                    .MulWrap => { return types.int_val_checked_mul(l, r); }
                    .MulCheck => { return types.int_val_checked_mul(l, r); }
                    .Div => { return types.int_val_checked_div(l, r); }
                    .DivCheck => { return types.int_val_checked_div(l, r); }
                    .Mod => { return types.int_val_checked_rem(l, r); }
                    .ModCheck => { return types.int_val_checked_rem(l, r); }
                    _ => { return null; }
                }
                return null;
            }
            _ => { return null; }
        }
        return null;
    }

    @recursive
    fn lower_builtin_expr(
        self: *mut Self,
        expr_id: u32,
        name: ast.IdentSpan,
        args_range: ast.IdRange,
        ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let bs = self.interner.get(name.sym);
        let is_sqrt = str.bytes_eq(bs, "sqrt".as_bytes());
        let is_fma = str.bytes_eq(bs, "fma".as_bytes());
        let is_lzcnt = str.bytes_eq(bs, "lzcnt".as_bytes());
        let is_tzcnt = str.bytes_eq(bs, "tzcnt".as_bytes());
        let is_popcnt = str.bytes_eq(bs, "popcnt".as_bytes());
        let is_bswap = str.bytes_eq(bs, "bswap".as_bytes());
        if is_sqrt || is_fma || is_lzcnt || is_tzcnt || is_popcnt || is_bswap {
            let kind: cfg_ir.CfgBuiltinOpKind = if is_sqrt {
                .MathSqrt
            } else if is_fma {
                .MathFma
            } else if is_lzcnt {
                .MathLzcnt
            } else if is_tzcnt {
                .MathTzcnt
            } else if is_popcnt {
                .MathPopcnt
            } else {
                .MathBswap
            };
            let n_args = args_range.len.widen.[usize]();
            var cargs = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_args +% 1_usize);
            errdefer cargs.destroy(self.alloc);
            var arg_spans = try col.DynBuf.[span.Span].init(self.alloc, n_args +% 1_usize);
            errdefer arg_spans.destroy(self.alloc);
            var i: usize = 0_usize;
            while i < n_args {
                let ga = arena_generic_arg_at(self.arena, args_range, i) orelse { break; };
                if ga.kind == .Expr {
                    try cargs.push(self.alloc, try self.lower_expr_rvalue(ga.node_id, ty));
                    try arg_spans.push(self.alloc, ga.span);
                }
                i = i +% 1_usize;
            }
            let dst = try self.new_temp_place(ty, sp);
            let cid = try self.cfg.add_call_data(
                self.alloc,
                cfg_ir.callee_builtin(cfg_ir.builtin_op_ty(kind, ty)),
                cargs.as_slice(),
                arg_spans.as_slice(),
                false,
                cfg_ir.CFG_NONE,
                false,
                span.span_dummy(),
                false,
                false,
            );
            try self.push_stmt(cfg_ir.stmt_call(sp, dst, cid));
            arg_spans.destroy(self.alloc);
            cargs.destroy(self.alloc);
            return cfg_ir.op_copy(dst);
        }
        if str.bytes_eq(bs, "size_of".as_bytes()) || str.bytes_eq(bs, "align_of".as_bytes()) {
            let val = self.table.get_const_int(expr_id) orelse types.int_val_zero();
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_int(val, types.TY_USIZE));
        }
        if str.bytes_eq(bs, "type_info".as_bytes()) {
            if let cv_id = self.table.get_comptime_val(expr_id) {
                return try self.lower_ct_val(cv_id, ty, sp);
            }
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        }
        if str.bytes_eq(bs, "target_is_nostd".as_bytes()) {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_bool(self.env.target_spec.is_nostd));
        }
        let is_gid = str.bytes_eq(bs, "gpu_global_id".as_bytes());
        let is_lid = str.bytes_eq(bs, "gpu_local_id".as_bytes());
        let is_wid = str.bytes_eq(bs, "gpu_workgroup_id".as_bytes());
        if is_gid || is_lid || is_wid {
            let kind: cfg_ir.CfgBuiltinOpKind = if is_gid {
                .GpuGlobalId
            } else if is_lid {
                .GpuLocalId
            } else {
                .GpuWorkgroupId
            };
            let dst = try self.new_temp_place(ty, sp);
            let dummy_ops: [1]cfg_ir.CfgOperand = [cfg_ir.op_none()];
            let dummy_sps: [1]span.Span = [span.span_dummy()];
            let cid = try self.cfg.add_call_data(
                self.alloc,
                cfg_ir.callee_builtin(cfg_ir.builtin_op_simple(kind)),
                dummy_ops[0_usize..0_usize],
                dummy_sps[0_usize..0_usize],
                false,
                cfg_ir.CFG_NONE,
                false,
                span.span_dummy(),
                false,
                false,
            );
            try self.push_stmt(cfg_ir.stmt_call(sp, dst, cid));
            return cfg_ir.op_copy(dst);
        }
        if str.bytes_eq(bs, "gpu_vertex_index".as_bytes())
            || str.bytes_eq(bs, "gpu_instance_index".as_bytes())
            || str.bytes_eq(bs, "gpu_frag_coord".as_bytes())
        {
            let kind: cfg_ir.CfgBuiltinOpKind = if str.bytes_eq(bs, "gpu_vertex_index".as_bytes()) {
                .GpuVertexIndex
            } else if str.bytes_eq(bs, "gpu_instance_index".as_bytes()) {
                .GpuInstanceIndex
            } else {
                .GpuFragCoord
            };
            let dst = try self.new_temp_place(ty, sp);
            let dummy_ops: [1]cfg_ir.CfgOperand = [cfg_ir.op_none()];
            let dummy_sps: [1]span.Span = [span.span_dummy()];
            let cid = try self.cfg.add_call_data(
                self.alloc,
                cfg_ir.callee_builtin(cfg_ir.builtin_op_simple(kind)),
                dummy_ops[0_usize..0_usize],
                dummy_sps[0_usize..0_usize],
                false,
                cfg_ir.CFG_NONE,
                false,
                span.span_dummy(),
                false,
                false,
            );
            try self.push_stmt(cfg_ir.stmt_call(sp, dst, cid));
            return cfg_ir.op_copy(dst);
        }
        if str.bytes_eq(bs, "gpu_workgroup_barrier".as_bytes()) || str.bytes_eq(bs, "gpu_discard".as_bytes()) {
            let kind: cfg_ir.CfgBuiltinOpKind = if str.bytes_eq(bs, "gpu_discard".as_bytes()) {
                .GpuDiscard
            } else {
                .GpuWorkgroupBarrier
            };
            let dummy_ops: [1]cfg_ir.CfgOperand = [cfg_ir.op_none()];
            let dummy_sps: [1]span.Span = [span.span_dummy()];
            let cid = try self.cfg.add_call_data(
                self.alloc,
                cfg_ir.callee_builtin(cfg_ir.builtin_op_simple(kind)),
                dummy_ops[0_usize..0_usize],
                dummy_sps[0_usize..0_usize],
                false,
                cfg_ir.CFG_NONE,
                false,
                span.span_dummy(),
                false,
                false,
            );
            try self.push_stmt(cfg_ir.stmt_call(sp, cfg_ir.CFG_NONE, cid));
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        }
        if str.bytes_eq(bs, "embed_gpu_spirv".as_bytes()) || str.bytes_eq(bs, "embed_gpu_msl".as_bytes()) {
            var target_sym = span.SYM_EMPTY;
            if let iv = self.table.get_const_int(expr_id) {
                target_sym = iv.lo.trunc.[u32]();
            } else if let ga0 = arena_generic_arg_at(self.arena, args_range, 0_usize) {
                if ga0.kind == .Expr {
                    if let ae = self.arena.get_expr(ga0.node_id) {
                        if ae.kind == .Ident {
                            target_sym = ae.a;
                        } else if ae.kind == .Field {
                            target_sym = ae.ident.sym;
                        }
                    }
                }
            }
            var bop = cfg_ir.builtin_op_simple(
                if str.bytes_eq(bs, "embed_gpu_spirv".as_bytes()) { .EmbedGpuSpirv } else { .EmbedGpuMsl },
            );
            bop.sym = target_sym;
            let dst = try self.new_temp_place(ty, sp);
            let dummy_ops: [1]cfg_ir.CfgOperand = [cfg_ir.op_none()];
            let dummy_sps: [1]span.Span = [span.span_dummy()];
            let cid = try self.cfg.add_call_data(
                self.alloc,
                cfg_ir.callee_builtin(bop),
                dummy_ops[0_usize..0_usize],
                dummy_sps[0_usize..0_usize],
                false,
                cfg_ir.CFG_NONE,
                false,
                span.span_dummy(),
                false,
                false,
            );
            try self.push_stmt(cfg_ir.stmt_call(sp, dst, cid));
            return cfg_ir.op_copy(dst);
        }
        let gm_op = match_gpu_math_builtin(bs);
        if gm_op.matched {
            let n_args = args_range.len.widen.[usize]();
            var cargs = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_args +% 1_usize);
            errdefer cargs.destroy(self.alloc);
            var arg_spans = try col.DynBuf.[span.Span].init(self.alloc, n_args +% 1_usize);
            errdefer arg_spans.destroy(self.alloc);
            var gi: usize = 0_usize;
            while gi < n_args {
                let ga = arena_generic_arg_at(self.arena, args_range, gi) orelse { break; };
                if ga.kind == .Expr {
                    let hint = if gm_op.kind == .GpuMath1 && gm_op.sub == 8_u8 {
                        types.TY_NONE
                    } else if gm_op.kind == .GpuMath2 && gm_op.sub == 3_u8 {
                        types.TY_NONE
                    } else {
                        ty
                    };
                    try cargs.push(self.alloc, try self.lower_expr_rvalue(ga.node_id, hint));
                    try arg_spans.push(self.alloc, ga.span);
                }
                gi = gi +% 1_usize;
            }
            var bop = cfg_ir.builtin_op_len(gm_op.kind, gm_op.sub);
            bop.ty0 = ty;
            let dst = try self.new_temp_place(ty, sp);
            let cid = try self.cfg.add_call_data(
                self.alloc,
                cfg_ir.callee_builtin(bop),
                cargs.as_slice(),
                arg_spans.as_slice(),
                false,
                cfg_ir.CFG_NONE,
                false,
                span.span_dummy(),
                false,
                false,
            );
            try self.push_stmt(cfg_ir.stmt_call(sp, dst, cid));
            arg_spans.destroy(self.alloc);
            cargs.destroy(self.alloc);
            return cfg_ir.op_copy(dst);
        }
        return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
    }
}

struct GpuMathMatch {
    matched: bool;
    kind: cfg_ir.CfgBuiltinOpKind;
    sub: u8;
}

fn match_gpu_math_builtin(bs: *[u8]) -> GpuMathMatch {
    if str.bytes_eq(bs, "gpu_abs".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath1, sub: 0_u8 }; }
    if str.bytes_eq(bs, "gpu_floor".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath1, sub: 1_u8 }; }
    if str.bytes_eq(bs, "gpu_ceil".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath1, sub: 2_u8 }; }
    if str.bytes_eq(bs, "gpu_fract".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath1, sub: 3_u8 }; }
    if str.bytes_eq(bs, "gpu_exp".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath1, sub: 4_u8 }; }
    if str.bytes_eq(bs, "gpu_sin".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath1, sub: 5_u8 }; }
    if str.bytes_eq(bs, "gpu_cos".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath1, sub: 6_u8 }; }
    if str.bytes_eq(bs, "gpu_sqrt".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath1, sub: 7_u8 }; }
    if str.bytes_eq(bs, "gpu_length".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath1, sub: 8_u8 }; }
    if str.bytes_eq(bs, "gpu_normalize".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath1, sub: 9_u8 }; }
    if str.bytes_eq(bs, "gpu_min".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath2, sub: 0_u8 }; }
    if str.bytes_eq(bs, "gpu_max".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath2, sub: 1_u8 }; }
    if str.bytes_eq(bs, "gpu_pow".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath2, sub: 2_u8 }; }
    if str.bytes_eq(bs, "gpu_dot".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath2, sub: 3_u8 }; }
    if str.bytes_eq(bs, "gpu_step".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath2, sub: 4_u8 }; }
    if str.bytes_eq(bs, "gpu_clamp".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath3, sub: 0_u8 }; }
    if str.bytes_eq(bs, "gpu_mix".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath3, sub: 1_u8 }; }
    if str.bytes_eq(bs, "gpu_smoothstep".as_bytes()) { return GpuMathMatch.{ matched: true, kind: .GpuMath3, sub: 2_u8 }; }
    return GpuMathMatch.{ matched: false, kind: .GpuMath1, sub: 0_u8 };
}

// ===========================================================================
// Section 5: Calls, Builtin Methods (All 116 Ops), Buf.drain & Schedule.build
// ===========================================================================

struct BuiltinMethodMatch {
    matched: bool;
    op: cfg_ir.CfgBuiltinOp;
    is_mut_recv: bool;
    consumes_recv: bool;
}

struct FoundImplMethod {
    found: bool;
    impl_idx: u32;
    sub_idx: u32;
    sig: types.FnSig;
}

struct DirectCalleeInfo {
    callee: cfg_ir.CfgCallee;
    has_sig: bool;
    is_view: bool;
    sig_ret: types.TyId;
    from_fn_ptr: bool;
    fn_ptr_ty: types.TyId;
    sig_params_range: ast.IdRange;
}

struct SchedEdge {
    u: u32;
    v: u32;
}

fn no_builtin_match() -> BuiltinMethodMatch {
    return BuiltinMethodMatch.{
        matched: false,
        op: cfg_ir.builtin_op_simple(.ArenaInit),
        is_mut_recv: false,
        consumes_recv: false,
    };
}

fn mk_bmatch(op: cfg_ir.CfgBuiltinOp, is_mut: bool, consumes: bool) -> BuiltinMethodMatch {
    return BuiltinMethodMatch.{
        matched: true,
        op: op,
        is_mut_recv: is_mut,
        consumes_recv: consumes,
    };
}

fn is_vec_builtin_op(k: cfg_ir.CfgBuiltinOpKind) -> bool {
    return k == .VecLen || k == .VecCmp || k == .VecMaskAny || k == .VecMaskAll
        || k == .VecBitmask || k == .VecSelect || k == .VecMin || k == .VecMax
        || k == .VecFma || k == .VecReduceAdd || k == .VecReduceMin || k == .VecReduceMax
        || k == .VecDot || k == .VecShuffle;
}

fn is_borrow_on_proj_builtin(bk: resolve.BuiltinKind) -> bool {
    return bk == .Arena || bk == .ArenaPool || bk == .SlotPool || bk == .Buf
        || bk == .LinearBuf || bk == .Atomic || bk == .MmioReg;
}

fn is_cap_builtin(bk: resolve.BuiltinKind) -> bool {
    return bk == .AllocCap || bk == .ArgsCap || bk == .BuildCap || bk == .FsCap
        || bk == .DirCap || bk == .NetCap || bk == .ClockCap || bk == .IoCap;
}

impl CfgBuilder {
    fn extract_first_type_arg(self: *Self, ty: types.TyId) -> types.TyId {
        let n = self.env.get(ty);
        if n.kind == .Builtin {
            let gs = self.env.node_gval_list(&n);
            if gs.len > 0_usize && gs[0_usize].kind == .Ty {
                return gs[0_usize].id;
            }
            return types.TY_U64;
        }
        if n.kind == .RawPtr {
            return n.primary;
        }
        return types.TY_U64;
    }

    fn extract_builtin_assoc_kind(self: *Self, expr_id: u32) -> ?resolve.BuiltinKind {
        let e0 = self.arena.get_expr(expr_id) orelse { return null; };
        let base_id = if e0.kind == .GenericApply { e0.a } else { expr_id };
        let be = self.arena.get_expr(base_id) orelse { return null; };
        if be.kind != .Ident {
            return null;
        }
        if let _ = self.lookup_local(be.a) {
            return null;
        }
        if let entry = self.prog.lookup_in_module(self.module_id, be.a) {
            if entry.kind == .Builtin {
                return resolve.decode_builtin(entry.target_id).kind;
            }
        }
        return null;
    }

    fn is_module_or_type_static_path(self: *Self, expr_id: u32) -> bool {
        var cur = expr_id;
        var first_sym = span.SYM_EMPTY;
        loop {
            let e = self.arena.get_expr(cur) orelse {
                return false;
            };
            if e.kind == .Ident {
                first_sym = e.a;
                break;
            }
            if e.kind == .Field {
                cur = e.a;
            } else if e.kind == .GenericApply {
                cur = e.a;
            } else {
                return false;
            }
        }
        if let _ = self.lookup_local(first_sym) {
            return false;
        }
        if let _ = self.lookup_captured(first_sym) {
            return false;
        }
        if let _ = self.prog.lookup_in_module(self.module_id, first_sym) {
            return true;
        }
        return false;
    }

    fn find_method_entry(self: *Self, rty: types.TyId, name: u32) -> FoundImplMethod {
        let empty = FoundImplMethod.{
            found: false,
            impl_idx: 0_u32,
            sub_idx: 0_u32,
            sig: self.sig,
        };
        let rn = self.env.get(rty);
        let deref = if rn.kind == .Borrow && rn.borrow_kind == .Single { rn.primary } else { rty };
        let dn = self.env.get(deref);
        var has_target = false;
        var target = types.MethodTarget.{ kind: .Def, def_id: resolve.DEF_NONE, builtin: .Prim };
        if dn.kind == .Struct || dn.kind == .Pool || dn.kind == .Enum || dn.kind == .Union || dn.kind == .Bitfield {
            has_target = true;
            target = types.MethodTarget.{ kind: .Def, def_id: dn.primary, builtin: .Prim };
        } else if dn.kind == .Builtin {
            has_target = true;
            target = types.MethodTarget.{ kind: .Builtin, def_id: resolve.DEF_NONE, builtin: dn.builtin_kind };
        }
        if !has_target {
            return empty;
        }
        let impls = self.env.decls.impls.as_slice();
        var ii: usize = 0_usize;
        while ii < impls.len {
            if method_target_eq(impls[ii].target, target) {
                let ms = self.env.impl_methods_range(impls[ii].methods);
                var mi: usize = 0_usize;
                while mi < ms.len {
                    if ms[mi].sig.name == name {
                        return FoundImplMethod.{
                            found: true,
                            impl_idx: ii.trunc.[u32](),
                            sub_idx: ms[mi].sub_idx,
                            sig: ms[mi].sig,
                        };
                    }
                    mi = mi +% 1_usize;
                }
            }
            ii = ii +% 1_usize;
        }
        return empty;
    }

    @recursive
    fn resolve_static_expr_path(self: *Self, expr_id: u32) -> ?resolve.ScopeEntry {
        let e = self.arena.get_expr(expr_id) orelse { return null; };
        if e.kind == .Ident {
            if let _ = self.lookup_local(e.a) {
                return null;
            }
            if let _ = self.lookup_captured(e.a) {
                return null;
            }
            return self.prog.lookup_in_module(self.module_id, e.a);
        }
        if e.kind == .GenericApply {
            return self.resolve_static_expr_path(e.a);
        }
        if e.kind == .Field {
            let base_ent = self.resolve_static_expr_path(e.a) orelse { return null; };
            if base_ent.kind != .Module {
                return null;
            }
            return self.prog.lookup_export(base_ent.target_id, e.ident.sym);
        }
        return null;
    }

    @recursive
    fn resolve_direct_callee(self: *mut Self, callee_id: u32) -> DirectCalleeInfo ! OutOfMemory {
        let ce0 = self.arena.get_expr(callee_id) orelse {
            let v = try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
            return DirectCalleeInfo.{
                callee: cfg_ir.callee_fn_ptr(v),
                has_sig: false,
                is_view: false,
                sig_ret: types.TY_VOID,
                from_fn_ptr: false,
                fn_ptr_ty: types.TY_ERROR,
                sig_params_range: ast.range_empty(),
            };
        };
        let inner_id = if ce0.kind == .GenericApply { ce0.a } else { callee_id };
        if let ie = self.arena.get_expr(inner_id) {
            if ie.kind == .Ident {
                var is_loc = false;
                if let _ = self.lookup_local(ie.a) { is_loc = true; }
                if let _ = self.lookup_captured(ie.a) { is_loc = true; }
                if !is_loc {
                    if let entry = self.prog.lookup_in_module(self.module_id, ie.a) {
                        if entry.kind == .Def {
                            if let sig = self.env.get_fn(entry.target_id) {
                                let cal = if sig.is_extern {
                                    cfg_ir.callee_extern_fn(entry.target_id, sig.name)
                                } else {
                                    cfg_ir.callee_direct_fn(entry.target_id)
                                };
                                return DirectCalleeInfo.{
                                    callee: cal,
                                    has_sig: true,
                                    is_view: sig.is_view,
                                    sig_ret: sig.ret,
                                    from_fn_ptr: false,
                                    fn_ptr_ty: types.TY_ERROR,
                                    sig_params_range: sig.params,
                                };
                            }
                        }
                    }
                }
            } else if ie.kind == .Field {
                if let target = self.resolve_static_expr_path(ie.a) {
                    if target.kind == .Module {
                        if let exp = self.prog.lookup_export(target.target_id, ie.ident.sym) {
                            if exp.kind == .Def {
                                if let sig = self.env.get_fn(exp.target_id) {
                                    let cal = if sig.is_extern {
                                        cfg_ir.callee_extern_fn(exp.target_id, sig.name)
                                    } else {
                                        cfg_ir.callee_direct_fn(exp.target_id)
                                    };
                                    return DirectCalleeInfo.{
                                        callee: cal,
                                        has_sig: true,
                                        is_view: sig.is_view,
                                        sig_ret: sig.ret,
                                        from_fn_ptr: false,
                                        fn_ptr_ty: types.TY_ERROR,
                                        sig_params_range: sig.params,
                                    };
                                }
                            }
                        }
                    } else if target.kind == .Def {
                        let d = target.target_id;
                        let impls = self.env.decls.impls.as_slice();
                        var ii: usize = 0_usize;
                        while ii < impls.len {
                            if impls[ii].target.kind == .Def && impls[ii].target.def_id == d {
                                let ms = self.env.impl_methods_range(impls[ii].methods);
                                var mi: usize = 0_usize;
                                while mi < ms.len {
                                    if ms[mi].sig.name == ie.ident.sym {
                                        return DirectCalleeInfo.{
                                            callee: cfg_ir.callee_method(ii.trunc.[u32](), ms[mi].sub_idx, ms[mi].sig.is_view),
                                            has_sig: true,
                                            is_view: ms[mi].sig.is_view,
                                            sig_ret: ms[mi].sig.ret,
                                            from_fn_ptr: false,
                                            fn_ptr_ty: types.TY_ERROR,
                                            sig_params_range: ms[mi].sig.params,
                                        };
                                    }
                                    mi = mi +% 1_usize;
                                }
                            }
                            ii = ii +% 1_usize;
                        }
                    }
                }
            }
        }

        let op = try self.lower_expr_rvalue(inner_id, types.TY_NONE);
        let oty = self.operand_ty(op);
        let on = self.env.get(oty);
        if on.kind == .FnPtr {
            return DirectCalleeInfo.{
                callee: cfg_ir.callee_fn_ptr(op),
                has_sig: true,
                is_view: false,
                sig_ret: on.primary,
                from_fn_ptr: true,
                fn_ptr_ty: oty,
                sig_params_range: ast.range_empty(),
            };
        }
        return DirectCalleeInfo.{
            callee: cfg_ir.callee_fn_ptr(op),
            has_sig: false,
            is_view: false,
            sig_ret: types.TY_VOID,
            from_fn_ptr: false,
            fn_ptr_ty: types.TY_ERROR,
            sig_params_range: ast.range_empty(),
        };
    }

    fn match_builtin_method_seq_vec(
        self: *mut Self,
        rty: types.TyId,
        deref: types.TyId,
        mname_sym: u32,
        args_range: ast.IdRange,
    ) -> BuiltinMethodMatch ! OutOfMemory {
        let rn = self.env.get(rty);
        if rn.kind == .Borrow && rn.borrow_kind == .Slice {
            let el = rn.primary;
            if sym_is(self.interner, mname_sym, "len") { return mk_bmatch(cfg_ir.builtin_op_simple(.SliceLen), false, false); }
            if sym_is(self.interner, mname_sym, "as_str") && el == types.TY_U8 {
                return mk_bmatch(cfg_ir.builtin_op_simple(.BytesAsStr), false, false);
            }
            if sym_is(self.interner, mname_sym, "at") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.SliceAt, el, false), false, false); }
            if sym_is(self.interner, mname_sym, "at_mut") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.SliceAt, el, true), true, false); }
            if sym_is(self.interner, mname_sym, "get") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.SliceGet, el, false), false, false); }
            if sym_is(self.interner, mname_sym, "get_mut") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.SliceGet, el, true), true, false); }
            if sym_is(self.interner, mname_sym, "sub") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.SliceSub, el, false), false, false); }
            if sym_is(self.interner, mname_sym, "sub_mut") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.SliceSub, el, true), true, false); }
            if sym_is(self.interner, mname_sym, "par_reduce") {
                var op_sym = span.SYM_EMPTY;
                if let a0 = arena_expr_at(self.arena, args_range, 0_usize) {
                    if let ae = self.arena.get_expr(a0) {
                        if ae.kind == .EnumLit {
                            op_sym = ae.ident.sym;
                        }
                    }
                }
                return mk_bmatch(cfg_ir.builtin_op_par_reduce(el, op_sym), false, false);
            }
            return no_builtin_match();
        }
        let dn = self.env.get(deref);
        if (dn.kind == .Borrow && dn.borrow_kind == .Str) || dn.kind == .Str {
            if sym_is(self.interner, mname_sym, "len") { return mk_bmatch(cfg_ir.builtin_op_simple(.StrLen), false, false); }
            if sym_is(self.interner, mname_sym, "as_bytes") { return mk_bmatch(cfg_ir.builtin_op_simple(.StrAsBytes), false, false); }
            return no_builtin_match();
        }
        if dn.kind == .Array {
            let el = dn.primary;
            if sym_is(self.interner, mname_sym, "len") { return mk_bmatch(cfg_ir.builtin_op_simple(.ArrayLen), false, false); }
            if sym_is(self.interner, mname_sym, "at") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.ArrayAt, el, false), false, false); }
            if sym_is(self.interner, mname_sym, "at_mut") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.ArrayAt, el, true), true, false); }
            if sym_is(self.interner, mname_sym, "get") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.ArrayGet, el, false), false, false); }
            if sym_is(self.interner, mname_sym, "get_mut") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.ArrayGet, el, true), true, false); }
            if sym_is(self.interner, mname_sym, "sub") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.ArraySub, el, false), false, false); }
            if sym_is(self.interner, mname_sym, "sub_mut") { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.ArraySub, el, true), true, false); }
            return no_builtin_match();
        }
        if dn.kind == .Vec {
            let vlen = dn.u8_val;
            if sym_is(self.interner, mname_sym, "len") { return mk_bmatch(cfg_ir.builtin_op_len(.VecLen, vlen), false, false); }
            if sym_is(self.interner, mname_sym, "cmpeq") { return mk_bmatch(cfg_ir.builtin_op_vec_cmp(.Eq, deref), false, false); }
            if sym_is(self.interner, mname_sym, "cmpne") { return mk_bmatch(cfg_ir.builtin_op_vec_cmp(.NotEq, deref), false, false); }
            if sym_is(self.interner, mname_sym, "cmplt") { return mk_bmatch(cfg_ir.builtin_op_vec_cmp(.Lt, deref), false, false); }
            if sym_is(self.interner, mname_sym, "cmple") { return mk_bmatch(cfg_ir.builtin_op_vec_cmp(.LtEq, deref), false, false); }
            if sym_is(self.interner, mname_sym, "cmpgt") { return mk_bmatch(cfg_ir.builtin_op_vec_cmp(.Gt, deref), false, false); }
            if sym_is(self.interner, mname_sym, "cmpge") { return mk_bmatch(cfg_ir.builtin_op_vec_cmp(.GtEq, deref), false, false); }
            if sym_is(self.interner, mname_sym, "any") { return mk_bmatch(cfg_ir.builtin_op_len(.VecMaskAny, vlen), false, false); }
            if sym_is(self.interner, mname_sym, "all") { return mk_bmatch(cfg_ir.builtin_op_len(.VecMaskAll, vlen), false, false); }
            if sym_is(self.interner, mname_sym, "bitmask") { return mk_bmatch(cfg_ir.builtin_op_len(.VecBitmask, vlen), false, false); }
            if sym_is(self.interner, mname_sym, "select") {
                var vty = types.TY_ERROR;
                if let a0 = arena_expr_at(self.arena, args_range, 0_usize) {
                    vty = try self.expr_ty(a0, types.TY_ERROR);
                }
                return mk_bmatch(cfg_ir.builtin_op_ty(.VecSelect, vty), false, false);
            }
            if sym_is(self.interner, mname_sym, "min") { return mk_bmatch(cfg_ir.builtin_op_ty(.VecMin, deref), false, false); }
            if sym_is(self.interner, mname_sym, "max") { return mk_bmatch(cfg_ir.builtin_op_ty(.VecMax, deref), false, false); }
            if sym_is(self.interner, mname_sym, "fma") { return mk_bmatch(cfg_ir.builtin_op_ty(.VecFma, deref), false, false); }
            if sym_is(self.interner, mname_sym, "reduce_add") { return mk_bmatch(cfg_ir.builtin_op_ty(.VecReduceAdd, deref), false, false); }
            if sym_is(self.interner, mname_sym, "reduce_min") { return mk_bmatch(cfg_ir.builtin_op_ty(.VecReduceMin, deref), false, false); }
            if sym_is(self.interner, mname_sym, "reduce_max") { return mk_bmatch(cfg_ir.builtin_op_ty(.VecReduceMax, deref), false, false); }
            if sym_is(self.interner, mname_sym, "dot") { return mk_bmatch(cfg_ir.builtin_op_ty(.VecDot, deref), false, false); }
            if sym_is(self.interner, mname_sym, "shuffle") {
                let two_src = args_range.len == 2_u32;
                var idx_ty = types.TY_ERROR;
                if two_src {
                    if let a1 = arena_expr_at(self.arena, args_range, 1_usize) {
                        idx_ty = try self.expr_ty(a1, types.TY_ERROR);
                    }
                } else {
                    if let a0 = arena_expr_at(self.arena, args_range, 0_usize) {
                        idx_ty = try self.expr_ty(a0, types.TY_ERROR);
                    }
                }
                return mk_bmatch(cfg_ir.builtin_op_vec_shuffle(deref, idx_ty, two_src), false, false);
            }
            return no_builtin_match();
        }
        return no_builtin_match();
    }

    fn match_builtin_method_caps(self: *Self, bk: resolve.BuiltinKind, mname: *[u8]) -> BuiltinMethodMatch {
        _ = self;
        match bk {
            .Arena => {
                if str.bytes_eq(mname, "alloc".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.ArenaAlloc), true, false); }
                if str.bytes_eq(mname, "reset".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.ArenaReset), true, false); }
                if str.bytes_eq(mname, "destroy".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.ArenaDestroy), true, true); }
                if str.bytes_eq(mname, "used_bytes".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.ArenaUsedBytes), false, false); }
                if str.bytes_eq(mname, "capacity".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.ArenaCapacity), false, false); }
            }
            .AllocCap => {
                if str.bytes_eq(mname, "live_allocs".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.AllocCapLiveAllocs), false, false); }
                if str.bytes_eq(mname, "used_bytes".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.AllocCapUsedBytes), false, false); }
                if str.bytes_eq(mname, "peak_bytes".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.AllocCapPeakBytes), false, false); }
                if str.bytes_eq(mname, "sub_budget".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.AllocCapSubBudget), true, false); }
            }
            .ClockCap => {
                if str.bytes_eq(mname, "now_ns".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.ClockNowNs), false, false); }
            }
            .ArgsCap => {
                if str.bytes_eq(mname, "len".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.ArgsLen), false, false); }
                if str.bytes_eq(mname, "get".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.ArgsGet), false, false); }
            }
            .FsCap => {
                if str.bytes_eq(mname, "open_dir".as_bytes()) || str.bytes_eq(mname, "sub_dir".as_bytes()) {
                    return mk_bmatch(cfg_ir.builtin_op_simple(.FsOpenDir), false, false);
                }
                if str.bytes_eq(mname, "read_file".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.FsReadFile), false, false); }
                if str.bytes_eq(mname, "write_file".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.FsWriteFile), false, false); }
                if str.bytes_eq(mname, "write_executable".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.FsWriteExecutable), false, false); }
                if str.bytes_eq(mname, "is_dir".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.FsIsDir), false, false); }
                if str.bytes_eq(mname, "mkdir_all".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.FsMkdirAll), false, false); }
                if str.bytes_eq(mname, "list_dir".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.FsListDir), false, false); }
                if str.bytes_eq(mname, "spawn_wait".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.FsSpawnWait), false, false); }
            }
            .DirCap => {
                if str.bytes_eq(mname, "sub_dir".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.DirSubDir), false, false); }
                if str.bytes_eq(mname, "read_file".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.DirReadFile), false, false); }
                if str.bytes_eq(mname, "write_file".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.DirWriteFile), false, false); }
                if str.bytes_eq(mname, "close".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.DirClose), true, true); }
            }
            .NetCap => {
                if str.bytes_eq(mname, "restrict_host".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.NetRestrictHost), false, false); }
            }
            .IoCap => {
                if str.bytes_eq(mname, "nop_roundtrip".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.IoNopRoundtrip), false, false); }
                if str.bytes_eq(mname, "run_fibers".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.IoRunFibers), false, false); }
            }
            .BuildCap => {
                if str.bytes_eq(mname, "add_module".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BuildAddModule), true, false); }
                if str.bytes_eq(mname, "add_exe".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BuildAddExe), true, false); }
                if str.bytes_eq(mname, "add_shared_lib".as_bytes()) || str.bytes_eq(mname, "add_shared".as_bytes()) {
                    return mk_bmatch(cfg_ir.builtin_op_simple(.BuildAddSharedLib), true, false);
                }
                if str.bytes_eq(mname, "add_dep".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BuildAddDep), true, false); }
                if str.bytes_eq(mname, "add_lib".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BuildAddLib), true, false); }
                if str.bytes_eq(mname, "set_out_dir".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BuildSetOutDir), true, false); }
                if str.bytes_eq(mname, "set_sanitize".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BuildSetSanitize), true, false); }
                if str.bytes_eq(mname, "set_audit_tcb".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BuildSetAuditTcb), true, false); }
                if str.bytes_eq(mname, "set_opt_level".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BuildSetOptLevel), true, false); }
                if str.bytes_eq(mname, "link_lib".as_bytes()) || str.bytes_eq(mname, "add_needed_lib".as_bytes()) {
                    return mk_bmatch(cfg_ir.builtin_op_simple(.BuildLinkLib), true, false);
                }
                if str.bytes_eq(mname, "allow_hal".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BuildAllowHal), true, false); }
                if str.bytes_eq(mname, "out_path".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BuildOutPath), false, false); }
            }
            .Schedule => {
                if str.bytes_eq(mname, "run".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.ScheduleRun), false, false); }
            }
            _ => {}
        }
        return no_builtin_match();
    }

    fn match_builtin_method_pools(self: *Self, dn: *types.TyNode, mname: *[u8]) -> BuiltinMethodMatch {
        let gs = self.env.node_gval_list(dn);
        let first_ty = if gs.len > 0_usize && gs[0_usize].kind == .Ty { gs[0_usize].id } else { types.TY_ERROR };
        match dn.builtin_kind {
            .ArenaPool => {
                if str.bytes_eq(mname, "push".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.ArenaPoolPush, first_ty), true, false); }
                if str.bytes_eq(mname, "id_at".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.ArenaPoolIdAt, first_ty), false, false); }
                if str.bytes_eq(mname, "reset".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.ArenaPoolReset, first_ty), true, false); }
                if str.bytes_eq(mname, "len".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.ArenaPoolLen), false, false); }
            }
            .SlotPool => {
                if str.bytes_eq(mname, "insert".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.SlotPoolInsert, first_ty), true, false); }
                if str.bytes_eq(mname, "try_insert".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.SlotPoolTryInsert, first_ty), true, false); }
                if str.bytes_eq(mname, "remove".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.SlotPoolRemove, first_ty), true, false); }
                if str.bytes_eq(mname, "get".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.SlotPoolGet, first_ty, false), false, false); }
                if str.bytes_eq(mname, "get_mut".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.SlotPoolGet, first_ty, true), true, false); }
                if str.bytes_eq(mname, "at".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.SlotPoolAt, first_ty), false, false); }
                if str.bytes_eq(mname, "len".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.SlotPoolLen), false, false); }
                if str.bytes_eq(mname, "cap".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.SlotPoolCap), false, false); }
                if str.bytes_eq(mname, "is_alive".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.SlotPoolIsAlive, first_ty), false, false); }
                if str.bytes_eq(mname, "id_at".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.SlotPoolIdAt, first_ty), false, false); }
                if str.bytes_eq(mname, "destroy".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.SlotPoolDestroy, first_ty), true, true); }
            }
            .Buf => {
                return self.match_builtin_method_buf(first_ty, mname);
            }
            .LinearBuf => {
                return self.match_builtin_method_buf(first_ty, mname);
            }
            .Atomic => {
                let elem = if first_ty != types.TY_ERROR { first_ty } else { types.TY_U64 };
                if str.bytes_eq(mname, "load".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.AtomicLoad, elem), false, false); }
                if str.bytes_eq(mname, "store".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.AtomicStore, elem), false, false); }
                if str.bytes_eq(mname, "fetch_add".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.AtomicFetchAdd, elem), false, false); }
                if str.bytes_eq(mname, "fetch_sub".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.AtomicFetchSub, elem), false, false); }
                if str.bytes_eq(mname, "swap".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.AtomicSwap, elem), false, false); }
                if str.bytes_eq(mname, "compare_exchange".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.AtomicCas, elem), false, false); }
            }
            .MmioReg => {
                let elem = if first_ty != types.TY_ERROR { first_ty } else { types.TY_U32 };
                if str.bytes_eq(mname, "read".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.MmioRead, elem), false, false); }
                if str.bytes_eq(mname, "write".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.MmioWrite, elem), true, false); }
            }
            .GpuImage2D => {
                let elem = if first_ty != types.TY_ERROR { first_ty } else { types.TY_U32 };
                if str.bytes_eq(mname, "load".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.GpuImageLoad, elem), false, false); }
                if str.bytes_eq(mname, "store".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.GpuImageStore, elem), false, false); }
                if str.bytes_eq(mname, "sample".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.GpuImageSample, elem), false, false); }
            }
            _ => {}
        }
        return no_builtin_match();
    }

    fn match_builtin_method_buf(self: *Self, elem: types.TyId, mname: *[u8]) -> BuiltinMethodMatch {
        _ = self;
        if str.bytes_eq(mname, "push".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.BufPush, elem), true, false); }
        if str.bytes_eq(mname, "push_slice".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.BufPushSlice, elem), true, false); }
        if str.bytes_eq(mname, "pop".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.BufPop, elem), true, false); }
        if str.bytes_eq(mname, "len".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BufLen), false, false); }
        if str.bytes_eq(mname, "cap".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BufCap), false, false); }
        if str.bytes_eq(mname, "clear".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_simple(.BufClear), true, false); }
        if str.bytes_eq(mname, "as_slice".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.BufAsSlice, elem, false), false, false); }
        if str.bytes_eq(mname, "as_mut_slice".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.BufAsSlice, elem, true), true, false); }
        if str.bytes_eq(mname, "at".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.BufAt, elem, false), false, false); }
        if str.bytes_eq(mname, "at_mut".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.BufAt, elem, true), true, false); }
        if str.bytes_eq(mname, "get".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.BufGet, elem, false), false, false); }
        if str.bytes_eq(mname, "get_mut".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.BufGet, elem, true), true, false); }
        if str.bytes_eq(mname, "sub".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.BufSub, elem, false), false, false); }
        if str.bytes_eq(mname, "sub_mut".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty_mut(.BufSub, elem, true), true, false); }
        if str.bytes_eq(mname, "destroy".as_bytes()) { return mk_bmatch(cfg_ir.builtin_op_ty(.BufDestroy, elem), true, true); }
        return no_builtin_match();
    }

    fn match_builtin_method(
        self: *mut Self,
        rty: types.TyId,
        mname_sym: u32,
        args_range: ast.IdRange,
    ) -> BuiltinMethodMatch ! OutOfMemory {
        let rn = self.env.get(rty);
        let deref = if rn.kind == .Borrow && rn.borrow_kind == .Single { rn.primary } else { rty };
        let m1 = try self.match_builtin_method_seq_vec(rty, deref, mname_sym, args_range);
        if m1.matched {
            return m1;
        }
        let dn = self.env.get(deref);
        if dn.kind != .Builtin {
            return no_builtin_match();
        }
        let mname = self.interner.get(mname_sym);
        let m2 = self.match_builtin_method_caps(dn.builtin_kind, mname);
        if m2.matched {
            return m2;
        }
        return self.match_builtin_method_pools(&dn, mname);
    }

    fn builtin_method_arg_hint(
        self: *mut Self,
        bop: *cfg_ir.CfgBuiltinOp,
        arg_idx: usize,
        total_args: usize,
    ) -> types.TyId ! OutOfMemory {
        match bop.kind {
            .ArenaAlloc => { return if arg_idx == 0_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .ArenaPoolIdAt => { return if arg_idx == 0_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .SlotPoolIsAlive => { return if arg_idx == 0_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .SlotPoolIdAt => { return if arg_idx == 0_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .SliceAt => { return if arg_idx == 0_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .ArrayAt => { return if arg_idx == 0_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .BufAt => { return if arg_idx == 0_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .SliceGet => { return if arg_idx == 0_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .ArrayGet => { return if arg_idx == 0_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .BufGet => { return if arg_idx == 0_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .SliceSub => { return if arg_idx < 2_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .ArraySub => { return if arg_idx < 2_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .BufSub => { return if arg_idx < 2_usize { types.TY_USIZE } else { types.TY_NONE }; }
            .ArenaPoolPush => { return if arg_idx == 0_usize { bop.ty0 } else { types.TY_NONE }; }
            .SlotPoolTryInsert => { return if arg_idx == 0_usize { bop.ty0 } else { types.TY_NONE }; }
            .SlotPoolInsert => {
                if total_args == 2_usize { return if arg_idx == 1_usize { bop.ty0 } else { types.TY_NONE }; }
                return if arg_idx == 0_usize { bop.ty0 } else { types.TY_NONE };
            }
            .BufPush => {
                if total_args == 2_usize { return if arg_idx == 1_usize { bop.ty0 } else { types.TY_NONE }; }
                return if arg_idx == 0_usize { bop.ty0 } else { types.TY_NONE };
            }
            .BufPushSlice => {
                let target_idx: usize = if total_args == 2_usize { 1_usize } else { 0_usize };
                if arg_idx == target_idx {
                    return try self.env.intern_borrow(self.alloc, false, .Slice, bop.ty0);
                }
                return types.TY_NONE;
            }
            .AtomicLoad => { return if arg_idx == 0_usize { types.TY_ORDERING } else { types.TY_NONE }; }
            .AtomicStore => { return if arg_idx == 0_usize { bop.ty0 } else if arg_idx == 1_usize { types.TY_ORDERING } else { types.TY_NONE }; }
            .AtomicFetchAdd => { return if arg_idx == 0_usize { bop.ty0 } else if arg_idx == 1_usize { types.TY_ORDERING } else { types.TY_NONE }; }
            .AtomicFetchSub => { return if arg_idx == 0_usize { bop.ty0 } else if arg_idx == 1_usize { types.TY_ORDERING } else { types.TY_NONE }; }
            .AtomicSwap => { return if arg_idx == 0_usize { bop.ty0 } else if arg_idx == 1_usize { types.TY_ORDERING } else { types.TY_NONE }; }
            .AtomicCas => {
                if arg_idx < 2_usize { return bop.ty0; }
                if arg_idx < 4_usize { return types.TY_ORDERING; }
                return types.TY_NONE;
            }
            .MmioWrite => { return if arg_idx == 0_usize { bop.ty0 } else { types.TY_NONE }; }
            .GpuImageLoad => { return if arg_idx == 0_usize { try self.env.intern_vec(self.alloc, types.TY_U32, 2_u8) } else { types.TY_NONE }; }
            .GpuImageStore => {
                if arg_idx == 0_usize { return try self.env.intern_vec(self.alloc, types.TY_U32, 2_u8); }
                if arg_idx == 1_usize { return bop.ty0; }
                return types.TY_NONE;
            }
            .GpuImageSample => { return if arg_idx == 0_usize { try self.env.intern_vec(self.alloc, types.TY_F32, 2_u8) } else { types.TY_NONE }; }
            .VecCmp => { return if arg_idx == 0_usize { bop.ty0 } else { types.TY_NONE }; }
            .VecMin => { return if arg_idx == 0_usize { bop.ty0 } else { types.TY_NONE }; }
            .VecMax => { return if arg_idx == 0_usize { bop.ty0 } else { types.TY_NONE }; }
            .VecDot => { return if arg_idx == 0_usize { bop.ty0 } else { types.TY_NONE }; }
            .VecFma => { return if arg_idx < 2_usize { bop.ty0 } else { types.TY_NONE }; }
            .VecSelect => { return if arg_idx < 2_usize { bop.ty0 } else { types.TY_NONE }; }
            .VecShuffle => {
                if bop.flag {
                    if arg_idx == 0_usize { return bop.ty0; }
                    if arg_idx == 1_usize { return bop.ty1; }
                } else if arg_idx == 0_usize {
                    return bop.ty1;
                }
                return types.TY_NONE;
            }
            .FsWriteExecutable => {
                if arg_idx == 0_usize { return try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID); }
                if arg_idx == 1_usize { return try self.env.intern_borrow(self.alloc, false, .Slice, types.TY_U8); }
                return types.TY_NONE;
            }
            .FsSpawnWait => {
                if arg_idx == 0_usize { return try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID); }
                if arg_idx == 1_usize { return try self.env.intern_borrow(self.alloc, false, .Slice, types.TY_U8); }
                return types.TY_NONE;
            }
            .FsIsDir => { return if arg_idx == 0_usize { try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID) } else { types.TY_NONE }; }
            .FsMkdirAll => { return if arg_idx == 0_usize { try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID) } else { types.TY_NONE }; }
            .FsListDir => { return if arg_idx == 1_usize { try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID) } else { types.TY_NONE }; }
            _ => { return types.TY_NONE; }
        }
    }

    @recursive
    fn lower_builtin_init_call(
        self: *mut Self,
        bk: resolve.BuiltinKind,
        ret_ty: types.TyId,
        args_range: ast.IdRange,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let n_args = args_range.len.widen.[usize]();
        var cargs = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_args +% 1_usize);
        errdefer cargs.destroy(self.alloc);
        var arg_spans = try col.DynBuf.[span.Span].init(self.alloc, n_args +% 1_usize);
        errdefer arg_spans.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < n_args {
            let aid = arena_expr_at(self.arena, args_range, i) orelse { break; };
            let hint = if i == 1_usize { types.TY_USIZE } else { types.TY_NONE };
            let op = try self.lower_expr_rvalue(aid, hint);
            let asp = expr_span(self.arena, aid);
            let cop = if i == 1_usize { try self.coerce_operand(op, types.TY_USIZE, asp) } else { op };
            try cargs.push(self.alloc, cop);
            try arg_spans.push(self.alloc, asp);
            i = i +% 1_usize;
        }
        let rn = self.env.get(ret_ty);
        let ok_ty = if rn.kind == .ErrorUnion { rn.primary } else { ret_ty };
        let okn = self.env.get(ok_ty);
        var elem_ty = types.TY_ERROR;
        if okn.kind == .Builtin {
            let gs = self.env.node_gval_list(&okn);
            if gs.len > 0_usize && gs[0_usize].kind == .Ty {
                elem_ty = gs[0_usize].id;
            }
        }
        let bop = if bk == .ArenaPool {
            cfg_ir.builtin_op_ty(.ArenaPoolInit, elem_ty)
        } else if bk == .SlotPool {
            cfg_ir.builtin_op_ty(.SlotPoolInit, elem_ty)
        } else if bk == .Buf || bk == .LinearBuf {
            cfg_ir.builtin_op_ty(.BufInit, elem_ty)
        } else {
            cfg_ir.builtin_op_simple(.ArenaInit)
        };
        let dst = try self.new_temp_place(ret_ty, sp);
        let cid = try self.cfg.add_call_data(
            self.alloc,
            cfg_ir.callee_builtin(bop),
            cargs.as_slice(),
            arg_spans.as_slice(),
            false,
            cfg_ir.CFG_NONE,
            false,
            span.span_dummy(),
            false,
            false,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, dst, cid));
        arg_spans.destroy(self.alloc);
        cargs.destroy(self.alloc);
        return self.operand_for_place(dst);
    }

    @recursive
    fn lower_builtin_assoc_op(
        self: *mut Self,
        bop: *cfg_ir.CfgBuiltinOp,
        ret_ty: types.TyId,
        args_range: ast.IdRange,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        var hint = types.TY_NONE;
        if bop.kind == .AtomicNew {
            hint = bop.ty0;
        } else if bop.kind == .RawPtrFromUsize {
            hint = types.TY_USIZE;
        } else if bop.kind == .VecSplat {
            let vn = self.env.get(bop.ty0);
            if vn.kind == .Vec {
                hint = vn.primary;
            }
        }
        let n_args = args_range.len.widen.[usize]();
        var cargs = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_args +% 1_usize);
        errdefer cargs.destroy(self.alloc);
        var arg_spans = try col.DynBuf.[span.Span].init(self.alloc, n_args +% 1_usize);
        errdefer arg_spans.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < n_args {
            let aid = arena_expr_at(self.arena, args_range, i) orelse { break; };
            let op = try self.lower_expr_rvalue(aid, hint);
            let asp = expr_span(self.arena, aid);
            let cop = if hint != types.TY_NONE { try self.coerce_operand(op, hint, asp) } else { op };
            try cargs.push(self.alloc, cop);
            try arg_spans.push(self.alloc, asp);
            i = i +% 1_usize;
        }
        let dst = try self.new_temp_place(ret_ty, sp);
        let cid = try self.cfg.add_call_data(
            self.alloc,
            cfg_ir.callee_builtin(bop.*),
            cargs.as_slice(),
            arg_spans.as_slice(),
            false,
            cfg_ir.CFG_NONE,
            false,
            span.span_dummy(),
            false,
            false,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, dst, cid));
        arg_spans.destroy(self.alloc);
        cargs.destroy(self.alloc);
        return self.operand_for_place(dst);
    }

    @recursive
    fn lower_builtin_method_call(
        self: *mut Self,
        bop: *cfg_ir.CfgBuiltinOp,
        rplace: u32,
        recv_span: span.Span,
        is_mut_recv: bool,
        consumes_recv: bool,
        args_range: ast.IdRange,
        ret_ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let n_args = args_range.len.widen.[usize]();
        var cargs = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_args +% 2_usize);
        errdefer cargs.destroy(self.alloc);
        var arg_spans = try col.DynBuf.[span.Span].init(self.alloc, n_args +% 2_usize);
        errdefer arg_spans.destroy(self.alloc);

        var created_recv_borrow = false;
        let rty = self.place_ty(rplace);
        let rn = self.env.get(rty);
        let has_projs = !self.cfg.place_is_local_only(rplace);
        let need_borrow = (has_projs && ((rn.kind == .Builtin && is_borrow_on_proj_builtin(rn.builtin_kind)) || rn.kind == .Array))
            || (rn.kind == .Builtin && is_cap_builtin(rn.builtin_kind));

        var rop = cfg_ir.op_copy(rplace);
        if consumes_recv {
            rop = cfg_ir.op_move(rplace);
        } else if need_borrow {
            created_recv_borrow = true;
            let bty = try self.env.intern_borrow(self.alloc, is_mut_recv, .Single, rty);
            let bdst = try self.new_temp_place(bty, recv_span);
            try self.emit_assign(recv_span, bdst, cfg_ir.rvalue_borrow(is_mut_recv, rplace));
            rop = cfg_ir.op_copy(bdst);
        } else if is_vec_builtin_op(bop.kind) && rn.kind == .Borrow && rn.borrow_kind == .Single {
            let dp = try self.extend_place(rplace, cfg_ir.proj_deref(), rn.primary, recv_span);
            rop = cfg_ir.op_copy(dp);
        }
        try cargs.push(self.alloc, rop);
        try arg_spans.push(self.alloc, recv_span);

        let is_pool_row_op = bop.kind == .ArenaPoolPush || bop.kind == .SlotPoolInsert || bop.kind == .SlotPoolTryInsert;
        let saved_has_row = self.has_pool_row_is_slot;
        let saved_row = self.pool_row_is_slot;
        if bop.kind == .ArenaPoolPush {
            self.has_pool_row_is_slot = true;
            self.pool_row_is_slot = false;
        } else if bop.kind == .SlotPoolInsert || bop.kind == .SlotPoolTryInsert {
            self.has_pool_row_is_slot = true;
            self.pool_row_is_slot = true;
        }

        var i: usize = 0_usize;
        while i < n_args {
            let aid = arena_expr_at(self.arena, args_range, i) orelse { break; };
            let hint = try self.builtin_method_arg_hint(bop, i, n_args);
            let op = try self.lower_expr_rvalue(aid, hint);
            let asp = expr_span(self.arena, aid);
            let cop = if hint != types.TY_NONE && self.env.get(hint).kind != .Pool {
                try self.coerce_operand(op, hint, asp)
            } else {
                op
            };
            try cargs.push(self.alloc, cop);
            try arg_spans.push(self.alloc, asp);
            i = i +% 1_usize;
        }
        if is_pool_row_op {
            self.has_pool_row_is_slot = saved_has_row;
            self.pool_row_is_slot = saved_row;
        }

        var dst_place = cfg_ir.CFG_NONE;
        if ret_ty != types.TY_VOID {
            dst_place = try self.new_temp_place(ret_ty, sp);
        }
        let cid = try self.cfg.add_call_data(
            self.alloc,
            cfg_ir.callee_builtin(bop.*),
            cargs.as_slice(),
            arg_spans.as_slice(),
            !created_recv_borrow,
            rplace,
            true,
            recv_span,
            is_mut_recv,
            consumes_recv,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, dst_place, cid));
        let res = if dst_place == cfg_ir.CFG_NONE {
            try self.cfg.add_const_op(self.alloc, cfg_ir.const_void())
        } else {
            self.operand_for_place(dst_place)
        };
        arg_spans.destroy(self.alloc);
        cargs.destroy(self.alloc);
        return res;
    }

    @recursive
    fn lower_call_method(
        self: *mut Self,
        call_expr_id: u32,
        fm: *FoundImplMethod,
        rty: types.TyId,
        rplace: u32,
        recv_span: span.Span,
        args_range: ast.IdRange,
        ret_ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        var inst_gargs = try col.DynBuf.[types.GenericVal].init(self.alloc, 4_usize);
        errdefer inst_gargs.destroy(self.alloc);
        var has_ci = false;
        var ci_args_r = ast.range_empty();
        if let ci = self.table.get_call_generic_inst(call_expr_id) {
            has_ci = true;
            ci_args_r = ci.args;
        }
        if has_ci {
            let n_ca = ci_args_r.len.widen.[usize]();
            var k: usize = 0_usize;
            while k < n_ca {
                let gv = call_inst_arg_at(self.table, ci_args_r, k) orelse { break; };
                if gv.kind == .Ty {
                    try inst_gargs.push(self.alloc, types.gval_ty(try self.subst(gv.id)));
                } else {
                    try inst_gargs.push(self.alloc, gv);
                }
                k = k +% 1_usize;
            }
        } else {
            let rn = self.env.get(rty);
            let d = if rn.kind == .Borrow && rn.borrow_kind == .Single { rn.primary } else { rty };
            let dn = self.env.get(d);
            if dn.kind == .Struct || dn.kind == .Union || dn.kind == .Pool {
                var sg_copy = try col.DynBuf.[types.GenericVal].init(self.alloc, dn.list_len.widen.[usize]() +% 1_usize);
                errdefer sg_copy.destroy(self.alloc);
                try sg_copy.push_slice(self.alloc, self.env.node_gval_list(&dn));
                try self.subst_gargs_into(sg_copy.as_slice(), &mut inst_gargs);
                sg_copy.destroy(self.alloc);
            }
        }

        var sub_params = try col.DynBuf.[types.ParamSig].init(self.alloc, fm.sig.params.len.widen.[usize]() +% 1_usize);
        errdefer sub_params.destroy(self.alloc);
        try sub_params.push_slice(self.alloc, self.env.params_range(fm.sig.params));
        if !inst_gargs.is_empty() {
            let sp_mut = sub_params.as_mut_slice();
            var pi: usize = 0_usize;
            while pi < sp_mut.len {
                sp_mut[pi].ty = try check.subst_ty(self.alloc, self.env, sp_mut[pi].ty, inst_gargs.as_slice());
                pi = pi +% 1_usize;
            }
        }

        let ps = sub_params.as_slice();
        let has_self = ps.len > 0_usize && ps[0_usize].is_self;
        var is_mut_recv = false;
        var consumes_recv = false;
        var created_self_borrow = false;
        var recv_arg = cfg_ir.op_copy(rplace);
        if has_self && ps.len > 0_usize {
            let p0_ty = ps[0_usize].ty;
            let p0n = self.env.get(p0_ty);
            is_mut_recv = p0n.kind == .Borrow && p0n.flag0;
            consumes_recv = p0n.kind != .Borrow && self.env.is_linear(p0_ty);
            let rp_kind = self.env.get(self.place_ty(rplace)).kind;
            if p0n.kind == .Borrow && rp_kind != .Borrow {
                created_self_borrow = true;
                let bdst = try self.new_temp_place(p0_ty, recv_span);
                try self.emit_assign(recv_span, bdst, cfg_ir.rvalue_borrow(p0n.flag0, rplace));
                recv_arg = cfg_ir.op_copy(bdst);
            } else if consumes_recv {
                recv_arg = cfg_ir.op_move(rplace);
            }
        }

        let n_args = args_range.len.widen.[usize]();
        var cargs = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_args +% 2_usize);
        errdefer cargs.destroy(self.alloc);
        var arg_spans = try col.DynBuf.[span.Span].init(self.alloc, n_args +% 2_usize);
        errdefer arg_spans.destroy(self.alloc);
        if has_self {
            try cargs.push(self.alloc, recv_arg);
            try arg_spans.push(self.alloc, recv_span);
        }
        let p_offset: usize = if has_self { 1_usize } else { 0_usize };
        var i: usize = 0_usize;
        while i < n_args {
            let aid = arena_expr_at(self.arena, args_range, i) orelse { break; };
            let pidx = i +% p_offset;
            let pty = if pidx < ps.len { ps[pidx].ty } else { types.TY_NONE };
            let op = try self.lower_expr_rvalue(aid, pty);
            let asp = expr_span(self.arena, aid);
            let cop = if pty != types.TY_NONE { try self.coerce_operand(op, pty, asp) } else { op };
            try cargs.push(self.alloc, cop);
            try arg_spans.push(self.alloc, asp);
            i = i +% 1_usize;
        }

        var dst_place = cfg_ir.CFG_NONE;
        if ret_ty != types.TY_VOID {
            dst_place = try self.new_temp_place(ret_ty, sp);
        }
        let callee = if !inst_gargs.is_empty() {
            let base_key = cfg_ir.fn_key_impl_method(fm.impl_idx, fm.sub_idx);
            let inst_id = try self.intern_generic_inst(base_key, inst_gargs.as_slice());
            cfg_ir.callee_generic_inst(inst_id, fm.sig.is_view)
        } else {
            cfg_ir.callee_method(fm.impl_idx, fm.sub_idx, fm.sig.is_view)
        };
        let cid = try self.cfg.add_call_data(
            self.alloc,
            callee,
            cargs.as_slice(),
            arg_spans.as_slice(),
            !created_self_borrow,
            rplace,
            true,
            recv_span,
            is_mut_recv,
            consumes_recv,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, dst_place, cid));
        let res = if dst_place == cfg_ir.CFG_NONE {
            try self.cfg.add_const_op(self.alloc, cfg_ir.const_void())
        } else {
            self.operand_for_place(dst_place)
        };
        arg_spans.destroy(self.alloc);
        cargs.destroy(self.alloc);
        sub_params.destroy(self.alloc);
        inst_gargs.destroy(self.alloc);
        return res;
    }

    @recursive
    fn lower_call_dyn(
        self: *mut Self,
        iface_def: u32,
        method_idx: u32,
        rplace: u32,
        recv_span: span.Span,
        args_range: ast.IdRange,
        ret_ty: types.TyId,
        sp: span.Span,
    ) -> ?cfg_ir.CfgOperand ! OutOfMemory {
        var found = false;
        var m_params_r = ast.range_empty();
        if let im = self.env.get_iface(iface_def) {
            let ms = self.env.iface_methods_range(im.methods);
            let mi = method_idx.widen.[usize]();
            if mi < ms.len {
                found = true;
                m_params_r = ms[mi].params;
            }
        }
        if !found {
            return null;
        }
        var ps_copy = try col.DynBuf.[types.ParamSig].init(self.alloc, m_params_r.len.widen.[usize]() +% 1_usize);
        errdefer ps_copy.destroy(self.alloc);
        try ps_copy.push_slice(self.alloc, self.env.params_range(m_params_r));
        let ps = ps_copy.as_slice();
        var is_mut_recv = false;
        if ps.len > 0_usize && ps[0_usize].is_self {
            let p0n = self.env.get(ps[0_usize].ty);
            is_mut_recv = p0n.kind == .Borrow && p0n.flag0;
        }
        let n_args = args_range.len.widen.[usize]();
        var cargs = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_args +% 2_usize);
        errdefer cargs.destroy(self.alloc);
        var arg_spans = try col.DynBuf.[span.Span].init(self.alloc, n_args +% 2_usize);
        errdefer arg_spans.destroy(self.alloc);
        try cargs.push(self.alloc, cfg_ir.op_copy(rplace));
        try arg_spans.push(self.alloc, recv_span);
        var i: usize = 0_usize;
        while i < n_args {
            let aid = arena_expr_at(self.arena, args_range, i) orelse { break; };
            let pidx = i +% 1_usize;
            let pty = if pidx < ps.len { ps[pidx].ty } else { types.TY_NONE };
            let op = try self.lower_expr_rvalue(aid, pty);
            let asp = expr_span(self.arena, aid);
            let cop = if pty != types.TY_NONE { try self.coerce_operand(op, pty, asp) } else { op };
            try cargs.push(self.alloc, cop);
            try arg_spans.push(self.alloc, asp);
            i = i +% 1_usize;
        }
        var dst_place = cfg_ir.CFG_NONE;
        if ret_ty != types.TY_VOID {
            dst_place = try self.new_temp_place(ret_ty, sp);
        }
        let cid = try self.cfg.add_call_data(
            self.alloc,
            cfg_ir.callee_dyn_call(iface_def, method_idx),
            cargs.as_slice(),
            arg_spans.as_slice(),
            true,
            rplace,
            true,
            recv_span,
            is_mut_recv,
            false,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, dst_place, cid));
        let res = if dst_place == cfg_ir.CFG_NONE {
            try self.cfg.add_const_op(self.alloc, cfg_ir.const_void())
        } else {
            self.operand_for_place(dst_place)
        };
        arg_spans.destroy(self.alloc);
        cargs.destroy(self.alloc);
        ps_copy.destroy(self.alloc);
        return res;
    }

    @recursive
    fn lower_call(
        self: *mut Self,
        call_expr_id: u32,
        callee_id: u32,
        args_range: ast.IdRange,
        ret_ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        var has_ce = false;
        var ce_kind: ast.ExprKind = .Error;
        var ce_a: u32 = ast.NONE_ID;
        var ce_ident = ast.ident_none();
        if let ce = self.arena.get_expr(callee_id) {
            has_ce = true;
            ce_kind = ce.kind;
            ce_a = ce.a;
            ce_ident = ce.ident;
        }
        if !has_ce {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        }

        // Case 0: Union variant constructor `.Click(payload)`
        if ce_kind == .EnumLit {
            let rn = self.env.get(ret_ty);
            if rn.kind == .Union {
                let def_id = rn.primary;
                let vidx = self.variant_tag_index(ret_ty, ce_ident.sym) orelse 0_u32;
                var pty = types.TY_ERROR;
                if let um = self.env.get_union(def_id) {
                    let vs = self.env.union_variants_range(um.variants);
                    let vi = vidx.widen.[usize]();
                    if vi < vs.len && vs[vi].has_payload {
                        pty = vs[vi].payload;
                    }
                }
                var elems = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, 2_usize);
                errdefer elems.destroy(self.alloc);
                if let a0 = arena_expr_at(self.arena, args_range, 0_usize) {
                    let op = try self.lower_expr_rvalue(a0, pty);
                    let cop = try self.coerce_operand(op, pty, expr_span(self.arena, a0));
                    try elems.push(self.alloc, cop);
                }
                let dst = try self.new_temp_place(ret_ty, sp);
                let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_union_variant(def_id, vidx));
                let er = try self.cfg.add_operands(self.alloc, elems.as_slice());
                try self.emit_assign(sp, dst, cfg_ir.rvalue_aggregate(agg_id, er));
                elems.destroy(self.alloc);
                return self.operand_for_place(dst);
            }
        }

        // Case 1: Conversion casts `x.widen.[To]()`, `x.try_into.[To]()`, etc.
        if ce_kind == .GenericApply {
            var is_be_field = false;
            var be_a: u32 = ast.NONE_ID;
            var be_sym: u32 = span.SYM_EMPTY;
            if let be = self.arena.get_expr(ce_a) {
                if be.kind == .Field {
                    is_be_field = true;
                    be_a = be.a;
                    be_sym = be.ident.sym;
                }
            }
            if is_be_field {
                if sym_is(self.interner, be_sym, "try_into") {
                    let rop = try self.lower_expr_rvalue(be_a, types.TY_NONE);
                    return try self.lower_try_into(rop, ret_ty, be_sym, sp);
                }
                var has_ck = false;
                var ck: cfg_ir.CastKind = .Widen;
                if sym_is(self.interner, be_sym, "widen") { has_ck = true; ck = .Widen; }
                else if sym_is(self.interner, be_sym, "trunc") { has_ck = true; ck = .Trunc; }
                else if sym_is(self.interner, be_sym, "clamp") { has_ck = true; ck = .Clamp; }
                else if sym_is(self.interner, be_sym, "to_float") { has_ck = true; ck = .ToFloat; }
                else if sym_is(self.interner, be_sym, "trunc_to_int") { has_ck = true; ck = .TruncToInt; }
                else if sym_is(self.interner, be_sym, "bitcast") { has_ck = true; ck = .Bitcast; }
                if has_ck {
                    let rop = try self.lower_expr_rvalue(be_a, types.TY_NONE);
                    let dst = try self.new_temp_place(ret_ty, sp);
                    try self.emit_assign(sp, dst, cfg_ir.rvalue_cast(ck, rop, ret_ty));
                    return self.operand_for_place(dst);
                }
            }
        }

        // Case 2: Builtin type assoc call or method call
        let inner_id = if ce_kind == .GenericApply { ce_a } else { callee_id };
        var is_ie_field = false;
        var recv_id: u32 = ast.NONE_ID;
        var field = ast.ident_none();
        if let ie = self.arena.get_expr(inner_id) {
            if ie.kind == .Field {
                is_ie_field = true;
                recv_id = ie.a;
                field = ie.ident;
            }
        }
        if is_ie_field {
            if let bk = self.extract_builtin_assoc_kind(recv_id) {
                if sym_is(self.interner, field.sym, "init") {
                    return try self.lower_builtin_init_call(bk, ret_ty, args_range, sp);
                }
                if sym_is(self.interner, field.sym, "new") && bk == .Atomic {
                    let el = self.extract_first_type_arg(ret_ty);
                    let bop = cfg_ir.builtin_op_ty(.AtomicNew, el);
                    return try self.lower_builtin_assoc_op(&bop, ret_ty, args_range, sp);
                }
                if sym_is(self.interner, field.sym, "from_usize") {
                    let bop = cfg_ir.builtin_op_ty(.RawPtrFromUsize, ret_ty);
                    return try self.lower_builtin_assoc_op(&bop, ret_ty, args_range, sp);
                }
                if sym_is(self.interner, field.sym, "splat") && (bk == .SimdAlias || bk == .VecType) {
                    let bop = cfg_ir.builtin_op_ty(.VecSplat, ret_ty);
                    return try self.lower_builtin_assoc_op(&bop, ret_ty, args_range, sp);
                }
                if sym_is(self.interner, field.sym, "build") && bk == .Schedule {
                    return try self.lower_schedule_build(args_range, ret_ty);
                }
            }

            if !self.is_module_or_type_static_path(recv_id) {
                let rty = try self.expr_ty(recv_id, types.TY_ERROR);
                let rplace = try self.lower_place(recv_id);
                if !self.has_cur_bb {
                    return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
                }
                let recv_sp = expr_span(self.arena, recv_id);
                if (sym_is(self.interner, field.sym, "as_u64") || sym_is(self.interner, field.sym, "as_usize"))
                    && args_range.len == 0_u32
                    && (self.env.is_address(rty) || self.env.get(rty).kind == .RawPtr)
                {
                    let dst = try self.new_temp_place(ret_ty, sp);
                    try self.emit_assign(sp, dst, cfg_ir.rvalue_cast(.AsU64, cfg_ir.op_copy(rplace), ret_ty));
                    return cfg_ir.op_copy(dst);
                }
                var has_dc = false;
                var dc_iface: u32 = 0_u32;
                var dc_midx: u32 = 0_u32;
                if let dc = self.table.get_dyn_call(call_expr_id) {
                    has_dc = true;
                    dc_iface = dc.iface_def;
                    dc_midx = dc.method_idx;
                }
                if has_dc {
                    if let res = try self.lower_call_dyn(dc_iface, dc_midx, rplace, recv_sp, args_range, ret_ty, sp) {
                        return res;
                    }
                }
                if sym_is(self.interner, field.sym, "drain") {
                    let rn = self.env.get(rty);
                    let deref_rty = if rn.kind == .Borrow && rn.borrow_kind == .Single { rn.primary } else { rty };
                    let dn = self.env.get(deref_rty);
                    if dn.kind == .Builtin && (dn.builtin_kind == .Buf || dn.builtin_kind == .LinearBuf) {
                        var elem_ty = types.TY_U64;
                        let gs = self.env.node_gval_list(&dn);
                        if gs.len > 0_usize && gs[0_usize].kind == .Ty {
                            elem_ty = gs[0_usize].id;
                        }
                        return try self.lower_buf_drain(rplace, recv_sp, elem_ty, args_range, sp);
                    }
                }
                let bm = try self.match_builtin_method(rty, field.sym, args_range);
                if bm.matched {
                    let bop = bm.op;
                    return try self.lower_builtin_method_call(
                        &bop, rplace, recv_sp, bm.is_mut_recv, bm.consumes_recv, args_range, ret_ty, sp,
                    );
                }
                let fm = self.find_method_entry(rty, field.sym);
                if fm.found {
                    return try self.lower_call_method(call_expr_id, &fm, rty, rplace, recv_sp, args_range, ret_ty, sp);
                }
            }
        }

        // Case 3: Direct / module-qualified / static method / fn pointer call
        return try self.lower_call_direct(call_expr_id, callee_id, args_range, ret_ty, sp);
    }

    @recursive
    fn lower_call_direct(
        self: *mut Self,
        call_expr_id: u32,
        callee_id: u32,
        args_range: ast.IdRange,
        ret_ty: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        var info = try self.resolve_direct_callee(callee_id);
        var param_tys = try col.DynBuf.[types.TyId].init(self.alloc, 8_usize);
        errdefer param_tys.destroy(self.alloc);
        if info.has_sig {
            if info.from_fn_ptr {
                let fn_n = self.env.get(info.fn_ptr_ty);
                try param_tys.push_slice(self.alloc, self.env.node_ty_list(&fn_n));
            } else {
                let ps = self.env.params_range(info.sig_params_range);
                var pi: usize = 0_usize;
                while pi < ps.len {
                    try param_tys.push(self.alloc, ps[pi].ty);
                    pi = pi +% 1_usize;
                }
            }
        }

        var has_ci = false;
        var ci_kind: check.CallFnKeyKind = .TopDef;
        var ci_primary: u32 = 0_u32;
        var ci_secondary: u32 = 0_u32;
        var ci_args_r = ast.range_empty();
        if let ci = self.table.get_call_generic_inst(call_expr_id) {
            has_ci = true;
            ci_kind = ci.kind;
            ci_primary = ci.primary;
            ci_secondary = ci.secondary;
            ci_args_r = ci.args;
        }
        if has_ci {
            let n_ca = ci_args_r.len.widen.[usize]();
            var inst_gargs = try col.DynBuf.[types.GenericVal].init(self.alloc, n_ca +% 1_usize);
            errdefer inst_gargs.destroy(self.alloc);
            var ca_i: usize = 0_usize;
            while ca_i < n_ca {
                let gv = call_inst_arg_at(self.table, ci_args_r, ca_i) orelse { break; };
                if gv.kind == .Ty {
                    try inst_gargs.push(self.alloc, types.gval_ty(try self.subst(gv.id)));
                } else {
                    try inst_gargs.push(self.alloc, gv);
                }
                ca_i = ca_i +% 1_usize;
            }
            let gs = inst_gargs.as_slice();
            var all_conc = gs.len > 0_usize;
            var gi: usize = 0_usize;
            while all_conc && gi < gs.len {
                if gs[gi].kind == .Ty {
                    if gs[gi].id == types.TY_ERROR || check.ty_contains_generic_param(gs[gi].id, self.env) {
                        all_conc = false;
                    }
                }
                gi = gi +% 1_usize;
            }
            if all_conc {
                if info.has_sig {
                    let pt_mut = param_tys.as_mut_slice();
                    var k: usize = 0_usize;
                    while k < pt_mut.len {
                        pt_mut[k] = try check.subst_ty(self.alloc, self.env, pt_mut[k], gs);
                        k = k +% 1_usize;
                    }
                    info.sig_ret = try check.subst_ty(self.alloc, self.env, info.sig_ret, gs);
                }
                let base_key = if ci_kind == .TopDef {
                    cfg_ir.fn_key_top_def(ci_primary)
                } else {
                    cfg_ir.fn_key_impl_method(ci_primary, ci_secondary)
                };
                let inst_id = try self.intern_generic_inst(base_key, gs);
                info.callee = cfg_ir.callee_generic_inst(inst_id, info.is_view);
            }
            inst_gargs.destroy(self.alloc);
        }

        let n_args = args_range.len.widen.[usize]();
        var cargs = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, n_args +% 1_usize);
        errdefer cargs.destroy(self.alloc);
        var arg_spans = try col.DynBuf.[span.Span].init(self.alloc, n_args +% 1_usize);
        errdefer arg_spans.destroy(self.alloc);
        let pts = param_tys.as_slice();
        var i: usize = 0_usize;
        while i < n_args {
            let aid = arena_expr_at(self.arena, args_range, i) orelse { break; };
            let pty = if i < pts.len { pts[i] } else { types.TY_NONE };
            let op = try self.lower_expr_rvalue(aid, pty);
            let asp = expr_span(self.arena, aid);
            let cop = if pty != types.TY_NONE { try self.coerce_operand(op, pty, asp) } else { op };
            try cargs.push(self.alloc, cop);
            try arg_spans.push(self.alloc, asp);
            i = i +% 1_usize;
        }
        if !self.has_cur_bb {
            let vres = try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
            arg_spans.destroy(self.alloc);
            cargs.destroy(self.alloc);
            param_tys.destroy(self.alloc);
            return vres;
        }
        let actual_ret = if ret_ty != types.TY_ERROR {
            ret_ty
        } else if info.has_sig {
            info.sig_ret
        } else {
            types.TY_VOID
        };
        var dst_place = cfg_ir.CFG_NONE;
        if actual_ret != types.TY_VOID {
            dst_place = try self.new_temp_place(actual_ret, sp);
        }
        let cid = try self.cfg.add_call_data(
            self.alloc,
            info.callee,
            cargs.as_slice(),
            arg_spans.as_slice(),
            false,
            cfg_ir.CFG_NONE,
            false,
            span.span_dummy(),
            false,
            false,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, dst_place, cid));
        let res = if dst_place == cfg_ir.CFG_NONE {
            try self.cfg.add_const_op(self.alloc, cfg_ir.const_void())
        } else {
            self.operand_for_place(dst_place)
        };
        arg_spans.destroy(self.alloc);
        cargs.destroy(self.alloc);
        param_tys.destroy(self.alloc);
        return res;
    }

    @recursive
    fn lower_buf_drain(
        self: *mut Self,
        rplace: u32,
        recv_span: span.Span,
        elem_ty: types.TyId,
        args_range: ast.IdRange,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        let n_args = args_range.len.widen.[usize]();
        var has_alloc = false;
        var alloc_op = cfg_ir.op_none();
        var alloc_sp = span.span_dummy();
        if n_args >= 2_usize {
            if let a0 = arena_expr_at(self.arena, args_range, 0_usize) {
                has_alloc = true;
                alloc_op = try self.lower_expr_rvalue(a0, types.TY_NONE);
                alloc_sp = expr_span(self.arena, a0);
            }
        }
        let one_el: [1]types.TyId = [elem_ty];
        let cb_ty = try self.env.intern_fn_ptr(self.alloc, &one_el, types.TY_VOID);
        if n_args == 0_usize {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        }
        let cb_expr_id = arena_expr_at(self.arena, args_range, n_args - 1_usize) orelse {
            return try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        };
        let cb_sp = expr_span(self.arena, cb_expr_id);
        let cb_raw = try self.lower_expr_rvalue(cb_expr_id, cb_ty);
        let cb_op = try self.coerce_operand(cb_raw, cb_ty, cb_sp);
        let cb_place = try self.new_temp_place(cb_ty, cb_sp);
        try self.emit_assign(cb_sp, cb_place, cfg_ir.rvalue_use(cb_op));

        let opt_ty = try self.env.intern_optional(self.alloc, elem_ty);
        let opt_place = try self.new_temp_place(opt_ty, sp);
        let has_place = try self.new_temp_place(types.TY_BOOL, sp);
        let item_place = try self.new_temp_place(elem_ty, sp);

        let header_bb = try self.new_block();
        let h_idx = header_bb.widen.[usize]();
        let bs_mut = self.st.bufs.blocks.as_mut_slice();
        if h_idx < bs_mut.len {
            bs_mut[h_idx].is_loop_header = true;
        }
        let body_bb = try self.new_block();
        let done_bb = try self.new_block();

        self.set_term(cfg_ir.term_goto(header_bb));
        self.has_cur_bb = true;
        self.cur_bb = header_bb;
        let pop_args: [1]cfg_ir.CfgOperand = [cfg_ir.op_copy(rplace)];
        let pop_spans: [1]span.Span = [recv_span];
        let pop_cid = try self.cfg.add_call_data(
            self.alloc,
            cfg_ir.callee_builtin(cfg_ir.builtin_op_ty(.BufPop, elem_ty)),
            &pop_args,
            &pop_spans,
            true,
            rplace,
            true,
            recv_span,
            true,
            false,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, opt_place, pop_cid));
        try self.emit_assign(sp, has_place, cfg_ir.rvalue_is_non_null(cfg_ir.op_copy(opt_place)));
        self.set_term(cfg_ir.term_branch(cfg_ir.op_copy(has_place), body_bb, done_bb, sp, false));

        self.has_cur_bb = true;
        self.cur_bb = body_bb;
        try self.emit_assign(sp, item_place, cfg_ir.rvalue_unwrap_optional(cfg_ir.op_move(opt_place)));
        let item_op = if self.env.is_linear(elem_ty) { cfg_ir.op_move(item_place) } else { cfg_ir.op_copy(item_place) };
        let cb_args: [1]cfg_ir.CfgOperand = [item_op];
        let cb_spans: [1]span.Span = [sp];
        let cb_cid = try self.cfg.add_call_data(
            self.alloc,
            cfg_ir.callee_fn_ptr(cfg_ir.op_copy(cb_place)),
            &cb_args,
            &cb_spans,
            false,
            cfg_ir.CFG_NONE,
            false,
            span.span_dummy(),
            false,
            false,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, cfg_ir.CFG_NONE, cb_cid));
        self.set_term(cfg_ir.term_goto(header_bb));

        self.has_cur_bb = true;
        self.cur_bb = done_bb;
        var d_args = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, 2_usize);
        errdefer d_args.destroy(self.alloc);
        var d_spans = try col.DynBuf.[span.Span].init(self.alloc, 2_usize);
        errdefer d_spans.destroy(self.alloc);
        try d_args.push(self.alloc, cfg_ir.op_copy(rplace));
        try d_spans.push(self.alloc, recv_span);
        if has_alloc {
            try d_args.push(self.alloc, alloc_op);
            try d_spans.push(self.alloc, alloc_sp);
        }
        let d_cid = try self.cfg.add_call_data(
            self.alloc,
            cfg_ir.callee_builtin(cfg_ir.builtin_op_ty(.BufDestroy, elem_ty)),
            d_args.as_slice(),
            d_spans.as_slice(),
            true,
            rplace,
            true,
            recv_span,
            true,
            true,
        );
        try self.push_stmt(cfg_ir.stmt_call(sp, cfg_ir.CFG_NONE, d_cid));
        let res = try self.cfg.add_const_op(self.alloc, cfg_ir.const_void());
        d_spans.destroy(self.alloc);
        d_args.destroy(self.alloc);
        return res;
    }

    fn resolve_sys_expr(self: *Self, expr_id: u32) -> ?u32 {
        let e = self.arena.get_expr(expr_id) orelse { return null; };
        if e.kind != .Ident {
            return null;
        }
        let entry = self.prog.lookup_in_module(self.module_id, e.a) orelse { return null; };
        if entry.kind != .Def {
            return null;
        }
        if let d = self.prog.get_def(entry.target_id) {
            if d.kind == .Sys {
                return entry.target_id;
            }
        }
        return null;
    }

    fn push_sched_node_unique(
        self: *Self,
        d: u32,
        nodes: *mut col.DynBuf[u32],
    ) -> !OutOfMemory {
        let ns = nodes.as_slice();
        var i: usize = 0_usize;
        while i < ns.len {
            if ns[i] == d {
                return;
            }
            i = i +% 1_usize;
        }
        try nodes.push(self.alloc, d);
        return;
    }

    fn push_sched_edge_unique(
        self: *Self,
        u: u32,
        v: u32,
        edges: *mut col.DynBuf[SchedEdge],
    ) -> !OutOfMemory {
        let es = edges.as_slice();
        var i: usize = 0_usize;
        while i < es.len {
            if es[i].u == u && es[i].v == v {
                return;
            }
            i = i +% 1_usize;
        }
        try edges.push(self.alloc, SchedEdge.{ u: u, v: v });
        return;
    }

    fn collect_schedule_dag_entry(
        self: *Self,
        expr_id: u32,
        nodes: *mut col.DynBuf[u32],
        edges: *mut col.DynBuf[SchedEdge],
    ) -> !OutOfMemory {
        let e = self.arena.get_expr(expr_id) orelse { return; };
        if e.kind == .Ident {
            if let d = self.resolve_sys_expr(expr_id) {
                try self.push_sched_node_unique(d, nodes);
            }
            return;
        }
        if e.kind == .Call {
            if let ce = self.arena.get_expr(e.a) {
                if ce.kind == .Field {
                    if let lhs = self.resolve_sys_expr(ce.a) {
                        try self.push_sched_node_unique(lhs, nodes);
                        let cargs = self.arena.expr_list_range(e.list);
                        if cargs.len > 0_usize {
                            if let rhs = self.resolve_sys_expr(cargs[0_usize]) {
                                try self.push_sched_node_unique(rhs, nodes);
                                if sym_is(self.interner, ce.ident.sym, "before") {
                                    try self.push_sched_edge_unique(lhs, rhs, edges);
                                } else if sym_is(self.interner, ce.ident.sym, "after") {
                                    try self.push_sched_edge_unique(rhs, lhs, edges);
                                }
                            }
                        }
                    }
                }
            }
        }
        return;
    }

    fn lower_schedule_build(
        self: *mut Self,
        args_range: ast.IdRange,
        ret_ty: types.TyId,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        var nodes = try col.DynBuf.[u32].init(self.alloc, 8_usize);
        errdefer nodes.destroy(self.alloc);
        var edges = try col.DynBuf.[SchedEdge].init(self.alloc, 8_usize);
        errdefer edges.destroy(self.alloc);

        let n_args = args_range.len.widen.[usize]();
        var ai: usize = 0_usize;
        while ai < n_args {
            let aid = arena_expr_at(self.arena, args_range, ai) orelse { break; };
            if let ae = self.arena.get_expr(aid) {
                if ae.kind == .AnonStructLit {
                    let fis = self.arena.field_inits_range(ae.list);
                    var fi: usize = 0_usize;
                    while fi < fis.len {
                        try self.collect_schedule_dag_entry(fis[fi].value, &mut nodes, &mut edges);
                        fi = fi +% 1_usize;
                    }
                } else if ae.kind == .Tuple || ae.kind == .ArrayLit {
                    let es = self.arena.expr_list_range(ae.list);
                    var ei: usize = 0_usize;
                    while ei < es.len {
                        try self.collect_schedule_dag_entry(es[ei], &mut nodes, &mut edges);
                        ei = ei +% 1_usize;
                    }
                } else {
                    try self.collect_schedule_dag_entry(aid, &mut nodes, &mut edges);
                }
            }
            ai = ai +% 1_usize;
        }

        let n = nodes.len();
        var in_deg = try col.DynBuf.[u32].init(self.alloc, n +% 1_usize);
        errdefer in_deg.destroy(self.alloc);
        var alive = try col.DynBuf.[bool].init(self.alloc, n +% 1_usize);
        errdefer alive.destroy(self.alloc);
        var ni: usize = 0_usize;
        while ni < n {
            try in_deg.push(self.alloc, 0_u32);
            try alive.push(self.alloc, true);
            ni = ni +% 1_usize;
        }
        let ns = nodes.as_slice();
        let es = edges.as_slice();
        var ei2: usize = 0_usize;
        while ei2 < es.len {
            var k: usize = 0_usize;
            while k < ns.len {
                if ns[k] == es[ei2].v {
                    let id_mut = in_deg.as_mut_slice();
                    if k < id_mut.len {
                        id_mut[k] = id_mut[k] +% 1_u32;
                    }
                    break;
                }
                k = k +% 1_usize;
            }
            ei2 = ei2 +% 1_usize;
        }

        var waves = try col.DynBuf.[cfg_ir.ScheduleWave].init(self.alloc, n +% 1_usize);
        errdefer waves.destroy(self.alloc);
        var ready = try col.DynBuf.[u32].init(self.alloc, n +% 1_usize);
        errdefer ready.destroy(self.alloc);
        var rem = n;
        while rem > 0_usize {
            ready.clear();
            let id_ro = in_deg.as_slice();
            let al_ro = alive.as_slice();
            var ri: usize = 0_usize;
            while ri < ns.len {
                if ri < al_ro.len && ri < id_ro.len && al_ro[ri] && id_ro[ri] == 0_u32 {
                    try ready.push(self.alloc, ns[ri]);
                }
                ri = ri +% 1_usize;
            }
            if ready.is_empty() {
                break;
            }
            let rds = ready.as_slice();
            var rj: usize = 0_usize;
            while rj < rds.len {
                let d = rds[rj];
                var k: usize = 0_usize;
                while k < ns.len {
                    if ns[k] == d {
                        let al_mut = alive.as_mut_slice();
                        if k < al_mut.len {
                            al_mut[k] = false;
                        }
                        if rem > 0_usize {
                            rem = rem - 1_usize;
                        }
                        break;
                    }
                    k = k +% 1_usize;
                }
                var ek: usize = 0_usize;
                while ek < es.len {
                    if es[ek].u == d {
                        var vk: usize = 0_usize;
                        while vk < ns.len {
                            if ns[vk] == es[ek].v {
                                let id_mut = in_deg.as_mut_slice();
                                if vk < id_mut.len && id_mut[vk] > 0_u32 {
                                    id_mut[vk] = id_mut[vk] -% 1_u32;
                                }
                                break;
                            }
                            vk = vk +% 1_usize;
                        }
                    }
                    ek = ek +% 1_usize;
                }
                rj = rj +% 1_usize;
            }
            let sys_r = try self.cfg.add_sched_systems(self.alloc, rds);
            try waves.push(self.alloc, cfg_ir.ScheduleWave.{ systems: sys_r });
        }

        var dag_nodes = try col.DynBuf.[cfg_ir.ScheduleDagNode].init(self.alloc, n +% 1_usize);
        errdefer dag_nodes.destroy(self.alloc);
        var deps = try col.DynBuf.[u32].init(self.alloc, 4_usize);
        errdefer deps.destroy(self.alloc);
        var dn_i: usize = 0_usize;
        while dn_i < ns.len {
            deps.clear();
            var ek2: usize = 0_usize;
            while ek2 < es.len {
                if es[ek2].v == ns[dn_i] {
                    try deps.push(self.alloc, es[ek2].u);
                }
                ek2 = ek2 +% 1_usize;
            }
            let dr = try self.cfg.add_dag_deps(self.alloc, deps.as_slice());
            try dag_nodes.push(self.alloc, cfg_ir.ScheduleDagNode.{ fn_def_id: ns[dn_i], deps_range: dr });
            dn_i = dn_i +% 1_usize;
        }

        let waves_r = try self.cfg.add_sched_waves(self.alloc, waves.as_slice());
        let nodes_r = try self.cfg.add_dag_nodes(self.alloc, dag_nodes.as_slice());
        let idx = try self.cfg.add_schedule(self.alloc, waves_r, nodes_r);
        let res = try self.cfg.add_const_op(
            self.alloc,
            cfg_ir.const_int(types.int_val_from_u64(idx.widen.[u64]()), ret_ty),
        );

        deps.destroy(self.alloc);
        dag_nodes.destroy(self.alloc);
        ready.destroy(self.alloc);
        waves.destroy(self.alloc);
        alive.destroy(self.alloc);
        in_deg.destroy(self.alloc);
        edges.destroy(self.alloc);
        nodes.destroy(self.alloc);
        return res;
    }
}

// ===========================================================================
// Section 6: Closures, Free-Variable Analysis & `lower_program` Entrypoint
// ===========================================================================

struct FreeVar {
    sym: u32;
    mutated: bool;
}

struct CapEntry {
    is_self: bool;
    sym: u32;
    outer_place: u32;
    is_mut: bool;
    cap_ptr_ty: types.TyId;
    inner_ty: types.TyId;
}

fn bound_contains(bound: *[u32], sym: u32) -> bool {
    var i: usize = 0_usize;
    while i < bound.len {
        if bound[i] == sym {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn pop_bound_to(bound: *mut col.DynBuf[u32], mark: usize) {
    while bound.len() > mark {
        _ = bound.pop();
    }
}

fn record_free_var(
    alloc: *mut AllocCap,
    sym: u32,
    mutated: bool,
    out: *mut col.DynBuf[FreeVar],
) -> !OutOfMemory {
    let s = out.as_mut_slice();
    var i: usize = 0_usize;
    while i < s.len {
        if s[i].sym == sym {
            if mutated {
                s[i].mutated = true;
            }
            return;
        }
        i = i +% 1_usize;
    }
    try out.push(alloc, FreeVar.{ sym: sym, mutated: mutated });
    return;
}

fn sort_free_vars(xs: *mut [FreeVar]) {
    let n = xs.len;
    if n <= 1_usize {
        return;
    }
    var i: usize = 1_usize;
    while i < n {
        let cur = xs[i];
        var j = i;
        while j > 0_usize && xs[j - 1_usize].sym > cur.sym {
            xs[j] = xs[j - 1_usize];
            j = j - 1_usize;
        }
        xs[j] = cur;
        i = i +% 1_usize;
    }
}

@recursive
fn collect_pat_bindings(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    pat_id: u32,
    bound: *mut col.DynBuf[u32],
) -> !OutOfMemory {
    let p = arena.get_pat(pat_id) orelse { return; };
    match p.kind {
        .Ident => { try bound.push(alloc, p.data0); }
        .Variant => {
            let args = arena.pat_list_range(p.list);
            var i: usize = 0_usize;
            while i < args.len {
                try collect_pat_bindings(alloc, arena, args[i], bound);
                i = i +% 1_usize;
            }
        }
        .Tuple => {
            let args = arena.pat_list_range(p.list);
            var i: usize = 0_usize;
            while i < args.len {
                try collect_pat_bindings(alloc, arena, args[i], bound);
                i = i +% 1_usize;
            }
        }
        .Struct => {
            let fps = arena.pat_fields_range(p.list);
            var i: usize = 0_usize;
            while i < fps.len {
                if fps[i].pat != ast.NONE_ID {
                    try collect_pat_bindings(alloc, arena, fps[i].pat, bound);
                } else {
                    try bound.push(alloc, fps[i].name.sym);
                }
                i = i +% 1_usize;
            }
        }
        _ => {}
    }
    return;
}

@recursive
fn collect_free_vars_jump(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    jump_id: u32,
    bound: *mut col.DynBuf[u32],
    out: *mut col.DynBuf[FreeVar],
    uses_self: *mut bool,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    let j = arena.get_jump(jump_id) orelse { return; };
    if (j.kind == .Return || j.kind == .Break) && j.value != ast.NONE_ID {
        try collect_free_vars_expr(alloc, arena, j.value, bound, false, out, uses_self, interner);
    }
    return;
}

@recursive
fn collect_free_vars_body(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    kind: ast.BodyKind,
    id: u32,
    bound: *mut col.DynBuf[u32],
    out: *mut col.DynBuf[FreeVar],
    uses_self: *mut bool,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    match kind {
        .Block => { try collect_free_vars_block(alloc, arena, id, bound, out, uses_self, interner); }
        .Expr => { try collect_free_vars_expr(alloc, arena, id, bound, false, out, uses_self, interner); }
        .Jump => { try collect_free_vars_jump(alloc, arena, id, bound, out, uses_self, interner); }
    }
    return;
}

@recursive
fn collect_free_vars_block(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    block_id: u32,
    bound: *mut col.DynBuf[u32],
    out: *mut col.DynBuf[FreeVar],
    uses_self: *mut bool,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    let blk = arena.get_block(block_id) orelse { return; };
    let mark = bound.len();
    let stmts = arena.stmt_list_range(blk.stmts);
    var i: usize = 0_usize;
    while i < stmts.len {
        try collect_free_vars_stmt(alloc, arena, stmts[i], bound, out, uses_self, interner);
        i = i +% 1_usize;
    }
    if blk.tail_expr != ast.NONE_ID {
        try collect_free_vars_expr(alloc, arena, blk.tail_expr, bound, false, out, uses_self, interner);
    }
    pop_bound_to(bound, mark);
    return;
}

@recursive
fn collect_free_vars_if(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    if_id: u32,
    bound: *mut col.DynBuf[u32],
    out: *mut col.DynBuf[FreeVar],
    uses_self: *mut bool,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    let data = arena.get_if(if_id) orelse { return; };
    let mark = bound.len();
    try collect_free_vars_expr(alloc, arena, data.cond_expr, bound, false, out, uses_self, interner);
    if data.cond_kind == .Let {
        try collect_pat_bindings(alloc, arena, data.cond_pat, bound);
    }
    try collect_free_vars_block(alloc, arena, data.then_block, bound, out, uses_self, interner);
    pop_bound_to(bound, mark);
    if data.else_kind == .Block {
        try collect_free_vars_block(alloc, arena, data.else_id, bound, out, uses_self, interner);
    } else if data.else_kind == .If {
        try collect_free_vars_if(alloc, arena, data.else_id, bound, out, uses_self, interner);
    }
    return;
}

@recursive
fn collect_free_vars_match(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    scrut_id: u32,
    arms_range: ast.IdRange,
    bound: *mut col.DynBuf[u32],
    out: *mut col.DynBuf[FreeVar],
    uses_self: *mut bool,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    try collect_free_vars_expr(alloc, arena, scrut_id, bound, false, out, uses_self, interner);
    let arms = arena.match_arms_range(arms_range);
    var i: usize = 0_usize;
    while i < arms.len {
        let arm = arms[i];
        let mark = bound.len();
        try collect_pat_bindings(alloc, arena, arm.pat, bound);
        if arm.guard != ast.NONE_ID {
            try collect_free_vars_expr(alloc, arena, arm.guard, bound, false, out, uses_self, interner);
        }
        try collect_free_vars_body(alloc, arena, arm.body_kind, arm.body_id, bound, out, uses_self, interner);
        pop_bound_to(bound, mark);
        i = i +% 1_usize;
    }
    return;
}

@recursive
fn collect_free_vars_stmt(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    stmt_id: u32,
    bound: *mut col.DynBuf[u32],
    out: *mut col.DynBuf[FreeVar],
    uses_self: *mut bool,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    let s = arena.get_stmt(stmt_id) orelse { return; };
    match s.kind {
        .Let => {
            try collect_free_vars_expr(alloc, arena, s.c, bound, false, out, uses_self, interner);
            try collect_pat_bindings(alloc, arena, s.a, bound);
        }
        .Var => {
            try collect_free_vars_expr(alloc, arena, s.c, bound, false, out, uses_self, interner);
            try bound.push(alloc, s.ident.sym);
        }
        .Const => {
            if let c = arena.get_const_decl(s.a) {
                try collect_free_vars_expr(alloc, arena, c.value, bound, false, out, uses_self, interner);
                try bound.push(alloc, c.name.sym);
            }
        }
        .Defer => {
            try collect_free_vars_body(alloc, arena, s.body_kind, s.a, bound, out, uses_self, interner);
        }
        .Errdefer => {
            let mark = bound.len();
            if ast.ident_is_some(s.ident) {
                try bound.push(alloc, s.ident.sym);
            }
            try collect_free_vars_body(alloc, arena, s.body_kind, s.a, bound, out, uses_self, interner);
            pop_bound_to(bound, mark);
        }
        .Jump => { try collect_free_vars_jump(alloc, arena, s.a, bound, out, uses_self, interner); }
        .If => { try collect_free_vars_if(alloc, arena, s.a, bound, out, uses_self, interner); }
        .Match => { try collect_free_vars_match(alloc, arena, s.a, s.list, bound, out, uses_self, interner); }
        .While => {
            try collect_free_vars_expr(alloc, arena, s.a, bound, false, out, uses_self, interner);
            let ws = arena.expr_list_range(s.list);
            var i: usize = 0_usize;
            while i < ws.len {
                try collect_free_vars_expr(alloc, arena, ws[i], bound, false, out, uses_self, interner);
                i = i +% 1_usize;
            }
            try collect_free_vars_block(alloc, arena, s.b, bound, out, uses_self, interner);
        }
        .For => {
            try collect_free_vars_expr(alloc, arena, s.c, bound, false, out, uses_self, interner);
            if s.has_range {
                try collect_free_vars_expr(alloc, arena, s.d, bound, false, out, uses_self, interner);
            }
            let mark = bound.len();
            try collect_pat_bindings(alloc, arena, s.a, bound);
            try collect_free_vars_block(alloc, arena, s.b, bound, out, uses_self, interner);
            pop_bound_to(bound, mark);
        }
        .ParFor => {
            try collect_free_vars_expr(alloc, arena, s.c, bound, false, out, uses_self, interner);
            if s.has_range {
                try collect_free_vars_expr(alloc, arena, s.d, bound, false, out, uses_self, interner);
            }
            let mark = bound.len();
            try collect_pat_bindings(alloc, arena, s.a, bound);
            try collect_free_vars_block(alloc, arena, s.b, bound, out, uses_self, interner);
            pop_bound_to(bound, mark);
        }
        .Loop => { try collect_free_vars_block(alloc, arena, s.a, bound, out, uses_self, interner); }
        .ComptimeBlock => { try collect_free_vars_block(alloc, arena, s.a, bound, out, uses_self, interner); }
        .RawBlock => { try collect_free_vars_block(alloc, arena, s.a, bound, out, uses_self, interner); }
        .Assign => {
            try collect_free_vars_expr(alloc, arena, s.a, bound, true, out, uses_self, interner);
            try collect_free_vars_expr(alloc, arena, s.b, bound, false, out, uses_self, interner);
        }
        .Discard => { try collect_free_vars_expr(alloc, arena, s.a, bound, false, out, uses_self, interner); }
        .Expr => { try collect_free_vars_expr(alloc, arena, s.a, bound, false, out, uses_self, interner); }
    }
    return;
}

fn is_readonly_closure_method(interner: *span.SymInterner, sym: u32) -> bool {
    let bs = interner.get(sym);
    return str.bytes_eq(bs, "len".as_bytes())
        || str.bytes_eq(bs, "cap".as_bytes())
        || str.bytes_eq(bs, "as_slice".as_bytes())
        || str.bytes_eq(bs, "get".as_bytes())
        || str.bytes_eq(bs, "at".as_bytes())
        || str.bytes_eq(bs, "sub".as_bytes())
        || str.bytes_eq(bs, "is_alive".as_bytes())
        || str.bytes_eq(bs, "as_bytes".as_bytes())
        || str.bytes_eq(bs, "as_str".as_bytes())
        || str.bytes_eq(bs, "as_u64".as_bytes())
        || str.bytes_eq(bs, "as_usize".as_bytes());
}

@recursive
fn collect_free_vars_expr(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    expr_id: u32,
    bound: *mut col.DynBuf[u32],
    mutated: bool,
    out: *mut col.DynBuf[FreeVar],
    uses_self: *mut bool,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    let e = arena.get_expr(expr_id) orelse { return; };
    match e.kind {
        .Ident => {
            if !bound_contains(bound.as_slice(), e.a) {
                try record_free_var(alloc, e.a, mutated, out);
            }
        }
        .SelfVal => { uses_self.* = true; }
        .AnonStructLit => {
            let fis = arena.field_inits_range(e.list);
            var i: usize = 0_usize;
            while i < fis.len {
                try collect_free_vars_expr(alloc, arena, fis[i].value, bound, false, out, uses_self, interner);
                i = i +% 1_usize;
            }
        }
        .NamedStructLit => {
            try collect_free_vars_expr(alloc, arena, e.a, bound, false, out, uses_self, interner);
            let fis = arena.field_inits_range(e.list);
            var i: usize = 0_usize;
            while i < fis.len {
                try collect_free_vars_expr(alloc, arena, fis[i].value, bound, false, out, uses_self, interner);
                i = i +% 1_usize;
            }
        }
        .ArrayLit => {
            let es = arena.expr_list_range(e.list);
            var i: usize = 0_usize;
            while i < es.len {
                try collect_free_vars_expr(alloc, arena, es[i], bound, false, out, uses_self, interner);
                i = i +% 1_usize;
            }
        }
        .Tuple => {
            let es = arena.expr_list_range(e.list);
            var i: usize = 0_usize;
            while i < es.len {
                try collect_free_vars_expr(alloc, arena, es[i], bound, false, out, uses_self, interner);
                i = i +% 1_usize;
            }
        }
        .ArrayRepeat => {
            try collect_free_vars_expr(alloc, arena, e.a, bound, false, out, uses_self, interner);
            try collect_free_vars_expr(alloc, arena, e.b, bound, false, out, uses_self, interner);
        }
        .Paren => { try collect_free_vars_expr(alloc, arena, e.a, bound, mutated, out, uses_self, interner); }
        .Deref => { try collect_free_vars_expr(alloc, arena, e.a, bound, mutated, out, uses_self, interner); }
        .ComptimeExpr => { try collect_free_vars_expr(alloc, arena, e.a, bound, mutated, out, uses_self, interner); }
        .Closure => {
            let mark = bound.len();
            let ps = arena.params_range(e.list);
            var i: usize = 0_usize;
            while i < ps.len {
                try bound.push(alloc, ps[i].name.sym);
                i = i +% 1_usize;
            }
            try collect_free_vars_block(alloc, arena, e.a, bound, out, uses_self, interner);
            pop_bound_to(bound, mark);
        }
        .If => { try collect_free_vars_if(alloc, arena, e.a, bound, out, uses_self, interner); }
        .Match => { try collect_free_vars_match(alloc, arena, e.a, e.list, bound, out, uses_self, interner); }
        .Loop => { try collect_free_vars_block(alloc, arena, e.a, bound, out, uses_self, interner); }
        .ComptimeBlock => { try collect_free_vars_block(alloc, arena, e.a, bound, out, uses_self, interner); }
        .Builtin => {
            let gas = arena.generic_args_range(e.list);
            var i: usize = 0_usize;
            while i < gas.len {
                if gas[i].kind == .Expr {
                    try collect_free_vars_expr(alloc, arena, gas[i].node_id, bound, false, out, uses_self, interner);
                }
                i = i +% 1_usize;
            }
        }
        .Asm => {
            let ops = arena.asm_ops_range(e.list2);
            var i: usize = 0_usize;
            while i < ops.len {
                if ops[i].kind == .Named {
                    if ops[i].arg != ast.NONE_ID {
                        try collect_free_vars_expr(alloc, arena, ops[i].arg, bound, false, out, uses_self, interner);
                    }
                } else {
                    try collect_free_vars_expr(alloc, arena, ops[i].expr, bound, false, out, uses_self, interner);
                }
                i = i +% 1_usize;
            }
        }
        .Unary => {
            let m = mutated || e.unary_op == .BorrowMut;
            try collect_free_vars_expr(alloc, arena, e.a, bound, m, out, uses_self, interner);
        }
        .Binary => {
            try collect_free_vars_expr(alloc, arena, e.a, bound, false, out, uses_self, interner);
            try collect_free_vars_expr(alloc, arena, e.b, bound, false, out, uses_self, interner);
        }
        .Is => { try collect_free_vars_expr(alloc, arena, e.a, bound, false, out, uses_self, interner); }
        .Orelse => {
            try collect_free_vars_expr(alloc, arena, e.a, bound, false, out, uses_self, interner);
            try collect_free_vars_body(alloc, arena, e.body_kind, e.b, bound, out, uses_self, interner);
        }
        .Catch => {
            try collect_free_vars_expr(alloc, arena, e.a, bound, false, out, uses_self, interner);
            let mark = bound.len();
            if ast.ident_is_some(e.ident) {
                try bound.push(alloc, e.ident.sym);
            }
            try collect_free_vars_body(alloc, arena, e.body_kind, e.b, bound, out, uses_self, interner);
            pop_bound_to(bound, mark);
        }
        .Field => { try collect_free_vars_expr(alloc, arena, e.a, bound, mutated, out, uses_self, interner); }
        .GenericApply => {
            try collect_free_vars_expr(alloc, arena, e.a, bound, false, out, uses_self, interner);
            let gas = arena.generic_args_range(e.list);
            var i: usize = 0_usize;
            while i < gas.len {
                if gas[i].kind == .Expr {
                    try collect_free_vars_expr(alloc, arena, gas[i].node_id, bound, false, out, uses_self, interner);
                }
                i = i +% 1_usize;
            }
        }
        .Call => {
            var handled_field = false;
            if let ce = arena.get_expr(e.a) {
                if ce.kind == .Field {
                    handled_field = true;
                    let ro = is_readonly_closure_method(interner, ce.ident.sym);
                    try collect_free_vars_expr(alloc, arena, ce.a, bound, !ro, out, uses_self, interner);
                }
            }
            if !handled_field {
                try collect_free_vars_expr(alloc, arena, e.a, bound, false, out, uses_self, interner);
            }
            let cargs = arena.expr_list_range(e.list);
            var i: usize = 0_usize;
            while i < cargs.len {
                try collect_free_vars_expr(alloc, arena, cargs[i], bound, false, out, uses_self, interner);
                i = i +% 1_usize;
            }
        }
        .Index => {
            try collect_free_vars_expr(alloc, arena, e.a, bound, mutated, out, uses_self, interner);
            try collect_free_vars_expr(alloc, arena, e.b, bound, false, out, uses_self, interner);
        }
        .Slice => {
            try collect_free_vars_expr(alloc, arena, e.a, bound, mutated, out, uses_self, interner);
            if e.b != ast.NONE_ID {
                try collect_free_vars_expr(alloc, arena, e.b, bound, false, out, uses_self, interner);
            }
            if e.c != ast.NONE_ID {
                try collect_free_vars_expr(alloc, arena, e.c, bound, false, out, uses_self, interner);
            }
        }
        _ => {}
    }
    return;
}

view struct LowerCtx {
    alloc: *mut AllocCap;
    arena: *ast.AstArena;
    prog: *resolve.ResolvedProgram;
    env: *mut types.TypeEnv;
    ct: *ctvm.CtArena;
    table: *check.TypeTable;
    interner: *span.SymInterner;
    cfg: *mut cfg_ir.CfgProgram;
    lstate: *mut LowerState;
}

struct FnLowerSpec {
    key: cfg_ir.CfgFnKey;
    module_id: u32;
    sig: types.FnSig;
    body_id: u32;
    is_sys: bool;
    where_range: ast.IdRange;
    ensures_range: ast.IdRange;
    has_base_generic: bool;
    base_generic_key: cfg_ir.CfgFnKey;
    base_generic_args: ast.IdRange;
}

@recursive
fn lower_closure_body(
    ctx: *mut LowerCtx,
    cid: u32,
    module_id: u32,
    cl_sig: *types.FnSig,
    body_id: u32,
    generic_subst: *[types.GenericVal],
    cap_entries: *[CapEntry],
) -> cfg_ir.CfgFunction ! OutOfMemory {
    let body_sp = if let blk = ctx.arena.get_block(body_id) { blk.span } else { span.span_dummy() };
    var st = try FnBuildState.init(ctx.alloc);
    errdefer st.destroy(ctx.alloc);
    try st.sc.generic_subst.push_slice(ctx.alloc, generic_subst);

    var cb = CfgBuilder.{
        alloc: ctx.alloc,
        arena: ctx.arena,
        prog: ctx.prog,
        env: ctx.env,
        ct: ctx.ct,
        table: ctx.table,
        interner: ctx.interner,
        cfg: ctx.cfg,
        lstate: ctx.lstate,
        st: &mut st,
        key: cfg_ir.fn_key_closure(cid),
        module_id: module_id,
        sig: cl_sig.*,
        body_span: body_sp,
        is_sys: false,
        where_clauses: ast.range_empty(),
        ensures_clauses: ast.range_empty(),
        has_base_generic: false,
        base_generic_key: cfg_ir.fn_key_top_def(resolve.DEF_NONE),
        base_generic_args: ast.range_empty(),
        has_cur_bb: false,
        cur_bb: 0_u32,
        cleanup_depth: 0_u32,
        in_errdefer: false,
        has_active_err_span: false,
        active_err_span: span.span_dummy(),
        has_pool_row_is_slot: false,
        pool_row_is_slot: false,
        has_captured_self: false,
        captured_self: empty_captured_alias(),
    };
    try cb.init_entry();
    try cb.bind_params();
    var env_local: cfg_ir.LocalId = 0_u32;
    let bps = cb.st.bufs.params.as_slice();
    if bps.len > 0_usize {
        env_local = bps[0_usize];
    }
    var fi: usize = 0_usize;
    while fi < cap_entries.len {
        let ce = cap_entries[fi];
        let alias = CapturedAlias.{
            sym: ce.sym,
            env_loc: env_local,
            field_idx: fi.trunc.[u32](),
            ptr_ty: ce.cap_ptr_ty,
            inner_ty: ce.inner_ty,
        };
        if ce.is_self {
            cb.has_captured_self = true;
            cb.captured_self = alias;
        } else {
            try cb.st.sc.captured_aliases.push(ctx.alloc, alias);
        }
        fi = fi +% 1_usize;
    }
    try cb.lower_body(body_id);
    let cl_func = try cb.finish_fn();
    st.destroy(ctx.alloc);
    return cl_func;
}

impl CfgBuilder {
    fn intern_cap_ptr_ty(self: *mut Self, is_mut: bool, inner_ty: types.TyId) -> types.TyId ! OutOfMemory {
        if self.env.get(inner_ty).kind == .Pool {
            return try self.env.intern_raw_ptr(self.alloc, is_mut, inner_ty);
        }
        return try self.env.intern_borrow(self.alloc, is_mut, .Single, inner_ty);
    }

    fn ptr_ty_is_mut(self: *Self, ptr_ty: types.TyId) -> bool {
        let pn = self.env.get(ptr_ty);
        return (pn.kind == .Borrow || pn.kind == .RawPtr) && pn.flag0;
    }

    @recursive
    fn lower_closure(
        self: *mut Self,
        params_range: ast.IdRange,
        body_id: u32,
        ty: types.TyId,
        expected: types.TyId,
        sp: span.Span,
    ) -> cfg_ir.CfgOperand ! OutOfMemory {
        var raw_fn_ty = ty;
        if self.env.get(ty).kind != .FnPtr && expected != types.TY_NONE && self.env.get(expected).kind == .FnPtr {
            raw_fn_ty = expected;
        }
        let fn_ty = try self.subst(raw_fn_ty);
        let n_params = params_range.len.widen.[usize]();

        var param_tys = try col.DynBuf.[types.TyId].init(self.alloc, n_params +% 1_usize);
        errdefer param_tys.destroy(self.alloc);
        var ret_ty = types.TY_VOID;
        let fnn = self.env.get(fn_ty);
        if fnn.kind == .FnPtr {
            try param_tys.push_slice(self.alloc, self.env.node_ty_list(&fnn));
            ret_ty = fnn.primary;
        } else {
            var pi: usize = 0_usize;
            while pi < n_params {
                let pnode = arena_param_at(self.arena, params_range, pi) orelse { break; };
                let pt = try self.raw_ty_span(pnode.span);
                let use_pt = if pt != types.TY_ERROR { pt } else { types.TY_U64 };
                try param_tys.push(self.alloc, try self.subst(use_pt));
                pi = pi +% 1_usize;
            }
        }
        let final_fn_ty = try self.env.intern_fn_ptr(self.alloc, param_tys.as_slice(), ret_ty);

        var bound = try col.DynBuf.[u32].init(self.alloc, n_params +% 4_usize);
        errdefer bound.destroy(self.alloc);
        var bi: usize = 0_usize;
        while bi < n_params {
            let pnode = arena_param_at(self.arena, params_range, bi) orelse { break; };
            try bound.push(self.alloc, pnode.name.sym);
            bi = bi +% 1_usize;
        }
        var free_vars = try col.DynBuf.[FreeVar].init(self.alloc, 8_usize);
        errdefer free_vars.destroy(self.alloc);
        var uses_self = false;
        try collect_free_vars_block(
            self.alloc, self.arena, body_id, &mut bound, &mut free_vars, &mut uses_self, self.interner,
        );
        sort_free_vars(free_vars.as_mut_slice());

        var cap_entries = try col.DynBuf.[CapEntry].init(self.alloc, free_vars.len() +% 1_usize);
        errdefer cap_entries.destroy(self.alloc);
        if uses_self {
            if self.has_captured_self {
                let cs = self.captured_self;
                let cs_ptr_ty = cs.ptr_ty;
                let cs_inner_ty = cs.inner_ty;
                let outer_place = try self.make_captured_place(cs, sp);
                let is_mut = self.ptr_ty_is_mut(cs_ptr_ty);
                let cap_ptr_ty = try self.intern_cap_ptr_ty(is_mut, cs_inner_ty);
                try cap_entries.push(
                    self.alloc,
                    CapEntry.{ is_self: true, sym: span.SYM_EMPTY, outer_place: outer_place, is_mut: is_mut, cap_ptr_ty: cap_ptr_ty, inner_ty: cs_inner_ty },
                );
            } else {
                let fps = self.st.bufs.params.as_slice();
                if fps.len > 0_usize && self.local_is_self(fps[0_usize]) {
                    let sloc = fps[0_usize];
                    let inner_ty = self.local_ty(sloc);
                    let is_mut = self.local_is_mut(sloc);
                    let outer_place = try self.cfg.add_local_place(self.alloc, sloc, inner_ty, sp);
                    let cap_ptr_ty = try self.intern_cap_ptr_ty(is_mut, inner_ty);
                    try cap_entries.push(
                        self.alloc,
                        CapEntry.{ is_self: true, sym: span.SYM_EMPTY, outer_place: outer_place, is_mut: is_mut, cap_ptr_ty: cap_ptr_ty, inner_ty: inner_ty },
                    );
                }
            }
        }
        let fvs = free_vars.as_slice();
        var fi: usize = 0_usize;
        while fi < fvs.len {
            let fv = fvs[fi];
            if let outer_loc = self.lookup_local(fv.sym) {
                let inner_ty = self.local_ty(outer_loc);
                let is_mut = self.local_is_mut(outer_loc) && fv.mutated;
                let outer_place = try self.cfg.add_local_place(self.alloc, outer_loc, inner_ty, sp);
                let cap_ptr_ty = try self.intern_cap_ptr_ty(is_mut, inner_ty);
                try cap_entries.push(
                    self.alloc,
                    CapEntry.{ is_self: false, sym: fv.sym, outer_place: outer_place, is_mut: is_mut, cap_ptr_ty: cap_ptr_ty, inner_ty: inner_ty },
                );
            } else if let cap = self.lookup_captured(fv.sym) {
                let cap_ptr_orig = cap.ptr_ty;
                let cap_inner_ty = cap.inner_ty;
                let outer_place = try self.make_captured_place(cap, sp);
                let is_mut = self.ptr_ty_is_mut(cap_ptr_orig) && fv.mutated;
                let cap_ptr_ty = try self.intern_cap_ptr_ty(is_mut, cap_inner_ty);
                try cap_entries.push(
                    self.alloc,
                    CapEntry.{ is_self: false, sym: fv.sym, outer_place: outer_place, is_mut: is_mut, cap_ptr_ty: cap_ptr_ty, inner_ty: cap_inner_ty },
                );
            }
            fi = fi +% 1_usize;
        }

        let cid = self.lstate.next_closure_id;
        self.lstate.next_closure_id = cid +% 1_u32;

        var env_ptr_ty = types.TY_VOID;
        var has_env_ptr = false;
        var env_ptr_op = cfg_ir.op_none();
        let caps = cap_entries.as_slice();
        if caps.len == 0_usize {
            env_ptr_ty = try self.env.intern_raw_ptr(self.alloc, true, types.TY_VOID);
        } else {
            var ptr_tys = try col.DynBuf.[types.TyId].init(self.alloc, caps.len);
            errdefer ptr_tys.destroy(self.alloc);
            var ptr_ops = try col.DynBuf.[cfg_ir.CfgOperand].init(self.alloc, caps.len);
            errdefer ptr_ops.destroy(self.alloc);
            var ci: usize = 0_usize;
            while ci < caps.len {
                try ptr_tys.push(self.alloc, caps[ci].cap_ptr_ty);
                let pdst = try self.new_temp_place(caps[ci].cap_ptr_ty, sp);
                try self.emit_assign(sp, pdst, cfg_ir.rvalue_borrow(caps[ci].is_mut, caps[ci].outer_place));
                try ptr_ops.push(self.alloc, cfg_ir.op_copy(pdst));
                ci = ci +% 1_usize;
            }
            let env_tup_ty = try self.env.intern_tuple(self.alloc, ptr_tys.as_slice());
            let env_tup_place = try self.new_temp_place(env_tup_ty, sp);
            let agg_id = try self.cfg.add_aggregate_kind(self.alloc, cfg_ir.agg_tuple());
            let er = try self.cfg.add_operands(self.alloc, ptr_ops.as_slice());
            try self.emit_assign(sp, env_tup_place, cfg_ir.rvalue_aggregate(agg_id, er));
            env_ptr_ty = try self.env.intern_borrow(self.alloc, true, .Single, env_tup_ty);
            let env_ptr_place = try self.new_temp_place(env_ptr_ty, sp);
            try self.emit_assign(sp, env_ptr_place, cfg_ir.rvalue_borrow(true, env_tup_place));
            has_env_ptr = true;
            env_ptr_op = cfg_ir.op_copy(env_ptr_place);
            ptr_ops.destroy(self.alloc);
            ptr_tys.destroy(self.alloc);
        }

        var cl_params = try col.DynBuf.[types.ParamSig].init(self.alloc, n_params +% 1_usize);
        errdefer cl_params.destroy(self.alloc);
        try cl_params.push(self.alloc, make_param_sig_simple(span.SYM_EMPTY, sp, .None, env_ptr_ty));
        let pts = param_tys.as_slice();
        var pi2: usize = 0_usize;
        while pi2 < n_params {
            let pnode = arena_param_at(self.arena, params_range, pi2) orelse { break; };
            let pty = if pi2 < pts.len { pts[pi2] } else { types.TY_U64 };
            try cl_params.push(self.alloc, make_param_sig_simple(pnode.name.sym, pnode.span, pnode.modifier, pty));
            pi2 = pi2 +% 1_usize;
        }
        let cl_params_r = try push_env_params(self.alloc, self.env, cl_params.as_slice());
        let cl_sig = types.FnSig.{
            has_def: false,
            def_id: resolve.DEF_NONE,
            module_id: self.module_id,
            name: span.SYM_EMPTY,
            is_pub: false,
            is_view: false,
            is_comptime: false,
            is_extern: false,
            generics: ast.range_empty(),
            params: cl_params_r,
            ret: ret_ty,
            has_gpu_attr: false,
            effects: self.sig.effects,
        };

        var lctx = LowerCtx.{
            alloc: self.alloc,
            arena: self.arena,
            prog: self.prog,
            env: self.env,
            ct: self.ct,
            table: self.table,
            interner: self.interner,
            cfg: self.cfg,
            lstate: self.lstate,
        };
        let cl_func = try lower_closure_body(
            &mut lctx,
            cid,
            self.module_id,
            &cl_sig,
            body_id,
            self.st.sc.generic_subst.as_slice(),
            cap_entries.as_slice(),
        );
        try self.lstate.out_closures.push(self.alloc, cl_func);

        let dst = try self.new_temp_place(final_fn_ty, sp);
        try self.emit_assign(sp, dst, cfg_ir.rvalue_make_closure(cid, has_env_ptr, env_ptr_op, final_fn_ty));

        cl_params.destroy(self.alloc);
        cap_entries.destroy(self.alloc);
        free_vars.destroy(self.alloc);
        bound.destroy(self.alloc);
        param_tys.destroy(self.alloc);
        return self.operand_for_place(dst);
    }
}

fn lower_fn_body(
    ctx: *mut LowerCtx,
    spec: *FnLowerSpec,
    generic_subst: *[types.GenericVal],
) -> cfg_ir.CfgFunction ! OutOfMemory {
    let body_sp = if let blk = ctx.arena.get_block(spec.body_id) { blk.span } else { span.span_dummy() };
    let wc_r = try ctx.cfg.add_expr_ids(ctx.alloc, ctx.arena.expr_list_range(spec.where_range));
    let ec_r = try ctx.cfg.add_expr_ids(ctx.alloc, ctx.arena.expr_list_range(spec.ensures_range));

    var st = try FnBuildState.init(ctx.alloc);
    errdefer st.destroy(ctx.alloc);
    try st.sc.generic_subst.push_slice(ctx.alloc, generic_subst);

    var b = CfgBuilder.{
        alloc: ctx.alloc,
        arena: ctx.arena,
        prog: ctx.prog,
        env: ctx.env,
        ct: ctx.ct,
        table: ctx.table,
        interner: ctx.interner,
        cfg: ctx.cfg,
        lstate: ctx.lstate,
        st: &mut st,
        key: spec.key,
        module_id: spec.module_id,
        sig: spec.sig,
        body_span: body_sp,
        is_sys: spec.is_sys,
        where_clauses: wc_r,
        ensures_clauses: ec_r,
        has_base_generic: spec.has_base_generic,
        base_generic_key: spec.base_generic_key,
        base_generic_args: spec.base_generic_args,
        has_cur_bb: false,
        cur_bb: 0_u32,
        cleanup_depth: 0_u32,
        in_errdefer: false,
        has_active_err_span: false,
        active_err_span: span.span_dummy(),
        has_pool_row_is_slot: false,
        pool_row_is_slot: false,
        has_captured_self: false,
        captured_self: empty_captured_alias(),
    };
    try b.init_entry();
    try b.bind_params();
    try b.lower_body(spec.body_id);
    let func = try b.finish_fn();
    st.destroy(ctx.alloc);
    return func;
}

fn sort_dyn_pairs(pairs: *mut [cfg_ir.DynImplPair]) {
    let n = pairs.len;
    if n <= 1_usize {
        return;
    }
    var i: usize = 1_usize;
    while i < n {
        let cur = pairs[i];
        var j = i;
        while j > 0_usize {
            let prev = pairs[j - 1_usize];
            if prev.iface_def < cur.iface_def || (prev.iface_def == cur.iface_def && prev.concrete_ty <= cur.concrete_ty) {
                break;
            }
            pairs[j] = prev;
            j = j - 1_usize;
        }
        pairs[j] = cur;
        i = i +% 1_usize;
    }
}

fn call_inst_less(insts: *[check.CallGenericInst], a: u32, b: u32) -> bool {
    let au = a.widen.[usize]();
    let bu = b.widen.[usize]();
    if au >= insts.len || bu >= insts.len {
        return a < b;
    }
    let sa = insts[au].span;
    let sb = insts[bu].span;
    if sa.file != sb.file {
        return sa.file < sb.file;
    }
    if sa.start != sb.start {
        return sa.start < sb.start;
    }
    if sa.end != sb.end {
        return sa.end < sb.end;
    }
    return a < b;
}

fn sift_down_call_inst(
    insts: *[check.CallGenericInst],
    order: *mut [u32],
    start: usize,
    end: usize,
) {
    if end > order.len {
        return;
    }
    var root = start;
    while root < end {
        let left = (root *% 2_usize) +% 1_usize;
        if left >= end || left <= root {
            break;
        }
        var swap_idx = root;
        if swap_idx < order.len && left < order.len {
            if call_inst_less(insts, order[swap_idx], order[left]) {
                swap_idx = left;
            }
        }
        let right = left +% 1_usize;
        if right < end && right > left && right < order.len && swap_idx < order.len {
            if call_inst_less(insts, order[swap_idx], order[right]) {
                swap_idx = right;
            }
        }
        if swap_idx == root || swap_idx >= order.len || root >= order.len {
            break;
        }
        let tmp = order[root];
        order[root] = order[swap_idx];
        order[swap_idx] = tmp;
        root = swap_idx;
    }
}

fn sort_call_inst_indices(insts: *[check.CallGenericInst], order: *mut [u32]) {
    let n = order.len;
    if n <= 1_usize {
        return;
    }
    var start = n / 2_usize;
    while start > 0_usize {
        start = start - 1_usize;
        sift_down_call_inst(insts, order, start, n);
    }
    var end = n;
    while end > 1_usize {
        end = end - 1_usize;
        let tmp = order[0_usize];
        order[0_usize] = order[end];
        order[end] = tmp;
        sift_down_call_inst(insts, order, 0_usize, end);
    }
}

fn seed_dyn_pairs_and_generic_insts(
    alloc: *mut AllocCap,
    table: *check.TypeTable,
    cfg: *mut cfg_ir.CfgProgram,
) -> !OutOfMemory {
    let coers = table.meta.dyn_coercions.as_slice();
    var pairs = try col.DynBuf.[cfg_ir.DynImplPair].init(alloc, coers.len +% 1_usize);
    errdefer pairs.destroy(alloc);
    var i: usize = 0_usize;
    while i < coers.len {
        let c = coers[i];
        var exists = false;
        let ps = pairs.as_slice();
        var k: usize = 0_usize;
        while k < ps.len {
            if ps[k].iface_def == c.iface_def && ps[k].concrete_ty == c.concrete_ty {
                exists = true;
                break;
            }
            k = k +% 1_usize;
        }
        if !exists {
            try pairs.push(alloc, cfg_ir.DynImplPair.{ iface_def: c.iface_def, concrete_ty: c.concrete_ty });
        }
        i = i +% 1_usize;
    }
    sort_dyn_pairs(pairs.as_mut_slice());
    let sorted = pairs.as_slice();
    var pi: usize = 0_usize;
    while pi < sorted.len {
        try cfg.add_dyn_impl_pair(alloc, sorted[pi].iface_def, sorted[pi].concrete_ty);
        pi = pi +% 1_usize;
    }

    let insts = table.meta.call_insts.as_slice();
    var order = try col.DynBuf.[u32].init(alloc, insts.len +% 1_usize);
    errdefer order.destroy(alloc);
    var oi: usize = 0_usize;
    while oi < insts.len {
        try order.push(alloc, oi.trunc.[u32]());
        oi = oi +% 1_usize;
    }
    sort_call_inst_indices(insts, order.as_mut_slice());
    let ord = order.as_slice();
    var ii: usize = 0_usize;
    while ii < ord.len {
        let cur_idx = ord[ii].widen.[usize]();
        if cur_idx < insts.len {
            var skip_overwritten = false;
            if ii +% 1_usize < ord.len {
                let next_idx = ord[ii +% 1_usize].widen.[usize]();
                if next_idx < insts.len {
                    let s0 = insts[cur_idx].span;
                    let s1 = insts[next_idx].span;
                    if s0.file == s1.file && s0.start == s1.start && s0.end == s1.end {
                        skip_overwritten = true;
                    }
                }
            }
            if !skip_overwritten {
                let ci = insts[cur_idx];
                let fk = if ci.kind == .TopDef {
                    cfg_ir.fn_key_top_def(ci.primary)
                } else {
                    cfg_ir.fn_key_impl_method(ci.primary, ci.secondary)
                };
                let gargs = table.call_inst_args_slice(ci.args);
                if let _ = cfg.find_generic_inst(fk, gargs) {
                    // already registered
                } else {
                    let next_id = cfg.generic_inst_count();
                    try cfg.register_generic_inst(alloc, fk, gargs, next_id);
                }
            }
        }
        ii = ii +% 1_usize;
    }
    order.destroy(alloc);
    pairs.destroy(alloc);
    return;
}

fn lower_all_top_defs(ctx: *mut LowerCtx) -> !OutOfMemory {
    let empty_g_arr: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
    let empty_g = empty_g_arr[0_usize..0_usize];
    let n_defs = ctx.prog.def_count();
    var di: u32 = 0_u32;
    while di < n_defs {
        var is_target = false;
        var def_mod: u32 = 0_u32;
        var def_decl: u32 = ast.NONE_ID;
        var def_is_sys = false;
        if let def = ctx.prog.get_def(di) {
            var has_unit = false;
            if let m = ctx.prog.get_module(def.module_id) {
                has_unit = m.unit_id != resolve.UNIT_NONE;
            }
            if has_unit && (def.kind == .Fn || def.kind == .Sys) {
                is_target = true;
                def_mod = def.module_id;
                def_decl = def.decl_id;
                def_is_sys = def.kind == .Sys;
            }
        }
        if is_target {
            var has_sig = false;
            var sig = types.FnSig.{
                has_def: false,
                def_id: resolve.DEF_NONE,
                module_id: 0_u32,
                name: span.SYM_EMPTY,
                is_pub: false,
                is_view: false,
                is_comptime: false,
                is_extern: false,
                generics: ast.range_empty(),
                params: ast.range_empty(),
                ret: types.TY_VOID,
                has_gpu_attr: false,
                effects: types.effect_set_empty(),
            };
            if let s = ctx.env.get_fn(di) {
                has_sig = true;
                sig = s.*;
            }
            if has_sig {
                var has_body = false;
                var is_stub = false;
                var body_id = ast.NONE_ID;
                var where_r = ast.range_empty();
                var ensures_r = ast.range_empty();
                var mod_is_stub = false;
                if let mm = ctx.prog.get_module(def_mod) {
                    mod_is_stub = mm.is_emi_stub;
                }
                if let decl = ctx.arena.get_decl(def_decl) {
                    if !def_is_sys && decl.kind == .Fn {
                        if let f = ctx.arena.get_fn_decl(decl.payload) {
                            has_body = true;
                            body_id = f.body;
                            where_r = f.where_clauses;
                            ensures_r = f.ensures_clauses;
                            is_stub = f.is_emi_stub_body;
                        }
                    } else if def_is_sys && decl.kind == .Sys {
                        if let s = ctx.arena.get_sys_decl(decl.payload) {
                            has_body = true;
                            body_id = s.body;
                            where_r = s.where_clauses;
                            ensures_r = s.ensures_clauses;
                            is_stub = s.is_emi_stub_body;
                        }
                    }
                }
                if has_body && !is_stub && mod_is_stub {
                    if let blk = ctx.arena.get_block(body_id) {
                        if blk.stmts.len == 0_u32 && blk.tail_expr == ast.NONE_ID {
                            is_stub = true;
                        }
                    }
                }
                if has_body {
                    if is_stub {
                        let bsp = if let blk = ctx.arena.get_block(body_id) { blk.span } else { span.span_dummy() };
                        let stub_fn = cfg_ir.fn_new(cfg_ir.fn_key_top_def(di), def_mod, sig.name, bsp, sig, def_is_sys);
                        _ = try ctx.cfg.add_fn(ctx.alloc, stub_fn);
                    } else {
                        let spec = FnLowerSpec.{
                            key: cfg_ir.fn_key_top_def(di),
                            module_id: def_mod,
                            sig: sig,
                            body_id: body_id,
                            is_sys: def_is_sys,
                            where_range: where_r,
                            ensures_range: ensures_r,
                            has_base_generic: false,
                            base_generic_key: cfg_ir.fn_key_top_def(resolve.DEF_NONE),
                            base_generic_args: ast.range_empty(),
                        };
                        let func = try lower_fn_body(ctx, &spec, empty_g);
                        _ = try ctx.cfg.add_fn(ctx.alloc, func);
                    }
                }
            }
        }
        di = di +% 1_u32;
    }
    return;
}

fn lower_all_impl_methods(ctx: *mut LowerCtx) -> !OutOfMemory {
    let empty_g_arr: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
    let empty_g = empty_g_arr[0_usize..0_usize];
    let impl_count = ctx.env.decls.impls.len();
    var ii: usize = 0_usize;
    while ii < impl_count {
        var mod_id: u32 = 0_u32;
        var methods_r = ast.range_empty();
        let ims = ctx.env.decls.impls.as_slice();
        if ii < ims.len {
            mod_id = ims[ii].module_id;
            methods_r = ims[ii].methods;
        }
        var has_unit = false;
        var mod_is_stub = false;
        if let m = ctx.prog.get_module(mod_id) {
            has_unit = m.unit_id != resolve.UNIT_NONE;
            mod_is_stub = m.is_emi_stub;
        }
        if has_unit {
            var ms_copy = try col.DynBuf.[types.ImplMethodMeta].init(ctx.alloc, methods_r.len.widen.[usize]() +% 1_usize);
            errdefer ms_copy.destroy(ctx.alloc);
            try ms_copy.push_slice(ctx.alloc, ctx.env.impl_methods_range(methods_r));
            let ms = ms_copy.as_slice();
            var mi: usize = 0_usize;
            while mi < ms.len {
                let mm = ms[mi];
                var has_body = false;
                var is_stub = false;
                var body_id = ast.NONE_ID;
                var where_r = ast.range_empty();
                var ensures_r = ast.range_empty();
                if let sub_decl = ctx.arena.get_decl(mm.decl_id) {
                    if sub_decl.kind == .Fn {
                        if let f = ctx.arena.get_fn_decl(sub_decl.payload) {
                            has_body = true;
                            body_id = f.body;
                            where_r = f.where_clauses;
                            ensures_r = f.ensures_clauses;
                            is_stub = f.is_emi_stub_body;
                        }
                    }
                }
                if has_body && !is_stub && mod_is_stub {
                    if let blk = ctx.arena.get_block(body_id) {
                        if blk.stmts.len == 0_u32 && blk.tail_expr == ast.NONE_ID {
                            is_stub = true;
                        }
                    }
                }
                if has_body {
                    if is_stub {
                        let bsp = if let blk = ctx.arena.get_block(body_id) { blk.span } else { span.span_dummy() };
                        let stub_fn = cfg_ir.fn_new(cfg_ir.fn_key_impl_method(ii.trunc.[u32](), mm.sub_idx), mod_id, mm.sig.name, bsp, mm.sig, false);
                        _ = try ctx.cfg.add_fn(ctx.alloc, stub_fn);
                    } else {
                        let spec = FnLowerSpec.{
                            key: cfg_ir.fn_key_impl_method(ii.trunc.[u32](), mm.sub_idx),
                            module_id: mod_id,
                            sig: mm.sig,
                            body_id: body_id,
                            is_sys: false,
                            where_range: where_r,
                            ensures_range: ensures_r,
                            has_base_generic: false,
                            base_generic_key: cfg_ir.fn_key_top_def(resolve.DEF_NONE),
                            base_generic_args: ast.range_empty(),
                        };
                        let func = try lower_fn_body(ctx, &spec, empty_g);
                        _ = try ctx.cfg.add_fn(ctx.alloc, func);
                    }
                }
                mi = mi +% 1_usize;
            }
            ms_copy.destroy(ctx.alloc);
        }
        ii = ii +% 1_usize;
    }
    return;
}

fn drain_generic_insts(ctx: *mut LowerCtx) -> !OutOfMemory {
    var cursor: u32 = 0_u32;
    while cursor < ctx.cfg.generic_inst_count() {
        var entry = cfg_ir.GenericInstEntry.{
            base_key: cfg_ir.fn_key_top_def(resolve.DEF_NONE),
            gargs: ast.range_empty(),
            inst_id: 0_u32,
        };
        let all_insts = ctx.cfg.generic_insts_slice();
        let ci = cursor.widen.[usize]();
        if ci < all_insts.len {
            entry = all_insts[ci];
        }
        cursor = cursor +% 1_u32;

        var gargs = try col.DynBuf.[types.GenericVal].init(ctx.alloc, entry.gargs.len.widen.[usize]() +% 1_usize);
        errdefer gargs.destroy(ctx.alloc);
        try gargs.push_slice(ctx.alloc, ctx.cfg.gvals_slice(entry.gargs));

        var found = false;
        var def_mod: u32 = 0_u32;
        var sig = types.FnSig.{
            has_def: false,
            def_id: resolve.DEF_NONE,
            module_id: 0_u32,
            name: span.SYM_EMPTY,
            is_pub: false,
            is_view: false,
            is_comptime: false,
            is_extern: false,
            generics: ast.range_empty(),
            params: ast.range_empty(),
            ret: types.TY_VOID,
            has_gpu_attr: false,
            effects: types.effect_set_empty(),
        };
        var body_id = ast.NONE_ID;
        var where_r = ast.range_empty();
        var ensures_r = ast.range_empty();

        if entry.base_key.kind == .TopDef {
            let def_id = entry.base_key.a;
            if let def = ctx.prog.get_def(def_id) {
                var has_unit = false;
                if let m = ctx.prog.get_module(def.module_id) {
                    has_unit = m.unit_id != resolve.UNIT_NONE;
                }
                if has_unit && def.kind == .Fn {
                    if let s = ctx.env.get_fn(def_id) {
                        if let decl = ctx.arena.get_decl(def.decl_id) {
                            if decl.kind == .Fn {
                                if let f = ctx.arena.get_fn_decl(decl.payload) {
                                    found = true;
                                    def_mod = def.module_id;
                                    sig = s.*;
                                    body_id = f.body;
                                    where_r = f.where_clauses;
                                    ensures_r = f.ensures_clauses;
                                }
                            }
                        }
                    }
                }
            }
        } else if entry.base_key.kind == .ImplMethod {
            let impl_idx = entry.base_key.a.widen.[usize]();
            let sub_idx = entry.base_key.b;
            let ims = ctx.env.decls.impls.as_slice();
            if impl_idx < ims.len {
                let im = ims[impl_idx];
                var has_unit = false;
                if let m = ctx.prog.get_module(im.module_id) {
                    has_unit = m.unit_id != resolve.UNIT_NONE;
                }
                if has_unit {
                    let ms = ctx.env.impl_methods_range(im.methods);
                    var mi: usize = 0_usize;
                    while mi < ms.len {
                        if ms[mi].sub_idx == sub_idx {
                            if let sub_decl = ctx.arena.get_decl(ms[mi].decl_id) {
                                if sub_decl.kind == .Fn {
                                    if let f = ctx.arena.get_fn_decl(sub_decl.payload) {
                                        found = true;
                                        def_mod = im.module_id;
                                        sig = ms[mi].sig;
                                        body_id = f.body;
                                        where_r = f.where_clauses;
                                        ensures_r = f.ensures_clauses;
                                    }
                                }
                            }
                            break;
                        }
                        mi = mi +% 1_usize;
                    }
                }
            }
        }

        if !found {
            gargs.destroy(ctx.alloc);
            continue;
        }

        var sub_params = try col.DynBuf.[types.ParamSig].init(ctx.alloc, sig.params.len.widen.[usize]() +% 1_usize);
        errdefer sub_params.destroy(ctx.alloc);
        try sub_params.push_slice(ctx.alloc, ctx.env.params_range(sig.params));
        let sp_mut = sub_params.as_mut_slice();
        var pi: usize = 0_usize;
        while pi < sp_mut.len {
            sp_mut[pi].ty = try check.subst_ty(ctx.alloc, ctx.env, sp_mut[pi].ty, gargs.as_slice());
            pi = pi +% 1_usize;
        }
        sig.params = try push_env_params(ctx.alloc, ctx.env, sub_params.as_slice());
        sig.ret = try check.subst_ty(ctx.alloc, ctx.env, sig.ret, gargs.as_slice());
        sig.generics = ast.range_empty();

        let spec = FnLowerSpec.{
            key: cfg_ir.fn_key_generic_inst(entry.inst_id),
            module_id: def_mod,
            sig: sig,
            body_id: body_id,
            is_sys: false,
            where_range: where_r,
            ensures_range: ensures_r,
            has_base_generic: true,
            base_generic_key: entry.base_key,
            base_generic_args: entry.gargs,
        };
        let func = try lower_fn_body(ctx, &spec, gargs.as_slice());
        _ = try ctx.cfg.add_fn(ctx.alloc, func);
        sub_params.destroy(ctx.alloc);
        gargs.destroy(ctx.alloc);
    }
    return;
}

pub fn lower_program(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    unit_ids: *[u32],
    prog: *resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    ct: *ctvm.CtArena,
    table: *check.TypeTable,
    interner: *mut span.SymInterner,
) -> cfg_ir.CfgProgram ! OutOfMemory {
    return try lower_program_with_jobs(
        alloc, arena, unit_ids, prog, env, ct, table, interner, 0_u32,
    );
}

struct CfgWorkItem {
    is_stub: bool;
    spec: FnLowerSpec;
    stub_span: span.Span;
    weight: u32;
    gargs_start: u32;
    gargs_len: u32;
}

struct CfgWorkResult {
    has_result: bool;
    worker_id: u32;
    local_fn_idx: u32;
    call_start: u32;
    call_count: u32;
    cl_buf_start: u32;
    cl_buf_count: u32;
    cl_cid_start: u32;
    cl_cid_count: u32;
    sched_start: u32;
    sched_count: u32;
}

fn cfg_work_result_empty() -> CfgWorkResult {
    return CfgWorkResult.{
        has_result: false,
        worker_id: 0_u32,
        local_fn_idx: 0_u32,
        call_start: 0_u32,
        call_count: 0_u32,
        cl_buf_start: 0_u32,
        cl_buf_count: 0_u32,
        cl_cid_start: 0_u32,
        cl_cid_count: 0_u32,
        sched_start: 0_u32,
        sched_count: 0_u32,
    };
}

linear struct WorkerCfgState {
    env: types.TypeEnv;
    cfg: cfg_ir.CfgProgram;
    lstate: LowerState;
    out_fns: col.DynBuf[cfg_ir.CfgFunction];
    rm: cfg_ir.CfgWaveRemap;
    off: cfg_ir.CfgPoolOffsets;
    oom: bool;
}

impl WorkerCfgState {
    fn init(
        alloc: *mut AllocCap,
        src_env: *types.TypeEnv,
        src_cfg: *cfg_ir.CfgProgram,
        active: bool,
    ) -> WorkerCfgState ! OutOfMemory {
        let env = if active {
            try src_env.clone_for_worker(alloc)
        } else {
            try types.TypeEnv.init(alloc)
        };
        errdefer env.destroy(alloc);
        var cfg = try cfg_ir.CfgProgram.init(alloc);
        errdefer cfg.destroy(alloc);
        if active {
            try cfg.seed_generic_insts_from(alloc, src_cfg);
        }
        let lstate = try LowerState.init(alloc);
        errdefer lstate.destroy(alloc);
        let out_fns = try col.DynBuf.[cfg_ir.CfgFunction].init(alloc, 32_usize);
        errdefer out_fns.destroy(alloc);
        let rm = try cfg_ir.CfgWaveRemap.init(alloc);
        let off = cfg_ir.cfg_pool_offsets_from(&cfg, 0_u32);
        return WorkerCfgState.{
            env: env,
            cfg: cfg,
            lstate: lstate,
            out_fns: out_fns,
            rm: rm,
            off: off,
            oom: false,
        };
    }

    fn destroy(self: WorkerCfgState, alloc: *mut AllocCap) {
        let WorkerCfgState.{ env, cfg, lstate, out_fns, rm, off, oom } = self;
        _ = off;
        _ = oom;
        rm.destroy(alloc);
        out_fns.destroy(alloc);
        lstate.destroy(alloc);
        cfg.destroy(alloc);
        env.destroy(alloc);
    }

    fn sync_for_wave(
        self: *mut Self,
        alloc: *mut AllocCap,
        src_env: *types.TypeEnv,
        src_cfg: *cfg_ir.CfgProgram,
    ) -> !OutOfMemory {
        self.cfg.clear_all();
        try self.cfg.seed_generic_insts_from(alloc, src_cfg);
        try self.env.sync_intern_and_params_from(alloc, src_env);
        self.lstate.out_closures.clear();
        self.lstate.next_closure_id = 0_u32;
        self.out_fns.clear();
        self.oom = false;
        return;
    }
}

fn sort_cfg_work_order_desc(order: *mut [u32], items: *[CfgWorkItem]) {
    let n = order.len;
    if n <= 1_usize {
        return;
    }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third {
        gap = (gap *% 3_usize) +% 1_usize;
    }
    while gap > 0_usize {
        var i = gap;
        while i < order.len {
            let idx = order[i];
            let iu = idx.widen.[usize]();
            let wi = if iu < items.len { items[iu].weight } else { 0_u32 };
            var j = i;
            while j >= gap && j < order.len {
                let prev = j - gap;
                let pidx = order[prev];
                let pu = pidx.widen.[usize]();
                let wp = if pu < items.len { items[pu].weight } else { 0_u32 };
                if wp > wi || (wp == wi && pidx < idx) {
                    break;
                }
                order[j] = pidx;
                j = prev;
            }
            order[j] = idx;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

fn block_work_weight(arena: *ast.AstArena, body_id: u32) -> u32 {
    if let blk = arena.get_block(body_id) {
        return blk.stmts.len +% 1_u32;
    }
    return 1_u32;
}

fn collect_wave0_work_items(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    out_items: *mut col.DynBuf[CfgWorkItem],
) -> usize ! OutOfMemory {
    var non_stub: usize = 0_usize;
    let n_defs = prog.def_count();
    var di: u32 = 0_u32;
    while di < n_defs {
        var is_target = false;
        var def_mod: u32 = 0_u32;
        var def_decl: u32 = ast.NONE_ID;
        var def_is_sys = false;
        if let def = prog.get_def(di) {
            var has_unit = false;
            if let m = prog.get_module(def.module_id) {
                has_unit = m.unit_id != resolve.UNIT_NONE;
            }
            if has_unit && (def.kind == .Fn || def.kind == .Sys) {
                is_target = true;
                def_mod = def.module_id;
                def_decl = def.decl_id;
                def_is_sys = def.kind == .Sys;
            }
        }
        if is_target {
            var has_sig = false;
            var sig = types.FnSig.{
                has_def: false,
                def_id: resolve.DEF_NONE,
                module_id: 0_u32,
                name: span.SYM_EMPTY,
                is_pub: false,
                is_view: false,
                is_comptime: false,
                is_extern: false,
                generics: ast.range_empty(),
                params: ast.range_empty(),
                ret: types.TY_VOID,
                has_gpu_attr: false,
                effects: types.effect_set_empty(),
            };
            if let s = env.get_fn(di) {
                has_sig = true;
                sig = s.*;
            }
            if has_sig {
                var has_body = false;
                var is_stub = false;
                var body_id = ast.NONE_ID;
                var where_r = ast.range_empty();
                var ensures_r = ast.range_empty();
                var mod_is_stub = false;
                if let mm = prog.get_module(def_mod) {
                    mod_is_stub = mm.is_emi_stub;
                }
                if let decl = arena.get_decl(def_decl) {
                    if !def_is_sys && decl.kind == .Fn {
                        if let f = arena.get_fn_decl(decl.payload) {
                            has_body = true;
                            body_id = f.body;
                            where_r = f.where_clauses;
                            ensures_r = f.ensures_clauses;
                            is_stub = f.is_emi_stub_body;
                        }
                    } else if def_is_sys && decl.kind == .Sys {
                        if let s = arena.get_sys_decl(decl.payload) {
                            has_body = true;
                            body_id = s.body;
                            where_r = s.where_clauses;
                            ensures_r = s.ensures_clauses;
                            is_stub = s.is_emi_stub_body;
                        }
                    }
                }
                if has_body && !is_stub && mod_is_stub {
                    if let blk = arena.get_block(body_id) {
                        if blk.stmts.len == 0_u32 && blk.tail_expr == ast.NONE_ID {
                            is_stub = true;
                        }
                    }
                }
                if has_body {
                    let bsp = if let blk = arena.get_block(body_id) { blk.span } else { span.span_dummy() };
                    let w = if is_stub { 0_u32 } else { block_work_weight(arena, body_id) };
                    if !is_stub {
                        non_stub = non_stub +% 1_usize;
                    }
                    try out_items.push(
                        alloc,
                        CfgWorkItem.{
                            is_stub: is_stub,
                            spec: FnLowerSpec.{
                                key: cfg_ir.fn_key_top_def(di),
                                module_id: def_mod,
                                sig: sig,
                                body_id: body_id,
                                is_sys: def_is_sys,
                                where_range: where_r,
                                ensures_range: ensures_r,
                                has_base_generic: false,
                                base_generic_key: cfg_ir.fn_key_top_def(resolve.DEF_NONE),
                                base_generic_args: ast.range_empty(),
                            },
                            stub_span: bsp,
                            weight: w,
                            gargs_start: 0_u32,
                            gargs_len: 0_u32,
                        },
                    );
                }
            }
        }
        di = di +% 1_u32;
    }

    let impl_count = env.decls.impls.len();
    var ii: usize = 0_usize;
    while ii < impl_count {
        var mod_id: u32 = 0_u32;
        var methods_r = ast.range_empty();
        let ims = env.decls.impls.as_slice();
        if ii < ims.len {
            mod_id = ims[ii].module_id;
            methods_r = ims[ii].methods;
        }
        var has_unit = false;
        var mod_is_stub = false;
        if let m = prog.get_module(mod_id) {
            has_unit = m.unit_id != resolve.UNIT_NONE;
            mod_is_stub = m.is_emi_stub;
        }
        if has_unit {
            let ms = env.impl_methods_range(methods_r);
            var mi: usize = 0_usize;
            while mi < ms.len {
                let mm = ms[mi];
                var has_body = false;
                var is_stub = false;
                var body_id = ast.NONE_ID;
                var where_r = ast.range_empty();
                var ensures_r = ast.range_empty();
                if let sub_decl = arena.get_decl(mm.decl_id) {
                    if sub_decl.kind == .Fn {
                        if let f = arena.get_fn_decl(sub_decl.payload) {
                            has_body = true;
                            body_id = f.body;
                            where_r = f.where_clauses;
                            ensures_r = f.ensures_clauses;
                            is_stub = f.is_emi_stub_body;
                        }
                    }
                }
                if has_body && !is_stub && mod_is_stub {
                    if let blk = arena.get_block(body_id) {
                        if blk.stmts.len == 0_u32 && blk.tail_expr == ast.NONE_ID {
                            is_stub = true;
                        }
                    }
                }
                if has_body {
                    let bsp = if let blk = arena.get_block(body_id) { blk.span } else { span.span_dummy() };
                    let w = if is_stub { 0_u32 } else { block_work_weight(arena, body_id) };
                    if !is_stub {
                        non_stub = non_stub +% 1_usize;
                    }
                    try out_items.push(
                        alloc,
                        CfgWorkItem.{
                            is_stub: is_stub,
                            spec: FnLowerSpec.{
                                key: cfg_ir.fn_key_impl_method(ii.trunc.[u32](), mm.sub_idx),
                                module_id: mod_id,
                                sig: mm.sig,
                                body_id: body_id,
                                is_sys: false,
                                where_range: where_r,
                                ensures_range: ensures_r,
                                has_base_generic: false,
                                base_generic_key: cfg_ir.fn_key_top_def(resolve.DEF_NONE),
                                base_generic_args: ast.range_empty(),
                            },
                            stub_span: bsp,
                            weight: w,
                            gargs_start: 0_u32,
                            gargs_len: 0_u32,
                        },
                    );
                }
                mi = mi +% 1_usize;
            }
        }
        ii = ii +% 1_usize;
    }
    return non_stub;
}

fn collect_generic_wave_items(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    cfg: *cfg_ir.CfgProgram,
    cursor_start: u32,
    cursor_end: u32,
    out_items: *mut col.DynBuf[CfgWorkItem],
    out_gvals: *mut col.DynBuf[types.GenericVal],
) -> !OutOfMemory {
    var cursor = cursor_start;
    while cursor < cursor_end {
        var entry = cfg_ir.GenericInstEntry.{
            base_key: cfg_ir.fn_key_top_def(resolve.DEF_NONE),
            gargs: ast.range_empty(),
            inst_id: 0_u32,
        };
        let all_insts = cfg.generic_insts_slice();
        let ci = cursor.widen.[usize]();
        if ci < all_insts.len {
            entry = all_insts[ci];
        }
        cursor = cursor +% 1_u32;

        var gargs = try col.DynBuf.[types.GenericVal].init(alloc, entry.gargs.len.widen.[usize]() +% 1_usize);
        errdefer gargs.destroy(alloc);
        try gargs.push_slice(alloc, cfg.gvals_slice(entry.gargs));

        var found = false;
        var def_mod: u32 = 0_u32;
        var sig = types.FnSig.{
            has_def: false,
            def_id: resolve.DEF_NONE,
            module_id: 0_u32,
            name: span.SYM_EMPTY,
            is_pub: false,
            is_view: false,
            is_comptime: false,
            is_extern: false,
            generics: ast.range_empty(),
            params: ast.range_empty(),
            ret: types.TY_VOID,
            has_gpu_attr: false,
            effects: types.effect_set_empty(),
        };
        var body_id = ast.NONE_ID;
        var where_r = ast.range_empty();
        var ensures_r = ast.range_empty();

        if entry.base_key.kind == .TopDef {
            let def_id = entry.base_key.a;
            if let def = prog.get_def(def_id) {
                var has_unit = false;
                if let m = prog.get_module(def.module_id) {
                    has_unit = m.unit_id != resolve.UNIT_NONE;
                }
                if has_unit && def.kind == .Fn {
                    if let s = env.get_fn(def_id) {
                        if let decl = arena.get_decl(def.decl_id) {
                            if decl.kind == .Fn {
                                if let f = arena.get_fn_decl(decl.payload) {
                                    found = true;
                                    def_mod = def.module_id;
                                    sig = s.*;
                                    body_id = f.body;
                                    where_r = f.where_clauses;
                                    ensures_r = f.ensures_clauses;
                                }
                            }
                        }
                    }
                }
            }
        } else if entry.base_key.kind == .ImplMethod {
            let impl_idx = entry.base_key.a.widen.[usize]();
            let sub_idx = entry.base_key.b;
            let ims = env.decls.impls.as_slice();
            if impl_idx < ims.len {
                let im = ims[impl_idx];
                var has_unit = false;
                if let m = prog.get_module(im.module_id) {
                    has_unit = m.unit_id != resolve.UNIT_NONE;
                }
                if has_unit {
                    let ms = env.impl_methods_range(im.methods);
                    var mi: usize = 0_usize;
                    while mi < ms.len {
                        if ms[mi].sub_idx == sub_idx {
                            if let sub_decl = arena.get_decl(ms[mi].decl_id) {
                                if sub_decl.kind == .Fn {
                                    if let f = arena.get_fn_decl(sub_decl.payload) {
                                        found = true;
                                        def_mod = im.module_id;
                                        sig = ms[mi].sig;
                                        body_id = f.body;
                                        where_r = f.where_clauses;
                                        ensures_r = f.ensures_clauses;
                                    }
                                }
                            }
                            break;
                        }
                        mi = mi +% 1_usize;
                    }
                }
            }
        }

        if !found {
            gargs.destroy(alloc);
            continue;
        }

        var sub_params = try col.DynBuf.[types.ParamSig].init(alloc, sig.params.len.widen.[usize]() +% 1_usize);
        errdefer sub_params.destroy(alloc);
        try sub_params.push_slice(alloc, env.params_range(sig.params));
        let sp_mut = sub_params.as_mut_slice();
        var pi: usize = 0_usize;
        while pi < sp_mut.len {
            sp_mut[pi].ty = try check.subst_ty(alloc, env, sp_mut[pi].ty, gargs.as_slice());
            pi = pi +% 1_usize;
        }
        sig.params = try push_env_params(alloc, env, sub_params.as_slice());
        sig.ret = try check.subst_ty(alloc, env, sig.ret, gargs.as_slice());
        sig.generics = ast.range_empty();

        let gs_start = out_gvals.len().trunc.[u32]();
        let gs_len = gargs.len().trunc.[u32]();
        try out_gvals.push_slice(alloc, gargs.as_slice());

        try out_items.push(
            alloc,
            CfgWorkItem.{
                is_stub: false,
                spec: FnLowerSpec.{
                    key: cfg_ir.fn_key_generic_inst(entry.inst_id),
                    module_id: def_mod,
                    sig: sig,
                    body_id: body_id,
                    is_sys: false,
                    where_range: where_r,
                    ensures_range: ensures_r,
                    has_base_generic: true,
                    base_generic_key: entry.base_key,
                    base_generic_args: entry.gargs,
                },
                stub_span: span.span_dummy(),
                weight: block_work_weight(arena, body_id),
                gargs_start: gs_start,
                gargs_len: gs_len,
            },
        );
        sub_params.destroy(alloc);
        gargs.destroy(alloc);
    }
    return;
}

fn cfg_worker_loop(
    wid: u32,
    need_sync: bool,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    order: *[u32],
    items: *[CfgWorkItem],
    wave_gvals: *[types.GenericVal],
    results: *mut [CfgWorkResult],
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    main_env: *types.TypeEnv,
    main_cfg: *cfg_ir.CfgProgram,
    ct: *ctvm.CtArena,
    table: *check.TypeTable,
    interner: *span.SymInterner,
    w: *mut WorkerCfgState,
) -> !OutOfMemory {
    if need_sync {
        try w.sync_for_wave(alloc, main_env, main_cfg);
    }
    let empty_g_arr: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
    let empty_g = empty_g_arr[0_usize..0_usize];
    while true {
        let pos = next_pos.fetch_add(1_u64, .AcqRel).trunc.[usize]();
        if pos >= order.len {
            break;
        }
        let item_idx = order[pos].widen.[usize]();
        if item_idx >= items.len {
            continue;
        }
        let it = items[item_idx];
        var wspec = it.spec;
        wspec.base_generic_args = ast.range_empty();
        let gargs_slice = if it.gargs_len > 0_u32 {
            let gs = it.gargs_start.widen.[usize]();
            let ge = gs +% it.gargs_len.widen.[usize]();
            wave_gvals.sub(gs, ge) catch empty_g
        } else {
            empty_g
        };
        let call_start = w.cfg.exprs.calls.len().trunc.[u32]();
        let cl_buf_start = w.lstate.out_closures.len().trunc.[u32]();
        let cl_cid_start = w.lstate.next_closure_id;
        let sched_start = w.cfg.schedule_count();

        var lctx = LowerCtx.{
            alloc: alloc,
            arena: arena,
            prog: prog,
            env: &mut w.env,
            ct: ct,
            table: table,
            interner: interner,
            cfg: &mut w.cfg,
            lstate: &mut w.lstate,
        };
        let func = try lower_fn_body(&mut lctx, &wspec, gargs_slice);
        let local_fn_idx = w.out_fns.len().trunc.[u32]();
        try w.out_fns.push(alloc, func);

        let call_count = w.cfg.exprs.calls.len().trunc.[u32]() -% call_start;
        let cl_buf_count = w.lstate.out_closures.len().trunc.[u32]() -% cl_buf_start;
        let cl_cid_count = w.lstate.next_closure_id -% cl_cid_start;
        let sched_count = w.cfg.schedule_count() -% sched_start;
        if item_idx < results.len {
            results[item_idx] = CfgWorkResult.{
                has_result: true,
                worker_id: wid,
                local_fn_idx: local_fn_idx,
                call_start: call_start,
                call_count: call_count,
                cl_buf_start: cl_buf_start,
                cl_buf_count: cl_buf_count,
                cl_cid_start: cl_cid_start,
                cl_cid_count: cl_cid_count,
                sched_start: sched_start,
                sched_count: sched_count,
            };
        }
    }
    return;
}

fn run_cfg_worker_entry(
    wid: u32,
    need_sync: bool,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    order: *[u32],
    items: *[CfgWorkItem],
    wave_gvals: *[types.GenericVal],
    results: *mut [CfgWorkResult],
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    main_env: *types.TypeEnv,
    main_cfg: *cfg_ir.CfgProgram,
    ct: *ctvm.CtArena,
    table: *check.TypeTable,
    interner: *span.SymInterner,
    w: *mut WorkerCfgState,
) {
    cfg_worker_loop(
        wid, need_sync, alloc, next_pos, order, items, wave_gvals, results,
        arena, prog, main_env, main_cfg, ct, table, interner, w,
    ) catch {
        w.oom = true;
    };
}

fn dispatch_cfg_wave_workers(
    n_workers: usize,
    need_sync: bool,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    order: *[u32],
    items: *[CfgWorkItem],
    wave_gvals: *[types.GenericVal],
    results: *mut [CfgWorkResult],
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    main_env: *types.TypeEnv,
    main_cfg: *cfg_ir.CfgProgram,
    ct: *ctvm.CtArena,
    table: *check.TypeTable,
    interner: *span.SymInterner,
    w0: *mut WorkerCfgState,
    w1: *mut WorkerCfgState,
    w2: *mut WorkerCfgState,
    w3: *mut WorkerCfgState,
    w4: *mut WorkerCfgState,
    w5: *mut WorkerCfgState,
    w6: *mut WorkerCfgState,
    w7: *mut WorkerCfgState,
    w8: *mut WorkerCfgState,
    w9: *mut WorkerCfgState,
    w10: *mut WorkerCfgState,
    w11: *mut WorkerCfgState,
) {
    if n_workers <= 1_usize {
        run_cfg_worker_entry(
            0_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results,
            arena, prog, main_env, main_cfg, ct, table, interner, w0,
        );
        return;
    }
    par for wi in 0_usize..n_workers {
        if wi == 0_usize { run_cfg_worker_entry(0_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w0); }
        else if wi == 1_usize { run_cfg_worker_entry(1_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w1); }
        else if wi == 2_usize { run_cfg_worker_entry(2_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w2); }
        else if wi == 3_usize { run_cfg_worker_entry(3_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w3); }
        else if wi == 4_usize { run_cfg_worker_entry(4_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w4); }
        else if wi == 5_usize { run_cfg_worker_entry(5_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w5); }
        else if wi == 6_usize { run_cfg_worker_entry(6_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w6); }
        else if wi == 7_usize { run_cfg_worker_entry(7_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w7); }
        else if wi == 8_usize { run_cfg_worker_entry(8_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w8); }
        else if wi == 9_usize { run_cfg_worker_entry(9_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w9); }
        else if wi == 10_usize { run_cfg_worker_entry(10_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w10); }
        else if wi == 11_usize { run_cfg_worker_entry(11_u32, need_sync, alloc, next_pos, order, items, wave_gvals, results, arena, prog, main_env, main_cfg, ct, table, interner, w11); }
    }
}

fn check_cfg_workers_oom(
    w0: *WorkerCfgState,
    w1: *WorkerCfgState,
    w2: *WorkerCfgState,
    w3: *WorkerCfgState,
    w4: *WorkerCfgState,
    w5: *WorkerCfgState,
    w6: *WorkerCfgState,
    w7: *WorkerCfgState,
    w8: *WorkerCfgState,
    w9: *WorkerCfgState,
    w10: *WorkerCfgState,
    w11: *WorkerCfgState,
) -> !OutOfMemory {
    if w0.oom || w1.oom || w2.oom || w3.oom || w4.oom || w5.oom
        || w6.oom || w7.oom || w8.oom || w9.oom || w10.oom || w11.oom
    {
        return OutOfMemory;
    }
    return;
}

fn prepare_single_worker_remap(
    alloc: *mut AllocCap,
    base_ty_count: u32,
    base_inst_count: u32,
    w: *mut WorkerCfgState,
) -> !OutOfMemory {
    try w.rm.prepare(
        alloc,
        base_ty_count,
        w.env.ty_count(),
        base_inst_count,
        w.cfg.generic_inst_count(),
        w.lstate.next_closure_id,
        w.cfg.schedule_count(),
    );
    return;
}

fn assign_single_worker_item_ids(
    alloc: *mut AllocCap,
    res: *CfgWorkResult,
    base_ty_count: u32,
    base_inst_count: u32,
    w: *mut WorkerCfgState,
    main_env: *mut types.TypeEnv,
    main_cfg: *mut cfg_ir.CfgProgram,
    main_lstate: *mut LowerState,
) -> !OutOfMemory {
    if res.cl_cid_count > 0_u32 {
        let dst_cid = main_lstate.next_closure_id;
        main_lstate.next_closure_id = dst_cid +% res.cl_cid_count;
        let cm = w.rm.cl_cid_map.as_mut_slice();
        var k: u32 = 0_u32;
        while k < res.cl_cid_count {
            let si = (res.cl_cid_start +% k).widen.[usize]();
            if si < cm.len {
                cm[si] = dst_cid +% k;
            }
            k = k +% 1_u32;
        }
    }
    if res.sched_count > 0_u32 {
        let dst_sid = try cfg_ir.copy_cfg_schedules_range(
            alloc, &w.cfg, res.sched_start, res.sched_count, main_cfg,
        );
        let sm = w.rm.sched_map.as_mut_slice();
        var k: u32 = 0_u32;
        while k < res.sched_count {
            let si = (res.sched_start +% k).widen.[usize]();
            if si < sm.len {
                sm[si] = dst_sid +% k;
            }
            k = k +% 1_u32;
        }
    }
    try cfg_ir.register_worker_call_insts_range(
        alloc, &w.cfg, res.call_start, res.call_count,
        base_ty_count, base_inst_count, &w.env, main_env, &mut w.rm, main_cfg,
    );
    return;
}

fn assign_item_ids_dispatch(
    alloc: *mut AllocCap,
    res: *CfgWorkResult,
    base_ty_count: u32,
    base_inst_count: u32,
    main_env: *mut types.TypeEnv,
    main_cfg: *mut cfg_ir.CfgProgram,
    main_lstate: *mut LowerState,
    w0: *mut WorkerCfgState,
    w1: *mut WorkerCfgState,
    w2: *mut WorkerCfgState,
    w3: *mut WorkerCfgState,
    w4: *mut WorkerCfgState,
    w5: *mut WorkerCfgState,
    w6: *mut WorkerCfgState,
    w7: *mut WorkerCfgState,
    w8: *mut WorkerCfgState,
    w9: *mut WorkerCfgState,
    w10: *mut WorkerCfgState,
    w11: *mut WorkerCfgState,
) -> !OutOfMemory {
    let wid = res.worker_id;
    if wid == 0_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w0, main_env, main_cfg, main_lstate); }
    else if wid == 1_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w1, main_env, main_cfg, main_lstate); }
    else if wid == 2_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w2, main_env, main_cfg, main_lstate); }
    else if wid == 3_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w3, main_env, main_cfg, main_lstate); }
    else if wid == 4_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w4, main_env, main_cfg, main_lstate); }
    else if wid == 5_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w5, main_env, main_cfg, main_lstate); }
    else if wid == 6_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w6, main_env, main_cfg, main_lstate); }
    else if wid == 7_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w7, main_env, main_cfg, main_lstate); }
    else if wid == 8_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w8, main_env, main_cfg, main_lstate); }
    else if wid == 9_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w9, main_env, main_cfg, main_lstate); }
    else if wid == 10_u32 { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w10, main_env, main_cfg, main_lstate); }
    else { try assign_single_worker_item_ids(alloc, res, base_ty_count, base_inst_count, w11, main_env, main_cfg, main_lstate); }
    return;
}

fn assign_worker_pool_offset(
    cur: *mut cfg_ir.CfgPoolOffsets,
    base_env_params: u32,
    w: *mut WorkerCfgState,
) {
    w.off = cur.*;
    let total_ep = w.env.sigs.params.len().trunc.[u32]();
    let new_ep = if total_ep > base_env_params { total_ep -% base_env_params } else { 0_u32 };
    cfg_ir.cfg_pool_offsets_advance(cur, &w.cfg, new_ep);
}

fn fixup_single_worker(
    main_env: *types.TypeEnv,
    base_ty_count: u32,
    base_env_params: u32,
    base_inst_count: u32,
    w: *mut WorkerCfgState,
) {
    let off = w.off;
    cfg_ir.fixup_worker_cfg_inplace(
        &mut w.cfg,
        w.env.sigs.params.as_mut_slice(),
        w.out_fns.as_mut_slice(),
        w.lstate.out_closures.as_mut_slice(),
        main_env,
        &off,
        base_ty_count,
        base_env_params,
        base_inst_count,
        &w.rm,
    );
}

fn dispatch_cfg_fixup_workers(
    n_wave: usize,
    main_env: *types.TypeEnv,
    base_ty_count: u32,
    base_env_params: u32,
    base_inst_count: u32,
    w0: *mut WorkerCfgState,
    w1: *mut WorkerCfgState,
    w2: *mut WorkerCfgState,
    w3: *mut WorkerCfgState,
    w4: *mut WorkerCfgState,
    w5: *mut WorkerCfgState,
    w6: *mut WorkerCfgState,
    w7: *mut WorkerCfgState,
    w8: *mut WorkerCfgState,
    w9: *mut WorkerCfgState,
    w10: *mut WorkerCfgState,
    w11: *mut WorkerCfgState,
) {
    if n_wave <= 1_usize {
        fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w0);
        return;
    }
    par for wi in 0_usize..n_wave {
        if wi == 0_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w0); }
        else if wi == 1_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w1); }
        else if wi == 2_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w2); }
        else if wi == 3_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w3); }
        else if wi == 4_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w4); }
        else if wi == 5_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w5); }
        else if wi == 6_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w6); }
        else if wi == 7_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w7); }
        else if wi == 8_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w8); }
        else if wi == 9_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w9); }
        else if wi == 10_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w10); }
        else if wi == 11_usize { fixup_single_worker(main_env, base_ty_count, base_env_params, base_inst_count, w11); }
    }
}

fn commit_single_worker_fn(
    alloc: *mut AllocCap,
    item: *CfgWorkItem,
    res: *CfgWorkResult,
    w: *WorkerCfgState,
    main_cfg: *mut cfg_ir.CfgProgram,
    main_lstate: *mut LowerState,
) -> !OutOfMemory {
    if let f_ptr = w.out_fns.get(res.local_fn_idx.widen.[usize]()) {
        var nf = f_ptr.*;
        if item.spec.has_base_generic {
            nf.base_generic_args = item.spec.base_generic_args;
        }
        _ = try main_cfg.add_fn(alloc, nf);
    }
    var ci: u32 = 0_u32;
    while ci < res.cl_buf_count {
        let idx = (res.cl_buf_start +% ci).widen.[usize]();
        if let cp = w.lstate.out_closures.get(idx) {
            try main_lstate.out_closures.push(alloc, cp.*);
        }
        ci = ci +% 1_u32;
    }
    return;
}

fn commit_item_fn_dispatch(
    alloc: *mut AllocCap,
    item: *CfgWorkItem,
    res: *CfgWorkResult,
    main_cfg: *mut cfg_ir.CfgProgram,
    main_lstate: *mut LowerState,
    w0: *WorkerCfgState,
    w1: *WorkerCfgState,
    w2: *WorkerCfgState,
    w3: *WorkerCfgState,
    w4: *WorkerCfgState,
    w5: *WorkerCfgState,
    w6: *WorkerCfgState,
    w7: *WorkerCfgState,
    w8: *WorkerCfgState,
    w9: *WorkerCfgState,
    w10: *WorkerCfgState,
    w11: *WorkerCfgState,
) -> !OutOfMemory {
    let wid = res.worker_id;
    if wid == 0_u32 { try commit_single_worker_fn(alloc, item, res, w0, main_cfg, main_lstate); }
    else if wid == 1_u32 { try commit_single_worker_fn(alloc, item, res, w1, main_cfg, main_lstate); }
    else if wid == 2_u32 { try commit_single_worker_fn(alloc, item, res, w2, main_cfg, main_lstate); }
    else if wid == 3_u32 { try commit_single_worker_fn(alloc, item, res, w3, main_cfg, main_lstate); }
    else if wid == 4_u32 { try commit_single_worker_fn(alloc, item, res, w4, main_cfg, main_lstate); }
    else if wid == 5_u32 { try commit_single_worker_fn(alloc, item, res, w5, main_cfg, main_lstate); }
    else if wid == 6_u32 { try commit_single_worker_fn(alloc, item, res, w6, main_cfg, main_lstate); }
    else if wid == 7_u32 { try commit_single_worker_fn(alloc, item, res, w7, main_cfg, main_lstate); }
    else if wid == 8_u32 { try commit_single_worker_fn(alloc, item, res, w8, main_cfg, main_lstate); }
    else if wid == 9_u32 { try commit_single_worker_fn(alloc, item, res, w9, main_cfg, main_lstate); }
    else if wid == 10_u32 { try commit_single_worker_fn(alloc, item, res, w10, main_cfg, main_lstate); }
    else { try commit_single_worker_fn(alloc, item, res, w11, main_cfg, main_lstate); }
    return;
}

fn run_cfg_wave(
    alloc: *mut AllocCap,
    n_workers: usize,
    need_sync: bool,
    items: *[CfgWorkItem],
    wave_gvals: *[types.GenericVal],
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    main_env: *mut types.TypeEnv,
    main_cfg: *mut cfg_ir.CfgProgram,
    main_lstate: *mut LowerState,
    ct: *ctvm.CtArena,
    table: *check.TypeTable,
    interner: *span.SymInterner,
    w0: *mut WorkerCfgState,
    w1: *mut WorkerCfgState,
    w2: *mut WorkerCfgState,
    w3: *mut WorkerCfgState,
    w4: *mut WorkerCfgState,
    w5: *mut WorkerCfgState,
    w6: *mut WorkerCfgState,
    w7: *mut WorkerCfgState,
    w8: *mut WorkerCfgState,
    w9: *mut WorkerCfgState,
    w10: *mut WorkerCfgState,
    w11: *mut WorkerCfgState,
) -> !OutOfMemory {
    var order = try col.DynBuf.[u32].init(alloc, items.len +% 1_usize);
    errdefer order.destroy(alloc);
    var results = try col.DynBuf.[CfgWorkResult].init(alloc, items.len +% 1_usize);
    errdefer results.destroy(alloc);
    var ii: usize = 0_usize;
    while ii < items.len {
        try results.push(alloc, cfg_work_result_empty());
        if !items[ii].is_stub {
            try order.push(alloc, ii.trunc.[u32]());
        }
        ii = ii +% 1_usize;
    }

    let base_ty_count = main_env.ty_count();
    let base_env_params = main_env.sigs.params.len().trunc.[u32]();
    let base_inst_count = main_cfg.generic_inst_count();

    if !order.is_empty() {
        sort_cfg_work_order_desc(order.as_mut_slice(), items);
        var n_wave = n_workers;
        if n_wave > order.len() {
            n_wave = order.len();
        }
        var next_pos = sync.AtomicCounter.init(0_u64);
        dispatch_cfg_wave_workers(
            n_wave, need_sync, alloc, &mut next_pos, order.as_slice(), items, wave_gvals,
            results.as_mut_slice(), arena, prog, main_env, main_cfg, ct, table, interner,
            w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11,
        );
        try check_cfg_workers_oom(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11);

        // Phase A: Prepare per-worker remap tables and assign deterministic IDs in strict item order.
        if n_wave > 0_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w0); }
        if n_wave > 1_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w1); }
        if n_wave > 2_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w2); }
        if n_wave > 3_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w3); }
        if n_wave > 4_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w4); }
        if n_wave > 5_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w5); }
        if n_wave > 6_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w6); }
        if n_wave > 7_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w7); }
        if n_wave > 8_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w8); }
        if n_wave > 9_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w9); }
        if n_wave > 10_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w10); }
        if n_wave > 11_usize { try prepare_single_worker_remap(alloc, base_ty_count, base_inst_count, w11); }

        let res_ro = results.as_slice();
        var ai: usize = 0_usize;
        while ai < items.len {
            if !items[ai].is_stub && ai < res_ro.len && res_ro[ai].has_result {
                try assign_item_ids_dispatch(
                    alloc, &res_ro[ai], base_ty_count, base_inst_count,
                    main_env, main_cfg, main_lstate,
                    w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11,
                );
            }
            ai = ai +% 1_usize;
        }

        if n_wave > 0_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w0.env, main_env, &mut w0.rm); }
        if n_wave > 1_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w1.env, main_env, &mut w1.rm); }
        if n_wave > 2_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w2.env, main_env, &mut w2.rm); }
        if n_wave > 3_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w3.env, main_env, &mut w3.rm); }
        if n_wave > 4_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w4.env, main_env, &mut w4.rm); }
        if n_wave > 5_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w5.env, main_env, &mut w5.rm); }
        if n_wave > 6_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w6.env, main_env, &mut w6.rm); }
        if n_wave > 7_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w7.env, main_env, &mut w7.rm); }
        if n_wave > 8_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w8.env, main_env, &mut w8.rm); }
        if n_wave > 9_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w9.env, main_env, &mut w9.rm); }
        if n_wave > 10_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w10.env, main_env, &mut w10.rm); }
        if n_wave > 11_usize { try cfg_ir.finalize_worker_ty_remap(alloc, base_ty_count, &w11.env, main_env, &mut w11.rm); }

        // Phase B: Compute prefix-sum pool offsets & run in-place fixup in parallel across workers!
        var cur_off = cfg_ir.cfg_pool_offsets_from(main_cfg, base_env_params);
        if n_wave > 0_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w0); }
        if n_wave > 1_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w1); }
        if n_wave > 2_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w2); }
        if n_wave > 3_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w3); }
        if n_wave > 4_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w4); }
        if n_wave > 5_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w5); }
        if n_wave > 6_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w6); }
        if n_wave > 7_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w7); }
        if n_wave > 8_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w8); }
        if n_wave > 9_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w9); }
        if n_wave > 10_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w10); }
        if n_wave > 11_usize { assign_worker_pool_offset(&mut cur_off, base_env_params, w11); }

        dispatch_cfg_fixup_workers(
            n_wave, main_env, base_ty_count, base_env_params, base_inst_count,
            w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11,
        );

        // Phase C: Exact pre-reserve & bulk memcpy-append all worker pools into main_cfg & main_env.sigs.params!
        try cfg_ir.reserve_for_bulk_append(alloc, main_cfg, &mut main_env.sigs.params, &cur_off);
        if n_wave > 0_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w0.cfg, w0.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 1_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w1.cfg, w1.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 2_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w2.cfg, w2.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 3_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w3.cfg, w3.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 4_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w4.cfg, w4.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 5_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w5.cfg, w5.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 6_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w6.cfg, w6.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 7_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w7.cfg, w7.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 8_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w8.cfg, w8.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 9_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w9.cfg, w9.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 10_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w10.cfg, w10.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
        if n_wave > 11_usize { try cfg_ir.bulk_append_worker_cfg_pools(alloc, &w11.cfg, w11.env.sigs.params.as_slice(), base_env_params, main_cfg, &mut main_env.sigs.params); }
    }

    // Phase D: Commit CfgFunction & closure headers in strict deterministic item order!
    let res_slice = results.as_slice();
    var mi: usize = 0_usize;
    while mi < items.len {
        let it = items[mi];
        if it.is_stub {
            let stub_fn = cfg_ir.fn_new(
                it.spec.key, it.spec.module_id, it.spec.sig.name, it.stub_span, it.spec.sig, it.spec.is_sys,
            );
            _ = try main_cfg.add_fn(alloc, stub_fn);
        } else if mi < res_slice.len && res_slice[mi].has_result {
            try commit_item_fn_dispatch(
                alloc, &it, &res_slice[mi], main_cfg, main_lstate,
                w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11,
            );
        }
        mi = mi +% 1_usize;
    }

    // Release worker body pools immediately after committing the wave to keep Peak RSS bounded
    if n_workers > 0_usize { try w0.cfg.release_body_pools(alloc); }
    if n_workers > 1_usize { try w1.cfg.release_body_pools(alloc); }
    if n_workers > 2_usize { try w2.cfg.release_body_pools(alloc); }
    if n_workers > 3_usize { try w3.cfg.release_body_pools(alloc); }
    if n_workers > 4_usize { try w4.cfg.release_body_pools(alloc); }
    if n_workers > 5_usize { try w5.cfg.release_body_pools(alloc); }
    if n_workers > 6_usize { try w6.cfg.release_body_pools(alloc); }
    if n_workers > 7_usize { try w7.cfg.release_body_pools(alloc); }
    if n_workers > 8_usize { try w8.cfg.release_body_pools(alloc); }
    if n_workers > 9_usize { try w9.cfg.release_body_pools(alloc); }
    if n_workers > 10_usize { try w10.cfg.release_body_pools(alloc); }
    if n_workers > 11_usize { try w11.cfg.release_body_pools(alloc); }

    results.destroy(alloc);
    order.destroy(alloc);
    return;
}

fn lower_program_parallel_waves(
    alloc: *mut AllocCap,
    n_workers: usize,
    wave0_items: *[CfgWorkItem],
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    cfg: *mut cfg_ir.CfgProgram,
    lstate: *mut LowerState,
    ct: *ctvm.CtArena,
    table: *check.TypeTable,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    var w0 = try WorkerCfgState.init(alloc, env, cfg, 0_usize < n_workers);
    errdefer w0.destroy(alloc);
    var w1 = try WorkerCfgState.init(alloc, env, cfg, 1_usize < n_workers);
    errdefer w1.destroy(alloc);
    var w2 = try WorkerCfgState.init(alloc, env, cfg, 2_usize < n_workers);
    errdefer w2.destroy(alloc);
    var w3 = try WorkerCfgState.init(alloc, env, cfg, 3_usize < n_workers);
    errdefer w3.destroy(alloc);
    var w4 = try WorkerCfgState.init(alloc, env, cfg, 4_usize < n_workers);
    errdefer w4.destroy(alloc);
    var w5 = try WorkerCfgState.init(alloc, env, cfg, 5_usize < n_workers);
    errdefer w5.destroy(alloc);
    var w6 = try WorkerCfgState.init(alloc, env, cfg, 6_usize < n_workers);
    errdefer w6.destroy(alloc);
    var w7 = try WorkerCfgState.init(alloc, env, cfg, 7_usize < n_workers);
    errdefer w7.destroy(alloc);
    var w8 = try WorkerCfgState.init(alloc, env, cfg, 8_usize < n_workers);
    errdefer w8.destroy(alloc);
    var w9 = try WorkerCfgState.init(alloc, env, cfg, 9_usize < n_workers);
    errdefer w9.destroy(alloc);
    var w10 = try WorkerCfgState.init(alloc, env, cfg, 10_usize < n_workers);
    errdefer w10.destroy(alloc);
    var w11 = try WorkerCfgState.init(alloc, env, cfg, 11_usize < n_workers);
    errdefer w11.destroy(alloc);

    let empty_g_arr: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
    let empty_g = empty_g_arr[0_usize..0_usize];
    // Process wave0 in deterministic chunks of 512 items so worker CFG pools stay small (~20 MiB vs ~350 MiB)
    let chunk_sz: usize = 512_usize;
    var w0_pos: usize = 0_usize;
    while w0_pos < wave0_items.len {
        var w0_end = w0_pos +% chunk_sz;
        if w0_end > wave0_items.len {
            w0_end = wave0_items.len;
        }
        let batch = wave0_items.sub(w0_pos, w0_end) catch { break; };
        try run_cfg_wave(
            alloc, n_workers, w0_pos > 0_usize, batch, empty_g,
            arena, prog, env, cfg, lstate, ct, table, interner,
            &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
            &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
        );
        w0_pos = w0_end;
    }

    var g_items = try col.DynBuf.[CfgWorkItem].init(alloc, 32_usize);
    errdefer g_items.destroy(alloc);
    var g_vals = try col.DynBuf.[types.GenericVal].init(alloc, 64_usize);
    errdefer g_vals.destroy(alloc);
    var cursor: u32 = 0_u32;
    while cursor < cfg.generic_inst_count() {
        let end = cfg.generic_inst_count();
        g_items.clear();
        g_vals.clear();
        try collect_generic_wave_items(
            alloc, arena, prog, env, cfg, cursor, end, &mut g_items, &mut g_vals,
        );
        cursor = end;
        if !g_items.is_empty() {
            try run_cfg_wave(
                alloc, n_workers, true, g_items.as_slice(), g_vals.as_slice(),
                arena, prog, env, cfg, lstate, ct, table, interner,
                &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
                &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
            );
        }
    }
    g_vals.destroy(alloc);
    g_items.destroy(alloc);
    w11.destroy(alloc);
    w10.destroy(alloc);
    w9.destroy(alloc);
    w8.destroy(alloc);
    w7.destroy(alloc);
    w6.destroy(alloc);
    w5.destroy(alloc);
    w4.destroy(alloc);
    w3.destroy(alloc);
    w2.destroy(alloc);
    w1.destroy(alloc);
    w0.destroy(alloc);
    return;
}

/// Parallel AST -> CFG lowering (up to 12 workers, wave-based generic instantiation,
/// deterministic lazy TypeEnv/GenericInst/Closure/Schedule merge).
pub fn lower_program_with_jobs(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    unit_ids: *[u32],
    prog: *resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    ct: *ctvm.CtArena,
    table: *check.TypeTable,
    interner: *span.SymInterner,
    jobs: u32,
) -> cfg_ir.CfgProgram ! OutOfMemory {
    _ = unit_ids;
    var cfg = try cfg_ir.CfgProgram.init(alloc);
    errdefer cfg.destroy(alloc);
    var lstate = try LowerState.init(alloc);
    errdefer lstate.destroy(alloc);

    try seed_dyn_pairs_and_generic_insts(alloc, table, &mut cfg);

    var wave0_items = try col.DynBuf.[CfgWorkItem].init(alloc, 64_usize);
    errdefer wave0_items.destroy(alloc);
    let non_stub = try collect_wave0_work_items(alloc, arena, prog, env, &mut wave0_items);

    var n_workers: usize = 1_usize;
    if jobs == 1_u32 {
        n_workers = 1_usize;
    } else if jobs > 1_u32 {
        n_workers = jobs.widen.[usize]();
        if n_workers > 12_usize { n_workers = 12_usize; }
    } else {
        if non_stub < 32_usize {
            n_workers = 1_usize;
        } else if non_stub < 192_usize {
            n_workers = 4_usize;
        } else if non_stub < 480_usize {
            n_workers = 8_usize;
        } else {
            n_workers = 12_usize;
        }
    }

    if non_stub < 32_usize {
        var lctx = LowerCtx.{
            alloc: alloc,
            arena: arena,
            prog: prog,
            env: env,
            ct: ct,
            table: table,
            interner: interner,
            cfg: &mut cfg,
            lstate: &mut lstate,
        };
        try lower_all_top_defs(&mut lctx);
        try lower_all_impl_methods(&mut lctx);
        try drain_generic_insts(&mut lctx);
    } else {
        try lower_program_parallel_waves(
            alloc, n_workers, wave0_items.as_slice(), arena, prog, env, &mut cfg, &mut lstate,
            ct, table, interner,
        );
    }

    let closures = lstate.out_closures.as_slice();
    var ci: usize = 0_usize;
    while ci < closures.len {
        _ = try cfg.add_fn(alloc, closures[ci]);
        ci = ci +% 1_usize;
    }

    wave0_items.destroy(alloc);
    lstate.destroy(alloc);
    return cfg;
}

pub struct CfgBatchRange {
    pub start: u32;
    pub end: u32;
}

fn lower_items_seq(
    alloc: *mut AllocCap,
    items: *[CfgWorkItem],
    wave_gvals: *[types.GenericVal],
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    cfg: *mut cfg_ir.CfgProgram,
    lstate: *mut LowerState,
    ct: *ctvm.CtArena,
    table: *check.TypeTable,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    let empty_g_arr: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
    let empty_g = empty_g_arr[0_usize..0_usize];
    var lctx = LowerCtx.{
        alloc: alloc,
        arena: arena,
        prog: prog,
        env: env,
        ct: ct,
        table: table,
        interner: interner,
        cfg: cfg,
        lstate: lstate,
    };
    var i: usize = 0_usize;
    while i < items.len {
        let it = items[i];
        if it.is_stub {
            let stub_fn = cfg_ir.fn_new(
                it.spec.key, it.spec.module_id, it.spec.sig.name, it.stub_span, it.spec.sig, it.spec.is_sys,
            );
            _ = try cfg.add_fn(alloc, stub_fn);
        } else {
            let gargs_slice = if it.gargs_len > 0_u32 {
                let gs = it.gargs_start.widen.[usize]();
                let ge = gs +% it.gargs_len.widen.[usize]();
                wave_gvals.sub(gs, ge) catch empty_g
            } else {
                empty_g
            };
            let func = try lower_fn_body(&mut lctx, &it.spec, gargs_slice);
            _ = try cfg.add_fn(alloc, func);
        }
        i = i +% 1_usize;
    }
    return;
}

/// Streaming AST -> CFG session that emits bounded batches of lowered functions
/// so callers can borrow-check, collect effects, lower to EIR, and release CFG body pools
/// after each batch to keep Peak RSS bounded.
pub linear struct CfgStreamSession {
    lstate: LowerState;
    wave0_items: col.DynBuf[CfgWorkItem];
    wave0_pos: usize;
    gen_items: col.DynBuf[CfgWorkItem];
    gen_vals: col.DynBuf[types.GenericVal];
    gen_pos: usize;
    gen_cursor: u32;
    n_workers: usize;
    has_run_wave: bool;
    w0: WorkerCfgState;
    w1: WorkerCfgState;
    w2: WorkerCfgState;
    w3: WorkerCfgState;
    w4: WorkerCfgState;
    w5: WorkerCfgState;
    w6: WorkerCfgState;
    w7: WorkerCfgState;
    w8: WorkerCfgState;
    w9: WorkerCfgState;
    w10: WorkerCfgState;
    w11: WorkerCfgState;
}

impl CfgStreamSession {
    pub fn init(
        alloc: *mut AllocCap,
        arena: *ast.AstArena,
        prog: *resolve.ResolvedProgram,
        env: *types.TypeEnv,
        cfg: *mut cfg_ir.CfgProgram,
        table: *check.TypeTable,
        jobs: u32,
    ) -> CfgStreamSession ! OutOfMemory {
        try seed_dyn_pairs_and_generic_insts(alloc, table, cfg);
        let lstate = try LowerState.init(alloc);
        errdefer lstate.destroy(alloc);
        var wave0_items = try col.DynBuf.[CfgWorkItem].init(alloc, 64_usize);
        errdefer wave0_items.destroy(alloc);
        let non_stub = try collect_wave0_work_items(alloc, arena, prog, env, &mut wave0_items);
        let gen_items = try col.DynBuf.[CfgWorkItem].init(alloc, 32_usize);
        errdefer gen_items.destroy(alloc);
        let gen_vals = try col.DynBuf.[types.GenericVal].init(alloc, 64_usize);
        errdefer gen_vals.destroy(alloc);

        var n_workers: usize = 1_usize;
        if jobs == 1_u32 || non_stub < 32_usize {
            n_workers = 1_usize;
        } else if jobs > 1_u32 {
            n_workers = jobs.widen.[usize]();
            // Cap streaming CFG workers at 3 because each worker holds a cloned TypeEnv (~18 MiB)
            // concurrently with the AST arena, TypeTable, and growing EirProgram.
            if n_workers > 3_usize { n_workers = 3_usize; }
        } else {
            n_workers = 2_usize;
        }

        let par_on = n_workers > 1_usize;
        let w0 = try WorkerCfgState.init(alloc, env, cfg, par_on && 0_usize < n_workers); errdefer w0.destroy(alloc);
        let w1 = try WorkerCfgState.init(alloc, env, cfg, par_on && 1_usize < n_workers); errdefer w1.destroy(alloc);
        let w2 = try WorkerCfgState.init(alloc, env, cfg, par_on && 2_usize < n_workers); errdefer w2.destroy(alloc);
        let w3 = try WorkerCfgState.init(alloc, env, cfg, par_on && 3_usize < n_workers); errdefer w3.destroy(alloc);
        let w4 = try WorkerCfgState.init(alloc, env, cfg, par_on && 4_usize < n_workers); errdefer w4.destroy(alloc);
        let w5 = try WorkerCfgState.init(alloc, env, cfg, par_on && 5_usize < n_workers); errdefer w5.destroy(alloc);
        let w6 = try WorkerCfgState.init(alloc, env, cfg, par_on && 6_usize < n_workers); errdefer w6.destroy(alloc);
        let w7 = try WorkerCfgState.init(alloc, env, cfg, par_on && 7_usize < n_workers); errdefer w7.destroy(alloc);
        let w8 = try WorkerCfgState.init(alloc, env, cfg, par_on && 8_usize < n_workers); errdefer w8.destroy(alloc);
        let w9 = try WorkerCfgState.init(alloc, env, cfg, par_on && 9_usize < n_workers); errdefer w9.destroy(alloc);
        let w10 = try WorkerCfgState.init(alloc, env, cfg, par_on && 10_usize < n_workers); errdefer w10.destroy(alloc);
        let w11 = try WorkerCfgState.init(alloc, env, cfg, par_on && 11_usize < n_workers); errdefer w11.destroy(alloc);

        return CfgStreamSession.{
            lstate: lstate,
            wave0_items: wave0_items,
            wave0_pos: 0_usize,
            gen_items: gen_items,
            gen_vals: gen_vals,
            gen_pos: 0_usize,
            gen_cursor: 0_u32,
            n_workers: n_workers,
            has_run_wave: false,
            w0: w0,
            w1: w1,
            w2: w2,
            w3: w3,
            w4: w4,
            w5: w5,
            w6: w6,
            w7: w7,
            w8: w8,
            w9: w9,
            w10: w10,
            w11: w11,
        };
    }

    pub fn destroy(self: CfgStreamSession, alloc: *mut AllocCap) {
        let CfgStreamSession.{
            lstate,
            wave0_items,
            wave0_pos: _,
            gen_items,
            gen_vals,
            gen_pos: _,
            gen_cursor: _,
            n_workers: _,
            has_run_wave: _,
            w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11,
        } = self;
        w11.destroy(alloc); w10.destroy(alloc); w9.destroy(alloc); w8.destroy(alloc);
        w7.destroy(alloc); w6.destroy(alloc); w5.destroy(alloc); w4.destroy(alloc);
        w3.destroy(alloc); w2.destroy(alloc); w1.destroy(alloc); w0.destroy(alloc);
        gen_vals.destroy(alloc);
        gen_items.destroy(alloc);
        wave0_items.destroy(alloc);
        lstate.destroy(alloc);
    }

    pub fn next_batch(
        self: *mut Self,
        alloc: *mut AllocCap,
        arena: *ast.AstArena,
        prog: *resolve.ResolvedProgram,
        env: *mut types.TypeEnv,
        cfg: *mut cfg_ir.CfgProgram,
        ct: *ctvm.CtArena,
        table: *check.TypeTable,
        interner: *span.SymInterner,
        batch_sz: usize,
    ) -> ?CfgBatchRange ! OutOfMemory {
        let step = if batch_sz == 0_usize { 512_usize } else { batch_sz };
        let empty_g_arr: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
        let empty_g = empty_g_arr[0_usize..0_usize];
        let start_fn = cfg.fn_count();

        if self.wave0_pos < self.wave0_items.len() {
            let w0_len = self.wave0_items.len();
            var w0_end = self.wave0_pos +% step;
            if w0_end > w0_len {
                w0_end = w0_len;
            }
            let b_start = self.wave0_pos;
            self.wave0_pos = w0_end;
            let batch = self.wave0_items.as_slice().sub(b_start, w0_end) catch {
                return null;
            };
            if self.n_workers <= 1_usize || batch.len < 32_usize {
                try lower_items_seq(
                    alloc, batch, empty_g, arena, prog, env, cfg, &mut self.lstate, ct, table, interner,
                );
            } else {
                try run_cfg_wave(
                    alloc, self.n_workers, self.has_run_wave, batch, empty_g,
                    arena, prog, env, cfg, &mut self.lstate, ct, table, interner,
                    &mut self.w0, &mut self.w1, &mut self.w2, &mut self.w3, &mut self.w4, &mut self.w5,
                    &mut self.w6, &mut self.w7, &mut self.w8, &mut self.w9, &mut self.w10, &mut self.w11,
                );
            }
            self.has_run_wave = true;
        } else {
            while self.gen_pos >= self.gen_items.len() && self.gen_cursor < cfg.generic_inst_count() {
                let g_end = cfg.generic_inst_count();
                self.gen_items.clear();
                self.gen_vals.clear();
                self.gen_pos = 0_usize;
                try collect_generic_wave_items(
                    alloc, arena, prog, env, cfg, self.gen_cursor, g_end, &mut self.gen_items, &mut self.gen_vals,
                );
                self.gen_cursor = g_end;
            }
            if self.gen_pos >= self.gen_items.len() {
                return null;
            }
            let g_len = self.gen_items.len();
            var g_end = self.gen_pos +% step;
            if g_end > g_len {
                g_end = g_len;
            }
            let g_start = self.gen_pos;
            self.gen_pos = g_end;
            let batch = self.gen_items.as_slice().sub(g_start, g_end) catch {
                return null;
            };
            let gvals = self.gen_vals.as_slice();
            if self.n_workers <= 1_usize || batch.len < 32_usize {
                try lower_items_seq(
                    alloc, batch, gvals, arena, prog, env, cfg, &mut self.lstate, ct, table, interner,
                );
            } else {
                try run_cfg_wave(
                    alloc, self.n_workers, true, batch, gvals,
                    arena, prog, env, cfg, &mut self.lstate, ct, table, interner,
                    &mut self.w0, &mut self.w1, &mut self.w2, &mut self.w3, &mut self.w4, &mut self.w5,
                    &mut self.w6, &mut self.w7, &mut self.w8, &mut self.w9, &mut self.w10, &mut self.w11,
                );
            }
            self.has_run_wave = true;
        }

        let cls = self.lstate.out_closures.as_slice();
        var ci: usize = 0_usize;
        while ci < cls.len {
            _ = try cfg.add_fn(alloc, cls[ci]);
            ci = ci +% 1_usize;
        }
        self.lstate.out_closures.clear();
        let end_fn = cfg.fn_count();
        return CfgBatchRange.{ start: start_fn, end: end_fn };
    }
}
