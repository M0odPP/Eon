module eonc.mach_opt_x64;

import core.col;
import eonc.span;
import eonc.ast;
import eonc.eir;
import eonc.x64_asm;
import eonc.elf64;
import eonc.mach_ir;

// ============================================================================
// Section 1: Public Emission Result (`MachEmitOut`) & Helper Utilities
// ============================================================================

pub linear struct MachEmitOut {
    pub ok: bool;
    pub own_stack_bytes: u64;
    pub code: col.DynBuf[u8];
    pub relocs: col.DynBuf[x64_asm.FnReloc];
    pub rodata_items: col.DynBuf[mach_ir.MachRodataItem];
    pub rodata_bytes: col.DynBuf[u8];
    pub rodata_relocs: col.DynBuf[mach_ir.MachRodataReloc];
    pub used_helpers: col.DynBuf[u32];
    pub line_entries: col.DynBuf[elf64.LineEntry];
}

impl MachEmitOut {
    pub fn init(alloc: *mut AllocCap) -> MachEmitOut ! OutOfMemory {
        let code = try col.DynBuf.[u8].init(alloc, 128_usize);
        errdefer code.destroy(alloc);
        let relocs = try col.DynBuf.[x64_asm.FnReloc].init(alloc, 8_usize);
        errdefer relocs.destroy(alloc);
        let rodata_items = try col.DynBuf.[mach_ir.MachRodataItem].init(alloc, 4_usize);
        errdefer rodata_items.destroy(alloc);
        let rodata_bytes = try col.DynBuf.[u8].init(alloc, 32_usize);
        errdefer rodata_bytes.destroy(alloc);
        let rodata_relocs = try col.DynBuf.[mach_ir.MachRodataReloc].init(alloc, 4_usize);
        errdefer rodata_relocs.destroy(alloc);
        let used_helpers = try col.DynBuf.[u32].init(alloc, 4_usize);
        errdefer used_helpers.destroy(alloc);
        let line_entries = try col.DynBuf.[elf64.LineEntry].init(alloc, 16_usize);
        errdefer line_entries.destroy(alloc);
        return MachEmitOut.{
            ok: false,
            own_stack_bytes: 0_u64,
            code: code,
            relocs: relocs,
            rodata_items: rodata_items,
            rodata_bytes: rodata_bytes,
            rodata_relocs: rodata_relocs,
            used_helpers: used_helpers,
            line_entries: line_entries,
        };
    }

    pub fn destroy(self: MachEmitOut, alloc: *mut AllocCap) {
        let MachEmitOut.{
            ok: _,
            own_stack_bytes: _,
            code,
            relocs,
            rodata_items,
            rodata_bytes,
            rodata_relocs,
            used_helpers,
            line_entries,
        } = self;
        code.destroy(alloc);
        relocs.destroy(alloc);
        rodata_items.destroy(alloc);
        rodata_bytes.destroy(alloc);
        rodata_relocs.destroy(alloc);
        used_helpers.destroy(alloc);
        line_entries.destroy(alloc);
    }
}

fn align_up_usize(val: usize, align: usize) -> usize {
    if align <= 1_usize {
        return val;
    }
    let mask = align -% 1_usize;
    return (val +% mask) & (~mask);
}

fn invert_cond(cc: x64_asm.Cond) -> x64_asm.Cond {
    match cc {
        .O => { return .No; }
        .No => { return .O; }
        .B => { return .Ae; }
        .Ae => { return .B; }
        .E => { return .Ne; }
        .Ne => { return .E; }
        .Be => { return .A; }
        .A => { return .Be; }
        .S => { return .Ns; }
        .Ns => { return .S; }
        .P => { return .Np; }
        .Np => { return .P; }
        .L => { return .Ge; }
        .Ge => { return .L; }
        .Le => { return .G; }
        .G => { return .Le; }
    }
}

fn cond_only_zf_sf(cc: x64_asm.Cond) -> bool {
    return cc == .E || cc == .Ne || cc == .S || cc == .Ns;
}

// ============================================================================
// Section 2: Instruction Effect Analysis (Registers, Flags, Memory, Latency)
// ============================================================================

struct InstEffects {
    read_gprs: u32;
    write_gprs: u32;
    read_xmms: u32;
    write_xmms: u32;
    reads_flags: bool;
    writes_flags: bool;
    reads_mem: bool;
    writes_mem: bool;
    is_barrier: bool;
    latency: u8;
}

fn op_reads_flags(op: mach_ir.MachOp) -> bool {
    return op == .Jcc || op == .Cmov || op == .Setcc || op == .Ret || op == .Iretq;
}

fn op_writes_flags(op: mach_ir.MachOp) -> bool {
    match op {
        .Add => { return true; }
        .AddImm => { return true; }
        .Sub => { return true; }
        .SubImm => { return true; }
        .Mul => { return true; }
        .MulImm => { return true; }
        .Imul128 => { return true; }
        .Mul128 => { return true; }
        .Div => { return true; }
        .Idiv => { return true; }
        .Div32 => { return true; }
        .Idiv32 => { return true; }
        .Add32 => { return true; }
        .Add32Imm => { return true; }
        .Sub32 => { return true; }
        .Sub32Imm => { return true; }
        .Mul32 => { return true; }
        .Mul32Imm => { return true; }
        .And => { return true; }
        .AndImm => { return true; }
        .And32 => { return true; }
        .And32Imm => { return true; }
        .Or => { return true; }
        .OrImm => { return true; }
        .Or32 => { return true; }
        .Or32Imm => { return true; }
        .Xor => { return true; }
        .XorImm => { return true; }
        .Xor32 => { return true; }
        .Xor32Imm => { return true; }
        .Shl => { return true; }
        .ShlImm => { return true; }
        .Shr => { return true; }
        .ShrImm => { return true; }
        .Sar => { return true; }
        .SarImm => { return true; }
        .Shl32 => { return true; }
        .Shl32Imm => { return true; }
        .Shr32 => { return true; }
        .Shr32Imm => { return true; }
        .Sar32 => { return true; }
        .Sar32Imm => { return true; }
        .RorImm => { return true; }
        .Ror32Imm => { return true; }
        .Neg => { return true; }
        .Neg32 => { return true; }
        .Tzcnt => { return true; }
        .Lzcnt => { return true; }
        .Popcnt => { return true; }
        .Bextr => { return true; }
        .Cmp => { return true; }
        .CmpImm => { return true; }
        .Cmp32 => { return true; }
        .Cmp32Imm => { return true; }
        .CmpMem => { return true; }
        .AddMem => { return true; }
        .SubMem => { return true; }
        .MulMem => { return true; }
        .AndMem => { return true; }
        .OrMem => { return true; }
        .XorMem => { return true; }
        .Test => { return true; }
        .TestImm => { return true; }
        .Test32 => { return true; }
        .Test32Imm => { return true; }
        .Clc => { return true; }
        .Stc => { return true; }
        .LockXadd => { return true; }
        .LockCmpxchg => { return true; }
        .VUcomiSS => { return true; }
        .VUcomiSD => { return true; }
        .CallSym => { return true; }
        .CallReg => { return true; }
        .CallBarrier => { return true; }
        _ => { return false; }
    }
}

