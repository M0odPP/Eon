        .VMovSDStore => { return true; }
        .VMovVecReg => { return true; }
        .VAddSS => { return true; }
        .VSubSS => { return true; }
        .VMulSS => { return true; }
        .VDivSS => { return true; }
        .VMinSS => { return true; }
        .VMaxSS => { return true; }
        .VSqrtSS => { return true; }
        .VFmadd231SS => { return true; }
        .VAddSD => { return true; }
        .VSubSD => { return true; }
        .VMulSD => { return true; }
        .VDivSD => { return true; }
        .VMinSD => { return true; }
        .VMaxSD => { return true; }
        .VSqrtSD => { return true; }
        .VFmadd231SD => { return true; }
        .VUcomiSS => { return true; }
        .VUcomiSD => { return true; }
        .VCvtTTSS2SI => { return true; }
        .VCvtTTSD2SI => { return true; }
        .VCvtSS2SD => { return true; }
        .VCvtSD2SS => { return true; }
        .VMovDFromXmm => { return true; }
        .VMovQFromXmm => { return true; }
        .VMovUpsStore => { return true; }
        .VMovApsStore => { return true; }
        .VMovDquStore => { return true; }
        .VBroadcastSS => { return true; }
        .VBroadcastSD => { return true; }
        .VAddPS => { return true; }
        .VAddPSMem => { return true; }
        .VSubPS => { return true; }
        .VSubPSMem => { return true; }
        .VMulPS => { return true; }
        .VMulPSMem => { return true; }
        .VDivPS => { return true; }
        .VMinPS => { return true; }
        .VMaxPS => { return true; }
        .VSqrtPS => { return true; }
        .VRsqrtPS => { return true; }
        .VFmadd231PS => { return true; }
        .VFmadd231PSMem => { return true; }
        .VFnMadd231PS => { return true; }
        .VAddPD => { return true; }
        .VSubPD => { return true; }
        .VMulPD => { return true; }
        .VDivPD => { return true; }
        .VMinPD => { return true; }
        .VMaxPD => { return true; }
        .VSqrtPD => { return true; }
        .VFmadd231PD => { return true; }
        .VFmadd231PDMem => { return true; }
        .VXorPS => { return true; }
        .VAndPS => { return true; }
        .VOrPS => { return true; }
        .VXorPD => { return true; }
        .VAndPD => { return true; }
        .VOrPD => { return true; }
        .VCmpPS => { return true; }
        .VBlendVPS => { return true; }
        .VShufPS => { return true; }
        .VHAddPS => { return true; }
        .VExtractF128 => { return true; }
        .VInsertF128 => { return true; }
        .VPXor => { return true; }
        .VPAnd => { return true; }
        .VPOr => { return true; }
        .VPAddB => { return true; }
        .VPSubB => { return true; }
        .VPAddD => { return true; }
        .VPSubD => { return true; }
        .VPMullD => { return true; }
        .VPAddQ => { return true; }
        .VPSubQ => { return true; }
        .VPMinSD => { return true; }
        .VPMaxSD => { return true; }
        .VPCmpEqB => { return true; }
        .VPCmpEqD => { return true; }
        .VPCmpGtD => { return true; }
        .VPMovMskB => { return true; }
        .VPSllDImm => { return true; }
        .VPSrlDImm => { return true; }
        .VPSraDImm => { return true; }
        .VPSllWImm => { return true; }
        .VPBroadcastB => { return true; }
