module eonc.x64_asm;

import core.col;
import core.str;
import eonc.span;

// ============================================================================
// Registers, Condition Codes, Relocations, and X64Buf Machine-Code Buffer
// ============================================================================

pub enum Reg : u8 {
    Rax = 0,
    Rcx = 1,
    Rdx = 2,
    Rbx = 3,
    Rsp = 4,
    Rbp = 5,
    Rsi = 6,
    Rdi = 7,
    R8 = 8,
    R9 = 9,
    R10 = 10,
    R11 = 11,
    R12 = 12,
    R13 = 13,
    R14 = 14,
    R15 = 15,
}

impl Reg {
    pub fn id(self: Self) -> u8 {
        match self {
            .Rax => { return 0_u8; }
            .Rcx => { return 1_u8; }
            .Rdx => { return 2_u8; }
            .Rbx => { return 3_u8; }
            .Rsp => { return 4_u8; }
            .Rbp => { return 5_u8; }
            .Rsi => { return 6_u8; }
            .Rdi => { return 7_u8; }
            .R8 => { return 8_u8; }
            .R9 => { return 9_u8; }
            .R10 => { return 10_u8; }
            .R11 => { return 11_u8; }
            .R12 => { return 12_u8; }
            .R13 => { return 13_u8; }
            .R14 => { return 14_u8; }
            .R15 => { return 15_u8; }
        }
    }

    pub fn low(self: Self) -> u8 {
        return self.id() & 7_u8;
    }

    pub fn hi(self: Self) -> bool {
        return self.id() >= 8_u8;
    }
}

pub enum Xmm : u8 {
    Xmm0 = 0,
    Xmm1 = 1,
    Xmm2 = 2,
    Xmm3 = 3,
    Xmm4 = 4,
    Xmm5 = 5,
    Xmm6 = 6,
    Xmm7 = 7,
    Xmm8 = 8,
    Xmm9 = 9,
    Xmm10 = 10,
    Xmm11 = 11,
    Xmm12 = 12,
    Xmm13 = 13,
    Xmm14 = 14,
    Xmm15 = 15,
}

impl Xmm {
    pub fn id(self: Self) -> u8 {
        match self {
            .Xmm0 => { return 0_u8; }
            .Xmm1 => { return 1_u8; }
            .Xmm2 => { return 2_u8; }
            .Xmm3 => { return 3_u8; }
            .Xmm4 => { return 4_u8; }
            .Xmm5 => { return 5_u8; }
            .Xmm6 => { return 6_u8; }
            .Xmm7 => { return 7_u8; }
            .Xmm8 => { return 8_u8; }
            .Xmm9 => { return 9_u8; }
            .Xmm10 => { return 10_u8; }
            .Xmm11 => { return 11_u8; }
            .Xmm12 => { return 12_u8; }
            .Xmm13 => { return 13_u8; }
            .Xmm14 => { return 14_u8; }
            .Xmm15 => { return 15_u8; }
        }
    }

    pub fn low(self: Self) -> u8 {
        return self.id() & 7_u8;
    }

    pub fn hi(self: Self) -> bool {
        return self.id() >= 8_u8;
    }
}

pub enum Cond : u8 {
    O = 0,
    No = 1,
    B = 2,
    Ae = 3,
    E = 4,
    Ne = 5,
    Be = 6,
    A = 7,
    S = 8,
    Ns = 9,
    P = 10,
    Np = 11,
    L = 12,
    Ge = 13,
    Le = 14,
    G = 15,
}

impl Cond {
    pub fn id(self: Self) -> u8 {
        match self {
            .O => { return 0_u8; }
            .No => { return 1_u8; }
            .B => { return 2_u8; }
            .Ae => { return 3_u8; }
            .E => { return 4_u8; }
            .Ne => { return 5_u8; }
            .Be => { return 6_u8; }
            .A => { return 7_u8; }
            .S => { return 8_u8; }
            .Ns => { return 9_u8; }
            .P => { return 10_u8; }
            .Np => { return 11_u8; }
            .L => { return 12_u8; }
            .Ge => { return 13_u8; }
            .Le => { return 14_u8; }
            .G => { return 15_u8; }
        }
    }
}

pub enum RelocKindX64 : u8 {
    Rel32 = 0,
    Abs64 = 1,
    GotPcRel32 = 2,
    Plt32 = 3,
    TpOff32 = 4,
}

pub const LABEL_UNBOUND: u32 = 4294967295_u32;

pub struct FnReloc {
    pub offset: u32;
    pub kind: RelocKindX64;
    pub sym_id: u32;
    pub addend: i64;
}

pub struct LabelFixup {
    pub patch_off: u32;
    pub label: u32;
}

pub linear struct X64Buf {
    pub code: col.DynBuf[u8];
    pub labels: col.DynBuf[u32];
    pub fixups: col.DynBuf[LabelFixup];
    pub relocs: col.DynBuf[FnReloc];
}

fn modrm_byte(m: u8, reg: u8, rm: u8) -> u8 {
    return ((m & 3_u8) <<% 6_u8) | ((reg & 7_u8) <<% 3_u8) | (rm & 7_u8);
}

fn sib_scale_bits(scale: u8) -> u8 {
    if scale == 2_u8 { return 1_u8; }
    if scale == 4_u8 { return 2_u8; }
    if scale == 8_u8 { return 3_u8; }
    return 0_u8;
}

fn sib_byte(scale: u8, idx_low: u8, base_low: u8) -> u8 {
    return ((sib_scale_bits(scale) & 3_u8) <<% 6_u8) | ((idx_low & 7_u8) <<% 3_u8) | (base_low & 7_u8);
}

const VEX_MAP_0F: u8 = 1_u8;
const VEX_MAP_0F38: u8 = 2_u8;
const VEX_MAP_0F3A: u8 = 3_u8;
const VEX_PP_NONE: u8 = 0_u8;
const VEX_PP_66: u8 = 1_u8;
const VEX_PP_F3: u8 = 2_u8;
const VEX_PP_F2: u8 = 3_u8;

fn patch_fixups(
    fixups: *[LabelFixup],
    labels: *[u32],
    code: *mut [u8],
) -> bool {
    var i: usize = 0_usize;
    while i < fixups.len {
        let fx = fixups[i];
        let lbl_idx = fx.label.widen.[usize]();
        if lbl_idx >= labels.len {
            return false;
        }
        let target = labels[lbl_idx];
        if target == LABEL_UNBOUND {
            return false;
        }
        let off0 = fx.patch_off.widen.[usize]();
        let off1 = off0 +% 1_usize;
        let off2 = off0 +% 2_usize;
        let off3 = off0 +% 3_usize;
        if off0 >= code.len || off1 >= code.len || off2 >= code.len || off3 >= code.len {
            return false;
        }
        let t64 = target.widen.[u64]().bitcast.[i64]();
        let p64 = (fx.patch_off.widen.[u64]() +% 4_u64).bitcast.[i64]();
        let disp = t64 -% p64;
        if disp < -2147483648_i64 || disp > 2147483647_i64 {
            return false;
        }
        let d32 = disp.trunc.[i32]().bitcast.[u32]();
        code[off0] = (d32 & 0xFF_u32).trunc.[u8]();
        code[off1] = ((d32 >> 8_u32) & 0xFF_u32).trunc.[u8]();
        code[off2] = ((d32 >> 16_u32) & 0xFF_u32).trunc.[u8]();
        code[off3] = ((d32 >> 24_u32) & 0xFF_u32).trunc.[u8]();
        i = i +% 1_usize;
    }
    return true;
}

impl X64Buf {
    pub fn init(alloc: *mut AllocCap) -> X64Buf ! OutOfMemory {
        let code = try col.DynBuf.[u8].init(alloc, 256_usize);
        errdefer code.destroy(alloc);
        let labels = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer labels.destroy(alloc);
        let fixups = try col.DynBuf.[LabelFixup].init(alloc, 16_usize);
        errdefer fixups.destroy(alloc);
        let relocs = try col.DynBuf.[FnReloc].init(alloc, 8_usize);
        errdefer relocs.destroy(alloc);
        return X64Buf.{
            code: code,
            labels: labels,
            fixups: fixups,
            relocs: relocs,
        };
    }

    pub fn clear(self: *mut Self) {
        self.code.clear();
        self.labels.clear();
        self.fixups.clear();
        self.relocs.clear();
    }

    pub fn destroy(self: X64Buf, alloc: *mut AllocCap) {
        let X64Buf.{ code, labels, fixups, relocs } = self;
        code.destroy(alloc);
        labels.destroy(alloc);
        fixups.destroy(alloc);
        relocs.destroy(alloc);
    }

    pub fn pos(self: *Self) -> u32 {
        return self.code.len().trunc.[u32]();
    }

    pub fn new_label(self: *mut Self, alloc: *mut AllocCap) -> u32 ! OutOfMemory {
        let id = self.labels.len().trunc.[u32]();
        try self.labels.push(alloc, LABEL_UNBOUND);
        return id;
    }

    pub fn bind_label(self: *mut Self, l: u32) {
        let idx = l.widen.[usize]();
        let cur_pos = self.code.len().trunc.[u32]();
        let lslice = self.labels.as_mut_slice();
        if idx < lslice.len {
            lslice[idx] = cur_pos;
        }
    }

    pub fn finish(self: *mut Self) -> bool {
        let ok = patch_fixups(
            self.fixups.as_slice(),
            self.labels.as_slice(),
            self.code.as_mut_slice(),
        );
        if ok {
            self.fixups.clear();
        }
        return ok;
    }

    pub fn emit_u8(self: *mut Self, alloc: *mut AllocCap, b: u8) -> !OutOfMemory {
        try self.code.push(alloc, b);
        return;
    }

    pub fn emit_u16(self: *mut Self, alloc: *mut AllocCap, v: u16) -> !OutOfMemory {
        try self.code.push(alloc, (v & 0xFF_u16).trunc.[u8]());
        try self.code.push(alloc, ((v >> 8_u16) & 0xFF_u16).trunc.[u8]());
        return;
    }

    pub fn emit_i16(self: *mut Self, alloc: *mut AllocCap, v: i16) -> !OutOfMemory {
        try self.emit_u16(alloc, v.bitcast.[u16]());
        return;
    }

    pub fn emit_u32(self: *mut Self, alloc: *mut AllocCap, v: u32) -> !OutOfMemory {
        try self.code.push(alloc, (v & 0xFF_u32).trunc.[u8]());
        try self.code.push(alloc, ((v >> 8_u32) & 0xFF_u32).trunc.[u8]());
        try self.code.push(alloc, ((v >> 16_u32) & 0xFF_u32).trunc.[u8]());
        try self.code.push(alloc, ((v >> 24_u32) & 0xFF_u32).trunc.[u8]());
        return;
    }

    pub fn emit_i32(self: *mut Self, alloc: *mut AllocCap, v: i32) -> !OutOfMemory {
        try self.emit_u32(alloc, v.bitcast.[u32]());
        return;
    }

    pub fn emit_u64(self: *mut Self, alloc: *mut AllocCap, v: u64) -> !OutOfMemory {
        try self.emit_u32(alloc, (v & 0xFFFFFFFF_u64).trunc.[u32]());
        try self.emit_u32(alloc, (v >> 32_u64).trunc.[u32]());
        return;
    }

    pub fn emit_bytes(self: *mut Self, alloc: *mut AllocCap, data: *[u8]) -> !OutOfMemory {
        try self.code.push_slice(alloc, data);
        return;
    }

    fn emit_rex(
        self: *mut Self,
        alloc: *mut AllocCap,
        w: bool,
        r: bool,
        x: bool,
        b: bool,
        force: bool,
    ) -> !OutOfMemory {
        var v: u8 = 0x40_u8;
        if w { v = v | 0x08_u8; }
        if r { v = v | 0x04_u8; }
        if x { v = v | 0x02_u8; }
        if b { v = v | 0x01_u8; }
        if force || v != 0x40_u8 {
            try self.emit_u8(alloc, v);
        }
        return;
    }

    fn emit_mem(
        self: *mut Self,
        alloc: *mut AllocCap,
        reg_field: u8,
        base: Reg,
        disp: i32,
    ) -> !OutOfMemory {
        let bl = base.low();
        if disp == 0_i32 && bl != 5_u8 {
            try self.emit_u8(alloc, modrm_byte(0_u8, reg_field, bl));
            if bl == 4_u8 {
                try self.emit_u8(alloc, 0x24_u8);
            }
        } else if disp >= -128_i32 && disp <= 127_i32 {
            try self.emit_u8(alloc, modrm_byte(1_u8, reg_field, bl));
            if bl == 4_u8 {
                try self.emit_u8(alloc, 0x24_u8);
            }
            try self.emit_u8(alloc, disp.bitcast.[u32]().trunc.[u8]());
        } else {
            try self.emit_u8(alloc, modrm_byte(2_u8, reg_field, bl));
            if bl == 4_u8 {
                try self.emit_u8(alloc, 0x24_u8);
            }
            try self.emit_i32(alloc, disp);
        }
        return;
    }

    fn push_sym_reloc(
        self: *mut Self,
        alloc: *mut AllocCap,
        kind: RelocKindX64,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        let off = self.pos();
        try self.emit_i32(alloc, 0_i32);
        try self.relocs.push(
            alloc,
            FnReloc.{ offset: off, kind: kind, sym_id: sym_id, addend: addend },
        );
        return;
    }

    // --- Basic stack & control flow ---

    pub fn push(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        if r.hi() {
            try self.emit_u8(alloc, 0x41_u8);
        }
        try self.emit_u8(alloc, 0x50_u8 +% r.low());
        return;
    }

    pub fn pop(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        if r.hi() {
            try self.emit_u8(alloc, 0x41_u8);
        }
        try self.emit_u8(alloc, 0x58_u8 +% r.low());
        return;
    }

    pub fn ret(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xC3_u8);
        return;
    }

    pub fn iretq(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x48_u8);
        try self.emit_u8(alloc, 0xCF_u8);
        return;
    }

    pub fn nop(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x90_u8);
        return;
    }

    pub fn hlt(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF4_u8);
        return;
    }

    pub fn cli(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xFA_u8);
        return;
    }

    pub fn sti(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xFB_u8);
        return;
    }

    pub fn clc(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF8_u8);
        return;
    }

    pub fn stc(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF9_u8);
        return;
    }

    pub fn pause(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF3_u8);
        try self.emit_u8(alloc, 0x90_u8);
        return;
    }

    pub fn mfence(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0xAE_u8);
        try self.emit_u8(alloc, 0xF0_u8);
        return;
    }

    pub fn lfence(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0xAE_u8);
        try self.emit_u8(alloc, 0xE8_u8);
        return;
    }

    pub fn sfence(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0xAE_u8);
        try self.emit_u8(alloc, 0xF8_u8);
        return;
    }

    pub fn ud2(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x0B_u8);
        return;
    }

    pub fn syscall(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x05_u8);
        return;
    }

    pub fn jmp_label(self: *mut Self, alloc: *mut AllocCap, l: u32) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xE9_u8);
        let off = self.pos();
        try self.emit_i32(alloc, 0_i32);
        try self.fixups.push(alloc, LabelFixup.{ patch_off: off, label: l });
        return;
    }

    pub fn jcc_label(self: *mut Self, alloc: *mut AllocCap, cc: Cond, l: u32) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x80_u8 | cc.id());
        let off = self.pos();
        try self.emit_i32(alloc, 0_i32);
        try self.fixups.push(alloc, LabelFixup.{ patch_off: off, label: l });
        return;
    }

    pub fn jmp_sym(self: *mut Self, alloc: *mut AllocCap, sym_id: u32) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xE9_u8);
        try self.push_sym_reloc(alloc, .Rel32, sym_id, 0_i64);
        return;
    }

    pub fn call_sym(self: *mut Self, alloc: *mut AllocCap, sym_id: u32) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xE8_u8);
        try self.push_sym_reloc(alloc, .Rel32, sym_id, 0_i64);
        return;
    }

    pub fn call_label(self: *mut Self, alloc: *mut AllocCap, l: u32) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xE8_u8);
        let off = self.pos();
        try self.emit_i32(alloc, 0_i32);
        try self.fixups.push(alloc, LabelFixup.{ patch_off: off, label: l });
        return;
    }

    pub fn call_reg(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xFF_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 2_u8, r.low()));
        return;
    }

    pub fn call_rip_sym(
        self: *mut Self,
        alloc: *mut AllocCap,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xFF_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, 2_u8, 5_u8));
        try self.push_sym_reloc(alloc, .Rel32, sym_id, addend);
        return;
    }

    pub fn jmp_rip_sym(
        self: *mut Self,
        alloc: *mut AllocCap,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xFF_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, 4_u8, 5_u8));
        try self.push_sym_reloc(alloc, .Rel32, sym_id, addend);
        return;
    }

    pub fn call_got_sym(
        self: *mut Self,
        alloc: *mut AllocCap,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xFF_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, 2_u8, 5_u8));
        try self.push_sym_reloc(alloc, .GotPcRel32, sym_id, addend);
        return;
    }

    pub fn jmp_got_sym(
        self: *mut Self,
        alloc: *mut AllocCap,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xFF_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, 4_u8, 5_u8));
        try self.push_sym_reloc(alloc, .GotPcRel32, sym_id, addend);
        return;
    }

    pub fn mov_got_load(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), false, false, true);
        try self.emit_u8(alloc, 0x8B_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, dst.low(), 5_u8));
        try self.push_sym_reloc(alloc, .GotPcRel32, sym_id, addend);
        return;
    }

    pub fn call_plt_sym(self: *mut Self, alloc: *mut AllocCap, sym_id: u32) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xE8_u8);
        try self.push_sym_reloc(alloc, .Plt32, sym_id, 0_i64);
        return;
    }

    pub fn jmp_plt_sym(self: *mut Self, alloc: *mut AllocCap, sym_id: u32) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xE9_u8);
        try self.push_sym_reloc(alloc, .Plt32, sym_id, 0_i64);
        return;
    }

    pub fn jmp_reg(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xFF_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 4_u8, r.low()));
        return;
    }

    pub fn lea_rip_sym(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), false, false, true);
        try self.emit_u8(alloc, 0x8D_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, dst.low(), 5_u8));
        try self.push_sym_reloc(alloc, .Rel32, sym_id, addend);
        return;
    }

    pub fn lea_rip_bss_or_sym(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.lea_rip_sym(alloc, dst, sym_id, addend);
        return;
    }

    pub fn lea_rip_label(self: *mut Self, alloc: *mut AllocCap, dst: Reg, l: u32) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), false, false, true);
        try self.emit_u8(alloc, 0x8D_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, dst.low(), 5_u8));
        let off = self.pos();
        try self.emit_i32(alloc, 0_i32);
        try self.fixups.push(alloc, LabelFixup.{ patch_off: off, label: l });
        return;
    }

    pub fn mov_rip_load(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), false, false, true);
        try self.emit_u8(alloc, 0x8B_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, dst.low(), 5_u8));
        try self.push_sym_reloc(alloc, .Rel32, sym_id, addend);
        return;
    }

    pub fn mov_rip_store(
        self: *mut Self,
        alloc: *mut AllocCap,
        sym_id: u32,
        addend: i64,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, src.hi(), false, false, true);
        try self.emit_u8(alloc, 0x89_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, src.low(), 5_u8));
        try self.push_sym_reloc(alloc, .Rel32, sym_id, addend);
        return;
    }

    pub fn load_fs_disp(self: *mut Self, alloc: *mut AllocCap, dst: Reg, disp32: i32) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x64_u8);
        try self.emit_rex(alloc, true, dst.hi(), false, false, true);
        try self.emit_u8(alloc, 0x8B_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, dst.low(), 4_u8));
        try self.emit_u8(alloc, 0x25_u8);
        try self.emit_i32(alloc, disp32);
        return;
    }

    pub fn load_gs_disp(self: *mut Self, alloc: *mut AllocCap, dst: Reg, disp32: i32) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x65_u8);
        try self.emit_rex(alloc, true, dst.hi(), false, false, true);
        try self.emit_u8(alloc, 0x8B_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, dst.low(), 4_u8));
        try self.emit_u8(alloc, 0x25_u8);
        try self.emit_i32(alloc, disp32);
        return;
    }

    pub fn store_fs_disp(self: *mut Self, alloc: *mut AllocCap, disp32: i32, src: Reg) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x64_u8);
        try self.emit_rex(alloc, true, src.hi(), false, false, true);
        try self.emit_u8(alloc, 0x89_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, src.low(), 4_u8));
        try self.emit_u8(alloc, 0x25_u8);
        try self.emit_i32(alloc, disp32);
        return;
    }

    pub fn load_fs_tpoff(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x64_u8);
        try self.emit_rex(alloc, true, dst.hi(), false, false, true);
        try self.emit_u8(alloc, 0x8B_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, dst.low(), 4_u8));
        try self.emit_u8(alloc, 0x25_u8);
        try self.push_sym_reloc(alloc, .TpOff32, sym_id, addend);
        return;
    }

    pub fn store_fs_tpoff(
        self: *mut Self,
        alloc: *mut AllocCap,
        sym_id: u32,
        addend: i64,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x64_u8);
        try self.emit_rex(alloc, true, src.hi(), false, false, true);
        try self.emit_u8(alloc, 0x89_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, src.low(), 4_u8));
        try self.emit_u8(alloc, 0x25_u8);
        try self.push_sym_reloc(alloc, .TpOff32, sym_id, addend);
        return;
    }

    pub fn lea_fs_tpoff(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.load_fs_disp(alloc, dst, 0_i32);
        try self.emit_rex(alloc, true, dst.hi(), false, dst.hi(), true);
        try self.emit_u8(alloc, 0x8D_u8);
        try self.emit_u8(alloc, modrm_byte(2_u8, dst.low(), dst.low()));
        if dst.low() == 4_u8 {
            try self.emit_u8(alloc, 0x24_u8);
        }
        try self.push_sym_reloc(alloc, .TpOff32, sym_id, addend);
        return;
    }

    pub fn store_imm32_mem(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        disp: i32,
        imm: i32,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, base.hi(), false);
        try self.emit_u8(alloc, 0xC7_u8);
        try self.emit_mem(alloc, 0_u8, base, disp);
        try self.emit_i32(alloc, imm);
        return;
    }

    pub fn store_imm64_sext_mem(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        disp: i32,
        imm: i32,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, false, false, base.hi(), true);
        try self.emit_u8(alloc, 0xC7_u8);
        try self.emit_mem(alloc, 0_u8, base, disp);
        try self.emit_i32(alloc, imm);
        return;
    }

    pub fn cpuid(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0xA2_u8);
        return;
    }

    pub fn rdtsc(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x31_u8);
        return;
    }

    pub fn stmxcsr(self: *mut Self, alloc: *mut AllocCap, base: Reg, disp: i32) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0xAE_u8);
        try self.emit_mem(alloc, 3_u8, base, disp);
        return;
    }

    pub fn ldmxcsr(self: *mut Self, alloc: *mut AllocCap, base: Reg, disp: i32) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0xAE_u8);
        try self.emit_mem(alloc, 2_u8, base, disp);
        return;
    }

    pub fn fnstcw(self: *mut Self, alloc: *mut AllocCap, base: Reg, disp: i32) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, base.hi(), false);
        try self.emit_u8(alloc, 0xD9_u8);
        try self.emit_mem(alloc, 7_u8, base, disp);
        return;
    }

    pub fn fldcw(self: *mut Self, alloc: *mut AllocCap, base: Reg, disp: i32) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, base.hi(), false);
        try self.emit_u8(alloc, 0xD9_u8);
        try self.emit_mem(alloc, 5_u8, base, disp);
        return;
    }

    pub fn mov_abs_sym(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        sym_id: u32,
        addend: i64,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, false, false, dst.hi(), true);
        try self.emit_u8(alloc, 0xB8_u8 +% dst.low());
        let off = self.pos();
        try self.emit_u64(alloc, 0_u64);
        try self.relocs.push(
            alloc,
            FnReloc.{ offset: off, kind: .Abs64, sym_id: sym_id, addend: addend },
        );
        return;
    }

    // --- Moves & Loads / Stores ---

    pub fn mov_rr(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        if dst.id() == src.id() {
            return;
        }
        try self.emit_rex(alloc, true, src.hi(), false, dst.hi(), true);
        try self.emit_u8(alloc, 0x89_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        return;
    }

    pub fn mov_ri64(self: *mut Self, alloc: *mut AllocCap, dst: Reg, val: u64) -> !OutOfMemory {
        let sval = val.bitcast.[i64]();
        if val == 0_u64 {
            try self.xor_rr32(alloc, dst, dst);
        } else if val <= 0xFFFFFFFF_u64 {
            try self.emit_rex(alloc, false, false, false, dst.hi(), false);
            try self.emit_u8(alloc, 0xB8_u8 +% dst.low());
            try self.emit_u32(alloc, val.trunc.[u32]());
        } else if sval >= -2147483648_i64 && sval <= 2147483647_i64 {
            try self.emit_rex(alloc, true, false, false, dst.hi(), true);
            try self.emit_u8(alloc, 0xC7_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, 0_u8, dst.low()));
            try self.emit_i32(alloc, sval.trunc.[i32]());
        } else {
            try self.emit_rex(alloc, true, false, false, dst.hi(), true);
            try self.emit_u8(alloc, 0xB8_u8 +% dst.low());
            try self.emit_u64(alloc, val);
        }
        return;
    }

    pub fn lea_mem(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        base: Reg,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), false, base.hi(), true);
        try self.emit_u8(alloc, 0x8D_u8);
        try self.emit_mem(alloc, dst.low(), base, disp);
        return;
    }

    pub fn load_mem(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        base: Reg,
        disp: i32,
        bytes: usize,
        signed: bool,
    ) -> !OutOfMemory {
        if bytes == 8_usize {
            try self.emit_rex(alloc, true, dst.hi(), false, base.hi(), true);
            try self.emit_u8(alloc, 0x8B_u8);
            try self.emit_mem(alloc, dst.low(), base, disp);
        } else if bytes == 4_usize && !signed {
            try self.emit_rex(alloc, false, dst.hi(), false, base.hi(), false);
            try self.emit_u8(alloc, 0x8B_u8);
            try self.emit_mem(alloc, dst.low(), base, disp);
        } else if bytes == 4_usize && signed {
            try self.emit_rex(alloc, true, dst.hi(), false, base.hi(), true);
            try self.emit_u8(alloc, 0x63_u8);
            try self.emit_mem(alloc, dst.low(), base, disp);
        } else if bytes == 2_usize && !signed {
            try self.emit_rex(alloc, false, dst.hi(), false, base.hi(), false);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xB7_u8);
            try self.emit_mem(alloc, dst.low(), base, disp);
        } else if bytes == 2_usize && signed {
            try self.emit_rex(alloc, true, dst.hi(), false, base.hi(), true);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xBF_u8);
            try self.emit_mem(alloc, dst.low(), base, disp);
        } else if bytes == 1_usize && !signed {
            try self.emit_rex(alloc, false, dst.hi(), false, base.hi(), false);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xB6_u8);
            try self.emit_mem(alloc, dst.low(), base, disp);
        } else if bytes == 1_usize && signed {
            try self.emit_rex(alloc, true, dst.hi(), false, base.hi(), true);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xBE_u8);
            try self.emit_mem(alloc, dst.low(), base, disp);
        } else {
            try self.emit_rex(alloc, true, dst.hi(), false, base.hi(), true);
            try self.emit_u8(alloc, 0x8B_u8);
            try self.emit_mem(alloc, dst.low(), base, disp);
        }
        return;
    }

    pub fn store_mem(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        disp: i32,
        src: Reg,
        bytes: usize,
    ) -> !OutOfMemory {
        if bytes == 8_usize {
            try self.emit_rex(alloc, true, src.hi(), false, base.hi(), true);
            try self.emit_u8(alloc, 0x89_u8);
            try self.emit_mem(alloc, src.low(), base, disp);
        } else if bytes == 4_usize {
            try self.emit_rex(alloc, false, src.hi(), false, base.hi(), false);
            try self.emit_u8(alloc, 0x89_u8);
            try self.emit_mem(alloc, src.low(), base, disp);
        } else if bytes == 2_usize {
            try self.emit_u8(alloc, 0x66_u8);
            try self.emit_rex(alloc, false, src.hi(), false, base.hi(), false);
            try self.emit_u8(alloc, 0x89_u8);
            try self.emit_mem(alloc, src.low(), base, disp);
        } else if bytes == 1_usize {
            let need_rex = src.id() >= 4_u8 || base.hi();
            try self.emit_rex(alloc, false, src.hi(), false, base.hi(), need_rex);
            try self.emit_u8(alloc, 0x88_u8);
            try self.emit_mem(alloc, src.low(), base, disp);
        } else {
            try self.emit_rex(alloc, true, src.hi(), false, base.hi(), true);
            try self.emit_u8(alloc, 0x89_u8);
            try self.emit_mem(alloc, src.low(), base, disp);
        }
        return;
    }

    pub fn extend_reg(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        src: Reg,
        bits: u8,
        signed: bool,
    ) -> !OutOfMemory {
        if bits == 8_u8 && !signed {
            let need_rex = src.id() >= 4_u8 || dst.hi();
            try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), need_rex);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xB6_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        } else if bits == 8_u8 && signed {
            try self.emit_rex(alloc, true, dst.hi(), false, src.hi(), true);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xBE_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        } else if bits == 16_u8 && !signed {
            try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xB7_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        } else if bits == 16_u8 && signed {
            try self.emit_rex(alloc, true, dst.hi(), false, src.hi(), true);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xBF_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        } else if bits == 32_u8 && !signed {
            try self.emit_rex(alloc, false, src.hi(), false, dst.hi(), false);
            try self.emit_u8(alloc, 0x89_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        } else if bits == 32_u8 && signed {
            try self.emit_rex(alloc, true, dst.hi(), false, src.hi(), true);
            try self.emit_u8(alloc, 0x63_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        } else {
            try self.mov_rr(alloc, dst, src);
        }
        return;
    }

    // --- Integer ALU (64-bit & 32-bit) ---

    fn alu_rr(self: *mut Self, alloc: *mut AllocCap, op: u8, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, true, src.hi(), false, dst.hi(), true);
        try self.emit_u8(alloc, op);
        try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        return;
    }

    fn alu_ri32(self: *mut Self, alloc: *mut AllocCap, ext: u8, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.emit_rex(alloc, true, false, false, dst.hi(), true);
        if imm >= -128_i32 && imm <= 127_i32 {
            try self.emit_u8(alloc, 0x83_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, ext, dst.low()));
            try self.emit_u8(alloc, imm.bitcast.[u32]().trunc.[u8]());
        } else {
            try self.emit_u8(alloc, 0x81_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, ext, dst.low()));
            try self.emit_i32(alloc, imm);
        }
        return;
    }

    pub fn add_rr(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.alu_rr(alloc, 0x01_u8, dst, src);
        return;
    }

    pub fn sub_rr(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.alu_rr(alloc, 0x29_u8, dst, src);
        return;
    }

    pub fn and_rr(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.alu_rr(alloc, 0x21_u8, dst, src);
        return;
    }

    pub fn or_rr(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.alu_rr(alloc, 0x09_u8, dst, src);
        return;
    }

    pub fn xor_rr(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.alu_rr(alloc, 0x31_u8, dst, src);
        return;
    }

    pub fn cmp_rr(self: *mut Self, alloc: *mut AllocCap, lhs: Reg, rhs: Reg) -> !OutOfMemory {
        try self.alu_rr(alloc, 0x39_u8, lhs, rhs);
        return;
    }

    fn alu_rm(self: *mut Self, alloc: *mut AllocCap, op: u8, dst: Reg, base: Reg, disp: i32) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), false, base.hi(), true);
        try self.emit_u8(alloc, op);
        try self.emit_mem(alloc, dst.low(), base, disp);
        return;
    }

    pub fn add_rm(self: *mut Self, alloc: *mut AllocCap, dst: Reg, base: Reg, disp: i32) -> !OutOfMemory {
        try self.alu_rm(alloc, 0x03_u8, dst, base, disp);
        return;
    }

    pub fn sub_rm(self: *mut Self, alloc: *mut AllocCap, dst: Reg, base: Reg, disp: i32) -> !OutOfMemory {
        try self.alu_rm(alloc, 0x2B_u8, dst, base, disp);
        return;
    }

    pub fn and_rm(self: *mut Self, alloc: *mut AllocCap, dst: Reg, base: Reg, disp: i32) -> !OutOfMemory {
        try self.alu_rm(alloc, 0x23_u8, dst, base, disp);
        return;
    }

    pub fn or_rm(self: *mut Self, alloc: *mut AllocCap, dst: Reg, base: Reg, disp: i32) -> !OutOfMemory {
        try self.alu_rm(alloc, 0x0B_u8, dst, base, disp);
        return;
    }

    pub fn xor_rm(self: *mut Self, alloc: *mut AllocCap, dst: Reg, base: Reg, disp: i32) -> !OutOfMemory {
        try self.alu_rm(alloc, 0x33_u8, dst, base, disp);
        return;
    }

    pub fn cmp_rm(self: *mut Self, alloc: *mut AllocCap, lhs: Reg, base: Reg, disp: i32) -> !OutOfMemory {
        try self.alu_rm(alloc, 0x3B_u8, lhs, base, disp);
        return;
    }

    pub fn cmp_mr(self: *mut Self, alloc: *mut AllocCap, base: Reg, disp: i32, rhs: Reg) -> !OutOfMemory {
        try self.alu_rm(alloc, 0x39_u8, rhs, base, disp);
        return;
    }

    pub fn imul_rm(self: *mut Self, alloc: *mut AllocCap, dst: Reg, base: Reg, disp: i32) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), false, base.hi(), true);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0xAF_u8);
        try self.emit_mem(alloc, dst.low(), base, disp);
        return;
    }

    pub fn xor_rr32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, src.hi(), false, dst.hi(), false);
        try self.emit_u8(alloc, 0x31_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        return;
    }

    pub fn add_ri32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        if imm != 0_i32 {
            try self.alu_ri32(alloc, 0_u8, dst, imm);
        }
        return;
    }

    pub fn sub_ri32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        if imm != 0_i32 {
            try self.alu_ri32(alloc, 5_u8, dst, imm);
        }
        return;
    }

    pub fn and_ri32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.alu_ri32(alloc, 4_u8, dst, imm);
        return;
    }

    pub fn or_ri32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.alu_ri32(alloc, 1_u8, dst, imm);
        return;
    }

    pub fn xor_ri32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.alu_ri32(alloc, 6_u8, dst, imm);
        return;
    }

    pub fn cmp_ri32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.alu_ri32(alloc, 7_u8, dst, imm);
        return;
    }

    pub fn test_rr(self: *mut Self, alloc: *mut AllocCap, a: Reg, b: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, true, b.hi(), false, a.hi(), true);
        try self.emit_u8(alloc, 0x85_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, b.low(), a.low()));
        return;
    }

    pub fn test_rr32(self: *mut Self, alloc: *mut AllocCap, a: Reg, b: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, b.hi(), false, a.hi(), false);
        try self.emit_u8(alloc, 0x85_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, b.low(), a.low()));
        return;
    }

    pub fn neg_r(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, true, false, false, r.hi(), true);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 3_u8, r.low()));
        return;
    }

    pub fn not_r(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, true, false, false, r.hi(), true);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 2_u8, r.low()));
        return;
    }

    pub fn imul_rr(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), false, src.hi(), true);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0xAF_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn imul_rri32(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        src: Reg,
        imm: i32,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), false, src.hi(), true);
        try self.emit_u8(alloc, 0x69_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        try self.emit_i32(alloc, imm);
        return;
    }

    pub fn mul_r(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, true, false, false, r.hi(), true);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 4_u8, r.low()));
        return;
    }

    pub fn cqo(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x48_u8);
        try self.emit_u8(alloc, 0x99_u8);
        return;
    }

