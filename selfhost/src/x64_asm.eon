    pub fn vpminsd(self: *mut Self, alloc: *mut AllocCap, dst: Xmm, src1: Xmm, src2: Xmm, l256: bool) -> !OutOfMemory {
        try self.vex_rr(alloc, VEX_MAP_0F38, VEX_PP_66, false, l256, 0x39_u8, dst, src1, src2);
        return;
    }

    pub fn vpmaxsd(self: *mut Self, alloc: *mut AllocCap, dst: Xmm, src1: Xmm, src2: Xmm, l256: bool) -> !OutOfMemory {
        try self.vex_rr(alloc, VEX_MAP_0F38, VEX_PP_66, false, l256, 0x3D_u8, dst, src1, src2);
        return;
    }

    pub fn vpcmpeqb(self: *mut Self, alloc: *mut AllocCap, dst: Xmm, src1: Xmm, src2: Xmm, l256: bool) -> !OutOfMemory {
        try self.vex_rr(alloc, VEX_MAP_0F, VEX_PP_66, false, l256, 0x74_u8, dst, src1, src2);
        return;
    }

    pub fn vpcmpeqd(self: *mut Self, alloc: *mut AllocCap, dst: Xmm, src1: Xmm, src2: Xmm, l256: bool) -> !OutOfMemory {
        try self.vex_rr(alloc, VEX_MAP_0F, VEX_PP_66, false, l256, 0x76_u8, dst, src1, src2);
        return;
    }

    pub fn vpcmpgtd(self: *mut Self, alloc: *mut AllocCap, dst: Xmm, src1: Xmm, src2: Xmm, l256: bool) -> !OutOfMemory {
        try self.vex_rr(alloc, VEX_MAP_0F, VEX_PP_66, false, l256, 0x66_u8, dst, src1, src2);
        return;
    }

    pub fn vpmovmskb(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        src: Xmm,
        l256: bool,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, dst.hi(), false, src.hi(), VEX_MAP_0F, false, 0_u8, l256, VEX_PP_66);
        try self.emit_u8(alloc, 0xD7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn vpslld_imm(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Xmm,
        imm: u8,
        l256: bool,
    ) -> !OutOfMemory {
        try self.vex_shift_imm(alloc, l256, 0x72_u8, 6_u8, dst, src, imm);
        return;
    }

    pub fn vpsrld_imm(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Xmm,
        imm: u8,
        l256: bool,
    ) -> !OutOfMemory {
        try self.vex_shift_imm(alloc, l256, 0x72_u8, 2_u8, dst, src, imm);
        return;
    }

    pub fn vpsrad_imm(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Xmm,
        imm: u8,
        l256: bool,
    ) -> !OutOfMemory {
        try self.vex_shift_imm(alloc, l256, 0x72_u8, 4_u8, dst, src, imm);
        return;
    }

    pub fn vpsllw_imm(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Xmm,
        imm: u8,
        l256: bool,
    ) -> !OutOfMemory {
        try self.vex_shift_imm(alloc, l256, 0x71_u8, 6_u8, dst, src, imm);
        return;
    }

    pub fn vpbroadcastb_xmm(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Xmm,
        l256: bool,
    ) -> !OutOfMemory {
        try self.vex_r2(alloc, VEX_MAP_0F38, VEX_PP_66, false, l256, 0x78_u8, dst, src);
        return;
    }

    pub fn vpbroadcastd_xmm(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Xmm,
        l256: bool,
    ) -> !OutOfMemory {
        try self.vex_r2(alloc, VEX_MAP_0F38, VEX_PP_66, false, l256, 0x58_u8, dst, src);
        return;
    }

    pub fn vmovd_xmm_r32(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, dst.hi(), false, src.hi(), VEX_MAP_0F, false, 0_u8, false, VEX_PP_66);
        try self.emit_u8(alloc, 0x6E_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn vmovd_r32_xmm(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, src.hi(), false, dst.hi(), VEX_MAP_0F, false, 0_u8, false, VEX_PP_66);
        try self.emit_u8(alloc, 0x7E_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        return;
    }

    pub fn vmovq_xmm_r64(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, dst.hi(), false, src.hi(), VEX_MAP_0F, true, 0_u8, false, VEX_PP_66);
        try self.emit_u8(alloc, 0x6E_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn vmovq_r64_xmm(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, src.hi(), false, dst.hi(), VEX_MAP_0F, true, 0_u8, false, VEX_PP_66);
        try self.emit_u8(alloc, 0x7E_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        return;
    }
}

// ============================================================================
// Inline x86_64 Mini-Assembler & Win64-to-EonCall ABI Trampoline
// ============================================================================

fn ascii_lower(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' {
        return c +% 32_u8;
    }
    return c;
}

fn eq_ascii_ci(a: *[u8], lit: *str) -> bool {
    let b = lit.as_bytes();
    if a.len != b.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < a.len {
        if ascii_lower(a[i]) != b[i] {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

fn is_ascii_ws(c: u8) -> bool {
    return c == 32_u8 || c == 9_u8 || c == 13_u8 || c == 10_u8 || c == 11_u8 || c == 12_u8;
}

view fn trim_ws(s: *[u8]) -> *[u8] {
    var start: usize = 0_usize;
    var end: usize = s.len;
    while start < end && is_ascii_ws(s[start]) {
        start = start +% 1_usize;
    }
    while end > start && is_ascii_ws(s[end - 1_usize]) {
        end = end - 1_usize;
    }
    return s.sub(start, end) catch {
        return s;
    };
}

view fn strip_leading_byte(s: *[u8], ch: u8) -> *[u8] {
    var start: usize = 0_usize;
    while start < s.len && s[start] == ch {
        start = start +% 1_usize;
    }
    return s.sub(start, s.len) catch {
        return s;
    };
}

view fn strip_line_comment(s: *[u8]) -> *[u8] {
    var i: usize = 0_usize;
    while i < s.len {
        let i1 = i +% 1_usize;
        if i1 < s.len && s[i] == b'/' && s[i1] == b'/' {
            return s.sub(0_usize, i) catch {
                return s;
            };
        }
        i = i +% 1_usize;
    }
    return s;
}

fn parse_reg64(s: *[u8]) -> ?Reg {
    let t = strip_leading_byte(trim_ws(s), b'%');
    if eq_ascii_ci(t, "rax") || eq_ascii_ci(t, "eax") { return .Rax; }
    if eq_ascii_ci(t, "rcx") || eq_ascii_ci(t, "ecx") { return .Rcx; }
    if eq_ascii_ci(t, "rdx") || eq_ascii_ci(t, "edx") { return .Rdx; }
    if eq_ascii_ci(t, "rbx") || eq_ascii_ci(t, "ebx") { return .Rbx; }
    if eq_ascii_ci(t, "rsp") || eq_ascii_ci(t, "esp") { return .Rsp; }
    if eq_ascii_ci(t, "rbp") || eq_ascii_ci(t, "ebp") { return .Rbp; }
    if eq_ascii_ci(t, "rsi") || eq_ascii_ci(t, "esi") { return .Rsi; }
    if eq_ascii_ci(t, "rdi") || eq_ascii_ci(t, "edi") { return .Rdi; }
    if eq_ascii_ci(t, "r8") { return .R8; }
    if eq_ascii_ci(t, "r9") { return .R9; }
    if eq_ascii_ci(t, "r10") { return .R10; }
    if eq_ascii_ci(t, "r11") { return .R11; }
    if eq_ascii_ci(t, "r12") { return .R12; }
    if eq_ascii_ci(t, "r13") { return .R13; }
    if eq_ascii_ci(t, "r14") { return .R14; }
    if eq_ascii_ci(t, "r15") { return .R15; }
    return null;
}

fn parse_asm_imm(s: *[u8]) -> ?u64 {
    let t = strip_leading_byte(trim_ws(s), b'$');
    if t.len >= 2_usize && t[0_usize] == b'0' && (t[1_usize] == b'x' || t[1_usize] == b'X') {
        let hex = t.sub(2_usize, t.len) catch {
            return null;
        };
        return str.parse_u64_radix(hex, 16_u64);
    }
    return str.parse_u64_radix(t, 10_u64);
}

fn find_byte(s: *[u8], ch: u8) -> usize {
    var i: usize = 0_usize;
    while i < s.len {
        if s[i] == ch {
            return i;
        }
        i = i +% 1_usize;
    }
    return s.len;
}

fn find_first_ws(s: *[u8]) -> usize {
    var i: usize = 0_usize;
    while i < s.len {
        if is_ascii_ws(s[i]) {
            return i;
        }
        i = i +% 1_usize;
    }
    return s.len;
}

fn encode_inline_asm_no_ops(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    mnem: *[u8],
) -> u8 ! OutOfMemory {
    if eq_ascii_ci(mnem, "nop") { try b.nop(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "hlt") { try b.hlt(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "cli") { try b.cli(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "sti") { try b.sti(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "pause") { try b.pause(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "mfence") { try b.mfence(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "lfence") { try b.lfence(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "sfence") { try b.sfence(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "ret") { try b.ret(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "iretq") { try b.iretq(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "syscall") { try b.syscall(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "ud2") { try b.ud2(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "clc") { try b.clc(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "stc") { try b.stc(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "cpuid") { try b.cpuid(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "rdtsc") { try b.rdtsc(alloc); return 1_u8; }
    if eq_ascii_ci(mnem, "rdmsr") {
        try b.emit_u8(alloc, 0x0F_u8);
        try b.emit_u8(alloc, 0x32_u8);
        return 1_u8;
    }
    if eq_ascii_ci(mnem, "wrmsr") {
        try b.emit_u8(alloc, 0x0F_u8);
        try b.emit_u8(alloc, 0x30_u8);
        return 1_u8;
    }
    if eq_ascii_ci(mnem, "in") || eq_ascii_ci(mnem, "inb") { try b.emit_u8(alloc, 0xEC_u8); return 1_u8; }
    if eq_ascii_ci(mnem, "out") || eq_ascii_ci(mnem, "outb") { try b.emit_u8(alloc, 0xEE_u8); return 1_u8; }
    if eq_ascii_ci(mnem, "inw") { try b.emit_u8(alloc, 0x66_u8); try b.emit_u8(alloc, 0xED_u8); return 1_u8; }
    if eq_ascii_ci(mnem, "outw") { try b.emit_u8(alloc, 0x66_u8); try b.emit_u8(alloc, 0xEF_u8); return 1_u8; }
    if eq_ascii_ci(mnem, "inl") { try b.emit_u8(alloc, 0xED_u8); return 1_u8; }
    if eq_ascii_ci(mnem, "outl") { try b.emit_u8(alloc, 0xEF_u8); return 1_u8; }
    if eq_ascii_ci(mnem, "retfq") { try b.emit_u8(alloc, 0x48_u8); try b.emit_u8(alloc, 0xCB_u8); return 1_u8; }
    if eq_ascii_ci(mnem, "swapgs") {
        try b.emit_u8(alloc, 0x0F_u8);
        try b.emit_u8(alloc, 0x01_u8);
        try b.emit_u8(alloc, 0xF8_u8);
        return 1_u8;
    }
    if eq_ascii_ci(mnem, "cld") { try b.emit_u8(alloc, 0xFC_u8); return 1_u8; }
    if eq_ascii_ci(mnem, "std") { try b.emit_u8(alloc, 0xFD_u8); return 1_u8; }
    return 0_u8;
}

fn parse_mem_reg64(s: *[u8]) -> ?Reg {
    let t = trim_ws(s);
    if t.len >= 3_usize && ((t[0_usize] == b'[' && t[t.len - 1_usize] == b']') || (t[0_usize] == b'(' && t[t.len - 1_usize] == b')')) {
        let inner = t.sub(1_usize, t.len - 1_usize) catch {
            return null;
        };
        return parse_reg64(inner);
    }
    return parse_reg64(t);
}

fn parse_cr_num(s: *[u8]) -> ?u8 {
    let t = strip_leading_byte(trim_ws(s), b'%');
    if eq_ascii_ci(t, "cr0") { return 0_u8; }
    if eq_ascii_ci(t, "cr2") { return 2_u8; }
    if eq_ascii_ci(t, "cr3") { return 3_u8; }
    if eq_ascii_ci(t, "cr4") { return 4_u8; }
    return null;
}

fn parse_seg_num(s: *[u8]) -> ?u8 {
    let t = strip_leading_byte(trim_ws(s), b'%');
    if eq_ascii_ci(t, "es") { return 0_u8; }
    if eq_ascii_ci(t, "ss") { return 2_u8; }
    if eq_ascii_ci(t, "ds") { return 3_u8; }
    if eq_ascii_ci(t, "fs") { return 4_u8; }
    if eq_ascii_ci(t, "gs") { return 5_u8; }
    return null;
}

fn emit_0f01_mem(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    ext: u8,
    r: Reg,
) -> !OutOfMemory {
    if r.hi() {
        try b.emit_u8(alloc, 0x41_u8);
    }
    try b.emit_u8(alloc, 0x0F_u8);
    try b.emit_u8(alloc, 0x01_u8);
    let lo = r.low();
    if lo == 5_u8 {
        // [rbp + 0] / [r13 + 0]
        try b.emit_u8(alloc, 0x40_u8 | ((ext & 7_u8) <<% 3_u8) | 5_u8);
        try b.emit_u8(alloc, 0_u8);
    } else if lo == 4_u8 {
        // [rsp] / [r12]
        try b.emit_u8(alloc, ((ext & 7_u8) <<% 3_u8) | 4_u8);
        try b.emit_u8(alloc, 0x24_u8);
    } else {
        try b.emit_u8(alloc, ((ext & 7_u8) <<% 3_u8) | lo);
    }
    return;
}

fn encode_inline_asm_line(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    raw_line: *[u8],
) -> bool ! OutOfMemory {
    let line = trim_ws(strip_line_comment(raw_line));
    if line.len == 0_usize {
        return true;
    }
    let split_pos = find_first_ws(line);
    let mnem = line.sub(0_usize, split_pos) catch {
        return false;
    };
    let ops_raw = line.sub(split_pos, line.len) catch {
        return false;
    };
    let ops = trim_ws(ops_raw);

    let handled = try encode_inline_asm_no_ops(alloc, b, mnem);
    if handled != 0_u8 {
        return true;
    }
    if eq_ascii_ci(mnem, ".byte") {
        var pos: usize = 0_usize;
        while pos < ops.len {
            let rest = ops.sub(pos, ops.len) catch { return false; };
            let c = find_byte(rest, b',');
            let tok = trim_ws(rest.sub(0_usize, c) catch { return false; });
            if tok.len > 0_usize {
                if let bv = parse_asm_imm(tok) {
                    try b.emit_u8(alloc, bv.trunc.[u8]());
                } else {
                    return false;
                }
            }
            if c >= rest.len {
                break;
            }
            pos = pos +% c +% 1_usize;
        }
        return true;
    }
    if eq_ascii_ci(mnem, "int") {
        let vec = (parse_asm_imm(ops) orelse 3_u64).trunc.[u8]();
        try b.emit_u8(alloc, 0xCD_u8);
        try b.emit_u8(alloc, vec);
        return true;
    }
    if eq_ascii_ci(mnem, "push") {
        if let r = parse_reg64(ops) {
            try b.push(alloc, r);
        }
        return true;
    }
    if eq_ascii_ci(mnem, "pop") {
        if let r = parse_reg64(ops) {
            try b.pop(alloc, r);
        }
        return true;
    }
    if eq_ascii_ci(mnem, "jmp") {
        if let r = parse_reg64(ops) {
            try b.jmp_reg(alloc, r);
            return true;
        }
        return false;
    }
    if eq_ascii_ci(mnem, "call") {
        if let r = parse_reg64(ops) {
            try b.call_reg(alloc, r);
            return true;
        }
        return false;
    }
    if eq_ascii_ci(mnem, "lgdt") {
        if let r = parse_mem_reg64(ops) {
            try emit_0f01_mem(alloc, b, 2_u8, r);
            return true;
        }
        return false;
    }
    if eq_ascii_ci(mnem, "lidt") {
        if let r = parse_mem_reg64(ops) {
            try emit_0f01_mem(alloc, b, 3_u8, r);
            return true;
        }
        return false;
    }
    if eq_ascii_ci(mnem, "invlpg") {
        if let r = parse_mem_reg64(ops) {
            try emit_0f01_mem(alloc, b, 7_u8, r);
            return true;
        }
        return false;
    }
    if eq_ascii_ci(mnem, "ltr") {
        if let r = parse_reg64(ops) {
            if r.hi() {
                try b.emit_u8(alloc, 0x41_u8);
            }
            try b.emit_u8(alloc, 0x0F_u8);
            try b.emit_u8(alloc, 0x00_u8);
            try b.emit_u8(alloc, 0xD8_u8 | r.low());
            return true;
        }
        return false;
    }
    if eq_ascii_ci(mnem, "shl") || eq_ascii_ci(mnem, "shr") {
        let comma = find_byte(ops, b',');
        let dst_s = trim_ws(ops.sub(0_usize, comma) catch { return false; });
        let src_start = if comma < ops.len { comma +% 1_usize } else { ops.len };
        let src_s = trim_ws(ops.sub(src_start, ops.len) catch { return false; });
        if let dst = parse_reg64(dst_s) {
            if let imm = parse_asm_imm(src_s) {
                if eq_ascii_ci(mnem, "shl") {
                    try b.shl_imm(alloc, dst, imm.trunc.[u8]());
                } else {
                    try b.shr_imm(alloc, dst, imm.trunc.[u8]());
                }
                return true;
            }
        }
        return false;
    }
    if eq_ascii_ci(mnem, "mov") || eq_ascii_ci(mnem, "xor") || eq_ascii_ci(mnem, "or") {
        let comma = find_byte(ops, b',');
        let dst_s = trim_ws(ops.sub(0_usize, comma) catch { return true; });
        let src_start = if comma < ops.len { comma +% 1_usize } else { ops.len };
        let src_s = trim_ws(ops.sub(src_start, ops.len) catch { return true; });
        if eq_ascii_ci(mnem, "mov") {
            if let cr_dst = parse_cr_num(dst_s) {
                if let src = parse_reg64(src_s) {
                    if src.hi() { try b.emit_u8(alloc, 0x41_u8); }
                    try b.emit_u8(alloc, 0x0F_u8);
                    try b.emit_u8(alloc, 0x22_u8);
                    try b.emit_u8(alloc, 0xC0_u8 | ((cr_dst & 7_u8) <<% 3_u8) | src.low());
                    return true;
                }
            }
            if let seg_dst = parse_seg_num(dst_s) {
                if let src = parse_reg64(src_s) {
                    if src.hi() { try b.emit_u8(alloc, 0x41_u8); }
                    try b.emit_u8(alloc, 0x8E_u8);
                    try b.emit_u8(alloc, 0xC0_u8 | ((seg_dst & 7_u8) <<% 3_u8) | src.low());
                    return true;
                }
            }
        }
        if let dst = parse_reg64(dst_s) {
            if eq_ascii_ci(mnem, "mov") {
                if let cr_src = parse_cr_num(src_s) {
                    if dst.hi() { try b.emit_u8(alloc, 0x41_u8); }
                    try b.emit_u8(alloc, 0x0F_u8);
                    try b.emit_u8(alloc, 0x20_u8);
                    try b.emit_u8(alloc, 0xC0_u8 | ((cr_src & 7_u8) <<% 3_u8) | dst.low());
                } else if let src = parse_reg64(src_s) {
                    try b.mov_rr(alloc, dst, src);
                } else if let imm = parse_asm_imm(src_s) {
                    try b.mov_ri64(alloc, dst, imm);
                }
            } else if eq_ascii_ci(mnem, "xor") {
                if let src = parse_reg64(src_s) {
                    try b.xor_rr(alloc, dst, src);
                }
            } else {
                if let src = parse_reg64(src_s) {
                    try b.or_rr(alloc, dst, src);
                }
            }
        }
        return true;
    }
    return false;
}

/// Built-in x86_64 mini-assembler for `.hal.eon` `asm("...")` templates.
pub fn encode_inline_asm(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    template: *[u8],
) -> bool ! OutOfMemory {
    var start: usize = 0_usize;
    var i: usize = 0_usize;
    while i <= template.len {
        let at_end = i == template.len;
        var is_sep = at_end;
        if !at_end && i < template.len {
            let ch = template[i];
            if ch == b';' || ch == 10_u8 {
                is_sep = true;
            }
        }
        if is_sep {
            let seg = template.sub(start, i) catch {
                return false;
            };
            let ok = try encode_inline_asm_line(alloc, b, seg);
            if !ok {
                return false;
            }
            start = i +% 1_usize;
        }
        i = i +% 1_usize;
    }
    return true;
}

/// Emit a Win64-to-EonCall ABI adapter trampoline for `n_int_args` (`0..=8`).
pub fn emit_win64_to_eon_trampoline(
    alloc: *mut AllocCap,
    target_sym_id: u32,
    n_int_args: usize,
    out: *mut X64Buf,
) -> bool ! OutOfMemory {
    if n_int_args > 8_usize {
        return false;
    }
    out.clear();
    let frame_bytes: i32 = 168_i32; // 10 * 16 + 8 pad
    try out.push(alloc, .Rbp);
    try out.mov_rr(alloc, .Rbp, .Rsp);
    try out.push(alloc, .Rdi);
    try out.push(alloc, .Rsi);
    try out.push(alloc, .R15);
    try out.sub_ri32(alloc, .Rsp, frame_bytes);
    var i: u8 = 0_u8;
    while i < 10_u8 {
        let disp = (i.widen.[u32]() *% 16_u32).bitcast.[i32]();
        try out.movdqu_store_n(alloc, .Rsp, disp, 6_u8 +% i);
        i = i +% 1_u8;
    }
    try out.mov_rr(alloc, .Rdi, .Rcx);
    try out.mov_rr(alloc, .Rsi, .Rdx);
    try out.mov_rr(alloc, .Rdx, .R8);
    try out.mov_rr(alloc, .Rcx, .R9);
    if n_int_args > 4_usize { try out.load_mem(alloc, .R8, .Rbp, 48_i32, 8_usize, false); }
    if n_int_args > 5_usize { try out.load_mem(alloc, .R9, .Rbp, 56_i32, 8_usize, false); }
    if n_int_args > 6_usize { try out.load_mem(alloc, .R10, .Rbp, 64_i32, 8_usize, false); }
    if n_int_args > 7_usize { try out.load_mem(alloc, .R11, .Rbp, 72_i32, 8_usize, false); }
    try out.call_sym(alloc, target_sym_id);
    i = 0_u8;
    while i < 10_u8 {
        let disp = (i.widen.[u32]() *% 16_u32).bitcast.[i32]();
        try out.movdqu_load_n(alloc, 6_u8 +% i, .Rsp, disp);
        i = i +% 1_u8;
    }
    try out.add_ri32(alloc, .Rsp, frame_bytes);
    try out.pop(alloc, .R15);
    try out.pop(alloc, .Rsi);
    try out.pop(alloc, .Rdi);
    try out.pop(alloc, .Rbp);
    try out.ret(alloc);
    return out.finish();
}

// ============================================================================
// Standalone Zero-Libc Linux x86_64 Runtime Helpers & BSS Layout Catalog
// ============================================================================

pub const RT_BSS_COUNT: usize = 11_usize;
pub const RT_HELPER_COUNT: usize = 38_usize;

pub struct RtBssSym {
    pub sym_id: u32;
    pub size: u64;
    pub align: u64;
}

fn push_bss_sym(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    out: *mut col.DynBuf[RtBssSym],
    name: *str,
    size: u64,
    align: u64,
) -> !OutOfMemory {
    let sid = try interner.intern_str(alloc, name);
    try out.push(alloc, RtBssSym.{ sym_id: sid, size: size, align: align });
    return;
}

pub fn emit_rt_bss_symbols(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    out: *mut col.DynBuf[RtBssSym],
) -> !OutOfMemory {
    try push_bss_sym(alloc, interner, out, "__eon_vdso_clock_gettime", 8_u64, 8_u64);
    try push_bss_sym(alloc, interner, out, "__eon_envp", 8_u64, 8_u64);
    try push_bss_sym(alloc, interner, out, "__eon_alloc_tls_fallback", 256_u64, 16_u64);
    try push_bss_sym(alloc, interner, out, "__eon_main_tcb", 256_u64, 64_u64);
    try push_bss_sym(alloc, interner, out, "__eon_med_span_lock", 8_u64, 8_u64);
    try push_bss_sym(alloc, interner, out, "__eon_med_chunks", 18432_u64, 8_u64);
    try push_bss_sym(alloc, interner, out, "__eon_san_lock", 8_u64, 8_u64);
    try push_bss_sym(alloc, interner, out, "__eon_san_quarantine", 1032_u64, 8_u64);
    try push_bss_sym(alloc, interner, out, "__eon_san_altstack", 16384_u64, 16_u64);
    try push_bss_sym(alloc, interner, out, "__eon_sched_state", 12288_u64, 64_u64);
    try push_bss_sym(alloc, interner, out, "__eon_cpu_affinity_mask", 128_u64, 8_u64);
    return;
}

const SLAB_MAGIC: u64 = 0xE04E534C41423030_u64;
const MED_CHUNK_BYTES: u64 = 2097152_u64;
const MED_CHUNK_STRIDE: i32 = 72_i32;
const MED_CHUNK_COUNT_I32: i32 = 256_i32;
const SAN_QUARANTINE_MASK_I32: i32 = 63_i32;
const SAN_POISON_BYTE: u64 = 0xDE_u64;

const U64_NEG1: u64 = 0xFFFFFFFFFFFFFFFF_u64;
const U64_NEG4096: u64 = 0xFFFFFFFFFFFFF000_u64;
const U64_NEG17: u64 = 0xFFFFFFFFFFFFFFEF_u64;
const U64_NEG22: u64 = 0xFFFFFFFFFFFFFFEA_u64;

const SCHED_OFF_INIT: i32 = 0_i32;
const SCHED_OFF_NUM_WORKERS: i32 = 8_i32;
const SCHED_OFF_SHUTDOWN: i32 = 16_i32;
const SCHED_OFF_WORK_GEN: i32 = 24_i32;
const SCHED_OFF_TASK_KIND: i32 = 32_i32;
const SCHED_OFF_TASK_CTX: i32 = 40_i32;
const SCHED_OFF_TASK_FN: i32 = 48_i32;
const SCHED_OFF_TASK_TOTAL: i32 = 56_i32;
const SCHED_OFF_TASK_CHUNK: i32 = 64_i32;
const SCHED_OFF_TASK_NEXT: i32 = 72_i32;
const SCHED_OFF_TASK_DONE: i32 = 80_i32;
const SCHED_OFF_ACTIVE_WORKERS: i32 = 88_i32;
const SCHED_OFF_DAG_NODES: i32 = 96_i32;
const SCHED_OFF_DAG_COUNT: i32 = 104_i32;
const SCHED_OFF_CALL_LOCK: i32 = 112_i32;
const SCHED_OFF_IN_TASK: i32 = 120_i32;
const SCHED_OFF_TASK_CLOSED: i32 = 128_i32;
const SCHED_OFF_DAG_RT: i32 = 136_i32;
const SCHED_OFF_SLEEPING: i32 = 144_i32;
const SCHED_OFF_WORKER_TCBS: i32 = 192_i32;
const SCHED_OFF_ONLINE_CPUS: i32 = 4288_i32;
const SCHED_OFF_DAG_RT_INLINE: i32 = 4480_i32;
const TCB_OFF_CAP_PTR: i32 = 96_i32;
const TCB_OFF_ST_FAST: i32 = 104_i32;
const TCB_OFF_CAP_LIVE: i32 = 112_i32;
const TCB_OFF_CAP_BYTES: i32 = 120_i32;
const TCB_OFF_MED_FREE: i32 = 128_i32;
const TCB_OFF_MED_CNT: i32 = 184_i32;
const TCB_MED_MAX_CACHED: i32 = 8_i32;
const TCB_CAP_BATCH_BYTES: i32 = 262144_i32;
const SCHED_MAX_WORKERS_I32: i32 = 16_i32;
const SCHED_MAX_INLINE_DAG_I32: i32 = 176_i32;
const WORKER_STACK_BYTES: u64 = 8388608_u64;
const CLONE_WORKER_FLAGS: u64 = 0x00050F00_u64; // CLONE_VM|FS|FILES|SIGHAND|THREAD|SYSVSEM (preserve glibc %fs; worker sets %gs)

fn emit_spin_lock(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
    lock_sym: *str,
) -> !OutOfMemory {
    let sid = try interner.intern_str(alloc, lock_sym);
    let l_acq = try b.new_label(alloc);
    let l_spin = try b.new_label(alloc);
    try b.lea_rip_sym(alloc, .R8, sid, 0_i64);
    b.bind_label(l_acq);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.xchg_mem(alloc, .R8, .Rax, 8_usize);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.jcc_label(alloc, .E, l_spin);
    let l_wait = try b.new_label(alloc);
    b.bind_label(l_wait);
    try b.pause(alloc);
    try b.cmp_mi32(alloc, .R8, 0_i32, 0_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_wait);
    try b.jmp_label(alloc, l_acq);
    b.bind_label(l_spin);
    return;
}

fn emit_spin_unlock(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
    lock_sym: *str,
) -> !OutOfMemory {
    let sid = try interner.intern_str(alloc, lock_sym);
    try b.lea_rip_sym(alloc, .R8, sid, 0_i64);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.xchg_mem(alloc, .R8, .Rax, 8_usize);
    return;
}

fn emit_load_tcb(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
    dst: Reg,
) -> !OutOfMemory {
    let s_tcb = try interner.intern_str(alloc, "__eon_main_tcb");
    let s_fb = try interner.intern_str(alloc, "__eon_alloc_tls_fallback");
    let l_fs_ok = try b.new_label(alloc);
    let l_have_tcb = try b.new_label(alloc);
    try b.lea_rip_sym(alloc, .Rax, s_tcb, 0_i64);
    try b.cmp_mi32(alloc, .Rax, 0_i32, 0_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_fs_ok);
    try b.store_mem(alloc, .Rax, 0_i32, .Rax, 8_usize);
    try b.store_imm64_sext_mem(alloc, .Rax, TCB_OFF_ST_FAST, 1_i32);
    try b.mov_rr(alloc, .Rsi, .Rax);
    try b.mov_ri64(alloc, .Rdi, 0x1001_u64); // ARCH_SET_GS (keeps glibc %fs TLS intact)
    try b.mov_ri64(alloc, .Rax, 158_u64);
    try b.syscall(alloc);
    b.bind_label(l_fs_ok);
    try b.load_gs_disp(alloc, dst, 0_i32);
    try b.test_rr(alloc, dst, dst);
    try b.jcc_label(alloc, .Ne, l_have_tcb);
    try b.lea_rip_sym(alloc, dst, s_fb, 0_i64);
    b.bind_label(l_have_tcb);
    return;
}

fn emit_alloc_cap_charge(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    l_fail: u32,
) -> !OutOfMemory {
    let l_walk = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    let l_nolimit = try b.new_label(alloc);
    let l_cas = try b.new_label(alloc);
    let l_charged = try b.new_label(alloc);
    let l_peak = try b.new_label(alloc);
    let l_next = try b.new_label(alloc);
    let l_budget_fail = try b.new_label(alloc);

    try b.mov_rr(alloc, .Rbx, .R12);
    try b.xor_rr32(alloc, .R15, .R15);

    b.bind_label(l_walk);
    try b.test_rr(alloc, .Rbx, .Rbx);
    try b.jcc_label(alloc, .E, l_done);

    try b.load_mem(alloc, .R8, .Rbx, 24_i32, 8_usize, false);
    try b.test_rr(alloc, .R8, .R8);
    try b.jcc_label(alloc, .E, l_nolimit);

    try b.load_mem(alloc, .Rax, .Rbx, 8_i32, 8_usize, false);
    b.bind_label(l_cas);
    try b.mov_rr(alloc, .Rcx, .Rax);
    try b.add_rr(alloc, .Rcx, .R13);
    try b.jcc_label(alloc, .B, l_budget_fail);
    try b.cmp_rr(alloc, .Rcx, .R8);
    try b.jcc_label(alloc, .A, l_budget_fail);
    try b.lock_cmpxchg_disp(alloc, .Rbx, 8_i32, .Rcx, 8_usize);
    try b.jcc_label(alloc, .Ne, l_cas);
    try b.jmp_label(alloc, l_charged);

    b.bind_label(l_nolimit);
    try b.mov_rr(alloc, .Rax, .R13);
    try b.lock_xadd_disp(alloc, .Rbx, 8_i32, .Rax, 8_usize);
    try b.mov_rr(alloc, .Rcx, .Rax);
    try b.add_rr(alloc, .Rcx, .R13);

    b.bind_label(l_charged);
    try b.mov_ri64(alloc, .R9, 1_u64);
    try b.lock_xadd_disp(alloc, .Rbx, 0_i32, .R9, 8_usize);
    try b.load_mem(alloc, .Rax, .Rbx, 16_i32, 8_usize, false);
    b.bind_label(l_peak);
    try b.cmp_rr(alloc, .Rcx, .Rax);
    try b.jcc_label(alloc, .Be, l_next);
    try b.lock_cmpxchg_disp(alloc, .Rbx, 16_i32, .Rcx, 8_usize);
    try b.jcc_label(alloc, .Ne, l_peak);

    b.bind_label(l_next);
    try b.load_mem(alloc, .Rbx, .Rbx, 32_i32, 8_usize, false);
    try b.jmp_label(alloc, l_walk);

    b.bind_label(l_budget_fail);
    try b.mov_rr(alloc, .R15, .Rbx);
    try b.jmp_label(alloc, l_fail);

    b.bind_label(l_done);
    return;
}

fn emit_alloc_cap_rollback(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    let l_loop = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    try b.mov_rr(alloc, .Rbx, .R12);
    b.bind_label(l_loop);
    try b.test_rr(alloc, .Rbx, .Rbx);
    try b.jcc_label(alloc, .E, l_done);
    try b.cmp_rr(alloc, .Rbx, .R15);
    try b.jcc_label(alloc, .E, l_done);
    try b.mov_ri64(alloc, .Rax, U64_NEG1);
    try b.lock_xadd_disp(alloc, .Rbx, 0_i32, .Rax, 8_usize);
    try b.mov_rr(alloc, .Rax, .R13);
    try b.neg_r(alloc, .Rax);
    try b.lock_xadd_disp(alloc, .Rbx, 8_i32, .Rax, 8_usize);
    try b.load_mem(alloc, .Rbx, .Rbx, 32_i32, 8_usize, false);
    try b.jmp_label(alloc, l_loop);
    b.bind_label(l_done);
    return;
}

fn emit_alloc_cap_release(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    let l_walk = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    let l_live = try b.new_label(alloc);
    let l_live_done = try b.new_label(alloc);
    let l_used = try b.new_label(alloc);
    let l_used_zero = try b.new_label(alloc);
    let l_used_cas = try b.new_label(alloc);

    try b.mov_rr(alloc, .Rbx, .R12);
    b.bind_label(l_walk);
    try b.test_rr(alloc, .Rbx, .Rbx);
    try b.jcc_label(alloc, .E, l_done);

    try b.load_mem(alloc, .Rax, .Rbx, 0_i32, 8_usize, false);
    b.bind_label(l_live);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.jcc_label(alloc, .E, l_live_done);
    try b.lea_mem(alloc, .Rcx, .Rax, -1_i32);
    try b.lock_cmpxchg_disp(alloc, .Rbx, 0_i32, .Rcx, 8_usize);
    try b.jcc_label(alloc, .Ne, l_live);
    b.bind_label(l_live_done);

    try b.load_mem(alloc, .Rax, .Rbx, 8_i32, 8_usize, false);
    b.bind_label(l_used);
    try b.cmp_rr(alloc, .Rax, .R14);
    try b.jcc_label(alloc, .B, l_used_zero);
    try b.mov_rr(alloc, .Rcx, .Rax);
    try b.sub_rr(alloc, .Rcx, .R14);
    try b.jmp_label(alloc, l_used_cas);
    b.bind_label(l_used_zero);
    try b.xor_rr32(alloc, .Rcx, .Rcx);
    b.bind_label(l_used_cas);
    try b.lock_cmpxchg_disp(alloc, .Rbx, 8_i32, .Rcx, 8_usize);
    try b.jcc_label(alloc, .Ne, l_used);

    try b.load_mem(alloc, .Rbx, .Rbx, 32_i32, 8_usize, false);
    try b.jmp_label(alloc, l_walk);
    b.bind_label(l_done);
    return;
}

/// Flushes calling thread's batched `AllocCap` deltas (`live_count`, `used_bytes`, `peak_bytes`)
/// back to the root `AllocCap`. Clobbers `Rax, Rcx, R8, R9, R10, R11`; preserves `Rbx, R12..R15`.
fn emit_flush_tcb_alloc_cap(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let l_done = try b.new_label(alloc);
    let l_no_live = try b.new_label(alloc);
    let l_peak = try b.new_label(alloc);
    try emit_load_tcb(alloc, b, interner, .R9);
    try b.load_mem(alloc, .R8, .R9, TCB_OFF_CAP_PTR, 8_usize, false);
    try b.test_rr(alloc, .R8, .R8);
    try b.jcc_label(alloc, .E, l_done);
    try b.load_mem(alloc, .R10, .R9, TCB_OFF_CAP_LIVE, 8_usize, false);
    try b.load_mem(alloc, .R11, .R9, TCB_OFF_CAP_BYTES, 8_usize, false);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .R9, TCB_OFF_CAP_LIVE, .Rax, 8_usize);
    try b.store_mem(alloc, .R9, TCB_OFF_CAP_BYTES, .Rax, 8_usize);
    try b.test_rr(alloc, .R10, .R10);
    try b.jcc_label(alloc, .E, l_no_live);
    try b.mov_rr(alloc, .Rax, .R10);
    try b.lock_xadd_disp(alloc, .R8, 0_i32, .Rax, 8_usize);
    b.bind_label(l_no_live);
    try b.test_rr(alloc, .R11, .R11);
    try b.jcc_label(alloc, .E, l_done);
    try b.mov_rr(alloc, .Rax, .R11);
    try b.lock_xadd_disp(alloc, .R8, 8_i32, .Rax, 8_usize);
    try b.mov_rr(alloc, .Rcx, .Rax);
    try b.add_rr(alloc, .Rcx, .R11);
    try b.test_rr(alloc, .Rcx, .Rcx);
    try b.jcc_label(alloc, .S, l_done);
    try b.load_mem(alloc, .Rax, .R8, 16_i32, 8_usize, false);
    b.bind_label(l_peak);
    try b.cmp_rr(alloc, .Rcx, .Rax);
    try b.jcc_label(alloc, .Be, l_done);
    try b.lock_cmpxchg_disp(alloc, .R8, 16_i32, .Rcx, 8_usize);
    try b.jcc_label(alloc, .Ne, l_peak);
    b.bind_label(l_done);
    return;
}

fn emit_alloc_cap_charge_fast(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
    l_fail: u32,
) -> !OutOfMemory {
    let s_sched = try interner.intern_str(alloc, "__eon_sched_state");
    let l_mt = try b.new_label(alloc);
    let l_mt_exact = try b.new_label(alloc);
    let l_cap_ok = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    let l_st_walk = try b.new_label(alloc);
    let l_st_store = try b.new_label(alloc);
    let l_st_fail = try b.new_label(alloc);

    try b.lea_rip_sym(alloc, .R10, s_sched, 0_i64);
    try b.cmp_mi32(alloc, .R10, SCHED_OFF_CALL_LOCK, 0_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_mt);

    // Single-threaded fast path: ZERO LOCK instructions, branchless peak update!
    try b.mov_rr(alloc, .Rbx, .R12);
    try b.xor_rr32(alloc, .R15, .R15);
    b.bind_label(l_st_walk);
    try b.test_rr(alloc, .Rbx, .Rbx);
    try b.jcc_label(alloc, .E, l_done);
    try b.load_mem(alloc, .R8, .Rbx, 24_i32, 8_usize, false);
    try b.load_mem(alloc, .Rax, .Rbx, 8_i32, 8_usize, false);
    try b.mov_rr(alloc, .Rcx, .Rax);
    try b.add_rr(alloc, .Rcx, .R13);
    try b.test_rr(alloc, .R8, .R8);
    try b.jcc_label(alloc, .E, l_st_store);
    try b.cmp_rr(alloc, .Rcx, .Rax);
    try b.jcc_label(alloc, .B, l_st_fail);
    try b.cmp_rr(alloc, .Rcx, .R8);
    try b.jcc_label(alloc, .A, l_st_fail);
    b.bind_label(l_st_store);
    try b.store_mem(alloc, .Rbx, 8_i32, .Rcx, 8_usize);
    try b.load_mem(alloc, .Rax, .Rbx, 0_i32, 8_usize, false);
    try b.lea_mem(alloc, .R9, .Rax, 1_i32);
    try b.store_mem(alloc, .Rbx, 0_i32, .R9, 8_usize);
    try b.load_mem(alloc, .Rax, .Rbx, 16_i32, 8_usize, false);
    try b.cmp_rr(alloc, .Rcx, .Rax);
    try b.cmovcc(alloc, .A, .Rax, .Rcx);
    try b.store_mem(alloc, .Rbx, 16_i32, .Rax, 8_usize);
    try b.load_mem(alloc, .Rbx, .Rbx, 32_i32, 8_usize, false);
    try b.jmp_label(alloc, l_st_walk);

    b.bind_label(l_st_fail);
    try b.mov_rr(alloc, .R15, .Rbx);
    try b.jmp_label(alloc, l_fail);

    // Multi-threaded path: per-thread TCB batching for unlimited root AllocCap (ZERO LOCKs!)
    b.bind_label(l_mt);
    try b.test_rr(alloc, .R12, .R12);
    try b.jcc_label(alloc, .E, l_done);
    try b.load_mem(alloc, .Rax, .R12, 24_i32, 8_usize, false);
    try b.load_mem(alloc, .Rcx, .R12, 32_i32, 8_usize, false);
    try b.or_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ne, l_mt_exact);
    try emit_load_tcb(alloc, b, interner, .R9);
    try b.load_mem(alloc, .R8, .R9, TCB_OFF_CAP_PTR, 8_usize, false);
    try b.cmp_rr(alloc, .R8, .R12);
    try b.jcc_label(alloc, .E, l_cap_ok);
    try emit_flush_tcb_alloc_cap(alloc, interner, b);
    try b.store_mem(alloc, .R9, TCB_OFF_CAP_PTR, .R12, 8_usize);
    b.bind_label(l_cap_ok);
    try b.load_mem(alloc, .Rax, .R9, TCB_OFF_CAP_LIVE, 8_usize, false);
    try b.lea_mem(alloc, .Rax, .Rax, 1_i32);
    try b.store_mem(alloc, .R9, TCB_OFF_CAP_LIVE, .Rax, 8_usize);
    try b.load_mem(alloc, .Rcx, .R9, TCB_OFF_CAP_BYTES, 8_usize, false);
    try b.add_rr(alloc, .Rcx, .R13);
    try b.store_mem(alloc, .R9, TCB_OFF_CAP_BYTES, .Rcx, 8_usize);
    try b.cmp_ri32(alloc, .Rcx, TCB_CAP_BATCH_BYTES);
    try b.jcc_label(alloc, .L, l_done);
    try emit_flush_tcb_alloc_cap(alloc, interner, b);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_mt_exact);
    try emit_alloc_cap_charge(alloc, b, l_fail);
    b.bind_label(l_done);
    return;
}

fn emit_alloc_cap_release_fast(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let s_sched = try interner.intern_str(alloc, "__eon_sched_state");
    let l_mt = try b.new_label(alloc);
    let l_mt_exact = try b.new_label(alloc);
    let l_cap_ok = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    let l_st_walk = try b.new_label(alloc);

    try b.lea_rip_sym(alloc, .R10, s_sched, 0_i64);
    try b.cmp_mi32(alloc, .R10, SCHED_OFF_CALL_LOCK, 0_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_mt);

    // Single-threaded fast path: ZERO LOCK instructions, branchless saturating dec/sub!
    try b.mov_rr(alloc, .Rbx, .R12);
    b.bind_label(l_st_walk);
    try b.test_rr(alloc, .Rbx, .Rbx);
    try b.jcc_label(alloc, .E, l_done);
    try b.load_mem(alloc, .Rax, .Rbx, 0_i32, 8_usize, false);
    try b.lea_mem(alloc, .Rcx, .Rax, -1_i32);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.cmovcc(alloc, .Ne, .Rax, .Rcx);
    try b.store_mem(alloc, .Rbx, 0_i32, .Rax, 8_usize);
    try b.load_mem(alloc, .Rax, .Rbx, 8_i32, 8_usize, false);
    try b.xor_rr32(alloc, .Rcx, .Rcx);
    try b.mov_rr(alloc, .R8, .Rax);
    try b.sub_rr(alloc, .R8, .R14);
    try b.cmp_rr(alloc, .Rax, .R14);
    try b.cmovcc(alloc, .Ae, .Rcx, .R8);
    try b.store_mem(alloc, .Rbx, 8_i32, .Rcx, 8_usize);
    try b.load_mem(alloc, .Rbx, .Rbx, 32_i32, 8_usize, false);
    try b.jmp_label(alloc, l_st_walk);

    // Multi-threaded path: per-thread TCB batching for unlimited root AllocCap (ZERO LOCKs!)
    b.bind_label(l_mt);
    try b.test_rr(alloc, .R12, .R12);
    try b.jcc_label(alloc, .E, l_done);
    try b.load_mem(alloc, .Rax, .R12, 24_i32, 8_usize, false);
    try b.load_mem(alloc, .Rcx, .R12, 32_i32, 8_usize, false);
    try b.or_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ne, l_mt_exact);
    try emit_load_tcb(alloc, b, interner, .R9);
    try b.load_mem(alloc, .R8, .R9, TCB_OFF_CAP_PTR, 8_usize, false);
    try b.cmp_rr(alloc, .R8, .R12);
    try b.jcc_label(alloc, .E, l_cap_ok);
    try emit_flush_tcb_alloc_cap(alloc, interner, b);
    try b.store_mem(alloc, .R9, TCB_OFF_CAP_PTR, .R12, 8_usize);
    b.bind_label(l_cap_ok);
    try b.load_mem(alloc, .Rax, .R9, TCB_OFF_CAP_LIVE, 8_usize, false);
    try b.lea_mem(alloc, .Rax, .Rax, -1_i32);
    try b.store_mem(alloc, .R9, TCB_OFF_CAP_LIVE, .Rax, 8_usize);
    try b.load_mem(alloc, .Rcx, .R9, TCB_OFF_CAP_BYTES, 8_usize, false);
    try b.sub_rr(alloc, .Rcx, .R14);
    try b.store_mem(alloc, .R9, TCB_OFF_CAP_BYTES, .Rcx, 8_usize);
    try b.cmp_ri32(alloc, .Rcx, 0_i32 - TCB_CAP_BATCH_BYTES);
    try b.jcc_label(alloc, .G, l_done);
    try emit_flush_tcb_alloc_cap(alloc, interner, b);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_mt_exact);
    try emit_alloc_cap_release(alloc, b);
    b.bind_label(l_done);
    return;
}

fn emit_med_bitmap_update(alloc: *mut AllocCap, b: *mut X64Buf, set: bool) -> !OutOfMemory {
    let l_loop = try b.new_label(alloc);
    try b.lea_mem(alloc, .Rsi, .R9, 8_i32);
    try b.mov_rr(alloc, .R8, .Rbx);
    b.bind_label(l_loop);
    try b.mov_rr(alloc, .Rax, .Rdi);
    try b.shr_imm(alloc, .Rax, 6_u8);
    try b.shl_imm(alloc, .Rax, 3_u8);
    try b.add_rr(alloc, .Rax, .Rsi);
    try b.mov_rr(alloc, .Rcx, .Rdi);
    try b.and_ri32(alloc, .Rcx, 63_i32);
    try b.mov_ri64(alloc, .Rdx, 1_u64);
    try b.shl_cl(alloc, .Rdx);
    try b.load_mem(alloc, .R10, .Rax, 0_i32, 8_usize, false);
    if set {
        try b.or_rr(alloc, .R10, .Rdx);
    } else {
        try b.not_r(alloc, .Rdx);
        try b.and_rr(alloc, .R10, .Rdx);
    }
    try b.store_mem(alloc, .Rax, 0_i32, .R10, 8_usize);
    try b.add_ri32(alloc, .Rdi, 1_i32);
    try b.sub_ri32(alloc, .R8, 1_i32);
    try b.jcc_label(alloc, .Ne, l_loop);
    return;
}

// ============================================================================
// Runtime Helpers Part 1: Allocator, Sanitizer, Arena & TLS
// ============================================================================

fn emit_alloc_raw_slab_refill(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
    l_done: u32,
    l_mmap_fail: u32,
) -> !OutOfMemory {
    let s_fb = try interner.intern_str(alloc, "__eon_alloc_tls_fallback");
    try b.mov_rr(alloc, .R9, .R8);
    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rsi, 65536_u64);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 0x22_u64);
    try b.mov_ri64(alloc, .R8, U64_NEG1);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.syscall(alloc);
    try b.mov_ri64(alloc, .Rcx, U64_NEG4096);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ae, l_mmap_fail);

    try b.mov_rr(alloc, .Rsi, .Rax);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    try b.mov_ri64(alloc, .Rcx, 16_u64);
    try b.mov_ri64(alloc, .R10, SLAB_MAGIC);
    let l_page_lp = try b.new_label(alloc);
    let l_blk_lp = try b.new_label(alloc);
    let l_blk_end = try b.new_label(alloc);
    b.bind_label(l_page_lp);
    try b.store_mem(alloc, .Rsi, 0_i32, .R10, 8_usize);
    try b.store_mem(alloc, .Rsi, 8_i32, .Rbx, 8_usize);
    try b.mov_rr(alloc, .Rdi, .Rsi);
    try b.add_rr(alloc, .Rdi, .R15);
    try b.lea_mem(alloc, .R11, .Rsi, 4096_i32);
    b.bind_label(l_blk_lp);
    try b.cmp_rr(alloc, .Rdi, .R11);
    try b.jcc_label(alloc, .Ae, l_blk_end);
    try b.store_mem(alloc, .Rdi, 0_i32, .Rdx, 8_usize);
    try b.mov_rr(alloc, .Rdx, .Rdi);
    try b.add_rr(alloc, .Rdi, .R15);
    try b.jmp_label(alloc, l_blk_lp);
    b.bind_label(l_blk_end);
    try b.add_ri32(alloc, .Rsi, 4096_i32);
    try b.sub_ri32(alloc, .Rcx, 1_i32);
    try b.jcc_label(alloc, .Ne, l_page_lp);

    try b.load_mem(alloc, .R10, .Rdx, 0_i32, 8_usize, false);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .Rdx, 0_i32, .Rax, 8_usize);
    try b.load_gs_disp(alloc, .R9, 0_i32);
    try b.test_rr(alloc, .R9, .R9);
    let l_refill_tcb = try b.new_label(alloc);
    try b.jcc_label(alloc, .Ne, l_refill_tcb);
    try b.lea_rip_sym(alloc, .R9, s_fb, 0_i64);
    b.bind_label(l_refill_tcb);
    try b.lea_mem(alloc, .R8, .R9, 16_i32);
    try b.shl_imm(alloc, .Rbx, 3_u8);
    try b.add_rr(alloc, .R8, .Rbx);
    try b.store_mem(alloc, .R8, 0_i32, .R10, 8_usize);
    try b.mov_rr(alloc, .Rax, .Rdx);
    try b.jmp_label(alloc, l_done);
    return;
}

fn emit_alloc_raw_slab(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
    l_medium: u32,
    l_done: u32,
    l_mmap_fail: u32,
    zero_fill: bool,
) -> !OutOfMemory {
    try b.cmp_ri32(alloc, .R13, 2048_i32);
    try b.jcc_label(alloc, .A, l_medium);
    try b.cmp_ri32(alloc, .R14, 2048_i32);
    try b.jcc_label(alloc, .A, l_medium);

    try b.mov_rr(alloc, .R8, .R13);
    try b.cmp_rr(alloc, .R8, .R14);
    try b.cmovcc(alloc, .B, .R8, .R14);
    // Branchless slab size-class via BSR: cls = bsr(max(r8, 16) - 1) - 3 in 0..7!
    try b.mov_ri64(alloc, .Rcx, 16_u64);
    try b.cmp_rr(alloc, .R8, .Rcx);
    try b.cmovcc(alloc, .B, .R8, .Rcx);
    try b.lea_mem(alloc, .Rcx, .R8, -1_i32);
    try b.bsr(alloc, true, .Rbx, .Rcx);
    try b.sub_ri32(alloc, .Rbx, 3_i32);

    try b.mov_ri64(alloc, .R15, 16_u64);
    try b.mov_rr(alloc, .Rcx, .Rbx);
    try b.shl_cl(alloc, .R15);

    try emit_load_tcb(alloc, b, interner, .R9);
    try b.lea_mem(alloc, .R8, .R9, 16_i32);
    try b.mov_rr(alloc, .R10, .Rbx);
    try b.shl_imm(alloc, .R10, 3_u8);
    try b.add_rr(alloc, .R8, .R10);

    try b.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
    let l_slab_refill = try b.new_label(alloc);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.jcc_label(alloc, .E, l_slab_refill);

    try b.load_mem(alloc, .Rcx, .Rax, 0_i32, 8_usize, false);
    try b.store_mem(alloc, .R8, 0_i32, .Rcx, 8_usize);
    if zero_fill {
        try b.mov_rr(alloc, .R9, .Rax);
        try b.mov_rr(alloc, .Rdi, .Rax);
        try b.xor_rr32(alloc, .Rax, .Rax);
        try b.mov_rr(alloc, .Rcx, .R15);
        try b.shr_imm(alloc, .Rcx, 3_u8);
        try b.rep_stosq(alloc);
        try b.mov_rr(alloc, .Rax, .R9);
    }
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_slab_refill);
    try emit_alloc_raw_slab_refill(alloc, b, interner, l_done, l_mmap_fail);
    return;
}

fn emit_alloc_raw_med_new(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
    l_done: u32,
    l_mmap_fail: u32,
) -> !OutOfMemory {
    let l_med_full = try b.new_label(alloc);
    try b.test_rr(alloc, .R10, .R10);
    try b.jcc_label(alloc, .E, l_med_full);
    try b.mov_rr(alloc, .R15, .R10);
    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rsi, MED_CHUNK_BYTES);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 0x22_u64);
    try b.mov_ri64(alloc, .R8, U64_NEG1);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.syscall(alloc);
    try b.mov_ri64(alloc, .Rcx, U64_NEG4096);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    let l_med_mmap_fail = try b.new_label(alloc);
    try b.jcc_label(alloc, .Ae, l_med_mmap_fail);

    try b.store_mem(alloc, .R15, 0_i32, .Rax, 8_usize);
    try b.mov_rr(alloc, .R9, .Rax);
    let l_all64 = try b.new_label(alloc);
    let l_bm_w = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .Rbx, 64_i32);
    try b.jcc_label(alloc, .E, l_all64);
    try b.mov_ri64(alloc, .Rdx, 1_u64);
    try b.mov_rr(alloc, .Rcx, .Rbx);
    try b.shl_cl(alloc, .Rdx);
    try b.sub_ri32(alloc, .Rdx, 1_i32);
    try b.jmp_label(alloc, l_bm_w);
    b.bind_label(l_all64);
    try b.mov_ri64(alloc, .Rdx, U64_NEG1);
    b.bind_label(l_bm_w);
    try b.store_mem(alloc, .R15, 8_i32, .Rdx, 8_usize);
    try emit_spin_unlock(alloc, b, interner, "__eon_med_span_lock");
    try b.mov_rr(alloc, .Rax, .R9);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_med_mmap_fail);
    try emit_spin_unlock(alloc, b, interner, "__eon_med_span_lock");
    try b.jmp_label(alloc, l_mmap_fail);

    b.bind_label(l_med_full);
    try emit_spin_unlock(alloc, b, interner, "__eon_med_span_lock");
    // Ensure fallback mmap maps exact power-of-2 `cap_pages` matching medium free/cache size!
    try b.mov_rr(alloc, .R13, .Rbx);
    try b.shl_imm(alloc, .R13, 12_u8);
    return;
}

fn emit_alloc_raw_medium(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
    l_large: u32,
    l_done: u32,
    l_mmap_fail: u32,
    zero_fill: bool,
) -> !OutOfMemory {
    let s_chunks = try interner.intern_str(alloc, "__eon_med_chunks");
    try b.cmp_ri32(alloc, .R13, 262144_i32);
    try b.jcc_label(alloc, .A, l_large);
    try b.cmp_ri32(alloc, .R14, 4096_i32);
    try b.jcc_label(alloc, .A, l_large);

    // Round `pages = (R13 + 4095) >> 12` up to power-of-2 `cap_pages = 1 << cls` (`cls` in 0..6 -> 4K..256K).
    try b.lea_mem(alloc, .Rbx, .R13, 4095_i32);
    try b.shr_imm(alloc, .Rbx, 12_u8);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    let l_cls_done = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .Rbx, 1_i32);
    try b.jcc_label(alloc, .Be, l_cls_done);
    try b.lea_mem(alloc, .Rcx, .Rbx, -1_i32);
    try b.bsr(alloc, true, .Rdx, .Rcx);
    try b.add_ri32(alloc, .Rdx, 1_i32);
    b.bind_label(l_cls_done);
    try b.mov_ri64(alloc, .Rbx, 1_u64);
    try b.mov_rr(alloc, .Rcx, .Rdx);
    try b.shl_cl(alloc, .Rbx);

    // Lock-free per-thread TLS medium page freelist fast path!
    try emit_load_tcb(alloc, b, interner, .R9);
    try b.lea_mem(alloc, .R8, .R9, TCB_OFF_MED_FREE);
    try b.mov_rr(alloc, .Rcx, .Rdx);
    try b.shl_imm(alloc, .Rcx, 3_u8);
    try b.add_rr(alloc, .R8, .Rcx);
    try b.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
    let l_med_tls_miss = try b.new_label(alloc);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.jcc_label(alloc, .E, l_med_tls_miss);
    try b.load_mem(alloc, .Rcx, .Rax, 0_i32, 8_usize, false);
    try b.store_mem(alloc, .R8, 0_i32, .Rcx, 8_usize);
    try b.load_mem(alloc, .Rcx, .R8, 56_i32, 8_usize, false);
    try b.sub_ri32(alloc, .Rcx, 1_i32);
    try b.store_mem(alloc, .R8, 56_i32, .Rcx, 8_usize);
    if zero_fill {
        try b.mov_rr(alloc, .R15, .Rax);
        try b.mov_rr(alloc, .Rdi, .Rax);
        try b.xor_rr32(alloc, .Rax, .Rax);
        try b.mov_rr(alloc, .Rcx, .Rbx);
        try b.shl_imm(alloc, .Rcx, 9_u8);
        try b.rep_stosq(alloc);
        try b.mov_rr(alloc, .Rax, .R15);
    }
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_med_tls_miss);
    try emit_spin_lock(alloc, b, interner, "__eon_med_span_lock");
    try b.lea_rip_sym(alloc, .R9, s_chunks, 0_i64);
    try b.xor_rr32(alloc, .R10, .R10);
    try b.xor_rr32(alloc, .R8, .R8);

    let l_c_loop = try b.new_label(alloc);
    let l_c_next = try b.new_label(alloc);
    let l_c_done = try b.new_label(alloc);
    let l_scan_bm = try b.new_label(alloc);
    let l_bit_lp = try b.new_label(alloc);
    let l_bit_test = try b.new_label(alloc);
    let l_bit_one = try b.new_label(alloc);
    let l_bit_adv = try b.new_label(alloc);
    let l_found_run = try b.new_label(alloc);

    b.bind_label(l_c_loop);
    try b.cmp_ri32(alloc, .R8, MED_CHUNK_COUNT_I32);
    try b.jcc_label(alloc, .Ae, l_c_done);
    try b.load_mem(alloc, .R11, .R9, 0_i32, 8_usize, false);
    try b.test_rr(alloc, .R11, .R11);
    try b.jcc_label(alloc, .Ne, l_scan_bm);
    try b.test_rr(alloc, .R10, .R10);
    try b.jcc_label(alloc, .Ne, l_c_next);
    try b.mov_rr(alloc, .R10, .R9);
    try b.jmp_label(alloc, l_c_next);

    b.bind_label(l_scan_bm);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    b.bind_label(l_bit_lp);
    try b.cmp_ri32(alloc, .Rdi, 512_i32);
    try b.jcc_label(alloc, .Ae, l_c_next);
    try b.mov_rr(alloc, .Rsi, .Rdi);
    try b.shr_imm(alloc, .Rsi, 6_u8);
    try b.shl_imm(alloc, .Rsi, 3_u8);
    try b.lea_mem(alloc, .Rax, .R9, 8_i32);
    try b.add_rr(alloc, .Rax, .Rsi);
    try b.load_mem(alloc, .Rax, .Rax, 0_i32, 8_usize, false);
    try b.mov_rr(alloc, .Rcx, .Rdi);
    try b.and_ri32(alloc, .Rcx, 63_i32);
    try b.jcc_label(alloc, .Ne, l_bit_test);
    try b.cmp_ri32(alloc, .Rax, -1_i32);
    try b.jcc_label(alloc, .Ne, l_bit_test);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    try b.add_ri32(alloc, .Rdi, 64_i32);
    try b.jmp_label(alloc, l_bit_lp);

    b.bind_label(l_bit_test);
    try b.shr_cl(alloc, .Rax);
    try b.and_ri32(alloc, .Rax, 1_i32);
    try b.jcc_label(alloc, .Ne, l_bit_one);
    try b.add_ri32(alloc, .Rdx, 1_i32);
    try b.cmp_rr(alloc, .Rdx, .Rbx);
    try b.jcc_label(alloc, .E, l_found_run);
    try b.jmp_label(alloc, l_bit_adv);
    b.bind_label(l_bit_one);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    b.bind_label(l_bit_adv);
    try b.add_ri32(alloc, .Rdi, 1_i32);
    try b.jmp_label(alloc, l_bit_lp);

    b.bind_label(l_c_next);
    try b.add_ri32(alloc, .R9, MED_CHUNK_STRIDE);
    try b.add_ri32(alloc, .R8, 1_i32);
    try b.jmp_label(alloc, l_c_loop);

    b.bind_label(l_found_run);
    try b.add_ri32(alloc, .Rdi, 1_i32);
    try b.sub_rr(alloc, .Rdi, .Rbx);
    try b.mov_rr(alloc, .R15, .Rdi);
    try emit_med_bitmap_update(alloc, b, true);
    try b.shl_imm(alloc, .R15, 12_u8);
    try b.add_rr(alloc, .R15, .R11);
    try emit_spin_unlock(alloc, b, interner, "__eon_med_span_lock");
    if zero_fill {
        try b.mov_rr(alloc, .Rdi, .R15);
        try b.xor_rr32(alloc, .Rax, .Rax);
        try b.mov_rr(alloc, .Rcx, .Rbx);
        try b.shl_imm(alloc, .Rcx, 9_u8);
        try b.rep_stosq(alloc);
    }
    try b.mov_rr(alloc, .Rax, .R15);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_c_done);
    try emit_alloc_raw_med_new(alloc, b, interner, l_done, l_mmap_fail);
    return;
}

fn emit_alloc_raw_large(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    l_done: u32,
    l_mmap_fail: u32,
) -> !OutOfMemory {
    try b.lea_mem(alloc, .R15, .R13, 4095_i32);
    try b.and_ri32(alloc, .R15, -4096_i32);
    let l_lg_overalign = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .R14, 4096_i32);
    try b.jcc_label(alloc, .A, l_lg_overalign);

    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_rr(alloc, .Rsi, .R15);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 0x22_u64);
    try b.mov_ri64(alloc, .R8, U64_NEG1);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.syscall(alloc);
    try b.mov_ri64(alloc, .Rcx, U64_NEG4096);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ae, l_mmap_fail);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_lg_overalign);
    try b.mov_rr(alloc, .Rbx, .R15);
    try b.add_rr(alloc, .Rbx, .R14);
    try b.sub_ri32(alloc, .Rbx, 4096_i32);
    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_rr(alloc, .Rsi, .Rbx);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 0x22_u64);
    try b.mov_ri64(alloc, .R8, U64_NEG1);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.syscall(alloc);
    try b.mov_ri64(alloc, .Rcx, U64_NEG4096);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ae, l_mmap_fail);

    try b.mov_rr(alloc, .R8, .Rax);
    try b.lea_mem(alloc, .Rcx, .R14, -1_i32);
    try b.lea_mem(alloc, .R9, .R8, 0_i32);
    try b.add_rr(alloc, .R9, .Rcx);
    try b.not_r(alloc, .Rcx);
    try b.and_rr(alloc, .R9, .Rcx);
    let l_no_pfx = try b.new_label(alloc);
    try b.cmp_rr(alloc, .R9, .R8);
    try b.jcc_label(alloc, .E, l_no_pfx);
    try b.mov_rr(alloc, .Rsi, .R9);
    try b.sub_rr(alloc, .Rsi, .R8);
    try b.mov_rr(alloc, .Rdi, .R8);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);
    b.bind_label(l_no_pfx);

    try b.add_rr(alloc, .R8, .Rbx);
    try b.mov_rr(alloc, .Rdi, .R9);
    try b.add_rr(alloc, .Rdi, .R15);
    let l_no_sfx = try b.new_label(alloc);
    try b.cmp_rr(alloc, .R8, .Rdi);
    try b.jcc_label(alloc, .Be, l_no_sfx);
    try b.mov_rr(alloc, .Rsi, .R8);
    try b.sub_rr(alloc, .Rsi, .Rdi);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);
    b.bind_label(l_no_sfx);
    try b.mov_rr(alloc, .Rax, .R9);
    try b.jmp_label(alloc, l_done);
    return;
}

fn emit_rt_alloc_raw_impl(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
    zero_fill: bool,
) -> !OutOfMemory {
    // Zero-push leaf single-threaded slab fast path (eliminates 10 callee-save pushes/pops
    // + fs:0x0 + AllocCap parent walk loop on 99.9% of small uninit allocations!).
    if !zero_fill {
        let l_slow = try b.new_label(alloc);
        let s_tcb = try interner.intern_str(alloc, "__eon_main_tcb");
        // Single-branch range check: 1 <= size <= 2048
        try b.lea_mem(alloc, .Rax, .Rsi, -1_i32);
        try b.cmp_ri32(alloc, .Rax, 2047_i32);
        try b.jcc_label(alloc, .A, l_slow);
        try b.cmp_ri32(alloc, .Rdx, 2048_i32);
        try b.jcc_label(alloc, .A, l_slow);
        try b.test_rr(alloc, .Rdi, .Rdi);
        try b.jcc_label(alloc, .E, l_slow);
        // Combine budget (24) | parent (32) == 0 into 1 branch
        try b.load_mem(alloc, .Rax, .Rdi, 24_i32, 8_usize, false);
        try b.load_mem(alloc, .Rcx, .Rdi, 32_i32, 8_usize, false);
        try b.or_rr(alloc, .Rax, .Rcx);
        try b.jcc_label(alloc, .Ne, l_slow);
        try b.lea_rip_sym(alloc, .R9, s_tcb, 0_i64);
        try b.cmp_mi32(alloc, .R9, TCB_OFF_ST_FAST, 0_i32, 8_usize);
        try b.jcc_label(alloc, .E, l_slow);

        // r8 = max(size, align), bsr((r8 - 1) | 15) in 3..10, slot = r9 + 8*r8 - 8 == r9 + 16 + 8*(r8 - 3)
        try b.mov_rr(alloc, .R8, .Rsi);
        try b.cmp_rr(alloc, .R8, .Rdx);
        try b.cmovcc(alloc, .B, .R8, .Rdx);
        try b.lea_mem(alloc, .Rcx, .R8, -1_i32);
        try b.or_ri32(alloc, .Rcx, 15_i32);
        try b.bsr(alloc, true, .R8, .Rcx);
        try b.lea_sib(alloc, .R10, .R9, .R8, 8_u8, -8_i32);

        try b.load_mem(alloc, .Rax, .R10, 0_i32, 8_usize, false);
        try b.test_rr(alloc, .Rax, .Rax);
        try b.jcc_label(alloc, .E, l_slow);

        // Pop freelist head & update AllocCap (live_count, live_bytes, peak_bytes)
        try b.load_mem(alloc, .Rcx, .Rax, 0_i32, 8_usize, false);
        try b.store_mem(alloc, .R10, 0_i32, .Rcx, 8_usize);
        try b.load_mem(alloc, .Rcx, .Rdi, 0_i32, 8_usize, false);
        try b.lea_mem(alloc, .Rcx, .Rcx, 1_i32);
        try b.store_mem(alloc, .Rdi, 0_i32, .Rcx, 8_usize);
        try b.load_mem(alloc, .Rcx, .Rdi, 8_i32, 8_usize, false);
        try b.add_rr(alloc, .Rcx, .Rsi);
        try b.store_mem(alloc, .Rdi, 8_i32, .Rcx, 8_usize);
        try b.load_mem(alloc, .R8, .Rdi, 16_i32, 8_usize, false);
        try b.cmp_rr(alloc, .Rcx, .R8);
        try b.cmovcc(alloc, .A, .R8, .Rcx);
        try b.store_mem(alloc, .Rdi, 16_i32, .R8, 8_usize);
        try b.ret(alloc);

        b.bind_label(l_slow);
    }

    try b.push(alloc, .Rbx);
    try b.push(alloc, .R12);
    try b.push(alloc, .R13);
    try b.push(alloc, .R14);
    try b.push(alloc, .R15);

    try b.mov_rr(alloc, .R12, .Rdi);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.mov_rr(alloc, .R13, .Rsi);
    try b.test_rr(alloc, .R13, .R13);
    try b.cmovcc(alloc, .E, .R13, .Rax);
    try b.mov_rr(alloc, .R14, .Rdx);
    try b.test_rr(alloc, .R14, .R14);
    try b.cmovcc(alloc, .E, .R14, .Rax);

    let l_rollback_fail = try b.new_label(alloc);
    let l_medium = try b.new_label(alloc);
    let l_large = try b.new_label(alloc);
    let l_mmap_fail = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);

    try emit_alloc_cap_charge_fast(alloc, interner, b, l_rollback_fail);
    try emit_alloc_raw_slab(alloc, b, interner, l_medium, l_done, l_mmap_fail, zero_fill);

    b.bind_label(l_medium);
    try emit_alloc_raw_medium(alloc, b, interner, l_large, l_done, l_mmap_fail, zero_fill);

    b.bind_label(l_large);
    try emit_alloc_raw_large(alloc, b, l_done, l_mmap_fail);

    b.bind_label(l_mmap_fail);
    try b.xor_rr32(alloc, .R15, .R15);
    b.bind_label(l_rollback_fail);
    try emit_alloc_cap_rollback(alloc, b);
    try b.xor_rr32(alloc, .Rax, .Rax);

    b.bind_label(l_done);
    try b.pop(alloc, .R15);
    try b.pop(alloc, .R14);
    try b.pop(alloc, .R13);
    try b.pop(alloc, .R12);
    try b.pop(alloc, .Rbx);
    try b.ret(alloc);
    return;
}

fn emit_rt_alloc_raw(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    try emit_rt_alloc_raw_impl(alloc, interner, b, true);
    return;
}

fn emit_rt_alloc_raw_uninit(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    try emit_rt_alloc_raw_impl(alloc, interner, b, false);
    return;
}

fn emit_free_raw_medium(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
    l_update_cap: u32,
) -> !OutOfMemory {
    let s_chunks = try interner.intern_str(alloc, "__eon_med_chunks");
    try b.lea_mem(alloc, .Rbx, .R14, 4095_i32);
    try b.shr_imm(alloc, .Rbx, 12_u8);
    let l_munmap = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .Rbx, 64_i32);
    try b.jcc_label(alloc, .A, l_munmap);

    // Round `pages` up to matching power-of-2 `cap_pages = 1 << cls` (`cls` in 0..6 -> 4K..256K).
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    let l_fcls_done = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .Rbx, 1_i32);
    try b.jcc_label(alloc, .Be, l_fcls_done);
    try b.lea_mem(alloc, .Rcx, .Rbx, -1_i32);
    try b.bsr(alloc, true, .Rdx, .Rcx);
    try b.add_ri32(alloc, .Rdx, 1_i32);
    b.bind_label(l_fcls_done);
    try b.mov_ri64(alloc, .Rbx, 1_u64);
    try b.mov_rr(alloc, .Rcx, .Rdx);
    try b.shl_cl(alloc, .Rbx);

    // Lock-free per-thread TLS medium page freelist cache scaled inversely by class size:
    // cls 0..1 (4K, 8K) -> 8, cls 2..3 (16K, 32K) -> 4, cls 4..5 (64K, 128K) -> 2, cls 6 (256K) -> 1.
    // Caps max per-thread idle medium cache to ~0.94 MiB (down from 4.06 MiB), cutting MT RSS cleanly.
    try emit_load_tcb(alloc, b, interner, .R9);
    try b.lea_mem(alloc, .R8, .R9, TCB_OFF_MED_FREE);
    try b.mov_rr(alloc, .Rcx, .Rdx);
    try b.shl_imm(alloc, .Rcx, 3_u8);
    try b.add_rr(alloc, .R8, .Rcx);
    try b.mov_rr(alloc, .Rcx, .Rdx);
    try b.shr_imm(alloc, .Rcx, 1_u8);
    try b.mov_ri64(alloc, .R11, TCB_MED_MAX_CACHED.bitcast.[u32]().widen.[u64]());
    try b.shr_cl(alloc, .R11);
    try b.load_mem(alloc, .Rcx, .R8, 56_i32, 8_usize, false);
    let l_med_tls_full = try b.new_label(alloc);
    try b.cmp_rr(alloc, .Rcx, .R11);
    try b.jcc_label(alloc, .Ae, l_med_tls_full);
    try b.add_ri32(alloc, .Rcx, 1_i32);
    try b.store_mem(alloc, .R8, 56_i32, .Rcx, 8_usize);
    try b.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
    try b.store_mem(alloc, .R13, 0_i32, .Rax, 8_usize);
    try b.store_mem(alloc, .R8, 0_i32, .R13, 8_usize);
    try b.jmp_label(alloc, l_update_cap);

    b.bind_label(l_med_tls_full);
    try emit_spin_lock(alloc, b, interner, "__eon_med_span_lock");
    try b.lea_rip_sym(alloc, .R9, s_chunks, 0_i64);
    try b.xor_rr32(alloc, .R8, .R8);
    let l_scan = try b.new_label(alloc);
    let l_next = try b.new_label(alloc);
    let l_not_med = try b.new_label(alloc);
    b.bind_label(l_scan);
    try b.cmp_ri32(alloc, .R8, MED_CHUNK_COUNT_I32);
    try b.jcc_label(alloc, .Ae, l_not_med);
    try b.load_mem(alloc, .R11, .R9, 0_i32, 8_usize, false);
    try b.test_rr(alloc, .R11, .R11);
    try b.jcc_label(alloc, .E, l_next);
    try b.cmp_rr(alloc, .R13, .R11);
    try b.jcc_label(alloc, .B, l_next);
    try b.mov_ri64(alloc, .Rax, MED_CHUNK_BYTES);
    try b.add_rr(alloc, .Rax, .R11);
    try b.cmp_rr(alloc, .R13, .Rax);
    try b.jcc_label(alloc, .Ae, l_next);

    try b.mov_rr(alloc, .Rdi, .R13);
    try b.sub_rr(alloc, .Rdi, .R11);
    try b.shr_imm(alloc, .Rdi, 12_u8);
    try emit_med_bitmap_update(alloc, b, false);
    try emit_spin_unlock(alloc, b, interner, "__eon_med_span_lock");
    try b.jmp_label(alloc, l_update_cap);

    b.bind_label(l_next);
    try b.add_ri32(alloc, .R9, MED_CHUNK_STRIDE);
    try b.add_ri32(alloc, .R8, 1_i32);
    try b.jmp_label(alloc, l_scan);

    b.bind_label(l_not_med);
    try emit_spin_unlock(alloc, b, interner, "__eon_med_span_lock");

    b.bind_label(l_munmap);
    try b.mov_rr(alloc, .Rdi, .R13);
    try b.mov_rr(alloc, .Rsi, .Rbx);
    try b.shl_imm(alloc, .Rsi, 12_u8);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);
    return;
}

fn emit_rt_free_raw(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let l_ret = try b.new_label(alloc);
    try b.test_rr(alloc, .Rsi, .Rsi);
    try b.jcc_label(alloc, .E, l_ret);

    // Zero-push leaf single-threaded slab free fast path!
    let l_slow = try b.new_label(alloc);
    let s_tcb = try interner.intern_str(alloc, "__eon_main_tcb");
    try b.test_ri32(alloc, .Rsi, 4095_i32);
    try b.jcc_label(alloc, .E, l_slow);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .E, l_slow);
    try b.cmp_mi32(alloc, .Rdi, 32_i32, 0_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_slow);
    try b.lea_rip_sym(alloc, .R9, s_tcb, 0_i64);
    try b.cmp_mi32(alloc, .R9, TCB_OFF_ST_FAST, 0_i32, 8_usize);
    try b.jcc_label(alloc, .E, l_slow);
    try b.mov_rr(alloc, .R8, .Rsi);
    try b.and_ri32(alloc, .R8, -4096_i32);
    try b.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
    try b.mov_ri64(alloc, .Rcx, SLAB_MAGIC);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ne, l_slow);
    try b.load_mem(alloc, .Rcx, .R8, 8_i32, 8_usize, false);
    try b.cmp_ri32(alloc, .Rcx, 8_i32);
    try b.jcc_label(alloc, .Ae, l_slow);

    try b.lea_sib(alloc, .R10, .R9, .Rcx, 8_u8, 16_i32);
    try b.load_mem(alloc, .Rax, .R10, 0_i32, 8_usize, false);
    try b.store_mem(alloc, .Rsi, 0_i32, .Rax, 8_usize);
    try b.store_mem(alloc, .R10, 0_i32, .Rsi, 8_usize);

    try b.mov_ri64(alloc, .R8, 1_u64);
    try b.test_rr(alloc, .Rdx, .Rdx);
    try b.cmovcc(alloc, .E, .Rdx, .R8);
    try b.load_mem(alloc, .Rax, .Rdi, 0_i32, 8_usize, false);
    try b.lea_mem(alloc, .Rcx, .Rax, -1_i32);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.cmovcc(alloc, .Ne, .Rax, .Rcx);
    try b.store_mem(alloc, .Rdi, 0_i32, .Rax, 8_usize);
    try b.load_mem(alloc, .Rax, .Rdi, 8_i32, 8_usize, false);
    try b.xor_rr32(alloc, .Rcx, .Rcx);
    try b.mov_rr(alloc, .R8, .Rax);
    try b.sub_rr(alloc, .R8, .Rdx);
    try b.cmp_rr(alloc, .Rax, .Rdx);
    try b.cmovcc(alloc, .Ae, .Rcx, .R8);
    try b.store_mem(alloc, .Rdi, 8_i32, .Rcx, 8_usize);
    try b.ret(alloc);

    b.bind_label(l_slow);
    try b.push(alloc, .Rbx);
    try b.push(alloc, .R12);
    try b.push(alloc, .R13);
    try b.push(alloc, .R14);

    try b.mov_rr(alloc, .R12, .Rdi);
    try b.mov_rr(alloc, .R13, .Rsi);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.mov_rr(alloc, .R14, .Rdx);
    try b.test_rr(alloc, .R14, .R14);
    try b.cmovcc(alloc, .E, .R14, .Rax);

    let l_page_aligned = try b.new_label(alloc);
    let l_update_cap = try b.new_label(alloc);

    try b.mov_rr(alloc, .Rax, .R13);
    try b.and_ri32(alloc, .Rax, 4095_i32);
    try b.jcc_label(alloc, .E, l_page_aligned);

    try b.mov_rr(alloc, .R8, .R13);
    try b.and_ri32(alloc, .R8, -4096_i32);
    try b.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
    try b.mov_ri64(alloc, .Rcx, SLAB_MAGIC);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ne, l_update_cap);
    try b.load_mem(alloc, .Rbx, .R8, 8_i32, 8_usize, false);
    try b.cmp_ri32(alloc, .Rbx, 8_i32);
    try b.jcc_label(alloc, .Ae, l_update_cap);

    try emit_load_tcb(alloc, b, interner, .R9);
    try b.lea_mem(alloc, .R10, .R9, 16_i32);
    try b.shl_imm(alloc, .Rbx, 3_u8);
    try b.add_rr(alloc, .R10, .Rbx);
    try b.load_mem(alloc, .Rax, .R10, 0_i32, 8_usize, false);
    try b.store_mem(alloc, .R13, 0_i32, .Rax, 8_usize);
    try b.store_mem(alloc, .R10, 0_i32, .R13, 8_usize);
    try b.jmp_label(alloc, l_update_cap);

    b.bind_label(l_page_aligned);
    try emit_free_raw_medium(alloc, b, interner, l_update_cap);

    b.bind_label(l_update_cap);
    try emit_alloc_cap_release_fast(alloc, interner, b);

    try b.pop(alloc, .R14);
    try b.pop(alloc, .R13);
    try b.pop(alloc, .R12);
    try b.pop(alloc, .Rbx);
    b.bind_label(l_ret);
    try b.ret(alloc);
    return;
}

fn emit_rt_alloc_raw_san(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    try b.push(alloc, .Rbx);
    try b.push(alloc, .R12);
    try b.push(alloc, .R13);
    try b.push(alloc, .R14);
    try b.push(alloc, .R15);

    try b.mov_rr(alloc, .R12, .Rdi);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.mov_rr(alloc, .R13, .Rsi);
    try b.test_rr(alloc, .R13, .R13);
    try b.cmovcc(alloc, .E, .R13, .Rax);
    try b.mov_rr(alloc, .R14, .Rdx);
    try b.test_rr(alloc, .R14, .R14);
    try b.cmovcc(alloc, .E, .R14, .Rax);
    try b.mov_ri64(alloc, .Rax, 4096_u64);
    try b.cmp_ri32(alloc, .R14, 4096_i32);
    try b.cmovcc(alloc, .A, .R14, .Rax);

    let l_rollback = try b.new_label(alloc);
    try emit_alloc_cap_charge(alloc, b, l_rollback);

    try b.lea_mem(alloc, .Rbx, .R13, 4095_i32);
    try b.and_ri32(alloc, .Rbx, -4096_i32);
    try b.lea_mem(alloc, .Rsi, .Rbx, 4096_i32);
    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 0x22_u64);
    try b.mov_ri64(alloc, .R8, U64_NEG1);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.syscall(alloc);

    let l_mmap_fail = try b.new_label(alloc);
    try b.mov_ri64(alloc, .Rcx, U64_NEG4096);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ae, l_mmap_fail);

    try b.mov_rr(alloc, .R15, .Rax);
    try b.add_rr(alloc, .R15, .Rbx);
    try b.mov_rr(alloc, .Rdi, .R15);
    try b.mov_ri64(alloc, .Rsi, 4096_u64);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    try b.mov_ri64(alloc, .Rax, 10_u64);
    try b.syscall(alloc);

    try b.mov_rr(alloc, .Rax, .R15);
    try b.sub_rr(alloc, .Rax, .R13);
    try b.lea_mem(alloc, .Rcx, .R14, -1_i32);
    try b.not_r(alloc, .Rcx);
    try b.and_rr(alloc, .Rax, .Rcx);
    let l_done = try b.new_label(alloc);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_mmap_fail);
    try b.xor_rr32(alloc, .R15, .R15);
    b.bind_label(l_rollback);
    try emit_alloc_cap_rollback(alloc, b);
    try b.xor_rr32(alloc, .Rax, .Rax);

    b.bind_label(l_done);
    try b.pop(alloc, .R15);
    try b.pop(alloc, .R14);
    try b.pop(alloc, .R13);
    try b.pop(alloc, .R12);
    try b.pop(alloc, .Rbx);
    try b.ret(alloc);
    return;
}

fn emit_rt_free_raw_san(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let s_quar = try interner.intern_str(alloc, "__eon_san_quarantine");
    let l_ret = try b.new_label(alloc);
    try b.test_rr(alloc, .Rsi, .Rsi);
    try b.jcc_label(alloc, .E, l_ret);

    try b.push(alloc, .Rbx);
    try b.push(alloc, .R12);
    try b.push(alloc, .R13);
    try b.push(alloc, .R14);
    try b.push(alloc, .R15);

    try b.mov_rr(alloc, .R12, .Rdi);
    try b.mov_rr(alloc, .R13, .Rsi);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.mov_rr(alloc, .R14, .Rdx);
    try b.test_rr(alloc, .R14, .R14);
    try b.cmovcc(alloc, .E, .R14, .Rax);

    try b.mov_rr(alloc, .Rdi, .R13);
    try b.mov_ri64(alloc, .Rax, SAN_POISON_BYTE);
    try b.mov_rr(alloc, .Rcx, .R14);
    try b.rep_stosb(alloc);

    try b.mov_rr(alloc, .Rbx, .R14);
    try b.add_ri32(alloc, .Rbx, 4095_i32);
    try b.and_ri32(alloc, .Rbx, -4096_i32);

    try b.mov_rr(alloc, .R15, .R13);
    try b.add_rr(alloc, .R15, .R14);
    try b.add_ri32(alloc, .R15, 4095_i32);
    try b.and_ri32(alloc, .R15, -4096_i32);
    try b.sub_rr(alloc, .R15, .Rbx);

    try b.mov_rr(alloc, .Rdi, .R15);
    try b.mov_rr(alloc, .Rsi, .Rbx);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    try b.mov_ri64(alloc, .Rax, 10_u64);
    try b.syscall(alloc);

    try b.add_ri32(alloc, .Rbx, 4096_i32);
    try emit_spin_lock(alloc, b, interner, "__eon_san_lock");
    try b.lea_rip_sym(alloc, .R9, s_quar, 0_i64);
    try b.load_mem(alloc, .R10, .R9, 0_i32, 8_usize, false);
    try b.mov_rr(alloc, .R11, .R10);
    try b.add_ri32(alloc, .R11, 1_i32);
    try b.and_ri32(alloc, .R11, SAN_QUARANTINE_MASK_I32);
    try b.store_mem(alloc, .R9, 0_i32, .R11, 8_usize);

    try b.and_ri32(alloc, .R10, SAN_QUARANTINE_MASK_I32);
    try b.shl_imm(alloc, .R10, 4_u8);
    try b.lea_mem(alloc, .R9, .R9, 8_i32);
    try b.add_rr(alloc, .R9, .R10);
    try b.load_mem(alloc, .R10, .R9, 0_i32, 8_usize, false);
    try b.load_mem(alloc, .R11, .R9, 8_i32, 8_usize, false);
    try b.store_mem(alloc, .R9, 0_i32, .R15, 8_usize);
    try b.store_mem(alloc, .R9, 8_i32, .Rbx, 8_usize);
    try b.mov_rr(alloc, .R15, .R10);
    try b.mov_rr(alloc, .Rbx, .R11);
    try emit_spin_unlock(alloc, b, interner, "__eon_san_lock");

    let l_no_evict = try b.new_label(alloc);
    try b.test_rr(alloc, .R15, .R15);
    try b.jcc_label(alloc, .E, l_no_evict);
    try b.mov_rr(alloc, .Rdi, .R15);
    try b.mov_rr(alloc, .Rsi, .Rbx);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);
    b.bind_label(l_no_evict);

    try emit_alloc_cap_release(alloc, b);

    try b.pop(alloc, .R15);
    try b.pop(alloc, .R14);
    try b.pop(alloc, .R13);
    try b.pop(alloc, .R12);
    try b.pop(alloc, .Rbx);
    b.bind_label(l_ret);
    try b.ret(alloc);
    return;
}

fn emit_rt_arena_alloc(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    let l_fail = try b.new_label(alloc);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .E, l_fail);
    try b.load_mem(alloc, .R8, .Rdi, 0_i32, 8_usize, false);
    try b.test_rr(alloc, .R8, .R8);
    try b.jcc_label(alloc, .E, l_fail);

    let l_m_ok = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .Rdx, 1_i32);
    try b.jcc_label(alloc, .A, l_m_ok);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    let l_m_done = try b.new_label(alloc);
    try b.jmp_label(alloc, l_m_done);
    b.bind_label(l_m_ok);
    try b.sub_ri32(alloc, .Rdx, 1_i32);
    b.bind_label(l_m_done);

    try b.load_mem(alloc, .R9, .Rdi, 16_i32, 8_usize, false);
    try b.add_rr(alloc, .R9, .Rdx);
    try b.not_r(alloc, .Rdx);
    try b.and_rr(alloc, .R9, .Rdx);

    try b.load_mem(alloc, .R10, .Rdi, 8_i32, 8_usize, false);
    try b.cmp_rr(alloc, .Rsi, .R10);
    try b.jcc_label(alloc, .A, l_fail);
    try b.sub_rr(alloc, .R10, .Rsi);
    try b.cmp_rr(alloc, .R9, .R10);
    try b.jcc_label(alloc, .A, l_fail);

    try b.mov_rr(alloc, .Rax, .R8);
    try b.add_rr(alloc, .Rax, .R9);
    try b.add_rr(alloc, .R9, .Rsi);
    try b.store_mem(alloc, .Rdi, 16_i32, .R9, 8_usize);
    try b.ret(alloc);

    b.bind_label(l_fail);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.ret(alloc);
    return;
}

fn emit_rt_arena_reset_san(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    let l_done = try b.new_label(alloc);
    let l_zero_only = try b.new_label(alloc);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .E, l_done);
    try b.mov_rr(alloc, .R8, .Rdi);
    try b.load_mem(alloc, .Rdx, .R8, 0_i32, 8_usize, false);
    try b.load_mem(alloc, .Rcx, .R8, 16_i32, 8_usize, false);
    try b.test_rr(alloc, .Rdx, .Rdx);
    try b.jcc_label(alloc, .E, l_zero_only);
    try b.test_rr(alloc, .Rcx, .Rcx);
    try b.jcc_label(alloc, .E, l_zero_only);
    try b.mov_rr(alloc, .Rdi, .Rdx);
    try b.mov_ri64(alloc, .Rax, SAN_POISON_BYTE);
    try b.rep_stosb(alloc);
    b.bind_label(l_zero_only);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .R8, 16_i32, .Rax, 8_usize);
    b.bind_label(l_done);
    try b.ret(alloc);
    return;
}

fn emit_san_stderr(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    lbl: u32,
    len: u64,
) -> !OutOfMemory {
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.mov_ri64(alloc, .Rdi, 2_u64);
    try b.lea_rip_label(alloc, .Rsi, lbl);
    try b.mov_ri64(alloc, .Rdx, len);
    try b.syscall(alloc);
    return;
}

fn emit_san_write_hex(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    try b.sub_ri32(alloc, .Rsp, 24_i32);
    try b.mov_ri64(alloc, .Rax, 0x7830_u64);
    try b.store_mem(alloc, .Rsp, 0_i32, .Rax, 2_usize);
    try b.mov_ri64(alloc, .Rcx, 16_u64);
    let l_hex_lp = try b.new_label(alloc);
    let l_hex_alpha = try b.new_label(alloc);
    let l_hex_st = try b.new_label(alloc);
    b.bind_label(l_hex_lp);
    try b.mov_rr(alloc, .Rax, .Rdi);
    try b.and_ri32(alloc, .Rax, 0xF_i32);
    try b.cmp_ri32(alloc, .Rax, 10_i32);
    try b.jcc_label(alloc, .Ae, l_hex_alpha);
    try b.add_ri32(alloc, .Rax, 48_i32);
    try b.jmp_label(alloc, l_hex_st);
    b.bind_label(l_hex_alpha);
    try b.add_ri32(alloc, .Rax, 87_i32);
    b.bind_label(l_hex_st);
    try b.lea_mem(alloc, .Rdx, .Rsp, 1_i32);
    try b.add_rr(alloc, .Rdx, .Rcx);
    try b.store_mem(alloc, .Rdx, 0_i32, .Rax, 1_usize);
    try b.shr_imm(alloc, .Rdi, 4_u8);
    try b.sub_ri32(alloc, .Rcx, 1_i32);
    try b.jcc_label(alloc, .Ne, l_hex_lp);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.mov_ri64(alloc, .Rdi, 2_u64);
    try b.mov_rr(alloc, .Rsi, .Rsp);
    try b.mov_ri64(alloc, .Rdx, 18_u64);
    try b.syscall(alloc);
    try b.add_ri32(alloc, .Rsp, 24_i32);
    try b.ret(alloc);
    return;
}

fn emit_san_sig_handler(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    l_write_hex: u32,
    l_str_hdr: u32,
    l_str_addr: u32,
    l_str_rip: u32,
    l_str_bt: u32,
    l_str_nl: u32,
) -> !OutOfMemory {
    try b.mov_rr(alloc, .R12, .Rdi);
    try b.mov_rr(alloc, .R13, .Rsi);
    try b.mov_rr(alloc, .R14, .Rdx);
    try b.and_ri32(alloc, .Rsp, -16_i32);

    try emit_san_stderr(alloc, b, l_str_hdr, 23_u64);
    try b.mov_rr(alloc, .Rdi, .R12);
    try b.call_label(alloc, l_write_hex);

    try emit_san_stderr(alloc, b, l_str_addr, 6_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    let l_no_si = try b.new_label(alloc);
    try b.test_rr(alloc, .R13, .R13);
    try b.jcc_label(alloc, .E, l_no_si);
    try b.load_mem(alloc, .Rdi, .R13, 16_i32, 8_usize, false);
    b.bind_label(l_no_si);
    try b.call_label(alloc, l_write_hex);

    try emit_san_stderr(alloc, b, l_str_rip, 5_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    let l_no_uc = try b.new_label(alloc);
    try b.test_rr(alloc, .R14, .R14);
    try b.jcc_label(alloc, .E, l_no_uc);
    try b.load_mem(alloc, .Rdi, .R14, 168_i32, 8_usize, false);
    b.bind_label(l_no_uc);
    try b.call_label(alloc, l_write_hex);
    try emit_san_stderr(alloc, b, l_str_nl, 1_u64);

    let l_bt_done = try b.new_label(alloc);
    try b.test_rr(alloc, .R14, .R14);
    try b.jcc_label(alloc, .E, l_bt_done);
    try b.load_mem(alloc, .Rbx, .R14, 120_i32, 8_usize, false);
    try b.load_mem(alloc, .R13, .R14, 160_i32, 8_usize, false);
    try b.mov_ri64(alloc, .R15, 16_u64);
    let l_bt_lp = try b.new_label(alloc);
    b.bind_label(l_bt_lp);
    try b.cmp_rr(alloc, .Rbx, .R13);
    try b.jcc_label(alloc, .B, l_bt_done);
    try b.mov_ri64(alloc, .Rax, 0x100000_u64);
    try b.add_rr(alloc, .Rax, .R13);
    try b.cmp_rr(alloc, .Rbx, .Rax);
    try b.jcc_label(alloc, .Ae, l_bt_done);
    try b.mov_rr(alloc, .Rax, .Rbx);
    try b.and_ri32(alloc, .Rax, 7_i32);
    try b.jcc_label(alloc, .Ne, l_bt_done);

    try emit_san_stderr(alloc, b, l_str_bt, 6_u64);
    try b.load_mem(alloc, .Rdi, .Rbx, 8_i32, 8_usize, false);
    try b.call_label(alloc, l_write_hex);
    try emit_san_stderr(alloc, b, l_str_nl, 1_u64);

    try b.load_mem(alloc, .Rax, .Rbx, 0_i32, 8_usize, false);
    try b.cmp_rr(alloc, .Rax, .Rbx);
    try b.jcc_label(alloc, .Be, l_bt_done);
    try b.mov_rr(alloc, .Rbx, .Rax);
    try b.sub_ri32(alloc, .R15, 1_i32);
    try b.jcc_label(alloc, .Ne, l_bt_lp);

    b.bind_label(l_bt_done);
    try b.lea_mem(alloc, .Rdi, .R12, 128_i32);
    try b.mov_ri64(alloc, .Rax, 231_u64);
    try b.syscall(alloc);
    try b.ud2(alloc);
    return;
}

fn emit_rt_install_san_handler(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let s_alt = try interner.intern_str(alloc, "__eon_san_altstack");
    let l_sig_handler = try b.new_label(alloc);
    let l_sigreturn = try b.new_label(alloc);
    let l_write_hex = try b.new_label(alloc);
    let l_str_hdr = try b.new_label(alloc);
    let l_str_addr = try b.new_label(alloc);
    let l_str_rip = try b.new_label(alloc);
    let l_str_bt = try b.new_label(alloc);
    let l_str_nl = try b.new_label(alloc);

    try b.sub_ri32(alloc, .Rsp, 40_i32);
    try b.lea_rip_sym(alloc, .Rax, s_alt, 0_i64);
    try b.store_mem(alloc, .Rsp, 0_i32, .Rax, 8_usize);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .Rsp, 8_i32, .Rax, 8_usize);
    try b.mov_ri64(alloc, .Rax, 16384_u64);
    try b.store_mem(alloc, .Rsp, 16_i32, .Rax, 8_usize);
    try b.mov_ri64(alloc, .Rax, 131_u64);
    try b.mov_rr(alloc, .Rdi, .Rsp);
    try b.xor_rr32(alloc, .Rsi, .Rsi);
    try b.syscall(alloc);

    try b.lea_rip_label(alloc, .Rax, l_sig_handler);
    try b.store_mem(alloc, .Rsp, 0_i32, .Rax, 8_usize);
    try b.mov_ri64(alloc, .Rax, 0x0C000004_u64);
    try b.store_mem(alloc, .Rsp, 8_i32, .Rax, 8_usize);
    try b.lea_rip_label(alloc, .Rax, l_sigreturn);
    try b.store_mem(alloc, .Rsp, 16_i32, .Rax, 8_usize);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .Rsp, 24_i32, .Rax, 8_usize);

    var sidx: usize = 0_usize;
    while sidx < 3_usize {
        let sig: u64 = if sidx == 0_usize { 11_u64 } else if sidx == 1_usize { 4_u64 } else { 7_u64 };
        try b.mov_ri64(alloc, .Rax, 13_u64);
        try b.mov_ri64(alloc, .Rdi, sig);
        try b.mov_rr(alloc, .Rsi, .Rsp);
        try b.xor_rr32(alloc, .Rdx, .Rdx);
        try b.mov_ri64(alloc, .R10, 8_u64);
        try b.syscall(alloc);
        sidx = sidx +% 1_usize;
    }

    try b.add_ri32(alloc, .Rsp, 40_i32);
    try b.ret(alloc);

    b.bind_label(l_sigreturn);
    try b.mov_ri64(alloc, .Rax, 15_u64);
    try b.syscall(alloc);
    try b.ud2(alloc);

    b.bind_label(l_write_hex);
    try emit_san_write_hex(alloc, b);

    b.bind_label(l_sig_handler);
    try emit_san_sig_handler(
        alloc,
        b,
        l_write_hex,
        l_str_hdr,
        l_str_addr,
        l_str_rip,
        l_str_bt,
        l_str_nl,
    );

    b.bind_label(l_str_hdr);
    try b.emit_bytes(alloc, "EON SANITIZER TRAP sig=".as_bytes());
    b.bind_label(l_str_addr);
    try b.emit_bytes(alloc, " addr=".as_bytes());
    b.bind_label(l_str_rip);
    try b.emit_bytes(alloc, " rip=".as_bytes());
    b.bind_label(l_str_bt);
    try b.emit_bytes(alloc, "  bt: ".as_bytes());
    b.bind_label(l_str_nl);
    try b.emit_u8(alloc, 10_u8);
    return;
}

fn emit_rt_tls_init(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let s_tcb = try interner.intern_str(alloc, "__eon_main_tcb");
    try b.lea_rip_sym(alloc, .Rsi, s_tcb, 0_i64);
    try b.store_mem(alloc, .Rsi, 0_i32, .Rsi, 8_usize);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .Rsi, 8_i32, .Rax, 8_usize);
    try b.mov_ri64(alloc, .Rdi, 0x1001_u64); // ARCH_SET_GS (keeps glibc %fs TLS intact)
    try b.mov_ri64(alloc, .Rax, 158_u64);
    try b.syscall(alloc);
    try b.ret(alloc);
    return;
}

// ============================================================================
// Runtime Helpers Part 2: vDSO, Clock, File I/O, Printing, UTF-8, Process, f16
// ============================================================================

fn emit_vdso_reloc_val(alloc: *mut AllocCap, b: *mut X64Buf, reg: Reg) -> !OutOfMemory {
    let l_rel = try b.new_label(alloc);
    let l_ok = try b.new_label(alloc);
    try b.cmp_rr(alloc, reg, .Rdi);
    try b.jcc_label(alloc, .B, l_rel);
    try b.mov_ri64(alloc, .Rax, 0x100000_u64);
    try b.add_rr(alloc, .Rax, .Rdi);
    try b.cmp_rr(alloc, reg, .Rax);
    try b.jcc_label(alloc, .B, l_ok);
    b.bind_label(l_rel);
    try b.add_rr(alloc, reg, .R12);
    b.bind_label(l_ok);
    return;
}

fn emit_vdso_scan_phdrs(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    l_fail_pop: u32,
) -> !OutOfMemory {
    try b.load_mem(alloc, .R8, .Rdi, 32_i32, 8_usize, false);
    try b.add_rr(alloc, .R8, .Rdi);
    try b.load_mem(alloc, .R9, .Rdi, 54_i32, 2_usize, false);
    try b.load_mem(alloc, .R10, .Rdi, 56_i32, 2_usize, false);

    try b.xor_rr32(alloc, .R12, .R12);
    try b.xor_rr32(alloc, .Rbx, .Rbx);
    try b.xor_rr32(alloc, .R13, .R13);

    let l_ph_lp = try b.new_label(alloc);
    let l_ph_next = try b.new_label(alloc);
    let l_ph_done = try b.new_label(alloc);
    let l_not_load = try b.new_label(alloc);
    b.bind_label(l_ph_lp);
    try b.test_rr(alloc, .R10, .R10);
    try b.jcc_label(alloc, .E, l_ph_done);
    try b.load_mem(alloc, .Rax, .R8, 0_i32, 4_usize, false);
    try b.cmp_ri32(alloc, .Rax, 1_i32);
    try b.jcc_label(alloc, .Ne, l_not_load);
    try b.test_rr(alloc, .Rbx, .Rbx);
    try b.jcc_label(alloc, .Ne, l_ph_next);
    try b.mov_rr(alloc, .R12, .Rdi);
    try b.load_mem(alloc, .Rcx, .R8, 16_i32, 8_usize, false);
    try b.sub_rr(alloc, .R12, .Rcx);
    try b.mov_ri64(alloc, .Rbx, 1_u64);
    try b.jmp_label(alloc, l_ph_next);

    b.bind_label(l_not_load);
    try b.cmp_ri32(alloc, .Rax, 2_i32);
    try b.jcc_label(alloc, .Ne, l_ph_next);
    try b.load_mem(alloc, .R13, .R8, 16_i32, 8_usize, false);

    b.bind_label(l_ph_next);
    try b.add_rr(alloc, .R8, .R9);
    try b.sub_ri32(alloc, .R10, 1_i32);
    try b.jmp_label(alloc, l_ph_lp);

    b.bind_label(l_ph_done);
    try b.test_rr(alloc, .Rbx, .Rbx);
    try b.jcc_label(alloc, .E, l_fail_pop);
    try b.test_rr(alloc, .R13, .R13);
    try b.jcc_label(alloc, .E, l_fail_pop);
    try emit_vdso_reloc_val(alloc, b, .R13);
    return;
}

fn emit_vdso_scan_dyn(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    l_fail_pop: u32,
) -> !OutOfMemory {
    try b.xor_rr32(alloc, .R8, .R8);
    try b.xor_rr32(alloc, .R14, .R14);
    try b.xor_rr32(alloc, .R15, .R15);
    let l_dyn_lp = try b.new_label(alloc);
    let l_dyn_next = try b.new_label(alloc);
    let l_dyn_done = try b.new_label(alloc);
    let l_not_hash = try b.new_label(alloc);
    let l_not_str = try b.new_label(alloc);
