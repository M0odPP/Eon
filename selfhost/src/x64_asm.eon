fn emit_rt_iouring_create(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    try b.push(alloc, .Rbx);
    try b.push(alloc, .R12);
    try b.push(alloc, .R13);

    try b.mov_ri64(alloc, .Rax, 8_u64);
    try b.mov_rr(alloc, .Rbx, .Rdi);
    try b.cmp_ri32(alloc, .Rbx, 8_i32);
    try b.cmovcc(alloc, .B, .Rbx, .Rax);

    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rsi, 4096_u64);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 0x22_u64);
    try b.mov_ri64(alloc, .R8, U64_NEG1);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.syscall(alloc);
    try b.mov_ri64(alloc, .Rcx, U64_NEG4096);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    let l_fail_ret = try b.new_label(alloc);
    let l_fail_unmap_hdr = try b.new_label(alloc);
    let l_fail_close = try b.new_label(alloc);
    let l_fail_sq = try b.new_label(alloc);
    let l_fail_cq = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    try b.jcc_label(alloc, .Ae, l_fail_ret);
    try b.mov_rr(alloc, .R12, .Rax);

    try b.mov_rr(alloc, .Rdi, .Rbx);
    try b.lea_mem(alloc, .Rsi, .R12, 128_i32);
    try b.mov_ri64(alloc, .Rax, 425_u64);
    try b.syscall(alloc);
    try b.cmp_ri32(alloc, .Rax, 0_i32);
    try b.jcc_label(alloc, .L, l_fail_unmap_hdr);
    try b.mov_rr(alloc, .R13, .Rax);
    try b.store_mem(alloc, .R12, 0_i32, .R13, 8_usize);

    try b.load_mem(alloc, .Rax, .R12, 128_i32, 4_usize, false);
    try b.store_mem(alloc, .R12, 120_i32, .Rax, 8_usize);

    try emit_iouring_mmap_rings(alloc, b, l_fail_close, l_fail_sq, l_fail_cq);
    try emit_iouring_populate_ptrs(alloc, b);

    try b.mov_rr(alloc, .Rax, .R12);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_fail_cq);
    try b.load_mem(alloc, .Rdi, .R12, 24_i32, 8_usize, false);
    try b.load_mem(alloc, .Rsi, .R12, 32_i32, 8_usize, false);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);
    b.bind_label(l_fail_sq);
    try b.load_mem(alloc, .Rdi, .R12, 8_i32, 8_usize, false);
    try b.load_mem(alloc, .Rsi, .R12, 16_i32, 8_usize, false);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);
    b.bind_label(l_fail_close);
    try b.mov_rr(alloc, .Rdi, .R13);
    try b.mov_ri64(alloc, .Rax, 3_u64);
    try b.syscall(alloc);
    b.bind_label(l_fail_unmap_hdr);
    try b.mov_rr(alloc, .Rdi, .R12);
    try b.mov_ri64(alloc, .Rsi, 4096_u64);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);
    b.bind_label(l_fail_ret);
    try b.xor_rr32(alloc, .Rax, .Rax);

    b.bind_label(l_done);
    try b.pop(alloc, .R13);
    try b.pop(alloc, .R12);
    try b.pop(alloc, .Rbx);
    try b.ret(alloc);
    return;
}

fn emit_rt_iouring_destroy(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    let l_ret = try b.new_label(alloc);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .E, l_ret);

    try b.push(alloc, .R12);
    try b.mov_rr(alloc, .R12, .Rdi);
    var k: usize = 0_usize;
    while k < 3_usize {
        let p_off: i32 = if k == 0_usize { 40_i32 } else if k == 1_usize { 24_i32 } else { 8_i32 };
        let sz_off: i32 = if k == 0_usize { 48_i32 } else if k == 1_usize { 32_i32 } else { 16_i32 };
        let l_skip = try b.new_label(alloc);
        try b.load_mem(alloc, .Rdi, .R12, p_off, 8_usize, false);
        try b.test_rr(alloc, .Rdi, .Rdi);
        try b.jcc_label(alloc, .E, l_skip);
        try b.load_mem(alloc, .Rsi, .R12, sz_off, 8_usize, false);
        try b.mov_ri64(alloc, .Rax, 11_u64);
        try b.syscall(alloc);
        b.bind_label(l_skip);
        k = k +% 1_usize;
    }
    try b.load_mem(alloc, .Rdi, .R12, 0_i32, 8_usize, false);
    try b.mov_ri64(alloc, .Rax, 3_u64);
    try b.syscall(alloc);
    try b.mov_rr(alloc, .Rdi, .R12);
    try b.mov_ri64(alloc, .Rsi, 4096_u64);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);
    try b.pop(alloc, .R12);
    b.bind_label(l_ret);
    try b.ret(alloc);
    return;
}

fn emit_fibers_alloc_tables(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
    l_fail_0: u32,
    l_fail_desc: u32,
    l_fail_arena: u32,
) -> !OutOfMemory {
    let s_create = try interner.intern_str(alloc, "eon_iouring_create");
    try b.mov_ri64(alloc, .Rax, 4096_u64);
    try b.cmp_ri32(alloc, .Rsi, 4096_i32);
    try b.cmovcc(alloc, .B, .Rsi, .Rax);
    try b.add_ri32(alloc, .Rsi, 4095_i32);
    try b.and_ri32(alloc, .Rsi, -4096_i32);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    try b.test_rr(alloc, .R8, .R8);
    try b.cmovcc(alloc, .Ne, .Rdx, .Rax);
    try b.add_rr(alloc, .Rsi, .Rdx);
