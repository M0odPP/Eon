    try b.imul_rri32(alloc, .Rsi, .R15, 80_i32);
    try b.add_ri32(alloc, .Rsi, 4095_i32);
    try b.and_ri32(alloc, .Rsi, -4096_i32);
    try b.store_mem(alloc, .Rsp, 64_i32, .Rsi, 8_usize);
    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 0x22_u64);
    try b.mov_ri64(alloc, .R8, U64_NEG1);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.syscall(alloc);
    try b.mov_ri64(alloc, .Rcx, U64_NEG4096);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ae, l_fail_0);
    try b.mov_rr(alloc, .R13, .Rax);

    try b.load_mem(alloc, .Rsi, .Rsp, 104_i32, 8_usize, false);
    try b.mov_rr(alloc, .Rax, .R15);
    try b.mul_r(alloc, .Rsi);
    try b.store_mem(alloc, .Rsp, 72_i32, .Rax, 8_usize);
    try b.mov_rr(alloc, .Rsi, .Rax);
    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 0x22_u64);
    try b.mov_ri64(alloc, .R8, U64_NEG1);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.syscall(alloc);
    try b.mov_ri64(alloc, .Rcx, U64_NEG4096);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ae, l_fail_desc);
    try b.mov_rr(alloc, .R14, .Rax);

    try b.mov_ri64(alloc, .Rdi, 128_u64);
    try b.call_sym(alloc, s_create);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.jcc_label(alloc, .E, l_fail_arena);
    try b.mov_rr(alloc, .R12, .Rax);
    return;
}

fn emit_fibers_init_descs(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    l_fiber_tramp: u32,
) -> !OutOfMemory {
    try b.xor_rr32(alloc, .Rbx, .Rbx);
    let l_init_lp = try b.new_label(alloc);
    let l_init_done = try b.new_label(alloc);
    let l_no_guard = try b.new_label(alloc);
    try b.load_mem(alloc, .R8, .Rsp, 104_i32, 8_usize, false);
    try b.load_mem(alloc, .R9, .Rsp, 112_i32, 8_usize, false);
    b.bind_label(l_init_lp);
    try b.cmp_rr(alloc, .Rbx, .R15);
    try b.jcc_label(alloc, .Ae, l_init_done);

    try b.mov_rr(alloc, .R10, .Rbx);
    try b.imul_rr(alloc, .R10, .R8);
    try b.add_rr(alloc, .R10, .R14);

    try b.test_rr(alloc, .R9, .R9);
    try b.jcc_label(alloc, .E, l_no_guard);
    try b.push(alloc, .R8);
    try b.push(alloc, .R9);
    try b.push(alloc, .R10);
    try b.mov_rr(alloc, .Rdi, .R10);
    try b.mov_ri64(alloc, .Rsi, 4096_u64);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    try b.mov_ri64(alloc, .Rax, 10_u64);
    try b.syscall(alloc);
    try b.pop(alloc, .R10);
    try b.pop(alloc, .R9);
    try b.pop(alloc, .R8);
    b.bind_label(l_no_guard);

    try b.imul_rri32(alloc, .R11, .Rbx, 80_i32);
    try b.add_rr(alloc, .R11, .R13);
    try b.store_mem(alloc, .R11, 0_i32, .Rbx, 8_usize);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .R11, 8_i32, .Rax, 8_usize);
    try b.store_mem(alloc, .R11, 16_i32, .R11, 8_usize);
    try b.load_mem(alloc, .Rax, .Rsp, 80_i32, 8_usize, false);
    try b.store_mem(alloc, .R11, 24_i32, .Rax, 8_usize);
    try b.lea_mem(alloc, .Rax, .Rsp, 0_i32);
    try b.store_mem(alloc, .R11, 32_i32, .Rax, 8_usize);
    try b.load_mem(alloc, .Rax, .Rsp, 88_i32, 8_usize, false);
    try b.store_mem(alloc, .R11, 40_i32, .Rax, 8_usize);
    try b.mov_rr(alloc, .Rax, .R10);
    try b.add_rr(alloc, .Rax, .R8);
    try b.store_mem(alloc, .R11, 48_i32, .Rax, 8_usize);
    try b.lea_rip_label(alloc, .Rax, l_fiber_tramp);
    try b.store_mem(alloc, .R11, 56_i32, .Rax, 8_usize);

    try b.add_ri32(alloc, .Rbx, 1_i32);
    try b.jmp_label(alloc, l_init_lp);
    b.bind_label(l_init_done);
    return;
}

fn emit_fibers_submit_batch(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
) -> !OutOfMemory {
    let s_switch = try interner.intern_str(alloc, "eon_fiber_switch");
    try b.xor_rr32(alloc, .R8, .R8);
    let l_sub_lp = try b.new_label(alloc);
    let l_sub_done = try b.new_label(alloc);
    b.bind_label(l_sub_lp);
    try b.load_mem(alloc, .Rax, .Rsp, 120_i32, 8_usize, false);
    try b.cmp_rr(alloc, .R8, .Rax);
    try b.jcc_label(alloc, .Ae, l_sub_done);

    try b.lea_mem(alloc, .Rdi, .Rsp, 0_i32);
    try b.mov_rr(alloc, .Rsi, .Rbx);
    try b.add_rr(alloc, .Rsi, .R8);
    try b.push(alloc, .R8);
    try b.imul_rri32(alloc, .Rsi, .Rsi, 80_i32);
    try b.add_rr(alloc, .Rsi, .R13);
    try b.call_sym(alloc, s_switch);
    try b.pop(alloc, .R8);

    try b.load_mem(alloc, .R9, .R12, 64_i32, 8_usize, false);
    try b.load_mem(alloc, .R10, .R9, 0_i32, 4_usize, false);
    try b.add_rr(alloc, .R10, .R8);
    try b.load_mem(alloc, .R11, .R12, 72_i32, 8_usize, false);
    try b.and_rr(alloc, .R10, .R11);
    try b.load_mem(alloc, .Rdi, .R12, 40_i32, 8_usize, false);
    try b.mov_rr(alloc, .Rsi, .R10);
    try b.shl_imm(alloc, .Rsi, 6_u8);
    try b.add_rr(alloc, .Rdi, .Rsi);
    try b.xor_rr32(alloc, .Rax, .Rax);
    var q: i32 = 0_i32;
    while q < 8_i32 {
        try b.store_mem(alloc, .Rdi, q *% 8_i32, .Rax, 8_usize);
        q = q +% 1_i32;
    }
    try b.mov_rr(alloc, .Rax, .Rbx);
    try b.add_rr(alloc, .Rax, .R8);
    try b.store_mem(alloc, .Rdi, 32_i32, .Rax, 8_usize);
    try b.load_mem(alloc, .Rdx, .R12, 80_i32, 8_usize, false);
    try b.mov_rr(alloc, .Rcx, .R10);
    try b.shl_imm(alloc, .Rcx, 2_u8);
    try b.add_rr(alloc, .Rdx, .Rcx);
    try b.store_mem(alloc, .Rdx, 0_i32, .R10, 4_usize);

    try b.add_ri32(alloc, .R8, 1_i32);
    try b.jmp_label(alloc, l_sub_lp);

    b.bind_label(l_sub_done);
    try b.load_mem(alloc, .R9, .R12, 64_i32, 8_usize, false);
    try b.load_mem(alloc, .Rax, .R9, 0_i32, 4_usize, false);
    try b.load_mem(alloc, .Rcx, .Rsp, 120_i32, 8_usize, false);
    try b.add_rr(alloc, .Rax, .Rcx);
    try b.sfence(alloc);
    try b.store_mem(alloc, .R9, 0_i32, .Rax, 4_usize);

    try b.load_mem(alloc, .Rdi, .R12, 0_i32, 8_usize, false);
    try b.mov_rr(alloc, .Rsi, .Rcx);
    try b.mov_rr(alloc, .Rdx, .Rcx);
    try b.mov_ri64(alloc, .R10, 1_u64);
    try b.xor_rr32(alloc, .R8, .R8);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.mov_ri64(alloc, .Rax, 426_u64);
    try b.syscall(alloc);
    return;
}

fn emit_fibers_drain_cqes(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
    l_batch_next: u32,
) -> !OutOfMemory {
    let s_switch = try interner.intern_str(alloc, "eon_fiber_switch");
    try b.xor_rr32(alloc, .R8, .R8);
    let l_drain_lp = try b.new_label(alloc);
    let l_cqe_lp = try b.new_label(alloc);
    let l_cqe_empty = try b.new_label(alloc);
    b.bind_label(l_drain_lp);
    try b.load_mem(alloc, .Rax, .Rsp, 120_i32, 8_usize, false);
    try b.cmp_rr(alloc, .R8, .Rax);
    try b.jcc_label(alloc, .Ae, l_batch_next);

    b.bind_label(l_cqe_lp);
    try b.load_mem(alloc, .R9, .R12, 88_i32, 8_usize, false);
    try b.load_mem(alloc, .R10, .R9, 0_i32, 4_usize, false);
    try b.load_mem(alloc, .R11, .R12, 96_i32, 8_usize, false);
    try b.load_mem(alloc, .Rcx, .R11, 0_i32, 4_usize, false);
    try b.lfence(alloc);
    try b.cmp_rr(alloc, .R10, .Rcx);
    try b.jcc_label(alloc, .E, l_cqe_empty);

    try b.load_mem(alloc, .Rdi, .R12, 104_i32, 8_usize, false);
    try b.mov_rr(alloc, .Rsi, .R10);
    try b.and_rr(alloc, .Rsi, .Rdi);
    try b.shl_imm(alloc, .Rsi, 4_u8);
    try b.load_mem(alloc, .Rdx, .R12, 112_i32, 8_usize, false);
    try b.add_rr(alloc, .Rdx, .Rsi);

    try b.load_mem(alloc, .Rdi, .Rdx, 0_i32, 8_usize, false);
    try b.load_mem(alloc, .Rax, .Rdx, 8_i32, 4_usize, true);
    try b.add_ri32(alloc, .R10, 1_i32);
    try b.sfence(alloc);
    try b.store_mem(alloc, .R9, 0_i32, .R10, 4_usize);

    try b.imul_rri32(alloc, .Rsi, .Rdi, 80_i32);
    try b.add_rr(alloc, .Rsi, .R13);
    try b.store_mem(alloc, .Rsi, 72_i32, .Rax, 8_usize);
    try b.push(alloc, .R8);
    try b.push(alloc, .Rsi);
    try b.lea_mem(alloc, .Rdi, .Rsp, 16_i32);
    try b.call_sym(alloc, s_switch);
    try b.pop(alloc, .Rsi);
    try b.pop(alloc, .R8);

    try b.load_mem(alloc, .Rax, .Rsi, 72_i32, 8_usize, false);
    try b.load_mem(alloc, .Rcx, .Rsp, 96_i32, 8_usize, false);
    try b.add_rr(alloc, .Rcx, .Rax);
    try b.store_mem(alloc, .Rsp, 96_i32, .Rcx, 8_usize);
    try b.add_ri32(alloc, .R8, 1_i32);
    try b.load_mem(alloc, .Rax, .Rsp, 120_i32, 8_usize, false);
    try b.cmp_rr(alloc, .R8, .Rax);
    try b.jcc_label(alloc, .B, l_cqe_lp);
    try b.jmp_label(alloc, l_batch_next);

    b.bind_label(l_cqe_empty);
    try b.load_mem(alloc, .Rdx, .Rsp, 120_i32, 8_usize, false);
    try b.sub_rr(alloc, .Rdx, .R8);
    try b.load_mem(alloc, .Rdi, .R12, 0_i32, 8_usize, false);
    try b.xor_rr32(alloc, .Rsi, .Rsi);
    try b.mov_ri64(alloc, .R10, 1_u64);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.push(alloc, .R8);
    try b.xor_rr32(alloc, .R8, .R8);
    try b.mov_ri64(alloc, .Rax, 426_u64);
    try b.syscall(alloc);
    try b.pop(alloc, .R8);
    try b.jmp_label(alloc, l_drain_lp);
    return;
}

fn emit_fibers_trampoline(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
) -> !OutOfMemory {
    let s_switch = try interner.intern_str(alloc, "eon_fiber_switch");
    try b.sub_ri32(alloc, .Rsp, 16_i32);
    try b.store_mem(alloc, .Rsp, 0_i32, .Rbx, 8_usize);
    try b.mov_rr(alloc, .Rdi, .R12);
    try b.mov_rr(alloc, .Rsi, .R14);
    try b.call_sym(alloc, s_switch);

    let l_skip_entry = try b.new_label(alloc);
    try b.test_rr(alloc, .R13, .R13);
    try b.jcc_label(alloc, .E, l_skip_entry);
    try b.mov_rr(alloc, .Rdi, .R15);
    try b.load_mem(alloc, .Rsi, .R12, 72_i32, 4_usize, true);
    try b.mov_rr(alloc, .Rdx, .Rbx);
    try b.call_reg(alloc, .R13);
    b.bind_label(l_skip_entry);

    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.store_mem(alloc, .R12, 72_i32, .Rax, 8_usize);
    try b.add_ri32(alloc, .Rsp, 16_i32);
    try b.mov_rr(alloc, .Rdi, .R12);
    try b.mov_rr(alloc, .Rsi, .R14);
    try b.call_sym(alloc, s_switch);
    try b.ud2(alloc);
    return;
}

fn emit_rt_run_fibers_iouring(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let s_destroy = try interner.intern_str(alloc, "eon_iouring_destroy");
    let l_ret_zero = try b.new_label(alloc);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .E, l_ret_zero);

    try b.push(alloc, .Rbx);
    try b.push(alloc, .R12);
    try b.push(alloc, .R13);
    try b.push(alloc, .R14);
    try b.push(alloc, .R15);
    try b.sub_ri32(alloc, .Rsp, 128_i32);

    try b.mov_rr(alloc, .R15, .Rdi);
    try b.store_mem(alloc, .Rsp, 80_i32, .Rdx, 8_usize);
    try b.store_mem(alloc, .Rsp, 88_i32, .Rcx, 8_usize);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .Rsp, 96_i32, .Rax, 8_usize);
    try b.store_mem(alloc, .Rsp, 112_i32, .R8, 8_usize);

    let l_fail_0 = try b.new_label(alloc);
    let l_fail_desc = try b.new_label(alloc);
    let l_fail_arena = try b.new_label(alloc);
    let l_fiber_tramp = try b.new_label(alloc);

    try emit_fibers_alloc_tables(alloc, b, interner, l_fail_0, l_fail_desc, l_fail_arena);
    try emit_fibers_init_descs(alloc, b, l_fiber_tramp);

    try b.xor_rr32(alloc, .Rbx, .Rbx);
    let l_batch_lp = try b.new_label(alloc);
    let l_batch_next = try b.new_label(alloc);
    let l_batch_done = try b.new_label(alloc);
    b.bind_label(l_batch_lp);
    try b.cmp_rr(alloc, .Rbx, .R15);
    try b.jcc_label(alloc, .Ae, l_batch_done);

    try b.mov_rr(alloc, .Rax, .R15);
    try b.sub_rr(alloc, .Rax, .Rbx);
    try b.load_mem(alloc, .Rcx, .R12, 120_i32, 8_usize, false);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    try b.cmovcc(alloc, .A, .Rax, .Rcx);
    try b.store_mem(alloc, .Rsp, 120_i32, .Rax, 8_usize);

    try emit_fibers_submit_batch(alloc, b, interner);
    try emit_fibers_drain_cqes(alloc, b, interner, l_batch_next);

    b.bind_label(l_batch_next);
    try b.load_mem(alloc, .Rax, .Rsp, 120_i32, 8_usize, false);
    try b.add_rr(alloc, .Rbx, .Rax);
    try b.jmp_label(alloc, l_batch_lp);

    b.bind_label(l_batch_done);
    try b.mov_rr(alloc, .Rdi, .R12);
    try b.call_sym(alloc, s_destroy);

    b.bind_label(l_fail_arena);
    try b.mov_rr(alloc, .Rdi, .R14);
    try b.load_mem(alloc, .Rsi, .Rsp, 72_i32, 8_usize, false);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);

    b.bind_label(l_fail_desc);
    try b.mov_rr(alloc, .Rdi, .R13);
    try b.load_mem(alloc, .Rsi, .Rsp, 64_i32, 8_usize, false);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);

    b.bind_label(l_fail_0);
    try b.load_mem(alloc, .Rax, .Rsp, 96_i32, 8_usize, false);
    try b.add_ri32(alloc, .Rsp, 128_i32);
    try b.pop(alloc, .R15);
    try b.pop(alloc, .R14);
    try b.pop(alloc, .R13);
    try b.pop(alloc, .R12);
    try b.pop(alloc, .Rbx);
    try b.ret(alloc);

    b.bind_label(l_ret_zero);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.ret(alloc);

    b.bind_label(l_fiber_tramp);
    try emit_fibers_trampoline(alloc, b, interner);
    return;
}

// ============================================================================
// Runtime Helper Dependencies, Catalog & Name-Based Dispatcher
// ============================================================================

pub fn rt_helper_deps(
    alloc: *mut AllocCap,
    name: *[u8],
    interner: *mut span.SymInterner,
    out: *mut col.DynBuf[u32],
) -> !OutOfMemory {
    if str.bytes_eq(name, "eon_rt_print_bytes".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_str".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_bytes".as_bytes())
        || str.bytes_eq(name, "eon_rt_eprint_nl".as_bytes())
    {
        let sid = try interner.intern_str(alloc, "eon_rt_write_fd");
        try out.push(alloc, sid);
        return;
    }
    if str.bytes_eq(name, "eon_par_for".as_bytes())
        || str.bytes_eq(name, "eon_sched_run_dag".as_bytes())
    {
        let sid = try interner.intern_str(alloc, "eon_sched_init");
        try out.push(alloc, sid);
        return;
    }
    if str.bytes_eq(name, "eon_run_fibers_iouring".as_bytes()) {
        let s0 = try interner.intern_str(alloc, "eon_iouring_create");
        let s1 = try interner.intern_str(alloc, "eon_iouring_destroy");
        let s2 = try interner.intern_str(alloc, "eon_fiber_switch");
        try out.push(alloc, s0);
        try out.push(alloc, s1);
        try out.push(alloc, s2);
        return;
    }
    return;
}

fn push_helper_name(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    out: *mut col.DynBuf[u32],
    name: *str,
) -> !OutOfMemory {
    let sid = try interner.intern_str(alloc, name);
    try out.push(alloc, sid);
    return;
}

pub fn emit_all_rt_helper_names(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    out: *mut col.DynBuf[u32],
) -> !OutOfMemory {
    try push_helper_name(alloc, interner, out, "eon_alloc_raw");
    try push_helper_name(alloc, interner, out, "eon_alloc_raw_uninit");
    try push_helper_name(alloc, interner, out, "eon_free_raw");
    try push_helper_name(alloc, interner, out, "eon_alloc_raw_san");
    try push_helper_name(alloc, interner, out, "eon_free_raw_san");
    try push_helper_name(alloc, interner, out, "eon_arena_alloc_aligned");
    try push_helper_name(alloc, interner, out, "eon_rt_arena_reset_san");
    try push_helper_name(alloc, interner, out, "eon_rt_install_san_handler");
    try push_helper_name(alloc, interner, out, "eon_rt_tls_init");
    try push_helper_name(alloc, interner, out, "eon_rt_parse_vdso");
    try push_helper_name(alloc, interner, out, "eon_rt_now_ns");
    try push_helper_name(alloc, interner, out, "eon_rt_openat2_beneath");
    try push_helper_name(alloc, interner, out, "eon_rt_read_fd");
    try push_helper_name(alloc, interner, out, "eon_rt_write_fd");
    try push_helper_name(alloc, interner, out, "eon_rt_close_fd");
    try push_helper_name(alloc, interner, out, "eon_rt_print_str");
    try push_helper_name(alloc, interner, out, "eon_rt_print_bytes");
    try push_helper_name(alloc, interner, out, "eon_rt_print_u64");
    try push_helper_name(alloc, interner, out, "eon_rt_print_i64");
    try push_helper_name(alloc, interner, out, "eon_rt_print_f32");
    try push_helper_name(alloc, interner, out, "eon_rt_print_nl");
    try push_helper_name(alloc, interner, out, "eon_rt_eprint_str");
    try push_helper_name(alloc, interner, out, "eon_rt_eprint_bytes");
    try push_helper_name(alloc, interner, out, "eon_rt_eprint_nl");
    try push_helper_name(alloc, interner, out, "eon_rt_validate_utf8");
    try push_helper_name(alloc, interner, out, "eon_rt_is_dir");
    try push_helper_name(alloc, interner, out, "eon_rt_mkdir_all");
    try push_helper_name(alloc, interner, out, "eon_rt_spawn_wait");
    try push_helper_name(alloc, interner, out, "eon_f16_to_f32");
    try push_helper_name(alloc, interner, out, "eon_f32_to_f16");
    try push_helper_name(alloc, interner, out, "eon_sched_init");
    try push_helper_name(alloc, interner, out, "eon_sched_shutdown");
    try push_helper_name(alloc, interner, out, "eon_par_for");
    try push_helper_name(alloc, interner, out, "eon_sched_run_dag");
    try push_helper_name(alloc, interner, out, "eon_fiber_switch");
    try push_helper_name(alloc, interner, out, "eon_iouring_create");
    try push_helper_name(alloc, interner, out, "eon_iouring_destroy");
    try push_helper_name(alloc, interner, out, "eon_run_fibers_iouring");
    return;
}

fn dispatch_rt_helper_mem_io(
    alloc: *mut AllocCap,
    name: *[u8],
    interner: *mut span.SymInterner,
    out: *mut X64Buf,
) -> bool ! OutOfMemory {
    if str.bytes_eq(name, "eon_alloc_raw".as_bytes()) {
        out.clear(); try emit_rt_alloc_raw(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_alloc_raw_uninit".as_bytes()) {
        out.clear(); try emit_rt_alloc_raw_uninit(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_free_raw".as_bytes()) {
        out.clear(); try emit_rt_free_raw(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_alloc_raw_san".as_bytes()) {
        out.clear(); try emit_rt_alloc_raw_san(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_free_raw_san".as_bytes()) {
        out.clear(); try emit_rt_free_raw_san(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_arena_alloc_aligned".as_bytes()) {
        out.clear(); try emit_rt_arena_alloc(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_arena_reset_san".as_bytes()) {
        out.clear(); try emit_rt_arena_reset_san(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_install_san_handler".as_bytes()) {
        out.clear(); try emit_rt_install_san_handler(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_tls_init".as_bytes()) {
        out.clear(); try emit_rt_tls_init(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_parse_vdso".as_bytes()) {
        out.clear(); try emit_rt_parse_vdso(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_now_ns".as_bytes()) {
        out.clear(); try emit_rt_now_ns(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_openat2_beneath".as_bytes()) {
        out.clear(); try emit_rt_openat2_beneath(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_read_fd".as_bytes()) {
        out.clear(); try emit_rt_read_fd(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_write_fd".as_bytes()) {
        out.clear(); try emit_rt_write_fd(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_close_fd".as_bytes()) {
        out.clear(); try emit_rt_close_fd(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_str".as_bytes()) {
        out.clear(); try emit_rt_print_str(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_bytes".as_bytes()) {
        out.clear(); try emit_rt_write_all_to_fd(alloc, interner, out, 1_u64); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_u64".as_bytes()) {
        out.clear(); try emit_rt_print_u64(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_i64".as_bytes()) {
        out.clear(); try emit_rt_print_i64(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_f32".as_bytes()) {
        out.clear(); try emit_rt_print_f32(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_print_nl".as_bytes()) {
        out.clear(); try emit_rt_print_nl(alloc, out); return out.finish();
    }
    return false;
}

fn dispatch_rt_helper_sys_sched(
    alloc: *mut AllocCap,
    name: *[u8],
    interner: *mut span.SymInterner,
    out: *mut X64Buf,
) -> bool ! OutOfMemory {
    if str.bytes_eq(name, "eon_rt_eprint_str".as_bytes()) {
        out.clear(); try emit_rt_write_all_to_fd(alloc, interner, out, 2_u64); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_eprint_bytes".as_bytes()) {
        out.clear(); try emit_rt_write_all_to_fd(alloc, interner, out, 2_u64); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_eprint_nl".as_bytes()) {
        out.clear(); try emit_rt_eprint_nl(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_validate_utf8".as_bytes()) {
        out.clear(); try emit_rt_validate_utf8(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_is_dir".as_bytes()) {
        out.clear(); try emit_rt_is_dir(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_mkdir_all".as_bytes()) {
        out.clear(); try emit_rt_mkdir_all(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_rt_spawn_wait".as_bytes()) {
        out.clear(); try emit_rt_spawn_wait(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_f16_to_f32".as_bytes()) {
        out.clear(); try emit_rt_f16_to_f32(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_f32_to_f16".as_bytes()) {
        out.clear(); try emit_rt_f32_to_f16(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_sched_init".as_bytes()) {
        out.clear(); try emit_rt_sched_init(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_sched_shutdown".as_bytes()) {
        out.clear(); try emit_rt_sched_shutdown(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_par_for".as_bytes()) {
        out.clear(); try emit_rt_par_for(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_sched_run_dag".as_bytes()) {
        out.clear(); try emit_rt_sched_run_dag(alloc, interner, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_fiber_switch".as_bytes()) {
        out.clear(); try emit_rt_fiber_switch(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_iouring_create".as_bytes()) {
        out.clear(); try emit_rt_iouring_create(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_iouring_destroy".as_bytes()) {
        out.clear(); try emit_rt_iouring_destroy(alloc, out); return out.finish();
    }
    if str.bytes_eq(name, "eon_run_fibers_iouring".as_bytes()) {
        out.clear(); try emit_rt_run_fibers_iouring(alloc, interner, out); return out.finish();
    }
    return false;
}

pub fn emit_rt_helper_by_name(
    alloc: *mut AllocCap,
    name: *[u8],
    interner: *mut span.SymInterner,
    out: *mut X64Buf,
) -> bool ! OutOfMemory {
    if try dispatch_rt_helper_mem_io(alloc, name, interner, out) {
        return true;
    }
    return try dispatch_rt_helper_sys_sched(alloc, name, interner, out);
}
