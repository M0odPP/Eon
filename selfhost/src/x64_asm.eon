    ) -> !OutOfMemory {
        try self.lock_cmpxchg_disp(alloc, ptr, 0_i32, desired, bytes);
        return;
    }

    pub fn xchg_mem_disp(
        self: *mut Self,
        alloc: *mut AllocCap,
        ptr: Reg,
        disp: i32,
        val: Reg,
        bytes: usize,
    ) -> !OutOfMemory {
        try self.emit_rm_mem(alloc, false, 0_u8, 0x86_u8, 0x87_u8, ptr, disp, val, bytes);
        return;
    }

    pub fn xchg_mem(
        self: *mut Self,
        alloc: *mut AllocCap,
        ptr: Reg,
        val: Reg,
        bytes: usize,
    ) -> !OutOfMemory {
        try self.xchg_mem_disp(alloc, ptr, 0_i32, val, bytes);
        return;
    }

    // --- SSE2 / FMA3 / Packed SIMD ops ---

    pub fn movss_load(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        base: Reg,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF3_u8);
        try self.emit_rex(alloc, false, dst.hi(), false, base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x10_u8);
        try self.emit_mem(alloc, dst.low(), base, disp);
        return;
    }

    pub fn movss_store(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        disp: i32,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF3_u8);
        try self.emit_rex(alloc, false, src.hi(), false, base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x11_u8);
        try self.emit_mem(alloc, src.low(), base, disp);
        return;
    }

    pub fn movsd_load(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        base: Reg,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF2_u8);
        try self.emit_rex(alloc, false, dst.hi(), false, base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x10_u8);
        try self.emit_mem(alloc, dst.low(), base, disp);
        return;
    }

    pub fn movsd_store(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        disp: i32,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF2_u8);
        try self.emit_rex(alloc, false, src.hi(), false, base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x11_u8);
        try self.emit_mem(alloc, src.low(), base, disp);
        return;
    }

    pub fn movdqu_store_n(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        disp: i32,
        xmm_n: u8,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF3_u8);
        try self.emit_rex(alloc, false, xmm_n >= 8_u8, false, base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x7F_u8);
        try self.emit_mem(alloc, xmm_n & 7_u8, base, disp);
        return;
    }

    pub fn movdqu_load_n(
        self: *mut Self,
        alloc: *mut AllocCap,
        xmm_n: u8,
        base: Reg,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF3_u8);
        try self.emit_rex(alloc, false, xmm_n >= 8_u8, false, base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x6F_u8);
        try self.emit_mem(alloc, xmm_n & 7_u8, base, disp);
        return;
    }

    pub fn movd_xmm_r32(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x66_u8);
        try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x6E_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn movd_r32_xmm(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x66_u8);
        try self.emit_rex(alloc, false, src.hi(), false, dst.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x7E_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        return;
    }

    pub fn movq_xmm_r64(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x66_u8);
        try self.emit_rex(alloc, true, dst.hi(), false, src.hi(), true);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x6E_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn movq_r64_xmm(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x66_u8);
        try self.emit_rex(alloc, true, src.hi(), false, dst.hi(), true);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x7E_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        return;
    }

    pub fn sse_bin(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_f64: bool,
        opcode: u8,
        dst: Xmm,
        src: Xmm,
    ) -> !OutOfMemory {
        let pfx: u8 = if is_f64 { 0xF2_u8 } else { 0xF3_u8 };
        try self.emit_u8(alloc, pfx);
        try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, opcode);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn sqrt_f(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_f64: bool,
        dst: Xmm,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.sse_bin(alloc, is_f64, 0x51_u8, dst, src);
        return;
    }

    pub fn vfmadd213(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_f64: bool,
        dst: Xmm,
        src1: Xmm,
        src2: Xmm,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xC4_u8);
        var vex1: u8 = 0x42_u8;
        if !dst.hi() {
            vex1 = vex1 | 0x80_u8;
        }
        if !src2.hi() {
            vex1 = vex1 | 0x20_u8;
        }
        try self.emit_u8(alloc, vex1);
        let w_bit: u8 = if is_f64 { 0x80_u8 } else { 0_u8 };
        let vvvv: u8 = ((~src1.id()) & 0x0F_u8) <<% 3_u8;
        try self.emit_u8(alloc, w_bit | vvvv | 0x01_u8);
        try self.emit_u8(alloc, 0xA9_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src2.low()));
        return;
    }

    pub fn movups_load(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        base: Reg,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, false, dst.hi(), false, base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x10_u8);
        try self.emit_mem(alloc, dst.low(), base, disp);
        return;
    }

    pub fn movups_store(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        disp: i32,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, false, src.hi(), false, base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x11_u8);
        try self.emit_mem(alloc, src.low(), base, disp);
        return;
    }

    pub fn sse_ps_bin(
        self: *mut Self,
        alloc: *mut AllocCap,
        opcode: u8,
        dst: Xmm,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, opcode);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn sse_66_bin(
        self: *mut Self,
        alloc: *mut AllocCap,
        opcode: u8,
        dst: Xmm,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x66_u8);
        try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, opcode);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn psllw_imm(self: *mut Self, alloc: *mut AllocCap, dst: Xmm, imm: u8) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x66_u8);
        try self.emit_rex(alloc, false, false, false, dst.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x71_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 6_u8, dst.low()));
        try self.emit_u8(alloc, imm);
        return;
    }

    pub fn pmovmskb(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Xmm) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x66_u8);
        try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0xD7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn ucomi(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_f64: bool,
        a: Xmm,
        b: Xmm,
    ) -> !OutOfMemory {
        if is_f64 {
            try self.emit_u8(alloc, 0x66_u8);
        }
        try self.emit_rex(alloc, false, a.hi(), false, b.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x2E_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, a.low(), b.low()));
        return;
    }

    pub fn cvtsi2f(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_f64: bool,
        dst: Xmm,
        src: Reg,
    ) -> !OutOfMemory {
        let pfx: u8 = if is_f64 { 0xF2_u8 } else { 0xF3_u8 };
        try self.emit_u8(alloc, pfx);
        try self.emit_rex(alloc, true, dst.hi(), false, src.hi(), true);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x2A_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn cvttf2si(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_f64: bool,
        dst: Reg,
        src: Xmm,
    ) -> !OutOfMemory {
        let pfx: u8 = if is_f64 { 0xF2_u8 } else { 0xF3_u8 };
        try self.emit_u8(alloc, pfx);
        try self.emit_rex(alloc, true, dst.hi(), false, src.hi(), true);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x2C_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn cvtss2sd(self: *mut Self, alloc: *mut AllocCap, dst: Xmm, src: Xmm) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF3_u8);
        try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x5A_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn cvtsd2ss(self: *mut Self, alloc: *mut AllocCap, dst: Xmm, src: Xmm) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF2_u8);
        try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x5A_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    // --- Phase 9: SIB Memory Addressing [base + idx*scale + disp] ---

    pub fn emit_mem_sib(
        self: *mut Self,
        alloc: *mut AllocCap,
        reg_field: u8,
        base: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
    ) -> !OutOfMemory {
        let bl = base.low();
        let sib = sib_byte(scale, idx.low(), bl);
        if disp == 0_i32 && bl != 5_u8 {
            try self.emit_u8(alloc, modrm_byte(0_u8, reg_field, 4_u8));
            try self.emit_u8(alloc, sib);
        } else if disp >= -128_i32 && disp <= 127_i32 {
            try self.emit_u8(alloc, modrm_byte(1_u8, reg_field, 4_u8));
            try self.emit_u8(alloc, sib);
            try self.emit_u8(alloc, disp.bitcast.[u32]().trunc.[u8]());
        } else {
            try self.emit_u8(alloc, modrm_byte(2_u8, reg_field, 4_u8));
            try self.emit_u8(alloc, sib);
            try self.emit_i32(alloc, disp);
        }
        return;
    }

    pub fn load_mem_sib(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        base: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
        bytes: usize,
        signed: bool,
    ) -> !OutOfMemory {
        if bytes == 8_usize {
            try self.emit_rex(alloc, true, dst.hi(), idx.hi(), base.hi(), true);
            try self.emit_u8(alloc, 0x8B_u8);
            try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        } else if bytes == 4_usize && !signed {
            try self.emit_rex(alloc, false, dst.hi(), idx.hi(), base.hi(), false);
            try self.emit_u8(alloc, 0x8B_u8);
            try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        } else if bytes == 4_usize && signed {
            try self.emit_rex(alloc, true, dst.hi(), idx.hi(), base.hi(), true);
            try self.emit_u8(alloc, 0x63_u8);
            try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        } else if bytes == 2_usize && !signed {
            try self.emit_rex(alloc, false, dst.hi(), idx.hi(), base.hi(), false);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xB7_u8);
            try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        } else if bytes == 2_usize && signed {
            try self.emit_rex(alloc, true, dst.hi(), idx.hi(), base.hi(), true);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xBF_u8);
            try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        } else if bytes == 1_usize && !signed {
            try self.emit_rex(alloc, false, dst.hi(), idx.hi(), base.hi(), false);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xB6_u8);
            try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        } else if bytes == 1_usize && signed {
            try self.emit_rex(alloc, true, dst.hi(), idx.hi(), base.hi(), true);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xBE_u8);
            try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        } else {
            try self.emit_rex(alloc, true, dst.hi(), idx.hi(), base.hi(), true);
            try self.emit_u8(alloc, 0x8B_u8);
            try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        }
        return;
    }

    pub fn store_mem_sib(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
        src: Reg,
        bytes: usize,
    ) -> !OutOfMemory {
        if bytes == 8_usize {
            try self.emit_rex(alloc, true, src.hi(), idx.hi(), base.hi(), true);
            try self.emit_u8(alloc, 0x89_u8);
            try self.emit_mem_sib(alloc, src.low(), base, idx, scale, disp);
        } else if bytes == 4_usize {
            try self.emit_rex(alloc, false, src.hi(), idx.hi(), base.hi(), false);
            try self.emit_u8(alloc, 0x89_u8);
            try self.emit_mem_sib(alloc, src.low(), base, idx, scale, disp);
        } else if bytes == 2_usize {
            try self.emit_u8(alloc, 0x66_u8);
            try self.emit_rex(alloc, false, src.hi(), idx.hi(), base.hi(), false);
            try self.emit_u8(alloc, 0x89_u8);
            try self.emit_mem_sib(alloc, src.low(), base, idx, scale, disp);
        } else if bytes == 1_usize {
            let need_rex = src.id() >= 4_u8 || base.hi() || idx.hi();
            try self.emit_rex(alloc, false, src.hi(), idx.hi(), base.hi(), need_rex);
            try self.emit_u8(alloc, 0x88_u8);
            try self.emit_mem_sib(alloc, src.low(), base, idx, scale, disp);
        } else {
            try self.emit_rex(alloc, true, src.hi(), idx.hi(), base.hi(), true);
            try self.emit_u8(alloc, 0x89_u8);
            try self.emit_mem_sib(alloc, src.low(), base, idx, scale, disp);
        }
        return;
    }

    pub fn lea_sib(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        base: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), idx.hi(), base.hi(), true);
        try self.emit_u8(alloc, 0x8D_u8);
        try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        return;
    }

    pub fn lea_scale_disp(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), idx.hi(), false, true);
        try self.emit_u8(alloc, 0x8D_u8);
        try self.emit_u8(alloc, modrm_byte(0_u8, dst.low(), 4_u8));
        try self.emit_u8(alloc, sib_byte(scale, idx.low(), 5_u8));
        try self.emit_i32(alloc, disp);
        return;
    }

    pub fn movss_load_sib(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        base: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF3_u8);
        try self.emit_rex(alloc, false, dst.hi(), idx.hi(), base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x10_u8);
        try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        return;
    }

    pub fn movss_store_sib(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF3_u8);
        try self.emit_rex(alloc, false, src.hi(), idx.hi(), base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x11_u8);
        try self.emit_mem_sib(alloc, src.low(), base, idx, scale, disp);
        return;
    }

    pub fn movsd_load_sib(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        base: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF2_u8);
        try self.emit_rex(alloc, false, dst.hi(), idx.hi(), base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x10_u8);
        try self.emit_mem_sib(alloc, dst.low(), base, idx, scale, disp);
        return;
    }

    pub fn movsd_store_sib(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF2_u8);
        try self.emit_rex(alloc, false, src.hi(), idx.hi(), base.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x11_u8);
        try self.emit_mem_sib(alloc, src.low(), base, idx, scale, disp);
        return;
    }

    // --- Phase 9: 32-bit & Immediate GPR, Division/Mul, BMI1, Indirect Jumps & Alignment ---

    pub fn mov_rr32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, src.hi(), false, dst.hi(), false);
        try self.emit_u8(alloc, 0x89_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        return;
    }

    pub fn mov_ri32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: u32) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, dst.hi(), false);
        try self.emit_u8(alloc, 0xB8_u8 +% dst.low());
        try self.emit_u32(alloc, imm);
        return;
    }

    fn alu_rr32(self: *mut Self, alloc: *mut AllocCap, op: u8, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, src.hi(), false, dst.hi(), false);
        try self.emit_u8(alloc, op);
        try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        return;
    }

    fn alu_ri32_32(self: *mut Self, alloc: *mut AllocCap, ext: u8, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, dst.hi(), false);
        if imm >= -128_i32 && imm <= 127_i32 {
            try self.emit_u8(alloc, 0x83_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, ext, dst.low()));
            try self.emit_u8(alloc, imm.bitcast.[u32]().trunc.[u8]());
        } else {
            try self.emit_u8(alloc, 0x81_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, ext, dst.low()));
            try self.emit_i32(alloc, imm);
        }
        return;
    }

    pub fn add_rr32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.alu_rr32(alloc, 0x01_u8, dst, src);
        return;
    }

    pub fn sub_rr32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.alu_rr32(alloc, 0x29_u8, dst, src);
        return;
    }

    pub fn and_rr32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.alu_rr32(alloc, 0x21_u8, dst, src);
        return;
    }

    pub fn or_rr32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.alu_rr32(alloc, 0x09_u8, dst, src);
        return;
    }

    pub fn cmp_rr32(self: *mut Self, alloc: *mut AllocCap, lhs: Reg, rhs: Reg) -> !OutOfMemory {
        try self.alu_rr32(alloc, 0x39_u8, lhs, rhs);
        return;
    }

    pub fn imul_rr32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, src: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0xAF_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn imul_rri32_32(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Reg,
        src: Reg,
        imm: i32,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
        if imm >= -128_i32 && imm <= 127_i32 {
            try self.emit_u8(alloc, 0x6B_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
            try self.emit_u8(alloc, imm.bitcast.[u32]().trunc.[u8]());
        } else {
            try self.emit_u8(alloc, 0x69_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
            try self.emit_i32(alloc, imm);
        }
        return;
    }

    pub fn test_ri32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.emit_rex(alloc, true, false, false, dst.hi(), true);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 0_u8, dst.low()));
        try self.emit_i32(alloc, imm);
        return;
    }

    pub fn add_ri32_32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.alu_ri32_32(alloc, 0_u8, dst, imm);
        return;
    }

    pub fn sub_ri32_32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.alu_ri32_32(alloc, 5_u8, dst, imm);
        return;
    }

    pub fn and_ri32_32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.alu_ri32_32(alloc, 4_u8, dst, imm);
        return;
    }

    pub fn or_ri32_32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.alu_ri32_32(alloc, 1_u8, dst, imm);
        return;
    }

    pub fn xor_ri32_32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.alu_ri32_32(alloc, 6_u8, dst, imm);
        return;
    }

    pub fn cmp_ri32_32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.alu_ri32_32(alloc, 7_u8, dst, imm);
        return;
    }

    pub fn test_ri32_32(self: *mut Self, alloc: *mut AllocCap, dst: Reg, imm: i32) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, dst.hi(), false);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 0_u8, dst.low()));
        try self.emit_i32(alloc, imm);
        return;
    }

    pub fn neg_r32(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 3_u8, r.low()));
        return;
    }

    pub fn not_r32(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 2_u8, r.low()));
        return;
    }

    pub fn shl_imm32(self: *mut Self, alloc: *mut AllocCap, r: Reg, imm: u8) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xC1_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 4_u8, r.low()));
        try self.emit_u8(alloc, imm);
        return;
    }

    pub fn shr_imm32(self: *mut Self, alloc: *mut AllocCap, r: Reg, imm: u8) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xC1_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 5_u8, r.low()));
        try self.emit_u8(alloc, imm);
        return;
    }

    pub fn sar_imm32(self: *mut Self, alloc: *mut AllocCap, r: Reg, imm: u8) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xC1_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 7_u8, r.low()));
        try self.emit_u8(alloc, imm);
        return;
    }

    pub fn ror_imm32(self: *mut Self, alloc: *mut AllocCap, r: Reg, imm: u8) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xC1_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 1_u8, r.low()));
        try self.emit_u8(alloc, imm);
        return;
    }

    pub fn shl_cl32(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xD3_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 4_u8, r.low()));
        return;
    }

    pub fn shr_cl32(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xD3_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 5_u8, r.low()));
        return;
    }

    pub fn sar_cl32(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xD3_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 7_u8, r.low()));
        return;
    }

    pub fn cdq(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0x99_u8);
        return;
    }

    pub fn div_r32(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 6_u8, r.low()));
        return;
    }

    pub fn idiv_r32(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 7_u8, r.low()));
        return;
    }

    pub fn mul_r32(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 4_u8, r.low()));
        return;
    }

    pub fn imul_r(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, true, false, false, r.hi(), true);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 5_u8, r.low()));
        return;
    }

    pub fn imul_r32(self: *mut Self, alloc: *mut AllocCap, r: Reg) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, false, r.hi(), false);
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, 5_u8, r.low()));
        return;
    }

    pub fn bextr(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_64: bool,
        dst: Reg,
        src: Reg,
        ctrl: Reg,
    ) -> !OutOfMemory {
        try self.emit_vex3(
            alloc,
            dst.hi(),
            false,
            src.hi(),
            VEX_MAP_0F38,
            is_64,
            ctrl.id(),
            false,
            VEX_PP_NONE,
        );
        try self.emit_u8(alloc, 0xF7_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn cmovcc32(
        self: *mut Self,
        alloc: *mut AllocCap,
        cc: Cond,
        dst: Reg,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, false, dst.hi(), false, src.hi(), false);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x40_u8 | cc.id());
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn jmp_r(self: *mut Self, alloc: *mut AllocCap, target: Reg) -> !OutOfMemory {
        try self.jmp_reg(alloc, target);
        return;
    }

    pub fn jmp_mem_sib(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, false, false, idx.hi(), base.hi(), false);
        try self.emit_u8(alloc, 0xFF_u8);
        try self.emit_mem_sib(alloc, 4_u8, base, idx, scale, disp);
        return;
    }

    pub fn align_nop(self: *mut Self, alloc: *mut AllocCap, align: usize) -> !OutOfMemory {
        if align <= 1_usize {
            return;
        }
        let cur = self.code.len();
        let rem = cur % align;
        if rem == 0_usize {
            return;
        }
        var pad = align -% rem;
        while pad > 0_usize {
            if pad >= 8_usize {
                try self.emit_u8(alloc, 0x0F_u8);
                try self.emit_u8(alloc, 0x1F_u8);
                try self.emit_u8(alloc, 0x84_u8);
                try self.emit_u8(alloc, 0x00_u8);
                try self.emit_u32(alloc, 0_u32);
                pad = pad -% 8_usize;
            } else if pad == 7_usize {
                try self.emit_u8(alloc, 0x0F_u8);
                try self.emit_u8(alloc, 0x1F_u8);
                try self.emit_u8(alloc, 0x80_u8);
                try self.emit_u32(alloc, 0_u32);
                pad = 0_usize;
            } else if pad == 6_usize {
                try self.emit_u8(alloc, 0x66_u8);
                try self.emit_u8(alloc, 0x0F_u8);
                try self.emit_u8(alloc, 0x1F_u8);
                try self.emit_u8(alloc, 0x44_u8);
                try self.emit_u8(alloc, 0x00_u8);
                try self.emit_u8(alloc, 0x00_u8);
                pad = 0_usize;
            } else if pad == 5_usize {
                try self.emit_u8(alloc, 0x0F_u8);
                try self.emit_u8(alloc, 0x1F_u8);
                try self.emit_u8(alloc, 0x44_u8);
                try self.emit_u8(alloc, 0x00_u8);
                try self.emit_u8(alloc, 0x00_u8);
                pad = 0_usize;
            } else if pad == 4_usize {
                try self.emit_u8(alloc, 0x0F_u8);
                try self.emit_u8(alloc, 0x1F_u8);
                try self.emit_u8(alloc, 0x40_u8);
                try self.emit_u8(alloc, 0x00_u8);
                pad = 0_usize;
            } else if pad == 3_usize {
                try self.emit_u8(alloc, 0x0F_u8);
                try self.emit_u8(alloc, 0x1F_u8);
                try self.emit_u8(alloc, 0x00_u8);
                pad = 0_usize;
            } else if pad == 2_usize {
                try self.emit_u8(alloc, 0x66_u8);
                try self.emit_u8(alloc, 0x90_u8);
                pad = 0_usize;
            } else {
                try self.emit_u8(alloc, 0x90_u8);
                pad = 0_usize;
            }
        }
        return;
    }

    pub fn vzeroupper(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xC5_u8);
        try self.emit_u8(alloc, 0xF8_u8);
        try self.emit_u8(alloc, 0x77_u8);
        return;
    }

    // --- Phase 9: Full VEX / AVX2 / FMA3 Encoder (128-bit XMM & 256-bit YMM) ---

    pub fn emit_vex3(
        self: *mut Self,
        alloc: *mut AllocCap,
        r_hi: bool,
        x_hi: bool,
        b_hi: bool,
        map: u8,
        w: bool,
        vvvv: u8,
        l256: bool,
        pp: u8,
    ) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xC4_u8);
        var p1: u8 = map & 0x1F_u8;
        if !r_hi { p1 = p1 | 0x80_u8; }
        if !x_hi { p1 = p1 | 0x40_u8; }
        if !b_hi { p1 = p1 | 0x20_u8; }
        try self.emit_u8(alloc, p1);
        var p2: u8 = (((~vvvv) & 0x0F_u8) <<% 3_u8) | (pp & 0x03_u8);
        if w { p2 = p2 | 0x80_u8; }
        if l256 { p2 = p2 | 0x04_u8; }
        try self.emit_u8(alloc, p2);
        return;
    }

    fn vex_rr(
        self: *mut Self,
        alloc: *mut AllocCap,
        map: u8,
        pp: u8,
        w: bool,
        l256: bool,
        op: u8,
        dst: Xmm,
        src1: Xmm,
        src2: Xmm,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, dst.hi(), false, src2.hi(), map, w, src1.id(), l256, pp);
        try self.emit_u8(alloc, op);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src2.low()));
        return;
    }

    fn vex_r2(
        self: *mut Self,
        alloc: *mut AllocCap,
        map: u8,
        pp: u8,
        w: bool,
        l256: bool,
        op: u8,
        dst: Xmm,
        src: Xmm,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, dst.hi(), false, src.hi(), map, w, 0_u8, l256, pp);
        try self.emit_u8(alloc, op);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    fn vex_mem(
        self: *mut Self,
        alloc: *mut AllocCap,
        map: u8,
        pp: u8,
        w: bool,
        l256: bool,
        op: u8,
        reg: Xmm,
        vvvv: u8,
        base: Reg,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, reg.hi(), false, base.hi(), map, w, vvvv, l256, pp);
        try self.emit_u8(alloc, op);
        try self.emit_mem(alloc, reg.low(), base, disp);
        return;
    }

    fn vex_sib(
        self: *mut Self,
        alloc: *mut AllocCap,
        map: u8,
        pp: u8,
        w: bool,
        l256: bool,
        op: u8,
        reg: Xmm,
        vvvv: u8,
        base: Reg,
        idx: Reg,
        scale: u8,
        disp: i32,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, reg.hi(), idx.hi(), base.hi(), map, w, vvvv, l256, pp);
        try self.emit_u8(alloc, op);
        try self.emit_mem_sib(alloc, reg.low(), base, idx, scale, disp);
        return;
    }

    fn vex_shift_imm(
        self: *mut Self,
        alloc: *mut AllocCap,
        l256: bool,
        op: u8,
        ext: u8,
        dst: Xmm,
        src: Xmm,
        imm: u8,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, false, false, src.hi(), VEX_MAP_0F, false, dst.id(), l256, VEX_PP_66);
        try self.emit_u8(alloc, op);
        try self.emit_u8(alloc, modrm_byte(3_u8, ext, src.low()));
        try self.emit_u8(alloc, imm);
        return;
    }

