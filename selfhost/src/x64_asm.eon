    try b.add_rr(alloc, .Rdx, .Rcx);
    try b.load_mem(alloc, .Rax, .Rdx, 0_i32, 1_usize, false);
    try b.mov_rr(alloc, .Rdx, .R10);
    try b.add_rr(alloc, .Rdx, .Rcx);
