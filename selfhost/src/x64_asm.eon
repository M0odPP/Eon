fn emit_rt_parse_vdso(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let l_fail = try b.new_label(alloc);
    let l_str_name = try b.new_label(alloc);
    let l_fail_pop = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);

