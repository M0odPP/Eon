    pub fn setcc(self: *mut Self, alloc: *mut AllocCap, cc: Cond, dst: Reg) -> !OutOfMemory {
        let need_rex = dst.id() >= 4_u8;
        try self.emit_rex(alloc, false, false, false, dst.hi(), need_rex);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x90_u8 | cc.id());
        try self.emit_u8(alloc, modrm_byte(3_u8, 0_u8, dst.low()));
        try self.extend_reg(alloc, dst, dst, 8_u8, false);
        return;
    }

    pub fn cmovcc(
        self: *mut Self,
        alloc: *mut AllocCap,
        cc: Cond,
        dst: Reg,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_rex(alloc, true, dst.hi(), false, src.hi(), true);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, 0x40_u8 | cc.id());
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    // --- Bulk memory ops ---

    pub fn rep_movsb(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF3_u8);
        try self.emit_u8(alloc, 0xA4_u8);
        return;
    }

