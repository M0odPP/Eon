        l256: bool,
    ) -> !OutOfMemory {
        try self.vex_rr(alloc, VEX_MAP_0F, VEX_PP_NONE, false, l256, 0xC2_u8, dst, src1, src2);
        try self.emit_u8(alloc, imm8);
        return;
    }

    pub fn vblendvps(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src1: Xmm,
        src2: Xmm,
        mask: Xmm,
        l256: bool,
    ) -> !OutOfMemory {
        try self.vex_rr(alloc, VEX_MAP_0F3A, VEX_PP_66, false, l256, 0x4A_u8, dst, src1, src2);
        try self.emit_u8(alloc, (mask.id() & 0x0F_u8) <<% 4_u8);
        return;
    }

