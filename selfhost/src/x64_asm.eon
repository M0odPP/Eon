    b.bind_label(l_fail_pop);
    try b.xor_rr32(alloc, .Rax, .Rax);
    b.bind_label(l_done);
    try b.pop(alloc, .R15);
    try b.pop(alloc, .R14);
    try b.pop(alloc, .R13);
    try b.pop(alloc, .R12);
    try b.pop(alloc, .Rbx);
    try b.ret(alloc);

    b.bind_label(l_fail);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.ret(alloc);

    b.bind_label(l_str_name);
    try b.emit_bytes(alloc, "__vdso_clock_gettime".as_bytes());
    try b.emit_u8(alloc, 0_u8);
    return;
}

