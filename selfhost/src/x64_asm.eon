    pub fn vextractf128(
        self: *mut Self,
        alloc: *mut AllocCap,
        dst: Xmm,
        src: Xmm,
        imm8: u8,
    ) -> !OutOfMemory {
        try self.emit_vex3(alloc, src.hi(), false, dst.hi(), VEX_MAP_0F3A, false, 0_u8, true, VEX_PP_66);
        try self.emit_u8(alloc, 0x19_u8);
        try self.emit_u8(alloc, modrm_byte(3_u8, src.low(), dst.low()));
        try self.emit_u8(alloc, imm8);
        return;
    }

