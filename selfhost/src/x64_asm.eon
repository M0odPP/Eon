    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 1_u64);
    try b.mov_rr(alloc, .R8, .R13);
    try b.mov_ri64(alloc, .R9, 0x08000000_u64);
    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.syscall(alloc);
    try b.mov_ri64(alloc, .Rcx, U64_NEG4096);
