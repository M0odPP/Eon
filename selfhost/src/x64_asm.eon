    pub fn rep_stosq(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.emit_u8(alloc, 0xF3_u8);
        try self.emit_u8(alloc, 0x48_u8);
        try self.emit_u8(alloc, 0xAB_u8);
        return;
    }

    // --- Bit manipulation & byte-swap intrinsics ---

    fn emit_bit_cnt(
        self: *mut Self,
        alloc: *mut AllocCap,
        f3_prefix: bool,
        op2: u8,
        is_64: bool,
        dst: Reg,
        src: Reg,
    ) -> !OutOfMemory {
        if f3_prefix {
            try self.emit_u8(alloc, 0xF3_u8);
        }
        try self.emit_rex(alloc, is_64, dst.hi(), false, src.hi(), is_64);
        try self.emit_u8(alloc, 0x0F_u8);
        try self.emit_u8(alloc, op2);
        try self.emit_u8(alloc, modrm_byte(3_u8, dst.low(), src.low()));
        return;
    }

    pub fn popcnt(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_64: bool,
        dst: Reg,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_bit_cnt(alloc, true, 0xB8_u8, is_64, dst, src);
        return;
    }

    pub fn lzcnt(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_64: bool,
        dst: Reg,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_bit_cnt(alloc, true, 0xBD_u8, is_64, dst, src);
        return;
    }

    pub fn tzcnt(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_64: bool,
        dst: Reg,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_bit_cnt(alloc, true, 0xBC_u8, is_64, dst, src);
        return;
    }

    pub fn bsf(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_64: bool,
        dst: Reg,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_bit_cnt(alloc, false, 0xBC_u8, is_64, dst, src);
        return;
    }

    pub fn bsr(
        self: *mut Self,
        alloc: *mut AllocCap,
        is_64: bool,
        dst: Reg,
        src: Reg,
    ) -> !OutOfMemory {
        try self.emit_bit_cnt(alloc, false, 0xBD_u8, is_64, dst, src);
        return;
    }

    pub fn bswap(self: *mut Self, alloc: *mut AllocCap, bytes: usize, r: Reg) -> !OutOfMemory {
        if bytes == 8_usize {
            try self.emit_rex(alloc, true, false, false, r.hi(), true);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xC8_u8 +% r.low());
        } else if bytes == 4_usize {
            try self.emit_rex(alloc, false, false, false, r.hi(), false);
            try self.emit_u8(alloc, 0x0F_u8);
            try self.emit_u8(alloc, 0xC8_u8 +% r.low());
        } else if bytes == 2_usize {
            try self.emit_u8(alloc, 0x66_u8);
            try self.emit_rex(alloc, false, false, false, r.hi(), false);
            try self.emit_u8(alloc, 0xC1_u8);
            try self.emit_u8(alloc, modrm_byte(3_u8, 0_u8, r.low()));
            try self.emit_u8(alloc, 0x08_u8);
        }
        return;
    }

    // --- Memory compare & atomic instructions ---

    pub fn cmp_mi32(
        self: *mut Self,
        alloc: *mut AllocCap,
        base: Reg,
        disp: i32,
        imm: i32,
        bytes: usize,
    ) -> !OutOfMemory {
        if bytes == 1_usize {
            try self.emit_rex(alloc, false, false, false, base.hi(), false);
            try self.emit_u8(alloc, 0x80_u8);
            try self.emit_mem(alloc, 7_u8, base, disp);
            try self.emit_u8(alloc, imm.bitcast.[u32]().trunc.[u8]());
            return;
        }
        if bytes == 2_usize {
            try self.emit_u8(alloc, 0x66_u8);
        }
        let is_64 = bytes == 8_usize;
        try self.emit_rex(alloc, is_64, false, false, base.hi(), is_64);
        if imm >= -128_i32 && imm <= 127_i32 {
            try self.emit_u8(alloc, 0x83_u8);
            try self.emit_mem(alloc, 7_u8, base, disp);
            try self.emit_u8(alloc, imm.bitcast.[u32]().trunc.[u8]());
        } else {
            try self.emit_u8(alloc, 0x81_u8);
            try self.emit_mem(alloc, 7_u8, base, disp);
            if bytes == 2_usize {
                try self.emit_i16(alloc, imm.trunc.[i16]());
            } else {
                try self.emit_i32(alloc, imm);
            }
        }
        return;
    }

    fn emit_rm_mem(
        self: *mut Self,
        alloc: *mut AllocCap,
        lock: bool,
        op_2b: u8,
        op8: u8,
        op_wide: u8,
        base: Reg,
        disp: i32,
        reg: Reg,
        bytes: usize,
    ) -> !OutOfMemory {
        if lock {
            try self.emit_u8(alloc, 0xF0_u8);
        }
        if bytes == 8_usize {
            try self.emit_rex(alloc, true, reg.hi(), false, base.hi(), true);
            if op_2b != 0_u8 { try self.emit_u8(alloc, op_2b); }
            try self.emit_u8(alloc, op_wide);
            try self.emit_mem(alloc, reg.low(), base, disp);
        } else if bytes == 4_usize {
            try self.emit_rex(alloc, false, reg.hi(), false, base.hi(), false);
            if op_2b != 0_u8 { try self.emit_u8(alloc, op_2b); }
            try self.emit_u8(alloc, op_wide);
            try self.emit_mem(alloc, reg.low(), base, disp);
        } else if bytes == 2_usize {
            try self.emit_u8(alloc, 0x66_u8);
            try self.emit_rex(alloc, false, reg.hi(), false, base.hi(), false);
            if op_2b != 0_u8 { try self.emit_u8(alloc, op_2b); }
            try self.emit_u8(alloc, op_wide);
            try self.emit_mem(alloc, reg.low(), base, disp);
        } else {
            let need_rex = reg.id() >= 4_u8 || base.hi();
            try self.emit_rex(alloc, false, reg.hi(), false, base.hi(), need_rex);
            if op_2b != 0_u8 { try self.emit_u8(alloc, op_2b); }
            try self.emit_u8(alloc, op8);
            try self.emit_mem(alloc, reg.low(), base, disp);
        }
        return;
    }

    pub fn lock_xadd_disp(
        self: *mut Self,
        alloc: *mut AllocCap,
        ptr: Reg,
        disp: i32,
        val: Reg,
        bytes: usize,
    ) -> !OutOfMemory {
        try self.emit_rm_mem(alloc, true, 0x0F_u8, 0xC0_u8, 0xC1_u8, ptr, disp, val, bytes);
        return;
    }

    pub fn lock_xadd(
        self: *mut Self,
        alloc: *mut AllocCap,
        ptr: Reg,
        val: Reg,
        bytes: usize,
    ) -> !OutOfMemory {
        try self.lock_xadd_disp(alloc, ptr, 0_i32, val, bytes);
        return;
    }

    pub fn lock_cmpxchg_disp(
        self: *mut Self,
        alloc: *mut AllocCap,
        ptr: Reg,
        disp: i32,
        desired: Reg,
        bytes: usize,
    ) -> !OutOfMemory {
        try self.emit_rm_mem(alloc, true, 0x0F_u8, 0xB0_u8, 0xB1_u8, ptr, disp, desired, bytes);
        return;
    }

    pub fn lock_cmpxchg(
        self: *mut Self,
        alloc: *mut AllocCap,
        ptr: Reg,
        desired: Reg,
