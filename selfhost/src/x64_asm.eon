    try b.cvtss2sd(alloc, .Xmm0, .Xmm0);
    try b.mov_ri64(alloc, .Rax, 0x4059000000000000_u64);
    try b.movq_xmm_r64(alloc, .Xmm1, .Rax);
    try b.sse_bin(alloc, true, 0x59_u8, .Xmm0, .Xmm1);
    try b.mov_ri64(alloc, .Rax, 0x3FE0000000000000_u64);
    try b.movq_xmm_r64(alloc, .Xmm1, .Rax);
    try b.mov_ri64(alloc, .Rax, 0_u64);
    try b.movq_xmm_r64(alloc, .Xmm2, .Rax);
    try b.ucomi(alloc, true, .Xmm0, .Xmm2);
    let l_neg = try b.new_label(alloc);
    let l_cvt = try b.new_label(alloc);
    try b.jcc_label(alloc, .B, l_neg);
    try b.sse_bin(alloc, true, 0x58_u8, .Xmm0, .Xmm1);
    try b.jmp_label(alloc, l_cvt);
    b.bind_label(l_neg);
    try b.sse_bin(alloc, true, 0x5C_u8, .Xmm0, .Xmm1);
    b.bind_label(l_cvt);
    try b.cvttf2si(alloc, true, .Rax, .Xmm0);

    try b.xor_rr32(alloc, .R8, .R8);
    let l_pos = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .Rax, 0_i32);
    try b.jcc_label(alloc, .Ge, l_pos);
    try b.mov_ri64(alloc, .R8, 1_u64);
    try b.neg_r(alloc, .Rax);
    b.bind_label(l_pos);

    try b.lea_mem(alloc, .Rsi, .Rsp, 32_i32);
    try b.mov_ri64(alloc, .Rcx, 10_u64);
    var d: usize = 0_usize;
    while d < 2_usize {
        try b.xor_rr32(alloc, .Rdx, .Rdx);
        try b.div_r(alloc, .Rcx);
        try b.add_ri32(alloc, .Rdx, 48_i32);
        try b.sub_ri32(alloc, .Rsi, 1_i32);
        try b.store_mem(alloc, .Rsi, 0_i32, .Rdx, 1_usize);
        d = d +% 1_usize;
    }
    try b.sub_ri32(alloc, .Rsi, 1_i32);
    try b.mov_ri64(alloc, .Rdx, 46_u64);
    try b.store_mem(alloc, .Rsi, 0_i32, .Rdx, 1_usize);

    let l_loop = try b.new_label(alloc);
    b.bind_label(l_loop);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    try b.div_r(alloc, .Rcx);
    try b.add_ri32(alloc, .Rdx, 48_i32);
    try b.sub_ri32(alloc, .Rsi, 1_i32);
    try b.store_mem(alloc, .Rsi, 0_i32, .Rdx, 1_usize);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.jcc_label(alloc, .Ne, l_loop);

    let l_write = try b.new_label(alloc);
    try b.test_rr(alloc, .R8, .R8);
    try b.jcc_label(alloc, .E, l_write);
    try b.sub_ri32(alloc, .Rsi, 1_i32);
    try b.mov_ri64(alloc, .Rdx, 45_u64);
    try b.store_mem(alloc, .Rsi, 0_i32, .Rdx, 1_usize);

    b.bind_label(l_write);
    try b.lea_mem(alloc, .Rdx, .Rsp, 32_i32);
    try b.sub_rr(alloc, .Rdx, .Rsi);
    try b.mov_ri64(alloc, .Rdi, 1_u64);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.syscall(alloc);
    try b.add_ri32(alloc, .Rsp, 40_i32);
    try b.ret(alloc);
    return;
}

fn emit_rt_f16_to_f32(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    try b.mov_rr(alloc, .Rdx, .Rdi);
    try b.shr_imm(alloc, .Rdx, 15_u8);
    try b.and_ri32(alloc, .Rdx, 1_i32);
    try b.shl_imm(alloc, .Rdx, 31_u8);
    try b.mov_rr(alloc, .Rcx, .Rdi);
    try b.shr_imm(alloc, .Rcx, 10_u8);
    try b.and_ri32(alloc, .Rcx, 0x1F_i32);
    try b.mov_rr(alloc, .Rax, .Rdi);
    try b.and_ri32(alloc, .Rax, 0x03FF_i32);

    let l_exp_nonzero = try b.new_label(alloc);
    let l_subnormal = try b.new_label(alloc);
    let l_sub_loop = try b.new_label(alloc);
    let l_exp_inf = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);

    try b.test_rr(alloc, .Rcx, .Rcx);
    try b.jcc_label(alloc, .Ne, l_exp_nonzero);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.jcc_label(alloc, .Ne, l_subnormal);
    try b.mov_rr(alloc, .Rax, .Rdx);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_subnormal);
    try b.mov_ri64(alloc, .Rsi, 113_u64);
    b.bind_label(l_sub_loop);
    try b.mov_rr(alloc, .Rdi, .Rax);
    try b.and_ri32(alloc, .Rdi, 0x0400_i32);
    let l_sub_done = try b.new_label(alloc);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .Ne, l_sub_done);
    try b.shl_imm(alloc, .Rax, 1_u8);
    try b.sub_ri32(alloc, .Rsi, 1_i32);
    try b.jmp_label(alloc, l_sub_loop);
    b.bind_label(l_sub_done);
    try b.and_ri32(alloc, .Rax, 0x03FF_i32);
    try b.shl_imm(alloc, .Rax, 13_u8);
    try b.shl_imm(alloc, .Rsi, 23_u8);
    try b.or_rr(alloc, .Rax, .Rsi);
    try b.or_rr(alloc, .Rax, .Rdx);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_exp_nonzero);
    try b.cmp_ri32(alloc, .Rcx, 31_i32);
    try b.jcc_label(alloc, .E, l_exp_inf);
    try b.add_ri32(alloc, .Rcx, 112_i32);
    try b.shl_imm(alloc, .Rcx, 23_u8);
    try b.shl_imm(alloc, .Rax, 13_u8);
    try b.or_rr(alloc, .Rax, .Rcx);
    try b.or_rr(alloc, .Rax, .Rdx);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_exp_inf);
    try b.shl_imm(alloc, .Rax, 13_u8);
    try b.mov_ri64(alloc, .Rcx, 0x7F800000_u64);
    try b.or_rr(alloc, .Rax, .Rcx);
    try b.or_rr(alloc, .Rax, .Rdx);

    b.bind_label(l_done);
    try b.movd_xmm_r32(alloc, .Xmm0, .Rax);
    try b.ret(alloc);
    return;
}

fn emit_f32_to_f16_subnormal(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    try b.or_ri32(alloc, .Rsi, 0x00800000_i32);
    try b.neg_r(alloc, .Rcx);
    try b.sub_ri32(alloc, .Rcx, 1_i32);
    try b.mov_rr(alloc, .Rax, .Rsi);
    try b.shr_cl(alloc, .Rax);
    try b.mov_ri64(alloc, .R8, 1_u64);
    try b.shl_cl(alloc, .R8);
    try b.mov_rr(alloc, .R9, .R8);
    try b.shr_imm(alloc, .R9, 1_u8);
    try b.sub_ri32(alloc, .R8, 1_i32);
    try b.and_rr(alloc, .Rsi, .R8);
    let l_sub_no_round = try b.new_label(alloc);
    let l_sub_round = try b.new_label(alloc);
    try b.cmp_rr(alloc, .Rsi, .R9);
    try b.jcc_label(alloc, .A, l_sub_round);
    try b.jcc_label(alloc, .B, l_sub_no_round);
    try b.mov_rr(alloc, .Rdi, .Rax);
    try b.and_ri32(alloc, .Rdi, 1_i32);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .E, l_sub_no_round);
    b.bind_label(l_sub_round);
    try b.add_ri32(alloc, .Rax, 1_i32);
    b.bind_label(l_sub_no_round);
    try b.or_rr(alloc, .Rax, .Rdx);
    try b.and_ri32(alloc, .Rax, 0xFFFF_i32);
    try b.ret(alloc);
    return;
}

fn emit_rt_f32_to_f16(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    try b.movd_r32_xmm(alloc, .Rdi, .Xmm0);
    try b.mov_rr(alloc, .Rdx, .Rdi);
    try b.shr_imm(alloc, .Rdx, 16_u8);
    try b.and_ri32(alloc, .Rdx, 0x8000_i32);
    try b.mov_rr(alloc, .Rcx, .Rdi);
    try b.shr_imm(alloc, .Rcx, 23_u8);
    try b.and_ri32(alloc, .Rcx, 0xFF_i32);
    try b.mov_rr(alloc, .Rsi, .Rdi);
    try b.and_ri32(alloc, .Rsi, 0x007FFFFF_i32);

    let l_not_inf = try b.new_label(alloc);
    let l_inf_zero_frac = try b.new_label(alloc);
    let l_ovf = try b.new_label(alloc);
    let l_und = try b.new_label(alloc);
    let l_sub = try b.new_label(alloc);
    let l_norm_no_round = try b.new_label(alloc);
    let l_norm_round = try b.new_label(alloc);

    try b.cmp_ri32(alloc, .Rcx, 0xFF_i32);
    try b.jcc_label(alloc, .Ne, l_not_inf);
    try b.mov_rr(alloc, .Rax, .Rdx);
    try b.or_ri32(alloc, .Rax, 0x7C00_i32);
    try b.test_rr(alloc, .Rsi, .Rsi);
    try b.jcc_label(alloc, .E, l_inf_zero_frac);
    try b.shr_imm(alloc, .Rsi, 13_u8);
    let l_nan_nz = try b.new_label(alloc);
    try b.test_rr(alloc, .Rsi, .Rsi);
    try b.jcc_label(alloc, .Ne, l_nan_nz);
    try b.mov_ri64(alloc, .Rsi, 1_u64);
    b.bind_label(l_nan_nz);
    try b.or_rr(alloc, .Rax, .Rsi);
    b.bind_label(l_inf_zero_frac);
    try b.ret(alloc);

    b.bind_label(l_not_inf);
    try b.sub_ri32(alloc, .Rcx, 127_i32);
    try b.cmp_ri32(alloc, .Rcx, 15_i32);
    try b.jcc_label(alloc, .G, l_ovf);
    try b.cmp_ri32(alloc, .Rcx, -24_i32);
    try b.jcc_label(alloc, .L, l_und);
    try b.cmp_ri32(alloc, .Rcx, -14_i32);
    try b.jcc_label(alloc, .L, l_sub);

    try b.add_ri32(alloc, .Rcx, 15_i32);
    try b.shl_imm(alloc, .Rcx, 10_u8);
    try b.mov_rr(alloc, .Rax, .Rsi);
    try b.shr_imm(alloc, .Rax, 13_u8);
    try b.and_ri32(alloc, .Rsi, 0x1FFF_i32);
    try b.cmp_ri32(alloc, .Rsi, 0x1000_i32);
    try b.jcc_label(alloc, .G, l_norm_round);
    try b.jcc_label(alloc, .L, l_norm_no_round);
    try b.mov_rr(alloc, .Rdi, .Rax);
    try b.and_ri32(alloc, .Rdi, 1_i32);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .E, l_norm_no_round);
    b.bind_label(l_norm_round);
    try b.add_ri32(alloc, .Rax, 1_i32);
    b.bind_label(l_norm_no_round);
    try b.add_rr(alloc, .Rax, .Rcx);
    try b.or_rr(alloc, .Rax, .Rdx);
    try b.and_ri32(alloc, .Rax, 0xFFFF_i32);
    try b.ret(alloc);

    b.bind_label(l_sub);
    try emit_f32_to_f16_subnormal(alloc, b);

    b.bind_label(l_ovf);
    try b.mov_rr(alloc, .Rax, .Rdx);
    try b.or_ri32(alloc, .Rax, 0x7C00_i32);
    try b.ret(alloc);

    b.bind_label(l_und);
    try b.mov_rr(alloc, .Rax, .Rdx);
    try b.ret(alloc);
    return;
}

// ============================================================================
// Runtime Helpers Part 3: Multi-Core Scheduler, DAG, Static Fibers & io_uring
// ============================================================================

fn emit_par_for_work_loop(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    sched_reg: Reg,
) -> !OutOfMemory {
    let l_loop = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    let l_no_ovf = try b.new_label(alloc);
    try b.load_mem(alloc, .R14, sched_reg, SCHED_OFF_TASK_FN, 8_usize, false);
    try b.load_mem(alloc, .R15, sched_reg, SCHED_OFF_TASK_CTX, 8_usize, false);

    b.bind_label(l_loop);
    try b.load_mem(alloc, .Rax, sched_reg, SCHED_OFF_TASK_CHUNK, 8_usize, false);
    try b.lock_xadd_disp(alloc, sched_reg, SCHED_OFF_TASK_NEXT, .Rax, 8_usize);
    try b.load_mem(alloc, .Rdx, sched_reg, SCHED_OFF_TASK_TOTAL, 8_usize, false);
    try b.cmp_rr(alloc, .Rax, .Rdx);
    try b.jcc_label(alloc, .Ae, l_done);

    try b.mov_rr(alloc, .Rsi, .Rax);
    try b.load_mem(alloc, .Rcx, sched_reg, SCHED_OFF_TASK_CHUNK, 8_usize, false);
    try b.add_rr(alloc, .Rsi, .Rcx);
    try b.jcc_label(alloc, .Ae, l_no_ovf);
    try b.mov_rr(alloc, .Rsi, .Rdx);
    b.bind_label(l_no_ovf);
    try b.cmp_rr(alloc, .Rsi, .Rdx);
    try b.cmovcc(alloc, .A, .Rsi, .Rdx);

    try b.mov_rr(alloc, .Rdi, .Rax);
    try b.load_mem(alloc, .Rdx, sched_reg, SCHED_OFF_TASK_CTX, 8_usize, false);
    try b.call_reg(alloc, .R14);
    try b.jmp_label(alloc, l_loop);

    b.bind_label(l_done);
    return;
}

fn emit_dag_work_loop(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    sched_reg: Reg,
) -> !OutOfMemory {
    let l_outer = try b.new_label(alloc);
    let l_scan = try b.new_label(alloc);
    let l_next_i = try b.new_label(alloc);
    let l_pause = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);

    try b.push(alloc, .R13);
    try b.push(alloc, .Rbx);
    try b.load_mem(alloc, .R13, sched_reg, SCHED_OFF_DAG_NODES, 8_usize, false);
    try b.load_mem(alloc, .R14, sched_reg, SCHED_OFF_DAG_RT, 8_usize, false);
    try b.load_mem(alloc, .R15, sched_reg, SCHED_OFF_DAG_COUNT, 8_usize, false);

    b.bind_label(l_outer);
    try b.load_mem(alloc, .Rax, sched_reg, SCHED_OFF_TASK_DONE, 8_usize, false);
    try b.cmp_rr(alloc, .Rax, .R15);
    try b.jcc_label(alloc, .Ae, l_done);

    try b.xor_rr32(alloc, .Rbx, .Rbx);
    b.bind_label(l_scan);
    try b.cmp_rr(alloc, .Rbx, .R15);
    try b.jcc_label(alloc, .Ae, l_pause);

    try b.mov_rr(alloc, .R8, .Rbx);
    try b.shl_imm(alloc, .R8, 4_u8);
    try b.add_rr(alloc, .R8, .R14);
    try b.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.jcc_label(alloc, .Ne, l_next_i);
    try b.load_mem(alloc, .Rax, .R8, 8_i32, 8_usize, false);
    try b.test_rr(alloc, .Rax, .Rax);
    try b.jcc_label(alloc, .Ne, l_next_i);

    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.mov_ri64(alloc, .Rcx, 1_u64);
    try b.lock_cmpxchg_disp(alloc, .R8, 8_i32, .Rcx, 8_usize);
    try b.jcc_label(alloc, .Ne, l_next_i);

    try b.mov_rr(alloc, .R9, .Rbx);
    try b.shl_imm(alloc, .R9, 5_u8);
    try b.add_rr(alloc, .R9, .R13);
    try b.load_mem(alloc, .Rax, .R9, 0_i32, 8_usize, false);
    try b.load_mem(alloc, .Rdi, .R9, 8_i32, 8_usize, false);
    let l_have_arg = try b.new_label(alloc);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .Ne, l_have_arg);
    try b.load_mem(alloc, .Rdi, sched_reg, SCHED_OFF_TASK_CTX, 8_usize, false);
    b.bind_label(l_have_arg);
    try b.call_reg(alloc, .Rax);
    try b.load_mem(alloc, .R15, sched_reg, SCHED_OFF_DAG_COUNT, 8_usize, false);

    try b.mov_rr(alloc, .R9, .Rbx);
    try b.shl_imm(alloc, .R9, 5_u8);
    try b.add_rr(alloc, .R9, .R13);
    try b.load_mem(alloc, .Rcx, .R9, 20_i32, 4_usize, false);
    let l_mark_done = try b.new_label(alloc);
    try b.test_rr(alloc, .Rcx, .Rcx);
    try b.jcc_label(alloc, .E, l_mark_done);
    try b.load_mem(alloc, .Rsi, .R9, 24_i32, 8_usize, false);
    let l_succ_lp = try b.new_label(alloc);
    b.bind_label(l_succ_lp);
    try b.load_mem(alloc, .Rdx, .Rsi, 0_i32, 4_usize, false);
    try b.shl_imm(alloc, .Rdx, 4_u8);
    try b.add_rr(alloc, .Rdx, .R14);
    try b.mov_ri64(alloc, .Rax, U64_NEG1);
    try b.lock_xadd_disp(alloc, .Rdx, 0_i32, .Rax, 8_usize);
    try b.add_ri32(alloc, .Rsi, 4_i32);
    try b.sub_ri32(alloc, .Rcx, 1_i32);
    try b.jcc_label(alloc, .Ne, l_succ_lp);

    b.bind_label(l_mark_done);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.lock_xadd_disp(alloc, sched_reg, SCHED_OFF_TASK_DONE, .Rax, 8_usize);
    try b.jmp_label(alloc, l_outer);

    b.bind_label(l_next_i);
    try b.add_ri32(alloc, .Rbx, 1_i32);
    try b.jmp_label(alloc, l_scan);

    b.bind_label(l_pause);
    try b.pause(alloc);
    try b.jmp_label(alloc, l_outer);

    b.bind_label(l_done);
    try b.pop(alloc, .Rbx);
    try b.pop(alloc, .R13);
    return;
}

fn emit_sched_detect_cpus(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
) -> !OutOfMemory {
    let s_mask = try interner.intern_str(alloc, "__eon_cpu_affinity_mask");
    try b.lea_rip_sym(alloc, .R13, s_mask, 0_i64);
    try b.mov_ri64(alloc, .Rax, 204_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rsi, 128_u64);
    try b.mov_rr(alloc, .Rdx, .R13);
    try b.syscall(alloc);

    try b.xor_rr32(alloc, .R14, .R14);
    let l_cpu_fallback = try b.new_label(alloc);
    let l_cpus_ready = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .Rax, 0_i32);
    try b.jcc_label(alloc, .Le, l_cpu_fallback);

    try b.xor_rr32(alloc, .Rcx, .Rcx);
    let l_cpu_scan = try b.new_label(alloc);
    let l_cpu_next = try b.new_label(alloc);
    b.bind_label(l_cpu_scan);
    try b.cmp_ri32(alloc, .Rcx, 1024_i32);
    try b.jcc_label(alloc, .Ae, l_cpus_ready);
    try b.cmp_ri32(alloc, .R14, SCHED_MAX_WORKERS_I32);
    try b.jcc_label(alloc, .Ae, l_cpus_ready);
    try b.mov_rr(alloc, .Rax, .Rcx);
    try b.shr_imm(alloc, .Rax, 6_u8);
    try b.shl_imm(alloc, .Rax, 3_u8);
    try b.add_rr(alloc, .Rax, .R13);
    try b.load_mem(alloc, .Rdx, .Rax, 0_i32, 8_usize, false);
    try b.mov_rr(alloc, .R8, .Rcx);
    try b.and_ri32(alloc, .R8, 63_i32);
    try b.mov_rr(alloc, .R9, .Rcx);
    try b.mov_rr(alloc, .Rcx, .R8);
    try b.shr_cl(alloc, .Rdx);
    try b.mov_rr(alloc, .Rcx, .R9);
    try b.and_ri32(alloc, .Rdx, 1_i32);
    try b.jcc_label(alloc, .E, l_cpu_next);
    try b.mov_rr(alloc, .Rax, .R14);
    try b.shl_imm(alloc, .Rax, 3_u8);
    try b.lea_mem(alloc, .R8, .R12, SCHED_OFF_ONLINE_CPUS);
    try b.add_rr(alloc, .R8, .Rax);
    try b.store_mem(alloc, .R8, 0_i32, .Rcx, 8_usize);
    try b.add_ri32(alloc, .R14, 1_i32);
    b.bind_label(l_cpu_next);
    try b.add_ri32(alloc, .Rcx, 1_i32);
    try b.jmp_label(alloc, l_cpu_scan);

    b.bind_label(l_cpus_ready);
    try b.test_rr(alloc, .R14, .R14);
    let l_spawn_start = try b.new_label(alloc);
    try b.jcc_label(alloc, .Ne, l_spawn_start);
    b.bind_label(l_cpu_fallback);
    try b.mov_ri64(alloc, .R14, 1_u64);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .R12, SCHED_OFF_ONLINE_CPUS, .Rax, 8_usize);
    b.bind_label(l_spawn_start);
    return;
}

fn emit_sched_spawn_workers(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    l_worker_entry: u32,
) -> !OutOfMemory {
    try b.xor_rr32(alloc, .Rbx, .Rbx);
    let l_spawn_lp = try b.new_label(alloc);
    let l_spawn_done = try b.new_label(alloc);
    b.bind_label(l_spawn_lp);
    try b.cmp_rr(alloc, .Rbx, .R14);
    try b.jcc_label(alloc, .Ae, l_spawn_done);

    try b.mov_rr(alloc, .R15, .Rbx);
    try b.shl_imm(alloc, .R15, 8_u8);
    try b.lea_mem(alloc, .R8, .R12, SCHED_OFF_WORKER_TCBS);
    try b.add_rr(alloc, .R15, .R8);
    try b.store_mem(alloc, .R15, 0_i32, .R15, 8_usize);
    try b.store_mem(alloc, .R15, 8_i32, .Rbx, 8_usize);
    try b.mov_rr(alloc, .Rax, .Rbx);
    try b.shl_imm(alloc, .Rax, 3_u8);
    try b.lea_mem(alloc, .R8, .R12, SCHED_OFF_ONLINE_CPUS);
    try b.add_rr(alloc, .R8, .Rax);
    try b.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
    try b.store_mem(alloc, .R15, 80_i32, .Rax, 8_usize);

    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rsi, WORKER_STACK_BYTES);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 0x22_u64);
    try b.mov_ri64(alloc, .R8, U64_NEG1);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.syscall(alloc);
    try b.mov_ri64(alloc, .Rcx, U64_NEG4096);
    try b.cmp_rr(alloc, .Rax, .Rcx);
    try b.jcc_label(alloc, .Ae, l_spawn_done);

    try b.store_mem(alloc, .R15, 88_i32, .Rax, 8_usize);
    // Guard page at bottom of worker stack: mprotect(base, 4096, PROT_NONE).
    try b.mov_rr(alloc, .Rdi, .Rax);
    try b.mov_ri64(alloc, .Rsi, 4096_u64);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    try b.mov_ri64(alloc, .Rax, 10_u64);
    try b.syscall(alloc);
    try b.load_mem(alloc, .Rax, .R15, 88_i32, 8_usize, false);
    try b.mov_ri64(alloc, .Rcx, WORKER_STACK_BYTES -% 16_u64);
    try b.add_rr(alloc, .Rax, .Rcx);

    try b.mov_ri64(alloc, .Rcx, 1_u64);
    try b.lock_xadd_disp(alloc, .R12, SCHED_OFF_ACTIVE_WORKERS, .Rcx, 8_usize);

    try b.mov_ri64(alloc, .Rdi, CLONE_WORKER_FLAGS);
    try b.mov_rr(alloc, .Rsi, .Rax);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    try b.xor_rr32(alloc, .R10, .R10);
    try b.mov_rr(alloc, .R8, .R15);
    try b.mov_ri64(alloc, .Rax, 56_u64);
    try b.syscall(alloc);

    try b.test_rr(alloc, .Rax, .Rax);
    try b.jcc_label(alloc, .E, l_worker_entry);
    let l_clone_ok = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .Rax, 0_i32);
    try b.jcc_label(alloc, .G, l_clone_ok);
    try b.mov_ri64(alloc, .Rcx, U64_NEG1);
    try b.lock_xadd_disp(alloc, .R12, SCHED_OFF_ACTIVE_WORKERS, .Rcx, 8_usize);
    try b.jmp_label(alloc, l_spawn_done);

    b.bind_label(l_clone_ok);
    try b.add_ri32(alloc, .Rbx, 1_i32);
    try b.jmp_label(alloc, l_spawn_lp);

    b.bind_label(l_spawn_done);
    try b.store_mem(alloc, .R12, SCHED_OFF_NUM_WORKERS, .Rbx, 8_usize);
    try b.mov_ri64(alloc, .Rax, 2_u64);
    try b.xchg_mem_disp(alloc, .R12, SCHED_OFF_INIT, .Rax, 8_usize);
    return;
}

fn emit_sched_worker_entry(
    alloc: *mut AllocCap,
    b: *mut X64Buf,
    interner: *mut span.SymInterner,
) -> !OutOfMemory {
    let s_sched = try interner.intern_str(alloc, "__eon_sched_state");
    // R15 carries this worker's TCB pointer from `emit_sched_spawn_workers`; bind %gs to it.
    try b.mov_rr(alloc, .Rbx, .R15);
    try b.mov_rr(alloc, .Rsi, .R15);
    try b.mov_ri64(alloc, .Rdi, 0x1001_u64); // ARCH_SET_GS
    try b.mov_ri64(alloc, .Rax, 158_u64);    // SYS_arch_prctl
    try b.syscall(alloc);
    try b.sub_ri32(alloc, .Rsp, 128_i32);
    try b.mov_rr(alloc, .Rdi, .Rsp);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.mov_ri64(alloc, .Rcx, 16_u64);
    try b.rep_stosq(alloc);
    try b.load_mem(alloc, .Rcx, .Rbx, 80_i32, 8_usize, false);
    try b.and_ri32(alloc, .Rcx, 1023_i32);
    try b.mov_rr(alloc, .Rax, .Rcx);
    try b.shr_imm(alloc, .Rax, 6_u8);
    try b.shl_imm(alloc, .Rax, 3_u8);
    try b.add_rr(alloc, .Rax, .Rsp);
    try b.and_ri32(alloc, .Rcx, 63_i32);
    try b.mov_ri64(alloc, .Rdx, 1_u64);
    try b.shl_cl(alloc, .Rdx);
    try b.store_mem(alloc, .Rax, 0_i32, .Rdx, 8_usize);
    try b.mov_ri64(alloc, .Rax, 203_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rsi, 128_u64);
    try b.mov_rr(alloc, .Rdx, .Rsp);
    try b.syscall(alloc);
    try b.add_ri32(alloc, .Rsp, 128_i32);

    try b.lea_rip_sym(alloc, .R12, s_sched, 0_i64);
    try b.xor_rr32(alloc, .R13, .R13);

    let l_wloop = try b.new_label(alloc);
    let l_wexit = try b.new_label(alloc);
    let l_w_skip = try b.new_label(alloc);
    let l_w_dag = try b.new_label(alloc);
    let l_w_leave = try b.new_label(alloc);
    let l_w_work = try b.new_label(alloc);

    b.bind_label(l_wloop);
    try b.cmp_mi32(alloc, .R12, SCHED_OFF_SHUTDOWN, 0_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_wexit);

    try b.load_mem(alloc, .Rax, .R12, SCHED_OFF_WORK_GEN, 4_usize, false);
    try b.cmp_rr(alloc, .Rax, .R13);
    try b.jcc_label(alloc, .Ne, l_w_work);

    // Brief adaptive spin (~4000 pauses) before kernel futex_wait so back-to-back
    // par_for / par_reduce waves wake in ~50 ns with zero futex syscalls!
    let l_spin = try b.new_label(alloc);
    try b.mov_ri64(alloc, .Rcx, 4000_u64);
    b.bind_label(l_spin);
    try b.pause(alloc);
    try b.load_mem(alloc, .Rax, .R12, SCHED_OFF_WORK_GEN, 4_usize, false);
    try b.cmp_rr(alloc, .Rax, .R13);
    try b.jcc_label(alloc, .Ne, l_w_work);
    try b.cmp_mi32(alloc, .R12, SCHED_OFF_SHUTDOWN, 0_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_wexit);
    try b.sub_ri32(alloc, .Rcx, 1_i32);
    try b.jcc_label(alloc, .Ne, l_spin);

    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.lock_xadd_disp(alloc, .R12, SCHED_OFF_SLEEPING, .Rax, 8_usize);
    try b.load_mem(alloc, .Rax, .R12, SCHED_OFF_WORK_GEN, 4_usize, false);
    let l_wake_dec = try b.new_label(alloc);
    try b.cmp_rr(alloc, .Rax, .R13);
    try b.jcc_label(alloc, .Ne, l_wake_dec);
    try b.cmp_mi32(alloc, .R12, SCHED_OFF_SHUTDOWN, 0_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_wake_dec);
    try b.lea_mem(alloc, .Rdi, .R12, SCHED_OFF_WORK_GEN);
    try b.mov_ri64(alloc, .Rsi, 128_u64);
    try b.mov_rr(alloc, .Rdx, .R13);
    try b.xor_rr32(alloc, .R10, .R10);
    try b.xor_rr32(alloc, .R8, .R8);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.mov_ri64(alloc, .Rax, 202_u64);
    try b.syscall(alloc);
    b.bind_label(l_wake_dec);
    try b.mov_ri64(alloc, .Rax, U64_NEG1);
    try b.lock_xadd_disp(alloc, .R12, SCHED_OFF_SLEEPING, .Rax, 8_usize);
    try b.jmp_label(alloc, l_wloop);

    b.bind_label(l_w_work);
    try b.mov_rr(alloc, .R13, .Rax);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.lock_xadd_disp(alloc, .R12, SCHED_OFF_IN_TASK, .Rax, 8_usize);
    try b.cmp_mi32(alloc, .R12, SCHED_OFF_SHUTDOWN, 0_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_w_skip);
    try b.cmp_mi32(alloc, .R12, SCHED_OFF_TASK_CLOSED, 0_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_w_skip);
    try b.load_mem(alloc, .Rax, .R12, SCHED_OFF_WORK_GEN, 4_usize, false);
    try b.cmp_rr(alloc, .Rax, .R13);
    try b.jcc_label(alloc, .Ne, l_w_skip);

    try b.load_mem(alloc, .Rax, .R12, SCHED_OFF_TASK_KIND, 8_usize, false);
    try b.cmp_ri32(alloc, .Rax, 2_i32);
    try b.jcc_label(alloc, .E, l_w_dag);
    try b.cmp_ri32(alloc, .Rax, 1_i32);
    try b.jcc_label(alloc, .Ne, l_w_leave);
    try emit_par_for_work_loop(alloc, b, .R12);
    try b.jmp_label(alloc, l_w_leave);

    b.bind_label(l_w_dag);
    try emit_dag_work_loop(alloc, b, .R12);

    b.bind_label(l_w_leave);
    try emit_flush_tcb_alloc_cap(alloc, interner, b);
    b.bind_label(l_w_skip);
    try b.mov_ri64(alloc, .Rax, U64_NEG1);
    try b.lock_xadd_disp(alloc, .R12, SCHED_OFF_IN_TASK, .Rax, 8_usize);
    try b.jmp_label(alloc, l_wloop);

    b.bind_label(l_wexit);
    try b.mov_ri64(alloc, .Rax, U64_NEG1);
    try b.lock_xadd_disp(alloc, .R12, SCHED_OFF_ACTIVE_WORKERS, .Rax, 8_usize);
    try b.mov_ri64(alloc, .Rax, 60_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.syscall(alloc);
    try b.ud2(alloc);
    return;
}

fn emit_rt_sched_init(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let s_sched = try interner.intern_str(alloc, "__eon_sched_state");
    let l_ret_fast = try b.new_label(alloc);
    let l_worker_entry = try b.new_label(alloc);

    try b.lea_rip_sym(alloc, .R8, s_sched, 0_i64);
    try b.cmp_mi32(alloc, .R8, SCHED_OFF_INIT, 2_i32, 8_usize);
    try b.jcc_label(alloc, .E, l_ret_fast);

    try b.push(alloc, .Rbx);
    try b.push(alloc, .R12);
    try b.push(alloc, .R13);
    try b.push(alloc, .R14);
    try b.push(alloc, .R15);

    try b.mov_rr(alloc, .R12, .R8);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.mov_ri64(alloc, .Rcx, 1_u64);
    try b.lock_cmpxchg_disp(alloc, .R12, SCHED_OFF_INIT, .Rcx, 8_usize);
    let l_do_init = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    try b.jcc_label(alloc, .E, l_do_init);

    let l_wait_ready = try b.new_label(alloc);
    b.bind_label(l_wait_ready);
    try b.pause(alloc);
    try b.cmp_mi32(alloc, .R12, SCHED_OFF_INIT, 2_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_wait_ready);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_do_init);
    try emit_load_tcb(alloc, b, interner, .Rax);
    try emit_sched_detect_cpus(alloc, b, interner);
    try emit_sched_spawn_workers(alloc, b, l_worker_entry);

    b.bind_label(l_done);
    try b.pop(alloc, .R15);
    try b.pop(alloc, .R14);
    try b.pop(alloc, .R13);
    try b.pop(alloc, .R12);
    try b.pop(alloc, .Rbx);
    b.bind_label(l_ret_fast);
    try b.ret(alloc);

    b.bind_label(l_worker_entry);
    try emit_sched_worker_entry(alloc, b, interner);
    return;
}

fn emit_rt_sched_shutdown(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let s_sched = try interner.intern_str(alloc, "__eon_sched_state");
    let l_done = try b.new_label(alloc);
    let l_wait = try b.new_label(alloc);

    try b.lea_rip_sym(alloc, .R8, s_sched, 0_i64);
    try b.cmp_mi32(alloc, .R8, SCHED_OFF_INIT, 2_i32, 8_usize);
    try b.jcc_label(alloc, .Ne, l_done);

    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.xchg_mem_disp(alloc, .R8, SCHED_OFF_SHUTDOWN, .Rax, 8_usize);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.lock_xadd_disp(alloc, .R8, SCHED_OFF_WORK_GEN, .Rax, 8_usize);

    try b.lea_mem(alloc, .Rdi, .R8, SCHED_OFF_WORK_GEN);
    try b.mov_ri64(alloc, .Rsi, 129_u64);
    try b.mov_ri64(alloc, .Rdx, 0x7FFFFFFF_u64);
    try b.xor_rr32(alloc, .R10, .R10);
    try b.xor_rr32(alloc, .R8, .R8);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.mov_ri64(alloc, .Rax, 202_u64);
    try b.syscall(alloc);

    try b.lea_rip_sym(alloc, .R8, s_sched, 0_i64);
    b.bind_label(l_wait);
    try b.cmp_mi32(alloc, .R8, SCHED_OFF_ACTIVE_WORKERS, 0_i32, 8_usize);
    try b.jcc_label(alloc, .E, l_done);
    try b.pause(alloc);
    try b.jmp_label(alloc, l_wait);

    b.bind_label(l_done);
    try b.ret(alloc);
    return;
}

fn emit_rt_par_for(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let s_init = try interner.intern_str(alloc, "eon_sched_init");
    let s_sched = try interner.intern_str(alloc, "__eon_sched_state");
    let l_ret_zero = try b.new_label(alloc);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .E, l_ret_zero);

    try b.push(alloc, .Rbx);
    try b.push(alloc, .R12);
    try b.push(alloc, .R13);
    try b.push(alloc, .R14);
    try b.push(alloc, .R15);

    try b.mov_rr(alloc, .Rbx, .Rdi);
    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.mov_rr(alloc, .R13, .Rsi);
    try b.test_rr(alloc, .R13, .R13);
    try b.cmovcc(alloc, .E, .R13, .Rax);
    try b.mov_rr(alloc, .R14, .Rdx);
    try b.mov_rr(alloc, .R15, .Rcx);

    let l_seq = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    try b.cmp_rr(alloc, .Rbx, .R13);
    try b.jcc_label(alloc, .Be, l_seq);

    try b.call_sym(alloc, s_init);
    try b.lea_rip_sym(alloc, .R12, s_sched, 0_i64);

    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.mov_ri64(alloc, .Rcx, 1_u64);
    try b.lock_cmpxchg_disp(alloc, .R12, SCHED_OFF_CALL_LOCK, .Rcx, 8_usize);
    try b.jcc_label(alloc, .Ne, l_seq);

    let s_tcb_pf = try interner.intern_str(alloc, "__eon_main_tcb");
    try b.lea_rip_sym(alloc, .Rax, s_tcb_pf, 0_i64);
    try b.store_imm64_sext_mem(alloc, .Rax, TCB_OFF_ST_FAST, 0_i32);

    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_KIND, .Rax, 8_usize);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_CTX, .R15, 8_usize);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_FN, .R14, 8_usize);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_TOTAL, .Rbx, 8_usize);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_CHUNK, .R13, 8_usize);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_NEXT, .Rax, 8_usize);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_DONE, .Rax, 8_usize);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_CLOSED, .Rax, 8_usize);

    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.lock_xadd_disp(alloc, .R12, SCHED_OFF_WORK_GEN, .Rax, 8_usize);

    let l_skip_wake = try b.new_label(alloc);
    try b.cmp_mi32(alloc, .R12, SCHED_OFF_SLEEPING, 0_i32, 8_usize);
    try b.jcc_label(alloc, .E, l_skip_wake);
    try b.lea_mem(alloc, .Rdi, .R12, SCHED_OFF_WORK_GEN);
    try b.mov_ri64(alloc, .Rsi, 129_u64);
    try b.mov_ri64(alloc, .Rdx, 0x7FFFFFFF_u64);
    try b.xor_rr32(alloc, .R10, .R10);
    try b.xor_rr32(alloc, .R8, .R8);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.mov_ri64(alloc, .Rax, 202_u64);
    try b.syscall(alloc);
    b.bind_label(l_skip_wake);

    try emit_par_for_work_loop(alloc, b, .R12);

    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.xchg_mem_disp(alloc, .R12, SCHED_OFF_TASK_CLOSED, .Rax, 8_usize);
    let l_drain = try b.new_label(alloc);
    let l_drained = try b.new_label(alloc);
    b.bind_label(l_drain);
    try b.cmp_mi32(alloc, .R12, SCHED_OFF_IN_TASK, 0_i32, 8_usize);
    try b.jcc_label(alloc, .E, l_drained);
    try b.pause(alloc);
    try b.jmp_label(alloc, l_drain);
    b.bind_label(l_drained);
    try emit_flush_tcb_alloc_cap(alloc, interner, b);
    try b.lea_rip_sym(alloc, .Rax, s_tcb_pf, 0_i64);
    try b.store_imm64_sext_mem(alloc, .Rax, TCB_OFF_ST_FAST, 1_i32);

    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.xchg_mem_disp(alloc, .R12, SCHED_OFF_CALL_LOCK, .Rax, 8_usize);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_seq);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_rr(alloc, .Rsi, .Rbx);
    try b.mov_rr(alloc, .Rdx, .R15);
    try b.call_reg(alloc, .R14);

    b.bind_label(l_done);
    try b.pop(alloc, .R15);
    try b.pop(alloc, .R14);
    try b.pop(alloc, .R13);
    try b.pop(alloc, .R12);
    try b.pop(alloc, .Rbx);
    b.bind_label(l_ret_zero);
    try b.ret(alloc);
    return;
}

fn emit_dag_prepare_rt(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    try b.xor_rr32(alloc, .Rbx, .Rbx);
    let l_use_inline = try b.new_label(alloc);
    let l_rt_ready = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .R14, SCHED_MAX_INLINE_DAG_I32);
    try b.jcc_label(alloc, .Be, l_use_inline);
    try b.mov_rr(alloc, .Rsi, .R14);
    try b.shl_imm(alloc, .Rsi, 4_u8);
    try b.add_ri32(alloc, .Rsi, 4095_i32);
    try b.and_ri32(alloc, .Rsi, -4096_i32);
    try b.mov_rr(alloc, .Rbx, .Rsi);
    try b.mov_ri64(alloc, .Rax, 9_u64);
    try b.xor_rr32(alloc, .Rdi, .Rdi);
    try b.mov_ri64(alloc, .Rdx, 3_u64);
    try b.mov_ri64(alloc, .R10, 0x22_u64);
    try b.mov_ri64(alloc, .R8, U64_NEG1);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.syscall(alloc);
    try b.jmp_label(alloc, l_rt_ready);

    b.bind_label(l_use_inline);
    try b.lea_mem(alloc, .Rax, .R12, SCHED_OFF_DAG_RT_INLINE);

    b.bind_label(l_rt_ready);
    try b.store_mem(alloc, .R12, SCHED_OFF_DAG_RT, .Rax, 8_usize);
    try b.xor_rr32(alloc, .Rcx, .Rcx);
    let l_init_rt = try b.new_label(alloc);
    let l_init_done = try b.new_label(alloc);
    b.bind_label(l_init_rt);
    try b.cmp_rr(alloc, .Rcx, .R14);
    try b.jcc_label(alloc, .Ae, l_init_done);
    try b.mov_rr(alloc, .R8, .Rcx);
    try b.shl_imm(alloc, .R8, 5_u8);
    try b.add_rr(alloc, .R8, .R13);
    try b.load_mem(alloc, .Rdx, .R8, 16_i32, 4_usize, false);
    try b.mov_rr(alloc, .R9, .Rcx);
    try b.shl_imm(alloc, .R9, 4_u8);
    try b.add_rr(alloc, .R9, .Rax);
    try b.store_mem(alloc, .R9, 0_i32, .Rdx, 8_usize);
    try b.xor_rr32(alloc, .Rdx, .Rdx);
    try b.store_mem(alloc, .R9, 8_i32, .Rdx, 8_usize);
    try b.add_ri32(alloc, .Rcx, 1_i32);
    try b.jmp_label(alloc, l_init_rt);
    b.bind_label(l_init_done);
    return;
}

fn emit_rt_sched_run_dag(
    alloc: *mut AllocCap,
    interner: *mut span.SymInterner,
    b: *mut X64Buf,
) -> !OutOfMemory {
    let s_init = try interner.intern_str(alloc, "eon_sched_init");
    let s_sched = try interner.intern_str(alloc, "__eon_sched_state");
    let l_ret_empty = try b.new_label(alloc);
    try b.test_rr(alloc, .Rsi, .Rsi);
    try b.jcc_label(alloc, .E, l_ret_empty);

    try b.push(alloc, .Rbx);
    try b.push(alloc, .R12);
    try b.push(alloc, .R13);
    try b.push(alloc, .R14);
    try b.push(alloc, .R15);

    try b.mov_rr(alloc, .R13, .Rdi);
    try b.mov_rr(alloc, .R14, .Rsi);
    try b.mov_rr(alloc, .R15, .Rdx);

    let l_multi = try b.new_label(alloc);
    let l_done = try b.new_label(alloc);
    try b.cmp_ri32(alloc, .R14, 1_i32);
    try b.jcc_label(alloc, .A, l_multi);
    try b.load_mem(alloc, .Rax, .R13, 0_i32, 8_usize, false);
    try b.load_mem(alloc, .Rdi, .R13, 8_i32, 8_usize, false);
    let l_have_1 = try b.new_label(alloc);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .Ne, l_have_1);
    try b.mov_rr(alloc, .Rdi, .R15);
    b.bind_label(l_have_1);
    try b.call_reg(alloc, .Rax);
    try b.jmp_label(alloc, l_done);

    b.bind_label(l_multi);
    try b.call_sym(alloc, s_init);
    try b.lea_rip_sym(alloc, .R12, s_sched, 0_i64);

    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.mov_ri64(alloc, .Rcx, 1_u64);
    try b.lock_cmpxchg_disp(alloc, .R12, SCHED_OFF_CALL_LOCK, .Rcx, 8_usize);
    let l_got_lock = try b.new_label(alloc);
    try b.jcc_label(alloc, .E, l_got_lock);

    try b.xor_rr32(alloc, .Rbx, .Rbx);
    let l_seq_lp = try b.new_label(alloc);
    b.bind_label(l_seq_lp);
    try b.cmp_rr(alloc, .Rbx, .R14);
    try b.jcc_label(alloc, .Ae, l_done);
    try b.mov_rr(alloc, .R8, .Rbx);
    try b.shl_imm(alloc, .R8, 5_u8);
    try b.add_rr(alloc, .R8, .R13);
    try b.load_mem(alloc, .Rax, .R8, 0_i32, 8_usize, false);
    try b.load_mem(alloc, .Rdi, .R8, 8_i32, 8_usize, false);
    let l_sq_arg = try b.new_label(alloc);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .Ne, l_sq_arg);
    try b.mov_rr(alloc, .Rdi, .R15);
    b.bind_label(l_sq_arg);
    try b.call_reg(alloc, .Rax);
    try b.add_ri32(alloc, .Rbx, 1_i32);
    try b.jmp_label(alloc, l_seq_lp);

    b.bind_label(l_got_lock);
    let s_tcb_dag = try interner.intern_str(alloc, "__eon_main_tcb");
    try b.lea_rip_sym(alloc, .Rax, s_tcb_dag, 0_i64);
    try b.store_imm64_sext_mem(alloc, .Rax, TCB_OFF_ST_FAST, 0_i32);
    try emit_dag_prepare_rt(alloc, b);

    try b.mov_ri64(alloc, .Rax, 2_u64);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_KIND, .Rax, 8_usize);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_CTX, .R15, 8_usize);
    try b.store_mem(alloc, .R12, SCHED_OFF_DAG_NODES, .R13, 8_usize);
    try b.store_mem(alloc, .R12, SCHED_OFF_DAG_COUNT, .R14, 8_usize);
    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_DONE, .Rax, 8_usize);
    try b.store_mem(alloc, .R12, SCHED_OFF_TASK_CLOSED, .Rax, 8_usize);

    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.lock_xadd_disp(alloc, .R12, SCHED_OFF_WORK_GEN, .Rax, 8_usize);
    try b.lea_mem(alloc, .Rdi, .R12, SCHED_OFF_WORK_GEN);
    try b.mov_ri64(alloc, .Rsi, 129_u64);
    try b.mov_ri64(alloc, .Rdx, 0x7FFFFFFF_u64);
    try b.xor_rr32(alloc, .R10, .R10);
    try b.xor_rr32(alloc, .R8, .R8);
    try b.xor_rr32(alloc, .R9, .R9);
    try b.mov_ri64(alloc, .Rax, 202_u64);
    try b.syscall(alloc);

    try emit_dag_work_loop(alloc, b, .R12);

    try b.mov_ri64(alloc, .Rax, 1_u64);
    try b.xchg_mem_disp(alloc, .R12, SCHED_OFF_TASK_CLOSED, .Rax, 8_usize);
    let l_drain = try b.new_label(alloc);
    let l_drained = try b.new_label(alloc);
    b.bind_label(l_drain);
    try b.cmp_mi32(alloc, .R12, SCHED_OFF_IN_TASK, 0_i32, 8_usize);
    try b.jcc_label(alloc, .E, l_drained);
    try b.pause(alloc);
    try b.jmp_label(alloc, l_drain);
    b.bind_label(l_drained);
    try emit_flush_tcb_alloc_cap(alloc, interner, b);
    try b.lea_rip_sym(alloc, .Rax, s_tcb_dag, 0_i64);
    try b.store_imm64_sext_mem(alloc, .Rax, TCB_OFF_ST_FAST, 1_i32);

    let l_no_unmap = try b.new_label(alloc);
    try b.test_rr(alloc, .Rbx, .Rbx);
    try b.jcc_label(alloc, .E, l_no_unmap);
    try b.load_mem(alloc, .Rdi, .R12, SCHED_OFF_DAG_RT, 8_usize, false);
    try b.mov_rr(alloc, .Rsi, .Rbx);
    try b.mov_ri64(alloc, .Rax, 11_u64);
    try b.syscall(alloc);
    b.bind_label(l_no_unmap);

    try b.xor_rr32(alloc, .Rax, .Rax);
    try b.xchg_mem_disp(alloc, .R12, SCHED_OFF_CALL_LOCK, .Rax, 8_usize);

    b.bind_label(l_done);
    try b.pop(alloc, .R15);
    try b.pop(alloc, .R14);
    try b.pop(alloc, .R13);
    try b.pop(alloc, .R12);
    try b.pop(alloc, .Rbx);
    b.bind_label(l_ret_empty);
    try b.ret(alloc);
    return;
}

fn emit_rt_fiber_switch(alloc: *mut AllocCap, b: *mut X64Buf) -> !OutOfMemory {
    let l_restore = try b.new_label(alloc);
    try b.test_rr(alloc, .Rdi, .Rdi);
    try b.jcc_label(alloc, .E, l_restore);

    try b.store_mem(alloc, .Rdi, 0_i32, .Rbx, 8_usize);
    try b.store_mem(alloc, .Rdi, 8_i32, .Rbp, 8_usize);
    try b.store_mem(alloc, .Rdi, 16_i32, .R12, 8_usize);
    try b.store_mem(alloc, .Rdi, 24_i32, .R13, 8_usize);
    try b.store_mem(alloc, .Rdi, 32_i32, .R14, 8_usize);
    try b.store_mem(alloc, .Rdi, 40_i32, .R15, 8_usize);
    try b.load_mem(alloc, .Rax, .Rsp, 0_i32, 8_usize, false);
    try b.store_mem(alloc, .Rdi, 56_i32, .Rax, 8_usize);
    try b.lea_mem(alloc, .Rax, .Rsp, 8_i32);
    try b.store_mem(alloc, .Rdi, 48_i32, .Rax, 8_usize);

    b.bind_label(l_restore);
    try b.load_mem(alloc, .Rbx, .Rsi, 0_i32, 8_usize, false);
    try b.load_mem(alloc, .Rbp, .Rsi, 8_i32, 8_usize, false);
    try b.load_mem(alloc, .R12, .Rsi, 16_i32, 8_usize, false);
    try b.load_mem(alloc, .R13, .Rsi, 24_i32, 8_usize, false);
    try b.load_mem(alloc, .R14, .Rsi, 32_i32, 8_usize, false);
    try b.load_mem(alloc, .R15, .Rsi, 40_i32, 8_usize, false);
    try b.load_mem(alloc, .Rsp, .Rsi, 48_i32, 8_usize, false);
    try b.load_mem(alloc, .Rax, .Rsi, 56_i32, 8_usize, false);
    try b.jmp_reg(alloc, .Rax);
    return;
}

