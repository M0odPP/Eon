module eonc.cfg_ir;

import core.col;
import core.str;
import eonc.span;
import eonc.ast;
import eonc.resolve;
import eonc.types;

// ===========================================================================
// Section 1: Core IDs, Constants, Function Keys, and Slice Helpers
// ===========================================================================

pub type BlockId = u32;
pub type LocalId = u32;

pub const CFG_NONE: u32 = 4294967295_u32;

pub enum CfgFnKeyKind : u8 {
    TopDef = 0,
    ImplMethod = 1,
    GenericInst = 2,
    Closure = 3,
}

pub struct CfgFnKey {
    pub kind: CfgFnKeyKind;
    pub a: u32;
    pub b: u32;
}

pub fn fn_key_top_def(def_id: u32) -> CfgFnKey {
    return CfgFnKey.{ kind: .TopDef, a: def_id, b: 0_u32 };
}

pub fn fn_key_impl_method(impl_idx: u32, sub_idx: u32) -> CfgFnKey {
    return CfgFnKey.{ kind: .ImplMethod, a: impl_idx, b: sub_idx };
}

pub fn fn_key_generic_inst(inst_id: u32) -> CfgFnKey {
    return CfgFnKey.{ kind: .GenericInst, a: inst_id, b: 0_u32 };
}

pub fn fn_key_closure(closure_id: u32) -> CfgFnKey {
    return CfgFnKey.{ kind: .Closure, a: closure_id, b: 0_u32 };
}

pub fn fn_key_eq(x: CfgFnKey, y: CfgFnKey) -> bool {
    return x.kind == y.kind && x.a == y.a && x.b == y.b;
}

fn fn_key_kind_u8(kind: CfgFnKeyKind) -> u8 {
    match kind {
        .TopDef => { return 0_u8; }
        .ImplMethod => { return 1_u8; }
        .GenericInst => { return 2_u8; }
        .Closure => { return 3_u8; }
    }
}

/// Collision-free `u64` key encoding for `HashMap[u32]` (`by_key`).
/// Encodes `kind` in bits 62..63, `b` (`sub_idx`) in bits 32..61, and `a` in bits 0..31.
pub fn fn_key_u64(k: CfgFnKey) -> u64 {
    let tag = fn_key_kind_u8(k.kind).widen.[u64]();
    let hi_b = (k.b.widen.[u64]() & 0x3FFFFFFF_u64) <<% 32_u64;
    return (tag <<% 62_u64) | hi_b | k.a.widen.[u64]();
}

pub fn write_fn_key_kind(
    alloc: *mut AllocCap,
    key: CfgFnKey,
    is_sys: bool,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    match key.kind {
        .TopDef => {
            if is_sys {
                try out.push_str_grow(alloc, "sys");
            } else {
                try out.push_str_grow(alloc, "fn");
            }
        }
        .ImplMethod => { try out.push_str_grow(alloc, "method"); }
        .GenericInst => { try out.push_str_grow(alloc, "inst"); }
        .Closure => { try out.push_str_grow(alloc, "closure"); }
    }
    return;
}

view fn slice_id_range[T](all: *[T], r: ast.IdRange) -> *[T] {
    let start = r.start.widen.[usize]();
    let end = start +% r.len.widen.[usize]();
    let s = all.sub(start, end) catch {
        return all.sub(0_usize, 0_usize) catch {
            return all;
        };
    };
    return s;
}

view fn empty_slice[T](all: *[T]) -> *[T] {
    return all.sub(0_usize, 0_usize) catch {
        return all;
    };
}

// ===========================================================================
// Section 2: Projections, Places, Constants, and Operands
// ===========================================================================

pub enum CfgProjKind : u8 {
    Deref = 0,
    Field = 1,
    TupleField = 2,
    PoolCol = 3,
    Index = 4,
}

pub struct CfgProj {
    pub kind: CfgProjKind;
    pub is_slot_pool: bool;
    pub has_const_idx: bool;
    pub has_key_sym: bool;
    pub sym: u32;
    pub index: u32;
    pub ty: types.TyId;
    pub operand_id: u32;
    pub const_idx: types.IntVal;
}

pub fn proj_deref() -> CfgProj {
    return CfgProj.{
        kind: .Deref,
        is_slot_pool: false,
        has_const_idx: false,
        has_key_sym: false,
        sym: span.SYM_EMPTY,
        index: 0_u32,
        ty: types.TY_ERROR,
        operand_id: CFG_NONE,
        const_idx: types.int_val_zero(),
    };
}

pub fn proj_field(name: u32, field_idx: u32, ty: types.TyId) -> CfgProj {
    return CfgProj.{
        kind: .Field,
        is_slot_pool: false,
        has_const_idx: false,
        has_key_sym: false,
        sym: name,
        index: field_idx,
        ty: ty,
        operand_id: CFG_NONE,
        const_idx: types.int_val_zero(),
    };
}

pub fn proj_tuple_field(index: u32, ty: types.TyId) -> CfgProj {
    return CfgProj.{
        kind: .TupleField,
        is_slot_pool: false,
        has_const_idx: false,
        has_key_sym: false,
        sym: span.SYM_EMPTY,
        index: index,
        ty: ty,
        operand_id: CFG_NONE,
        const_idx: types.int_val_zero(),
    };
}

pub fn proj_pool_col(
    col_sym: u32,
    col_idx: u32,
    is_slot_pool: bool,
    elem_ty: types.TyId,
) -> CfgProj {
    return CfgProj.{
        kind: .PoolCol,
        is_slot_pool: is_slot_pool,
        has_const_idx: false,
        has_key_sym: false,
        sym: col_sym,
        index: col_idx,
        ty: elem_ty,
        operand_id: CFG_NONE,
        const_idx: types.int_val_zero(),
    };
}

pub fn proj_index(
    operand_id: u32,
    has_const_idx: bool,
    const_idx: types.IntVal,
    has_key_sym: bool,
    key_sym: u32,
    ty: types.TyId,
) -> CfgProj {
    return CfgProj.{
        kind: .Index,
        is_slot_pool: false,
        has_const_idx: has_const_idx,
        has_key_sym: has_key_sym,
        sym: key_sym,
        index: 0_u32,
        ty: ty,
        operand_id: operand_id,
        const_idx: const_idx,
    };
}

pub struct CfgPlace {
    pub local: LocalId;
    pub projs: ast.IdRange;
    pub ty: types.TyId;
    pub span: span.Span;
}

pub fn place_local(local: LocalId, ty: types.TyId, sp: span.Span) -> CfgPlace {
    return CfgPlace.{
        local: local,
        projs: ast.range_empty(),
        ty: ty,
        span: sp,
    };
}

pub fn place_new(local: LocalId, projs: ast.IdRange, ty: types.TyId, sp: span.Span) -> CfgPlace {
    return CfgPlace.{
        local: local,
        projs: projs,
        ty: ty,
        span: sp,
    };
}

pub enum CfgConstKind : u8 {
    Void = 0,
    Bool = 1,
    Char = 2,
    Int = 3,
    Float = 4,
    Str = 5,
    Bytes = 6,
    Null = 7,
    EnumTag = 8,
    ErrorTag = 9,
    FnRef = 10,
    ConstDef = 11,
}

pub struct CfgConst {
    pub kind: CfgConstKind;
    pub bool_val: bool;
    pub ty: types.TyId;
    pub aux_u32: u32;
    pub sym: u32;
    pub int_val: types.IntVal;
    pub bytes: ast.IdRange;
}

pub fn const_void() -> CfgConst {
    return CfgConst.{
        kind: .Void,
        bool_val: false,
        ty: types.TY_VOID,
        aux_u32: 0_u32,
        sym: span.SYM_EMPTY,
        int_val: types.int_val_zero(),
        bytes: ast.range_empty(),
    };
}

pub fn const_bool(v: bool) -> CfgConst {
    var c = const_void();
    c.kind = .Bool;
    c.bool_val = v;
    c.ty = types.TY_BOOL;
    return c;
}

pub fn const_char(cp: u32) -> CfgConst {
    var c = const_void();
    c.kind = .Char;
    c.aux_u32 = cp;
    c.ty = types.TY_CHAR;
    return c;
}

pub fn const_int(val: types.IntVal, ty: types.TyId) -> CfgConst {
    var c = const_void();
    c.kind = .Int;
    c.int_val = val;
    c.ty = ty;
    return c;
}

pub fn const_float(text_range: ast.IdRange, ty: types.TyId) -> CfgConst {
    var c = const_void();
    c.kind = .Float;
    c.bytes = text_range;
    c.ty = ty;
    return c;
}

pub fn const_str(bytes_range: ast.IdRange) -> CfgConst {
    var c = const_void();
    c.kind = .Str;
    c.bytes = bytes_range;
    c.ty = types.TY_STR;
    return c;
}

pub fn const_bytes(bytes_range: ast.IdRange) -> CfgConst {
    var c = const_void();
    c.kind = .Bytes;
    c.bytes = bytes_range;
    c.ty = types.TY_STR;
    return c;
}

pub fn const_null(ty: types.TyId) -> CfgConst {
    var c = const_void();
    c.kind = .Null;
    c.ty = ty;
    return c;
}

pub fn const_enum_tag(ty: types.TyId, variant: u32, tag_val: types.IntVal) -> CfgConst {
    var c = const_void();
    c.kind = .EnumTag;
    c.ty = ty;
    c.sym = variant;
    c.int_val = tag_val;
    return c;
}

pub fn const_error_tag(ty: types.TyId, variant: u32, tag_val: u32) -> CfgConst {
    var c = const_void();
    c.kind = .ErrorTag;
    c.ty = ty;
    c.sym = variant;
    c.aux_u32 = tag_val;
    return c;
}

pub fn const_fn_ref(def_id: u32, ty: types.TyId) -> CfgConst {
    var c = const_void();
    c.kind = .FnRef;
    c.aux_u32 = def_id;
    c.ty = ty;
    return c;
}

pub fn const_def(def_id: u32, ty: types.TyId) -> CfgConst {
    var c = const_void();
    c.kind = .ConstDef;
    c.aux_u32 = def_id;
    c.ty = ty;
    return c;
}

/// Returns the resolved `TyId` of a `CfgConst`, matching `compiler/src/cfg.rs::CfgConst::ty`.
pub fn const_ty(c: *CfgConst, env: *types.TypeEnv) -> types.TyId {
    match c.kind {
        .Void => { return types.TY_VOID; }
        .Bool => { return types.TY_BOOL; }
        .Char => { return types.TY_CHAR; }
        .Int => { return c.ty; }
        .Float => { return c.ty; }
        .Str => { return types.TY_STR; }
        .Bytes => { return types.TY_STR; }
        .Null => { return c.ty; }
        .EnumTag => { return c.ty; }
        .ErrorTag => {
            if env.get(c.ty).kind == .ErrorSet {
                return c.ty;
            }
            return types.TY_U32;
        }
        .FnRef => { return c.ty; }
        .ConstDef => { return c.ty; }
    }
}

pub enum CfgOperandKind : u8 {
    Copy = 0,
    Move = 1,
    Const = 2,
}

pub struct CfgOperand {
    pub kind: CfgOperandKind;
    pub id: u32;
}

pub fn op_copy(place_id: u32) -> CfgOperand {
    return CfgOperand.{ kind: .Copy, id: place_id };
}

pub fn op_move(place_id: u32) -> CfgOperand {
    return CfgOperand.{ kind: .Move, id: place_id };
}

pub fn op_const(const_id: u32) -> CfgOperand {
    return CfgOperand.{ kind: .Const, id: const_id };
}

pub fn op_none() -> CfgOperand {
    return CfgOperand.{ kind: .Const, id: CFG_NONE };
}

pub fn operand_place_id(op: CfgOperand) -> ?u32 {
    if op.kind == .Copy || op.kind == .Move {
        return op.id;
    }
    return null;
}

pub fn operand_const_id(op: CfgOperand) -> ?u32 {
    if op.kind == .Const {
        return op.id;
    }
    return null;
}

