pub enum CastKind : u8 {
    Widen = 0,
    Trunc = 1,
    Clamp = 2,
    ToFloat = 3,
    TruncToInt = 4,
    Bitcast = 5,
    AsU64 = 6,
    WrapOptional = 7,
    WrapOk = 8,
    WrapErr = 9,
    MutToConst = 10,
    ArrayBorrowToSlice = 11,
}

pub enum AggregateKindTag : u8 {
    Struct = 0,
    AnonStruct = 1,
    Tuple = 2,
    PoolRow = 3,
    Array = 4,
    ArrayRepeat = 5,
    UnionVariant = 6,
    Bitfield = 7,
    Vec = 8,
}

pub struct AggregateKind {
    pub tag: AggregateKindTag;
    pub is_slot_pool: bool;
    pub vec_len: u8;
    pub def_id: u32;
    pub variant_idx: u32;
    pub elem_ty: types.TyId;
    pub count: u64;
    pub field_syms: ast.IdRange;
}

pub fn agg_tuple() -> AggregateKind {
    return AggregateKind.{
        tag: .Tuple,
        is_slot_pool: false,
        vec_len: 0_u8,
        def_id: resolve.DEF_NONE,
        variant_idx: 0_u32,
        elem_ty: types.TY_VOID,
        count: 0_u64,
        field_syms: ast.range_empty(),
    };
}

pub fn agg_struct(def_id: u32) -> AggregateKind {
    var a = agg_tuple();
    a.tag = .Struct;
    a.def_id = def_id;
    return a;
}

pub fn agg_anon_struct(field_syms: ast.IdRange) -> AggregateKind {
    var a = agg_tuple();
    a.tag = .AnonStruct;
    a.field_syms = field_syms;
    return a;
}

pub fn agg_pool_row(def_id: u32, is_slot_pool: bool) -> AggregateKind {
    var a = agg_tuple();
    a.tag = .PoolRow;
    a.def_id = def_id;
    a.is_slot_pool = is_slot_pool;
    return a;
}

pub fn agg_array(elem_ty: types.TyId) -> AggregateKind {
    var a = agg_tuple();
    a.tag = .Array;
    a.elem_ty = elem_ty;
    return a;
}

pub fn agg_array_repeat(elem_ty: types.TyId, count: u64) -> AggregateKind {
    var a = agg_tuple();
    a.tag = .ArrayRepeat;
    a.elem_ty = elem_ty;
    a.count = count;
    return a;
}

pub fn agg_union_variant(def_id: u32, variant_idx: u32) -> AggregateKind {
    var a = agg_tuple();
    a.tag = .UnionVariant;
    a.def_id = def_id;
    a.variant_idx = variant_idx;
    return a;
}

pub fn agg_bitfield(def_id: u32) -> AggregateKind {
    var a = agg_tuple();
    a.tag = .Bitfield;
    a.def_id = def_id;
    return a;
}

pub fn agg_vec(elem_ty: types.TyId, len: u8) -> AggregateKind {
    var a = agg_tuple();
    a.tag = .Vec;
    a.elem_ty = elem_ty;
    a.vec_len = len;
    return a;
}

