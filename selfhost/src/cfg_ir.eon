pub struct CfgBuiltinOp {
    pub kind: CfgBuiltinOpKind;
    pub flag: bool;
    pub len_u8: u8;
    pub bin_op: ast.BinaryOp;
    pub ty0: types.TyId;
    pub ty1: types.TyId;
    pub sym: u32;
}

pub fn builtin_op_simple(kind: CfgBuiltinOpKind) -> CfgBuiltinOp {
    return CfgBuiltinOp.{
        kind: kind,
        flag: false,
        len_u8: 0_u8,
        bin_op: .Add,
        ty0: types.TY_VOID,
        ty1: types.TY_VOID,
        sym: span.SYM_EMPTY,
    };
}

pub fn builtin_op_ty(kind: CfgBuiltinOpKind, ty: types.TyId) -> CfgBuiltinOp {
    var b = builtin_op_simple(kind);
    b.ty0 = ty;
    return b;
}

pub fn builtin_op_ty_mut(kind: CfgBuiltinOpKind, elem_ty: types.TyId, is_mut: bool) -> CfgBuiltinOp {
    var b = builtin_op_simple(kind);
    b.ty0 = elem_ty;
    b.flag = is_mut;
    return b;
}

pub fn builtin_op_len(kind: CfgBuiltinOpKind, len: u8) -> CfgBuiltinOp {
    var b = builtin_op_simple(kind);
    b.len_u8 = len;
    return b;
}

pub fn builtin_op_par_reduce(elem_ty: types.TyId, op_sym: u32) -> CfgBuiltinOp {
    var b = builtin_op_simple(.ParReduce);
    b.ty0 = elem_ty;
    b.sym = op_sym;
    return b;
}

pub fn builtin_op_vec_cmp(op: ast.BinaryOp, vec_ty: types.TyId) -> CfgBuiltinOp {
    var b = builtin_op_simple(.VecCmp);
    b.bin_op = op;
    b.ty0 = vec_ty;
    return b;
}

pub fn builtin_op_vec_shuffle(
    src_ty: types.TyId,
    idx_ty: types.TyId,
    two_src: bool,
) -> CfgBuiltinOp {
    var b = builtin_op_simple(.VecShuffle);
    b.ty0 = src_ty;
    b.ty1 = idx_ty;
    b.flag = two_src;
    return b;
}

pub enum CfgCalleeKind : u8 {
    DirectFn = 0,
    Method = 1,
    GenericInst = 2,
    DynCall = 3,
    ExternFn = 4,
    FnPtr = 5,
    Builtin = 6,
}

pub struct CfgCallee {
    pub kind: CfgCalleeKind;
    pub is_view: bool;
    pub a: u32;
    pub b: u32;
    pub fn_ptr: CfgOperand;
    pub builtin: CfgBuiltinOp;
}

pub fn callee_direct_fn(def_id: u32) -> CfgCallee {
    return CfgCallee.{
        kind: .DirectFn,
        is_view: false,
        a: def_id,
        b: 0_u32,
        fn_ptr: op_none(),
        builtin: builtin_op_simple(.ArenaInit),
    };
}

pub fn callee_method(impl_idx: u32, sub_idx: u32, is_view: bool) -> CfgCallee {
    var c = callee_direct_fn(impl_idx);
    c.kind = .Method;
    c.is_view = is_view;
    c.b = sub_idx;
    return c;
}

pub fn callee_generic_inst(inst_id: u32, is_view: bool) -> CfgCallee {
    var c = callee_direct_fn(inst_id);
    c.kind = .GenericInst;
    c.is_view = is_view;
    return c;
}

pub fn callee_dyn_call(iface_def: u32, method_idx: u32) -> CfgCallee {
    var c = callee_direct_fn(iface_def);
    c.kind = .DynCall;
    c.b = method_idx;
    return c;
}

pub fn callee_extern_fn(def_id: u32, name_sym: u32) -> CfgCallee {
    var c = callee_direct_fn(def_id);
    c.kind = .ExternFn;
    c.b = name_sym;
    return c;
}

pub fn callee_fn_ptr(fn_ptr: CfgOperand) -> CfgCallee {
    var c = callee_direct_fn(0_u32);
    c.kind = .FnPtr;
    c.fn_ptr = fn_ptr;
    return c;
}

pub fn callee_builtin(op: CfgBuiltinOp) -> CfgCallee {
    var c = callee_direct_fn(0_u32);
    c.kind = .Builtin;
    c.builtin = op;
    return c;
}

pub struct CfgAsmInput {
    pub name: ast.IdRange;
    pub operand: CfgOperand;
}

