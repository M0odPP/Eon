module eonc.verify;

import core.col;
import core.str;
import core.sync as sync;
import eonc.span;
import eonc.diag;
import eonc.ast;
import eonc.resolve;
import eonc.types;
import eonc.cfg_ir;
import eonc.effects;
import eonc.eir;

// ===========================================================================
// Section 1: Public Types (`FnVerifyInfo`, `VerifyReport`) & Constants
// ===========================================================================

const MAX_DBM_VERTS: usize = 64_usize;
const WIDEN_AFTER_ITERS: usize = 3_usize;
const MAX_FIXPOINT_ITERS: usize = 32_usize;
const NARROW_ITERS: usize = 2_usize;
const COMPACT_MAT_THRESHOLD: usize = 262144_usize;

pub struct FnVerifyInfo {
    pub proven_checks: usize;
    pub total_checks: usize;
    pub proven_safe_insts: usize;
    pub ranged_values: usize;
}

pub fn fn_verify_default() -> FnVerifyInfo {
    return FnVerifyInfo.{
        proven_checks: 0_usize,
        total_checks: 0_usize,
        proven_safe_insts: 0_usize,
        ranged_values: 0_usize,
    };
}

pub struct VerifyProfStats {
    pub fn_count: u64;
    pub block_transfers: u64;
    pub saves: u64;
    pub edge_saves: u64;
    pub loads: u64;
    pub copies: u64;
    pub sorts: u64;
    pub already_sorted: u64;
    pub total_iv_saved: u64;
    pub total_mat_saved: u64;
    pub fixpoint_iters: u64;
    pub narrow_iters: u64;
    pub widens: u64;
    pub compacts: u64;
    pub peak_spool_iv: u64;
    pub peak_spool_mat: u64;
    pub max_fn_id: u32;
    pub max_fn_blocks: u32;
    pub max_fn_iv_pool: u64;
    pub max_fn_mat_pool: u64;
}

pub fn verify_prof_zero() -> VerifyProfStats {
    return VerifyProfStats.{
        fn_count: 0_u64,
        block_transfers: 0_u64,
        saves: 0_u64,
        edge_saves: 0_u64,
        loads: 0_u64,
        copies: 0_u64,
        sorts: 0_u64,
        already_sorted: 0_u64,
        total_iv_saved: 0_u64,
        total_mat_saved: 0_u64,
        fixpoint_iters: 0_u64,
        narrow_iters: 0_u64,
        widens: 0_u64,
        compacts: 0_u64,
        peak_spool_iv: 0_u64,
        peak_spool_mat: 0_u64,
        max_fn_id: 0_u32,
        max_fn_blocks: 0_u32,
        max_fn_iv_pool: 0_u64,
        max_fn_mat_pool: 0_u64,
    };
}

pub linear struct VerifyReport {
    pub per_fn: col.DynBuf[FnVerifyInfo];
    by_key: col.HashMap[u32];
    pub prof: VerifyProfStats;
}

impl VerifyReport {
    pub fn init(alloc: *mut AllocCap) -> VerifyReport ! OutOfMemory {
        let per_fn = try col.DynBuf.[FnVerifyInfo].init(alloc, 16_usize);
        errdefer per_fn.destroy(alloc);
        let by_key = try col.HashMap.[u32].init(alloc, 32_usize);
        errdefer by_key.destroy(alloc);
        return VerifyReport.{ per_fn: per_fn, by_key: by_key, prof: verify_prof_zero() };
    }

    pub fn destroy(self: VerifyReport, alloc: *mut AllocCap) {
        let VerifyReport.{ per_fn, by_key, prof: _ } = self;
        per_fn.destroy(alloc);
        by_key.destroy(alloc);
    }

    pub fn fn_count(self: *Self) -> u32 {
        return self.per_fn.len().trunc.[u32]();
    }

    pub fn get_fn(self: *Self, fn_id: u32) -> ?FnVerifyInfo {
        let idx = fn_id.widen.[usize]();
        let xs = self.per_fn.as_slice();
        if idx < xs.len {
            return xs[idx];
        }
        return null;
    }

    pub fn get_by_key(self: *Self, key: cfg_ir.CfgFnKey) -> ?FnVerifyInfo {
        if let fn_id = self.by_key.get(cfg_ir.fn_key_u64(key)) {
            return self.get_fn(fn_id);
        }
        return null;
    }
}

// ===========================================================================
// Section 2: Exact 128-bit Arithmetic, `Bound`, `Interval`, & `KnownBits`
// ===========================================================================

fn iv_one() -> types.IntVal {
    return types.int_val_from_u64(1_u64);
}

fn iv_neg_one() -> types.IntVal {
    return types.int_val_from_i64(-1_i64);
}

fn iv_i64_max() -> types.IntVal {
    return types.IntVal.{ lo: 0x7FFFFFFFFFFFFFFF_u64, hi: 0_i64 };
}

fn iv_lt(a: types.IntVal, b: types.IntVal) -> bool {
    return types.int_val_cmp(a, b) < 0_i32;
}

fn iv_le(a: types.IntVal, b: types.IntVal) -> bool {
    return types.int_val_cmp(a, b) <= 0_i32;
}

fn iv_gt(a: types.IntVal, b: types.IntVal) -> bool {
    return types.int_val_cmp(a, b) > 0_i32;
}

fn iv_ge(a: types.IntVal, b: types.IntVal) -> bool {
    return types.int_val_cmp(a, b) >= 0_i32;
}

fn iv_min(a: types.IntVal, b: types.IntVal) -> types.IntVal {
    return if iv_le(a, b) { a } else { b };
}

fn iv_max(a: types.IntVal, b: types.IntVal) -> types.IntVal {
    return if iv_ge(a, b) { a } else { b };
}

fn iv_clamp(v: types.IntVal, lo: types.IntVal, hi: types.IntVal) -> types.IntVal {
    if iv_lt(v, lo) {
        return lo;
    }
    if iv_gt(v, hi) {
        return hi;
    }
    return v;
}

fn iv_checked_shl(a: types.IntVal, shift: u32) -> ?types.IntVal {
    if shift >= 128_u32 {
        return null;
    }
    return types.int_val_shl(a, shift);
}

fn u128_zero() -> types.U128Val {
    return types.U128Val.{ lo: 0_u64, hi: 0_u64 };
}

fn u128_max() -> types.U128Val {
    return types.U128Val.{ lo: 0xFFFFFFFFFFFFFFFF_u64, hi: 0xFFFFFFFFFFFFFFFF_u64 };
}

fn u128_eq(a: types.U128Val, b: types.U128Val) -> bool {
    return a.lo == b.lo && a.hi == b.hi;
}

fn u128_le(a: types.U128Val, b: types.U128Val) -> bool {
    if a.hi != b.hi {
        return a.hi < b.hi;
    }
    return a.lo <= b.lo;
}

fn u128_not(a: types.U128Val) -> types.U128Val {
    return types.U128Val.{ lo: ~a.lo, hi: ~a.hi };
}

fn u128_and(a: types.U128Val, b: types.U128Val) -> types.U128Val {
    return types.U128Val.{ lo: a.lo & b.lo, hi: a.hi & b.hi };
}

fn u128_or(a: types.U128Val, b: types.U128Val) -> types.U128Val {
    return types.U128Val.{ lo: a.lo | b.lo, hi: a.hi | b.hi };
}

fn u128_xor(a: types.U128Val, b: types.U128Val) -> types.U128Val {
    return types.U128Val.{ lo: a.lo ^ b.lo, hi: a.hi ^ b.hi };
}

fn u128_shl(a: types.U128Val, k: u32) -> types.U128Val {
    if k == 0_u32 {
        return a;
    }
    if k >= 128_u32 {
        return u128_zero();
    }
    if k >= 64_u32 {
        let s = (k -% 64_u32).widen.[u64]() & 63_u64;
        return types.U128Val.{ lo: 0_u64, hi: a.lo <<% s };
    }
    let s = k.widen.[u64]() & 63_u64;
    let r = (64_u64 -% s) & 63_u64;
    return types.U128Val.{ lo: a.lo <<% s, hi: (a.hi <<% s) | (a.lo >> r) };
}

fn u128_shr(a: types.U128Val, k: u32) -> types.U128Val {
    if k == 0_u32 {
        return a;
    }
    if k >= 128_u32 {
        return u128_zero();
    }
    if k >= 64_u32 {
        let s = (k -% 64_u32).widen.[u64]() & 63_u64;
        return types.U128Val.{ lo: a.hi >> s, hi: 0_u64 };
    }
    let s = k.widen.[u64]() & 63_u64;
    let r = (64_u64 -% s) & 63_u64;
    return types.U128Val.{ lo: (a.lo >> s) | (a.hi <<% r), hi: a.hi >> s };
}

fn u128_low_mask(bits: u32) -> types.U128Val {
    if bits == 0_u32 {
        return u128_zero();
    }
    if bits >= 128_u32 {
        return u128_max();
    }
    if bits == 64_u32 {
        return types.U128Val.{ lo: 0xFFFFFFFFFFFFFFFF_u64, hi: 0_u64 };
    }
    if bits < 64_u32 {
        let s = bits.widen.[u64]() & 63_u64;
        return types.U128Val.{ lo: (1_u64 <<% s) -% 1_u64, hi: 0_u64 };
    }
    let s = (bits -% 64_u32).widen.[u64]() & 63_u64;
    return types.U128Val.{ lo: 0xFFFFFFFFFFFFFFFF_u64, hi: (1_u64 <<% s) -% 1_u64 };
}

fn u128_leading_zeros(a: types.U128Val) -> u32 {
    if a.hi != 0_u64 {
        return (@lzcnt(a.hi) & 63_u64).trunc.[u32]();
    }
    if a.lo != 0_u64 {
        return 64_u32 +% (@lzcnt(a.lo) & 63_u64).trunc.[u32]();
    }
    return 128_u32;
}

fn u128_from_nonneg(v: types.IntVal) -> types.U128Val {
    return types.U128Val.{ lo: v.lo, hi: v.hi.bitcast.[u64]() };
}

fn int_val_from_u128_checked(u: types.U128Val) -> ?types.IntVal {
    if u.hi <= 0x7FFFFFFFFFFFFFFF_u64 {
        return types.IntVal.{ lo: u.lo, hi: u.hi.bitcast.[i64]() };
    }
    return null;
}

struct Bound {
    has_val: bool;
    val: types.IntVal;
}

fn bound_none() -> Bound {
    return Bound.{ has_val: false, val: types.int_val_zero() };
}

fn bound_some(v: types.IntVal) -> Bound {
    return Bound.{ has_val: true, val: v };
}

fn bound_add(a: Bound, b: Bound) -> Bound {
    if a.has_val && b.has_val {
        if let s = types.int_val_checked_add(a.val, b.val) {
            return bound_some(s);
        }
    }
    return bound_none();
}

fn bound_min(a: Bound, b: Bound) -> Bound {
    if a.has_val && b.has_val {
        return bound_some(iv_min(a.val, b.val));
    }
    if a.has_val {
        return a;
    }
    return b;
}

fn bound_max(a: Bound, b: Bound) -> Bound {
    if a.has_val && b.has_val {
        return bound_some(iv_max(a.val, b.val));
    }
    return bound_none();
}

fn bound_lt(a: *Bound, b: *Bound) -> bool {
    if a.has_val && b.has_val {
        return iv_lt(a.val, b.val);
    }
    return a.has_val && !b.has_val;
}

fn bound_le(a: *Bound, b: *Bound) -> bool {
    if !b.has_val {
        return true;
    }
    if !a.has_val {
        return false;
    }
    return iv_le(a.val, b.val);
}

struct Interval {
    has_lo: bool;
    lo: types.IntVal;
    has_hi: bool;
    hi: types.IntVal;
}

fn interval_top() -> Interval {
    return Interval.{
        has_lo: false,
        lo: types.int_val_zero(),
        has_hi: false,
        hi: types.int_val_zero(),
    };
}

fn interval_const(c: types.IntVal) -> Interval {
    return Interval.{ has_lo: true, lo: c, has_hi: true, hi: c };
}

fn interval_range(lo: types.IntVal, hi: types.IntVal) -> Interval {
    return Interval.{ has_lo: true, lo: lo, has_hi: true, hi: hi };
}

fn interval_eq(a: *Interval, b: *Interval) -> bool {
    if a.has_lo != b.has_lo || a.has_hi != b.has_hi {
        return false;
    }
    if a.has_lo && !types.int_val_eq(a.lo, b.lo) {
        return false;
    }
    if a.has_hi && !types.int_val_eq(a.hi, b.hi) {
        return false;
    }
    return true;
}

fn interval_is_empty(iv: *Interval) -> bool {
    return iv.has_lo && iv.has_hi && iv_gt(iv.lo, iv.hi);
}

fn interval_is_const(iv: *Interval) -> bool {
    return iv.has_lo && iv.has_hi && types.int_val_eq(iv.lo, iv.hi);
}

fn interval_intersect(a: *Interval, b: *Interval) -> Interval {
    var has_lo = false;
    var lo = types.int_val_zero();
    if a.has_lo && b.has_lo {
        has_lo = true;
        lo = iv_max(a.lo, b.lo);
    } else if a.has_lo {
        has_lo = true;
        lo = a.lo;
    } else if b.has_lo {
        has_lo = true;
        lo = b.lo;
    }
    var has_hi = false;
    var hi = types.int_val_zero();
    if a.has_hi && b.has_hi {
        has_hi = true;
        hi = iv_min(a.hi, b.hi);
    } else if a.has_hi {
        has_hi = true;
        hi = a.hi;
    } else if b.has_hi {
        has_hi = true;
        hi = b.hi;
    }
    return Interval.{ has_lo: has_lo, lo: lo, has_hi: has_hi, hi: hi };
}

fn interval_hull(a: *Interval, b: *Interval) -> Interval {
    var has_lo = false;
    var lo = types.int_val_zero();
    if a.has_lo && b.has_lo {
        has_lo = true;
        lo = iv_min(a.lo, b.lo);
    }
    var has_hi = false;
    var hi = types.int_val_zero();
    if a.has_hi && b.has_hi {
        has_hi = true;
        hi = iv_max(a.hi, b.hi);
    }
    return Interval.{ has_lo: has_lo, lo: lo, has_hi: has_hi, hi: hi };
}

fn tb_to_interval(tb: types.IntBounds) -> Interval {
    if !tb.valid {
        return interval_top();
    }
    if tb.has_max {
        return interval_range(tb.min, tb.max);
    }
    return Interval.{ has_lo: true, lo: tb.min, has_hi: false, hi: types.int_val_zero() };
}

fn tb_ptr_to_interval(tb: *types.IntBounds) -> Interval {
    return tb_to_interval(copy tb.*);
}

fn interval_widen(old: *Interval, next: *Interval, tb: types.IntBounds) -> Interval {
    var has_lo = false;
    var lo = types.int_val_zero();
    if old.has_lo && next.has_lo && iv_ge(next.lo, old.lo) {
        has_lo = true;
        lo = old.lo;
    } else if tb.valid {
        has_lo = true;
        lo = tb.min;
    }
    var has_hi = false;
    var hi = types.int_val_zero();
    if old.has_hi && next.has_hi && iv_le(next.hi, old.hi) {
        has_hi = true;
        hi = old.hi;
    } else if tb.valid && tb.has_max {
        has_hi = true;
        hi = tb.max;
    }
    return Interval.{ has_lo: has_lo, lo: lo, has_hi: has_hi, hi: hi };
}

fn interval_narrow(old: *Interval, next: *Interval) -> Interval {
    var has_lo = old.has_lo;
    var lo = old.lo;
    if !old.has_lo && next.has_lo {
        has_lo = true;
        lo = next.lo;
    } else if old.has_lo && next.has_lo && iv_gt(next.lo, old.lo) {
        lo = next.lo;
    }
    var has_hi = old.has_hi;
    var hi = old.hi;
    if !old.has_hi && next.has_hi {
        has_hi = true;
        hi = next.hi;
    } else if old.has_hi && next.has_hi && iv_lt(next.hi, old.hi) {
        hi = next.hi;
    }
    return Interval.{ has_lo: has_lo, lo: lo, has_hi: has_hi, hi: hi };
}

fn push_interval_str(alloc: *mut AllocCap, iv: *Interval, out: *mut str.StrBuf) -> !OutOfMemory {
    try out.push_byte_grow(alloc, b'[');
    if iv.has_lo {
        try types.push_int_val_grow(alloc, iv.lo, out);
    } else {
        try out.push_str_grow(alloc, "-inf");
    }
    try out.push_str_grow(alloc, "..=");
    if iv.has_hi {
        try types.push_int_val_grow(alloc, iv.hi, out);
    } else {
        try out.push_str_grow(alloc, "+inf");
    }
    try out.push_byte_grow(alloc, b']');
    return;
}

struct KnownBits {
    zeros: types.U128Val;
    ones: types.U128Val;
}

fn kb_eq(a: *KnownBits, b: *KnownBits) -> bool {
    return u128_eq(a.zeros, b.zeros) && u128_eq(a.ones, b.ones);
}

fn kb_from_const(c: types.U128Val) -> KnownBits {
    return KnownBits.{ zeros: u128_not(c), ones: c };
}

fn kb_from_nonneg_interval(iv: *Interval, bw: u32) -> KnownBits {
    let mask = u128_low_mask(bw);
    var zeros = u128_not(mask);
    var ones = u128_zero();
    if iv.has_lo && iv.has_hi && !types.int_val_is_neg(iv.lo) && iv_ge(iv.hi, iv.lo) {
        let ulo = u128_from_nonneg(iv.lo);
        let uhi = u128_from_nonneg(iv.hi);
        if u128_eq(ulo, uhi) {
            return kb_from_const(ulo);
        }
        let diff = u128_xor(ulo, uhi);
        let leading = u128_leading_zeros(diff);
        if leading > 0_u32 && leading <= 128_u32 {
            let common_mask = u128_shl(u128_max(), 128_u32 -% leading);
            zeros = u128_or(zeros, u128_and(common_mask, u128_not(ulo)));
            ones = u128_or(ones, u128_and(common_mask, ulo));
        }
    } else if iv.has_hi && !types.int_val_is_neg(iv.hi) {
        let uhi = u128_from_nonneg(iv.hi);
        let used_bits = 128_u32 -% u128_leading_zeros(uhi);
        if used_bits < 128_u32 {
            zeros = u128_or(zeros, u128_shl(u128_max(), used_bits));
        }
    }
    return KnownBits.{ zeros: u128_and(zeros, u128_not(ones)), ones: ones };
}

fn kb_join(a: *KnownBits, b: *KnownBits) -> KnownBits {
    return KnownBits.{ zeros: u128_and(a.zeros, b.zeros), ones: u128_and(a.ones, b.ones) };
}

fn kb_bit_and(a: *KnownBits, b: *KnownBits) -> KnownBits {
    return KnownBits.{ zeros: u128_or(a.zeros, b.zeros), ones: u128_and(a.ones, b.ones) };
}

fn kb_bit_or(a: *KnownBits, b: *KnownBits) -> KnownBits {
    return KnownBits.{ zeros: u128_and(a.zeros, b.zeros), ones: u128_or(a.ones, b.ones) };
}

fn kb_bit_xor(a: *KnownBits, b: *KnownBits) -> KnownBits {
    let z = u128_or(u128_and(a.zeros, b.zeros), u128_and(a.ones, b.ones));
    let o = u128_or(u128_and(a.zeros, b.ones), u128_and(a.ones, b.zeros));
    return KnownBits.{ zeros: z, ones: o };
}

fn kb_shl(a: *KnownBits, k: u32, bw: u32) -> KnownBits {
    if k >= 128_u32 {
        return kb_from_const(u128_zero());
    }
    let mask = u128_low_mask(bw);
    let low_zeros = u128_low_mask(k);
    let ones = u128_and(u128_shl(a.ones, k), mask);
    let raw_z = u128_or(u128_or(u128_shl(a.zeros, k), low_zeros), u128_not(mask));
    return KnownBits.{ zeros: u128_and(raw_z, u128_not(ones)), ones: ones };
}

fn kb_lshr(a: *KnownBits, k: u32) -> KnownBits {
    if k >= 128_u32 {
        return kb_from_const(u128_zero());
    }
    let high_zeros = if k == 0_u32 {
        u128_zero()
    } else {
        u128_shl(u128_max(), 128_u32 -% k)
    };
    return KnownBits.{ zeros: u128_or(u128_shr(a.zeros, k), high_zeros), ones: u128_shr(a.ones, k) };
}

fn kb_trunc_unsigned(a: *KnownBits, bw: u32) -> KnownBits {
    let mask = u128_low_mask(bw);
    let ones = u128_and(a.ones, mask);
    let zeros = u128_and(u128_or(a.zeros, u128_not(mask)), u128_not(ones));
    return KnownBits.{ zeros: zeros, ones: ones };
}

fn kb_to_nonneg_interval(a: *KnownBits, bw: u32) -> ?Interval {
    let mask = u128_low_mask(bw);
    let lo_u = u128_and(a.ones, mask);
    let hi_u = u128_and(u128_not(a.zeros), mask);
    if u128_le(lo_u, hi_u) {
        if let lo_i = int_val_from_u128_checked(lo_u) {
            if let hi_i = int_val_from_u128_checked(hi_u) {
                return interval_range(lo_i, hi_i);
            }
        }
    }
    return null;
}

// ===========================================================================
// Section 3: Order-Preserving `VarKey` Encoding, `CmpOp`, & `PredArena`
// ===========================================================================

type VarKey = u64;

const VK_NONE: VarKey = 0xFFFFFFFFFFFFFFFF_u64;
const VK_TAG_VAL: u8 = 0_u8;
const VK_TAG_SLOT: u8 = 1_u8;
const VK_TAG_LEN_VAL: u8 = 2_u8;
const VK_TAG_LEN_SLOT: u8 = 3_u8;
const VK_TAG_FIELD_VAL: u8 = 4_u8;
const VK_TAG_FIELD_SLOT: u8 = 5_u8;
const VK_TAG_FIELD_LEN_VAL: u8 = 6_u8;
const VK_TAG_FIELD_LEN_SLOT: u8 = 7_u8;

fn vk_make(tag: u8, a: u32, b: u32) -> VarKey {
    let t = (tag.widen.[u64]() & 7_u64) <<% 61_u64;
    let hi = a.widen.[u64]() <<% 29_u64;
    let lo = b.widen.[u64]() & 0x1FFFFFFF_u64;
    return t | hi | lo;
}

fn vk_tag(k: VarKey) -> u8 {
    return (k >> 61_u64).trunc.[u8]();
}

fn vk_a(k: VarKey) -> u32 {
    return ((k >> 29_u64) & 0xFFFFFFFF_u64).trunc.[u32]();
}

fn vk_b(k: VarKey) -> u32 {
    return (k & 0x1FFFFFFF_u64).trunc.[u32]();
}

fn vk_val(v: eir.EirValue) -> VarKey {
    return vk_make(VK_TAG_VAL, v, 0_u32);
}

fn vk_slot(s: eir.EirSlot) -> VarKey {
    return vk_make(VK_TAG_SLOT, s, 0_u32);
}

fn vk_len_val(v: eir.EirValue) -> VarKey {
    return vk_make(VK_TAG_LEN_VAL, v, 0_u32);
}

fn vk_len_slot(s: eir.EirSlot) -> VarKey {
    return vk_make(VK_TAG_LEN_SLOT, s, 0_u32);
}

fn vk_field_val(v: eir.EirValue, fidx: u32) -> VarKey {
    return vk_make(VK_TAG_FIELD_VAL, v, fidx);
}

fn vk_field_slot(s: eir.EirSlot, fidx: u32) -> VarKey {
    return vk_make(VK_TAG_FIELD_SLOT, s, fidx);
}

fn vk_field_len_val(v: eir.EirValue, fidx: u32) -> VarKey {
    return vk_make(VK_TAG_FIELD_LEN_VAL, v, fidx);
}

fn vk_field_len_slot(s: eir.EirSlot, fidx: u32) -> VarKey {
    return vk_make(VK_TAG_FIELD_LEN_SLOT, s, fidx);
}

fn vk_is_len(k: VarKey) -> bool {
    let t = vk_tag(k);
    return t == VK_TAG_LEN_VAL
        || t == VK_TAG_LEN_SLOT
        || t == VK_TAG_FIELD_LEN_VAL
        || t == VK_TAG_FIELD_LEN_SLOT;
}

fn vk_is_priority(k: VarKey) -> bool {
    return vk_tag(k) != VK_TAG_VAL;
}

fn vk_shared_less(a: VarKey, b: VarKey) -> bool {
    let al = vk_is_len(a);
    let bl = vk_is_len(b);
    if al != bl {
        return al;
    }
    let ap = vk_is_priority(a);
    let bp = vk_is_priority(b);
    if ap != bp {
        return ap;
    }
    return a < b;
}

enum CmpOp : u8 {
    Lt = 0,
    LtEq = 1,
    Gt = 2,
    GtEq = 3,
    Eq = 4,
    NotEq = 5,
}

fn cmp_negate(op: CmpOp) -> CmpOp {
    match op {
        .Lt => { return .GtEq; }
        .LtEq => { return .Gt; }
        .Gt => { return .LtEq; }
        .GtEq => { return .Lt; }
        .Eq => { return .NotEq; }
        .NotEq => { return .Eq; }
    }
}

fn cmp_flip(op: CmpOp) -> CmpOp {
    match op {
        .Lt => { return .Gt; }
        .LtEq => { return .GtEq; }
        .Gt => { return .Lt; }
        .GtEq => { return .LtEq; }
        .Eq => { return .Eq; }
        .NotEq => { return .NotEq; }
    }
}

fn cmp_op_u8(op: CmpOp) -> u8 {
    match op {
        .Lt => { return 0_u8; }
        .LtEq => { return 1_u8; }
        .Gt => { return 2_u8; }
        .GtEq => { return 3_u8; }
        .Eq => { return 4_u8; }
        .NotEq => { return 5_u8; }
    }
}

enum PredKind : u8 {
    Cmp = 0,
    Const = 1,
    Not = 2,
    And = 3,
    Or = 4,
}

fn pred_kind_u8(k: PredKind) -> u8 {
    match k {
        .Cmp => { return 0_u8; }
        .Const => { return 1_u8; }
        .Not => { return 2_u8; }
        .And => { return 3_u8; }
        .Or => { return 4_u8; }
    }
}

struct PredNode {
    kind: PredKind;
    cmp_op: CmpOp;
    bool_val: bool;
    lhs_vk: VarKey;
    rhs_vk: VarKey;
    a: u32;
    b: u32;
}

fn pred_node_eq(x: *PredNode, y: *PredNode) -> bool {
    return x.kind == y.kind
        && x.cmp_op == y.cmp_op
        && x.bool_val == y.bool_val
        && x.lhs_vk == y.lhs_vk
        && x.rhs_vk == y.rhs_vk
        && x.a == y.a
        && x.b == y.b;
}

fn hash_pred_node(p: *PredNode) -> u64 {
    var h: u64 = 0xCBF29CE484222325_u64;
    let p0 = pred_kind_u8(p.kind).widen.[u64]()
        | (cmp_op_u8(p.cmp_op).widen.[u64]() <<% 8_u64)
        | (if p.bool_val { 0x10000_u64 } else { 0_u64 });
    h = (h ^ p0) *% 0x100000001B3_u64;
    h = (h ^ p.lhs_vk) *% 0x100000001B3_u64;
    h = (h ^ p.rhs_vk) *% 0x100000001B3_u64;
    h = (h ^ ((p.a.widen.[u64]() <<% 32_u64) | p.b.widen.[u64]())) *% 0x100000001B3_u64;
    return h;
}

linear struct PredArena {
    nodes: col.DynBuf[PredNode];
    next: col.DynBuf[u32];
    buckets: col.HashMap[u32];
}

impl PredArena {
    fn init(alloc: *mut AllocCap) -> PredArena ! OutOfMemory {
        let nodes = try col.DynBuf.[PredNode].init(alloc, 32_usize);
        errdefer nodes.destroy(alloc);
        let next = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer next.destroy(alloc);
        let buckets = try col.HashMap.[u32].init(alloc, 64_usize);
        errdefer buckets.destroy(alloc);
        return PredArena.{ nodes: nodes, next: next, buckets: buckets };
    }

    fn destroy(self: PredArena, alloc: *mut AllocCap) {
        let PredArena.{ nodes, next, buckets } = self;
        nodes.destroy(alloc);
        next.destroy(alloc);
        buckets.destroy(alloc);
    }

    fn clear(self: *mut Self) {
        self.nodes.clear();
        self.next.clear();
        self.buckets.clear();
    }

    fn intern(self: *mut Self, alloc: *mut AllocCap, node: PredNode) -> u32 ! OutOfMemory {
        let h = hash_pred_node(&node);
        let ns = self.nodes.as_slice();
        let nxs = self.next.as_slice();
        var prev_head = eir.EIR_NONE;
        if let head = self.buckets.get(h) {
            prev_head = head;
            var cur = head;
            while cur != eir.EIR_NONE {
                let idx = cur.widen.[usize]();
                if idx < ns.len && pred_node_eq(&ns[idx], &node) {
                    return cur;
                }
                if idx < nxs.len {
                    cur = nxs[idx];
                } else {
                    break;
                }
            }
        }
        let id = self.nodes.len().trunc.[u32]();
        try self.nodes.push(alloc, node);
        try self.next.push(alloc, prev_head);
        try self.buckets.insert(alloc, h, id);
        return id;
    }

    fn intern_const(self: *mut Self, alloc: *mut AllocCap, b: bool) -> u32 ! OutOfMemory {
        return try self.intern(
            alloc,
            PredNode.{
                kind: .Const,
                cmp_op: .Eq,
                bool_val: b,
                lhs_vk: 0_u64,
                rhs_vk: 0_u64,
                a: 0_u32,
                b: 0_u32,
            },
        );
    }

    fn intern_cmp(
        self: *mut Self,
        alloc: *mut AllocCap,
        op: CmpOp,
        lhs: VarKey,
        rhs: VarKey,
    ) -> u32 ! OutOfMemory {
        return try self.intern(
            alloc,
            PredNode.{
                kind: .Cmp,
                cmp_op: op,
                bool_val: false,
                lhs_vk: lhs,
                rhs_vk: rhs,
                a: 0_u32,
                b: 0_u32,
            },
        );
    }

    fn intern_not(self: *mut Self, alloc: *mut AllocCap, inner: u32) -> u32 ! OutOfMemory {
        return try self.intern(
            alloc,
            PredNode.{
                kind: .Not,
                cmp_op: .Eq,
                bool_val: false,
                lhs_vk: 0_u64,
                rhs_vk: 0_u64,
                a: inner,
                b: 0_u32,
            },
        );
    }

    fn intern_bin(
        self: *mut Self,
        alloc: *mut AllocCap,
        kind: PredKind,
        a: u32,
        b: u32,
    ) -> u32 ! OutOfMemory {
        return try self.intern(
            alloc,
            PredNode.{
                kind: kind,
                cmp_op: .Eq,
                bool_val: false,
                lhs_vk: 0_u64,
                rhs_vk: 0_u64,
                a: a,
                b: b,
            },
        );
    }

    fn get(self: *Self, id: u32) -> ?PredNode {
        let idx = id.widen.[usize]();
        let ns = self.nodes.as_slice();
        if idx < ns.len {
            return ns[idx];
        }
        return null;
    }
}

// ===========================================================================
// Section 4: Sorted Side-Table Entries, Helpers, & Deterministic Heapsorts
// ===========================================================================

struct IntervalEntry {
    key: VarKey;
    iv: Interval;
}

struct ValPredEntry {
    val: u32;
    pred: u32;
}

struct KnownBitsEntry {
    key: VarKey;
    kb: KnownBits;
}

struct PairExprEntry {
    key: VarKey;
    a: VarKey;
    b: VarKey;
    ty: types.TyId;
    no_wrap: bool;
}

struct CheckedOpEntry {
    id: u32;
    op: ast.BinaryOp;
    lhs: u32;
    rhs: u32;
    op_ty: types.TyId;
}

struct ValSlotEntry {
    val: u32;
    slot: u32;
}

fn checked_op_eq(x: *CheckedOpEntry, y: *CheckedOpEntry) -> bool {
    return x.id == y.id
        && x.op == y.op
        && x.lhs == y.lhs
        && x.rhs == y.rhs
        && x.op_ty == y.op_ty;
}

view fn slice_range[T](all: *[T], r: ast.IdRange) -> *[T] {
    let start = r.start.widen.[usize]();
    let end = start +% r.len.widen.[usize]();
    let s = all.sub(start, end) catch {
        return all.sub(0_usize, 0_usize) catch {
            return all;
        };
    };
    return s;
}

fn vk_set_find(xs: *[VarKey], key: VarKey) -> usize {
    var lo: usize = 0_usize;
    var hi = xs.len;
    while lo < hi {
        let mid = lo +% ((hi -% lo) >> 1_usize);
        if mid < xs.len && xs[mid] < key {
            lo = mid +% 1_usize;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn vk_set_contains(xs: *[VarKey], key: VarKey) -> bool {
    let pos = vk_set_find(xs, key);
    return pos < xs.len && xs[pos] == key;
}

fn vk_set_insert(buf: *mut col.DynBuf[VarKey], alloc: *mut AllocCap, key: VarKey) -> !OutOfMemory {
    let old_len = buf.len();
    let pos = vk_set_find(buf.as_slice(), key);
    if pos < old_len {
        let ro = buf.as_slice();
        if pos < ro.len && ro[pos] == key {
            return;
        }
    }
    try buf.push(alloc, key);
    let ms = buf.as_mut_slice();
    var j = old_len;
    while j > pos {
        let prev = j - 1_usize;
        if j < ms.len && prev < ms.len {
            ms[j] = ms[prev];
        }
        j = prev;
    }
    if pos < ms.len {
        ms[pos] = key;
    }
    return;
}

fn vk_set_remove(buf: *mut col.DynBuf[VarKey], key: VarKey) {
    let n = buf.len();
    let pos = vk_set_find(buf.as_slice(), key);
    if pos >= n {
        return;
    }
    let ro = buf.as_slice();
    if pos >= ro.len || ro[pos] != key {
        return;
    }
    let ms = buf.as_mut_slice();
    var j = pos;
    while j +% 1_usize < n {
        let nxt = j +% 1_usize;
        if j < ms.len && nxt < ms.len {
            ms[j] = ms[nxt];
        }
        j = nxt;
    }
    _ = buf.pop();
}

fn vk_set_eq(a: *[VarKey], b: *[VarKey]) -> bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < a.len {
        if a[i] != b[i] {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

fn preds_find(xs: *[ValPredEntry], val: u32) -> usize {
    var lo: usize = 0_usize;
    var hi = xs.len;
    while lo < hi {
        let mid = lo +% ((hi -% lo) >> 1_usize);
        if mid < xs.len && xs[mid].val < val {
            lo = mid +% 1_usize;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn preds_get(xs: *[ValPredEntry], val: u32) -> ?u32 {
    let pos = preds_find(xs, val);
    if pos < xs.len && xs[pos].val == val {
        return xs[pos].pred;
    }
    return null;
}

fn preds_insert(
    buf: *mut col.DynBuf[ValPredEntry],
    alloc: *mut AllocCap,
    val: u32,
    pred: u32,
) -> !OutOfMemory {
    let old_len = buf.len();
    let pos = preds_find(buf.as_slice(), val);
    if pos < old_len {
        let ms0 = buf.as_mut_slice();
        if pos < ms0.len && ms0[pos].val == val {
            ms0[pos].pred = pred;
            return;
        }
    }
    try buf.push(alloc, ValPredEntry.{ val: val, pred: pred });
    let ms = buf.as_mut_slice();
    var j = old_len;
    while j > pos {
        let prev = j - 1_usize;
        if j < ms.len && prev < ms.len {
            ms[j] = ms[prev];
        }
        j = prev;
    }
    if pos < ms.len {
        ms[pos] = ValPredEntry.{ val: val, pred: pred };
    }
    return;
}

fn preds_eq(a: *[ValPredEntry], b: *[ValPredEntry]) -> bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < a.len {
        if a[i].val != b[i].val || a[i].pred != b[i].pred {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

fn kb_map_find(xs: *[KnownBitsEntry], key: VarKey) -> usize {
    var lo: usize = 0_usize;
    var hi = xs.len;
    while lo < hi {
        let mid = lo +% ((hi -% lo) >> 1_usize);
        if mid < xs.len && xs[mid].key < key {
            lo = mid +% 1_usize;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn kb_map_get(xs: *[KnownBitsEntry], key: VarKey) -> ?KnownBits {
    let pos = kb_map_find(xs, key);
    if pos < xs.len && xs[pos].key == key {
        return xs[pos].kb;
    }
    return null;
}

fn kb_map_insert(
    buf: *mut col.DynBuf[KnownBitsEntry],
    alloc: *mut AllocCap,
    key: VarKey,
    kb: KnownBits,
) -> !OutOfMemory {
    let old_len = buf.len();
    let pos = kb_map_find(buf.as_slice(), key);
    if pos < old_len {
        let ms0 = buf.as_mut_slice();
        if pos < ms0.len && ms0[pos].key == key {
            ms0[pos].kb = kb;
            return;
        }
    }
    try buf.push(alloc, KnownBitsEntry.{ key: key, kb: copy kb });
    let ms = buf.as_mut_slice();
    var j = old_len;
    while j > pos {
        let prev = j - 1_usize;
        if j < ms.len && prev < ms.len {
            ms[j] = ms[prev];
        }
        j = prev;
    }
    if pos < ms.len {
        ms[pos] = KnownBitsEntry.{ key: key, kb: kb };
    }
    return;
}

fn kb_map_remove(buf: *mut col.DynBuf[KnownBitsEntry], key: VarKey) {
    let n = buf.len();
    let pos = kb_map_find(buf.as_slice(), key);
    if pos >= n {
        return;
    }
    let ro = buf.as_slice();
    if pos >= ro.len || ro[pos].key != key {
        return;
    }
    let ms = buf.as_mut_slice();
    var j = pos;
    while j +% 1_usize < n {
        let nxt = j +% 1_usize;
        if j < ms.len && nxt < ms.len {
            ms[j] = ms[nxt];
        }
        j = nxt;
    }
    _ = buf.pop();
}

fn kb_map_eq(a: *[KnownBitsEntry], b: *[KnownBitsEntry]) -> bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < a.len {
        if a[i].key != b[i].key || !kb_eq(&a[i].kb, &b[i].kb) {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

fn pair_map_find(xs: *[PairExprEntry], key: VarKey) -> usize {
    var lo: usize = 0_usize;
    var hi = xs.len;
    while lo < hi {
        let mid = lo +% ((hi -% lo) >> 1_usize);
        if mid < xs.len && xs[mid].key < key {
            lo = mid +% 1_usize;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn pair_map_get(xs: *[PairExprEntry], key: VarKey) -> ?PairExprEntry {
    let pos = pair_map_find(xs, key);
    if pos < xs.len && xs[pos].key == key {
        return xs[pos];
    }
    return null;
}

fn pair_map_insert(
    buf: *mut col.DynBuf[PairExprEntry],
    alloc: *mut AllocCap,
    key: VarKey,
    a: VarKey,
    b: VarKey,
    ty: types.TyId,
    no_wrap: bool,
) -> !OutOfMemory {
    let old_len = buf.len();
    let pos = pair_map_find(buf.as_slice(), key);
    if pos < old_len {
        let ms0 = buf.as_mut_slice();
        if pos < ms0.len && ms0[pos].key == key {
            ms0[pos] = PairExprEntry.{ key: key, a: a, b: b, ty: ty, no_wrap: no_wrap };
            return;
        }
    }
    try buf.push(alloc, PairExprEntry.{ key: key, a: a, b: b, ty: ty, no_wrap: no_wrap });
    let ms = buf.as_mut_slice();
    var j = old_len;
    while j > pos {
        let prev = j - 1_usize;
        if j < ms.len && prev < ms.len {
            ms[j] = ms[prev];
        }
        j = prev;
    }
    if pos < ms.len {
        ms[pos] = PairExprEntry.{ key: key, a: a, b: b, ty: ty, no_wrap: no_wrap };
    }
    return;
}

fn pair_map_forget_key(buf: *mut col.DynBuf[PairExprEntry], k: VarKey) {
    let n = buf.len();
    var w: usize = 0_usize;
    var r: usize = 0_usize;
    let ms = buf.as_mut_slice();
    while r < n && r < ms.len {
        let e = ms[r];
        if e.key != k && e.a != k && e.b != k {
            if w < ms.len {
                ms[w] = e;
            }
            w = w +% 1_usize;
        }
        r = r +% 1_usize;
    }
    while buf.len() > w {
        _ = buf.pop();
    }
}

fn pair_map_eq(a: *[PairExprEntry], b: *[PairExprEntry]) -> bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < a.len {
        if a[i].key != b[i].key
            || a[i].a != b[i].a
            || a[i].b != b[i].b
            || a[i].ty != b[i].ty
            || a[i].no_wrap != b[i].no_wrap
        {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

fn checked_map_find(xs: *[CheckedOpEntry], id: u32) -> usize {
    var lo: usize = 0_usize;
    var hi = xs.len;
    while lo < hi {
        let mid = lo +% ((hi -% lo) >> 1_usize);
        if mid < xs.len && xs[mid].id < id {
            lo = mid +% 1_usize;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn checked_map_get(xs: *[CheckedOpEntry], id: u32) -> ?CheckedOpEntry {
    let pos = checked_map_find(xs, id);
    if pos < xs.len && xs[pos].id == id {
        return xs[pos];
    }
    return null;
}

fn checked_map_insert(
    buf: *mut col.DynBuf[CheckedOpEntry],
    alloc: *mut AllocCap,
    entry: CheckedOpEntry,
) -> !OutOfMemory {
    let old_len = buf.len();
    let pos = checked_map_find(buf.as_slice(), entry.id);
    if pos < old_len {
        let ms0 = buf.as_mut_slice();
        if pos < ms0.len && ms0[pos].id == entry.id {
            ms0[pos] = entry;
            return;
        }
    }
    try buf.push(alloc, copy entry);
    let ms = buf.as_mut_slice();
    var j = old_len;
    while j > pos {
        let prev = j - 1_usize;
        if j < ms.len && prev < ms.len {
            ms[j] = ms[prev];
        }
        j = prev;
    }
    if pos < ms.len {
        ms[pos] = entry;
    }
    return;
}

fn checked_map_remove(buf: *mut col.DynBuf[CheckedOpEntry], id: u32) {
    let n = buf.len();
    let pos = checked_map_find(buf.as_slice(), id);
    if pos >= n {
        return;
    }
    let ro = buf.as_slice();
    if pos >= ro.len || ro[pos].id != id {
        return;
    }
    let ms = buf.as_mut_slice();
    var j = pos;
    while j +% 1_usize < n {
        let nxt = j +% 1_usize;
        if j < ms.len && nxt < ms.len {
            ms[j] = ms[nxt];
        }
        j = nxt;
    }
    _ = buf.pop();
}

fn checked_map_eq(a: *[CheckedOpEntry], b: *[CheckedOpEntry]) -> bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < a.len {
        if !checked_op_eq(&a[i], &b[i]) {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

fn val_slot_find(xs: *[ValSlotEntry], val: u32) -> usize {
    var lo: usize = 0_usize;
    var hi = xs.len;
    while lo < hi {
        let mid = lo +% ((hi -% lo) >> 1_usize);
        if mid < xs.len && xs[mid].val < val {
            lo = mid +% 1_usize;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn val_slot_get(xs: *[ValSlotEntry], val: u32) -> ?u32 {
    let pos = val_slot_find(xs, val);
    if pos < xs.len && xs[pos].val == val {
        return xs[pos].slot;
    }
    return null;
}

fn val_slot_insert(
    buf: *mut col.DynBuf[ValSlotEntry],
    alloc: *mut AllocCap,
    val: u32,
    slot: u32,
) -> !OutOfMemory {
    let old_len = buf.len();
    let pos = val_slot_find(buf.as_slice(), val);
    if pos < old_len {
        let ms0 = buf.as_mut_slice();
        if pos < ms0.len && ms0[pos].val == val {
            ms0[pos].slot = slot;
            return;
        }
    }
    try buf.push(alloc, ValSlotEntry.{ val: val, slot: slot });
    let ms = buf.as_mut_slice();
    var j = old_len;
    while j > pos {
        let prev = j - 1_usize;
        if j < ms.len && prev < ms.len {
            ms[j] = ms[prev];
        }
        j = prev;
    }
    if pos < ms.len {
        ms[pos] = ValSlotEntry.{ val: val, slot: slot };
    }
    return;
}

fn val_slot_remove_by_slot(buf: *mut col.DynBuf[ValSlotEntry], slot: u32) {
    let n = buf.len();
    var w: usize = 0_usize;
    var r: usize = 0_usize;
    let ms = buf.as_mut_slice();
    while r < n && r < ms.len {
        let e = ms[r];
        if e.slot != slot {
            if w < ms.len {
                ms[w] = e;
            }
            w = w +% 1_usize;
        }
        r = r +% 1_usize;
    }
    while buf.len() > w {
        _ = buf.pop();
    }
}

fn val_slot_eq(a: *[ValSlotEntry], b: *[ValSlotEntry]) -> bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < a.len {
        if a[i].val != b[i].val || a[i].slot != b[i].slot {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

fn sift_down_iv_entries(xs: *mut [IntervalEntry], start: usize, end: usize) {
    if start >= xs.len {
        return;
    }
    let val = xs[start];
    let val_key = val.key;
    var root = start;
    while (root *% 2_usize) +% 1_usize < end {
        var child = (root *% 2_usize) +% 1_usize;
        if child >= xs.len {
            break;
        }
        let right = child +% 1_usize;
        if right < end && right < xs.len && xs[child].key < xs[right].key {
            child = right;
        }
        if !(val_key < xs[child].key) {
            break;
        }
        xs[root] = xs[child];
        root = child;
    }
    xs[root] = val;
}

fn sort_iv_entries(xs: *mut [IntervalEntry]) {
    let n = xs.len;
    if n < 2_usize {
        return;
    }
    if n <= 24_usize {
        var i: usize = 1_usize;
        while i < n && i < xs.len {
            let v = xs[i];
            let vk = v.key;
            var j = i;
            while j > 0_usize {
                let prev = j - 1_usize;
                if prev < xs.len && j < xs.len && vk < xs[prev].key {
                    xs[j] = xs[prev];
                    j = prev;
                } else {
                    break;
                }
            }
            xs[j] = v;
            i = i +% 1_usize;
        }
        return;
    }
    var i = n >> 1_usize;
    while i > 0_usize {
        i = i - 1_usize;
        sift_down_iv_entries(xs, i, n);
    }
    var end = n;
    while end > 1_usize {
        end = end - 1_usize;
        let tmp = xs[0_usize];
        xs[0_usize] = xs[end];
        xs[end] = tmp;
        sift_down_iv_entries(xs, 0_usize, end);
    }
}

fn sort_shared_verts(xs: *mut [VarKey]) {
    let n = xs.len;
    var i: usize = 1_usize;
    while i < n && i < xs.len {
        let key = xs[i];
        var j = i;
        while j > 0_usize {
            let prev = j - 1_usize;
            if prev < xs.len && j < xs.len && vk_shared_less(key, xs[prev]) {
                xs[j] = xs[prev];
                j = prev;
            } else {
                break;
            }
        }
        xs[j] = key;
        i = i +% 1_usize;
    }
}

fn sort_val_ranges(xs: *mut [eir.EirValRange]) {
    let n = xs.len;
    if n < 2_usize {
        return;
    }
    var i = n >> 1_usize;
    while i > 0_usize {
        i = i - 1_usize;
        var root = i;
        while (root *% 2_usize) +% 1_usize < n {
            let child = (root *% 2_usize) +% 1_usize;
            var sw = root;
            if sw < xs.len && child < xs.len && xs[sw].val < xs[child].val {
                sw = child;
            }
            let right = child +% 1_usize;
            if right < n && sw < xs.len && right < xs.len && xs[sw].val < xs[right].val {
                sw = right;
            }
            if sw == root {
                break;
            }
            if root < xs.len && sw < xs.len {
                let tmp = xs[root];
                xs[root] = xs[sw];
                xs[sw] = tmp;
            }
            root = sw;
        }
    }
    var end = n;
    while end > 1_usize {
        end = end - 1_usize;
        let top = xs[0_usize];
        xs[0_usize] = xs[end];
        xs[end] = top;
        var root: usize = 0_usize;
        while (root *% 2_usize) +% 1_usize < end {
            let child = (root *% 2_usize) +% 1_usize;
            var sw = root;
            if sw < xs.len && child < xs.len && xs[sw].val < xs[child].val {
                sw = child;
            }
            let right = child +% 1_usize;
            if right < end && sw < xs.len && right < xs.len && xs[sw].val < xs[right].val {
                sw = right;
            }
            if sw == root {
                break;
            }
            if root < xs.len && sw < xs.len {
                let tmp = xs[root];
                xs[root] = xs[sw];
                xs[sw] = tmp;
            }
            root = sw;
        }
    }
}

fn proven_safe_less(a: eir.EirProvenSafeInst, b: eir.EirProvenSafeInst) -> bool {
    if a.bb != b.bb {
        return a.bb < b.bb;
    }
    return a.inst_idx < b.inst_idx;
}

fn sort_proven_safe(xs: *mut [eir.EirProvenSafeInst]) {
    let n = xs.len;
    if n < 2_usize {
        return;
    }
    var i = n >> 1_usize;
    while i > 0_usize {
        i = i - 1_usize;
        var root = i;
        while (root *% 2_usize) +% 1_usize < n {
            let child = (root *% 2_usize) +% 1_usize;
            var sw = root;
            if sw < xs.len && child < xs.len && proven_safe_less(xs[sw], xs[child]) {
                sw = child;
            }
            let right = child +% 1_usize;
            if right < n && sw < xs.len && right < xs.len && proven_safe_less(xs[sw], xs[right]) {
                sw = right;
            }
            if sw == root {
                break;
            }
            if root < xs.len && sw < xs.len {
                let tmp = xs[root];
                xs[root] = xs[sw];
                xs[sw] = tmp;
            }
            root = sw;
        }
    }
    var end = n;
    while end > 1_usize {
        end = end - 1_usize;
        let top = xs[0_usize];
        xs[0_usize] = xs[end];
        xs[end] = top;
        var root: usize = 0_usize;
        while (root *% 2_usize) +% 1_usize < end {
            let child = (root *% 2_usize) +% 1_usize;
            var sw = root;
            if sw < xs.len && child < xs.len && proven_safe_less(xs[sw], xs[child]) {
                sw = child;
            }
            let right = child +% 1_usize;
            if right < end && sw < xs.len && right < xs.len && proven_safe_less(xs[sw], xs[right]) {
                sw = right;
            }
            if sw == root {
                break;
            }
            if root < xs.len && sw < xs.len {
                let tmp = xs[root];
                xs[root] = xs[sw];
                xs[sw] = tmp;
            }
            root = sw;
        }
    }
}

// ===========================================================================
// Section 5: `DbmCore`, `DbmAux`, `DbmState`, `StateSnap`, & `StatePool`
// ===========================================================================

linear struct DbmCore {
    is_bottom: bool;
    is_closed: bool;
    unsynced_mask: u64;
    intervals: col.HashMap[Interval];
    verts: col.DynBuf[VarKey];
    vmap: col.HashMap[u32];
    mat: col.DynBuf[Bound];
    mat_stride: usize;
}

impl DbmCore {
    fn init(alloc: *mut AllocCap) -> DbmCore ! OutOfMemory {
        let intervals = try col.HashMap.[Interval].init(alloc, 32_usize);
        errdefer intervals.destroy(alloc);
        var verts = try col.DynBuf.[VarKey].init(alloc, 8_usize);
        errdefer verts.destroy(alloc);
        let vmap = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer vmap.destroy(alloc);
        var mat = try col.DynBuf.[Bound].init(alloc, 64_usize);
        errdefer mat.destroy(alloc);
        try verts.push(alloc, VK_NONE);
        var i: usize = 0_usize;
        while i < 64_usize {
            try mat.push(alloc, bound_none());
            i = i +% 1_usize;
        }
        let ms = mat.as_mut_slice();
        if ms.len > 0_usize {
            ms[0_usize] = bound_some(types.int_val_zero());
        }
        return DbmCore.{
            is_bottom: false,
            is_closed: true,
            unsynced_mask: 0_u64,
            intervals: intervals,
            verts: verts,
            vmap: vmap,
            mat: mat,
            mat_stride: 8_usize,
        };
    }

    fn destroy(self: DbmCore, alloc: *mut AllocCap) {
        let DbmCore.{ is_bottom: _, is_closed: _, unsynced_mask: _, intervals, verts, vmap, mat, mat_stride: _ } = self;
        intervals.destroy(alloc);
        verts.destroy(alloc);
        vmap.destroy(alloc);
        mat.destroy(alloc);
    }

    fn reset(self: *mut Self, alloc: *mut AllocCap, is_bottom: bool) -> !OutOfMemory {
        self.is_bottom = is_bottom;
        self.is_closed = true;
        self.unsynced_mask = 0_u64;
        self.intervals.clear();
        self.verts.clear();
        self.vmap.clear();
        try self.verts.push(alloc, VK_NONE);
        if self.mat_stride == 0_usize {
            self.mat_stride = 8_usize;
            while self.mat.len() < 64_usize {
                try self.mat.push(alloc, bound_none());
            }
        }
        let ms = self.mat.as_mut_slice();
        if ms.len > 0_usize {
            ms[0_usize] = bound_some(types.int_val_zero());
        }
        return;
    }

    fn ensure_mat_stride(self: *mut Self, alloc: *mut AllocCap, need: usize) -> !OutOfMemory {
        if need <= self.mat_stride && (self.mat_stride *% self.mat_stride) <= self.mat.len() {
            return;
        }
        var ns = if self.mat_stride < 8_usize { 8_usize } else { self.mat_stride };
        while ns < need {
            ns = ns *% 2_usize;
        }
        if ns > MAX_DBM_VERTS +% 1_usize {
            ns = MAX_DBM_VERTS +% 1_usize;
        }
        if ns < need {
            ns = need;
        }
        let total = ns *% ns;
        var nmat = try col.DynBuf.[Bound].init(alloc, total);
        errdefer nmat.destroy(alloc);
        var k: usize = 0_usize;
        while k < total {
            try nmat.push(alloc, bound_none());
            k = k +% 1_usize;
        }
        let old_n = self.verts.len();
        let old_s = self.mat_stride;
        let old_ro = self.mat.as_slice();
        let new_mut = nmat.as_mut_slice();
        var r: usize = 0_usize;
        while r < old_n {
            var c: usize = 0_usize;
            while c < old_n {
                let oi = (r *% old_s) +% c;
                let ni = (r *% ns) +% c;
                if oi < old_ro.len && ni < new_mut.len {
                    new_mut[ni] = old_ro[oi];
                }
                c = c +% 1_usize;
            }
            r = r +% 1_usize;
        }
        self.mat.destroy(alloc);
        self.mat = nmat;
        self.mat_stride = ns;
        return;
    }

    fn mat_get(self: *Self, r: usize, c: usize) -> Bound {
        let idx = (r *% self.mat_stride) +% c;
        let ms = self.mat.as_slice();
        if idx < ms.len {
            return ms[idx];
        }
        return bound_none();
    }

    fn mat_set(self: *mut Self, r: usize, c: usize, b: Bound) {
        let idx = (r *% self.mat_stride) +% c;
        let ms = self.mat.as_mut_slice();
        if idx < ms.len {
            ms[idx] = b;
        }
    }
}

linear struct DbmAux {
    non_zero: col.DynBuf[VarKey];
    preds: col.DynBuf[ValPredEntry];
    known_bits: col.DynBuf[KnownBitsEntry];
    diff_exprs: col.DynBuf[PairExprEntry];
    sum_exprs: col.DynBuf[PairExprEntry];
    checked_op: col.DynBuf[CheckedOpEntry];
    slot_checked_op: col.DynBuf[CheckedOpEntry];
    val_slot_origin: col.DynBuf[ValSlotEntry];
    const_lits: col.DynBuf[VarKey];
}

impl DbmAux {
    fn init(alloc: *mut AllocCap) -> DbmAux ! OutOfMemory {
        let non_zero = try col.DynBuf.[VarKey].init(alloc, 8_usize);
        errdefer non_zero.destroy(alloc);
        let preds = try col.DynBuf.[ValPredEntry].init(alloc, 16_usize);
        errdefer preds.destroy(alloc);
        let known_bits = try col.DynBuf.[KnownBitsEntry].init(alloc, 8_usize);
        errdefer known_bits.destroy(alloc);
        let diff_exprs = try col.DynBuf.[PairExprEntry].init(alloc, 8_usize);
        errdefer diff_exprs.destroy(alloc);
        let sum_exprs = try col.DynBuf.[PairExprEntry].init(alloc, 8_usize);
        errdefer sum_exprs.destroy(alloc);
        let checked_op = try col.DynBuf.[CheckedOpEntry].init(alloc, 4_usize);
        errdefer checked_op.destroy(alloc);
        let slot_checked_op = try col.DynBuf.[CheckedOpEntry].init(alloc, 4_usize);
        errdefer slot_checked_op.destroy(alloc);
        let val_slot_origin = try col.DynBuf.[ValSlotEntry].init(alloc, 8_usize);
        errdefer val_slot_origin.destroy(alloc);
        let const_lits = try col.DynBuf.[VarKey].init(alloc, 16_usize);
        errdefer const_lits.destroy(alloc);
        return DbmAux.{
            non_zero: non_zero,
            preds: preds,
            known_bits: known_bits,
            diff_exprs: diff_exprs,
            sum_exprs: sum_exprs,
            checked_op: checked_op,
            slot_checked_op: slot_checked_op,
            val_slot_origin: val_slot_origin,
            const_lits: const_lits,
        };
    }

    fn destroy(self: DbmAux, alloc: *mut AllocCap) {
        let DbmAux.{
            non_zero,
            preds,
            known_bits,
            diff_exprs,
            sum_exprs,
            checked_op,
            slot_checked_op,
            val_slot_origin,
            const_lits,
        } = self;
        non_zero.destroy(alloc);
        preds.destroy(alloc);
        known_bits.destroy(alloc);
        diff_exprs.destroy(alloc);
        sum_exprs.destroy(alloc);
        checked_op.destroy(alloc);
        slot_checked_op.destroy(alloc);
        val_slot_origin.destroy(alloc);
        const_lits.destroy(alloc);
    }

    fn clear(self: *mut Self) {
        self.non_zero.clear();
        self.preds.clear();
        self.known_bits.clear();
        self.diff_exprs.clear();
        self.sum_exprs.clear();
        self.checked_op.clear();
        self.slot_checked_op.clear();
        self.val_slot_origin.clear();
        self.const_lits.clear();
    }
}

linear struct DbmState {
    core: DbmCore;
    aux: DbmAux;
    filter_active: bool;
    rel_vals: col.BitSet;
    rel_slots: col.BitSet;
    cross_active: bool;
    cross_vals: col.BitSet;
    const_int_vals: col.BitSet;
    mut_addr_slots: col.BitSet;
    val_tb: col.DynBuf[types.IntBounds];
    slot_tb: col.DynBuf[types.IntBounds];
    prof_loads: u64;
    prof_copies: u64;
}

impl DbmState {
    fn init(alloc: *mut AllocCap) -> DbmState ! OutOfMemory {
        let core = try DbmCore.init(alloc);
        errdefer core.destroy(alloc);
        let aux = try DbmAux.init(alloc);
        errdefer aux.destroy(alloc);
        let rel_vals = try col.BitSet.init(alloc, 0_usize);
        errdefer rel_vals.destroy(alloc);
        let rel_slots = try col.BitSet.init(alloc, 0_usize);
        errdefer rel_slots.destroy(alloc);
        let cross_vals = try col.BitSet.init(alloc, 0_usize);
        errdefer cross_vals.destroy(alloc);
        let const_int_vals = try col.BitSet.init(alloc, 0_usize);
        errdefer const_int_vals.destroy(alloc);
        let mut_addr_slots = try col.BitSet.init(alloc, 0_usize);
        errdefer mut_addr_slots.destroy(alloc);
        let val_tb = try col.DynBuf.[types.IntBounds].init(alloc, 0_usize);
        errdefer val_tb.destroy(alloc);
        let slot_tb = try col.DynBuf.[types.IntBounds].init(alloc, 0_usize);
        errdefer slot_tb.destroy(alloc);
        return DbmState.{
            core: core,
            aux: aux,
            filter_active: false,
            rel_vals: rel_vals,
            rel_slots: rel_slots,
            cross_active: false,
            cross_vals: cross_vals,
            const_int_vals: const_int_vals,
            mut_addr_slots: mut_addr_slots,
            val_tb: val_tb,
            slot_tb: slot_tb,
            prof_loads: 0_u64,
            prof_copies: 0_u64,
        };
    }

    fn destroy(self: DbmState, alloc: *mut AllocCap) {
        let DbmState.{ core, aux, filter_active: _, rel_vals, rel_slots, cross_active: _, cross_vals, const_int_vals, mut_addr_slots, val_tb, slot_tb, prof_loads: _, prof_copies: _ } = self;
        core.destroy(alloc);
        aux.destroy(alloc);
        rel_vals.destroy(alloc);
        rel_slots.destroy(alloc);
        cross_vals.destroy(alloc);
        const_int_vals.destroy(alloc);
        mut_addr_slots.destroy(alloc);
        val_tb.destroy(alloc);
        slot_tb.destroy(alloc);
    }

    fn is_const_lit(self: *Self, k: VarKey) -> bool {
        if vk_tag(k) == VK_TAG_VAL && self.const_int_vals.test(vk_a(k).widen.[usize]()) {
            return true;
        }
        return vk_set_contains(self.aux.const_lits.as_slice(), k);
    }

    fn get_known_bits(self: *Self, k: VarKey) -> ?KnownBits {
        if vk_tag(k) == VK_TAG_VAL {
            let idx = vk_a(k).widen.[usize]();
            if self.const_int_vals.test(idx) {
                let s = self.val_tb.as_slice();
                if idx < s.len && s[idx].valid && !types.int_val_is_neg(s[idx].min) {
                    return kb_from_const(u128_from_nonneg(s[idx].min));
                }
                return null;
            }
        }
        return kb_map_get(self.aux.known_bits.as_slice(), k);
    }

    fn default_interval(self: *Self, k: VarKey) -> Interval {
        let t = vk_tag(k);
        if t == VK_TAG_VAL {
            let idx = vk_a(k).widen.[usize]();
            let s = self.val_tb.as_slice();
            if idx < s.len && s[idx].valid {
                return tb_to_interval(s[idx]);
            }
            return interval_top();
        }
        if t == VK_TAG_SLOT {
            let idx = vk_a(k).widen.[usize]();
            let s = self.slot_tb.as_slice();
            if idx < s.len && s[idx].valid {
                return tb_to_interval(s[idx]);
            }
            return interval_top();
        }
        return interval_top();
    }

    fn is_trivial_interval(self: *Self, k: VarKey, iv: *Interval) -> bool {
        let t = vk_tag(k);
        if t == VK_TAG_VAL {
            let idx = vk_a(k).widen.[usize]();
            let s = self.val_tb.as_slice();
            if idx < s.len {
                let tb = s[idx];
                if tb.valid {
                    if tb.has_max {
                        return iv.has_lo && iv.has_hi && types.int_val_eq(iv.lo, tb.min) && types.int_val_eq(iv.hi, tb.max);
                    }
                    return iv.has_lo && !iv.has_hi && types.int_val_eq(iv.lo, tb.min);
                }
                return !iv.has_lo && !iv.has_hi;
            }
            return false;
        }
        if t == VK_TAG_SLOT {
            let idx = vk_a(k).widen.[usize]();
            let s = self.slot_tb.as_slice();
            if idx < s.len {
                let tb = s[idx];
                if tb.valid {
                    if tb.has_max {
                        return iv.has_lo && iv.has_hi && types.int_val_eq(iv.lo, tb.min) && types.int_val_eq(iv.hi, tb.max);
                    }
                    return iv.has_lo && !iv.has_hi && types.int_val_eq(iv.lo, tb.min);
                }
                return !iv.has_lo && !iv.has_hi;
            }
            return false;
        }
        return false;
    }

    fn put_interval_if_nontrivial(self: *mut Self, alloc: *mut AllocCap, k: VarKey, iv: Interval) -> !OutOfMemory {
        if self.is_trivial_interval(k, &iv) {
            _ = self.core.intervals.remove(k);
            return;
        }
        try self.core.intervals.insert(alloc, k, iv);
        return;
    }

    fn var_is_relational(self: *Self, k: VarKey) -> bool {
        if !self.filter_active {
            return true;
        }
        let t = vk_tag(k);
        if t == VK_TAG_VAL {
            return self.rel_vals.test(vk_a(k).widen.[usize]());
        }
        if t == VK_TAG_SLOT {
            return self.rel_slots.test(vk_a(k).widen.[usize]());
        }
        return true;
    }

    fn keep_on_edge(self: *Self, k: VarKey) -> bool {
        if !self.cross_active {
            return true;
        }
        let t = vk_tag(k);
        if t == VK_TAG_VAL || t == VK_TAG_LEN_VAL || t == VK_TAG_FIELD_VAL || t == VK_TAG_FIELD_LEN_VAL {
            if self.cross_vals.test(vk_a(k).widen.[usize]()) {
                return true;
            }
            return self.core.vmap.contains(k);
        }
        return true;
    }

    fn keep_val_on_edge(self: *Self, v: eir.EirValue) -> bool {
        if !self.cross_active {
            return true;
        }
        return self.cross_vals.test(v.widen.[usize]());
    }

    fn reset_top(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.core.reset(alloc, false);
        self.aux.clear();
        return;
    }

    fn reset_bottom(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.core.reset(alloc, true);
        self.aux.clear();
        return;
    }
}

struct StateSnap {
    valid: bool;
    is_bottom: bool;
    is_closed: bool;
    unsynced_mask: u64;
    intervals: ast.IdRange;
    verts: ast.IdRange;
    mat: ast.IdRange;
    non_zero: ast.IdRange;
    preds: ast.IdRange;
    known_bits: ast.IdRange;
    diff_exprs: ast.IdRange;
    sum_exprs: ast.IdRange;
    checked_op: ast.IdRange;
    slot_checked_op: ast.IdRange;
    val_slot_origin: ast.IdRange;
    const_lits: ast.IdRange;
}

fn snap_bottom() -> StateSnap {
    return StateSnap.{
        valid: true,
        is_bottom: true,
        is_closed: true,
        unsynced_mask: 0_u64,
        intervals: ast.range_empty(),
        verts: ast.range_empty(),
        mat: ast.range_empty(),
        non_zero: ast.range_empty(),
        preds: ast.range_empty(),
        known_bits: ast.range_empty(),
        diff_exprs: ast.range_empty(),
        sum_exprs: ast.range_empty(),
        checked_op: ast.range_empty(),
        slot_checked_op: ast.range_empty(),
        val_slot_origin: ast.range_empty(),
        const_lits: ast.range_empty(),
    };
}

struct SparseBound {
    rc: u16;
    val: types.IntVal;
}

fn sparse_rc(r: usize, c: usize) -> u16 {
    return ((r <<% 8_usize) | (c & 0xFF_usize)).trunc.[u16]();
}

linear struct StatePoolCore {
    intervals: col.DynBuf[IntervalEntry];
    verts: col.DynBuf[VarKey];
    mat: col.DynBuf[SparseBound];
}

impl StatePoolCore {
    fn init(alloc: *mut AllocCap) -> StatePoolCore ! OutOfMemory {
        let intervals = try col.DynBuf.[IntervalEntry].init(alloc, 256_usize);
        errdefer intervals.destroy(alloc);
        let verts = try col.DynBuf.[VarKey].init(alloc, 128_usize);
        errdefer verts.destroy(alloc);
        let mat = try col.DynBuf.[SparseBound].init(alloc, 256_usize);
        errdefer mat.destroy(alloc);
        return StatePoolCore.{ intervals: intervals, verts: verts, mat: mat };
    }

    fn destroy(self: StatePoolCore, alloc: *mut AllocCap) {
        let StatePoolCore.{ intervals, verts, mat } = self;
        intervals.destroy(alloc);
        verts.destroy(alloc);
        mat.destroy(alloc);
    }
}

linear struct StatePoolAux {
    non_zero: col.DynBuf[VarKey];
    preds: col.DynBuf[ValPredEntry];
    known_bits: col.DynBuf[KnownBitsEntry];
    diff_exprs: col.DynBuf[PairExprEntry];
    sum_exprs: col.DynBuf[PairExprEntry];
    checked_op: col.DynBuf[CheckedOpEntry];
    slot_checked_op: col.DynBuf[CheckedOpEntry];
    val_slot_origin: col.DynBuf[ValSlotEntry];
    const_lits: col.DynBuf[VarKey];
}

impl StatePoolAux {
    fn init(alloc: *mut AllocCap) -> StatePoolAux ! OutOfMemory {
        let non_zero = try col.DynBuf.[VarKey].init(alloc, 64_usize);
        errdefer non_zero.destroy(alloc);
        let preds = try col.DynBuf.[ValPredEntry].init(alloc, 128_usize);
        errdefer preds.destroy(alloc);
        let known_bits = try col.DynBuf.[KnownBitsEntry].init(alloc, 64_usize);
        errdefer known_bits.destroy(alloc);
        let diff_exprs = try col.DynBuf.[PairExprEntry].init(alloc, 64_usize);
        errdefer diff_exprs.destroy(alloc);
        let sum_exprs = try col.DynBuf.[PairExprEntry].init(alloc, 64_usize);
        errdefer sum_exprs.destroy(alloc);
        let checked_op = try col.DynBuf.[CheckedOpEntry].init(alloc, 16_usize);
        errdefer checked_op.destroy(alloc);
        let slot_checked_op = try col.DynBuf.[CheckedOpEntry].init(alloc, 16_usize);
        errdefer slot_checked_op.destroy(alloc);
        let val_slot_origin = try col.DynBuf.[ValSlotEntry].init(alloc, 64_usize);
        errdefer val_slot_origin.destroy(alloc);
        let const_lits = try col.DynBuf.[VarKey].init(alloc, 128_usize);
        errdefer const_lits.destroy(alloc);
        return StatePoolAux.{
            non_zero: non_zero,
            preds: preds,
            known_bits: known_bits,
            diff_exprs: diff_exprs,
            sum_exprs: sum_exprs,
            checked_op: checked_op,
            slot_checked_op: slot_checked_op,
            val_slot_origin: val_slot_origin,
            const_lits: const_lits,
        };
    }

    fn destroy(self: StatePoolAux, alloc: *mut AllocCap) {
        let StatePoolAux.{
            non_zero,
            preds,
            known_bits,
            diff_exprs,
            sum_exprs,
            checked_op,
            slot_checked_op,
            val_slot_origin,
            const_lits,
        } = self;
        non_zero.destroy(alloc);
        preds.destroy(alloc);
        known_bits.destroy(alloc);
        diff_exprs.destroy(alloc);
        sum_exprs.destroy(alloc);
        checked_op.destroy(alloc);
        slot_checked_op.destroy(alloc);
        val_slot_origin.destroy(alloc);
        const_lits.destroy(alloc);
    }
}

fn vk_is_ssa(k: VarKey) -> bool {
    let t = vk_tag(k);
    return t == VK_TAG_VAL || t == VK_TAG_LEN_VAL || t == VK_TAG_FIELD_VAL || t == VK_TAG_FIELD_LEN_VAL;
}

fn word_bit_set(buf: *mut [u64], bi: usize, wpb: usize, cid: usize) {
    let idx = (bi *% wpb) +% (cid >> 6_usize);
    if idx < buf.len {
        buf[idx] = buf[idx] | (1_u64 <<% (cid.trunc.[u64]() & 63_u64));
    }
}

fn word_bit_test(buf: *[u64], bi: usize, wpb: usize, cid: usize) -> bool {
    let idx = (bi *% wpb) +% (cid >> 6_usize);
    if idx < buf.len {
        return (buf[idx] & (1_u64 <<% (cid.trunc.[u64]() & 63_u64))) != 0_u64;
    }
    return false;
}

fn propagate_live_succ(
    live_in: *mut [u64],
    phi_def: *[u64],
    def_body: *[u64],
    wpb: usize,
    pred_bi: usize,
    succ_bi: usize,
) -> bool {
    let p_base = pred_bi *% wpb;
    let s_base = succ_bi *% wpb;
    var any = false;
    var w: usize = 0_usize;
    while w < wpb {
        let pi = p_base +% w;
        let si = s_base +% w;
        if pi < live_in.len && si < live_in.len && si < phi_def.len && pi < def_body.len {
            let add = (live_in[si] & (~phi_def[si])) & (~def_body[pi]);
            let old = live_in[pi];
            let nw = old | add;
            if nw != old {
                live_in[pi] = nw;
                any = true;
            }
        }
        w = w +% 1_usize;
    }
    return any;
}

fn ensure_zero_u64_buf(alloc: *mut AllocCap, buf: *mut col.DynBuf[u64], n: usize) -> !OutOfMemory {
    buf.clear();
    try buf.reserve(alloc, n);
    var i: usize = 0_usize;
    while i < n {
        try buf.push(alloc, 0_u64);
        i = i +% 1_usize;
    }
    return;
}

linear struct BlockLiveness {
    active: bool;
    n_blocks: usize;
    n_vals: usize;
    words_per_blk: usize;
    val_to_cid: col.DynBuf[u32];
    live_in: col.DynBuf[u64];
    def_body: col.DynBuf[u64];
    phi_def: col.DynBuf[u64];
    def_bb: col.DynBuf[u32];
    cross_bs: col.BitSet;
    live_phis: col.BitSet;
    block_live_phis: col.BitSet;
    real_uses: col.BitSet;
    val_to_phi: col.DynBuf[u32];
    phi_worklist: col.DynBuf[u32];
    tmp_uses: col.DynBuf[eir.EirValue];
}

impl BlockLiveness {
    fn init(alloc: *mut AllocCap) -> BlockLiveness ! OutOfMemory {
        let val_to_cid = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer val_to_cid.destroy(alloc);
        let live_in = try col.DynBuf.[u64].init(alloc, 16_usize);
        errdefer live_in.destroy(alloc);
        let def_body = try col.DynBuf.[u64].init(alloc, 16_usize);
        errdefer def_body.destroy(alloc);
        let phi_def = try col.DynBuf.[u64].init(alloc, 16_usize);
        errdefer phi_def.destroy(alloc);
        let def_bb = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer def_bb.destroy(alloc);
        let cross_bs = try col.BitSet.init(alloc, 0_usize);
        errdefer cross_bs.destroy(alloc);
        let live_phis = try col.BitSet.init(alloc, 0_usize);
        errdefer live_phis.destroy(alloc);
        let block_live_phis = try col.BitSet.init(alloc, 0_usize);
        errdefer block_live_phis.destroy(alloc);
        let real_uses = try col.BitSet.init(alloc, 0_usize);
        errdefer real_uses.destroy(alloc);
        let val_to_phi = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer val_to_phi.destroy(alloc);
        let phi_worklist = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer phi_worklist.destroy(alloc);
        let tmp_uses = try col.DynBuf.[eir.EirValue].init(alloc, 8_usize);
        errdefer tmp_uses.destroy(alloc);
        return BlockLiveness.{
            active: false,
            n_blocks: 0_usize,
            n_vals: 0_usize,
            words_per_blk: 0_usize,
            val_to_cid: val_to_cid,
            live_in: live_in,
            def_body: def_body,
            phi_def: phi_def,
            def_bb: def_bb,
            cross_bs: cross_bs,
            live_phis: live_phis,
            block_live_phis: block_live_phis,
            real_uses: real_uses,
            val_to_phi: val_to_phi,
            phi_worklist: phi_worklist,
            tmp_uses: tmp_uses,
        };
    }

    fn destroy(self: BlockLiveness, alloc: *mut AllocCap) {
        let BlockLiveness.{
            active: _,
            n_blocks: _,
            n_vals: _,
            words_per_blk: _,
            val_to_cid,
            live_in,
            def_body,
            phi_def,
            def_bb,
            cross_bs,
            live_phis,
            block_live_phis,
            real_uses,
            val_to_phi,
            phi_worklist,
            tmp_uses,
        } = self;
        val_to_cid.destroy(alloc);
        live_in.destroy(alloc);
        def_body.destroy(alloc);
        phi_def.destroy(alloc);
        def_bb.destroy(alloc);
        cross_bs.destroy(alloc);
        live_phis.destroy(alloc);
        block_live_phis.destroy(alloc);
        real_uses.destroy(alloc);
        val_to_phi.destroy(alloc);
        phi_worklist.destroy(alloc);
        tmp_uses.destroy(alloc);
    }

    fn reset(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        self.active = false;
        self.n_blocks = 0_usize;
        self.n_vals = 0_usize;
        self.words_per_blk = 0_usize;
        if self.live_in.cap() > 131072_usize {
            let nl = try col.DynBuf.[u64].init(alloc, 64_usize);
            self.live_in.destroy(alloc);
            self.live_in = nl;
            let nd = try col.DynBuf.[u64].init(alloc, 64_usize);
            self.def_body.destroy(alloc);
            self.def_body = nd;
            let np = try col.DynBuf.[u64].init(alloc, 64_usize);
            self.phi_def.destroy(alloc);
            self.phi_def = np;
        } else {
            self.live_in.clear();
            self.def_body.clear();
            self.phi_def.clear();
        }
        self.val_to_cid.clear();
        self.def_bb.clear();
        self.cross_bs.clear();
        self.live_phis.clear();
        self.block_live_phis.clear();
        self.real_uses.clear();
        self.val_to_phi.clear();
        self.phi_worklist.clear();
        self.tmp_uses.clear();
        return;
    }

    fn is_live_phi(self: *Self, v: eir.EirValue) -> bool {
        if !self.active {
            return true;
        }
        return self.live_phis.test(v.widen.[usize]());
    }

    fn block_has_live_phis(self: *Self, bb: cfg_ir.BlockId) -> bool {
        if !self.active {
            return true;
        }
        return self.block_live_phis.test(bb.widen.[usize]());
    }

    fn is_live(self: *Self, bb: cfg_ir.BlockId, v: eir.EirValue) -> bool {
        if !self.active {
            return true;
        }
        let vi = v.widen.[usize]();
        let v2c = self.val_to_cid.as_slice();
        if vi >= v2c.len {
            return false;
        }
        let cid_u32 = v2c[vi];
        if cid_u32 == 0xFFFFFFFF_u32 {
            return false;
        }
        let bi = bb.widen.[usize]();
        let wpb = self.words_per_blk;
        if bi >= self.n_blocks || wpb == 0_usize {
            return false;
        }
        let cid = cid_u32.widen.[usize]();
        let idx = (bi *% wpb) +% (cid >> 6_usize);
        let ls = self.live_in.as_slice();
        if idx < ls.len {
            return (ls[idx] & (1_u64 <<% (cid.trunc.[u64]() & 63_u64))) != 0_u64;
        }
        return false;
    }

    fn blocks_equal(self: *Self, bb0: cfg_ir.BlockId, bb1: cfg_ir.BlockId) -> bool {
        if bb0 == bb1 || !self.active {
            return true;
        }
        let wpb = self.words_per_blk;
        if wpb == 0_usize {
            return true;
        }
        let b0 = bb0.widen.[usize]();
        let b1 = bb1.widen.[usize]();
        if b0 >= self.n_blocks || b1 >= self.n_blocks {
            return false;
        }
        let ls = self.live_in.as_slice();
        let base0 = b0 *% wpb;
        let base1 = b1 *% wpb;
        var w: usize = 0_usize;
        while w < wpb {
            let i0 = base0 +% w;
            let i1 = base1 +% w;
            if i0 >= ls.len || i1 >= ls.len || ls[i0] != ls[i1] {
                return false;
            }
            w = w +% 1_usize;
        }
        return true;
    }

    fn compute_for_fn(
        self: *mut Self,
        alloc: *mut AllocCap,
        eir_prog: *eir.EirProgram,
        fn_id: u32,
        f: *eir.EirFunction,
        nvals: usize,
    ) -> !OutOfMemory {
        let blks = eir_prog.fn_blocks(fn_id);
        let n_blocks = blks.len;
        if nvals == 0_usize
            || n_blocks <= 1_usize
            || eir_prog.fn_where_clauses(fn_id).len > 0_usize
            || eir_prog.fn_ensures_clauses(fn_id).len > 0_usize
            || f.loop_invariants.len > 0_u32
        {
            self.active = false;
            return;
        }

        // 0. Compute transitively LIVE phis (ignoring ~90%+ dead non-pruned SSA phis!).
        self.def_bb.clear();
        try self.def_bb.reserve(alloc, nvals);
        self.val_to_phi.clear();
        try self.val_to_phi.reserve(alloc, nvals);
        var i0: usize = 0_usize;
        while i0 < nvals {
            try self.def_bb.push(alloc, 0xFFFFFFFF_u32);
            try self.val_to_phi.push(alloc, 0xFFFFFFFF_u32);
            i0 = i0 +% 1_usize;
        }
        if self.cross_bs.len() < nvals {
            let nb = try col.BitSet.init(alloc, nvals);
            self.cross_bs.destroy(alloc);
            self.cross_bs = nb;
        } else {
            self.cross_bs.clear();
        }
        if self.live_phis.len() < nvals {
            let nb2 = try col.BitSet.init(alloc, nvals);
            self.live_phis.destroy(alloc);
            self.live_phis = nb2;
        } else {
            self.live_phis.clear();
        }
        if self.real_uses.len() < nvals {
            let nb3 = try col.BitSet.init(alloc, nvals);
            self.real_uses.destroy(alloc);
            self.real_uses = nb3;
        } else {
            self.real_uses.clear();
        }
        if self.block_live_phis.len() < n_blocks {
            let nb4 = try col.BitSet.init(alloc, n_blocks);
            self.block_live_phis.destroy(alloc);
            self.block_live_phis = nb4;
        } else {
            self.block_live_phis.clear();
        }

        let params = eir_prog.fn_params(fn_id);
        var pi0: usize = 0_usize;
        while pi0 < params.len {
            let pv = params[pi0].widen.[usize]();
            if pv < nvals {
                self.cross_bs.set(pv);
            }
            pi0 = pi0 +% 1_usize;
        }

        var bi: usize = 0_usize;
        while bi < blks.len {
            let blk = blks[bi];
            let b_u32 = bi.trunc.[u32]();
            let phis = eir_prog.phis_slice(blk.phis);
            var pi: usize = 0_usize;
            while pi < phis.len {
                let vi = phis[pi].dst.widen.[usize]();
                let dbb = self.def_bb.as_mut_slice();
                if vi < dbb.len {
                    dbb[vi] = b_u32;
                }
                let v2p = self.val_to_phi.as_mut_slice();
                if vi < v2p.len {
                    v2p[vi] = blk.phis.start +% pi.trunc.[u32]();
                }
                pi = pi +% 1_usize;
            }
            let insts = eir_prog.insts_slice(blk.insts);
            var ki: usize = 0_usize;
            while ki < insts.len {
                let ins = insts[ki];
                let dv = ins.dst;
                if dv != eir.EIR_NONE {
                    let vi = dv.widen.[usize]();
                    let dbb = self.def_bb.as_mut_slice();
                    if vi < dbb.len {
                        dbb[vi] = b_u32;
                    }
                }
                try eir.collect_inst_uses(alloc, eir_prog, &ins, &mut self.tmp_uses);
                let ts = self.tmp_uses.as_slice();
                var ti: usize = 0_usize;
                while ti < ts.len {
                    let vi = ts[ti].widen.[usize]();
                    if vi < nvals {
                        self.real_uses.set(vi);
                    }
                    ti = ti +% 1_usize;
                }
                ki = ki +% 1_usize;
            }
            let tv = blk.term.val;
            if tv != eir.EIR_NONE {
                let vi = tv.widen.[usize]();
                if vi < nvals {
                    self.real_uses.set(vi);
                }
            }
            bi = bi +% 1_usize;
        }

        // BFS backward from real_uses over phi graph to mark transitively live phis.
        self.phi_worklist.clear();
        bi = 0_usize;
        while bi < blks.len {
            let blk = blks[bi];
            let phis = eir_prog.phis_slice(blk.phis);
            var pi: usize = 0_usize;
            while pi < phis.len {
                let vi = phis[pi].dst.widen.[usize]();
                if vi < nvals && self.real_uses.test(vi) && !self.live_phis.test(vi) {
                    self.live_phis.set(vi);
                    self.block_live_phis.set(bi);
                    self.cross_bs.set(vi);
                    try self.phi_worklist.push(alloc, blk.phis.start +% pi.trunc.[u32]());
                }
                pi = pi +% 1_usize;
            }
            bi = bi +% 1_usize;
        }
        let all_phis = eir_prog.funcs.phis.as_slice();
        while self.phi_worklist.len() > 0_usize {
            if let gpi = self.phi_worklist.pop() {
                let gi = gpi.widen.[usize]();
                if gi < all_phis.len {
                    let incs = eir_prog.phi_incoming(all_phis[gi].incoming);
                    var ii: usize = 0_usize;
                    while ii < incs.len {
                        let iv = incs[ii].val.widen.[usize]();
                        let v2p = self.val_to_phi.as_slice();
                        if iv < v2p.len && v2p[iv] != 0xFFFFFFFF_u32 && !self.live_phis.test(iv) {
                            let p_gid = v2p[iv];
                            self.live_phis.set(iv);
                            self.cross_bs.set(iv);
                            let dbb_ro = self.def_bb.as_slice();
                            if iv < dbb_ro.len {
                                let pbi = dbb_ro[iv].widen.[usize]();
                                if pbi < n_blocks {
                                    self.block_live_phis.set(pbi);
                                }
                            }
                            try self.phi_worklist.push(alloc, p_gid);
                        }
                        ii = ii +% 1_usize;
                    }
                }
            }
        }

        // 1. Identify cross-block SSA values (ignoring dead phis!).
        bi = 0_usize;
        while bi < blks.len {
            let blk = blks[bi];
            let b_u32 = bi.trunc.[u32]();
            if self.block_live_phis.test(bi) {
                let phis = eir_prog.phis_slice(blk.phis);
                var pi: usize = 0_usize;
                while pi < phis.len {
                    let pdst = phis[pi].dst.widen.[usize]();
                    if self.live_phis.test(pdst) {
                        let incs = eir_prog.phi_incoming(phis[pi].incoming);
                        let dbb_ro = self.def_bb.as_slice();
                        var ii: usize = 0_usize;
                        while ii < incs.len {
                            let vi = incs[ii].val.widen.[usize]();
                            if vi < dbb_ro.len && dbb_ro[vi] != incs[ii].pred_bb {
                                self.cross_bs.set(vi);
                            }
                            ii = ii +% 1_usize;
                        }
                    }
                    pi = pi +% 1_usize;
                }
            }
            let insts = eir_prog.insts_slice(blk.insts);
            var ki: usize = 0_usize;
            while ki < insts.len {
                let ins = insts[ki];
                try eir.collect_inst_uses(alloc, eir_prog, &ins, &mut self.tmp_uses);
                let ts = self.tmp_uses.as_slice();
                let dbb_ro = self.def_bb.as_slice();
                var ti: usize = 0_usize;
                while ti < ts.len {
                    let vi = ts[ti].widen.[usize]();
                    if vi < dbb_ro.len && dbb_ro[vi] != b_u32 {
                        self.cross_bs.set(vi);
                    }
                    ti = ti +% 1_usize;
                }
                ki = ki +% 1_usize;
            }
            let tv = blk.term.val;
            if tv != eir.EIR_NONE {
                let vi = tv.widen.[usize]();
                let dbb_ro = self.def_bb.as_slice();
                if vi < dbb_ro.len && dbb_ro[vi] != b_u32 {
                    self.cross_bs.set(vi);
                }
            }
            bi = bi +% 1_usize;
        }

        // 2. Compress cross-block values to dense IDs 0..n_cross-1.
        self.val_to_cid.clear();
        try self.val_to_cid.reserve(alloc, nvals);
        var n_cross: usize = 0_usize;
        var vi0: usize = 0_usize;
        while vi0 < nvals {
            if self.cross_bs.test(vi0) {
                try self.val_to_cid.push(alloc, n_cross.trunc.[u32]());
                n_cross = n_cross +% 1_usize;
            } else {
                try self.val_to_cid.push(alloc, 0xFFFFFFFF_u32);
            }
            vi0 = vi0 +% 1_usize;
        }

        if n_cross == 0_usize {
            self.n_blocks = n_blocks;
            self.n_vals = nvals;
            self.words_per_blk = 0_usize;
            self.active = true;
            return;
        }

        let wpb = (n_cross +% 63_usize) >> 6_usize;
        let total_w = n_blocks *% wpb;
        if total_w > 4000000_usize {
            self.active = false;
            return;
        }

        try ensure_zero_u64_buf(alloc, &mut self.live_in, total_w);
        try ensure_zero_u64_buf(alloc, &mut self.def_body, total_w);
        try ensure_zero_u64_buf(alloc, &mut self.phi_def, total_w);

        // 3. Seed phi_def (live phis only), def_body, and body uses into live_in.
        bi = 0_usize;
        while bi < blks.len {
            let blk = blks[bi];
            if self.block_live_phis.test(bi) {
                let phis = eir_prog.phis_slice(blk.phis);
                var pi: usize = 0_usize;
                while pi < phis.len {
                    let v = phis[pi].dst.widen.[usize]();
                    if self.live_phis.test(v) {
                        let v2c = self.val_to_cid.as_slice();
                        if v < v2c.len && v2c[v] != 0xFFFFFFFF_u32 {
                            let cid = v2c[v].widen.[usize]();
                            word_bit_set(self.phi_def.as_mut_slice(), bi, wpb, cid);
                            word_bit_set(self.live_in.as_mut_slice(), bi, wpb, cid);
                        }
                    }
                    pi = pi +% 1_usize;
                }
            }
            let insts = eir_prog.insts_slice(blk.insts);
            var ki: usize = 0_usize;
            while ki < insts.len {
                let ins = insts[ki];
                try eir.collect_inst_uses(alloc, eir_prog, &ins, &mut self.tmp_uses);
                let ts = self.tmp_uses.as_slice();
                let v2c = self.val_to_cid.as_slice();
                let dbs = self.def_body.as_slice();
                var ti: usize = 0_usize;
                while ti < ts.len {
                    let v = ts[ti].widen.[usize]();
                    if v < v2c.len && v2c[v] != 0xFFFFFFFF_u32 {
                        let cid = v2c[v].widen.[usize]();
                        if !word_bit_test(dbs, bi, wpb, cid) {
                            word_bit_set(self.live_in.as_mut_slice(), bi, wpb, cid);
                        }
                    }
                    ti = ti +% 1_usize;
                }
                let dv = ins.dst;
                if dv != eir.EIR_NONE {
                    let v = dv.widen.[usize]();
                    if v < v2c.len && v2c[v] != 0xFFFFFFFF_u32 {
                        word_bit_set(self.def_body.as_mut_slice(), bi, wpb, v2c[v].widen.[usize]());
                    }
                }
                ki = ki +% 1_usize;
            }
            let tv = blk.term.val;
            if tv != eir.EIR_NONE {
                let v = tv.widen.[usize]();
                let v2c = self.val_to_cid.as_slice();
                if v < v2c.len && v2c[v] != 0xFFFFFFFF_u32 {
                    let cid = v2c[v].widen.[usize]();
                    if !word_bit_test(self.def_body.as_slice(), bi, wpb, cid) {
                        word_bit_set(self.live_in.as_mut_slice(), bi, wpb, cid);
                    }
                }
            }
            bi = bi +% 1_usize;
        }

        // 4. Seed outgoing edge phi incoming uses (live phis only!) into predecessor live_in.
        bi = 0_usize;
        while bi < blks.len {
            if self.block_live_phis.test(bi) {
                let blk = blks[bi];
                let phis = eir_prog.phis_slice(blk.phis);
                let v2c = self.val_to_cid.as_slice();
                var pi: usize = 0_usize;
                while pi < phis.len {
                    let pdst = phis[pi].dst.widen.[usize]();
                    if self.live_phis.test(pdst) {
                        let incs = eir_prog.phi_incoming(phis[pi].incoming);
                        var ii: usize = 0_usize;
                        while ii < incs.len {
                            let p = incs[ii].pred_bb.widen.[usize]();
                            let v = incs[ii].val.widen.[usize]();
                            if p < n_blocks && v < v2c.len && v2c[v] != 0xFFFFFFFF_u32 {
                                let cid = v2c[v].widen.[usize]();
                                if !word_bit_test(self.def_body.as_slice(), p, wpb, cid) {
                                    word_bit_set(self.live_in.as_mut_slice(), p, wpb, cid);
                                }
                            }
                            ii = ii +% 1_usize;
                        }
                    }
                    pi = pi +% 1_usize;
                }
            }
            bi = bi +% 1_usize;
        }

        // 5. Backward dataflow fixpoint in reverse RPO order.
        let rpo = eir_prog.fn_rpo(fn_id);
        let use_rpo = rpo.len > 0_usize;
        let max_iters = n_blocks +% 64_usize;
        var iter: usize = 0_usize;
        var changed = true;
        while changed && iter < max_iters {
            changed = false;
            var ri = if use_rpo { rpo.len } else { n_blocks };
            while ri > 0_usize {
                ri = ri - 1_usize;
                let cur_bi = if use_rpo && ri < rpo.len { rpo[ri].widen.[usize]() } else { ri };
                if cur_bi >= blks.len {
                    continue;
                }
                let term = blks[cur_bi].term;
                match term.kind {
                    .Goto => {
                        let s0 = term.bb0.widen.[usize]();
                        if s0 < n_blocks && propagate_live_succ(self.live_in.as_mut_slice(), self.phi_def.as_slice(), self.def_body.as_slice(), wpb, cur_bi, s0) {
                            changed = true;
                        }
                    }
                    .Branch => {
                        let s0 = term.bb0.widen.[usize]();
                        if s0 < n_blocks && propagate_live_succ(self.live_in.as_mut_slice(), self.phi_def.as_slice(), self.def_body.as_slice(), wpb, cur_bi, s0) {
                            changed = true;
                        }
                        let s1 = term.bb1.widen.[usize]();
                        if s1 < n_blocks && s1 != s0 && propagate_live_succ(self.live_in.as_mut_slice(), self.phi_def.as_slice(), self.def_body.as_slice(), wpb, cur_bi, s1) {
                            changed = true;
                        }
                    }
                    .SwitchInt => {
                        let s0 = term.bb0.widen.[usize]();
                        if s0 < n_blocks && propagate_live_succ(self.live_in.as_mut_slice(), self.phi_def.as_slice(), self.def_body.as_slice(), wpb, cur_bi, s0) {
                            changed = true;
                        }
                        let targets = eir_prog.switch_targets_slice(term.targets);
                        var ti: usize = 0_usize;
                        while ti < targets.len {
                            let stgt = targets[ti].target.widen.[usize]();
                            if stgt < n_blocks && propagate_live_succ(self.live_in.as_mut_slice(), self.phi_def.as_slice(), self.def_body.as_slice(), wpb, cur_bi, stgt) {
                                changed = true;
                            }
                            ti = ti +% 1_usize;
                        }
                    }
                    _ => {}
                }
            }
            iter = iter +% 1_usize;
        }

        self.n_blocks = n_blocks;
        self.n_vals = nvals;
        self.words_per_blk = wpb;
        self.active = true;
        return;
    }
}

struct ExtraKeepSet {
    vals: [128]u32;
    len: usize;
    overflow: bool;
}

impl ExtraKeepSet {
    fn empty() -> ExtraKeepSet {
        return ExtraKeepSet.{
            vals: [0_u32; 128],
            len: 0_usize,
            overflow: false,
        };
    }

    fn add_val(self: *mut Self, live: *BlockLiveness, dst_bb: cfg_ir.BlockId, v: u32) {
        if self.overflow || live.is_live(dst_bb, v) {
            return;
        }
        var i: usize = 0_usize;
        while i < self.len && i < 128_usize {
            if self.vals[i] == v {
                return;
            }
            i = i +% 1_usize;
        }
        if self.len < 128_usize {
            self.vals[self.len] = v;
            self.len = self.len +% 1_usize;
        } else {
            self.overflow = true;
        }
    }

    fn add_vk(self: *mut Self, live: *BlockLiveness, dst_bb: cfg_ir.BlockId, k: VarKey) {
        if vk_is_ssa(k) {
            self.add_val(live, dst_bb, vk_a(k));
        }
    }

    fn contains(self: *Self, v: u32) -> bool {
        var i: usize = 0_usize;
        while i < self.len && i < 128_usize {
            if self.vals[i] == v {
                return true;
            }
            i = i +% 1_usize;
        }
        return false;
    }
}

fn collect_pred_extra_vals(
    preds: *PredArena,
    pred_id: u32,
    live: *BlockLiveness,
    dst_bb: cfg_ir.BlockId,
    extra: *mut ExtraKeepSet,
) {
    var stk: [32]u32 = [0_u32; 32];
    var sp: usize = 1_usize;
    stk[0_usize] = pred_id;
    var steps: usize = 0_usize;
    while sp > 0_usize && sp <= 32_usize && steps < 64_usize && !extra.overflow {
        sp = sp - 1_usize;
        steps = steps +% 1_usize;
        let pid = stk[sp];
        if let node = preds.get(pid) {
            match node.kind {
                .Cmp => {
                    extra.add_vk(live, dst_bb, node.lhs_vk);
                    extra.add_vk(live, dst_bb, node.rhs_vk);
                }
                .Not => {
                    stk[sp] = node.a;
                    sp = sp + 1_usize;
                }
                .And => {
                    stk[sp] = node.a;
                    sp = sp + 1_usize;
                    if sp < 32_usize {
                        stk[sp] = node.b;
                        sp = sp + 1_usize;
                    }
                }
                .Or => {
                    stk[sp] = node.a;
                    sp = sp + 1_usize;
                    if sp < 32_usize {
                        stk[sp] = node.b;
                        sp = sp + 1_usize;
                    }
                }
                .Const => {}
            }
        }
    }
}

fn edge_keep_val(live: *BlockLiveness, extra: *ExtraKeepSet, dst_bb: cfg_ir.BlockId, v: u32) -> bool {
    if extra.overflow || !live.active {
        return true;
    }
    if live.is_live(dst_bb, v) {
        return true;
    }
    if extra.len > 0_usize && extra.contains(v) {
        return true;
    }
    return false;
}

fn edge_keep_key(live: *BlockLiveness, extra: *ExtraKeepSet, dst_bb: cfg_ir.BlockId, k: VarKey) -> bool {
    if !vk_is_ssa(k) {
        return true;
    }
    return edge_keep_val(live, extra, dst_bb, vk_a(k));
}

fn keep_or_dbm_eq_live(
    st: *DbmState,
    live: *BlockLiveness,
    extra: *ExtraKeepSet,
    dst_bb: cfg_ir.BlockId,
    k: VarKey,
) -> bool {
    if edge_keep_key(live, extra, dst_bb, k) {
        return true;
    }
    if let ki_u32 = st.core.vmap.get(k) {
        let ki = ki_u32.widen.[usize]();
        let sv = st.core.verts.as_slice();
        let stride = st.core.mat_stride;
        let sm = st.core.mat.as_slice();
        let ki_row = ki *% stride;
        var vj: usize = 1_usize;
        while vj < sv.len {
            if vj != ki && edge_keep_key(live, extra, dst_bb, sv[vj]) {
                let i1 = ki_row +% vj;
                let i2 = (vj *% stride) +% ki;
                if i1 < sm.len && i2 < sm.len {
                    let b1 = sm[i1];
                    let b2 = sm[i2];
                    if b1.has_val && b2.has_val && types.int_val_is_zero(b1.val) && types.int_val_is_zero(b2.val) {
                        return true;
                    }
                }
            }
            vj = vj +% 1_usize;
        }
    }
    return false;
}

linear struct StatePool {
    core: StatePoolCore;
    aux: StatePoolAux;
    prof_saves: u64;
    prof_edge_saves: u64;
    prof_sorts: u64;
    prof_already_sorted: u64;
    prof_total_iv_saved: u64;
    prof_total_mat_saved: u64;
    prof_peak_iv: u64;
    prof_peak_mat: u64;
}

impl StatePool {
    fn init(alloc: *mut AllocCap) -> StatePool ! OutOfMemory {
        let core = try StatePoolCore.init(alloc);
        errdefer core.destroy(alloc);
        let aux = try StatePoolAux.init(alloc);
        errdefer aux.destroy(alloc);
        return StatePool.{
            core: core,
            aux: aux,
            prof_saves: 0_u64,
            prof_edge_saves: 0_u64,
            prof_sorts: 0_u64,
            prof_already_sorted: 0_u64,
            prof_total_iv_saved: 0_u64,
            prof_total_mat_saved: 0_u64,
            prof_peak_iv: 0_u64,
            prof_peak_mat: 0_u64,
        };
    }

    fn destroy(self: StatePool, alloc: *mut AllocCap) {
        let StatePool.{
            core,
            aux,
            prof_saves: _,
            prof_edge_saves: _,
            prof_sorts: _,
            prof_already_sorted: _,
            prof_total_iv_saved: _,
            prof_total_mat_saved: _,
            prof_peak_iv: _,
            prof_peak_mat: _,
        } = self;
        core.destroy(alloc);
        aux.destroy(alloc);
    }

    fn clear(self: *mut Self) {
        self.core.intervals.clear();
        self.core.verts.clear();
        self.core.mat.clear();
        self.aux.non_zero.clear();
        self.aux.preds.clear();
        self.aux.known_bits.clear();
        self.aux.diff_exprs.clear();
        self.aux.sum_exprs.clear();
        self.aux.checked_op.clear();
        self.aux.slot_checked_op.clear();
        self.aux.val_slot_origin.clear();
        self.aux.const_lits.clear();
    }

    fn save(self: *mut Self, alloc: *mut AllocCap, st: *DbmState) -> StateSnap ! OutOfMemory {
        self.prof_saves = self.prof_saves +% 1_u64;
        if st.core.is_bottom {
            return snap_bottom();
        }
        let iv_start = self.core.intervals.len();
        let ks = st.core.intervals.keys_slice();
        let vs = st.core.intervals.vals_slice();
        try self.core.intervals.reserve(alloc, iv_start +% ks.len);
        var sorted = true;
        var prev_k: u64 = 0_u64;
        var has_prev = false;
        var i: usize = 0_usize;
        while i < ks.len && i < vs.len {
            let k = ks[i];
            if has_prev && k < prev_k {
                sorted = false;
            }
            prev_k = k;
            has_prev = true;
            try self.core.intervals.push(alloc, IntervalEntry.{ key: k, iv: vs[i] });
            i = i +% 1_usize;
        }
        let iv_end = self.core.intervals.len();
        self.prof_total_iv_saved = self.prof_total_iv_saved +% (iv_end -% iv_start).widen.[u64]();
        if iv_end.widen.[u64]() > self.prof_peak_iv {
            self.prof_peak_iv = iv_end.widen.[u64]();
        }
        if iv_end > iv_start +% 1_usize {
            if sorted {
                self.prof_already_sorted = self.prof_already_sorted +% 1_u64;
            } else {
                let ms = self.core.intervals.as_mut_slice();
                let sub = ms.sub_mut(iv_start, iv_end) catch {
                    return .OutOfMemory;
                };
                self.prof_sorts = self.prof_sorts +% 1_u64;
                sort_iv_entries(sub);
            }
        }
        let iv_r = ast.range_new(iv_start.trunc.[u32](), (iv_end -% iv_start).trunc.[u32]());

        let v_start = self.core.verts.len().trunc.[u32]();
        let sv = st.core.verts.as_slice();
        try self.core.verts.push_slice(alloc, sv);
        let n = sv.len;
        let v_r = ast.range_new(v_start, n.trunc.[u32]());

        let m_start_sz = self.core.mat.len();
        let m_start = m_start_sz.trunc.[u32]();
        if n > 1_usize {
            try self.core.mat.reserve(alloc, m_start_sz +% (n *% 4_usize));
            let stride = st.core.mat_stride;
            let sm = st.core.mat.as_slice();
            var r: usize = 0_usize;
            while r < n {
                let rrow = r *% stride;
                var c: usize = 0_usize;
                while c < n {
                    if r != c {
                        let idx = rrow +% c;
                        if idx < sm.len {
                            let b = sm[idx];
                            if b.has_val {
                                try self.core.mat.push(alloc, SparseBound.{ rc: sparse_rc(r, c), val: b.val });
                            }
                        }
                    }
                    c = c +% 1_usize;
                }
                r = r +% 1_usize;
            }
        }
        let m_end = self.core.mat.len();
        let m_len = m_end.trunc.[u32]() -% m_start;
        self.prof_total_mat_saved = self.prof_total_mat_saved +% m_len.widen.[u64]();
        if m_end.widen.[u64]() > self.prof_peak_mat {
            self.prof_peak_mat = m_end.widen.[u64]();
        }
        let m_r = ast.range_new(m_start, m_len);

        let nz_r = try push_range_vk(alloc, &mut self.aux.non_zero, st.aux.non_zero.as_slice());
        let pr_r = try push_range_pred(alloc, &mut self.aux.preds, st.aux.preds.as_slice());
        let kb_r = try push_range_kb(alloc, &mut self.aux.known_bits, st.aux.known_bits.as_slice());
        let co_r = try push_range_cop(alloc, &mut self.aux.checked_op, st.aux.checked_op.as_slice());
        let vso_r = try push_range_vso(alloc, &mut self.aux.val_slot_origin, st.aux.val_slot_origin.as_slice());
        let cl_r = try push_range_vk(alloc, &mut self.aux.const_lits, st.aux.const_lits.as_slice());
        let df_r = try push_range_pair(alloc, &mut self.aux.diff_exprs, st.aux.diff_exprs.as_slice());
        let sm_r = try push_range_pair(alloc, &mut self.aux.sum_exprs, st.aux.sum_exprs.as_slice());
        let sco_r = try push_range_cop(alloc, &mut self.aux.slot_checked_op, st.aux.slot_checked_op.as_slice());

        return StateSnap.{
            valid: true,
            is_bottom: false,
            is_closed: st.core.is_closed,
            unsynced_mask: st.core.unsynced_mask,
            intervals: iv_r,
            verts: v_r,
            mat: m_r,
            non_zero: nz_r,
            preds: pr_r,
            known_bits: kb_r,
            diff_exprs: df_r,
            sum_exprs: sm_r,
            checked_op: co_r,
            slot_checked_op: sco_r,
            val_slot_origin: vso_r,
            const_lits: cl_r,
        };
    }

    fn save_edge_for_bb(
        self: *mut Self,
        alloc: *mut AllocCap,
        st: *DbmState,
        live: *BlockLiveness,
        preds: *PredArena,
        dst_bb: cfg_ir.BlockId,
    ) -> StateSnap ! OutOfMemory {
        if !live.active {
            self.prof_edge_saves = self.prof_edge_saves +% 1_u64;
            return try self.save(alloc, st);
        }
        self.prof_saves = self.prof_saves +% 1_u64;
        self.prof_edge_saves = self.prof_edge_saves +% 1_u64;
        if st.core.is_bottom {
            return snap_bottom();
        }

        // Collect extra SSA values referenced by kept aux relations (preds, checked_op, diff/sum).
        var extra = ExtraKeepSet.empty();
        let pr_src = st.aux.preds.as_slice();
        var ei: usize = 0_usize;
        while ei < pr_src.len && !extra.overflow {
            if live.is_live(dst_bb, pr_src[ei].val) {
                collect_pred_extra_vals(preds, pr_src[ei].pred, live, dst_bb, &mut extra);
            }
            ei = ei +% 1_usize;
        }
        let co_src = st.aux.checked_op.as_slice();
        ei = 0_usize;
        while ei < co_src.len && !extra.overflow {
            if edge_keep_val(live, &extra, dst_bb, co_src[ei].id) {
                extra.add_val(live, dst_bb, co_src[ei].lhs);
                extra.add_val(live, dst_bb, co_src[ei].rhs);
            }
            ei = ei +% 1_usize;
        }
        let sco_src = st.aux.slot_checked_op.as_slice();
        ei = 0_usize;
        while ei < sco_src.len && !extra.overflow {
            extra.add_val(live, dst_bb, sco_src[ei].lhs);
            extra.add_val(live, dst_bb, sco_src[ei].rhs);
            ei = ei +% 1_usize;
        }
        let df_src = st.aux.diff_exprs.as_slice();
        ei = 0_usize;
        while ei < df_src.len && !extra.overflow {
            if edge_keep_key(live, &extra, dst_bb, df_src[ei].key)
                || (keep_or_dbm_eq_live(st, live, &extra, dst_bb, df_src[ei].a) && keep_or_dbm_eq_live(st, live, &extra, dst_bb, df_src[ei].b))
            {
                extra.add_vk(live, dst_bb, df_src[ei].key);
                extra.add_vk(live, dst_bb, df_src[ei].a);
                extra.add_vk(live, dst_bb, df_src[ei].b);
            }
            ei = ei +% 1_usize;
        }
        let sm_src = st.aux.sum_exprs.as_slice();
        ei = 0_usize;
        while ei < sm_src.len && !extra.overflow {
            if edge_keep_key(live, &extra, dst_bb, sm_src[ei].key)
                || (keep_or_dbm_eq_live(st, live, &extra, dst_bb, sm_src[ei].a) && keep_or_dbm_eq_live(st, live, &extra, dst_bb, sm_src[ei].b))
            {
                extra.add_vk(live, dst_bb, sm_src[ei].key);
                extra.add_vk(live, dst_bb, sm_src[ei].a);
                extra.add_vk(live, dst_bb, sm_src[ei].b);
            }
            ei = ei +% 1_usize;
        }

        if extra.overflow {
            // Undo counter double-bump before delegating to full save.
            self.prof_saves = self.prof_saves -% 1_u64;
            return try self.save(alloc, st);
        }

        // Project dead SSA vertices out of the DBM on outgoing edges.
        // When `is_closed == true`, this is an exact closed-DBM projection.
        // When `is_closed == false` (post-widening), `dbm_close_around` already propagated
        // all constraints added through loop temporaries, and dropping dead vertices is
        // sound and strictly preserves widening convergence.
        let sv = st.core.verts.as_slice();
        let n = sv.len;
        var prune_verts = false;
        let v_start = self.core.verts.len().trunc.[u32]();
        let m_start_sz = self.core.mat.len();
        let m_start = m_start_sz.trunc.[u32]();
        var out_unsynced: u64 = 0_u64;
        var kept_n: usize = n;

        if sv.len > 1_usize && sv.len <= 65_usize {
            prune_verts = true;
            var kept_old: [65]u8 = [0_u8; 65];
            kept_n = 1_usize;
            try self.core.verts.push(alloc, sv[0_usize]);
            var oi: usize = 1_usize;
            while oi < sv.len && kept_n < 65_usize {
                let vk = sv[oi];
                if edge_keep_key(live, &extra, dst_bb, vk) {
                    kept_old[kept_n] = oi.trunc.[u8]();
                    try self.core.verts.push(alloc, vk);
                    if (st.core.unsynced_mask & vert_bit(oi)) != 0_u64 {
                        out_unsynced = out_unsynced | vert_bit(kept_n);
                    }
                    kept_n = kept_n +% 1_usize;
                }
                oi = oi +% 1_usize;
            }
            if kept_n > 1_usize {
                try self.core.mat.reserve(alloc, m_start_sz +% (kept_n *% 4_usize));
                let stride = st.core.mat_stride;
                let sm = st.core.mat.as_slice();
                var nr: usize = 0_usize;
                while nr < kept_n && nr < 65_usize {
                    let old_r = kept_old[nr].widen.[usize]();
                    let rrow = old_r *% stride;
                    var nc: usize = 0_usize;
                    while nc < kept_n && nc < 65_usize {
                        if nr != nc {
                            let old_c = kept_old[nc].widen.[usize]();
                            let idx = rrow +% old_c;
                            if idx < sm.len {
                                let b = sm[idx];
                                if b.has_val {
                                    try self.core.mat.push(alloc, SparseBound.{ rc: sparse_rc(nr, nc), val: b.val });
                                }
                            }
                        }
                        nc = nc +% 1_usize;
                    }
                    nr = nr +% 1_usize;
                }
            }
        } else {
            out_unsynced = st.core.unsynced_mask;
            try self.core.verts.push_slice(alloc, sv);
            if n > 1_usize {
                try self.core.mat.reserve(alloc, m_start_sz +% (n *% 4_usize));
                let stride = st.core.mat_stride;
                let sm = st.core.mat.as_slice();
                var r: usize = 0_usize;
                while r < n {
                    let rrow = r *% stride;
                    var c: usize = 0_usize;
                    while c < n {
                        if r != c {
                            let idx = rrow +% c;
                            if idx < sm.len {
                                let b = sm[idx];
                                if b.has_val {
                                    try self.core.mat.push(alloc, SparseBound.{ rc: sparse_rc(r, c), val: b.val });
                                }
                            }
                        }
                        c = c +% 1_usize;
                    }
                    r = r +% 1_usize;
                }
            }
        }
        let v_r = ast.range_new(v_start, kept_n.trunc.[u32]());
        let m_end = self.core.mat.len();
        let m_len = m_end.trunc.[u32]() -% m_start;
        self.prof_total_mat_saved = self.prof_total_mat_saved +% m_len.widen.[u64]();
        if m_end.widen.[u64]() > self.prof_peak_mat {
            self.prof_peak_mat = m_end.widen.[u64]();
        }
        let m_r = ast.range_new(m_start, m_len);

        // Save live intervals (only keep unpruned DBM vertices if !prune_verts).
        let iv_start = self.core.intervals.len();
        let ks = st.core.intervals.keys_slice();
        let vs = st.core.intervals.vals_slice();
        var sorted = true;
        var prev_k: u64 = 0_u64;
        var has_prev = false;
        var i: usize = 0_usize;
        while i < ks.len && i < vs.len {
            let k = ks[i];
            if edge_keep_key(live, &extra, dst_bb, k) || (!prune_verts && st.core.vmap.contains(k)) {
                if has_prev && k < prev_k {
                    sorted = false;
                }
                prev_k = k;
                has_prev = true;
                try self.core.intervals.push(alloc, IntervalEntry.{ key: k, iv: vs[i] });
            }
            i = i +% 1_usize;
        }
        let iv_end = self.core.intervals.len();
        self.prof_total_iv_saved = self.prof_total_iv_saved +% (iv_end -% iv_start).widen.[u64]();
        if iv_end.widen.[u64]() > self.prof_peak_iv {
            self.prof_peak_iv = iv_end.widen.[u64]();
        }
        if iv_end > iv_start +% 1_usize {
            if sorted {
                self.prof_already_sorted = self.prof_already_sorted +% 1_u64;
            } else {
                let ms = self.core.intervals.as_mut_slice();
                let sub = ms.sub_mut(iv_start, iv_end) catch {
                    return .OutOfMemory;
                };
                self.prof_sorts = self.prof_sorts +% 1_u64;
                sort_iv_entries(sub);
            }
        }
        let iv_r = ast.range_new(iv_start.trunc.[u32](), (iv_end -% iv_start).trunc.[u32]());

        // Save pruned aux tables.
        let nz_s = self.aux.non_zero.len().trunc.[u32]();
        let nz_src = st.aux.non_zero.as_slice();
        var k0: usize = 0_usize;
        while k0 < nz_src.len {
            if edge_keep_key(live, &extra, dst_bb, nz_src[k0]) || (!prune_verts && st.core.vmap.contains(nz_src[k0])) {
                try self.aux.non_zero.push(alloc, nz_src[k0]);
            }
            k0 = k0 +% 1_usize;
        }
        let nz_r = ast.range_new(nz_s, self.aux.non_zero.len().trunc.[u32]() -% nz_s);

        let pr_s = self.aux.preds.len().trunc.[u32]();
        k0 = 0_usize;
        while k0 < pr_src.len {
            if live.is_live(dst_bb, pr_src[k0].val) {
                try self.aux.preds.push(alloc, pr_src[k0]);
            }
            k0 = k0 +% 1_usize;
        }
        let pr_r = ast.range_new(pr_s, self.aux.preds.len().trunc.[u32]() -% pr_s);

        let kb_s = self.aux.known_bits.len().trunc.[u32]();
        let kb_src = st.aux.known_bits.as_slice();
        k0 = 0_usize;
        while k0 < kb_src.len {
            if edge_keep_key(live, &extra, dst_bb, kb_src[k0].key) || (!prune_verts && st.core.vmap.contains(kb_src[k0].key)) {
                try self.aux.known_bits.push(alloc, kb_src[k0]);
            }
            k0 = k0 +% 1_usize;
        }
        let kb_r = ast.range_new(kb_s, self.aux.known_bits.len().trunc.[u32]() -% kb_s);

        let co_s = self.aux.checked_op.len().trunc.[u32]();
        k0 = 0_usize;
        while k0 < co_src.len {
            if edge_keep_val(live, &extra, dst_bb, co_src[k0].id) {
                try self.aux.checked_op.push(alloc, co_src[k0]);
            }
            k0 = k0 +% 1_usize;
        }
        let co_r = ast.range_new(co_s, self.aux.checked_op.len().trunc.[u32]() -% co_s);

        let vso_s = self.aux.val_slot_origin.len().trunc.[u32]();
        let vso_src = st.aux.val_slot_origin.as_slice();
        k0 = 0_usize;
        while k0 < vso_src.len {
            if edge_keep_val(live, &extra, dst_bb, vso_src[k0].val) {
                try self.aux.val_slot_origin.push(alloc, vso_src[k0]);
            }
            k0 = k0 +% 1_usize;
        }
        let vso_r = ast.range_new(vso_s, self.aux.val_slot_origin.len().trunc.[u32]() -% vso_s);

        let cl_s = self.aux.const_lits.len().trunc.[u32]();
        let cl_src = st.aux.const_lits.as_slice();
        k0 = 0_usize;
        while k0 < cl_src.len {
            if edge_keep_key(live, &extra, dst_bb, cl_src[k0]) || (!prune_verts && st.core.vmap.contains(cl_src[k0])) {
                try self.aux.const_lits.push(alloc, cl_src[k0]);
            }
            k0 = k0 +% 1_usize;
        }
        let cl_r = ast.range_new(cl_s, self.aux.const_lits.len().trunc.[u32]() -% cl_s);

        let df_s = self.aux.diff_exprs.len().trunc.[u32]();
        k0 = 0_usize;
        while k0 < df_src.len {
            if edge_keep_key(live, &extra, dst_bb, df_src[k0].key) {
                try self.aux.diff_exprs.push(alloc, df_src[k0]);
            }
            k0 = k0 +% 1_usize;
        }
        let df_r = ast.range_new(df_s, self.aux.diff_exprs.len().trunc.[u32]() -% df_s);

        let sm_s = self.aux.sum_exprs.len().trunc.[u32]();
        k0 = 0_usize;
        while k0 < sm_src.len {
            if edge_keep_key(live, &extra, dst_bb, sm_src[k0].key) {
                try self.aux.sum_exprs.push(alloc, sm_src[k0]);
            }
            k0 = k0 +% 1_usize;
        }
        let sm_r = ast.range_new(sm_s, self.aux.sum_exprs.len().trunc.[u32]() -% sm_s);

        let sco_r = try push_range_cop(alloc, &mut self.aux.slot_checked_op, sco_src);

        return StateSnap.{
            valid: true,
            is_bottom: false,
            is_closed: st.core.is_closed,
            unsynced_mask: out_unsynced,
            intervals: iv_r,
            verts: v_r,
            mat: m_r,
            non_zero: nz_r,
            preds: pr_r,
            known_bits: kb_r,
            diff_exprs: df_r,
            sum_exprs: sm_r,
            checked_op: co_r,
            slot_checked_op: sco_r,
            val_slot_origin: vso_r,
            const_lits: cl_r,
        };
    }

    fn load(self: *Self, alloc: *mut AllocCap, snap: *StateSnap, dst: *mut DbmState) -> !OutOfMemory {
        dst.prof_loads = dst.prof_loads +% 1_u64;
        if !snap.valid || snap.is_bottom {
            try dst.reset_bottom(alloc);
            return;
        }
        try dst.reset_top(alloc);
        dst.core.is_closed = snap.is_closed;
        dst.core.unsynced_mask = snap.unsynced_mask;
        let ivs = slice_range.[IntervalEntry](self.core.intervals.as_slice(), snap.intervals);
        try dst.core.intervals.reserve(alloc, ivs.len);
        var i: usize = 0_usize;
        while i < ivs.len {
            try dst.core.intervals.insert_unique_fresh(alloc, ivs[i].key, ivs[i].iv);
            i = i +% 1_usize;
        }
        let vs = slice_range.[VarKey](self.core.verts.as_slice(), snap.verts);
        let n = vs.len;
        dst.core.verts.clear();
        try dst.core.verts.push_slice(alloc, vs);
        try dst.core.vmap.reserve(alloc, n);
        var vi: usize = 1_usize;
        while vi < n {
            try dst.core.vmap.insert_unique_fresh(alloc, vs[vi], vi.trunc.[u32]());
            vi = vi +% 1_usize;
        }
        try dst.core.ensure_mat_stride(alloc, n);
        let sm = slice_range.[SparseBound](self.core.mat.as_slice(), snap.mat);
        let dmat = dst.core.mat.as_mut_slice();
        let dstride = dst.core.mat_stride;
        let z_b = bound_some(types.int_val_zero());
        let inf_b = bound_none();
        var r: usize = 0_usize;
        while r < n {
            let drow = r *% dstride;
            var c: usize = 0_usize;
            while c < n {
                let di = drow +% c;
                if di < dmat.len {
                    dmat[di] = if r == c { copy z_b } else { copy inf_b };
                }
                c = c +% 1_usize;
            }
            r = r +% 1_usize;
        }
        var si: usize = 0_usize;
        while si < sm.len {
            let e = sm[si];
            let er = (e.rc >> 8_u16).widen.[usize]();
            let ec = (e.rc & 0xFF_u16).widen.[usize]();
            let di = (er *% dstride) +% ec;
            if er < n && ec < n && di < dmat.len {
                dmat[di] = bound_some(e.val);
            }
            si = si +% 1_usize;
        }
        try dst.aux.non_zero.push_slice(alloc, slice_range.[VarKey](self.aux.non_zero.as_slice(), snap.non_zero));
        try dst.aux.preds.push_slice(alloc, slice_range.[ValPredEntry](self.aux.preds.as_slice(), snap.preds));
        try dst.aux.known_bits.push_slice(alloc, slice_range.[KnownBitsEntry](self.aux.known_bits.as_slice(), snap.known_bits));
        try dst.aux.diff_exprs.push_slice(alloc, slice_range.[PairExprEntry](self.aux.diff_exprs.as_slice(), snap.diff_exprs));
        try dst.aux.sum_exprs.push_slice(alloc, slice_range.[PairExprEntry](self.aux.sum_exprs.as_slice(), snap.sum_exprs));
        try dst.aux.checked_op.push_slice(alloc, slice_range.[CheckedOpEntry](self.aux.checked_op.as_slice(), snap.checked_op));
        try dst.aux.slot_checked_op.push_slice(alloc, slice_range.[CheckedOpEntry](self.aux.slot_checked_op.as_slice(), snap.slot_checked_op));
        try dst.aux.val_slot_origin.push_slice(alloc, slice_range.[ValSlotEntry](self.aux.val_slot_origin.as_slice(), snap.val_slot_origin));
        try dst.aux.const_lits.push_slice(alloc, slice_range.[VarKey](self.aux.const_lits.as_slice(), snap.const_lits));
        return;
    }

    fn copy_snap_into(
        self: *Self,
        alloc: *mut AllocCap,
        snap: *StateSnap,
        dst: *mut StatePool,
    ) -> StateSnap ! OutOfMemory {
        if !snap.valid || snap.is_bottom {
            return snap_bottom();
        }
        let iv_s = slice_range.[IntervalEntry](self.core.intervals.as_slice(), snap.intervals);
        let iv_off = dst.core.intervals.len().trunc.[u32]();
        try dst.core.intervals.push_slice(alloc, iv_s);
        let iv_r = ast.range_new(iv_off, iv_s.len.trunc.[u32]());

        let v_s = slice_range.[VarKey](self.core.verts.as_slice(), snap.verts);
        let v_r = try push_range_vk(alloc, &mut dst.core.verts, v_s);

        let m_s = slice_range.[SparseBound](self.core.mat.as_slice(), snap.mat);
        let m_off = dst.core.mat.len().trunc.[u32]();
        try dst.core.mat.push_slice(alloc, m_s);
        let m_r = ast.range_new(m_off, m_s.len.trunc.[u32]());

        let nz_r = try push_range_vk(alloc, &mut dst.aux.non_zero, slice_range.[VarKey](self.aux.non_zero.as_slice(), snap.non_zero));
        let pr_r = try push_range_pred(alloc, &mut dst.aux.preds, slice_range.[ValPredEntry](self.aux.preds.as_slice(), snap.preds));
        let kb_r = try push_range_kb(alloc, &mut dst.aux.known_bits, slice_range.[KnownBitsEntry](self.aux.known_bits.as_slice(), snap.known_bits));
        let df_r = try push_range_pair(alloc, &mut dst.aux.diff_exprs, slice_range.[PairExprEntry](self.aux.diff_exprs.as_slice(), snap.diff_exprs));
        let sm_r = try push_range_pair(alloc, &mut dst.aux.sum_exprs, slice_range.[PairExprEntry](self.aux.sum_exprs.as_slice(), snap.sum_exprs));
        let co_r = try push_range_cop(alloc, &mut dst.aux.checked_op, slice_range.[CheckedOpEntry](self.aux.checked_op.as_slice(), snap.checked_op));
        let sco_r = try push_range_cop(alloc, &mut dst.aux.slot_checked_op, slice_range.[CheckedOpEntry](self.aux.slot_checked_op.as_slice(), snap.slot_checked_op));
        let vso_r = try push_range_vso(alloc, &mut dst.aux.val_slot_origin, slice_range.[ValSlotEntry](self.aux.val_slot_origin.as_slice(), snap.val_slot_origin));
        let cl_r = try push_range_vk(alloc, &mut dst.aux.const_lits, slice_range.[VarKey](self.aux.const_lits.as_slice(), snap.const_lits));

        return StateSnap.{
            valid: true,
            is_bottom: false,
            is_closed: snap.is_closed,
            unsynced_mask: snap.unsynced_mask,
            intervals: iv_r,
            verts: v_r,
            mat: m_r,
            non_zero: nz_r,
            preds: pr_r,
            known_bits: kb_r,
            diff_exprs: df_r,
            sum_exprs: sm_r,
            checked_op: co_r,
            slot_checked_op: sco_r,
            val_slot_origin: vso_r,
            const_lits: cl_r,
        };
    }
}

fn push_range_vk(alloc: *mut AllocCap, dst: *mut col.DynBuf[VarKey], src: *[VarKey]) -> ast.IdRange ! OutOfMemory {
    let off = dst.len().trunc.[u32]();
    try dst.push_slice(alloc, src);
    return ast.range_new(off, src.len.trunc.[u32]());
}

fn push_range_pred(alloc: *mut AllocCap, dst: *mut col.DynBuf[ValPredEntry], src: *[ValPredEntry]) -> ast.IdRange ! OutOfMemory {
    let off = dst.len().trunc.[u32]();
    try dst.push_slice(alloc, src);
    return ast.range_new(off, src.len.trunc.[u32]());
}

fn push_range_kb(alloc: *mut AllocCap, dst: *mut col.DynBuf[KnownBitsEntry], src: *[KnownBitsEntry]) -> ast.IdRange ! OutOfMemory {
    let off = dst.len().trunc.[u32]();
    try dst.push_slice(alloc, src);
    return ast.range_new(off, src.len.trunc.[u32]());
}

fn push_range_pair(alloc: *mut AllocCap, dst: *mut col.DynBuf[PairExprEntry], src: *[PairExprEntry]) -> ast.IdRange ! OutOfMemory {
    let off = dst.len().trunc.[u32]();
    try dst.push_slice(alloc, src);
    return ast.range_new(off, src.len.trunc.[u32]());
}

fn push_range_cop(alloc: *mut AllocCap, dst: *mut col.DynBuf[CheckedOpEntry], src: *[CheckedOpEntry]) -> ast.IdRange ! OutOfMemory {
    let off = dst.len().trunc.[u32]();
    try dst.push_slice(alloc, src);
    return ast.range_new(off, src.len.trunc.[u32]());
}

fn push_range_vso(alloc: *mut AllocCap, dst: *mut col.DynBuf[ValSlotEntry], src: *[ValSlotEntry]) -> ast.IdRange ! OutOfMemory {
    let off = dst.len().trunc.[u32]();
    try dst.push_slice(alloc, src);
    return ast.range_new(off, src.len.trunc.[u32]());
}

fn dbm_copy_state(alloc: *mut AllocCap, src: *DbmState, dst: *mut DbmState) -> !OutOfMemory {
    dst.prof_copies = dst.prof_copies +% 1_u64;
    if src.core.is_bottom {
        try dst.reset_bottom(alloc);
        return;
    }
    dst.core.is_bottom = false;
    dst.core.is_closed = src.core.is_closed;
    dst.core.unsynced_mask = src.core.unsynced_mask;
    try dst.core.intervals.copy_from(alloc, &src.core.intervals);
    let sv = src.core.verts.as_slice();
    let n = sv.len;
    dst.core.verts.clear();
    try dst.core.verts.push_slice(alloc, sv);
    try dst.core.vmap.copy_from(alloc, &src.core.vmap);
    try dst.core.ensure_mat_stride(alloc, n);
    let s_stride = src.core.mat_stride;
    let d_stride = dst.core.mat_stride;
    let sm = src.core.mat.as_slice();
    let dm = dst.core.mat.as_mut_slice();
    if s_stride == d_stride {
        let copy_len = n *% s_stride;
        var k: usize = 0_usize;
        while k < copy_len && k < sm.len && k < dm.len {
            dm[k] = sm[k];
            k = k +% 1_usize;
        }
    } else {
        var r: usize = 0_usize;
        while r < n {
            let srow = r *% s_stride;
            let drow = r *% d_stride;
            var c: usize = 0_usize;
            while c < n {
                let si = srow +% c;
                let di = drow +% c;
                if si < sm.len && di < dm.len {
                    dm[di] = sm[si];
                }
                c = c +% 1_usize;
            }
            r = r +% 1_usize;
        }
    }
    dst.aux.clear();
    try dst.aux.non_zero.push_slice(alloc, src.aux.non_zero.as_slice());
    try dst.aux.preds.push_slice(alloc, src.aux.preds.as_slice());
    try dst.aux.known_bits.push_slice(alloc, src.aux.known_bits.as_slice());
    try dst.aux.diff_exprs.push_slice(alloc, src.aux.diff_exprs.as_slice());
    try dst.aux.sum_exprs.push_slice(alloc, src.aux.sum_exprs.as_slice());
    try dst.aux.checked_op.push_slice(alloc, src.aux.checked_op.as_slice());
    try dst.aux.slot_checked_op.push_slice(alloc, src.aux.slot_checked_op.as_slice());
    try dst.aux.val_slot_origin.push_slice(alloc, src.aux.val_slot_origin.as_slice());
    try dst.aux.const_lits.push_slice(alloc, src.aux.const_lits.as_slice());
    return;
}

fn state_eq_snap(st: *DbmState, spool: *StatePool, snap: *StateSnap) -> bool {
    if !snap.valid {
        return false;
    }
    if st.core.is_bottom && snap.is_bottom {
        return true;
    }
    if st.core.is_bottom != snap.is_bottom {
        return false;
    }
    if st.core.is_closed != snap.is_closed || st.core.unsynced_mask != snap.unsynced_mask {
        return false;
    }
    let ivs = slice_range.[IntervalEntry](spool.core.intervals.as_slice(), snap.intervals);
    if st.core.intervals.len() != ivs.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < ivs.len {
        let got = st.core.intervals.get(ivs[i].key) orelse {
            return false;
        };
        if !interval_eq(&got, &ivs[i].iv) {
            return false;
        }
        i = i +% 1_usize;
    }
    let sv = st.core.verts.as_slice();
    let pv = slice_range.[VarKey](spool.core.verts.as_slice(), snap.verts);
    if sv.len != pv.len {
        return false;
    }
    let n = sv.len;
    var vi: usize = 0_usize;
    while vi < n {
        if sv[vi] != pv[vi] {
            return false;
        }
        vi = vi +% 1_usize;
    }
    let pm = slice_range.[SparseBound](spool.core.mat.as_slice(), snap.mat);
    var pi: usize = 0_usize;
    var r: usize = 0_usize;
    while r < n {
        var c: usize = 0_usize;
        while c < n {
            if r != c {
                let sb = st.core.mat_get(r, c);
                let cur_rc = sparse_rc(r, c);
                if pi < pm.len && pm[pi].rc == cur_rc {
                    if !sb.has_val || !types.int_val_eq(sb.val, pm[pi].val) {
                        return false;
                    }
                    pi = pi +% 1_usize;
                } else {
                    if sb.has_val {
                        return false;
                    }
                }
            }
            c = c +% 1_usize;
        }
        r = r +% 1_usize;
    }
    if pi != pm.len {
        return false;
    }
    if !vk_set_eq(st.aux.non_zero.as_slice(), slice_range.[VarKey](spool.aux.non_zero.as_slice(), snap.non_zero)) {
        return false;
    }
    if !preds_eq(st.aux.preds.as_slice(), slice_range.[ValPredEntry](spool.aux.preds.as_slice(), snap.preds)) {
        return false;
    }
    if !kb_map_eq(st.aux.known_bits.as_slice(), slice_range.[KnownBitsEntry](spool.aux.known_bits.as_slice(), snap.known_bits)) {
        return false;
    }
    if !pair_map_eq(st.aux.diff_exprs.as_slice(), slice_range.[PairExprEntry](spool.aux.diff_exprs.as_slice(), snap.diff_exprs)) {
        return false;
    }
    if !pair_map_eq(st.aux.sum_exprs.as_slice(), slice_range.[PairExprEntry](spool.aux.sum_exprs.as_slice(), snap.sum_exprs)) {
        return false;
    }
    if !checked_map_eq(st.aux.checked_op.as_slice(), slice_range.[CheckedOpEntry](spool.aux.checked_op.as_slice(), snap.checked_op)) {
        return false;
    }
    if !checked_map_eq(st.aux.slot_checked_op.as_slice(), slice_range.[CheckedOpEntry](spool.aux.slot_checked_op.as_slice(), snap.slot_checked_op)) {
        return false;
    }
    if !val_slot_eq(st.aux.val_slot_origin.as_slice(), slice_range.[ValSlotEntry](spool.aux.val_slot_origin.as_slice(), snap.val_slot_origin)) {
        return false;
    }
    return vk_set_eq(st.aux.const_lits.as_slice(), slice_range.[VarKey](spool.aux.const_lits.as_slice(), snap.const_lits));
}

fn snap_eq_snap(spool: *StatePool, a: *StateSnap, b: *StateSnap) -> bool {
    if !a.valid || !b.valid {
        return a.valid == b.valid;
    }
    if a.is_bottom || b.is_bottom {
        return a.is_bottom == b.is_bottom;
    }
    if a.is_closed != b.is_closed || a.unsynced_mask != b.unsynced_mask {
        return false;
    }
    let ia = slice_range.[IntervalEntry](spool.core.intervals.as_slice(), a.intervals);
    let ib = slice_range.[IntervalEntry](spool.core.intervals.as_slice(), b.intervals);
    if ia.len != ib.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < ia.len {
        if ia[i].key != ib[i].key || !interval_eq(&ia[i].iv, &ib[i].iv) {
            return false;
        }
        i = i +% 1_usize;
    }
    let va = slice_range.[VarKey](spool.core.verts.as_slice(), a.verts);
    let vb = slice_range.[VarKey](spool.core.verts.as_slice(), b.verts);
    if va.len != vb.len {
        return false;
    }
    i = 0_usize;
    while i < va.len {
        if va[i] != vb[i] {
            return false;
        }
        i = i +% 1_usize;
    }
    let ma = slice_range.[SparseBound](spool.core.mat.as_slice(), a.mat);
    let mb = slice_range.[SparseBound](spool.core.mat.as_slice(), b.mat);
    if ma.len != mb.len {
        return false;
    }
    i = 0_usize;
    while i < ma.len {
        if ma[i].rc != mb[i].rc || !types.int_val_eq(ma[i].val, mb[i].val) {
            return false;
        }
        i = i +% 1_usize;
    }
    if !vk_set_eq(slice_range.[VarKey](spool.aux.non_zero.as_slice(), a.non_zero), slice_range.[VarKey](spool.aux.non_zero.as_slice(), b.non_zero)) {
        return false;
    }
    if !preds_eq(slice_range.[ValPredEntry](spool.aux.preds.as_slice(), a.preds), slice_range.[ValPredEntry](spool.aux.preds.as_slice(), b.preds)) {
        return false;
    }
    if !kb_map_eq(slice_range.[KnownBitsEntry](spool.aux.known_bits.as_slice(), a.known_bits), slice_range.[KnownBitsEntry](spool.aux.known_bits.as_slice(), b.known_bits)) {
        return false;
    }
    if !pair_map_eq(slice_range.[PairExprEntry](spool.aux.diff_exprs.as_slice(), a.diff_exprs), slice_range.[PairExprEntry](spool.aux.diff_exprs.as_slice(), b.diff_exprs)) {
        return false;
    }
    if !pair_map_eq(slice_range.[PairExprEntry](spool.aux.sum_exprs.as_slice(), a.sum_exprs), slice_range.[PairExprEntry](spool.aux.sum_exprs.as_slice(), b.sum_exprs)) {
        return false;
    }
    if !checked_map_eq(slice_range.[CheckedOpEntry](spool.aux.checked_op.as_slice(), a.checked_op), slice_range.[CheckedOpEntry](spool.aux.checked_op.as_slice(), b.checked_op)) {
        return false;
    }
    if !checked_map_eq(slice_range.[CheckedOpEntry](spool.aux.slot_checked_op.as_slice(), a.slot_checked_op), slice_range.[CheckedOpEntry](spool.aux.slot_checked_op.as_slice(), b.slot_checked_op)) {
        return false;
    }
    if !val_slot_eq(slice_range.[ValSlotEntry](spool.aux.val_slot_origin.as_slice(), a.val_slot_origin), slice_range.[ValSlotEntry](spool.aux.val_slot_origin.as_slice(), b.val_slot_origin)) {
        return false;
    }
    return vk_set_eq(slice_range.[VarKey](spool.aux.const_lits.as_slice(), a.const_lits), slice_range.[VarKey](spool.aux.const_lits.as_slice(), b.const_lits));
}

// ===========================================================================
// Section 6: DBM Core Relational Operations
// ===========================================================================

fn find_vert_in_slice(vs: *[VarKey], k: VarKey) -> ?usize {
    var i: usize = 1_usize;
    while i < vs.len {
        if vs[i] == k {
            return i;
        }
        i = i +% 1_usize;
    }
    return null;
}

fn dbm_get_interval(st: *DbmState, k: VarKey) -> Interval {
    var iv = st.core.intervals.get(k) orelse st.default_interval(k);
    if let idx_u32 = st.core.vmap.get(k) {
        let idx = idx_u32.widen.[usize]();
        let hi_b = st.core.mat_get(idx, 0_usize);
        let lo_b = st.core.mat_get(0_usize, idx);
        var has_lo = false;
        var lo = types.int_val_zero();
        if lo_b.has_val {
            if let nl = types.int_val_checked_neg(lo_b.val) {
                has_lo = true;
                lo = nl;
            }
        }
        let dbm_iv = Interval.{ has_lo: has_lo, lo: lo, has_hi: hi_b.has_val, hi: hi_b.val };
        iv = interval_intersect(&iv, &dbm_iv);
    }
    return iv;
}

fn dbm_diff_upper(st: *DbmState, u: VarKey, v: VarKey) -> Bound {
    if u == v {
        return bound_some(types.int_val_zero());
    }
    var best = bound_none();
    if let ui_u32 = st.core.vmap.get(u) {
        if let vi_u32 = st.core.vmap.get(v) {
            best = bound_min(copy best, st.core.mat_get(ui_u32.widen.[usize](), vi_u32.widen.[usize]()));
        }
    }
    let iu = dbm_get_interval(st, u);
    let iv = dbm_get_interval(st, v);
    if iu.has_hi && iv.has_lo {
        if let d = types.int_val_checked_sub(iu.hi, iv.lo) {
            best = bound_min(copy best, bound_some(d));
        }
    }
    return best;
}

fn dbm_is_non_zero(st: *DbmState, k: VarKey) -> bool {
    if vk_set_contains(st.aux.non_zero.as_slice(), k) {
        return true;
    }
    let iv = dbm_get_interval(st, k);
    let z = types.int_val_zero();
    return (iv.has_lo && iv_gt(iv.lo, z)) || (iv.has_hi && iv_lt(iv.hi, z));
}

fn vert_bit(idx: usize) -> u64 {
    if idx >= 1_usize && idx <= 64_usize {
        return 1_u64 <<% (idx - 1_usize).trunc.[u64]();
    }
    return 0_u64;
}

fn dbm_close_around(st: *mut DbmState, u: usize, v: usize) -> u64 {
    if st.core.is_bottom {
        return 0_u64;
    }
    let n = st.core.verts.len();
    let stride = st.core.mat_stride;
    let is_closed = st.core.is_closed;
    let ms = st.core.mat.as_mut_slice();
    let uv_idx = (u *% stride) +% v;
    if uv_idx >= ms.len {
        return 0_u64;
    }
    let cb = ms[uv_idx];
    if !cb.has_val {
        return 0_u64;
    }
    let c_lo = cb.val.lo;
    let c_hi = cb.val.hi;
    let c_neg = c_hi < 0_i64;

    // Early negative-cycle check on `(v, u) + (u, v) < 0`.
    let vu_idx = (v *% stride) +% u;
    if vu_idx < ms.len && ms[vu_idx].has_val {
        let vu_lo = ms[vu_idx].val.lo;
        let vu_hi = ms[vu_idx].val.hi;
        let cyc_lo = vu_lo +% c_lo;
        let cyc_carry: i64 = if cyc_lo < vu_lo { 1_i64 } else { 0_i64 };
        let cyc_hi = vu_hi +% c_hi +% cyc_carry;
        let vu_neg = vu_hi < 0_i64;
        let cyc_neg = cyc_hi < 0_i64;
        if !(vu_neg == c_neg && cyc_neg != vu_neg) && cyc_neg {
            st.core.is_bottom = true;
            return 0_u64;
        }
    }

    // Pre-collect active columns `j` (with Miné filter `c + M[v][j] < M[u][j]` when closed).
    var active_j: [72]usize = [0_usize; 72];
    var active_j_lo: [72]u64 = [0_u64; 72];
    var active_j_hi: [72]i64 = [0_i64; 72];
    var nj: usize = 0_usize;
    let u_row = u *% stride;
    let v_row = v *% stride;
    var j0: usize = 0_usize;
    while j0 < n && nj < 72_usize {
        let vj_idx = v_row +% j0;
        if vj_idx < ms.len {
            let d_vj = ms[vj_idx];
            if d_vj.has_val {
                var keep_j = true;
                if is_closed && j0 != v {
                    let uj_idx = u_row +% j0;
                    if uj_idx < ms.len {
                        let d_uj = ms[uj_idx];
                        if d_uj.has_val {
                            let cv_lo = c_lo +% d_vj.val.lo;
                            let cv_carry: i64 = if cv_lo < c_lo { 1_i64 } else { 0_i64 };
                            let cv_hi = c_hi +% d_vj.val.hi +% cv_carry;
                            let vj_neg = d_vj.val.hi < 0_i64;
                            let cv_neg = cv_hi < 0_i64;
                            if c_neg == vj_neg && cv_neg != c_neg {
                                // Overflow in `c + M[v][j]`: check sign to avoid dropping valid negative wrap; conservatively keep.
                                keep_j = true;
                            } else if cv_hi > d_uj.val.hi || (cv_hi == d_uj.val.hi && cv_lo >= d_uj.val.lo) {
                                keep_j = false;
                            }
                        }
                    }
                }
                if keep_j {
                    active_j[nj] = j0;
                    active_j_lo[nj] = d_vj.val.lo;
                    active_j_hi[nj] = d_vj.val.hi;
                    nj = nj +% 1_usize;
                }
            }
        }
        j0 = j0 +% 1_usize;
    }
    if nj == 0_usize {
        return 0_u64;
    }

    // Pre-collect active rows `i` (with Miné filter `M[i][u] + c < M[i][v]` when closed).
    var active_i: [72]usize = [0_usize; 72];
    var active_i_lo: [72]u64 = [0_u64; 72];
    var active_i_hi: [72]i64 = [0_i64; 72];
    var ni: usize = 0_usize;
    var i0: usize = 0_usize;
    while i0 < n && ni < 72_usize {
        let i_row0 = i0 *% stride;
        let iu_idx = i_row0 +% u;
        if iu_idx < ms.len {
            let d_iu = ms[iu_idx];
            if d_iu.has_val {
                let sum_lo = d_iu.val.lo +% c_lo;
                let sum_carry: i64 = if sum_lo < d_iu.val.lo { 1_i64 } else { 0_i64 };
                let sum_hi = d_iu.val.hi +% c_hi +% sum_carry;
                let iu_neg = d_iu.val.hi < 0_i64;
                let sum_neg = sum_hi < 0_i64;
                if !(iu_neg == c_neg && sum_neg != iu_neg) {
                    var keep_i = true;
                    if is_closed && i0 != u {
                        let iv_idx = i_row0 +% v;
                        if iv_idx < ms.len {
                            let d_iv = ms[iv_idx];
                            if d_iv.has_val {
                                if sum_hi > d_iv.val.hi || (sum_hi == d_iv.val.hi && sum_lo >= d_iv.val.lo) {
                                    keep_i = false;
                                }
                            }
                        }
                    }
                    if keep_i {
                        active_i[ni] = i0;
                        active_i_lo[ni] = sum_lo;
                        active_i_hi[ni] = sum_hi;
                        ni = ni +% 1_usize;
                    }
                }
            }
        }
        i0 = i0 +% 1_usize;
    }

    var dirty_mask: u64 = 0_u64;
    var ii: usize = 0_usize;
    while ii < ni && ii < 72_usize {
        let i = active_i[ii];
        let i_row = i *% stride;
        let sum_lo = active_i_lo[ii];
        let sum_hi = active_i_hi[ii];
        let sum_neg = sum_hi < 0_i64;
        var k: usize = 0_usize;
        while k < nj && k < 72_usize {
            let vj_lo = active_j_lo[k];
            let vj_hi = active_j_hi[k];
            let cand_lo = sum_lo +% vj_lo;
            let cand_carry: i64 = if cand_lo < sum_lo { 1_i64 } else { 0_i64 };
            let cand_hi = sum_hi +% vj_hi +% cand_carry;
            let vj_neg = vj_hi < 0_i64;
            let cand_neg = cand_hi < 0_i64;
            if !(sum_neg == vj_neg && cand_neg != sum_neg) {
                let j = active_j[k];
                let ij_idx = i_row +% j;
                if ij_idx < ms.len {
                    let cur = ms[ij_idx];
                    let tighter = if !cur.has_val {
                        true
                    } else if cand_hi != cur.val.hi {
                        cand_hi < cur.val.hi
                    } else {
                        cand_lo < cur.val.lo
                    };
                    if tighter {
                        ms[ij_idx] = Bound.{
                            has_val: true,
                            val: types.IntVal.{ lo: cand_lo, hi: cand_hi },
                        };
                        if j == 0_usize {
                            dirty_mask = dirty_mask | vert_bit(i);
                        } else if i == 0_usize {
                            dirty_mask = dirty_mask | vert_bit(j);
                        }
                        if i == j && cand_neg {
                            st.core.is_bottom = true;
                            return dirty_mask;
                        }
                    }
                }
            }
            k = k +% 1_usize;
        }
        ii = ii +% 1_usize;
    }
    return dirty_mask;
}

fn dbm_sync_one_vertex(st: *mut DbmState, alloc: *mut AllocCap, i: usize) -> !OutOfMemory {
    let vs = st.core.verts.as_slice();
    if i == 0_usize || i >= vs.len {
        return;
    }
    let k = vs[i];
    if k == VK_NONE {
        return;
    }
    let stride = st.core.mat_stride;
    let ms = st.core.mat.as_slice();
    let i0_idx = i *% stride;
    let hi_b = if i0_idx < ms.len { ms[i0_idx] } else { bound_none() };
    let lo_b = if i < ms.len { ms[i] } else { bound_none() };

    var has_lo = false;
    var lo = types.int_val_zero();
    if lo_b.has_val {
        if let nl = types.int_val_checked_neg(lo_b.val) {
            has_lo = true;
            lo = nl;
        }
    }
    let dbm_iv = Interval.{ has_lo: has_lo, lo: lo, has_hi: hi_b.has_val, hi: hi_b.val };
    let z = types.int_val_zero();
    if let cur = st.core.intervals.get(k) {
        if !dbm_iv.has_lo && !dbm_iv.has_hi {
            return;
        }
        let next = interval_intersect(&cur, &dbm_iv);
        if interval_is_empty(&next) {
            st.core.is_bottom = true;
            return;
        }
        if !interval_eq(&next, &cur) {
            if (next.has_lo && iv_gt(next.lo, z)) || (next.has_hi && iv_lt(next.hi, z)) {
                try vk_set_insert(&mut st.aux.non_zero, alloc, k);
            }
            try st.put_interval_if_nontrivial(alloc, k, next);
        }
    } else {
        let def_iv = st.default_interval(k);
        let next = interval_intersect(&def_iv, &dbm_iv);
        if interval_is_empty(&next) {
            st.core.is_bottom = true;
            return;
        }
        if (next.has_lo && iv_gt(next.lo, z)) || (next.has_hi && iv_lt(next.hi, z)) {
            try vk_set_insert(&mut st.aux.non_zero, alloc, k);
        }
        try st.put_interval_if_nontrivial(alloc, k, next);
    }
    return;
}

fn dbm_sync_intervals_mask(st: *mut DbmState, alloc: *mut AllocCap, mask: u64) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    var m = mask | st.core.unsynced_mask;
    st.core.unsynced_mask = 0_u64;
    while m != 0_u64 {
        let bit = (@tzcnt(m) & 63_u64).trunc.[usize]();
        try dbm_sync_one_vertex(st, alloc, bit +% 1_usize);
        if st.core.is_bottom {
            return;
        }
        m = m & (m -% 1_u64);
    }
    return;
}

fn dbm_sync_intervals_from_dbm(st: *mut DbmState, alloc: *mut AllocCap) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    st.core.unsynced_mask = 0_u64;
    let n = st.core.verts.len();
    var i: usize = 1_usize;
    while i < n {
        try dbm_sync_one_vertex(st, alloc, i);
        if st.core.is_bottom {
            return;
        }
        i = i +% 1_usize;
    }
    return;
}

fn dbm_pick_evict_victim(vs: *[VarKey], has_prot: bool, prot: VarKey) -> usize {
    var best_idx: usize = 0_usize;
    var best_key: VarKey = VK_NONE;
    var found = false;
    var i: usize = 1_usize;
    while i < vs.len {
        let k = vs[i];
        if k != VK_NONE && !vk_is_priority(k) && (!has_prot || k != prot) {
            if !found || k < best_key {
                found = true;
                best_idx = i;
                best_key = k;
            }
        }
        i = i +% 1_usize;
    }
    if found {
        return best_idx;
    }
    i = 1_usize;
    while i < vs.len {
        let k = vs[i];
        if k != VK_NONE && !vk_is_len(k) && (!has_prot || k != prot) {
            if !found || k < best_key {
                found = true;
                best_idx = i;
                best_key = k;
            }
        }
        i = i +% 1_usize;
    }
    if found {
        return best_idx;
    }
    i = 1_usize;
    while i < vs.len {
        let k = vs[i];
        if !has_prot || k != prot {
            return i;
        }
        i = i +% 1_usize;
    }
    return 1_usize;
}

fn dbm_evict_one_vertex(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    has_prot: bool,
    prot: VarKey,
) -> !OutOfMemory {
    let n = st.core.verts.len();
    if n <= 1_usize {
        return;
    }
    let victim = dbm_pick_evict_victim(st.core.verts.as_slice(), has_prot, prot);
    var vk = VK_NONE;
    let vs0 = st.core.verts.as_slice();
    if victim < vs0.len {
        vk = vs0[victim];
    }
    if vk != VK_NONE {
        let iv = dbm_get_interval(st, vk);
        try st.put_interval_if_nontrivial(alloc, vk, iv);
        _ = st.core.vmap.remove(vk);
    }
    let last = n - 1_usize;
    if victim != last {
        var moved = VK_NONE;
        let vs_mut = st.core.verts.as_mut_slice();
        if last < vs_mut.len && victim < vs_mut.len {
            moved = vs_mut[last];
            vs_mut[victim] = moved;
        }
        if moved != VK_NONE {
            try st.core.vmap.insert(alloc, moved, victim.trunc.[u32]());
        }
        var c: usize = 0_usize;
        while c < n {
            let a = st.core.mat_get(victim, c);
            let b = st.core.mat_get(last, c);
            st.core.mat_set(victim, c, b);
            st.core.mat_set(last, c, a);
            c = c +% 1_usize;
        }
        var r: usize = 0_usize;
        while r < n {
            let a = st.core.mat_get(r, victim);
            let b = st.core.mat_get(r, last);
            st.core.mat_set(r, victim, b);
            st.core.mat_set(r, last, a);
            r = r +% 1_usize;
        }
        st.core.unsynced_mask = (st.core.unsynced_mask & (~vert_bit(last))) | vert_bit(victim);
    } else {
        st.core.unsynced_mask = st.core.unsynced_mask & (~vert_bit(last));
    }
    _ = st.core.verts.pop();
    return;
}

fn dbm_ensure_vertex(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    k: VarKey,
    has_prot: bool,
    prot: VarKey,
) -> usize ! OutOfMemory {
    if let existing = st.core.vmap.get(k) {
        return existing.widen.[usize]();
    }
    if st.core.verts.len() > MAX_DBM_VERTS {
        try dbm_evict_one_vertex(st, alloc, has_prot, prot);
    }
    let idx = st.core.verts.len();
    try st.core.ensure_mat_stride(alloc, idx +% 1_usize);
    try st.core.verts.push(alloc, k);
    try st.core.vmap.insert(alloc, k, idx.trunc.[u32]());
    var j: usize = 0_usize;
    while j <= idx {
        st.core.mat_set(idx, j, bound_none());
        st.core.mat_set(j, idx, bound_none());
        j = j +% 1_usize;
    }
    st.core.mat_set(idx, idx, bound_some(types.int_val_zero()));

    let init_iv = st.core.intervals.get(k) orelse st.default_interval(k);
    if init_iv.has_lo || init_iv.has_hi {
        if init_iv.has_hi {
            let prev_i0 = st.core.mat_get(idx, 0_usize);
            st.core.mat_set(idx, 0_usize, bound_min(prev_i0, bound_some(init_iv.hi)));
            let d1 = dbm_close_around(st, idx, 0_usize);
            st.core.unsynced_mask = st.core.unsynced_mask | d1;
        }
        if init_iv.has_lo {
            if let nl = types.int_val_checked_neg(init_iv.lo) {
                let prev_0i = st.core.mat_get(0_usize, idx);
                st.core.mat_set(0_usize, idx, bound_min(prev_0i, bound_some(nl)));
                let d2 = dbm_close_around(st, 0_usize, idx);
                st.core.unsynced_mask = st.core.unsynced_mask | d2;
            }
        }
    } else {
        st.core.unsynced_mask = st.core.unsynced_mask | vert_bit(idx);
    }
    return idx;
}

fn dbm_add_upper(st: *mut DbmState, alloc: *mut AllocCap, k: VarKey, hi: types.IntVal) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    let old_iv = dbm_get_interval(st, k);
    let hi_iv = Interval.{ has_lo: false, lo: types.int_val_zero(), has_hi: true, hi: hi };
    let cur = interval_intersect(&old_iv, &hi_iv);
    if interval_is_empty(&cur) {
        st.core.is_bottom = true;
        return;
    }
    if cur.has_hi && types.int_val_is_neg(cur.hi) {
        try vk_set_insert(&mut st.aux.non_zero, alloc, k);
    }
    try st.put_interval_if_nontrivial(alloc, k, cur);
    if let idx_u32 = st.core.vmap.get(k) {
        let idx = idx_u32.widen.[usize]();
        let hi_b = bound_some(hi);
        let cur_b = st.core.mat_get(idx, 0_usize);
        if bound_lt(&hi_b, &cur_b) {
            st.core.mat_set(idx, 0_usize, hi_b);
            let dirty = dbm_close_around(st, idx, 0_usize);
            try dbm_sync_intervals_mask(st, alloc, dirty | vert_bit(idx));
        }
    }
    return;
}

fn dbm_add_lower(st: *mut DbmState, alloc: *mut AllocCap, k: VarKey, lo: types.IntVal) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    let old_iv = dbm_get_interval(st, k);
    let lo_iv = Interval.{ has_lo: true, lo: lo, has_hi: false, hi: types.int_val_zero() };
    let cur = interval_intersect(&old_iv, &lo_iv);
    if interval_is_empty(&cur) {
        st.core.is_bottom = true;
        return;
    }
    if cur.has_lo && iv_gt(cur.lo, types.int_val_zero()) {
        try vk_set_insert(&mut st.aux.non_zero, alloc, k);
    }
    try st.put_interval_if_nontrivial(alloc, k, cur);
    if let neg_lo = types.int_val_checked_neg(lo) {
        if let idx_u32 = st.core.vmap.get(k) {
            let idx = idx_u32.widen.[usize]();
            let nl_b = bound_some(neg_lo);
            let cur_b = st.core.mat_get(0_usize, idx);
            if bound_lt(&nl_b, &cur_b) {
                st.core.mat_set(0_usize, idx, nl_b);
                let dirty = dbm_close_around(st, 0_usize, idx);
                try dbm_sync_intervals_mask(st, alloc, dirty | vert_bit(idx));
            }
        }
    }
    return;
}

fn dbm_set_interval(st: *mut DbmState, alloc: *mut AllocCap, k: VarKey, iv: Interval) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    if interval_is_empty(&iv) {
        st.core.is_bottom = true;
        return;
    }
    let old_iv = dbm_get_interval(st, k);
    let cur = interval_intersect(&old_iv, &iv);
    if interval_is_empty(&cur) {
        st.core.is_bottom = true;
        return;
    }
    let z = types.int_val_zero();
    if (cur.has_lo && iv_gt(cur.lo, z)) || (cur.has_hi && iv_lt(cur.hi, z)) {
        try vk_set_insert(&mut st.aux.non_zero, alloc, k);
    }
    let cur_has_lo = cur.has_lo;
    let cur_lo = cur.lo;
    let cur_has_hi = cur.has_hi;
    let cur_hi = cur.hi;
    try st.put_interval_if_nontrivial(alloc, k, cur);
    if st.core.vmap.contains(k) {
        if cur_has_lo {
            try dbm_add_lower(st, alloc, k, cur_lo);
        }
        if cur_has_hi {
            try dbm_add_upper(st, alloc, k, cur_hi);
        }
    }
    return;
}

fn dbm_add_diff(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    u: VarKey,
    v: VarKey,
    c: types.IntVal,
) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    if u == v {
        if types.int_val_is_neg(c) {
            st.core.is_bottom = true;
        }
        return;
    }
    let iu = dbm_get_interval(st, u);
    let iv = dbm_get_interval(st, v);
    if st.is_const_lit(v) && interval_is_const(&iv) {
        if let hi = types.int_val_checked_add(iv.lo, c) {
            try dbm_add_upper(st, alloc, u, hi);
        }
        return;
    }
    if st.is_const_lit(u) && interval_is_const(&iu) {
        if let lo = types.int_val_checked_sub(iu.lo, c) {
            try dbm_add_lower(st, alloc, v, lo);
        }
        return;
    }
    if !st.var_is_relational(u) || !st.var_is_relational(v) {
        return;
    }
    _ = try dbm_ensure_vertex(st, alloc, u, true, v);
    _ = try dbm_ensure_vertex(st, alloc, v, true, u);
    let ui_u32 = st.core.vmap.get(u) orelse {
        return;
    };
    let vi_u32 = st.core.vmap.get(v) orelse {
        return;
    };
    let ui = ui_u32.widen.[usize]();
    let vi = vi_u32.widen.[usize]();
    let cb = bound_some(c);
    let cur_b = st.core.mat_get(ui, vi);
    if bound_lt(&cb, &cur_b) {
        st.core.mat_set(ui, vi, cb);
        var dmask = dbm_close_around(st, ui, vi);
        if ui == 0_usize {
            dmask = dmask | vert_bit(vi);
        } else if vi == 0_usize {
            dmask = dmask | vert_bit(ui);
        }
        try dbm_sync_intervals_mask(st, alloc, dmask);
    }
    return;
}

fn dbm_add_eq(st: *mut DbmState, alloc: *mut AllocCap, u: VarKey, v: VarKey) -> !OutOfMemory {
    let z = types.int_val_zero();
    try dbm_add_diff(st, alloc, u, v, z);
    try dbm_add_diff(st, alloc, v, u, z);
    if dbm_is_non_zero(st, u) {
        try vk_set_insert(&mut st.aux.non_zero, alloc, v);
    } else if dbm_is_non_zero(st, v) {
        try vk_set_insert(&mut st.aux.non_zero, alloc, u);
    }
    return;
}

fn dbm_add_const(st: *mut DbmState, alloc: *mut AllocCap, k: VarKey, c: types.IntVal) -> !OutOfMemory {
    try dbm_set_interval(st, alloc, k, interval_const(c));
    if !types.int_val_is_zero(c) {
        try vk_set_insert(&mut st.aux.non_zero, alloc, k);
    }
    return;
}

fn dbm_forget(st: *mut DbmState, k: VarKey) {
    _ = st.core.intervals.remove(k);
    vk_set_remove(&mut st.aux.non_zero, k);
    kb_map_remove(&mut st.aux.known_bits, k);
    pair_map_forget_key(&mut st.aux.diff_exprs, k);
    pair_map_forget_key(&mut st.aux.sum_exprs, k);
    if let idx_u32 = st.core.vmap.get(k) {
        let idx = idx_u32.widen.[usize]();
        let n = st.core.verts.len();
        var j: usize = 0_usize;
        while j < n {
            let v = if j == idx { bound_some(types.int_val_zero()) } else { bound_none() };
            st.core.mat_set(idx, j, copy v);
            st.core.mat_set(j, idx, v);
            j = j +% 1_usize;
        }
    }
}

fn dbm_forget_fields_for_slot(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    slot: eir.EirSlot,
) -> !OutOfMemory {
    var keys = try col.DynBuf.[VarKey].init(alloc, 8_usize);
    errdefer keys.destroy(alloc);
    let iks = st.core.intervals.keys_slice();
    var i: usize = 0_usize;
    while i < iks.len {
        let k = iks[i];
        let t = vk_tag(k);
        if (t == VK_TAG_FIELD_SLOT || t == VK_TAG_FIELD_LEN_SLOT) && vk_a(k) == slot {
            try vk_set_insert(&mut keys, alloc, k);
        }
        i = i +% 1_usize;
    }
    let vs = st.core.verts.as_slice();
    i = 1_usize;
    while i < vs.len {
        let k = vs[i];
        let t = vk_tag(k);
        if (t == VK_TAG_FIELD_SLOT || t == VK_TAG_FIELD_LEN_SLOT) && vk_a(k) == slot {
            try vk_set_insert(&mut keys, alloc, k);
        }
        i = i +% 1_usize;
    }
    let ks = keys.as_slice();
    i = 0_usize;
    while i < ks.len {
        dbm_forget(st, ks[i]);
        i = i +% 1_usize;
    }
    val_slot_remove_by_slot(&mut st.aux.val_slot_origin, slot);
    keys.destroy(alloc);
    return;
}

fn is_mutable_field_key(
    st: *DbmState,
    k: VarKey,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> bool {
    let t = vk_tag(k);
    if t == VK_TAG_FIELD_SLOT || t == VK_TAG_FIELD_LEN_SLOT {
        return true;
    }
    if t == VK_TAG_SLOT || t == VK_TAG_LEN_SLOT {
        return st.mut_addr_slots.test(vk_a(k).widen.[usize]());
    }
    if t == VK_TAG_FIELD_VAL || t == VK_TAG_FIELD_LEN_VAL {
        let ty = eir_prog.fn_val_ty(fn_id, vk_a(k));
        let tn = env.get(ty);
        return !(tn.kind == .Borrow && !tn.flag0);
    }
    return false;
}

fn dbm_forget_all_mutable_fields(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    var keys = try col.DynBuf.[VarKey].init(alloc, 8_usize);
    errdefer keys.destroy(alloc);
    let iks = st.core.intervals.keys_slice();
    var i: usize = 0_usize;
    while i < iks.len {
        let k = iks[i];
        if is_mutable_field_key(st, k, eir_prog, fn_id, env) {
            try vk_set_insert(&mut keys, alloc, k);
        }
        i = i +% 1_usize;
    }
    let vs = st.core.verts.as_slice();
    i = 1_usize;
    while i < vs.len {
        let k = vs[i];
        if is_mutable_field_key(st, k, eir_prog, fn_id, env) {
            try vk_set_insert(&mut keys, alloc, k);
        }
        i = i +% 1_usize;
    }
    let kbs = st.aux.known_bits.as_slice();
    i = 0_usize;
    while i < kbs.len {
        let k = kbs[i].key;
        if is_mutable_field_key(st, k, eir_prog, fn_id, env) {
            try vk_set_insert(&mut keys, alloc, k);
        }
        i = i +% 1_usize;
    }
    let nzs = st.aux.non_zero.as_slice();
    i = 0_usize;
    while i < nzs.len {
        let k = nzs[i];
        if is_mutable_field_key(st, k, eir_prog, fn_id, env) {
            try vk_set_insert(&mut keys, alloc, k);
        }
        i = i +% 1_usize;
    }
    let ks = keys.as_slice();
    i = 0_usize;
    while i < ks.len {
        dbm_forget(st, ks[i]);
        i = i +% 1_usize;
    }
    // Also forget checked_op facts on mutably-addressed slots.
    let sc_n = st.aux.slot_checked_op.len();
    if sc_n > 0_usize {
        var w: usize = 0_usize;
        var r: usize = 0_usize;
        let ms = st.aux.slot_checked_op.as_mut_slice();
        while r < sc_n && r < ms.len {
            let e = ms[r];
            if !st.mut_addr_slots.test(e.id.widen.[usize]()) {
                if w < ms.len {
                    ms[w] = e;
                }
                w = w +% 1_usize;
            }
            r = r +% 1_usize;
        }
        while st.aux.slot_checked_op.len() > w {
            _ = st.aux.slot_checked_op.pop();
        }
    }
    keys.destroy(alloc);
    return;
}

fn dbm_assign_offset(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    dst: VarKey,
    src: VarKey,
    offset: types.IntVal,
    dst_tb: types.IntBounds,
) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    if dst == src {
        let old_iv = dbm_get_interval(st, src);
        if let idx_u32 = st.core.vmap.get(src) {
            let idx = idx_u32.widen.[usize]();
            let n = st.core.verts.len();
            let neg_off = types.int_val_checked_neg(offset);
            var j: usize = 0_usize;
            while j < n {
                if j != idx {
                    let prev_ij = st.core.mat_get(idx, j);
                    st.core.mat_set(idx, j, bound_add(prev_ij, bound_some(offset)));
                    let prev_ji = st.core.mat_get(j, idx);
                    let rev = if let no = neg_off {
                        bound_add(prev_ji, bound_some(no))
                    } else {
                        bound_none()
                    };
                    st.core.mat_set(j, idx, rev);
                }
                j = j +% 1_usize;
            }
        }
        var has_lo = false;
        var lo = types.int_val_zero();
        if old_iv.has_lo {
            if let s = types.int_val_checked_add(old_iv.lo, offset) {
                has_lo = true;
                lo = s;
            }
        }
        var has_hi = false;
        var hi = types.int_val_zero();
        if old_iv.has_hi {
            if let s = types.int_val_checked_add(old_iv.hi, offset) {
                has_hi = true;
                hi = s;
            }
        }
        try st.put_interval_if_nontrivial(
            alloc,
            dst,
            Interval.{ has_lo: has_lo, lo: lo, has_hi: has_hi, hi: hi },
        );
        vk_set_remove(&mut st.aux.non_zero, dst);
        if dst_tb.valid {
            try dbm_set_interval(st, alloc, dst, tb_to_interval(dst_tb));
        }
        try dbm_sync_intervals_from_dbm(st, alloc);
        return;
    }
    let src_iv = dbm_get_interval(st, src);
    let src_nz = dbm_is_non_zero(st, src);
    dbm_forget(st, dst);
    if dst_tb.valid {
        try dbm_set_interval(st, alloc, dst, tb_to_interval(dst_tb));
    }
    var has_lo = false;
    var lo = types.int_val_zero();
    if src_iv.has_lo {
        if let s = types.int_val_checked_add(src_iv.lo, offset) {
            has_lo = true;
            lo = s;
        }
    }
    var has_hi = false;
    var hi = types.int_val_zero();
    if src_iv.has_hi {
        if let s = types.int_val_checked_add(src_iv.hi, offset) {
            has_hi = true;
            hi = s;
        }
    }
    try dbm_set_interval(st, alloc, dst, Interval.{ has_lo: has_lo, lo: lo, has_hi: has_hi, hi: hi });
    try dbm_add_diff(st, alloc, dst, src, offset);
    if let neg = types.int_val_checked_neg(offset) {
        try dbm_add_diff(st, alloc, src, dst, neg);
    }
    if types.int_val_is_zero(offset) && src_nz {
        try vk_set_insert(&mut st.aux.non_zero, alloc, dst);
    }
    return;
}

// ===========================================================================
// Section 7: Predicate Refinement, Difference/Sum Algebra, & Lattice Joins
// ===========================================================================

fn refine_neq_const(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    target: VarKey,
    tiv: *Interval,
    c: types.IntVal,
) -> !OutOfMemory {
    if types.int_val_is_zero(c) {
        try vk_set_insert(&mut st.aux.non_zero, alloc, target);
    }
    if tiv.has_lo && tiv.has_hi && types.int_val_eq(tiv.lo, c) && types.int_val_eq(tiv.hi, c) {
        st.core.is_bottom = true;
        return;
    }
    if tiv.has_lo && types.int_val_eq(tiv.lo, c) {
        if let c1 = types.int_val_checked_add(c, iv_one()) {
            try dbm_add_lower(st, alloc, target, c1);
        }
    }
    if tiv.has_hi && types.int_val_eq(tiv.hi, c) {
        if let cm1 = types.int_val_checked_sub(c, iv_one()) {
            try dbm_add_upper(st, alloc, target, cm1);
        }
    }
    return;
}

fn apply_diff_const(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    a: VarKey,
    b: VarKey,
    eff_op: CmpOp,
    c: types.IntVal,
) -> !OutOfMemory {
    match eff_op {
        .GtEq => {
            if let nc = types.int_val_checked_neg(c) {
                try dbm_add_diff(st, alloc, b, a, nc);
            }
        }
        .Gt => {
            if let c1 = types.int_val_checked_add(c, iv_one()) {
                if let nc1 = types.int_val_checked_neg(c1) {
                    try dbm_add_diff(st, alloc, b, a, nc1);
                }
            }
        }
        .LtEq => {
            try dbm_add_diff(st, alloc, a, b, c);
        }
        .Lt => {
            if let cm1 = types.int_val_checked_sub(c, iv_one()) {
                try dbm_add_diff(st, alloc, a, b, cm1);
            }
        }
        .Eq => {
            try dbm_add_diff(st, alloc, a, b, c);
            if let nc = types.int_val_checked_neg(c) {
                try dbm_add_diff(st, alloc, b, a, nc);
            }
        }
        .NotEq => {}
    }
    return;
}

fn apply_sum_upper(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    a: VarKey,
    b: VarKey,
    bound: VarKey,
    strict: bool,
) -> !OutOfMemory {
    let extra = if strict { iv_one() } else { types.int_val_zero() };
    let bi = dbm_get_interval(st, b);
    if bi.has_lo {
        if let sum = types.int_val_checked_add(bi.lo, extra) {
            if let edge = types.int_val_checked_neg(sum) {
                try dbm_add_diff(st, alloc, a, bound, edge);
            }
        }
    }
    let ai = dbm_get_interval(st, a);
    if ai.has_lo {
        if let sum = types.int_val_checked_add(ai.lo, extra) {
            if let edge = types.int_val_checked_neg(sum) {
                try dbm_add_diff(st, alloc, b, bound, edge);
            }
        }
    }
    return;
}

fn dbm_refine_cmp(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    op: CmpOp,
    lhs: VarKey,
    rhs: VarKey,
) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    match op {
        .Lt => { try dbm_add_diff(st, alloc, lhs, rhs, iv_neg_one()); }
        .LtEq => { try dbm_add_diff(st, alloc, lhs, rhs, types.int_val_zero()); }
        .Gt => { try dbm_add_diff(st, alloc, rhs, lhs, iv_neg_one()); }
        .GtEq => { try dbm_add_diff(st, alloc, rhs, lhs, types.int_val_zero()); }
        .Eq => { try dbm_add_eq(st, alloc, lhs, rhs); }
        .NotEq => {
            if lhs == rhs {
                st.core.is_bottom = true;
                return;
            }
            let li = dbm_get_interval(st, lhs);
            let ri = dbm_get_interval(st, rhs);
            if interval_is_const(&ri) {
                try refine_neq_const(st, alloc, lhs, &li, ri.lo);
                if st.core.is_bottom {
                    return;
                }
            }
            if interval_is_const(&li) {
                try refine_neq_const(st, alloc, rhs, &ri, li.lo);
                if st.core.is_bottom {
                    return;
                }
            }
        }
    }
    let li2 = dbm_get_interval(st, lhs);
    let ri2 = dbm_get_interval(st, rhs);
    if let de = pair_map_get(st.aux.diff_exprs.as_slice(), lhs) {
        if de.no_wrap && interval_is_const(&ri2) {
            try apply_diff_const(st, alloc, de.a, de.b, op, ri2.lo);
        }
    }
    if let de = pair_map_get(st.aux.diff_exprs.as_slice(), rhs) {
        if de.no_wrap && interval_is_const(&li2) {
            try apply_diff_const(st, alloc, de.a, de.b, cmp_flip(op), li2.lo);
        }
    }
    if let se = pair_map_get(st.aux.sum_exprs.as_slice(), lhs) {
        if se.no_wrap {
            if op == .Lt {
                try apply_sum_upper(st, alloc, se.a, se.b, rhs, true);
            } else if op == .LtEq || op == .Eq {
                try apply_sum_upper(st, alloc, se.a, se.b, rhs, false);
            }
        }
    }
    if let se = pair_map_get(st.aux.sum_exprs.as_slice(), rhs) {
        if se.no_wrap {
            if op == .Gt {
                try apply_sum_upper(st, alloc, se.a, se.b, lhs, true);
            } else if op == .GtEq || op == .Eq {
                try apply_sum_upper(st, alloc, se.a, se.b, lhs, false);
            }
        }
    }
    return;
}

fn intersect_vk_sets(
    alloc: *mut AllocCap,
    a: *[VarKey],
    b: *[VarKey],
    out: *mut col.DynBuf[VarKey],
) -> !OutOfMemory {
    var i: usize = 0_usize;
    var j: usize = 0_usize;
    while i < a.len && j < b.len {
        if a[i] == b[j] {
            try out.push(alloc, a[i]);
            i = i +% 1_usize;
            j = j +% 1_usize;
        } else if a[i] < b[j] {
            i = i +% 1_usize;
        } else {
            j = j +% 1_usize;
        }
    }
    return;
}

fn intersect_preds(
    alloc: *mut AllocCap,
    a: *[ValPredEntry],
    b: *[ValPredEntry],
    out: *mut col.DynBuf[ValPredEntry],
) -> !OutOfMemory {
    var i: usize = 0_usize;
    var j: usize = 0_usize;
    while i < a.len && j < b.len {
        if a[i].val == b[j].val {
            if a[i].pred == b[j].pred {
                try out.push(alloc, a[i]);
            }
            i = i +% 1_usize;
            j = j +% 1_usize;
        } else if a[i].val < b[j].val {
            i = i +% 1_usize;
        } else {
            j = j +% 1_usize;
        }
    }
    return;
}

fn intersect_pairs(
    alloc: *mut AllocCap,
    a: *[PairExprEntry],
    b: *[PairExprEntry],
    has_wkeys: bool,
    wkeys: *[VarKey],
    out: *mut col.DynBuf[PairExprEntry],
) -> !OutOfMemory {
    var i: usize = 0_usize;
    var j: usize = 0_usize;
    while i < a.len && j < b.len {
        if a[i].key == b[j].key {
            if a[i].a == b[j].a && a[i].b == b[j].b && a[i].ty == b[j].ty && a[i].no_wrap == b[j].no_wrap {
                if !has_wkeys || !vk_set_contains(wkeys, a[i].key) {
                    try out.push(alloc, a[i]);
                }
            }
            i = i +% 1_usize;
            j = j +% 1_usize;
        } else if a[i].key < b[j].key {
            i = i +% 1_usize;
        } else {
            j = j +% 1_usize;
        }
    }
    return;
}

fn intersect_checked_ops(
    alloc: *mut AllocCap,
    a: *[CheckedOpEntry],
    b: *[CheckedOpEntry],
    out: *mut col.DynBuf[CheckedOpEntry],
) -> !OutOfMemory {
    var i: usize = 0_usize;
    var j: usize = 0_usize;
    while i < a.len && j < b.len {
        if a[i].id == b[j].id {
            if checked_op_eq(&a[i], &b[j]) {
                try out.push(alloc, a[i]);
            }
            i = i +% 1_usize;
            j = j +% 1_usize;
        } else if a[i].id < b[j].id {
            i = i +% 1_usize;
        } else {
            j = j +% 1_usize;
        }
    }
    return;
}

fn intersect_val_slots(
    alloc: *mut AllocCap,
    a: *[ValSlotEntry],
    b: *[ValSlotEntry],
    out: *mut col.DynBuf[ValSlotEntry],
) -> !OutOfMemory {
    var i: usize = 0_usize;
    var j: usize = 0_usize;
    while i < a.len && j < b.len {
        if a[i].val == b[j].val {
            if a[i].slot == b[j].slot {
                try out.push(alloc, a[i]);
            }
            i = i +% 1_usize;
            j = j +% 1_usize;
        } else if a[i].val < b[j].val {
            i = i +% 1_usize;
        } else {
            j = j +% 1_usize;
        }
    }
    return;
}

fn join_aux_snaps(
    alloc: *mut AllocCap,
    pool_a: *StatePool,
    pool_b: *StatePool,
    a: *StateSnap,
    b: *StateSnap,
    out: *mut DbmState,
) -> !OutOfMemory {
    try intersect_vk_sets(
        alloc,
        slice_range.[VarKey](pool_a.aux.non_zero.as_slice(), a.non_zero),
        slice_range.[VarKey](pool_b.aux.non_zero.as_slice(), b.non_zero),
        &mut out.aux.non_zero,
    );
    try intersect_preds(
        alloc,
        slice_range.[ValPredEntry](pool_a.aux.preds.as_slice(), a.preds),
        slice_range.[ValPredEntry](pool_b.aux.preds.as_slice(), b.preds),
        &mut out.aux.preds,
    );
    let ka = slice_range.[KnownBitsEntry](pool_a.aux.known_bits.as_slice(), a.known_bits);
    let kb = slice_range.[KnownBitsEntry](pool_b.aux.known_bits.as_slice(), b.known_bits);
    var ki: usize = 0_usize;
    var kj: usize = 0_usize;
    while ki < ka.len && kj < kb.len {
        if ka[ki].key == kb[kj].key {
            try out.aux.known_bits.push(
                alloc,
                KnownBitsEntry.{ key: ka[ki].key, kb: kb_join(&ka[ki].kb, &kb[kj].kb) },
            );
            ki = ki +% 1_usize;
            kj = kj +% 1_usize;
        } else if ka[ki].key < kb[kj].key {
            ki = ki +% 1_usize;
        } else {
            kj = kj +% 1_usize;
        }
    }
    let empty_wk: [0]VarKey = [];
    try intersect_pairs(
        alloc,
        slice_range.[PairExprEntry](pool_a.aux.diff_exprs.as_slice(), a.diff_exprs),
        slice_range.[PairExprEntry](pool_b.aux.diff_exprs.as_slice(), b.diff_exprs),
        false,
        &empty_wk,
        &mut out.aux.diff_exprs,
    );
    try intersect_pairs(
        alloc,
        slice_range.[PairExprEntry](pool_a.aux.sum_exprs.as_slice(), a.sum_exprs),
        slice_range.[PairExprEntry](pool_b.aux.sum_exprs.as_slice(), b.sum_exprs),
        false,
        &empty_wk,
        &mut out.aux.sum_exprs,
    );
    try intersect_checked_ops(
        alloc,
        slice_range.[CheckedOpEntry](pool_a.aux.checked_op.as_slice(), a.checked_op),
        slice_range.[CheckedOpEntry](pool_b.aux.checked_op.as_slice(), b.checked_op),
        &mut out.aux.checked_op,
    );
    try intersect_checked_ops(
        alloc,
        slice_range.[CheckedOpEntry](pool_a.aux.slot_checked_op.as_slice(), a.slot_checked_op),
        slice_range.[CheckedOpEntry](pool_b.aux.slot_checked_op.as_slice(), b.slot_checked_op),
        &mut out.aux.slot_checked_op,
    );
    try intersect_val_slots(
        alloc,
        slice_range.[ValSlotEntry](pool_a.aux.val_slot_origin.as_slice(), a.val_slot_origin),
        slice_range.[ValSlotEntry](pool_b.aux.val_slot_origin.as_slice(), b.val_slot_origin),
        &mut out.aux.val_slot_origin,
    );
    try intersect_vk_sets(
        alloc,
        slice_range.[VarKey](pool_a.aux.const_lits.as_slice(), a.const_lits),
        slice_range.[VarKey](pool_b.aux.const_lits.as_slice(), b.const_lits),
        &mut out.aux.const_lits,
    );
    return;
}

fn collect_shared_verts(
    alloc: *mut AllocCap,
    va: *[VarKey],
    vb: *[VarKey],
    shared: *mut col.DynBuf[VarKey],
) -> !OutOfMemory {
    var i: usize = 1_usize;
    while i < va.len {
        let k = va[i];
        if k != VK_NONE {
            if let _ = find_vert_in_slice(vb, k) {
                try shared.push(alloc, k);
            }
        }
        i = i +% 1_usize;
    }
    sort_shared_verts(shared.as_mut_slice());
    while shared.len() > MAX_DBM_VERTS {
        _ = shared.pop();
    }
    return;
}

fn snap_mat_at(mat: *[SparseBound], _n: usize, r: usize, c: usize) -> Bound {
    if r == c {
        return bound_some(types.int_val_zero());
    }
    let target = sparse_rc(r, c);
    var lo: usize = 0_usize;
    var hi = mat.len;
    while lo < hi {
        let mid = lo +% ((hi -% lo) >> 1_usize);
        if mid < mat.len && mat[mid].rc < target {
            lo = mid +% 1_usize;
        } else {
            hi = mid;
        }
    }
    if lo < mat.len && mat[lo].rc == target {
        return bound_some(mat[lo].val);
    }
    return bound_none();
}

fn join_snaps(
    alloc: *mut AllocCap,
    pool_a: *StatePool,
    pool_b: *StatePool,
    a: *StateSnap,
    b: *StateSnap,
    out: *mut DbmState,
) -> !OutOfMemory {
    if !a.valid || a.is_bottom {
        try pool_b.load(alloc, b, out);
        return;
    }
    if !b.valid || b.is_bottom {
        try pool_a.load(alloc, a, out);
        return;
    }
    try out.reset_top(alloc);

    let ia = slice_range.[IntervalEntry](pool_a.core.intervals.as_slice(), a.intervals);
    let ib = slice_range.[IntervalEntry](pool_b.core.intervals.as_slice(), b.intervals);
    let min_iv = if ia.len < ib.len { ia.len } else { ib.len };
    if min_iv > 0_usize {
        try out.core.intervals.reserve(alloc, min_iv);
    }
    var ii: usize = 0_usize;
    var ij: usize = 0_usize;
    while ii < ia.len && ij < ib.len {
        if ia[ii].key == ib[ij].key {
            let hull = interval_hull(&ia[ii].iv, &ib[ij].iv);
            if !out.is_trivial_interval(ia[ii].key, &hull) {
                try out.core.intervals.insert_unique_fresh(alloc, ia[ii].key, hull);
            }
            ii = ii +% 1_usize;
            ij = ij +% 1_usize;
        } else if ia[ii].key < ib[ij].key {
            ii = ii +% 1_usize;
        } else {
            ij = ij +% 1_usize;
        }
    }

    try join_aux_snaps(alloc, pool_a, pool_b, a, b, out);

    let va = slice_range.[VarKey](pool_a.core.verts.as_slice(), a.verts);
    let vb = slice_range.[VarKey](pool_b.core.verts.as_slice(), b.verts);
    let ma = slice_range.[SparseBound](pool_a.core.mat.as_slice(), a.mat);
    let mb = slice_range.[SparseBound](pool_b.core.mat.as_slice(), b.mat);

    var shared = try col.DynBuf.[VarKey].init(alloc, 16_usize);
    errdefer shared.destroy(alloc);
    try collect_shared_verts(alloc, va, vb, &mut shared);
    let sh = shared.as_slice();
    let m = sh.len +% 1_usize;

    try out.core.ensure_mat_stride(alloc, m);
    let dstride = out.core.mat_stride;
    let z_b = bound_some(types.int_val_zero());
    let inf_b = bound_none();
    let dmat = out.core.mat.as_mut_slice();
    var r: usize = 0_usize;
    while r < m {
        let drow = r *% dstride;
        var c: usize = 0_usize;
        while c < m {
            let di = drow +% c;
            if di < dmat.len {
                dmat[di] = if r == c { copy z_b } else { copy inf_b };
            }
            c = c +% 1_usize;
        }
        r = r +% 1_usize;
    }

    var map_a: [65]u8 = [0xFF_u8; 65];
    var map_b: [65]u8 = [0xFF_u8; 65];
    map_a[0_usize] = 0_u8;
    map_b[0_usize] = 0_u8;
    try out.core.vmap.reserve(alloc, m);
    var si: usize = 0_usize;
    while si < sh.len && si < 64_usize {
        let k = sh[si];
        let mi_u8 = (si +% 1_usize).trunc.[u8]();
        try out.core.verts.push(alloc, k);
        try out.core.vmap.insert_unique_fresh(alloc, k, (si +% 1_usize).trunc.[u32]());
        let ia_v = find_vert_in_slice(va, k) orelse 0_usize;
        let ib_v = find_vert_in_slice(vb, k) orelse 0_usize;
        if ia_v > 0_usize && ia_v < 65_usize {
            map_a[ia_v] = mi_u8;
        }
        if ib_v > 0_usize && ib_v < 65_usize {
            map_b[ib_v] = mi_u8;
        }
        si = si +% 1_usize;
    }

    var seen_lo: [65]u64 = [0_u64; 65];
    var seen_hi: [65]u8 = [0_u8; 65];
    var both_lo: [65]u64 = [0_u64; 65];
    var both_hi: [65]u8 = [0_u8; 65];

    var mai: usize = 0_usize;
    while mai < ma.len {
        let e = ma[mai];
        let er = (e.rc >> 8_u16).widen.[usize]();
        let ec = (e.rc & 0xFF_u16).widen.[usize]();
        if er < 65_usize && ec < 65_usize {
            let mr_u8 = map_a[er];
            let mc_u8 = map_a[ec];
            if mr_u8 != 0xFF_u8 && mc_u8 != 0xFF_u8 && mr_u8 != mc_u8 {
                let mr = mr_u8.widen.[usize]();
                let mc = mc_u8.widen.[usize]();
                if mr < 65_usize && mc < 65_usize {
                    let di = (mr *% dstride) +% mc;
                    if di < dmat.len {
                        dmat[di] = bound_some(e.val);
                    }
                    if mc < 64_usize {
                        seen_lo[mr] = seen_lo[mr] | (1_u64 <<% mc.trunc.[u64]());
                    } else {
                        seen_hi[mr] = 1_u8;
                    }
                }
            }
        }
        mai = mai +% 1_usize;
    }

    var mbi: usize = 0_usize;
    while mbi < mb.len {
        let e = mb[mbi];
        let er = (e.rc >> 8_u16).widen.[usize]();
        let ec = (e.rc & 0xFF_u16).widen.[usize]();
        if er < 65_usize && ec < 65_usize {
            let mr_u8 = map_b[er];
            let mc_u8 = map_b[ec];
            if mr_u8 != 0xFF_u8 && mc_u8 != 0xFF_u8 && mr_u8 != mc_u8 {
                let mr = mr_u8.widen.[usize]();
                let mc = mc_u8.widen.[usize]();
                if mr < 65_usize && mc < 65_usize {
                    var in_a = false;
                    if mc < 64_usize {
                        in_a = (seen_lo[mr] & (1_u64 <<% mc.trunc.[u64]())) != 0_u64;
                    } else {
                        in_a = seen_hi[mr] != 0_u8;
                    }
                    if in_a {
                        let di = (mr *% dstride) +% mc;
                        if di < dmat.len {
                            dmat[di] = bound_max(dmat[di], bound_some(e.val));
                        }
                        if mc < 64_usize {
                            both_lo[mr] = both_lo[mr] | (1_u64 <<% mc.trunc.[u64]());
                        } else {
                            both_hi[mr] = 1_u8;
                        }
                    }
                }
            }
        }
        mbi = mbi +% 1_usize;
    }

    var cr: usize = 0_usize;
    while cr < m && cr < 65_usize {
        var clr = seen_lo[cr] & (~both_lo[cr]);
        let drow = cr *% dstride;
        while clr != 0_u64 {
            let bit = (@tzcnt(clr) & 63_u64).trunc.[usize]();
            let di = drow +% bit;
            if di < dmat.len {
                dmat[di] = copy inf_b;
            }
            clr = clr & (clr -% 1_u64);
        }
        if (seen_hi[cr] & (~both_hi[cr])) != 0_u8 {
            let di64 = drow +% 64_usize;
            if di64 < dmat.len {
                dmat[di64] = copy inf_b;
            }
        }
        cr = cr +% 1_usize;
    }

    out.core.is_closed = a.is_closed && b.is_closed;
    try dbm_sync_intervals_from_dbm(out, alloc);
    shared.destroy(alloc);
    return;
}

@recursive
fn dbm_refine_pred(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    preds: *PredArena,
    spool: *mut StatePool,
    pred_id: u32,
    truth: bool,
) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    let node = preds.get(pred_id) orelse {
        return;
    };
    match node.kind {
        .Const => {
            if node.bool_val != truth {
                st.core.is_bottom = true;
            }
        }
        .Cmp => {
            let eff = if truth { node.cmp_op } else { cmp_negate(node.cmp_op) };
            try dbm_refine_cmp(st, alloc, eff, node.lhs_vk, node.rhs_vk);
        }
        .Not => {
            try dbm_refine_pred(st, alloc, preds, spool, node.a, !truth);
        }
        .And => {
            if truth {
                try dbm_refine_pred(st, alloc, preds, spool, node.a, true);
                try dbm_refine_pred(st, alloc, preds, spool, node.b, true);
            } else {
                let base_snap = try spool.save(alloc, st);
                try dbm_refine_pred(st, alloc, preds, spool, node.a, false);
                let left_snap = try spool.save(alloc, st);
                try spool.load(alloc, &base_snap, st);
                try dbm_refine_pred(st, alloc, preds, spool, node.b, false);
                let right_snap = try spool.save(alloc, st);
                try join_snaps(alloc, spool, spool, &left_snap, &right_snap, st);
            }
        }
        .Or => {
            if !truth {
                try dbm_refine_pred(st, alloc, preds, spool, node.a, false);
                try dbm_refine_pred(st, alloc, preds, spool, node.b, false);
            } else {
                let base_snap = try spool.save(alloc, st);
                try dbm_refine_pred(st, alloc, preds, spool, node.a, true);
                let left_snap = try spool.save(alloc, st);
                try spool.load(alloc, &base_snap, st);
                try dbm_refine_pred(st, alloc, preds, spool, node.b, true);
                let right_snap = try spool.save(alloc, st);
                try join_snaps(alloc, spool, spool, &left_snap, &right_snap, st);
            }
        }
    }
    return;
}

fn type_bounds_of_key(
    k: VarKey,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> types.IntBounds {
    let t = vk_tag(k);
    if t == VK_TAG_VAL {
        return types.int_bounds(env.get(eir_prog.fn_val_ty(fn_id, vk_a(k))));
    }
    if t == VK_TAG_SLOT {
        if let si = eir_prog.fn_slot(fn_id, vk_a(k)) {
            return types.int_bounds(env.get(si.ty));
        }
        return types.IntBounds.{ valid: false, has_max: false, min: types.int_val_zero(), max: types.int_val_zero() };
    }
    if vk_is_len(k) {
        return types.IntBounds.{ valid: true, has_max: true, min: types.int_val_zero(), max: iv_i64_max() };
    }
    return types.IntBounds.{ valid: false, has_max: false, min: types.int_val_zero(), max: types.int_val_zero() };
}

fn widen_aux_snaps(
    alloc: *mut AllocCap,
    pool_old: *StatePool,
    pool_new: *StatePool,
    old: *StateSnap,
    new_s: *StateSnap,
    wkeys: *[VarKey],
    out: *mut DbmState,
) -> !OutOfMemory {
    try intersect_vk_sets(
        alloc,
        slice_range.[VarKey](pool_old.aux.non_zero.as_slice(), old.non_zero),
        slice_range.[VarKey](pool_new.aux.non_zero.as_slice(), new_s.non_zero),
        &mut out.aux.non_zero,
    );
    try intersect_preds(
        alloc,
        slice_range.[ValPredEntry](pool_old.aux.preds.as_slice(), old.preds),
        slice_range.[ValPredEntry](pool_new.aux.preds.as_slice(), new_s.preds),
        &mut out.aux.preds,
    );
    let ko = slice_range.[KnownBitsEntry](pool_old.aux.known_bits.as_slice(), old.known_bits);
    let kn = slice_range.[KnownBitsEntry](pool_new.aux.known_bits.as_slice(), new_s.known_bits);
    var oi: usize = 0_usize;
    var ni: usize = 0_usize;
    while ni < kn.len {
        let k = kn[ni].key;
        while oi < ko.len && ko[oi].key < k {
            oi = oi +% 1_usize;
        }
        if vk_set_contains(wkeys, k) {
            if oi < ko.len && ko[oi].key == k {
                try out.aux.known_bits.push(
                    alloc,
                    KnownBitsEntry.{ key: k, kb: kb_join(&ko[oi].kb, &kn[ni].kb) },
                );
            }
        } else {
            try out.aux.known_bits.push(alloc, kn[ni]);
        }
        ni = ni +% 1_usize;
    }
    try intersect_pairs(
        alloc,
        slice_range.[PairExprEntry](pool_old.aux.diff_exprs.as_slice(), old.diff_exprs),
        slice_range.[PairExprEntry](pool_new.aux.diff_exprs.as_slice(), new_s.diff_exprs),
        true,
        wkeys,
        &mut out.aux.diff_exprs,
    );
    try intersect_pairs(
        alloc,
        slice_range.[PairExprEntry](pool_old.aux.sum_exprs.as_slice(), old.sum_exprs),
        slice_range.[PairExprEntry](pool_new.aux.sum_exprs.as_slice(), new_s.sum_exprs),
        true,
        wkeys,
        &mut out.aux.sum_exprs,
    );
    try intersect_checked_ops(
        alloc,
        slice_range.[CheckedOpEntry](pool_old.aux.checked_op.as_slice(), old.checked_op),
        slice_range.[CheckedOpEntry](pool_new.aux.checked_op.as_slice(), new_s.checked_op),
        &mut out.aux.checked_op,
    );
    try intersect_checked_ops(
        alloc,
        slice_range.[CheckedOpEntry](pool_old.aux.slot_checked_op.as_slice(), old.slot_checked_op),
        slice_range.[CheckedOpEntry](pool_new.aux.slot_checked_op.as_slice(), new_s.slot_checked_op),
        &mut out.aux.slot_checked_op,
    );
    try intersect_val_slots(
        alloc,
        slice_range.[ValSlotEntry](pool_old.aux.val_slot_origin.as_slice(), old.val_slot_origin),
        slice_range.[ValSlotEntry](pool_new.aux.val_slot_origin.as_slice(), new_s.val_slot_origin),
        &mut out.aux.val_slot_origin,
    );
    try intersect_vk_sets(
        alloc,
        slice_range.[VarKey](pool_old.aux.const_lits.as_slice(), old.const_lits),
        slice_range.[VarKey](pool_new.aux.const_lits.as_slice(), new_s.const_lits),
        &mut out.aux.const_lits,
    );
    return;
}

fn widen_dbm_matrix(
    sh: *[VarKey],
    vo: *[VarKey],
    vn: *[VarKey],
    mo: *[SparseBound],
    mn: *[SparseBound],
    wkeys: *[VarKey],
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    alloc: *mut AllocCap,
    out: *mut DbmState,
) -> !OutOfMemory {
    let no = vo.len;
    let nn = vn.len;
    let m = sh.len +% 1_usize;
    try out.core.ensure_mat_stride(alloc, m);
    var r: usize = 0_usize;
    while r < m {
        var c: usize = 0_usize;
        while c < m {
            out.core.mat_set(r, c, bound_none());
            c = c +% 1_usize;
        }
        r = r +% 1_usize;
    }
    let z_b = bound_some(types.int_val_zero());
    out.core.mat_set(0_usize, 0_usize, copy z_b);

    var idx_o: [64]usize = [0_usize; 64];
    var idx_n: [64]usize = [0_usize; 64];
    var is_w: [64]bool = [false; 64];
    var si: usize = 0_usize;
    while si < sh.len && si < 64_usize {
        let k = sh[si];
        try out.core.verts.push(alloc, k);
        try out.core.vmap.insert(alloc, k, (si +% 1_usize).trunc.[u32]());
        idx_o[si] = find_vert_in_slice(vo, k) orelse 0_usize;
        idx_n[si] = find_vert_in_slice(vn, k) orelse 0_usize;
        is_w[si] = vk_set_contains(wkeys, k);
        si = si +% 1_usize;
    }

    var i: usize = 1_usize;
    while i < m && i <= 64_usize {
        let ki = sh[i - 1_usize];
        let io = idx_o[i - 1_usize];
        let inw = idx_n[i - 1_usize];
        let wi = is_w[i - 1_usize];
        let tb = type_bounds_of_key(ki, eir_prog, fn_id, env);
        out.core.mat_set(i, i, copy z_b);

        let n_i0 = snap_mat_at(mn, nn, inw, 0_usize);
        let o_i0 = snap_mat_at(mo, no, io, 0_usize);
        let out_i0 = if !wi {
            copy n_i0
        } else if bound_le(&n_i0, &o_i0) {
            copy o_i0
        } else if tb.valid && tb.has_max {
            bound_some(tb.max)
        } else {
            bound_none()
        };
        out.core.mat_set(i, 0_usize, out_i0);

        let n_0i = snap_mat_at(mn, nn, 0_usize, inw);
        let o_0i = snap_mat_at(mo, no, 0_usize, io);
        let out_0i = if !wi {
            copy n_0i
        } else if bound_le(&n_0i, &o_0i) {
            copy o_0i
        } else if tb.valid {
            if let nl = types.int_val_checked_neg(tb.min) {
                bound_some(nl)
            } else {
                bound_none()
            }
        } else {
            bound_none()
        };
        out.core.mat_set(0_usize, i, out_0i);

        var j: usize = 1_usize;
        while j < m && j <= 64_usize {
            if i != j {
                let jo = idx_o[j - 1_usize];
                let jnw = idx_n[j - 1_usize];
                let wj = is_w[j - 1_usize];
                let n_ij = snap_mat_at(mn, nn, inw, jnw);
                let o_ij = snap_mat_at(mo, no, io, jo);
                let out_ij = if !wi && !wj {
                    copy n_ij
                } else if bound_le(&n_ij, &o_ij) {
                    copy o_ij
                } else if bound_le(&n_ij, &z_b) {
                    copy z_b
                } else {
                    bound_none()
                };
                out.core.mat_set(i, j, out_ij);
            }
            j = j +% 1_usize;
        }
        i = i +% 1_usize;
    }
    return;
}

fn widen_snaps(
    alloc: *mut AllocCap,
    pool_old: *StatePool,
    pool_new: *StatePool,
    old: *StateSnap,
    new_s: *StateSnap,
    wkeys: *[VarKey],
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    out: *mut DbmState,
) -> !OutOfMemory {
    if !old.valid || old.is_bottom {
        try pool_new.load(alloc, new_s, out);
        return;
    }
    if !new_s.valid || new_s.is_bottom {
        try pool_old.load(alloc, old, out);
        return;
    }
    try out.reset_top(alloc);

    let io_s = slice_range.[IntervalEntry](pool_old.core.intervals.as_slice(), old.intervals);
    let in_s = slice_range.[IntervalEntry](pool_new.core.intervals.as_slice(), new_s.intervals);
    if in_s.len > 0_usize {
        try out.core.intervals.reserve(alloc, in_s.len);
    }
    var oi: usize = 0_usize;
    var ni: usize = 0_usize;
    while ni < in_s.len {
        let k = in_s[ni].key;
        while oi < io_s.len && io_s[oi].key < k {
            oi = oi +% 1_usize;
        }
        if vk_set_contains(wkeys, k) {
            if oi < io_s.len && io_s[oi].key == k {
                let tb = type_bounds_of_key(k, eir_prog, fn_id, env);
                try out.put_interval_if_nontrivial(alloc, k, interval_widen(&io_s[oi].iv, &in_s[ni].iv, tb));
            } else {
                let kt = vk_tag(k);
                if kt != VK_TAG_VAL && kt != VK_TAG_SLOT {
                    try out.put_interval_if_nontrivial(alloc, k, in_s[ni].iv);
                }
            }
        } else {
            try out.put_interval_if_nontrivial(alloc, k, in_s[ni].iv);
        }
        ni = ni +% 1_usize;
    }

    try widen_aux_snaps(alloc, pool_old, pool_new, old, new_s, wkeys, out);

    let vo = slice_range.[VarKey](pool_old.core.verts.as_slice(), old.verts);
    let vn = slice_range.[VarKey](pool_new.core.verts.as_slice(), new_s.verts);
    let mo = slice_range.[SparseBound](pool_old.core.mat.as_slice(), old.mat);
    let mn = slice_range.[SparseBound](pool_new.core.mat.as_slice(), new_s.mat);

    var shared = try col.DynBuf.[VarKey].init(alloc, 16_usize);
    errdefer shared.destroy(alloc);
    try collect_shared_verts(alloc, vo, vn, &mut shared);
    try widen_dbm_matrix(
        shared.as_slice(), vo, vn, mo, mn, wkeys, eir_prog, fn_id, env, alloc, out,
    );
    out.core.is_closed = false;
    try dbm_sync_intervals_from_dbm(out, alloc);
    shared.destroy(alloc);
    return;
}

fn narrow_snaps(
    alloc: *mut AllocCap,
    pool_old: *StatePool,
    pool_new: *StatePool,
    old: *StateSnap,
    new_s: *StateSnap,
    out: *mut DbmState,
) -> !OutOfMemory {
    if !old.valid || old.is_bottom || !new_s.valid || new_s.is_bottom {
        try pool_new.load(alloc, new_s, out);
        return;
    }
    try pool_old.load(alloc, old, out);
    let in_s = slice_range.[IntervalEntry](pool_new.core.intervals.as_slice(), new_s.intervals);
    var ni: usize = 0_usize;
    while ni < in_s.len {
        let k = in_s[ni].key;
        let cur = out.core.intervals.get(k) orelse out.default_interval(k);
        try out.put_interval_if_nontrivial(alloc, k, interval_narrow(&cur, &in_s[ni].iv));
        ni = ni +% 1_usize;
    }

    let vn = slice_range.[VarKey](pool_new.core.verts.as_slice(), new_s.verts);
    let mn = slice_range.[SparseBound](pool_new.core.mat.as_slice(), new_s.mat);
    let nn = vn.len;
    let out_n = out.core.verts.len();
    var i: usize = 1_usize;
    while i < out_n {
        var ki = VK_NONE;
        let ovs = out.core.verts.as_slice();
        if i < ovs.len {
            ki = ovs[i];
        }
        if ki == VK_NONE {
            i = i +% 1_usize;
            continue;
        }
        if let inw = find_vert_in_slice(vn, ki) {
            let n_i0 = snap_mat_at(mn, nn, inw, 0_usize);
            let cur_i0 = out.core.mat_get(i, 0_usize);
            if bound_lt(&n_i0, &cur_i0) {
                out.core.mat_set(i, 0_usize, n_i0);
            }
            let n_0i = snap_mat_at(mn, nn, 0_usize, inw);
            let cur_0i = out.core.mat_get(0_usize, i);
            if bound_lt(&n_0i, &cur_0i) {
                out.core.mat_set(0_usize, i, n_0i);
            }
            var j: usize = 1_usize;
            while j < out_n {
                if i != j {
                    var kj = VK_NONE;
                    let ovs2 = out.core.verts.as_slice();
                    if j < ovs2.len {
                        kj = ovs2[j];
                    }
                    if kj != VK_NONE {
                        if let jnw = find_vert_in_slice(vn, kj) {
                            let n_ij = snap_mat_at(mn, nn, inw, jnw);
                            let cur_ij = out.core.mat_get(i, j);
                            if bound_lt(&n_ij, &cur_ij) {
                                out.core.mat_set(i, j, n_ij);
                            }
                        }
                    }
                }
                j = j +% 1_usize;
            }
        }
        i = i +% 1_usize;
    }
    out.core.is_closed = false;
    try dbm_sync_intervals_from_dbm(out, alloc);
    return;
}

// ===========================================================================
// Section 8: Contracts (`where`, `ensures`, & Loop Invariants)
// ===========================================================================

struct SymEnvEntry {
    sym: u32;
    val_key: VarKey;
    has_len_key: bool;
    len_key: VarKey;
}

fn sym_env_find(xs: *[SymEnvEntry], sym: u32) -> ?SymEnvEntry {
    var i: usize = 0_usize;
    while i < xs.len {
        if xs[i].sym == sym {
            return xs[i];
        }
        i = i +% 1_usize;
    }
    return null;
}

fn sym_env_put(
    buf: *mut col.DynBuf[SymEnvEntry],
    alloc: *mut AllocCap,
    entry: SymEnvEntry,
    overwrite: bool,
) -> !OutOfMemory {
    let ms = buf.as_mut_slice();
    var i: usize = 0_usize;
    while i < ms.len {
        if ms[i].sym == entry.sym {
            if overwrite {
                ms[i] = entry;
            }
            return;
        }
        i = i +% 1_usize;
    }
    try buf.push(alloc, entry);
    return;
}

fn build_param_env(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    out: *mut col.DynBuf[SymEnvEntry],
) -> !OutOfMemory {
    out.clear();
    let params = eir_prog.fn_params(fn_id);
    let pnames = eir_prog.fn_param_names(fn_id);
    var pi: usize = 0_usize;
    while pi < params.len && pi < pnames.len {
        let pv = params[pi];
        try sym_env_put(
            out,
            alloc,
            SymEnvEntry.{
                sym: pnames[pi],
                val_key: vk_val(pv),
                has_len_key: true,
                len_key: vk_len_val(pv),
            },
            true,
        );
        pi = pi +% 1_usize;
    }
    return;
}

fn build_block_sym_env(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    out: *mut col.DynBuf[SymEnvEntry],
) -> !OutOfMemory {
    try build_param_env(alloc, eir_prog, fn_id, out);
    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < slots.len {
        if slots[si].has_name {
            let sid = slots[si].id;
            try sym_env_put(
                out,
                alloc,
                SymEnvEntry.{
                    sym: slots[si].name,
                    val_key: vk_slot(sid),
                    has_len_key: true,
                    len_key: vk_len_slot(sid),
                },
                true,
            );
        }
        si = si +% 1_usize;
    }
    let vns = eir_prog.fn_val_names(fn_id);
    var vi: usize = 0_usize;
    while vi < vns.len {
        let v = vns[vi].val;
        try sym_env_put(
            out,
            alloc,
            SymEnvEntry.{
                sym: vns[vi].sym,
                val_key: vk_val(v),
                has_len_key: true,
                len_key: vk_len_val(v),
            },
            false,
        );
        vi = vi +% 1_usize;
    }
    return;
}

enum ContractTermKind : u8 {
    Const = 0,
    Var = 1,
    VarPlusConst = 2,
}

struct ContractTerm {
    kind: ContractTermKind;
    key: VarKey;
    cval: types.IntVal;
}

fn ct_const(c: types.IntVal) -> ContractTerm {
    return ContractTerm.{ kind: .Const, key: VK_NONE, cval: c };
}

fn ct_var(k: VarKey) -> ContractTerm {
    return ContractTerm.{ kind: .Var, key: k, cval: types.int_val_zero() };
}

fn ct_var_plus(k: VarKey, c: types.IntVal) -> ContractTerm {
    return ContractTerm.{ kind: .VarPlusConst, key: k, cval: c };
}

@recursive
fn resolve_contract_term(
    arena: *ast.AstArena,
    expr_id: u32,
    sym_env: *[SymEnvEntry],
    has_ret: bool,
    ret_key: VarKey,
    interner: *span.SymInterner,
) -> ?ContractTerm {
    let e = arena.get_expr(expr_id) orelse {
        return null;
    };
    match e.kind {
        .Paren => {
            return resolve_contract_term(arena, e.a, sym_env, has_ret, ret_key, interner);
        }
        .IntLit => {
            if let u = types.parse_int_literal_u128(interner.get(e.a)) {
                if let iv = int_val_from_u128_checked(u) {
                    return ct_const(iv);
                }
            }
            return null;
        }
        .Unary => {
            if e.unary_op == .Neg {
                if let inner = resolve_contract_term(arena, e.a, sym_env, has_ret, ret_key, interner) {
                    if inner.kind == .Const {
                        if let nc = types.int_val_checked_neg(inner.cval) {
                            return ct_const(nc);
                        }
                    }
                }
            }
            return null;
        }
        .ReturnVal => {
            if has_ret {
                return ct_var(ret_key);
            }
            return null;
        }
        .Ident => {
            if let ent = sym_env_find(sym_env, e.a) {
                return ct_var(ent.val_key);
            }
            return null;
        }
        .Field => {
            if str.bytes_eq(interner.get(e.ident.sym), "len".as_bytes()) {
                if let base = arena.get_expr(e.a) {
                    if base.kind == .Ident {
                        if let ent = sym_env_find(sym_env, base.a) {
                            if ent.has_len_key {
                                return ct_var(ent.len_key);
                            }
                        }
                    }
                }
            }
            return null;
        }
        .Call => {
            if e.list.len == 0_u32 {
                if let callee = arena.get_expr(e.a) {
                    if callee.kind == .Field && str.bytes_eq(interner.get(callee.ident.sym), "len".as_bytes()) {
                        if let base = arena.get_expr(callee.a) {
                            if base.kind == .Ident {
                                if let ent = sym_env_find(sym_env, base.a) {
                                    if ent.has_len_key {
                                        return ct_var(ent.len_key);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            return null;
        }
        .Binary => {
            if e.bin_op == .Add || e.bin_op == .AddWrap {
                let lt = resolve_contract_term(arena, e.a, sym_env, has_ret, ret_key, interner) orelse {
                    return null;
                };
                let rt = resolve_contract_term(arena, e.b, sym_env, has_ret, ret_key, interner) orelse {
                    return null;
                };
                if lt.kind == .Const && rt.kind == .Const {
                    if let s = types.int_val_checked_add(lt.cval, rt.cval) {
                        return ct_const(s);
                    }
                } else if lt.kind == .Var && rt.kind == .Const {
                    return ct_var_plus(lt.key, rt.cval);
                } else if lt.kind == .Const && rt.kind == .Var {
                    return ct_var_plus(rt.key, lt.cval);
                } else if lt.kind == .VarPlusConst && rt.kind == .Const {
                    if let c = types.int_val_checked_add(lt.cval, rt.cval) {
                        return ct_var_plus(lt.key, c);
                    }
                }
                return null;
            }
            if e.bin_op == .Sub || e.bin_op == .SubWrap {
                let lt = resolve_contract_term(arena, e.a, sym_env, has_ret, ret_key, interner) orelse {
                    return null;
                };
                let rt = resolve_contract_term(arena, e.b, sym_env, has_ret, ret_key, interner) orelse {
                    return null;
                };
                if lt.kind == .Const && rt.kind == .Const {
                    if let d = types.int_val_checked_sub(lt.cval, rt.cval) {
                        return ct_const(d);
                    }
                } else if lt.kind == .Var && rt.kind == .Const {
                    if let nc = types.int_val_checked_neg(rt.cval) {
                        return ct_var_plus(lt.key, nc);
                    }
                }
                return null;
            }
            return null;
        }
        _ => { return null; }
    }
}

enum ContractVerdict : u8 {
    Proven = 0,
    Disproven = 1,
    Unknown = 2,
}

fn eval_const_cmp(cmp: CmpOp, a: types.IntVal, b: types.IntVal) -> bool {
    let c = types.int_val_cmp(a, b);
    match cmp {
        .Lt => { return c < 0_i32; }
        .LtEq => { return c <= 0_i32; }
        .Gt => { return c > 0_i32; }
        .GtEq => { return c >= 0_i32; }
        .Eq => { return c == 0_i32; }
        .NotEq => { return c != 0_i32; }
    }
}

fn dbm_vars_provably_diff_eq(st: *DbmState, u: VarKey, v: VarKey, c: types.IntVal) -> bool {
    // Returns true iff `u + c == v` is provably true in `st` (i.e. `u - v <= -c` and `v - u <= c`).
    let nc = types.int_val_checked_neg(c) orelse {
        return false;
    };
    let d_uv = dbm_diff_upper(st, u, v);
    if !d_uv.has_val || types.int_val_cmp(d_uv.val, nc) > 0_i32 {
        return false;
    }
    let d_vu = dbm_diff_upper(st, v, u);
    if !d_vu.has_val || types.int_val_cmp(d_vu.val, c) > 0_i32 {
        return false;
    }
    return true;
}

fn assume_var_cmp_const(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    cmp: CmpOp,
    u: VarKey,
    c: types.IntVal,
) -> !OutOfMemory {
    match cmp {
        .Lt => {
            if let cm1 = types.int_val_checked_sub(c, iv_one()) {
                try dbm_add_upper(st, alloc, u, cm1);
            }
        }
        .LtEq => { try dbm_add_upper(st, alloc, u, c); }
        .Gt => {
            if let c1 = types.int_val_checked_add(c, iv_one()) {
                try dbm_add_lower(st, alloc, u, c1);
            }
        }
        .GtEq => { try dbm_add_lower(st, alloc, u, c); }
        .Eq => { try dbm_add_const(st, alloc, u, c); }
        .NotEq => {
            let cur = dbm_get_interval(st, u);
            try refine_neq_const(st, alloc, u, &cur, c);
        }
    }
    return;
}

fn assume_var_plus_const_cmp_var(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    cmp: CmpOp,
    u: VarKey,
    c: types.IntVal,
    v: VarKey,
) -> !OutOfMemory {
    // `u + c <cmp> v`
    match cmp {
        .LtEq => {
            if let nc = types.int_val_checked_neg(c) {
                try dbm_add_diff(st, alloc, u, v, nc);
            }
        }
        .Lt => {
            if let nc = types.int_val_checked_neg(c) {
                if let ncm1 = types.int_val_checked_sub(nc, iv_one()) {
                    try dbm_add_diff(st, alloc, u, v, ncm1);
                }
            }
        }
        .GtEq => { try dbm_add_diff(st, alloc, v, u, c); }
        .Gt => {
            if let cm1 = types.int_val_checked_sub(c, iv_one()) {
                try dbm_add_diff(st, alloc, v, u, cm1);
            }
        }
        .Eq => {
            if let nc = types.int_val_checked_neg(c) {
                try dbm_add_diff(st, alloc, u, v, nc);
            }
            try dbm_add_diff(st, alloc, v, u, c);
        }
        .NotEq => {
            if dbm_vars_provably_diff_eq(st, u, v, c) {
                st.core.is_bottom = true;
            }
        }
    }
    return;
}

fn assume_term_cmp(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    cmp: CmpOp,
    lt: ContractTerm,
    rt: ContractTerm,
) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    if lt.kind == .Const && rt.kind == .Const {
        if !eval_const_cmp(cmp, lt.cval, rt.cval) {
            st.core.is_bottom = true;
        }
        return;
    }
    if lt.kind == .Var && rt.kind == .Var {
        if cmp == .NotEq && dbm_vars_provably_diff_eq(st, lt.key, rt.key, types.int_val_zero()) {
            st.core.is_bottom = true;
            return;
        }
        try dbm_refine_cmp(st, alloc, cmp, lt.key, rt.key);
        return;
    }
    if lt.kind == .Var && rt.kind == .Const {
        try assume_var_cmp_const(st, alloc, cmp, lt.key, rt.cval);
        return;
    }
    if lt.kind == .Const && rt.kind == .Var {
        try assume_var_cmp_const(st, alloc, cmp_flip(cmp), rt.key, lt.cval);
        return;
    }
    if lt.kind == .VarPlusConst && rt.kind == .Const {
        if let rhs_c = types.int_val_checked_sub(rt.cval, lt.cval) {
            try assume_var_cmp_const(st, alloc, cmp, lt.key, rhs_c);
        }
        return;
    }
    if lt.kind == .Const && rt.kind == .VarPlusConst {
        if let rhs_c = types.int_val_checked_sub(lt.cval, rt.cval) {
            try assume_var_cmp_const(st, alloc, cmp_flip(cmp), rt.key, rhs_c);
        }
        return;
    }
    if lt.kind == .VarPlusConst && rt.kind == .Var {
        try assume_var_plus_const_cmp_var(st, alloc, cmp, lt.key, lt.cval, rt.key);
        return;
    }
    if lt.kind == .Var && rt.kind == .VarPlusConst {
        try assume_var_plus_const_cmp_var(st, alloc, cmp_flip(cmp), rt.key, rt.cval, lt.key);
        return;
    }
    if lt.kind == .VarPlusConst && rt.kind == .VarPlusConst {
        if let dc = types.int_val_checked_sub(lt.cval, rt.cval) {
            try assume_var_plus_const_cmp_var(st, alloc, cmp, lt.key, dc, rt.key);
        }
        return;
    }
    return;
}

fn bin_op_to_cmp(op: ast.BinaryOp) -> ?CmpOp {
    match op {
        .Lt => { return .Lt; }
        .LtEq => { return .LtEq; }
        .Gt => { return .Gt; }
        .GtEq => { return .GtEq; }
        .Eq => { return .Eq; }
        .NotEq => { return .NotEq; }
        _ => { return null; }
    }
}

@recursive
fn assume_contract_expr_pol(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    expr_id: u32,
    sym_env: *[SymEnvEntry],
    has_ret: bool,
    ret_key: VarKey,
    interner: *span.SymInterner,
    negated: bool,
) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    let e = arena.get_expr(expr_id) orelse {
        return;
    };
    if e.kind == .Paren {
        try assume_contract_expr_pol(st, alloc, arena, e.a, sym_env, has_ret, ret_key, interner, negated);
        return;
    }
    if e.kind == .BoolLit {
        if e.flag == negated {
            st.core.is_bottom = true;
        }
        return;
    }
    if e.kind == .Unary && e.unary_op == .Not {
        try assume_contract_expr_pol(st, alloc, arena, e.a, sym_env, has_ret, ret_key, interner, !negated);
        return;
    }
    if e.kind == .Binary {
        let is_conj = (!negated && e.bin_op == .And) || (negated && e.bin_op == .Or);
        if is_conj {
            try assume_contract_expr_pol(st, alloc, arena, e.a, sym_env, has_ret, ret_key, interner, negated);
            try assume_contract_expr_pol(st, alloc, arena, e.b, sym_env, has_ret, ret_key, interner, negated);
            return;
        }
        let cmp = bin_op_to_cmp(e.bin_op) orelse {
            return;
        };
        let eff_cmp = if negated { cmp_negate(cmp) } else { cmp };
        let lt = resolve_contract_term(arena, e.a, sym_env, has_ret, ret_key, interner) orelse {
            return;
        };
        let rt = resolve_contract_term(arena, e.b, sym_env, has_ret, ret_key, interner) orelse {
            return;
        };
        try assume_term_cmp(st, alloc, eff_cmp, lt, rt);
    }
    return;
}

fn assume_contract_expr(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    expr_id: u32,
    sym_env: *[SymEnvEntry],
    has_ret: bool,
    ret_key: VarKey,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    try assume_contract_expr_pol(st, alloc, arena, expr_id, sym_env, has_ret, ret_key, interner, false);
    return;
}

@recursive
fn eval_contract_expr(
    alloc: *mut AllocCap,
    spool: *StatePool,
    st_snap: *StateSnap,
    tmp_st: *mut DbmState,
    arena: *ast.AstArena,
    expr_id: u32,
    sym_env: *[SymEnvEntry],
    has_ret: bool,
    ret_key: VarKey,
    interner: *span.SymInterner,
    negated: bool,
) -> ContractVerdict ! OutOfMemory {
    if !st_snap.valid || st_snap.is_bottom {
        return .Proven;
    }
    let e = arena.get_expr(expr_id) orelse {
        return .Unknown;
    };
    if e.kind == .Paren {
        return try eval_contract_expr(
            alloc, spool, st_snap, tmp_st, arena, e.a, sym_env, has_ret, ret_key, interner, negated,
        );
    }
    if e.kind == .BoolLit {
        return if e.flag != negated { .Proven } else { .Disproven };
    }
    if e.kind == .Unary && e.unary_op == .Not {
        return try eval_contract_expr(
            alloc, spool, st_snap, tmp_st, arena, e.a, sym_env, has_ret, ret_key, interner, !negated,
        );
    }
    if e.kind == .Binary {
        let is_conj = (!negated && e.bin_op == .And) || (negated && e.bin_op == .Or);
        if is_conj {
            let lv = try eval_contract_expr(
                alloc, spool, st_snap, tmp_st, arena, e.a, sym_env, has_ret, ret_key, interner, negated,
            );
            if lv == .Disproven {
                return .Disproven;
            }
            let rv = try eval_contract_expr(
                alloc, spool, st_snap, tmp_st, arena, e.b, sym_env, has_ret, ret_key, interner, negated,
            );
            if rv == .Disproven {
                return .Disproven;
            }
            if lv == .Proven && rv == .Proven {
                return .Proven;
            }
            return .Unknown;
        }
        let is_disj = (!negated && e.bin_op == .Or) || (negated && e.bin_op == .And);
        if is_disj {
            let lv = try eval_contract_expr(
                alloc, spool, st_snap, tmp_st, arena, e.a, sym_env, has_ret, ret_key, interner, negated,
            );
            if lv == .Proven {
                return .Proven;
            }
            let rv = try eval_contract_expr(
                alloc, spool, st_snap, tmp_st, arena, e.b, sym_env, has_ret, ret_key, interner, negated,
            );
            if rv == .Proven {
                return .Proven;
            }
            if lv == .Disproven && rv == .Disproven {
                return .Disproven;
            }
            // Disjunction is proven if assuming its negation (`!lhs && !rhs`) is unsatisfiable.
            try spool.load(alloc, st_snap, tmp_st);
            try assume_contract_expr_pol(tmp_st, alloc, arena, e.a, sym_env, has_ret, ret_key, interner, !negated);
            try assume_contract_expr_pol(tmp_st, alloc, arena, e.b, sym_env, has_ret, ret_key, interner, !negated);
            if tmp_st.core.is_bottom {
                return .Proven;
            }
            return .Unknown;
        }
        let cmp = bin_op_to_cmp(e.bin_op) orelse {
            return .Unknown;
        };
        let eff_cmp = if negated { cmp_negate(cmp) } else { cmp };
        let lt = resolve_contract_term(arena, e.a, sym_env, has_ret, ret_key, interner) orelse {
            return .Unknown;
        };
        let rt = resolve_contract_term(arena, e.b, sym_env, has_ret, ret_key, interner) orelse {
            return .Unknown;
        };
        try spool.load(alloc, st_snap, tmp_st);
        try assume_term_cmp(tmp_st, alloc, cmp_negate(eff_cmp), copy lt, copy rt);
        if tmp_st.core.is_bottom {
            return .Proven;
        }
        try spool.load(alloc, st_snap, tmp_st);
        try assume_term_cmp(tmp_st, alloc, eff_cmp, lt, rt);
        if tmp_st.core.is_bottom {
            return .Disproven;
        }
        return .Unknown;
    }
    return .Unknown;
}

fn check_contract_expr(
    alloc: *mut AllocCap,
    spool: *StatePool,
    st_snap: *StateSnap,
    tmp_st: *mut DbmState,
    arena: *ast.AstArena,
    expr_id: u32,
    sym_env: *[SymEnvEntry],
    has_ret: bool,
    ret_key: VarKey,
    interner: *span.SymInterner,
) -> ContractVerdict ! OutOfMemory {
    return try eval_contract_expr(
        alloc, spool, st_snap, tmp_st, arena, expr_id, sym_env, has_ret, ret_key, interner, false,
    );
}

// ===========================================================================
// Section 9: Abstract Transfer (`transfer_inst`, `transfer_binary`, Phis, Edges)
// ===========================================================================

fn ty_bounds(ty: types.TyId, env: *types.TypeEnv) -> types.IntBounds {
    return types.int_bounds(env.get(ty));
}

fn int_bitwidth(tn: types.TyNode) -> u32 {
    if tn.kind == .Int {
        return if tn.flag1 { 64_u32 } else { tn.u8_val.widen.[u32]() };
    }
    return 64_u32;
}

fn deref_single_borrow(ty: types.TyId, env: *types.TypeEnv) -> types.TyId {
    let tn = env.get(ty);
    if tn.kind == .Borrow && tn.borrow_kind == .Single {
        return tn.primary;
    }
    return ty;
}

fn deref_ptr_or_borrow(ty: types.TyId, env: *types.TypeEnv) -> types.TyId {
    let tn = env.get(ty);
    if (tn.kind == .Borrow && tn.borrow_kind == .Single) || tn.kind == .RawPtr {
        return tn.primary;
    }
    return ty;
}

fn has_len_ty(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let tn = env.get(ty);
    if tn.kind == .Str {
        return true;
    }
    if tn.kind == .Borrow && (tn.borrow_kind == .Slice || tn.borrow_kind == .Str) {
        return true;
    }
    let dn = env.get(deref_single_borrow(ty, env));
    if dn.kind == .Array {
        return true;
    }
    if dn.kind == .Builtin {
        return dn.builtin_kind == .ArenaPool
            || dn.builtin_kind == .SlotPool
            || dn.builtin_kind == .Buf
            || dn.builtin_kind == .LinearBuf;
    }
    return false;
}

fn propagates_len_ty(ty: types.TyId, env: *types.TypeEnv) -> bool {
    if has_len_ty(ty, env) {
        return true;
    }
    let tn = env.get(ty);
    if tn.kind == .Optional || tn.kind == .ErrorUnion {
        return has_len_ty(tn.primary, env);
    }
    return false;
}

fn init_len_for_key(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    lk: VarKey,
    ty: types.TyId,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    let tn = env.get(ty);
    if tn.kind == .Str || (tn.kind == .Borrow && (tn.borrow_kind == .Slice || tn.borrow_kind == .Str)) {
        try dbm_set_interval(st, alloc, lk, interval_range(types.int_val_zero(), iv_i64_max()));
        return;
    }
    let dn = env.get(deref_single_borrow(ty, env));
    if dn.kind == .Array {
        try dbm_add_const(st, alloc, lk, types.int_val_from_u64(dn.u64_val));
        return;
    }
    if dn.kind == .Builtin && (dn.builtin_kind == .ArenaPool || dn.builtin_kind == .SlotPool) {
        try dbm_set_interval(st, alloc, lk, interval_range(types.int_val_zero(), iv_i64_max()));
    }
    return;
}

fn extract_root_field_idx(projs: *[eir.EirProj]) -> ?u32 {
    if projs.len == 1_usize {
        if projs[0_usize].kind == .Field || projs[0_usize].kind == .TupleField {
            return projs[0_usize].index;
        }
        return null;
    }
    if projs.len == 2_usize && projs[0_usize].kind == .Deref {
        if projs[1_usize].kind == .Field || projs[1_usize].kind == .TupleField {
            return projs[1_usize].index;
        }
    }
    return null;
}

fn field_key_of_place_static(eir_prog: *eir.EirProgram, place: *eir.EirPlace) -> ?VarKey {
    let fidx = extract_root_field_idx(eir_prog.projs_slice(place.projs)) orelse {
        return null;
    };
    if place.base.kind == .Slot {
        return vk_field_slot(place.base.id, fidx);
    }
    return vk_field_val(place.base.id, fidx);
}

fn field_key_of_place(
    st: *DbmState,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    place: *eir.EirPlace,
    env: *types.TypeEnv,
) -> ?VarKey {
    let fidx = extract_root_field_idx(eir_prog.projs_slice(place.projs)) orelse {
        return null;
    };
    var base_ty = types.TY_ERROR;
    if place.base.kind == .Slot {
        if let si = eir_prog.fn_slot(fn_id, place.base.id) {
            base_ty = si.ty;
        }
    } else {
        base_ty = eir_prog.fn_val_ty(fn_id, place.base.id);
    }
    if env.get(deref_ptr_or_borrow(base_ty, env)).kind == .Pool {
        return null;
    }
    if place.base.kind == .Slot {
        return vk_field_slot(place.base.id, fidx);
    }
    if let orig_slot = val_slot_get(st.aux.val_slot_origin.as_slice(), place.base.id) {
        return vk_field_slot(orig_slot, fidx);
    }
    return vk_field_val(place.base.id, fidx);
}

struct DiffCancelEdge {
    m: VarKey;
    c: types.IntVal;
}

fn vk_dbm_eq(st: *DbmState, u: VarKey, v: VarKey) -> bool {
    if u == v {
        return true;
    }
    let iu = dbm_get_interval(st, u);
    let iv = dbm_get_interval(st, v);
    if interval_is_const(&iu) && interval_is_const(&iv) {
        return types.int_val_eq(iu.lo, iv.lo);
    }
    let z_b = bound_some(types.int_val_zero());
    let d1 = dbm_diff_upper(st, u, v);
    if !bound_le(&d1, &z_b) {
        return false;
    }
    let d2 = dbm_diff_upper(st, v, u);
    return bound_le(&d2, &z_b);
}

fn find_equiv_pair_expr(
    st: *DbmState,
    xs: *[PairExprEntry],
    lk: VarKey,
    rk: VarKey,
    ty: types.TyId,
    commutative: bool,
) -> ?VarKey {
    var i: usize = 0_usize;
    while i < xs.len {
        let e = xs[i];
        if e.ty == ty {
            if (vk_dbm_eq(st, e.a, lk) && vk_dbm_eq(st, e.b, rk))
                || (commutative && vk_dbm_eq(st, e.a, rk) && vk_dbm_eq(st, e.b, lk))
            {
                return e.key;
            }
        }
        i = i +% 1_usize;
    }
    return null;
}

fn transfer_binary_add(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    op: ast.BinaryOp,
    dk: VarKey,
    lk: VarKey,
    rk: VarKey,
    li: *Interval,
    ri: *Interval,
    dst_ty: types.TyId,
    tb: *types.IntBounds,
) -> !OutOfMemory {
    let is_const_r = interval_is_const(ri);
    let is_const_l = interval_is_const(li);
    var no_wrap = op == .Add;
    if !no_wrap && li.has_lo && li.has_hi && ri.has_lo && ri.has_hi && tb.valid {
        if let slo = types.int_val_checked_add(li.lo, ri.lo) {
            if let shi = types.int_val_checked_add(li.hi, ri.hi) {
                if iv_ge(slo, tb.min) && iv_le(shi, tb.max) {
                    no_wrap = true;
                }
            }
        }
    }
    let prev_equiv = find_equiv_pair_expr(st, st.aux.sum_exprs.as_slice(), lk, rk, dst_ty, true);
    if no_wrap && is_const_r {
        try dbm_assign_offset(st, alloc, dk, lk, ri.lo, copy tb.*);
        if let eq_k = prev_equiv {
            try dbm_add_eq(st, alloc, dk, eq_k);
        }
        try pair_map_insert(&mut st.aux.sum_exprs, alloc, dk, lk, rk, dst_ty, true);
        return;
    }
    if no_wrap && is_const_l {
        try dbm_assign_offset(st, alloc, dk, rk, li.lo, copy tb.*);
        if let eq_k = prev_equiv {
            try dbm_add_eq(st, alloc, dk, eq_k);
        }
        try pair_map_insert(&mut st.aux.sum_exprs, alloc, dk, lk, rk, dst_ty, true);
        return;
    }
    if no_wrap {
        var has_lo = false;
        var lo = types.int_val_zero();
        if li.has_lo && ri.has_lo {
            if let s = types.int_val_checked_add(li.lo, ri.lo) {
                has_lo = true;
                lo = s;
            }
        }
        var has_hi = false;
        var hi = types.int_val_zero();
        if li.has_hi && ri.has_hi {
            if let s = types.int_val_checked_add(li.hi, ri.hi) {
                has_hi = true;
                hi = s;
            }
        }
        var res = Interval.{ has_lo: has_lo, lo: lo, has_hi: has_hi, hi: hi };
        if tb.valid {
            let tb_iv = tb_ptr_to_interval(tb);
            res = interval_intersect(&res, &tb_iv);
        }
        try dbm_set_interval(st, alloc, dk, res);
        try pair_map_insert(&mut st.aux.sum_exprs, alloc, dk, lk, rk, dst_ty, true);
        if let eq_k = prev_equiv {
            try dbm_add_eq(st, alloc, dk, eq_k);
        }
        if ri.has_lo {
            if let neg_rl = types.int_val_checked_neg(ri.lo) {
                try dbm_add_diff(st, alloc, lk, dk, neg_rl);
            }
        }
        if li.has_lo {
            if let neg_ll = types.int_val_checked_neg(li.lo) {
                try dbm_add_diff(st, alloc, rk, dk, neg_ll);
            }
        }
        let des = st.aux.diff_exprs.as_slice();
        if des.len > 0_usize {
            var edges = try col.DynBuf.[DiffCancelEdge].init(alloc, 4_usize);
            errdefer edges.destroy(alloc);
            var di: usize = 0_usize;
            while di < des.len {
                let de = des[di];
                if de.no_wrap {
                    if de.b == lk {
                        let c_b = dbm_diff_upper(st, rk, de.key);
                        if c_b.has_val {
                            try edges.push(alloc, DiffCancelEdge.{ m: de.a, c: c_b.val });
                        }
                    } else if de.b == rk {
                        let c_b = dbm_diff_upper(st, lk, de.key);
                        if c_b.has_val {
                            try edges.push(alloc, DiffCancelEdge.{ m: de.a, c: c_b.val });
                        }
                    }
                }
                di = di +% 1_usize;
            }
            let es = edges.as_slice();
            var ei: usize = 0_usize;
            while ei < es.len {
                try dbm_add_diff(st, alloc, dk, es[ei].m, es[ei].c);
                ei = ei +% 1_usize;
            }
            edges.destroy(alloc);
        }
        return;
    }
    if tb.valid {
        try dbm_set_interval(st, alloc, dk, tb_ptr_to_interval(tb));
    }
    if let eq_k = prev_equiv {
        try dbm_add_eq(st, alloc, dk, eq_k);
    }
    try pair_map_insert(&mut st.aux.sum_exprs, alloc, dk, lk, rk, dst_ty, false);
    return;
}

fn transfer_binary_sub(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    op: ast.BinaryOp,
    dk: VarKey,
    lk: VarKey,
    rk: VarKey,
    li: *Interval,
    ri: *Interval,
    dst_ty: types.TyId,
    tb: *types.IntBounds,
) -> !OutOfMemory {
    let is_const_r = interval_is_const(ri);
    var no_wrap = op == .Sub;
    if !no_wrap && li.has_lo && li.has_hi && ri.has_lo && ri.has_hi && tb.valid {
        if let dlo = types.int_val_checked_sub(li.lo, ri.hi) {
            if let dhi = types.int_val_checked_sub(li.hi, ri.lo) {
                if iv_ge(dlo, tb.min) && iv_le(dhi, tb.max) {
                    no_wrap = true;
                }
            }
        }
    }
    let prev_equiv = find_equiv_pair_expr(st, st.aux.diff_exprs.as_slice(), lk, rk, dst_ty, false);
    if no_wrap && is_const_r {
        if let neg = types.int_val_checked_neg(ri.lo) {
            try dbm_assign_offset(st, alloc, dk, lk, neg, copy tb.*);
            if let eq_k = prev_equiv {
                try dbm_add_eq(st, alloc, dk, eq_k);
            }
            try pair_map_insert(&mut st.aux.diff_exprs, alloc, dk, lk, rk, dst_ty, true);
            return;
        }
    }
    if no_wrap {
        let hi_dbm = dbm_diff_upper(st, lk, rk);
        let lo_dbm_raw = dbm_diff_upper(st, rk, lk);
        var has_lo_dbm = false;
        var lo_dbm = types.int_val_zero();
        if lo_dbm_raw.has_val {
            if let nl = types.int_val_checked_neg(lo_dbm_raw.val) {
                has_lo_dbm = true;
                lo_dbm = nl;
            }
        }
        var has_lo_iv = false;
        var lo_iv = types.int_val_zero();
        if li.has_lo && ri.has_hi {
            if let d = types.int_val_checked_sub(li.lo, ri.hi) {
                has_lo_iv = true;
                lo_iv = d;
            }
        }
        var has_hi_iv = false;
        var hi_iv = types.int_val_zero();
        if li.has_hi && ri.has_lo {
            if let d = types.int_val_checked_sub(li.hi, ri.lo) {
                has_hi_iv = true;
                hi_iv = d;
            }
        }
        let iv_a = Interval.{ has_lo: has_lo_iv, lo: lo_iv, has_hi: has_hi_iv, hi: hi_iv };
        let iv_b = Interval.{ has_lo: has_lo_dbm, lo: lo_dbm, has_hi: hi_dbm.has_val, hi: hi_dbm.val };
        var res = interval_intersect(&iv_a, &iv_b);
        if tb.valid {
            let tb_iv = tb_ptr_to_interval(tb);
            res = interval_intersect(&res, &tb_iv);
        }
        try dbm_set_interval(st, alloc, dk, res);
        try pair_map_insert(&mut st.aux.diff_exprs, alloc, dk, lk, rk, dst_ty, true);
        if let eq_k = prev_equiv {
            try dbm_add_eq(st, alloc, dk, eq_k);
        }
        if ri.has_lo {
            if let neg_rl = types.int_val_checked_neg(ri.lo) {
                try dbm_add_diff(st, alloc, dk, lk, neg_rl);
            }
        }
        return;
    }
    if tb.valid {
        try dbm_set_interval(st, alloc, dk, tb_ptr_to_interval(tb));
    }
    if let eq_k = prev_equiv {
        try dbm_add_eq(st, alloc, dk, eq_k);
    }
    try pair_map_insert(&mut st.aux.diff_exprs, alloc, dk, lk, rk, dst_ty, false);
    return;
}

fn transfer_binary_bitwise(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    op: ast.BinaryOp,
    dk: VarKey,
    lk: VarKey,
    rk: VarKey,
    li: *Interval,
    ri: *Interval,
    bw: u32,
    tb: *types.IntBounds,
) -> !OutOfMemory {
    let nonneg = li.has_lo && !types.int_val_is_neg(li.lo) && ri.has_lo && !types.int_val_is_neg(ri.lo);
    if nonneg {
        let lkb_i = kb_from_nonneg_interval(li, bw);
        let rkb_i = kb_from_nonneg_interval(ri, bw);
        let lkb = st.get_known_bits(lk) orelse copy lkb_i;
        let rkb = st.get_known_bits(rk) orelse copy rkb_i;
        let l_eff = KnownBits.{ zeros: u128_or(lkb.zeros, lkb_i.zeros), ones: u128_or(lkb.ones, lkb_i.ones) };
        let r_eff = KnownBits.{ zeros: u128_or(rkb.zeros, rkb_i.zeros), ones: u128_or(rkb.ones, rkb_i.ones) };
        let res_kb = if op == .BitAnd {
            kb_bit_and(&l_eff, &r_eff)
        } else if op == .BitOr {
            kb_bit_or(&l_eff, &r_eff)
        } else {
            kb_bit_xor(&l_eff, &r_eff)
        };
        var iv = kb_to_nonneg_interval(&res_kb, bw) orelse interval_top();
        try kb_map_insert(&mut st.aux.known_bits, alloc, dk, res_kb);
        if op == .BitAnd {
            if ri.has_hi {
                let r_iv = interval_range(types.int_val_zero(), ri.hi);
                iv = interval_intersect(&iv, &r_iv);
            }
            if li.has_hi {
                let l_iv = interval_range(types.int_val_zero(), li.hi);
                iv = interval_intersect(&iv, &l_iv);
            }
        }
        if tb.valid {
            let tb_iv = tb_ptr_to_interval(tb);
            iv = interval_intersect(&iv, &tb_iv);
        }
        try dbm_set_interval(st, alloc, dk, iv);
        return;
    }
    if op == .BitAnd {
        var has_hi = false;
        var hi_cand = types.int_val_zero();
        if ri.has_lo && !types.int_val_is_neg(ri.lo) && ri.has_hi {
            has_hi = true;
            hi_cand = ri.hi;
        }
        if li.has_lo && !types.int_val_is_neg(li.lo) && li.has_hi {
            if !has_hi || iv_lt(li.hi, hi_cand) {
                has_hi = true;
                hi_cand = li.hi;
            }
        }
        if has_hi {
            try dbm_set_interval(st, alloc, dk, interval_range(types.int_val_zero(), hi_cand));
            return;
        }
    }
    if tb.valid {
        try dbm_set_interval(st, alloc, dk, tb_ptr_to_interval(tb));
    }
    return;
}

fn transfer_binary_shift(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    op: ast.BinaryOp,
    dk: VarKey,
    lk: VarKey,
    li: *Interval,
    ri: *Interval,
    bw: u32,
    tb: *types.IntBounds,
) -> !OutOfMemory {
    if li.has_lo && li.has_hi && ri.has_lo && ri.has_hi && !types.int_val_is_neg(ri.lo) {
        if let rl_u = types.int_val_to_u64(ri.lo) {
            if let rh_u = types.int_val_to_u64(ri.hi) {
                if rh_u < bw.widen.[u64]() {
                    let rl32 = rl_u.trunc.[u32]();
                    let rh32 = rh_u.trunc.[u32]();
                    if op == .Shr {
                        let a = types.int_val_shr(li.lo, rh32);
                        let b = types.int_val_shr(li.lo, rl32);
                        let c = types.int_val_shr(li.hi, rh32);
                        let d = types.int_val_shr(li.hi, rl32);
                        let lo = iv_min(iv_min(a, b), iv_min(c, d));
                        let hi = iv_max(iv_max(a, b), iv_max(c, d));
                        if !types.int_val_is_neg(li.lo) && rl32 == rh32 {
                            let lkb = st.get_known_bits(lk)
                                orelse kb_from_nonneg_interval(li, bw);
                            try kb_map_insert(&mut st.aux.known_bits, alloc, dk, kb_lshr(&lkb, rl32));
                        }
                        try dbm_set_interval(st, alloc, dk, interval_range(lo, hi));
                        return;
                    }
                    if op == .Shl && !types.int_val_is_neg(li.lo) {
                        if let lo = iv_checked_shl(li.lo, rl32) {
                            if let hi = iv_checked_shl(li.hi, rh32) {
                                if rl32 == rh32 {
                                    let lkb = st.get_known_bits(lk)
                                        orelse kb_from_nonneg_interval(li, bw);
                                    try kb_map_insert(&mut st.aux.known_bits, alloc, dk, kb_shl(&lkb, rl32, bw));
                                }
                                var res = interval_range(lo, hi);
                                if tb.valid {
                                    let tb_iv = tb_ptr_to_interval(tb);
                                    res = interval_intersect(&res, &tb_iv);
                                }
                                try dbm_set_interval(st, alloc, dk, res);
                                return;
                            }
                        }
                    }
                }
            }
        }
    }
    if tb.valid {
        try dbm_set_interval(st, alloc, dk, tb_ptr_to_interval(tb));
    }
    return;
}

fn transfer_binary_mul_div_mod(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    op: ast.BinaryOp,
    dk: VarKey,
    rk: VarKey,
    li: *Interval,
    ri: *Interval,
    tb: *types.IntBounds,
) -> !OutOfMemory {
    if op == .Mul {
        if li.has_lo && li.has_hi && ri.has_lo && ri.has_hi {
            if let p0 = types.int_val_checked_mul(li.lo, ri.lo) {
                if let p1 = types.int_val_checked_mul(li.lo, ri.hi) {
                    if let p2 = types.int_val_checked_mul(li.hi, ri.lo) {
                        if let p3 = types.int_val_checked_mul(li.hi, ri.hi) {
                            let lo = iv_min(iv_min(p0, p1), iv_min(p2, p3));
                            let hi = iv_max(iv_max(p0, p1), iv_max(p2, p3));
                            var res = interval_range(lo, hi);
                            if tb.valid {
                                let tb_iv = tb_ptr_to_interval(tb);
                                res = interval_intersect(&res, &tb_iv);
                            }
                            try dbm_set_interval(st, alloc, dk, res);
                            return;
                        }
                    }
                }
            }
        }
        if tb.valid {
            try dbm_set_interval(st, alloc, dk, tb_ptr_to_interval(tb));
        }
        return;
    }
    if op == .Div {
        if li.has_lo && li.has_hi && ri.has_lo && ri.has_hi
            && !types.int_val_is_neg(li.lo) && iv_ge(ri.lo, iv_one())
        {
            if let lo = types.int_val_checked_div(li.lo, ri.hi) {
                if let hi = types.int_val_checked_div(li.hi, ri.lo) {
                    try dbm_set_interval(st, alloc, dk, interval_range(lo, hi));
                    return;
                }
            }
        }
        if tb.valid {
            try dbm_set_interval(st, alloc, dk, tb_ptr_to_interval(tb));
        }
        return;
    }
    if op == .Mod {
        if li.has_lo && !types.int_val_is_neg(li.lo) && ri.has_lo && iv_ge(ri.lo, iv_one()) {
            try dbm_add_lower(st, alloc, dk, types.int_val_zero());
            try dbm_add_diff(st, alloc, dk, rk, iv_neg_one());
            if ri.has_hi {
                if let rm1 = types.int_val_checked_sub(ri.hi, iv_one()) {
                    try dbm_add_upper(st, alloc, dk, rm1);
                }
            }
            return;
        }
        if tb.valid {
            try dbm_set_interval(st, alloc, dk, tb_ptr_to_interval(tb));
        }
    }
    return;
}

fn transfer_binary(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    preds: *mut PredArena,
    dst: eir.EirValue,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
    dst_ty: types.TyId,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    let lk = vk_val(lhs);
    let rk = vk_val(rhs);
    let dk = vk_val(dst);

    if let cmp = bin_op_to_cmp(op) {
        let pid = try preds.intern_cmp(alloc, cmp, lk, rk);
        try preds_insert(&mut st.aux.preds, alloc, dst, pid);
        return;
    }
    if op == .And || op == .Or {
        if let lp = preds_get(st.aux.preds.as_slice(), lhs) {
            if let rp = preds_get(st.aux.preds.as_slice(), rhs) {
                let pk: PredKind = if op == .And { .And } else { .Or };
                let pid = try preds.intern_bin(alloc, pk, lp, rp);
                try preds_insert(&mut st.aux.preds, alloc, dst, pid);
            }
        }
        return;
    }
    if op == .AddCheck || op == .SubCheck || op == .MulCheck || op == .DivCheck || op == .ModCheck {
        try checked_map_insert(
            &mut st.aux.checked_op,
            alloc,
            CheckedOpEntry.{ id: dst, op: op, lhs: lhs, rhs: rhs, op_ty: op_ty },
        );
        return;
    }
    if !env.is_integer(dst_ty) {
        return;
    }

    let tb = ty_bounds(dst_ty, env);
    let li = dbm_get_interval(st, lk);
    let ri = dbm_get_interval(st, rk);

    match op {
        .Add => { try transfer_binary_add(st, alloc, op, dk, lk, rk, &li, &ri, dst_ty, &tb); }
        .AddWrap => { try transfer_binary_add(st, alloc, op, dk, lk, rk, &li, &ri, dst_ty, &tb); }
        .Sub => { try transfer_binary_sub(st, alloc, op, dk, lk, rk, &li, &ri, dst_ty, &tb); }
        .SubWrap => { try transfer_binary_sub(st, alloc, op, dk, lk, rk, &li, &ri, dst_ty, &tb); }
        .Mul => { try transfer_binary_mul_div_mod(st, alloc, op, dk, rk, &li, &ri, &tb); }
        .Div => { try transfer_binary_mul_div_mod(st, alloc, op, dk, rk, &li, &ri, &tb); }
        .Mod => { try transfer_binary_mul_div_mod(st, alloc, op, dk, rk, &li, &ri, &tb); }
        .BitAnd => {
            try transfer_binary_bitwise(st, alloc, op, dk, lk, rk, &li, &ri, int_bitwidth(env.get(op_ty)), &tb);
        }
        .BitOr => {
            try transfer_binary_bitwise(st, alloc, op, dk, lk, rk, &li, &ri, int_bitwidth(env.get(op_ty)), &tb);
        }
        .BitXor => {
            try transfer_binary_bitwise(st, alloc, op, dk, lk, rk, &li, &ri, int_bitwidth(env.get(op_ty)), &tb);
        }
        .Shr => {
            try transfer_binary_shift(st, alloc, op, dk, lk, &li, &ri, int_bitwidth(env.get(op_ty)), &tb);
        }
        .Shl => {
            try transfer_binary_shift(st, alloc, op, dk, lk, &li, &ri, int_bitwidth(env.get(op_ty)), &tb);
        }
        _ => {
            if tb.valid {
                try dbm_set_interval(st, alloc, dk, tb_to_interval(tb));
            }
        }
    }
    return;
}

fn callee_to_fn_key(callee: eir.EirCallee) -> ?cfg_ir.CfgFnKey {
    match callee.kind {
        .DirectFn => { return cfg_ir.fn_key_top_def(callee.a); }
        .Method => { return cfg_ir.fn_key_impl_method(callee.a, callee.b); }
        .GenericInst => { return cfg_ir.fn_key_generic_inst(callee.a); }
        _ => { return null; }
    }
}

fn transfer_cast(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    inst: *eir.EirInst,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    let dst = inst.dst;
    let operand = inst.v0;
    let to_ty = inst.ty0;
    let from_ty = inst.ty1;
    match inst.cast_kind {
        .Widen => {
            if env.is_integer(from_ty) && env.is_integer(to_ty) {
                let siv = dbm_get_interval(st, vk_val(operand));
                let opt_kb = st.get_known_bits(vk_val(operand));
                try dbm_assign_offset(st, alloc, vk_val(dst), vk_val(operand), types.int_val_zero(), ty_bounds(to_ty, env));
                if siv.has_lo && !types.int_val_is_neg(siv.lo) {
                    if let kb = opt_kb {
                        try kb_map_insert(&mut st.aux.known_bits, alloc, vk_val(dst), kb);
                    }
                }
            }
        }
        .Trunc => {
            if env.is_integer(from_ty) && env.is_integer(to_ty) {
                let siv = dbm_get_interval(st, vk_val(operand));
                let opt_kb = st.get_known_bits(vk_val(operand));
                let tb = ty_bounds(to_ty, env);
                if tb.valid {
                    let fits = siv.has_lo && iv_ge(siv.lo, tb.min) && (!tb.has_max || (siv.has_hi && iv_le(siv.hi, tb.max)));
                    if fits {
                        try dbm_assign_offset(st, alloc, vk_val(dst), vk_val(operand), types.int_val_zero(), tb);
                        if !types.int_val_is_neg(siv.lo) {
                            if let kb = opt_kb {
                                try kb_map_insert(&mut st.aux.known_bits, alloc, vk_val(dst), kb);
                            }
                        }
                    } else {
                        try dbm_set_interval(st, alloc, vk_val(dst), tb_to_interval(tb));
                        if !env.is_signed_integer(to_ty) && siv.has_lo && !types.int_val_is_neg(siv.lo) {
                            if let kb = opt_kb {
                                try kb_map_insert(
                                    &mut st.aux.known_bits,
                                    alloc,
                                    vk_val(dst),
                                    kb_trunc_unsigned(&kb, int_bitwidth(env.get(to_ty))),
                                );
                            }
                        }
                    }
                }
            }
        }
        .Clamp => {
            let tb = ty_bounds(to_ty, env);
            if tb.valid {
                let siv = dbm_get_interval(st, vk_val(operand));
                if tb.has_max {
                    let lo = if siv.has_lo { iv_clamp(siv.lo, tb.min, tb.max) } else { tb.min };
                    let hi = if siv.has_hi { iv_clamp(siv.hi, tb.min, tb.max) } else { tb.max };
                    try dbm_set_interval(st, alloc, vk_val(dst), interval_range(lo, hi));
                } else {
                    let lo = if siv.has_lo { iv_max(siv.lo, tb.min) } else { tb.min };
                    let has_hi = siv.has_hi;
                    let hi = if siv.has_hi { iv_max(siv.hi, tb.min) } else { types.int_val_zero() };
                    try dbm_set_interval(st, alloc, vk_val(dst), Interval.{ has_lo: true, lo: lo, has_hi: has_hi, hi: hi });
                }
            }
        }
        .ArrayBorrowToSlice => {
            let fn_node = env.get(from_ty);
            var has_arr = false;
            var arr_len: u64 = 0_u64;
            if fn_node.kind == .Borrow && fn_node.borrow_kind == .Single {
                let an = env.get(fn_node.primary);
                if an.kind == .Array {
                    has_arr = true;
                    arr_len = an.u64_val;
                }
            }
            if has_arr {
                try dbm_add_const(st, alloc, vk_len_val(dst), types.int_val_from_u64(arr_len));
            } else {
                try init_len_for_key(st, alloc, vk_len_val(dst), to_ty, env);
            }
        }
        .MutToConst => {
            if has_len_ty(to_ty, env) {
                try dbm_add_eq(st, alloc, vk_len_val(dst), vk_len_val(operand));
            }
        }
        .WrapOptional => {
            if env.is_integer(from_ty) {
                let opt_kb = st.get_known_bits(vk_val(operand));
                try dbm_assign_offset(st, alloc, vk_val(dst), vk_val(operand), types.int_val_zero(), ty_bounds(from_ty, env));
                if let kb = opt_kb {
                    try kb_map_insert(&mut st.aux.known_bits, alloc, vk_val(dst), kb);
                }
            }
            if has_len_ty(from_ty, env) {
                try init_len_for_key(st, alloc, vk_len_val(operand), from_ty, env);
                try dbm_add_eq(st, alloc, vk_len_val(dst), vk_len_val(operand));
            }
        }
        .WrapOk => {
            if env.is_integer(from_ty) {
                let opt_kb = st.get_known_bits(vk_val(operand));
                try dbm_assign_offset(st, alloc, vk_val(dst), vk_val(operand), types.int_val_zero(), ty_bounds(from_ty, env));
                if let kb = opt_kb {
                    try kb_map_insert(&mut st.aux.known_bits, alloc, vk_val(dst), kb);
                }
            }
            if has_len_ty(from_ty, env) {
                try init_len_for_key(st, alloc, vk_len_val(operand), from_ty, env);
                try dbm_add_eq(st, alloc, vk_len_val(dst), vk_len_val(operand));
            }
        }
        _ => {
            let tb = ty_bounds(to_ty, env);
            if tb.valid {
                try dbm_set_interval(st, alloc, vk_val(dst), tb_to_interval(tb));
            }
        }
    }
    return;
}

fn transfer_builtin_call(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    inst: *eir.EirInst,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    let bc = eir_prog.get_builtin_call(inst.aux0) orelse {
        return;
    };
    let args = eir_prog.vals_slice(bc.args);
    let arg_slots = eir_prog.arg_slots_slice(bc.arg_slots);
    let opk = bc.op.kind;
    if inst.dst != eir.EIR_NONE {
        let dv = inst.dst;
        if opk == .SliceLen || opk == .StrLen || opk == .ArrayLen
            || opk == .ArenaPoolLen || opk == .SlotPoolLen || opk == .BufLen
        {
            var lk = vk_val(dv);
            if arg_slots.len > 0_usize && arg_slots[0_usize] != eir.EIR_NONE {
                let slot = arg_slots[0_usize];
                if let si = eir_prog.fn_slot(fn_id, slot) {
                    try init_len_for_key(st, alloc, vk_len_slot(slot), si.ty, env);
                }
                lk = vk_len_slot(slot);
            } else if args.len > 0_usize {
                let a0 = args[0_usize];
                let aty = eir_prog.fn_val_ty(fn_id, a0);
                try init_len_for_key(st, alloc, vk_len_val(a0), aty, env);
                lk = vk_len_val(a0);
            }
            try dbm_set_interval(st, alloc, vk_val(dv), interval_range(types.int_val_zero(), iv_i64_max()));
            if lk != vk_val(dv) {
                try dbm_add_eq(st, alloc, vk_val(dv), lk);
            }
        } else if opk == .BufAsSlice || opk == .StrAsBytes || opk == .BytesAsStr {
            try init_len_for_key(st, alloc, vk_len_val(dv), bc.ret_ty, env);
            if arg_slots.len > 0_usize && arg_slots[0_usize] != eir.EIR_NONE {
                let slot = arg_slots[0_usize];
                if let si = eir_prog.fn_slot(fn_id, slot) {
                    try init_len_for_key(st, alloc, vk_len_slot(slot), si.ty, env);
                }
                try dbm_add_eq(st, alloc, vk_len_val(dv), vk_len_slot(slot));
            } else if args.len > 0_usize {
                let a0 = args[0_usize];
                let aty = eir_prog.fn_val_ty(fn_id, a0);
                try init_len_for_key(st, alloc, vk_len_val(a0), aty, env);
                try dbm_add_eq(st, alloc, vk_len_val(dv), vk_len_val(a0));
            }
        } else if (opk == .SliceSub || opk == .ArraySub || opk == .BufSub) && args.len >= 3_usize {
            let z = types.int_val_zero();
            var base_lk = vk_len_val(args[0_usize]);
            if arg_slots.len > 0_usize && arg_slots[0_usize] != eir.EIR_NONE {
                let slot = arg_slots[0_usize];
                if let si = eir_prog.fn_slot(fn_id, slot) {
                    try init_len_for_key(st, alloc, vk_len_slot(slot), si.ty, env);
                }
                base_lk = vk_len_slot(slot);
            } else {
                try init_len_for_key(st, alloc, base_lk, eir_prog.fn_val_ty(fn_id, args[0_usize]), env);
            }
            let lo_k = vk_val(args[1_usize]);
            let hi_k = vk_val(args[2_usize]);
            let dst_lk = vk_len_val(dv);
            try dbm_set_interval(st, alloc, dst_lk, interval_range(z, iv_i64_max()));
            try dbm_add_diff(st, alloc, dst_lk, base_lk, z);
            let lo_iv = dbm_get_interval(st, lo_k);
            if interval_is_const(&lo_iv) && types.int_val_is_zero(lo_iv.lo) {
                try dbm_add_eq(st, alloc, dst_lk, hi_k);
            } else {
                let d_hi = dbm_diff_upper(st, hi_k, lo_k);
                let d_lo = dbm_diff_upper(st, lo_k, hi_k);
                if d_hi.has_val && d_lo.has_val {
                    if let neg_dlo = types.int_val_checked_neg(d_lo.val) {
                        if types.int_val_eq(d_hi.val, neg_dlo) && !types.int_val_is_neg(d_hi.val) {
                            try dbm_add_const(st, alloc, dst_lk, d_hi.val);
                        }
                    }
                }
            }
        } else {
            let tb = ty_bounds(bc.ret_ty, env);
            if tb.valid {
                try dbm_set_interval(st, alloc, vk_val(dv), tb_to_interval(tb));
            }
            try init_len_for_key(st, alloc, vk_len_val(dv), bc.ret_ty, env);
        }
    }
    if opk == .ArenaPoolPush || opk == .ArenaPoolReset
        || opk == .SlotPoolInsert || opk == .SlotPoolTryInsert || opk == .SlotPoolRemove
        || opk == .BufPush || opk == .BufPushSlice || opk == .BufPop || opk == .BufClear
    {
        if arg_slots.len > 0_usize && arg_slots[0_usize] != eir.EIR_NONE {
            let slot = arg_slots[0_usize];
            dbm_forget(st, vk_len_slot(slot));
            try dbm_set_interval(st, alloc, vk_len_slot(slot), interval_range(types.int_val_zero(), iv_i64_max()));
        }
    }
    return;
}

fn transfer_call(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    inst: *eir.EirInst,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    sym_scratch: *mut col.DynBuf[SymEnvEntry],
) -> !OutOfMemory {
    let cd = eir_prog.get_call(inst.aux0) orelse {
        return;
    };
    let args = eir_prog.vals_slice(cd.args);
    var any_mut_arg = false;
    var ai: usize = 0_usize;
    while ai < args.len {
        let aty = eir_prog.fn_val_ty(fn_id, args[ai]);
        let an = env.get(aty);
        if (an.kind == .Borrow && an.flag0) || an.kind == .RawPtr {
            any_mut_arg = true;
            break;
        }
        if an.kind == .Struct {
            if let sm = env.get_struct(an.primary) {
                if sm.is_view {
                    any_mut_arg = true;
                    break;
                }
            }
        }
        ai = ai +% 1_usize;
    }
    if any_mut_arg {
        try dbm_forget_all_mutable_fields(st, alloc, eir_prog, fn_id, env);
    }
    if inst.dst != eir.EIR_NONE {
        let tb = ty_bounds(cd.ret_ty, env);
        if tb.valid {
            try dbm_set_interval(st, alloc, vk_val(inst.dst), tb_to_interval(tb));
        }
        try init_len_for_key(st, alloc, vk_len_val(inst.dst), cd.ret_ty, env);
    }
    if env.get(cd.ret_ty).kind != .ErrorUnion {
        if let ck = callee_to_fn_key(cd.callee) {
            if let cid = eir_prog.find_fn_by_key(ck) {
                let ens = eir_prog.fn_ensures_clauses(cid);
                if ens.len > 0_usize {
                    sym_scratch.clear();
                    let pnames = eir_prog.fn_param_names(cid);
                    var pi: usize = 0_usize;
                    while pi < pnames.len && pi < args.len {
                        let av = args[pi];
                        try sym_env_put(
                            sym_scratch,
                            alloc,
                            SymEnvEntry.{
                                sym: pnames[pi],
                                val_key: vk_val(av),
                                has_len_key: true,
                                len_key: vk_len_val(av),
                            },
                            true,
                        );
                        pi = pi +% 1_usize;
                    }
                    let has_ret = inst.dst != eir.EIR_NONE;
                    let ret_k = if has_ret { vk_val(inst.dst) } else { VK_NONE };
                    var ei: usize = 0_usize;
                    while ei < ens.len {
                        try assume_contract_expr(
                            st, alloc, arena, ens[ei], sym_scratch.as_slice(), has_ret, ret_k, interner,
                        );
                        ei = ei +% 1_usize;
                    }
                }
            }
        }
    }
    return;
}

fn transfer_copy_slot_inst(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    inst: *eir.EirInst,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    match inst.kind {
        .Copy => {
            let dst = inst.dst;
            let src = inst.v0;
            let dty = eir_prog.fn_val_ty(fn_id, dst);
            if env.is_integer(dty) {
                let opt_kb = st.get_known_bits(vk_val(src));
                try dbm_assign_offset(st, alloc, vk_val(dst), vk_val(src), types.int_val_zero(), ty_bounds(dty, env));
                if let kb = opt_kb {
                    try kb_map_insert(&mut st.aux.known_bits, alloc, vk_val(dst), kb);
                }
            }
            if let p = preds_get(st.aux.preds.as_slice(), src) {
                try preds_insert(&mut st.aux.preds, alloc, dst, p);
            }
            if let orig = val_slot_get(st.aux.val_slot_origin.as_slice(), src) {
                try val_slot_insert(&mut st.aux.val_slot_origin, alloc, dst, orig);
            }
            if let cop = checked_map_get(st.aux.checked_op.as_slice(), src) {
                try checked_map_insert(
                    &mut st.aux.checked_op,
                    alloc,
                    CheckedOpEntry.{ id: dst, op: cop.op, lhs: cop.lhs, rhs: cop.rhs, op_ty: cop.op_ty },
                );
            }
            if propagates_len_ty(dty, env) {
                let lsrc = vk_len_val(src);
                if has_len_ty(dty, env) || st.core.intervals.contains(lsrc) || st.core.vmap.contains(lsrc) {
                    try dbm_add_eq(st, alloc, vk_len_val(dst), lsrc);
                }
            }
        }
        .LoadSlot => {
            let dst = inst.dst;
            let slot = inst.aux0;
            let dty = eir_prog.fn_val_ty(fn_id, dst);
            if env.is_integer(dty) {
                let opt_kb = kb_map_get(st.aux.known_bits.as_slice(), vk_slot(slot));
                try dbm_assign_offset(st, alloc, vk_val(dst), vk_slot(slot), types.int_val_zero(), ty_bounds(dty, env));
                if let kb = opt_kb {
                    try kb_map_insert(&mut st.aux.known_bits, alloc, vk_val(dst), kb);
                }
            }
            let dn = env.get(dty);
            if (dn.kind == .Borrow && dn.borrow_kind == .Single) || dn.kind == .RawPtr {
                try val_slot_insert(&mut st.aux.val_slot_origin, alloc, dst, slot);
            }
            if let cop = checked_map_get(st.aux.slot_checked_op.as_slice(), slot) {
                try checked_map_insert(
                    &mut st.aux.checked_op,
                    alloc,
                    CheckedOpEntry.{ id: dst, op: cop.op, lhs: cop.lhs, rhs: cop.rhs, op_ty: cop.op_ty },
                );
            }
            if propagates_len_ty(dty, env) {
                let lslot = vk_len_slot(slot);
                if has_len_ty(dty, env) {
                    try init_len_for_key(st, alloc, lslot, dty, env);
                    try dbm_add_eq(st, alloc, vk_len_val(dst), lslot);
                } else if st.core.intervals.contains(lslot) || st.core.vmap.contains(lslot) {
                    try dbm_add_eq(st, alloc, vk_len_val(dst), lslot);
                }
            }
        }
        .StoreSlot => {
            let slot = inst.aux0;
            let val = inst.v0;
            var sty = types.TY_ERROR;
            if let si = eir_prog.fn_slot(fn_id, slot) {
                sty = si.ty;
            }
            try dbm_forget_fields_for_slot(st, alloc, slot);
            if let cop = checked_map_get(st.aux.checked_op.as_slice(), val) {
                try checked_map_insert(
                    &mut st.aux.slot_checked_op,
                    alloc,
                    CheckedOpEntry.{ id: slot, op: cop.op, lhs: cop.lhs, rhs: cop.rhs, op_ty: cop.op_ty },
                );
            } else {
                checked_map_remove(&mut st.aux.slot_checked_op, slot);
            }
            if env.is_integer(sty) {
                let opt_kb = st.get_known_bits(vk_val(val));
                try dbm_assign_offset(st, alloc, vk_slot(slot), vk_val(val), types.int_val_zero(), ty_bounds(sty, env));
                if let kb = opt_kb {
                    try kb_map_insert(&mut st.aux.known_bits, alloc, vk_slot(slot), kb);
                }
            }
            if propagates_len_ty(sty, env) {
                dbm_forget(st, vk_len_slot(slot));
                if has_len_ty(sty, env) {
                    try init_len_for_key(st, alloc, vk_len_slot(slot), sty, env);
                }
                let lval = vk_len_val(val);
                if st.core.intervals.contains(lval) || st.core.vmap.contains(lval) {
                    try dbm_add_eq(st, alloc, vk_len_slot(slot), lval);
                }
            }
            let stn = env.get(sty);
            if stn.kind == .Struct || stn.kind == .Tuple {
                var n_flds: u32 = 0_u32;
                if stn.kind == .Struct {
                    if let sm = env.get_struct(stn.primary) {
                        n_flds = sm.fields.len;
                    }
                } else {
                    n_flds = stn.list_len;
                }
                if n_flds > 16_u32 { n_flds = 16_u32; }
                var fi_s: u32 = 0_u32;
                while fi_s < n_flds {
                    let fvk = vk_field_val(val, fi_s);
                    if st.core.intervals.contains(fvk) || st.core.vmap.contains(fvk) {
                        try dbm_add_eq(st, alloc, vk_field_slot(slot, fi_s), fvk);
                    }
                    let flk = vk_field_len_val(val, fi_s);
                    if st.core.intervals.contains(flk) || st.core.vmap.contains(flk) {
                        try dbm_add_eq(st, alloc, vk_field_len_slot(slot, fi_s), flk);
                    }
                    fi_s = fi_s +% 1_u32;
                }
            }
        }
        .SlotAddr => {
            let dst = inst.dst;
            let slot = inst.aux0;
            try val_slot_insert(&mut st.aux.val_slot_origin, alloc, dst, slot);
            var sty = types.TY_ERROR;
            if let si = eir_prog.fn_slot(fn_id, slot) {
                sty = si.ty;
            }
            if has_len_ty(sty, env) || has_len_ty(inst.ty0, env) {
                try init_len_for_key(st, alloc, vk_len_slot(slot), sty, env);
                try dbm_add_eq(st, alloc, vk_len_val(dst), vk_len_slot(slot));
            }
        }
        _ => {}
    }
    return;
}

fn transfer_place_inst(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    inst: *eir.EirInst,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    if inst.kind == .LoadPlace {
        let dst = inst.dst;
        let dty = eir_prog.fn_val_ty(fn_id, dst);
        if let place = eir_prog.get_place(inst.aux0) {
            if let fk = field_key_of_place(st, eir_prog, fn_id, place, env) {
                if env.is_integer(dty) {
                    let tb = ty_bounds(dty, env);
                    if tb.valid {
                        try dbm_set_interval(st, alloc, fk, tb_to_interval(copy tb));
                    }
                    let opt_kb = kb_map_get(st.aux.known_bits.as_slice(), fk);
                    try dbm_assign_offset(st, alloc, vk_val(dst), fk, types.int_val_zero(), tb);
                    if let kb = opt_kb {
                        try kb_map_insert(&mut st.aux.known_bits, alloc, vk_val(dst), kb);
                    }
                } else {
                    try init_len_for_key(st, alloc, vk_len_val(dst), dty, env);
                    if has_len_ty(dty, env) {
                        let flk = if vk_tag(fk) == VK_TAG_FIELD_SLOT {
                            vk_field_len_slot(vk_a(fk), vk_b(fk))
                        } else if vk_tag(fk) == VK_TAG_FIELD_VAL {
                            vk_field_len_val(vk_a(fk), vk_b(fk))
                        } else {
                            fk
                        };
                        try init_len_for_key(st, alloc, flk, dty, env);
                        try dbm_add_eq(st, alloc, vk_len_val(dst), flk);
                    }
                }
                return;
            }
        }
        let tb = ty_bounds(dty, env);
        if tb.valid {
            try dbm_set_interval(st, alloc, vk_val(dst), tb_to_interval(tb));
        }
        try init_len_for_key(st, alloc, vk_len_val(dst), dty, env);
        return;
    }
    if inst.kind == .StorePlace {
        if let place = eir_prog.get_place(inst.aux0) {
            if let fk = field_key_of_place(st, eir_prog, fn_id, place, env) {
                let val = inst.v0;
                dbm_forget(st, fk);
                if vk_tag(fk) == VK_TAG_FIELD_SLOT || vk_tag(fk) == VK_TAG_FIELD_VAL {
                    let flk = if vk_tag(fk) == VK_TAG_FIELD_SLOT {
                        vk_field_len_slot(vk_a(fk), vk_b(fk))
                    } else {
                        vk_field_len_val(vk_a(fk), vk_b(fk))
                    };
                    dbm_forget(st, flk);
                    if has_len_ty(place.ty, env) {
                        try init_len_for_key(st, alloc, flk, place.ty, env);
                        try dbm_add_eq(st, alloc, flk, vk_len_val(val));
                    }
                }
                if env.is_integer(place.ty) {
                    let opt_kb = st.get_known_bits(vk_val(val));
                    try dbm_assign_offset(st, alloc, fk, vk_val(val), types.int_val_zero(), ty_bounds(place.ty, env));
                    if let kb = opt_kb {
                        try kb_map_insert(&mut st.aux.known_bits, alloc, fk, kb);
                    }
                }
                return;
            }
        }
        try dbm_forget_all_mutable_fields(st, alloc, eir_prog, fn_id, env);
    }
    return;
}

fn transfer_unary_inst(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    preds: *mut PredArena,
    inst: *eir.EirInst,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    if inst.unary_op == .Not {
        if let p = preds_get(st.aux.preds.as_slice(), inst.v0) {
            let np = try preds.intern_not(alloc, p);
            try preds_insert(&mut st.aux.preds, alloc, inst.dst, np);
        }
        return;
    }
    if inst.unary_op == .Neg && env.is_integer(inst.ty0) {
        let iv = dbm_get_interval(st, vk_val(inst.v0));
        var has_lo = false;
        var lo = types.int_val_zero();
        if iv.has_hi {
            if let nl = types.int_val_checked_neg(iv.hi) {
                has_lo = true;
                lo = nl;
            }
        }
        var has_hi = false;
        var hi = types.int_val_zero();
        if iv.has_lo {
            if let nh = types.int_val_checked_neg(iv.lo) {
                has_hi = true;
                hi = nh;
            }
        }
        var res = Interval.{ has_lo: has_lo, lo: lo, has_hi: has_hi, hi: hi };
        let tb = ty_bounds(inst.ty0, env);
        if tb.valid {
            let tb_iv = tb_to_interval(tb);
            res = interval_intersect(&res, &tb_iv);
        }
        try dbm_set_interval(st, alloc, vk_val(inst.dst), res);
        return;
    }
    let tb = ty_bounds(inst.ty0, env);
    if tb.valid {
        try dbm_set_interval(st, alloc, vk_val(inst.dst), tb_to_interval(tb));
    }
    return;
}

fn transfer_slice_inst(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    inst: *eir.EirInst,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    let base_len_k = vk_len_val(inst.v0);
    try init_len_for_key(st, alloc, base_len_k, inst.ty1, env);
    let z = types.int_val_zero();
    let lo_iv = if inst.v1 != eir.EIR_NONE {
        dbm_get_interval(st, vk_val(inst.v1))
    } else {
        interval_const(z)
    };
    let hi_iv = if inst.v2 != eir.EIR_NONE {
        dbm_get_interval(st, vk_val(inst.v2))
    } else {
        dbm_get_interval(st, base_len_k)
    };
    var len_lo = z;
    if hi_iv.has_lo && lo_iv.has_hi {
        if let d = types.int_val_checked_sub(hi_iv.lo, lo_iv.hi) {
            len_lo = iv_max(d, z);
        }
    }
    var len_hi = iv_i64_max();
    if hi_iv.has_hi && lo_iv.has_lo {
        if let d = types.int_val_checked_sub(hi_iv.hi, lo_iv.lo) {
            len_hi = iv_clamp(d, z, iv_i64_max());
        }
    }
    try dbm_set_interval(st, alloc, vk_len_val(inst.dst), interval_range(len_lo, iv_max(len_hi, len_lo)));
    try dbm_add_diff(st, alloc, vk_len_val(inst.dst), base_len_k, z);
    if inst.v1 == eir.EIR_NONE && inst.v2 != eir.EIR_NONE {
        try dbm_add_eq(st, alloc, vk_len_val(inst.dst), vk_val(inst.v2));
    } else if inst.v1 != eir.EIR_NONE && inst.v2 != eir.EIR_NONE {
        let liv = dbm_get_interval(st, vk_val(inst.v1));
        if interval_is_const(&liv) && types.int_val_is_zero(liv.lo) {
            try dbm_add_eq(st, alloc, vk_len_val(inst.dst), vk_val(inst.v2));
        } else {
            let d_hi = dbm_diff_upper(st, vk_val(inst.v2), vk_val(inst.v1));
            let d_lo = dbm_diff_upper(st, vk_val(inst.v1), vk_val(inst.v2));
            if d_hi.has_val && d_lo.has_val {
                if let neg_dlo = types.int_val_checked_neg(d_lo.val) {
                    if types.int_val_eq(d_hi.val, neg_dlo) && !types.int_val_is_neg(d_hi.val) {
                        try dbm_add_const(st, alloc, vk_len_val(inst.dst), d_hi.val);
                    }
                }
            }
        }
    }
    return;
}

fn transfer_inst(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    preds: *mut PredArena,
    arena: *ast.AstArena,
    inst: *eir.EirInst,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    sym_scratch: *mut col.DynBuf[SymEnvEntry],
) -> !OutOfMemory {
    match inst.kind {
        .Const => {
            if let kc = eir_prog.get_const(inst.aux0) {
                match kc.kind {
                    .Int => {}
                    .Bool => {
                        let pid = try preds.intern_const(alloc, kc.bool_val);
                        try preds_insert(&mut st.aux.preds, alloc, inst.dst, pid);
                    }
                    .Str => {
                        try dbm_add_const(st, alloc, vk_len_val(inst.dst), types.int_val_from_u64(kc.bytes.len.widen.[u64]()));
                    }
                    .Bytes => {
                        try dbm_add_const(st, alloc, vk_len_val(inst.dst), types.int_val_from_u64(kc.bytes.len.widen.[u64]()));
                    }
                    _ => {
                        try init_len_for_key(st, alloc, vk_len_val(inst.dst), inst.ty0, env);
                    }
                }
            }
        }
        .Copy => { try transfer_copy_slot_inst(st, alloc, inst, eir_prog, fn_id, env); }
        .LoadSlot => { try transfer_copy_slot_inst(st, alloc, inst, eir_prog, fn_id, env); }
        .StoreSlot => { try transfer_copy_slot_inst(st, alloc, inst, eir_prog, fn_id, env); }
        .SlotAddr => { try transfer_copy_slot_inst(st, alloc, inst, eir_prog, fn_id, env); }
        .LoadPlace => { try transfer_place_inst(st, alloc, inst, eir_prog, fn_id, env); }
        .StorePlace => { try transfer_place_inst(st, alloc, inst, eir_prog, fn_id, env); }
        .PoolColumnLoad => {
            let dty = eir_prog.fn_val_ty(fn_id, inst.dst);
            let tb = ty_bounds(dty, env);
            if tb.valid {
                try dbm_set_interval(st, alloc, vk_val(inst.dst), tb_to_interval(tb));
            }
            try init_len_for_key(st, alloc, vk_len_val(inst.dst), dty, env);
        }
        .Unary => { try transfer_unary_inst(st, alloc, preds, inst, env); }
        .Binary => {
            try transfer_binary(
                st, alloc, preds, inst.dst, inst.bin_op, inst.v0, inst.v1, inst.ty1, inst.ty0, env,
            );
        }
        .Cast => { try transfer_cast(st, alloc, inst, env); }
        .Slice => { try transfer_slice_inst(st, alloc, inst, env); }
        .Aggregate => {
            try init_len_for_key(st, alloc, vk_len_val(inst.dst), inst.ty0, env);
            let atn = env.get(inst.ty0);
            if atn.kind == .Struct || atn.kind == .Tuple {
                let fvals = eir_prog.vals_slice(inst.range);
                var fi_a: usize = 0_usize;
                while fi_a < fvals.len && fi_a < 16_usize {
                    let fv = fvals[fi_a];
                    let fty = eir_prog.fn_val_ty(fn_id, fv);
                    if env.is_integer(fty) {
                        try dbm_assign_offset(st, alloc, vk_field_val(inst.dst, fi_a.trunc.[u32]()), vk_val(fv), types.int_val_zero(), ty_bounds(fty, env));
                    }
                    if has_len_ty(fty, env) {
                        let flk = vk_field_len_val(inst.dst, fi_a.trunc.[u32]());
                        try init_len_for_key(st, alloc, flk, fty, env);
                        try init_len_for_key(st, alloc, vk_len_val(fv), fty, env);
                        try dbm_add_eq(st, alloc, flk, vk_len_val(fv));
                    }
                    fi_a = fi_a +% 1_usize;
                }
            }
        }
        .UnwrapOptional => {
            let tb = ty_bounds(inst.ty0, env);
            if tb.valid {
                try dbm_set_interval(st, alloc, vk_val(inst.dst), tb_to_interval(tb));
            }
            try init_len_for_key(st, alloc, vk_len_val(inst.dst), inst.ty0, env);
            if has_len_ty(inst.ty0, env) {
                let lsrc = vk_len_val(inst.v0);
                if st.core.intervals.contains(lsrc) || st.core.vmap.contains(lsrc) {
                    try dbm_add_eq(st, alloc, vk_len_val(inst.dst), lsrc);
                }
            }
        }
        .FieldExtract => {
            let tb = ty_bounds(inst.ty0, env);
            if tb.valid {
                try dbm_set_interval(st, alloc, vk_val(inst.dst), tb_to_interval(tb));
            }
            if env.is_integer(inst.ty0) {
                let fvk = vk_field_val(inst.v0, inst.aux0);
                if st.core.intervals.contains(fvk) || st.core.vmap.contains(fvk) {
                    try dbm_assign_offset(st, alloc, vk_val(inst.dst), fvk, types.int_val_zero(), ty_bounds(inst.ty0, env));
                }
            }
            try init_len_for_key(st, alloc, vk_len_val(inst.dst), inst.ty0, env);
            if has_len_ty(inst.ty0, env) {
                let flk = vk_field_len_val(inst.v0, inst.aux0);
                if st.core.intervals.contains(flk) || st.core.vmap.contains(flk) {
                    try dbm_add_eq(st, alloc, vk_len_val(inst.dst), flk);
                }
            }
        }
        .UnwrapErrorOk => {
            if let cop = checked_map_get(st.aux.checked_op.as_slice(), inst.v0) {
                let proven_op: ast.BinaryOp = match cop.op {
                    .AddCheck => .Add,
                    .SubCheck => .Sub,
                    .MulCheck => .Mul,
                    .DivCheck => .Div,
                    .ModCheck => .Mod,
                    _ => cop.op,
                };
                try transfer_binary(
                    st, alloc, preds, inst.dst, proven_op, cop.lhs, cop.rhs, cop.op_ty, inst.ty0, env,
                );
            } else {
                let tb = ty_bounds(inst.ty0, env);
                if tb.valid {
                    try dbm_set_interval(st, alloc, vk_val(inst.dst), tb_to_interval(tb));
                }
                try init_len_for_key(st, alloc, vk_len_val(inst.dst), inst.ty0, env);
                if has_len_ty(inst.ty0, env) {
                    let lsrc = vk_len_val(inst.v0);
                    if st.core.intervals.contains(lsrc) || st.core.vmap.contains(lsrc) {
                        try dbm_add_eq(st, alloc, vk_len_val(inst.dst), lsrc);
                    }
                }
            }
        }
        .BuiltinCall => {
            try transfer_builtin_call(st, alloc, inst, eir_prog, fn_id, env);
        }
        .Call => {
            try transfer_call(st, alloc, arena, inst, eir_prog, fn_id, env, interner, sym_scratch);
        }
        _ => {}
    }
    return;
}

fn snap_find_interval(spool: *StatePool, snap: *StateSnap, k: VarKey) -> ?Interval {
    let ivs = slice_range.[IntervalEntry](spool.core.intervals.as_slice(), snap.intervals);
    var lo: usize = 0_usize;
    var hi = ivs.len;
    while lo < hi {
        let mid = lo +% ((hi -% lo) >> 1_usize);
        if mid < ivs.len && ivs[mid].key < k {
            lo = mid +% 1_usize;
        } else {
            hi = mid;
        }
    }
    if lo < ivs.len && ivs[lo].key == k {
        return ivs[lo].iv;
    }
    return null;
}

fn snap_get_interval(spool: *StatePool, snap: *StateSnap, k: VarKey, ref_st: *DbmState) -> Interval {
    var iv = snap_find_interval(spool, snap, k) orelse ref_st.default_interval(k);
    let vs = slice_range.[VarKey](spool.core.verts.as_slice(), snap.verts);
    if let idx = find_vert_in_slice(vs, k) {
        let mat = slice_range.[SparseBound](spool.core.mat.as_slice(), snap.mat);
        let n = vs.len;
        let hi_b = snap_mat_at(mat, n, idx, 0_usize);
        let lo_b = snap_mat_at(mat, n, 0_usize, idx);
        var has_lo = false;
        var lo = types.int_val_zero();
        if lo_b.has_val {
            if let nl = types.int_val_checked_neg(lo_b.val) {
                has_lo = true;
                lo = nl;
            }
        }
        let dbm_iv = Interval.{ has_lo: has_lo, lo: lo, has_hi: hi_b.has_val, hi: hi_b.val };
        iv = interval_intersect(&iv, &dbm_iv);
    }
    return iv;
}

fn snap_is_non_zero(spool: *StatePool, snap: *StateSnap, k: VarKey, ref_st: *DbmState) -> bool {
    if vk_set_contains(slice_range.[VarKey](spool.aux.non_zero.as_slice(), snap.non_zero), k) {
        return true;
    }
    let iv = snap_get_interval(spool, snap, k, ref_st);
    let z = types.int_val_zero();
    return (iv.has_lo && iv_gt(iv.lo, z)) || (iv.has_hi && iv_lt(iv.hi, z));
}

fn phis_contains_dst_vk(phis: *[eir.EirPhi], k: VarKey) -> bool {
    if vk_tag(k) != VK_TAG_VAL {
        return false;
    }
    let target = vk_a(k);
    var i: usize = 0_usize;
    while i < phis.len {
        if phis[i].dst == target {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn bb_is_loop_hdr(eir_prog: *eir.EirProgram, fn_id: u32, bb: cfg_ir.BlockId) -> bool {
    let preds = eir_prog.block_preds(fn_id, bb);
    var i: usize = 0_usize;
    while i < preds.len {
        if eir_prog.dominates_block(fn_id, bb, preds[i]) {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn apply_phis_on_edge(
    st: *mut DbmState,
    alloc: *mut AllocCap,
    spool: *mut StatePool,
    from_bb: cfg_ir.BlockId,
    to_bb: cfg_ir.BlockId,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    val_uses: *[u32],
    live: *BlockLiveness,
) -> !OutOfMemory {
    if st.core.is_bottom {
        return;
    }
    if !live.block_has_live_phis(to_bb) {
        return;
    }
    let phis = eir_prog.block_phis(fn_id, to_bb);
    if phis.len == 0_usize {
        return;
    }
    let to_is_loop_hdr = bb_is_loop_hdr(eir_prog, fn_id, to_bb);
    // Fast path: when no live incoming value on edge `from_bb -> to_bb` collides with any live `phi.dst`
    // in `phis` (99%+ of blocks), read directly from `st` without saving/sorting a snapshot!
    var has_phi_conflict = false;
    var ci: usize = 0_usize;
    while ci < phis.len {
        if !live.is_live_phi(phis[ci].dst) {
            ci = ci +% 1_usize;
            continue;
        }
        let incs_c = eir_prog.phi_incoming(phis[ci].incoming);
        var ii_c: usize = 0_usize;
        while ii_c < incs_c.len {
            if incs_c[ii_c].pred_bb == from_bb {
                let iv_c = incs_c[ii_c].val;
                if live.is_live_phi(iv_c) && phis_contains_dst_vk(phis, vk_val(iv_c)) {
                    has_phi_conflict = true;
                }
                break;
            }
            ii_c = ii_c +% 1_usize;
        }
        if has_phi_conflict {
            break;
        }
        ci = ci +% 1_usize;
    }
    if !has_phi_conflict {
        var pi: usize = 0_usize;
        while pi < phis.len {
            let phi = phis[pi];
            if !live.is_live_phi(phi.dst) {
                pi = pi +% 1_usize;
                continue;
            }
            let incs = eir_prog.phi_incoming(phi.incoming);
            var found = false;
            var inc: eir.EirValue = 0_u32;
            var ii: usize = 0_usize;
            while ii < incs.len {
                if incs[ii].pred_bb == from_bb {
                    found = true;
                    inc = incs[ii].val;
                    break;
                }
                ii = ii +% 1_usize;
            }
            if !found {
                pi = pi +% 1_usize;
                continue;
            }
            if env.is_integer(phi.ty) {
                let dk = vk_val(phi.dst);
                let sk = vk_val(inc);
                let dst_tb = ty_bounds(phi.ty, env);
                let sk_iv = dbm_get_interval(st, sk);
                let sk_kb = st.get_known_bits(sk);
                let sk_nz = dbm_is_non_zero(st, sk);
                let sk_in_vmap = st.core.vmap.contains(sk);
                dbm_forget(st, dk);
                if dst_tb.valid {
                    try dbm_set_interval(st, alloc, dk, tb_to_interval(dst_tb));
                }
                try dbm_set_interval(st, alloc, dk, copy sk_iv);
                if let kb = sk_kb {
                    try kb_map_insert(&mut st.aux.known_bits, alloc, dk, kb);
                }
                if sk != dk && st.var_is_relational(dk) && st.var_is_relational(sk) {
                    let inc_idx = inc.widen.[usize]();
                    let sk_multi_use = inc_idx < val_uses.len && val_uses[inc_idx] > 1_u32;
                    if sk_in_vmap || (sk_multi_use && !interval_is_const(&sk_iv)) {
                        try dbm_add_eq(st, alloc, dk, sk);
                    } else if !to_is_loop_hdr && interval_is_const(&sk_iv) {
                        _ = try dbm_ensure_vertex(st, alloc, dk, false, VK_NONE);
                    }
                } else if !to_is_loop_hdr && st.var_is_relational(dk) && interval_is_const(&sk_iv) {
                    _ = try dbm_ensure_vertex(st, alloc, dk, false, VK_NONE);
                }
                if sk_nz {
                    try vk_set_insert(&mut st.aux.non_zero, alloc, dk);
                }
            }
            let lsrc = vk_len_val(inc);
            let ldst = vk_len_val(phi.dst);
            if st.core.intervals.contains(lsrc) || st.core.vmap.contains(lsrc) {
                try dbm_add_eq(st, alloc, ldst, lsrc);
            }
            pi = pi +% 1_usize;
        }
        return;
    }
    let snap = try spool.save(alloc, st);
    var pi: usize = 0_usize;
    while pi < phis.len {
        let phi = phis[pi];
        if !live.is_live_phi(phi.dst) {
            pi = pi +% 1_usize;
            continue;
        }
        let incs = eir_prog.phi_incoming(phi.incoming);
        var found = false;
        var inc: eir.EirValue = 0_u32;
        var ii: usize = 0_usize;
        while ii < incs.len {
            if incs[ii].pred_bb == from_bb {
                found = true;
                inc = incs[ii].val;
                break;
            }
            ii = ii +% 1_usize;
        }
        if !found {
            pi = pi +% 1_usize;
            continue;
        }
        if env.is_integer(phi.ty) {
            let dk = vk_val(phi.dst);
            let sk = vk_val(inc);
            let dst_tb = ty_bounds(phi.ty, env);
            dbm_forget(st, dk);
            if dst_tb.valid {
                try dbm_set_interval(st, alloc, dk, tb_to_interval(dst_tb));
            }
            let sk_iv = snap_get_interval(spool, &snap, sk, st);
            try dbm_set_interval(st, alloc, dk, copy sk_iv);
            if let kb = kb_map_get(slice_range.[KnownBitsEntry](spool.aux.known_bits.as_slice(), snap.known_bits), sk) {
                try kb_map_insert(&mut st.aux.known_bits, alloc, dk, kb);
            } else if vk_tag(sk) == VK_TAG_VAL && st.const_int_vals.test(vk_a(sk).widen.[usize]()) {
                if let ckb = st.get_known_bits(sk) {
                    try kb_map_insert(&mut st.aux.known_bits, alloc, dk, ckb);
                }
            }
            if sk != dk && st.var_is_relational(dk) && st.var_is_relational(sk) {
                let svs = slice_range.[VarKey](spool.core.verts.as_slice(), snap.verts);
                let sk_is_phi_dst = phis_contains_dst_vk(phis, sk);
                let inc_idx = inc.widen.[usize]();
                let sk_multi_use = inc_idx < val_uses.len && val_uses[inc_idx] > 1_u32;
                if !sk_is_phi_dst && st.core.vmap.contains(sk) {
                    // `sk` is untouched in `st` and already in DBM: `dk == sk` propagates ALL of `sk`'s relations!
                    try dbm_add_eq(st, alloc, dk, sk);
                } else if !sk_is_phi_dst && sk_multi_use && !interval_is_const(&sk_iv) && find_vert_in_slice(svs, sk) == null {
                    // `sk` may be compared later (`use_count > 1`): record equality `dk == sk`.
                    try dbm_add_eq(st, alloc, dk, sk);
                } else if let si = find_vert_in_slice(svs, sk) {
                    // Only needed for parallel-swap phi cycles (`sk_is_phi_dst`) or if `sk` was evicted.
                    let smat = slice_range.[SparseBound](spool.core.mat.as_slice(), snap.mat);
                    let sn = svs.len;
                    var oi: usize = 1_usize;
                    while oi < svs.len {
                        let ok = svs[oi];
                        if ok != VK_NONE && ok != dk && ok != sk && !phis_contains_dst_vk(phis, ok) {
                            let d1 = snap_mat_at(smat, sn, si, oi);
                            if d1.has_val {
                                try dbm_add_diff(st, alloc, dk, ok, d1.val);
                            }
                            let d2 = snap_mat_at(smat, sn, oi, si);
                            if d2.has_val {
                                try dbm_add_diff(st, alloc, ok, dk, d2.val);
                            }
                        }
                        oi = oi +% 1_usize;
                    }
                } else if !to_is_loop_hdr && interval_is_const(&sk_iv) {
                    _ = try dbm_ensure_vertex(st, alloc, dk, false, VK_NONE);
                }
            } else if !to_is_loop_hdr && st.var_is_relational(dk) && interval_is_const(&sk_iv) {
                _ = try dbm_ensure_vertex(st, alloc, dk, false, VK_NONE);
            }
            if snap_is_non_zero(spool, &snap, sk, st) {
                try vk_set_insert(&mut st.aux.non_zero, alloc, dk);
            }
        }
        let lsrc = vk_len_val(inc);
        let ldst = vk_len_val(phi.dst);
        var has_lsrc = false;
        if let _ = snap_find_interval(spool, &snap, lsrc) {
            has_lsrc = true;
        } else if let _ = find_vert_in_slice(slice_range.[VarKey](spool.core.verts.as_slice(), snap.verts), lsrc) {
            has_lsrc = true;
        }
        if has_lsrc {
            try dbm_add_eq(st, alloc, ldst, lsrc);
        }
        pi = pi +% 1_usize;
    }
    return;
}

// ===========================================================================
// Section 10: Verification Checks, Bounds/Overflow Proofs, & Diagnostics
// ===========================================================================

fn push_val_name(
    alloc: *mut AllocCap,
    v: eir.EirValue,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    if let sym = eir_prog.fn_val_name(fn_id, v) {
        try out.push_bytes_grow(alloc, interner.get(sym));
        return;
    }
    try out.push_str_grow(alloc, "%v");
    try out.push_u64_grow(alloc, v.widen.[u64]());
    return;
}

fn push_state_summary(
    alloc: *mut AllocCap,
    st: *DbmState,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    let params = eir_prog.fn_params(fn_id);
    let pnames = eir_prog.fn_param_names(fn_id);
    try out.push_str_grow(alloc, "known: ");
    var count: usize = 0_usize;
    var pi: usize = 0_usize;
    while pi < params.len {
        let iv = dbm_get_interval(st, vk_val(params[pi]));
        if iv.has_lo || iv.has_hi {
            if count > 0_usize {
                try out.push_str_grow(alloc, ", ");
            }
            if pi < pnames.len {
                try out.push_bytes_grow(alloc, interner.get(pnames[pi]));
            } else {
                try out.push_byte_grow(alloc, b'p');
                try out.push_u64_grow(alloc, pi.widen.[u64]());
            }
            try out.push_str_grow(alloc, " in ");
            try push_interval_str(alloc, &iv, out);
            count = count +% 1_usize;
        }
        pi = pi +% 1_usize;
    }
    if count == 0_usize {
        try out.push_str_grow(alloc, "state is reachable (non-contradictory)");
    }
    return;
}

fn emit_note_buf(
    diags: *mut diag.DiagBag,
    alloc: *mut AllocCap,
    didx: usize,
    buf: *str.StrBuf,
) -> !OutOfMemory {
    let s = buf.as_str() catch {
        return;
    };
    try diags.add_note(alloc, didx, s);
    return;
}

fn verify_index_proj(
    alloc: *mut AllocCap,
    index: eir.EirValue,
    cur_ty: types.TyId,
    has_len_k: bool,
    len_k: VarKey,
    sp: span.Span,
    st: *DbmState,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    stats: *mut FnVerifyInfo,
    msg_buf: *mut str.StrBuf,
    note_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let idx_k = vk_val(index);
    let idx_iv = dbm_get_interval(st, idx_k);
    let non_neg = idx_iv.has_lo && !types.int_val_is_neg(idx_iv.lo);
    let deref_tn = env.get(deref_single_borrow(cur_ty, env));

    var proven = false;
    note_buf.clear();
    try note_buf.push_str_grow(alloc, "known: ");
    try push_val_name(alloc, index, eir_prog, fn_id, interner, note_buf);
    try note_buf.push_str_grow(alloc, " in ");
    try push_interval_str(alloc, &idx_iv, note_buf);

    if deref_tn.kind == .Builtin && deref_tn.builtin_kind == .GpuBuf {
        proven = true;
    } else if deref_tn.kind == .Array {
        let alen = types.int_val_from_u64(deref_tn.u64_val);
        if non_neg && idx_iv.has_hi && iv_lt(idx_iv.hi, alen) {
            proven = true;
        } else {
            try note_buf.push_str_grow(alloc, ", array len = ");
            try note_buf.push_u64_grow(alloc, deref_tn.u64_val);
        }
    } else if deref_tn.kind == .Vec {
        let vlen = types.int_val_from_u64(deref_tn.u8_val.widen.[u64]());
        if non_neg && idx_iv.has_hi && iv_lt(idx_iv.hi, vlen) {
            proven = true;
        } else {
            try note_buf.push_str_grow(alloc, ", vec len = ");
            try note_buf.push_u64_grow(alloc, deref_tn.u8_val.widen.[u64]());
        }
    } else if has_len_k {
        let diff = dbm_diff_upper(st, idx_k, len_k);
        let neg1_b = bound_some(iv_neg_one());
        if non_neg && bound_le(&diff, &neg1_b) {
            proven = true;
        } else if diff.has_val {
            try note_buf.push_str_grow(alloc, ", ");
            try push_val_name(alloc, index, eir_prog, fn_id, interner, note_buf);
            try note_buf.push_str_grow(alloc, " - len <= ");
            try types.push_int_val_grow(alloc, diff.val, note_buf);
        } else {
            let len_iv = dbm_get_interval(st, len_k);
            try note_buf.push_str_grow(alloc, ", len in ");
            try push_interval_str(alloc, &len_iv, note_buf);
        }
    }

    stats.total_checks = stats.total_checks +% 1_usize;
    if proven {
        stats.proven_checks = stats.proven_checks +% 1_usize;
        return true;
    }
    msg_buf.clear();
    try msg_buf.push_str_grow(alloc, "ZM-07: cannot prove index bounds `0 <= ");
    try push_val_name(alloc, index, eir_prog, fn_id, interner, msg_buf);
    try msg_buf.push_str_grow(alloc, " < len`");
    let didx = try diags.emit_error_bytes(alloc, diag.E0107, sp, msg_buf.as_bytes());
    try emit_note_buf(diags, alloc, didx, note_buf);
    var help_msg: *str = "add a check `if i < buf.len { ... }`, strengthen `where`, or use `try buf.at(i)`";
    if !non_neg {
        help_msg = "index may be negative: add `if i >= 0 && i < buf.len { ... }`, or use `usize`";
    } else if has_len_k {
        let diff_h = dbm_diff_upper(st, idx_k, len_k);
        if diff_h.has_val && types.int_val_is_zero(diff_h.val) {
            help_msg = "possible off-by-one (`idx <= len` allows `idx == len`): use `<` instead of `<=`, or `try buf.at(i)`";
        }
    }
    try diags.add_help(alloc, didx, help_msg);
    return false;
}

fn verify_place_bounds(
    alloc: *mut AllocCap,
    place: *eir.EirPlace,
    sp: span.Span,
    st: *DbmState,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    stats: *mut FnVerifyInfo,
    msg_buf: *mut str.StrBuf,
    note_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    var all_ok = true;
    var cur_ty = types.TY_ERROR;
    var has_len_k = true;
    var len_k = VK_NONE;
    if place.base.kind == .Slot {
        if let si = eir_prog.fn_slot(fn_id, place.base.id) {
            cur_ty = si.ty;
        }
        len_k = vk_len_slot(place.base.id);
    } else {
        cur_ty = eir_prog.fn_val_ty(fn_id, place.base.id);
        len_k = vk_len_val(place.base.id);
    }
    var prev_was_pool_col = false;
    let projs = eir_prog.projs_slice(place.projs);
    var pi: usize = 0_usize;
    while pi < projs.len {
        let pr = projs[pi];
        match pr.kind {
            .Deref => {
                cur_ty = deref_ptr_or_borrow(cur_ty, env);
                prev_was_pool_col = false;
            }
            .Field => {
                let is_root = pi == 0_usize || (pi == 1_usize && projs[0_usize].kind == .Deref);
                let is_pool = env.get(deref_ptr_or_borrow(cur_ty, env)).kind == .Pool;
                if is_root && !is_pool {
                    has_len_k = true;
                    if place.base.kind == .Slot {
                        len_k = vk_field_len_slot(place.base.id, pr.index);
                    } else if let os = val_slot_get(st.aux.val_slot_origin.as_slice(), place.base.id) {
                        len_k = vk_field_len_slot(os, pr.index);
                    } else {
                        len_k = vk_field_len_val(place.base.id, pr.index);
                    }
                } else {
                    has_len_k = false;
                }
                cur_ty = pr.ty;
                prev_was_pool_col = false;
            }
            .TupleField => {
                let is_root = pi == 0_usize || (pi == 1_usize && projs[0_usize].kind == .Deref);
                if is_root {
                    has_len_k = true;
                    if place.base.kind == .Slot {
                        len_k = vk_field_len_slot(place.base.id, pr.index);
                    } else if let os = val_slot_get(st.aux.val_slot_origin.as_slice(), place.base.id) {
                        len_k = vk_field_len_slot(os, pr.index);
                    } else {
                        len_k = vk_field_len_val(place.base.id, pr.index);
                    }
                } else {
                    has_len_k = false;
                }
                cur_ty = pr.ty;
                prev_was_pool_col = false;
            }
            .PoolCol => {
                cur_ty = pr.ty;
                prev_was_pool_col = true;
            }
            .Index => {
                let idx_ty = eir_prog.fn_val_ty(fn_id, pr.index);
                let idx_tn = env.get(idx_ty);
                let is_pool_id = idx_tn.kind == .Builtin
                    && (idx_tn.builtin_kind == .IdBrand
                        || idx_tn.builtin_kind == .GenId
                        || idx_tn.builtin_kind == .Link);
                if !(prev_was_pool_col && is_pool_id) {
                    let ok = try verify_index_proj(
                        alloc, pr.index, cur_ty, has_len_k, len_k, sp, st,
                        eir_prog, fn_id, env, interner, diags, stats, msg_buf, note_buf,
                    );
                    if !ok {
                        all_ok = false;
                    }
                }
                cur_ty = pr.ty;
                has_len_k = false;
                prev_was_pool_col = false;
            }
        }
        pi = pi +% 1_usize;
    }
    return all_ok;
}

fn emit_arith_bin_err(
    alloc: *mut AllocCap,
    diags: *mut diag.DiagBag,
    sp: span.Span,
    msg_buf: *str.StrBuf,
    note_buf: *mut str.StrBuf,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    li: *Interval,
    ri: *Interval,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    interner: *span.SymInterner,
    help: *str,
) -> !OutOfMemory {
    note_buf.clear();
    try note_buf.push_str_grow(alloc, "known: ");
    try push_val_name(alloc, lhs, eir_prog, fn_id, interner, note_buf);
    try note_buf.push_str_grow(alloc, " in ");
    try push_interval_str(alloc, li, note_buf);
    try note_buf.push_str_grow(alloc, ", ");
    try push_val_name(alloc, rhs, eir_prog, fn_id, interner, note_buf);
    try note_buf.push_str_grow(alloc, " in ");
    try push_interval_str(alloc, ri, note_buf);
    let didx = try diags.emit_error_bytes(alloc, diag.E0108, sp, msg_buf.as_bytes());
    try emit_note_buf(diags, alloc, didx, note_buf);
    try diags.add_help(alloc, didx, help);
    return;
}

fn check_add_safe(st: *DbmState, lk: VarKey, rk: VarKey, li: *Interval, ri: *Interval, tb: *types.IntBounds) -> bool {
    if li.has_lo && li.has_hi && ri.has_lo && ri.has_hi {
        if let slo = types.int_val_checked_add(li.lo, ri.lo) {
            if let shi = types.int_val_checked_add(li.hi, ri.hi) {
                if iv_ge(slo, tb.min) && iv_le(shi, tb.max) {
                    return true;
                }
            }
        }
    }
    var lo_ok = false;
    if li.has_lo && ri.has_lo {
        if let s = types.int_val_checked_add(li.lo, ri.lo) {
            if iv_ge(s, tb.min) {
                lo_ok = true;
            }
        }
    }
    if lo_ok {
        let des = st.aux.diff_exprs.as_slice();
        var di: usize = 0_usize;
        while di < des.len {
            let de = des[di];
            var has_other = false;
            var other = VK_NONE;
            if de.no_wrap {
                if de.b == lk {
                    has_other = true;
                    other = rk;
                } else if de.b == rk {
                    has_other = true;
                    other = lk;
                }
            }
            if has_other {
                let cb = dbm_diff_upper(st, other, de.key);
                let miv = dbm_get_interval(st, de.a);
                if cb.has_val && miv.has_hi {
                    if let hi = types.int_val_checked_add(miv.hi, cb.val) {
                        if iv_le(hi, tb.max) {
                            return true;
                        }
                    }
                }
            }
            di = di +% 1_usize;
        }
    }
    return false;
}

fn check_sub_safe(st: *DbmState, lk: VarKey, rk: VarKey, li: *Interval, ri: *Interval, tb: *types.IntBounds) -> bool {
    let dbm_hi = dbm_diff_upper(st, lk, rk);
    let dbm_lo_raw = dbm_diff_upper(st, rk, lk);
    var has_dbm_lo = false;
    var dbm_lo = types.int_val_zero();
    if dbm_lo_raw.has_val {
        if let nl = types.int_val_checked_neg(dbm_lo_raw.val) {
            has_dbm_lo = true;
            dbm_lo = nl;
        }
    }
    var has_iv_lo = false;
    var iv_lo = types.int_val_zero();
    if li.has_lo && ri.has_hi {
        if let d = types.int_val_checked_sub(li.lo, ri.hi) {
            has_iv_lo = true;
            iv_lo = d;
        }
    }
    var iv_hi = bound_none();
    if li.has_hi && ri.has_lo {
        if let d = types.int_val_checked_sub(li.hi, ri.lo) {
            iv_hi = bound_some(d);
        }
    }
    var has_eff_lo = false;
    var eff_lo = types.int_val_zero();
    if has_iv_lo && has_dbm_lo {
        has_eff_lo = true;
        eff_lo = iv_max(iv_lo, dbm_lo);
    } else if has_iv_lo {
        has_eff_lo = true;
        eff_lo = iv_lo;
    } else if has_dbm_lo {
        has_eff_lo = true;
        eff_lo = dbm_lo;
    }
    let eff_hi = bound_min(iv_hi, dbm_hi);
    let hi_ok = (eff_hi.has_val && iv_le(eff_hi.val, tb.max))
        || (!tb.has_max && ri.has_lo && iv_ge(ri.lo, types.int_val_zero()));
    return has_eff_lo && iv_ge(eff_lo, tb.min) && hi_ok;
}

fn check_mul_safe(li: *Interval, ri: *Interval, tb: *types.IntBounds) -> bool {
    if !(li.has_lo && li.has_hi && ri.has_lo && ri.has_hi) {
        return false;
    }
    let p0 = types.int_val_checked_mul(li.lo, ri.lo) orelse { return false; };
    let p1 = types.int_val_checked_mul(li.lo, ri.hi) orelse { return false; };
    let p2 = types.int_val_checked_mul(li.hi, ri.lo) orelse { return false; };
    let p3 = types.int_val_checked_mul(li.hi, ri.hi) orelse { return false; };
    return iv_ge(p0, tb.min) && iv_le(p0, tb.max)
        && iv_ge(p1, tb.min) && iv_le(p1, tb.max)
        && iv_ge(p2, tb.min) && iv_le(p2, tb.max)
        && iv_ge(p3, tb.min) && iv_le(p3, tb.max);
}

fn verify_binary_arith(
    alloc: *mut AllocCap,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
    sp: span.Span,
    st: *DbmState,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    msg_buf: *mut str.StrBuf,
    note_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let tb = ty_bounds(op_ty, env);
    if !tb.valid {
        return true;
    }
    let lk = vk_val(lhs);
    let rk = vk_val(rhs);
    let li = dbm_get_interval(st, lk);
    let ri = dbm_get_interval(st, rk);

    match op {
        .Add => {
            if check_add_safe(st, lk, rk, &li, &ri, &tb) {
                return true;
            }
            msg_buf.clear();
            try msg_buf.push_str_grow(alloc, "ZM-08: cannot prove `+` does not overflow `");
            try env.format_ty_short(alloc, op_ty, interner, msg_buf);
            try msg_buf.push_byte_grow(alloc, b'`');
            try emit_arith_bin_err(
                alloc, diags, sp, msg_buf, note_buf, lhs, rhs, &li, &ri, eir_prog, fn_id, interner,
                "use checked `+?`, wrapping `+%`, or saturating `+|`, or constrain operands via `if`/`where`",
            );
            return false;
        }
        .Sub => {
            if check_sub_safe(st, lk, rk, &li, &ri, &tb) {
                return true;
            }
            msg_buf.clear();
            try msg_buf.push_str_grow(alloc, "ZM-08: cannot prove `-` does not overflow/underflow `");
            try env.format_ty_short(alloc, op_ty, interner, msg_buf);
            try msg_buf.push_byte_grow(alloc, b'`');
            let sub_help: *str = if !env.is_signed_integer(op_ty) {
                "unsigned subtraction may underflow below 0: guard `if lhs >= rhs { ... }`, or use `-?` / `-%` / `-|`"
            } else {
                "use checked `-?`, wrapping `-%`, or saturating `-|`, or prove `lhs >= rhs`"
            };
            try emit_arith_bin_err(
                alloc, diags, sp, msg_buf, note_buf, lhs, rhs, &li, &ri, eir_prog, fn_id, interner,
                sub_help,
            );
            return false;
        }
        .Mul => {
            if check_mul_safe(&li, &ri, &tb) {
                return true;
            }
            msg_buf.clear();
            try msg_buf.push_str_grow(alloc, "ZM-08: cannot prove `*` does not overflow `");
            try env.format_ty_short(alloc, op_ty, interner, msg_buf);
            try msg_buf.push_byte_grow(alloc, b'`');
            try emit_arith_bin_err(
                alloc, diags, sp, msg_buf, note_buf, lhs, rhs, &li, &ri, eir_prog, fn_id, interner,
                "use checked `*?`, wrapping `*%`, or saturating `*|`",
            );
            return false;
        }
        .Div => {
            return try verify_div_mod_arith(
                alloc, lhs, rhs, op_ty, sp, st, &li, &ri, &tb, eir_prog, fn_id, env, interner, diags, msg_buf, note_buf,
            );
        }
        .Mod => {
            return try verify_div_mod_arith(
                alloc, lhs, rhs, op_ty, sp, st, &li, &ri, &tb, eir_prog, fn_id, env, interner, diags, msg_buf, note_buf,
            );
        }
        .Shl => {
            return try verify_shift_arith(
                alloc, rhs, op_ty, sp, &ri, eir_prog, fn_id, env, interner, diags, msg_buf, note_buf,
            );
        }
        .Shr => {
            return try verify_shift_arith(
                alloc, rhs, op_ty, sp, &ri, eir_prog, fn_id, env, interner, diags, msg_buf, note_buf,
            );
        }
        _ => { return true; }
    }
}

fn verify_div_mod_arith(
    alloc: *mut AllocCap,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
    sp: span.Span,
    st: *DbmState,
    li: *Interval,
    ri: *Interval,
    tb: *types.IntBounds,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    msg_buf: *mut str.StrBuf,
    note_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let nonzero = dbm_is_non_zero(st, vk_val(rhs));
    let neg1 = iv_neg_one();
    let min_div_neg1 = env.is_signed_integer(op_ty)
        && (!li.has_lo || iv_le(li.lo, tb.min))
        && (!ri.has_lo || iv_le(ri.lo, neg1))
        && (!ri.has_hi || iv_ge(ri.hi, neg1));
    if nonzero && !min_div_neg1 {
        return true;
    }
    msg_buf.clear();
    if !nonzero {
        try msg_buf.push_str_grow(alloc, "ZM-08: cannot prove divisor is non-zero for `");
        try env.format_ty_short(alloc, op_ty, interner, msg_buf);
        try msg_buf.push_byte_grow(alloc, b'`');
    } else {
        try msg_buf.push_str_grow(alloc, "ZM-08: cannot prove signed division does not overflow `");
        try env.format_ty_short(alloc, op_ty, interner, msg_buf);
        try msg_buf.push_str_grow(alloc, ".MIN / -1`");
    }
    try emit_arith_bin_err(
        alloc, diags, sp, msg_buf, note_buf, lhs, rhs, li, ri, eir_prog, fn_id, interner,
        "add a check `if d == 0 { return .DivByZero; }` or use `/?` / `%?`",
    );
    return false;
}

fn verify_shift_arith(
    alloc: *mut AllocCap,
    rhs: eir.EirValue,
    op_ty: types.TyId,
    sp: span.Span,
    ri: *Interval,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    msg_buf: *mut str.StrBuf,
    note_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    let bw = int_bitwidth(env.get(op_ty));
    let bw_iv = types.int_val_from_u64(bw.widen.[u64]());
    if ri.has_lo && !types.int_val_is_neg(ri.lo) && ri.has_hi && iv_lt(ri.hi, bw_iv) {
        return true;
    }
    msg_buf.clear();
    try msg_buf.push_str_grow(alloc, "ZM-08: cannot prove shift count is in `0..");
    try msg_buf.push_u64_grow(alloc, bw.widen.[u64]());
    try msg_buf.push_str_grow(alloc, "` for `");
    try env.format_ty_short(alloc, op_ty, interner, msg_buf);
    try msg_buf.push_byte_grow(alloc, b'`');
    note_buf.clear();
    try note_buf.push_str_grow(alloc, "known: shift ");
    try push_val_name(alloc, rhs, eir_prog, fn_id, interner, note_buf);
    try note_buf.push_str_grow(alloc, " in ");
    try push_interval_str(alloc, ri, note_buf);
    let didx = try diags.emit_error_bytes(alloc, diag.E0108, sp, msg_buf.as_bytes());
    try emit_note_buf(diags, alloc, didx, note_buf);
    try diags.add_help(alloc, didx, "mask the shift count, constrain it with `if`/`where`, or use `<<%`");
    return false;
}

fn verify_slice_inst(
    alloc: *mut AllocCap,
    bb: cfg_ir.BlockId,
    ii: u32,
    inst: *eir.EirInst,
    st: *DbmState,
    spool: *mut StatePool,
    tmp_st: *mut DbmState,
    env: *types.TypeEnv,
    diags: *mut diag.DiagBag,
    proven_safe: *mut col.DynBuf[eir.EirProvenSafeInst],
    stats: *mut FnVerifyInfo,
    note_buf: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    stats.total_checks = stats.total_checks +% 1_usize;
    let len_k = vk_len_val(inst.v0);
    _ = spool;
    try dbm_copy_state(alloc, st, tmp_st);
    try init_len_for_key(tmp_st, alloc, len_k, inst.ty1, env);

    let has_lo = inst.v1 != eir.EIR_NONE;
    let has_hi = inst.v2 != eir.EIR_NONE;
    let z_b = bound_some(types.int_val_zero());
    var lo_ok = true;
    if has_lo {
        let liv = dbm_get_interval(tmp_st, vk_val(inst.v1));
        lo_ok = liv.has_lo && !types.int_val_is_neg(liv.lo);
    }
    var hi_ok = true;
    if has_hi {
        let hi_diff = dbm_diff_upper(tmp_st, vk_val(inst.v2), len_k);
        hi_ok = bound_le(&hi_diff, &z_b);
    }
    var order_ok = true;
    if has_lo && has_hi {
        let od = dbm_diff_upper(tmp_st, vk_val(inst.v1), vk_val(inst.v2));
        order_ok = bound_le(&od, &z_b);
    } else if has_lo && !has_hi {
        let od = dbm_diff_upper(tmp_st, vk_val(inst.v1), len_k);
        order_ok = bound_le(&od, &z_b);
    } else if !has_lo && has_hi {
        let hiv = dbm_get_interval(tmp_st, vk_val(inst.v2));
        order_ok = hiv.has_lo && !types.int_val_is_neg(hiv.lo);
    }
    if lo_ok && hi_ok && order_ok {
        stats.proven_checks = stats.proven_checks +% 1_usize;
        try proven_safe.push(alloc, eir.EirProvenSafeInst.{ bb: bb, inst_idx: ii });
        return true;
    }
    let didx = try diags.emit_error(
        alloc,
        diag.E0107,
        inst.span,
        "ZM-07: cannot prove slice bounds `0 <= lo <= hi <= len`",
    );
    note_buf.clear();
    let len_iv = dbm_get_interval(tmp_st, len_k);
    try note_buf.push_str_grow(alloc, "known: len in ");
    try push_interval_str(alloc, &len_iv, note_buf);
    try note_buf.push_str_grow(alloc, ", lo in ");
    if has_lo {
        let lo_iv = dbm_get_interval(tmp_st, vk_val(inst.v1));
        try push_interval_str(alloc, &lo_iv, note_buf);
    } else {
        try note_buf.push_str_grow(alloc, "[0..=0]");
    }
    try note_buf.push_str_grow(alloc, ", hi in ");
    if has_hi {
        let hi_iv = dbm_get_interval(tmp_st, vk_val(inst.v2));
        try push_interval_str(alloc, &hi_iv, note_buf);
    } else {
        try note_buf.push_str_grow(alloc, "len");
    }
    try emit_note_buf(diags, alloc, didx, note_buf);
    try diags.add_help(alloc, didx, "add a bounds check, strengthen `where`, or use `try buf.sub(lo, hi)`");
    return false;
}

fn verify_call_where(
    alloc: *mut AllocCap,
    inst: *eir.EirInst,
    st: *DbmState,
    spool: *mut StatePool,
    tmp_st: *mut DbmState,
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    stats: *mut FnVerifyInfo,
    sym_scratch: *mut col.DynBuf[SymEnvEntry],
    note_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    let cd = eir_prog.get_call(inst.aux0) orelse {
        return;
    };
    let ck = callee_to_fn_key(cd.callee) orelse {
        return;
    };
    let cid = eir_prog.find_fn_by_key(ck) orelse {
        return;
    };
    let wcs = eir_prog.fn_where_clauses(cid);
    if wcs.len == 0_usize {
        return;
    }
    sym_scratch.clear();
    let pnames = eir_prog.fn_param_names(cid);
    let args = eir_prog.vals_slice(cd.args);
    var pi: usize = 0_usize;
    while pi < pnames.len && pi < args.len {
        let av = args[pi];
        try sym_env_put(
            sym_scratch,
            alloc,
            SymEnvEntry.{
                sym: pnames[pi],
                val_key: vk_val(av),
                has_len_key: true,
                len_key: vk_len_val(av),
            },
            true,
        );
        pi = pi +% 1_usize;
    }
    let st_snap = try spool.save(alloc, st);
    var wi: usize = 0_usize;
    while wi < wcs.len {
        stats.total_checks = stats.total_checks +% 1_usize;
        let verdict = try check_contract_expr(
            alloc, spool, &st_snap, tmp_st, arena, wcs[wi],
            sym_scratch.as_slice(), false, VK_NONE, interner,
        );
        if verdict == .Proven {
            stats.proven_checks = stats.proven_checks +% 1_usize;
        } else {
            let msg: *str = if verdict == .Disproven {
                "callee `where` precondition is definitely violated at call site"
            } else {
                "cannot prove callee `where` precondition at call site"
            };
            let didx = try diags.emit_error(
                alloc,
                diag.E0107,
                inst.span,
                msg,
            );
            note_buf.clear();
            try push_state_summary(alloc, st, eir_prog, fn_id, interner, note_buf);
            try emit_note_buf(diags, alloc, didx, note_buf);
            try diags.add_help(
                alloc,
                didx,
                "add a runtime check or propagate the precondition to the caller's `where` clause",
            );
        }
        wi = wi +% 1_usize;
    }
    return;
}

struct ProvenInstFlag {
    global_inst_idx: u32;
    flags: u8;
}

fn build_value_fact(
    st: *DbmState,
    k: VarKey,
    ty: types.TyId,
    env: *types.TypeEnv,
) -> eir.EirValueFact {
    if st.core.is_bottom {
        return eir.value_fact_unknown();
    }
    let tn = env.get(ty);
    let is_int = env.is_integer(ty);
    let is_bool = tn.kind == .Bool;
    if !is_int && !is_bool {
        return eir.value_fact_unknown();
    }

    var iv = dbm_get_interval(st, k);
    if is_int {
        let tb = ty_bounds(ty, env);
        if tb.valid {
            let tb_iv = tb_to_interval(tb);
            iv = interval_intersect(&iv, &tb_iv);
        }
    } else {
        let b_iv = interval_range(types.int_val_zero(), iv_one());
        iv = interval_intersect(&iv, &b_iv);
    }

    let bw = if is_int { int_bitwidth(tn) } else { 1_u32 };
    var kb_nonzero = false;
    if let kb = st.get_known_bits(k) {
        if bw > 0_u32 {
            if let kb_iv = kb_to_nonneg_interval(&kb, bw) {
                let narrowed = interval_intersect(&iv, &kb_iv);
                if !interval_is_empty(&narrowed) {
                    iv = narrowed;
                }
            }
            let ones_masked = u128_and(kb.ones, u128_low_mask(bw));
            if ones_masked.lo != 0_u64 || ones_masked.hi != 0_u64 {
                kb_nonzero = true;
            }
        }
    }

    if interval_is_empty(&iv) {
        return eir.value_fact_unknown();
    }

    var fact = eir.value_fact_unknown();
    let zero = types.int_val_zero();

    if iv.has_lo && iv.has_hi {
        if let lo64 = types.int_val_to_i64(iv.lo) {
            if let hi64 = types.int_val_to_i64(iv.hi) {
                if lo64 <= hi64 {
                    fact.has_range = true;
                    fact.lo_i64 = lo64;
                    fact.hi_i64 = hi64;
                }
            }
        }
    }

    if iv.has_lo && !types.int_val_is_neg(iv.lo) {
        fact.non_neg = true;
    }

    if kb_nonzero
        || dbm_is_non_zero(st, k)
        || (iv.has_lo && iv_gt(iv.lo, zero))
        || (iv.has_hi && iv_lt(iv.hi, zero))
    {
        fact.non_zero = true;
    }

    let u32_max_iv = types.int_val_from_u64(0xFFFFFFFF_u64);
    if iv.has_lo && iv.has_hi && !types.int_val_is_neg(iv.lo) && iv_le(iv.hi, u32_max_iv) {
        fact.fits_u32 = true;
    }

    let i32_min_iv = types.int_val_from_i64((-2147483647_i64) -% 1_i64);
    let i32_max_iv = types.int_val_from_i64(2147483647_i64);
    if iv.has_lo && iv.has_hi && iv_ge(iv.lo, i32_min_iv) && iv_le(iv.hi, i32_max_iv) {
        fact.fits_i32 = true;
    }

    if bw <= 64_u32 && interval_is_const(&iv) {
        if let cu = types.int_val_to_u64(iv.lo) {
            fact.is_const = true;
            fact.const_u64 = cu;
        } else if let cs = types.int_val_to_i64(iv.lo) {
            fact.is_const = true;
            fact.const_u64 = cs.bitcast.[u64]();
        }
    }

    return fact;
}

fn extra_binary_proven_flags(
    st: *DbmState,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
    env: *types.TypeEnv,
) -> u8 {
    let tb = ty_bounds(op_ty, env);
    if !tb.valid {
        return 0_u8;
    }
    let lk = vk_val(lhs);
    let rk = vk_val(rhs);
    let li = dbm_get_interval(st, lk);
    let ri = dbm_get_interval(st, rk);
    match op {
        .AddCheck => {
            return if check_add_safe(st, lk, rk, &li, &ri, &tb) { eir.PROVEN_NO_OVERFLOW } else { 0_u8 };
        }
        .AddSat => {
            return if check_add_safe(st, lk, rk, &li, &ri, &tb) { eir.PROVEN_NO_OVERFLOW } else { 0_u8 };
        }
        .AddWrap => {
            return if check_add_safe(st, lk, rk, &li, &ri, &tb) { eir.PROVEN_NO_OVERFLOW } else { 0_u8 };
        }
        .SubCheck => {
            return if check_sub_safe(st, lk, rk, &li, &ri, &tb) { eir.PROVEN_NO_OVERFLOW } else { 0_u8 };
        }
        .SubSat => {
            return if check_sub_safe(st, lk, rk, &li, &ri, &tb) { eir.PROVEN_NO_OVERFLOW } else { 0_u8 };
        }
        .SubWrap => {
            return if check_sub_safe(st, lk, rk, &li, &ri, &tb) { eir.PROVEN_NO_OVERFLOW } else { 0_u8 };
        }
        .MulCheck => {
            return if check_mul_safe(&li, &ri, &tb) { eir.PROVEN_NO_OVERFLOW } else { 0_u8 };
        }
        .MulSat => {
            return if check_mul_safe(&li, &ri, &tb) { eir.PROVEN_NO_OVERFLOW } else { 0_u8 };
        }
        .MulWrap => {
            return if check_mul_safe(&li, &ri, &tb) { eir.PROVEN_NO_OVERFLOW } else { 0_u8 };
        }
        .DivCheck => {
            let nonzero = dbm_is_non_zero(st, rk);
            if !nonzero {
                return 0_u8;
            }
            let neg1 = iv_neg_one();
            let min_div_neg1 = env.is_signed_integer(op_ty)
                && (!li.has_lo || iv_le(li.lo, tb.min))
                && (!ri.has_lo || iv_le(ri.lo, neg1))
                && (!ri.has_hi || iv_ge(ri.hi, neg1));
            if !min_div_neg1 {
                return eir.PROVEN_NONZERO_DIV | eir.PROVEN_NO_OVERFLOW;
            }
            return eir.PROVEN_NONZERO_DIV;
        }
        .ModCheck => {
            let nonzero = dbm_is_non_zero(st, rk);
            if !nonzero {
                return 0_u8;
            }
            let neg1 = iv_neg_one();
            let min_div_neg1 = env.is_signed_integer(op_ty)
                && (!li.has_lo || iv_le(li.lo, tb.min))
                && (!ri.has_lo || iv_le(ri.lo, neg1))
                && (!ri.has_hi || iv_ge(ri.hi, neg1));
            if !min_div_neg1 {
                return eir.PROVEN_NONZERO_DIV | eir.PROVEN_NO_OVERFLOW;
            }
            return eir.PROVEN_NONZERO_DIV;
        }
        _ => { return 0_u8; }
    }
}

fn check_binary_narrow_u32(
    st: *DbmState,
    op: ast.BinaryOp,
    lhs: eir.EirValue,
    rhs: eir.EirValue,
    op_ty: types.TyId,
    env: *types.TypeEnv,
) -> bool {
    if !env.is_integer(op_ty) {
        return false;
    }
    let bw = int_bitwidth(env.get(op_ty));
    if bw != 64_u32 {
        return false;
    }
    let is_signed = env.is_signed_integer(op_ty);
    let max_val = if is_signed {
        types.int_val_from_u64(0x7FFFFFFF_u64)
    } else {
        types.int_val_from_u64(0xFFFFFFFF_u64)
    };
    let tb_narrow = types.IntBounds.{
        valid: true,
        has_max: true,
        min: types.int_val_zero(),
        max: max_val,
    };

    let lk = vk_val(lhs);
    let rk = vk_val(rhs);
    let li = dbm_get_interval(st, lk);
    let ri = dbm_get_interval(st, rk);
    if !(li.has_lo && li.has_hi && !types.int_val_is_neg(li.lo) && iv_le(li.hi, max_val)) {
        return false;
    }
    if !(ri.has_lo && ri.has_hi && !types.int_val_is_neg(ri.lo) && iv_le(ri.hi, max_val)) {
        return false;
    }

    match op {
        .Add => { return check_add_safe(st, lk, rk, &li, &ri, &tb_narrow); }
        .AddWrap => { return check_add_safe(st, lk, rk, &li, &ri, &tb_narrow); }
        .AddCheck => { return check_add_safe(st, lk, rk, &li, &ri, &tb_narrow); }
        .AddSat => { return check_add_safe(st, lk, rk, &li, &ri, &tb_narrow); }
        .Sub => { return check_sub_safe(st, lk, rk, &li, &ri, &tb_narrow); }
        .SubWrap => { return check_sub_safe(st, lk, rk, &li, &ri, &tb_narrow); }
        .SubCheck => { return check_sub_safe(st, lk, rk, &li, &ri, &tb_narrow); }
        .SubSat => { return check_sub_safe(st, lk, rk, &li, &ri, &tb_narrow); }
        .Mul => { return check_mul_safe(&li, &ri, &tb_narrow); }
        .MulWrap => { return check_mul_safe(&li, &ri, &tb_narrow); }
        .MulCheck => { return check_mul_safe(&li, &ri, &tb_narrow); }
        .MulSat => { return check_mul_safe(&li, &ri, &tb_narrow); }
        .Div => { return dbm_is_non_zero(st, rk); }
        .DivCheck => { return dbm_is_non_zero(st, rk); }
        .Mod => { return dbm_is_non_zero(st, rk); }
        .ModCheck => { return dbm_is_non_zero(st, rk); }
        .Shr => {
            return iv_lt(ri.hi, types.int_val_from_u64(32_u64));
        }
        .Shl => {
            if !iv_lt(ri.hi, types.int_val_from_u64(32_u64)) {
                return false;
            }
            if let sh_u = types.int_val_to_u64(ri.hi) {
                if let shifted = iv_checked_shl(li.hi, sh_u.trunc.[u32]()) {
                    return iv_le(shifted, max_val);
                }
            }
            return false;
        }
        .BitAnd => { return true; }
        .BitOr => { return true; }
        .BitXor => { return true; }
        .Eq => { return true; }
        .NotEq => { return true; }
        .Lt => { return true; }
        .LtEq => { return true; }
        .Gt => { return true; }
        .GtEq => { return true; }
        _ => { return false; }
    }
}

fn verify_inst(
    alloc: *mut AllocCap,
    bb: cfg_ir.BlockId,
    ii: u32,
    global_inst_idx: u32,
    inst: *eir.EirInst,
    st: *DbmState,
    spool: *mut StatePool,
    tmp_st: *mut DbmState,
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    proven_safe: *mut col.DynBuf[eir.EirProvenSafeInst],
    out_inst_flags: *mut col.DynBuf[ProvenInstFlag],
    stats: *mut FnVerifyInfo,
    sym_scratch: *mut col.DynBuf[SymEnvEntry],
    msg_buf: *mut str.StrBuf,
    note_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    var flags: u8 = 0_u8;
    match inst.kind {
        .LoadPlace => {
            if let place = eir_prog.get_place(inst.aux0) {
                if try verify_place_bounds(
                    alloc, place, inst.span, st, eir_prog, fn_id, env, interner, diags, stats, msg_buf, note_buf,
                ) {
                    try proven_safe.push(alloc, eir.EirProvenSafeInst.{ bb: bb, inst_idx: ii });
                    flags = flags | eir.PROVEN_BOUNDS_SAFE;
                }
            }
        }
        .StorePlace => {
            if let place = eir_prog.get_place(inst.aux0) {
                if try verify_place_bounds(
                    alloc, place, inst.span, st, eir_prog, fn_id, env, interner, diags, stats, msg_buf, note_buf,
                ) {
                    try proven_safe.push(alloc, eir.EirProvenSafeInst.{ bb: bb, inst_idx: ii });
                    flags = flags | eir.PROVEN_BOUNDS_SAFE;
                }
            }
        }
        .PlaceAddr => {
            if let place = eir_prog.get_place(inst.aux0) {
                if try verify_place_bounds(
                    alloc, place, inst.span, st, eir_prog, fn_id, env, interner, diags, stats, msg_buf, note_buf,
                ) {
                    try proven_safe.push(alloc, eir.EirProvenSafeInst.{ bb: bb, inst_idx: ii });
                    flags = flags | eir.PROVEN_BOUNDS_SAFE;
                }
            }
        }
        .PoolColumnLoad => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                let idx_tn = env.get(eir_prog.fn_val_ty(fn_id, op.index));
                if idx_tn.kind == .Builtin
                    && (idx_tn.builtin_kind == .IdBrand
                        || idx_tn.builtin_kind == .GenId
                        || idx_tn.builtin_kind == .Link)
                {
                    flags = flags | eir.PROVEN_BOUNDS_SAFE;
                }
            }
        }
        .PoolColumnStore => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                let idx_tn = env.get(eir_prog.fn_val_ty(fn_id, op.index));
                if idx_tn.kind == .Builtin
                    && (idx_tn.builtin_kind == .IdBrand
                        || idx_tn.builtin_kind == .GenId
                        || idx_tn.builtin_kind == .Link)
                {
                    flags = flags | eir.PROVEN_BOUNDS_SAFE;
                }
            }
        }
        .Slice => {
            if try verify_slice_inst(
                alloc, bb, ii, inst, st, spool, tmp_st, env, diags, proven_safe, stats, note_buf,
            ) {
                flags = flags | eir.PROVEN_BOUNDS_SAFE;
            }
        }
        .Unary => {
            if inst.unary_op == .Neg && env.is_signed_integer(inst.ty0) {
                let tb = ty_bounds(inst.ty0, env);
                if tb.valid {
                    stats.total_checks = stats.total_checks +% 1_usize;
                    let iv = dbm_get_interval(st, vk_val(inst.v0));
                    if iv.has_lo && iv_gt(iv.lo, tb.min) {
                        stats.proven_checks = stats.proven_checks +% 1_usize;
                        try proven_safe.push(alloc, eir.EirProvenSafeInst.{ bb: bb, inst_idx: ii });
                        flags = flags | eir.PROVEN_NO_OVERFLOW;
                    } else {
                        msg_buf.clear();
                        try msg_buf.push_str_grow(alloc, "ZM-08: cannot prove unary `-` does not overflow `");
                        try env.format_ty_short(alloc, inst.ty0, interner, msg_buf);
                        try msg_buf.push_str_grow(alloc, "` (operand could be MIN)");
                        note_buf.clear();
                        try note_buf.push_str_grow(alloc, "known: ");
                        try push_val_name(alloc, inst.v0, eir_prog, fn_id, interner, note_buf);
                        try note_buf.push_str_grow(alloc, " in ");
                        try push_interval_str(alloc, &iv, note_buf);
                        let didx = try diags.emit_error_bytes(alloc, diag.E0108, inst.span, msg_buf.as_bytes());
                        try emit_note_buf(diags, alloc, didx, note_buf);
                    }
                }
            }
        }
        .Binary => {
            let op = inst.bin_op;
            if env.is_integer(inst.ty1) {
                if op == .Add || op == .Sub || op == .Mul || op == .Div || op == .Mod || op == .Shl || op == .Shr {
                    stats.total_checks = stats.total_checks +% 1_usize;
                    if try verify_binary_arith(
                        alloc, op, inst.v0, inst.v1, inst.ty1, inst.span, st,
                        eir_prog, fn_id, env, interner, diags, msg_buf, note_buf,
                    ) {
                        stats.proven_checks = stats.proven_checks +% 1_usize;
                        try proven_safe.push(alloc, eir.EirProvenSafeInst.{ bb: bb, inst_idx: ii });
                        if op == .Div || op == .Mod {
                            flags = flags | eir.PROVEN_NONZERO_DIV | eir.PROVEN_NO_OVERFLOW;
                        } else {
                            flags = flags | eir.PROVEN_NO_OVERFLOW;
                        }
                    }
                } else {
                    flags = flags | extra_binary_proven_flags(st, op, inst.v0, inst.v1, inst.ty1, env);
                }
                if check_binary_narrow_u32(st, op, inst.v0, inst.v1, inst.ty1, env) {
                    flags = flags | eir.PROVEN_NARROW_U32;
                }
            }
        }
        .Call => {
            try verify_call_where(
                alloc, inst, st, spool, tmp_st, arena, eir_prog, fn_id,
                interner, diags, stats, sym_scratch, note_buf,
            );
        }
        _ => {}
    }
    if flags != 0_u8 {
        try out_inst_flags.push(alloc, ProvenInstFlag.{ global_inst_idx: global_inst_idx, flags: flags });
    }
    return;
}

fn is_definitely_err_val(val_in: eir.EirValue, insts: *[eir.EirInst]) -> bool {
    var cur = val_in;
    var depth: usize = 0_usize;
    while depth < 32_usize {
        var found_next = false;
        var i = insts.len;
        while i > 0_usize {
            i = i - 1_usize;
            let inst = insts[i];
            if inst.kind == .Cast && inst.cast_kind == .WrapErr && inst.dst == cur {
                return true;
            }
            if inst.kind == .LoadSlot && inst.dst == cur {
                let target_slot = inst.aux0;
                var j = insts.len;
                while j > 0_usize {
                    j = j - 1_usize;
                    if insts[j].kind == .StoreSlot && insts[j].aux0 == target_slot {
                        cur = insts[j].v0;
                        found_next = true;
                        break;
                    }
                }
                break;
            }
        }
        if !found_next {
            return false;
        }
        depth = depth +% 1_usize;
    }
    return false;
}

fn verify_terminator(
    alloc: *mut AllocCap,
    term: *eir.EirTerm,
    insts: *[eir.EirInst],
    st: *DbmState,
    preds: *PredArena,
    spool: *mut StatePool,
    tmp_st: *mut DbmState,
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    f: *eir.EirFunction,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    stats: *mut FnVerifyInfo,
    sym_scratch: *mut col.DynBuf[SymEnvEntry],
    note_buf: *mut str.StrBuf,
) -> !OutOfMemory {
    if term.kind == .Unreachable && term.flag {
        stats.total_checks = stats.total_checks +% 1_usize;
        let didx = try diags.emit_error(
            alloc,
            diag.E0115,
            term.span,
            "ZM-15: `unreachable;` statement is statically reachable",
        );
        note_buf.clear();
        try push_state_summary(alloc, st, eir_prog, fn_id, interner, note_buf);
        try emit_note_buf(diags, alloc, didx, note_buf);
        return;
    }
    if term.kind == .Return && term.flag {
        let ens = eir_prog.fn_ensures_clauses(fn_id);
        if ens.len > 0_usize {
            let is_err_ret = env.get(f.sig.ret).kind == .ErrorUnion
                && is_definitely_err_val(term.val, insts);
            if !is_err_ret {
                try build_block_sym_env(alloc, eir_prog, fn_id, sym_scratch);
                let st_snap = try spool.save(alloc, st);
                var ei: usize = 0_usize;
                while ei < ens.len {
                    stats.total_checks = stats.total_checks +% 1_usize;
                    let verdict = try check_contract_expr(
                        alloc, spool, &st_snap, tmp_st, arena, ens[ei],
                        sym_scratch.as_slice(), true, vk_val(term.val), interner,
                    );
                    if verdict == .Proven {
                        stats.proven_checks = stats.proven_checks +% 1_usize;
                    } else {
                        var esp = span.span_dummy();
                        if let ex = arena.get_expr(ens[ei]) {
                            esp = ex.span;
                        }
                        let msg: *str = if verdict == .Disproven {
                            "postcondition `ensures` is definitely violated at return"
                        } else {
                            "cannot prove postcondition `ensures` at return"
                        };
                        let didx = try diags.emit_error(
                            alloc,
                            diag.E0108,
                            esp,
                            msg,
                        );
                        note_buf.clear();
                        let ret_iv = dbm_get_interval(st, vk_val(term.val));
                        try note_buf.push_str_grow(alloc, "known: return in ");
                        try push_interval_str(alloc, &ret_iv, note_buf);
                        try emit_note_buf(diags, alloc, didx, note_buf);
                    }
                    ei = ei +% 1_usize;
                }
            }
        }
        return;
    }
    if term.kind == .Branch && term.flag {
        if let pred_id = preds_get(st.aux.preds.as_slice(), term.val) {
            try dbm_copy_state(alloc, st, tmp_st);
            try dbm_refine_pred(tmp_st, alloc, preds, spool, pred_id, true);
            let then_bot = tmp_st.core.is_bottom;
            try dbm_copy_state(alloc, st, tmp_st);
            try dbm_refine_pred(tmp_st, alloc, preds, spool, pred_id, false);
            let else_bot = tmp_st.core.is_bottom;
            if then_bot && !else_bot {
                _ = try diags.emit_error(
                    alloc,
                    diag.E0114,
                    term.span,
                    "ZM-14: `if` condition is always false; dead `then` branch (use `comptime if` for conditional compilation)",
                );
            } else if else_bot && !then_bot {
                _ = try diags.emit_error(
                    alloc,
                    diag.E0114,
                    term.span,
                    "ZM-14: `if` condition is always true; dead `else` branch (use `comptime if` for conditional compilation)",
                );
            }
        }
    }
    return;
}

// ===========================================================================
// Section 11: Loop Analysis, Out-Edges, Fixpoint Driver, & `verify_program`
// ===========================================================================

fn inst_def_val(inst: *eir.EirInst) -> eir.EirValue {
    match inst.kind {
        .Const => { return inst.dst; }
        .Copy => { return inst.dst; }
        .LoadSlot => { return inst.dst; }
        .SlotAddr => { return inst.dst; }
        .LoadPlace => { return inst.dst; }
        .PoolColumnLoad => { return inst.dst; }
        .PlaceAddr => { return inst.dst; }
        .Unary => { return inst.dst; }
        .Binary => { return inst.dst; }
        .Cast => { return inst.dst; }
        .Slice => { return inst.dst; }
        .Aggregate => { return inst.dst; }
        .UnwrapOptional => { return inst.dst; }
        .UnwrapErrorOk => { return inst.dst; }
        .UnwrapErrorErr => { return inst.dst; }
        .IsNonNull => { return inst.dst; }
        .IsError => { return inst.dst; }
        .MatchTag => { return inst.dst; }
        .FieldExtract => { return inst.dst; }
        .Call => { return inst.dst; }
        .BuiltinCall => { return inst.dst; }
        _ => { return eir.EIR_NONE; }
    }
}

fn edge_key(from_bb: cfg_ir.BlockId, to_bb: cfg_ir.BlockId) -> u64 {
    return (from_bb.widen.[u64]() <<% 32_u64) | to_bb.widen.[u64]();
}

linear struct LoopInfo {
    is_header: col.DynBuf[bool];
    header_iters: col.DynBuf[usize];
    wkey_ranges: col.DynBuf[ast.IdRange];
    wkey_pool: col.DynBuf[VarKey];
}

impl LoopInfo {
    fn init(alloc: *mut AllocCap, n_blocks: usize) -> LoopInfo ! OutOfMemory {
        let cap = if n_blocks < 4_usize { 4_usize } else { n_blocks };
        var is_header = try col.DynBuf.[bool].init(alloc, cap);
        errdefer is_header.destroy(alloc);
        var header_iters = try col.DynBuf.[usize].init(alloc, cap);
        errdefer header_iters.destroy(alloc);
        var wkey_ranges = try col.DynBuf.[ast.IdRange].init(alloc, cap);
        errdefer wkey_ranges.destroy(alloc);
        let wkey_pool = try col.DynBuf.[VarKey].init(alloc, 32_usize);
        errdefer wkey_pool.destroy(alloc);
        var i: usize = 0_usize;
        while i < n_blocks {
            try is_header.push(alloc, false);
            try header_iters.push(alloc, 0_usize);
            try wkey_ranges.push(alloc, ast.range_empty());
            i = i +% 1_usize;
        }
        return LoopInfo.{
            is_header: is_header,
            header_iters: header_iters,
            wkey_ranges: wkey_ranges,
            wkey_pool: wkey_pool,
        };
    }

    fn destroy(self: LoopInfo, alloc: *mut AllocCap) {
        let LoopInfo.{ is_header, header_iters, wkey_ranges, wkey_pool } = self;
        is_header.destroy(alloc);
        header_iters.destroy(alloc);
        wkey_ranges.destroy(alloc);
        wkey_pool.destroy(alloc);
    }

    fn block_is_header(self: *Self, bi: usize) -> bool {
        let xs = self.is_header.as_slice();
        if bi < xs.len {
            return xs[bi];
        }
        return false;
    }

    view fn header_wkeys(self: *Self, bi: usize) -> *[VarKey] {
        let rs = self.wkey_ranges.as_slice();
        if bi < rs.len {
            return slice_range.[VarKey](self.wkey_pool.as_slice(), rs[bi]);
        }
        return slice_range.[VarKey](self.wkey_pool.as_slice(), ast.range_empty());
    }
}

fn collect_loop_wkeys_for_header(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    n_blocks: usize,
    hdr: cfg_ir.BlockId,
    back_srcs: *[cfg_ir.BlockId],
    out_wkeys: *mut col.DynBuf[VarKey],
) -> !OutOfMemory {
    var in_loop = try col.BitSet.init(alloc, n_blocks);
    errdefer in_loop.destroy(alloc);
    var work = try col.DynBuf.[cfg_ir.BlockId].init(alloc, 16_usize);
    errdefer work.destroy(alloc);
    in_loop.set(hdr.widen.[usize]());
    var si: usize = 0_usize;
    while si < back_srcs.len {
        let s = back_srcs[si];
        let su = s.widen.[usize]();
        if !in_loop.test(su) {
            in_loop.set(su);
            try work.push(alloc, s);
        }
        si = si +% 1_usize;
    }
    loop {
        let cur = work.pop() orelse {
            break;
        };
        let preds = eir_prog.block_preds(fn_id, cur);
        var pi: usize = 0_usize;
        while pi < preds.len {
            let p = preds[pi];
            let pu = p.widen.[usize]();
            if !in_loop.test(pu) {
                in_loop.set(pu);
                try work.push(alloc, p);
            }
            pi = pi +% 1_usize;
        }
    }

    out_wkeys.clear();
    let phis = eir_prog.block_phis(fn_id, hdr);
    var phi_i: usize = 0_usize;
    while phi_i < phis.len {
        let d = phis[phi_i].dst;
        try vk_set_insert(out_wkeys, alloc, vk_val(d));
        try vk_set_insert(out_wkeys, alloc, vk_len_val(d));
        phi_i = phi_i +% 1_usize;
    }
    var bi: usize = 0_usize;
    while bi < n_blocks {
        if in_loop.test(bi) {
            let insts = eir_prog.block_insts(fn_id, bi.trunc.[u32]());
            var ii: usize = 0_usize;
            while ii < insts.len {
                let inst = insts[ii];
                let dv = inst_def_val(&inst);
                if dv != eir.EIR_NONE {
                    try vk_set_insert(out_wkeys, alloc, vk_val(dv));
                    try vk_set_insert(out_wkeys, alloc, vk_len_val(dv));
                }
                if inst.kind == .StoreSlot || (inst.kind == .SlotAddr && inst.flag0) {
                    try vk_set_insert(out_wkeys, alloc, vk_slot(inst.aux0));
                    try vk_set_insert(out_wkeys, alloc, vk_len_slot(inst.aux0));
                } else if inst.kind == .StorePlace {
                    if let place = eir_prog.get_place(inst.aux0) {
                        if let fk = field_key_of_place_static(eir_prog, place) {
                            try vk_set_insert(out_wkeys, alloc, fk);
                            if vk_tag(fk) == VK_TAG_FIELD_SLOT {
                                try vk_set_insert(out_wkeys, alloc, vk_field_len_slot(vk_a(fk), vk_b(fk)));
                            } else if vk_tag(fk) == VK_TAG_FIELD_VAL {
                                try vk_set_insert(out_wkeys, alloc, vk_field_len_val(vk_a(fk), vk_b(fk)));
                            }
                        }
                    }
                } else if inst.kind == .BuiltinCall {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        let aslots = eir_prog.arg_slots_slice(bc.arg_slots);
                        var ai: usize = 0_usize;
                        while ai < aslots.len {
                            if aslots[ai] != eir.EIR_NONE {
                                try vk_set_insert(out_wkeys, alloc, vk_slot(aslots[ai]));
                                try vk_set_insert(out_wkeys, alloc, vk_len_slot(aslots[ai]));
                            }
                            ai = ai +% 1_usize;
                        }
                    }
                }
                ii = ii +% 1_usize;
            }
        }
        bi = bi +% 1_usize;
    }

    work.destroy(alloc);
    in_loop.destroy(alloc);
    return;
}

fn compute_loop_info(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    n_blocks: usize,
) -> LoopInfo ! OutOfMemory {
    var info = try LoopInfo.init(alloc, n_blocks);
    errdefer info.destroy(alloc);

    var back_hdrs = try col.DynBuf.[cfg_ir.BlockId].init(alloc, 8_usize);
    errdefer back_hdrs.destroy(alloc);
    var back_srcs = try col.DynBuf.[cfg_ir.BlockId].init(alloc, 8_usize);
    errdefer back_srcs.destroy(alloc);

    let blks = eir_prog.fn_blocks(fn_id);
    var bi: usize = 0_usize;
    while bi < blks.len {
        let src = bi.trunc.[u32]();
        let term = blks[bi].term;
        let sc = eir_prog.term_successor_count(&term);
        var si: usize = 0_usize;
        while si < sc {
            let succ = eir_prog.term_successor_at(&term, si);
            if succ != eir.EIR_NONE && eir_prog.dominates_block(fn_id, succ, src) {
                let su = succ.widen.[usize]();
                let ih = info.is_header.as_mut_slice();
                if su < ih.len {
                    ih[su] = true;
                }
                try back_hdrs.push(alloc, succ);
                try back_srcs.push(alloc, src);
            }
            si = si +% 1_usize;
        }
        bi = bi +% 1_usize;
    }

    var hdr_srcs = try col.DynBuf.[cfg_ir.BlockId].init(alloc, 8_usize);
    errdefer hdr_srcs.destroy(alloc);
    var wkeys_tmp = try col.DynBuf.[VarKey].init(alloc, 32_usize);
    errdefer wkeys_tmp.destroy(alloc);

    var hi: usize = 0_usize;
    while hi < n_blocks {
        if info.block_is_header(hi) {
            let hdr = hi.trunc.[u32]();
            hdr_srcs.clear();
            let bhs = back_hdrs.as_slice();
            let bss = back_srcs.as_slice();
            var k: usize = 0_usize;
            while k < bhs.len && k < bss.len {
                if bhs[k] == hdr {
                    try hdr_srcs.push(alloc, bss[k]);
                }
                k = k +% 1_usize;
            }
            try collect_loop_wkeys_for_header(
                alloc, eir_prog, fn_id, n_blocks, hdr, hdr_srcs.as_slice(), &mut wkeys_tmp,
            );
            let r = try push_range_vk(alloc, &mut info.wkey_pool, wkeys_tmp.as_slice());
            let wr = info.wkey_ranges.as_mut_slice();
            if hi < wr.len {
                wr[hi] = r;
            }
        }
        hi = hi +% 1_usize;
    }

    wkeys_tmp.destroy(alloc);
    hdr_srcs.destroy(alloc);
    back_srcs.destroy(alloc);
    back_hdrs.destroy(alloc);
    return info;
}

fn mark_rel_val(rel: *mut col.BitSet, v: eir.EirValue, changed: *mut bool) {
    if v == eir.EIR_NONE {
        return;
    }
    let idx = v.widen.[usize]();
    if idx < rel.len() && !rel.test(idx) {
        rel.set(idx);
        changed.* = true;
    }
}

fn mark_rel_slot(rel: *mut col.BitSet, s: eir.EirSlot, changed: *mut bool) {
    let idx = s.widen.[usize]();
    if idx < rel.len() && !rel.test(idx) {
        rel.set(idx);
        changed.* = true;
    }
}

fn bitset_copy_from(alloc: *mut AllocCap, dst: *mut col.BitSet, src: *col.BitSet) -> !OutOfMemory {
    dst.clear();
    let n = src.len();
    var pos: usize = 0_usize;
    while pos < n {
        let bit = src.next_set(pos) orelse {
            break;
        };
        try dst.set_grow(alloc, bit);
        pos = bit +% 1_usize;
    }
    return;
}

fn init_fn_mut_addr_slots(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    work_st: *mut DbmState,
    tmp_st: *mut DbmState,
) -> !OutOfMemory {
    let nslots = eir_prog.fn_slots(fn_id).len;
    if nslots == 0_usize {
        work_st.mut_addr_slots.clear();
        tmp_st.mut_addr_slots.clear();
        return;
    }
    let blks = eir_prog.fn_blocks(fn_id);
    var has_raw_cast = false;
    var bi: usize = 0_usize;
    while bi < blks.len && !has_raw_cast {
        let insts = eir_prog.insts_slice(blks[bi].insts);
        var ki: usize = 0_usize;
        while ki < insts.len {
            let inst = insts[ki];
            if inst.kind == .Cast && env.get(inst.ty0).kind == .RawPtr {
                has_raw_cast = true;
                break;
            }
            ki = ki +% 1_usize;
        }
        bi = bi +% 1_usize;
    }
    var mut_slots = try col.BitSet.init(alloc, nslots);
    errdefer mut_slots.destroy(alloc);
    bi = 0_usize;
    while bi < blks.len {
        let insts = eir_prog.insts_slice(blks[bi].insts);
        var ki: usize = 0_usize;
        while ki < insts.len {
            let inst = insts[ki];
            if inst.kind == .SlotAddr {
                if inst.flag0 || has_raw_cast || env.get(inst.ty0).kind == .RawPtr {
                    let s = inst.aux0.widen.[usize]();
                    if s < nslots {
                        mut_slots.set(s);
                    }
                }
            }
            ki = ki +% 1_usize;
        }
        bi = bi +% 1_usize;
    }
    try bitset_copy_from(alloc, &mut work_st.mut_addr_slots, &mut_slots);
    try bitset_copy_from(alloc, &mut tmp_st.mut_addr_slots, &mut_slots);
    mut_slots.destroy(alloc);
    return;
}

fn init_fn_rel_filter(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    f: *eir.EirFunction,
    nvals: usize,
    work_st: *mut DbmState,
    tmp_st: *mut DbmState,
) -> !OutOfMemory {
    if eir_prog.fn_where_clauses(fn_id).len > 0_usize
        || eir_prog.fn_ensures_clauses(fn_id).len > 0_usize
        || f.loop_invariants.len > 0_u32
    {
        work_st.filter_active = false;
        tmp_st.filter_active = false;
        return;
    }

    let blks = eir_prog.fn_blocks(fn_id);
    let nslots = eir_prog.fn_slots(fn_id).len;
    var is_const = try col.BitSet.init(alloc, nvals);
    errdefer is_const.destroy(alloc);
    var is_mem_or_cast = try col.BitSet.init(alloc, nvals);
    errdefer is_mem_or_cast.destroy(alloc);
    var rel_v = try col.BitSet.init(alloc, nvals);
    errdefer rel_v.destroy(alloc);
    var rel_s = try col.BitSet.init(alloc, nslots);
    errdefer rel_s.destroy(alloc);
    var tmp = try col.DynBuf.[eir.EirValue].init(alloc, 8_usize);
    errdefer tmp.destroy(alloc);

    var has_explicit_unreach = false;
    var has_place_op = false;
    var bi: usize = 0_usize;
    while bi < blks.len {
        let blk = blks[bi];
        if blk.term.kind == .Unreachable && blk.term.flag {
            has_explicit_unreach = true;
            break;
        }
        let phis = eir_prog.phis_slice(blk.phis);
        var pi0: usize = 0_usize;
        while pi0 < phis.len {
            let pdi = phis[pi0].dst.widen.[usize]();
            if pdi < nvals {
                is_mem_or_cast.set(pdi);
            }
            pi0 = pi0 +% 1_usize;
        }
        let insts = eir_prog.insts_slice(blk.insts);
        var ki: usize = 0_usize;
        while ki < insts.len {
            let inst = insts[ki];
            let di = inst.dst.widen.[usize]();
            if inst.kind == .Const {
                if di < nvals {
                    is_const.set(di);
                }
            } else if inst.kind == .LoadSlot || inst.kind == .LoadPlace || inst.kind == .FieldExtract
                || inst.kind == .Cast || inst.kind == .Copy || inst.kind == .UnwrapOptional
                || inst.kind == .UnwrapErrorOk
            {
                if di < nvals {
                    is_mem_or_cast.set(di);
                }
                if inst.kind == .LoadPlace {
                    has_place_op = true;
                }
            } else if inst.kind == .StorePlace || inst.kind == .PlaceAddr {
                has_place_op = true;
            }
            ki = ki +% 1_usize;
        }
        bi = bi +% 1_usize;
    }

    if has_explicit_unreach {
        tmp.destroy(alloc);
        rel_s.destroy(alloc);
        rel_v.destroy(alloc);
        is_mem_or_cast.destroy(alloc);
        is_const.destroy(alloc);
        work_st.filter_active = false;
        tmp_st.filter_active = false;
        return;
    }

    // Seed relational values from checks, 2-var comparisons, field/slot comparisons, indexing, and contracts.
    var dummy = false;
    bi = 0_usize;
    while bi < blks.len {
        let blk = blks[bi];
        let insts = eir_prog.insts_slice(blk.insts);
        var ki: usize = 0_usize;
        while ki < insts.len {
            let inst = insts[ki];
            var seed_all_uses = false;
            match inst.kind {
                .Binary => {
                    match inst.bin_op {
                        .Add => { seed_all_uses = true; mark_rel_val(&mut rel_v, inst.dst, &mut dummy); }
                        .Sub => { seed_all_uses = true; mark_rel_val(&mut rel_v, inst.dst, &mut dummy); }
                        .Mul => { seed_all_uses = true; mark_rel_val(&mut rel_v, inst.dst, &mut dummy); }
                        .Div => { seed_all_uses = true; mark_rel_val(&mut rel_v, inst.dst, &mut dummy); }
                        .Mod => { seed_all_uses = true; mark_rel_val(&mut rel_v, inst.dst, &mut dummy); }
                        .Shl => {
                            if !is_const.test(inst.v1.widen.[usize]()) {
                                seed_all_uses = true;
                                mark_rel_val(&mut rel_v, inst.dst, &mut dummy);
                            }
                        }
                        .Shr => {
                            if !is_const.test(inst.v1.widen.[usize]()) {
                                seed_all_uses = true;
                                mark_rel_val(&mut rel_v, inst.dst, &mut dummy);
                            }
                        }
                        .Lt => {
                            let u0 = inst.v0.widen.[usize]();
                            let u1 = inst.v1.widen.[usize]();
                            if (!is_const.test(u0) && !is_const.test(u1)) || is_mem_or_cast.test(u0) || is_mem_or_cast.test(u1) {
                                seed_all_uses = true;
                            }
                        }
                        .LtEq => {
                            let u0 = inst.v0.widen.[usize]();
                            let u1 = inst.v1.widen.[usize]();
                            if (!is_const.test(u0) && !is_const.test(u1)) || is_mem_or_cast.test(u0) || is_mem_or_cast.test(u1) {
                                seed_all_uses = true;
                            }
                        }
                        .Gt => {
                            let u0 = inst.v0.widen.[usize]();
                            let u1 = inst.v1.widen.[usize]();
                            if (!is_const.test(u0) && !is_const.test(u1)) || is_mem_or_cast.test(u0) || is_mem_or_cast.test(u1) {
                                seed_all_uses = true;
                            }
                        }
                        .GtEq => {
                            let u0 = inst.v0.widen.[usize]();
                            let u1 = inst.v1.widen.[usize]();
                            if (!is_const.test(u0) && !is_const.test(u1)) || is_mem_or_cast.test(u0) || is_mem_or_cast.test(u1) {
                                seed_all_uses = true;
                            }
                        }
                        .Eq => {
                            let u0 = inst.v0.widen.[usize]();
                            let u1 = inst.v1.widen.[usize]();
                            if (!is_const.test(u0) && !is_const.test(u1)) || is_mem_or_cast.test(u0) || is_mem_or_cast.test(u1) {
                                seed_all_uses = true;
                            }
                        }
                        .NotEq => {
                            let u0 = inst.v0.widen.[usize]();
                            let u1 = inst.v1.widen.[usize]();
                            if (!is_const.test(u0) && !is_const.test(u1)) || is_mem_or_cast.test(u0) || is_mem_or_cast.test(u1) {
                                seed_all_uses = true;
                            }
                        }
                        _ => {}
                    }
                }
                .Unary => {
                    if inst.unary_op == .Neg {
                        seed_all_uses = true;
                        mark_rel_val(&mut rel_v, inst.dst, &mut dummy);
                    }
                }
                .Slice => { seed_all_uses = true; mark_rel_val(&mut rel_v, inst.dst, &mut dummy); }
                .PoolColumnLoad => { seed_all_uses = true; mark_rel_val(&mut rel_v, inst.dst, &mut dummy); }
                .PoolColumnStore => { seed_all_uses = true; }
                .BuiltinCall => { seed_all_uses = true; mark_rel_val(&mut rel_v, inst.dst, &mut dummy); }
                .LoadPlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        let projs = eir_prog.projs_slice(pl.projs);
                        var pji: usize = 0_usize;
                        while pji < projs.len {
                            if projs[pji].kind == .Index {
                                seed_all_uses = true;
                                mark_rel_val(&mut rel_v, inst.dst, &mut dummy);
                                break;
                            }
                            pji = pji +% 1_usize;
                        }
                    }
                }
                .StorePlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        let projs = eir_prog.projs_slice(pl.projs);
                        var pji: usize = 0_usize;
                        while pji < projs.len {
                            if projs[pji].kind == .Index {
                                seed_all_uses = true;
                                break;
                            }
                            pji = pji +% 1_usize;
                        }
                    }
                }
                .PlaceAddr => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        let projs = eir_prog.projs_slice(pl.projs);
                        var pji: usize = 0_usize;
                        while pji < projs.len {
                            if projs[pji].kind == .Index {
                                seed_all_uses = true;
                                break;
                            }
                            pji = pji +% 1_usize;
                        }
                    }
                }
                .Call => {
                    if let cd = eir_prog.get_call(inst.aux0) {
                        var need_call = true;
                        if let ckey = callee_to_fn_key(cd.callee) {
                            if let cfid = eir_prog.find_fn_by_key(ckey) {
                                need_call = eir_prog.fn_where_clauses(cfid).len > 0_usize;
                            }
                        }
                        if need_call {
                            seed_all_uses = true;
                        }
                    }
                }
                .SlotAddr => {
                    if has_place_op {
                        mark_rel_slot(&mut rel_s, inst.aux0, &mut dummy);
                    }
                }
                _ => {}
            }
            if seed_all_uses {
                try eir.collect_inst_uses(alloc, eir_prog, &inst, &mut tmp);
                let ts = tmp.as_slice();
                var ti: usize = 0_usize;
                while ti < ts.len {
                    mark_rel_val(&mut rel_v, ts[ti], &mut dummy);
                    ti = ti +% 1_usize;
                }
            }
            ki = ki +% 1_usize;
        }
        bi = bi +% 1_usize;
    }

    // Backward closure over SSA defs, phis, and slots (typically 1-2 passes).
    var changed = true;
    var iter: usize = 0_usize;
    while changed && iter < 8_usize {
        changed = false;
        bi = blks.len;
        while bi > 0_usize && bi <= blks.len {
            bi = bi - 1_usize;
            let blk = blks[bi];
            let insts = eir_prog.insts_slice(blk.insts);
            var ki = insts.len;
            while ki > 0_usize && ki <= insts.len {
                ki = ki - 1_usize;
                let inst = insts[ki];
                var prop = inst.dst != eir.EIR_NONE && rel_v.test(inst.dst.widen.[usize]());
                if !prop && inst.kind == .StoreSlot && rel_s.test(inst.aux0.widen.[usize]()) {
                    prop = true;
                } else if !prop && inst.kind == .StorePlace {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot && rel_s.test(pl.base.id.widen.[usize]()) {
                            prop = true;
                        }
                    }
                }
                if prop {
                    if inst.kind == .LoadSlot {
                        mark_rel_slot(&mut rel_s, inst.aux0, &mut changed);
                    } else if inst.kind == .LoadPlace {
                        if let pl = eir_prog.get_place(inst.aux0) {
                            if pl.base.kind == .Slot {
                                mark_rel_slot(&mut rel_s, pl.base.id, &mut changed);
                            }
                        }
                    }
                    try eir.collect_inst_uses(alloc, eir_prog, &inst, &mut tmp);
                    let ts = tmp.as_slice();
                    var ti: usize = 0_usize;
                    while ti < ts.len {
                        mark_rel_val(&mut rel_v, ts[ti], &mut changed);
                        ti = ti +% 1_usize;
                    }
                }
            }
            let phis = eir_prog.phis_slice(blk.phis);
            var pi: usize = 0_usize;
            while pi < phis.len {
                if rel_v.test(phis[pi].dst.widen.[usize]()) {
                    let incs = eir_prog.phi_incoming(phis[pi].incoming);
                    var ii: usize = 0_usize;
                    while ii < incs.len {
                        mark_rel_val(&mut rel_v, incs[ii].val, &mut changed);
                        ii = ii +% 1_usize;
                    }
                }
                pi = pi +% 1_usize;
            }
        }
        iter = iter +% 1_usize;
    }

    try bitset_copy_from(alloc, &mut work_st.rel_vals, &rel_v);
    try bitset_copy_from(alloc, &mut work_st.rel_slots, &rel_s);
    try bitset_copy_from(alloc, &mut tmp_st.rel_vals, &rel_v);
    try bitset_copy_from(alloc, &mut tmp_st.rel_slots, &rel_s);
    work_st.filter_active = true;
    tmp_st.filter_active = true;

    tmp.destroy(alloc);
    rel_s.destroy(alloc);
    rel_v.destroy(alloc);
    is_mem_or_cast.destroy(alloc);
    is_const.destroy(alloc);
    return;
}

fn compute_fn_val_uses(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    nvals: usize,
    out_uses: *mut col.DynBuf[u32],
) -> !OutOfMemory {
    out_uses.clear();
    var i: usize = 0_usize;
    while i < nvals {
        try out_uses.push(alloc, 0_u32);
        i = i +% 1_usize;
    }
    var tmp = try col.DynBuf.[eir.EirValue].init(alloc, 8_usize);
    errdefer tmp.destroy(alloc);
    let blks = eir_prog.fn_blocks(fn_id);
    let us = out_uses.as_mut_slice();
    var bi: usize = 0_usize;
    while bi < blks.len {
        let blk = blks[bi];
        let phis = eir_prog.phis_slice(blk.phis);
        var pi: usize = 0_usize;
        while pi < phis.len {
            let incs = eir_prog.phi_incoming(phis[pi].incoming);
            var ii: usize = 0_usize;
            while ii < incs.len {
                let vi = incs[ii].val.widen.[usize]();
                if vi < us.len {
                    us[vi] = us[vi] +% 1_u32;
                }
                ii = ii +% 1_usize;
            }
            pi = pi +% 1_usize;
        }
        let insts = eir_prog.insts_slice(blk.insts);
        var ki: usize = 0_usize;
        while ki < insts.len {
            try eir.collect_inst_uses(alloc, eir_prog, &insts[ki], &mut tmp);
            let ts = tmp.as_slice();
            var ti: usize = 0_usize;
            while ti < ts.len {
                let vi = ts[ti].widen.[usize]();
                if vi < us.len {
                    us[vi] = us[vi] +% 1_u32;
                }
                ti = ti +% 1_usize;
            }
            ki = ki +% 1_usize;
        }
        let tv = blk.term.val;
        if tv != eir.EIR_NONE {
            let vi = tv.widen.[usize]();
            if vi < us.len {
                us[vi] = us[vi] +% 1_u32;
            }
        }
        bi = bi +% 1_usize;
    }
    tmp.destroy(alloc);
    return;
}

linear struct FnVerifyCtx {
    preds: PredArena;
    spool: StatePool;
    tmp_pool: StatePool;
    work_st: DbmState;
    tmp_st: DbmState;
    liveness: BlockLiveness;
    in_states: col.DynBuf[StateSnap];
    edge_map: col.HashMap[u32];
    edge_snaps: col.DynBuf[StateSnap];
    sym_scratch: col.DynBuf[SymEnvEntry];
    val_uses: col.DynBuf[u32];
    msg_buf: str.StrBuf;
    note_buf: str.StrBuf;
    next_compact_mat: usize;
    next_compact_iv: usize;
    next_compact_preds: usize;
    prof_block_transfers: u64;
    prof_fixpoint_iters: u64;
    prof_narrow_iters: u64;
    prof_widens: u64;
    prof_compacts: u64;
}

impl FnVerifyCtx {
    fn init(alloc: *mut AllocCap, n_blocks: usize) -> FnVerifyCtx ! OutOfMemory {
        let cap = if n_blocks < 4_usize { 4_usize } else { n_blocks };
        let preds = try PredArena.init(alloc);
        errdefer preds.destroy(alloc);
        let spool = try StatePool.init(alloc);
        errdefer spool.destroy(alloc);
        let tmp_pool = try StatePool.init(alloc);
        errdefer tmp_pool.destroy(alloc);
        let work_st = try DbmState.init(alloc);
        errdefer work_st.destroy(alloc);
        let tmp_st = try DbmState.init(alloc);
        errdefer tmp_st.destroy(alloc);
        let liveness = try BlockLiveness.init(alloc);
        errdefer liveness.destroy(alloc);
        var in_states = try col.DynBuf.[StateSnap].init(alloc, cap);
        errdefer in_states.destroy(alloc);
        let edge_map = try col.HashMap.[u32].init(alloc, cap *% 2_usize);
        errdefer edge_map.destroy(alloc);
        let edge_snaps = try col.DynBuf.[StateSnap].init(alloc, cap *% 2_usize);
        errdefer edge_snaps.destroy(alloc);
        let sym_scratch = try col.DynBuf.[SymEnvEntry].init(alloc, 16_usize);
        errdefer sym_scratch.destroy(alloc);
        let val_uses = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer val_uses.destroy(alloc);
        let msg_buf = try str.StrBuf.init(alloc, 128_usize);
        errdefer msg_buf.destroy(alloc);
        let note_buf = try str.StrBuf.init(alloc, 128_usize);
        errdefer note_buf.destroy(alloc);

        var i: usize = 0_usize;
        while i < n_blocks {
            try in_states.push(alloc, snap_bottom());
            i = i +% 1_usize;
        }
        return FnVerifyCtx.{
            preds: preds,
            spool: spool,
            tmp_pool: tmp_pool,
            work_st: work_st,
            tmp_st: tmp_st,
            liveness: liveness,
            in_states: in_states,
            edge_map: edge_map,
            edge_snaps: edge_snaps,
            sym_scratch: sym_scratch,
            val_uses: val_uses,
            msg_buf: msg_buf,
            note_buf: note_buf,
            next_compact_mat: COMPACT_MAT_THRESHOLD,
            next_compact_iv: COMPACT_MAT_THRESHOLD,
            next_compact_preds: COMPACT_MAT_THRESHOLD,
            prof_block_transfers: 0_u64,
            prof_fixpoint_iters: 0_u64,
            prof_narrow_iters: 0_u64,
            prof_widens: 0_u64,
            prof_compacts: 0_u64,
        };
    }

    fn destroy(self: FnVerifyCtx, alloc: *mut AllocCap) {
        let FnVerifyCtx.{
            preds,
            spool,
            tmp_pool,
            work_st,
            tmp_st,
            liveness,
            in_states,
            edge_map,
            edge_snaps,
            sym_scratch,
            val_uses,
            msg_buf,
            note_buf,
            next_compact_mat: _,
            next_compact_iv: _,
            next_compact_preds: _,
            prof_block_transfers: _,
            prof_fixpoint_iters: _,
            prof_narrow_iters: _,
            prof_widens: _,
            prof_compacts: _,
        } = self;
        preds.destroy(alloc);
        spool.destroy(alloc);
        tmp_pool.destroy(alloc);
        work_st.destroy(alloc);
        tmp_st.destroy(alloc);
        liveness.destroy(alloc);
        in_states.destroy(alloc);
        edge_map.destroy(alloc);
        edge_snaps.destroy(alloc);
        sym_scratch.destroy(alloc);
        val_uses.destroy(alloc);
        msg_buf.destroy(alloc);
        note_buf.destroy(alloc);
    }

    fn reset_for_fn(self: *mut Self, alloc: *mut AllocCap, n_blocks: usize) -> !OutOfMemory {
        self.preds.clear();
        try self.liveness.reset(alloc);
        // High-water shrink if a huge function bloated spool or tmp_pool.
        if self.spool.core.intervals.cap() > 131072_usize || self.spool.core.mat.cap() > 131072_usize {
            let fresh_s = try StatePool.init(alloc);
            self.spool.destroy(alloc);
            self.spool = fresh_s;
        } else {
            self.spool.clear();
            self.spool.prof_saves = 0_u64;
            self.spool.prof_edge_saves = 0_u64;
            self.spool.prof_sorts = 0_u64;
            self.spool.prof_already_sorted = 0_u64;
            self.spool.prof_total_iv_saved = 0_u64;
            self.spool.prof_total_mat_saved = 0_u64;
            self.spool.prof_peak_iv = 0_u64;
            self.spool.prof_peak_mat = 0_u64;
        }
        if self.tmp_pool.core.intervals.cap() > 65536_usize || self.tmp_pool.core.mat.cap() > 65536_usize {
            let fresh_t = try StatePool.init(alloc);
            self.tmp_pool.destroy(alloc);
            self.tmp_pool = fresh_t;
        } else {
            self.tmp_pool.clear();
            self.tmp_pool.prof_saves = 0_u64;
            self.tmp_pool.prof_edge_saves = 0_u64;
            self.tmp_pool.prof_sorts = 0_u64;
            self.tmp_pool.prof_already_sorted = 0_u64;
            self.tmp_pool.prof_total_iv_saved = 0_u64;
            self.tmp_pool.prof_total_mat_saved = 0_u64;
            self.tmp_pool.prof_peak_iv = 0_u64;
            self.tmp_pool.prof_peak_mat = 0_u64;
        }
        try self.work_st.reset_top(alloc);
        try self.tmp_st.reset_top(alloc);
        self.work_st.filter_active = false;
        self.tmp_st.filter_active = false;
        self.work_st.cross_active = false;
        self.tmp_st.cross_active = false;
        self.work_st.rel_vals.clear();
        self.tmp_st.rel_vals.clear();
        self.work_st.rel_slots.clear();
        self.tmp_st.rel_slots.clear();
        self.work_st.cross_vals.clear();
        self.tmp_st.cross_vals.clear();
        self.work_st.const_int_vals.clear();
        self.tmp_st.const_int_vals.clear();
        self.work_st.mut_addr_slots.clear();
        self.tmp_st.mut_addr_slots.clear();
        self.work_st.val_tb.clear();
        self.tmp_st.val_tb.clear();
        self.work_st.slot_tb.clear();
        self.tmp_st.slot_tb.clear();
        self.work_st.prof_loads = 0_u64;
        self.tmp_st.prof_loads = 0_u64;
        self.work_st.prof_copies = 0_u64;
        self.tmp_st.prof_copies = 0_u64;

        self.in_states.clear();
        try self.in_states.reserve(alloc, n_blocks);
        var i: usize = 0_usize;
        while i < n_blocks {
            try self.in_states.push(alloc, snap_bottom());
            i = i +% 1_usize;
        }
        self.edge_map.clear();
        self.edge_snaps.clear();
        self.sym_scratch.clear();
        self.val_uses.clear();
        self.msg_buf.clear();
        self.note_buf.clear();
        self.next_compact_mat = COMPACT_MAT_THRESHOLD;
        self.next_compact_iv = COMPACT_MAT_THRESHOLD;
        self.next_compact_preds = COMPACT_MAT_THRESHOLD;
        self.prof_block_transfers = 0_u64;
        self.prof_fixpoint_iters = 0_u64;
        self.prof_narrow_iters = 0_u64;
        self.prof_widens = 0_u64;
        self.prof_compacts = 0_u64;
        return;
    }

    fn set_edge(
        self: *mut Self,
        alloc: *mut AllocCap,
        from_bb: cfg_ir.BlockId,
        to_bb: cfg_ir.BlockId,
        snap: StateSnap,
    ) -> !OutOfMemory {
        let ek = edge_key(from_bb, to_bb);
        if let idx = self.edge_map.get(ek) {
            let es = self.edge_snaps.as_mut_slice();
            let iu = idx.widen.[usize]();
            if iu < es.len {
                es[iu] = snap;
            }
            return;
        }
        let new_idx = self.edge_snaps.len().trunc.[u32]();
        try self.edge_snaps.push(alloc, snap);
        try self.edge_map.insert(alloc, ek, new_idx);
        return;
    }

    fn get_edge(self: *Self, from_bb: cfg_ir.BlockId, to_bb: cfg_ir.BlockId) -> ?StateSnap {
        if let idx = self.edge_map.get(edge_key(from_bb, to_bb)) {
            let es = self.edge_snaps.as_slice();
            let iu = idx.widen.[usize]();
            if iu < es.len {
                return es[iu];
            }
        }
        return null;
    }

    fn compact_pool_if_needed(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        if self.spool.core.mat.len() <= self.next_compact_mat
            && self.spool.core.intervals.len() <= self.next_compact_iv
            && self.spool.aux.preds.len() <= self.next_compact_preds
        {
            return;
        }
        var fresh = try StatePool.init(alloc);
        errdefer fresh.destroy(alloc);
        let ins = self.in_states.as_mut_slice();
        var i: usize = 0_usize;
        while i < ins.len {
            let cur_s = ins[i];
            ins[i] = try self.spool.copy_snap_into(alloc, &cur_s, &mut fresh);
            i = i +% 1_usize;
        }
        let es = self.edge_snaps.as_mut_slice();
        var j: usize = 0_usize;
        while j < es.len {
            let cur_e = es[j];
            es[j] = try self.spool.copy_snap_into(alloc, &cur_e, &mut fresh);
            j = j +% 1_usize;
        }
        self.prof_compacts = self.prof_compacts +% 1_u64;
        fresh.prof_saves = self.spool.prof_saves;
        fresh.prof_edge_saves = self.spool.prof_edge_saves;
        fresh.prof_sorts = self.spool.prof_sorts;
        fresh.prof_already_sorted = self.spool.prof_already_sorted;
        fresh.prof_total_iv_saved = self.spool.prof_total_iv_saved;
        fresh.prof_total_mat_saved = self.spool.prof_total_mat_saved;
        fresh.prof_peak_iv = self.spool.prof_peak_iv;
        fresh.prof_peak_mat = self.spool.prof_peak_mat;
        self.spool.destroy(alloc);
        self.spool = fresh;
        let live_mat = self.spool.core.mat.len();
        let live_iv = self.spool.core.intervals.len();
        let live_pr = self.spool.aux.preds.len();
        self.next_compact_mat = (live_mat *% 2_usize) +% COMPACT_MAT_THRESHOLD;
        self.next_compact_iv = (live_iv *% 2_usize) +% COMPACT_MAT_THRESHOLD;
        self.next_compact_preds = (live_pr *% 2_usize) +% COMPACT_MAT_THRESHOLD;
        return;
    }
}

fn compute_out_edges_switch(
    alloc: *mut AllocCap,
    ctx: *mut FnVerifyCtx,
    bb: cfg_ir.BlockId,
    term: *eir.EirTerm,
    out_snap: *StateSnap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    try ctx.tmp_pool.load(alloc, out_snap, &mut ctx.work_st);
    var arm_map = try col.HashMap.[u32].init(alloc, 16_usize);
    errdefer arm_map.destroy(alloc);
    var arm_tgts = try col.DynBuf.[cfg_ir.BlockId].init(alloc, 8_usize);
    errdefer arm_tgts.destroy(alloc);
    var arm_snaps = try col.DynBuf.[StateSnap].init(alloc, 8_usize);
    errdefer arm_snaps.destroy(alloc);

    let discr_k = vk_val(term.val);
    let targets = eir_prog.switch_targets_slice(term.targets);
    var ti: usize = 0_usize;
    while ti < targets.len {
        let cval = targets[ti].val;
        let tgt = targets[ti].target;
        try ctx.tmp_pool.load(alloc, out_snap, &mut ctx.tmp_st);
        try dbm_add_const(&mut ctx.tmp_st, alloc, discr_k, cval);
        let arm_snap = try ctx.tmp_pool.save(alloc, &ctx.tmp_st);
        let tk = tgt.widen.[u64]();
        if let existing_idx = arm_map.get(tk) {
            let iu = existing_idx.widen.[usize]();
            let prev = if let p = arm_snaps.get(iu) { copy p.* } else { snap_bottom() };
            try join_snaps(alloc, &ctx.tmp_pool, &ctx.tmp_pool, &prev, &arm_snap, &mut ctx.tmp_st);
            let merged = try ctx.tmp_pool.save(alloc, &ctx.tmp_st);
            let ms = arm_snaps.as_mut_slice();
            if iu < ms.len {
                ms[iu] = merged;
            }
        } else {
            let ni = arm_snaps.len().trunc.[u32]();
            try arm_tgts.push(alloc, tgt);
            try arm_snaps.push(alloc, arm_snap);
            try arm_map.insert(alloc, tk, ni);
        }

        let iv = dbm_get_interval(&ctx.work_st, discr_k);
        if types.int_val_is_zero(cval) {
            try vk_set_insert(&mut ctx.work_st.aux.non_zero, alloc, discr_k);
        }
        if iv.has_lo && iv.has_hi && types.int_val_eq(iv.lo, cval) && types.int_val_eq(iv.hi, cval) {
            ctx.work_st.core.is_bottom = true;
        } else if iv.has_lo && types.int_val_eq(iv.lo, cval) {
            if let c1 = types.int_val_checked_add(cval, iv_one()) {
                try dbm_add_lower(&mut ctx.work_st, alloc, discr_k, c1);
            }
        } else if iv.has_hi && types.int_val_eq(iv.hi, cval) {
            if let cm1 = types.int_val_checked_sub(cval, iv_one()) {
                try dbm_add_upper(&mut ctx.work_st, alloc, discr_k, cm1);
            }
        }
        ti = ti +% 1_usize;
    }

    let oth_pre_snap = try ctx.tmp_pool.save(alloc, &ctx.work_st);
    let tgts_ro = arm_tgts.as_slice();
    let snaps_ro = arm_snaps.as_slice();
    var ai: usize = 0_usize;
    while ai < tgts_ro.len && ai < snaps_ro.len {
        let tgt = tgts_ro[ai];
        try ctx.tmp_pool.load(alloc, &snaps_ro[ai], &mut ctx.tmp_st);
        try apply_phis_on_edge(&mut ctx.tmp_st, alloc, &mut ctx.tmp_pool, bb, tgt, eir_prog, fn_id, env, ctx.val_uses.as_slice(), &ctx.liveness);
        let final_s = try ctx.spool.save_edge_for_bb(alloc, &ctx.tmp_st, &ctx.liveness, &ctx.preds, tgt);
        try ctx.set_edge(alloc, bb, tgt, final_s);
        ai = ai +% 1_usize;
    }

    try ctx.tmp_pool.load(alloc, &oth_pre_snap, &mut ctx.tmp_st);
    try apply_phis_on_edge(&mut ctx.tmp_st, alloc, &mut ctx.tmp_pool, bb, term.bb0, eir_prog, fn_id, env, ctx.val_uses.as_slice(), &ctx.liveness);
    let oth_final = try ctx.spool.save_edge_for_bb(alloc, &ctx.tmp_st, &ctx.liveness, &ctx.preds, term.bb0);
    try ctx.set_edge(alloc, bb, term.bb0, oth_final);

    arm_snaps.destroy(alloc);
    arm_tgts.destroy(alloc);
    arm_map.destroy(alloc);
    return;
}

fn compute_out_edges(
    alloc: *mut AllocCap,
    ctx: *mut FnVerifyCtx,
    bb: cfg_ir.BlockId,
    term: *eir.EirTerm,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    ctx.tmp_pool.clear();
    match term.kind {
        .Goto => {
            try apply_phis_on_edge(&mut ctx.work_st, alloc, &mut ctx.tmp_pool, bb, term.bb0, eir_prog, fn_id, env, ctx.val_uses.as_slice(), &ctx.liveness);
            let snap = try ctx.spool.save_edge_for_bb(alloc, &ctx.work_st, &ctx.liveness, &ctx.preds, term.bb0);
            try ctx.set_edge(alloc, bb, term.bb0, snap);
        }
        .Branch => {
            let opt_pred = preds_get(ctx.work_st.aux.preds.as_slice(), term.val);
            let no_pred_no_phis = opt_pred == null
                && (!ctx.liveness.block_has_live_phis(term.bb0) || eir_prog.block_phis(fn_id, term.bb0).len == 0_usize)
                && (!ctx.liveness.block_has_live_phis(term.bb1) || eir_prog.block_phis(fn_id, term.bb1).len == 0_usize);
            if no_pred_no_phis && ctx.liveness.blocks_equal(term.bb0, term.bb1) {
                let shared_snap = try ctx.spool.save_edge_for_bb(alloc, &ctx.work_st, &ctx.liveness, &ctx.preds, term.bb0);
                try ctx.set_edge(alloc, bb, term.bb0, copy shared_snap);
                try ctx.set_edge(alloc, bb, term.bb1, shared_snap);
            } else if no_pred_no_phis {
                let s0 = try ctx.spool.save_edge_for_bb(alloc, &ctx.work_st, &ctx.liveness, &ctx.preds, term.bb0);
                try ctx.set_edge(alloc, bb, term.bb0, s0);
                let s1 = try ctx.spool.save_edge_for_bb(alloc, &ctx.work_st, &ctx.liveness, &ctx.preds, term.bb1);
                try ctx.set_edge(alloc, bb, term.bb1, s1);
            } else {
                try dbm_copy_state(alloc, &ctx.work_st, &mut ctx.tmp_st);
                if let pred_id = opt_pred {
                    try dbm_refine_pred(&mut ctx.tmp_st, alloc, &ctx.preds, &mut ctx.tmp_pool, pred_id, true);
                }
                try apply_phis_on_edge(&mut ctx.tmp_st, alloc, &mut ctx.tmp_pool, bb, term.bb0, eir_prog, fn_id, env, ctx.val_uses.as_slice(), &ctx.liveness);
                let then_snap = try ctx.spool.save_edge_for_bb(alloc, &ctx.tmp_st, &ctx.liveness, &ctx.preds, term.bb0);
                try ctx.set_edge(alloc, bb, term.bb0, then_snap);

                if let pred_id = opt_pred {
                    try dbm_refine_pred(&mut ctx.work_st, alloc, &ctx.preds, &mut ctx.tmp_pool, pred_id, false);
                }
                try apply_phis_on_edge(&mut ctx.work_st, alloc, &mut ctx.tmp_pool, bb, term.bb1, eir_prog, fn_id, env, ctx.val_uses.as_slice(), &ctx.liveness);
                let else_snap = try ctx.spool.save_edge_for_bb(alloc, &ctx.work_st, &ctx.liveness, &ctx.preds, term.bb1);
                try ctx.set_edge(alloc, bb, term.bb1, else_snap);
            }
        }
        .SwitchInt => {
            let out_snap = try ctx.tmp_pool.save(alloc, &ctx.work_st);
            try compute_out_edges_switch(alloc, ctx, bb, term, &out_snap, eir_prog, fn_id, env);
        }
        _ => {}
    }
    ctx.tmp_pool.clear();
    return;
}

struct JoinPredResult {
    in_tmp_st: bool;
    snap: StateSnap;
}

fn join_pred_edges_ex(
    alloc: *mut AllocCap,
    ctx: *mut FnVerifyCtx,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    bb: cfg_ir.BlockId,
) -> JoinPredResult ! OutOfMemory {
    var acc = snap_bottom();
    var in_tmp = false;
    var has_tmp_st = false;
    let preds = eir_prog.block_preds(fn_id, bb);
    var pi: usize = 0_usize;
    while pi < preds.len {
        if let es = ctx.get_edge(preds[pi], bb) {
            if es.valid && !es.is_bottom {
                if !has_tmp_st && (!acc.valid || acc.is_bottom) {
                    acc = es;
                    in_tmp = false;
                } else {
                    if has_tmp_st {
                        ctx.tmp_pool.clear();
                        acc = try ctx.tmp_pool.save(alloc, &ctx.tmp_st);
                        in_tmp = true;
                        has_tmp_st = false;
                    }
                    if in_tmp {
                        try join_snaps(alloc, &ctx.tmp_pool, &ctx.spool, &acc, &es, &mut ctx.tmp_st);
                    } else {
                        try join_snaps(alloc, &ctx.spool, &ctx.spool, &acc, &es, &mut ctx.tmp_st);
                    }
                    has_tmp_st = true;
                }
            }
        }
        pi = pi +% 1_usize;
    }
    ctx.tmp_pool.clear();
    if has_tmp_st {
        return JoinPredResult.{ in_tmp_st: true, snap: snap_bottom() };
    }
    return JoinPredResult.{ in_tmp_st: false, snap: acc };
}

fn init_entry_state(
    alloc: *mut AllocCap,
    ctx: *mut FnVerifyCtx,
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    f: *eir.EirFunction,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    try ctx.work_st.reset_top(alloc);
    let params = eir_prog.fn_params(fn_id);
    let sig_params = env.params_range(f.sig.params);
    var pi: usize = 0_usize;
    while pi < params.len {
        let pv = params[pi];
        let pty = if pi < sig_params.len { sig_params[pi].ty } else { eir_prog.fn_val_ty(fn_id, pv) };
        let tb = ty_bounds(pty, env);
        if tb.valid {
            try dbm_set_interval(&mut ctx.work_st, alloc, vk_val(pv), tb_to_interval(tb));
        }
        try init_len_for_key(&mut ctx.work_st, alloc, vk_len_val(pv), pty, env);
        pi = pi +% 1_usize;
    }
    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < slots.len {
        let s = slots[si];
        let tb = ty_bounds(s.ty, env);
        if tb.valid {
            try dbm_set_interval(&mut ctx.work_st, alloc, vk_slot(s.id), tb_to_interval(tb));
        }
        try init_len_for_key(&mut ctx.work_st, alloc, vk_len_slot(s.id), s.ty, env);
        si = si +% 1_usize;
    }
    let wcs = eir_prog.fn_where_clauses(fn_id);
    if wcs.len > 0_usize {
        try build_param_env(alloc, eir_prog, fn_id, &mut ctx.sym_scratch);
        var wi: usize = 0_usize;
        while wi < wcs.len {
            try assume_contract_expr(
                &mut ctx.work_st, alloc, arena, wcs[wi], ctx.sym_scratch.as_slice(), false, VK_NONE, interner,
            );
            wi = wi +% 1_usize;
        }
    }
    let entry_snap = try ctx.spool.save(alloc, &ctx.work_st);
    let ins = ctx.in_states.as_mut_slice();
    if ins.len > 0_usize {
        ins[0_usize] = entry_snap;
    }
    return;
}

fn run_block_transfer_loaded(
    alloc: *mut AllocCap,
    ctx: *mut FnVerifyCtx,
    bb: cfg_ir.BlockId,
    blk: *eir.EirBlock,
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    if ctx.work_st.core.is_bottom {
        return;
    }
    ctx.prof_block_transfers = ctx.prof_block_transfers +% 1_u64;
    let insts = eir_prog.insts_slice(blk.insts);
    var ii: usize = 0_usize;
    while ii < insts.len {
        try transfer_inst(
            &mut ctx.work_st, alloc, &mut ctx.preds, arena, &insts[ii],
            eir_prog, fn_id, env, interner, &mut ctx.sym_scratch,
        );
        if ctx.work_st.core.is_bottom {
            break;
        }
        ii = ii +% 1_usize;
    }
    let term = blk.term;
    try compute_out_edges(alloc, ctx, bb, &term, eir_prog, fn_id, env);
    return;
}

fn run_block_transfer(
    alloc: *mut AllocCap,
    ctx: *mut FnVerifyCtx,
    bb: cfg_ir.BlockId,
    blk: *eir.EirBlock,
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
) -> !OutOfMemory {
    let bi = bb.widen.[usize]();
    let cur_in = if let p = ctx.in_states.get(bi) { copy p.* } else { snap_bottom() };
    if !cur_in.valid || cur_in.is_bottom {
        return;
    }
    try ctx.spool.load(alloc, &cur_in, &mut ctx.work_st);
    try run_block_transfer_loaded(alloc, ctx, bb, blk, arena, eir_prog, fn_id, env, interner);
    return;
}

fn mark_term_succs_dirty(
    eir_prog: *eir.EirProgram,
    term: *eir.EirTerm,
    dirty: *mut col.BitSet,
    n_blocks: usize,
) {
    match term.kind {
        .Goto => {
            let t0 = term.bb0.widen.[usize]();
            if t0 < n_blocks { dirty.set(t0); }
        }
        .Branch => {
            let t0 = term.bb0.widen.[usize]();
            let t1 = term.bb1.widen.[usize]();
            if t0 < n_blocks { dirty.set(t0); }
            if t1 < n_blocks { dirty.set(t1); }
        }
        .SwitchInt => {
            let t0 = term.bb0.widen.[usize]();
            if t0 < n_blocks { dirty.set(t0); }
            let targets = eir_prog.switch_targets_slice(term.targets);
            var ti: usize = 0_usize;
            while ti < targets.len {
                let tt = targets[ti].target.widen.[usize]();
                if tt < n_blocks { dirty.set(tt); }
                ti = ti +% 1_usize;
            }
        }
        _ => {}
    }
}

fn run_fixpoint_passes(
    alloc: *mut AllocCap,
    ctx: *mut FnVerifyCtx,
    loops: *mut LoopInfo,
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
) -> bool ! OutOfMemory {
    let rpo = eir_prog.fn_rpo(fn_id);
    let blks = eir_prog.fn_blocks(fn_id);
    let n_blocks = blks.len;
    var dirty = try col.BitSet.init(alloc, n_blocks);
    errdefer dirty.destroy(alloc);
    if n_blocks > 0_usize {
        dirty.set(0_usize);
    }
    var did_widen = false;
    var pass: usize = 0_usize;
    while pass < MAX_FIXPOINT_ITERS {
        ctx.prof_fixpoint_iters = ctx.prof_fixpoint_iters +% 1_u64;
        var changed = false;
        var ri: usize = 0_usize;
        while ri < rpo.len {
            let bb = rpo[ri];
            let bi = bb.widen.[usize]();
            if bi >= n_blocks {
                ri = ri +% 1_usize;
                continue;
            }
            if !dirty.test(bi) {
                ri = ri +% 1_usize;
                continue;
            }
            dirty.unset(bi);

            var need_transfer = pass == 0_usize && bi == 0_usize;
            var have_loaded_work = false;
            if bi != 0_usize {
                let jp = try join_pred_edges_ex(alloc, ctx, eir_prog, fn_id, bb);
                let old_snap = if let p = ctx.in_states.get(bi) { copy p.* } else { snap_bottom() };
                var cur_in_tmp_st = jp.in_tmp_st;
                let cur_snap = jp.snap;
                if loops.block_is_header(bi) && old_snap.valid && !old_snap.is_bottom {
                    var cnt: usize = 0_usize;
                    let hiters = loops.header_iters.as_mut_slice();
                    if bi < hiters.len {
                        hiters[bi] = hiters[bi] +% 1_usize;
                        cnt = hiters[bi];
                    }
                    if cnt > WIDEN_AFTER_ITERS {
                        ctx.prof_widens = ctx.prof_widens +% 1_u64;
                        if cur_in_tmp_st {
                            ctx.tmp_pool.clear();
                            let new_tmp = try ctx.tmp_pool.save(alloc, &ctx.tmp_st);
                            try widen_snaps(
                                alloc, &ctx.spool, &ctx.tmp_pool, &old_snap, &new_tmp, loops.header_wkeys(bi),
                                eir_prog, fn_id, env, &mut ctx.tmp_st,
                            );
                            ctx.tmp_pool.clear();
                        } else {
                            try widen_snaps(
                                alloc, &ctx.spool, &ctx.spool, &old_snap, &cur_snap, loops.header_wkeys(bi),
                                eir_prog, fn_id, env, &mut ctx.tmp_st,
                            );
                        }
                        cur_in_tmp_st = true;
                        did_widen = true;
                    }
                }
                let invs = eir_prog.fn_block_invariants(fn_id, bb);
                if invs.len > 0_usize {
                    if !cur_in_tmp_st {
                        try ctx.spool.load(alloc, &cur_snap, &mut ctx.tmp_st);
                        cur_in_tmp_st = true;
                    }
                    try build_block_sym_env(alloc, eir_prog, fn_id, &mut ctx.sym_scratch);
                    var ii: usize = 0_usize;
                    while ii < invs.len {
                        try assume_contract_expr(
                            &mut ctx.tmp_st, alloc, arena, invs[ii], ctx.sym_scratch.as_slice(),
                            false, VK_NONE, interner,
                        );
                        ii = ii +% 1_usize;
                    }
                }
                if cur_in_tmp_st {
                    if !state_eq_snap(&ctx.tmp_st, &ctx.spool, &old_snap) {
                        let new_s = try ctx.spool.save(alloc, &ctx.tmp_st);
                        let ins = ctx.in_states.as_mut_slice();
                        if bi < ins.len {
                            ins[bi] = new_s;
                        }
                        changed = true;
                        need_transfer = true;
                        try dbm_copy_state(alloc, &ctx.tmp_st, &mut ctx.work_st);
                        have_loaded_work = true;
                    }
                } else {
                    if !snap_eq_snap(&ctx.spool, &cur_snap, &old_snap) {
                        let ins = ctx.in_states.as_mut_slice();
                        if bi < ins.len {
                            ins[bi] = cur_snap;
                        }
                        changed = true;
                        need_transfer = true;
                    }
                }
            }
            if need_transfer && bi < blks.len {
                if have_loaded_work {
                    try run_block_transfer_loaded(alloc, ctx, bb, &blks[bi], arena, eir_prog, fn_id, env, interner);
                } else {
                    try run_block_transfer(alloc, ctx, bb, &blks[bi], arena, eir_prog, fn_id, env, interner);
                }
                mark_term_succs_dirty(eir_prog, &blks[bi].term, &mut dirty, n_blocks);
            }
            if (ri & 255_usize) == 255_usize {
                try ctx.compact_pool_if_needed(alloc);
            }
            ri = ri +% 1_usize;
        }
        try ctx.compact_pool_if_needed(alloc);
        if !changed {
            break;
        }
        pass = pass +% 1_usize;
    }
    dirty.destroy(alloc);
    return did_widen;
}

fn run_narrow_passes(
    alloc: *mut AllocCap,
    ctx: *mut FnVerifyCtx,
    loops: *LoopInfo,
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    did_widen: bool,
) -> !OutOfMemory {
    if !did_widen {
        return;
    }
    let rpo = eir_prog.fn_rpo(fn_id);
    let blks = eir_prog.fn_blocks(fn_id);
    let n_blocks = blks.len;
    var dirty = try col.BitSet.init(alloc, n_blocks);
    errdefer dirty.destroy(alloc);
    var hb: usize = 0_usize;
    while hb < n_blocks {
        if loops.block_is_header(hb) {
            dirty.set(hb);
        }
        hb = hb +% 1_usize;
    }
    var npass: usize = 0_usize;
    while npass < NARROW_ITERS {
        ctx.prof_narrow_iters = ctx.prof_narrow_iters +% 1_u64;
        var changed = false;
        var ri: usize = 0_usize;
        while ri < rpo.len {
            let bb = rpo[ri];
            let bi = bb.widen.[usize]();
            if bi >= n_blocks || !dirty.test(bi) {
                ri = ri +% 1_usize;
                continue;
            }
            dirty.unset(bi);
            if bi != 0_usize {
                let jp = try join_pred_edges_ex(alloc, ctx, eir_prog, fn_id, bb);
                let old_snap = if let p = ctx.in_states.get(bi) { copy p.* } else { snap_bottom() };
                var cur_in_tmp_st = jp.in_tmp_st;
                let cur_snap = jp.snap;
                if loops.block_is_header(bi) {
                    if cur_in_tmp_st {
                        ctx.tmp_pool.clear();
                        let new_tmp = try ctx.tmp_pool.save(alloc, &ctx.tmp_st);
                        try narrow_snaps(alloc, &ctx.spool, &ctx.tmp_pool, &old_snap, &new_tmp, &mut ctx.tmp_st);
                        ctx.tmp_pool.clear();
                    } else {
                        try narrow_snaps(alloc, &ctx.spool, &ctx.spool, &old_snap, &cur_snap, &mut ctx.tmp_st);
                    }
                    cur_in_tmp_st = true;
                }
                if cur_in_tmp_st {
                    if !state_eq_snap(&ctx.tmp_st, &ctx.spool, &old_snap) {
                        let new_s = try ctx.spool.save(alloc, &ctx.tmp_st);
                        let ins = ctx.in_states.as_mut_slice();
                        if bi < ins.len {
                            ins[bi] = new_s;
                        }
                        changed = true;
                        try dbm_copy_state(alloc, &ctx.tmp_st, &mut ctx.work_st);
                        try run_block_transfer_loaded(alloc, ctx, bb, &blks[bi], arena, eir_prog, fn_id, env, interner);
                        mark_term_succs_dirty(eir_prog, &blks[bi].term, &mut dirty, n_blocks);
                    }
                } else {
                    if !snap_eq_snap(&ctx.spool, &cur_snap, &old_snap) {
                        let ins = ctx.in_states.as_mut_slice();
                        if bi < ins.len {
                            ins[bi] = cur_snap;
                        }
                        changed = true;
                        try run_block_transfer(alloc, ctx, bb, &blks[bi], arena, eir_prog, fn_id, env, interner);
                        mark_term_succs_dirty(eir_prog, &blks[bi].term, &mut dirty, n_blocks);
                    }
                }
            }
            if (ri & 255_usize) == 255_usize {
                try ctx.compact_pool_if_needed(alloc);
            }
            ri = ri +% 1_usize;
        }
        try ctx.compact_pool_if_needed(alloc);
        if !changed {
            break;
        }
        npass = npass +% 1_usize;
    }
    dirty.destroy(alloc);
    return;
}

fn record_val_fact(
    out_facts: *mut col.DynBuf[eir.EirValueFact],
    v: eir.EirValue,
    fact: eir.EirValueFact,
) {
    let idx = v.widen.[usize]();
    let fs = out_facts.as_mut_slice();
    if idx < fs.len {
        fs[idx] = fact;
    }
}

fn init_fn_type_bounds(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    work_st: *mut DbmState,
    tmp_st: *mut DbmState,
) -> !OutOfMemory {
    let vtys = eir_prog.fn_value_tys(fn_id);
    try work_st.val_tb.reserve(alloc, vtys.len);
    try tmp_st.val_tb.reserve(alloc, vtys.len);
    var vi: usize = 0_usize;
    while vi < vtys.len {
        let tb = ty_bounds(vtys[vi], env);
        try work_st.val_tb.push(alloc, copy tb);
        try tmp_st.val_tb.push(alloc, tb);
        vi = vi +% 1_usize;
    }
    var civ = try col.BitSet.init(alloc, vtys.len);
    errdefer civ.destroy(alloc);
    let blks = eir_prog.fn_blocks(fn_id);
    let wtbs = work_st.val_tb.as_mut_slice();
    let ttbs = tmp_st.val_tb.as_mut_slice();
    var bi: usize = 0_usize;
    while bi < blks.len {
        let insts = eir_prog.insts_slice(blks[bi].insts);
        var ki: usize = 0_usize;
        while ki < insts.len {
            let inst = insts[ki];
            if inst.kind == .Const {
                if let kc = eir_prog.get_const(inst.aux0) {
                    if kc.kind == .Int {
                        let di = inst.dst.widen.[usize]();
                        if di < wtbs.len && di < ttbs.len {
                            let cb = types.IntBounds.{ valid: true, has_max: true, min: kc.int_val, max: kc.int_val };
                            wtbs[di] = copy cb;
                            ttbs[di] = cb;
                            civ.set(di);
                        }
                    }
                }
            }
            ki = ki +% 1_usize;
        }
        bi = bi +% 1_usize;
    }
    try bitset_copy_from(alloc, &mut work_st.const_int_vals, &civ);
    try bitset_copy_from(alloc, &mut tmp_st.const_int_vals, &civ);
    let slots = eir_prog.fn_slots(fn_id);
    try work_st.slot_tb.reserve(alloc, slots.len);
    try tmp_st.slot_tb.reserve(alloc, slots.len);
    var si: usize = 0_usize;
    while si < slots.len {
        let tb = ty_bounds(slots[si].ty, env);
        try work_st.slot_tb.push(alloc, copy tb);
        try tmp_st.slot_tb.push(alloc, tb);
        si = si +% 1_usize;
    }
    civ.destroy(alloc);
    return;
}

fn verify_block_invariants(
    alloc: *mut AllocCap,
    ctx: *mut FnVerifyCtx,
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    bb: cfg_ir.BlockId,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    stats: *mut FnVerifyInfo,
) -> !OutOfMemory {
    let blk_invs = eir_prog.fn_block_invariants(fn_id, bb);
    if blk_invs.len == 0_usize {
        return;
    }
    try build_block_sym_env(alloc, eir_prog, fn_id, &mut ctx.sym_scratch);
    let inv_preds = eir_prog.block_preds(fn_id, bb);
    var inv_i: usize = 0_usize;
    while inv_i < blk_invs.len {
        var worst: ContractVerdict = .Proven;
        var any_edge = false;
        var pi_inv: usize = 0_usize;
        while pi_inv < inv_preds.len {
            if let es = ctx.get_edge(inv_preds[pi_inv], bb) {
                if es.valid && !es.is_bottom {
                    any_edge = true;
                    let v = try check_contract_expr(
                        alloc, &ctx.spool, &es, &mut ctx.tmp_st, arena, blk_invs[inv_i],
                        ctx.sym_scratch.as_slice(), false, VK_NONE, interner,
                    );
                    if v == .Disproven {
                        worst = .Disproven;
                        break;
                    } else if v == .Unknown && worst == .Proven {
                        worst = .Unknown;
                    }
                }
            }
            pi_inv = pi_inv +% 1_usize;
        }
        if any_edge {
            stats.total_checks = stats.total_checks +% 1_usize;
            if worst == .Proven {
                stats.proven_checks = stats.proven_checks +% 1_usize;
            } else {
                var isp = span.span_dummy();
                if let ex = arena.get_expr(blk_invs[inv_i]) {
                    isp = ex.span;
                }
                let imsg: *str = if worst == .Disproven {
                    "loop invariant `where` is definitely violated"
                } else {
                    "cannot prove loop invariant `where`"
                };
                _ = try diags.emit_error(alloc, diag.E0107, isp, imsg);
            }
        }
        inv_i = inv_i +% 1_usize;
    }
    return;
}

fn verify_function(
    alloc: *mut AllocCap,
    ctx: *mut FnVerifyCtx,
    range_idx_map: *mut col.HashMap[u32],
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    out_ranges: *mut col.DynBuf[eir.EirValRange],
    out_proven: *mut col.DynBuf[eir.EirProvenSafeInst],
    out_facts: *mut col.DynBuf[eir.EirValueFact],
    out_inst_flags: *mut col.DynBuf[ProvenInstFlag],
    prof: *mut VerifyProfStats,
) -> FnVerifyInfo ! OutOfMemory {
    out_ranges.clear();
    out_proven.clear();
    out_facts.clear();
    out_inst_flags.clear();
    let f = eir_prog.get_fn(fn_id) orelse {
        return fn_verify_default();
    };
    let nvals = eir_prog.fn_value_tys(fn_id).len;
    var fv0: usize = 0_usize;
    while fv0 < nvals {
        try out_facts.push(alloc, eir.value_fact_unknown());
        fv0 = fv0 +% 1_usize;
    }
    let blks = eir_prog.fn_blocks(fn_id);
    let n_blocks = blks.len;
    if n_blocks == 0_usize {
        return fn_verify_default();
    }

    var loops = try compute_loop_info(alloc, eir_prog, fn_id, n_blocks);
    errdefer loops.destroy(alloc);
    try ctx.reset_for_fn(alloc, n_blocks);
    try compute_fn_val_uses(alloc, eir_prog, fn_id, nvals, &mut ctx.val_uses);
    try init_fn_type_bounds(alloc, eir_prog, fn_id, env, &mut ctx.work_st, &mut ctx.tmp_st);
    try init_fn_rel_filter(alloc, eir_prog, fn_id, f, nvals, &mut ctx.work_st, &mut ctx.tmp_st);
    try ctx.liveness.compute_for_fn(alloc, eir_prog, fn_id, f, nvals);
    try init_fn_mut_addr_slots(alloc, eir_prog, fn_id, env, &mut ctx.work_st, &mut ctx.tmp_st);

    try init_entry_state(alloc, ctx, arena, eir_prog, fn_id, f, env, interner);
    let did_widen = try run_fixpoint_passes(alloc, ctx, &mut loops, arena, eir_prog, fn_id, env, interner);
    try run_narrow_passes(alloc, ctx, &loops, arena, eir_prog, fn_id, env, interner, did_widen);

    range_idx_map.clear();
    var stats = fn_verify_default();
    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bb = rpo[ri];
        let bi = bb.widen.[usize]();
        if bi >= blks.len {
            ri = ri +% 1_usize;
            continue;
        }
        try verify_block_invariants(
            alloc, ctx, arena, eir_prog, fn_id, bb, interner, diags, &mut stats,
        );
        let cur_in = if let p = ctx.in_states.get(bi) { copy p.* } else { snap_bottom() };
        let term = blks[bi].term;
        if !cur_in.valid || cur_in.is_bottom {
            if term.kind == .Unreachable && term.flag {
                stats.total_checks = stats.total_checks +% 1_usize;
                stats.proven_checks = stats.proven_checks +% 1_usize;
            }
            ri = ri +% 1_usize;
            continue;
        }
        try ctx.spool.load(alloc, &cur_in, &mut ctx.work_st);
        if bb == f.entry {
            let params = eir_prog.fn_params(fn_id);
            var pi: usize = 0_usize;
            while pi < params.len {
                let pv = params[pi];
                let pty = eir_prog.fn_val_ty(fn_id, pv);
                record_val_fact(out_facts, pv, build_value_fact(&ctx.work_st, vk_val(pv), pty, env));
                pi = pi +% 1_usize;
            }
        }
        let phis = eir_prog.phis_slice(blks[bi].phis);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len {
            let phi = phis[phi_i];
            record_val_fact(out_facts, phi.dst, build_value_fact(&ctx.work_st, vk_val(phi.dst), phi.ty, env));
            phi_i = phi_i +% 1_usize;
        }
        let insts_start = blks[bi].insts.start;
        let insts = eir_prog.insts_slice(blks[bi].insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let ii_u32 = ii.trunc.[u32]();
            let global_inst_idx = insts_start +% ii_u32;
            ctx.tmp_pool.clear();
            try verify_inst(
                alloc, bb, ii_u32, global_inst_idx, &insts[ii], &ctx.work_st,
                &mut ctx.tmp_pool, &mut ctx.tmp_st, arena, eir_prog, fn_id, env, interner,
                diags, out_proven, out_inst_flags, &mut stats, &mut ctx.sym_scratch, &mut ctx.msg_buf, &mut ctx.note_buf,
            );
            try transfer_inst(
                &mut ctx.work_st, alloc, &mut ctx.preds, arena, &insts[ii],
                eir_prog, fn_id, env, interner, &mut ctx.sym_scratch,
            );
            let dst = inst_def_val(&insts[ii]);
            if dst != eir.EIR_NONE {
                let dty = eir_prog.fn_val_ty(fn_id, dst);
                if env.is_integer(dty) {
                    let iv = dbm_get_interval(&ctx.work_st, vk_val(dst));
                    if iv.has_lo && iv.has_hi {
                        let dk = dst.widen.[u64]();
                        let vr = eir.EirValRange.{ val: dst, lo: iv.lo, hi: iv.hi };
                        if let existing = range_idx_map.get(dk) {
                            let rs = out_ranges.as_mut_slice();
                            let eu = existing.widen.[usize]();
                            if eu < rs.len {
                                rs[eu] = vr;
                            }
                        } else {
                            let ni = out_ranges.len().trunc.[u32]();
                            try out_ranges.push(alloc, vr);
                            try range_idx_map.insert(alloc, dk, ni);
                        }
                    }
                }
                if !ctx.work_st.core.is_bottom {
                    record_val_fact(out_facts, dst, build_value_fact(&ctx.work_st, vk_val(dst), dty, env));
                }
            }
            if ctx.work_st.core.is_bottom {
                break;
            }
            ii = ii +% 1_usize;
        }
        if ctx.work_st.core.is_bottom {
            if term.kind == .Unreachable && term.flag {
                stats.total_checks = stats.total_checks +% 1_usize;
                stats.proven_checks = stats.proven_checks +% 1_usize;
            }
            ri = ri +% 1_usize;
            continue;
        }
        ctx.tmp_pool.clear();
        try verify_terminator(
            alloc, &term, insts, &ctx.work_st, &ctx.preds, &mut ctx.tmp_pool, &mut ctx.tmp_st,
            arena, eir_prog, fn_id, f, env, interner, diags, &mut stats, &mut ctx.sym_scratch, &mut ctx.note_buf,
        );
        ri = ri +% 1_usize;
    }

    sort_val_ranges(out_ranges.as_mut_slice());
    sort_proven_safe(out_proven.as_mut_slice());
    stats.proven_safe_insts = out_proven.len();
    stats.ranged_values = out_ranges.len();

    prof.fn_count = prof.fn_count +% 1_u64;
    prof.block_transfers = prof.block_transfers +% ctx.prof_block_transfers;
    prof.saves = prof.saves +% ctx.spool.prof_saves +% ctx.tmp_pool.prof_saves;
    prof.edge_saves = prof.edge_saves +% ctx.spool.prof_edge_saves +% ctx.tmp_pool.prof_edge_saves;
    prof.loads = prof.loads +% ctx.work_st.prof_loads +% ctx.tmp_st.prof_loads;
    prof.copies = prof.copies +% ctx.work_st.prof_copies +% ctx.tmp_st.prof_copies;
    prof.sorts = prof.sorts +% ctx.spool.prof_sorts +% ctx.tmp_pool.prof_sorts;
    prof.already_sorted = prof.already_sorted +% ctx.spool.prof_already_sorted +% ctx.tmp_pool.prof_already_sorted;
    prof.total_iv_saved = prof.total_iv_saved +% ctx.spool.prof_total_iv_saved +% ctx.tmp_pool.prof_total_iv_saved;
    prof.total_mat_saved = prof.total_mat_saved +% ctx.spool.prof_total_mat_saved +% ctx.tmp_pool.prof_total_mat_saved;
    prof.fixpoint_iters = prof.fixpoint_iters +% ctx.prof_fixpoint_iters;
    prof.narrow_iters = prof.narrow_iters +% ctx.prof_narrow_iters;
    prof.widens = prof.widens +% ctx.prof_widens;
    prof.compacts = prof.compacts +% ctx.prof_compacts;
    let fn_peak_iv = ctx.spool.prof_peak_iv;
    let fn_peak_mat = ctx.spool.prof_peak_mat;
    if fn_peak_iv > prof.peak_spool_iv {
        prof.peak_spool_iv = fn_peak_iv;
    }
    if fn_peak_mat > prof.peak_spool_mat {
        prof.peak_spool_mat = fn_peak_mat;
    }
    if fn_peak_iv > prof.max_fn_iv_pool || (fn_peak_iv == prof.max_fn_iv_pool && fn_peak_mat > prof.max_fn_mat_pool) {
        prof.max_fn_id = fn_id;
        prof.max_fn_blocks = n_blocks.trunc.[u32]();
        prof.max_fn_iv_pool = fn_peak_iv;
        prof.max_fn_mat_pool = fn_peak_mat;
    }

    loops.destroy(alloc);
    return stats;
}

linear struct WorkerVerifyOut {
    oom: bool;
    infos: col.DynBuf[FnVerifyInfo];
    ranges_pool: col.DynBuf[eir.EirValRange];
    ranges_spans: col.DynBuf[ast.IdRange];
    proven_pool: col.DynBuf[eir.EirProvenSafeInst];
    proven_spans: col.DynBuf[ast.IdRange];
    facts_pool: col.DynBuf[eir.EirValueFact];
    facts_spans: col.DynBuf[ast.IdRange];
    flags_pool: col.DynBuf[ProvenInstFlag];
    flags_spans: col.DynBuf[ast.IdRange];
    diags_pool: diag.DiagBag;
    diag_spans: col.DynBuf[ast.IdRange];
    prof: VerifyProfStats;
}

impl WorkerVerifyOut {
    fn init(alloc: *mut AllocCap) -> WorkerVerifyOut ! OutOfMemory {
        let infos = try col.DynBuf.[FnVerifyInfo].init(alloc, 32_usize);
        errdefer infos.destroy(alloc);
        let ranges_pool = try col.DynBuf.[eir.EirValRange].init(alloc, 64_usize);
        errdefer ranges_pool.destroy(alloc);
        let ranges_spans = try col.DynBuf.[ast.IdRange].init(alloc, 32_usize);
        errdefer ranges_spans.destroy(alloc);
        let proven_pool = try col.DynBuf.[eir.EirProvenSafeInst].init(alloc, 64_usize);
        errdefer proven_pool.destroy(alloc);
        let proven_spans = try col.DynBuf.[ast.IdRange].init(alloc, 32_usize);
        errdefer proven_spans.destroy(alloc);
        let facts_pool = try col.DynBuf.[eir.EirValueFact].init(alloc, 128_usize);
        errdefer facts_pool.destroy(alloc);
        let facts_spans = try col.DynBuf.[ast.IdRange].init(alloc, 32_usize);
        errdefer facts_spans.destroy(alloc);
        let flags_pool = try col.DynBuf.[ProvenInstFlag].init(alloc, 64_usize);
        errdefer flags_pool.destroy(alloc);
        let flags_spans = try col.DynBuf.[ast.IdRange].init(alloc, 32_usize);
        errdefer flags_spans.destroy(alloc);
        let diags_pool = try diag.DiagBag.init(alloc);
        errdefer diags_pool.destroy(alloc);
        let diag_spans = try col.DynBuf.[ast.IdRange].init(alloc, 32_usize);
        errdefer diag_spans.destroy(alloc);
        return WorkerVerifyOut.{
            oom: false,
            infos: infos,
            ranges_pool: ranges_pool,
            ranges_spans: ranges_spans,
            proven_pool: proven_pool,
            proven_spans: proven_spans,
            facts_pool: facts_pool,
            facts_spans: facts_spans,
            flags_pool: flags_pool,
            flags_spans: flags_spans,
            diags_pool: diags_pool,
            diag_spans: diag_spans,
            prof: verify_prof_zero(),
        };
    }

    fn destroy(self: WorkerVerifyOut, alloc: *mut AllocCap) {
        let WorkerVerifyOut.{
            oom: _,
            infos,
            ranges_pool,
            ranges_spans,
            proven_pool,
            proven_spans,
            facts_pool,
            facts_spans,
            flags_pool,
            flags_spans,
            diags_pool,
            diag_spans,
            prof: _,
        } = self;
        infos.destroy(alloc);
        ranges_pool.destroy(alloc);
        ranges_spans.destroy(alloc);
        proven_pool.destroy(alloc);
        proven_spans.destroy(alloc);
        facts_pool.destroy(alloc);
        facts_spans.destroy(alloc);
        flags_pool.destroy(alloc);
        flags_spans.destroy(alloc);
        diags_pool.destroy(alloc);
        diag_spans.destroy(alloc);
    }
}

fn verify_worker_loop(
    wi: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    fn_loc: *mut [u64],
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    out: *mut WorkerVerifyOut,
) -> !OutOfMemory {
    var ctx = try FnVerifyCtx.init(alloc, 16_usize);
    errdefer ctx.destroy(alloc);
    var range_idx_map = try col.HashMap.[u32].init(alloc, 32_usize);
    errdefer range_idx_map.destroy(alloc);
    var ranges_buf = try col.DynBuf.[eir.EirValRange].init(alloc, 32_usize);
    errdefer ranges_buf.destroy(alloc);
    var proven_buf = try col.DynBuf.[eir.EirProvenSafeInst].init(alloc, 32_usize);
    errdefer proven_buf.destroy(alloc);
    var facts_buf = try col.DynBuf.[eir.EirValueFact].init(alloc, 64_usize);
    errdefer facts_buf.destroy(alloc);
    var inst_flags_buf = try col.DynBuf.[ProvenInstFlag].init(alloc, 32_usize);
    errdefer inst_flags_buf.destroy(alloc);

    loop {
        let pos = next_pos.fetch_add(1_u64, .AcqRel);
        let pu = pos.trunc.[usize]();
        if pu >= work_order.len {
            break;
        }
        let fi = work_order[pu];
        let fiu = fi.widen.[usize]();
        let d_start = out.diags_pool.count().trunc.[u32]();
        let info = try verify_function(
            alloc, &mut ctx, &mut range_idx_map, arena, eir_prog, fi, env, interner, &mut out.diags_pool,
            &mut ranges_buf, &mut proven_buf, &mut facts_buf, &mut inst_flags_buf,
            &mut out.prof,
        );
        let d_len = out.diags_pool.count().trunc.[u32]() -% d_start;

        let local_idx = out.infos.len().trunc.[u32]();
        try out.infos.push(alloc, info);
        try out.diag_spans.push(alloc, ast.range_new(d_start, d_len));

        let rs = out.ranges_pool.len().trunc.[u32]();
        try out.ranges_pool.push_slice(alloc, ranges_buf.as_slice());
        try out.ranges_spans.push(alloc, ast.range_new(rs, ranges_buf.len().trunc.[u32]()));

        let ps = out.proven_pool.len().trunc.[u32]();
        try out.proven_pool.push_slice(alloc, proven_buf.as_slice());
        try out.proven_spans.push(alloc, ast.range_new(ps, proven_buf.len().trunc.[u32]()));

        let fs = out.facts_pool.len().trunc.[u32]();
        try out.facts_pool.push_slice(alloc, facts_buf.as_slice());
        try out.facts_spans.push(alloc, ast.range_new(fs, facts_buf.len().trunc.[u32]()));

        let fls = out.flags_pool.len().trunc.[u32]();
        try out.flags_pool.push_slice(alloc, inst_flags_buf.as_slice());
        try out.flags_spans.push(alloc, ast.range_new(fls, inst_flags_buf.len().trunc.[u32]()));

        if fiu < fn_loc.len {
            fn_loc[fiu] = ((wi +% 1_u32).widen.[u64]() <<% 32_u64) | local_idx.widen.[u64]();
        }
    }

    inst_flags_buf.destroy(alloc);
    facts_buf.destroy(alloc);
    proven_buf.destroy(alloc);
    ranges_buf.destroy(alloc);
    range_idx_map.destroy(alloc);
    ctx.destroy(alloc);
    return;
}

fn run_verify_worker_entry(
    wi: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    fn_loc: *mut [u64],
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    out: *mut WorkerVerifyOut,
) {
    verify_worker_loop(wi, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, out) catch {
        out.oom = true;
    };
}

fn dispatch_verify_workers(
    n_workers: usize,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    fn_loc: *mut [u64],
    arena: *ast.AstArena,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    w0: *mut WorkerVerifyOut,
    w1: *mut WorkerVerifyOut,
    w2: *mut WorkerVerifyOut,
    w3: *mut WorkerVerifyOut,
    w4: *mut WorkerVerifyOut,
    w5: *mut WorkerVerifyOut,
    w6: *mut WorkerVerifyOut,
    w7: *mut WorkerVerifyOut,
    w8: *mut WorkerVerifyOut,
    w9: *mut WorkerVerifyOut,
    w10: *mut WorkerVerifyOut,
    w11: *mut WorkerVerifyOut,
) {
    par for wi in 0_usize..n_workers {
        if wi == 0_usize {
            run_verify_worker_entry(0_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w0);
        } else if wi == 1_usize {
            run_verify_worker_entry(1_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w1);
        } else if wi == 2_usize {
            run_verify_worker_entry(2_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w2);
        } else if wi == 3_usize {
            run_verify_worker_entry(3_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w3);
        } else if wi == 4_usize {
            run_verify_worker_entry(4_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w4);
        } else if wi == 5_usize {
            run_verify_worker_entry(5_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w5);
        } else if wi == 6_usize {
            run_verify_worker_entry(6_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w6);
        } else if wi == 7_usize {
            run_verify_worker_entry(7_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w7);
        } else if wi == 8_usize {
            run_verify_worker_entry(8_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w8);
        } else if wi == 9_usize {
            run_verify_worker_entry(9_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w9);
        } else if wi == 10_usize {
            run_verify_worker_entry(10_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w10);
        } else if wi == 11_usize {
            run_verify_worker_entry(11_u32, alloc, next_pos, work_order, fn_loc, arena, eir_prog, env, interner, w11);
        }
    }
}

fn commit_worker_fn_result(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    diags: *mut diag.DiagBag,
    fi: u32,
    li: usize,
    w: *WorkerVerifyOut,
) -> FnVerifyInfo ! OutOfMemory {
    let info = if let p = w.infos.get(li) { p.* } else { fn_verify_default() };
    if let rs = w.ranges_spans.get(li) {
        try eir_prog.set_fn_value_ranges(alloc, fi, slice_range.[eir.EirValRange](w.ranges_pool.as_slice(), rs.*));
    }
    if let ps = w.proven_spans.get(li) {
        try eir_prog.set_fn_proven_safe_insts(alloc, fi, slice_range.[eir.EirProvenSafeInst](w.proven_pool.as_slice(), ps.*));
    }
    if let fs = w.facts_spans.get(li) {
        try eir_prog.set_fn_value_facts(alloc, fi, slice_range.[eir.EirValueFact](w.facts_pool.as_slice(), fs.*));
    }
    if let fls = w.flags_spans.get(li) {
        let fl_sl = slice_range.[ProvenInstFlag](w.flags_pool.as_slice(), fls.*);
        var fli: usize = 0_usize;
        while fli < fl_sl.len {
            try eir_prog.mark_inst_proven(alloc, fl_sl[fli].global_inst_idx, fl_sl[fli].flags);
            fli = fli +% 1_usize;
        }
    }
    if let ds = w.diag_spans.get(li) {
        if ds.len > 0_u32 {
            try diags.append_diag_range(alloc, &w.diags_pool, ds.start, ds.len);
        }
    }
    return info;
}

fn merge_verify_prof(dst: *mut VerifyProfStats, src: *VerifyProfStats) {
    dst.fn_count = dst.fn_count +% src.fn_count;
    dst.block_transfers = dst.block_transfers +% src.block_transfers;
    dst.saves = dst.saves +% src.saves;
    dst.edge_saves = dst.edge_saves +% src.edge_saves;
    dst.loads = dst.loads +% src.loads;
    dst.copies = dst.copies +% src.copies;
    dst.sorts = dst.sorts +% src.sorts;
    dst.already_sorted = dst.already_sorted +% src.already_sorted;
    dst.total_iv_saved = dst.total_iv_saved +% src.total_iv_saved;
    dst.total_mat_saved = dst.total_mat_saved +% src.total_mat_saved;
    dst.fixpoint_iters = dst.fixpoint_iters +% src.fixpoint_iters;
    dst.narrow_iters = dst.narrow_iters +% src.narrow_iters;
    dst.widens = dst.widens +% src.widens;
    dst.compacts = dst.compacts +% src.compacts;
    if src.peak_spool_iv > dst.peak_spool_iv {
        dst.peak_spool_iv = src.peak_spool_iv;
    }
    if src.peak_spool_mat > dst.peak_spool_mat {
        dst.peak_spool_mat = src.peak_spool_mat;
    }
    if src.max_fn_iv_pool > dst.max_fn_iv_pool
        || (src.max_fn_iv_pool == dst.max_fn_iv_pool && src.max_fn_mat_pool > dst.max_fn_mat_pool)
        || (src.max_fn_iv_pool == dst.max_fn_iv_pool && src.max_fn_mat_pool == dst.max_fn_mat_pool && src.max_fn_id < dst.max_fn_id)
    {
        dst.max_fn_id = src.max_fn_id;
        dst.max_fn_blocks = src.max_fn_blocks;
        dst.max_fn_iv_pool = src.max_fn_iv_pool;
        dst.max_fn_mat_pool = src.max_fn_mat_pool;
    }
}

fn weight_of(weights: *[u32], fi: u32) -> u32 {
    let idx = fi.widen.[usize]();
    if idx < weights.len {
        return weights[idx];
    }
    return 0_u32;
}

fn sort_work_order_desc(order: *mut [u32], weights: *[u32]) {
    let n = order.len;
    if n < 2_usize {
        return;
    }
    // Min-heap by weight (descending sort puts largest weight first).
    var i = n >> 1_usize;
    while i > 0_usize {
        i = i - 1_usize;
        var root = i;
        while (root *% 2_usize) +% 1_usize < n {
            var child = (root *% 2_usize) +% 1_usize;
            if child >= order.len { break; }
            let right = child +% 1_usize;
            let cw = weight_of(weights, order[child]);
            if right < n && right < order.len {
                let rw = weight_of(weights, order[right]);
                if rw < cw || (rw == cw && order[right] > order[child]) {
                    child = right;
                }
            }
            if root >= order.len { break; }
            let root_w = weight_of(weights, order[root]);
            let ch_w = weight_of(weights, order[child]);
            if root_w < ch_w || (root_w == ch_w && order[root] >= order[child]) {
                break;
            }
            let tmp = order[root];
            order[root] = order[child];
            order[child] = tmp;
            root = child;
        }
    }
    var end = order.len;
    while end > 1_usize && end <= order.len {
        end = end - 1_usize;
        let tmp = order[0_usize];
        order[0_usize] = order[end];
        order[end] = tmp;
        var root: usize = 0_usize;
        while (root *% 2_usize) +% 1_usize < end {
            var child = (root *% 2_usize) +% 1_usize;
            if child >= order.len { break; }
            let right = child +% 1_usize;
            let cw = weight_of(weights, order[child]);
            if right < end && right < order.len {
                let rw = weight_of(weights, order[right]);
                if rw < cw || (rw == cw && order[right] > order[child]) {
                    child = right;
                }
            }
            if root >= order.len { break; }
            let root_w = weight_of(weights, order[root]);
            let ch_w = weight_of(weights, order[child]);
            if root_w < ch_w || (root_w == ch_w && order[root] >= order[child]) {
                break;
            }
            let tmp2 = order[root];
            order[root] = order[child];
            order[child] = tmp2;
            root = child;
        }
    }
}

fn verify_program_parallel(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    env: *types.TypeEnv,
    eir_prog: *mut eir.EirProgram,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    n_workers: usize,
) -> VerifyReport ! OutOfMemory {
    var report = try VerifyReport.init(alloc);
    errdefer report.destroy(alloc);

    let n_fns = eir_prog.fn_count();
    let n_u = n_fns.widen.[usize]();
    var work_order = try col.DynBuf.[u32].init(alloc, n_u);
    errdefer work_order.destroy(alloc);
    var weights = try col.DynBuf.[u32].init(alloc, n_u);
    errdefer weights.destroy(alloc);
    var fn_loc = try col.DynBuf.[u64].init(alloc, n_u);
    errdefer fn_loc.destroy(alloc);

    var fi: u32 = 0_u32;
    while fi < n_fns {
        var blks: u32 = 0_u32;
        if let f = eir_prog.get_fn(fi) {
            blks = f.blocks.len;
            try work_order.push(alloc, fi);
        }
        try weights.push(alloc, blks);
        try fn_loc.push(alloc, 0_u64);
        fi = fi +% 1_u32;
    }
    sort_work_order_desc(work_order.as_mut_slice(), weights.as_slice());

    var w0 = try WorkerVerifyOut.init(alloc);
    errdefer w0.destroy(alloc);
    var w1 = try WorkerVerifyOut.init(alloc);
    errdefer w1.destroy(alloc);
    var w2 = try WorkerVerifyOut.init(alloc);
    errdefer w2.destroy(alloc);
    var w3 = try WorkerVerifyOut.init(alloc);
    errdefer w3.destroy(alloc);
    var w4 = try WorkerVerifyOut.init(alloc);
    errdefer w4.destroy(alloc);
    var w5 = try WorkerVerifyOut.init(alloc);
    errdefer w5.destroy(alloc);
    var w6 = try WorkerVerifyOut.init(alloc);
    errdefer w6.destroy(alloc);
    var w7 = try WorkerVerifyOut.init(alloc);
    errdefer w7.destroy(alloc);
    var w8 = try WorkerVerifyOut.init(alloc);
    errdefer w8.destroy(alloc);
    var w9 = try WorkerVerifyOut.init(alloc);
    errdefer w9.destroy(alloc);
    var w10 = try WorkerVerifyOut.init(alloc);
    errdefer w10.destroy(alloc);
    var w11 = try WorkerVerifyOut.init(alloc);
    errdefer w11.destroy(alloc);

    var next_pos = sync.AtomicCounter.init(0_u64);
    let nw = if n_workers > 12_usize { 12_usize } else { n_workers };
    dispatch_verify_workers(
        nw, alloc, &mut next_pos, work_order.as_slice(), fn_loc.as_mut_slice(),
        arena, eir_prog, env, interner,
        &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
        &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
    );

    if w0.oom || w1.oom || w2.oom || w3.oom || w4.oom || w5.oom
        || w6.oom || w7.oom || w8.oom || w9.oom || w10.oom || w11.oom
    {
        return .OutOfMemory;
    }

    // Merge worker outputs sequentially in exact `fi = 0..n_fns-1` order for bit-exact determinism!
    let locs = fn_loc.as_slice();
    fi = 0_u32;
    while fi < n_fns {
        var f_key = cfg_ir.fn_key_top_def(resolve.DEF_NONE);
        var have_f = false;
        if let f = eir_prog.get_fn(fi) {
            f_key = f.key;
            have_f = true;
        }
        var info = fn_verify_default();
        let fiu = fi.widen.[usize]();
        if have_f && fiu < locs.len {
            let packed = locs[fiu];
            let wid = (packed >> 32_u64).trunc.[u32]();
            let li = (packed & 0xFFFFFFFF_u64).trunc.[usize]();
            if wid == 1_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w0);
            } else if wid == 2_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w1);
            } else if wid == 3_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w2);
            } else if wid == 4_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w3);
            } else if wid == 5_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w4);
            } else if wid == 6_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w5);
            } else if wid == 7_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w6);
            } else if wid == 8_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w7);
            } else if wid == 9_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w8);
            } else if wid == 10_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w9);
            } else if wid == 11_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w10);
            } else if wid == 12_u32 {
                info = try commit_worker_fn_result(alloc, eir_prog, diags, fi, li, &w11);
            }
        }
        try report.per_fn.push(alloc, info);
        if have_f {
            try report.by_key.insert(alloc, cfg_ir.fn_key_u64(f_key), fi);
        }
        fi = fi +% 1_u32;
    }

    merge_verify_prof(&mut report.prof, &w0.prof);
    merge_verify_prof(&mut report.prof, &w1.prof);
    merge_verify_prof(&mut report.prof, &w2.prof);
    merge_verify_prof(&mut report.prof, &w3.prof);
    merge_verify_prof(&mut report.prof, &w4.prof);
    merge_verify_prof(&mut report.prof, &w5.prof);
    merge_verify_prof(&mut report.prof, &w6.prof);
    merge_verify_prof(&mut report.prof, &w7.prof);
    merge_verify_prof(&mut report.prof, &w8.prof);
    merge_verify_prof(&mut report.prof, &w9.prof);
    merge_verify_prof(&mut report.prof, &w10.prof);
    merge_verify_prof(&mut report.prof, &w11.prof);

    w11.destroy(alloc);
    w10.destroy(alloc);
    w9.destroy(alloc);
    w8.destroy(alloc);
    w7.destroy(alloc);
    w6.destroy(alloc);
    w5.destroy(alloc);
    w4.destroy(alloc);
    w3.destroy(alloc);
    w2.destroy(alloc);
    w1.destroy(alloc);
    w0.destroy(alloc);
    fn_loc.destroy(alloc);
    weights.destroy(alloc);
    work_order.destroy(alloc);
    return report;
}

fn resolve_verify_workers(jobs: u32, n_fns: u32) -> usize {
    if jobs == 1_u32 || n_fns < 32_u32 {
        return 1_usize;
    }
    if jobs > 0_u32 {
        let j = jobs.widen.[usize]();
        return if j > 12_usize { 12_usize } else { j };
    }
    // Auto mode: bounded workers scaling gently with function count.
    if n_fns < 192_u32 {
        return 4_usize;
    }
    if n_fns < 480_u32 {
        return 8_usize;
    }
    return 12_usize;
}

fn verify_program_core(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    eir_prog: *mut eir.EirProgram,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    jobs: u32,
) -> VerifyReport ! OutOfMemory {
    _ = prog;
    let n_fns = eir_prog.fn_count();
    let nw = resolve_verify_workers(jobs, n_fns);
    if nw > 1_usize {
        return try verify_program_parallel(alloc, arena, env, eir_prog, interner, diags, nw);
    }

    var report = try VerifyReport.init(alloc);
    errdefer report.destroy(alloc);

    var ctx = try FnVerifyCtx.init(alloc, 16_usize);
    errdefer ctx.destroy(alloc);
    var range_idx_map = try col.HashMap.[u32].init(alloc, 32_usize);
    errdefer range_idx_map.destroy(alloc);
    var ranges_buf = try col.DynBuf.[eir.EirValRange].init(alloc, 32_usize);
    errdefer ranges_buf.destroy(alloc);
    var proven_buf = try col.DynBuf.[eir.EirProvenSafeInst].init(alloc, 32_usize);
    errdefer proven_buf.destroy(alloc);
    var facts_buf = try col.DynBuf.[eir.EirValueFact].init(alloc, 64_usize);
    errdefer facts_buf.destroy(alloc);
    var inst_flags_buf = try col.DynBuf.[ProvenInstFlag].init(alloc, 32_usize);
    errdefer inst_flags_buf.destroy(alloc);

    var fi: u32 = 0_u32;
    while fi < n_fns {
        var f_key = cfg_ir.fn_key_top_def(resolve.DEF_NONE);
        var have_f = false;
        if let f = eir_prog.get_fn(fi) {
            f_key = f.key;
            have_f = true;
        }
        var info = fn_verify_default();
        if have_f {
            info = try verify_function(
                alloc, &mut ctx, &mut range_idx_map, arena, eir_prog, fi, env, interner, diags,
                &mut ranges_buf, &mut proven_buf, &mut facts_buf, &mut inst_flags_buf,
                &mut report.prof,
            );
            try eir_prog.set_fn_value_ranges(alloc, fi, ranges_buf.as_slice());
            try eir_prog.set_fn_proven_safe_insts(alloc, fi, proven_buf.as_slice());
            try eir_prog.set_fn_value_facts(alloc, fi, facts_buf.as_slice());
            let fls = inst_flags_buf.as_slice();
            var fli: usize = 0_usize;
            while fli < fls.len {
                try eir_prog.mark_inst_proven(alloc, fls[fli].global_inst_idx, fls[fli].flags);
                fli = fli +% 1_usize;
            }
        }
        try report.per_fn.push(alloc, info);
        if have_f {
            try report.by_key.insert(alloc, cfg_ir.fn_key_u64(f_key), fi);
        }
        fi = fi +% 1_u32;
    }

    inst_flags_buf.destroy(alloc);
    facts_buf.destroy(alloc);
    proven_buf.destroy(alloc);
    ranges_buf.destroy(alloc);
    range_idx_map.destroy(alloc);
    ctx.destroy(alloc);
    return report;
}

/// Public entry point: verify all EIR functions with the relational DBM + interval + known-bits verifier.
pub fn format_verify_prof(
    alloc: *mut AllocCap,
    p: *VerifyProfStats,
    eir_prog: *eir.EirProgram,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    try out.push_str_grow(alloc, "[profile-verify] fns=");
    try out.push_u64_grow(alloc, p.fn_count);
    try out.push_str_grow(alloc, " xfers=");
    try out.push_u64_grow(alloc, p.block_transfers);
    try out.push_str_grow(alloc, " saves=");
    try out.push_u64_grow(alloc, p.saves);
    try out.push_str_grow(alloc, " (edge=");
    try out.push_u64_grow(alloc, p.edge_saves);
    try out.push_str_grow(alloc, ") loads=");
    try out.push_u64_grow(alloc, p.loads);
    try out.push_str_grow(alloc, " copies=");
    try out.push_u64_grow(alloc, p.copies);
    try out.push_str_grow(alloc, " sorts=");
    try out.push_u64_grow(alloc, p.sorts);
    try out.push_str_grow(alloc, " sorted_skip=");
    try out.push_u64_grow(alloc, p.already_sorted);
    try out.push_str_grow(alloc, " iv_saved=");
    try out.push_u64_grow(alloc, p.total_iv_saved);
    try out.push_str_grow(alloc, " mat_saved=");
    try out.push_u64_grow(alloc, p.total_mat_saved);
    try out.push_str_grow(alloc, " fix_iters=");
    try out.push_u64_grow(alloc, p.fixpoint_iters);
    try out.push_str_grow(alloc, " narrow=");
    try out.push_u64_grow(alloc, p.narrow_iters);
    try out.push_str_grow(alloc, " widens=");
    try out.push_u64_grow(alloc, p.widens);
    try out.push_str_grow(alloc, " compacts=");
    try out.push_u64_grow(alloc, p.compacts);
    try out.push_str_grow(alloc, " peak_iv=");
    try out.push_u64_grow(alloc, p.peak_spool_iv);
    try out.push_str_grow(alloc, " peak_mat=");
    try out.push_u64_grow(alloc, p.peak_spool_mat);
    try out.push_str_grow(alloc, " max_fn=#");
    try out.push_u64_grow(alloc, p.max_fn_id.widen.[u64]());
    if let f = eir_prog.get_fn(p.max_fn_id) {
        try out.push_byte_grow(alloc, b'(');
        try out.push_bytes_grow(alloc, interner.get(f.mod_name));
        try out.push_str_grow(alloc, "::");
        try out.push_bytes_grow(alloc, interner.get(f.name));
        try out.push_byte_grow(alloc, b')');
    }
    try out.push_str_grow(alloc, " blks=");
    try out.push_u64_grow(alloc, p.max_fn_blocks.widen.[u64]());
    try out.push_byte_grow(alloc, b'\n');
    return;
}

pub fn verify_program(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    eir_prog: *mut eir.EirProgram,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
) -> VerifyReport ! OutOfMemory {
    return try verify_program_core(alloc, arena, prog, env, eir_prog, interner, diags, 1_u32);
}

pub fn verify_program_with_jobs(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    eir_prog: *mut eir.EirProgram,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    jobs: u32,
) -> VerifyReport ! OutOfMemory {
    return try verify_program_core(alloc, arena, prog, env, eir_prog, interner, diags, jobs);
}

/// Phase 9 `EIR-Opt` entry point: verifies all EIR functions and exports DBM + interval + KnownBits
/// `EirValueFact` tables and `proven_safe_insts` bitmask flags onto `eir_prog`.
pub fn verify_program_with_facts(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    eir_prog: *mut eir.EirProgram,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
) -> VerifyReport ! OutOfMemory {
    return try verify_program_core(alloc, arena, prog, env, eir_prog, interner, diags, 1_u32);
}

pub fn verify_program_with_facts_and_jobs(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    eir_prog: *mut eir.EirProgram,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
    jobs: u32,
) -> VerifyReport ! OutOfMemory {
    return try verify_program_core(alloc, arena, prog, env, eir_prog, interner, diags, jobs);
}

// ===========================================================================
// Section 12: Canonical Verification Dump (`dump_verify_canonical`)
// ===========================================================================

struct VerifyDumpEntry {
    key_off: u32;
    key_len: u32;
    line_off: u32;
    line_len: u32;
}

fn bytes_cmp(a: *[u8], b: *[u8]) -> i32 {
    let n = if a.len < b.len { a.len } else { b.len };
    var i: usize = 0_usize;
    while i < n {
        if a[i] < b[i] {
            return -1_i32;
        }
        if a[i] > b[i] {
            return 1_i32;
        }
        i = i +% 1_usize;
    }
    if a.len < b.len {
        return -1_i32;
    }
    if a.len > b.len {
        return 1_i32;
    }
    return 0_i32;
}

fn dump_entry_less(keys: *[u8], lines: *[u8], a: VerifyDumpEntry, b: VerifyDumpEntry) -> bool {
    let ka = slice_range.[u8](keys, ast.range_new(a.key_off, a.key_len));
    let kb = slice_range.[u8](keys, ast.range_new(b.key_off, b.key_len));
    let c = bytes_cmp(ka, kb);
    if c != 0_i32 {
        return c < 0_i32;
    }
    let la = slice_range.[u8](lines, ast.range_new(a.line_off, a.line_len));
    let lb = slice_range.[u8](lines, ast.range_new(b.line_off, b.line_len));
    return bytes_cmp(la, lb) < 0_i32;
}

fn sort_verify_dump_entries(keys: *[u8], lines: *[u8], xs: *mut [VerifyDumpEntry]) {
    let n = xs.len;
    if n < 2_usize {
        return;
    }
    var i = n >> 1_usize;
    while i > 0_usize {
        i = i - 1_usize;
        var root = i;
        while (root *% 2_usize) +% 1_usize < n {
            let child = (root *% 2_usize) +% 1_usize;
            var sw = root;
            if sw < xs.len && child < xs.len && dump_entry_less(keys, lines, xs[sw], xs[child]) {
                sw = child;
            }
            let right = child +% 1_usize;
            if right < n && sw < xs.len && right < xs.len && dump_entry_less(keys, lines, xs[sw], xs[right]) {
                sw = right;
            }
            if sw == root {
                break;
            }
            if root < xs.len && sw < xs.len {
                let tmp = xs[root];
                xs[root] = xs[sw];
                xs[sw] = tmp;
            }
            root = sw;
        }
    }
    var end = n;
    while end > 1_usize {
        end = end - 1_usize;
        let top = xs[0_usize];
        xs[0_usize] = xs[end];
        xs[end] = top;
        var root: usize = 0_usize;
        while (root *% 2_usize) +% 1_usize < end {
            let child = (root *% 2_usize) +% 1_usize;
            var sw = root;
            if sw < xs.len && child < xs.len && dump_entry_less(keys, lines, xs[sw], xs[child]) {
                sw = child;
            }
            let right = child +% 1_usize;
            if right < end && sw < xs.len && right < xs.len && dump_entry_less(keys, lines, xs[sw], xs[right]) {
                sw = right;
            }
            if sw == root {
                break;
            }
            if root < xs.len && sw < xs.len {
                let tmp = xs[root];
                xs[root] = xs[sw];
                xs[sw] = tmp;
            }
            root = sw;
        }
    }
}

fn push_effects_tags(
    alloc: *mut AllocCap,
    einfo: *effects.FnEffectsInfo,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    var count: usize = 0_usize;
    if einfo.can_mutate {
        try out.push_str_grow(alloc, "mut");
        count = count +% 1_usize;
    }
    if einfo.can_alloc {
        if count > 0_usize {
            try out.push_byte_grow(alloc, b',');
        }
        try out.push_str_grow(alloc, "alloc");
        count = count +% 1_usize;
    }
    if einfo.can_block {
        if count > 0_usize {
            try out.push_byte_grow(alloc, b',');
        }
        try out.push_str_grow(alloc, "block");
        count = count +% 1_usize;
    }
    if einfo.uses_extern_c {
        if count > 0_usize {
            try out.push_byte_grow(alloc, b',');
        }
        try out.push_str_grow(alloc, "extern_c");
        count = count +% 1_usize;
    }
    if count == 0_usize {
        try out.push_str_grow(alloc, "pure");
    }
    return;
}

/// Canonical `--dump-verify` output matching `compiler/src/lib.rs::dump_verify_canonical` byte-for-byte.
pub fn dump_verify_canonical(
    alloc: *mut AllocCap,
    cfg: *cfg_ir.CfgProgram,
    eff: *effects.EffectsReport,
    ver: *VerifyReport,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    _ = prog;
    _ = env;
    let n_fns = cfg.fn_count();
    let cap_e = if n_fns < 4_u32 { 4_usize } else { n_fns.widen.[usize]() };
    var entries = try col.DynBuf.[VerifyDumpEntry].init(alloc, cap_e);
    errdefer entries.destroy(alloc);
    var keys_buf = try str.StrBuf.init(alloc, 256_usize);
    errdefer keys_buf.destroy(alloc);
    var lines_buf = try str.StrBuf.init(alloc, 512_usize);
    errdefer lines_buf.destroy(alloc);
    var eff_buf = try str.StrBuf.init(alloc, 32_usize);
    errdefer eff_buf.destroy(alloc);

    var fi: u32 = 0_u32;
    while fi < n_fns {
        if let f = cfg.get_fn(fi) {
            let name = interner.get(f.name);
            var einfo = eff.get_by_key(cfg, f.key) orelse effects.fn_effects_default();
            if f.key.kind == .GenericInst && f.has_base_generic {
                if let e_direct = eff.get_fn(fi) {
                    einfo = e_direct;
                } else if let e_base = eff.get_by_key(cfg, f.base_generic_key) {
                    einfo = e_base;
                }
            }
            let vinfo = ver.get_by_key(f.key) orelse fn_verify_default();

            eff_buf.clear();
            try push_effects_tags(alloc, &einfo, &mut eff_buf);
            let eff_bytes = eff_buf.as_bytes();
            let rec_str: *str = if einfo.is_recursive { "true" } else { "false" };

            let line_off = lines_buf.len().trunc.[u32]();
            try lines_buf.push_str_grow(alloc, "verify ");
            try cfg_ir.write_fn_key_kind(alloc, f.key, f.is_sys, &mut lines_buf);
            try lines_buf.push_byte_grow(alloc, b' ');
            try lines_buf.push_bytes_grow(alloc, name);
            try lines_buf.push_str_grow(alloc, " effects=[");
            try lines_buf.push_bytes_grow(alloc, eff_bytes);
            try lines_buf.push_str_grow(alloc, "] is_recursive=");
            try lines_buf.push_str_grow(alloc, rec_str);
            try lines_buf.push_str_grow(alloc, " stack_bytes=");
            try lines_buf.push_u64_grow(alloc, einfo.total_stack_bytes);
            try lines_buf.push_str_grow(alloc, " checks=");
            try lines_buf.push_u64_grow(alloc, vinfo.proven_checks.widen.[u64]());
            try lines_buf.push_byte_grow(alloc, b'/');
            try lines_buf.push_u64_grow(alloc, vinfo.total_checks.widen.[u64]());
            try lines_buf.push_byte_grow(alloc, b'\n');
            let line_len = lines_buf.len().trunc.[u32]() -% line_off;

            let key_off = keys_buf.len().trunc.[u32]();
            try keys_buf.push_bytes_grow(alloc, name);
            try keys_buf.push_byte_grow(alloc, 9_u8);
            try cfg_ir.write_fn_key_kind(alloc, f.key, f.is_sys, &mut keys_buf);
            try keys_buf.push_byte_grow(alloc, 9_u8);
            try keys_buf.push_u64_grow(alloc, f.params.len.widen.[u64]());
            try keys_buf.push_byte_grow(alloc, 9_u8);
            try keys_buf.push_bytes_grow(alloc, eff_bytes);
            try keys_buf.push_byte_grow(alloc, 9_u8);
            try keys_buf.push_str_grow(alloc, rec_str);
            try keys_buf.push_byte_grow(alloc, 9_u8);
            try keys_buf.push_u64_grow(alloc, einfo.total_stack_bytes);
            try keys_buf.push_byte_grow(alloc, 9_u8);
            try keys_buf.push_u64_grow(alloc, vinfo.proven_checks.widen.[u64]());
            try keys_buf.push_byte_grow(alloc, 9_u8);
            try keys_buf.push_u64_grow(alloc, vinfo.total_checks.widen.[u64]());
            let key_len = keys_buf.len().trunc.[u32]() -% key_off;

            try entries.push(
                alloc,
                VerifyDumpEntry.{
                    key_off: key_off,
                    key_len: key_len,
                    line_off: line_off,
                    line_len: line_len,
                },
            );
        }
        fi = fi +% 1_u32;
    }

    sort_verify_dump_entries(keys_buf.as_bytes(), lines_buf.as_bytes(), entries.as_mut_slice());
    let sorted = entries.as_slice();
    let all_lines = lines_buf.as_bytes();
    var ei: usize = 0_usize;
    while ei < sorted.len {
        let e = sorted[ei];
        try out.push_bytes_grow(alloc, slice_range.[u8](all_lines, ast.range_new(e.line_off, e.line_len)));
        ei = ei +% 1_usize;
    }

    eff_buf.destroy(alloc);
    lines_buf.destroy(alloc);
    keys_buf.destroy(alloc);
    entries.destroy(alloc);
    return;
}
