module eonc.check;

import core.col;
import core.str;
import core.sync;
import eonc.span;
import eonc.diag;
import eonc.ast;
import eonc.resolve;
import eonc.types;
import eonc.ctvm;

// ===========================================================================
// Section 1: TypeTable, Call/Dyn Metadata, and Type Substitution Helpers
// ===========================================================================

const FNV_OFFSET: u64 = 0xCBF29CE484222325_u64;
const FNV_PRIME: u64 = 0x100000001B3_u64;

fn mix_u32(h: u64, v: u32) -> u64 {
    var cur = (h ^ (v & 0xFF_u32).widen.[u64]()) *% FNV_PRIME;
    cur = (cur ^ ((v >> 8_u32) & 0xFF_u32).widen.[u64]()) *% FNV_PRIME;
    cur = (cur ^ ((v >> 16_u32) & 0xFF_u32).widen.[u64]()) *% FNV_PRIME;
    cur = (cur ^ ((v >> 24_u32) & 0xFF_u32).widen.[u64]()) *% FNV_PRIME;
    return cur;
}

pub fn span_key(sp: span.Span) -> u64 {
    var h = mix_u32(FNV_OFFSET, sp.file);
    h = mix_u32(h, sp.start);
    h = mix_u32(h, sp.end);
    h = h ^ (h >> 33_u64);
    return h;
}

view fn slice_id_range[T](all: *[T], r: ast.IdRange) -> *[T] {
    let start = r.start.widen.[usize]();
    let end = start +% r.len.widen.[usize]();
    let s = all.sub(start, end) catch {
        return all.sub(0_usize, 0_usize) catch {
            return all;
        };
    };
    return s;
}

pub enum CallFnKeyKind : u8 {
    TopDef = 0,
    ImplMethod = 1,
}

pub struct CallGenericInst {
    pub expr_id: u32;
    pub span: span.Span;
    pub kind: CallFnKeyKind;
    pub primary: u32;
    pub secondary: u32;
    pub args: ast.IdRange;
}

pub struct DynCoercion {
    pub span: span.Span;
    pub iface_def: u32;
    pub concrete_ty: types.TyId;
}

pub struct DynCall {
    pub expr_id: u32;
    pub span: span.Span;
    pub iface_def: u32;
    pub method_idx: u32;
}

pub struct ResolvedCallTarget {
    pub kind: CallFnKeyKind;
    pub primary: u32;
    pub secondary: u32;
}

pub linear struct TypeTableMeta {
    pub call_insts: col.DynBuf[CallGenericInst];
    pub call_inst_args: col.DynBuf[types.GenericVal];
    pub call_inst_by_expr: col.HashMap[u32];
    pub dyn_coercions: col.DynBuf[DynCoercion];
    pub dyn_coercion_by_span: col.HashMap[u32];
    pub dyn_calls: col.DynBuf[DynCall];
    pub dyn_call_by_expr: col.HashMap[u32];
    pub call_targets: col.DynBuf[ResolvedCallTarget];
    pub call_target_by_expr: col.HashMap[u32];
}

impl TypeTableMeta {
    pub fn init(alloc: *mut AllocCap) -> TypeTableMeta ! OutOfMemory {
        let call_insts = try col.DynBuf.[CallGenericInst].init(alloc, 16_usize);
        errdefer call_insts.destroy(alloc);
        let call_inst_args = try col.DynBuf.[types.GenericVal].init(alloc, 32_usize);
        errdefer call_inst_args.destroy(alloc);
        let call_inst_by_expr = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer call_inst_by_expr.destroy(alloc);
        let dyn_coercions = try col.DynBuf.[DynCoercion].init(alloc, 8_usize);
        errdefer dyn_coercions.destroy(alloc);
        let dyn_coercion_by_span = try col.HashMap.[u32].init(alloc, 8_usize);
        errdefer dyn_coercion_by_span.destroy(alloc);
        let dyn_calls = try col.DynBuf.[DynCall].init(alloc, 8_usize);
        errdefer dyn_calls.destroy(alloc);
        let dyn_call_by_expr = try col.HashMap.[u32].init(alloc, 8_usize);
        errdefer dyn_call_by_expr.destroy(alloc);
        let call_targets = try col.DynBuf.[ResolvedCallTarget].init(alloc, 32_usize);
        errdefer call_targets.destroy(alloc);
        let call_target_by_expr = try col.HashMap.[u32].init(alloc, 32_usize);
        errdefer call_target_by_expr.destroy(alloc);
        return TypeTableMeta.{
            call_insts: call_insts,
            call_inst_args: call_inst_args,
            call_inst_by_expr: call_inst_by_expr,
            dyn_coercions: dyn_coercions,
            dyn_coercion_by_span: dyn_coercion_by_span,
            dyn_calls: dyn_calls,
            dyn_call_by_expr: dyn_call_by_expr,
            call_targets: call_targets,
            call_target_by_expr: call_target_by_expr,
        };
    }

    pub fn destroy(self: TypeTableMeta, alloc: *mut AllocCap) {
        let TypeTableMeta.{
            call_insts,
            call_inst_args,
            call_inst_by_expr,
            dyn_coercions,
            dyn_coercion_by_span,
            dyn_calls,
            dyn_call_by_expr,
            call_targets,
            call_target_by_expr,
        } = self;
        call_insts.destroy(alloc);
        call_inst_args.destroy(alloc);
        call_inst_by_expr.destroy(alloc);
        dyn_coercions.destroy(alloc);
        dyn_coercion_by_span.destroy(alloc);
        dyn_calls.destroy(alloc);
        dyn_call_by_expr.destroy(alloc);
        call_targets.destroy(alloc);
        call_target_by_expr.destroy(alloc);
    }
}

pub linear struct TypeTable {
    pub expr_tys: col.HashMap[u32];
    pub span_tys: col.HashMap[u32];
    pub comptime_vals: col.HashMap[u32];
    pub comptime_branches: col.HashMap[u8];
    pub const_int_map: col.HashMap[u32];
    pub const_ints: col.DynBuf[types.IntVal];
    pub meta: TypeTableMeta;
}

impl TypeTable {
    pub fn init(alloc: *mut AllocCap) -> TypeTable ! OutOfMemory {
        let expr_tys = try col.HashMap.[u32].init(alloc, 128_usize);
        errdefer expr_tys.destroy(alloc);
        let span_tys = try col.HashMap.[u32].init(alloc, 128_usize);
        errdefer span_tys.destroy(alloc);
        let comptime_vals = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer comptime_vals.destroy(alloc);
        let comptime_branches = try col.HashMap.[u8].init(alloc, 16_usize);
        errdefer comptime_branches.destroy(alloc);
        let const_int_map = try col.HashMap.[u32].init(alloc, 16_usize);
        errdefer const_int_map.destroy(alloc);
        let const_ints = try col.DynBuf.[types.IntVal].init(alloc, 16_usize);
        errdefer const_ints.destroy(alloc);
        let meta = try TypeTableMeta.init(alloc);
        errdefer meta.destroy(alloc);
        return TypeTable.{
            expr_tys: expr_tys,
            span_tys: span_tys,
            comptime_vals: comptime_vals,
            comptime_branches: comptime_branches,
            const_int_map: const_int_map,
            const_ints: const_ints,
            meta: meta,
        };
    }

    pub fn destroy(self: TypeTable, alloc: *mut AllocCap) {
        let TypeTable.{
            expr_tys,
            span_tys,
            comptime_vals,
            comptime_branches,
            const_int_map,
            const_ints,
            meta,
        } = self;
        expr_tys.destroy(alloc);
        span_tys.destroy(alloc);
        comptime_vals.destroy(alloc);
        comptime_branches.destroy(alloc);
        const_int_map.destroy(alloc);
        const_ints.destroy(alloc);
        meta.destroy(alloc);
    }

    pub fn set_expr_ty(self: *mut Self, alloc: *mut AllocCap, expr_id: u32, ty: types.TyId) -> !OutOfMemory {
        try self.expr_tys.insert(alloc, expr_id.widen.[u64](), ty);
        return;
    }

    pub fn get_expr_ty(self: *Self, expr_id: u32) -> ?types.TyId {
        return self.expr_tys.get(expr_id.widen.[u64]());
    }

    pub fn set_span_ty(self: *mut Self, alloc: *mut AllocCap, sp: span.Span, ty: types.TyId) -> !OutOfMemory {
        try self.span_tys.insert(alloc, span_key(sp), ty);
        return;
    }

    pub fn get_span_ty(self: *Self, sp: span.Span) -> ?types.TyId {
        return self.span_tys.get(span_key(sp));
    }

    pub fn set_expr_and_span_ty(
        self: *mut Self,
        alloc: *mut AllocCap,
        expr_id: u32,
        sp: span.Span,
        ty: types.TyId,
    ) -> !OutOfMemory {
        try self.expr_tys.insert(alloc, expr_id.widen.[u64](), ty);
        try self.span_tys.insert(alloc, span_key(sp), ty);
        return;
    }

    pub fn set_const_int(
        self: *mut Self,
        alloc: *mut AllocCap,
        expr_id: u32,
        val: types.IntVal,
    ) -> !OutOfMemory {
        let idx = self.const_ints.len().trunc.[u32]();
        try self.const_ints.push(alloc, val);
        try self.const_int_map.insert(alloc, expr_id.widen.[u64](), idx);
        return;
    }

    pub fn get_const_int(self: *Self, expr_id: u32) -> ?types.IntVal {
        let idx = self.const_int_map.get(expr_id.widen.[u64]()) orelse { return null; };
        let cs = self.const_ints.as_slice();
        let ui = idx.widen.[usize]();
        if ui < cs.len {
            return cs[ui];
        }
        return null;
    }

    pub fn set_comptime_branch(
        self: *mut Self,
        alloc: *mut AllocCap,
        if_id: u32,
        taken: bool,
    ) -> !OutOfMemory {
        let b: u8 = if taken { 1_u8 } else { 0_u8 };
        try self.comptime_branches.insert(alloc, if_id.widen.[u64](), b);
        return;
    }

    pub fn get_comptime_branch(self: *Self, if_id: u32) -> ?bool {
        let b = self.comptime_branches.get(if_id.widen.[u64]()) orelse { return null; };
        return b != 0_u8;
    }

    pub fn set_comptime_val(
        self: *mut Self,
        alloc: *mut AllocCap,
        expr_id: u32,
        ct_val_id: u32,
    ) -> !OutOfMemory {
        try self.comptime_vals.insert(alloc, expr_id.widen.[u64](), ct_val_id);
        return;
    }

    pub fn get_comptime_val(self: *Self, expr_id: u32) -> ?u32 {
        return self.comptime_vals.get(expr_id.widen.[u64]());
    }

    pub fn set_call_generic_inst(
        self: *mut Self,
        alloc: *mut AllocCap,
        expr_id: u32,
        sp: span.Span,
        kind: CallFnKeyKind,
        primary: u32,
        secondary: u32,
        args: *[types.GenericVal],
    ) -> !OutOfMemory {
        let astart = self.meta.call_inst_args.len().trunc.[u32]();
        try self.meta.call_inst_args.push_slice(alloc, args);
        let idx = self.meta.call_insts.len().trunc.[u32]();
        try self.meta.call_insts.push(
            alloc,
            CallGenericInst.{
                expr_id: expr_id,
                span: sp,
                kind: kind,
                primary: primary,
                secondary: secondary,
                args: ast.range_new(astart, args.len.trunc.[u32]()),
            },
        );
        try self.meta.call_inst_by_expr.insert(alloc, expr_id.widen.[u64](), idx);
        return;
    }

    pub view fn get_call_generic_inst(self: *Self, expr_id: u32) -> ?*CallGenericInst {
        let idx = self.meta.call_inst_by_expr.get(expr_id.widen.[u64]()) orelse { return null; };
        return self.meta.call_insts.get(idx.widen.[usize]());
    }

    pub view fn call_inst_args_slice(self: *Self, r: ast.IdRange) -> *[types.GenericVal] {
        return slice_id_range.[types.GenericVal](self.meta.call_inst_args.as_slice(), r);
    }

    pub fn set_dyn_coercion(
        self: *mut Self,
        alloc: *mut AllocCap,
        sp: span.Span,
        iface_def: u32,
        concrete_ty: types.TyId,
    ) -> !OutOfMemory {
        let idx = self.meta.dyn_coercions.len().trunc.[u32]();
        try self.meta.dyn_coercions.push(
            alloc,
            DynCoercion.{
                span: sp,
                iface_def: iface_def,
                concrete_ty: concrete_ty,
            },
        );
        try self.meta.dyn_coercion_by_span.insert(alloc, span_key(sp), idx);
        return;
    }

    pub view fn get_dyn_coercion(self: *Self, sp: span.Span) -> ?*DynCoercion {
        let idx = self.meta.dyn_coercion_by_span.get(span_key(sp)) orelse { return null; };
        return self.meta.dyn_coercions.get(idx.widen.[usize]());
    }

    pub fn set_dyn_call(
        self: *mut Self,
        alloc: *mut AllocCap,
        expr_id: u32,
        sp: span.Span,
        iface_def: u32,
        method_idx: u32,
    ) -> !OutOfMemory {
        let idx = self.meta.dyn_calls.len().trunc.[u32]();
        try self.meta.dyn_calls.push(
            alloc,
            DynCall.{
                expr_id: expr_id,
                span: sp,
                iface_def: iface_def,
                method_idx: method_idx,
            },
        );
        try self.meta.dyn_call_by_expr.insert(alloc, expr_id.widen.[u64](), idx);
        return;
    }

    pub view fn get_dyn_call(self: *Self, expr_id: u32) -> ?*DynCall {
        let idx = self.meta.dyn_call_by_expr.get(expr_id.widen.[u64]()) orelse { return null; };
        return self.meta.dyn_calls.get(idx.widen.[usize]());
    }

    pub fn set_call_target(
        self: *mut Self,
        alloc: *mut AllocCap,
        expr_id: u32,
        kind: CallFnKeyKind,
        primary: u32,
        secondary: u32,
    ) -> !OutOfMemory {
        let idx = self.meta.call_targets.len().trunc.[u32]();
        try self.meta.call_targets.push(
            alloc,
            ResolvedCallTarget.{
                kind: kind,
                primary: primary,
                secondary: secondary,
            },
        );
        try self.meta.call_target_by_expr.insert(alloc, expr_id.widen.[u64](), idx);
        return;
    }

    pub view fn get_call_target(self: *Self, expr_id: u32) -> ?*ResolvedCallTarget {
        let idx = self.meta.call_target_by_expr.get(expr_id.widen.[u64]()) orelse { return null; };
        return self.meta.call_targets.get(idx.widen.[usize]());
    }
}

@recursive
fn subst_ty_list_into(
    alloc: *mut AllocCap,
    env: *mut types.TypeEnv,
    n: *types.TyNode,
    args: *[types.GenericVal],
    is_fn_ptr: bool,
) -> types.TyId ! OutOfMemory {
    var orig = try col.DynBuf.[types.TyId].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
    errdefer orig.destroy(alloc);
    try orig.push_slice(alloc, env.node_ty_list(n));
    var mapped = try col.DynBuf.[types.TyId].init(alloc, orig.len() +% 1_usize);
    errdefer mapped.destroy(alloc);
    let os = orig.as_slice();
    var i: usize = 0_usize;
    while i < os.len {
        let st = try subst_ty(alloc, env, os[i], args);
        try mapped.push(alloc, st);
        i = i +% 1_usize;
    }
    let res = if is_fn_ptr {
        let nr = try subst_ty(alloc, env, n.primary, args);
        try env.intern_fn_ptr(alloc, mapped.as_slice(), nr)
    } else {
        try env.intern_tuple(alloc, mapped.as_slice())
    };
    mapped.destroy(alloc);
    orig.destroy(alloc);
    return res;
}

@recursive
fn subst_gval_node(
    alloc: *mut AllocCap,
    env: *mut types.TypeEnv,
    n: *types.TyNode,
    args: *[types.GenericVal],
) -> types.TyId ! OutOfMemory {
    var orig = try col.DynBuf.[types.GenericVal].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
    errdefer orig.destroy(alloc);
    try orig.push_slice(alloc, env.node_gval_list(n));
    var mapped = try col.DynBuf.[types.GenericVal].init(alloc, orig.len() +% 1_usize);
    errdefer mapped.destroy(alloc);
    let os = orig.as_slice();
    var i: usize = 0_usize;
    while i < os.len {
        let g = os[i];
        if g.kind == .Ty {
            let st = try subst_ty(alloc, env, g.id, args);
            try mapped.push(alloc, types.gval_ty(st));
        } else {
            try mapped.push(alloc, g);
        }
        i = i +% 1_usize;
    }
    var res = types.TY_ERROR;
    if n.kind == .Struct {
        res = try env.intern_struct(alloc, n.primary, mapped.as_slice());
    } else if n.kind == .Union {
        res = try env.intern_union(alloc, n.primary, mapped.as_slice());
    } else if n.kind == .Pool {
        res = try env.intern_pool(alloc, n.primary, mapped.as_slice());
    } else if n.kind == .Builtin {
        res = try env.intern_builtin(alloc, n.builtin_kind, mapped.as_slice());
    }
    mapped.destroy(alloc);
    orig.destroy(alloc);
    return res;
}

/// Exact `check.rs::subst_ty` semantics: ignores `TY_ERROR` placeholder slots in `args`.
@recursive
pub fn subst_ty(
    alloc: *mut AllocCap,
    env: *mut types.TypeEnv,
    ty: types.TyId,
    args: *[types.GenericVal],
) -> types.TyId ! OutOfMemory {
    if args.len == 0_usize {
        return ty;
    }
    let n = env.get(ty);
    match n.kind {
        .GenericParam => {
            let idx = n.primary.widen.[usize]();
            if idx < args.len && args[idx].kind == .Ty && args[idx].id != types.TY_ERROR {
                return args[idx].id;
            }
            return ty;
        }
        .Optional => {
            let inn = try subst_ty(alloc, env, n.primary, args);
            return try env.intern_optional(alloc, inn);
        }
        .ErrorUnion => {
            let ok = try subst_ty(alloc, env, n.primary, args);
            var errs = try col.DynBuf.[types.ErrorSource].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
            errdefer errs.destroy(alloc);
            try errs.push_slice(alloc, env.node_err_src_list(&n));
            let res = try env.intern_error_union(alloc, ok, errs.as_slice());
            errs.destroy(alloc);
            return res;
        }
        .Borrow => {
            if n.borrow_kind == .Str {
                return ty;
            }
            let inn = try subst_ty(alloc, env, n.primary, args);
            return try env.intern_borrow(alloc, n.flag0, n.borrow_kind, inn);
        }
        .RawPtr => {
            let inn = try subst_ty(alloc, env, n.primary, args);
            return try env.intern_raw_ptr(alloc, n.flag0, inn);
        }
        .Array => {
            let el = try subst_ty(alloc, env, n.primary, args);
            return try env.intern_array(alloc, n.u64_val, el);
        }
        .Tuple => {
            return try subst_ty_list_into(alloc, env, &n, args, false);
        }
        .FnPtr => {
            return try subst_ty_list_into(alloc, env, &n, args, true);
        }
        .Struct => {
            return try subst_gval_node(alloc, env, &n, args);
        }
        .Union => {
            return try subst_gval_node(alloc, env, &n, args);
        }
        .Pool => {
            return try subst_gval_node(alloc, env, &n, args);
        }
        .Builtin => {
            return try subst_gval_node(alloc, env, &n, args);
        }
        _ => {
            return ty;
        }
    }
}

@recursive
pub fn replace_ty(
    alloc: *mut AllocCap,
    env: *mut types.TypeEnv,
    ty: types.TyId,
    from_ty: types.TyId,
    to_ty: types.TyId,
) -> types.TyId ! OutOfMemory {
    if ty == from_ty {
        return to_ty;
    }
    let n = env.get(ty);
    match n.kind {
        .Borrow => {
            if n.borrow_kind == .Str {
                return ty;
            }
            let nt = try replace_ty(alloc, env, n.primary, from_ty, to_ty);
            return try env.intern_borrow(alloc, n.flag0, n.borrow_kind, nt);
        }
        .Optional => {
            let nt = try replace_ty(alloc, env, n.primary, from_ty, to_ty);
            return try env.intern_optional(alloc, nt);
        }
        .ErrorUnion => {
            let nok = try replace_ty(alloc, env, n.primary, from_ty, to_ty);
            var errs = try col.DynBuf.[types.ErrorSource].init(alloc, n.list_len.widen.[usize]() +% 1_usize);
            errdefer errs.destroy(alloc);
            try errs.push_slice(alloc, env.node_err_src_list(&n));
            let res = try env.intern_error_union(alloc, nok, errs.as_slice());
            errs.destroy(alloc);
            return res;
        }
        .RawPtr => {
            let ni = try replace_ty(alloc, env, n.primary, from_ty, to_ty);
            return try env.intern_raw_ptr(alloc, n.flag0, ni);
        }
        _ => {
            return ty;
        }
    }
}

@recursive
pub fn ty_contains_generic_param(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let n = env.get(ty);
    match n.kind {
        .GenericParam => { return true; }
        .Borrow => {
            if n.borrow_kind == .Str {
                return false;
            }
            return ty_contains_generic_param(n.primary, env);
        }
        .Optional => { return ty_contains_generic_param(n.primary, env); }
        .RawPtr => { return ty_contains_generic_param(n.primary, env); }
        .Array => { return ty_contains_generic_param(n.primary, env); }
        .ErrorUnion => { return ty_contains_generic_param(n.primary, env); }
        .Struct => {
            let gs = env.node_gval_list(&n);
            var i: usize = 0_usize;
            while i < gs.len {
                if gs[i].kind == .Ty && ty_contains_generic_param(gs[i].id, env) {
                    return true;
                }
                i = i +% 1_usize;
            }
            return false;
        }
        .Union => {
            let gs = env.node_gval_list(&n);
            var i: usize = 0_usize;
            while i < gs.len {
                if gs[i].kind == .Ty && ty_contains_generic_param(gs[i].id, env) {
                    return true;
                }
                i = i +% 1_usize;
            }
            return false;
        }
        .Pool => {
            let gs = env.node_gval_list(&n);
            var i: usize = 0_usize;
            while i < gs.len {
                if gs[i].kind == .Ty && ty_contains_generic_param(gs[i].id, env) {
                    return true;
                }
                i = i +% 1_usize;
            }
            return false;
        }
        .Builtin => {
            let gs = env.node_gval_list(&n);
            var i: usize = 0_usize;
            while i < gs.len {
                if gs[i].kind == .Ty && ty_contains_generic_param(gs[i].id, env) {
                    return true;
                }
                i = i +% 1_usize;
            }
            return false;
        }
        .Tuple => {
            let ts = env.node_ty_list(&n);
            var i: usize = 0_usize;
            while i < ts.len {
                if ty_contains_generic_param(ts[i], env) {
                    return true;
                }
                i = i +% 1_usize;
            }
            return false;
        }
        .FnPtr => {
            let ts = env.node_ty_list(&n);
            var i: usize = 0_usize;
            while i < ts.len {
                if ty_contains_generic_param(ts[i], env) {
                    return true;
                }
                i = i +% 1_usize;
            }
            return ty_contains_generic_param(n.primary, env);
        }
        _ => { return false; }
    }
}

// ===========================================================================
// Section 2: FnState, Checker Context, Scopes, Locals, and Diagnostics
// ===========================================================================

struct LocalInfo {
    name: u32;
    span: span.Span;
    ty: types.TyId;
    is_mut: bool;
    is_param: bool;
    is_self: bool;
    is_linear: bool;
    is_copy_val: bool;
    used: bool;
    mutated: bool;
    has_moved: bool;
    moved_span: span.Span;
}

struct MoveSlot {
    has_moved: bool;
    span: span.Span;
}

struct LoopFrame {
    has_label: bool;
    label: u32;
    has_break: bool;
    first_break_ty: types.TyId;
}

linear struct FnState {
    generic_ctx: types.GenericCtx;
    locals: col.DynBuf[LocalInfo];
    scope_ids: col.DynBuf[u32];
    scope_marks: col.DynBuf[usize];
    loops: col.DynBuf[LoopFrame];
    move_snaps: col.DynBuf[MoveSlot];
}

impl FnState {
    fn init(alloc: *mut AllocCap) -> FnState ! OutOfMemory {
        let generic_ctx = try types.GenericCtx.init(alloc);
        errdefer generic_ctx.destroy(alloc);
        let locals = try col.DynBuf.[LocalInfo].init(alloc, 32_usize);
        errdefer locals.destroy(alloc);
        let scope_ids = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer scope_ids.destroy(alloc);
        let scope_marks = try col.DynBuf.[usize].init(alloc, 16_usize);
        errdefer scope_marks.destroy(alloc);
        let loops = try col.DynBuf.[LoopFrame].init(alloc, 8_usize);
        errdefer loops.destroy(alloc);
        let move_snaps = try col.DynBuf.[MoveSlot].init(alloc, 64_usize);
        errdefer move_snaps.destroy(alloc);
        return FnState.{
            generic_ctx: generic_ctx,
            locals: locals,
            scope_ids: scope_ids,
            scope_marks: scope_marks,
            loops: loops,
            move_snaps: move_snaps,
        };
    }

    fn reset(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        self.generic_ctx.params.clear();
        self.generic_ctx.comptime_vals.clear();
        self.generic_ctx.has_self_ty = false;
        self.generic_ctx.self_ty = types.TY_ERROR;
        self.locals.clear();
        self.scope_ids.clear();
        self.scope_marks.clear();
        try self.scope_marks.push(alloc, 0_usize);
        self.loops.clear();
        self.move_snaps.clear();
        return;
    }

    fn destroy(self: FnState, alloc: *mut AllocCap) {
        let FnState.{
            generic_ctx,
            locals,
            scope_ids,
            scope_marks,
            loops,
            move_snaps,
        } = self;
        generic_ctx.destroy(alloc);
        locals.destroy(alloc);
        scope_ids.destroy(alloc);
        scope_marks.destroy(alloc);
        loops.destroy(alloc);
        move_snaps.destroy(alloc);
    }
}

struct CheckBlockRes {
    ty: types.TyId;
    diverged: bool;
}

view struct Checker {
    alloc: *mut AllocCap;
    prog: *mut resolve.ResolvedProgram;
    env: *mut types.TypeEnv;
    ct: *mut ctvm.CtArena;
    table: *mut TypeTable;
    interner: *mut span.SymInterner;
    diags: *mut diag.DiagBag;
    st: *mut FnState;
    mod_id: u32;
    sig: types.FnSig;
    in_iface_impl: bool;
    in_comptime: bool;
    has_pool_handle_kind: bool;
    pool_handle_kind: types.PoolHandleKind;
}

fn expr_span(arena: *ast.AstArena, expr_id: u32) -> span.Span {
    if let e = arena.get_expr(expr_id) {
        return e.span;
    }
    return span.span_dummy();
}

fn is_wildcard_bytes(bs: *[u8]) -> bool {
    return bs.len == 1_usize && bs[0_usize] == b'_';
}

fn starts_with_underscore(bs: *[u8]) -> bool {
    return bs.len > 0_usize && bs[0_usize] == b'_';
}

fn is_discard_named_bytes(bs: *[u8]) -> bool {
    return bs.len > 1_usize && bs[0_usize] == b'_';
}

fn method_target_eq(a: types.MethodTarget, b: types.MethodTarget) -> bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == .Def {
        return a.def_id == b.def_id;
    }
    return a.builtin == b.builtin;
}

fn err_src_eq(a: types.ErrorSource, b: types.ErrorSource) -> bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == .User {
        return a.def_id == b.def_id;
    }
    return a.builtin == b.builtin;
}

fn gval_eq(a: types.GenericVal, b: types.GenericVal) -> bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == .Int {
        return types.int_val_eq(a.int_val, b.int_val);
    }
    return a.id == b.id;
}

fn gval_slice_eq(a: *[types.GenericVal], b: *[types.GenericVal]) -> bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < a.len {
        if !gval_eq(a[i], b[i]) {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

impl Checker {
    fn sym_eq(self: *Self, sym: u32, lit: *str) -> bool {
        return str.bytes_eq(self.interner.get(sym), lit.as_bytes());
    }

    fn emit_err(self: *mut Self, code: u32, sp: span.Span, msg: *str) -> !OutOfMemory {
        _ = try self.diags.emit_error(self.alloc, code, sp, msg);
        return;
    }

    fn emit_err_buf(self: *mut Self, code: u32, sp: span.Span, buf: *str.StrBuf) -> !OutOfMemory {
        _ = try self.diags.emit_error_bytes(self.alloc, code, sp, buf.as_bytes());
        return;
    }

    fn emit_err_bytes2(
        self: *mut Self,
        code: u32,
        sp: span.Span,
        p0: *str,
        s0: *[u8],
        p1: *str,
    ) -> !OutOfMemory {
        var buf = try str.StrBuf.init(self.alloc, 96_usize);
        errdefer buf.destroy(self.alloc);
        try buf.push_str_grow(self.alloc, p0);
        try buf.push_bytes_grow(self.alloc, s0);
        try buf.push_str_grow(self.alloc, p1);
        try self.emit_err_buf(code, sp, &buf);
        buf.destroy(self.alloc);
        return;
    }

    fn emit_err_sym2(
        self: *mut Self,
        code: u32,
        sp: span.Span,
        p0: *str,
        sym: u32,
        p1: *str,
    ) -> !OutOfMemory {
        var buf = try str.StrBuf.init(self.alloc, 96_usize);
        errdefer buf.destroy(self.alloc);
        try buf.push_str_grow(self.alloc, p0);
        try buf.push_bytes_grow(self.alloc, self.interner.get(sym));
        try buf.push_str_grow(self.alloc, p1);
        try self.emit_err_buf(code, sp, &buf);
        buf.destroy(self.alloc);
        return;
    }

    fn emit_err_ty2(
        self: *mut Self,
        code: u32,
        sp: span.Span,
        p0: *str,
        ty: types.TyId,
        p1: *str,
    ) -> !OutOfMemory {
        var buf = try str.StrBuf.init(self.alloc, 96_usize);
        errdefer buf.destroy(self.alloc);
        try buf.push_str_grow(self.alloc, p0);
        try self.env.format_ty_named(self.alloc, ty, self.prog, self.interner, &mut buf);
        try buf.push_str_grow(self.alloc, p1);
        try self.emit_err_buf(code, sp, &buf);
        buf.destroy(self.alloc);
        return;
    }

    fn emit_err_ty_ty(
        self: *mut Self,
        code: u32,
        sp: span.Span,
        p0: *str,
        ty0: types.TyId,
        p1: *str,
        ty1: types.TyId,
        p2: *str,
    ) -> !OutOfMemory {
        var buf = try str.StrBuf.init(self.alloc, 128_usize);
        errdefer buf.destroy(self.alloc);
        try buf.push_str_grow(self.alloc, p0);
        try self.env.format_ty_named(self.alloc, ty0, self.prog, self.interner, &mut buf);
        try buf.push_str_grow(self.alloc, p1);
        try self.env.format_ty_named(self.alloc, ty1, self.prog, self.interner, &mut buf);
        try buf.push_str_grow(self.alloc, p2);
        try self.emit_err_buf(code, sp, &buf);
        buf.destroy(self.alloc);
        return;
    }

    fn emit_err_sym_ty(
        self: *mut Self,
        code: u32,
        sp: span.Span,
        p0: *str,
        sym: u32,
        p1: *str,
        ty: types.TyId,
        p2: *str,
    ) -> !OutOfMemory {
        var buf = try str.StrBuf.init(self.alloc, 128_usize);
        errdefer buf.destroy(self.alloc);
        try buf.push_str_grow(self.alloc, p0);
        try buf.push_bytes_grow(self.alloc, self.interner.get(sym));
        try buf.push_str_grow(self.alloc, p1);
        try self.env.format_ty_named(self.alloc, ty, self.prog, self.interner, &mut buf);
        try buf.push_str_grow(self.alloc, p2);
        try self.emit_err_buf(code, sp, &buf);
        buf.destroy(self.alloc);
        return;
    }

    fn emit_err_ty_sym(
        self: *mut Self,
        code: u32,
        sp: span.Span,
        p0: *str,
        ty: types.TyId,
        p1: *str,
        sym: u32,
        p2: *str,
    ) -> !OutOfMemory {
        var buf = try str.StrBuf.init(self.alloc, 128_usize);
        errdefer buf.destroy(self.alloc);
        try buf.push_str_grow(self.alloc, p0);
        try self.env.format_ty_named(self.alloc, ty, self.prog, self.interner, &mut buf);
        try buf.push_str_grow(self.alloc, p1);
        try buf.push_bytes_grow(self.alloc, self.interner.get(sym));
        try buf.push_str_grow(self.alloc, p2);
        try self.emit_err_buf(code, sp, &buf);
        buf.destroy(self.alloc);
        return;
    }

    fn push_scope(self: *mut Self) -> !OutOfMemory {
        try self.st.scope_marks.push(self.alloc, self.st.scope_ids.len());
        return;
    }

    fn pop_scope(self: *mut Self) -> !OutOfMemory {
        let mark = self.st.scope_marks.pop() orelse { return; };
        let total = self.st.scope_ids.len();
        var si = mark;
        while si < total {
            var lid: u32 = 0_u32;
            var has_id = false;
            let sids = self.st.scope_ids.as_slice();
            if si < sids.len {
                lid = sids[si];
                has_id = true;
            }
            if has_id {
                var info_ok = false;
                var info = LocalInfo.{
                    name: span.SYM_EMPTY,
                    span: span.span_dummy(),
                    ty: types.TY_ERROR,
                    is_mut: false,
                    is_param: false,
                    is_self: false,
                    is_linear: false,
                    is_copy_val: true,
                    used: true,
                    mutated: true,
                    has_moved: false,
                    moved_span: span.span_dummy(),
                };
                let ls = self.st.locals.as_slice();
                let lidx = lid.widen.[usize]();
                if lidx < ls.len {
                    info = ls[lidx];
                    info_ok = true;
                }
                if info_ok {
                    let skip_unused = is_wildcard_bytes(self.interner.get(info.name))
                        || starts_with_underscore(self.interner.get(info.name));
                    if !skip_unused {
                        if !(info.is_self && self.in_iface_impl) {
                            if !info.used {
                                if info.is_param {
                                    try self.emit_err_sym2(
                                        diag.E0101, info.span, "ZM-01: unused parameter `", info.name, "`",
                                    );
                                } else {
                                    try self.emit_err_sym2(
                                        diag.E0101, info.span, "ZM-01: unused local variable `", info.name, "`",
                                    );
                                }
                            } else if info.is_mut && !info.is_param && !info.mutated {
                                try self.emit_err_sym2(
                                    diag.E0122,
                                    info.span,
                                    "`var` binding `",
                                    info.name,
                                    "` is never mutated; consider using `let`",
                                );
                            }
                        }
                    }
                }
            }
            si = si +% 1_usize;
        }
        while self.st.scope_ids.len() > mark {
            _ = self.st.scope_ids.pop();
        }
        return;
    }

    fn lookup_local(self: *Self, sym: u32) -> ?u32 {
        let sids = self.st.scope_ids.as_slice();
        let ls = self.st.locals.as_slice();
        var i = sids.len;
        while i > 0_usize {
            i = i - 1_usize;
            let lid = sids[i];
            let lidx = lid.widen.[usize]();
            if lidx < ls.len && ls[lidx].name == sym {
                return lid;
            }
        }
        return null;
    }

    fn bind_local(
        self: *mut Self,
        sym: u32,
        sp: span.Span,
        ty: types.TyId,
        is_mut: bool,
        is_param: bool,
        is_comptime: bool,
        is_self: bool,
    ) -> u32 ! OutOfMemory {
        if !is_wildcard_bytes(self.interner.get(sym)) {
            if let prev_id = self.lookup_local(sym) {
                var prev_sym = sym;
                let ls = self.st.locals.as_slice();
                let pidx = prev_id.widen.[usize]();
                if pidx < ls.len {
                    prev_sym = ls[pidx].name;
                }
                try self.emit_err_sym2(
                    diag.E0103, sp, "ZM-03: shadowing variable `", prev_sym, "` is forbidden",
                );
            }
            if !self.in_comptime && self.env.contains_type_type(ty) && !is_comptime {
                try self.emit_err(
                    diag.E0210, sp, "cannot store `type` value in a runtime variable",
                );
            }
        }
        let is_linear = ty != types.TY_ERROR && self.env.is_linear(ty);
        let is_copy_val = ty == types.TY_ERROR || (!is_linear && self.env.is_trivial_copy(ty));
        let id = self.st.locals.len().trunc.[u32]();
        try self.st.locals.push(
            self.alloc,
            LocalInfo.{
                name: sym,
                span: sp,
                ty: ty,
                is_mut: is_mut,
                is_param: is_param,
                is_self: is_self,
                is_linear: is_linear,
                is_copy_val: is_copy_val,
                used: false,
                mutated: false,
                has_moved: false,
                moved_span: span.span_dummy(),
            },
        );
        try self.st.scope_ids.push(self.alloc, id);
        return id;
    }

    fn snapshot_moves(self: *mut Self) -> ast.IdRange ! OutOfMemory {
        let start = self.st.move_snaps.len().trunc.[u32]();
        let n = self.st.locals.len();
        var i: usize = 0_usize;
        while i < n {
            var slot = MoveSlot.{ has_moved: false, span: span.span_dummy() };
            let ls = self.st.locals.as_slice();
            if i < ls.len {
                slot = MoveSlot.{ has_moved: ls[i].has_moved, span: ls[i].moved_span };
            }
            try self.st.move_snaps.push(self.alloc, slot);
            i = i +% 1_usize;
        }
        return ast.range_new(start, n.trunc.[u32]());
    }

    fn restore_moves(self: *mut Self, snap: ast.IdRange) {
        let start = snap.start.widen.[usize]();
        let cnt = snap.len.widen.[usize]();
        let ls = self.st.locals.as_mut_slice();
        let ms = self.st.move_snaps.as_slice();
        var i: usize = 0_usize;
        while i < cnt && i < ls.len {
            let pos = start +% i;
            if pos < ms.len {
                ls[i].has_moved = ms[pos].has_moved;
                ls[i].moved_span = ms[pos].span;
            }
            i = i +% 1_usize;
        }
    }

    fn pop_move_snaps_to(self: *mut Self, mark: usize) {
        while self.st.move_snaps.len() > mark {
            _ = self.st.move_snaps.pop();
        }
    }

    fn merge_branch_moves(
        self: *mut Self,
        base: ast.IdRange,
        divs: *[bool],
        snaps: *[ast.IdRange],
    ) {
        self.restore_moves(base);
        var has_live = false;
        var bi: usize = 0_usize;
        while bi < divs.len && bi < snaps.len {
            if !divs[bi] {
                has_live = true;
                break;
            }
            bi = bi +% 1_usize;
        }
        if !has_live {
            return;
        }
        let ls = self.st.locals.as_mut_slice();
        let ms = self.st.move_snaps.as_slice();
        var li: usize = 0_usize;
        while li < ls.len {
            var bj: usize = 0_usize;
            while bj < divs.len && bj < snaps.len {
                if !divs[bj] {
                    let sr = snaps[bj];
                    if li < sr.len.widen.[usize]() {
                        let pos = sr.start.widen.[usize]() +% li;
                        if pos < ms.len && ms[pos].has_moved {
                            ls[li].has_moved = true;
                            ls[li].moved_span = ms[pos].span;
                            break;
                        }
                    }
                }
                bj = bj +% 1_usize;
            }
            li = li +% 1_usize;
        }
    }

    fn read_local(self: *mut Self, id: u32, sp: span.Span, as_move: bool) -> types.TyId ! OutOfMemory {
        let idx = id.widen.[usize]();
        var name_sym = span.SYM_EMPTY;
        var is_linear = false;
        var has_moved = false;
        var is_copy = true;
        var ty = types.TY_ERROR;
        if let l = self.st.locals.get_mut(idx) {
            l.used = true;
            name_sym = l.name;
            is_linear = l.is_linear;
            has_moved = l.has_moved;
            is_copy = l.is_copy_val;
            ty = l.ty;
        }
        if is_discard_named_bytes(self.interner.get(name_sym)) {
            try self.emit_err_sym2(
                diag.E0119, sp, "cannot read `_`-prefixed binding `", name_sym, "`",
            );
        }
        if !is_linear {
            if has_moved {
                try self.emit_err_sym2(
                    diag.E0301, sp, "ZM-06: use of moved value `", name_sym, "`",
                );
            } else if as_move && !is_copy {
                if let l = self.st.locals.get_mut(idx) {
                    l.has_moved = true;
                    l.moved_span = sp;
                }
            }
        }
        return ty;
    }

    fn needs_explicit_return(self: *Self, ret: types.TyId) -> bool {
        if ret == types.TY_VOID || ret == types.TY_NEVER || ret == types.TY_ERROR {
            return false;
        }
        let n = self.env.get(ret);
        if n.kind == .ErrorUnion && n.primary == types.TY_VOID {
            return false;
        }
        return true;
    }

    fn push_loop_frame(self: *mut Self, has_label: bool, label: u32) -> !OutOfMemory {
        try self.st.loops.push(
            self.alloc,
            LoopFrame.{
                has_label: has_label,
                label: label,
                has_break: false,
                first_break_ty: types.TY_NEVER,
            },
        );
        return;
    }

    fn record_loop_break(self: *mut Self, target_idx: usize, v_ty: types.TyId) {
        if let f = self.st.loops.get_mut(target_idx) {
            if !f.has_break {
                f.has_break = true;
                f.first_break_ty = v_ty;
            }
        }
    }

    fn pop_loop_frame_first_break(self: *mut Self) -> ?types.TyId {
        let frame = self.st.loops.pop() orelse { return null; };
        if frame.has_break {
            return frame.first_break_ty;
        }
        return null;
    }

    fn pop_loop_frame_had_breaks(self: *mut Self) -> bool {
        let frame = self.st.loops.pop() orelse { return false; };
        return frame.has_break;
    }
}

// ===========================================================================
// Section 3: Match Exhaustiveness Coverage & Pattern Binding
// ===========================================================================

fn int_val_sat_sub_one(v: types.IntVal) -> types.IntVal {
    return types.int_val_checked_sub(v, types.int_val_from_u64(1_u64))
        orelse types.int_val_min_i128();
}

fn int_val_sat_add_one(v: types.IntVal) -> types.IntVal {
    return types.int_val_checked_add(v, types.int_val_from_u64(1_u64))
        orelse types.int_val_max_i128();
}

fn parse_signed_int_val(raw_bytes: *[u8], neg: bool) -> ?types.IntVal {
    let u = types.parse_int_literal_u128(raw_bytes) orelse { return null; };
    if neg {
        if u.hi == 0x8000000000000000_u64 && u.lo == 0_u64 {
            return types.int_val_min_i128();
        }
        if u.hi >= 0x8000000000000000_u64 {
            return null;
        }
        let pos = types.IntVal.{ lo: u.lo, hi: u.hi.bitcast.[i64]() };
        return types.int_val_checked_neg(pos);
    }
    if u.hi >= 0x8000000000000000_u64 {
        return null;
    }
    return types.IntVal.{ lo: u.lo, hi: u.hi.bitcast.[i64]() };
}

struct IntRangeVal {
    lo: types.IntVal;
    hi: types.IntVal;
}

fn cmp_int_range(a: *IntRangeVal, b: *IntRangeVal) -> i32 {
    let c = types.int_val_cmp(a.lo, b.lo);
    if c != 0_i32 {
        return c;
    }
    return types.int_val_cmp(a.hi, b.hi);
}

fn sort_int_ranges(rs: *mut [IntRangeVal]) {
    let n = rs.len;
    if n <= 1_usize {
        return;
    }
    var i: usize = 1_usize;
    while i < n {
        let cur = rs[i];
        var j = i;
        while j > 0_usize {
            let prev = j - 1_usize;
            if cmp_int_range(&rs[prev], &cur) <= 0_i32 {
                break;
            }
            rs[j] = rs[prev];
            j = prev;
        }
        rs[j] = cur;
        i = i +% 1_usize;
    }
}

@recursive
fn pat_is_irrefutable(arena: *ast.AstArena, pat_id: u32) -> bool {
    let p = arena.get_pat(pat_id) orelse { return true; };
    match p.kind {
        .Wildcard => { return true; }
        .Ident => { return true; }
        .Error => { return true; }
        .Tuple => {
            let ps = arena.pat_list_range(p.list);
            var i: usize = 0_usize;
            while i < ps.len {
                if !pat_is_irrefutable(arena, ps[i]) {
                    return false;
                }
                i = i +% 1_usize;
            }
            return true;
        }
        .Struct => {
            let fs = arena.pat_fields_range(p.list);
            var i: usize = 0_usize;
            while i < fs.len {
                if fs[i].pat != ast.NONE_ID && !pat_is_irrefutable(arena, fs[i].pat) {
                    return false;
                }
                i = i +% 1_usize;
            }
            return true;
        }
        _ => { return false; }
    }
}

linear struct MatchCoverage {
    has_wild: bool;
    seen_true: bool;
    seen_false: bool;
    seen_null: bool;
    seen_some: bool;
    variants: col.HashMap[u8];
    int_ranges: col.DynBuf[IntRangeVal];
    all_variants: col.DynBuf[u32];
    int_domain: types.IntBounds;
}

impl MatchCoverage {
    fn init(
        alloc: *mut AllocCap,
        scrut: types.TyId,
        env: *types.TypeEnv,
    ) -> MatchCoverage ! OutOfMemory {
        let variants = try col.HashMap.[u8].init(alloc, 16_usize);
        errdefer variants.destroy(alloc);
        let int_ranges = try col.DynBuf.[IntRangeVal].init(alloc, 8_usize);
        errdefer int_ranges.destroy(alloc);
        var all_variants = try col.DynBuf.[u32].init(alloc, 16_usize);
        errdefer all_variants.destroy(alloc);

        var dom = types.IntBounds.{
            valid: false,
            has_max: false,
            min: types.int_val_zero(),
            max: types.int_val_zero(),
        };
        let n = env.get(scrut);
        match n.kind {
            .Enum => {
                if let m = env.get_enum(n.primary) {
                    let vs = env.enum_variants_range(m.variants);
                    var i: usize = 0_usize;
                    while i < vs.len {
                        try all_variants.push(alloc, vs[i].name);
                        i = i +% 1_usize;
                    }
                }
            }
            .Union => {
                if let m = env.get_union(n.primary) {
                    let vs = env.union_variants_range(m.variants);
                    var i: usize = 0_usize;
                    while i < vs.len {
                        try all_variants.push(alloc, vs[i].name);
                        i = i +% 1_usize;
                    }
                }
            }
            .ErrorSet => {
                if !n.flag0 {
                    if let m = env.get_error(n.primary) {
                        let vs = env.error_variants_range(m.variants);
                        var i: usize = 0_usize;
                        while i < vs.len {
                            try all_variants.push(alloc, vs[i]);
                            i = i +% 1_usize;
                        }
                    }
                }
            }
            .Char => {
                dom = types.IntBounds.{
                    valid: true,
                    has_max: true,
                    min: types.int_val_zero(),
                    max: types.int_val_from_u64(0x10FFFF_u64),
                };
            }
            .Int => {
                dom = types.int_bounds(n);
            }
            _ => {}
        }

        return MatchCoverage.{
            has_wild: false,
            seen_true: false,
            seen_false: false,
            seen_null: false,
            seen_some: false,
            variants: variants,
            int_ranges: int_ranges,
            all_variants: all_variants,
            int_domain: dom,
        };
    }

    fn destroy(self: MatchCoverage, alloc: *mut AllocCap) {
        let MatchCoverage.{
            has_wild: _,
            seen_true: _,
            seen_false: _,
            seen_null: _,
            seen_some: _,
            variants,
            int_ranges,
            all_variants,
            int_domain: _,
        } = self;
        variants.destroy(alloc);
        int_ranges.destroy(alloc);
        all_variants.destroy(alloc);
    }

    fn is_already_exhaustive(self: *Self) -> bool {
        if self.has_wild {
            return true;
        }
        let av = self.all_variants.as_slice();
        if av.len == 0_usize {
            return false;
        }
        var i: usize = 0_usize;
        while i < av.len {
            if !self.variants.contains(av[i].widen.[u64]()) {
                return false;
            }
            i = i +% 1_usize;
        }
        return true;
    }

    fn int_domain_covered(self: *Self, alloc: *mut AllocCap) -> bool ! OutOfMemory {
        if !self.int_domain.valid || !self.int_domain.has_max {
            return false;
        }
        let rs = self.int_ranges.as_slice();
        if rs.len == 0_usize {
            return false;
        }
        var sorted = try col.DynBuf.[IntRangeVal].init(alloc, rs.len);
        errdefer sorted.destroy(alloc);
        try sorted.push_slice(alloc, rs);
        sort_int_ranges(sorted.as_mut_slice());
        let ss = sorted.as_slice();
        var reach = int_val_sat_sub_one(self.int_domain.min);
        var covered = false;
        var i: usize = 0_usize;
        while i < ss.len {
            let r = ss[i];
            if types.int_val_cmp(r.lo, int_val_sat_add_one(reach)) > 0_i32 {
                sorted.destroy(alloc);
                return false;
            }
            if types.int_val_cmp(r.hi, reach) > 0_i32 {
                reach = r.hi;
            }
            if types.int_val_cmp(reach, self.int_domain.max) >= 0_i32 {
                covered = true;
                break;
            }
            i = i +% 1_usize;
        }
        if !covered && types.int_val_cmp(reach, self.int_domain.max) >= 0_i32 {
            covered = true;
        }
        sorted.destroy(alloc);
        return covered;
    }

    fn record_pattern(
        self: *mut Self,
        alloc: *mut AllocCap,
        arena: *ast.AstArena,
        pat_id: u32,
        interner: *span.SymInterner,
        diags: *mut diag.DiagBag,
    ) -> !OutOfMemory {
        let pat = arena.get_pat(pat_id) orelse { return; };
        match pat.kind {
            .Wildcard => {
                self.has_wild = true;
                return;
            }
            .Ident => {
                if self.seen_null && !self.seen_some {
                    self.seen_some = true;
                } else {
                    self.has_wild = true;
                }
                return;
            }
            .BoolLit => {
                if pat.flag {
                    if self.seen_true {
                        _ = try diags.emit_error(
                            alloc, diag.E0114, pat.span, "ZM-14: duplicate `true` match pattern",
                        );
                    }
                    self.seen_true = true;
                    if self.seen_false {
                        self.has_wild = true;
                    }
                } else {
                    if self.seen_false {
                        _ = try diags.emit_error(
                            alloc, diag.E0114, pat.span, "ZM-14: duplicate `false` match pattern",
                        );
                    }
                    self.seen_false = true;
                    if self.seen_true {
                        self.has_wild = true;
                    }
                }
                return;
            }
            .Null => {
                if self.seen_null {
                    _ = try diags.emit_error(
                        alloc, diag.E0114, pat.span, "ZM-14: duplicate `null` match pattern",
                    );
                }
                self.seen_null = true;
                if self.seen_some {
                    self.has_wild = true;
                }
                return;
            }
            .Variant => {
                let vname = interner.get(pat.ident.sym);
                if str.bytes_eq(vname, "Some".as_bytes()) {
                    self.seen_some = true;
                    if self.seen_null {
                        self.has_wild = true;
                    }
                } else {
                    let key = pat.ident.sym.widen.[u64]();
                    if self.variants.contains(key) {
                        var msg = try str.StrBuf.init(alloc, 64_usize);
                        errdefer msg.destroy(alloc);
                        try msg.push_str_grow(alloc, "ZM-14: unreachable duplicate variant `.");
                        try msg.push_bytes_grow(alloc, vname);
                        try msg.push_byte_grow(alloc, b'`');
                        _ = try diags.emit_error_bytes(alloc, diag.E0114, pat.span, msg.as_bytes());
                        msg.destroy(alloc);
                    } else {
                        try self.variants.insert(alloc, key, 1_u8);
                    }
                }
                return;
            }
            .IntLit => {
                let lo = parse_signed_int_val(interner.get(pat.data0), pat.flag)
                    orelse types.int_val_zero();
                var hi = lo;
                if pat.has_range {
                    let raw_end = parse_signed_int_val(interner.get(pat.data1), pat.range_neg)
                        orelse lo;
                    hi = if pat.range_kind == .Inclusive {
                        raw_end
                    } else {
                        int_val_sat_sub_one(raw_end)
                    };
                }
                if types.int_val_cmp(lo, hi) <= 0_i32 {
                    try self.int_ranges.push(alloc, IntRangeVal.{ lo: lo, hi: hi });
                    if try self.int_domain_covered(alloc) {
                        self.has_wild = true;
                    }
                }
                return;
            }
            .CharLit => {
                let lo = types.int_val_from_u64(pat.data0.widen.[u64]());
                var hi = lo;
                if pat.has_range {
                    let end_v = types.int_val_from_u64(pat.data1.widen.[u64]());
                    hi = if pat.range_kind == .Inclusive {
                        end_v
                    } else {
                        int_val_sat_sub_one(end_v)
                    };
                }
                if types.int_val_cmp(lo, hi) <= 0_i32 {
                    try self.int_ranges.push(alloc, IntRangeVal.{ lo: lo, hi: hi });
                    if try self.int_domain_covered(alloc) {
                        self.has_wild = true;
                    }
                }
                return;
            }
            .Struct => {
                if pat_is_irrefutable(arena, pat_id) {
                    self.has_wild = true;
                }
                return;
            }
            .Tuple => {
                if pat_is_irrefutable(arena, pat_id) {
                    self.has_wild = true;
                }
                return;
            }
            .Error => {
                self.has_wild = true;
                return;
            }
        }
    }

    fn verify_exhaustive(
        self: *Self,
        alloc: *mut AllocCap,
        scrut: types.TyId,
        env: *types.TypeEnv,
        interner: *span.SymInterner,
        diags: *mut diag.DiagBag,
        sp: span.Span,
    ) -> !OutOfMemory {
        if self.has_wild {
            return;
        }
        let n = env.get(scrut);
        match n.kind {
            .Error => { return; }
            .Bool => {
                if !(self.seen_true && self.seen_false) {
                    _ = try diags.emit_error(
                        alloc, diag.E0104, sp, "ZM-04: non-exhaustive `match` on `bool`",
                    );
                }
            }
            .Optional => {
                if !(self.seen_null && self.seen_some) {
                    _ = try diags.emit_error(
                        alloc,
                        diag.E0104,
                        sp,
                        "ZM-04: non-exhaustive `match` on optional type (must handle `null` and value)",
                    );
                }
            }
            .Enum => { try self.emit_missing_variants(alloc, interner, diags, sp); }
            .Union => { try self.emit_missing_variants(alloc, interner, diags, sp); }
            .ErrorSet => { try self.emit_missing_variants(alloc, interner, diags, sp); }
            .Int => {
                if !(try self.int_domain_covered(alloc)) {
                    _ = try diags.emit_error(
                        alloc,
                        diag.E0104,
                        sp,
                        "ZM-04: non-exhaustive `match` on scalar range (add a `_` arm)",
                    );
                }
            }
            .Char => {
                if !(try self.int_domain_covered(alloc)) {
                    _ = try diags.emit_error(
                        alloc,
                        diag.E0104,
                        sp,
                        "ZM-04: non-exhaustive `match` on scalar range (add a `_` arm)",
                    );
                }
            }
            _ => {
                _ = try diags.emit_error(
                    alloc,
                    diag.E0104,
                    sp,
                    "ZM-04: non-exhaustive `match` (add a `_` catch-all arm)",
                );
            }
        }
        return;
    }

    fn emit_missing_variants(
        self: *Self,
        alloc: *mut AllocCap,
        interner: *span.SymInterner,
        diags: *mut diag.DiagBag,
        sp: span.Span,
    ) -> !OutOfMemory {
        let av = self.all_variants.as_slice();
        var missing_cnt: usize = 0_usize;
        var msg = try str.StrBuf.init(alloc, 96_usize);
        errdefer msg.destroy(alloc);
        try msg.push_str_grow(alloc, "ZM-04: non-exhaustive `match`; missing variants: ");
        var i: usize = 0_usize;
        while i < av.len {
            let sym = av[i];
            if !self.variants.contains(sym.widen.[u64]()) {
                if missing_cnt > 0_usize {
                    try msg.push_str_grow(alloc, ", ");
                }
                try msg.push_bytes_grow(alloc, interner.get(sym));
                missing_cnt = missing_cnt +% 1_usize;
            }
            i = i +% 1_usize;
        }
        if missing_cnt > 0_usize {
            _ = try diags.emit_error_bytes(alloc, diag.E0104, sp, msg.as_bytes());
        }
        msg.destroy(alloc);
        return;
    }
}

fn node_to_err_src(n: *types.TyNode) -> types.ErrorSource {
    if n.flag0 {
        let b: types.BuiltinErrorKind = match n.u8_val {
            0_u8 => .ArithError,
            1_u8 => .BoundsError,
            2_u8 => .Utf8Error,
            3_u8 => .OutOfMemory,
            4_u8 => .MemError,
            5_u8 => .StaleId,
            6_u8 => .IoError,
            _ => .ArithError,
        };
        return types.err_src_builtin(b);
    }
    return types.err_src_user(n.primary);
}

impl Checker {
    @recursive
    fn bind_pattern_variant(
        self: *mut Self,
        arena: *ast.AstArena,
        pat: *ast.PatNode,
        ty: types.TyId,
        is_mut_allowed: bool,
    ) -> !OutOfMemory {
        let args = arena.pat_list_range(pat.list);
        let n = self.env.get(ty);
        match n.kind {
            .Union => {
                var uargs = try col.DynBuf.[types.GenericVal].init(self.alloc, n.list_len.widen.[usize]() +% 1_usize);
                errdefer uargs.destroy(self.alloc);
                try uargs.push_slice(self.alloc, self.env.node_gval_list(&n));
                var found = false;
                var has_payload = false;
                var raw_pt = types.TY_ERROR;
                if let um = self.env.get_union(n.primary) {
                    let vs = self.env.union_variants_range(um.variants);
                    var vi: usize = 0_usize;
                    while vi < vs.len {
                        if vs[vi].name == pat.ident.sym {
                            found = true;
                            has_payload = vs[vi].has_payload;
                            raw_pt = vs[vi].payload;
                            break;
                        }
                        vi = vi +% 1_usize;
                    }
                }
                if !found {
                    try self.emit_err_ty_sym(
                        diag.E0132, pat.ident.span, "union `", ty, "` has no variant `.", pat.ident.sym, "`",
                    );
                } else if !has_payload {
                    if args.len > 0_usize {
                        try self.emit_err_sym2(
                            diag.E0230, pat.span, "variant `.", pat.ident.sym, "` has no payload",
                        );
                    }
                } else {
                    let pty = try subst_ty(self.alloc, self.env, raw_pt, uargs.as_slice());
                    if args.len != 1_usize {
                        try self.emit_err_sym2(
                            diag.E0230, pat.span, "variant `.", pat.ident.sym, "` expects 1 payload pattern",
                        );
                    } else {
                        try self.bind_pattern(arena, args[0_usize], pty, is_mut_allowed);
                    }
                }
                uargs.destroy(self.alloc);
            }
            .Enum => {
                if args.len > 0_usize {
                    try self.emit_err(diag.E0230, pat.span, "enum variants have no payloads");
                }
                var has_var = true;
                if let meta = self.env.get_enum(n.primary) {
                    has_var = false;
                    let vs = self.env.enum_variants_range(meta.variants);
                    var vi: usize = 0_usize;
                    while vi < vs.len {
                        if vs[vi].name == pat.ident.sym {
                            has_var = true;
                            break;
                        }
                        vi = vi +% 1_usize;
                    }
                }
                if !has_var {
                    try self.emit_err_sym2(
                        diag.E0132, pat.ident.span, "unknown enum variant `.", pat.ident.sym, "`",
                    );
                }
            }
            .ErrorSet => {
                let srcs: [1]types.ErrorSource = [node_to_err_src(&n)];
                if !self.env.error_sources_have_variant(srcs[0_usize..1_usize], pat.ident.sym, self.interner) {
                    try self.emit_err_sym2(
                        diag.E0132, pat.ident.span, "unknown error variant `.", pat.ident.sym, "`",
                    );
                }
            }
            .ErrorUnion => {
                if self.sym_eq(pat.ident.sym, "Ok") {
                    if args.len > 0_usize {
                        try self.bind_pattern(arena, args[0_usize], n.primary, is_mut_allowed);
                    }
                } else {
                    let errs = self.env.node_err_src_list(&n);
                    if !self.env.error_sources_have_variant(errs, pat.ident.sym, self.interner) {
                        try self.emit_err_sym2(
                            diag.E0132, pat.ident.span, "unknown error variant `.", pat.ident.sym, "`",
                        );
                    }
                }
            }
            .Error => {}
            _ => {
                try self.emit_err_sym_ty(
                    diag.E0230, pat.span, "variant pattern `.", pat.ident.sym, "` cannot match `", ty, "`",
                );
            }
        }
        return;
    }

    @recursive
    fn bind_pattern_struct(
        self: *mut Self,
        arena: *ast.AstArena,
        pat: *ast.PatNode,
        ty: types.TyId,
        is_mut_allowed: bool,
    ) -> !OutOfMemory {
        let fields = arena.pat_fields_range(pat.list);
        let n = self.env.get(ty);
        if n.kind == .Struct {
            var sargs = try col.DynBuf.[types.GenericVal].init(self.alloc, n.list_len.widen.[usize]() +% 1_usize);
            errdefer sargs.destroy(self.alloc);
            try sargs.push_slice(self.alloc, self.env.node_gval_list(&n));
            var has_meta = false;
            var meta_fields = ast.range_empty();
            if let meta = self.env.get_struct(n.primary) {
                has_meta = true;
                meta_fields = meta.fields;
            }
            if has_meta {
                var fi: usize = 0_usize;
                while fi < fields.len {
                    let fp = fields[fi];
                    var found = false;
                    var raw_fty = types.TY_ERROR;
                    let mfs = self.env.struct_fields_range(meta_fields);
                    var mi: usize = 0_usize;
                    while mi < mfs.len {
                        if mfs[mi].name == fp.name.sym {
                            found = true;
                            raw_fty = mfs[mi].ty;
                            break;
                        }
                        mi = mi +% 1_usize;
                    }
                    if found {
                        let fty = try subst_ty(self.alloc, self.env, raw_fty, sargs.as_slice());
                        if fp.pat != ast.NONE_ID {
                            try self.bind_pattern(arena, fp.pat, fty, is_mut_allowed);
                        } else {
                            _ = try self.bind_local(fp.name.sym, fp.name.span, fty, false, false, false, false);
                        }
                    } else {
                        try self.emit_err_sym2(
                            diag.E0132, fp.name.span, "unknown struct field `", fp.name.sym, "` in pattern",
                        );
                    }
                    fi = fi +% 1_usize;
                }
            }
            sargs.destroy(self.alloc);
        } else if n.kind == .AnonStruct {
            var afs = try col.DynBuf.[types.AnonField].init(self.alloc, n.list_len.widen.[usize]() +% 1_usize);
            errdefer afs.destroy(self.alloc);
            try afs.push_slice(self.alloc, self.env.node_anon_fields(&n));
            let mfs = afs.as_slice();
            var fi: usize = 0_usize;
            while fi < fields.len {
                let fp = fields[fi];
                var found = false;
                var fty = types.TY_ERROR;
                var mi: usize = 0_usize;
                while mi < mfs.len {
                    if mfs[mi].name == fp.name.sym {
                        found = true;
                        fty = mfs[mi].ty;
                        break;
                    }
                    mi = mi +% 1_usize;
                }
                if found {
                    if fp.pat != ast.NONE_ID {
                        try self.bind_pattern(arena, fp.pat, fty, is_mut_allowed);
                    } else {
                        _ = try self.bind_local(fp.name.sym, fp.name.span, fty, false, false, false, false);
                    }
                } else {
                    try self.emit_err_sym2(
                        diag.E0132, fp.name.span, "unknown struct field `", fp.name.sym, "` in pattern",
                    );
                }
                fi = fi +% 1_usize;
            }
            afs.destroy(self.alloc);
        }
        return;
    }

    @recursive
    fn bind_pattern(
        self: *mut Self,
        arena: *ast.AstArena,
        pat_id: u32,
        ty: types.TyId,
        is_mut_allowed: bool,
    ) -> !OutOfMemory {
        let pat = arena.get_pat(pat_id) orelse { return; };
        match pat.kind {
            .Wildcard => {}
            .Error => {}
            .Null => {}
            .BoolLit => {}
            .CharLit => {}
            .IntLit => {}
            .Ident => {
                _ = try self.bind_local(pat.data0, pat.span, ty, false, false, false, false);
            }
            .Tuple => {
                let ps = arena.pat_list_range(pat.list);
                let n = self.env.get(ty);
                if n.kind == .Tuple {
                    var elems = try col.DynBuf.[types.TyId].init(self.alloc, n.list_len.widen.[usize]() +% 1_usize);
                    errdefer elems.destroy(self.alloc);
                    try elems.push_slice(self.alloc, self.env.node_ty_list(&n));
                    let es = elems.as_slice();
                    if es.len != ps.len {
                        var msg = try str.StrBuf.init(self.alloc, 64_usize);
                        errdefer msg.destroy(self.alloc);
                        try msg.push_str_grow(self.alloc, "tuple pattern has ");
                        try msg.push_u64_grow(self.alloc, ps.len.widen.[u64]());
                        try msg.push_str_grow(self.alloc, " elements, expected ");
                        try msg.push_u64_grow(self.alloc, es.len.widen.[u64]());
                        try self.emit_err_buf(diag.E0230, pat.span, &msg);
                        msg.destroy(self.alloc);
                    }
                    var i: usize = 0_usize;
                    while i < ps.len {
                        let ety = if i < es.len { es[i] } else { types.TY_ERROR };
                        try self.bind_pattern(arena, ps[i], ety, is_mut_allowed);
                        i = i +% 1_usize;
                    }
                    elems.destroy(self.alloc);
                } else if ty != types.TY_ERROR {
                    try self.emit_err_ty2(
                        diag.E0230, pat.span, "cannot match tuple pattern against `", ty, "`",
                    );
                }
            }
            .Variant => {
                try self.bind_pattern_variant(arena, pat, ty, is_mut_allowed);
            }
            .Struct => {
                try self.bind_pattern_struct(arena, pat, ty, is_mut_allowed);
            }
        }
        return;
    }
}

// ===========================================================================
// Section 4: Function, System, Block, Statement, Jump, and Range Checking
// ===========================================================================

impl Checker {
    fn bind_fn_params(self: *mut Self) -> !OutOfMemory {
        let p_range = self.sig.params;
        let cnt = p_range.len.widen.[usize]();
        var i: usize = 0_usize;
        while i < cnt {
            let ps = self.env.params_range(p_range);
            if i < ps.len {
                let p = ps[i];
                let is_mut = p.modifier == .Mut || p.access == .Write;
                _ = try self.bind_local(p.name, p.span, p.ty, is_mut, true, p.is_comptime, p.is_self);
            }
            i = i +% 1_usize;
        }
        return;
    }

    fn check_fn_body(self: *mut Self, arena: *ast.AstArena, f: *ast.FnDeclNode) -> !OutOfMemory {
        if f.is_emi_stub_body {
            return;
        }
        if let m = self.prog.get_module(self.mod_id) {
            if m.is_emi_stub {
                if let blk = arena.get_block(f.body) {
                    if blk.stmts.len == 0_u32 && blk.tail_expr == ast.NONE_ID {
                        return;
                    }
                }
            }
        }
        try self.bind_fn_params();
        let diverged = try self.check_block_stmts(arena, f.body);
        if let blk = arena.get_block(f.body) {
            if blk.tail_expr != ast.NONE_ID {
                _ = try self.check_expr(arena, blk.tail_expr, self.sig.ret);
            } else if !diverged && self.needs_explicit_return(self.sig.ret) {
                try self.emit_err_sym_ty(
                    diag.E0230,
                    blk.span,
                    "function `",
                    f.name.sym,
                    "` must return a value of type `",
                    self.sig.ret,
                    "` on all control-flow paths",
                );
            }
        }
        try self.pop_scope();
        return;
    }

    fn check_sys_body(self: *mut Self, arena: *ast.AstArena, s: *ast.SysDeclNode) -> !OutOfMemory {
        if s.is_emi_stub_body {
            return;
        }
        if let m = self.prog.get_module(self.mod_id) {
            if m.is_emi_stub {
                if let blk = arena.get_block(s.body) {
                    if blk.stmts.len == 0_u32 && blk.tail_expr == ast.NONE_ID {
                        return;
                    }
                }
            }
        }
        try self.bind_fn_params();
        let diverged = try self.check_block_stmts(arena, s.body);
        if let blk = arena.get_block(s.body) {
            if blk.tail_expr != ast.NONE_ID {
                _ = try self.check_expr(arena, blk.tail_expr, self.sig.ret);
            } else if !diverged && self.needs_explicit_return(self.sig.ret) {
                try self.emit_err_sym_ty(
                    diag.E0230,
                    blk.span,
                    "system `",
                    s.name.sym,
                    "` must return a value of type `",
                    self.sig.ret,
                    "`",
                );
            }
        }
        try self.pop_scope();
        return;
    }

    @recursive
    fn check_block_stmts(self: *mut Self, arena: *ast.AstArena, block_id: u32) -> bool ! OutOfMemory {
        let blk = arena.get_block(block_id) orelse { return false; };
        let stmts = arena.stmt_list_range(blk.stmts);
        var diverged = false;
        var i: usize = 0_usize;
        while i < stmts.len {
            if try self.check_stmt(arena, stmts[i]) {
                diverged = true;
            }
            i = i +% 1_usize;
        }
        return diverged;
    }

    @recursive
    fn check_block_expr(
        self: *mut Self,
        arena: *ast.AstArena,
        block_id: u32,
        expected: types.TyId,
    ) -> CheckBlockRes ! OutOfMemory {
        try self.push_scope();
        let diverged = try self.check_block_stmts(arena, block_id);
        var ty = types.TY_VOID;
        if let blk = arena.get_block(block_id) {
            if blk.tail_expr != ast.NONE_ID {
                ty = try self.check_expr(arena, blk.tail_expr, expected);
            } else if diverged {
                ty = types.TY_NEVER;
            } else {
                ty = types.TY_VOID;
            }
        }
        try self.pop_scope();
        return CheckBlockRes.{ ty: ty, diverged: diverged || ty == types.TY_NEVER };
    }

    fn check_concrete_binding_ty(
        self: *mut Self,
        ty: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if self.in_comptime {
            return ty;
        }
        let n = self.env.get(ty);
        if n.kind == .ComptimeInt {
            try self.emit_err(
                diag.E0203,
                sp,
                "cannot infer concrete integer type for unsuffixed literal; add a type annotation or suffix like `_i32`",
            );
            return types.TY_ERROR;
        }
        if n.kind == .ComptimeFloat {
            try self.emit_err(
                diag.E0203,
                sp,
                "cannot infer concrete float type for unsuffixed literal; add a type annotation or suffix like `_f64`",
            );
            return types.TY_ERROR;
        }
        return ty;
    }

    @recursive
    fn check_defer_body(self: *mut Self, arena: *ast.AstArena, kind: ast.BodyKind, body_id: u32) -> !OutOfMemory {
        let snap_mark = self.st.move_snaps.len();
        let snap = try self.snapshot_moves();
        if kind == .Block {
            try self.push_scope();
            _ = try self.check_block_stmts(arena, body_id);
            try self.pop_scope();
        } else if kind == .Expr {
            _ = try self.check_expr(arena, body_id, types.TY_NONE);
        }
        self.restore_moves(snap);
        self.pop_move_snaps_to(snap_mark);
        return;
    }

    fn enclosing_error_set_ty(self: *mut Self) -> ?types.TyId ! OutOfMemory {
        let n = self.env.get(self.sig.ret);
        if n.kind != .ErrorUnion {
            return null;
        }
        let errs = self.env.node_err_src_list(&n);
        if errs.len == 0_usize {
            return null;
        }
        let first = errs[0_usize];
        return try self.env.intern_error_set(self.alloc, first);
    }

    @recursive
    fn check_jump(self: *mut Self, arena: *ast.AstArena, jump_id: u32, sp: span.Span) -> !OutOfMemory {
        let j = arena.get_jump(jump_id) orelse { return; };
        match j.kind {
            .Return => {
                let ret_ty = self.sig.ret;
                if j.value == ast.NONE_ID {
                    let rn = self.env.get(ret_ty);
                    let void_ok = ret_ty == types.TY_VOID
                        || ret_ty == types.TY_ERROR
                        || (rn.kind == .ErrorUnion && rn.primary == types.TY_VOID);
                    if !void_ok {
                        try self.emit_err_ty2(
                            diag.E0230, sp, "expected return value of type `", ret_ty, "`",
                        );
                    }
                } else {
                    let rn = self.env.get(ret_ty);
                    let val_sp = expr_span(arena, j.value);
                    if rn.kind == .ErrorUnion {
                        let ok_ty = rn.primary;
                        if let ve = arena.get_expr(j.value) {
                            if ve.kind == .EnumLit {
                                let errs = self.env.node_err_src_list(&rn);
                                if self.env.error_sources_have_variant(errs, ve.ident.sym, self.interner) {
                                    try self.table.set_expr_and_span_ty(self.alloc, j.value, ve.span, ret_ty);
                                    return;
                                }
                            }
                        }
                        let got = try self.check_expr_rvalue(arena, j.value, ret_ty);
                        if got != ret_ty {
                            try self.expect_assignable(got, ok_ty, val_sp);
                        }
                    } else {
                        let got = try self.check_expr_rvalue(arena, j.value, ret_ty);
                        try self.expect_assignable(got, ret_ty, val_sp);
                    }
                }
                return;
            }
            .Break => {
                var found_target = false;
                var target_idx: usize = 0_usize;
                let ls = self.st.loops.as_slice();
                if ast.ident_is_some(j.label) {
                    var li = ls.len;
                    while li > 0_usize {
                        li = li - 1_usize;
                        if ls[li].has_label && ls[li].label == j.label.sym {
                            found_target = true;
                            target_idx = li;
                            break;
                        }
                    }
                } else if ls.len > 0_usize {
                    found_target = true;
                    target_idx = ls.len - 1_usize;
                }
                if !found_target {
                    try self.emit_err(
                        diag.E0230, sp, "`break` outside of a loop or unknown loop label",
                    );
                }
                let v_ty = if j.value != ast.NONE_ID {
                    try self.check_expr_rvalue(arena, j.value, types.TY_NONE)
                } else {
                    types.TY_VOID
                };
                if found_target {
                    self.record_loop_break(target_idx, v_ty);
                }
                return;
            }
            .Continue => {
                var ok = false;
                let ls = self.st.loops.as_slice();
                if ast.ident_is_some(j.label) {
                    var li: usize = 0_usize;
                    while li < ls.len {
                        if ls[li].has_label && ls[li].label == j.label.sym {
                            ok = true;
                            break;
                        }
                        li = li +% 1_usize;
                    }
                } else {
                    ok = ls.len > 0_usize;
                }
                if !ok {
                    try self.emit_err(
                        diag.E0230, sp, "`continue` outside of a loop or unknown loop label",
                    );
                }
                return;
            }
            .Unreachable => { return; }
        }
    }

    @recursive
    fn check_for_range(
        self: *mut Self,
        arena: *ast.AstArena,
        start_id: u32,
        has_range: bool,
        end_id: u32,
    ) -> types.TyId ! OutOfMemory {
        let start_sp = expr_span(arena, start_id);
        if has_range && end_id != ast.NONE_ID {
            let st = try self.check_expr(arena, start_id, types.TY_NONE);
            let hint = if st != types.TY_COMPTIME_INT { st } else { types.TY_NONE };
            let en = try self.check_expr(arena, end_id, hint);
            if st == types.TY_COMPTIME_INT && en == types.TY_COMPTIME_INT {
                return types.TY_USIZE;
            }
            if st == types.TY_COMPTIME_INT && self.env.is_concrete_integer(en) {
                _ = try self.check_expr(arena, start_id, en);
                return en;
            }
            if st != types.TY_ERROR && !self.env.is_integer(st) {
                try self.emit_err_ty2(
                    diag.E0230, start_sp, "range bound must be integer, found `", st, "`",
                );
                return types.TY_ERROR;
            }
            try self.expect_assignable(en, st, expr_span(arena, end_id));
            return st;
        }

        var is_each_mut = false;
        var is_each = false;
        if let se = arena.get_expr(start_id) {
            if se.kind == .Call && se.list.len == 0_u32 {
                if let ce = arena.get_expr(se.a) {
                    if ce.kind == .Field {
                        if self.sym_eq(ce.ident.sym, "each_mut") {
                            is_each_mut = true;
                        } else if self.sym_eq(ce.ident.sym, "each") {
                            is_each = true;
                        }
                    }
                }
            }
        }
        let col_ty = try self.check_expr(arena, start_id, types.TY_NONE);
        let cn = self.env.get(col_ty);
        if cn.kind == .Error {
            return types.TY_ERROR;
        }
        if cn.kind == .Array || (cn.kind == .Borrow && cn.borrow_kind == .Slice) {
            let el = cn.primary;
            if is_each_mut {
                return try self.env.intern_borrow(self.alloc, true, .Single, el);
            }
            if is_each {
                return try self.env.intern_borrow(self.alloc, false, .Single, el);
            }
            return el;
        }
        if cn.kind == .Str || (cn.kind == .Borrow && cn.borrow_kind == .Str) {
            return types.TY_U8;
        }
        if cn.kind == .Builtin && cn.builtin_kind == .SlotPool {
            let gs = self.env.node_gval_list(&cn);
            let el = if gs.len > 0_usize && gs[0_usize].kind == .Ty { gs[0_usize].id } else { types.TY_ERROR };
            let ga: [1]types.GenericVal = [types.gval_ty(el)];
            return try self.env.intern_builtin(self.alloc, .GenId, ga[0_usize..1_usize]);
        }
        if cn.kind == .Borrow && cn.borrow_kind == .Single {
            let inn = self.env.get(cn.primary);
            if inn.kind == .Builtin && inn.builtin_kind == .SlotPool {
                let gs = self.env.node_gval_list(&inn);
                let el = if gs.len > 0_usize && gs[0_usize].kind == .Ty { gs[0_usize].id } else { types.TY_ERROR };
                let ga: [1]types.GenericVal = [types.gval_ty(el)];
                return try self.env.intern_builtin(self.alloc, .GenId, ga[0_usize..1_usize]);
            }
        }
        try self.emit_err_ty2(diag.E0230, start_sp, "cannot iterate over `", col_ty, "`");
        return types.TY_ERROR;
    }

    @recursive
    fn check_stmt_assign(self: *mut Self, arena: *ast.AstArena, s: *ast.StmtNode) -> !OutOfMemory {
        let lhs_ty = try self.check_lvalue_write(arena, s.a, s.assign_op != .Assign);
        let rhs_ty = try self.check_expr_rvalue(arena, s.b, lhs_ty);
        let lhs_sp = expr_span(arena, s.a);
        let rhs_sp = expr_span(arena, s.b);
        match s.assign_op {
            .Assign => {
                try self.expect_assignable(rhs_ty, lhs_ty, rhs_sp);
            }
            .ShlAssign => {
                if lhs_ty != types.TY_ERROR && !self.env.is_integer(lhs_ty) {
                    try self.emit_err(diag.E0230, lhs_sp, "shift assignment requires integer left operand");
                }
                if rhs_ty != types.TY_ERROR && !self.env.is_integer(rhs_ty) {
                    try self.emit_err(diag.E0230, rhs_sp, "shift amount must be an integer");
                }
            }
            .ShrAssign => {
                if lhs_ty != types.TY_ERROR && !self.env.is_integer(lhs_ty) {
                    try self.emit_err(diag.E0230, lhs_sp, "shift assignment requires integer left operand");
                }
                if rhs_ty != types.TY_ERROR && !self.env.is_integer(rhs_ty) {
                    try self.emit_err(diag.E0230, rhs_sp, "shift amount must be an integer");
                }
            }
            .BitAndAssign => {
                if lhs_ty != types.TY_ERROR && !self.env.is_integer(lhs_ty) {
                    try self.emit_err(diag.E0230, lhs_sp, "bitwise assignment requires integer operand");
                }
                try self.expect_assignable(rhs_ty, lhs_ty, rhs_sp);
            }
            .BitOrAssign => {
                if lhs_ty != types.TY_ERROR && !self.env.is_integer(lhs_ty) {
                    try self.emit_err(diag.E0230, lhs_sp, "bitwise assignment requires integer operand");
                }
                try self.expect_assignable(rhs_ty, lhs_ty, rhs_sp);
            }
            .BitXorAssign => {
                if lhs_ty != types.TY_ERROR && !self.env.is_integer(lhs_ty) {
                    try self.emit_err(diag.E0230, lhs_sp, "bitwise assignment requires integer operand");
                }
                try self.expect_assignable(rhs_ty, lhs_ty, rhs_sp);
            }
            _ => {
                if lhs_ty != types.TY_ERROR && !self.env.is_numeric(lhs_ty) {
                    try self.emit_err_ty2(
                        diag.E0230, lhs_sp, "arithmetic assignment requires numeric type, found `", lhs_ty, "`",
                    );
                }
                try self.expect_assignable(rhs_ty, lhs_ty, rhs_sp);
            }
        }
        return;
    }

    @recursive
    fn check_stmt_loops(self: *mut Self, arena: *ast.AstArena, s: *ast.StmtNode) -> bool ! OutOfMemory {
        match s.kind {
            .While => {
                let cond_ty = try self.check_expr(arena, s.a, types.TY_BOOL);
                if cond_ty != types.TY_ERROR && cond_ty != types.TY_BOOL {
                    try self.emit_err_ty2(
                        diag.E0230,
                        expr_span(arena, s.a),
                        "`while` condition must be `bool`, found `",
                        cond_ty,
                        "`",
                    );
                }
                try self.push_loop_frame(ast.ident_is_some(s.ident), s.ident.sym);
                try self.push_scope();
                _ = try self.check_block_stmts(arena, s.b);
                if let blk = arena.get_block(s.b) {
                    if blk.tail_expr != ast.NONE_ID {
                        let t = try self.check_expr(arena, blk.tail_expr, types.TY_NONE);
                        if t != types.TY_VOID && t != types.TY_NEVER && t != types.TY_ERROR {
                            try self.emit_err_ty2(
                                diag.E0102,
                                expr_span(arena, blk.tail_expr),
                                "ZM-02: unused expression value of type `",
                                t,
                                "`",
                            );
                        }
                    }
                }
                try self.pop_scope();
                _ = self.pop_loop_frame_had_breaks();
                return false;
            }
            .For => {
                let elem_ty = try self.check_for_range(arena, s.c, s.has_range, s.d);
                try self.push_loop_frame(ast.ident_is_some(s.ident), s.ident.sym);
                try self.push_scope();
                try self.bind_pattern(arena, s.a, elem_ty, false);
                _ = try self.check_block_stmts(arena, s.b);
                try self.pop_scope();
                _ = self.pop_loop_frame_had_breaks();
                return false;
            }
            .ParFor => {
                let elem_ty = try self.check_for_range(arena, s.c, s.has_range, s.d);
                if let pnode = arena.get_pat(s.a) {
                    try self.table.set_span_ty(self.alloc, pnode.span, elem_ty);
                }
                try self.push_loop_frame(false, span.SYM_EMPTY);
                try self.push_scope();
                try self.bind_pattern(arena, s.a, elem_ty, false);
                _ = try self.check_block_stmts(arena, s.b);
                try self.pop_scope();
                _ = self.pop_loop_frame_had_breaks();
                return false;
            }
            .Loop => {
                try self.push_loop_frame(ast.ident_is_some(s.ident), s.ident.sym);
                let snap_mark = self.st.move_snaps.len();
                let base_moves = try self.snapshot_moves();
                try self.push_scope();
                _ = try self.check_block_stmts(arena, s.a);
                try self.pop_scope();
                self.restore_moves(base_moves);
                self.pop_move_snaps_to(snap_mark);
                return !self.pop_loop_frame_had_breaks();
            }
            _ => { return false; }
        }
    }

    @recursive
    fn check_stmt(self: *mut Self, arena: *ast.AstArena, stmt_id: u32) -> bool ! OutOfMemory {
        let s = arena.get_stmt(stmt_id) orelse { return false; };
        match s.kind {
            .Let => {
                var annot_ty = types.TY_NONE;
                if s.b != ast.NONE_ID {
                    annot_ty = try self.resolve_ty(arena, s.b);
                    if let tn = arena.get_type(s.b) {
                        try self.table.set_span_ty(self.alloc, tn.span, annot_ty);
                    }
                }
                let init_ty = try self.check_expr_rvalue(arena, s.c, annot_ty);
                let init_sp = expr_span(arena, s.c);
                let final_ty = if annot_ty != types.TY_NONE {
                    try self.expect_assignable(init_ty, annot_ty, init_sp);
                    annot_ty
                } else {
                    try self.check_concrete_binding_ty(init_ty, init_sp)
                };
                try self.bind_pattern(arena, s.a, final_ty, false);
                return false;
            }
            .Var => {
                var annot_ty = types.TY_NONE;
                if s.b != ast.NONE_ID {
                    annot_ty = try self.resolve_ty(arena, s.b);
                    if let tn = arena.get_type(s.b) {
                        try self.table.set_span_ty(self.alloc, tn.span, annot_ty);
                    }
                }
                let init_ty = try self.check_expr_rvalue(arena, s.c, annot_ty);
                let init_sp = expr_span(arena, s.c);
                let final_ty = if annot_ty != types.TY_NONE {
                    try self.expect_assignable(init_ty, annot_ty, init_sp);
                    annot_ty
                } else {
                    try self.check_concrete_binding_ty(init_ty, init_sp)
                };
                _ = try self.bind_local(s.ident.sym, s.ident.span, final_ty, true, false, false, false);
                return false;
            }
            .Const => {
                if let c = arena.get_const_decl(s.a) {
                    let c_ty = try self.resolve_ty(arena, c.ty);
                    let saved = self.in_comptime;
                    self.in_comptime = true;
                    let init_ty = try self.check_expr(arena, c.value, c_ty);
                    try self.expect_assignable(init_ty, c_ty, expr_span(arena, c.value));
                    self.in_comptime = saved;
                    _ = try self.bind_local(c.name.sym, c.name.span, c_ty, false, false, true, false);
                }
                return false;
            }
            .Defer => {
                try self.check_defer_body(arena, s.body_kind, s.a);
                return false;
            }
            .Errdefer => {
                try self.push_scope();
                if ast.ident_is_some(s.ident) {
                    let ety = (try self.enclosing_error_set_ty()) orelse types.TY_ERROR;
                    _ = try self.bind_local(s.ident.sym, s.ident.span, ety, false, false, false, false);
                }
                try self.check_defer_body(arena, s.body_kind, s.a);
                try self.pop_scope();
                return false;
            }
            .Jump => {
                try self.check_jump(arena, s.a, s.span);
                return true;
            }
            .If => {
                let res = try self.check_if(arena, s.a, types.TY_NONE);
                return res.diverged;
            }
            .Match => {
                let res = try self.check_match(arena, s.a, s.list, types.TY_NONE, s.span);
                return res.diverged;
            }
            .While => { return try self.check_stmt_loops(arena, s); }
            .For => { return try self.check_stmt_loops(arena, s); }
            .ParFor => { return try self.check_stmt_loops(arena, s); }
            .Loop => { return try self.check_stmt_loops(arena, s); }
            .ComptimeBlock => {
                let saved = self.in_comptime;
                self.in_comptime = true;
                try self.push_scope();
                let div = try self.check_block_stmts(arena, s.a);
                try self.pop_scope();
                self.in_comptime = saved;
                return div;
            }
            .RawBlock => {
                try self.push_scope();
                let div = try self.check_block_stmts(arena, s.a);
                try self.pop_scope();
                return div;
            }
            .Assign => {
                try self.check_stmt_assign(arena, s);
                return false;
            }
            .Discard => {
                let t = try self.check_expr(arena, s.a, types.TY_NONE);
                if t != types.TY_ERROR && self.env.get(t).kind == .ErrorUnion {
                    try self.emit_err(
                        diag.E0102,
                        s.span,
                        "ZM-02: cannot discard an error union with `_ = ...`; handle with `try` or `catch`",
                    );
                }
                return false;
            }
            .Expr => {
                let t = try self.check_expr(arena, s.a, types.TY_NONE);
                if t != types.TY_VOID && t != types.TY_NEVER && t != types.TY_ERROR {
                    try self.emit_err_ty2(
                        diag.E0102,
                        s.span,
                        "ZM-02: unused return value of type `",
                        t,
                        "`; bind it or explicitly discard with `_ = ...`",
                    );
                }
                return t == types.TY_NEVER;
            }
        }
    }
}

// ===========================================================================
// Section 5: Lvalues, Rvalues, Expression Dispatch, Literals, and Struct Inits
// ===========================================================================

fn extract_root_ident_sym(arena: *ast.AstArena, expr_id: u32) -> ?u32 {
    var cur = expr_id;
    var steps: u32 = 0_u32;
    while steps < 256_u32 {
        let e = arena.get_expr(cur) orelse { return null; };
        match e.kind {
            .Ident => { return e.a; }
            .Unary => {
                if e.unary_op == .Borrow || e.unary_op == .BorrowMut {
                    cur = e.a;
                } else {
                    return null;
                }
            }
            .Paren => { cur = e.a; }
            .Deref => { cur = e.a; }
            .Field => { cur = e.a; }
            _ => { return null; }
        }
        steps = steps +% 1_u32;
    }
    return null;
}

fn u128_le(a: types.U128Val, b: types.U128Val) -> bool {
    if a.hi != b.hi {
        return a.hi < b.hi;
    }
    return a.lo <= b.lo;
}

struct ParsedF64 {
    ok: bool;
    val: f64;
}

fn is_f64_finite(v: f64) -> bool {
    let bits = v.bitcast.[u64]();
    return ((bits >> 52_u64) & 0x7FF_u64) != 0x7FF_u64;
}

fn scale_pow10_f64(val_in: f64, exp_in: i32) -> f64 {
    var val = val_in;
    var p = if exp_in < 0_i32 { 0_i32 -% exp_in } else { exp_in };
    let is_neg_exp = exp_in < 0_i32;
    while p > 0_i32 {
        let step = if p > 256_i32 { 256_i32 } else { p };
        var sc = 1.0_f64;
        var base = 10.0_f64;
        var rem = step;
        while rem > 0_i32 {
            if (rem & 1_i32) != 0_i32 {
                sc = sc * base;
            }
            base = base * base;
            rem = rem >> 1_i32;
        }
        if is_neg_exp {
            val = val / sc;
        } else {
            val = val * sc;
        }
        p = p -% step;
    }
    return val;
}

fn parse_f64_checked(bytes: *[u8]) -> ParsedF64 {
    var i: usize = 0_usize;
    var neg = false;
    if i < bytes.len && bytes[i] == b'-' {
        neg = true;
        i = i +% 1_usize;
    } else if i < bytes.len && bytes[i] == b'+' {
        i = i +% 1_usize;
    }
    var sig: u64 = 0_u64;
    var sig_digits: i32 = 0_i32;
    var dec_exp: i32 = 0_i32;
    var in_frac = false;
    var saw_digit = false;
    while i < bytes.len {
        let ch = bytes[i];
        if ch == b'_' {
            i = i +% 1_usize;
            continue;
        }
        if ch == b'.' && !in_frac {
            in_frac = true;
            i = i +% 1_usize;
            continue;
        }
        if ch == b'e' || ch == b'E' {
            i = i +% 1_usize;
            break;
        }
        if ch >= b'0' && ch <= b'9' {
            saw_digit = true;
            let d = (ch - b'0').widen.[u64]();
            if sig == 0_u64 && d == 0_u64 {
                if in_frac {
                    dec_exp = dec_exp -% 1_i32;
                }
            } else if sig < 1000000000000000000_u64 {
                sig = sig *% 10_u64 +% d;
                sig_digits = sig_digits +% 1_i32;
                if in_frac {
                    dec_exp = dec_exp -% 1_i32;
                }
            } else if !in_frac {
                dec_exp = dec_exp +% 1_i32;
            }
            i = i +% 1_usize;
            continue;
        }
        return ParsedF64.{ ok: false, val: 0.0_f64 };
    }
    if !saw_digit {
        return ParsedF64.{ ok: false, val: 0.0_f64 };
    }
    if i < bytes.len {
        var exp_neg = false;
        if bytes[i] == b'-' {
            exp_neg = true;
            i = i +% 1_usize;
        } else if bytes[i] == b'+' {
            i = i +% 1_usize;
        }
        var eacc: i32 = 0_i32;
        var saw_exp_digit = false;
        while i < bytes.len {
            let ch = bytes[i];
            if ch == b'_' {
                i = i +% 1_usize;
                continue;
            }
            if ch >= b'0' && ch <= b'9' {
                saw_exp_digit = true;
                if eacc < 100000_i32 {
                    eacc = eacc *% 10_i32 +% (ch - b'0').widen.[i32]();
                }
                i = i +% 1_usize;
                continue;
            }
            return ParsedF64.{ ok: false, val: 0.0_f64 };
        }
        if !saw_exp_digit {
            return ParsedF64.{ ok: false, val: 0.0_f64 };
        }
        dec_exp = if exp_neg { dec_exp -% eacc } else { dec_exp +% eacc };
    }
    if sig == 0_u64 {
        return ParsedF64.{ ok: true, val: if neg { -0.0_f64 } else { 0.0_f64 } };
    }
    let eff_exp = dec_exp +% (sig_digits -% 1_i32);
    if eff_exp > 309_i32 {
        return ParsedF64.{ ok: false, val: 0.0_f64 };
    }
    if eff_exp < -325_i32 {
        return ParsedF64.{ ok: true, val: if neg { -0.0_f64 } else { 0.0_f64 } };
    }
    var v = scale_pow10_f64(sig.to_float.[f64](), dec_exp);
    if neg {
        v = -v;
    }
    if !is_f64_finite(v) {
        return ParsedF64.{ ok: false, val: 0.0_f64 };
    }
    return ParsedF64.{ ok: true, val: v };
}

fn is_ordering_variant(name: *[u8]) -> bool {
    return str.bytes_eq(name, "Less".as_bytes())
        || str.bytes_eq(name, "Equal".as_bytes())
        || str.bytes_eq(name, "Greater".as_bytes())
        || str.bytes_eq(name, "Relaxed".as_bytes())
        || str.bytes_eq(name, "Acquire".as_bytes())
        || str.bytes_eq(name, "Release".as_bytes())
        || str.bytes_eq(name, "AcqRel".as_bytes())
        || str.bytes_eq(name, "SeqCst".as_bytes());
}

fn is_prim_minmax_name(name: *[u8]) -> bool {
    return str.bytes_eq(name, "MIN".as_bytes()) || str.bytes_eq(name, "MAX".as_bytes());
}

fn parse_prim_int_bits(suf: *[u8]) -> u16 {
    if suf.len >= 2_usize && (suf[0_usize] == b'u' || suf[0_usize] == b'i') {
        let is_signed = suf[0_usize] == b'i';
        let rest = suf.sub(1_usize, suf.len) catch { return 0_u16; };
        let parsed = str.parse_u64(rest) catch { return 0_u16; };
        if parsed >= 1_u64 && parsed <= 64_u64 {
            let tag: u16 = if is_signed { 256_u16 } else { 0_u16 };
            return tag | parsed.trunc.[u16]();
        }
    }
    return 0_u16;
}

fn vec_swizzle_len(fname: *[u8], lanes: u8) -> u8 {
    if (is_vec_swizzle_xyzw(fname) || is_vec_swizzle_rgba(fname))
        && vec_swizzle_in_bounds(fname, lanes)
    {
        return fname.len.trunc.[u8]();
    }
    return 0_u8;
}

impl Checker {
    fn prim_from_suffix(self: *mut Self, sym: u32) -> ?types.TyId ! OutOfMemory {
        if self.sym_eq(sym, "usize") { return types.TY_USIZE; }
        if self.sym_eq(sym, "isize") { return types.TY_ISIZE; }
        if self.sym_eq(sym, "u128") { return types.TY_U128; }
        if self.sym_eq(sym, "i8") { return types.TY_I8; }
        if self.sym_eq(sym, "i16") { return types.TY_I16; }
        if self.sym_eq(sym, "i32") { return types.TY_I32; }
        if self.sym_eq(sym, "i64") { return types.TY_I64; }
        if self.sym_eq(sym, "i128") { return types.TY_I128; }
        let enc = parse_prim_int_bits(self.interner.get(sym));
        if enc != 0_u16 {
            let pk: resolve.PrimKind = if (enc & 256_u16) != 0_u16 { .IInt } else { .UInt };
            let bits = (enc & 255_u16).trunc.[u8]();
            return try types.prim_to_ty_id_in_env(self.alloc, pk, bits, self.env);
        }
        return null;
    }

    fn validate_int_fits(
        self: *mut Self,
        mag: types.U128Val,
        neg: bool,
        ty: types.TyId,
        sp: span.Span,
    ) -> !OutOfMemory {
        let n = self.env.get(ty);
        if n.kind != .Int {
            return;
        }
        let signed = n.flag0;
        let actual_bits: u8 = if n.flag1 { 64_u8 } else { n.u8_val };
        if !signed {
            if neg {
                try self.emit_err_ty2(
                    diag.E0201, sp, "negative literal cannot fit in unsigned type `", ty, "`",
                );
                return;
            }
            var fits = true;
            if actual_bits < 64_u8 {
                let lim = 1_u64 <<% actual_bits.widen.[u64]();
                fits = mag.hi == 0_u64 && mag.lo < lim;
            } else if actual_bits == 64_u8 {
                fits = mag.hi == 0_u64;
            } else if actual_bits < 128_u8 {
                let hi_lim = 1_u64 <<% (actual_bits -% 64_u8).widen.[u64]();
                fits = mag.hi < hi_lim;
            }
            if !fits {
                try self.emit_err_ty2(
                    diag.E0201, sp, "integer literal out of range for `", ty, "`",
                );
            }
            return;
        }

        var max_pos = types.U128Val.{ lo: 0xFFFFFFFFFFFFFFFF_u64, hi: 0x7FFFFFFFFFFFFFFF_u64 };
        var max_neg = types.U128Val.{ lo: 0_u64, hi: 0x8000000000000000_u64 };
        if actual_bits <= 1_u8 {
            max_pos = types.U128Val.{ lo: 0_u64, hi: 0_u64 };
            max_neg = types.U128Val.{ lo: 1_u64, hi: 0_u64 };
        } else if actual_bits < 64_u8 {
            let half = 1_u64 <<% (actual_bits -% 1_u8).widen.[u64]();
            max_pos = types.U128Val.{ lo: half -% 1_u64, hi: 0_u64 };
            max_neg = types.U128Val.{ lo: half, hi: 0_u64 };
        } else if actual_bits == 64_u8 {
            max_pos = types.U128Val.{ lo: 0x7FFFFFFFFFFFFFFF_u64, hi: 0_u64 };
            max_neg = types.U128Val.{ lo: 0x8000000000000000_u64, hi: 0_u64 };
        } else if actual_bits < 128_u8 {
            let half_hi = 1_u64 <<% (actual_bits -% 65_u8).widen.[u64]();
            max_pos = types.U128Val.{ lo: 0xFFFFFFFFFFFFFFFF_u64, hi: half_hi -% 1_u64 };
            max_neg = types.U128Val.{ lo: 0_u64, hi: half_hi };
        }
        let fits = if neg { u128_le(mag, max_neg) } else { u128_le(mag, max_pos) };
        if !fits {
            try self.emit_err_ty2(
                diag.E0201, sp, "integer literal out of range for `", ty, "`",
            );
        }
        return;
    }

    fn check_int_lit(
        self: *mut Self,
        raw_sym: u32,
        suffix: u32,
        neg: bool,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let mag = types.parse_int_literal_u128(self.interner.get(raw_sym)) orelse {
            try self.emit_err(diag.E0201, sp, "invalid integer literal");
            return types.TY_ERROR;
        };
        if suffix != ast.NONE_ID {
            let ty_opt = try self.prim_from_suffix(suffix);
            let ty = ty_opt orelse {
                try self.emit_err_sym2(diag.E0230, sp, "unknown integer suffix `", suffix, "`");
                return types.TY_ERROR;
            };
            try self.validate_int_fits(mag, neg, ty, sp);
            return ty;
        }
        if expected != types.TY_NONE && self.env.is_concrete_integer(expected) {
            try self.validate_int_fits(mag, neg, expected, sp);
            return expected;
        }
        return types.TY_COMPTIME_INT;
    }

    fn check_float_lit(
        self: *mut Self,
        raw_sym: u32,
        suffix: u32,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let parsed = parse_f64_checked(self.interner.get(raw_sym));
        if !parsed.ok {
            try self.emit_err(diag.E0202, sp, "float literal overflows `f64`");
            return types.TY_ERROR;
        }
        var target = types.TY_COMPTIME_FLOAT;
        if suffix != ast.NONE_ID {
            if self.sym_eq(suffix, "f16") {
                target = types.TY_F16;
            } else if self.sym_eq(suffix, "f32") {
                target = types.TY_F32;
            } else if self.sym_eq(suffix, "f64") {
                target = types.TY_F64;
            } else {
                try self.emit_err_sym2(diag.E0230, sp, "unknown float suffix `", suffix, "`");
                return types.TY_ERROR;
            }
        } else if expected != types.TY_NONE
            && self.env.is_float(expected)
            && expected != types.TY_COMPTIME_FLOAT
        {
            target = expected;
        } else {
            return types.TY_COMPTIME_FLOAT;
        }

        let abs_v = if parsed.val < 0.0_f64 { -parsed.val } else { parsed.val };
        if target == types.TY_F32 && abs_v >= 340282356779733661637539395458142568448.0_f64 {
            try self.emit_err(diag.E0202, sp, "float literal overflows `f32`");
        } else if target == types.TY_F16 && abs_v > 65504.0_f64 {
            try self.emit_err(diag.E0202, sp, "float literal overflows `f16`");
        }
        return target;
    }

    @recursive
    fn try_check_enum_lit_in_ty(
        self: *mut Self,
        v: ast.IdentSpan,
        target: types.TyId,
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        let n = self.env.get(target);
        match n.kind {
            .Enum => {
                if let meta = self.env.get_enum(n.primary) {
                    let vs = self.env.enum_variants_range(meta.variants);
                    var i: usize = 0_usize;
                    while i < vs.len {
                        if vs[i].name == v.sym {
                            return target;
                        }
                        i = i +% 1_usize;
                    }
                }
                return null;
            }
            .Union => {
                var found = false;
                var has_payload = false;
                if let um = self.env.get_union(n.primary) {
                    let vs = self.env.union_variants_range(um.variants);
                    var i: usize = 0_usize;
                    while i < vs.len {
                        if vs[i].name == v.sym {
                            found = true;
                            has_payload = vs[i].has_payload;
                            break;
                        }
                        i = i +% 1_usize;
                    }
                }
                if found {
                    if has_payload {
                        try self.emit_err_sym2(
                            diag.E0230, sp, "union variant `.", v.sym, "` requires a payload",
                        );
                    }
                    return target;
                }
                return null;
            }
            .Builtin => {
                if n.builtin_kind == .Ordering && is_ordering_variant(self.interner.get(v.sym)) {
                    return target;
                }
                return null;
            }
            .Optional => {
                return try self.try_check_enum_lit_in_ty(v, n.primary, sp);
            }
            _ => { return null; }
        }
    }

    fn check_enum_lit(
        self: *mut Self,
        v: ast.IdentSpan,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if expected == types.TY_NONE {
            try self.emit_err_sym2(
                diag.E0230,
                sp,
                "`.",
                v.sym,
                "` requires an expected enum, union, or error type",
            );
            return types.TY_ERROR;
        }
        let n = self.env.get(expected);
        match n.kind {
            .TypeType => { return types.TY_TYPE_TYPE; }
            .Enum => {
                if let meta = self.env.get_enum(n.primary) {
                    let vs = self.env.enum_variants_range(meta.variants);
                    var i: usize = 0_usize;
                    while i < vs.len {
                        if vs[i].name == v.sym {
                            return expected;
                        }
                        i = i +% 1_usize;
                    }
                }
                try self.emit_err_sym_ty(
                    diag.E0230, sp, "unknown enum variant `.", v.sym, "` for `", expected, "`",
                );
                return types.TY_ERROR;
            }
            .Union => {
                var found = false;
                var has_payload = false;
                if let um = self.env.get_union(n.primary) {
                    let vs = self.env.union_variants_range(um.variants);
                    var i: usize = 0_usize;
                    while i < vs.len {
                        if vs[i].name == v.sym {
                            found = true;
                            has_payload = vs[i].has_payload;
                            break;
                        }
                        i = i +% 1_usize;
                    }
                }
                if found {
                    if has_payload {
                        try self.emit_err_sym2(
                            diag.E0230, sp, "union variant `.", v.sym, "` requires a payload",
                        );
                    }
                    return expected;
                }
                try self.emit_err_sym_ty(
                    diag.E0230, sp, "unknown union variant `.", v.sym, "` for `", expected, "`",
                );
                return types.TY_ERROR;
            }
            .ErrorSet => {
                let srcs: [1]types.ErrorSource = [node_to_err_src(&n)];
                if self.env.error_sources_have_variant(srcs[0_usize..1_usize], v.sym, self.interner) {
                    return expected;
                }
                try self.emit_err_sym2(diag.E0230, sp, "unknown error variant `.", v.sym, "`");
                return types.TY_ERROR;
            }
            .ErrorUnion => {
                let errs = self.env.node_err_src_list(&n);
                if self.env.error_sources_have_variant(errs, v.sym, self.interner) {
                    return expected;
                }
                if let ok_ty = try self.try_check_enum_lit_in_ty(v, n.primary, sp) {
                    return ok_ty;
                }
                try self.emit_err_sym_ty(
                    diag.E0230, sp, "unknown variant `.", v.sym, "` for `", expected, "`",
                );
                return types.TY_ERROR;
            }
            .Optional => {
                if let inner_ty = try self.try_check_enum_lit_in_ty(v, n.primary, sp) {
                    return inner_ty;
                }
                try self.emit_err_sym_ty(
                    diag.E0230, sp, "unknown variant `.", v.sym, "` for `", expected, "`",
                );
                return types.TY_ERROR;
            }
            .Builtin => {
                if n.builtin_kind == .Ordering {
                    if is_ordering_variant(self.interner.get(v.sym)) {
                        return expected;
                    }
                    try self.emit_err(diag.E0230, sp, "unknown `Ordering` variant");
                    return types.TY_ERROR;
                }
                try self.emit_err_sym_ty(
                    diag.E0230, sp, "`.", v.sym, "` cannot construct `", expected, "`",
                );
                return types.TY_ERROR;
            }
            .Error => { return types.TY_ERROR; }
            _ => {
                try self.emit_err_sym_ty(
                    diag.E0230, sp, "`.", v.sym, "` cannot construct `", expected, "`",
                );
                return types.TY_ERROR;
            }
        }
    }

    @recursive
    fn check_lvalue_local_write(
        self: *mut Self,
        id: u32,
        needs_prior_val: bool,
        is_self_expr: bool,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let idx = id.widen.[usize]();
        var is_mut = false;
        var is_self = false;
        var has_moved = false;
        var ty = types.TY_ERROR;
        var name_sym = span.SYM_EMPTY;
        if let l = self.st.locals.get_mut(idx) {
            l.used = true;
            l.mutated = true;
            is_mut = l.is_mut;
            is_self = l.is_self;
            has_moved = l.has_moved;
            ty = l.ty;
            name_sym = l.name;
        }
        let tn = self.env.get(ty);
        let is_ptr_or_borrow = tn.kind == .Borrow || tn.kind == .RawPtr;
        let mut_through_borrow = needs_prior_val && is_ptr_or_borrow && tn.flag0;
        let immut_borrow = needs_prior_val && is_ptr_or_borrow && !tn.flag0;
        if immut_borrow {
            try self.emit_err_sym2(
                diag.E0230, sp, "cannot mutate through immutable borrow `", name_sym, "`",
            );
        } else if !is_mut && !is_self && !mut_through_borrow {
            if is_self_expr {
                try self.emit_err_sym2(diag.E0230, sp, "cannot assign to immutable `", name_sym, "`");
            } else {
                try self.emit_err_sym2(
                    diag.E0230, sp, "cannot assign to immutable `let` binding `", name_sym, "`",
                );
            }
        }
        if !is_self_expr {
            if needs_prior_val && has_moved {
                try self.emit_err_sym2(
                    diag.E0301, sp, "ZM-06: use of moved value `", name_sym, "`",
                );
            } else if !needs_prior_val {
                if let l = self.st.locals.get_mut(idx) {
                    l.has_moved = false;
                }
            }
        }
        return ty;
    }

    @recursive
    fn check_lvalue_write(
        self: *mut Self,
        arena: *ast.AstArena,
        expr_id: u32,
        needs_prior_val: bool,
    ) -> types.TyId ! OutOfMemory {
        let e = arena.get_expr(expr_id) orelse { return types.TY_ERROR; };
        var res = types.TY_ERROR;
        match e.kind {
            .SelfVal => {
                let sym = try self.interner.intern_str(self.alloc, "self");
                if let id = self.lookup_local(sym) {
                    res = try self.check_lvalue_local_write(id, needs_prior_val, true, e.span);
                } else {
                    try self.emit_err(diag.E0230, e.span, "`self` is not in scope");
                    res = types.TY_ERROR;
                }
            }
            .Ident => {
                if let id = self.lookup_local(e.a) {
                    res = try self.check_lvalue_local_write(id, needs_prior_val, false, e.span);
                } else {
                    try self.emit_err(
                        diag.E0230, e.span, "cannot assign to non-local or undeclared identifier",
                    );
                    res = types.TY_ERROR;
                }
            }
            .Field => {
                let base_ty = try self.check_lvalue_write(arena, e.a, true);
                let brand = extract_root_ident_sym(arena, e.a);
                res = try self.resolve_field_type(base_ty, e.ident, true, brand, e.span);
            }
            .Index => {
                let base_ty = try self.check_lvalue_write(arena, e.a, true);
                let idx_ty = try self.check_expr(arena, e.b, types.TY_NONE);
                try self.check_index_ty(arena, e.a, idx_ty, expr_span(arena, e.b));
                res = try self.index_elem_ty(base_ty, e.span);
            }
            .Deref => {
                let inner_ty = try self.check_expr(arena, e.a, types.TY_NONE);
                let inn = self.env.get(inner_ty);
                if (inn.kind == .Borrow && inn.borrow_kind == .Single && inn.flag0)
                    || (inn.kind == .RawPtr && inn.flag0)
                {
                    res = inn.primary;
                } else if (inn.kind == .Borrow && !inn.flag0) || (inn.kind == .RawPtr && !inn.flag0) {
                    try self.emit_err(
                        diag.E0230, e.span, "cannot assign through immutable borrow or pointer",
                    );
                    res = types.TY_ERROR;
                } else if inn.kind == .Error {
                    res = types.TY_ERROR;
                } else {
                    try self.emit_err_ty2(diag.E0230, e.span, "cannot dereference `", inner_ty, "`");
                    res = types.TY_ERROR;
                }
            }
            .Paren => {
                res = try self.check_lvalue_write(arena, e.a, needs_prior_val);
            }
            _ => {
                try self.emit_err(diag.E0230, e.span, "invalid assignment target");
                res = types.TY_ERROR;
            }
        }
        try self.table.set_expr_and_span_ty(self.alloc, expr_id, e.span, res);
        return res;
    }

    @recursive
    fn check_expr_rvalue(
        self: *mut Self,
        arena: *ast.AstArena,
        expr_id: u32,
        expected: types.TyId,
    ) -> types.TyId ! OutOfMemory {
        let e = arena.get_expr(expr_id) orelse { return types.TY_ERROR; };
        var ty = types.TY_ERROR;
        if e.kind == .Ident {
            if let id = self.lookup_local(e.a) {
                ty = try self.read_local(id, e.span, true);
            } else {
                ty = try self.check_expr(arena, expr_id, expected);
            }
        } else if e.kind == .Unary && e.unary_op == .Move {
            var handled = false;
            if let inn = arena.get_expr(e.a) {
                if inn.kind == .Ident {
                    if let id = self.lookup_local(inn.a) {
                        ty = try self.read_local(id, inn.span, true);
                        if let l = self.st.locals.get_mut(id.widen.[usize]()) {
                            if !l.is_linear {
                                l.has_moved = true;
                                l.moved_span = e.span;
                            }
                        }
                        handled = true;
                    }
                }
            }
            if !handled {
                ty = try self.check_expr_rvalue(arena, e.a, expected);
            }
        } else {
            ty = try self.check_expr(arena, expr_id, expected);
        }
        try self.table.set_expr_and_span_ty(self.alloc, expr_id, e.span, ty);
        return ty;
    }

    @recursive
    fn check_expr(
        self: *mut Self,
        arena: *ast.AstArena,
        expr_id: u32,
        expected: types.TyId,
    ) -> types.TyId ! OutOfMemory {
        let e = arena.get_expr(expr_id) orelse { return types.TY_ERROR; };
        let ty = try self.check_expr_inner(arena, expr_id, e, expected);
        try self.table.set_expr_and_span_ty(self.alloc, expr_id, e.span, ty);
        return ty;
    }

    @recursive
    fn check_array_lit(
        self: *mut Self,
        arena: *ast.AstArena,
        e: *ast.ExprNode,
        expected: types.TyId,
    ) -> types.TyId ! OutOfMemory {
        let elems = arena.expr_list_range(e.list);
        var exp_elem = types.TY_NONE;
        if expected != types.TY_NONE {
            let en = self.env.get(expected);
            if en.kind == .Array || (en.kind == .Borrow && en.borrow_kind == .Slice) {
                exp_elem = en.primary;
            }
        }
        var elem_ty = exp_elem;
        var inferred = try col.DynBuf.[types.TyId].init(self.alloc, elems.len +% 1_usize);
        errdefer inferred.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < elems.len {
            let t = try self.check_expr_rvalue(arena, elems[i], elem_ty);
            if elem_ty == types.TY_NONE && t != types.TY_COMPTIME_INT && t != types.TY_COMPTIME_FLOAT {
                elem_ty = t;
            }
            try inferred.push(self.alloc, t);
            i = i +% 1_usize;
        }
        var final_elem = elem_ty;
        if final_elem == types.TY_NONE {
            let inf_s = inferred.as_slice();
            if inf_s.len > 0_usize {
                final_elem = try self.check_concrete_binding_ty(inf_s[0_usize], e.span);
            } else {
                final_elem = types.TY_ERROR;
            }
        }
        let is2 = inferred.as_slice();
        var j: usize = 0_usize;
        while j < elems.len && j < is2.len {
            if final_elem != types.TY_ERROR {
                let t = is2[j];
                let actual = if t == types.TY_COMPTIME_INT || t == types.TY_COMPTIME_FLOAT {
                    try self.check_expr_rvalue(arena, elems[j], final_elem)
                } else {
                    t
                };
                try self.expect_assignable(actual, final_elem, expr_span(arena, elems[j]));
            }
            j = j +% 1_usize;
        }
        let arr_ty = try self.env.intern_array(self.alloc, elems.len.widen.[u64](), final_elem);
        inferred.destroy(self.alloc);
        return arr_ty;
    }

    @recursive
    fn check_expr_compound(
        self: *mut Self,
        arena: *ast.AstArena,
        expr_id: u32,
        e: *ast.ExprNode,
        expected: types.TyId,
    ) -> types.TyId ! OutOfMemory {
        match e.kind {
            .Tuple => {
                let elems = arena.expr_list_range(e.list);
                if elems.len == 0_usize {
                    return types.TY_VOID;
                }
                var exp_elems = try col.DynBuf.[types.TyId].init(self.alloc, elems.len);
                errdefer exp_elems.destroy(self.alloc);
                var has_exp = false;
                if expected != types.TY_NONE {
                    let en = self.env.get(expected);
                    if en.kind == .Tuple && en.list_len.widen.[usize]() == elems.len {
                        try exp_elems.push_slice(self.alloc, self.env.node_ty_list(&en));
                        has_exp = true;
                    }
                }
                var tys = try col.DynBuf.[types.TyId].init(self.alloc, elems.len);
                errdefer tys.destroy(self.alloc);
                let ex_s = exp_elems.as_slice();
                var i: usize = 0_usize;
                while i < elems.len {
                    let ex = if has_exp && i < ex_s.len { ex_s[i] } else { types.TY_NONE };
                    let t = try self.check_expr_rvalue(arena, elems[i], ex);
                    try tys.push(self.alloc, t);
                    i = i +% 1_usize;
                }
                let res = try self.env.intern_tuple(self.alloc, tys.as_slice());
                tys.destroy(self.alloc);
                exp_elems.destroy(self.alloc);
                return res;
            }
            .ArrayLit => { return try self.check_array_lit(arena, e, expected); }
            .ArrayRepeat => {
                var exp_elem = types.TY_NONE;
                if expected != types.TY_NONE {
                    let en = self.env.get(expected);
                    if en.kind == .Array {
                        exp_elem = en.primary;
                    }
                }
                let val_ty = try self.check_expr_rvalue(arena, e.a, exp_elem);
                let val_sp = expr_span(arena, e.a);
                let final_elem = if exp_elem != types.TY_NONE {
                    try self.expect_assignable(val_ty, exp_elem, val_sp);
                    exp_elem
                } else {
                    try self.check_concrete_binding_ty(val_ty, val_sp)
                };
                let c_ty = try self.check_expr(arena, e.b, types.TY_USIZE);
                if c_ty != types.TY_ERROR && !self.env.is_integer(c_ty) {
                    try self.emit_err(
                        diag.E0230, expr_span(arena, e.b), "array repeat count must be an integer",
                    );
                }
                var n: u64 = 0_u64;
                if let cv = try types.eval_const_int(
                    self.alloc, e.b, self.mod_id, &self.st.generic_ctx,
                    arena, self.prog, self.env, self.interner, self.diags,
                ) {
                    if !types.int_val_is_neg(cv) {
                        n = types.int_val_to_u64(cv) orelse 0_u64;
                    }
                }
                return try self.env.intern_array(self.alloc, n, final_elem);
            }
            .AnonStructLit => {
                return try self.check_anon_struct_lit(arena, e.list, expected, e.span);
            }
            .NamedStructLit => {
                return try self.check_named_struct_lit(arena, e.a, e.list, expected, e.span);
            }
            .ComptimeBlock => {
                let saved = self.in_comptime;
                self.in_comptime = true;
                let res = try self.check_block_expr(arena, e.a, expected);
                self.in_comptime = saved;
                if !saved && self.sig.generics.len == 0_u32 {
                    if let val_id = try ctvm.eval_expr_in_ctx(
                        self.alloc, self.ct, expr_id, res.ty, self.mod_id, &self.st.generic_ctx,
                        arena, self.prog, self.env, self.interner, self.diags,
                        ctvm.DEFAULT_COMPTIME_FUEL,
                    ) {
                        if let iv = self.ct.as_i128(val_id) {
                            try self.table.set_const_int(self.alloc, expr_id, iv);
                        }
                        try self.table.set_comptime_val(self.alloc, expr_id, val_id);
                    }
                }
                return res.ty;
            }
            .ComptimeExpr => {
                var is_schedule_build = false;
                if let inner = arena.get_expr(e.a) {
                    if inner.kind == .Call {
                        if let ce = arena.get_expr(inner.a) {
                            if ce.kind == .Field && str.bytes_eq(self.interner.get(ce.ident.sym), "build".as_bytes()) {
                                if let be = arena.get_expr(ce.a) {
                                    if be.kind == .Ident && str.bytes_eq(self.interner.get(be.a), "Schedule".as_bytes()) {
                                        is_schedule_build = true;
                                    }
                                }
                            }
                        }
                    }
                }
                let saved = self.in_comptime;
                self.in_comptime = true;
                let ty = try self.check_expr(arena, e.a, expected);
                self.in_comptime = saved;
                if !is_schedule_build && !saved && self.sig.generics.len == 0_u32 {
                    if let val_id = try ctvm.eval_expr_in_ctx(
                        self.alloc, self.ct, e.a, ty, self.mod_id, &self.st.generic_ctx,
                        arena, self.prog, self.env, self.interner, self.diags,
                        ctvm.DEFAULT_COMPTIME_FUEL,
                    ) {
                        if let iv = self.ct.as_i128(val_id) {
                            try self.table.set_const_int(self.alloc, expr_id, iv);
                        }
                        try self.table.set_comptime_val(self.alloc, expr_id, val_id);
                    }
                }
                return ty;
            }
            _ => { return types.TY_ERROR; }
        }
    }

    @recursive
    fn check_expr_null_or_slice(
        self: *mut Self,
        arena: *ast.AstArena,
        e: *ast.ExprNode,
        expected: types.TyId,
    ) -> types.TyId ! OutOfMemory {
        if e.kind == .Null {
            if expected != types.TY_NONE {
                let en = self.env.get(expected);
                if en.kind == .Optional {
                    return expected;
                }
                if en.kind == .ErrorUnion && self.env.get(en.primary).kind == .Optional {
                    return en.primary;
                }
                if expected != types.TY_ERROR {
                    try self.emit_err_ty2(
                        diag.E0230, e.span, "`null` cannot have non-optional type `", expected, "`",
                    );
                }
                return types.TY_ERROR;
            }
            try self.emit_err(diag.E0230, e.span, "`null` requires an optional `?T` type context");
            return types.TY_ERROR;
        }
        if e.kind == .Slice {
            let bt = try self.check_expr(arena, e.a, types.TY_NONE);
            if e.b != ast.NONE_ID {
                let lt = try self.check_expr(arena, e.b, types.TY_USIZE);
                if lt != types.TY_ERROR && !self.env.is_integer(lt) {
                    try self.emit_err(diag.E0230, expr_span(arena, e.b), "slice bound must be integer");
                }
            }
            if e.c != ast.NONE_ID {
                let ht = try self.check_expr(arena, e.c, types.TY_USIZE);
                if ht != types.TY_ERROR && !self.env.is_integer(ht) {
                    try self.emit_err(diag.E0230, expr_span(arena, e.c), "slice bound must be integer");
                }
            }
            return try self.slice_result_ty(bt, e.span);
        }
        let ops = arena.asm_ops_range(e.list2);
        var i: usize = 0_usize;
        while i < ops.len {
            let op = ops[i];
            if op.kind == .Named {
                if op.arg != ast.NONE_ID {
                    _ = try self.check_expr(arena, op.arg, types.TY_NONE);
                }
            } else {
                _ = try self.check_expr(arena, op.expr, types.TY_NONE);
            }
            i = i +% 1_usize;
        }
        return types.TY_VOID;
    }

    @recursive
    fn check_expr_inner(
        self: *mut Self,
        arena: *ast.AstArena,
        expr_id: u32,
        e: *ast.ExprNode,
        expected: types.TyId,
    ) -> types.TyId ! OutOfMemory {
        match e.kind {
            .Error => { return types.TY_ERROR; }
            .IntLit => { return try self.check_int_lit(e.a, e.b, false, expected, e.span); }
            .FloatLit => { return try self.check_float_lit(e.a, e.b, expected, e.span); }
            .StringLit => { return try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID); }
            .RawStringLit => { return try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID); }
            .ByteStringLit => {
                let bs = arena.byte_bytes_range(e.list);
                return try self.env.intern_array(self.alloc, bs.len.widen.[u64](), types.TY_U8);
            }
            .CharLit => { return types.TY_CHAR; }
            .ByteCharLit => { return types.TY_U8; }
            .BoolLit => { return types.TY_BOOL; }
            .Null => { return try self.check_expr_null_or_slice(arena, e, expected); }
            .SelfVal => {
                let sym = try self.interner.intern_str(self.alloc, "self");
                if let id = self.lookup_local(sym) {
                    return try self.read_local(id, e.span, false);
                }
                if self.st.generic_ctx.has_self_ty {
                    return self.st.generic_ctx.self_ty;
                }
                try self.emit_err(diag.E0132, e.span, "`self` is not bound here");
                return types.TY_ERROR;
            }
            .ReturnVal => { return self.sig.ret; }
            .Ident => {
                if let id = self.lookup_local(e.a) {
                    return try self.read_local(id, e.span, false);
                }
                let segs: [1]ast.IdentSpan = [ast.ident_new(e.a, e.span)];
                return try self.resolve_value_path(segs[0_usize..1_usize], e.span);
            }
            .EnumLit => { return try self.check_enum_lit(e.ident, expected, e.span); }
            .Paren => { return try self.check_expr(arena, e.a, expected); }
            .Tuple => { return try self.check_expr_compound(arena, expr_id, e, expected); }
            .ArrayLit => { return try self.check_expr_compound(arena, expr_id, e, expected); }
            .ArrayRepeat => { return try self.check_expr_compound(arena, expr_id, e, expected); }
            .AnonStructLit => { return try self.check_expr_compound(arena, expr_id, e, expected); }
            .NamedStructLit => { return try self.check_expr_compound(arena, expr_id, e, expected); }
            .ComptimeBlock => { return try self.check_expr_compound(arena, expr_id, e, expected); }
            .ComptimeExpr => { return try self.check_expr_compound(arena, expr_id, e, expected); }
            .Unary => {
                if e.unary_op == .Neg {
                    if let inn = arena.get_expr(e.a) {
                        if inn.kind == .IntLit {
                            return try self.check_int_lit(inn.a, inn.b, true, expected, e.span);
                        }
                    }
                }
                return try self.check_unary(arena, e.unary_op, e.a, expected, e.span);
            }
            .Binary => { return try self.check_binary(arena, e.bin_op, e.a, e.b, expected, e.span); }
            .If => {
                let r = try self.check_if(arena, e.a, expected);
                return r.ty;
            }
            .Match => {
                let r = try self.check_match(arena, e.a, e.list, expected, e.span);
                return r.ty;
            }
            .Loop => {
                try self.push_loop_frame(ast.ident_is_some(e.ident), e.ident.sym);
                let snap_mark = self.st.move_snaps.len();
                let base_moves = try self.snapshot_moves();
                try self.push_scope();
                _ = try self.check_block_stmts(arena, e.a);
                try self.pop_scope();
                self.restore_moves(base_moves);
                self.pop_move_snaps_to(snap_mark);
                return self.pop_loop_frame_first_break() orelse types.TY_NEVER;
            }
            .Builtin => { return try self.check_builtin(arena, expr_id, e.ident, e.list, expected, e.span); }
            .Is => {
                let lt = try self.check_expr(arena, e.a, types.TY_NONE);
                try self.push_scope();
                try self.bind_pattern(arena, e.b, lt, true);
                try self.pop_scope();
                return types.TY_BOOL;
            }
            .Orelse => { return try self.check_orelse(arena, e.a, e.body_kind, e.b, expected); }
            .Catch => { return try self.check_catch(arena, e.a, e.ident, e.body_kind, e.b, expected); }
            .Field => { return try self.check_field_access(arena, e.a, e.ident, e.span); }
            .Deref => {
                let t = try self.check_expr(arena, e.a, types.TY_NONE);
                let n = self.env.get(t);
                if (n.kind == .Borrow && n.borrow_kind == .Single) || n.kind == .RawPtr {
                    return n.primary;
                }
                if n.kind == .Error {
                    return types.TY_ERROR;
                }
                try self.emit_err_ty2(
                    diag.E0230, e.span, "cannot dereference value of type `", t, "`",
                );
                return types.TY_ERROR;
            }
            .GenericApply => { return try self.check_generic_apply(arena, e.a, e.list, e.span); }
            .Call => { return try self.check_call(arena, expr_id, e.a, e.list, expected, e.span); }
            .Index => {
                let bt = try self.check_expr(arena, e.a, types.TY_NONE);
                let it = try self.check_expr(arena, e.b, types.TY_NONE);
                try self.check_index_ty(arena, e.a, it, expr_span(arena, e.b));
                return try self.index_elem_ty(bt, e.span);
            }
            .Slice => { return try self.check_expr_null_or_slice(arena, e, expected); }
            .Closure => { return try self.check_closure(arena, e.list, e.a, expected); }
            .Asm => { return try self.check_expr_null_or_slice(arena, e, expected); }
        }
    }

    @recursive
    fn check_anon_struct_lit(
        self: *mut Self,
        arena: *ast.AstArena,
        fields_range: ast.IdRange,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let fields = arena.field_inits_range(fields_range);
        if expected != types.TY_NONE {
            let en = self.env.get(expected);
            if en.kind == .Struct {
                var args = try col.DynBuf.[types.GenericVal].init(self.alloc, en.list_len.widen.[usize]() +% 1_usize);
                errdefer args.destroy(self.alloc);
                try args.push_slice(self.alloc, self.env.node_gval_list(&en));
                try self.check_struct_fields_init(arena, en.primary, args.as_slice(), fields_range, sp);
                args.destroy(self.alloc);
                return expected;
            }
            if en.kind == .Pool {
                var args = try col.DynBuf.[types.GenericVal].init(self.alloc, en.list_len.widen.[usize]() +% 1_usize);
                errdefer args.destroy(self.alloc);
                try args.push_slice(self.alloc, self.env.node_gval_list(&en));
                try self.check_pool_fields_init(arena, en.primary, args.as_slice(), fields_range, sp);
                args.destroy(self.alloc);
                return expected;
            }
            if en.kind == .Bitfield {
                try self.check_bitfield_fields_init(arena, en.primary, fields_range);
                return expected;
            }
            if en.kind == .Vec {
                var all_unnamed = true;
                var fi: usize = 0_usize;
                while fi < fields.len {
                    if ast.ident_is_some(fields[fi].name) {
                        all_unnamed = false;
                        break;
                    }
                    fi = fi +% 1_usize;
                }
                if all_unnamed {
                    if fields.len != en.u8_val.widen.[usize]() {
                        var msg = try str.StrBuf.init(self.alloc, 64_usize);
                        errdefer msg.destroy(self.alloc);
                        try msg.push_str_grow(self.alloc, "expected ");
                        try msg.push_u64_grow(self.alloc, en.u8_val.widen.[u64]());
                        try msg.push_str_grow(self.alloc, " vector elements, found ");
                        try msg.push_u64_grow(self.alloc, fields.len.widen.[u64]());
                        try self.emit_err_buf(diag.E0230, sp, &msg);
                        msg.destroy(self.alloc);
                    }
                    var fj: usize = 0_usize;
                    while fj < fields.len {
                        let t = try self.check_expr_rvalue(arena, fields[fj].value, en.primary);
                        try self.expect_assignable(t, en.primary, expr_span(arena, fields[fj].value));
                        fj = fj +% 1_usize;
                    }
                    return expected;
                }
            }
        }
        var pairs = try col.DynBuf.[types.AnonField].init(self.alloc, fields.len +% 1_usize);
        errdefer pairs.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < fields.len {
            let f = fields[i];
            let t = try self.check_expr_rvalue(arena, f.value, types.TY_NONE);
            let nm = if ast.ident_is_some(f.name) {
                f.name.sym
            } else {
                try self.interner.intern_str(self.alloc, "_")
            };
            try pairs.push(self.alloc, types.AnonField.{ name: nm, ty: t });
            i = i +% 1_usize;
        }
        let res = try self.env.intern_anon_struct(self.alloc, pairs.as_slice());
        pairs.destroy(self.alloc);
        return res;
    }

    @recursive
    fn check_pool_fields_init(
        self: *mut Self,
        arena: *ast.AstArena,
        pool_def: u32,
        args: *[types.GenericVal],
        inits_range: ast.IdRange,
        sp: span.Span,
    ) -> !OutOfMemory {
        var has_meta = false;
        var cols_range = ast.range_empty();
        if let pm = self.env.get_pool(pool_def) {
            has_meta = true;
            cols_range = pm.columns;
        }
        if !has_meta {
            return;
        }
        let inits = arena.field_inits_range(inits_range);
        var seen = try col.HashMap.[u8].init(self.alloc, inits.len +% 4_usize);
        errdefer seen.destroy(self.alloc);

        var i: usize = 0_usize;
        while i < inits.len {
            let f = inits[i];
            if !ast.ident_is_some(f.name) {
                try self.emit_err(
                    diag.E0230, f.span, "pool row initializers must specify column names",
                );
                _ = try self.check_expr_rvalue(arena, f.value, types.TY_NONE);
                i = i +% 1_usize;
                continue;
            }
            try seen.insert(self.alloc, f.name.sym.widen.[u64](), 1_u8);
            var col_found = false;
            var col_raw_ty = types.TY_ERROR;
            let cols = self.env.pool_cols_range(cols_range);
            var ci: usize = 0_usize;
            while ci < cols.len {
                if cols[ci].name == f.name.sym {
                    col_found = true;
                    col_raw_ty = cols[ci].ty;
                    break;
                }
                ci = ci +% 1_usize;
            }
            if !col_found {
                try self.emit_err_sym2(
                    diag.E0132, f.name.span, "pool has no column named `", f.name.sym, "`",
                );
                _ = try self.check_expr_rvalue(arena, f.value, types.TY_NONE);
                i = i +% 1_usize;
                continue;
            }
            let raw_cty = try subst_ty(self.alloc, self.env, col_raw_ty, args);
            let exp_cty = if self.has_pool_handle_kind {
                let pool_ty = try self.env.intern_pool(self.alloc, pool_def, args);
                try self.env.resolve_pool_link_ty(
                    self.alloc, raw_cty, pool_ty, self.pool_handle_kind,
                )
            } else {
                raw_cty
            };
            let got = try self.check_expr_rvalue(arena, f.value, exp_cty);
            try self.expect_assignable(got, exp_cty, expr_span(arena, f.value));
            i = i +% 1_usize;
        }
        let col_cnt = cols_range.len.widen.[usize]();
        var cj: usize = 0_usize;
        while cj < col_cnt {
            var cname = span.SYM_EMPTY;
            let cs = self.env.pool_cols_range(cols_range);
            if cj < cs.len {
                cname = cs[cj].name;
            }
            if !seen.contains(cname.widen.[u64]()) {
                try self.emit_err_sym2(
                    diag.E0116, sp, "ZM-16: missing pool column `", cname, "` in row initializer",
                );
            }
            cj = cj +% 1_usize;
        }
        seen.destroy(self.alloc);
        return;
    }

    @recursive
    fn check_named_struct_lit(
        self: *mut Self,
        arena: *ast.AstArena,
        target_id: u32,
        fields_range: ast.IdRange,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        var gargs = try col.DynBuf.[types.GenericVal].init(self.alloc, 4_usize);
        errdefer gargs.destroy(self.alloc);
        let def_opt = try self.resolve_type_target_expr(arena, target_id, &mut gargs);
        let def_id = def_opt orelse {
            let fields = arena.field_inits_range(fields_range);
            var i: usize = 0_usize;
            while i < fields.len {
                _ = try self.check_expr_rvalue(arena, fields[i].value, types.TY_NONE);
                i = i +% 1_usize;
            }
            gargs.destroy(self.alloc);
            return types.TY_ERROR;
        };
        if let _ = self.env.get_bitfield(def_id) {
            try self.check_bitfield_fields_init(arena, def_id, fields_range);
            let bf_ty = try self.env.intern_bitfield(self.alloc, def_id);
            gargs.destroy(self.alloc);
            return bf_ty;
        }
        if let _ = self.env.get_struct(def_id) {
            // valid struct
        } else {
            try self.emit_err(
                diag.E0230, expr_span(arena, target_id), "struct literal requires a struct type",
            );
            gargs.destroy(self.alloc);
            return types.TY_ERROR;
        }
        if gargs.is_empty() && expected != types.TY_NONE {
            let en = self.env.get(expected);
            if en.kind == .Struct && en.primary == def_id {
                try gargs.push_slice(self.alloc, self.env.node_gval_list(&en));
            }
        }
        try self.check_struct_fields_init(arena, def_id, gargs.as_slice(), fields_range, sp);
        let res = try self.env.intern_struct(self.alloc, def_id, gargs.as_slice());
        gargs.destroy(self.alloc);
        return res;
    }

    @recursive
    fn check_bitfield_fields_init(
        self: *mut Self,
        arena: *ast.AstArena,
        def_id: u32,
        inits_range: ast.IdRange,
    ) -> !OutOfMemory {
        var has_meta = false;
        var mems_range = ast.range_empty();
        if let bm = self.env.get_bitfield(def_id) {
            has_meta = true;
            mems_range = bm.members;
        }
        if !has_meta {
            return;
        }
        let inits = arena.field_inits_range(inits_range);
        var seen = try col.HashMap.[u8].init(self.alloc, inits.len +% 4_usize);
        errdefer seen.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < inits.len {
            let f = inits[i];
            if !ast.ident_is_some(f.name) {
                try self.emit_err(
                    diag.E0230, f.span, "bitfield literal initializers must specify member names",
                );
                _ = try self.check_expr_rvalue(arena, f.value, types.TY_NONE);
                i = i +% 1_usize;
                continue;
            }
            let key = f.name.sym.widen.[u64]();
            if seen.contains(key) {
                try self.emit_err_sym2(
                    diag.E0132, f.name.span, "duplicate bitfield member `", f.name.sym, "` in initializer",
                );
            } else {
                try seen.insert(self.alloc, key, 1_u8);
            }
            var found = false;
            var mb_ty = types.TY_ERROR;
            let ms = self.env.bitfield_members_range(mems_range);
            var mi: usize = 0_usize;
            while mi < ms.len {
                if ms[mi].name == f.name.sym {
                    found = true;
                    mb_ty = ms[mi].ty;
                    break;
                }
                mi = mi +% 1_usize;
            }
            if !found {
                try self.emit_err_sym2(
                    diag.E0132, f.name.span, "bitfield has no member named `", f.name.sym, "`",
                );
                _ = try self.check_expr_rvalue(arena, f.value, types.TY_NONE);
                i = i +% 1_usize;
                continue;
            }
            let got = try self.check_expr_rvalue(arena, f.value, mb_ty);
            try self.expect_assignable(got, mb_ty, expr_span(arena, f.value));
            i = i +% 1_usize;
        }
        seen.destroy(self.alloc);
        return;
    }

    @recursive
    fn check_struct_fields_init(
        self: *mut Self,
        arena: *ast.AstArena,
        def_id: u32,
        args: *[types.GenericVal],
        inits_range: ast.IdRange,
        sp: span.Span,
    ) -> !OutOfMemory {
        var has_meta = false;
        var s_mod: u32 = resolve.MODULE_NONE;
        var fields_r = ast.range_empty();
        if let meta = self.env.get_struct(def_id) {
            has_meta = true;
            s_mod = meta.module_id;
            fields_r = meta.fields;
        }
        if !has_meta {
            return;
        }
        let inits = arena.field_inits_range(inits_range);
        var seen = try col.HashMap.[u8].init(self.alloc, inits.len +% 4_usize);
        errdefer seen.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < inits.len {
            let f = inits[i];
            if !ast.ident_is_some(f.name) {
                try self.emit_err(
                    diag.E0230, f.span, "struct literal initializers must specify field names",
                );
                _ = try self.check_expr_rvalue(arena, f.value, types.TY_NONE);
                i = i +% 1_usize;
                continue;
            }
            let key = f.name.sym.widen.[u64]();
            if seen.contains(key) {
                try self.emit_err_sym2(
                    diag.E0132, f.name.span, "duplicate field `", f.name.sym, "` in struct literal",
                );
            } else {
                try seen.insert(self.alloc, key, 1_u8);
            }
            var found = false;
            var f_is_pub = true;
            var f_raw_ty = types.TY_ERROR;
            let mfs = self.env.struct_fields_range(fields_r);
            var mi: usize = 0_usize;
            while mi < mfs.len {
                if mfs[mi].name == f.name.sym {
                    found = true;
                    f_is_pub = mfs[mi].is_pub;
                    f_raw_ty = mfs[mi].ty;
                    break;
                }
                mi = mi +% 1_usize;
            }
            if !found {
                try self.emit_err_sym2(
                    diag.E0132, f.name.span, "struct has no field named `", f.name.sym, "`",
                );
                _ = try self.check_expr_rvalue(arena, f.value, types.TY_NONE);
                i = i +% 1_usize;
                continue;
            }
            if !f_is_pub && s_mod != self.mod_id {
                try self.emit_err_sym2(
                    diag.E0133, f.name.span, "field `", f.name.sym, "` is private",
                );
            }
            let exp_fty = try subst_ty(self.alloc, self.env, f_raw_ty, args);
            let got = try self.check_expr_rvalue(arena, f.value, exp_fty);
            try self.expect_assignable(got, exp_fty, expr_span(arena, f.value));
            i = i +% 1_usize;
        }
        let fcnt = fields_r.len.widen.[usize]();
        var fj: usize = 0_usize;
        while fj < fcnt {
            var mname = span.SYM_EMPTY;
            var has_def = false;
            let mfs = self.env.struct_fields_range(fields_r);
            if fj < mfs.len {
                mname = mfs[fj].name;
                has_def = mfs[fj].has_default;
            }
            if !seen.contains(mname.widen.[u64]()) && !has_def {
                try self.emit_err_sym2(
                    diag.E0116, sp, "ZM-16: missing struct field `", mname, "` in initializer",
                );
            }
            fj = fj +% 1_usize;
        }
        seen.destroy(self.alloc);
        return;
    }

    @recursive
    fn extract_path_idents(
        self: *Self,
        arena: *ast.AstArena,
        expr_id: u32,
        out: *mut col.DynBuf[ast.IdentSpan],
    ) -> bool ! OutOfMemory {
        let e = arena.get_expr(expr_id) orelse { return false; };
        if e.kind == .Ident {
            try out.push(self.alloc, ast.ident_new(e.a, e.span));
            return true;
        }
        if e.kind == .Field {
            if !(try self.extract_path_idents(arena, e.a, out)) {
                return false;
            }
            try out.push(self.alloc, e.ident);
            return true;
        }
        return false;
    }

    @recursive
    fn resolve_type_target_expr(
        self: *mut Self,
        arena: *ast.AstArena,
        expr_id: u32,
        out_gargs: *mut col.DynBuf[types.GenericVal],
    ) -> ?u32 ! OutOfMemory {
        let e = arena.get_expr(expr_id) orelse { return null; };
        if e.kind == .GenericApply {
            let base_def = (try self.resolve_type_target_expr(arena, e.a, out_gargs)) orelse {
                return null;
            };
            out_gargs.clear();
            let gargs = arena.generic_args_range(e.list);
            var i: usize = 0_usize;
            while i < gargs.len {
                let gv = try self.eval_generic_arg(arena, &gargs[i]);
                try out_gargs.push(self.alloc, gv);
                i = i +% 1_usize;
            }
            return base_def;
        }
        var segs = try col.DynBuf.[ast.IdentSpan].init(self.alloc, 4_usize);
        errdefer segs.destroy(self.alloc);
        if !(try self.extract_path_idents(arena, expr_id, &mut segs)) {
            segs.destroy(self.alloc);
            return null;
        }
        let target = (try types.resolve_path_segments(
            self.alloc, segs.as_slice(), self.mod_id, self.prog, self.interner, self.diags,
        )) orelse {
            segs.destroy(self.alloc);
            return null;
        };
        if target.kind == .Def {
            segs.destroy(self.alloc);
            return target.target_id;
        }
        try self.emit_err(diag.E0230, e.span, "expected user-defined type");
        segs.destroy(self.alloc);
        return null;
    }

    fn resolve_value_path(
        self: *mut Self,
        segs: *[ast.IdentSpan],
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if segs.len == 2_usize {
            if is_prim_minmax_name(self.interner.get(segs[1_usize].sym)) {
                let pt_opt = try self.prim_from_suffix(segs[0_usize].sym);
                if let pt = pt_opt {
                    return pt;
                }
            }
        }
        let target = (try types.resolve_path_segments(
            self.alloc, segs, self.mod_id, self.prog, self.interner, self.diags,
        )) orelse {
            return types.TY_ERROR;
        };
        if target.kind == .Def {
            let d = target.target_id;
            if let sig = self.env.get_fn(d) {
                let pr = sig.params;
                let ret = sig.ret;
                var ptys = try col.DynBuf.[types.TyId].init(self.alloc, pr.len.widen.[usize]() +% 1_usize);
                errdefer ptys.destroy(self.alloc);
                let ps = self.env.params_range(pr);
                var i: usize = 0_usize;
                while i < ps.len {
                    try ptys.push(self.alloc, ps[i].ty);
                    i = i +% 1_usize;
                }
                let fty = try self.env.intern_fn_ptr(self.alloc, ptys.as_slice(), ret);
                ptys.destroy(self.alloc);
                return fty;
            }
            if let cm = self.env.get_const(d) {
                return cm.ty;
            }
            if let td = self.prog.get_def(d) {
                if td.kind == .Struct || td.kind == .Enum || td.kind == .Union {
                    return types.TY_TYPE_TYPE;
                }
                if td.kind == .Sys {
                    return types.TY_VOID;
                }
            }
            return types.TY_ERROR;
        }
        if target.kind == .Builtin {
            let binfo = resolve.decode_builtin(target.target_id);
            if binfo.kind == .Prim || binfo.kind == .VecType || binfo.kind == .SimdAlias {
                return types.TY_TYPE_TYPE;
            }
            return types.TY_ERROR;
        }
        try self.emit_err(diag.E0230, sp, "expected value, found module");
        return types.TY_ERROR;
    }
}

// ===========================================================================
// Section 6: Unary, Borrow, Binary, If, Match, Orelse, Catch, and Builtins
// ===========================================================================

impl Checker {
    fn error_sources_compatible(
        self: *Self,
        src: types.ErrorSource,
        allowed: *[types.ErrorSource],
    ) -> bool {
        var i: usize = 0_usize;
        while i < allowed.len {
            if err_src_eq(src, allowed[i]) {
                return true;
            }
            i = i +% 1_usize;
        }
        if src.kind == .Builtin && src.builtin == .OutOfMemory {
            var j: usize = 0_usize;
            while j < allowed.len {
                if allowed[j].kind == .Builtin && allowed[j].builtin == .MemError {
                    return true;
                }
                j = j +% 1_usize;
            }
        }
        if src.kind == .User {
            if let meta = self.env.get_error(src.def_id) {
                let vs = self.env.error_variants_range(meta.variants);
                var vi: usize = 0_usize;
                while vi < vs.len {
                    if !self.env.error_sources_have_variant(allowed, vs[vi], self.interner) {
                        return false;
                    }
                    vi = vi +% 1_usize;
                }
                return true;
            }
        }
        return false;
    }

    @recursive
    fn check_unary(
        self: *mut Self,
        arena: *ast.AstArena,
        op: ast.UnaryOp,
        inner_id: u32,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        match op {
            .Neg => {
                let t = try self.check_expr(arena, inner_id, expected);
                if t == types.TY_ERROR {
                    return types.TY_ERROR;
                }
                let tn = self.env.get(t);
                let vec_ok = tn.kind == .Vec
                    && (self.env.is_signed_integer(tn.primary) || self.env.is_float(tn.primary));
                if !self.env.is_signed_integer(t) && !self.env.is_float(t) && !vec_ok {
                    try self.emit_err_ty2(
                        diag.E0230, sp, "unary `-` requires signed numeric type, found `", t, "`",
                    );
                }
                return t;
            }
            .Not => {
                let t = try self.check_expr(arena, inner_id, types.TY_BOOL);
                if t != types.TY_ERROR && t != types.TY_BOOL {
                    try self.emit_err_ty2(
                        diag.E0230, sp, "logical `!` requires `bool`, found `", t, "`",
                    );
                }
                return types.TY_BOOL;
            }
            .BitNot => {
                let t = try self.check_expr(arena, inner_id, expected);
                if t != types.TY_ERROR && !self.env.is_integer(t) {
                    try self.emit_err_ty2(
                        diag.E0230, sp, "bitwise `~` requires integer type, found `", t, "`",
                    );
                }
                return t;
            }
            .Borrow => { return try self.check_borrow(arena, inner_id, false, expected, sp); }
            .BorrowMut => { return try self.check_borrow(arena, inner_id, true, expected, sp); }
            .Move => { return try self.check_expr_rvalue(arena, inner_id, expected); }
            .Copy => {
                let t = try self.check_expr(arena, inner_id, expected);
                if t != types.TY_ERROR && self.env.is_linear(t) {
                    try self.emit_err_ty2(
                        diag.E0320, sp, "cannot `copy` a `linear` value of type `", t, "`",
                    );
                }
                return t;
            }
            .Try => {
                let t = try self.check_expr(arena, inner_id, types.TY_NONE);
                let tn = self.env.get(t);
                if tn.kind == .Error {
                    return types.TY_ERROR;
                }
                if tn.kind != .ErrorUnion {
                    try self.emit_err_ty2(
                        diag.E0230, sp, "`try` requires an error union `T ! E`, found `", t, "`",
                    );
                    return types.TY_ERROR;
                }
                let ok_ty = tn.primary;
                var errs = try col.DynBuf.[types.ErrorSource].init(
                    self.alloc, tn.list_len.widen.[usize]() +% 1_usize,
                );
                errdefer errs.destroy(self.alloc);
                try errs.push_slice(self.alloc, self.env.node_err_src_list(&tn));
                let rn = self.env.get(self.sig.ret);
                if rn.kind == .ErrorUnion {
                    var rerrs = try col.DynBuf.[types.ErrorSource].init(
                        self.alloc, rn.list_len.widen.[usize]() +% 1_usize,
                    );
                    errdefer rerrs.destroy(self.alloc);
                    try rerrs.push_slice(self.alloc, self.env.node_err_src_list(&rn));
                    let es = errs.as_slice();
                    var i: usize = 0_usize;
                    while i < es.len {
                        if !self.error_sources_compatible(es[i], rerrs.as_slice()) {
                            let src_ty = try self.env.intern_error_set(self.alloc, es[i]);
                            try self.emit_err_ty_ty(
                                diag.E0230,
                                sp,
                                "`try` error `",
                                src_ty,
                                "` cannot convert into function return type `",
                                self.sig.ret,
                                "`",
                            );
                        }
                        i = i +% 1_usize;
                    }
                    rerrs.destroy(self.alloc);
                } else if rn.kind != .Error {
                    try self.emit_err_ty2(
                        diag.E0230,
                        sp,
                        "`try` used in function returning `",
                        self.sig.ret,
                        "` instead of an error union `... ! E`",
                    );
                }
                errs.destroy(self.alloc);
                return ok_ty;
            }
        }
    }

    fn borrow_of(self: *mut Self, t: types.TyId, is_mut: bool) -> types.TyId ! OutOfMemory {
        if self.env.get(t).kind == .Str {
            return try self.env.intern_borrow(self.alloc, is_mut, .Str, types.TY_VOID);
        }
        return try self.env.intern_borrow(self.alloc, is_mut, .Single, t);
    }

    @recursive
    fn check_place_mutability(self: *mut Self, arena: *ast.AstArena, expr_id: u32, sp: span.Span) -> !OutOfMemory {
        let e = arena.get_expr(expr_id) orelse { return; };
        match e.kind {
            .Ident => {
                if let id = self.lookup_local(e.a) {
                    var is_mut = false;
                    var ty = types.TY_ERROR;
                    var name_sym = span.SYM_EMPTY;
                    if let l = self.st.locals.get_mut(id.widen.[usize]()) {
                        l.used = true;
                        l.mutated = true;
                        is_mut = l.is_mut;
                        ty = l.ty;
                        name_sym = l.name;
                    }
                    let tn = self.env.get(ty);
                    let mut_borrow = (tn.kind == .Borrow || tn.kind == .RawPtr) && tn.flag0;
                    if !is_mut && !mut_borrow {
                        try self.emit_err_sym2(
                            diag.E0230, sp, "cannot mutably borrow immutable binding `", name_sym, "`",
                        );
                    }
                }
            }
            .Field => { try self.check_place_mutability(arena, e.a, sp); }
            .Index => { try self.check_place_mutability(arena, e.a, sp); }
            .Paren => { try self.check_place_mutability(arena, e.a, sp); }
            _ => {}
        }
        return;
    }

    @recursive
    fn check_borrow(
        self: *mut Self,
        arena: *ast.AstArena,
        inner_id: u32,
        is_mut: bool,
        _expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let inn = arena.get_expr(inner_id) orelse { return types.TY_ERROR; };
        if inn.kind == .Slice {
            if is_mut {
                try self.check_place_mutability(arena, inn.a, sp);
            }
            let bt = try self.check_expr(arena, inn.a, types.TY_NONE);
            if inn.b != ast.NONE_ID {
                let lt = try self.check_expr(arena, inn.b, types.TY_USIZE);
                if lt != types.TY_ERROR && !self.env.is_integer(lt) {
                    try self.emit_err(diag.E0230, expr_span(arena, inn.b), "slice bound must be integer");
                }
            }
            if inn.c != ast.NONE_ID {
                let ht = try self.check_expr(arena, inn.c, types.TY_USIZE);
                if ht != types.TY_ERROR && !self.env.is_integer(ht) {
                    try self.emit_err(diag.E0230, expr_span(arena, inn.c), "slice bound must be integer");
                }
            }
            let raw_slice = try self.slice_result_ty(bt, inn.span);
            let rsn = self.env.get(raw_slice);
            if rsn.kind == .Borrow && rsn.borrow_kind == .Slice {
                return try self.env.intern_borrow(self.alloc, is_mut, .Slice, rsn.primary);
            }
            return raw_slice;
        }
        if inn.kind == .Field {
            if is_mut {
                try self.check_place_mutability(arena, inn.a, sp);
            }
            let bt = try self.check_expr(arena, inn.a, types.TY_NONE);
            let btn = self.env.get(bt);
            let base_deref = if btn.kind == .Borrow && btn.borrow_kind == .Single {
                btn.primary
            } else {
                bt
            };
            let bdn = self.env.get(base_deref);
            if bdn.kind == .Struct {
                var misaligned = false;
                if let sm = self.env.get_struct(bdn.primary) {
                    if sm.is_packed {
                        let fs = self.env.struct_fields_range(sm.fields);
                        var fi: usize = 0_usize;
                        while fi < fs.len {
                            if fs[fi].name == inn.ident.sym {
                                misaligned = fs[fi].misaligned_in_packed;
                                break;
                            }
                            fi = fi +% 1_usize;
                        }
                    }
                }
                if misaligned {
                    try self.emit_err_sym2(
                        diag.E0215,
                        sp,
                        "cannot borrow misaligned field `",
                        inn.ident.sym,
                        "` of `@packed` struct; copy it out by value instead",
                    );
                }
            }
            let brand = extract_root_ident_sym(arena, inn.a);
            if bdn.kind == .Builtin
                && (bdn.builtin_kind == .ArenaPool || bdn.builtin_kind == .SlotPool)
            {
                let fty = try self.resolve_field_type(bt, inn.ident, is_mut, brand, inn.span);
                let fn_node = self.env.get(fty);
                if fn_node.kind == .Borrow && fn_node.borrow_kind == .Slice {
                    return try self.env.intern_borrow(self.alloc, is_mut, .Slice, fn_node.primary);
                }
                return fty;
            }
            let fty = try self.resolve_field_type(bt, inn.ident, is_mut, brand, inn.span);
            return try self.borrow_of(fty, is_mut);
        }
        if is_mut {
            try self.check_place_mutability(arena, inner_id, sp);
        }
        let t = try self.check_expr(arena, inner_id, types.TY_NONE);
        if t == types.TY_ERROR {
            return types.TY_ERROR;
        }
        return try self.borrow_of(t, is_mut);
    }

    fn check_same_operand_types(
        self: *mut Self,
        lt: types.TyId,
        rt: types.TyId,
        sp: span.Span,
    ) -> bool ! OutOfMemory {
        if lt == rt {
            return true;
        }
        if (lt == types.TY_COMPTIME_INT && self.env.is_concrete_integer(rt))
            || (rt == types.TY_COMPTIME_INT && self.env.is_concrete_integer(lt))
            || (lt == types.TY_COMPTIME_FLOAT && self.env.is_float(rt))
            || (rt == types.TY_COMPTIME_FLOAT && self.env.is_float(lt))
        {
            return true;
        }
        if self.env.is_address(lt) || self.env.is_address(rt) {
            try self.emit_err_ty_ty(
                diag.E0211, sp, "incompatible address types `", lt, "` and `", rt, "`",
            );
            return false;
        }
        if self.env.is_numeric(lt) && self.env.is_numeric(rt) {
            try self.emit_err_ty_ty(
                diag.E0105,
                sp,
                "ZM-05: cannot mix `",
                lt,
                "` and `",
                rt,
                "` without an explicit conversion (.widen/.trunc/...)",
            );
            return false;
        }
        try self.emit_err_ty_ty(
            diag.E0230, sp, "type mismatch between `", lt, "` and `", rt, "`",
        );
        return false;
    }

    @recursive
    fn check_numeric_pair(
        self: *mut Self,
        arena: *ast.AstArena,
        lhs_id: u32,
        rhs_id: u32,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        var lt = try self.check_expr(arena, lhs_id, expected);
        let rhs_hint = if expected != types.TY_NONE {
            expected
        } else if lt != types.TY_COMPTIME_INT && lt != types.TY_COMPTIME_FLOAT && lt != types.TY_ERROR {
            lt
        } else {
            types.TY_NONE
        };
        let rt = try self.check_expr(arena, rhs_id, rhs_hint);
        if (lt == types.TY_COMPTIME_INT || lt == types.TY_COMPTIME_FLOAT)
            && rt != types.TY_COMPTIME_INT
            && rt != types.TY_COMPTIME_FLOAT
            && rt != types.TY_ERROR
        {
            lt = try self.check_expr(arena, lhs_id, rt);
        }
        if lt == types.TY_ERROR || rt == types.TY_ERROR {
            return types.TY_ERROR;
        }
        if self.env.is_address(lt) || self.env.is_address(rt) {
            try self.emit_err_ty_ty(
                diag.E0211,
                sp,
                "cannot perform direct arithmetic on address types `",
                lt,
                "` and `",
                rt,
                "`",
            );
            return types.TY_ERROR;
        }
        if !(try self.check_same_operand_types(lt, rt, sp)) {
            return types.TY_ERROR;
        }
        if lt == types.TY_COMPTIME_INT && rt == types.TY_COMPTIME_INT {
            return types.TY_COMPTIME_INT;
        }
        if lt == types.TY_COMPTIME_FLOAT && rt == types.TY_COMPTIME_FLOAT {
            return types.TY_COMPTIME_FLOAT;
        }
        if !self.env.is_numeric(lt) && self.env.get(lt).kind != .Vec {
            try self.emit_err_ty2(
                diag.E0230, sp, "operator requires numeric operands, found `", lt, "`",
            );
            return types.TY_ERROR;
        }
        return lt;
    }

    @recursive
    fn check_binary(
        self: *mut Self,
        arena: *ast.AstArena,
        op: ast.BinaryOp,
        lhs_id: u32,
        rhs_id: u32,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        match op {
            .And => {
                let lt = try self.check_expr(arena, lhs_id, types.TY_BOOL);
                let rt = try self.check_expr(arena, rhs_id, types.TY_BOOL);
                if lt != types.TY_ERROR && lt != types.TY_BOOL {
                    try self.emit_err(diag.E0230, expr_span(arena, lhs_id), "boolean operator requires `bool`");
                }
                if rt != types.TY_ERROR && rt != types.TY_BOOL {
                    try self.emit_err(diag.E0230, expr_span(arena, rhs_id), "boolean operator requires `bool`");
                }
                return types.TY_BOOL;
            }
            .Or => {
                let lt = try self.check_expr(arena, lhs_id, types.TY_BOOL);
                let rt = try self.check_expr(arena, rhs_id, types.TY_BOOL);
                if lt != types.TY_ERROR && lt != types.TY_BOOL {
                    try self.emit_err(diag.E0230, expr_span(arena, lhs_id), "boolean operator requires `bool`");
                }
                if rt != types.TY_ERROR && rt != types.TY_BOOL {
                    try self.emit_err(diag.E0230, expr_span(arena, rhs_id), "boolean operator requires `bool`");
                }
                return types.TY_BOOL;
            }
            .Eq => { return try self.check_cmp_binary(arena, lhs_id, rhs_id, sp); }
            .NotEq => { return try self.check_cmp_binary(arena, lhs_id, rhs_id, sp); }
            .Lt => { return try self.check_cmp_binary(arena, lhs_id, rhs_id, sp); }
            .LtEq => { return try self.check_cmp_binary(arena, lhs_id, rhs_id, sp); }
            .Gt => { return try self.check_cmp_binary(arena, lhs_id, rhs_id, sp); }
            .GtEq => { return try self.check_cmp_binary(arena, lhs_id, rhs_id, sp); }
            .Shl => { return try self.check_shift_binary(arena, lhs_id, rhs_id, expected); }
            .Shr => { return try self.check_shift_binary(arena, lhs_id, rhs_id, expected); }
            .ShlWrap => { return try self.check_shift_binary(arena, lhs_id, rhs_id, expected); }
            .AddCheck => { return try self.check_checked_arith_binary(arena, lhs_id, rhs_id, expected, sp); }
            .SubCheck => { return try self.check_checked_arith_binary(arena, lhs_id, rhs_id, expected, sp); }
            .MulCheck => { return try self.check_checked_arith_binary(arena, lhs_id, rhs_id, expected, sp); }
            .DivCheck => { return try self.check_checked_arith_binary(arena, lhs_id, rhs_id, expected, sp); }
            .ModCheck => { return try self.check_checked_arith_binary(arena, lhs_id, rhs_id, expected, sp); }
            .BitAnd => { return try self.check_bitwise_binary(arena, lhs_id, rhs_id, expected, sp); }
            .BitOr => { return try self.check_bitwise_binary(arena, lhs_id, rhs_id, expected, sp); }
            .BitXor => { return try self.check_bitwise_binary(arena, lhs_id, rhs_id, expected, sp); }
            _ => { return try self.check_numeric_pair(arena, lhs_id, rhs_id, expected, sp); }
        }
    }

    @recursive
    fn check_cmp_binary(
        self: *mut Self,
        arena: *ast.AstArena,
        lhs_id: u32,
        rhs_id: u32,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        var lt = try self.check_expr(arena, lhs_id, types.TY_NONE);
        let hint = if lt != types.TY_COMPTIME_INT && lt != types.TY_COMPTIME_FLOAT && lt != types.TY_ERROR {
            lt
        } else {
            types.TY_NONE
        };
        let rt = try self.check_expr(arena, rhs_id, hint);
        if (lt == types.TY_COMPTIME_INT || lt == types.TY_COMPTIME_FLOAT)
            && rt != types.TY_COMPTIME_INT
            && rt != types.TY_COMPTIME_FLOAT
            && rt != types.TY_ERROR
        {
            lt = try self.check_expr(arena, lhs_id, rt);
        }
        if lt != types.TY_ERROR && rt != types.TY_ERROR {
            _ = try self.check_same_operand_types(lt, rt, sp);
        }
        return types.TY_BOOL;
    }

    @recursive
    fn check_shift_binary(
        self: *mut Self,
        arena: *ast.AstArena,
        lhs_id: u32,
        rhs_id: u32,
        expected: types.TyId,
    ) -> types.TyId ! OutOfMemory {
        let lt = try self.check_expr(arena, lhs_id, expected);
        let rt = try self.check_expr(arena, rhs_id, types.TY_NONE);
        if lt != types.TY_ERROR && !self.env.is_integer(lt) {
            try self.emit_err(diag.E0230, expr_span(arena, lhs_id), "shift requires integer left operand");
        }
        if rt != types.TY_ERROR && !self.env.is_integer(rt) {
            try self.emit_err(diag.E0230, expr_span(arena, rhs_id), "shift count must be an integer");
        }
        return lt;
    }

    @recursive
    fn check_checked_arith_binary(
        self: *mut Self,
        arena: *ast.AstArena,
        lhs_id: u32,
        rhs_id: u32,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        var elem_exp = types.TY_NONE;
        if expected != types.TY_NONE {
            let en = self.env.get(expected);
            if en.kind == .ErrorUnion {
                elem_exp = en.primary;
            }
        }
        let t = try self.check_numeric_pair(arena, lhs_id, rhs_id, elem_exp, sp);
        let errs: [1]types.ErrorSource = [types.err_src_builtin(.ArithError)];
        return try self.env.intern_error_union(self.alloc, t, errs[0_usize..1_usize]);
    }

    @recursive
    fn check_bitwise_binary(
        self: *mut Self,
        arena: *ast.AstArena,
        lhs_id: u32,
        rhs_id: u32,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let t = try self.check_numeric_pair(arena, lhs_id, rhs_id, expected, sp);
        let tn = self.env.get(t);
        let bit_ok = self.env.is_integer(t) || (tn.kind == .Vec && self.env.is_integer(tn.primary));
        if t != types.TY_ERROR && !bit_ok {
            try self.emit_err_ty2(
                diag.E0230, sp, "bitwise operator requires integer type, found `", t, "`",
            );
        }
        return t;
    }

    @recursive
    fn check_comptime_if(
        self: *mut Self,
        arena: *ast.AstArena,
        if_id: u32,
        data: *ast.IfNode,
        expected: types.TyId,
    ) -> CheckBlockRes ! OutOfMemory {
        try self.push_scope();
        var taken = false;
        if data.cond_kind == .Expr {
            let saved = self.in_comptime;
            self.in_comptime = true;
            let ct = try self.check_expr(arena, data.cond_expr, types.TY_BOOL);
            self.in_comptime = saved;
            if ct != types.TY_ERROR && ct != types.TY_BOOL {
                try self.emit_err_ty2(
                    diag.E0230,
                    expr_span(arena, data.cond_expr),
                    "`comptime if` condition must be `bool`, found `",
                    ct,
                    "`",
                );
            }
            taken = (try ctvm.eval_const_bool_in_ctx(
                self.alloc, self.ct, data.cond_expr, self.mod_id, &self.st.generic_ctx,
                arena, self.prog, self.env, self.interner, self.diags,
            )) orelse true;
        }
        try self.table.set_comptime_branch(self.alloc, if_id, taken);
        var res = CheckBlockRes.{ ty: types.TY_VOID, diverged: false };
        if taken {
            res = try self.check_block_expr(arena, data.then_block, expected);
        } else if data.else_kind == .Block {
            res = try self.check_block_expr(arena, data.else_id, expected);
        } else if data.else_kind == .If {
            res = try self.check_if(arena, data.else_id, expected);
        }
        try self.pop_scope();
        return res;
    }

    @recursive
    fn check_if(
        self: *mut Self,
        arena: *ast.AstArena,
        if_id: u32,
        expected: types.TyId,
    ) -> CheckBlockRes ! OutOfMemory {
        let data = arena.get_if(if_id) orelse {
            return CheckBlockRes.{ ty: types.TY_ERROR, diverged: false };
        };
        if data.is_comptime {
            return try self.check_comptime_if(arena, if_id, data, expected);
        }
        try self.push_scope();
        if data.cond_kind == .Expr {
            let ct = try self.check_expr(arena, data.cond_expr, types.TY_BOOL);
            if ct != types.TY_ERROR && ct != types.TY_BOOL {
                try self.emit_err_ty2(
                    diag.E0230,
                    expr_span(arena, data.cond_expr),
                    "`if` condition must be `bool`, found `",
                    ct,
                    "`",
                );
            }
        } else {
            let et = try self.check_expr_rvalue(arena, data.cond_expr, types.TY_NONE);
            let en = self.env.get(et);
            var bound_ty = types.TY_ERROR;
            if en.kind == .Optional {
                bound_ty = en.primary;
            } else if en.kind == .Error {
                bound_ty = types.TY_ERROR;
            } else {
                try self.emit_err_ty2(
                    diag.E0230,
                    expr_span(arena, data.cond_expr),
                    "`if let` requires optional `?T` or variant, found `",
                    et,
                    "`",
                );
            }
            try self.bind_pattern(arena, data.cond_pat, bound_ty, true);
        }

        let snap_mark = self.st.move_snaps.len();
        let base_moves = try self.snapshot_moves();
        let then_res = try self.check_block_expr(arena, data.then_block, expected);
        let then_moves = try self.snapshot_moves();
        self.restore_moves(base_moves);

        let else_exp = if expected != types.TY_NONE { expected } else { then_res.ty };
        var else_res = CheckBlockRes.{ ty: types.TY_VOID, diverged: false };
        var else_moves = base_moves;
        if data.else_kind == .Block {
            else_res = try self.check_block_expr(arena, data.else_id, else_exp);
            else_moves = try self.snapshot_moves();
        } else if data.else_kind == .If {
            else_res = try self.check_if(arena, data.else_id, else_exp);
            else_moves = try self.snapshot_moves();
        }

        let divs: [2]bool = [then_res.diverged, else_res.diverged];
        let snaps: [2]ast.IdRange = [then_moves, else_moves];
        self.merge_branch_moves(base_moves, divs[0_usize..2_usize], snaps[0_usize..2_usize]);
        self.pop_move_snaps_to(snap_mark);
        try self.pop_scope();

        var res_ty = types.TY_VOID;
        if then_res.ty == types.TY_NEVER {
            res_ty = else_res.ty;
        } else if else_res.ty == types.TY_NEVER {
            res_ty = then_res.ty;
        } else if data.else_kind == .None {
            if expected != types.TY_NONE
                && then_res.ty != types.TY_VOID
                && then_res.ty != types.TY_NEVER
                && then_res.ty != types.TY_ERROR
            {
                try self.emit_err(
                    diag.E0230, data.span, "`if` expression used as value must have an `else` branch",
                );
            }
            res_ty = types.TY_VOID;
        } else {
            res_ty = try self.unify_branch_types(then_res.ty, else_res.ty, data.span);
        }
        return CheckBlockRes.{ ty: res_ty, diverged: then_res.diverged && else_res.diverged };
    }

    @recursive
    fn check_match(
        self: *mut Self,
        arena: *ast.AstArena,
        scrutinee_id: u32,
        arms_range: ast.IdRange,
        expected: types.TyId,
        sp: span.Span,
    ) -> CheckBlockRes ! OutOfMemory {
        let scrut_ty = try self.check_expr(arena, scrutinee_id, types.TY_NONE);
        let arms = arena.match_arms_range(arms_range);
        let snap_mark = self.st.move_snaps.len();
        let base_moves = try self.snapshot_moves();

        var cov = try MatchCoverage.init(self.alloc, scrut_ty, self.env);
        errdefer cov.destroy(self.alloc);
        var arm_types = try col.DynBuf.[types.TyId].init(self.alloc, arms.len +% 1_usize);
        errdefer arm_types.destroy(self.alloc);
        var arm_divs = try col.DynBuf.[bool].init(self.alloc, arms.len +% 1_usize);
        errdefer arm_divs.destroy(self.alloc);
        var arm_snaps = try col.DynBuf.[ast.IdRange].init(self.alloc, arms.len +% 1_usize);
        errdefer arm_snaps.destroy(self.alloc);

        var all_diverged = arms.len > 0_usize;
        var all_blocks = true;
        var i: usize = 0_usize;
        while i < arms.len {
            let arm = arms[i];
            if arm.body_kind != .Block {
                all_blocks = false;
            }
            if cov.is_already_exhaustive() {
                try self.emit_err(diag.E0114, arm.span, "ZM-14: unreachable match arm");
            } else if arm.guard == ast.NONE_ID {
                try cov.record_pattern(self.alloc, arena, arm.pat, self.interner, self.diags);
            }
            self.restore_moves(base_moves);
            try self.push_scope();
            let sn = self.env.get(scrut_ty);
            let unwrap_opt = if sn.kind == .Optional && cov.seen_null {
                sn.primary
            } else {
                scrut_ty
            };
            try self.bind_pattern(arena, arm.pat, unwrap_opt, true);
            if arm.guard != ast.NONE_ID {
                let gt = try self.check_expr(arena, arm.guard, types.TY_BOOL);
                if gt != types.TY_ERROR && gt != types.TY_BOOL {
                    try self.emit_err(diag.E0230, expr_span(arena, arm.guard), "match guard must be `bool`");
                }
            }
            var exp_arm = expected;
            if exp_arm == types.TY_NONE {
                let ats = arm_types.as_slice();
                if ats.len > 0_usize {
                    exp_arm = ats[0_usize];
                }
            }
            var body_res = CheckBlockRes.{ ty: types.TY_NEVER, diverged: true };
            if arm.body_kind == .Block {
                body_res = try self.check_block_expr(arena, arm.body_id, exp_arm);
            } else if arm.body_kind == .Expr {
                let t = try self.check_expr_rvalue(arena, arm.body_id, exp_arm);
                body_res = CheckBlockRes.{ ty: t, diverged: t == types.TY_NEVER };
            } else {
                try self.check_jump(arena, arm.body_id, arm.span);
                body_res = CheckBlockRes.{ ty: types.TY_NEVER, diverged: true };
            }
            try self.pop_scope();
            if !body_res.diverged {
                all_diverged = false;
            }
            try arm_divs.push(self.alloc, body_res.diverged);
            try arm_snaps.push(self.alloc, try self.snapshot_moves());
            if body_res.ty != types.TY_NEVER {
                try arm_types.push(self.alloc, body_res.ty);
            }
            i = i +% 1_usize;
        }

        self.merge_branch_moves(base_moves, arm_divs.as_slice(), arm_snaps.as_slice());
        self.pop_move_snaps_to(snap_mark);
        try cov.verify_exhaustive(self.alloc, scrut_ty, self.env, self.interner, self.diags, sp);

        var all_void = true;
        let ats = arm_types.as_slice();
        var vi: usize = 0_usize;
        while vi < ats.len {
            if ats[vi] != types.TY_VOID {
                all_void = false;
                break;
            }
            vi = vi +% 1_usize;
        }
        var res_ty = types.TY_NEVER;
        var res_div = all_diverged;
        if expected == types.TY_NONE && all_blocks && all_void {
            res_ty = types.TY_VOID;
        } else if ats.len == 0_usize {
            res_ty = types.TY_NEVER;
            res_div = true;
        } else {
            var unified = ats[0_usize];
            var ui: usize = 1_usize;
            while ui < ats.len {
                unified = try self.unify_branch_types(unified, ats[ui], sp);
                ui = ui +% 1_usize;
            }
            res_ty = unified;
        }

        arm_snaps.destroy(self.alloc);
        arm_divs.destroy(self.alloc);
        arm_types.destroy(self.alloc);
        cov.destroy(self.alloc);
        return CheckBlockRes.{ ty: res_ty, diverged: res_div };
    }

    @recursive
    fn check_catch_body(
        self: *mut Self,
        arena: *ast.AstArena,
        kind: ast.BodyKind,
        body_id: u32,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if kind == .Block {
            let r = try self.check_block_expr(arena, body_id, expected);
            return r.ty;
        }
        if kind == .Expr {
            return try self.check_expr_rvalue(arena, body_id, expected);
        }
        try self.check_jump(arena, body_id, sp);
        return types.TY_NEVER;
    }

    @recursive
    fn check_orelse(
        self: *mut Self,
        arena: *ast.AstArena,
        lhs_id: u32,
        rhs_kind: ast.BodyKind,
        rhs_id: u32,
        _expected: types.TyId,
    ) -> types.TyId ! OutOfMemory {
        let lt = try self.check_expr_rvalue(arena, lhs_id, types.TY_NONE);
        let lhs_sp = expr_span(arena, lhs_id);
        let ln = self.env.get(lt);
        var ok_ty = types.TY_ERROR;
        if ln.kind == .Optional {
            ok_ty = ln.primary;
        } else if ln.kind == .Error {
            ok_ty = types.TY_ERROR;
        } else {
            try self.emit_err_ty2(
                diag.E0230, lhs_sp, "`orelse` requires an optional `?T`, found `", lt, "`",
            );
        }
        let rt = try self.check_catch_body(arena, rhs_kind, rhs_id, ok_ty, lhs_sp);
        if rt != types.TY_NEVER && ok_ty != types.TY_ERROR {
            try self.expect_assignable(rt, ok_ty, lhs_sp);
        }
        return ok_ty;
    }

    @recursive
    fn check_catch(
        self: *mut Self,
        arena: *ast.AstArena,
        lhs_id: u32,
        err_bind: ast.IdentSpan,
        rhs_kind: ast.BodyKind,
        rhs_id: u32,
        _expected: types.TyId,
    ) -> types.TyId ! OutOfMemory {
        let lt = try self.check_expr_rvalue(arena, lhs_id, types.TY_NONE);
        let lhs_sp = expr_span(arena, lhs_id);
        let ln = self.env.get(lt);
        var ok_ty = types.TY_ERROR;
        var has_first_err = false;
        var first_err = types.err_src_builtin(.ArithError);
        if ln.kind == .ErrorUnion {
            ok_ty = ln.primary;
            let errs = self.env.node_err_src_list(&ln);
            if errs.len > 0_usize {
                has_first_err = true;
                first_err = errs[0_usize];
            }
        } else if ln.kind == .Error {
            ok_ty = types.TY_ERROR;
        } else {
            try self.emit_err_ty2(
                diag.E0230, lhs_sp, "`catch` requires an error union `T ! E`, found `", lt, "`",
            );
        }
        try self.push_scope();
        if ast.ident_is_some(err_bind) {
            let err_ty = if has_first_err {
                try self.env.intern_error_set(self.alloc, first_err)
            } else {
                types.TY_ERROR
            };
            _ = try self.bind_local(err_bind.sym, err_bind.span, err_ty, false, false, false, false);
        }
        let rt = try self.check_catch_body(arena, rhs_kind, rhs_id, ok_ty, lhs_sp);
        try self.pop_scope();
        if rt != types.TY_NEVER && ok_ty != types.TY_ERROR {
            try self.expect_assignable(rt, ok_ty, lhs_sp);
        }
        return ok_ty;
    }

    @recursive
    fn check_builtin_math(
        self: *mut Self,
        arena: *ast.AstArena,
        name: ast.IdentSpan,
        args: *[ast.GenericArgNode],
        expected: types.TyId,
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if self.sym_eq(name.sym, "sqrt") {
            if args.len != 1_usize {
                try self.emit_err(diag.E0230, sp, "`@sqrt` expects 1 float argument");
                return types.TY_ERROR;
            }
            let hint = if expected != types.TY_NONE && self.env.is_float(expected) {
                expected
            } else {
                types.TY_NONE
            };
            if args[0_usize].kind != .Expr {
                try self.emit_err(diag.E0230, args[0_usize].span, "`@sqrt` argument must be an expression");
                return types.TY_ERROR;
            }
            let xt = try self.check_expr_rvalue(arena, args[0_usize].node_id, hint);
            if xt == types.TY_ERROR {
                return types.TY_ERROR;
            }
            if !self.env.is_float(xt) {
                try self.emit_err_ty2(
                    diag.E0230, args[0_usize].span, "`@sqrt` requires `f32` or `f64`, found `", xt, "`",
                );
                return types.TY_ERROR;
            }
            if xt == types.TY_COMPTIME_FLOAT {
                return if hint != types.TY_NONE { hint } else { types.TY_F64 };
            }
            return xt;
        }
        if self.sym_eq(name.sym, "fma") {
            if args.len != 3_usize {
                try self.emit_err(diag.E0230, sp, "`@fma` expects 3 float arguments (a, b, c)");
                return types.TY_ERROR;
            }
            let hint = if expected != types.TY_NONE && self.env.is_float(expected) {
                expected
            } else {
                types.TY_NONE
            };
            var ts: [3]types.TyId = [types.TY_ERROR; 3];
            var i: usize = 0_usize;
            while i < 3_usize {
                if args[i].kind != .Expr {
                    try self.emit_err(diag.E0230, args[i].span, "`@fma` arguments must be expressions");
                    return types.TY_ERROR;
                }
                ts[i] = try self.check_expr_rvalue(arena, args[i].node_id, hint);
                i = i +% 1_usize;
            }
            var res_ty = if hint != types.TY_NONE && hint != types.TY_COMPTIME_FLOAT {
                hint
            } else {
                types.TY_ERROR
            };
            var j: usize = 0_usize;
            while j < 3_usize {
                let t = ts[j];
                if t == types.TY_ERROR {
                    return types.TY_ERROR;
                }
                if !self.env.is_float(t) {
                    try self.emit_err_ty2(
                        diag.E0230, args[j].span, "`@fma` requires `f32` or `f64`, found `", t, "`",
                    );
                    return types.TY_ERROR;
                }
                if t != types.TY_COMPTIME_FLOAT {
                    if res_ty == types.TY_ERROR {
                        res_ty = t;
                    } else {
                        try self.expect_assignable(t, res_ty, args[j].span);
                    }
                }
                j = j +% 1_usize;
            }
            return if res_ty == types.TY_ERROR { types.TY_F64 } else { res_ty };
        }
        if self.sym_eq(name.sym, "lzcnt")
            || self.sym_eq(name.sym, "tzcnt")
            || self.sym_eq(name.sym, "popcnt")
            || self.sym_eq(name.sym, "bswap")
        {
            if args.len != 1_usize {
                try self.emit_err_sym2(diag.E0230, sp, "`@", name.sym, "` expects 1 integer argument");
                return types.TY_ERROR;
            }
            let hint = if expected != types.TY_NONE && self.env.is_integer(expected) {
                expected
            } else {
                types.TY_NONE
            };
            if args[0_usize].kind != .Expr {
                try self.emit_err_sym2(
                    diag.E0230, args[0_usize].span, "`@", name.sym, "` argument must be an expression",
                );
                return types.TY_ERROR;
            }
            let xt = try self.check_expr_rvalue(arena, args[0_usize].node_id, hint);
            if xt == types.TY_ERROR {
                return types.TY_ERROR;
            }
            if !self.env.is_integer(xt) {
                try self.emit_err_sym_ty(
                    diag.E0230, args[0_usize].span, "`@", name.sym, "` requires an integer type, found `", xt, "`",
                );
                return types.TY_ERROR;
            }
            if xt == types.TY_COMPTIME_INT {
                return if hint != types.TY_NONE { hint } else { types.TY_U64 };
            }
            return xt;
        }
        return null;
    }

    @recursive
    fn check_builtin(
        self: *mut Self,
        arena: *ast.AstArena,
        expr_id: u32,
        name: ast.IdentSpan,
        args_range: ast.IdRange,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let args = arena.generic_args_range(args_range);
        if let mty = try self.check_builtin_math(arena, name, args, expected, sp) {
            return mty;
        }
        let is_size = self.sym_eq(name.sym, "size_of");
        let is_align = self.sym_eq(name.sym, "align_of");
        if is_size || is_align {
            if args.len != 1_usize {
                try self.emit_err_sym2(diag.E0230, sp, "`@", name.sym, "` expects 1 type argument");
                return types.TY_ERROR;
            }
            let gv = try self.eval_generic_arg(arena, &args[0_usize]);
            if gv.kind == .Ty {
                let lay = self.env.eon_layout(gv.id);
                let v = if is_size { lay.size } else { lay.align };
                try self.table.set_const_int(self.alloc, expr_id, types.int_val_from_u64(v));
            }
            return types.TY_USIZE;
        }
        if self.sym_eq(name.sym, "type_info") {
            if args.len != 1_usize {
                try self.emit_err(diag.E0230, sp, "`@type_info` expects 1 type argument");
                return types.TY_ERROR;
            }
            let info_ty = try ctvm.type_info_struct_ty(self.alloc, self.env, self.interner);
            let gv = try self.eval_generic_arg(arena, &args[0_usize]);
            if gv.kind == .Ty {
                let val_id = try ctvm.make_type_info_val(self.alloc, self.ct, gv.id, self.env, self.interner);
                try self.table.set_comptime_val(self.alloc, expr_id, val_id);
            }
            return info_ty;
        }
        if self.sym_eq(name.sym, "target_arch") {
            let sym = try ctvm.target_arch_sym(self.alloc, self.env, self.interner);
            let vid = try self.ct.add_enum_sym(self.alloc, sym, types.int_val_zero());
            try self.table.set_comptime_val(self.alloc, expr_id, vid);
            return types.TY_TYPE_TYPE;
        }
        if self.sym_eq(name.sym, "target_os") {
            let sym = try ctvm.target_os_sym(self.alloc, self.env, self.interner);
            let vid = try self.ct.add_enum_sym(self.alloc, sym, types.int_val_zero());
            try self.table.set_comptime_val(self.alloc, expr_id, vid);
            return types.TY_TYPE_TYPE;
        }
        if self.sym_eq(name.sym, "target_is_nostd") {
            let vid = try self.ct.add_bool(self.alloc, ctvm.target_is_nostd(self.env));
            try self.table.set_comptime_val(self.alloc, expr_id, vid);
            return types.TY_BOOL;
        }
        if self.sym_eq(name.sym, "comptime_budget") {
            var i: usize = 0_usize;
            while i < args.len {
                if args[i].kind == .Expr {
                    _ = try self.check_expr(arena, args[i].node_id, types.TY_U64);
                }
                i = i +% 1_usize;
            }
            return types.TY_VOID;
        }
        if self.sym_eq(name.sym, "compile_error") {
            if !self.in_comptime {
                var has_msg = false;
                var msg_r = ast.range_empty();
                if args.len > 0_usize && args[0_usize].kind == .Expr {
                    if let ae = arena.get_expr(args[0_usize].node_id) {
                        if ae.kind == .StringLit || ae.kind == .RawStringLit {
                            has_msg = true;
                            msg_r = ae.list;
                        }
                    }
                }
                if has_msg {
                    _ = try self.diags.emit_error_bytes(
                        self.alloc, diag.E0520, sp, arena.str_bytes_range(msg_r),
                    );
                } else {
                    try self.emit_err(diag.E0520, sp, "@compile_error triggered");
                }
            }
            return types.TY_NEVER;
        }
        if self.sym_eq(name.sym, "gpu_global_id")
            || self.sym_eq(name.sym, "gpu_local_id")
            || self.sym_eq(name.sym, "gpu_workgroup_id")
        {
            return try self.env.intern_vec(self.alloc, types.TY_U32, 3_u8);
        }
        if self.sym_eq(name.sym, "gpu_workgroup_barrier") {
            return types.TY_VOID;
        }
        var k: usize = 0_usize;
        while k < args.len {
            if args[k].kind == .Expr {
                _ = try self.check_expr(arena, args[k].node_id, types.TY_NONE);
            }
            k = k +% 1_usize;
        }
        return types.TY_VOID;
    }
}

// ===========================================================================
// Section 7: Field Access, Indexing, Slicing, Generic Apply, and Closures
// ===========================================================================

fn is_vec_swizzle_xyzw(bs: *[u8]) -> bool {
    var i: usize = 0_usize;
    while i < bs.len {
        let c = bs[i];
        if c != b'x' && c != b'y' && c != b'z' && c != b'w' {
            return false;
        }
        i = i +% 1_usize;
    }
    return bs.len > 0_usize;
}

fn is_vec_swizzle_rgba(bs: *[u8]) -> bool {
    var i: usize = 0_usize;
    while i < bs.len {
        let c = bs[i];
        if c != b'r' && c != b'g' && c != b'b' && c != b'a' {
            return false;
        }
        i = i +% 1_usize;
    }
    return bs.len > 0_usize;
}

fn vec_swizzle_in_bounds(bs: *[u8], len: u8) -> bool {
    var i: usize = 0_usize;
    while i < bs.len {
        let c = bs[i];
        var idx: u8 = 3_u8;
        if c == b'x' || c == b'r' {
            idx = 0_u8;
        } else if c == b'y' || c == b'g' {
            idx = 1_u8;
        } else if c == b'z' || c == b'b' {
            idx = 2_u8;
        }
        if idx >= len {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

impl Checker {
    fn resolve_ty(self: *mut Self, arena: *ast.AstArena, type_id: u32) -> types.TyId ! OutOfMemory {
        return try types.resolve_type_expr(
            self.alloc,
            type_id,
            self.mod_id,
            &self.st.generic_ctx,
            arena,
            self.prog,
            self.env,
            self.interner,
            self.diags,
        );
    }

    fn resolve_bare_type_path(
        self: *mut Self,
        segs: *[ast.IdentSpan],
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if segs.len == 1_usize {
            let sym = segs[0_usize].sym;
            if let gp = self.st.generic_ctx.find_param(sym) {
                return try self.env.intern_generic_param(self.alloc, gp.idx, sym, gp.is_comptime);
            }
            if str.bytes_eq(self.interner.get(sym), "Self".as_bytes()) && self.st.generic_ctx.has_self_ty {
                return self.st.generic_ctx.self_ty;
            }
        }
        let target = (try types.resolve_path_segments(
            self.alloc, segs, self.mod_id, self.prog, self.interner, self.diags,
        )) orelse {
            return types.TY_ERROR;
        };
        if target.kind == .Builtin {
            let bi = resolve.decode_builtin(target.target_id);
            match bi.kind {
                .Prim => {
                    return try types.prim_to_ty_id_in_env(self.alloc, bi.prim, bi.prim_bits, self.env);
                }
                .SimdAlias => {
                    let et = try types.prim_to_ty_id_in_env(self.alloc, bi.prim, bi.prim_bits, self.env);
                    return try self.env.intern_vec(self.alloc, et, bi.lanes);
                }
                .Ordering => { return types.TY_ORDERING; }
                .ArithError => { return types.TY_ARITH_ERROR; }
                .BoundsError => { return types.TY_BOUNDS_ERROR; }
                .Utf8Error => { return types.TY_UTF8_ERROR; }
                .OutOfMemory => { return types.TY_OUT_OF_MEMORY; }
                .MemError => { return types.TY_MEM_ERROR; }
                .StaleId => { return types.TY_STALE_ID; }
                .IoError => { return types.TY_IO_ERROR; }
                _ => { return try self.env.intern_builtin_empty(self.alloc, bi.kind); }
            }
        }
        if target.kind == .Def {
            let d = target.target_id;
            var dkind: resolve.TopDefKind = .Fn;
            var dname = span.SYM_EMPTY;
            if let td = self.prog.get_def(d) {
                dkind = td.kind;
                dname = td.name;
            }
            let empty_g: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
            let empty_s = empty_g[0_usize..0_usize];
            match dkind {
                .Struct => { return try self.env.intern_struct(self.alloc, d, empty_s); }
                .ExternStruct => { return try self.env.intern_struct(self.alloc, d, empty_s); }
                .Pool => { return try self.env.intern_pool_empty(self.alloc, d); }
                .Enum => { return try self.env.intern_enum(self.alloc, d); }
                .Union => { return try self.env.intern_union(self.alloc, d, empty_s); }
                .ExternUnion => { return try self.env.intern_union(self.alloc, d, empty_s); }
                .Bitfield => { return try self.env.intern_bitfield(self.alloc, d); }
                .Error => { return try self.env.intern_error_set(self.alloc, types.err_src_user(d)); }
                .TypeAlias => {
                    if let ta = self.env.get_type_alias(d) {
                        return ta.ty;
                    }
                    return types.TY_ERROR;
                }
                .Iface => {
                    try self.emit_err(
                        diag.E0230,
                        sp,
                        "interface cannot be used directly as a value type; use `dyn Interface` or a generic bound",
                    );
                    return types.TY_ERROR;
                }
                _ => {
                    try self.emit_err_sym2(diag.E0230, sp, "`", dname, "` is not a type");
                    return types.TY_ERROR;
                }
            }
        }
        try self.emit_err(diag.E0230, sp, "expected type, found module");
        return types.TY_ERROR;
    }

    @recursive
    fn eval_generic_arg(self: *mut Self, arena: *ast.AstArena, arg: *ast.GenericArgNode) -> types.GenericVal ! OutOfMemory {
        match arg.kind {
            .Type => {
                let t = try self.resolve_ty(arena, arg.node_id);
                return types.gval_ty(t);
            }
            .TypeOrConst => {
                let segs = arena.idents_range(arg.segs);
                if segs.len == 1_usize {
                    if let cv = self.st.generic_ctx.find_comptime_val(segs[0_usize].sym) {
                        return types.gval_int(cv);
                    }
                }
                let t = try self.resolve_bare_type_path(segs, arg.span);
                return types.gval_ty(t);
            }
            .Expr => {
                if let e = arena.get_expr(arg.node_id) {
                    if e.kind == .EnumLit {
                        return types.gval_variant(e.ident.sym);
                    }
                }
                let v = (try types.eval_const_int(
                    self.alloc, arg.node_id, self.mod_id, &self.st.generic_ctx,
                    arena, self.prog, self.env, self.interner, self.diags,
                )) orelse types.int_val_zero();
                return types.gval_int(v);
            }
        }
    }

    @recursive
    fn check_field_access(
        self: *mut Self,
        arena: *ast.AstArena,
        base_id: u32,
        field: ast.IdentSpan,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        var segs = try col.DynBuf.[ast.IdentSpan].init(self.alloc, 4_usize);
        errdefer segs.destroy(self.alloc);
        if try self.extract_path_idents(arena, base_id, &mut segs) {
            var all_non_local = true;
            let ss = segs.as_slice();
            var i: usize = 0_usize;
            while i < ss.len {
                if let _ = self.lookup_local(ss[i].sym) {
                    all_non_local = false;
                    break;
                }
                i = i +% 1_usize;
            }
            if all_non_local && ss.len > 0_usize {
                try segs.push(self.alloc, field);
                let full = segs.as_slice();
                if full.len == 2_usize {
                    if is_prim_minmax_name(self.interner.get(full[1_usize].sym)) {
                        let pt_opt = try self.prim_from_suffix(full[0_usize].sym);
                        if let pt = pt_opt {
                            segs.destroy(self.alloc);
                            return pt;
                        }
                    }
                    if let target = self.prog.lookup_in_module(self.mod_id, full[0_usize].sym) {
                        if target.kind == .Def {
                            var is_enum_match = false;
                            let enum_def = target.target_id;
                            if let meta = self.env.get_enum(enum_def) {
                                self.prog.mark_module_binding_used(self.mod_id, full[0_usize].sym);
                                self.prog.mark_def_used(enum_def);
                                let vs = self.env.enum_variants_range(meta.variants);
                                var vi: usize = 0_usize;
                                while vi < vs.len {
                                    if vs[vi].name == field.sym {
                                        is_enum_match = true;
                                        break;
                                    }
                                    vi = vi +% 1_usize;
                                }
                            }
                            if is_enum_match {
                                let ety = try self.env.intern_enum(self.alloc, enum_def);
                                segs.destroy(self.alloc);
                                return ety;
                            }
                        }
                        let res = try self.resolve_value_path(full, sp);
                        segs.destroy(self.alloc);
                        return res;
                    }
                } else {
                    let res = try self.resolve_value_path(full, sp);
                    segs.destroy(self.alloc);
                    return res;
                }
            }
        }
        let bt = try self.check_expr(arena, base_id, types.TY_NONE);
        let brand = extract_root_ident_sym(arena, base_id);
        let fty = try self.resolve_field_type(bt, field, false, brand, sp);
        segs.destroy(self.alloc);
        return fty;
    }

    fn resolve_field_pool_builtin(
        self: *mut Self,
        bt: types.TyId,
        inner_ty: types.TyId,
        bk: resolve.BuiltinKind,
        n: *types.TyNode,
        field: ast.IdentSpan,
        base_brand: ?u32,
    ) -> types.TyId ! OutOfMemory {
        let btn = self.env.get(bt);
        let pool_is_mut = (btn.kind == .Borrow && btn.flag0) || btn.kind != .Borrow;
        let gargs = self.env.node_gval_list(n);
        if gargs.len > 0_usize && gargs[0_usize].kind == .Ty {
            let pool_ty = gargs[0_usize].id;
            let pn = self.env.get(pool_ty);
            if pn.kind == .Pool {
                var pool_args = try col.DynBuf.[types.GenericVal].init(
                    self.alloc, pn.list_len.widen.[usize]() +% 1_usize,
                );
                errdefer pool_args.destroy(self.alloc);
                try pool_args.push_slice(self.alloc, self.env.node_gval_list(&pn));
                var found = false;
                var col_pub = true;
                var col_raw_ty = types.TY_ERROR;
                var p_mod: u32 = resolve.MODULE_NONE;
                if let pm = self.env.get_pool(pn.primary) {
                    p_mod = pm.module_id;
                    let cols = self.env.pool_cols_range(pm.columns);
                    var ci: usize = 0_usize;
                    while ci < cols.len {
                        if cols[ci].name == field.sym {
                            found = true;
                            col_pub = cols[ci].is_pub;
                            col_raw_ty = cols[ci].ty;
                            break;
                        }
                        ci = ci +% 1_usize;
                    }
                }
                if found {
                    if !col_pub && p_mod != self.mod_id {
                        try self.emit_err_sym2(
                            diag.E0133, field.span, "pool column `", field.sym, "` is private",
                        );
                    }
                    let sub_col = try subst_ty(self.alloc, self.env, col_raw_ty, pool_args.as_slice());
                    let hkind = if bk == .ArenaPool {
                        let bsym = base_brand orelse (try self.interner.intern_str(self.alloc, "_pool"));
                        types.PoolHandleKind.{ tag: .ArenaPool, brand: bsym }
                    } else {
                        types.PoolHandleKind.{ tag: .SlotPool, brand: span.SYM_EMPTY }
                    };
                    let col_ty = try self.env.resolve_pool_link_ty(self.alloc, sub_col, pool_ty, hkind);
                    let res = try self.env.intern_borrow(self.alloc, pool_is_mut, .Slice, col_ty);
                    pool_args.destroy(self.alloc);
                    return res;
                }
                pool_args.destroy(self.alloc);
            }
        }
        try self.emit_err_ty_sym(
            diag.E0132, field.span, "pool `", inner_ty, "` has no column `", field.sym, "`",
        );
        return types.TY_ERROR;
    }

    fn resolve_field_struct_or_pool(
        self: *mut Self,
        inner_ty: types.TyId,
        n: *types.TyNode,
        field: ast.IdentSpan,
    ) -> types.TyId ! OutOfMemory {
        if n.kind == .Struct {
            var sargs = try col.DynBuf.[types.GenericVal].init(
                self.alloc, n.list_len.widen.[usize]() +% 1_usize,
            );
            errdefer sargs.destroy(self.alloc);
            try sargs.push_slice(self.alloc, self.env.node_gval_list(n));
            var found = false;
            var f_pub = true;
            var f_ty = types.TY_ERROR;
            var s_mod: u32 = resolve.MODULE_NONE;
            if let meta = self.env.get_struct(n.primary) {
                s_mod = meta.module_id;
                let fs = self.env.struct_fields_range(meta.fields);
                var fi: usize = 0_usize;
                while fi < fs.len {
                    if fs[fi].name == field.sym {
                        found = true;
                        f_pub = fs[fi].is_pub;
                        f_ty = fs[fi].ty;
                        break;
                    }
                    fi = fi +% 1_usize;
                }
            }
            if found {
                if !f_pub && s_mod != self.mod_id {
                    try self.emit_err_sym2(
                        diag.E0133, field.span, "field `", field.sym, "` is private",
                    );
                }
                let res = try subst_ty(self.alloc, self.env, f_ty, sargs.as_slice());
                sargs.destroy(self.alloc);
                return res;
            }
            try self.emit_err_ty_sym(
                diag.E0132, field.span, "type `", inner_ty, "` has no field `", field.sym, "`",
            );
            sargs.destroy(self.alloc);
            return types.TY_ERROR;
        }
        var pargs = try col.DynBuf.[types.GenericVal].init(
            self.alloc, n.list_len.widen.[usize]() +% 1_usize,
        );
        errdefer pargs.destroy(self.alloc);
        try pargs.push_slice(self.alloc, self.env.node_gval_list(n));
        var found = false;
        var c_pub = true;
        var c_ty = types.TY_ERROR;
        var p_mod: u32 = resolve.MODULE_NONE;
        if let pm = self.env.get_pool(n.primary) {
            p_mod = pm.module_id;
            let cols = self.env.pool_cols_range(pm.columns);
            var ci: usize = 0_usize;
            while ci < cols.len {
                if cols[ci].name == field.sym {
                    found = true;
                    c_pub = cols[ci].is_pub;
                    c_ty = cols[ci].ty;
                    break;
                }
                ci = ci +% 1_usize;
            }
        }
        if found {
            if !c_pub && p_mod != self.mod_id {
                try self.emit_err_sym2(
                    diag.E0133, field.span, "pool column `", field.sym, "` is private",
                );
            }
            let sub_col = try subst_ty(self.alloc, self.env, c_ty, pargs.as_slice());
            let res = try self.env.resolve_pool_link_ty(
                self.alloc,
                sub_col,
                inner_ty,
                types.PoolHandleKind.{ tag: .SlotPool, brand: span.SYM_EMPTY },
            );
            pargs.destroy(self.alloc);
            return res;
        }
        try self.emit_err_ty_sym(
            diag.E0132, field.span, "pool `", inner_ty, "` has no column `", field.sym, "`",
        );
        pargs.destroy(self.alloc);
        return types.TY_ERROR;
    }

    fn resolve_field_builtin(
        self: *mut Self,
        bt: types.TyId,
        inner_ty: types.TyId,
        n: *types.TyNode,
        field: ast.IdentSpan,
        base_brand: ?u32,
    ) -> types.TyId ! OutOfMemory {
        if n.builtin_kind == .Env {
            if self.sym_eq(field.sym, "alloc") {
                return try self.env.intern_builtin_empty(self.alloc, .AllocCap);
            }
            if self.sym_eq(field.sym, "fs") {
                return try self.env.intern_builtin_empty(self.alloc, .FsCap);
            }
            if self.sym_eq(field.sym, "net") {
                return try self.env.intern_builtin_empty(self.alloc, .NetCap);
            }
            if self.sym_eq(field.sym, "clock") {
                return try self.env.intern_builtin_empty(self.alloc, .ClockCap);
            }
            if self.sym_eq(field.sym, "io") {
                return try self.env.intern_builtin_empty(self.alloc, .IoCap);
            }
            if self.sym_eq(field.sym, "args") {
                return try self.env.intern_builtin_empty(self.alloc, .ArgsCap);
            }
            try self.emit_err_sym2(
                diag.E0132, field.span, "`Env` has no capability field `", field.sym, "`",
            );
            return types.TY_ERROR;
        }
        if n.builtin_kind == .ArenaPool || n.builtin_kind == .SlotPool {
            return try self.resolve_field_pool_builtin(
                bt, inner_ty, n.builtin_kind, n, field, base_brand,
            );
        }
        try self.emit_err_ty_sym(
            diag.E0132, field.span, "type `", inner_ty, "` has no field `", field.sym, "`",
        );
        return types.TY_ERROR;
    }

    fn resolve_field_type(
        self: *mut Self,
        bt: types.TyId,
        field: ast.IdentSpan,
        _is_mut: bool,
        base_brand: ?u32,
        _sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let btn = self.env.get(bt);
        let inner_ty = if btn.kind == .Borrow && btn.borrow_kind == .Single {
            btn.primary
        } else {
            bt
        };
        let n = self.env.get(inner_ty);
        match n.kind {
            .Error => { return types.TY_ERROR; }
            .Struct => { return try self.resolve_field_struct_or_pool(inner_ty, &n, field); }
            .Pool => { return try self.resolve_field_struct_or_pool(inner_ty, &n, field); }
            .AnonStruct => {
                let fs = self.env.node_anon_fields(&n);
                var i: usize = 0_usize;
                while i < fs.len {
                    if fs[i].name == field.sym {
                        return fs[i].ty;
                    }
                    i = i +% 1_usize;
                }
                try self.emit_err_sym2(diag.E0132, field.span, "unknown field `", field.sym, "`");
                return types.TY_ERROR;
            }
            .Tuple => {
                let parsed = str.parse_u64(self.interner.get(field.sym)) catch {
                    try self.emit_err_sym2(diag.E0132, field.span, "unknown tuple index `", field.sym, "`");
                    return types.TY_ERROR;
                };
                let elems = self.env.node_ty_list(&n);
                let idx = parsed.trunc.[usize]();
                if idx < elems.len {
                    return elems[idx];
                }
                try self.emit_err_sym2(diag.E0132, field.span, "unknown tuple index `", field.sym, "`");
                return types.TY_ERROR;
            }
            .Bitfield => {
                if let meta = self.env.get_bitfield(n.primary) {
                    let ms = self.env.bitfield_members_range(meta.members);
                    var i: usize = 0_usize;
                    while i < ms.len {
                        if ms[i].name == field.sym {
                            return ms[i].ty;
                        }
                        i = i +% 1_usize;
                    }
                }
                try self.emit_err_sym2(
                    diag.E0132, field.span, "unknown bitfield member `", field.sym, "`",
                );
                return types.TY_ERROR;
            }
            .Borrow => {
                if (n.borrow_kind == .Slice || n.borrow_kind == .Str)
                    && self.sym_eq(field.sym, "len")
                {
                    return types.TY_USIZE;
                }
                try self.emit_err_ty_sym(
                    diag.E0132, field.span, "type `", inner_ty, "` has no field `", field.sym, "`",
                );
                return types.TY_ERROR;
            }
            .Array => {
                if self.sym_eq(field.sym, "len") {
                    return types.TY_USIZE;
                }
                try self.emit_err_ty_sym(
                    diag.E0132, field.span, "type `", inner_ty, "` has no field `", field.sym, "`",
                );
                return types.TY_ERROR;
            }
            .Str => {
                if self.sym_eq(field.sym, "len") {
                    return types.TY_USIZE;
                }
                try self.emit_err_ty_sym(
                    diag.E0132, field.span, "type `", inner_ty, "` has no field `", field.sym, "`",
                );
                return types.TY_ERROR;
            }
            .Vec => {
                let swiz_len = vec_swizzle_len(self.interner.get(field.sym), n.u8_val);
                if swiz_len == 1_u8 {
                    return n.primary;
                }
                if swiz_len >= 2_u8 && swiz_len <= 4_u8 {
                    return try self.env.intern_vec(self.alloc, n.primary, swiz_len);
                }
                try self.emit_err_sym2(
                    diag.E0132, field.span, "invalid vector field `", field.sym, "`",
                );
                return types.TY_ERROR;
            }
            .Builtin => { return try self.resolve_field_builtin(bt, inner_ty, &n, field, base_brand); }
            _ => {
                try self.emit_err_ty_sym(
                    diag.E0132, field.span, "type `", inner_ty, "` has no field `", field.sym, "`",
                );
                return types.TY_ERROR;
            }
        }
    }

    fn check_index_ty(
        self: *mut Self,
        arena: *ast.AstArena,
        base_id: u32,
        idx_ty: types.TyId,
        sp: span.Span,
    ) -> !OutOfMemory {
        if idx_ty == types.TY_ERROR || self.env.is_integer(idx_ty) {
            return;
        }
        if let be = arena.get_expr(base_id) {
            if be.kind == .Field {
                let pool_expr = be.a;
                if let raw_pool_ty = self.table.get_expr_ty(pool_expr) {
                    let rn = self.env.get(raw_pool_ty);
                    let pool_deref = if rn.kind == .Borrow && rn.borrow_kind == .Single {
                        rn.primary
                    } else {
                        raw_pool_ty
                    };
                    let pn = self.env.get(pool_deref);
                    if pn.kind == .Builtin && pn.builtin_kind == .ArenaPool {
                        let in_node = self.env.get(idx_ty);
                        if in_node.kind == .Builtin && in_node.builtin_kind == .IdBrand {
                            let iargs = self.env.node_gval_list(&in_node);
                            if iargs.len > 0_usize && iargs[0_usize].kind == .Variant {
                                let id_brand = iargs[0_usize].id;
                                if let pool_sym = extract_root_ident_sym(arena, pool_expr) {
                                    if pool_sym != id_brand {
                                        var msg = try str.StrBuf.init(self.alloc, 96_usize);
                                        errdefer msg.destroy(self.alloc);
                                        try msg.push_str_grow(self.alloc, "brand mismatch: `Id[");
                                        try msg.push_bytes_grow(self.alloc, self.interner.get(id_brand));
                                        try msg.push_str_grow(self.alloc, "]` cannot index pool `");
                                        try msg.push_bytes_grow(self.alloc, self.interner.get(pool_sym));
                                        try msg.push_byte_grow(self.alloc, b'`');
                                        try self.emit_err_buf(diag.E0330, sp, &msg);
                                        msg.destroy(self.alloc);
                                    }
                                }
                            }
                            return;
                        }
                    } else if pn.kind == .Builtin && pn.builtin_kind == .SlotPool {
                        let pargs = self.env.node_gval_list(&pn);
                        var has_schema = false;
                        var schema = types.TY_ERROR;
                        if pargs.len > 0_usize && pargs[0_usize].kind == .Ty {
                            has_schema = true;
                            schema = pargs[0_usize].id;
                        }
                        let in_node = self.env.get(idx_ty);
                        if in_node.kind == .Builtin && in_node.builtin_kind == .GenId {
                            if has_schema && !self.env.is_gen_id_of(idx_ty, schema) {
                                try self.emit_err_ty_ty(
                                    diag.E0230,
                                    sp,
                                    "type mismatch: cannot index `SlotPool[",
                                    schema,
                                    "]` column with `",
                                    idx_ty,
                                    "`",
                                );
                            }
                            return;
                        }
                    }
                }
            }
        }
        try self.emit_err(diag.E0230, sp, "index must be an integer or valid pool Id");
        return;
    }

    fn index_elem_ty(self: *mut Self, base_ty: types.TyId, sp: span.Span) -> types.TyId ! OutOfMemory {
        let bn = self.env.get(base_ty);
        let inner = if bn.kind == .Borrow && bn.borrow_kind == .Single {
            bn.primary
        } else {
            base_ty
        };
        let n = self.env.get(inner);
        match n.kind {
            .Array => { return n.primary; }
            .Vec => { return n.primary; }
            .Borrow => {
                if n.borrow_kind == .Slice {
                    return n.primary;
                }
                if n.borrow_kind == .Str {
                    try self.emit_err(
                        diag.E0230,
                        sp,
                        "cannot index `str` directly by byte offset; use `.as_bytes()` for UTF-8 byte access",
                    );
                    return types.TY_ERROR;
                }
            }
            .Builtin => {
                if n.builtin_kind == .GpuBuf {
                    let gs = self.env.node_gval_list(&n);
                    if gs.len > 0_usize && gs[0_usize].kind == .Ty {
                        return gs[0_usize].id;
                    }
                    return types.TY_ERROR;
                }
            }
            .Str => {
                try self.emit_err(
                    diag.E0230,
                    sp,
                    "cannot index `str` directly by byte offset; use `.as_bytes()` for UTF-8 byte access",
                );
                return types.TY_ERROR;
            }
            .Error => { return types.TY_ERROR; }
            _ => {}
        }
        try self.emit_err_ty2(diag.E0230, sp, "cannot index value of type `", base_ty, "`");
        return types.TY_ERROR;
    }

    fn slice_result_ty(self: *mut Self, base_ty: types.TyId, sp: span.Span) -> types.TyId ! OutOfMemory {
        let bn = self.env.get(base_ty);
        var is_mut = false;
        var inner = base_ty;
        if bn.kind == .Borrow {
            if bn.borrow_kind == .Single {
                is_mut = bn.flag0;
                inner = bn.primary;
            } else if bn.borrow_kind == .Slice {
                return try self.env.intern_borrow(self.alloc, bn.flag0, .Slice, bn.primary);
            } else {
                try self.emit_err(
                    diag.E0230,
                    sp,
                    "cannot slice `str` directly (`s[lo..hi]` violates UTF-8 boundaries); use `.as_bytes()`",
                );
                return types.TY_ERROR;
            }
        }
        let inn = self.env.get(inner);
        if inn.kind == .Array {
            return try self.env.intern_borrow(self.alloc, is_mut, .Slice, inn.primary);
        }
        if inn.kind == .Str {
            try self.emit_err(
                diag.E0230,
                sp,
                "cannot slice `str` directly (`s[lo..hi]` violates UTF-8 boundaries); use `.as_bytes()`",
            );
            return types.TY_ERROR;
        }
        if inn.kind == .Error {
            return types.TY_ERROR;
        }
        try self.emit_err_ty2(diag.E0230, sp, "cannot slice value of type `", base_ty, "`");
        return types.TY_ERROR;
    }

    @recursive
    fn check_generic_apply(
        self: *mut Self,
        arena: *ast.AstArena,
        base_id: u32,
        args_range: ast.IdRange,
        _sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        var segs = try col.DynBuf.[ast.IdentSpan].init(self.alloc, 4_usize);
        errdefer segs.destroy(self.alloc);
        if try self.extract_path_idents(arena, base_id, &mut segs) {
            if let target = try types.resolve_path_segments(
                self.alloc, segs.as_slice(), self.mod_id, self.prog, self.interner, self.diags,
            ) {
                if target.kind == .Def {
                    var has_sig = false;
                    var pr = ast.range_empty();
                    var sret = types.TY_ERROR;
                    if let sig = self.env.get_fn(target.target_id) {
                        has_sig = true;
                        pr = sig.params;
                        sret = sig.ret;
                    }
                    if has_sig {
                        let gargs = arena.generic_args_range(args_range);
                        var gvals = try col.DynBuf.[types.GenericVal].init(
                            self.alloc, gargs.len +% 1_usize,
                        );
                        errdefer gvals.destroy(self.alloc);
                        var i: usize = 0_usize;
                        while i < gargs.len {
                            try gvals.push(self.alloc, try self.eval_generic_arg(arena, &gargs[i]));
                            i = i +% 1_usize;
                        }
                        var ptys = try col.DynBuf.[types.TyId].init(
                            self.alloc, pr.len.widen.[usize]() +% 1_usize,
                        );
                        errdefer ptys.destroy(self.alloc);
                        let pcnt = pr.len.widen.[usize]();
                        var pi: usize = 0_usize;
                        while pi < pcnt {
                            var raw_pt = types.TY_ERROR;
                            let ps = self.env.params_range(pr);
                            if pi < ps.len {
                                raw_pt = ps[pi].ty;
                            }
                            let sub_pt = try subst_ty(self.alloc, self.env, raw_pt, gvals.as_slice());
                            try ptys.push(self.alloc, sub_pt);
                            pi = pi +% 1_usize;
                        }
                        let ret = try subst_ty(self.alloc, self.env, sret, gvals.as_slice());
                        let fty = try self.env.intern_fn_ptr(self.alloc, ptys.as_slice(), ret);
                        ptys.destroy(self.alloc);
                        gvals.destroy(self.alloc);
                        segs.destroy(self.alloc);
                        return fty;
                    }
                }
            }
        }
        let fallback_ty = try self.check_expr(arena, base_id, types.TY_NONE);
        segs.destroy(self.alloc);
        return fallback_ty;
    }

    @recursive
    fn check_closure(
        self: *mut Self,
        arena: *ast.AstArena,
        params_range: ast.IdRange,
        body_id: u32,
        expected: types.TyId,
    ) -> types.TyId ! OutOfMemory {
        var exp_params = try col.DynBuf.[types.TyId].init(self.alloc, 4_usize);
        errdefer exp_params.destroy(self.alloc);
        var has_exp = false;
        var exp_ret = types.TY_NONE;
        if expected != types.TY_NONE {
            let en = self.env.get(expected);
            if en.kind == .FnPtr {
                has_exp = true;
                exp_ret = en.primary;
                try exp_params.push_slice(self.alloc, self.env.node_ty_list(&en));
            }
        }
        try self.push_scope();
        let params = arena.params_range(params_range);
        var p_tys = try col.DynBuf.[types.TyId].init(self.alloc, params.len +% 1_usize);
        errdefer p_tys.destroy(self.alloc);
        let ep_s = exp_params.as_slice();
        var i: usize = 0_usize;
        while i < params.len {
            let p = params[i];
            var is_inferred = false;
            if let tn = arena.get_type(p.ty) {
                is_inferred = tn.kind == .Inferred;
            }
            let pty = if is_inferred {
                if has_exp && i < ep_s.len { ep_s[i] } else { types.TY_ERROR }
            } else {
                try self.resolve_ty(arena, p.ty)
            };
            try p_tys.push(self.alloc, pty);
            try self.table.set_span_ty(self.alloc, p.span, pty);
            let is_mut = p.modifier == .Mut;
            _ = try self.bind_local(p.name.sym, p.span, pty, is_mut, true, p.is_comptime, p.is_self);
            i = i +% 1_usize;
        }
        let saved_ret = self.sig.ret;
        self.sig.ret = if has_exp { exp_ret } else { types.TY_ERROR };
        let body_res = try self.check_block_expr(arena, body_id, exp_ret);
        self.sig.ret = saved_ret;
        try self.pop_scope();

        var inferred_ret = body_res.ty;
        if has_exp {
            inferred_ret = exp_ret;
        } else if body_res.ty == types.TY_NEVER {
            var found_ret = types.TY_VOID;
            if let blk = arena.get_block(body_id) {
                let stmts = arena.stmt_list_range(blk.stmts);
                var si: usize = 0_usize;
                while si < stmts.len {
                    if let st = arena.get_stmt(stmts[si]) {
                        if st.kind == .Jump {
                            if let jmp = arena.get_jump(st.a) {
                                if jmp.kind == .Return && jmp.value != ast.NONE_ID {
                                    if let rt = self.table.get_expr_ty(jmp.value) {
                                        found_ret = rt;
                                    }
                                    break;
                                }
                            }
                        }
                    }
                    si = si +% 1_usize;
                }
            }
            inferred_ret = found_ret;
        }
        let res = try self.env.intern_fn_ptr(self.alloc, p_tys.as_slice(), inferred_ret);
        p_tys.destroy(self.alloc);
        exp_params.destroy(self.alloc);
        return res;
    }
}

// ===========================================================================
// Section 8A: Cast Methods, Builtin Methods, and Builtin Assoc Calls
// ===========================================================================

fn is_cast_method_name(name: *[u8]) -> bool {
    return str.bytes_eq(name, "widen".as_bytes())
        || str.bytes_eq(name, "trunc".as_bytes())
        || str.bytes_eq(name, "clamp".as_bytes())
        || str.bytes_eq(name, "try_into".as_bytes())
        || str.bytes_eq(name, "bitcast".as_bytes())
        || str.bytes_eq(name, "to_float".as_bytes())
        || str.bytes_eq(name, "trunc_to_int".as_bytes());
}

fn is_mut_builtin_method_name(name: *[u8]) -> bool {
    return str.bytes_eq(name, "alloc".as_bytes())
        || str.bytes_eq(name, "reset".as_bytes())
        || str.bytes_eq(name, "push".as_bytes())
        || str.bytes_eq(name, "push_slice".as_bytes())
        || str.bytes_eq(name, "insert".as_bytes())
        || str.bytes_eq(name, "try_insert".as_bytes())
        || str.bytes_eq(name, "remove".as_bytes())
        || str.bytes_eq(name, "get_mut".as_bytes())
        || str.bytes_eq(name, "at_mut".as_bytes())
        || str.bytes_eq(name, "sub_mut".as_bytes());
}

fn is_pow2_u64(v: u64) -> bool {
    return v != 0_u64 && (v & (v -% 1_u64)) == 0_u64;
}

impl Checker {
    @recursive
    fn check_slice_at_call(
        self: *mut Self,
        arena: *ast.AstArena,
        args: *[u32],
        elem: types.TyId,
        is_mut: bool,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if args.len != 1_usize {
            var msg = try str.StrBuf.init(self.alloc, 64_usize);
            errdefer msg.destroy(self.alloc);
            try msg.push_str_grow(self.alloc, if is_mut { ".at_mut() expects 1 index argument, found " } else { ".at() expects 1 index argument, found " });
            try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
            try self.emit_err_buf(diag.E0230, sp, &msg);
            msg.destroy(self.alloc);
        }
        var i: usize = 0_usize;
        while i < args.len {
            let it = try self.check_expr_rvalue(arena, args[i], types.TY_USIZE);
            try self.expect_assignable(it, types.TY_USIZE, expr_span(arena, args[i]));
            i = i +% 1_usize;
        }
        let ok = try self.env.intern_borrow(self.alloc, is_mut, .Single, elem);
        let errs: [1]types.ErrorSource = [types.err_src_builtin(.BoundsError)];
        return try self.env.intern_error_union(self.alloc, ok, errs[0_usize..1_usize]);
    }

    @recursive
    fn check_slice_get_call(
        self: *mut Self,
        arena: *ast.AstArena,
        args: *[u32],
        elem: types.TyId,
        is_mut: bool,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if args.len != 1_usize {
            var msg = try str.StrBuf.init(self.alloc, 64_usize);
            errdefer msg.destroy(self.alloc);
            try msg.push_str_grow(self.alloc, if is_mut { ".get_mut() expects 1 index argument, found " } else { ".get() expects 1 index argument, found " });
            try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
            try self.emit_err_buf(diag.E0230, sp, &msg);
            msg.destroy(self.alloc);
        }
        var i: usize = 0_usize;
        while i < args.len {
            let it = try self.check_expr_rvalue(arena, args[i], types.TY_USIZE);
            try self.expect_assignable(it, types.TY_USIZE, expr_span(arena, args[i]));
            i = i +% 1_usize;
        }
        let ptr = try self.env.intern_borrow(self.alloc, is_mut, .Single, elem);
        return try self.env.intern_optional(self.alloc, ptr);
    }

    @recursive
    fn check_slice_sub_call(
        self: *mut Self,
        arena: *ast.AstArena,
        args: *[u32],
        elem: types.TyId,
        is_mut: bool,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if args.len != 2_usize {
            var msg = try str.StrBuf.init(self.alloc, 64_usize);
            errdefer msg.destroy(self.alloc);
            try msg.push_str_grow(self.alloc, if is_mut { ".sub_mut() expects 2 range arguments (lo, hi), found " } else { ".sub() expects 2 range arguments (lo, hi), found " });
            try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
            try self.emit_err_buf(diag.E0230, sp, &msg);
            msg.destroy(self.alloc);
        }
        var i: usize = 0_usize;
        while i < args.len {
            let it = try self.check_expr_rvalue(arena, args[i], types.TY_USIZE);
            try self.expect_assignable(it, types.TY_USIZE, expr_span(arena, args[i]));
            i = i +% 1_usize;
        }
        let ok = try self.env.intern_borrow(self.alloc, is_mut, .Slice, elem);
        let errs: [1]types.ErrorSource = [types.err_src_builtin(.BoundsError)];
        return try self.env.intern_error_union(self.alloc, ok, errs[0_usize..1_usize]);
    }

    @recursive
    fn check_slot_id_arg(
        self: *mut Self,
        arena: *ast.AstArena,
        args: *[u32],
        expected_gen_id: types.TyId,
        mname_sym: u32,
        sp: span.Span,
    ) -> !OutOfMemory {
        if args.len != 1_usize {
            var msg = try str.StrBuf.init(self.alloc, 80_usize);
            errdefer msg.destroy(self.alloc);
            try msg.push_str_grow(self.alloc, "SlotPool.");
            try msg.push_bytes_grow(self.alloc, self.interner.get(mname_sym));
            try msg.push_str_grow(self.alloc, " expects 1 `GenId` argument, found ");
            try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
            try self.emit_err_buf(diag.E0230, sp, &msg);
            msg.destroy(self.alloc);
        }
        var i: usize = 0_usize;
        while i < args.len {
            let got = try self.check_expr_rvalue(arena, args[i], expected_gen_id);
            try self.expect_assignable(got, expected_gen_id, expr_span(arena, args[i]));
            i = i +% 1_usize;
        }
        return;
    }

    @recursive
    fn check_cast_method(
        self: *mut Self,
        arena: *ast.AstArena,
        kind_sym: u32,
        recv_id: u32,
        gargs_range: ast.IdRange,
        args: *[u32],
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if args.len > 0_usize {
            try self.emit_err_sym2(diag.E0230, sp, "`.", kind_sym, "()` takes no value arguments");
        }
        let gargs = arena.generic_args_range(gargs_range);
        if gargs.len != 1_usize {
            try self.emit_err_sym2(
                diag.E0230, sp, "`.", kind_sym, ".[To]()` requires 1 target type argument",
            );
            return types.TY_ERROR;
        }
        let gv = try self.eval_generic_arg(arena, &gargs[0_usize]);
        if gv.kind != .Ty {
            try self.emit_err(diag.E0230, gargs[0_usize].span, "expected target type");
            return types.TY_ERROR;
        }
        let to_ty = gv.id;
        let from_ty = try self.check_expr(arena, recv_id, types.TY_NONE);
        if from_ty == types.TY_ERROR || to_ty == types.TY_ERROR {
            return types.TY_ERROR;
        }
        if self.sym_eq(kind_sym, "widen") {
            let fn_node = self.env.get(from_ty);
            let tn_node = self.env.get(to_ty);
            var ok = false;
            if fn_node.kind == .Int && tn_node.kind == .Int {
                let s1 = fn_node.flag0;
                let s2 = tn_node.flag0;
                let bw1: u8 = if fn_node.flag1 { 64_u8 } else { fn_node.u8_val };
                let bw2: u8 = if tn_node.flag1 { 64_u8 } else { tn_node.u8_val };
                ok = (s1 == s2 && bw2 >= bw1) || (!s1 && s2 && bw2 > bw1);
            } else if fn_node.kind == .Float && tn_node.kind == .Float {
                ok = tn_node.u8_val >= fn_node.u8_val;
            }
            if !ok {
                try self.emit_err_ty_ty(
                    diag.E0230, sp, "cannot `.widen()` from `", from_ty, "` to `", to_ty, "`",
                );
            }
            return to_ty;
        }
        if self.sym_eq(kind_sym, "trunc") || self.sym_eq(kind_sym, "clamp") {
            let is_trunc = self.sym_eq(kind_sym, "trunc");
            let both_int = self.env.is_integer(from_ty) && self.env.is_integer(to_ty);
            let both_float_trunc = is_trunc && self.env.is_float(from_ty) && self.env.is_float(to_ty);
            if !both_int && !both_float_trunc {
                var msg = try str.StrBuf.init(self.alloc, 96_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, "`.");
                try msg.push_bytes_grow(self.alloc, self.interner.get(kind_sym));
                try msg.push_str_grow(self.alloc, "()` converts between integer types, found `");
                try self.env.format_ty_named(self.alloc, from_ty, self.prog, self.interner, &mut msg);
                try msg.push_str_grow(self.alloc, "` -> `");
                try self.env.format_ty_named(self.alloc, to_ty, self.prog, self.interner, &mut msg);
                try msg.push_byte_grow(self.alloc, b'`');
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            return to_ty;
        }
        if self.sym_eq(kind_sym, "try_into") {
            if !self.env.is_integer(from_ty) || !self.env.is_integer(to_ty) {
                try self.emit_err_ty_ty(
                    diag.E0230,
                    sp,
                    "`.try_into()` converts between integer types, found `",
                    from_ty,
                    "` -> `",
                    to_ty,
                    "`",
                );
            }
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.ArithError)];
            return try self.env.intern_error_union(self.alloc, to_ty, errs[0_usize..1_usize]);
        }
        if self.sym_eq(kind_sym, "bitcast") {
            let l1 = self.env.eon_layout(from_ty);
            let l2 = self.env.eon_layout(to_ty);
            if l1.size != l2.size {
                var msg = try str.StrBuf.init(self.alloc, 80_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, "`.bitcast()` requires equal byte sizes (");
                try msg.push_u64_grow(self.alloc, l1.size);
                try msg.push_str_grow(self.alloc, " != ");
                try msg.push_u64_grow(self.alloc, l2.size);
                try msg.push_byte_grow(self.alloc, b')');
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            } else if self.env.has_niche_forbidden_for_bitcast(from_ty)
                || self.env.has_niche_forbidden_for_bitcast(to_ty)
            {
                try self.emit_err_ty_ty(
                    diag.E0230,
                    sp,
                    "cannot `.bitcast()` between `",
                    from_ty,
                    "` and `",
                    to_ty,
                    "` because one contains disallowed niches/invariants",
                );
            }
            return to_ty;
        }
        if self.sym_eq(kind_sym, "to_float") {
            if !self.env.is_integer(from_ty) || !self.env.is_float(to_ty) {
                try self.emit_err(
                    diag.E0230, sp, "`.to_float()` converts from integer to floating-point type",
                );
            }
            return to_ty;
        }
        if self.sym_eq(kind_sym, "trunc_to_int") {
            if !self.env.is_float(from_ty) || !self.env.is_integer(to_ty) {
                try self.emit_err(
                    diag.E0230, sp, "`.trunc_to_int()` converts from floating-point to integer type",
                );
            }
            return to_ty;
        }
        return types.TY_ERROR;
    }

    @recursive
    fn try_builtin_method_slice(
        self: *mut Self,
        arena: *ast.AstArena,
        rty: types.TyId,
        is_mut: bool,
        elem: types.TyId,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if self.sym_eq(mname_sym, "len") {
            if args.len > 0_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, ".len() takes 0 arguments, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            return types.TY_USIZE;
        }
        if self.sym_eq(mname_sym, "as_str") && elem == types.TY_U8 {
            if args.len > 0_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, ".as_str() takes 0 arguments, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            let sb = try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID);
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.Utf8Error)];
            return try self.env.intern_error_union(self.alloc, sb, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "at") {
            return try self.check_slice_at_call(arena, args, elem, false, sp);
        }
        if self.sym_eq(mname_sym, "at_mut") {
            if !is_mut {
                try self.emit_err(diag.E0230, sp, "cannot call `.at_mut()` on immutable slice");
            }
            return try self.check_slice_at_call(arena, args, elem, true, sp);
        }
        if self.sym_eq(mname_sym, "get") {
            return try self.check_slice_get_call(arena, args, elem, false, sp);
        }
        if self.sym_eq(mname_sym, "get_mut") {
            if !is_mut {
                try self.emit_err(diag.E0230, sp, "cannot call `.get_mut()` on immutable slice");
            }
            return try self.check_slice_get_call(arena, args, elem, true, sp);
        }
        if self.sym_eq(mname_sym, "sub") {
            return try self.check_slice_sub_call(arena, args, elem, false, sp);
        }
        if self.sym_eq(mname_sym, "sub_mut") {
            if !is_mut {
                try self.emit_err(diag.E0230, sp, "cannot call `.sub_mut()` on immutable slice");
            }
            return try self.check_slice_sub_call(arena, args, elem, true, sp);
        }
        if self.sym_eq(mname_sym, "each") {
            if args.len > 0_usize {
                try self.emit_err(diag.E0230, sp, ".each() takes 0 arguments");
            }
            return try self.env.intern_borrow(self.alloc, false, .Slice, elem);
        }
        if self.sym_eq(mname_sym, "each_mut") {
            if !is_mut {
                try self.emit_err(diag.E0230, sp, "cannot call `.each_mut()` on immutable slice");
            }
            if args.len > 0_usize {
                try self.emit_err(diag.E0230, sp, ".each_mut() takes 0 arguments");
            }
            return rty;
        }
        if self.sym_eq(mname_sym, "par_reduce") {
            if args.len != 2_usize {
                try self.emit_err(diag.E0230, sp, ".par_reduce(op, init) expects 2 arguments");
            } else {
                var is_enum_lit = false;
                if let a0 = arena.get_expr(args[0_usize]) {
                    is_enum_lit = a0.kind == .EnumLit;
                }
                if !is_enum_lit {
                    _ = try self.check_expr_rvalue(arena, args[0_usize], types.TY_NONE);
                }
                let init_ty = try self.check_expr_rvalue(arena, args[1_usize], elem);
                try self.expect_assignable(init_ty, elem, expr_span(arena, args[1_usize]));
            }
            return elem;
        }
        return null;
    }

    @recursive
    fn try_builtin_method_array(
        self: *mut Self,
        arena: *ast.AstArena,
        recv_id: u32,
        rty: types.TyId,
        elem: types.TyId,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        let rn = self.env.get(rty);
        if self.sym_eq(mname_sym, "len") {
            if args.len > 0_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, ".len() takes 0 arguments, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            return types.TY_USIZE;
        }
        if self.sym_eq(mname_sym, "at") {
            return try self.check_slice_at_call(arena, args, elem, false, sp);
        }
        if self.sym_eq(mname_sym, "at_mut") {
            if rn.kind == .Borrow && !rn.flag0 {
                try self.emit_err(diag.E0230, sp, "cannot call `.at_mut()` through immutable borrow");
            } else if !(rn.kind == .Borrow && rn.flag0) {
                try self.check_place_mutability(arena, recv_id, expr_span(arena, recv_id));
            }
            return try self.check_slice_at_call(arena, args, elem, true, sp);
        }
        if self.sym_eq(mname_sym, "get") {
            return try self.check_slice_get_call(arena, args, elem, false, sp);
        }
        if self.sym_eq(mname_sym, "get_mut") {
            if rn.kind == .Borrow && !rn.flag0 {
                try self.emit_err(diag.E0230, sp, "cannot call `.get_mut()` through immutable borrow");
            } else if !(rn.kind == .Borrow && rn.flag0) {
                try self.check_place_mutability(arena, recv_id, expr_span(arena, recv_id));
            }
            return try self.check_slice_get_call(arena, args, elem, true, sp);
        }
        if self.sym_eq(mname_sym, "sub") {
            return try self.check_slice_sub_call(arena, args, elem, false, sp);
        }
        if self.sym_eq(mname_sym, "sub_mut") {
            if rn.kind == .Borrow && !rn.flag0 {
                try self.emit_err(diag.E0230, sp, "cannot call `.sub_mut()` through immutable borrow");
            } else if !(rn.kind == .Borrow && rn.flag0) {
                try self.check_place_mutability(arena, recv_id, expr_span(arena, recv_id));
            }
            return try self.check_slice_sub_call(arena, args, elem, true, sp);
        }
        return null;
    }

    @recursive
    fn try_builtin_method_vec_ops(
        self: *mut Self,
        arena: *ast.AstArena,
        deref: types.TyId,
        elem: types.TyId,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if self.sym_eq(mname_sym, "min") || self.sym_eq(mname_sym, "max") {
            if !self.env.is_numeric(elem) {
                try self.emit_err_sym2(diag.E0230, sp, "vec.", mname_sym, "() requires numeric elements");
            }
            if args.len != 1_usize {
                try self.emit_err_sym2(diag.E0230, sp, "vec.", mname_sym, "() expects 1 vector argument");
            } else {
                let at = try self.check_expr_rvalue(arena, args[0_usize], deref);
                try self.expect_assignable(at, deref, expr_span(arena, args[0_usize]));
            }
            return deref;
        }
        if self.sym_eq(mname_sym, "fma") {
            if !self.env.is_numeric(elem) {
                try self.emit_err(diag.E0230, sp, "vec.fma() requires numeric elements");
            }
            if args.len != 2_usize {
                try self.emit_err(diag.E0230, sp, "vec.fma(b, c) expects 2 vector arguments");
            } else {
                let tb = try self.check_expr_rvalue(arena, args[0_usize], deref);
                try self.expect_assignable(tb, deref, expr_span(arena, args[0_usize]));
                let tc = try self.check_expr_rvalue(arena, args[1_usize], deref);
                try self.expect_assignable(tc, deref, expr_span(arena, args[1_usize]));
            }
            return deref;
        }
        if self.sym_eq(mname_sym, "reduce_add")
            || self.sym_eq(mname_sym, "reduce_min")
            || self.sym_eq(mname_sym, "reduce_max")
        {
            if !self.env.is_numeric(elem) {
                try self.emit_err_sym2(diag.E0230, sp, "vec.", mname_sym, "() requires numeric elements");
            }
            if args.len > 0_usize {
                try self.emit_err_sym2(diag.E0230, sp, "vec.", mname_sym, "() takes 0 arguments");
            }
            return elem;
        }
        if self.sym_eq(mname_sym, "dot") {
            if !self.env.is_numeric(elem) {
                try self.emit_err(diag.E0230, sp, "vec.dot() requires numeric elements");
            }
            if args.len != 1_usize {
                try self.emit_err(diag.E0230, sp, "vec.dot(other) expects 1 vector argument");
            } else {
                let at = try self.check_expr_rvalue(arena, args[0_usize], deref);
                try self.expect_assignable(at, deref, expr_span(arena, args[0_usize]));
            }
            return elem;
        }
        if self.sym_eq(mname_sym, "shuffle") {
            if args.len != 1_usize && args.len != 2_usize {
                try self.emit_err(diag.E0230, sp, "vec.shuffle expects (idx_vec) or (other, idx_vec)");
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
                return types.TY_ERROR;
            }
            var idx_arg = args[0_usize];
            if args.len == 2_usize {
                let ot = try self.check_expr_rvalue(arena, args[0_usize], deref);
                try self.expect_assignable(ot, deref, expr_span(arena, args[0_usize]));
                idx_arg = args[1_usize];
            }
            let idx_ty = try self.check_expr_rvalue(arena, idx_arg, types.TY_NONE);
            let in_node = self.env.get(idx_ty);
            if in_node.kind == .Vec && self.env.is_integer(in_node.primary) {
                return try self.env.intern_vec(self.alloc, elem, in_node.u8_val);
            }
            try self.emit_err(
                diag.E0230, expr_span(arena, idx_arg), "vec.shuffle index argument must be an integer vector",
            );
            return types.TY_ERROR;
        }
        return null;
    }

    @recursive
    fn try_builtin_method_vec(
        self: *mut Self,
        arena: *ast.AstArena,
        deref: types.TyId,
        elem: types.TyId,
        len: u8,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if self.sym_eq(mname_sym, "len") {
            if args.len > 0_usize {
                try self.emit_err(diag.E0230, sp, "vec.len() takes 0 arguments");
            }
            return types.TY_USIZE;
        }
        if self.sym_eq(mname_sym, "cmpeq")
            || self.sym_eq(mname_sym, "cmpne")
            || self.sym_eq(mname_sym, "cmplt")
            || self.sym_eq(mname_sym, "cmple")
            || self.sym_eq(mname_sym, "cmpgt")
            || self.sym_eq(mname_sym, "cmpge")
        {
            if args.len != 1_usize {
                try self.emit_err_sym2(diag.E0230, sp, "vec.", mname_sym, "() expects 1 argument");
            } else {
                let at = try self.check_expr_rvalue(arena, args[0_usize], deref);
                try self.expect_assignable(at, deref, expr_span(arena, args[0_usize]));
            }
            return try self.env.intern_vec(self.alloc, types.TY_BOOL, len);
        }
        if self.sym_eq(mname_sym, "any") || self.sym_eq(mname_sym, "all") {
            if elem != types.TY_BOOL {
                try self.emit_err_sym2(diag.E0230, sp, "vec.", mname_sym, "() requires vec[bool, N]");
            }
            if args.len > 0_usize {
                try self.emit_err_sym2(diag.E0230, sp, "vec.", mname_sym, "() takes 0 arguments");
            }
            return types.TY_BOOL;
        }
        if self.sym_eq(mname_sym, "bitmask") {
            if elem != types.TY_BOOL {
                try self.emit_err(diag.E0230, sp, "vec.bitmask() requires vec[bool, N]");
            }
            if args.len > 0_usize {
                try self.emit_err(diag.E0230, sp, "vec.bitmask() takes 0 arguments");
            }
            return types.TY_U64;
        }
        if self.sym_eq(mname_sym, "select") {
            if elem != types.TY_BOOL {
                try self.emit_err(diag.E0230, sp, "vec.select() requires vec[bool, N] mask receiver");
            }
            if args.len != 2_usize {
                try self.emit_err(diag.E0230, sp, "vec.select(a, b) expects 2 vector arguments");
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
                return types.TY_ERROR;
            }
            let ta = try self.check_expr_rvalue(arena, args[0_usize], types.TY_NONE);
            let tb = try self.check_expr_rvalue(arena, args[1_usize], ta);
            let tan = self.env.get(ta);
            if tan.kind == .Vec {
                if tan.u8_val != len {
                    var msg = try str.StrBuf.init(self.alloc, 64_usize);
                    errdefer msg.destroy(self.alloc);
                    try msg.push_str_grow(self.alloc, "vec.select() mask length ");
                    try msg.push_u64_grow(self.alloc, len.widen.[u64]());
                    try msg.push_str_grow(self.alloc, " != value length ");
                    try msg.push_u64_grow(self.alloc, tan.u8_val.widen.[u64]());
                    try self.emit_err_buf(diag.E0230, expr_span(arena, args[0_usize]), &msg);
                    msg.destroy(self.alloc);
                }
                try self.expect_assignable(tb, ta, expr_span(arena, args[1_usize]));
                return ta;
            }
            try self.emit_err(
                diag.E0230, expr_span(arena, args[0_usize]), "vec.select() arguments must be vectors",
            );
            return types.TY_ERROR;
        }
        return try self.try_builtin_method_vec_ops(arena, deref, elem, mname_sym, args, sp);
    }

    @recursive
    fn try_builtin_method_fscap(
        self: *mut Self,
        arena: *ast.AstArena,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        let str_b = try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID);
        if self.sym_eq(mname_sym, "open_dir") || self.sym_eq(mname_sym, "sub_dir") {
            if args.len != 1_usize {
                try self.emit_err_sym2(diag.E0230, sp, "FsCap.", mname_sym, " expects 1 path argument");
            } else {
                let pt = try self.check_expr_rvalue(arena, args[0_usize], str_b);
                try self.expect_assignable(pt, str_b, expr_span(arena, args[0_usize]));
            }
            let ok = try self.env.intern_builtin_empty(self.alloc, .DirCap);
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.IoError)];
            return try self.env.intern_error_union(self.alloc, ok, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "read_file") || self.sym_eq(mname_sym, "list_dir") {
            let ac = try self.env.intern_builtin_empty(self.alloc, .AllocCap);
            let ac_ptr = try self.env.intern_borrow(self.alloc, true, .Single, ac);
            if args.len != 2_usize {
                if self.sym_eq(mname_sym, "read_file") {
                    try self.emit_err(diag.E0230, sp, "FsCap.read_file expects (alloc: *mut AllocCap, path: *str)");
                } else {
                    try self.emit_err(diag.E0230, sp, "FsCap.list_dir expects (alloc: *mut AllocCap, path: *str)");
                }
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
            } else {
                let at = try self.check_expr_rvalue(arena, args[0_usize], ac_ptr);
                try self.expect_assignable(at, ac_ptr, expr_span(arena, args[0_usize]));
                let pt = try self.check_expr_rvalue(arena, args[1_usize], str_b);
                try self.expect_assignable(pt, str_b, expr_span(arena, args[1_usize]));
            }
            let ga: [1]types.GenericVal = [types.gval_ty(types.TY_U8)];
            let buf_u8 = try self.env.intern_builtin(self.alloc, .Buf, ga[0_usize..1_usize]);
            let errs: [2]types.ErrorSource = [
                types.err_src_builtin(.OutOfMemory),
                types.err_src_builtin(.IoError),
            ];
            return try self.env.intern_error_union(self.alloc, buf_u8, errs[0_usize..2_usize]);
        }
        if self.sym_eq(mname_sym, "write_file") || self.sym_eq(mname_sym, "write_executable") {
            let slice_u8 = try self.env.intern_borrow(self.alloc, false, .Slice, types.TY_U8);
            if args.len != 2_usize {
                if self.sym_eq(mname_sym, "write_file") {
                    try self.emit_err(diag.E0230, sp, "FsCap.write_file expects (path: *str, data: *[u8])");
                } else {
                    try self.emit_err(diag.E0230, sp, "FsCap.write_executable expects (path: *str, data: *[u8])");
                }
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
            } else {
                let pt = try self.check_expr_rvalue(arena, args[0_usize], str_b);
                try self.expect_assignable(pt, str_b, expr_span(arena, args[0_usize]));
                let dt = try self.check_expr_rvalue(arena, args[1_usize], slice_u8);
                try self.expect_assignable(dt, slice_u8, expr_span(arena, args[1_usize]));
            }
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.IoError)];
            return try self.env.intern_error_union(self.alloc, types.TY_VOID, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "is_dir") {
            if args.len != 1_usize {
                try self.emit_err(diag.E0230, sp, "FsCap.is_dir expects 1 path argument");
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
            } else {
                let pt = try self.check_expr_rvalue(arena, args[0_usize], str_b);
                try self.expect_assignable(pt, str_b, expr_span(arena, args[0_usize]));
            }
            return types.TY_BOOL;
        }
        if self.sym_eq(mname_sym, "mkdir_all") {
            if args.len != 1_usize {
                try self.emit_err(diag.E0230, sp, "FsCap.mkdir_all expects 1 path argument");
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
            } else {
                let pt = try self.check_expr_rvalue(arena, args[0_usize], str_b);
                try self.expect_assignable(pt, str_b, expr_span(arena, args[0_usize]));
            }
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.IoError)];
            return try self.env.intern_error_union(self.alloc, types.TY_VOID, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "spawn_wait") {
            let slice_u8 = try self.env.intern_borrow(self.alloc, false, .Slice, types.TY_U8);
            if args.len != 2_usize {
                try self.emit_err(diag.E0230, sp, "FsCap.spawn_wait expects (path: *str, args_nul: *[u8])");
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
            } else {
                let pt = try self.check_expr_rvalue(arena, args[0_usize], str_b);
                try self.expect_assignable(pt, str_b, expr_span(arena, args[0_usize]));
                let dt = try self.check_expr_rvalue(arena, args[1_usize], slice_u8);
                try self.expect_assignable(dt, slice_u8, expr_span(arena, args[1_usize]));
            }
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.IoError)];
            return try self.env.intern_error_union(self.alloc, types.TY_I32, errs[0_usize..1_usize]);
        }
        return null;
    }

    @recursive
    fn try_builtin_method_dircap(
        self: *mut Self,
        arena: *ast.AstArena,
        rty: types.TyId,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        let str_b = try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID);
        if self.sym_eq(mname_sym, "sub_dir") {
            if args.len != 1_usize {
                try self.emit_err(diag.E0230, sp, "DirCap.sub_dir expects 1 path argument");
            } else {
                let pt = try self.check_expr_rvalue(arena, args[0_usize], str_b);
                try self.expect_assignable(pt, str_b, expr_span(arena, args[0_usize]));
            }
            let ok = try self.env.intern_builtin_empty(self.alloc, .DirCap);
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.IoError)];
            return try self.env.intern_error_union(self.alloc, ok, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "read_file") {
            let ac = try self.env.intern_builtin_empty(self.alloc, .AllocCap);
            let ac_ptr = try self.env.intern_borrow(self.alloc, true, .Single, ac);
            if args.len != 2_usize {
                try self.emit_err(diag.E0230, sp, "DirCap.read_file expects (alloc: *mut AllocCap, rel: *str)");
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
            } else {
                let at = try self.check_expr_rvalue(arena, args[0_usize], ac_ptr);
                try self.expect_assignable(at, ac_ptr, expr_span(arena, args[0_usize]));
                let pt = try self.check_expr_rvalue(arena, args[1_usize], str_b);
                try self.expect_assignable(pt, str_b, expr_span(arena, args[1_usize]));
            }
            let ga: [1]types.GenericVal = [types.gval_ty(types.TY_U8)];
            let buf_u8 = try self.env.intern_builtin(self.alloc, .Buf, ga[0_usize..1_usize]);
            let errs: [2]types.ErrorSource = [
                types.err_src_builtin(.OutOfMemory),
                types.err_src_builtin(.IoError),
            ];
            return try self.env.intern_error_union(self.alloc, buf_u8, errs[0_usize..2_usize]);
        }
        if self.sym_eq(mname_sym, "write_file") {
            let slice_u8 = try self.env.intern_borrow(self.alloc, false, .Slice, types.TY_U8);
            if args.len != 2_usize {
                try self.emit_err(diag.E0230, sp, "DirCap.write_file expects (rel: *str, data: *[u8])");
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
            } else {
                let pt = try self.check_expr_rvalue(arena, args[0_usize], str_b);
                try self.expect_assignable(pt, str_b, expr_span(arena, args[0_usize]));
                let dt = try self.check_expr_rvalue(arena, args[1_usize], slice_u8);
                try self.expect_assignable(dt, slice_u8, expr_span(arena, args[1_usize]));
            }
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.IoError)];
            return try self.env.intern_error_union(self.alloc, types.TY_VOID, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "close") {
            if args.len > 0_usize {
                try self.emit_err(diag.E0230, sp, "DirCap.close() takes 0 arguments");
            }
            if self.env.get(rty).kind == .Borrow {
                try self.emit_err(
                    diag.E0109, sp, "cannot consume borrowed `DirCap` via `.close()`; pass owned `DirCap`",
                );
            }
            return types.TY_VOID;
        }
        return null;
    }

    @recursive
    fn try_builtin_method_dircap_buildcap(
        self: *mut Self,
        arena: *ast.AstArena,
        rty: types.TyId,
        bk: resolve.BuiltinKind,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if bk == .DirCap {
            return try self.try_builtin_method_dircap(arena, rty, mname_sym, args, sp);
        }
        let str_b = try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID);
        if self.sym_eq(mname_sym, "add_module")
            || self.sym_eq(mname_sym, "add_exe")
            || self.sym_eq(mname_sym, "add_shared_lib")
            || self.sym_eq(mname_sym, "add_shared")
            || self.sym_eq(mname_sym, "add_dep")
            || self.sym_eq(mname_sym, "add_lib")
        {
            if args.len != 2_usize {
                try self.emit_err_sym2(diag.E0230, sp, "BuildCap.", mname_sym, " expects 2 string arguments");
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
            } else {
                let a0 = try self.check_expr_rvalue(arena, args[0_usize], str_b);
                try self.expect_assignable(a0, str_b, expr_span(arena, args[0_usize]));
                let a1 = try self.check_expr_rvalue(arena, args[1_usize], str_b);
                try self.expect_assignable(a1, str_b, expr_span(arena, args[1_usize]));
            }
            return types.TY_VOID;
        }
        if self.sym_eq(mname_sym, "set_opt_level") {
            if args.len != 1_usize {
                try self.emit_err(diag.E0230, sp, "BuildCap.set_opt_level expects 1 u8 argument");
            } else {
                let lt = try self.check_expr_rvalue(arena, args[0_usize], types.TY_U8);
                try self.expect_assignable(lt, types.TY_U8, expr_span(arena, args[0_usize]));
            }
            return types.TY_VOID;
        }
        if self.sym_eq(mname_sym, "set_sanitize") || self.sym_eq(mname_sym, "set_audit_tcb") {
            if args.len != 1_usize {
                try self.emit_err_sym2(diag.E0230, sp, "BuildCap.", mname_sym, " expects 1 bool argument");
            } else {
                let bt = try self.check_expr_rvalue(arena, args[0_usize], types.TY_BOOL);
                try self.expect_assignable(bt, types.TY_BOOL, expr_span(arena, args[0_usize]));
            }
            return types.TY_VOID;
        }
        if self.sym_eq(mname_sym, "link_lib")
            || self.sym_eq(mname_sym, "add_needed_lib")
            || self.sym_eq(mname_sym, "allow_hal")
            || self.sym_eq(mname_sym, "set_out_dir")
        {
            if args.len != 1_usize {
                try self.emit_err_sym2(diag.E0230, sp, "BuildCap.", mname_sym, " expects 1 string argument");
            } else {
                let a0 = try self.check_expr_rvalue(arena, args[0_usize], str_b);
                try self.expect_assignable(a0, str_b, expr_span(arena, args[0_usize]));
            }
            return types.TY_VOID;
        }
        if self.sym_eq(mname_sym, "out_path") {
            if args.len != 1_usize {
                try self.emit_err(diag.E0230, sp, "BuildCap.out_path expects 1 relative path argument");
            } else {
                let a0 = try self.check_expr_rvalue(arena, args[0_usize], str_b);
                try self.expect_assignable(a0, str_b, expr_span(arena, args[0_usize]));
            }
            return str_b;
        }
        return null;
    }

    @recursive
    fn try_builtin_method_arena_alloc(
        self: *mut Self,
        arena: *ast.AstArena,
        bk: resolve.BuiltinKind,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if bk == .Arena {
            if self.sym_eq(mname_sym, "alloc") {
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_USIZE);
                    i = i +% 1_usize;
                }
                let slice = try self.env.intern_borrow(self.alloc, true, .Slice, types.TY_U8);
                let errs: [1]types.ErrorSource = [types.err_src_builtin(.MemError)];
                return try self.env.intern_error_union(self.alloc, slice, errs[0_usize..1_usize]);
            }
            if self.sym_eq(mname_sym, "reset") || self.sym_eq(mname_sym, "destroy") {
                var i: usize = 0_usize;
                while i < args.len {
                    _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                    i = i +% 1_usize;
                }
                return types.TY_VOID;
            }
            if self.sym_eq(mname_sym, "used_bytes") || self.sym_eq(mname_sym, "capacity") {
                if args.len > 0_usize {
                    var msg = try str.StrBuf.init(self.alloc, 64_usize);
                    errdefer msg.destroy(self.alloc);
                    try msg.push_str_grow(self.alloc, "Arena.");
                    try msg.push_bytes_grow(self.alloc, self.interner.get(mname_sym));
                    try msg.push_str_grow(self.alloc, "() takes 0 arguments, found ");
                    try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                    try self.emit_err_buf(diag.E0230, sp, &msg);
                    msg.destroy(self.alloc);
                }
                return types.TY_USIZE;
            }
            return null;
        }
        if self.sym_eq(mname_sym, "live_allocs")
            || self.sym_eq(mname_sym, "used_bytes")
            || self.sym_eq(mname_sym, "peak_bytes")
        {
            if args.len > 0_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, "AllocCap.");
                try msg.push_bytes_grow(self.alloc, self.interner.get(mname_sym));
                try msg.push_str_grow(self.alloc, "() takes 0 arguments, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            return types.TY_USIZE;
        }
        if self.sym_eq(mname_sym, "sub_budget") {
            if args.len != 1_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, "AllocCap.sub_budget() takes 1 argument, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            } else {
                let lt = try self.check_expr_rvalue(arena, args[0_usize], types.TY_USIZE);
                try self.expect_assignable(lt, types.TY_USIZE, expr_span(arena, args[0_usize]));
            }
            return try self.env.intern_builtin_empty(self.alloc, .AllocCap);
        }
        return null;
    }

    @recursive
    fn try_builtin_method_arena_and_caps(
        self: *mut Self,
        arena: *ast.AstArena,
        bk: resolve.BuiltinKind,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if bk == .Arena || bk == .AllocCap {
            return try self.try_builtin_method_arena_alloc(arena, bk, mname_sym, args, sp);
        }
        match bk {
            .ClockCap => {
                if self.sym_eq(mname_sym, "now_ns") {
                    if args.len > 0_usize {
                        try self.emit_err(diag.E0230, sp, "ClockCap.now_ns() takes 0 arguments");
                    }
                    return types.TY_U64;
                }
                return null;
            }
            .ArgsCap => {
                if self.sym_eq(mname_sym, "len") {
                    if args.len > 0_usize {
                        try self.emit_err(diag.E0230, sp, "ArgsCap.len() takes 0 arguments");
                    }
                    return types.TY_USIZE;
                }
                if self.sym_eq(mname_sym, "get") {
                    if args.len != 1_usize {
                        try self.emit_err(diag.E0230, sp, "ArgsCap.get(idx) expects 1 index argument");
                    } else {
                        let it = try self.check_expr_rvalue(arena, args[0_usize], types.TY_USIZE);
                        try self.expect_assignable(it, types.TY_USIZE, expr_span(arena, args[0_usize]));
                    }
                    let sb = try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID);
                    return try self.env.intern_optional(self.alloc, sb);
                }
                return null;
            }
            .NetCap => {
                if self.sym_eq(mname_sym, "restrict_host") {
                    let sb = try self.env.intern_borrow(self.alloc, false, .Str, types.TY_VOID);
                    if args.len != 1_usize {
                        try self.emit_err(diag.E0230, sp, "NetCap.restrict_host expects 1 host argument");
                    } else {
                        let ht = try self.check_expr_rvalue(arena, args[0_usize], sb);
                        try self.expect_assignable(ht, sb, expr_span(arena, args[0_usize]));
                    }
                    return try self.env.intern_builtin_empty(self.alloc, .NetCap);
                }
                return null;
            }
            .IoCap => {
                if self.sym_eq(mname_sym, "nop_roundtrip") {
                    if args.len != 1_usize {
                        try self.emit_err(diag.E0230, sp, "IoCap.nop_roundtrip expects 1 count argument");
                    } else {
                        let ct = try self.check_expr_rvalue(arena, args[0_usize], types.TY_USIZE);
                        try self.expect_assignable(ct, types.TY_USIZE, expr_span(arena, args[0_usize]));
                    }
                    let errs: [1]types.ErrorSource = [types.err_src_builtin(.IoError)];
                    return try self.env.intern_error_union(self.alloc, types.TY_USIZE, errs[0_usize..1_usize]);
                }
                if self.sym_eq(mname_sym, "run_fibers") {
                    if args.len != 2_usize {
                        try self.emit_err(
                            diag.E0230, sp, "IoCap.run_fibers expects (count: usize, stack_bytes: usize)",
                        );
                        var i: usize = 0_usize;
                        while i < args.len {
                            _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                            i = i +% 1_usize;
                        }
                    } else {
                        let ct = try self.check_expr_rvalue(arena, args[0_usize], types.TY_USIZE);
                        try self.expect_assignable(ct, types.TY_USIZE, expr_span(arena, args[0_usize]));
                        let st = try self.check_expr_rvalue(arena, args[1_usize], types.TY_USIZE);
                        try self.expect_assignable(st, types.TY_USIZE, expr_span(arena, args[1_usize]));
                    }
                    let errs: [1]types.ErrorSource = [types.err_src_builtin(.IoError)];
                    return try self.env.intern_error_union(self.alloc, types.TY_USIZE, errs[0_usize..1_usize]);
                }
                return null;
            }
            .Schedule => {
                if self.sym_eq(mname_sym, "run") {
                    var i: usize = 0_usize;
                    while i < args.len {
                        _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                        i = i +% 1_usize;
                    }
                    return types.TY_VOID;
                }
                return null;
            }
            _ => { return null; }
        }
    }

    @recursive
    fn try_builtin_method_arena_pool(
        self: *mut Self,
        arena: *ast.AstArena,
        recv_id: u32,
        gargs: *[types.GenericVal],
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        let pool_var = extract_root_ident_sym(arena, recv_id)
            orelse (try self.interner.intern_str(self.alloc, "_pool"));
        var has_elem = false;
        var elem_ty = types.TY_NONE;
        if gargs.len > 0_usize && gargs[0_usize].kind == .Ty {
            has_elem = true;
            elem_ty = gargs[0_usize].id;
        }
        if self.sym_eq(mname_sym, "push") {
            if args.len != 1_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, "ArenaPool.push expects 1 argument, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            let prev_has = self.has_pool_handle_kind;
            let prev_hk = self.pool_handle_kind;
            self.has_pool_handle_kind = true;
            self.pool_handle_kind = types.PoolHandleKind.{ tag: .ArenaPool, brand: pool_var };
            var i: usize = 0_usize;
            while i < args.len {
                let got = try self.check_expr_rvalue(arena, args[i], elem_ty);
                if has_elem {
                    try self.expect_assignable(got, elem_ty, expr_span(arena, args[i]));
                }
                i = i +% 1_usize;
            }
            self.has_pool_handle_kind = prev_has;
            self.pool_handle_kind = prev_hk;
            let ba: [1]types.GenericVal = [types.gval_variant(pool_var)];
            let id_ty = try self.env.intern_builtin(self.alloc, .IdBrand, ba[0_usize..1_usize]);
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.MemError)];
            return try self.env.intern_error_union(self.alloc, id_ty, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "id_at") {
            var i: usize = 0_usize;
            while i < args.len {
                _ = try self.check_expr_rvalue(arena, args[i], types.TY_USIZE);
                i = i +% 1_usize;
            }
            let ba: [1]types.GenericVal = [types.gval_variant(pool_var)];
            let id_ty = try self.env.intern_builtin(self.alloc, .IdBrand, ba[0_usize..1_usize]);
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.BoundsError)];
            return try self.env.intern_error_union(self.alloc, id_ty, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "reset") {
            return try self.env.intern_builtin(self.alloc, .ArenaPool, gargs);
        }
        if self.sym_eq(mname_sym, "len") {
            return types.TY_USIZE;
        }
        return null;
    }

    @recursive
    fn try_builtin_method_slot_pool_insert(
        self: *mut Self,
        arena: *ast.AstArena,
        elem_ty: types.TyId,
        alloc_mut: types.TyId,
        exp_gid: types.TyId,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if self.sym_eq(mname_sym, "insert") {
            if args.len != 2_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, "SlotPool.insert expects 2 arguments, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            if args.len > 0_usize {
                let at0 = try self.check_expr_rvalue(arena, args[0_usize], alloc_mut);
                try self.expect_assignable(at0, alloc_mut, expr_span(arena, args[0_usize]));
            }
            let prev_has = self.has_pool_handle_kind;
            let prev_hk = self.pool_handle_kind;
            self.has_pool_handle_kind = true;
            self.pool_handle_kind = types.PoolHandleKind.{ tag: .SlotPool, brand: span.SYM_EMPTY };
            var i: usize = 1_usize;
            while i < args.len {
                let got = try self.check_expr_rvalue(arena, args[i], elem_ty);
                try self.expect_assignable(got, elem_ty, expr_span(arena, args[i]));
                i = i +% 1_usize;
            }
            self.has_pool_handle_kind = prev_has;
            self.pool_handle_kind = prev_hk;
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.OutOfMemory)];
            return try self.env.intern_error_union(self.alloc, exp_gid, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "try_insert") {
            if args.len != 1_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, "SlotPool.try_insert expects 1 argument, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            let prev_has = self.has_pool_handle_kind;
            let prev_hk = self.pool_handle_kind;
            self.has_pool_handle_kind = true;
            self.pool_handle_kind = types.PoolHandleKind.{ tag: .SlotPool, brand: span.SYM_EMPTY };
            var i: usize = 0_usize;
            while i < args.len {
                let got = try self.check_expr_rvalue(arena, args[i], elem_ty);
                try self.expect_assignable(got, elem_ty, expr_span(arena, args[i]));
                i = i +% 1_usize;
            }
            self.has_pool_handle_kind = prev_has;
            self.pool_handle_kind = prev_hk;
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.OutOfMemory)];
            return try self.env.intern_error_union(self.alloc, exp_gid, errs[0_usize..1_usize]);
        }
        return null;
    }

    @recursive
    fn try_builtin_method_pools(
        self: *mut Self,
        arena: *ast.AstArena,
        recv_id: u32,
        rty: types.TyId,
        bk: resolve.BuiltinKind,
        gargs: *[types.GenericVal],
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if bk == .ArenaPool {
            return try self.try_builtin_method_arena_pool(arena, recv_id, gargs, mname_sym, args, sp);
        }
        let elem_ty = if gargs.len > 0_usize && gargs[0_usize].kind == .Ty {
            gargs[0_usize].id
        } else {
            types.TY_ERROR
        };
        let ac = try self.env.intern_builtin_empty(self.alloc, .AllocCap);
        let alloc_mut = try self.env.intern_borrow(self.alloc, true, .Single, ac);
        let ga: [1]types.GenericVal = [types.gval_ty(elem_ty)];
        let exp_gid = try self.env.intern_builtin(self.alloc, .GenId, ga[0_usize..1_usize]);
        if let ins_res = try self.try_builtin_method_slot_pool_insert(
            arena, elem_ty, alloc_mut, exp_gid, mname_sym, args, sp,
        ) {
            return ins_res;
        }
        if self.sym_eq(mname_sym, "remove") {
            try self.check_slot_id_arg(arena, args, exp_gid, mname_sym, sp);
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.StaleId)];
            return try self.env.intern_error_union(self.alloc, elem_ty, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "get") {
            try self.check_slot_id_arg(arena, args, exp_gid, mname_sym, sp);
            let b = try self.env.intern_borrow(self.alloc, false, .Single, elem_ty);
            return try self.env.intern_optional(self.alloc, b);
        }
        if self.sym_eq(mname_sym, "get_mut") {
            try self.check_slot_id_arg(arena, args, exp_gid, mname_sym, sp);
            let b = try self.env.intern_borrow(self.alloc, true, .Single, elem_ty);
            return try self.env.intern_optional(self.alloc, b);
        }
        if self.sym_eq(mname_sym, "at") {
            try self.check_slot_id_arg(arena, args, exp_gid, mname_sym, sp);
            let b = try self.env.intern_borrow(self.alloc, false, .Single, elem_ty);
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.StaleId)];
            return try self.env.intern_error_union(self.alloc, b, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "len") || self.sym_eq(mname_sym, "cap") {
            return types.TY_USIZE;
        }
        if self.sym_eq(mname_sym, "is_alive") {
            var i: usize = 0_usize;
            while i < args.len {
                let at = try self.check_expr_rvalue(arena, args[i], types.TY_USIZE);
                try self.expect_assignable(at, types.TY_USIZE, expr_span(arena, args[i]));
                i = i +% 1_usize;
            }
            return types.TY_BOOL;
        }
        if self.sym_eq(mname_sym, "id_at") {
            var i: usize = 0_usize;
            while i < args.len {
                let at = try self.check_expr_rvalue(arena, args[i], types.TY_USIZE);
                try self.expect_assignable(at, types.TY_USIZE, expr_span(arena, args[i]));
                i = i +% 1_usize;
            }
            return try self.env.intern_optional(self.alloc, exp_gid);
        }
        if self.sym_eq(mname_sym, "each") || self.sym_eq(mname_sym, "each_mut") {
            if args.len > 0_usize {
                try self.emit_err_sym2(diag.E0230, sp, ".", mname_sym, "() takes 0 arguments");
            }
            return rty;
        }
        if self.sym_eq(mname_sym, "destroy") {
            if args.len != 1_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, "SlotPool.destroy expects 1 argument, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            var i: usize = 0_usize;
            while i < args.len {
                let at = try self.check_expr_rvalue(arena, args[i], alloc_mut);
                try self.expect_assignable(at, alloc_mut, expr_span(arena, args[i]));
                i = i +% 1_usize;
            }
            return types.TY_VOID;
        }
        if self.sym_eq(mname_sym, "drain") {
            let ps: [1]types.TyId = [elem_ty];
            let cb_ty = try self.env.intern_fn_ptr(self.alloc, ps[0_usize..1_usize], types.TY_VOID);
            var i: usize = 0_usize;
            while i < args.len {
                let hint = if i +% 1_usize == args.len { cb_ty } else { types.TY_NONE };
                _ = try self.check_expr_rvalue(arena, args[i], hint);
                i = i +% 1_usize;
            }
            return types.TY_VOID;
        }
        return null;
    }

    @recursive
    fn try_builtin_method_buf(
        self: *mut Self,
        arena: *ast.AstArena,
        elem_ty: types.TyId,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if self.sym_eq(mname_sym, "push") {
            var i: usize = 0_usize;
            while i < args.len {
                _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                i = i +% 1_usize;
            }
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.OutOfMemory)];
            return try self.env.intern_error_union(self.alloc, types.TY_VOID, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "push_slice") {
            let exp_slice = try self.env.intern_borrow(self.alloc, false, .Slice, elem_ty);
            if args.len != 1_usize && args.len != 2_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, "Buf.push_slice() expects 1 slice argument, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            } else {
                let s_idx = args.len - 1_usize;
                if args.len == 2_usize {
                    _ = try self.check_expr_rvalue(arena, args[0_usize], types.TY_NONE);
                }
                let st = try self.check_expr_rvalue(arena, args[s_idx], exp_slice);
                try self.expect_assignable(st, exp_slice, expr_span(arena, args[s_idx]));
            }
            let errs: [1]types.ErrorSource = [types.err_src_builtin(.OutOfMemory)];
            return try self.env.intern_error_union(self.alloc, types.TY_VOID, errs[0_usize..1_usize]);
        }
        if self.sym_eq(mname_sym, "len") || self.sym_eq(mname_sym, "cap") {
            return types.TY_USIZE;
        }
        if self.sym_eq(mname_sym, "clear") { return types.TY_VOID; }
        if self.sym_eq(mname_sym, "as_slice") {
            return try self.env.intern_borrow(self.alloc, false, .Slice, elem_ty);
        }
        if self.sym_eq(mname_sym, "as_mut_slice") {
            return try self.env.intern_borrow(self.alloc, true, .Slice, elem_ty);
        }
        if self.sym_eq(mname_sym, "at") { return try self.check_slice_at_call(arena, args, elem_ty, false, sp); }
        if self.sym_eq(mname_sym, "at_mut") { return try self.check_slice_at_call(arena, args, elem_ty, true, sp); }
        if self.sym_eq(mname_sym, "get") { return try self.check_slice_get_call(arena, args, elem_ty, false, sp); }
        if self.sym_eq(mname_sym, "get_mut") { return try self.check_slice_get_call(arena, args, elem_ty, true, sp); }
        if self.sym_eq(mname_sym, "sub") { return try self.check_slice_sub_call(arena, args, elem_ty, false, sp); }
        if self.sym_eq(mname_sym, "sub_mut") { return try self.check_slice_sub_call(arena, args, elem_ty, true, sp); }
        if self.sym_eq(mname_sym, "pop") { return try self.env.intern_optional(self.alloc, elem_ty); }
        if self.sym_eq(mname_sym, "destroy") {
            var i: usize = 0_usize;
            while i < args.len {
                _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                i = i +% 1_usize;
            }
            return types.TY_VOID;
        }
        if self.sym_eq(mname_sym, "drain") {
            let ps: [1]types.TyId = [elem_ty];
            let cb_ty = try self.env.intern_fn_ptr(self.alloc, ps[0_usize..1_usize], types.TY_VOID);
            var i: usize = 0_usize;
            while i < args.len {
                let hint = if i +% 1_usize == args.len { cb_ty } else { types.TY_NONE };
                _ = try self.check_expr_rvalue(arena, args[i], hint);
                i = i +% 1_usize;
            }
            return types.TY_VOID;
        }
        return null;
    }

    @recursive
    fn try_builtin_method_buf_atomic_mmio(
        self: *mut Self,
        arena: *ast.AstArena,
        bk: resolve.BuiltinKind,
        gargs: *[types.GenericVal],
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        let elem_ty = if gargs.len > 0_usize && gargs[0_usize].kind == .Ty {
            gargs[0_usize].id
        } else {
            types.TY_ERROR
        };
        if bk == .LinearBuf || bk == .Buf {
            return try self.try_builtin_method_buf(arena, elem_ty, mname_sym, args, sp);
        }
        if bk == .Atomic {
            if self.sym_eq(mname_sym, "load") {
                if args.len != 1_usize {
                    try self.emit_err(diag.E0230, sp, "Atomic.load expects 1 Ordering argument");
                } else {
                    let ot = try self.check_expr_rvalue(arena, args[0_usize], types.TY_ORDERING);
                    try self.expect_assignable(ot, types.TY_ORDERING, expr_span(arena, args[0_usize]));
                }
                return elem_ty;
            }
            if self.sym_eq(mname_sym, "store") {
                if args.len != 2_usize {
                    try self.emit_err(diag.E0230, sp, "Atomic.store expects (val, Ordering)");
                } else {
                    let vt = try self.check_expr_rvalue(arena, args[0_usize], elem_ty);
                    try self.expect_assignable(vt, elem_ty, expr_span(arena, args[0_usize]));
                    let ot = try self.check_expr_rvalue(arena, args[1_usize], types.TY_ORDERING);
                    try self.expect_assignable(ot, types.TY_ORDERING, expr_span(arena, args[1_usize]));
                }
                return types.TY_VOID;
            }
            if self.sym_eq(mname_sym, "fetch_add")
                || self.sym_eq(mname_sym, "fetch_sub")
                || self.sym_eq(mname_sym, "swap")
            {
                if args.len != 2_usize {
                    try self.emit_err_sym2(diag.E0230, sp, "Atomic.", mname_sym, " expects (val, Ordering)");
                } else {
                    let vt = try self.check_expr_rvalue(arena, args[0_usize], elem_ty);
                    try self.expect_assignable(vt, elem_ty, expr_span(arena, args[0_usize]));
                    let ot = try self.check_expr_rvalue(arena, args[1_usize], types.TY_ORDERING);
                    try self.expect_assignable(ot, types.TY_ORDERING, expr_span(arena, args[1_usize]));
                }
                return elem_ty;
            }
            if self.sym_eq(mname_sym, "compare_exchange") {
                if args.len != 4_usize {
                    try self.emit_err(
                        diag.E0230, sp, "Atomic.compare_exchange expects (expected, desired, succ_ord, fail_ord)",
                    );
                } else {
                    let e_ty = try self.check_expr_rvalue(arena, args[0_usize], elem_ty);
                    try self.expect_assignable(e_ty, elem_ty, expr_span(arena, args[0_usize]));
                    let d_ty = try self.check_expr_rvalue(arena, args[1_usize], elem_ty);
                    try self.expect_assignable(d_ty, elem_ty, expr_span(arena, args[1_usize]));
                    let s_ty = try self.check_expr_rvalue(arena, args[2_usize], types.TY_ORDERING);
                    try self.expect_assignable(s_ty, types.TY_ORDERING, expr_span(arena, args[2_usize]));
                    let f_ty = try self.check_expr_rvalue(arena, args[3_usize], types.TY_ORDERING);
                    try self.expect_assignable(f_ty, types.TY_ORDERING, expr_span(arena, args[3_usize]));
                }
                return types.TY_BOOL;
            }
            return null;
        }
        if bk == .MmioReg {
            var is_write_only = false;
            var is_read_only = false;
            if gargs.len >= 2_usize && gargs[1_usize].kind == .Variant {
                is_write_only = self.sym_eq(gargs[1_usize].id, "WriteOnly");
                is_read_only = self.sym_eq(gargs[1_usize].id, "ReadOnly");
            }
            if self.sym_eq(mname_sym, "read") {
                if is_write_only {
                    try self.emit_err(diag.E0805, sp, "cannot `.read()` from a `.WriteOnly` MmioReg");
                }
                if args.len > 0_usize {
                    try self.emit_err(diag.E0230, sp, "MmioReg.read takes 0 arguments");
                }
                return elem_ty;
            }
            if self.sym_eq(mname_sym, "write") {
                if is_read_only {
                    try self.emit_err(diag.E0805, sp, "cannot `.write()` to a `.ReadOnly` MmioReg");
                }
                if args.len != 1_usize {
                    try self.emit_err(diag.E0230, sp, "MmioReg.write expects 1 value argument");
                } else {
                    let vt = try self.check_expr_rvalue(arena, args[0_usize], elem_ty);
                    try self.expect_assignable(vt, elem_ty, expr_span(arena, args[0_usize]));
                }
                return types.TY_VOID;
            }
        }
        return null;
    }

    @recursive
    fn try_builtin_method_on_builtin(
        self: *mut Self,
        arena: *ast.AstArena,
        recv_id: u32,
        rty: types.TyId,
        dn: *types.TyNode,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if dn.builtin_kind == .FsCap {
            return try self.try_builtin_method_fscap(arena, mname_sym, args, sp);
        }
        if dn.builtin_kind == .DirCap || dn.builtin_kind == .BuildCap {
            return try self.try_builtin_method_dircap_buildcap(arena, rty, dn.builtin_kind, mname_sym, args, sp);
        }
        if dn.builtin_kind == .Arena
            || dn.builtin_kind == .AllocCap
            || dn.builtin_kind == .ClockCap
            || dn.builtin_kind == .ArgsCap
            || dn.builtin_kind == .NetCap
            || dn.builtin_kind == .IoCap
            || dn.builtin_kind == .Schedule
        {
            return try self.try_builtin_method_arena_and_caps(arena, dn.builtin_kind, mname_sym, args, sp);
        }
        if dn.builtin_kind == .ArenaPool
            || dn.builtin_kind == .SlotPool
            || dn.builtin_kind == .LinearBuf
            || dn.builtin_kind == .Buf
            || dn.builtin_kind == .Atomic
            || dn.builtin_kind == .MmioReg
        {
            var gbuf = try col.DynBuf.[types.GenericVal].init(
                self.alloc, dn.list_len.widen.[usize]() +% 1_usize,
            );
            errdefer gbuf.destroy(self.alloc);
            try gbuf.push_slice(self.alloc, self.env.node_gval_list(dn));
            let res = if dn.builtin_kind == .ArenaPool || dn.builtin_kind == .SlotPool {
                try self.try_builtin_method_pools(
                    arena,
                    recv_id, rty, dn.builtin_kind, gbuf.as_slice(), mname_sym, args, sp,
                )
            } else {
                try self.try_builtin_method_buf_atomic_mmio(
                    arena,
                    dn.builtin_kind, gbuf.as_slice(), mname_sym, args, sp,
                )
            };
            gbuf.destroy(self.alloc);
            return res;
        }
        return null;
    }

    @recursive
    fn try_builtin_method_call(
        self: *mut Self,
        arena: *ast.AstArena,
        recv_id: u32,
        rty: types.TyId,
        mname_sym: u32,
        args: *[u32],
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        let rn = self.env.get(rty);
        let deref = if rn.kind == .Borrow && rn.borrow_kind == .Single {
            rn.primary
        } else {
            rty
        };
        let dn = self.env.get(deref);

        if self.env.is_address(deref) && self.sym_eq(mname_sym, "as_u64") && args.len == 0_usize {
            return types.TY_U64;
        }
        if (dn.kind == .Str || (dn.kind == .Borrow && dn.borrow_kind == .Str))
            && self.sym_eq(mname_sym, "as_bytes")
            && args.len == 0_usize
        {
            return try self.env.intern_borrow(self.alloc, false, .Slice, types.TY_U8);
        }
        if is_mut_builtin_method_name(self.interner.get(mname_sym))
            && dn.kind == .Builtin
            && (dn.builtin_kind == .Arena
                || dn.builtin_kind == .ArenaPool
                || dn.builtin_kind == .SlotPool
                || dn.builtin_kind == .LinearBuf
                || dn.builtin_kind == .Buf)
            && !(rn.kind == .Borrow && rn.flag0)
        {
            try self.check_place_mutability(arena, recv_id, expr_span(arena, recv_id));
        }

        if rn.kind == .Borrow && rn.borrow_kind == .Slice {
            if let res = try self.try_builtin_method_slice(arena, rty, rn.flag0, rn.primary, mname_sym, args, sp) {
                return res;
            }
        } else if rn.kind == .Borrow && rn.borrow_kind == .Str && self.sym_eq(mname_sym, "len") {
            if args.len > 0_usize {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, ".len() takes 0 arguments, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            return types.TY_USIZE;
        }

        match dn.kind {
            .Str => {
                if self.sym_eq(mname_sym, "len") {
                    if args.len > 0_usize {
                        var msg = try str.StrBuf.init(self.alloc, 64_usize);
                        errdefer msg.destroy(self.alloc);
                        try msg.push_str_grow(self.alloc, ".len() takes 0 arguments, found ");
                        try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                        try self.emit_err_buf(diag.E0230, sp, &msg);
                        msg.destroy(self.alloc);
                    }
                    return types.TY_USIZE;
                }
            }
            .Array => {
                return try self.try_builtin_method_array(arena, recv_id, rty, dn.primary, mname_sym, args, sp);
            }
            .Vec => {
                return try self.try_builtin_method_vec(arena, deref, dn.primary, dn.u8_val, mname_sym, args, sp);
            }
            .FnPtr => {
                if self.sym_eq(mname_sym, "before") || self.sym_eq(mname_sym, "after") {
                    if args.len != 1_usize {
                        try self.emit_err_sym2(diag.E0230, sp, "sys.", mname_sym, "(other) expects 1 sys argument");
                    } else {
                        _ = try self.check_expr_rvalue(arena, args[0_usize], types.TY_NONE);
                    }
                    return deref;
                }
            }
            .RawPtr => {
                if self.sym_eq(mname_sym, "as_usize") && args.len == 0_usize {
                    return types.TY_USIZE;
                }
            }
            .PhysAddr => {
                if self.sym_eq(mname_sym, "as_usize") && args.len == 0_usize {
                    return types.TY_USIZE;
                }
            }
            .VirtAddr => {
                if self.sym_eq(mname_sym, "as_usize") && args.len == 0_usize {
                    return types.TY_USIZE;
                }
            }
            .DmaAddr => {
                if self.sym_eq(mname_sym, "as_usize") && args.len == 0_usize {
                    return types.TY_USIZE;
                }
            }
            .Builtin => {
                return try self.try_builtin_method_on_builtin(arena, recv_id, rty, &dn, mname_sym, args, sp);
            }
            _ => {}
        }
        return null;
    }

    @recursive
    fn check_builtin_assoc_call(
        self: *mut Self,
        arena: *ast.AstArena,
        builtin_id: u32,
        type_gargs_range: ast.IdRange,
        field: ast.IdentSpan,
        args: *[u32],
        _expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let binfo = resolve.decode_builtin(builtin_id);
        let type_gargs = arena.generic_args_range(type_gargs_range);

        if self.sym_eq(field.sym, "build") && binfo.kind == .Schedule {
            var i: usize = 0_usize;
            while i < args.len {
                _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                i = i +% 1_usize;
            }
            return try self.env.intern_builtin_empty(self.alloc, .Schedule);
        }
        if self.sym_eq(field.sym, "new") && binfo.kind == .Atomic {
            var gvals = try col.DynBuf.[types.GenericVal].init(self.alloc, type_gargs.len +% 1_usize);
            errdefer gvals.destroy(self.alloc);
            var i: usize = 0_usize;
            while i < type_gargs.len {
                try gvals.push(self.alloc, try self.eval_generic_arg(arena, &type_gargs[i]));
                i = i +% 1_usize;
            }
            let gs = gvals.as_slice();
            let elem_ty = if gs.len > 0_usize && gs[0_usize].kind == .Ty { gs[0_usize].id } else { types.TY_ERROR };
            if args.len != 1_usize {
                try self.emit_err(diag.E0230, sp, "Atomic.new expects 1 initial value argument");
            } else {
                let vt = try self.check_expr_rvalue(arena, args[0_usize], elem_ty);
                try self.expect_assignable(vt, elem_ty, expr_span(arena, args[0_usize]));
            }
            let res = try self.env.intern_builtin(self.alloc, .Atomic, gvals.as_slice());
            gvals.destroy(self.alloc);
            return res;
        }
        if self.sym_eq(field.sym, "from_usize") {
            var i: usize = 0_usize;
            while i < args.len {
                let at = try self.check_expr_rvalue(arena, args[i], types.TY_USIZE);
                try self.expect_assignable(at, types.TY_USIZE, expr_span(arena, args[i]));
                i = i +% 1_usize;
            }
            if binfo.kind == .RawPtr {
                var inner = types.TY_VOID;
                if type_gargs.len > 0_usize {
                    let gv = try self.eval_generic_arg(arena, &type_gargs[0_usize]);
                    if gv.kind == .Ty {
                        inner = gv.id;
                    }
                }
                return try self.env.intern_raw_ptr(self.alloc, binfo.is_mut, inner);
            }
            if binfo.kind == .Prim {
                if binfo.prim == .PhysAddr { return types.TY_PHYS_ADDR; }
                if binfo.prim == .VirtAddr { return types.TY_VIRT_ADDR; }
                if binfo.prim == .DmaAddr { return types.TY_DMA_ADDR; }
            }
        }
        if self.sym_eq(field.sym, "splat") {
            var has_vec = false;
            var el = types.TY_ERROR;
            var vty = types.TY_ERROR;
            if binfo.kind == .SimdAlias {
                el = try types.prim_to_ty_id_in_env(self.alloc, binfo.prim, binfo.prim_bits, self.env);
                vty = try self.env.intern_vec(self.alloc, el, binfo.lanes);
                has_vec = true;
            } else if binfo.kind == .VecType && type_gargs.len >= 2_usize {
                let g0 = try self.eval_generic_arg(arena, &type_gargs[0_usize]);
                let g1 = try self.eval_generic_arg(arena, &type_gargs[1_usize]);
                if g0.kind == .Ty && g1.kind == .Int {
                    if let n64 = types.int_val_to_u64(g1.int_val) {
                        if n64 >= 2_u64 && n64 <= 64_u64 && is_pow2_u64(n64) {
                            el = g0.id;
                            vty = try self.env.intern_vec(self.alloc, el, n64.trunc.[u8]());
                            has_vec = true;
                        }
                    }
                }
            }
            if has_vec {
                if args.len != 1_usize {
                    try self.emit_err(diag.E0230, sp, "vec.splat expects 1 scalar argument");
                } else {
                    let vt = try self.check_expr_rvalue(arena, args[0_usize], el);
                    try self.expect_assignable(vt, el, expr_span(arena, args[0_usize]));
                }
                return vty;
            }
        }
        if self.sym_eq(field.sym, "init") {
            var i: usize = 0_usize;
            while i < args.len {
                _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                i = i +% 1_usize;
            }
            var gvals = try col.DynBuf.[types.GenericVal].init(self.alloc, type_gargs.len +% 1_usize);
            errdefer gvals.destroy(self.alloc);
            var gi: usize = 0_usize;
            while gi < type_gargs.len {
                try gvals.push(self.alloc, try self.eval_generic_arg(arena, &type_gargs[gi]));
                gi = gi +% 1_usize;
            }
            let err_kind: types.BuiltinErrorKind = if binfo.kind == .Arena || binfo.kind == .ArenaPool {
                .MemError
            } else {
                .OutOfMemory
            };
            let ok = try self.env.intern_builtin(self.alloc, binfo.kind, gvals.as_slice());
            let errs: [1]types.ErrorSource = [types.err_src_builtin(err_kind)];
            let res = try self.env.intern_error_union(self.alloc, ok, errs[0_usize..1_usize]);
            gvals.destroy(self.alloc);
            return res;
        }
        var k: usize = 0_usize;
        while k < args.len {
            _ = try self.check_expr_rvalue(arena, args[k], types.TY_NONE);
            k = k +% 1_usize;
        }
        return types.TY_ERROR;
    }
}

// ===========================================================================
// Section 8B: Call Resolution, Generic Unification, and Method Dispatch
// ===========================================================================

struct FoundMethod {
    impl_idx: u32;
    sub_idx: u32;
    sig: types.FnSig;
}

struct ParamArgSym {
    formal: u32;
    has_actual: bool;
    actual: u32;
}

impl Checker {
    fn find_type_method_with_key(
        self: *Self,
        target: types.MethodTarget,
        name: u32,
    ) -> ?FoundMethod {
        let ims = self.env.decls.impls.as_slice();
        var ii: usize = 0_usize;
        while ii < ims.len {
            let im = ims[ii];
            if method_target_eq(im.target, target) {
                let ms = self.env.impl_methods_range(im.methods);
                var mi: usize = 0_usize;
                while mi < ms.len {
                    if ms[mi].sig.name == name {
                        return FoundMethod.{
                            impl_idx: ii.trunc.[u32](),
                            sub_idx: ms[mi].sub_idx,
                            sig: ms[mi].sig,
                        };
                    }
                    mi = mi +% 1_usize;
                }
            }
            ii = ii +% 1_usize;
        }
        return null;
    }

    fn type_implements_iface(self: *Self, ty: types.TyId, iface_def: u32) -> bool {
        let n = self.env.get(ty);
        var has_tk = false;
        var tk = types.MethodTarget.{ kind: .Def, def_id: 0_u32, builtin: .Prim };
        match n.kind {
            .Struct => { has_tk = true; tk = types.MethodTarget.{ kind: .Def, def_id: n.primary, builtin: .Prim }; }
            .Pool => { has_tk = true; tk = types.MethodTarget.{ kind: .Def, def_id: n.primary, builtin: .Prim }; }
            .Enum => { has_tk = true; tk = types.MethodTarget.{ kind: .Def, def_id: n.primary, builtin: .Prim }; }
            .Union => { has_tk = true; tk = types.MethodTarget.{ kind: .Def, def_id: n.primary, builtin: .Prim }; }
            .Bitfield => { has_tk = true; tk = types.MethodTarget.{ kind: .Def, def_id: n.primary, builtin: .Prim }; }
            .Builtin => { has_tk = true; tk = types.MethodTarget.{ kind: .Builtin, def_id: 0_u32, builtin: n.builtin_kind }; }
            _ => {}
        }
        if !has_tk {
            return false;
        }
        let ims = self.env.decls.impls.as_slice();
        var i: usize = 0_usize;
        while i < ims.len {
            if ims[i].has_iface && ims[i].iface_def == iface_def && method_target_eq(ims[i].target, tk) {
                return true;
            }
            i = i +% 1_usize;
        }
        return false;
    }

    fn type_supports_ord(self: *Self, ty: types.TyId) -> bool {
        if self.env.is_integer(ty) || self.env.is_float(ty) {
            return true;
        }
        let k = self.env.get(ty).kind;
        return k == .Bool || k == .Char || k == .Str || k == .Enum;
    }

    fn type_supports_eq(self: *Self, ty: types.TyId) -> bool {
        if self.type_supports_ord(ty) {
            return true;
        }
        let k = self.env.get(ty).kind;
        return k == .PhysAddr || k == .VirtAddr || k == .DmaAddr;
    }

    @recursive
    fn unify_generic_arg(
        self: *Self,
        pattern: types.TyId,
        actual: types.TyId,
        gvals: *mut col.DynBuf[types.GenericVal],
    ) -> !OutOfMemory {
        if actual == types.TY_ERROR
            || actual == types.TY_COMPTIME_INT
            || actual == types.TY_COMPTIME_FLOAT
        {
            return;
        }
        let pn = self.env.get(pattern);
        if pn.kind == .GenericParam && !pn.flag0 {
            let idx = pn.primary.widen.[usize]();
            while gvals.len() <= idx {
                try gvals.push(self.alloc, types.gval_ty(types.TY_ERROR));
            }
            let gs = gvals.as_mut_slice();
            if idx < gs.len && gs[idx].kind == .Ty && gs[idx].id == types.TY_ERROR {
                gs[idx] = types.gval_ty(actual);
            }
            return;
        }
        let an = self.env.get(actual);
        if pn.kind == .Borrow && an.kind == .Borrow {
            if (pn.borrow_kind == .Single && an.borrow_kind == .Single)
                || (pn.borrow_kind == .Slice && an.borrow_kind == .Slice)
            {
                try self.unify_generic_arg(pn.primary, an.primary, gvals);
            }
            return;
        }
        if pn.kind == .Optional && an.kind == .Optional {
            try self.unify_generic_arg(pn.primary, an.primary, gvals);
        }
        return;
    }

    @recursive
    fn check_union_ctor_call(
        self: *mut Self,
        arena: *ast.AstArena,
        v: ast.IdentSpan,
        callee_sp: span.Span,
        args: *[u32],
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        var union_target = types.TY_NONE;
        if expected != types.TY_NONE {
            let en = self.env.get(expected);
            if en.kind == .Union {
                union_target = expected;
            } else if en.kind == .Optional && self.env.get(en.primary).kind == .Union {
                union_target = en.primary;
            } else if en.kind == .ErrorUnion {
                let okn = self.env.get(en.primary);
                if okn.kind == .Union {
                    union_target = en.primary;
                } else if okn.kind == .Optional && self.env.get(okn.primary).kind == .Union {
                    union_target = okn.primary;
                }
            }
        }
        if union_target != types.TY_NONE {
            let un = self.env.get(union_target);
            var uargs = try col.DynBuf.[types.GenericVal].init(
                self.alloc, un.list_len.widen.[usize]() +% 1_usize,
            );
            errdefer uargs.destroy(self.alloc);
            try uargs.push_slice(self.alloc, self.env.node_gval_list(&un));
            var found = false;
            var has_payload = false;
            var raw_pt = types.TY_ERROR;
            if let um = self.env.get_union(un.primary) {
                let vs = self.env.union_variants_range(um.variants);
                var vi: usize = 0_usize;
                while vi < vs.len {
                    if vs[vi].name == v.sym {
                        found = true;
                        has_payload = vs[vi].has_payload;
                        raw_pt = vs[vi].payload;
                        break;
                    }
                    vi = vi +% 1_usize;
                }
            }
            if found && has_payload {
                let pty = try subst_ty(self.alloc, self.env, raw_pt, uargs.as_slice());
                if args.len != 1_usize {
                    try self.emit_err_sym2(
                        diag.E0230, sp, "variant `.", v.sym, "` expects 1 payload argument",
                    );
                } else {
                    let got = try self.check_expr_rvalue(arena, args[0_usize], pty);
                    try self.expect_assignable(got, pty, expr_span(arena, args[0_usize]));
                }
                uargs.destroy(self.alloc);
                return union_target;
            }
            if found {
                try self.emit_err_sym2(
                    diag.E0230, sp, "variant `.", v.sym, "` takes no payload arguments",
                );
                uargs.destroy(self.alloc);
                return union_target;
            }
            try self.emit_err_sym2(diag.E0132, v.span, "unknown union variant `.", v.sym, "`");
            uargs.destroy(self.alloc);
            return types.TY_ERROR;
        }
        var i: usize = 0_usize;
        while i < args.len {
            _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
            i = i +% 1_usize;
        }
        try self.emit_err_sym2(
            diag.E0230, callee_sp, "`.", v.sym, "` requires an expected union type",
        );
        return types.TY_ERROR;
    }

    @recursive
    fn check_generic_param_method_call(
        self: *mut Self,
        arena: *ast.AstArena,
        call_expr_id: u32,
        rty: types.TyId,
        deref_ty: types.TyId,
        gp_idx: u32,
        mfield: ast.IdentSpan,
        args: *[u32],
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let gidx = gp_idx.widen.[usize]();
        var has_gmeta = false;
        var gmeta = types.GenericParamMeta.{
            name: span.SYM_EMPTY,
            is_comptime: false,
            has_comptime_ty: false,
            comptime_ty: types.TY_ERROR,
            bounds: ast.range_empty(),
            builtin_ord: false,
            builtin_eq: false,
        };
        let gps = self.env.generic_params_range(self.sig.generics);
        if gidx < gps.len {
            gmeta = gps[gidx];
            has_gmeta = true;
        }
        if has_gmeta {
            if gmeta.builtin_ord && self.sym_eq(mfield.sym, "cmp") {
                if args.len != 1_usize {
                    try self.emit_err(diag.E0230, sp, "`.cmp(&other)` expects 1 argument");
                } else {
                    let exp_other = try self.env.intern_borrow(self.alloc, false, .Single, deref_ty);
                    let at = try self.check_expr_rvalue(arena, args[0_usize], exp_other);
                    try self.expect_assignable(at, exp_other, expr_span(arena, args[0_usize]));
                }
                return types.TY_ORDERING;
            }
            if gmeta.builtin_eq && self.sym_eq(mfield.sym, "eq") {
                if args.len != 1_usize {
                    try self.emit_err(diag.E0230, sp, "`.eq(&other)` expects 1 argument");
                } else {
                    let exp_other = try self.env.intern_borrow(self.alloc, false, .Single, deref_ty);
                    let at = try self.check_expr_rvalue(arena, args[0_usize], exp_other);
                    try self.expect_assignable(at, exp_other, expr_span(arena, args[0_usize]));
                }
                return types.TY_BOOL;
            }
            let bcnt = gmeta.bounds.len.widen.[usize]();
            var bi: usize = 0_usize;
            while bi < bcnt {
                var iface_def: u32 = 0_u32;
                let bs = self.env.generic_bounds_range(gmeta.bounds);
                if bi < bs.len {
                    iface_def = bs[bi];
                }
                var found_m = false;
                var msig = self.sig;
                if let im = self.env.get_iface(iface_def) {
                    let ms = self.env.iface_methods_range(im.methods);
                    var mi: usize = 0_usize;
                    while mi < ms.len {
                        if ms[mi].name == mfield.sym {
                            found_m = true;
                            msig = ms[mi];
                            break;
                        }
                        mi = mi +% 1_usize;
                    }
                }
                if found_m {
                    let dyn_self = try self.env.intern_dyn(self.alloc, iface_def);
                    let empty_g: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
                    return try self.check_fn_sig_call_inner(
                        arena,
                        call_expr_id,
                        &msig,
                        false,
                        .TopDef,
                        0_u32,
                        0_u32,
                        rty,
                        empty_g[0_usize..0_usize],
                        args,
                        dyn_self,
                        deref_ty,
                        sp,
                    );
                }
                bi = bi +% 1_usize;
            }
        }
        try self.emit_err_ty_sym(
            diag.E0501,
            mfield.span,
            "generic type `",
            deref_ty,
            "` has no interface bound providing method `",
            mfield.sym,
            "` (definition-site check)",
        );
        var i: usize = 0_usize;
        while i < args.len {
            _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
            i = i +% 1_usize;
        }
        return types.TY_ERROR;
    }

    @recursive
    fn check_dyn_method_call(
        self: *mut Self,
        arena: *ast.AstArena,
        call_expr_id: u32,
        rty: types.TyId,
        r_is_mut: bool,
        deref_ty: types.TyId,
        iface_def: u32,
        mfield: ast.IdentSpan,
        args: *[u32],
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        var found_m = false;
        var midx: u32 = 0_u32;
        var msig = self.sig;
        if let im = self.env.get_iface(iface_def) {
            let ms = self.env.iface_methods_range(im.methods);
            var mi: usize = 0_usize;
            while mi < ms.len {
                if ms[mi].name == mfield.sym {
                    found_m = true;
                    midx = mi.trunc.[u32]();
                    msig = ms[mi];
                    break;
                }
                mi = mi +% 1_usize;
            }
        }
        if found_m {
            var needs_mut = false;
            let ps = self.env.params_range(msig.params);
            if ps.len > 0_usize && ps[0_usize].is_self {
                let pn = self.env.get(ps[0_usize].ty);
                needs_mut = pn.kind == .Borrow && pn.flag0;
            }
            if needs_mut && !r_is_mut {
                try self.emit_err_sym2(
                    diag.E0230, mfield.span, "method `", mfield.sym, "` requires `*mut dyn` receiver",
                );
            }
            try self.table.set_dyn_call(self.alloc, call_expr_id, sp, iface_def, midx);
            let empty_g: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
            return try self.check_fn_sig_call_inner(
                arena,
                call_expr_id,
                &msig,
                false,
                .TopDef,
                0_u32,
                0_u32,
                rty,
                empty_g[0_usize..0_usize],
                args,
                types.TY_NONE,
                types.TY_NONE,
                sp,
            );
        }
        try self.emit_err_ty_sym(
            diag.E0132, mfield.span, "interface `", deref_ty, "` has no method `", mfield.sym, "`",
        );
        var i: usize = 0_usize;
        while i < args.len {
            _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
            i = i +% 1_usize;
        }
        return types.TY_ERROR;
    }

    @recursive
    fn check_method_call_on_recv(
        self: *mut Self,
        arena: *ast.AstArena,
        call_expr_id: u32,
        recv_id: u32,
        mfield: ast.IdentSpan,
        method_gargs_range: ast.IdRange,
        args: *[u32],
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let rty = try self.check_expr(arena, recv_id, types.TY_NONE);
        if rty == types.TY_ERROR {
            var i: usize = 0_usize;
            while i < args.len {
                _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                i = i +% 1_usize;
            }
            return types.TY_ERROR;
        }
        if let bret = try self.try_builtin_method_call(arena, recv_id, rty, mfield.sym, args, sp) {
            return bret;
        }
        let rn = self.env.get(rty);
        let deref_ty = if rn.kind == .Borrow && rn.borrow_kind == .Single {
            rn.primary
        } else {
            rty
        };
        let dn = self.env.get(deref_ty);
        if dn.kind == .Dyn {
            let r_is_mut = rn.kind == .Borrow && rn.flag0;
            return try self.check_dyn_method_call(
                arena, call_expr_id, rty, r_is_mut, deref_ty, dn.primary, mfield, args, sp,
            );
        }
        if dn.kind == .GenericParam {
            return try self.check_generic_param_method_call(
                arena,
                call_expr_id, rty, deref_ty, dn.primary, mfield, args, sp,
            );
        }
        var has_tk = false;
        var tk = types.MethodTarget.{ kind: .Def, def_id: 0_u32, builtin: .Prim };
        match dn.kind {
            .Struct => { has_tk = true; tk = types.MethodTarget.{ kind: .Def, def_id: dn.primary, builtin: .Prim }; }
            .Pool => { has_tk = true; tk = types.MethodTarget.{ kind: .Def, def_id: dn.primary, builtin: .Prim }; }
            .Enum => { has_tk = true; tk = types.MethodTarget.{ kind: .Def, def_id: dn.primary, builtin: .Prim }; }
            .Union => { has_tk = true; tk = types.MethodTarget.{ kind: .Def, def_id: dn.primary, builtin: .Prim }; }
            .Bitfield => { has_tk = true; tk = types.MethodTarget.{ kind: .Def, def_id: dn.primary, builtin: .Prim }; }
            .Builtin => { has_tk = true; tk = types.MethodTarget.{ kind: .Builtin, def_id: 0_u32, builtin: dn.builtin_kind }; }
            _ => {}
        }
        if has_tk {
            if let fm = self.find_type_method_with_key(tk, mfield.sym) {
                var needs_mut = false;
                let ps = self.env.params_range(fm.sig.params);
                if ps.len > 0_usize && ps[0_usize].is_self {
                    let pn = self.env.get(ps[0_usize].ty);
                    needs_mut = pn.kind == .Borrow && pn.flag0;
                }
                if needs_mut && !(rn.kind == .Borrow && rn.flag0) {
                    try self.check_place_mutability(arena, recv_id, expr_span(arena, recv_id));
                }
                var gvals = try col.DynBuf.[types.GenericVal].init(self.alloc, 8_usize);
                errdefer gvals.destroy(self.alloc);
                if dn.kind == .Struct || dn.kind == .Union || dn.kind == .Pool {
                    try gvals.push_slice(self.alloc, self.env.node_gval_list(&dn));
                }
                let mga = arena.generic_args_range(method_gargs_range);
                var gi: usize = 0_usize;
                while gi < mga.len {
                    try gvals.push(self.alloc, try self.eval_generic_arg(arena, &mga[gi]));
                    gi = gi +% 1_usize;
                }
                let res = try self.check_fn_sig_call_inner(
                    arena,
                    call_expr_id,
                    &fm.sig,
                    true,
                    .ImplMethod,
                    fm.impl_idx,
                    fm.sub_idx,
                    rty,
                    gvals.as_slice(),
                    args,
                    types.TY_NONE,
                    types.TY_NONE,
                    sp,
                );
                gvals.destroy(self.alloc);
                return res;
            }
        }
        try self.emit_err_ty_sym(
            diag.E0132, mfield.span, "type `", rty, "` has no method `", mfield.sym, "`",
        );
        var j: usize = 0_usize;
        while j < args.len {
            _ = try self.check_expr_rvalue(arena, args[j], types.TY_NONE);
            j = j +% 1_usize;
        }
        return types.TY_ERROR;
    }

    @recursive
    fn try_check_generic_assoc_call(
        self: *mut Self,
        arena: *ast.AstArena,
        call_expr_id: u32,
        re_a: u32,
        re_list: ast.IdRange,
        field: ast.IdentSpan,
        args: *[u32],
        expected: types.TyId,
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        var tsegs = try col.DynBuf.[ast.IdentSpan].init(self.alloc, 4_usize);
        errdefer tsegs.destroy(self.alloc);
        if try self.extract_path_idents(arena, re_a, &mut tsegs) {
            let ts = tsegs.as_slice();
            if ts.len > 0_usize {
                if let _ = self.lookup_local(ts[0_usize].sym) {
                    // local variable
                } else if let target = try types.resolve_path_segments(
                    self.alloc, ts, self.mod_id, self.prog, self.interner, self.diags,
                ) {
                    let first_sym = ts[0_usize].sym;
                    if target.kind == .Builtin {
                        let res = try self.check_builtin_assoc_call(
                            arena,
                            target.target_id, re_list, field, args, expected, sp,
                        );
                        tsegs.destroy(self.alloc);
                        return res;
                    }
                    if target.kind == .Def {
                        let tk = types.MethodTarget.{
                            kind: .Def, def_id: target.target_id, builtin: .Prim,
                        };
                        if let fm = self.find_type_method_with_key(tk, field.sym) {
                            self.prog.mark_module_binding_used(self.mod_id, first_sym);
                            self.prog.mark_def_used(target.target_id);
                            let tga = arena.generic_args_range(re_list);
                            var gvals = try col.DynBuf.[types.GenericVal].init(
                                self.alloc, tga.len +% 1_usize,
                            );
                            errdefer gvals.destroy(self.alloc);
                            var gi: usize = 0_usize;
                            while gi < tga.len {
                                try gvals.push(self.alloc, try self.eval_generic_arg(arena, &tga[gi]));
                                gi = gi +% 1_usize;
                            }
                            let res = try self.check_fn_sig_call_inner(
                                arena,
                                call_expr_id,
                                &fm.sig,
                                true,
                                .ImplMethod,
                                fm.impl_idx,
                                fm.sub_idx,
                                types.TY_NONE,
                                gvals.as_slice(),
                                args,
                                types.TY_NONE,
                                types.TY_NONE,
                                sp,
                            );
                            gvals.destroy(self.alloc);
                            tsegs.destroy(self.alloc);
                            return res;
                        }
                    }
                    tsegs.destroy(self.alloc);
                    return null;
                }
            }
        }
        tsegs.destroy(self.alloc);
        return null;
    }

    @recursive
    fn try_check_field_assoc_call(
        self: *mut Self,
        arena: *ast.AstArena,
        call_expr_id: u32,
        callee_id: u32,
        r_id: u32,
        field: ast.IdentSpan,
        args: *[u32],
        expected: types.TyId,
        sp: span.Span,
    ) -> ?types.TyId ! OutOfMemory {
        if let re = arena.get_expr(r_id) {
            if re.kind == .GenericApply {
                if let gres = try self.try_check_generic_assoc_call(
                    arena, call_expr_id, re.a, re.list, field, args, expected, sp,
                ) {
                    return gres;
                }
            }
        }

        var csegs = try col.DynBuf.[ast.IdentSpan].init(self.alloc, 4_usize);
        errdefer csegs.destroy(self.alloc);
        if try self.extract_path_idents(arena, callee_id, &mut csegs) {
            let cs = csegs.as_slice();
            if cs.len > 0_usize {
                if let _ = self.lookup_local(cs[0_usize].sym) {
                    // local variable
                } else if let first_ent = self.prog.lookup_in_module(self.mod_id, cs[0_usize].sym) {
                    let first_sym = cs[0_usize].sym;
                    if first_ent.kind == .Module {
                        if cs.len >= 3_usize {
                            let parent_slice = cs.sub(0_usize, cs.len - 1_usize) catch cs;
                            if let pt = try types.resolve_path_segments(
                                self.alloc, parent_slice, self.mod_id, self.prog, self.interner, self.diags,
                            ) {
                                if pt.kind == .Def {
                                    let tk = types.MethodTarget.{
                                        kind: .Def, def_id: pt.target_id, builtin: .Prim,
                                    };
                                    if let fm = self.find_type_method_with_key(tk, field.sym) {
                                        self.prog.mark_module_binding_used(self.mod_id, first_sym);
                                        self.prog.mark_def_used(pt.target_id);
                                        let empty_g: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
                                        let res = try self.check_fn_sig_call_inner(
                                            arena,
                                            call_expr_id,
                                            &fm.sig,
                                            true,
                                            .ImplMethod,
                                            fm.impl_idx,
                                            fm.sub_idx,
                                            types.TY_NONE,
                                            empty_g[0_usize..0_usize],
                                            args,
                                            types.TY_NONE,
                                            types.TY_NONE,
                                            sp,
                                        );
                                        csegs.destroy(self.alloc);
                                        return res;
                                    }
                                } else if pt.kind == .Builtin {
                                    let res = try self.check_builtin_assoc_call(
                                        arena,
                                        pt.target_id, ast.range_empty(), field, args, expected, sp,
                                    );
                                    csegs.destroy(self.alloc);
                                    return res;
                                }
                            }
                        }
                        let res = try self.check_direct_fn_call(
                            arena,
                            call_expr_id, callee_id, ast.range_empty(), args, sp,
                        );
                        csegs.destroy(self.alloc);
                        return res;
                    } else if first_ent.kind == .Def && cs.len == 2_usize {
                        let tk = types.MethodTarget.{
                            kind: .Def, def_id: first_ent.target_id, builtin: .Prim,
                        };
                        if let fm = self.find_type_method_with_key(tk, field.sym) {
                            self.prog.mark_module_binding_used(self.mod_id, first_sym);
                            self.prog.mark_def_used(first_ent.target_id);
                            let empty_g: [1]types.GenericVal = [types.gval_ty(types.TY_VOID)];
                            let res = try self.check_fn_sig_call_inner(
                                arena,
                                call_expr_id,
                                &fm.sig,
                                true,
                                .ImplMethod,
                                fm.impl_idx,
                                fm.sub_idx,
                                types.TY_NONE,
                                empty_g[0_usize..0_usize],
                                args,
                                types.TY_NONE,
                                types.TY_NONE,
                                sp,
                            );
                            csegs.destroy(self.alloc);
                            return res;
                        }
                    } else if first_ent.kind == .Builtin && cs.len == 2_usize {
                        let res = try self.check_builtin_assoc_call(
                            arena,
                            first_ent.target_id, ast.range_empty(), field, args, expected, sp,
                        );
                        csegs.destroy(self.alloc);
                        return res;
                    }
                }
            }
        }
        csegs.destroy(self.alloc);
        return null;
    }

    @recursive
    fn check_call(
        self: *mut Self,
        arena: *ast.AstArena,
        call_expr_id: u32,
        callee_id: u32,
        args_range: ast.IdRange,
        expected: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let callee = arena.get_expr(callee_id) orelse { return types.TY_ERROR; };
        let args = arena.expr_list_range(args_range);

        // Case 0: Union variant constructor call `.Click(payload)`
        if callee.kind == .EnumLit {
            return try self.check_union_ctor_call(arena, callee.ident, callee.span, args, expected, sp);
        }

        // Case 1: Built-in generic conversion methods `.widen.[To]()`, `.trunc.[To]()`, etc.
        if callee.kind == .GenericApply {
            if let base = arena.get_expr(callee.a) {
                if base.kind == .Field && is_cast_method_name(self.interner.get(base.ident.sym)) {
                    return try self.check_cast_method(arena, base.ident.sym, base.a, callee.list, args, sp);
                }
            }
        }

        // Case 2: GenericApply / Field method or module/assoc call vs direct call
        if callee.kind == .GenericApply {
            if let base = arena.get_expr(callee.a) {
                if base.kind == .Field {
                    var segs = try col.DynBuf.[ast.IdentSpan].init(self.alloc, 4_usize);
                    errdefer segs.destroy(self.alloc);
                    var is_mod_path = false;
                    if try self.extract_path_idents(arena, callee.a, &mut segs) {
                        let ss = segs.as_slice();
                        if ss.len > 0_usize {
                            if let _ = self.lookup_local(ss[0_usize].sym) {
                                // local
                            } else if let ent = self.prog.lookup_in_module(self.mod_id, ss[0_usize].sym) {
                                if ent.kind == .Module {
                                    is_mod_path = true;
                                }
                            }
                        }
                    }
                    if is_mod_path {
                        let res = try self.check_direct_fn_call(arena, call_expr_id, callee.a, callee.list, args, sp);
                        segs.destroy(self.alloc);
                        return res;
                    }
                    let res = try self.check_method_call_on_recv(
                        arena,
                        call_expr_id, base.a, base.ident, callee.list, args, sp,
                    );
                    segs.destroy(self.alloc);
                    return res;
                }
            }
            return try self.check_direct_fn_call(arena, call_expr_id, callee.a, callee.list, args, sp);
        }
        if callee.kind == .Field {
            if let assoc_res = try self.try_check_field_assoc_call(
                arena,
                call_expr_id, callee_id, callee.a, callee.ident, args, expected, sp,
            ) {
                return assoc_res;
            }
            return try self.check_method_call_on_recv(
                arena,
                call_expr_id, callee.a, callee.ident, ast.range_empty(), args, sp,
            );
        }
        return try self.check_direct_fn_call(arena, call_expr_id, callee_id, ast.range_empty(), args, sp);
    }

    @recursive
    fn check_direct_fn_call(
        self: *mut Self,
        arena: *ast.AstArena,
        call_expr_id: u32,
        callee_id: u32,
        gargs_range: ast.IdRange,
        args: *[u32],
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        var segs = try col.DynBuf.[ast.IdentSpan].init(self.alloc, 4_usize);
        errdefer segs.destroy(self.alloc);
        if try self.extract_path_idents(arena, callee_id, &mut segs) {
            let ss = segs.as_slice();
            if ss.len > 0_usize {
                if let _ = self.lookup_local(ss[0_usize].sym) {
                    // local callable value
                } else {
                    let target_opt = try types.resolve_path_segments(
                        self.alloc, ss, self.mod_id, self.prog, self.interner, self.diags,
                    );
                    let target = target_opt orelse {
                        var i: usize = 0_usize;
                        while i < args.len {
                            _ = try self.check_expr_rvalue(arena, args[i], types.TY_NONE);
                            i = i +% 1_usize;
                        }
                        segs.destroy(self.alloc);
                        return types.TY_ERROR;
                    };
                    if target.kind == .Def {
                        var has_sig = false;
                        var sig = self.sig;
                        if let s = self.env.get_fn(target.target_id) {
                            has_sig = true;
                            sig = s.*;
                        }
                        if has_sig {
                            let ga = arena.generic_args_range(gargs_range);
                            var gvals = try col.DynBuf.[types.GenericVal].init(
                                self.alloc, ga.len +% 1_usize,
                            );
                            errdefer gvals.destroy(self.alloc);
                            var gi: usize = 0_usize;
                            while gi < ga.len {
                                try gvals.push(self.alloc, try self.eval_generic_arg(arena, &ga[gi]));
                                gi = gi +% 1_usize;
                            }
                            let res = try self.check_fn_sig_call_inner(
                                arena,
                                call_expr_id,
                                &sig,
                                true,
                                .TopDef,
                                target.target_id,
                                0_u32,
                                types.TY_NONE,
                                gvals.as_slice(),
                                args,
                                types.TY_NONE,
                                types.TY_NONE,
                                sp,
                            );
                            gvals.destroy(self.alloc);
                            segs.destroy(self.alloc);
                            return res;
                        }
                    }
                    // Fall through to indirect expression checking if target was not a fn def
                    let ind_res = try self.check_indirect_call(arena, callee_id, args, sp);
                    segs.destroy(self.alloc);
                    return ind_res;
                }
            }
        }
        let fallback_res = try self.check_indirect_call(arena, callee_id, args, sp);
        segs.destroy(self.alloc);
        return fallback_res;
    }

    @recursive
    fn check_indirect_call(
        self: *mut Self,
        arena: *ast.AstArena,
        callee_id: u32,
        args: *[u32],
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        let ct = try self.check_expr(arena, callee_id, types.TY_NONE);
        let cn = self.env.get(ct);
        if cn.kind == .FnPtr {
            var params = try col.DynBuf.[types.TyId].init(
                self.alloc, cn.list_len.widen.[usize]() +% 1_usize,
            );
            errdefer params.destroy(self.alloc);
            try params.push_slice(self.alloc, self.env.node_ty_list(&cn));
            let ret = cn.primary;
            let ps = params.as_slice();
            if args.len != ps.len {
                var msg = try str.StrBuf.init(self.alloc, 64_usize);
                errdefer msg.destroy(self.alloc);
                try msg.push_str_grow(self.alloc, "expected ");
                try msg.push_u64_grow(self.alloc, ps.len.widen.[u64]());
                try msg.push_str_grow(self.alloc, " arguments, found ");
                try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
                try self.emit_err_buf(diag.E0230, sp, &msg);
                msg.destroy(self.alloc);
            }
            var i: usize = 0_usize;
            while i < args.len {
                let exp = if i < ps.len { ps[i] } else { types.TY_NONE };
                let at = try self.check_expr_rvalue(arena, args[i], exp);
                if exp != types.TY_NONE {
                    try self.expect_assignable(at, exp, expr_span(arena, args[i]));
                }
                i = i +% 1_usize;
            }
            params.destroy(self.alloc);
            return ret;
        }
        if cn.kind != .Error {
            try self.emit_err_ty2(
                diag.E0230, expr_span(arena, callee_id), "cannot call value of type `", ct, "`",
            );
        }
        var j: usize = 0_usize;
        while j < args.len {
            _ = try self.check_expr_rvalue(arena, args[j], types.TY_NONE);
            j = j +% 1_usize;
        }
        return types.TY_ERROR;
    }

    fn check_call_generic_bounds(
        self: *mut Self,
        sig: *types.FnSig,
        inferred: *[types.GenericVal],
        sp: span.Span,
    ) -> !OutOfMemory {
        if sig.generics.len == 0_u32 || inferred.len == 0_usize {
            return;
        }
        let gcnt = sig.generics.len.widen.[usize]();
        var gi: usize = 0_usize;
        while gi < gcnt && gi < inferred.len {
            let gv = inferred[gi];
            if gv.kind == .Ty
                && gv.id != types.TY_ERROR
                && self.env.get(gv.id).kind != .GenericParam
            {
                let actual_ty = gv.id;
                var has_gm = false;
                var gm = types.GenericParamMeta.{
                    name: span.SYM_EMPTY,
                    is_comptime: false,
                    has_comptime_ty: false,
                    comptime_ty: types.TY_ERROR,
                    bounds: ast.range_empty(),
                    builtin_ord: false,
                    builtin_eq: false,
                };
                let gms = self.env.generic_params_range(sig.generics);
                if gi < gms.len {
                    gm = gms[gi];
                    has_gm = true;
                }
                if has_gm {
                    let bcnt = gm.bounds.len.widen.[usize]();
                    var bi: usize = 0_usize;
                    while bi < bcnt {
                        var iface_def: u32 = 0_u32;
                        let bs = self.env.generic_bounds_range(gm.bounds);
                        if bi < bs.len {
                            iface_def = bs[bi];
                        }
                        if !self.type_implements_iface(actual_ty, iface_def) {
                            var iname = span.SYM_EMPTY;
                            if let id = self.prog.get_def(iface_def) {
                                iname = id.name;
                            }
                            try self.emit_err_ty_sym(
                                diag.E0501,
                                sp,
                                "type `",
                                actual_ty,
                                "` does not implement required interface `",
                                iname,
                                "`",
                            );
                        }
                        bi = bi +% 1_usize;
                    }
                    if gm.builtin_ord && !self.type_supports_ord(actual_ty) {
                        try self.emit_err_ty2(
                            diag.E0501, sp, "type `", actual_ty, "` does not satisfy `Ord` bound",
                        );
                    }
                    if gm.builtin_eq && !self.type_supports_eq(actual_ty) {
                        try self.emit_err_ty2(
                            diag.E0501, sp, "type `", actual_ty, "` does not satisfy `Eq` bound",
                        );
                    }
                }
            }
            gi = gi +% 1_usize;
        }
        return;
    }

    fn remap_id_brand_param(
        self: *mut Self,
        ty: types.TyId,
        param_syms: *[ParamArgSym],
    ) -> types.TyId ! OutOfMemory {
        let tn = self.env.get(ty);
        if tn.kind == .Builtin && tn.builtin_kind == .IdBrand {
            let bargs = self.env.node_gval_list(&tn);
            if bargs.len > 0_usize && bargs[0_usize].kind == .Variant {
                let formal_p = bargs[0_usize].id;
                var pi: usize = 0_usize;
                while pi < param_syms.len {
                    if param_syms[pi].formal == formal_p && param_syms[pi].has_actual {
                        let ga: [1]types.GenericVal = [types.gval_variant(param_syms[pi].actual)];
                        return try self.env.intern_builtin(self.alloc, .IdBrand, ga[0_usize..1_usize]);
                    }
                    pi = pi +% 1_usize;
                }
            }
        }
        return ty;
    }

    @recursive
    fn check_fn_sig_call_inner(
        self: *mut Self,
        arena: *ast.AstArena,
        call_expr_id: u32,
        sig: *types.FnSig,
        has_fn_key: bool,
        fn_key_kind: CallFnKeyKind,
        fn_key_primary: u32,
        fn_key_secondary: u32,
        self_recv_ty: types.TyId,
        explicit_gargs: *[types.GenericVal],
        args: *[u32],
        replace_from: types.TyId,
        replace_to: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if has_fn_key {
            try self.table.set_call_target(
                self.alloc, call_expr_id, fn_key_kind, fn_key_primary, fn_key_secondary,
            );
        }
        var all_params = try col.DynBuf.[types.ParamSig].init(
            self.alloc, sig.params.len.widen.[usize]() +% 1_usize,
        );
        errdefer all_params.destroy(self.alloc);
        try all_params.push_slice(self.alloc, self.env.params_range(sig.params));
        let aps = all_params.as_slice();

        var param_start: usize = 0_usize;
        if self_recv_ty != types.TY_NONE && aps.len > 0_usize && aps[0_usize].is_self {
            var p0_ty = aps[0_usize].ty;
            if replace_from != types.TY_NONE {
                p0_ty = try replace_ty(self.alloc, self.env, p0_ty, replace_from, replace_to);
            }
            let p_ty = try subst_ty(self.alloc, self.env, p0_ty, explicit_gargs);
            try self.expect_self_compatible(self_recv_ty, p_ty, sp);
            param_start = 1_usize;
        }
        let exp_len = if aps.len >= param_start { aps.len -% param_start } else { 0_usize };
        if args.len != exp_len {
            var msg = try str.StrBuf.init(self.alloc, 80_usize);
            errdefer msg.destroy(self.alloc);
            try msg.push_str_grow(self.alloc, "function `");
            try msg.push_bytes_grow(self.alloc, self.interner.get(sig.name));
            try msg.push_str_grow(self.alloc, "` expects ");
            try msg.push_u64_grow(self.alloc, exp_len.widen.[u64]());
            try msg.push_str_grow(self.alloc, " arguments, found ");
            try msg.push_u64_grow(self.alloc, args.len.widen.[u64]());
            try self.emit_err_buf(diag.E0230, sp, &msg);
            msg.destroy(self.alloc);
        }

        var inferred = try col.DynBuf.[types.GenericVal].init(self.alloc, explicit_gargs.len +% 4_usize);
        errdefer inferred.destroy(self.alloc);
        try inferred.push_slice(self.alloc, explicit_gargs);
        var param_syms = try col.DynBuf.[ParamArgSym].init(self.alloc, args.len +% 1_usize);
        errdefer param_syms.destroy(self.alloc);

        var i: usize = 0_usize;
        while i < args.len {
            let pidx = param_start +% i;
            let has_p = pidx < aps.len;
            var raw_p_ty = types.TY_NONE;
            var is_mut_mod = false;
            if has_p {
                raw_p_ty = aps[pidx].ty;
                if replace_from != types.TY_NONE {
                    raw_p_ty = try replace_ty(self.alloc, self.env, raw_p_ty, replace_from, replace_to);
                }
                is_mut_mod = aps[pidx].modifier == .Mut;
            }
            var exp_ty = types.TY_NONE;
            if has_p {
                exp_ty = try subst_ty(self.alloc, self.env, raw_p_ty, inferred.as_slice());
                exp_ty = try self.remap_id_brand_param(exp_ty, param_syms.as_slice());
            }
            let arg_ty = if is_mut_mod {
                try self.check_place_mutability(arena, args[i], expr_span(arena, args[i]));
                try self.check_expr(arena, args[i], exp_ty)
            } else {
                try self.check_expr_rvalue(arena, args[i], exp_ty)
            };
            if has_p {
                let root_opt = extract_root_ident_sym(arena, args[i]);
                if let rsym = root_opt {
                    try param_syms.push(
                        self.alloc, ParamArgSym.{ formal: aps[pidx].name, has_actual: true, actual: rsym },
                    );
                } else {
                    try param_syms.push(
                        self.alloc, ParamArgSym.{ formal: aps[pidx].name, has_actual: false, actual: 0_u32 },
                    );
                }
                try self.unify_generic_arg(raw_p_ty, arg_ty, &mut inferred);
                var res_p_ty = try subst_ty(self.alloc, self.env, raw_p_ty, inferred.as_slice());
                res_p_ty = try self.remap_id_brand_param(res_p_ty, param_syms.as_slice());
                try self.expect_assignable(arg_ty, res_p_ty, expr_span(arena, args[i]));
            }
            i = i +% 1_usize;
        }

        try self.check_call_generic_bounds(sig, inferred.as_slice(), sp);

        if has_fn_key && !inferred.is_empty() {
            var all_concrete = true;
            let inf_s = inferred.as_slice();
            var ki: usize = 0_usize;
            while ki < inf_s.len {
                if inf_s[ki].kind == .Ty {
                    if inf_s[ki].id == types.TY_ERROR || ty_contains_generic_param(inf_s[ki].id, self.env) {
                        all_concrete = false;
                        break;
                    }
                }
                ki = ki +% 1_usize;
            }
            if all_concrete {
                try self.table.set_call_generic_inst(
                    self.alloc, call_expr_id, sp, fn_key_kind, fn_key_primary, fn_key_secondary, inf_s,
                );
            }
        }

        var ret_ty = sig.ret;
        if replace_from != types.TY_NONE {
            ret_ty = try replace_ty(self.alloc, self.env, ret_ty, replace_from, replace_to);
        }
        let final_ret = try subst_ty(self.alloc, self.env, ret_ty, inferred.as_slice());
        param_syms.destroy(self.alloc);
        inferred.destroy(self.alloc);
        all_params.destroy(self.alloc);
        return final_ret;
    }
}

// ===========================================================================
// Section 9: Assignability, Branch Unification, Conformance, and Entrypoint
// ===========================================================================

impl Checker {
    fn expect_self_compatible(
        self: *mut Self,
        recv: types.TyId,
        param: types.TyId,
        sp: span.Span,
    ) -> !OutOfMemory {
        if recv == param || recv == types.TY_ERROR || param == types.TY_ERROR {
            return;
        }
        let pn = self.env.get(param);
        if pn.kind == .Borrow && pn.borrow_kind == .Single && pn.primary == recv {
            return;
        }
        let rn = self.env.get(recv);
        if rn.kind == .Borrow
            && rn.borrow_kind == .Single
            && rn.flag0
            && pn.kind == .Borrow
            && pn.borrow_kind == .Single
            && !pn.flag0
            && rn.primary == pn.primary
        {
            return;
        }
        try self.expect_assignable(recv, param, sp);
        return;
    }

    fn unify_branch_types(
        self: *mut Self,
        a: types.TyId,
        b: types.TyId,
        sp: span.Span,
    ) -> types.TyId ! OutOfMemory {
        if a == b || b == types.TY_NEVER || a == types.TY_ERROR {
            return a;
        }
        if a == types.TY_NEVER || b == types.TY_ERROR {
            return b;
        }
        if a == types.TY_COMPTIME_INT && self.env.is_concrete_integer(b) {
            return b;
        }
        if b == types.TY_COMPTIME_INT && self.env.is_concrete_integer(a) {
            return a;
        }
        if a == types.TY_COMPTIME_FLOAT && self.env.is_float(b) {
            return b;
        }
        if b == types.TY_COMPTIME_FLOAT && self.env.is_float(a) {
            return a;
        }
        try self.expect_assignable(b, a, sp);
        return a;
    }

    fn check_id_brand_assign_mismatch(
        self: *mut Self,
        from_ty: types.TyId,
        to_ty: types.TyId,
        sp: span.Span,
    ) -> bool ! OutOfMemory {
        let fn_n = self.env.get(from_ty);
        let tn_n = self.env.get(to_ty);
        if fn_n.kind == .Builtin
            && fn_n.builtin_kind == .IdBrand
            && tn_n.kind == .Builtin
            && tn_n.builtin_kind == .IdBrand
        {
            if !gval_slice_eq(self.env.node_gval_list(&fn_n), self.env.node_gval_list(&tn_n)) {
                try self.emit_err_ty_ty(
                    diag.E0330, sp, "brand mismatch: `", from_ty, "` cannot be assigned to `", to_ty, "`",
                );
            }
            return true;
        }
        if fn_n.kind == .Builtin && fn_n.builtin_kind == .IdBrand && tn_n.kind == .Optional {
            let ti = self.env.get(tn_n.primary);
            if ti.kind == .Builtin && ti.builtin_kind == .IdBrand {
                if !gval_slice_eq(self.env.node_gval_list(&fn_n), self.env.node_gval_list(&ti)) {
                    try self.emit_err_ty_ty(
                        diag.E0330, sp, "brand mismatch: `", from_ty, "` cannot be assigned to `", to_ty, "`",
                    );
                }
                return true;
            }
        }
        if fn_n.kind == .Optional && tn_n.kind == .Optional {
            let fi = self.env.get(fn_n.primary);
            let ti = self.env.get(tn_n.primary);
            if fi.kind == .Builtin
                && fi.builtin_kind == .IdBrand
                && ti.kind == .Builtin
                && ti.builtin_kind == .IdBrand
            {
                if !gval_slice_eq(self.env.node_gval_list(&fi), self.env.node_gval_list(&ti)) {
                    try self.emit_err_ty_ty(
                        diag.E0330, sp, "brand mismatch: `", from_ty, "` cannot be assigned to `", to_ty, "`",
                    );
                }
                return true;
            }
        }
        return false;
    }

    @recursive
    fn expect_assignable(
        self: *mut Self,
        from_ty: types.TyId,
        to_ty: types.TyId,
        sp: span.Span,
    ) -> !OutOfMemory {
        if from_ty == to_ty || from_ty == types.TY_NEVER || from_ty == types.TY_ERROR || to_ty == types.TY_ERROR {
            return;
        }
        if from_ty == types.TY_COMPTIME_INT && (self.env.is_integer(to_ty) || to_ty == types.TY_COMPTIME_INT) {
            return;
        }
        if from_ty == types.TY_COMPTIME_FLOAT && self.env.is_float(to_ty) {
            return;
        }
        let fn_n = self.env.get(from_ty);
        let tn_n = self.env.get(to_ty);

        // `T` coerces into `?T` and `T ! E`
        if tn_n.kind == .Optional {
            let inner = tn_n.primary;
            if from_ty == inner || (from_ty == types.TY_COMPTIME_INT && self.env.is_concrete_integer(inner)) {
                return;
            }
            let prev = self.diags.count();
            try self.expect_assignable(from_ty, inner, sp);
            if self.diags.count() == prev {
                return;
            }
            self.diags.truncate(prev);
        } else if tn_n.kind == .ErrorUnion {
            let ok = tn_n.primary;
            if from_ty == ok || (from_ty == types.TY_COMPTIME_INT && self.env.is_concrete_integer(ok)) {
                return;
            }
        }

        // `*mut T` -> `*T` and `*mut [T]` -> `*[T]`
        if fn_n.kind == .Borrow
            && tn_n.kind == .Borrow
            && fn_n.flag0
            && !tn_n.flag0
            && fn_n.borrow_kind == tn_n.borrow_kind
            && fn_n.primary == tn_n.primary
        {
            return;
        }

        // `*T` -> `*dyn Iface` / `*mut T` -> `*mut dyn Iface` / `*dyn Iface`
        if fn_n.kind == .Borrow
            && tn_n.kind == .Borrow
            && fn_n.borrow_kind == .Single
            && tn_n.borrow_kind == .Single
            && (!tn_n.flag0 || fn_n.flag0)
        {
            let concrete_ty = fn_n.primary;
            let dyn_inner = tn_n.primary;
            let dn = self.env.get(dyn_inner);
            if dn.kind == .Dyn && self.env.get(concrete_ty).kind != .Dyn {
                let iface_def = dn.primary;
                if self.type_implements_iface(concrete_ty, iface_def) {
                    try self.table.set_dyn_coercion(self.alloc, sp, iface_def, concrete_ty);
                    return;
                }
                var iname = span.SYM_EMPTY;
                if let id = self.prog.get_def(iface_def) {
                    iname = id.name;
                }
                try self.emit_err_ty_sym(
                    diag.E0501,
                    sp,
                    "type `",
                    concrete_ty,
                    "` does not implement interface `",
                    iname,
                    "` required for `dyn` coercion",
                );
                return;
            }
        }

        // `*[N]T` -> `*[T]` (and `*mut [N]T` -> `*mut [T]` / `*[T]`)
        if fn_n.kind == .Borrow
            && tn_n.kind == .Borrow
            && fn_n.borrow_kind == .Single
            && tn_n.borrow_kind == .Slice
            && (!tn_n.flag0 || fn_n.flag0)
        {
            let arr_n = self.env.get(fn_n.primary);
            if arr_n.kind == .Array && arr_n.primary == tn_n.primary {
                return;
            }
        }

        // Branded `Id[pool]` mismatch -> `E0330`
        if try self.check_id_brand_assign_mismatch(from_ty, to_ty, sp) {
            return;
        }

        // Address mismatch (`E0211`), ZM-05 numeric mismatch (`E0105`), general mismatch (`E0230`)
        if self.env.is_address(from_ty) || self.env.is_address(to_ty) {
            try self.emit_err_ty_ty(
                diag.E0211, sp, "incompatible address type: cannot assign `", from_ty, "` to `", to_ty, "`",
            );
            return;
        }
        if self.env.is_numeric(from_ty) && self.env.is_numeric(to_ty) {
            try self.emit_err_ty_ty(
                diag.E0105,
                sp,
                "ZM-05: implicit numeric conversion from `",
                from_ty,
                "` to `",
                to_ty,
                "` is forbidden; use .widen()/.trunc()/.to_float()",
            );
            return;
        }
        try self.emit_err_ty_ty(
            diag.E0230, sp, "type mismatch: expected `", to_ty, "`, found `", from_ty, "`",
        );
        return;
    }
}

fn check_impl_conformance(
    alloc: *mut AllocCap,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    interner: *span.SymInterner,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    let ims = env.decls.impls.as_slice();
    let prog_impls = prog.impls.as_slice();
    var ii: usize = 0_usize;
    while ii < ims.len {
        let im = ims[ii];
        if !im.has_iface {
            ii = ii +% 1_usize;
            continue;
        }
        let iface_meta = env.get_iface(im.iface_def) orelse {
            ii = ii +% 1_usize;
            continue;
        };
        var impl_span = span.span_dummy();
        var pi: usize = 0_usize;
        while pi < prog_impls.len {
            if prog_impls[pi].decl_idx == im.impl_decl_idx && prog_impls[pi].module_id == im.module_id {
                impl_span = prog_impls[pi].span;
                break;
            }
            pi = pi +% 1_usize;
        }
        let reqs = env.iface_methods_range(iface_meta.methods);
        let im_ms = env.impl_methods_range(im.methods);
        var ri: usize = 0_usize;
        while ri < reqs.len {
            let req = reqs[ri];
            var found = false;
            var impl_param_len: u32 = 0_u32;
            var mi: usize = 0_usize;
            while mi < im_ms.len {
                if im_ms[mi].sig.name == req.name {
                    found = true;
                    impl_param_len = im_ms[mi].sig.params.len;
                    break;
                }
                mi = mi +% 1_usize;
            }
            if !found {
                var msg = try str.StrBuf.init(alloc, 96_usize);
                errdefer msg.destroy(alloc);
                try msg.push_str_grow(alloc, "missing interface method `");
                try msg.push_bytes_grow(alloc, interner.get(req.name));
                try msg.push_str_grow(alloc, "` in `impl`");
                _ = try diags.emit_error_bytes(alloc, diag.E0501, impl_span, msg.as_bytes());
                msg.destroy(alloc);
            } else if impl_param_len != req.params.len {
                var msg = try str.StrBuf.init(alloc, 128_usize);
                errdefer msg.destroy(alloc);
                try msg.push_str_grow(alloc, "method `");
                try msg.push_bytes_grow(alloc, interner.get(req.name));
                try msg.push_str_grow(alloc, "` parameter count mismatch with interface (expected ");
                try msg.push_u64_grow(alloc, req.params.len.widen.[u64]());
                try msg.push_str_grow(alloc, ", found ");
                try msg.push_u64_grow(alloc, impl_param_len.widen.[u64]());
                try msg.push_byte_grow(alloc, b')');
                _ = try diags.emit_error_bytes(alloc, diag.E0501, impl_span, msg.as_bytes());
                msg.destroy(alloc);
            }
            ri = ri +% 1_usize;
        }
        ii = ii +% 1_usize;
    }
    return;
}

fn populate_sig_generics(
    alloc: *mut AllocCap,
    env: *types.TypeEnv,
    sig: *types.FnSig,
    gctx: *mut types.GenericCtx,
) -> !OutOfMemory {
    let gps = env.generic_params_range(sig.generics);
    var i: usize = 0_usize;
    while i < gps.len {
        try gctx.params.push(
            alloc,
            types.GenericCtxParam.{
                name: gps[i].name,
                idx: i.trunc.[u32](),
                is_comptime: gps[i].is_comptime,
            },
        );
        i = i +% 1_usize;
    }
    return;
}

fn prepare_fn_state(
    alloc: *mut AllocCap,
    env: *types.TypeEnv,
    sig: *types.FnSig,
    st: *mut FnState,
) -> !OutOfMemory {
    try st.reset(alloc);
    try populate_sig_generics(alloc, env, sig, &mut st.generic_ctx);
    return;
}

fn check_top_level_def(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    ct: *mut ctvm.CtArena,
    table: *mut TypeTable,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    st: *mut FnState,
    di: u32,
) -> !OutOfMemory {
    var has_td = false;
    var def_mod: u32 = resolve.MODULE_NONE;
    var def_kind: resolve.TopDefKind = .Struct;
    var decl_id: u32 = ast.NONE_ID;
    if let td = prog.get_def(di) {
        has_td = true;
        def_mod = td.module_id;
        def_kind = td.kind;
        decl_id = td.decl_id;
    }
    if !has_td {
        return;
    }
    var has_unit = false;
    if let mi = prog.get_module(def_mod) {
        has_unit = mi.unit_id != resolve.UNIT_NONE;
    }
    if !has_unit {
        return;
    }
    if def_kind == .Fn {
        var has_sig = false;
        var sig = types.FnSig.{
            has_def: false, def_id: 0_u32, module_id: def_mod, name: span.SYM_EMPTY,
            is_pub: false, is_view: false, is_comptime: false, is_extern: false,
            generics: ast.range_empty(), params: ast.range_empty(), ret: types.TY_VOID,
            has_gpu_attr: false, effects: types.effect_set_empty(),
        };
        if let s = env.get_fn(di) {
            has_sig = true;
            sig = s.*;
        }
        if has_sig {
            if let decl = arena.get_decl(decl_id) {
                if decl.kind == .Fn {
                    if let f = arena.get_fn_decl(decl.payload) {
                        try prepare_fn_state(alloc, env, &sig, st);
                        let is_ct = sig.is_comptime;
                        var ck = Checker.{
                            alloc: alloc, prog: prog, env: env, ct: ct, table: table,
                            interner: interner, diags: diags, st: st, mod_id: def_mod,
                            sig: sig, in_iface_impl: false, in_comptime: is_ct,
                            has_pool_handle_kind: false,
                            pool_handle_kind: types.PoolHandleKind.{ tag: .SlotPool, brand: span.SYM_EMPTY },
                        };
                        try ck.check_fn_body(arena, f);
                    }
                }
            }
        }
    } else if def_kind == .Sys {
        var has_sig = false;
        var sig = types.FnSig.{
            has_def: false, def_id: 0_u32, module_id: def_mod, name: span.SYM_EMPTY,
            is_pub: false, is_view: false, is_comptime: false, is_extern: false,
            generics: ast.range_empty(), params: ast.range_empty(), ret: types.TY_VOID,
            has_gpu_attr: false, effects: types.effect_set_empty(),
        };
        if let s = env.get_fn(di) {
            has_sig = true;
            sig = s.*;
        }
        if has_sig {
            if let decl = arena.get_decl(decl_id) {
                if decl.kind == .Sys {
                    if let sd = arena.get_sys_decl(decl.payload) {
                        try prepare_fn_state(alloc, env, &sig, st);
                        let is_ct = sig.is_comptime;
                        var ck = Checker.{
                            alloc: alloc, prog: prog, env: env, ct: ct, table: table,
                            interner: interner, diags: diags, st: st, mod_id: def_mod,
                            sig: sig, in_iface_impl: false, in_comptime: is_ct,
                            has_pool_handle_kind: false,
                            pool_handle_kind: types.PoolHandleKind.{ tag: .SlotPool, brand: span.SYM_EMPTY },
                        };
                        try ck.check_sys_body(arena, sd);
                    }
                }
            }
        }
    } else if def_kind == .Const {
        var has_meta = false;
        var cty = types.TY_ERROR;
        if let cm = env.get_const(di) {
            has_meta = true;
            cty = cm.ty;
        }
        if has_meta {
            if let decl = arena.get_decl(decl_id) {
                if decl.kind == .Const {
                    if let cd = arena.get_const_decl(decl.payload) {
                        let dummy_sig = types.FnSig.{
                            has_def: false, def_id: 0_u32, module_id: def_mod, name: cd.name.sym,
                            is_pub: decl.is_pub, is_view: false, is_comptime: true, is_extern: false,
                            generics: ast.range_empty(), params: ast.range_empty(), ret: cty,
                            has_gpu_attr: false, effects: types.effect_set_empty(),
                        };
                        try prepare_fn_state(alloc, env, &dummy_sig, st);
                        var ck = Checker.{
                            alloc: alloc, prog: prog, env: env, ct: ct, table: table,
                            interner: interner, diags: diags, st: st, mod_id: def_mod,
                            sig: dummy_sig, in_iface_impl: false, in_comptime: true,
                            has_pool_handle_kind: false,
                            pool_handle_kind: types.PoolHandleKind.{ tag: .SlotPool, brand: span.SYM_EMPTY },
                        };
                        let got = try ck.check_expr(arena, cd.value, cty);
                        try ck.expect_assignable(got, cty, expr_span(arena, cd.value));
                    }
                }
            }
        }
    }
    return;
}

fn check_top_level_defs(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    ct: *mut ctvm.CtArena,
    table: *mut TypeTable,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    st: *mut FnState,
) -> !OutOfMemory {
    let def_cnt = prog.def_count();
    var di: u32 = 0_u32;
    while di < def_cnt {
        try check_top_level_def(alloc, arena, prog, env, ct, table, interner, diags, st, di);
        di = di +% 1_u32;
    }
    return;
}

fn check_impl_methods(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    ct: *mut ctvm.CtArena,
    table: *mut TypeTable,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    st: *mut FnState,
) -> !OutOfMemory {
    let impl_cnt = env.decls.impls.len();
    var ii: usize = 0_usize;
    while ii < impl_cnt {
        var has_im = false;
        var im = types.ImplMeta.{
            module_id: resolve.MODULE_NONE,
            impl_decl_idx: 0_u32,
            impl_decl_id: ast.NONE_ID,
            has_iface: false,
            iface_def: 0_u32,
            target: types.MethodTarget.{ kind: .Def, def_id: 0_u32, builtin: .Prim },
            target_ty: types.TY_ERROR,
            generics: ast.range_empty(),
            methods: ast.range_empty(),
        };
        let ims = env.decls.impls.as_slice();
        if ii < ims.len {
            im = ims[ii];
            has_im = true;
        }
        if has_im {
            var has_unit = false;
            if let mi = prog.get_module(im.module_id) {
                has_unit = mi.unit_id != resolve.UNIT_NONE;
            }
            if has_unit {
                if let decl = arena.get_decl(im.impl_decl_id) {
                    if decl.kind == .Impl {
                        if let impl_decl = arena.get_impl_decl(decl.payload) {
                            let imp_gps = arena.generic_params_range(impl_decl.generics);
                            let mcnt = im.methods.len.widen.[usize]();
                            var mi_idx: usize = 0_usize;
                            while mi_idx < mcnt {
                                var has_m = false;
                                var m_decl_id: u32 = ast.NONE_ID;
                                var msig = types.FnSig.{
                                    has_def: false,
                                    def_id: 0_u32,
                                    module_id: im.module_id,
                                    name: span.SYM_EMPTY,
                                    is_pub: false,
                                    is_view: false,
                                    is_comptime: false,
                                    is_extern: false,
                                    generics: ast.range_empty(),
                                    params: ast.range_empty(),
                                    ret: types.TY_VOID,
                                    has_gpu_attr: false,
                                    effects: types.effect_set_empty(),
                                };
                                let ms = env.impl_methods_range(im.methods);
                                if mi_idx < ms.len {
                                    m_decl_id = ms[mi_idx].decl_id;
                                    msig = ms[mi_idx].sig;
                                    has_m = true;
                                }
                                if has_m {
                                    if let sub_decl = arena.get_decl(m_decl_id) {
                                        if sub_decl.kind == .Fn {
                                            if let f = arena.get_fn_decl(sub_decl.payload) {
                                                try prepare_fn_state(alloc, env, &msig, st);
                                                let is_ct = msig.is_comptime;
                                                var ck = Checker.{
                                                    alloc: alloc, prog: prog, env: env, ct: ct,
                                                    table: table, interner: interner, diags: diags,
                                                    st: st, mod_id: im.module_id, sig: msig,
                                                    in_iface_impl: im.has_iface, in_comptime: is_ct,
                                                    has_pool_handle_kind: false,
                                                    pool_handle_kind: types.PoolHandleKind.{
                                                        tag: .SlotPool, brand: span.SYM_EMPTY,
                                                    },
                                                };
                                                if im.target_ty != types.TY_ERROR {
                                                    ck.st.generic_ctx.has_self_ty = true;
                                                    ck.st.generic_ctx.self_ty = im.target_ty;
                                                }
                                                let base_len = ck.st.generic_ctx.params.len().trunc.[u32]();
                                                var gi: usize = 0_usize;
                                                while gi < imp_gps.len {
                                                    let gp = imp_gps[gi];
                                                    if let _ = ck.st.generic_ctx.find_param(gp.name.sym) {
                                                        // already present
                                                    } else {
                                                        try ck.st.generic_ctx.params.push(
                                                            alloc,
                                                            types.GenericCtxParam.{
                                                                name: gp.name.sym,
                                                                idx: base_len +% gi.trunc.[u32](),
                                                                is_comptime: gp.is_comptime,
                                                            },
                                                        );
                                                    }
                                                    gi = gi +% 1_usize;
                                                }
                                                try ck.check_fn_body(arena, f);
                                            }
                                        }
                                    }
                                }
                                mi_idx = mi_idx +% 1_usize;
                            }
                        }
                    }
                }
            }
        }
        ii = ii +% 1_usize;
    }
    return;
}

struct CheckWorkItem {
    is_impl: bool;
    def_id: u32;
    impl_idx: u32;
    method_idx: u32;
    weight: u32;
}

struct CheckWorkRes {
    has_res: bool;
    wid: u32;
    et_start: u32;
    et_len: u32;
    st_start: u32;
    st_len: u32;
    cv_start: u32;
    cv_len: u32;
    cb_start: u32;
    cb_len: u32;
    ci_start: u32;
    ci_len: u32;
    cgi_start: u32;
    cgi_len: u32;
    dc_start: u32;
    dc_len: u32;
    dcall_start: u32;
    dcall_len: u32;
    ctgt_start: u32;
    ctgt_len: u32;
    diag_start: u32;
    diag_len: u32;
}

fn check_work_res_empty() -> CheckWorkRes {
    return CheckWorkRes.{
        has_res: false,
        wid: 0_u32,
        et_start: 0_u32, et_len: 0_u32,
        st_start: 0_u32, st_len: 0_u32,
        cv_start: 0_u32, cv_len: 0_u32,
        cb_start: 0_u32, cb_len: 0_u32,
        ci_start: 0_u32, ci_len: 0_u32,
        cgi_start: 0_u32, cgi_len: 0_u32,
        dc_start: 0_u32, dc_len: 0_u32,
        dcall_start: 0_u32, dcall_len: 0_u32,
        ctgt_start: 0_u32, ctgt_len: 0_u32,
        diag_start: 0_u32, diag_len: 0_u32,
    };
}

linear struct WorkerCheckState {
    prog: resolve.ResolvedProgram;
    env: types.TypeEnv;
    ct: ctvm.CtArena;
    interner: span.SymInterner;
    table: TypeTable;
    diags: diag.DiagBag;
    st: FnState;
    ty_remap: col.DynBuf[types.TyId];
    ct_remap: col.DynBuf[u32];
    tmp_gvals: col.DynBuf[types.GenericVal];
    oom: bool;
}

impl WorkerCheckState {
    fn init(
        alloc: *mut AllocCap,
        src_prog: *resolve.ResolvedProgram,
        src_env: *types.TypeEnv,
        src_ct: *ctvm.CtArena,
        src_interner: *span.SymInterner,
        active: bool,
    ) -> WorkerCheckState ! OutOfMemory {
        let prog = if active { try src_prog.clone_for_worker(alloc) } else { try resolve.ResolvedProgram.init(alloc) };
        errdefer prog.destroy(alloc);
        let env = if active { try src_env.clone_for_worker(alloc) } else { try types.TypeEnv.init(alloc) };
        errdefer env.destroy(alloc);
        let ct = if active { try src_ct.clone_for_worker(alloc) } else { try ctvm.CtArena.init(alloc) };
        errdefer ct.destroy(alloc);
        let interner = if active { try src_interner.clone(alloc) } else { try span.SymInterner.init(alloc) };
        errdefer interner.destroy(alloc);
        let table = try TypeTable.init(alloc);
        errdefer table.destroy(alloc);
        let diags = try diag.DiagBag.init(alloc);
        errdefer diags.destroy(alloc);
        let st = try FnState.init(alloc);
        errdefer st.destroy(alloc);
        let ty_remap = try col.DynBuf.[types.TyId].init(alloc, 64_usize);
        errdefer ty_remap.destroy(alloc);
        let ct_remap = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer ct_remap.destroy(alloc);
        let tmp_gvals = try col.DynBuf.[types.GenericVal].init(alloc, 8_usize);
        return WorkerCheckState.{
            prog: prog,
            env: env,
            ct: ct,
            interner: interner,
            table: table,
            diags: diags,
            st: st,
            ty_remap: ty_remap,
            ct_remap: ct_remap,
            tmp_gvals: tmp_gvals,
            oom: false,
        };
    }

    fn destroy(self: WorkerCheckState, alloc: *mut AllocCap) {
        let WorkerCheckState.{
            prog, env, ct, interner, table, diags, st, ty_remap, ct_remap, tmp_gvals, oom,
        } = self;
        _ = oom;
        tmp_gvals.destroy(alloc);
        ct_remap.destroy(alloc);
        ty_remap.destroy(alloc);
        st.destroy(alloc);
        diags.destroy(alloc);
        table.destroy(alloc);
        interner.destroy(alloc);
        ct.destroy(alloc);
        env.destroy(alloc);
        prog.destroy(alloc);
    }
}

fn check_single_impl_method(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    ct: *mut ctvm.CtArena,
    table: *mut TypeTable,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    st: *mut FnState,
    impl_idx: u32,
    method_idx: u32,
) -> !OutOfMemory {
    let ii = impl_idx.widen.[usize]();
    let mi_idx = method_idx.widen.[usize]();
    var has_im = false;
    var im = types.ImplMeta.{
        module_id: resolve.MODULE_NONE,
        impl_decl_idx: 0_u32,
        impl_decl_id: ast.NONE_ID,
        has_iface: false,
        iface_def: 0_u32,
        target: types.MethodTarget.{ kind: .Def, def_id: 0_u32, builtin: .Prim },
        target_ty: types.TY_ERROR,
        generics: ast.range_empty(),
        methods: ast.range_empty(),
    };
    let ims = env.decls.impls.as_slice();
    if ii < ims.len {
        im = ims[ii];
        has_im = true;
    }
    if !has_im {
        return;
    }
    var has_m = false;
    var m_decl_id: u32 = ast.NONE_ID;
    var msig = types.FnSig.{
        has_def: false, def_id: 0_u32, module_id: im.module_id, name: span.SYM_EMPTY,
        is_pub: false, is_view: false, is_comptime: false, is_extern: false,
        generics: ast.range_empty(), params: ast.range_empty(), ret: types.TY_VOID,
        has_gpu_attr: false, effects: types.effect_set_empty(),
    };
    let ms = env.impl_methods_range(im.methods);
    if mi_idx < ms.len {
        m_decl_id = ms[mi_idx].decl_id;
        msig = ms[mi_idx].sig;
        has_m = true;
    }
    if !has_m {
        return;
    }
    if let decl = arena.get_decl(im.impl_decl_id) {
        if decl.kind == .Impl {
            if let impl_decl = arena.get_impl_decl(decl.payload) {
                let imp_gps = arena.generic_params_range(impl_decl.generics);
                if let sub_decl = arena.get_decl(m_decl_id) {
                    if sub_decl.kind == .Fn {
                        if let f = arena.get_fn_decl(sub_decl.payload) {
                            try prepare_fn_state(alloc, env, &msig, st);
                            let is_ct = msig.is_comptime;
                            var ck = Checker.{
                                alloc: alloc, prog: prog, env: env, ct: ct,
                                table: table, interner: interner, diags: diags,
                                st: st, mod_id: im.module_id, sig: msig,
                                in_iface_impl: im.has_iface, in_comptime: is_ct,
                                has_pool_handle_kind: false,
                                pool_handle_kind: types.PoolHandleKind.{
                                    tag: .SlotPool, brand: span.SYM_EMPTY,
                                },
                            };
                            if im.target_ty != types.TY_ERROR {
                                ck.st.generic_ctx.has_self_ty = true;
                                ck.st.generic_ctx.self_ty = im.target_ty;
                            }
                            let base_len = ck.st.generic_ctx.params.len().trunc.[u32]();
                            var gi: usize = 0_usize;
                            while gi < imp_gps.len {
                                let gp = imp_gps[gi];
                                if let _ = ck.st.generic_ctx.find_param(gp.name.sym) {
                                    // already present
                                } else {
                                    try ck.st.generic_ctx.params.push(
                                        alloc,
                                        types.GenericCtxParam.{
                                            name: gp.name.sym,
                                            idx: base_len +% gi.trunc.[u32](),
                                            is_comptime: gp.is_comptime,
                                        },
                                    );
                                }
                                gi = gi +% 1_usize;
                            }
                            try ck.check_fn_body(arena, f);
                        }
                    }
                }
            }
        }
    }
    return;
}

fn check_work_weight(arena: *ast.AstArena, body_id: u32) -> u32 {
    if let blk = arena.get_block(body_id) {
        return blk.stmts.len +% 1_u32;
    }
    return 1_u32;
}

fn collect_check_work_items(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    out_items: *mut col.DynBuf[CheckWorkItem],
) -> !OutOfMemory {
    let def_cnt = prog.def_count();
    var di: u32 = 0_u32;
    while di < def_cnt {
        if let td = prog.get_def(di) {
            var has_unit = false;
            if let mi = prog.get_module(td.module_id) {
                has_unit = mi.unit_id != resolve.UNIT_NONE;
            }
            if has_unit && (td.kind == .Fn || td.kind == .Sys || td.kind == .Const) {
                var w: u32 = 1_u32;
                if let decl = arena.get_decl(td.decl_id) {
                    if td.kind == .Fn && decl.kind == .Fn {
                        if let f = arena.get_fn_decl(decl.payload) { w = check_work_weight(arena, f.body); }
                    } else if td.kind == .Sys && decl.kind == .Sys {
                        if let sd = arena.get_sys_decl(decl.payload) { w = check_work_weight(arena, sd.body); }
                    }
                }
                try out_items.push(
                    alloc,
                    CheckWorkItem.{ is_impl: false, def_id: di, impl_idx: 0_u32, method_idx: 0_u32, weight: w },
                );
            }
        }
        di = di +% 1_u32;
    }
    let ims = env.decls.impls.as_slice();
    var ii: usize = 0_usize;
    while ii < ims.len {
        let im = ims[ii];
        var has_unit = false;
        if let mi = prog.get_module(im.module_id) {
            has_unit = mi.unit_id != resolve.UNIT_NONE;
        }
        if has_unit {
            let ms = env.impl_methods_range(im.methods);
            var mi_idx: usize = 0_usize;
            while mi_idx < ms.len {
                var w: u32 = 1_u32;
                if let sub_decl = arena.get_decl(ms[mi_idx].decl_id) {
                    if sub_decl.kind == .Fn {
                        if let f = arena.get_fn_decl(sub_decl.payload) { w = check_work_weight(arena, f.body); }
                    }
                }
                try out_items.push(
                    alloc,
                    CheckWorkItem.{
                        is_impl: true,
                        def_id: 0_u32,
                        impl_idx: ii.trunc.[u32](),
                        method_idx: mi_idx.trunc.[u32](),
                        weight: w,
                    },
                );
                mi_idx = mi_idx +% 1_usize;
            }
        }
        ii = ii +% 1_usize;
    }
    return;
}

fn sort_check_work_order_desc(order: *mut [u32], items: *[CheckWorkItem]) {
    let n = order.len;
    if n <= 1_usize {
        return;
    }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third {
        gap = (gap *% 3_usize) +% 1_usize;
    }
    while gap > 0_usize {
        var i = gap;
        while i < order.len {
            let idx = order[i];
            let iu = idx.widen.[usize]();
            let wi = if iu < items.len { items[iu].weight } else { 0_u32 };
            var j = i;
            while j >= gap && j < order.len {
                let prev = j - gap;
                let pidx = order[prev];
                let pu = pidx.widen.[usize]();
                let wp = if pu < items.len { items[pu].weight } else { 0_u32 };
                if wp > wi || (wp == wi && pidx < idx) {
                    break;
                }
                order[j] = pidx;
                j = prev;
            }
            order[j] = idx;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

fn check_worker_loop(
    wid: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    order: *[u32],
    items: *[CheckWorkItem],
    results: *mut [CheckWorkRes],
    arena: *ast.AstArena,
    w: *mut WorkerCheckState,
) -> !OutOfMemory {
    while true {
        let pos = next_pos.fetch_add(1_u64, .AcqRel).trunc.[usize]();
        if pos >= order.len {
            break;
        }
        let item_idx = order[pos].widen.[usize]();
        if item_idx >= items.len {
            continue;
        }
        let it = items[item_idx];
        let et_s = w.table.expr_tys.len().trunc.[u32]();
        let st_s = w.table.span_tys.len().trunc.[u32]();
        let cv_s = w.table.comptime_vals.len().trunc.[u32]();
        let cb_s = w.table.comptime_branches.len().trunc.[u32]();
        let ci_s = w.table.const_int_map.len().trunc.[u32]();
        let cgi_s = w.table.meta.call_insts.len().trunc.[u32]();
        let dc_s = w.table.meta.dyn_coercions.len().trunc.[u32]();
        let dcall_s = w.table.meta.dyn_calls.len().trunc.[u32]();
        let ctgt_s = w.table.meta.call_targets.len().trunc.[u32]();
        let d_s = w.diags.count().trunc.[u32]();

        if it.is_impl {
            try check_single_impl_method(
                alloc, arena, &mut w.prog, &mut w.env, &mut w.ct, &mut w.table,
                &mut w.interner, &mut w.diags, &mut w.st, it.impl_idx, it.method_idx,
            );
        } else {
            try check_top_level_def(
                alloc, arena, &mut w.prog, &mut w.env, &mut w.ct, &mut w.table,
                &mut w.interner, &mut w.diags, &mut w.st, it.def_id,
            );
        }

        if item_idx < results.len {
            results[item_idx] = CheckWorkRes.{
                has_res: true,
                wid: wid,
                et_start: et_s, et_len: w.table.expr_tys.len().trunc.[u32]() -% et_s,
                st_start: st_s, st_len: w.table.span_tys.len().trunc.[u32]() -% st_s,
                cv_start: cv_s, cv_len: w.table.comptime_vals.len().trunc.[u32]() -% cv_s,
                cb_start: cb_s, cb_len: w.table.comptime_branches.len().trunc.[u32]() -% cb_s,
                ci_start: ci_s, ci_len: w.table.const_int_map.len().trunc.[u32]() -% ci_s,
                cgi_start: cgi_s, cgi_len: w.table.meta.call_insts.len().trunc.[u32]() -% cgi_s,
                dc_start: dc_s, dc_len: w.table.meta.dyn_coercions.len().trunc.[u32]() -% dc_s,
                dcall_start: dcall_s, dcall_len: w.table.meta.dyn_calls.len().trunc.[u32]() -% dcall_s,
                ctgt_start: ctgt_s, ctgt_len: w.table.meta.call_targets.len().trunc.[u32]() -% ctgt_s,
                diag_start: d_s, diag_len: w.diags.count().trunc.[u32]() -% d_s,
            };
        }
    }
    return;
}

fn run_check_worker_entry(
    wid: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    order: *[u32],
    items: *[CheckWorkItem],
    results: *mut [CheckWorkRes],
    arena: *ast.AstArena,
    w: *mut WorkerCheckState,
) {
    check_worker_loop(wid, alloc, next_pos, order, items, results, arena, w) catch {
        w.oom = true;
    };
}

fn dispatch_check_workers(
    nw: usize,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    order: *[u32],
    items: *[CheckWorkItem],
    results: *mut [CheckWorkRes],
    arena: *ast.AstArena,
    w0: *mut WorkerCheckState, w1: *mut WorkerCheckState, w2: *mut WorkerCheckState, w3: *mut WorkerCheckState,
    w4: *mut WorkerCheckState, w5: *mut WorkerCheckState, w6: *mut WorkerCheckState, w7: *mut WorkerCheckState,
    w8: *mut WorkerCheckState, w9: *mut WorkerCheckState, w10: *mut WorkerCheckState, w11: *mut WorkerCheckState,
) {
    if nw <= 1_usize {
        run_check_worker_entry(0_u32, alloc, next_pos, order, items, results, arena, w0);
        return;
    }
    par for wi in 0_usize..nw {
        if wi == 0_usize { run_check_worker_entry(0_u32, alloc, next_pos, order, items, results, arena, w0); }
        else if wi == 1_usize { run_check_worker_entry(1_u32, alloc, next_pos, order, items, results, arena, w1); }
        else if wi == 2_usize { run_check_worker_entry(2_u32, alloc, next_pos, order, items, results, arena, w2); }
        else if wi == 3_usize { run_check_worker_entry(3_u32, alloc, next_pos, order, items, results, arena, w3); }
        else if wi == 4_usize { run_check_worker_entry(4_u32, alloc, next_pos, order, items, results, arena, w4); }
        else if wi == 5_usize { run_check_worker_entry(5_u32, alloc, next_pos, order, items, results, arena, w5); }
        else if wi == 6_usize { run_check_worker_entry(6_u32, alloc, next_pos, order, items, results, arena, w6); }
        else if wi == 7_usize { run_check_worker_entry(7_u32, alloc, next_pos, order, items, results, arena, w7); }
        else if wi == 8_usize { run_check_worker_entry(8_u32, alloc, next_pos, order, items, results, arena, w8); }
        else if wi == 9_usize { run_check_worker_entry(9_u32, alloc, next_pos, order, items, results, arena, w9); }
        else if wi == 10_usize { run_check_worker_entry(10_u32, alloc, next_pos, order, items, results, arena, w10); }
        else if wi == 11_usize { run_check_worker_entry(11_u32, alloc, next_pos, order, items, results, arena, w11); }
    }
}

fn check_workers_oom(
    w0: *WorkerCheckState, w1: *WorkerCheckState, w2: *WorkerCheckState, w3: *WorkerCheckState,
    w4: *WorkerCheckState, w5: *WorkerCheckState, w6: *WorkerCheckState, w7: *WorkerCheckState,
    w8: *WorkerCheckState, w9: *WorkerCheckState, w10: *WorkerCheckState, w11: *WorkerCheckState,
) -> !OutOfMemory {
    if w0.oom || w1.oom || w2.oom || w3.oom || w4.oom || w5.oom
        || w6.oom || w7.oom || w8.oom || w9.oom || w10.oom || w11.oom
    {
        return OutOfMemory;
    }
    return;
}

fn merge_single_check_item(
    alloc: *mut AllocCap,
    r: *CheckWorkRes,
    base_ty_count: u32,
    base_ct_count: u32,
    base_sym_count: u32,
    w: *mut WorkerCheckState,
    main_env: *mut types.TypeEnv,
    main_ct: *mut ctvm.CtArena,
    main_interner: *mut span.SymInterner,
    main_table: *mut TypeTable,
    main_diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    if r.diag_len > 0_u32 {
        try main_diags.append_diag_range(alloc, &w.diags, r.diag_start, r.diag_len);
    }

    if r.et_len > 0_u32 {
        let ks = w.table.expr_tys.keys_slice();
        let vs = w.table.expr_tys.vals_slice();
        let s = r.et_start.widen.[usize]();
        let e = s +% r.et_len.widen.[usize]();
        var i = s;
        while i < e && i < ks.len && i < vs.len {
            let mty = try main_env.remap_worker_ty_lazy(
                alloc, &w.env, base_ty_count, &mut w.ty_remap, vs[i],
            );
            try main_table.expr_tys.insert(alloc, ks[i], mty);
            i = i +% 1_usize;
        }
    }

    if r.st_len > 0_u32 {
        let ks = w.table.span_tys.keys_slice();
        let vs = w.table.span_tys.vals_slice();
        let s = r.st_start.widen.[usize]();
        let e = s +% r.st_len.widen.[usize]();
        var i = s;
        while i < e && i < ks.len && i < vs.len {
            let mty = try main_env.remap_worker_ty_lazy(
                alloc, &w.env, base_ty_count, &mut w.ty_remap, vs[i],
            );
            try main_table.span_tys.insert(alloc, ks[i], mty);
            i = i +% 1_usize;
        }
    }

    if r.cv_len > 0_u32 {
        let ks = w.table.comptime_vals.keys_slice();
        let vs = w.table.comptime_vals.vals_slice();
        let s = r.cv_start.widen.[usize]();
        let e = s +% r.cv_len.widen.[usize]();
        var i = s;
        while i < e && i < ks.len && i < vs.len {
            let mvid = try main_ct.import_worker_val_lazy(
                alloc, &w.ct, base_ct_count, &mut w.ct_remap,
                &w.env, main_env, base_ty_count, &mut w.ty_remap,
                &w.interner, main_interner, base_sym_count, vs[i],
            );
            try main_table.comptime_vals.insert(alloc, ks[i], mvid);
            i = i +% 1_usize;
        }
    }

    if r.cb_len > 0_u32 {
        let ks = w.table.comptime_branches.keys_slice();
        let vs = w.table.comptime_branches.vals_slice();
        let s = r.cb_start.widen.[usize]();
        let e = s +% r.cb_len.widen.[usize]();
        var i = s;
        while i < e && i < ks.len && i < vs.len {
            try main_table.comptime_branches.insert(alloc, ks[i], vs[i]);
            i = i +% 1_usize;
        }
    }

    if r.ci_len > 0_u32 {
        let ks = w.table.const_int_map.keys_slice();
        let vs = w.table.const_int_map.vals_slice();
        let cis = w.table.const_ints.as_slice();
        let s = r.ci_start.widen.[usize]();
        let e = s +% r.ci_len.widen.[usize]();
        var i = s;
        while i < e && i < ks.len && i < vs.len {
            let vidx = vs[i].widen.[usize]();
            if vidx < cis.len {
                try main_table.set_const_int(alloc, ks[i].trunc.[u32](), cis[vidx]);
            }
            i = i +% 1_usize;
        }
    }

    if r.cgi_len > 0_u32 {
        let cis = w.table.meta.call_insts.as_slice();
        let s = r.cgi_start.widen.[usize]();
        let e = s +% r.cgi_len.widen.[usize]();
        var i = s;
        while i < e && i < cis.len {
            let c = cis[i];
            let src_gs = w.table.call_inst_args_slice(c.args);
            w.tmp_gvals.clear();
            var gi: usize = 0_usize;
            while gi < src_gs.len {
                var gv = src_gs[gi];
                if gv.kind == .Ty {
                    gv.id = try main_env.remap_worker_ty_lazy(
                        alloc, &w.env, base_ty_count, &mut w.ty_remap, gv.id,
                    );
                }
                try w.tmp_gvals.push(alloc, gv);
                gi = gi +% 1_usize;
            }
            try main_table.set_call_generic_inst(
                alloc, c.expr_id, c.span, c.kind, c.primary, c.secondary, w.tmp_gvals.as_slice(),
            );
            i = i +% 1_usize;
        }
    }

    if r.dc_len > 0_u32 {
        let dcs = w.table.meta.dyn_coercions.as_slice();
        let s = r.dc_start.widen.[usize]();
        let e = s +% r.dc_len.widen.[usize]();
        var i = s;
        while i < e && i < dcs.len {
            let dc = dcs[i];
            let mty = try main_env.remap_worker_ty_lazy(
                alloc, &w.env, base_ty_count, &mut w.ty_remap, dc.concrete_ty,
            );
            try main_table.set_dyn_coercion(alloc, dc.span, dc.iface_def, mty);
            i = i +% 1_usize;
        }
    }

    if r.dcall_len > 0_u32 {
        let dcs = w.table.meta.dyn_calls.as_slice();
        let s = r.dcall_start.widen.[usize]();
        let e = s +% r.dcall_len.widen.[usize]();
        var i = s;
        while i < e && i < dcs.len {
            let dc = dcs[i];
            try main_table.set_dyn_call(alloc, dc.expr_id, dc.span, dc.iface_def, dc.method_idx);
            i = i +% 1_usize;
        }
    }

    if r.ctgt_len > 0_u32 {
        let ks = w.table.meta.call_target_by_expr.keys_slice();
        let vs = w.table.meta.call_target_by_expr.vals_slice();
        let cts = w.table.meta.call_targets.as_slice();
        let s = r.ctgt_start.widen.[usize]();
        let e = s +% r.ctgt_len.widen.[usize]();
        var i = s;
        while i < e && i < ks.len && i < vs.len {
            let tidx = vs[i].widen.[usize]();
            if tidx < cts.len {
                let ct_item = cts[tidx];
                try main_table.set_call_target(
                    alloc, ks[i].trunc.[u32](), ct_item.kind, ct_item.primary, ct_item.secondary,
                );
            }
            i = i +% 1_usize;
        }
    }
    return;
}

fn merge_check_item_dispatch(
    alloc: *mut AllocCap,
    r: *CheckWorkRes,
    base_ty_count: u32,
    base_ct_count: u32,
    base_sym_count: u32,
    main_env: *mut types.TypeEnv,
    main_ct: *mut ctvm.CtArena,
    main_interner: *mut span.SymInterner,
    main_table: *mut TypeTable,
    main_diags: *mut diag.DiagBag,
    w0: *mut WorkerCheckState, w1: *mut WorkerCheckState, w2: *mut WorkerCheckState, w3: *mut WorkerCheckState,
    w4: *mut WorkerCheckState, w5: *mut WorkerCheckState, w6: *mut WorkerCheckState, w7: *mut WorkerCheckState,
    w8: *mut WorkerCheckState, w9: *mut WorkerCheckState, w10: *mut WorkerCheckState, w11: *mut WorkerCheckState,
) -> !OutOfMemory {
    let wid = r.wid;
    if wid == 0_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w0, main_env, main_ct, main_interner, main_table, main_diags); }
    else if wid == 1_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w1, main_env, main_ct, main_interner, main_table, main_diags); }
    else if wid == 2_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w2, main_env, main_ct, main_interner, main_table, main_diags); }
    else if wid == 3_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w3, main_env, main_ct, main_interner, main_table, main_diags); }
    else if wid == 4_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w4, main_env, main_ct, main_interner, main_table, main_diags); }
    else if wid == 5_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w5, main_env, main_ct, main_interner, main_table, main_diags); }
    else if wid == 6_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w6, main_env, main_ct, main_interner, main_table, main_diags); }
    else if wid == 7_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w7, main_env, main_ct, main_interner, main_table, main_diags); }
    else if wid == 8_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w8, main_env, main_ct, main_interner, main_table, main_diags); }
    else if wid == 9_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w9, main_env, main_ct, main_interner, main_table, main_diags); }
    else if wid == 10_u32 { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w10, main_env, main_ct, main_interner, main_table, main_diags); }
    else { try merge_single_check_item(alloc, r, base_ty_count, base_ct_count, base_sym_count, w11, main_env, main_ct, main_interner, main_table, main_diags); }
    return;
}

fn run_check_parallel_items(
    alloc: *mut AllocCap,
    nw: usize,
    items: *[CheckWorkItem],
    arena: *ast.AstArena,
    prog: *mut resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    ct: *mut ctvm.CtArena,
    interner: *mut span.SymInterner,
    table: *mut TypeTable,
    diags: *mut diag.DiagBag,
) -> !OutOfMemory {
    let n = items.len;
    var order = try col.DynBuf.[u32].init(alloc, n);
    errdefer order.destroy(alloc);
    var results = try col.DynBuf.[CheckWorkRes].init(alloc, n);
    errdefer results.destroy(alloc);
    var i: usize = 0_usize;
    while i < n {
        try order.push(alloc, i.trunc.[u32]());
        try results.push(alloc, check_work_res_empty());
        i = i +% 1_usize;
    }
    sort_check_work_order_desc(order.as_mut_slice(), items);

    let base_ty_count = env.ty_count();
    let base_ct_count = ct.val_count();
    let base_sym_count = interner.len();

    var w0 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 0_usize < nw); errdefer w0.destroy(alloc);
    var w1 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 1_usize < nw); errdefer w1.destroy(alloc);
    var w2 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 2_usize < nw); errdefer w2.destroy(alloc);
    var w3 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 3_usize < nw); errdefer w3.destroy(alloc);
    var w4 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 4_usize < nw); errdefer w4.destroy(alloc);
    var w5 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 5_usize < nw); errdefer w5.destroy(alloc);
    var w6 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 6_usize < nw); errdefer w6.destroy(alloc);
    var w7 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 7_usize < nw); errdefer w7.destroy(alloc);
    var w8 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 8_usize < nw); errdefer w8.destroy(alloc);
    var w9 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 9_usize < nw); errdefer w9.destroy(alloc);
    var w10 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 10_usize < nw); errdefer w10.destroy(alloc);
    var w11 = try WorkerCheckState.init(alloc, prog, env, ct, interner, 11_usize < nw); errdefer w11.destroy(alloc);

    var next_pos = sync.AtomicCounter.init(0_u64);
    dispatch_check_workers(
        nw, alloc, &mut next_pos, order.as_slice(), items, results.as_mut_slice(), arena,
        &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
        &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
    );
    try check_workers_oom(&w0, &w1, &w2, &w3, &w4, &w5, &w6, &w7, &w8, &w9, &w10, &w11);

    let total_et = w0.table.expr_tys.len() +% w1.table.expr_tys.len() +% w2.table.expr_tys.len() +% w3.table.expr_tys.len()
        +% w4.table.expr_tys.len() +% w5.table.expr_tys.len() +% w6.table.expr_tys.len() +% w7.table.expr_tys.len()
        +% w8.table.expr_tys.len() +% w9.table.expr_tys.len() +% w10.table.expr_tys.len() +% w11.table.expr_tys.len();
    let total_st = w0.table.span_tys.len() +% w1.table.span_tys.len() +% w2.table.span_tys.len() +% w3.table.span_tys.len()
        +% w4.table.span_tys.len() +% w5.table.span_tys.len() +% w6.table.span_tys.len() +% w7.table.span_tys.len()
        +% w8.table.span_tys.len() +% w9.table.span_tys.len() +% w10.table.span_tys.len() +% w11.table.span_tys.len();
    try table.expr_tys.reserve(alloc, total_et);
    try table.span_tys.reserve(alloc, total_st);

    let rs = results.as_slice();
    var ri: usize = 0_usize;
    while ri < rs.len {
        if rs[ri].has_res {
            try merge_check_item_dispatch(
                alloc, &rs[ri], base_ty_count, base_ct_count, base_sym_count,
                env, ct, interner, table, diags,
                &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
                &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
            );
        }
        ri = ri +% 1_usize;
    }

    if nw > 0_usize { prog.merge_used_from(&w0.prog); }
    if nw > 1_usize { prog.merge_used_from(&w1.prog); }
    if nw > 2_usize { prog.merge_used_from(&w2.prog); }
    if nw > 3_usize { prog.merge_used_from(&w3.prog); }
    if nw > 4_usize { prog.merge_used_from(&w4.prog); }
    if nw > 5_usize { prog.merge_used_from(&w5.prog); }
    if nw > 6_usize { prog.merge_used_from(&w6.prog); }
    if nw > 7_usize { prog.merge_used_from(&w7.prog); }
    if nw > 8_usize { prog.merge_used_from(&w8.prog); }
    if nw > 9_usize { prog.merge_used_from(&w9.prog); }
    if nw > 10_usize { prog.merge_used_from(&w10.prog); }
    if nw > 11_usize { prog.merge_used_from(&w11.prog); }

    w11.destroy(alloc); w10.destroy(alloc); w9.destroy(alloc); w8.destroy(alloc);
    w7.destroy(alloc); w6.destroy(alloc); w5.destroy(alloc); w4.destroy(alloc);
    w3.destroy(alloc); w2.destroy(alloc); w1.destroy(alloc); w0.destroy(alloc);
    results.destroy(alloc);
    order.destroy(alloc);
    return;
}

pub fn check_program_with_jobs(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    unit_ids: *[u32],
    prog: *mut resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    ct: *mut ctvm.CtArena,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
    jobs: u32,
) -> TypeTable ! OutOfMemory {
    _ = unit_ids.len;
    try ctvm.eval_all_consts(alloc, ct, arena, prog, env, interner, diags);
    try check_impl_conformance(alloc, prog, env, interner, diags);

    var table = try TypeTable.init(alloc);
    errdefer table.destroy(alloc);

    var items = try col.DynBuf.[CheckWorkItem].init(alloc, 64_usize);
    errdefer items.destroy(alloc);
    try collect_check_work_items(alloc, arena, prog, env, &mut items);

    var nw: usize = 1_usize;
    if jobs == 1_u32 {
        nw = 1_usize;
    } else if jobs > 1_u32 {
        nw = jobs.widen.[usize]();
        if nw > 12_usize { nw = 12_usize; }
        if nw > items.len() { nw = items.len(); }
    } else {
        let ni = items.len();
        if ni < 64_usize {
            nw = 1_usize;
        } else if ni < 192_usize {
            nw = 4_usize;
        } else if ni < 480_usize {
            nw = 8_usize;
        } else {
            nw = 12_usize;
        }
    }

    if items.len() < 64_usize {
        var st = try FnState.init(alloc);
        errdefer st.destroy(alloc);
        try check_top_level_defs(alloc, arena, prog, env, ct, &mut table, interner, diags, &mut st);
        try check_impl_methods(alloc, arena, prog, env, ct, &mut table, interner, diags, &mut st);
        st.destroy(alloc);
    } else {
        _ = try interner.intern_str(alloc, "self");
        _ = try interner.intern_str(alloc, "_");
        _ = try interner.intern_str(alloc, "_pool");
        try run_check_parallel_items(
            alloc, nw, items.as_slice(), arena, prog, env, ct, interner, &mut table, diags,
        );
    }

    try prog.check_unused_module_items(alloc, diags);
    items.destroy(alloc);
    return table;
}

pub fn check_program(
    alloc: *mut AllocCap,
    arena: *ast.AstArena,
    unit_ids: *[u32],
    prog: *mut resolve.ResolvedProgram,
    env: *mut types.TypeEnv,
    ct: *mut ctvm.CtArena,
    interner: *mut span.SymInterner,
    diags: *mut diag.DiagBag,
) -> TypeTable ! OutOfMemory {
    return try check_program_with_jobs(
        alloc, arena, unit_ids, prog, env, ct, interner, diags, 0_u32,
    );
}
