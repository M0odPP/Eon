module eonc.interp;

import core.col;
import core.str;
import eonc.span;
import eonc.ast;
import eonc.resolve;
import eonc.types;
import eonc.ctvm;
import eonc.cfg_ir;
import eonc.build_sys;
import eonc.eir;

// ===========================================================================
// Section 1: Public Types, Constants, LE Helpers, 128-bit Int & IEEE-754 Math
// ===========================================================================

pub const DEFAULT_STEP_LIMIT: u64 = 50000000_u64;

const MAX_CALL_DEPTH: u32 = 512_u32;
const MAX_ALLOC_BYTES: usize = 1073741824_usize; // 1 << 30
const POISON_BYTE: u8 = 0xDE_u8;

const VAL_VOID: u8 = 0_u8;
const VAL_SCALAR: u8 = 1_u8;
const VAL_BYTES: u8 = 2_u8;

const PT_ADDR: u8 = 0_u8;
const PT_SLICE_VAL: u8 = 1_u8;
const PT_BITFIELD: u8 = 2_u8;

const ERR_OOM: u32 = 7_u32;
const ERR_BOUNDS: u32 = 4_u32;
const ERR_UTF8: u32 = 5_u32;
const ERR_STALE_ID: u32 = 11_u32;
const ERR_NOT_FOUND: u32 = 12_u32;
const ERR_PERM: u32 = 13_u32;
const ERR_PATH_ESCAPE: u32 = 14_u32;
const ERR_ALREADY_EXISTS: u32 = 15_u32;
const ERR_INVALID_INPUT: u32 = 16_u32;
const ERR_OTHER: u32 = 17_u32;

pub linear struct InterpResult {
    pub ok: bool;
    pub exit_code: i32;
    pub stdout: str.StrBuf;
    pub stderr: str.StrBuf;
    pub err_msg: str.StrBuf;
    pub steps: u64;
}

impl InterpResult {
    pub fn destroy(self: InterpResult, alloc: *mut AllocCap) {
        let InterpResult.{ ok: _, exit_code: _, stdout, stderr, err_msg, steps: _ } = self;
        stdout.destroy(alloc);
        stderr.destroy(alloc);
        err_msg.destroy(alloc);
    }
}

struct PairU64 {
    a: u64;
    b: u64;
}

struct PtrTemp {
    ptr: u64;
    temp: u64;
}

fn max_usize(a: usize, b: usize) -> usize {
    return if a > b { a } else { b };
}

fn min_usize(a: usize, b: usize) -> usize {
    return if a < b { a } else { b };
}

fn clamp_usize(v: usize, lo: usize, hi: usize) -> usize {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    return v;
}

fn pack_u64_u32(hi: u32, lo: u32) -> u64 {
    return (hi.widen.[u64]() <<% 32_u64) | lo.widen.[u64]();
}

fn read_le_u32_at(bs: *[u8], off: usize) -> u32 {
    var acc: u32 = 0_u32;
    var i: usize = 0_usize;
    while i < 4_usize {
        let idx = off +% i;
        if idx >= bs.len {
            break;
        }
        acc = acc | (bs[idx].widen.[u32]() <<% (i.trunc.[u32]() *% 8_u32));
        i = i +% 1_usize;
    }
    return acc;
}

fn read_le_u64_at(bs: *[u8], off: usize) -> u64 {
    var acc: u64 = 0_u64;
    var i: usize = 0_usize;
    while i < 8_usize {
        let idx = off +% i;
        if idx >= bs.len {
            break;
        }
        acc = acc | (bs[idx].widen.[u64]() <<% (i.trunc.[u64]() *% 8_u64));
        i = i +% 1_usize;
    }
    return acc;
}

fn write_le_u32_at(dst: *mut [u8], off: usize, v: u32) {
    var i: usize = 0_usize;
    while i < 4_usize {
        let idx = off +% i;
        if idx >= dst.len {
            break;
        }
        let sh = (i.trunc.[u32]() *% 8_u32) & 31_u32;
        dst[idx] = ((v >> sh) & 0xFF_u32).trunc.[u8]();
        i = i +% 1_usize;
    }
}

fn write_le_u64_at(dst: *mut [u8], off: usize, v: u64, n: usize) {
    let lim = min_usize(n, 8_usize);
    var i: usize = 0_usize;
    while i < lim {
        let idx = off +% i;
        if idx >= dst.len {
            break;
        }
        let sh = (i.trunc.[u64]() *% 8_u64) & 63_u64;
        dst[idx] = ((v >> sh) & 0xFF_u64).trunc.[u8]();
        i = i +% 1_usize;
    }
}

fn copy_bytes_slice(dst: *mut [u8], dst_off: usize, src: *[u8], src_off: usize, n: usize) {
    var i: usize = 0_usize;
    while i < n {
        let di = dst_off +% i;
        let si = src_off +% i;
        if di >= dst.len || si >= src.len {
            break;
        }
        dst[di] = src[si];
        i = i +% 1_usize;
    }
}

fn zero_bytes_slice(dst: *mut [u8], off: usize, n: usize) {
    var i: usize = 0_usize;
    while i < n {
        let di = off +% i;
        if di >= dst.len {
            break;
        }
        dst[di] = 0_u8;
        i = i +% 1_usize;
    }
}

fn push_zero_bytes(alloc: *mut AllocCap, buf: *mut col.DynBuf[u8], count: usize) -> !OutOfMemory {
    if count == 0_usize {
        return;
    }
    try buf.reserve(alloc, count);
    let zeros: [64]u8 = [0_u8; 64];
    let zref: *[u8] = &zeros;
    var rem = count;
    while rem >= 64_usize {
        try buf.push_slice(alloc, zref);
        rem = rem -% 64_usize;
    }
    if rem > 0_usize {
        let tail = zref.sub(0_usize, rem) catch {
            return;
        };
        try buf.push_slice(alloc, tail);
    }
    return;
}

fn interp_ty_size(env: *types.TypeEnv, ty: types.TyId) -> usize {
    let n = env.get(ty);
    if n.kind == .Builtin {
        match n.builtin_kind {
            .AllocCap => { return 40_usize; }
            .Env => { return 88_usize; }
            .ArgsCap => { return 16_usize; }
            .BuildCap => { return 16_usize; }
            .FsCap => { return 8_usize; }
            .DirCap => { return 8_usize; }
            .NetCap => { return 8_usize; }
            .ClockCap => { return 8_usize; }
            .IoCap => { return 8_usize; }
            _ => {}
        }
    }
    return env.x64_layout(ty).size;
}

fn mask_bits(bits: u8) -> u64 {
    if bits >= 64_u8 {
        return 0xFFFFFFFFFFFFFFFF_u64;
    }
    if bits == 0_u8 {
        return 0_u64;
    }
    return (1_u64 <<% bits.widen.[u64]()) -% 1_u64;
}

fn sign_extend_i128(raw_b: u64, bits: u8, signed: bool) -> types.IntVal {
    let masked = raw_b & mask_bits(bits);
    if !signed || bits == 0_u8 {
        return types.int_val_from_u64(masked);
    }
    if bits >= 64_u8 {
        return types.int_val_from_i64(masked.bitcast.[i64]());
    }
    let sh_u8: u8 = 64_u8 - bits;
    let shift = sh_u8.widen.[u64]();
    let sh_i: i64 = sh_u8.widen.[i64]();
    let s64 = (masked <<% shift).bitcast.[i64]() >> (sh_i & 63_i64);
    return types.int_val_from_i64(s64);
}

struct IntRange128 {
    lo: types.IntVal;
    hi: types.IntVal;
}

fn int_bounds_for(bits: u8, signed: bool) -> IntRange128 {
    if bits >= 128_u8 {
        if signed {
            return IntRange128.{
                lo: types.int_val_min_i128(),
                hi: types.int_val_max_i128(),
            };
        }
        return IntRange128.{
            lo: types.int_val_zero(),
            hi: types.int_val_max_i128(),
        };
    }
    if signed {
        if bits <= 1_u8 {
            return IntRange128.{
                lo: types.int_val_from_i64(-1_i64),
                hi: types.int_val_zero(),
            };
        }
        if bits == 64_u8 {
            return IntRange128.{
                lo: types.int_val_from_i64(0x8000000000000000_u64.bitcast.[i64]()),
                hi: types.int_val_from_i64(0x7FFFFFFFFFFFFFFF_i64),
            };
        }
        if bits < 64_u8 {
            let half = 1_u64 <<% (bits -% 1_u8).widen.[u64]();
            return IntRange128.{
                lo: types.int_val_from_i64((0_u64 -% half).bitcast.[i64]()),
                hi: types.int_val_from_u64(half -% 1_u64),
            };
        }
        let one = types.int_val_from_u64(1_u64);
        let half128 = types.int_val_shl(one, (bits -% 1_u8).widen.[u32]());
        let hi128 = types.int_val_checked_sub(half128, one) orelse types.int_val_max_i128();
        let lo128 = types.int_val_checked_neg(half128) orelse types.int_val_min_i128();
        return IntRange128.{ lo: lo128, hi: hi128 };
    }
    if bits <= 64_u8 {
        return IntRange128.{
            lo: types.int_val_zero(),
            hi: types.int_val_from_u64(mask_bits(bits)),
        };
    }
    let one = types.int_val_from_u64(1_u64);
    let hi128 = types.int_val_checked_sub(types.int_val_shl(one, bits.widen.[u32]()), one)
        orelse types.int_val_max_i128();
    return IntRange128.{ lo: types.int_val_zero(), hi: hi128 };
}

fn u64_mul_wide(a: u64, b: u64) -> types.U128Val {
    let a0 = a & 0xFFFFFFFF_u64;
    let a1 = a >> 32_u64;
    let b0 = b & 0xFFFFFFFF_u64;
    let b1 = b >> 32_u64;
    let p00 = a0 *% b0;
    let p01 = a0 *% b1;
    let p10 = a1 *% b0;
    let p11 = a1 *% b1;
    let mid = (p00 >> 32_u64) +% (p01 & 0xFFFFFFFF_u64) +% (p10 & 0xFFFFFFFF_u64);
    let lo = (p00 & 0xFFFFFFFF_u64) | (mid <<% 32_u64);
    let hi = p11 +% (p01 >> 32_u64) +% (p10 >> 32_u64) +% (mid >> 32_u64);
    return types.U128Val.{ lo: lo, hi: hi };
}

fn f16_bits_to_f32_bits(h: u16) -> u32 {
    let sign = ((h >> 15_u16).widen.[u32]()) <<% 31_u32;
    let exp = ((h >> 10_u16) & 0x1F_u16).widen.[u32]();
    let frac = (h & 0x03FF_u16).widen.[u32]();
    if exp == 0_u32 {
        if frac == 0_u32 {
            return sign;
        }
        var f = frac;
        var e: i32 = 127_i32 -% 14_i32;
        while (f & 0x0400_u32) == 0_u32 {
            f = f <<% 1_u32;
            e = e -% 1_i32;
        }
        f = f & 0x03FF_u32;
        return sign | (e.bitcast.[u32]() <<% 23_u32) | (f <<% 13_u32);
    }
    if exp == 31_u32 {
        return sign | (0xFF_u32 <<% 23_u32) | (frac <<% 13_u32);
    }
    return sign | ((exp +% (127_u32 -% 15_u32)) <<% 23_u32) | (frac <<% 13_u32);
}

fn f32_bits_to_f16_bits(bits: u32) -> u16 {
    let sign = ((bits >> 16_u32) & 0x8000_u32).trunc.[u16]();
    let exp = ((bits >> 23_u32) & 0xFF_u32).bitcast.[i32]();
    let frac = bits & 0x007FFFFF_u32;
    if exp == 0xFF_i32 {
        if frac != 0_u32 {
            let p = (frac >> 13_u32).trunc.[u16]();
            return sign | 0x7C00_u16 | (if p == 0_u16 { 1_u16 } else { p });
        }
        return sign | 0x7C00_u16;
    }
    let unbiased = exp -% 127_i32;
    if unbiased > 15_i32 {
        return sign | 0x7C00_u16;
    }
    if unbiased < -24_i32 {
        return sign;
    }
    if unbiased < -14_i32 {
        let full = frac | 0x00800000_u32;
        let shift = ((-14_i32 -% unbiased).bitcast.[u32]() +% 13_u32) & 31_u32;
        let mant = full >> shift;
        let rem = full & ((1_u32 <<% shift) -% 1_u32);
        let half = 1_u32 <<% (shift -% 1_u32);
        let round: u32 = if rem > half || (rem == half && (mant & 1_u32) != 0_u32) {
            1_u32
        } else {
            0_u32
        };
        return sign | (mant +% round).trunc.[u16]();
    }
    let h_exp = ((unbiased +% 15_i32).bitcast.[u32]()) <<% 10_u32;
    let mant = frac >> 13_u32;
    let rem = frac & 0x1FFF_u32;
    let round: u32 = if rem > 0x1000_u32 || (rem == 0x1000_u32 && (mant & 1_u32) != 0_u32) {
        1_u32
    } else {
        0_u32
    };
    return sign | (h_exp +% mant +% round).trunc.[u16]();
}

fn f64_bits_to_f32_bits(bits: u64) -> u32 {
    let sign = ((bits >> 32_u64) & 0x80000000_u64).trunc.[u32]();
    let exp = ((bits >> 52_u64) & 0x7FF_u64).trunc.[i32]();
    let frac = bits & 0x000FFFFFFFFFFFFF_u64;
    if exp == 0x7FF_i32 {
        if frac != 0_u64 {
            let payload = (frac >> 29_u64).trunc.[u32]();
            return sign | 0x7F800000_u32 | (if payload == 0_u32 { 1_u32 } else { payload });
        }
        return sign | 0x7F800000_u32;
    }
    if exp == 0_i32 {
        return sign;
    }
    let unbiased = exp -% 1023_i32;
    if unbiased > 127_i32 {
        return sign | 0x7F800000_u32;
    }
    if unbiased < -149_i32 {
        return sign;
    }
    if unbiased < -126_i32 {
        let full = frac | 0x0010000000000000_u64;
        let shift = (((-126_i32 -% unbiased).bitcast.[u32]() +% 29_u32).widen.[u64]()) & 63_u64;
        let mant = (full >> shift).trunc.[u32]();
        let rem = full & ((1_u64 <<% shift) -% 1_u64);
        let half = 1_u64 <<% (shift -% 1_u64);
        let round: u32 = if rem > half || (rem == half && (mant & 1_u32) != 0_u32) {
            1_u32
        } else {
            0_u32
        };
        return sign | (mant +% round);
    }
    let f_exp = ((unbiased +% 127_i32).bitcast.[u32]()) <<% 23_u32;
    let mant = (frac >> 29_u64).trunc.[u32]();
    let rem = frac & 0x1FFFFFFF_u64;
    let round: u32 = if rem > 0x10000000_u64 || (rem == 0x10000000_u64 && (mant & 1_u32) != 0_u32) {
        1_u32
    } else {
        0_u32
    };
    return sign | (f_exp +% mant +% round);
}

fn f32_total_key(bits: u32) -> i32 {
    let b = bits.bitcast.[i32]();
    let mask = ((b >> 31_i32).bitcast.[u32]() >> 1_u32).bitcast.[i32]();
    return b ^ mask;
}

fn f64_total_key(bits: u64) -> i64 {
    let b = bits.bitcast.[i64]();
    let mask = ((b >> 63_i64).bitcast.[u64]() >> 1_u64).bitcast.[i64]();
    return b ^ mask;
}

fn parse_f64_bytes(bytes: *[u8]) -> f64 {
    var i: usize = 0_usize;
    var neg = false;
    if i < bytes.len && bytes[i] == b'-' {
        neg = true;
        i = i +% 1_usize;
    } else if i < bytes.len && bytes[i] == b'+' {
        i = i +% 1_usize;
    }
    var sig: u64 = 0_u64;
    var dec_exp: i32 = 0_i32;
    var in_frac = false;
    while i < bytes.len {
        let ch = bytes[i];
        if ch == b'_' {
            i = i +% 1_usize;
            continue;
        }
        if ch == b'.' && !in_frac {
            in_frac = true;
            i = i +% 1_usize;
            continue;
        }
        if ch == b'e' || ch == b'E' {
            i = i +% 1_usize;
            break;
        }
        if ch >= b'0' && ch <= b'9' {
            let d = (ch - b'0').widen.[u64]();
            if sig < 1000000000000000000_u64 {
                sig = sig *% 10_u64 +% d;
                if in_frac {
                    dec_exp = dec_exp -% 1_i32;
                }
            } else if !in_frac {
                dec_exp = dec_exp +% 1_i32;
            }
            i = i +% 1_usize;
            continue;
        }
        break;
    }
    if i < bytes.len {
        var exp_neg = false;
        if bytes[i] == b'-' {
            exp_neg = true;
            i = i +% 1_usize;
        } else if bytes[i] == b'+' {
            i = i +% 1_usize;
        }
        var eacc: i32 = 0_i32;
        while i < bytes.len {
            let ch = bytes[i];
            if ch == b'_' {
                i = i +% 1_usize;
                continue;
            }
            if ch >= b'0' && ch <= b'9' {
                if eacc < 10000_i32 {
                    eacc = eacc *% 10_i32 +% (ch - b'0').widen.[i32]();
                }
                i = i +% 1_usize;
                continue;
            }
            break;
        }
        dec_exp = if exp_neg { dec_exp -% eacc } else { dec_exp +% eacc };
    }
    var val = sig.to_float.[f64]();
    var p = if dec_exp < 0_i32 { 0_i32 -% dec_exp } else { dec_exp };
    var scale = 1.0_f64;
    var base = 10.0_f64;
    var steps: u32 = 0_u32;
    while p > 0_i32 && steps < 16_u32 {
        if (p & 1_i32) != 0_i32 {
            scale = scale * base;
        }
        base = base * base;
        p = p >> 1_i32;
        steps = steps +% 1_u32;
    }
    val = if dec_exp < 0_i32 { val / scale } else { val * scale };
    return if neg { -val } else { val };
}

fn int_val_to_f64(v: types.IntVal) -> f64 {
    if let small = types.int_val_to_i64(v) {
        return small.to_float.[f64]();
    }
    return v.hi.to_float.[f64]() * 18446744073709551616.0_f64 + v.lo.to_float.[f64]();
}

fn push_f32_fixed2(alloc: *mut AllocCap, bits: u32, out: *mut str.StrBuf) -> !OutOfMemory {
    let sign = (bits >> 31_u32) != 0_u32;
    let exp = (bits >> 23_u32) & 0xFF_u32;
    let frac = bits & 0x007FFFFF_u32;
    if exp == 0xFF_u32 {
        if frac != 0_u32 {
            try out.push_str_grow(alloc, "NaN");
        } else if sign {
            try out.push_str_grow(alloc, "-inf");
        } else {
            try out.push_str_grow(alloc, "inf");
        }
        return;
    }
    if sign {
        try out.push_byte_grow(alloc, b'-');
    }
    let abs_f32 = (bits & 0x7FFFFFFF_u32).bitcast.[f32]();
    let mag = abs_f32.widen.[f64]();
    let scaled = mag * 100.0_f64 + 0.5_f64;
    let total_cents = scaled.trunc_to_int.[u64]();
    let whole = total_cents / 100_u64;
    let cents = total_cents % 100_u64;
    try out.push_u64_grow(alloc, whole);
    try out.push_byte_grow(alloc, b'.');
    try out.push_byte_grow(alloc, b'0' +% (cents / 10_u64).trunc.[u8]());
    try out.push_byte_grow(alloc, b'0' +% (cents % 10_u64).trunc.[u8]());
    return;
}

// ===========================================================================
// Section 2: Virtual Memory (VmMem), ValStore, VmTables, VmHostIo, VmState
// ===========================================================================

struct MemBlockMeta {
    byte_off: usize;
    byte_len: usize;
    alive: bool;
    readonly: bool;
}

struct PtrParts {
    id: u32;
    off: usize;
}

fn encode_ptr(alloc_id: u32, offset: u32) -> u64 {
    return (alloc_id.widen.[u64]() <<% 32_u64) | offset.widen.[u64]();
}

fn decode_ptr(ptr: u64) -> PtrParts {
    return PtrParts.{
        id: (ptr >> 32_u64).trunc.[u32](),
        off: (ptr & 0xFFFFFFFF_u64).trunc.[usize](),
    };
}

linear struct VmMem {
    blocks: col.DynBuf[MemBlockMeta];
    heap: col.DynBuf[u8];
}

impl VmMem {
    fn init(alloc: *mut AllocCap) -> VmMem ! OutOfMemory {
        var blocks = try col.DynBuf.[MemBlockMeta].init(alloc, 64_usize);
        errdefer blocks.destroy(alloc);
        let heap = try col.DynBuf.[u8].init(alloc, 4096_usize);
        errdefer heap.destroy(alloc);
        // Index 0 unused sentinel; valid AllocId = 1..
        try blocks.push(
            alloc,
            MemBlockMeta.{ byte_off: 0_usize, byte_len: 0_usize, alive: false, readonly: true },
        );
        return VmMem.{ blocks: blocks, heap: heap };
    }

    fn destroy(self: VmMem, alloc: *mut AllocCap) {
        let VmMem.{ blocks, heap } = self;
        blocks.destroy(alloc);
        heap.destroy(alloc);
    }
}

/// 16-byte copyable SSA value handle: Scalar(u64) inline, Bytes(off, len) in `ValStore`.
struct ValSlot {
    a: u64;
    len: u32;
    kind: u8;
}

fn val_void() -> ValSlot {
    return ValSlot.{ a: 0_u64, len: 0_u32, kind: VAL_VOID };
}

fn val_scalar(v: u64) -> ValSlot {
    return ValSlot.{ a: v, len: 8_u32, kind: VAL_SCALAR };
}

linear struct ValStore {
    data: col.DynBuf[u8];
    cursor: usize;
}

impl ValStore {
    fn init(alloc: *mut AllocCap) -> ValStore ! OutOfMemory {
        let data = try col.DynBuf.[u8].init(alloc, 2048_usize);
        return ValStore.{ data: data, cursor: 0_usize };
    }

    fn destroy(self: ValStore, alloc: *mut AllocCap) {
        let ValStore.{ data, cursor: _ } = self;
        data.destroy(alloc);
    }

    fn push_bytes(self: *mut Self, alloc: *mut AllocCap, src: *[u8]) -> u32 ! OutOfMemory {
        let off = self.cursor;
        let end = off +% src.len;
        let cur_len = self.data.len();
        if end <= cur_len {
            copy_bytes_slice(self.data.as_mut_slice(), off, src, 0_usize, src.len);
        } else {
            let overlap = if off < cur_len { cur_len - off } else { 0_usize };
            if overlap > 0_usize {
                copy_bytes_slice(self.data.as_mut_slice(), off, src, 0_usize, overlap);
            }
            if overlap < src.len {
                let tail = src.sub(overlap, src.len) catch {
                    return off.trunc.[u32]();
                };
                try self.data.push_slice(alloc, tail);
            }
        }
        self.cursor = end;
        return off.trunc.[u32]();
    }

    view fn slice(self: *Self, off: u32, len: u32) -> *[u8] {
        let all = self.data.as_slice();
        let s = off.widen.[usize]();
        let e = s +% len.widen.[usize]();
        return all.sub(s, e) catch {
            return all.sub(0_usize, 0_usize) catch {
                return all;
            };
        };
    }

    fn from_bytes(self: *mut Self, alloc: *mut AllocCap, b: *[u8]) -> ValSlot ! OutOfMemory {
        if b.len == 0_usize {
            return val_void();
        }
        if b.len <= 8_usize {
            return val_scalar(read_le_u64_at(b, 0_usize));
        }
        let off = try self.push_bytes(alloc, b);
        return ValSlot.{ a: off.widen.[u64](), len: b.len.trunc.[u32](), kind: VAL_BYTES };
    }

    fn from_pair(self: *mut Self, alloc: *mut AllocCap, lo: u64, hi: u64) -> ValSlot ! OutOfMemory {
        var tmp: [16]u8 = [0_u8; 16];
        write_le_u64_at(&mut tmp, 0_usize, lo, 8_usize);
        write_le_u64_at(&mut tmp, 8_usize, hi, 8_usize);
        let tref: *[u8] = &tmp;
        let off = try self.push_bytes(alloc, tref);
        return ValSlot.{ a: off.widen.[u64](), len: 16_u32, kind: VAL_BYTES };
    }

    fn as_u64(self: *Self, v: ValSlot) -> u64 {
        if v.kind == VAL_VOID {
            return 0_u64;
        }
        if v.kind == VAL_SCALAR {
            return v.a;
        }
        return read_le_u64_at(self.slice(v.a.trunc.[u32](), v.len), 0_usize);
    }

    fn as_pair(self: *Self, v: ValSlot) -> PairU64 {
        if v.kind == VAL_VOID {
            return PairU64.{ a: 0_u64, b: 0_u64 };
        }
        if v.kind == VAL_SCALAR {
            return PairU64.{ a: v.a, b: 0_u64 };
        }
        let bs = self.slice(v.a.trunc.[u32](), v.len);
        return PairU64.{ a: read_le_u64_at(bs, 0_usize), b: read_le_u64_at(bs, 8_usize) };
    }

    fn write_bytes_to(self: *Self, v: ValSlot, out: *mut [u8]) {
        zero_bytes_slice(out, 0_usize, out.len);
        if v.kind == VAL_VOID || out.len == 0_usize {
            return;
        }
        if v.kind == VAL_SCALAR {
            write_le_u64_at(out, 0_usize, v.a, min_usize(out.len, 8_usize));
            return;
        }
        let bs = self.slice(v.a.trunc.[u32](), v.len);
        copy_bytes_slice(out, 0_usize, bs, 0_usize, min_usize(out.len, bs.len));
    }

    fn to_dyn_bytes(
        self: *Self,
        alloc: *mut AllocCap,
        v: ValSlot,
        size: usize,
        out: *mut col.DynBuf[u8],
    ) -> !OutOfMemory {
        out.clear();
        if size == 0_usize {
            return;
        }
        try push_zero_bytes(alloc, out, size);
        self.write_bytes_to(v, out.as_mut_slice());
        return;
    }

    fn reset_frame_cursor(self: *mut Self, saved_cursor: usize, ret: ValSlot) -> ValSlot {
        if ret.kind == VAL_BYTES {
            let roff = ret.a.trunc.[usize]();
            let rlen = ret.len.widen.[usize]();
            if roff >= saved_cursor {
                if roff > saved_cursor && rlen > 0_usize {
                    let dst = self.data.as_mut_slice();
                    var i: usize = 0_usize;
                    while i < rlen {
                        let di = saved_cursor +% i;
                        let si = roff +% i;
                        if di < dst.len && si < dst.len {
                            dst[di] = dst[si];
                        }
                        i = i +% 1_usize;
                    }
                }
                self.cursor = saved_cursor +% rlen;
                return ValSlot.{ a: saved_cursor.trunc.[u64](), len: ret.len, kind: VAL_BYTES };
            }
        }
        self.cursor = saved_cursor;
        return ret;
    }
}

linear struct VmTables {
    vtables: col.HashMap[u64];
    vtable_ranges: col.DynBuf[ast.IdRange];
    vtable_methods: col.DynBuf[cfg_ir.CfgFnKey];
    fn_handles: col.HashMap[u64];
    handle_to_fn: col.DynBuf[cfg_ir.CfgFnKey];
    str_interner: col.Interner;
    str_ptrs: col.DynBuf[u64];
}

impl VmTables {
    fn init(alloc: *mut AllocCap) -> VmTables ! OutOfMemory {
        let vtables = try col.HashMap.[u64].init(alloc, 16_usize);
        errdefer vtables.destroy(alloc);
        var vtable_ranges = try col.DynBuf.[ast.IdRange].init(alloc, 16_usize);
        errdefer vtable_ranges.destroy(alloc);
        let vtable_methods = try col.DynBuf.[cfg_ir.CfgFnKey].init(alloc, 32_usize);
        errdefer vtable_methods.destroy(alloc);
        let fn_handles = try col.HashMap.[u64].init(alloc, 16_usize);
        errdefer fn_handles.destroy(alloc);
        var handle_to_fn = try col.DynBuf.[cfg_ir.CfgFnKey].init(alloc, 16_usize);
        errdefer handle_to_fn.destroy(alloc);
        let str_interner = try col.Interner.init(alloc, 32_usize);
        errdefer str_interner.destroy(alloc);
        let str_ptrs = try col.DynBuf.[u64].init(alloc, 32_usize);
        errdefer str_ptrs.destroy(alloc);

        // Index 0 unused sentinels
        try vtable_ranges.push(alloc, ast.range_empty());
        try handle_to_fn.push(alloc, cfg_ir.fn_key_top_def(0_u32));
        return VmTables.{
            vtables: vtables,
            vtable_ranges: vtable_ranges,
            vtable_methods: vtable_methods,
            fn_handles: fn_handles,
            handle_to_fn: handle_to_fn,
            str_interner: str_interner,
            str_ptrs: str_ptrs,
        };
    }

    fn destroy(self: VmTables, alloc: *mut AllocCap) {
        let VmTables.{
            vtables,
            vtable_ranges,
            vtable_methods,
            fn_handles,
            handle_to_fn,
            str_interner,
            str_ptrs,
        } = self;
        vtables.destroy(alloc);
        vtable_ranges.destroy(alloc);
        vtable_methods.destroy(alloc);
        fn_handles.destroy(alloc);
        handle_to_fn.destroy(alloc);
        str_interner.destroy(alloc);
        str_ptrs.destroy(alloc);
    }
}

struct DirRootMeta {
    alive: bool;
    range: ast.IdRange;
}

linear struct VmHostIo {
    dir_roots: col.DynBuf[DirRootMeta];
    dir_bytes: col.DynBuf[u8];
    net_hosts: col.DynBuf[ast.IdRange];
    net_bytes: col.DynBuf[u8];
}

impl VmHostIo {
    fn init(alloc: *mut AllocCap) -> VmHostIo ! OutOfMemory {
        var dir_roots = try col.DynBuf.[DirRootMeta].init(alloc, 8_usize);
        errdefer dir_roots.destroy(alloc);
        var dir_bytes = try col.DynBuf.[u8].init(alloc, 128_usize);
        errdefer dir_bytes.destroy(alloc);
        var net_hosts = try col.DynBuf.[ast.IdRange].init(alloc, 4_usize);
        errdefer net_hosts.destroy(alloc);
        let net_bytes = try col.DynBuf.[u8].init(alloc, 64_usize);
        errdefer net_bytes.destroy(alloc);

        // 0 = invalid, 1 = FsCap root (".")
        try dir_roots.push(alloc, DirRootMeta.{ alive: false, range: ast.range_empty() });
        let dot = ".".as_bytes();
        try dir_bytes.push_slice(alloc, dot);
        try dir_roots.push(alloc, DirRootMeta.{ alive: true, range: ast.range_new(0_u32, 1_u32) });
        // 0 = unrestricted net handle
        try net_hosts.push(alloc, ast.range_empty());

        return VmHostIo.{
            dir_roots: dir_roots,
            dir_bytes: dir_bytes,
            net_hosts: net_hosts,
            net_bytes: net_bytes,
        };
    }

    fn destroy(self: VmHostIo, alloc: *mut AllocCap) {
        let VmHostIo.{ dir_roots, dir_bytes, net_hosts, net_bytes } = self;
        dir_roots.destroy(alloc);
        dir_bytes.destroy(alloc);
        net_hosts.destroy(alloc);
        net_bytes.destroy(alloc);
    }
}

linear struct VmState {
    mem: VmMem;
    vals: ValStore;
    tables: VmTables;
    io: VmHostIo;
    stdout: str.StrBuf;
    stderr: str.StrBuf;
    err_msg: str.StrBuf;
    faulted: bool;
    steps: u64;
    step_limit: u64;
    clock_tick: u64;
    last_clock_ns: u64;
    depth: u32;
}

impl VmState {
    fn init(alloc: *mut AllocCap, step_limit: u64) -> VmState ! OutOfMemory {
        let mem = try VmMem.init(alloc);
        errdefer mem.destroy(alloc);
        let vals = try ValStore.init(alloc);
        errdefer vals.destroy(alloc);
        let tables = try VmTables.init(alloc);
        errdefer tables.destroy(alloc);
        let io = try VmHostIo.init(alloc);
        errdefer io.destroy(alloc);
        let stdout = try str.StrBuf.init(alloc, 256_usize);
        errdefer stdout.destroy(alloc);
        let stderr = try str.StrBuf.init(alloc, 128_usize);
        errdefer stderr.destroy(alloc);
        let err_msg = try str.StrBuf.init(alloc, 128_usize);
        errdefer err_msg.destroy(alloc);
        return VmState.{
            mem: mem,
            vals: vals,
            tables: tables,
            io: io,
            stdout: stdout,
            stderr: stderr,
            err_msg: err_msg,
            faulted: false,
            steps: 0_u64,
            step_limit: step_limit,
            clock_tick: 1000000_u64,
            last_clock_ns: 1000000_u64,
            depth: 0_u32,
        };
    }

    fn into_result(self: VmState, alloc: *mut AllocCap, exit_code: i32) -> InterpResult {
        let VmState.{
            mem,
            vals,
            tables,
            io,
            stdout,
            stderr,
            err_msg,
            faulted,
            steps,
            step_limit: _,
            clock_tick: _,
            last_clock_ns: _,
            depth: _,
        } = self;
        mem.destroy(alloc);
        vals.destroy(alloc);
        tables.destroy(alloc);
        io.destroy(alloc);
        return InterpResult.{
            ok: !faulted,
            exit_code: if faulted { 1_i32 } else { exit_code },
            stdout: stdout,
            stderr: stderr,
            err_msg: err_msg,
            steps: steps,
        };
    }

    fn destroy(self: VmState, alloc: *mut AllocCap) {
        let res = self.into_result(alloc, 0_i32);
        res.destroy(alloc);
    }
}

struct PhiUpdate {
    dst: eir.EirValue;
    val: ValSlot;
}

linear struct FrameState {
    vals: col.DynBuf[ValSlot];
    slot_ptrs: col.DynBuf[u64];
    rvalue_temps: col.DynBuf[u64];
    phi_updates: col.DynBuf[PhiUpdate];
}

impl FrameState {
    fn init(alloc: *mut AllocCap, n_vals: usize, n_slots: usize) -> FrameState ! OutOfMemory {
        var vals = try col.DynBuf.[ValSlot].init(alloc, max_usize(n_vals, 4_usize));
        errdefer vals.destroy(alloc);
        var vi: usize = 0_usize;
        while vi < n_vals {
            try vals.push(alloc, val_void());
            vi = vi +% 1_usize;
        }
        let slot_ptrs = try col.DynBuf.[u64].init(alloc, max_usize(n_slots, 4_usize));
        errdefer slot_ptrs.destroy(alloc);
        let rvalue_temps = try col.DynBuf.[u64].init(alloc, 4_usize);
        errdefer rvalue_temps.destroy(alloc);
        let phi_updates = try col.DynBuf.[PhiUpdate].init(alloc, 4_usize);
        errdefer phi_updates.destroy(alloc);
        return FrameState.{
            vals: vals,
            slot_ptrs: slot_ptrs,
            rvalue_temps: rvalue_temps,
            phi_updates: phi_updates,
        };
    }

    fn get_val(self: *Self, v: eir.EirValue) -> ValSlot {
        let s = self.vals.as_slice();
        let idx = v.widen.[usize]();
        if idx < s.len {
            return s[idx];
        }
        return val_void();
    }

    fn set_val(self: *mut Self, v: eir.EirValue, val: ValSlot) {
        let s = self.vals.as_mut_slice();
        let idx = v.widen.[usize]();
        if idx < s.len {
            s[idx] = val;
        }
    }

    fn get_slot_ptr(self: *Self, slot: eir.EirSlot) -> u64 {
        let s = self.slot_ptrs.as_slice();
        let idx = slot.widen.[usize]();
        if idx < s.len {
            return s[idx];
        }
        return 0_u64;
    }

    fn destroy(self: FrameState, alloc: *mut AllocCap) {
        let FrameState.{ vals, slot_ptrs, rvalue_temps, phi_updates } = self;
        vals.destroy(alloc);
        slot_ptrs.destroy(alloc);
        rvalue_temps.destroy(alloc);
        phi_updates.destroy(alloc);
    }
}

view struct Interp {
    alloc: *mut AllocCap;
    host_fs: *FsCap;
    eir: *eir.EirProgram;
    env: *types.TypeEnv;
    ct: *ctvm.CtArena;
    interner: *span.SymInterner;
    plan: *mut build_sys.BuildPlan;
    st: *mut VmState;
}

// ===========================================================================
// Section 3: Fault Helpers, Checked VmMem Operations, and Host FS Wrappers
// ===========================================================================

impl Interp {
    fn fail(self: *mut Self, msg: *str) -> !OutOfMemory {
        if !self.st.faulted {
            self.st.faulted = true;
            try self.st.err_msg.push_str_grow(self.alloc, msg);
        }
        return;
    }

    fn fail_with_u64(self: *mut Self, prefix: *str, v: u64) -> !OutOfMemory {
        if !self.st.faulted {
            self.st.faulted = true;
            try self.st.err_msg.push_str_grow(self.alloc, prefix);
            try self.st.err_msg.push_u64_grow(self.alloc, v);
        }
        return;
    }

    fn fail_with_bytes(self: *mut Self, prefix: *str, name: *[u8], suffix: *str) -> !OutOfMemory {
        if !self.st.faulted {
            self.st.faulted = true;
            try self.st.err_msg.push_str_grow(self.alloc, prefix);
            try self.st.err_msg.push_bytes_grow(self.alloc, name);
            try self.st.err_msg.push_str_grow(self.alloc, suffix);
        }
        return;
    }

    fn fail_with_sym(self: *mut Self, prefix: *str, sym: u32, suffix: *str) -> !OutOfMemory {
        if !self.st.faulted {
            self.st.faulted = true;
            try self.st.err_msg.push_str_grow(self.alloc, prefix);
            try self.st.err_msg.push_bytes_grow(self.alloc, self.interner.get(sym));
            try self.st.err_msg.push_str_grow(self.alloc, suffix);
        }
        return;
    }

    fn eir_val_at(self: *Self, r: ast.IdRange, idx: usize) -> eir.EirValue {
        let s = self.eir.vals_slice(r);
        if idx < s.len {
            return s[idx];
        }
        return eir.EIR_NONE;
    }

    fn eir_slot_at(self: *Self, r: ast.IdRange, idx: usize) -> eir.EirSlot {
        let s = self.eir.arg_slots_slice(r);
        if idx < s.len {
            return s[idx];
        }
        return eir.EIR_NONE;
    }

    fn pool_col_ty(self: *Self, col_range: ast.IdRange, ci: usize) -> types.TyId {
        let cols = self.env.pool_cols_range(col_range);
        if ci < cols.len {
            return cols[ci].ty;
        }
        return types.TY_U64;
    }

    fn mem_alloc(self: *mut Self, size: usize, readonly: bool) -> u64 ! OutOfMemory {
        if size > MAX_ALLOC_BYTES {
            try self.fail_with_u64("EIR-Interp: allocation too large: ", size.widen.[u64]());
            return 0_u64;
        }
        let id_usize = self.st.mem.blocks.len();
        if id_usize > 0xFFFFFFFF_usize {
            try self.fail("EIR-Interp: allocation table exhausted");
            return 0_u64;
        }
        let off = self.st.mem.heap.len();
        try push_zero_bytes(self.alloc, &mut self.st.mem.heap, size);
        try self.st.mem.blocks.push(
            self.alloc,
            MemBlockMeta.{ byte_off: off, byte_len: size, alive: true, readonly: readonly },
        );
        return encode_ptr(id_usize.trunc.[u32](), 0_u32);
    }

    fn mem_alloc_bytes(self: *mut Self, data: *[u8], readonly: bool) -> u64 ! OutOfMemory {
        if data.len > MAX_ALLOC_BYTES {
            try self.fail_with_u64("EIR-Interp: allocation too large: ", data.len.widen.[u64]());
            return 0_u64;
        }
        let id_usize = self.st.mem.blocks.len();
        if id_usize > 0xFFFFFFFF_usize {
            try self.fail("EIR-Interp: allocation table exhausted");
            return 0_u64;
        }
        let off = self.st.mem.heap.len();
        try self.st.mem.heap.push_slice(self.alloc, data);
        try self.st.mem.blocks.push(
            self.alloc,
            MemBlockMeta.{ byte_off: off, byte_len: data.len, alive: true, readonly: readonly },
        );
        return encode_ptr(id_usize.trunc.[u32](), 0_u32);
    }

    fn mem_free(self: *mut Self, ptr: u64) -> !OutOfMemory {
        if ptr == 0_u64 {
            return;
        }
        let parts = decode_ptr(ptr);
        if parts.off != 0_usize {
            try self.fail("EIR-Interp: freeing interior pointer");
            return;
        }
        let idx = parts.id.widen.[usize]();
        let blks = self.st.mem.blocks.as_mut_slice();
        if idx >= blks.len {
            try self.fail_with_u64("EIR-Interp: freeing invalid allocation id ", parts.id.widen.[u64]());
            return;
        }
        if !blks[idx].alive {
            try self.fail_with_u64("EIR-Interp: double-free / use-after-free of allocation ", parts.id.widen.[u64]());
            return;
        }
        blks[idx].alive = false;
        let boff = blks[idx].byte_off;
        let blen = blks[idx].byte_len;
        let heap = self.st.mem.heap.as_mut_slice();
        var i: usize = 0_usize;
        while i < blen {
            let hi = boff +% i;
            if hi < heap.len {
                heap[hi] = POISON_BYTE;
            }
            i = i +% 1_usize;
        }
        return;
    }

    fn mem_free_quiet(self: *mut Self, ptr: u64) {
        if ptr == 0_u64 {
            return;
        }
        let parts = decode_ptr(ptr);
        if parts.off != 0_usize {
            return;
        }
        let idx = parts.id.widen.[usize]();
        let blks = self.st.mem.blocks.as_mut_slice();
        if idx >= blks.len || !blks[idx].alive {
            return;
        }
        blks[idx].alive = false;
        let boff = blks[idx].byte_off;
        let blen = blks[idx].byte_len;
        let heap = self.st.mem.heap.as_mut_slice();
        var i: usize = 0_usize;
        while i < blen {
            let hi = boff +% i;
            if hi < heap.len {
                heap[hi] = POISON_BYTE;
            }
            i = i +% 1_usize;
        }
    }

    fn mem_ptr_add(self: *mut Self, ptr: u64, delta: usize) -> u64 ! OutOfMemory {
        if delta == 0_usize {
            return ptr;
        }
        if ptr == 0_u64 {
            try self.fail("EIR-Interp: pointer arithmetic on null pointer");
            return 0_u64;
        }
        let parts = decode_ptr(ptr);
        let new_off = (parts.off +? delta) catch {
            try self.fail("EIR-Interp: pointer offset overflow");
            return 0_u64;
        };
        if new_off > 0xFFFFFFFF_usize {
            try self.fail("EIR-Interp: pointer offset overflow");
            return 0_u64;
        }
        return encode_ptr(parts.id, new_off.trunc.[u32]());
    }

    fn mem_validate_access(
        self: *mut Self,
        ptr: u64,
        size: usize,
        is_write: bool,
    ) -> ?usize ! OutOfMemory {
        if size == 0_usize {
            return 0_usize;
        }
        if ptr == 0_u64 {
            if is_write {
                try self.fail("EIR-Interp: null pointer dereference on write");
            } else {
                try self.fail("EIR-Interp: null pointer dereference on read");
            }
            return null;
        }
        let parts = decode_ptr(ptr);
        let idx = parts.id.widen.[usize]();
        let blks = self.st.mem.blocks.as_slice();
        if idx >= blks.len {
            try self.fail_with_u64("EIR-Interp: invalid allocation ", parts.id.widen.[u64]());
            return null;
        }
        let blk = blks[idx];
        if !blk.alive {
            try self.fail_with_u64("EIR-Interp: use-after-free on allocation ", parts.id.widen.[u64]());
            return null;
        }
        if is_write && blk.readonly {
            try self.fail_with_u64("EIR-Interp: write to read-only allocation ", parts.id.widen.[u64]());
            return null;
        }
        let end = (parts.off +? size) catch {
            try self.fail("EIR-Interp: pointer offset overflow");
            return null;
        };
        if end > blk.byte_len {
            try self.fail_with_u64("EIR-Interp: out-of-bounds access on allocation ", parts.id.widen.[u64]());
            return null;
        }
        return blk.byte_off +% parts.off;
    }

    fn mem_read_into(self: *mut Self, ptr: u64, dst: *mut [u8]) -> bool ! OutOfMemory {
        return try self.mem_read_into_n(ptr, dst, dst.len);
    }

    fn mem_read_into_n(self: *mut Self, ptr: u64, dst: *mut [u8], n: usize) -> bool ! OutOfMemory {
        let sz = min_usize(n, dst.len);
        if sz == 0_usize {
            return true;
        }
        let heap_off = try self.mem_validate_access(ptr, sz, false) orelse {
            return false;
        };
        let heap = self.st.mem.heap.as_slice();
        copy_bytes_slice(dst, 0_usize, heap, heap_off, sz);
        return true;
    }

    fn mem_read_dyn(
        self: *mut Self,
        ptr: u64,
        size: usize,
        out: *mut col.DynBuf[u8],
    ) -> bool ! OutOfMemory {
        out.clear();
        if size == 0_usize {
            return true;
        }
        let heap_off = try self.mem_validate_access(ptr, size, false) orelse {
            return false;
        };
        let heap = self.st.mem.heap.as_slice();
        let slice = heap.sub(heap_off, heap_off +% size) catch {
            try self.fail("EIR-Interp: internal heap slice bounds fault");
            return false;
        };
        try out.push_slice(self.alloc, slice);
        return true;
    }

    fn mem_read_val(self: *mut Self, ptr: u64, size: usize) -> ValSlot ! OutOfMemory {
        if size == 0_usize {
            return val_void();
        }
        let heap_off = try self.mem_validate_access(ptr, size, false) orelse {
            return val_void();
        };
        let heap = self.st.mem.heap.as_slice();
        let slice = heap.sub(heap_off, heap_off +% size) catch {
            try self.fail("EIR-Interp: internal heap slice bounds fault");
            return val_void();
        };
        return try self.st.vals.from_bytes(self.alloc, slice);
    }

    fn mem_write(self: *mut Self, ptr: u64, data: *[u8]) -> bool ! OutOfMemory {
        if data.len == 0_usize {
            return true;
        }
        let heap_off = try self.mem_validate_access(ptr, data.len, true) orelse {
            return false;
        };
        copy_bytes_slice(self.st.mem.heap.as_mut_slice(), heap_off, data, 0_usize, data.len);
        return true;
    }

    fn mem_read_u64(self: *mut Self, ptr: u64) -> u64 ! OutOfMemory {
        var buf: [8]u8 = [0_u8; 8];
        if !(try self.mem_read_into(ptr, &mut buf)) {
            return 0_u64;
        }
        return read_le_u64_at(&buf, 0_usize);
    }

    fn mem_read_u32(self: *mut Self, ptr: u64) -> u32 ! OutOfMemory {
        var buf: [4]u8 = [0_u8; 4];
        if !(try self.mem_read_into(ptr, &mut buf)) {
            return 0_u32;
        }
        return read_le_u32_at(&buf, 0_usize);
    }

    fn mem_write_u64(self: *mut Self, ptr: u64, v: u64) -> bool ! OutOfMemory {
        var buf: [8]u8 = [0_u8; 8];
        write_le_u64_at(&mut buf, 0_usize, v, 8_usize);
        return try self.mem_write(ptr, &buf);
    }

    fn mem_write_u32(self: *mut Self, ptr: u64, v: u32) -> bool ! OutOfMemory {
        var buf: [4]u8 = [0_u8; 4];
        write_le_u32_at(&mut buf, 0_usize, v);
        return try self.mem_write(ptr, &buf);
    }

    fn mem_read_u64_off(self: *mut Self, base: u64, off: usize) -> u64 ! OutOfMemory {
        let p = try self.mem_ptr_add(base, off);
        if self.st.faulted {
            return 0_u64;
        }
        return try self.mem_read_u64(p);
    }

    fn mem_read_u32_off(self: *mut Self, base: u64, off: usize) -> u32 ! OutOfMemory {
        let p = try self.mem_ptr_add(base, off);
        if self.st.faulted {
            return 0_u32;
        }
        return try self.mem_read_u32(p);
    }

    fn mem_write_u64_off(self: *mut Self, base: u64, off: usize, v: u64) -> bool ! OutOfMemory {
        let p = try self.mem_ptr_add(base, off);
        if self.st.faulted {
            return false;
        }
        return try self.mem_write_u64(p, v);
    }

    fn mem_write_u32_off(self: *mut Self, base: u64, off: usize, v: u32) -> bool ! OutOfMemory {
        let p = try self.mem_ptr_add(base, off);
        if self.st.faulted {
            return false;
        }
        return try self.mem_write_u32(p, v);
    }

    fn collect_cap_chain(
        self: *mut Self,
        cap_ptr: u64,
        out_chain: *mut [64]u64,
    ) -> usize ! OutOfMemory {
        var cur = cap_ptr;
        var count: usize = 0_usize;
        while cur != 0_u64 {
            if count >= 64_usize {
                try self.fail("EIR-Interp: AllocCap parent chain cycle or depth exceeded");
                return 0_usize;
            }
            var j: usize = 0_usize;
            while j < count {
                if out_chain[j] == cur {
                    try self.fail("EIR-Interp: AllocCap parent chain cycle or depth exceeded");
                    return 0_usize;
                }
                j = j +% 1_usize;
            }
            out_chain[count] = cur;
            count = count +% 1_usize;
            let next_p = try self.mem_ptr_add(cur, 32_usize);
            if self.st.faulted {
                return 0_usize;
            }
            cur = try self.mem_read_u64(next_p);
            if self.st.faulted {
                return 0_usize;
            }
        }
        return count;
    }

    fn alloc_raw_tracked(self: *mut Self, cap_ptr: u64, req_size: usize) -> u64 ! OutOfMemory {
        let delta = req_size.widen.[u64]();
        var chain: [64]u64 = [0_u64; 64];
        let count = try self.collect_cap_chain(cap_ptr, &mut chain);
        if self.st.faulted {
            return 0_u64;
        }
        var i: usize = 0_usize;
        while i < count && i < 64_usize {
            let node = chain[i];
            let p_used = try self.mem_ptr_add(node, 8_usize);
            let p_lim = try self.mem_ptr_add(node, 24_usize);
            if self.st.faulted {
                return 0_u64;
            }
            let used = try self.mem_read_u64(p_used);
            let lim = try self.mem_read_u64(p_lim);
            if self.st.faulted {
                return 0_u64;
            }
            let new_used = (used +? delta) catch {
                return 0_u64;
            };
            if lim != 0_u64 && new_used > lim {
                return 0_u64;
            }
            i = i +% 1_usize;
        }
        let actual = max_usize(req_size, 1_usize);
        let ptr = try self.mem_alloc(actual, false);
        if self.st.faulted || ptr == 0_u64 {
            return 0_u64;
        }
        var k: usize = 0_usize;
        while k < count && k < 64_usize {
            let node = chain[k];
            let p_used = try self.mem_ptr_add(node, 8_usize);
            let p_peak = try self.mem_ptr_add(node, 16_usize);
            let live = try self.mem_read_u64(node);
            let used = try self.mem_read_u64(p_used);
            let peak = try self.mem_read_u64(p_peak);
            if self.st.faulted {
                return 0_u64;
            }
            let new_used = used +% delta;
            _ = try self.mem_write_u64(node, live +% 1_u64);
            _ = try self.mem_write_u64(p_used, new_used);
            if new_used > peak {
                _ = try self.mem_write_u64(p_peak, new_used);
            }
            if self.st.faulted {
                return 0_u64;
            }
            k = k +% 1_usize;
        }
        return ptr;
    }

    fn free_raw_tracked(self: *mut Self, cap_ptr: u64, ptr: u64, req_size: usize) -> !OutOfMemory {
        if ptr == 0_u64 {
            return;
        }
        try self.mem_free(ptr);
        if self.st.faulted {
            return;
        }
        let delta = req_size.widen.[u64]();
        var chain: [64]u64 = [0_u64; 64];
        let count = try self.collect_cap_chain(cap_ptr, &mut chain);
        if self.st.faulted {
            return;
        }
        var k: usize = 0_usize;
        while k < count && k < 64_usize {
            let node = chain[k];
            let p_used = try self.mem_ptr_add(node, 8_usize);
            let live = try self.mem_read_u64(node);
            let used = try self.mem_read_u64(p_used);
            if self.st.faulted {
                return;
            }
            let new_live = if live > 0_u64 { live -% 1_u64 } else { 0_u64 };
            let new_used = if used >= delta { used -% delta } else { 0_u64 };
            _ = try self.mem_write_u64(node, new_live);
            _ = try self.mem_write_u64(p_used, new_used);
            k = k +% 1_usize;
        }
        return;
    }
}

// --- Safe Host FS Helpers (Linear `DirCap` / `Buf[u8]` Leak-Free Wrappers) ---

fn map_void_io_err(r: void ! IoError) -> u32 {
    match r {
        .NotFound => { return ERR_NOT_FOUND; }
        .PermissionDenied => { return ERR_PERM; }
        .PathEscape => { return ERR_PATH_ESCAPE; }
        .AlreadyExists => { return ERR_ALREADY_EXISTS; }
        .InvalidInput => { return ERR_INVALID_INPUT; }
        .Other => { return ERR_OTHER; }
        _ => { return 0_u32; }
    }
}

fn map_void_io_oom_err(r: void ! IoError | OutOfMemory) -> u32 {
    match r {
        .OutOfMemory => { return ERR_OOM; }
        .NotFound => { return ERR_NOT_FOUND; }
        .PermissionDenied => { return ERR_PERM; }
        .PathEscape => { return ERR_PATH_ESCAPE; }
        .AlreadyExists => { return ERR_ALREADY_EXISTS; }
        .InvalidInput => { return ERR_INVALID_INPUT; }
        .Other => { return ERR_OTHER; }
        _ => { return 0_u32; }
    }
}

fn host_open_dir_inner(host_fs: *FsCap, path: *str) -> !IoError {
    let d = try host_fs.open_dir(path);
    d.close();
    return;
}

fn host_open_dir_code(host_fs: *FsCap, path: *str) -> u32 {
    return map_void_io_err(host_open_dir_inner(host_fs, path));
}

fn host_dir_sub_dir_inner(host_fs: *FsCap, root: *str, rel: *str) -> !IoError {
    let d = try host_fs.open_dir(root);
    errdefer d.close();
    let sd = try d.sub_dir(rel);
    sd.close();
    d.close();
    return;
}

fn host_dir_sub_dir_code(host_fs: *FsCap, root: *str, rel: *str) -> u32 {
    return map_void_io_err(host_dir_sub_dir_inner(host_fs, root, rel));
}

fn host_read_file_inner(
    host_fs: *FsCap,
    alloc: *mut AllocCap,
    path: *str,
    out: *mut col.DynBuf[u8],
) -> !IoError | OutOfMemory {
    let b = try host_fs.read_file(alloc, path);
    errdefer b.destroy(alloc);
    try out.push_slice(alloc, b.as_slice());
    b.destroy(alloc);
    return;
}

fn host_read_file_code(
    host_fs: *FsCap,
    alloc: *mut AllocCap,
    path: *str,
    out: *mut col.DynBuf[u8],
) -> u32 {
    return map_void_io_oom_err(host_read_file_inner(host_fs, alloc, path, out));
}

fn host_dir_read_file_inner(
    host_fs: *FsCap,
    alloc: *mut AllocCap,
    root: *str,
    rel: *str,
    out: *mut col.DynBuf[u8],
) -> !IoError | OutOfMemory {
    let d = try host_fs.open_dir(root);
    errdefer d.close();
    let b = try d.read_file(alloc, rel);
    errdefer b.destroy(alloc);
    try out.push_slice(alloc, b.as_slice());
    b.destroy(alloc);
    d.close();
    return;
}

fn host_dir_read_file_code(
    host_fs: *FsCap,
    alloc: *mut AllocCap,
    root: *str,
    rel: *str,
    out: *mut col.DynBuf[u8],
) -> u32 {
    return map_void_io_oom_err(host_dir_read_file_inner(host_fs, alloc, root, rel, out));
}

fn host_dir_write_file_inner(host_fs: *FsCap, root: *str, rel: *str, data: *[u8]) -> !IoError {
    let d = try host_fs.open_dir(root);
    errdefer d.close();
    try d.write_file(rel, data);
    d.close();
    return;
}

fn host_dir_write_file_code(host_fs: *FsCap, root: *str, rel: *str, data: *[u8]) -> u32 {
    return map_void_io_err(host_dir_write_file_inner(host_fs, root, rel, data));
}

fn host_list_dir_inner(
    host_fs: *FsCap,
    alloc: *mut AllocCap,
    path: *str,
    out: *mut col.DynBuf[u8],
) -> !IoError | OutOfMemory {
    let b = try host_fs.list_dir(alloc, path);
    errdefer b.destroy(alloc);
    try out.push_slice(alloc, b.as_slice());
    b.destroy(alloc);
    return;
}

fn host_list_dir_code(
    host_fs: *FsCap,
    alloc: *mut AllocCap,
    path: *str,
    out: *mut col.DynBuf[u8],
) -> u32 {
    return map_void_io_oom_err(host_list_dir_inner(host_fs, alloc, path, out));
}

fn host_spawn_wait_inner(
    host_fs: *FsCap,
    path: *str,
    args_nul: *[u8],
    rc_out: *mut i32,
) -> !IoError {
    let rc = try host_fs.spawn_wait(path, args_nul);
    rc_out.* = rc;
    return;
}

fn host_spawn_wait_code(host_fs: *FsCap, path: *str, args_nul: *[u8], rc_out: *mut i32) -> u32 {
    return map_void_io_err(host_spawn_wait_inner(host_fs, path, args_nul, rc_out));
}

fn cmp_byte_slices(a: *[u8], b: *[u8]) -> i32 {
    var i: usize = 0_usize;
    while i < a.len && i < b.len {
        if a[i] < b[i] {
            return -1_i32;
        }
        if a[i] > b[i] {
            return 1_i32;
        }
        i = i +% 1_usize;
    }
    if a.len < b.len {
        return -1_i32;
    }
    if a.len > b.len {
        return 1_i32;
    }
    return 0_i32;
}

fn sort_newline_entries(
    alloc: *mut AllocCap,
    raw_b: *[u8],
    sorted_out: *mut col.DynBuf[u8],
) -> !OutOfMemory {
    sorted_out.clear();
    var ranges = try col.DynBuf.[ast.IdRange].init(alloc, 16_usize);
    errdefer ranges.destroy(alloc);
    var start: usize = 0_usize;
    var i: usize = 0_usize;
    while i <= raw_b.len {
        var at_end = i == raw_b.len;
        if !at_end && i < raw_b.len {
            at_end = raw_b[i] == b'\n';
        }
        if at_end {
            if i > start {
                let seg = raw_b.sub(start, i) catch {
                    start = i +% 1_usize;
                    i = i +% 1_usize;
                    continue;
                };
                if !str.bytes_eq(seg, ".".as_bytes()) && !str.bytes_eq(seg, "..".as_bytes()) {
                    try ranges.push(
                        alloc,
                        ast.range_new(start.trunc.[u32](), (i -% start).trunc.[u32]()),
                    );
                }
            }
            start = i +% 1_usize;
        }
        i = i +% 1_usize;
    }
    let rs = ranges.as_mut_slice();
    var k: usize = 1_usize;
    while k < rs.len {
        let key = rs[k];
        let ks = key.start.widen.[usize]();
        let kslice = raw_b.sub(ks, ks +% key.len.widen.[usize]()) catch {
            k = k +% 1_usize;
            continue;
        };
        var j = k;
        while j > 0_usize {
            let prev = rs[j -% 1_usize];
            let ps = prev.start.widen.[usize]();
            let pslice = raw_b.sub(ps, ps +% prev.len.widen.[usize]()) catch {
                break;
            };
            if cmp_byte_slices(pslice, kslice) <= 0_i32 {
                break;
            }
            rs[j] = prev;
            j = j -% 1_usize;
        }
        rs[j] = key;
        k = k +% 1_usize;
    }
    let ro = ranges.as_slice();
    var m: usize = 0_usize;
    while m < ro.len {
        let s = ro[m].start.widen.[usize]();
        let e = s +% ro[m].len.widen.[usize]();
        let seg = raw_b.sub(s, e) catch {
            m = m +% 1_usize;
            continue;
        };
        try sorted_out.push_slice(alloc, seg);
        try sorted_out.push(alloc, b'\n');
        m = m +% 1_usize;
    }
    ranges.destroy(alloc);
    return;
}

fn bytes_has_nul(bs: *[u8]) -> bool {
    var i: usize = 0_usize;
    while i < bs.len {
        if bs[i] == 0_u8 {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn check_lexical_confined_rel(rel: *[u8]) -> u32 {
    if rel.len == 0_usize {
        return ERR_INVALID_INPUT;
    }
    if bytes_has_nul(rel) || rel[0_usize] == b'/' || rel[0_usize] == b'\\' {
        return ERR_PATH_ESCAPE;
    }
    var depth: i64 = 0_i64;
    var seg_start: usize = 0_usize;
    var i: usize = 0_usize;
    while i <= rel.len {
        var at_sep = i == rel.len;
        if !at_sep && i < rel.len {
            let ch = rel[i];
            at_sep = ch == b'/' || ch == b'\\';
        }
        if at_sep {
            if i > seg_start {
                let seg = rel.sub(seg_start, i) catch {
                    return ERR_PATH_ESCAPE;
                };
                if str.bytes_eq(seg, "..".as_bytes()) {
                    depth = depth -% 1_i64;
                    if depth < 0_i64 {
                        return ERR_PATH_ESCAPE;
                    }
                } else if !str.bytes_eq(seg, ".".as_bytes()) {
                    depth = depth +% 1_i64;
                }
            }
            seg_start = i +% 1_usize;
        }
        i = i +% 1_usize;
    }
    return 0_u32;
}

fn join_path_bytes(
    alloc: *mut AllocCap,
    base: *[u8],
    rel: *[u8],
    out: *mut str.StrBuf,
) -> !OutOfMemory {
    out.clear();
    if rel.len > 0_usize && rel[0_usize] == b'/' {
        try out.push_bytes_grow(alloc, rel);
        return;
    }
    if base.len == 0_usize || str.bytes_eq(base, ".".as_bytes()) {
        try out.push_bytes_grow(alloc, rel);
        return;
    }
    try out.push_bytes_grow(alloc, base);
    if base[base.len -% 1_usize] != b'/' {
        try out.push_byte_grow(alloc, b'/');
    }
    try out.push_bytes_grow(alloc, rel);
    return;
}

// ===========================================================================
// Section 4: Vtables, Handles, Constants, Niches, and ErrorUnion Packing
// ===========================================================================

fn method_target_eq(a: types.MethodTarget, b: types.MethodTarget) -> bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == .Def {
        return a.def_id == b.def_id;
    }
    return a.builtin == b.builtin;
}

impl Interp {
    fn init_vtables(self: *mut Self) -> !OutOfMemory {
        let pairs = self.eir.dyn_impl_pairs_slice();
        let impls = self.env.decls.impls.as_slice();
        var pi: usize = 0_usize;
        while pi < pairs.len {
            let pair = pairs[pi];
            pi = pi +% 1_usize;
            let imeta = self.env.get_iface(pair.iface_def) orelse {
                continue;
            };
            let cn = self.env.get(pair.concrete_ty);
            var has_tk = false;
            var tk = types.MethodTarget.{ kind: .Def, def_id: 0_u32, builtin: .Prim };
            match cn.kind {
                .Struct => { has_tk = true; tk.def_id = cn.primary; }
                .Pool => { has_tk = true; tk.def_id = cn.primary; }
                .Enum => { has_tk = true; tk.def_id = cn.primary; }
                .Union => { has_tk = true; tk.def_id = cn.primary; }
                .Bitfield => { has_tk = true; tk.def_id = cn.primary; }
                .Builtin => {
                    has_tk = true;
                    tk.kind = .Builtin;
                    tk.builtin = cn.builtin_kind;
                }
                _ => {}
            }
            if !has_tk {
                continue;
            }
            var found_impl = false;
            var impl_idx: usize = 0_usize;
            while impl_idx < impls.len {
                let im = impls[impl_idx];
                if im.has_iface && im.iface_def == pair.iface_def && method_target_eq(im.target, tk) {
                    found_impl = true;
                    break;
                }
                impl_idx = impl_idx +% 1_usize;
            }
            if !found_impl || impl_idx >= impls.len {
                continue;
            }
            let im_ref = impls[impl_idx];
            let im_methods = self.env.impl_methods_range(im_ref.methods);
            let iface_methods = self.env.iface_methods_range(imeta.methods);
            let m_start = self.st.tables.vtable_methods.len().trunc.[u32]();
            var mi: usize = 0_usize;
            while mi < iface_methods.len {
                let mname = iface_methods[mi].name;
                var sub_idx: u32 = 0_u32;
                var ji: usize = 0_usize;
                while ji < im_methods.len {
                    if im_methods[ji].sig.name == mname {
                        sub_idx = im_methods[ji].sub_idx;
                        break;
                    }
                    ji = ji +% 1_usize;
                }
                try self.st.tables.vtable_methods.push(
                    self.alloc,
                    cfg_ir.fn_key_impl_method(impl_idx.trunc.[u32](), sub_idx),
                );
                mi = mi +% 1_usize;
            }
            let vt_id = self.st.tables.vtable_ranges.len().widen.[u64]();
            try self.st.tables.vtable_ranges.push(
                self.alloc,
                ast.range_new(m_start, iface_methods.len.trunc.[u32]()),
            );
            try self.st.tables.vtables.insert(
                self.alloc,
                pack_u64_u32(pair.iface_def, pair.concrete_ty),
                vt_id,
            );
        }
        return;
    }

    fn intern_ro_bytes(self: *mut Self, bytes: *[u8]) -> u64 ! OutOfMemory {
        let sid = try self.st.tables.str_interner.intern(self.alloc, bytes);
        let idx = sid.widen.[usize]();
        let ptrs = self.st.tables.str_ptrs.as_slice();
        if idx < ptrs.len {
            return ptrs[idx];
        }
        let p = try self.mem_alloc_bytes(bytes, true);
        if self.st.faulted {
            return 0_u64;
        }
        try self.st.tables.str_ptrs.push(self.alloc, p);
        return p;
    }

    fn intern_eir_ro_bytes(self: *mut Self, r: ast.IdRange) -> ValSlot ! OutOfMemory {
        let n = r.len.widen.[usize]();
        var tmp = try col.DynBuf.[u8].init(self.alloc, max_usize(n, 8_usize));
        errdefer tmp.destroy(self.alloc);
        try tmp.push_slice(self.alloc, self.eir.bytes_slice(r));
        let ptr = try self.intern_ro_bytes(tmp.as_slice());
        let res = try self.st.vals.from_pair(self.alloc, ptr, n.widen.[u64]());
        tmp.destroy(self.alloc);
        return res;
    }

    fn intern_ct_ro_str(self: *mut Self, vid: u32) -> ValSlot ! OutOfMemory {
        var tmp = try col.DynBuf.[u8].init(self.alloc, 16_usize);
        errdefer tmp.destroy(self.alloc);
        try tmp.push_slice(self.alloc, self.ct.str_slice(vid));
        let n = tmp.len();
        let ptr = try self.intern_ro_bytes(tmp.as_slice());
        let res = try self.st.vals.from_pair(self.alloc, ptr, n.widen.[u64]());
        tmp.destroy(self.alloc);
        return res;
    }

    fn intern_fn_handle(self: *mut Self, key: cfg_ir.CfgFnKey) -> u64 ! OutOfMemory {
        let k64 = cfg_ir.fn_key_u64(key);
        if let existing = self.st.tables.fn_handles.get(k64) {
            return existing;
        }
        let h = self.st.tables.handle_to_fn.len().widen.[u64]();
        try self.st.tables.handle_to_fn.push(self.alloc, key);
        try self.st.tables.fn_handles.insert(self.alloc, k64, h);
        return h;
    }

    fn opt_null_val(self: *mut Self, ty: types.TyId) -> ValSlot ! OutOfMemory {
        let n = self.env.get(ty);
        if n.kind == .Optional {
            let niche = self.env.opt_niche(n.primary);
            match niche.kind {
                .IdBrand => { return val_scalar(0xFFFFFFFF_u64); }
                .BoolTag => { return val_scalar(2_u64); }
                .ScalarSentinel => { return val_scalar(niche.sentinel); }
                .SliceMaxLen => {
                    return try self.st.vals.from_pair(self.alloc, 0_u64, 0xFFFFFFFFFFFFFFFF_u64);
                }
                _ => {
                    let sz = self.env.x64_layout(ty).size;
                    return try self.zero_val_of_size(sz);
                }
            }
        }
        if n.kind == .Builtin && n.builtin_kind == .IdBrand {
            return val_scalar(0xFFFFFFFF_u64);
        }
        let sz = self.env.x64_layout(ty).size;
        return try self.zero_val_of_size(sz);
    }

    fn zero_val_of_size(self: *mut Self, sz: usize) -> ValSlot ! OutOfMemory {
        if sz == 0_usize {
            return val_void();
        }
        if sz <= 8_usize {
            return val_scalar(0_u64);
        }
        var buf = try col.DynBuf.[u8].init(self.alloc, sz);
        errdefer buf.destroy(self.alloc);
        try push_zero_bytes(self.alloc, &mut buf, sz);
        let v = try self.st.vals.from_bytes(self.alloc, buf.as_slice());
        buf.destroy(self.alloc);
        return v;
    }

    fn eval_is_non_null(self: *Self, v: ValSlot, inner: types.TyId) -> bool {
        let niche = self.env.opt_niche(inner);
        match niche.kind {
            .IdBrand => {
                return (self.st.vals.as_u64(v) & 0xFFFFFFFF_u64) != 0xFFFFFFFF_u64;
            }
            .GenId => {
                var raw_b: [8]u8 = [0_u8; 8];
                self.st.vals.write_bytes_to(v, &mut raw_b);
                return read_le_u32_at(&raw_b, 4_usize) != 0_u32;
            }
            .Link => {
                var raw_b: [8]u8 = [0_u8; 8];
                self.st.vals.write_bytes_to(v, &mut raw_b);
                return read_le_u32_at(&raw_b, 4_usize) != 0_u32;
            }
            .NullPtr => {
                return self.st.vals.as_u64(v) != 0_u64;
            }
            .FatPtrNullFirst => {
                return self.st.vals.as_pair(v).a != 0_u64;
            }
            .SliceMaxLen => {
                return self.st.vals.as_pair(v).b != 0xFFFFFFFFFFFFFFFF_u64;
            }
            .BoolTag => {
                return (self.st.vals.as_u64(v) & 0xFF_u64) != 2_u64;
            }
            .ScalarSentinel => {
                let mask = if niche.size >= 8_usize {
                    0xFFFFFFFFFFFFFFFF_u64
                } else {
                    (1_u64 <<% (niche.size.trunc.[u64]() *% 8_u64)) -% 1_u64
                };
                return (self.st.vals.as_u64(v) & mask) != (niche.sentinel & mask);
            }
            .None => {
                var raw_b: [1]u8 = [0_u8; 1];
                self.st.vals.write_bytes_to(v, &mut raw_b);
                return raw_b[0_usize] != 0_u8;
            }
        }
    }

    fn pack_error_union(
        self: *mut Self,
        eu_ty: types.TyId,
        ok_ty: types.TyId,
        err_code: u32,
        ok_val: ValSlot,
    ) -> ValSlot ! OutOfMemory {
        let has_ok = err_code == 0_u32 && ok_ty != types.TY_VOID && ok_ty != types.TY_NEVER;
        let ok_off = if has_ok { self.env.eu_ok_offset(ok_ty) } else { 0_usize };
        let ok_sz = if has_ok { interp_ty_size(self.env, ok_ty) } else { 0_usize };
        var sz = max_usize(self.env.x64_layout(eu_ty).size, 4_usize);
        if has_ok {
            sz = max_usize(sz, ok_off +% ok_sz);
        }
        var buf = try col.DynBuf.[u8].init(self.alloc, sz);
        errdefer buf.destroy(self.alloc);
        try push_zero_bytes(self.alloc, &mut buf, sz);
        write_le_u32_at(buf.as_mut_slice(), 0_usize, err_code);
        if has_ok && ok_sz > 0_usize {
            var ok_tmp = try col.DynBuf.[u8].init(self.alloc, ok_sz);
            errdefer ok_tmp.destroy(self.alloc);
            try self.st.vals.to_dyn_bytes(self.alloc, ok_val, ok_sz, &mut ok_tmp);
            copy_bytes_slice(buf.as_mut_slice(), ok_off, ok_tmp.as_slice(), 0_usize, ok_sz);
            ok_tmp.destroy(self.alloc);
        }
        let res = try self.st.vals.from_bytes(self.alloc, buf.as_slice());
        buf.destroy(self.alloc);
        return res;
    }

    @recursive
    fn encode_ct_val_bytes(
        self: *mut Self,
        val_id: u32,
        ty: types.TyId,
        out: *mut col.DynBuf[u8],
    ) -> bool ! OutOfMemory {
        out.clear();
        let sz = self.env.x64_layout(ty).size;
        if sz == 0_usize {
            return true;
        }
        let n = self.ct.get_val(val_id);
        match n.kind {
            .Void => {
                try push_zero_bytes(self.alloc, out, sz);
                return true;
            }
            .Bool => {
                try push_zero_bytes(self.alloc, out, sz);
                let bs = out.as_mut_slice();
                if bs.len > 0_usize {
                    bs[0_usize] = if n.i_lo != 0_u64 { 1_u8 } else { 0_u8 };
                }
                return true;
            }
            .Char => {
                try push_zero_bytes(self.alloc, out, sz);
                write_le_u64_at(out.as_mut_slice(), 0_usize, n.i_lo, min_usize(sz, 4_usize));
                return true;
            }
            .Int => {
                try push_zero_bytes(self.alloc, out, sz);
                write_le_u64_at(out.as_mut_slice(), 0_usize, n.i_lo, min_usize(sz, 8_usize));
                if sz > 8_usize {
                    write_le_u64_at(out.as_mut_slice(), 8_usize, n.i_hi, min_usize(sz -% 8_usize, 8_usize));
                }
                return true;
            }
            .EnumSym => {
                try push_zero_bytes(self.alloc, out, sz);
                write_le_u64_at(out.as_mut_slice(), 0_usize, n.i_lo, min_usize(sz, 8_usize));
                if sz > 8_usize {
                    write_le_u64_at(out.as_mut_slice(), 8_usize, n.i_hi, min_usize(sz -% 8_usize, 8_usize));
                }
                return true;
            }
            .Float => {
                try push_zero_bytes(self.alloc, out, sz);
                if sz == 2_usize {
                    let h = f32_bits_to_f16_bits(f64_bits_to_f32_bits(n.i_lo));
                    write_le_u64_at(out.as_mut_slice(), 0_usize, h.widen.[u64](), 2_usize);
                } else if sz == 4_usize {
                    let f32b = f64_bits_to_f32_bits(n.i_lo);
                    write_le_u32_at(out.as_mut_slice(), 0_usize, f32b);
                } else {
                    write_le_u64_at(out.as_mut_slice(), 0_usize, n.i_lo, min_usize(sz, 8_usize));
                }
                return true;
            }
            .Array => {
                return try self.encode_ct_array(n, ty, sz, out);
            }
            .Tuple => {
                return try self.encode_ct_tuple(n, ty, sz, out);
            }
            .Struct => {
                return try self.encode_ct_struct(val_id, n, sz, out);
            }
            _ => {
                return false;
            }
        }
    }

    @recursive
    fn encode_ct_array(
        self: *mut Self,
        n: ctvm.CtValNode,
        ty: types.TyId,
        sz: usize,
        out: *mut col.DynBuf[u8],
    ) -> bool ! OutOfMemory {
        let tn = self.env.get(ty);
        let elem_ty = if tn.kind == .Array || tn.kind == .Vec { tn.primary } else { n.ty };
        let esz = max_usize(self.env.x64_layout(elem_ty).size, 1_usize);
        try push_zero_bytes(self.alloc, out, sz);
        var tmp = try col.DynBuf.[u8].init(self.alloc, esz);
        errdefer tmp.destroy(self.alloc);
        let cnt = n.range.len.widen.[usize]();
        var i: usize = 0_usize;
        while i < cnt {
            let eid = self.ct.get_elem(n.range, i);
            if !(try self.encode_ct_val_bytes(eid, elem_ty, &mut tmp)) {
                tmp.destroy(self.alloc);
                return false;
            }
            let start = i *% esz;
            if start +% tmp.len() <= out.len() {
                copy_bytes_slice(out.as_mut_slice(), start, tmp.as_slice(), 0_usize, tmp.len());
            }
            i = i +% 1_usize;
        }
        tmp.destroy(self.alloc);
        return true;
    }

    @recursive
    fn encode_ct_tuple(
        self: *mut Self,
        n: ctvm.CtValNode,
        ty: types.TyId,
        sz: usize,
        out: *mut col.DynBuf[u8],
    ) -> bool ! OutOfMemory {
        try push_zero_bytes(self.alloc, out, sz);
        var tmp = try col.DynBuf.[u8].init(self.alloc, 16_usize);
        errdefer tmp.destroy(self.alloc);
        let cnt = n.range.len.widen.[usize]();
        var i: usize = 0_usize;
        while i < cnt {
            let eid = self.ct.get_elem(n.range, i);
            let fo = self.env.struct_field_offset(ty, i);
            if !(try self.encode_ct_val_bytes(eid, fo.ty, &mut tmp)) {
                tmp.destroy(self.alloc);
                return false;
            }
            if fo.offset +% tmp.len() <= out.len() {
                copy_bytes_slice(out.as_mut_slice(), fo.offset, tmp.as_slice(), 0_usize, tmp.len());
            }
            i = i +% 1_usize;
        }
        tmp.destroy(self.alloc);
        return true;
    }

    @recursive
    fn encode_ct_struct(
        self: *mut Self,
        val_id: u32,
        n: ctvm.CtValNode,
        sz: usize,
        out: *mut col.DynBuf[u8],
    ) -> bool ! OutOfMemory {
        let sty = n.ty;
        let sn = self.env.get(sty);
        try push_zero_bytes(self.alloc, out, sz);
        var tmp = try col.DynBuf.[u8].init(self.alloc, 16_usize);
        errdefer tmp.destroy(self.alloc);
        if sn.kind == .Struct {
            let meta = self.env.get_struct(sn.primary) orelse {
                tmp.destroy(self.alloc);
                return false;
            };
            let f_range = meta.fields;
            let f_cnt = f_range.len.widen.[usize]();
            var i: usize = 0_usize;
            while i < f_cnt {
                let sfs = self.env.struct_fields_range(f_range);
                if i >= sfs.len {
                    break;
                }
                let fname = sfs[i].name;
                let fo = self.env.struct_field_offset(sty, i);
                if let fvid = self.ct.get_struct_field(val_id, fname) {
                    if !(try self.encode_ct_val_bytes(fvid, fo.ty, &mut tmp)) {
                        tmp.destroy(self.alloc);
                        return false;
                    }
                    if fo.offset +% tmp.len() <= out.len() {
                        copy_bytes_slice(out.as_mut_slice(), fo.offset, tmp.as_slice(), 0_usize, tmp.len());
                    }
                }
                i = i +% 1_usize;
            }
            tmp.destroy(self.alloc);
            return true;
        }
        if sn.kind == .AnonStruct {
            let af_cnt = self.env.node_anon_fields(&sn).len;
            var i: usize = 0_usize;
            while i < af_cnt {
                let afs = self.env.node_anon_fields(&sn);
                if i >= afs.len {
                    break;
                }
                let fname = afs[i].name;
                let fo = self.env.struct_field_offset(sty, i);
                if let fvid = self.ct.get_struct_field(val_id, fname) {
                    if !(try self.encode_ct_val_bytes(fvid, fo.ty, &mut tmp)) {
                        tmp.destroy(self.alloc);
                        return false;
                    }
                    if fo.offset +% tmp.len() <= out.len() {
                        copy_bytes_slice(out.as_mut_slice(), fo.offset, tmp.as_slice(), 0_usize, tmp.len());
                    }
                }
                i = i +% 1_usize;
            }
            tmp.destroy(self.alloc);
            return true;
        }
        tmp.destroy(self.alloc);
        return false;
    }

    fn eval_const(self: *mut Self, ty: types.TyId, c: *cfg_ir.CfgConst) -> ValSlot ! OutOfMemory {
        match c.kind {
            .Void => { return val_void(); }
            .Bool => { return val_scalar(if c.bool_val { 1_u64 } else { 0_u64 }); }
            .Char => { return val_scalar(c.aux_u32.widen.[u64]()); }
            .Int => {
                if self.env.int_bits(ty) == 128_u8 {
                    return try self.st.vals.from_pair(
                        self.alloc,
                        c.int_val.lo,
                        c.int_val.hi.bitcast.[u64](),
                    );
                }
                return val_scalar(c.int_val.lo);
            }
            .Float => {
                let fbs = self.eir.bytes_slice(c.bytes);
                let fv64 = parse_f64_bytes(fbs);
                let f64b = fv64.bitcast.[u64]();
                let tn = self.env.get(ty);
                if tn.kind == .Float && tn.u8_val == 16_u8 {
                    let h = f32_bits_to_f16_bits(f64_bits_to_f32_bits(f64b));
                    return val_scalar(h.widen.[u64]());
                }
                if tn.kind == .Float && tn.u8_val == 32_u8 {
                    return val_scalar(f64_bits_to_f32_bits(f64b).widen.[u64]());
                }
                return val_scalar(f64b);
            }
            .Str => {
                return try self.intern_eir_ro_bytes(c.bytes);
            }
            .Bytes => {
                return try self.intern_eir_ro_bytes(c.bytes);
            }
            .Null => { return try self.opt_null_val(ty); }
            .EnumTag => { return val_scalar(c.int_val.lo); }
            .ErrorTag => { return val_scalar(c.aux_u32.widen.[u64]()); }
            .FnRef => {
                let h = try self.intern_fn_handle(cfg_ir.fn_key_top_def(c.aux_u32));
                return try self.st.vals.from_pair(self.alloc, h, 0_u64);
            }
            .ConstDef => {
                let cty = c.ty;
                if let vid = self.ct.get_const_val(c.aux_u32) {
                    let cn = self.ct.get_val(vid);
                    if cn.kind == .Str {
                        return try self.intern_ct_ro_str(vid);
                    }
                    var enc = try col.DynBuf.[u8].init(self.alloc, 16_usize);
                    errdefer enc.destroy(self.alloc);
                    if try self.encode_ct_val_bytes(vid, cty, &mut enc) {
                        let res = try self.st.vals.from_bytes(self.alloc, enc.as_slice());
                        enc.destroy(self.alloc);
                        return res;
                    }
                    enc.destroy(self.alloc);
                }
                if let cm = self.env.get_const(c.aux_u32) {
                    if cm.has_int_val {
                        return val_scalar(cm.int_val.lo);
                    }
                }
                let sz = self.env.x64_layout(cty).size;
                return try self.zero_val_of_size(sz);
            }
        }
    }
}

// ===========================================================================
// Section 5: Unary, Binary, Cast, and Aggregate Evaluation
// ===========================================================================

impl Interp {
    @recursive
    fn eval_unary(self: *mut Self, op: ast.UnaryOp, v: ValSlot, ty: types.TyId) -> ValSlot ! OutOfMemory {
        let tn = self.env.get(ty);
        if tn.kind == .Float {
            if op != .Neg {
                try self.fail("EIR-Interp: unsupported float unary op");
                return val_void();
            }
            let raw_b = self.st.vals.as_u64(v);
            if tn.u8_val == 16_u8 {
                let h = (raw_b.trunc.[u16]()) ^ 0x8000_u16;
                return val_scalar(h.widen.[u64]());
            }
            if tn.u8_val == 32_u8 {
                let neg32 = -(raw_b.trunc.[u32]().bitcast.[f32]());
                return val_scalar(neg32.bitcast.[u32]().widen.[u64]());
            }
            let neg64 = -(raw_b.bitcast.[f64]());
            return val_scalar(neg64.bitcast.[u64]());
        }
        if tn.kind == .Vec {
            let elem = tn.primary;
            let lanes = tn.u8_val.widen.[usize]();
            let esz = max_usize(self.env.x64_layout(elem).size, 1_usize);
            let total = esz *% lanes;
            var raw_b = try col.DynBuf.[u8].init(self.alloc, total);
            errdefer raw_b.destroy(self.alloc);
            try self.st.vals.to_dyn_bytes(self.alloc, v, total, &mut raw_b);
            var out = try col.DynBuf.[u8].init(self.alloc, total);
            errdefer out.destroy(self.alloc);
            try push_zero_bytes(self.alloc, &mut out, total);
            var eb = try col.DynBuf.[u8].init(self.alloc, esz);
            errdefer eb.destroy(self.alloc);
            var i: usize = 0_usize;
            while i < lanes {
                let off = i *% esz;
                let esl = raw_b.as_slice().sub(off, off +% esz) catch { break; };
                let ev = try self.st.vals.from_bytes(self.alloc, esl);
                let rv = try self.eval_unary(op, ev, elem);
                if self.st.faulted {
                    eb.destroy(self.alloc);
                    out.destroy(self.alloc);
                    raw_b.destroy(self.alloc);
                    return val_void();
                }
                try self.st.vals.to_dyn_bytes(self.alloc, rv, esz, &mut eb);
                copy_bytes_slice(out.as_mut_slice(), off, eb.as_slice(), 0_usize, esz);
                i = i +% 1_usize;
            }
            let res = try self.st.vals.from_bytes(self.alloc, out.as_slice());
            eb.destroy(self.alloc);
            out.destroy(self.alloc);
            raw_b.destroy(self.alloc);
            return res;
        }
        let bits = self.env.int_bits(ty);
        let signed = self.env.is_signed_int(ty);
        let raw_b = self.st.vals.as_u64(v);
        match op {
            .Neg => {
                let x = sign_extend_i128(raw_b, bits, signed);
                let neg_x = types.int_val_checked_neg(x) orelse types.int_val_zero();
                return val_scalar(neg_x.lo & mask_bits(bits));
            }
            .Not => {
                return val_scalar(if raw_b == 0_u64 { 1_u64 } else { 0_u64 });
            }
            .BitNot => {
                return val_scalar((~raw_b) & mask_bits(bits));
            }
            _ => {
                try self.fail("EIR-Interp: unsupported unary op");
                return val_void();
            }
        }
    }

    fn eval_binary_float(
        self: *mut Self,
        op: ast.BinaryOp,
        lhs: ValSlot,
        rhs: ValSlot,
        bits: u8,
    ) -> ValSlot ! OutOfMemory {
        let la_u = self.st.vals.as_u64(lhs);
        let rb_u = self.st.vals.as_u64(rhs);
        if bits == 16_u8 {
            let a = f16_bits_to_f32_bits(la_u.trunc.[u16]()).bitcast.[f32]();
            let b = f16_bits_to_f32_bits(rb_u.trunc.[u16]()).bitcast.[f32]();
            match op {
                .Add => { return val_scalar(f32_bits_to_f16_bits((a + b).bitcast.[u32]()).widen.[u64]()); }
                .Sub => { return val_scalar(f32_bits_to_f16_bits((a - b).bitcast.[u32]()).widen.[u64]()); }
                .Mul => { return val_scalar(f32_bits_to_f16_bits((a * b).bitcast.[u32]()).widen.[u64]()); }
                .Div => { return val_scalar(f32_bits_to_f16_bits((a / b).bitcast.[u32]()).widen.[u64]()); }
                .Eq => { return val_scalar(if a == b { 1_u64 } else { 0_u64 }); }
                .NotEq => { return val_scalar(if a != b { 1_u64 } else { 0_u64 }); }
                .Lt => { return val_scalar(if a < b { 1_u64 } else { 0_u64 }); }
                .LtEq => { return val_scalar(if a <= b { 1_u64 } else { 0_u64 }); }
                .Gt => { return val_scalar(if a > b { 1_u64 } else { 0_u64 }); }
                .GtEq => { return val_scalar(if a >= b { 1_u64 } else { 0_u64 }); }
                _ => {
                    try self.fail("EIR-Interp: unsupported f16 binary op");
                    return val_void();
                }
            }
        }
        if bits == 32_u8 {
            let a = la_u.trunc.[u32]().bitcast.[f32]();
            let b = rb_u.trunc.[u32]().bitcast.[f32]();
            match op {
                .Add => { return val_scalar((a + b).bitcast.[u32]().widen.[u64]()); }
                .Sub => { return val_scalar((a - b).bitcast.[u32]().widen.[u64]()); }
                .Mul => { return val_scalar((a * b).bitcast.[u32]().widen.[u64]()); }
                .Div => { return val_scalar((a / b).bitcast.[u32]().widen.[u64]()); }
                .Eq => { return val_scalar(if a == b { 1_u64 } else { 0_u64 }); }
                .NotEq => { return val_scalar(if a != b { 1_u64 } else { 0_u64 }); }
                .Lt => { return val_scalar(if a < b { 1_u64 } else { 0_u64 }); }
                .LtEq => { return val_scalar(if a <= b { 1_u64 } else { 0_u64 }); }
                .Gt => { return val_scalar(if a > b { 1_u64 } else { 0_u64 }); }
                .GtEq => { return val_scalar(if a >= b { 1_u64 } else { 0_u64 }); }
                _ => {
                    try self.fail("EIR-Interp: unsupported f32 binary op");
                    return val_void();
                }
            }
        }
        let a = la_u.bitcast.[f64]();
        let b = rb_u.bitcast.[f64]();
        match op {
            .Add => { return val_scalar((a + b).bitcast.[u64]()); }
            .Sub => { return val_scalar((a - b).bitcast.[u64]()); }
            .Mul => { return val_scalar((a * b).bitcast.[u64]()); }
            .Div => { return val_scalar((a / b).bitcast.[u64]()); }
            .Eq => { return val_scalar(if a == b { 1_u64 } else { 0_u64 }); }
            .NotEq => { return val_scalar(if a != b { 1_u64 } else { 0_u64 }); }
            .Lt => { return val_scalar(if a < b { 1_u64 } else { 0_u64 }); }
            .LtEq => { return val_scalar(if a <= b { 1_u64 } else { 0_u64 }); }
            .Gt => { return val_scalar(if a > b { 1_u64 } else { 0_u64 }); }
            .GtEq => { return val_scalar(if a >= b { 1_u64 } else { 0_u64 }); }
            _ => {
                try self.fail("EIR-Interp: unsupported f64 binary op");
                return val_void();
            }
        }
    }

    @recursive
    fn eval_binary_vec(
        self: *mut Self,
        op: ast.BinaryOp,
        lhs: ValSlot,
        rhs: ValSlot,
        elem: types.TyId,
        lanes: usize,
        dst_ty: types.TyId,
    ) -> ValSlot ! OutOfMemory {
        let esz = max_usize(self.env.x64_layout(elem).size, 1_usize);
        let total = esz *% lanes;
        var lb = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer lb.destroy(self.alloc);
        try self.st.vals.to_dyn_bytes(self.alloc, lhs, total, &mut lb);
        var rb = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer rb.destroy(self.alloc);
        try self.st.vals.to_dyn_bytes(self.alloc, rhs, total, &mut rb);

        if (op == .Eq || op == .NotEq) && dst_ty == types.TY_BOOL {
            var all_eq = true;
            var i: usize = 0_usize;
            while i < lanes {
                let off = i *% esz;
                let ls = lb.as_slice().sub(off, off +% esz) catch { break; };
                let rs = rb.as_slice().sub(off, off +% esz) catch { break; };
                let le = try self.st.vals.from_bytes(self.alloc, ls);
                let re = try self.st.vals.from_bytes(self.alloc, rs);
                let rv = try self.eval_binary(.Eq, le, re, elem, types.TY_BOOL);
                if self.st.faulted {
                    rb.destroy(self.alloc);
                    lb.destroy(self.alloc);
                    return val_void();
                }
                if self.st.vals.as_u64(rv) == 0_u64 {
                    all_eq = false;
                    break;
                }
                i = i +% 1_usize;
            }
            rb.destroy(self.alloc);
            lb.destroy(self.alloc);
            let res_b = if op == .Eq { all_eq } else { !all_eq };
            return val_scalar(if res_b { 1_u64 } else { 0_u64 });
        }

        let dn = self.env.get(dst_ty);
        let out_elem = if dn.kind == .Vec { dn.primary } else { elem };
        let oesz = max_usize(self.env.x64_layout(out_elem).size, 1_usize);
        let out_total = oesz *% lanes;
        var out = try col.DynBuf.[u8].init(self.alloc, out_total);
        errdefer out.destroy(self.alloc);
        try push_zero_bytes(self.alloc, &mut out, out_total);
        var eb = try col.DynBuf.[u8].init(self.alloc, oesz);
        errdefer eb.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < lanes {
            let off = i *% esz;
            let ls = lb.as_slice().sub(off, off +% esz) catch { break; };
            let rs = rb.as_slice().sub(off, off +% esz) catch { break; };
            let le = try self.st.vals.from_bytes(self.alloc, ls);
            let re = try self.st.vals.from_bytes(self.alloc, rs);
            let rv = try self.eval_binary(op, le, re, elem, out_elem);
            if self.st.faulted {
                eb.destroy(self.alloc);
                out.destroy(self.alloc);
                rb.destroy(self.alloc);
                lb.destroy(self.alloc);
                return val_void();
            }
            try self.st.vals.to_dyn_bytes(self.alloc, rv, oesz, &mut eb);
            copy_bytes_slice(out.as_mut_slice(), i *% oesz, eb.as_slice(), 0_usize, oesz);
            i = i +% 1_usize;
        }
        let res = try self.st.vals.from_bytes(self.alloc, out.as_slice());
        eb.destroy(self.alloc);
        out.destroy(self.alloc);
        rb.destroy(self.alloc);
        lb.destroy(self.alloc);
        return res;
    }

    fn eval_binary_checked_int(
        self: *mut Self,
        op: ast.BinaryOp,
        a: types.IntVal,
        b: types.IntVal,
        signed: bool,
        mask: u64,
        bounds: IntRange128,
        op_ty: types.TyId,
        dst_ty: types.TyId,
    ) -> ValSlot ! OutOfMemory {
        var err_code: u32 = 0_u32;
        var ok_bits: u64 = 0_u64;
        if op == .AddCheck {
            let s_opt = types.int_val_checked_add(a, b);
            if let s = s_opt {
                if types.int_val_cmp(s, bounds.lo) < 0_i32 || types.int_val_cmp(s, bounds.hi) > 0_i32 {
                    err_code = 1_u32;
                } else {
                    ok_bits = s.lo & mask;
                }
            } else {
                err_code = 1_u32;
            }
            return try self.pack_error_union(dst_ty, op_ty, err_code, val_scalar(ok_bits));
        }
        if op == .SubCheck {
            let s_opt = types.int_val_checked_sub(a, b);
            if let s = s_opt {
                if types.int_val_cmp(s, bounds.lo) < 0_i32 || types.int_val_cmp(s, bounds.hi) > 0_i32 {
                    err_code = 1_u32;
                } else {
                    ok_bits = s.lo & mask;
                }
            } else {
                err_code = 1_u32;
            }
            return try self.pack_error_union(dst_ty, op_ty, err_code, val_scalar(ok_bits));
        }
        if op == .MulCheck {
            if signed {
                let s_opt = types.int_val_checked_mul(a, b);
                if let s = s_opt {
                    if types.int_val_cmp(s, bounds.lo) >= 0_i32 && types.int_val_cmp(s, bounds.hi) <= 0_i32 {
                        ok_bits = s.lo & mask;
                    } else {
                        err_code = 1_u32;
                    }
                } else {
                    err_code = 1_u32;
                }
            } else {
                let p = u64_mul_wide(a.lo, b.lo);
                if p.hi == 0_u64 && p.lo <= bounds.hi.lo {
                    ok_bits = p.lo & mask;
                } else {
                    err_code = 1_u32;
                }
            }
            return try self.pack_error_union(dst_ty, op_ty, err_code, val_scalar(ok_bits));
        }
        if types.int_val_is_zero(b) {
            return try self.pack_error_union(dst_ty, op_ty, 2_u32, val_scalar(0_u64));
        }
        if signed
            && types.int_val_eq(a, bounds.lo)
            && types.int_val_eq(b, types.int_val_from_i64(-1_i64))
        {
            return try self.pack_error_union(dst_ty, op_ty, 1_u32, val_scalar(0_u64));
        }
        let q_opt = if op == .DivCheck {
            types.int_val_checked_div(a, b)
        } else {
            types.int_val_checked_rem(a, b)
        };
        if let q = q_opt {
            ok_bits = q.lo & mask;
        } else {
            err_code = 1_u32;
        }
        return try self.pack_error_union(dst_ty, op_ty, err_code, val_scalar(ok_bits));
    }

    fn eval_binary_sat_int(
        op: ast.BinaryOp,
        a: types.IntVal,
        b: types.IntVal,
        signed: bool,
        mask: u64,
        bounds: IntRange128,
    ) -> ValSlot {
        if op == .MulSat && !signed {
            let p = u64_mul_wide(a.lo, b.lo);
            if p.hi != 0_u64 || p.lo > bounds.hi.lo {
                return val_scalar(bounds.hi.lo & mask);
            }
            return val_scalar(p.lo & mask);
        }
        var raw_b = types.int_val_zero();
        var overflow_neg = false;
        var overflowed = false;
        if op == .AddSat {
            if let s = types.int_val_checked_add(a, b) {
                raw_b = s;
            } else {
                overflowed = true;
                overflow_neg = a.hi < 0_i64;
            }
        } else if op == .SubSat {
            if let s = types.int_val_checked_sub(a, b) {
                raw_b = s;
            } else {
                overflowed = true;
                overflow_neg = a.hi < 0_i64;
            }
        } else {
            if let p = types.int_val_checked_mul(a, b) {
                raw_b = p;
            } else {
                overflowed = true;
                overflow_neg = (a.hi < 0_i64) != (b.hi < 0_i64);
            }
        }
        if overflowed {
            let c = if overflow_neg { bounds.lo } else { bounds.hi };
            return val_scalar(c.lo & mask);
        }
        if types.int_val_cmp(raw_b, bounds.lo) < 0_i32 {
            return val_scalar(bounds.lo.lo & mask);
        }
        if types.int_val_cmp(raw_b, bounds.hi) > 0_i32 {
            return val_scalar(bounds.hi.lo & mask);
        }
        return val_scalar(raw_b.lo & mask);
    }

    @recursive
    fn eval_binary(
        self: *mut Self,
        op: ast.BinaryOp,
        lhs: ValSlot,
        rhs: ValSlot,
        op_ty: types.TyId,
        dst_ty: types.TyId,
    ) -> ValSlot ! OutOfMemory {
        let on = self.env.get(op_ty);
        if on.kind == .Vec {
            return try self.eval_binary_vec(op, lhs, rhs, on.primary, on.u8_val.widen.[usize](), dst_ty);
        }
        if on.kind == .Float {
            return try self.eval_binary_float(op, lhs, rhs, on.u8_val);
        }
        if (op == .Eq || op == .NotEq)
            && on.kind == .Builtin
            && (on.builtin_kind == .GenId || on.builtin_kind == .Link)
        {
            let sz = clamp_usize(self.env.x64_layout(op_ty).size, 4_usize, 8_usize);
            var lb: [8]u8 = [0_u8; 8];
            var rb: [8]u8 = [0_u8; 8];
            self.st.vals.write_bytes_to(lhs, &mut lb);
            self.st.vals.write_bytes_to(rhs, &mut rb);
            var eq = true;
            var i: usize = 0_usize;
            while i < sz && i < 8_usize {
                if lb[i] != rb[i] {
                    eq = false;
                    break;
                }
                i = i +% 1_usize;
            }
            let r = if op == .Eq { eq } else { !eq };
            return val_scalar(if r { 1_u64 } else { 0_u64 });
        }

        let signed = self.env.is_signed_int(op_ty);
        let bits = self.env.int_bits(op_ty);
        let mask = mask_bits(bits);
        let bounds = int_bounds_for(bits, signed);
        let lu = self.st.vals.as_u64(lhs);
        let ru = self.st.vals.as_u64(rhs);
        let a = sign_extend_i128(lu, bits, signed);
        let b = sign_extend_i128(ru, bits, signed);

        if op == .AddCheck || op == .SubCheck || op == .MulCheck || op == .DivCheck || op == .ModCheck {
            return try self.eval_binary_checked_int(op, a, b, signed, mask, bounds, op_ty, dst_ty);
        }
        if op == .AddSat || op == .SubSat || op == .MulSat {
            return Interp.eval_binary_sat_int(op, a, b, signed, mask, bounds);
        }
        return try self.eval_binary_core_int(op, lu, ru, a, b, signed, bits, mask, bounds);
    }

    fn eval_binary_core_int(
        self: *mut Self,
        op: ast.BinaryOp,
        lu: u64,
        ru: u64,
        a: types.IntVal,
        b: types.IntVal,
        signed: bool,
        bits: u8,
        mask: u64,
        bounds: IntRange128,
    ) -> ValSlot ! OutOfMemory {
        match op {
            .Add => {
                let s = types.int_val_checked_add(a, b) orelse {
                    try self.fail("EIR-Interp fault: proven `+` overflowed");
                    return val_void();
                };
                if types.int_val_cmp(s, bounds.lo) < 0_i32 || types.int_val_cmp(s, bounds.hi) > 0_i32 {
                    try self.fail("EIR-Interp fault: proven `+` overflowed");
                    return val_void();
                }
                return val_scalar(s.lo & mask);
            }
            .Sub => {
                let s = types.int_val_checked_sub(a, b) orelse {
                    try self.fail("EIR-Interp fault: proven `-` overflowed");
                    return val_void();
                };
                if types.int_val_cmp(s, bounds.lo) < 0_i32 || types.int_val_cmp(s, bounds.hi) > 0_i32 {
                    try self.fail("EIR-Interp fault: proven `-` overflowed");
                    return val_void();
                }
                return val_scalar(s.lo & mask);
            }
            .Mul => {
                if signed {
                    let s = types.int_val_checked_mul(a, b) orelse {
                        try self.fail("EIR-Interp fault: proven `*` overflowed");
                        return val_void();
                    };
                    if types.int_val_cmp(s, bounds.lo) < 0_i32 || types.int_val_cmp(s, bounds.hi) > 0_i32 {
                        try self.fail("EIR-Interp fault: proven `*` overflowed");
                        return val_void();
                    }
                    return val_scalar(s.lo & mask);
                }
                let p = u64_mul_wide(a.lo, b.lo);
                if p.hi != 0_u64 || p.lo > bounds.hi.lo {
                    try self.fail("EIR-Interp fault: proven `*` overflowed");
                    return val_void();
                }
                return val_scalar(p.lo & mask);
            }
            .Div => {
                if types.int_val_is_zero(b) {
                    try self.fail("EIR-Interp fault: proven `/` divided by zero");
                    return val_void();
                }
                if signed
                    && types.int_val_eq(a, bounds.lo)
                    && types.int_val_eq(b, types.int_val_from_i64(-1_i64))
                {
                    try self.fail("EIR-Interp fault: proven `/` overflowed MIN / -1");
                    return val_void();
                }
                let q = types.int_val_checked_div(a, b) orelse {
                    try self.fail("EIR-Interp fault: proven `/` overflowed");
                    return val_void();
                };
                return val_scalar(q.lo & mask);
            }
            .Mod => {
                if types.int_val_is_zero(b) {
                    try self.fail("EIR-Interp fault: proven `%` divided by zero");
                    return val_void();
                }
                if signed
                    && types.int_val_eq(a, bounds.lo)
                    && types.int_val_eq(b, types.int_val_from_i64(-1_i64))
                {
                    try self.fail("EIR-Interp fault: proven `%` overflowed MIN % -1");
                    return val_void();
                }
                let r = types.int_val_checked_rem(a, b) orelse {
                    try self.fail("EIR-Interp fault: proven `%` overflowed");
                    return val_void();
                };
                return val_scalar(r.lo & mask);
            }
            .AddWrap => { return val_scalar((lu +% ru) & mask); }
            .SubWrap => { return val_scalar((lu -% ru) & mask); }
            .MulWrap => { return val_scalar((lu *% ru) & mask); }
            .BitAnd => { return val_scalar((lu & ru) & mask); }
            .And => { return val_scalar((lu & ru) & mask); }
            .BitOr => { return val_scalar((lu | ru) & mask); }
            .Or => { return val_scalar((lu | ru) & mask); }
            .BitXor => { return val_scalar((lu ^ ru) & mask); }
            .Shl => {
                if ru >= bits.widen.[u64]() {
                    try self.fail("EIR-Interp fault: proven `<<` shift >= bitwidth");
                    return val_void();
                }
                return val_scalar(((lu & mask) <<% (ru & 63_u64)) & mask);
            }
            .ShlWrap => {
                let bmask = if bits > 0_u8 { (bits -% 1_u8).widen.[u64]() } else { 0_u64 };
                let sh = (ru & bmask) & 63_u64;
                return val_scalar(((lu & mask) <<% sh) & mask);
            }
            .Shr => {
                if ru >= bits.widen.[u64]() {
                    try self.fail("EIR-Interp fault: proven `>>` shift >= bitwidth");
                    return val_void();
                }
                if signed {
                    let sr = types.int_val_shr(a, ru.trunc.[u32]());
                    return val_scalar(sr.lo & mask);
                }
                return val_scalar(((lu & mask) >> (ru & 63_u64)) & mask);
            }
            .Eq => { return val_scalar(if types.int_val_eq(a, b) { 1_u64 } else { 0_u64 }); }
            .NotEq => { return val_scalar(if !types.int_val_eq(a, b) { 1_u64 } else { 0_u64 }); }
            .Lt => { return val_scalar(if types.int_val_cmp(a, b) < 0_i32 { 1_u64 } else { 0_u64 }); }
            .LtEq => { return val_scalar(if types.int_val_cmp(a, b) <= 0_i32 { 1_u64 } else { 0_u64 }); }
            .Gt => { return val_scalar(if types.int_val_cmp(a, b) > 0_i32 { 1_u64 } else { 0_u64 }); }
            .GtEq => { return val_scalar(if types.int_val_cmp(a, b) >= 0_i32 { 1_u64 } else { 0_u64 }); }
            _ => {
                try self.fail("EIR-Interp: unsupported binary op");
                return val_void();
            }
        }
    }

    fn eval_cast(
        self: *mut Self,
        kind: cfg_ir.CastKind,
        op: ValSlot,
        from_ty: types.TyId,
        to_ty: types.TyId,
    ) -> ValSlot ! OutOfMemory {
        let fn_node = self.env.get(from_ty);
        let tn_node = self.env.get(to_ty);
        match kind {
            .Widen => { return try self.eval_cast_numeric(op, from_ty, to_ty, &fn_node, &tn_node); }
            .Trunc => { return try self.eval_cast_numeric(op, from_ty, to_ty, &fn_node, &tn_node); }
            .AsU64 => { return try self.eval_cast_numeric(op, from_ty, to_ty, &fn_node, &tn_node); }
            .MutToConst => { return try self.eval_cast_numeric(op, from_ty, to_ty, &fn_node, &tn_node); }
            .Clamp => {
                let fbits = self.env.int_bits(from_ty);
                let fsigned = self.env.is_signed_int(from_ty);
                let tbits = self.env.int_bits(to_ty);
                let tsigned = self.env.is_signed_int(to_ty);
                let tb = int_bounds_for(tbits, tsigned);
                var iv = sign_extend_i128(self.st.vals.as_u64(op), fbits, fsigned);
                if types.int_val_cmp(iv, tb.lo) < 0_i32 {
                    iv = tb.lo;
                } else if types.int_val_cmp(iv, tb.hi) > 0_i32 {
                    iv = tb.hi;
                }
                return val_scalar(iv.lo & mask_bits(tbits));
            }
            .ToFloat => {
                let fbits = self.env.int_bits(from_ty);
                let fsigned = self.env.is_signed_int(from_ty);
                let iv = sign_extend_i128(self.st.vals.as_u64(op), fbits, fsigned);
                let f64b = int_val_to_f64(iv).bitcast.[u64]();
                if tn_node.kind == .Float && tn_node.u8_val == 16_u8 {
                    let h = f32_bits_to_f16_bits(f64_bits_to_f32_bits(f64b));
                    return val_scalar(h.widen.[u64]());
                }
                if tn_node.kind == .Float && tn_node.u8_val == 32_u8 {
                    return val_scalar(f64_bits_to_f32_bits(f64b).widen.[u64]());
                }
                return val_scalar(f64b);
            }
            .TruncToInt => {
                let raw_b = self.st.vals.as_u64(op);
                let fv: f64 = if fn_node.kind == .Float && fn_node.u8_val == 16_u8 {
                    f16_bits_to_f32_bits(raw_b.trunc.[u16]()).bitcast.[f32]().widen.[f64]()
                } else if fn_node.kind == .Float && fn_node.u8_val == 32_u8 {
                    raw_b.trunc.[u32]().bitcast.[f32]().widen.[f64]()
                } else {
                    raw_b.bitcast.[f64]()
                };
                let tbits = self.env.int_bits(to_ty);
                let tsigned = self.env.is_signed_int(to_ty);
                let iv: u64 = if tsigned {
                    fv.trunc_to_int.[i64]().bitcast.[u64]()
                } else {
                    fv.trunc_to_int.[u64]()
                };
                return val_scalar(iv & mask_bits(tbits));
            }
            .Bitcast => {
                let sz = self.env.x64_layout(to_ty).size;
                var tmp = try col.DynBuf.[u8].init(self.alloc, max_usize(sz, 8_usize));
                errdefer tmp.destroy(self.alloc);
                try self.st.vals.to_dyn_bytes(self.alloc, op, sz, &mut tmp);
                let res = try self.st.vals.from_bytes(self.alloc, tmp.as_slice());
                tmp.destroy(self.alloc);
                return res;
            }
            .WrapOptional => {
                let inner = if tn_node.kind == .Optional { tn_node.primary } else { from_ty };
                if self.env.is_niche_id_opt(inner) {
                    return op;
                }
                let sz = self.env.x64_layout(to_ty).size;
                var buf = try col.DynBuf.[u8].init(self.alloc, max_usize(sz, 8_usize));
                errdefer buf.destroy(self.alloc);
                try push_zero_bytes(self.alloc, &mut buf, sz);
                let bs = buf.as_mut_slice();
                if bs.len > 0_usize {
                    bs[0_usize] = 1_u8;
                }
                let voff = self.env.opt_val_offset(inner);
                let isz = self.env.x64_layout(inner).size;
                var itmp = try col.DynBuf.[u8].init(self.alloc, max_usize(isz, 8_usize));
                errdefer itmp.destroy(self.alloc);
                try self.st.vals.to_dyn_bytes(self.alloc, op, isz, &mut itmp);
                copy_bytes_slice(buf.as_mut_slice(), voff, itmp.as_slice(), 0_usize, isz);
                let res = try self.st.vals.from_bytes(self.alloc, buf.as_slice());
                itmp.destroy(self.alloc);
                buf.destroy(self.alloc);
                return res;
            }
            .WrapOk => {
                let ok_ty = if tn_node.kind == .ErrorUnion { tn_node.primary } else { from_ty };
                return try self.pack_error_union(to_ty, ok_ty, 0_u32, op);
            }
            .WrapErr => {
                let err_code = self.st.vals.as_u64(op).trunc.[u32]();
                return try self.pack_error_union(to_ty, types.TY_VOID, err_code, val_void());
            }
            .ArrayBorrowToSlice => {
                var arr_len: u64 = 0_u64;
                if fn_node.kind == .Borrow && fn_node.borrow_kind == .Single {
                    let an = self.env.get(fn_node.primary);
                    if an.kind == .Array {
                        arr_len = an.u64_val;
                    }
                }
                let ptr_u = self.st.vals.as_u64(op);
                return try self.st.vals.from_pair(self.alloc, ptr_u, arr_len);
            }
        }
    }

    fn eval_cast_numeric(
        self: *Self,
        op: ValSlot,
        from_ty: types.TyId,
        to_ty: types.TyId,
        fn_node: *types.TyNode,
        tn_node: *types.TyNode,
    ) -> ValSlot ! OutOfMemory {
        if fn_node.kind == .Float && tn_node.kind == .Float {
            let raw_b = self.st.vals.as_u64(op);
            let as_f64: f64 = if fn_node.u8_val == 16_u8 {
                f16_bits_to_f32_bits(raw_b.trunc.[u16]()).bitcast.[f32]().widen.[f64]()
            } else if fn_node.u8_val == 32_u8 {
                raw_b.trunc.[u32]().bitcast.[f32]().widen.[f64]()
            } else {
                raw_b.bitcast.[f64]()
            };
            let f64b = as_f64.bitcast.[u64]();
            if tn_node.u8_val == 16_u8 {
                return val_scalar(f32_bits_to_f16_bits(f64_bits_to_f32_bits(f64b)).widen.[u64]());
            }
            if tn_node.u8_val == 32_u8 {
                return val_scalar(f64_bits_to_f32_bits(f64b).widen.[u64]());
            }
            return val_scalar(f64b);
        }
        let fsz = self.env.x64_layout(from_ty).size;
        let tsz = self.env.x64_layout(to_ty).size;
        if fsz == tsz && tsz > 8_usize {
            return op;
        }
        let fbits = self.env.int_bits(from_ty);
        let fsigned = self.env.is_signed_int(from_ty);
        let tbits = self.env.int_bits(to_ty);
        let ext = sign_extend_i128(self.st.vals.as_u64(op), fbits, fsigned);
        return val_scalar(ext.lo & mask_bits(tbits));
    }

    fn eval_aggregate(
        self: *mut Self,
        agg: *cfg_ir.AggregateKind,
        elems_r: ast.IdRange,
        dst_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let elen = elems_r.len.widen.[usize]();
        if agg.tag == .Bitfield {
            var acc: u64 = 0_u64;
            if let m = self.env.get_bitfield(agg.def_id) {
                let mbs = self.env.bitfield_members_range(m.members);
                var i: usize = 0_usize;
                while i < elen && i < mbs.len {
                    let mb = mbs[i];
                    let width: u8 = if mb.hi > mb.lo { mb.hi -% mb.lo } else { 1_u8 };
                    let ev = self.eir_val_at(elems_r, i);
                    let v = self.st.vals.as_u64(frame.get_val(ev)) & mask_bits(width);
                    acc = acc | (v <<% (mb.lo.widen.[u64]() & 63_u64));
                    i = i +% 1_usize;
                }
            }
            return val_scalar(acc);
        }

        let sz = self.env.x64_layout(dst_ty).size;
        var buf = try col.DynBuf.[u8].init(self.alloc, max_usize(sz, 8_usize));
        errdefer buf.destroy(self.alloc);
        try push_zero_bytes(self.alloc, &mut buf, sz);
        var tmp = try col.DynBuf.[u8].init(self.alloc, 16_usize);
        errdefer tmp.destroy(self.alloc);

        match agg.tag {
            .Struct => {
                try self.fill_agg_fields(dst_ty, false, elems_r, frame, &mut buf, &mut tmp);
            }
            .AnonStruct => {
                try self.fill_agg_fields(dst_ty, false, elems_r, frame, &mut buf, &mut tmp);
            }
            .Tuple => {
                try self.fill_agg_fields(dst_ty, false, elems_r, frame, &mut buf, &mut tmp);
            }
            .PoolRow => {
                try self.fill_agg_fields(dst_ty, agg.is_slot_pool, elems_r, frame, &mut buf, &mut tmp);
            }
            .Array => {
                let esz = max_usize(self.env.x64_layout(agg.elem_ty).size, 1_usize);
                var i: usize = 0_usize;
                while i < elen {
                    let start = i *% esz;
                    if start +% esz <= buf.len() {
                        let ev = self.eir_val_at(elems_r, i);
                        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(ev), esz, &mut tmp);
                        copy_bytes_slice(buf.as_mut_slice(), start, tmp.as_slice(), 0_usize, esz);
                    }
                    i = i +% 1_usize;
                }
            }
            .Vec => {
                let esz = max_usize(self.env.x64_layout(agg.elem_ty).size, 1_usize);
                var i: usize = 0_usize;
                while i < elen {
                    let start = i *% esz;
                    if start +% esz <= buf.len() {
                        let ev = self.eir_val_at(elems_r, i);
                        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(ev), esz, &mut tmp);
                        copy_bytes_slice(buf.as_mut_slice(), start, tmp.as_slice(), 0_usize, esz);
                    }
                    i = i +% 1_usize;
                }
            }
            .ArrayRepeat => {
                if elen > 0_usize {
                    let esz = max_usize(self.env.x64_layout(agg.elem_ty).size, 1_usize);
                    let ev0 = self.eir_val_at(elems_r, 0_usize);
                    try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(ev0), esz, &mut tmp);
                    let cnt = agg.count.trunc.[usize]();
                    var i: usize = 0_usize;
                    while i < cnt {
                        let start = i *% esz;
                        if start +% esz <= buf.len() {
                            copy_bytes_slice(buf.as_mut_slice(), start, tmp.as_slice(), 0_usize, esz);
                        }
                        i = i +% 1_usize;
                    }
                }
            }
            .UnionVariant => {
                write_le_u32_at(buf.as_mut_slice(), 0_usize, agg.variant_idx);
                if elen > 0_usize {
                    if let m = self.env.get_union(agg.def_id) {
                        let vs = self.env.union_variants_range(m.variants);
                        let vi = agg.variant_idx.widen.[usize]();
                        if vi < vs.len && vs[vi].has_payload {
                            let pty = vs[vi].payload;
                            let p_off = self.env.union_payload_offset(agg.def_id);
                            let psz = self.env.x64_layout(pty).size;
                            let ev0 = self.eir_val_at(elems_r, 0_usize);
                            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(ev0), psz, &mut tmp);
                            copy_bytes_slice(buf.as_mut_slice(), p_off, tmp.as_slice(), 0_usize, psz);
                        }
                    }
                }
            }
            .Bitfield => {}
        }
        let res = try self.st.vals.from_bytes(self.alloc, buf.as_slice());
        tmp.destroy(self.alloc);
        buf.destroy(self.alloc);
        return res;
    }

    fn fill_agg_fields(
        self: *Self,
        dst_ty: types.TyId,
        link_is_slot: bool,
        elems_r: ast.IdRange,
        frame: *FrameState,
        buf: *mut col.DynBuf[u8],
        tmp: *mut col.DynBuf[u8],
    ) -> !OutOfMemory {
        let elen = elems_r.len.widen.[usize]();
        var i: usize = 0_usize;
        while i < elen {
            let fo = self.env.struct_field_offset(dst_ty, i);
            let fsz = self.env.x64_layout_impl(fo.ty, link_is_slot).size;
            let ev = self.eir_val_at(elems_r, i);
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(ev), fsz, tmp);
            copy_bytes_slice(buf.as_mut_slice(), fo.offset, tmp.as_slice(), 0_usize, fsz);
            i = i +% 1_usize;
        }
        return;
    }
}

// ===========================================================================
// Section 6: Place Resolution, Pointer Args, and Extern "C" Runtime Hooks
// ===========================================================================

struct PlaceTarget {
    kind: u8;
    addr: u64;
    temp_alloc: u64;
    slice_val: ValSlot;
    base_ty: types.TyId;
    field_ty: types.TyId;
    lo_bit: u8;
    hi_bit: u8;
}

fn pt_addr(addr: u64, temp: u64) -> PlaceTarget {
    return PlaceTarget.{
        kind: PT_ADDR,
        addr: addr,
        temp_alloc: temp,
        slice_val: val_void(),
        base_ty: types.TY_VOID,
        field_ty: types.TY_VOID,
        lo_bit: 0_u8,
        hi_bit: 0_u8,
    };
}

fn is_single_ptr_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    let n = env.get(ty);
    return (n.kind == .Borrow && n.borrow_kind == .Single) || n.kind == .RawPtr;
}

fn deref_single_ty(env: *types.TypeEnv, ty: types.TyId) -> types.TyId {
    let n = env.get(ty);
    if (n.kind == .Borrow && n.borrow_kind == .Single) || n.kind == .RawPtr {
        return n.primary;
    }
    return ty;
}

impl Interp {
    fn eval_place_addr(
        self: *mut Self,
        fn_id: u32,
        place: *eir.EirPlace,
        frame: *FrameState,
    ) -> PlaceTarget ! OutOfMemory {
        var addr: u64 = 0_u64;
        var cur_ty = types.TY_VOID;
        var temp_alloc: u64 = 0_u64;

        if place.base.kind == .Slot {
            addr = frame.get_slot_ptr(place.base.id);
            if let s = self.eir.fn_slot(fn_id, place.base.id) {
                cur_ty = s.ty;
            }
        } else {
            let vty = self.eir.fn_val_ty(fn_id, place.base.id);
            let sz = max_usize(interp_ty_size(self.env, vty), 1_usize);
            var tmp = try col.DynBuf.[u8].init(self.alloc, sz);
            errdefer tmp.destroy(self.alloc);
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(place.base.id), sz, &mut tmp);
            let p = try self.mem_alloc_bytes(tmp.as_slice(), false);
            tmp.destroy(self.alloc);
            if self.st.faulted {
                return pt_addr(0_u64, 0_u64);
            }
            addr = p;
            cur_ty = vty;
            temp_alloc = p;
        }

        let proj_r = place.projs;
        let plen = proj_r.len.widen.[usize]();
        var i: usize = 0_usize;
        while i < plen {
            let psl = self.eir.projs_slice(proj_r);
            if i >= psl.len {
                break;
            }
            let pr = psl[i];
            match pr.kind {
                .Deref => {
                    let inner = deref_single_ty(self.env, cur_ty);
                    if self.env.get(inner).kind != .Pool {
                        addr = try self.mem_read_u64(addr);
                    }
                    cur_ty = inner;
                }
                .Field => {
                    let bt = try self.eval_place_proj_field(pr, temp_alloc, &mut addr, &mut cur_ty);
                    if bt.kind != PT_ADDR {
                        return bt;
                    }
                }
                .TupleField => {
                    if is_single_ptr_ty(self.env, cur_ty) {
                        addr = try self.mem_read_u64(addr);
                    }
                    let deref_t = deref_single_ty(self.env, cur_ty);
                    let foff = self.env.struct_field_offset(deref_t, pr.index.widen.[usize]()).offset;
                    addr = try self.mem_ptr_add(addr, foff);
                    cur_ty = pr.ty;
                }
                .PoolCol => {
                    let psl2 = self.eir.projs_slice(proj_r);
                    var has_next_idx = false;
                    var next_pr = pr;
                    if i +% 1_usize < psl2.len {
                        let cand = psl2[i +% 1_usize];
                        if cand.kind == .Index {
                            has_next_idx = true;
                            next_pr = cand;
                        }
                    }
                    if has_next_idx {
                        try self.eval_place_proj_pool_col_idx(pr, next_pr, frame, &mut addr, &mut cur_ty);
                        if self.st.faulted {
                            self.mem_free_quiet(temp_alloc);
                            return pt_addr(0_u64, 0_u64);
                        }
                        i = i +% 2_usize;
                        continue;
                    }
                    return try self.eval_place_proj_pool_col_slice(pr, temp_alloc, addr, cur_ty);
                }
                .Index => {
                    try self.eval_place_proj_index(pr, frame, &mut addr, &mut cur_ty);
                }
            }
            if self.st.faulted {
                self.mem_free_quiet(temp_alloc);
                return pt_addr(0_u64, 0_u64);
            }
            i = i +% 1_usize;
        }
        return pt_addr(addr, temp_alloc);
    }

    fn eval_place_proj_field(
        self: *mut Self,
        pr: eir.EirProj,
        temp_alloc: u64,
        addr: *mut u64,
        cur_ty: *mut types.TyId,
    ) -> PlaceTarget ! OutOfMemory {
        let is_ptr = is_single_ptr_ty(self.env, cur_ty.*);
        let deref_t = deref_single_ty(self.env, cur_ty.*);
        let dn = self.env.get(deref_t);
        if dn.kind == .Pool && is_ptr {
            let pool_ptr = try self.mem_read_u64(addr.*);
            let row_idx = (try self.mem_read_u32_off(addr.*, 8_usize)).widen.[usize]();
            let col_ptr = try self.mem_read_u64_off(pool_ptr, pr.index.widen.[usize]() *% 8_usize);
            let elem_sz = max_usize(self.env.x64_layout_impl(pr.ty, true).size, 1_usize);
            addr.* = try self.mem_ptr_add(col_ptr, row_idx *% elem_sz);
            cur_ty.* = pr.ty;
            return pt_addr(addr.*, temp_alloc);
        }
        if dn.kind == .Bitfield {
            if is_ptr {
                addr.* = try self.mem_read_u64(addr.*);
            }
            if self.st.faulted {
                self.mem_free_quiet(temp_alloc);
                return PlaceTarget.{
                    kind: PT_BITFIELD,
                    addr: 0_u64,
                    temp_alloc: 0_u64,
                    slice_val: val_void(),
                    base_ty: types.TY_VOID,
                    field_ty: types.TY_VOID,
                    lo_bit: 0_u8,
                    hi_bit: 0_u8,
                };
            }
            let meta = self.env.get_bitfield(dn.primary) orelse {
                self.mem_free_quiet(temp_alloc);
                try self.fail("EIR-Interp: missing bitfield metadata");
                return pt_addr(0_u64, 0_u64);
            };
            let mbs = self.env.bitfield_members_range(meta.members);
            let fi = pr.index.widen.[usize]();
            if fi >= mbs.len {
                self.mem_free_quiet(temp_alloc);
                try self.fail("EIR-Interp: bitfield field_idx out of range");
                return pt_addr(0_u64, 0_u64);
            }
            return PlaceTarget.{
                kind: PT_BITFIELD,
                addr: addr.*,
                temp_alloc: temp_alloc,
                slice_val: val_void(),
                base_ty: meta.base_ty,
                field_ty: pr.ty,
                lo_bit: mbs[fi].lo,
                hi_bit: mbs[fi].hi,
            };
        }
        if is_ptr {
            addr.* = try self.mem_read_u64(addr.*);
        }
        let foff = self.env.struct_field_offset(deref_t, pr.index.widen.[usize]()).offset;
        addr.* = try self.mem_ptr_add(addr.*, foff);
        cur_ty.* = pr.ty;
        return pt_addr(addr.*, temp_alloc);
    }

    fn eval_place_proj_pool_col_idx(
        self: *mut Self,
        pr: eir.EirProj,
        next_pr: eir.EirProj,
        frame: *FrameState,
        addr: *mut u64,
        cur_ty: *mut types.TyId,
    ) -> !OutOfMemory {
        if is_single_ptr_ty(self.env, cur_ty.*) {
            addr.* = try self.mem_read_u64(addr.*);
        }
        let col_ptr = try self.mem_read_u64_off(addr.*, pr.index.widen.[usize]() *% 8_usize);
        let raw_idx = self.st.vals.as_u64(frame.get_val(next_pr.index));
        let idx = if pr.is_slot_pool {
            (raw_idx & 0xFFFFFFFF_u64).trunc.[usize]()
        } else {
            raw_idx.trunc.[usize]()
        };
        let esz = max_usize(self.env.x64_layout_impl(pr.ty, pr.is_slot_pool).size, 1_usize);
        addr.* = try self.mem_ptr_add(col_ptr, idx *% esz);
        cur_ty.* = next_pr.ty;
        return;
    }

    fn eval_place_proj_pool_col_slice(
        self: *mut Self,
        pr: eir.EirProj,
        temp_alloc: u64,
        base_addr: u64,
        cur_ty: types.TyId,
    ) -> PlaceTarget ! OutOfMemory {
        var addr = base_addr;
        if is_single_ptr_ty(self.env, cur_ty) {
            addr = try self.mem_read_u64(addr);
        }
        let deref = deref_single_ty(self.env, cur_ty);
        let dn = self.env.get(deref);
        let ncols = if dn.kind == .Builtin {
            self.env.pool_col_count(self.env.node_gval_list(&dn))
        } else {
            0_usize
        };
        let len_off = if pr.is_slot_pool { (ncols +% 2_usize) *% 8_usize } else { ncols *% 8_usize };
        let col_ptr = try self.mem_read_u64_off(addr, pr.index.widen.[usize]() *% 8_usize);
        let len_v = try self.mem_read_u64_off(addr, len_off);
        self.mem_free_quiet(temp_alloc);
        if self.st.faulted {
            return pt_addr(0_u64, 0_u64);
        }
        let sv = try self.st.vals.from_pair(self.alloc, col_ptr, len_v);
        return PlaceTarget.{
            kind: PT_SLICE_VAL,
            addr: 0_u64,
            temp_alloc: 0_u64,
            slice_val: sv,
            base_ty: types.TY_VOID,
            field_ty: types.TY_VOID,
            lo_bit: 0_u8,
            hi_bit: 0_u8,
        };
    }

    fn eval_place_proj_index(
        self: *mut Self,
        pr: eir.EirProj,
        frame: *FrameState,
        addr: *mut u64,
        cur_ty: *mut types.TyId,
    ) -> !OutOfMemory {
        if is_single_ptr_ty(self.env, cur_ty.*) {
            addr.* = try self.mem_read_u64(addr.*);
        }
        let deref_t = deref_single_ty(self.env, cur_ty.*);
        let idx_u64 = self.st.vals.as_u64(frame.get_val(pr.index));
        let idx = idx_u64.trunc.[usize]();
        let dn = self.env.get(deref_t);
        if (dn.kind == .Borrow && (dn.borrow_kind == .Slice || dn.borrow_kind == .Str))
            || dn.kind == .Str
        {
            let data_ptr = try self.mem_read_u64(addr.*);
            let len_v = try self.mem_read_u64_off(addr.*, 8_usize);
            if !self.st.faulted && idx_u64 >= len_v {
                try self.fail("EIR-Interp: slice index out of bounds");
                return;
            }
            addr.* = data_ptr;
        } else if dn.kind == .Array {
            if idx_u64 >= dn.u64_val {
                try self.fail("EIR-Interp: array index out of bounds");
                return;
            }
        } else if dn.kind == .Vec {
            if idx_u64 >= dn.u8_val.widen.[u64]() {
                try self.fail("EIR-Interp: vec index out of bounds");
                return;
            }
        }
        let esz = max_usize(self.env.x64_layout(pr.ty).size, 1_usize);
        addr.* = try self.mem_ptr_add(addr.*, idx *% esz);
        cur_ty.* = pr.ty;
        return;
    }

    fn eval_pool_base_ptr(
        self: *mut Self,
        pbase: eir.EirPlaceBase,
        pool_is_ptr: bool,
        frame: *FrameState,
    ) -> PtrTemp ! OutOfMemory {
        if pbase.kind == .Slot {
            let sp = frame.get_slot_ptr(pbase.id);
            if pool_is_ptr {
                return PtrTemp.{ ptr: try self.mem_read_u64(sp), temp: 0_u64 };
            }
            return PtrTemp.{ ptr: sp, temp: 0_u64 };
        }
        let v = frame.get_val(pbase.id);
        if pool_is_ptr {
            return PtrTemp.{ ptr: self.st.vals.as_u64(v), temp: 0_u64 };
        }
        let sz = if v.kind == VAL_BYTES { max_usize(v.len.widen.[usize](), 8_usize) } else { 8_usize };
        var tmp = try col.DynBuf.[u8].init(self.alloc, sz);
        errdefer tmp.destroy(self.alloc);
        try self.st.vals.to_dyn_bytes(self.alloc, v, sz, &mut tmp);
        let tp = try self.mem_alloc_bytes(tmp.as_slice(), false);
        tmp.destroy(self.alloc);
        return PtrTemp.{ ptr: tp, temp: tp };
    }

    fn resolve_ptr_arg(
        self: *mut Self,
        fn_id: u32,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        idx: usize,
        frame: *FrameState,
    ) -> PtrTemp ! OutOfMemory {
        let slen = slots_r.len.widen.[usize]();
        if idx < slen {
            let slot = self.eir_slot_at(slots_r, idx);
            if slot != eir.EIR_NONE {
                let sp = frame.get_slot_ptr(slot);
                if let s = self.eir.fn_slot(fn_id, slot) {
                    let sk = self.env.get(s.ty).kind;
                    if sk == .Borrow || sk == .RawPtr {
                        return PtrTemp.{ ptr: try self.mem_read_u64(sp), temp: 0_u64 };
                    }
                }
                return PtrTemp.{ ptr: sp, temp: 0_u64 };
            }
        }
        if idx >= args_r.len.widen.[usize]() {
            try self.fail("EIR-Interp: missing builtin pointer argument");
            return PtrTemp.{ ptr: 0_u64, temp: 0_u64 };
        }
        let v = self.eir_val_at(args_r, idx);
        let vty = self.eir.fn_val_ty(fn_id, v);
        let vk = self.env.get(vty).kind;
        if vk == .Borrow || vk == .RawPtr {
            return PtrTemp.{ ptr: self.st.vals.as_u64(frame.get_val(v)), temp: 0_u64 };
        }
        let sz = max_usize(interp_ty_size(self.env, vty), 1_usize);
        var tmp = try col.DynBuf.[u8].init(self.alloc, sz);
        errdefer tmp.destroy(self.alloc);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(v), sz, &mut tmp);
        let tp = try self.mem_alloc_bytes(tmp.as_slice(), false);
        tmp.destroy(self.alloc);
        return PtrTemp.{ ptr: tp, temp: tp };
    }

    fn exec_extern_fn(
        self: *mut Self,
        name_sym: u32,
        args: *[ValSlot],
    ) -> ValSlot ! OutOfMemory {
        let name = self.interner.get(name_sym);
        if str.bytes_eq(name, "eon_rt_print_str".as_bytes())
            || str.bytes_eq(name, "eon_rt_print_bytes".as_bytes())
        {
            if args.len > 0_usize {
                let pr = self.st.vals.as_pair(args[0_usize]);
                var tmp = try col.DynBuf.[u8].init(self.alloc, max_usize(pr.b.trunc.[usize](), 16_usize));
                errdefer tmp.destroy(self.alloc);
                if try self.mem_read_dyn(pr.a, pr.b.trunc.[usize](), &mut tmp) {
                    try self.st.stdout.push_bytes_grow(self.alloc, tmp.as_slice());
                }
                tmp.destroy(self.alloc);
            }
            return val_void();
        }
        if str.bytes_eq(name, "eon_rt_eprint_str".as_bytes())
            || str.bytes_eq(name, "eon_rt_eprint_bytes".as_bytes())
        {
            if args.len > 0_usize {
                let pr = self.st.vals.as_pair(args[0_usize]);
                var tmp = try col.DynBuf.[u8].init(self.alloc, max_usize(pr.b.trunc.[usize](), 16_usize));
                errdefer tmp.destroy(self.alloc);
                if try self.mem_read_dyn(pr.a, pr.b.trunc.[usize](), &mut tmp) {
                    try self.st.stderr.push_bytes_grow(self.alloc, tmp.as_slice());
                }
                tmp.destroy(self.alloc);
            }
            return val_void();
        }
        if str.bytes_eq(name, "eon_rt_print_u64".as_bytes()) {
            if args.len > 0_usize {
                try self.st.stdout.push_u64_grow(self.alloc, self.st.vals.as_u64(args[0_usize]));
            }
            return val_void();
        }
        if str.bytes_eq(name, "eon_rt_print_i64".as_bytes()) {
            if args.len > 0_usize {
                let iv = self.st.vals.as_u64(args[0_usize]).bitcast.[i64]();
                try self.st.stdout.push_i64_grow(self.alloc, iv);
            }
            return val_void();
        }
        if str.bytes_eq(name, "eon_rt_print_f32".as_bytes()) {
            if args.len > 0_usize {
                let bits = self.st.vals.as_u64(args[0_usize]).trunc.[u32]();
                try push_f32_fixed2(self.alloc, bits, &mut self.st.stdout);
            }
            return val_void();
        }
        if str.bytes_eq(name, "eon_rt_print_nl".as_bytes()) {
            try self.st.stdout.push_byte_grow(self.alloc, b'\n');
            return val_void();
        }
        if str.bytes_eq(name, "eon_rt_eprint_nl".as_bytes()) {
            try self.st.stderr.push_byte_grow(self.alloc, b'\n');
            return val_void();
        }
        if str.bytes_eq(name, "eon_rt_now_ns".as_bytes()) {
            self.st.clock_tick = self.st.clock_tick +% 100_u64;
            return val_scalar(self.st.clock_tick);
        }
        try self.fail_with_sym("EIR-Interp: unknown extern \"C\" function `", name_sym, "`");
        return val_void();
    }
}

// ===========================================================================
// Section 7: Builtin Execution — Arena, Caps, Host FS/Dir/Net/Io, BuildCap
// ===========================================================================

fn error_union_ok_ty(env: *types.TypeEnv, ret_ty: types.TyId, fallback: types.TyId) -> types.TyId {
    let n = env.get(ret_ty);
    if n.kind == .ErrorUnion {
        return n.primary;
    }
    return fallback;
}

impl Interp {
    fn read_str_ival(self: *mut Self, v: ValSlot, out: *mut str.StrBuf) -> u32 ! OutOfMemory {
        out.clear();
        let pr = self.st.vals.as_pair(v);
        var tmp = try col.DynBuf.[u8].init(self.alloc, max_usize(pr.b.trunc.[usize](), 16_usize));
        errdefer tmp.destroy(self.alloc);
        if !(try self.mem_read_dyn(pr.a, pr.b.trunc.[usize](), &mut tmp)) {
            tmp.destroy(self.alloc);
            return ERR_INVALID_INPUT;
        }
        str.validate_utf8(tmp.as_slice()) catch {
            tmp.destroy(self.alloc);
            return ERR_INVALID_INPUT;
        };
        try out.push_bytes_grow(self.alloc, tmp.as_slice());
        tmp.destroy(self.alloc);
        return 0_u32;
    }

    fn read_build_str(self: *mut Self, v: ValSlot, out: *mut str.StrBuf) -> bool ! OutOfMemory {
        let code = try self.read_str_ival(v, out);
        if self.st.faulted {
            return false;
        }
        if code != 0_u32 {
            try self.fail("build.eon error: string argument is not valid UTF-8");
            return false;
        }
        return true;
    }

    fn resolve_dir_root(self: *Self, handle: u64, out: *mut str.StrBuf) -> u32 ! OutOfMemory {
        out.clear();
        let idx = handle.trunc.[usize]();
        let rs = self.st.io.dir_roots.as_slice();
        if idx >= rs.len || !rs[idx].alive {
            return ERR_PERM;
        }
        let r = rs[idx].range;
        let all = self.st.io.dir_bytes.as_slice();
        let s = r.start.widen.[usize]();
        let e = s +% r.len.widen.[usize]();
        let bs = all.sub(s, e) catch {
            return ERR_PERM;
        };
        try out.push_bytes_grow(self.alloc, bs);
        return 0_u32;
    }

    fn push_dir_root(self: *mut Self, path_bytes: *[u8]) -> u64 ! OutOfMemory {
        let start = self.st.io.dir_bytes.len().trunc.[u32]();
        try self.st.io.dir_bytes.push_slice(self.alloc, path_bytes);
        let id = self.st.io.dir_roots.len().widen.[u64]();
        try self.st.io.dir_roots.push(
            self.alloc,
            DirRootMeta.{ alive: true, range: ast.range_new(start, path_bytes.len.trunc.[u32]()) },
        );
        return id;
    }

    fn pack_buf_u8_to_eu(
        self: *mut Self,
        alloc_ptr: u64,
        bytes: *[u8],
        ret_ty: types.TyId,
    ) -> ValSlot ! OutOfMemory {
        let data_ptr = try self.alloc_raw_tracked(alloc_ptr, bytes.len);
        if self.st.faulted {
            return val_void();
        }
        if data_ptr == 0_u64 {
            return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
        }
        if bytes.len > 0_usize {
            _ = try self.mem_write(data_ptr, bytes);
            if self.st.faulted {
                return val_void();
            }
        }
        var buf: [24]u8 = [0_u8; 24];
        write_le_u64_at(&mut buf, 0_usize, data_ptr, 8_usize);
        write_le_u64_at(&mut buf, 8_usize, bytes.len.widen.[u64](), 8_usize);
        write_le_u64_at(&mut buf, 16_usize, bytes.len.widen.[u64](), 8_usize);
        let bv = try self.st.vals.from_bytes(self.alloc, &buf);
        let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
        return try self.pack_error_union(ret_ty, ok_ty, 0_u32, bv);
    }

    fn exec_builtin_mem_caps(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        match op.kind {
            .ArenaInit => { return try self.exec_builtin_arena(fn_id, op.kind, args_r, slots_r, ret_ty, frame); }
            .ArenaAlloc => { return try self.exec_builtin_arena(fn_id, op.kind, args_r, slots_r, ret_ty, frame); }
            .ArenaReset => { return try self.exec_builtin_arena(fn_id, op.kind, args_r, slots_r, ret_ty, frame); }
            .ArenaDestroy => { return try self.exec_builtin_arena(fn_id, op.kind, args_r, slots_r, ret_ty, frame); }
            .ArenaUsedBytes => { return try self.exec_builtin_arena(fn_id, op.kind, args_r, slots_r, ret_ty, frame); }
            .ArenaCapacity => { return try self.exec_builtin_arena(fn_id, op.kind, args_r, slots_r, ret_ty, frame); }
            _ => { return try self.exec_builtin_caps_misc(fn_id, op.kind, args_r, slots_r, frame); }
        }
    }

    fn exec_builtin_arena(
        self: *mut Self,
        fn_id: u32,
        kind: cfg_ir.CfgBuiltinOpKind,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        match kind {
            .ArenaInit => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let a1 = self.eir_val_at(args_r, 1_usize);
                let cap_bytes = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                let base_ptr = try self.alloc_raw_tracked(p0.ptr, cap_bytes);
                self.mem_free_quiet(p0.temp);
                if self.st.faulted {
                    return val_void();
                }
                if base_ptr == 0_u64 {
                    return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
                }
                var ab: [24]u8 = [0_u8; 24];
                write_le_u64_at(&mut ab, 0_usize, base_ptr, 8_usize);
                write_le_u64_at(&mut ab, 8_usize, 0_u64, 8_usize);
                write_le_u64_at(&mut ab, 16_usize, cap_bytes.widen.[u64](), 8_usize);
                let av = try self.st.vals.from_bytes(self.alloc, &ab);
                let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                return try self.pack_error_union(ret_ty, ok_ty, 0_u32, av);
            }
            .ArenaAlloc => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let a1 = self.eir_val_at(args_r, 1_usize);
                let req = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                let base = try self.mem_read_u64(p0.ptr);
                let used = (try self.mem_read_u64_off(p0.ptr, 8_usize)).trunc.[usize]();
                let cap = (try self.mem_read_u64_off(p0.ptr, 16_usize)).trunc.[usize]();
                if self.st.faulted {
                    self.mem_free_quiet(p0.temp);
                    return val_void();
                }
                let aligned_used = (used +% 7_usize) & (~7_usize);
                var fits = false;
                var end_used: usize = 0_usize;
                let end_try = (aligned_used +? req) catch {
                    self.mem_free_quiet(p0.temp);
                    return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
                };
                if end_try <= cap {
                    fits = true;
                    end_used = end_try;
                }
                var res = val_void();
                if fits {
                    _ = try self.mem_write_u64_off(p0.ptr, 8_usize, end_used.widen.[u64]());
                    let slice_ptr = try self.mem_ptr_add(base, aligned_used);
                    let sv = try self.st.vals.from_pair(self.alloc, slice_ptr, req.widen.[u64]());
                    let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                    res = try self.pack_error_union(ret_ty, ok_ty, 0_u32, sv);
                } else {
                    res = try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
                }
                self.mem_free_quiet(p0.temp);
                return res;
            }
            .ArenaReset => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                _ = try self.mem_write_u64_off(p0.ptr, 8_usize, 0_u64);
                self.mem_free_quiet(p0.temp);
                return val_void();
            }
            .ArenaDestroy => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let p1 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 1_usize, frame);
                let base = try self.mem_read_u64(p0.ptr);
                let cap = (try self.mem_read_u64_off(p0.ptr, 16_usize)).trunc.[usize]();
                if !self.st.faulted {
                    try self.free_raw_tracked(p1.ptr, base, cap);
                    _ = try self.mem_write_u64(p0.ptr, 0_u64);
                    _ = try self.mem_write_u64_off(p0.ptr, 8_usize, 0_u64);
                    _ = try self.mem_write_u64_off(p0.ptr, 16_usize, 0_u64);
                }
                self.mem_free_quiet(p0.temp);
                self.mem_free_quiet(p1.temp);
                return val_void();
            }
            .ArenaUsedBytes => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let v = try self.mem_read_u64_off(p0.ptr, 8_usize);
                self.mem_free_quiet(p0.temp);
                return val_scalar(v);
            }
            .ArenaCapacity => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let v = try self.mem_read_u64_off(p0.ptr, 16_usize);
                self.mem_free_quiet(p0.temp);
                return val_scalar(v);
            }
            _ => { return val_void(); }
        }
    }

    fn exec_builtin_caps_misc(
        self: *mut Self,
        fn_id: u32,
        kind: cfg_ir.CfgBuiltinOpKind,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        match kind {
            .AllocCapLiveAllocs => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let v = try self.mem_read_u64(p0.ptr);
                self.mem_free_quiet(p0.temp);
                return val_scalar(v);
            }
            .AllocCapUsedBytes => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let v = try self.mem_read_u64_off(p0.ptr, 8_usize);
                self.mem_free_quiet(p0.temp);
                return val_scalar(v);
            }
            .AllocCapPeakBytes => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let v = try self.mem_read_u64_off(p0.ptr, 16_usize);
                self.mem_free_quiet(p0.temp);
                return val_scalar(v);
            }
            .AllocCapSubBudget => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let a1 = self.eir_val_at(args_r, 1_usize);
                let limit = self.st.vals.as_u64(frame.get_val(a1));
                self.mem_free_quiet(p0.temp);
                var cb: [40]u8 = [0_u8; 40];
                write_le_u64_at(&mut cb, 24_usize, limit, 8_usize);
                write_le_u64_at(&mut cb, 32_usize, p0.ptr, 8_usize);
                return try self.st.vals.from_bytes(self.alloc, &cb);
            }
            .ClockNowNs => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                _ = try self.mem_read_u64(p0.ptr);
                self.mem_free_quiet(p0.temp);
                self.st.last_clock_ns = self.st.last_clock_ns +% 100_u64;
                return val_scalar(self.st.last_clock_ns);
            }
            .ArgsLen => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let argc = try self.mem_read_u64(p0.ptr);
                self.mem_free_quiet(p0.temp);
                return val_scalar(argc);
            }
            .ArgsGet => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let a1 = self.eir_val_at(args_r, 1_usize);
                let idx = self.st.vals.as_u64(frame.get_val(a1));
                let argc = try self.mem_read_u64(p0.ptr);
                let table_ptr = try self.mem_read_u64_off(p0.ptr, 8_usize);
                self.mem_free_quiet(p0.temp);
                if self.st.faulted {
                    return val_void();
                }
                if idx < argc {
                    let entry = try self.mem_ptr_add(table_ptr, idx.trunc.[usize]() *% 16_usize);
                    let sptr = try self.mem_read_u64(entry);
                    let slen = try self.mem_read_u64_off(entry, 8_usize);
                    return try self.st.vals.from_pair(self.alloc, sptr, slen);
                }
                return try self.st.vals.from_pair(self.alloc, 0_u64, 0xFFFFFFFFFFFFFFFF_u64);
            }
            _ => { return val_void(); }
        }
    }

    fn exec_fs_open_or_sub(
        self: *mut Self,
        fn_id: u32,
        confined: bool,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let handle = try self.mem_read_u64(p0.ptr);
        self.mem_free_quiet(p0.temp);
        if self.st.faulted {
            return val_void();
        }
        var root_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer root_buf.destroy(self.alloc);
        let rcode = try self.resolve_dir_root(handle, &mut root_buf);
        if rcode != 0_u32 {
            let res = try self.pack_error_union(ret_ty, types.TY_VOID, rcode, val_void());
            root_buf.destroy(self.alloc);
            return res;
        }
        var path_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer path_buf.destroy(self.alloc);
        let a1 = self.eir_val_at(args_r, 1_usize);
        let pcode = try self.read_str_ival(frame.get_val(a1), &mut path_buf);
        if self.st.faulted {
            path_buf.destroy(self.alloc);
            root_buf.destroy(self.alloc);
            return val_void();
        }
        if pcode != 0_u32 {
            let res = try self.pack_error_union(ret_ty, types.TY_VOID, pcode, val_void());
            path_buf.destroy(self.alloc);
            root_buf.destroy(self.alloc);
            return res;
        }
        var joined = try str.StrBuf.init(self.alloc, 128_usize);
        errdefer joined.destroy(self.alloc);
        var err_code: u32 = 0_u32;
        if confined {
            err_code = check_lexical_confined_rel(path_buf.as_bytes());
            if err_code == 0_u32 {
                let rstr = root_buf.as_str() catch { err_code = ERR_INVALID_INPUT; "" };
                let pstr = path_buf.as_str() catch { err_code = ERR_INVALID_INPUT; "" };
                if err_code == 0_u32 {
                    err_code = host_dir_sub_dir_code(self.host_fs, rstr, pstr);
                }
                if err_code == 0_u32 {
                    try join_path_bytes(self.alloc, root_buf.as_bytes(), path_buf.as_bytes(), &mut joined);
                }
            }
        } else {
            if path_buf.len() == 0_usize || bytes_has_nul(path_buf.as_bytes()) {
                err_code = ERR_INVALID_INPUT;
            } else {
                try join_path_bytes(self.alloc, root_buf.as_bytes(), path_buf.as_bytes(), &mut joined);
                let jstr = joined.as_str() catch { err_code = ERR_INVALID_INPUT; "" };
                if err_code == 0_u32 {
                    err_code = host_open_dir_code(self.host_fs, jstr);
                }
            }
        }
        var res = val_void();
        if err_code != 0_u32 {
            res = try self.pack_error_union(ret_ty, types.TY_VOID, err_code, val_void());
        } else {
            let new_id = try self.push_dir_root(joined.as_bytes());
            let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
            res = try self.pack_error_union(ret_ty, ok_ty, 0_u32, val_scalar(new_id));
        }
        joined.destroy(self.alloc);
        path_buf.destroy(self.alloc);
        root_buf.destroy(self.alloc);
        return res;
    }

    fn exec_fs_read_file(
        self: *mut Self,
        fn_id: u32,
        confined: bool,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let p1 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 1_usize, frame);
        let handle = try self.mem_read_u64(p0.ptr);
        self.mem_free_quiet(p0.temp);
        if self.st.faulted {
            self.mem_free_quiet(p1.temp);
            return val_void();
        }
        var root_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer root_buf.destroy(self.alloc);
        let rcode = try self.resolve_dir_root(handle, &mut root_buf);
        if rcode != 0_u32 {
            let res = try self.pack_error_union(ret_ty, types.TY_VOID, rcode, val_void());
            root_buf.destroy(self.alloc);
            self.mem_free_quiet(p1.temp);
            return res;
        }
        var path_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer path_buf.destroy(self.alloc);
        let a2 = self.eir_val_at(args_r, 2_usize);
        let pcode = try self.read_str_ival(frame.get_val(a2), &mut path_buf);
        if self.st.faulted || pcode != 0_u32 {
            var res = val_void();
            if !self.st.faulted {
                res = try self.pack_error_union(ret_ty, types.TY_VOID, pcode, val_void());
            }
            path_buf.destroy(self.alloc);
            root_buf.destroy(self.alloc);
            self.mem_free_quiet(p1.temp);
            return res;
        }
        var data = try col.DynBuf.[u8].init(self.alloc, 64_usize);
        errdefer data.destroy(self.alloc);
        var err_code: u32 = 0_u32;
        if confined {
            err_code = check_lexical_confined_rel(path_buf.as_bytes());
            if err_code == 0_u32 {
                let rstr = root_buf.as_str() catch { err_code = ERR_INVALID_INPUT; "" };
                let pstr = path_buf.as_str() catch { err_code = ERR_INVALID_INPUT; "" };
                if err_code == 0_u32 {
                    err_code = host_dir_read_file_code(self.host_fs, self.alloc, rstr, pstr, &mut data);
                }
            }
        } else if path_buf.len() == 0_usize || bytes_has_nul(path_buf.as_bytes()) {
            err_code = ERR_INVALID_INPUT;
        } else {
            var joined = try str.StrBuf.init(self.alloc, 128_usize);
            errdefer joined.destroy(self.alloc);
            try join_path_bytes(self.alloc, root_buf.as_bytes(), path_buf.as_bytes(), &mut joined);
            let jstr = joined.as_str() catch { err_code = ERR_INVALID_INPUT; "" };
            if err_code == 0_u32 {
                err_code = host_read_file_code(self.host_fs, self.alloc, jstr, &mut data);
            }
            joined.destroy(self.alloc);
        }
        var res = val_void();
        if err_code != 0_u32 {
            res = try self.pack_error_union(ret_ty, types.TY_VOID, err_code, val_void());
        } else {
            res = try self.pack_buf_u8_to_eu(p1.ptr, data.as_slice(), ret_ty);
        }
        data.destroy(self.alloc);
        path_buf.destroy(self.alloc);
        root_buf.destroy(self.alloc);
        self.mem_free_quiet(p1.temp);
        return res;
    }

    fn exec_fs_write_file(
        self: *mut Self,
        fn_id: u32,
        confined: bool,
        executable: bool,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let handle = try self.mem_read_u64(p0.ptr);
        self.mem_free_quiet(p0.temp);
        if self.st.faulted {
            return val_void();
        }
        var root_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer root_buf.destroy(self.alloc);
        let rcode = try self.resolve_dir_root(handle, &mut root_buf);
        if rcode != 0_u32 {
            let res = try self.pack_error_union(ret_ty, types.TY_VOID, rcode, val_void());
            root_buf.destroy(self.alloc);
            return res;
        }
        var path_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer path_buf.destroy(self.alloc);
        let a1 = self.eir_val_at(args_r, 1_usize);
        let pcode = try self.read_str_ival(frame.get_val(a1), &mut path_buf);
        if self.st.faulted || pcode != 0_u32 {
            var res = val_void();
            if !self.st.faulted {
                res = try self.pack_error_union(ret_ty, types.TY_VOID, pcode, val_void());
            }
            path_buf.destroy(self.alloc);
            root_buf.destroy(self.alloc);
            return res;
        }
        let a2 = self.eir_val_at(args_r, 2_usize);
        let dpair = self.st.vals.as_pair(frame.get_val(a2));
        var data = try col.DynBuf.[u8].init(self.alloc, max_usize(dpair.b.trunc.[usize](), 16_usize));
        errdefer data.destroy(self.alloc);
        if !(try self.mem_read_dyn(dpair.a, dpair.b.trunc.[usize](), &mut data)) {
            data.destroy(self.alloc);
            path_buf.destroy(self.alloc);
            root_buf.destroy(self.alloc);
            return val_void();
        }
        var err_code: u32 = 0_u32;
        if confined {
            err_code = check_lexical_confined_rel(path_buf.as_bytes());
            if err_code == 0_u32 {
                let rstr = root_buf.as_str() catch { err_code = ERR_INVALID_INPUT; "" };
                let pstr = path_buf.as_str() catch { err_code = ERR_INVALID_INPUT; "" };
                if err_code == 0_u32 {
                    err_code = host_dir_write_file_code(self.host_fs, rstr, pstr, data.as_slice());
                }
            }
        } else if path_buf.len() == 0_usize || bytes_has_nul(path_buf.as_bytes()) {
            err_code = ERR_INVALID_INPUT;
        } else {
            var joined = try str.StrBuf.init(self.alloc, 128_usize);
            errdefer joined.destroy(self.alloc);
            try join_path_bytes(self.alloc, root_buf.as_bytes(), path_buf.as_bytes(), &mut joined);
            let jstr = joined.as_str() catch { err_code = ERR_INVALID_INPUT; "" };
            if err_code == 0_u32 {
                if executable {
                    err_code = map_void_io_err(self.host_fs.write_executable(jstr, data.as_slice()));
                } else {
                    err_code = map_void_io_err(self.host_fs.write_file(jstr, data.as_slice()));
                }
            }
            joined.destroy(self.alloc);
        }
        let res = try self.pack_error_union(ret_ty, types.TY_VOID, err_code, val_void());
        data.destroy(self.alloc);
        path_buf.destroy(self.alloc);
        root_buf.destroy(self.alloc);
        return res;
    }

    fn exec_fs_is_dir(
        self: *mut Self,
        fn_id: u32,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let handle = try self.mem_read_u64(p0.ptr);
        self.mem_free_quiet(p0.temp);
        if self.st.faulted {
            return val_void();
        }
        var root_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer root_buf.destroy(self.alloc);
        if (try self.resolve_dir_root(handle, &mut root_buf)) != 0_u32 {
            root_buf.destroy(self.alloc);
            return val_scalar(0_u64);
        }
        var path_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer path_buf.destroy(self.alloc);
        let a1 = self.eir_val_at(args_r, 1_usize);
        let pcode = try self.read_str_ival(frame.get_val(a1), &mut path_buf);
        if self.st.faulted || pcode != 0_u32 || path_buf.len() == 0_usize || bytes_has_nul(path_buf.as_bytes()) {
            path_buf.destroy(self.alloc);
            root_buf.destroy(self.alloc);
            return val_scalar(0_u64);
        }
        var joined = try str.StrBuf.init(self.alloc, 128_usize);
        errdefer joined.destroy(self.alloc);
        try join_path_bytes(self.alloc, root_buf.as_bytes(), path_buf.as_bytes(), &mut joined);
        var utf8_ok = true;
        let jstr = joined.as_str() catch {
            utf8_ok = false;
            ""
        };
        let is_d = if utf8_ok { self.host_fs.is_dir(jstr) } else { false };
        joined.destroy(self.alloc);
        path_buf.destroy(self.alloc);
        root_buf.destroy(self.alloc);
        return val_scalar(if is_d { 1_u64 } else { 0_u64 });
    }

    fn exec_fs_mkdir_all(
        self: *mut Self,
        fn_id: u32,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let handle = try self.mem_read_u64(p0.ptr);
        self.mem_free_quiet(p0.temp);
        if self.st.faulted {
            return val_void();
        }
        var root_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer root_buf.destroy(self.alloc);
        let rcode = try self.resolve_dir_root(handle, &mut root_buf);
        if rcode != 0_u32 {
            let res = try self.pack_error_union(ret_ty, types.TY_VOID, rcode, val_void());
            root_buf.destroy(self.alloc);
            return res;
        }
        var path_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer path_buf.destroy(self.alloc);
        let a1 = self.eir_val_at(args_r, 1_usize);
        let pcode = try self.read_str_ival(frame.get_val(a1), &mut path_buf);
        if self.st.faulted || pcode != 0_u32 || path_buf.len() == 0_usize || bytes_has_nul(path_buf.as_bytes()) {
            var res = val_void();
            if !self.st.faulted {
                res = try self.pack_error_union(ret_ty, types.TY_VOID, ERR_INVALID_INPUT, val_void());
            }
            path_buf.destroy(self.alloc);
            root_buf.destroy(self.alloc);
            return res;
        }
        var joined = try str.StrBuf.init(self.alloc, 128_usize);
        errdefer joined.destroy(self.alloc);
        try join_path_bytes(self.alloc, root_buf.as_bytes(), path_buf.as_bytes(), &mut joined);
        var utf8_ok = true;
        let jstr = joined.as_str() catch {
            utf8_ok = false;
            ""
        };
        let ec = if utf8_ok { map_void_io_err(self.host_fs.mkdir_all(jstr)) } else { ERR_INVALID_INPUT };
        let res = try self.pack_error_union(ret_ty, types.TY_VOID, ec, val_void());
        joined.destroy(self.alloc);
        path_buf.destroy(self.alloc);
        root_buf.destroy(self.alloc);
        return res;
    }

    fn exec_builtin_fs_io(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        match op.kind {
            .FsOpenDir => { return try self.exec_fs_open_or_sub(fn_id, false, args_r, slots_r, ret_ty, frame); }
            .DirSubDir => { return try self.exec_fs_open_or_sub(fn_id, true, args_r, slots_r, ret_ty, frame); }
            .FsReadFile => { return try self.exec_fs_read_file(fn_id, false, args_r, slots_r, ret_ty, frame); }
            .DirReadFile => { return try self.exec_fs_read_file(fn_id, true, args_r, slots_r, ret_ty, frame); }
            .FsWriteFile => { return try self.exec_fs_write_file(fn_id, false, false, args_r, slots_r, ret_ty, frame); }
            .DirWriteFile => { return try self.exec_fs_write_file(fn_id, true, false, args_r, slots_r, ret_ty, frame); }
            .FsWriteExecutable => { return try self.exec_fs_write_file(fn_id, false, true, args_r, slots_r, ret_ty, frame); }
            .FsIsDir => { return try self.exec_fs_is_dir(fn_id, args_r, slots_r, frame); }
            .FsMkdirAll => { return try self.exec_fs_mkdir_all(fn_id, args_r, slots_r, ret_ty, frame); }
            .FsListDir => { return try self.exec_fs_list_dir(fn_id, args_r, slots_r, ret_ty, frame); }
            .FsSpawnWait => { return try self.exec_fs_spawn_wait(fn_id, args_r, slots_r, ret_ty, frame); }
            .DirClose => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let handle = (try self.mem_read_u64(p0.ptr)).trunc.[usize]();
                self.mem_free_quiet(p0.temp);
                let rs = self.st.io.dir_roots.as_mut_slice();
                if handle > 1_usize && handle < rs.len {
                    rs[handle].alive = false;
                }
                return val_void();
            }
            .NetRestrictHost => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                _ = try self.mem_read_u64(p0.ptr);
                self.mem_free_quiet(p0.temp);
                if self.st.faulted {
                    return val_void();
                }
                let a1 = self.eir_val_at(args_r, 1_usize);
                let hp = self.st.vals.as_pair(frame.get_val(a1));
                var htmp = try col.DynBuf.[u8].init(self.alloc, max_usize(hp.b.trunc.[usize](), 16_usize));
                errdefer htmp.destroy(self.alloc);
                _ = try self.mem_read_dyn(hp.a, hp.b.trunc.[usize](), &mut htmp);
                let start = self.st.io.net_bytes.len().trunc.[u32]();
                try self.st.io.net_bytes.push_slice(self.alloc, htmp.as_slice());
                let hid = self.st.io.net_hosts.len().widen.[u64]();
                try self.st.io.net_hosts.push(self.alloc, ast.range_new(start, htmp.len().trunc.[u32]()));
                htmp.destroy(self.alloc);
                return val_scalar(hid);
            }
            .IoNopRoundtrip => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                _ = try self.mem_read_u64(p0.ptr);
                self.mem_free_quiet(p0.temp);
                let a1 = self.eir_val_at(args_r, 1_usize);
                let cnt = self.st.vals.as_u64(frame.get_val(a1));
                let ok_ty = error_union_ok_ty(self.env, ret_ty, types.TY_USIZE);
                return try self.pack_error_union(ret_ty, ok_ty, 0_u32, val_scalar(cnt));
            }
            .IoRunFibers => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                _ = try self.mem_read_u64(p0.ptr);
                self.mem_free_quiet(p0.temp);
                let a1 = self.eir_val_at(args_r, 1_usize);
                let a2 = self.eir_val_at(args_r, 2_usize);
                let cnt = self.st.vals.as_u64(frame.get_val(a1));
                let stack_bytes = self.st.vals.as_u64(frame.get_val(a2));
                if stack_bytes == 0_u64 {
                    return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_INVALID_INPUT, val_void());
                }
                let ok_ty = error_union_ok_ty(self.env, ret_ty, types.TY_USIZE);
                return try self.pack_error_union(ret_ty, ok_ty, 0_u32, val_scalar(cnt));
            }
            _ => { return val_void(); }
        }
    }

    fn exec_fs_list_dir(
        self: *mut Self,
        fn_id: u32,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let p1 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 1_usize, frame);
        let handle = try self.mem_read_u64(p0.ptr);
        self.mem_free_quiet(p0.temp);
        if self.st.faulted {
            self.mem_free_quiet(p1.temp);
            return val_void();
        }
        var root_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer root_buf.destroy(self.alloc);
        let rcode = try self.resolve_dir_root(handle, &mut root_buf);
        if rcode != 0_u32 {
            let res = try self.pack_error_union(ret_ty, types.TY_VOID, rcode, val_void());
            root_buf.destroy(self.alloc);
            self.mem_free_quiet(p1.temp);
            return res;
        }
        var path_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer path_buf.destroy(self.alloc);
        let a2 = self.eir_val_at(args_r, 2_usize);
        let pcode = try self.read_str_ival(frame.get_val(a2), &mut path_buf);
        if self.st.faulted || pcode != 0_u32 || path_buf.len() == 0_usize || bytes_has_nul(path_buf.as_bytes()) {
            var res = val_void();
            if !self.st.faulted {
                res = try self.pack_error_union(ret_ty, types.TY_VOID, ERR_INVALID_INPUT, val_void());
            }
            path_buf.destroy(self.alloc);
            root_buf.destroy(self.alloc);
            self.mem_free_quiet(p1.temp);
            return res;
        }
        var joined = try str.StrBuf.init(self.alloc, 128_usize);
        errdefer joined.destroy(self.alloc);
        try join_path_bytes(self.alloc, root_buf.as_bytes(), path_buf.as_bytes(), &mut joined);
        var raw_list = try col.DynBuf.[u8].init(self.alloc, 128_usize);
        errdefer raw_list.destroy(self.alloc);
        var utf8_ok = true;
        let jstr = joined.as_str() catch {
            utf8_ok = false;
            ""
        };
        let ec = if utf8_ok {
            host_list_dir_code(self.host_fs, self.alloc, jstr, &mut raw_list)
        } else {
            ERR_INVALID_INPUT
        };
        var res = val_void();
        if ec != 0_u32 {
            res = try self.pack_error_union(ret_ty, types.TY_VOID, ec, val_void());
        } else {
            var sorted = try col.DynBuf.[u8].init(self.alloc, max_usize(raw_list.len(), 16_usize));
            errdefer sorted.destroy(self.alloc);
            try sort_newline_entries(self.alloc, raw_list.as_slice(), &mut sorted);
            res = try self.pack_buf_u8_to_eu(p1.ptr, sorted.as_slice(), ret_ty);
            sorted.destroy(self.alloc);
        }
        raw_list.destroy(self.alloc);
        joined.destroy(self.alloc);
        path_buf.destroy(self.alloc);
        root_buf.destroy(self.alloc);
        self.mem_free_quiet(p1.temp);
        return res;
    }

    fn exec_fs_spawn_wait(
        self: *mut Self,
        fn_id: u32,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let handle = try self.mem_read_u64(p0.ptr);
        self.mem_free_quiet(p0.temp);
        if self.st.faulted {
            return val_void();
        }
        var root_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer root_buf.destroy(self.alloc);
        let rcode = try self.resolve_dir_root(handle, &mut root_buf);
        if rcode != 0_u32 {
            let res = try self.pack_error_union(ret_ty, types.TY_VOID, rcode, val_void());
            root_buf.destroy(self.alloc);
            return res;
        }
        var path_buf = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer path_buf.destroy(self.alloc);
        let a1 = self.eir_val_at(args_r, 1_usize);
        let pcode = try self.read_str_ival(frame.get_val(a1), &mut path_buf);
        if self.st.faulted || pcode != 0_u32 || path_buf.len() == 0_usize || bytes_has_nul(path_buf.as_bytes()) {
            var res = val_void();
            if !self.st.faulted {
                res = try self.pack_error_union(ret_ty, types.TY_VOID, ERR_INVALID_INPUT, val_void());
            }
            path_buf.destroy(self.alloc);
            root_buf.destroy(self.alloc);
            return res;
        }
        let a2 = self.eir_val_at(args_r, 2_usize);
        let ap = self.st.vals.as_pair(frame.get_val(a2));
        var abytes = try col.DynBuf.[u8].init(self.alloc, max_usize(ap.b.trunc.[usize](), 16_usize));
        errdefer abytes.destroy(self.alloc);
        if !(try self.mem_read_dyn(ap.a, ap.b.trunc.[usize](), &mut abytes)) {
            abytes.destroy(self.alloc);
            path_buf.destroy(self.alloc);
            root_buf.destroy(self.alloc);
            return val_void();
        }
        var joined = try str.StrBuf.init(self.alloc, 128_usize);
        errdefer joined.destroy(self.alloc);
        try join_path_bytes(self.alloc, root_buf.as_bytes(), path_buf.as_bytes(), &mut joined);
        var rc: i32 = 0_i32;
        var utf8_ok = true;
        let jstr = joined.as_str() catch {
            utf8_ok = false;
            ""
        };
        let ec = if utf8_ok {
            host_spawn_wait_code(self.host_fs, jstr, abytes.as_slice(), &mut rc)
        } else {
            ERR_INVALID_INPUT
        };
        var res = val_void();
        if ec != 0_u32 {
            res = try self.pack_error_union(ret_ty, types.TY_VOID, ec, val_void());
        } else {
            let ok_ty = error_union_ok_ty(self.env, ret_ty, types.TY_I32);
            res = try self.pack_error_union(ret_ty, ok_ty, 0_u32, val_scalar(rc.bitcast.[u32]().widen.[u64]()));
        }
        joined.destroy(self.alloc);
        abytes.destroy(self.alloc);
        path_buf.destroy(self.alloc);
        root_buf.destroy(self.alloc);
        return res;
    }

    fn exec_builtin_build(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        _ = try self.mem_read_u64(p0.ptr);
        self.mem_free_quiet(p0.temp);
        if self.st.faulted {
            return val_void();
        }
        var s1 = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer s1.destroy(self.alloc);
        var s2 = try str.StrBuf.init(self.alloc, 64_usize);
        errdefer s2.destroy(self.alloc);

        match op.kind {
            .BuildAddModule => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                let a2 = self.eir_val_at(args_r, 2_usize);
                _ = try self.read_build_str(frame.get_val(a1), &mut s1);
                if !self.st.faulted {
                    _ = try self.read_build_str(frame.get_val(a2), &mut s2);
                }
            }
            .BuildAddExe => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                let a2 = self.eir_val_at(args_r, 2_usize);
                if (try self.read_build_str(frame.get_val(a1), &mut s1))
                    && (try self.read_build_str(frame.get_val(a2), &mut s2))
                {
                    try self.plan.add_exe(self.alloc, s1.as_bytes(), s2.as_bytes());
                }
            }
            .BuildAddSharedLib => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                let a2 = self.eir_val_at(args_r, 2_usize);
                if (try self.read_build_str(frame.get_val(a1), &mut s1))
                    && (try self.read_build_str(frame.get_val(a2), &mut s2))
                {
                    try self.plan.add_shared(self.alloc, s1.as_bytes(), s2.as_bytes());
                }
            }
            .BuildSetOutDir => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                if try self.read_build_str(frame.get_val(a1), &mut s1) {
                    try self.plan.set_out_dir(self.alloc, s1.as_bytes());
                }
            }
            .BuildSetSanitize => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                self.plan.set_sanitize(self.st.vals.as_u64(frame.get_val(a1)) != 0_u64);
            }
            .BuildSetAuditTcb => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                self.plan.set_audit_tcb(self.st.vals.as_u64(frame.get_val(a1)) != 0_u64);
            }
            .BuildSetOptLevel => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                self.plan.set_opt_level(self.st.vals.as_u64(frame.get_val(a1)).trunc.[u8]());
            }
            .BuildLinkLib => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                if try self.read_build_str(frame.get_val(a1), &mut s1) {
                    try self.plan.add_link_lib(self.alloc, s1.as_bytes());
                }
            }
            .BuildAllowHal => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                if try self.read_build_str(frame.get_val(a1), &mut s1) {
                    try self.plan.add_allow_hal(self.alloc, s1.as_bytes());
                }
            }
            .BuildOutPath => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                if try self.read_build_str(frame.get_val(a1), &mut s1) {
                    let rel_ok = try build_sys.validate_sandbox_rel_path(
                        self.alloc,
                        s1.as_bytes(),
                        &mut self.st.err_msg,
                    );
                    if !rel_ok {
                        self.st.faulted = true;
                        s2.destroy(self.alloc);
                        s1.destroy(self.alloc);
                        return val_void();
                    }
                    let raw_out = self.plan.out_dir();
                    let eff_out = if raw_out.len == 0_usize { "out".as_bytes() } else { raw_out };
                    let out_ok = try build_sys.validate_sandbox_rel_path(
                        self.alloc,
                        eff_out,
                        &mut self.st.err_msg,
                    );
                    if !out_ok {
                        self.st.faulted = true;
                        s2.destroy(self.alloc);
                        s1.destroy(self.alloc);
                        return val_void();
                    }
                    var end_o = eff_out.len;
                    while end_o > 0_usize && eff_out[end_o -% 1_usize] == b'/' {
                        end_o = end_o -% 1_usize;
                    }
                    let trimmed = eff_out.sub(0_usize, end_o) catch { eff_out };
                    try s2.push_bytes_grow(self.alloc, trimmed);
                    try s2.push_byte_grow(self.alloc, b'/');
                    try s2.push_bytes_grow(self.alloc, s1.as_bytes());
                    let ptr = try self.intern_ro_bytes(s2.as_bytes());
                    let res = try self.st.vals.from_pair(self.alloc, ptr, s2.len().widen.[u64]());
                    s2.destroy(self.alloc);
                    s1.destroy(self.alloc);
                    return res;
                }
            }
            _ => {}
        }
        s2.destroy(self.alloc);
        s1.destroy(self.alloc);
        return val_void();
    }
}

// ===========================================================================
// Section 8: Builtin Execution — ArenaPool, SlotPool, Buf, Atomics, MMIO
// ===========================================================================

struct TrackedAllocRec {
    ptr: u64;
    sz: usize;
}

impl Interp {
    fn pool_def_of_ty(self: *Self, elem_ty: types.TyId) -> u32 {
        let n = self.env.get(elem_ty);
        if n.kind == .Pool {
            return n.primary;
        }
        return 0_u32;
    }

    fn rollback_tracked(
        self: *mut Self,
        cap_ptr: u64,
        recs: *[TrackedAllocRec],
    ) -> !OutOfMemory {
        var i: usize = 0_usize;
        while i < recs.len {
            try self.free_raw_tracked(cap_ptr, recs[i].ptr, recs[i].sz);
            i = i +% 1_usize;
        }
        return;
    }

    fn exec_builtin_arena_pool(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        match op.kind {
            .ArenaPoolInit => {
                return try self.exec_arena_pool_init(fn_id, op.ty0, args_r, slots_r, ret_ty, frame);
            }
            .ArenaPoolPush => {
                return try self.exec_arena_pool_push(fn_id, op.ty0, args_r, slots_r, ret_ty, frame);
            }
            .ArenaPoolIdAt => {
                let pdef = self.pool_def_of_ty(op.ty0);
                let ncols = if let pm = self.env.get_pool(pdef) { pm.columns.len.widen.[usize]() } else { 0_usize };
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let len = try self.mem_read_u64_off(p0.ptr, ncols *% 8_usize);
                let a1 = self.eir_val_at(args_r, 1_usize);
                let idx = self.st.vals.as_u64(frame.get_val(a1));
                self.mem_free_quiet(p0.temp);
                if idx < len {
                    let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                    return try self.pack_error_union(ret_ty, ok_ty, 0_u32, val_scalar(idx));
                }
                return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_BOUNDS, val_void());
            }
            .ArenaPoolReset => {
                let pdef = self.pool_def_of_ty(op.ty0);
                let ncols = if let pm = self.env.get_pool(pdef) { pm.columns.len.widen.[usize]() } else { 0_usize };
                let sz = (ncols +% 2_usize) *% 8_usize;
                var pb = try col.DynBuf.[u8].init(self.alloc, sz);
                errdefer pb.destroy(self.alloc);
                let a0 = self.eir_val_at(args_r, 0_usize);
                try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), sz, &mut pb);
                write_le_u64_at(pb.as_mut_slice(), ncols *% 8_usize, 0_u64, 8_usize);
                let res = try self.st.vals.from_bytes(self.alloc, pb.as_slice());
                pb.destroy(self.alloc);
                return res;
            }
            .ArenaPoolLen => {
                let a0 = self.eir_val_at(args_r, 0_usize);
                let ty0 = self.eir.fn_val_ty(fn_id, a0);
                let deref = deref_single_ty(self.env, ty0);
                let dn = self.env.get(deref);
                let ncols = if dn.kind == .Builtin {
                    self.env.pool_col_count(self.env.node_gval_list(&dn))
                } else {
                    0_usize
                };
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let len = try self.mem_read_u64_off(p0.ptr, ncols *% 8_usize);
                self.mem_free_quiet(p0.temp);
                return val_scalar(len);
            }
            _ => { return val_void(); }
        }
    }

    fn exec_arena_pool_init(
        self: *mut Self,
        fn_id: u32,
        elem_ty: types.TyId,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let pdef = self.pool_def_of_ty(elem_ty);
        let col_range = if let pm = self.env.get_pool(pdef) { pm.columns } else { ast.range_empty() };
        let ncols = col_range.len.widen.[usize]();
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let a1 = self.eir_val_at(args_r, 1_usize);
        let cap = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
        let base = try self.mem_read_u64(p0.ptr);
        var used = (try self.mem_read_u64_off(p0.ptr, 8_usize)).trunc.[usize]();
        let arena_cap = (try self.mem_read_u64_off(p0.ptr, 16_usize)).trunc.[usize]();
        if self.st.faulted {
            self.mem_free_quiet(p0.temp);
            return val_void();
        }
        let pbytes_sz = (ncols +% 2_usize) *% 8_usize;
        var pbytes = try col.DynBuf.[u8].init(self.alloc, pbytes_sz);
        errdefer pbytes.destroy(self.alloc);
        try push_zero_bytes(self.alloc, &mut pbytes, pbytes_sz);
        var oom = false;
        var ci: usize = 0_usize;
        while ci < ncols {
            let cty = self.pool_col_ty(col_range, ci);
            let esz = max_usize(self.env.x64_layout_impl(cty, false).size, 1_usize);
            let need = (cap *? esz) catch {
                oom = true;
                break;
            };
            let aligned = (used +% 63_usize) & (~63_usize);
            let end = (aligned +? need) catch {
                oom = true;
                break;
            };
            if end <= arena_cap {
                let cptr = try self.mem_ptr_add(base, aligned);
                write_le_u64_at(pbytes.as_mut_slice(), ci *% 8_usize, cptr, 8_usize);
                used = end;
            } else {
                oom = true;
                break;
            }
            ci = ci +% 1_usize;
        }
        if !oom && !self.st.faulted {
            _ = try self.mem_write_u64_off(p0.ptr, 8_usize, used.widen.[u64]());
        }
        self.mem_free_quiet(p0.temp);
        var res = val_void();
        if self.st.faulted {
            res = val_void();
        } else if oom {
            res = try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
        } else {
            write_le_u64_at(pbytes.as_mut_slice(), ncols *% 8_usize, 0_u64, 8_usize);
            write_le_u64_at(pbytes.as_mut_slice(), (ncols +% 1_usize) *% 8_usize, cap.widen.[u64](), 8_usize);
            let pv = try self.st.vals.from_bytes(self.alloc, pbytes.as_slice());
            let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
            res = try self.pack_error_union(ret_ty, ok_ty, 0_u32, pv);
        }
        pbytes.destroy(self.alloc);
        return res;
    }

    fn exec_arena_pool_push(
        self: *mut Self,
        fn_id: u32,
        elem_ty: types.TyId,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let pdef = self.pool_def_of_ty(elem_ty);
        let col_range = if let pm = self.env.get_pool(pdef) { pm.columns } else { ast.range_empty() };
        let ncols = col_range.len.widen.[usize]();
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let len = (try self.mem_read_u64_off(p0.ptr, ncols *% 8_usize)).trunc.[usize]();
        let cap = (try self.mem_read_u64_off(p0.ptr, (ncols +% 1_usize) *% 8_usize)).trunc.[usize]();
        if self.st.faulted {
            self.mem_free_quiet(p0.temp);
            return val_void();
        }
        if len >= cap {
            self.mem_free_quiet(p0.temp);
            return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
        }
        let row_sz = max_usize(self.env.x64_layout(elem_ty).size, 1_usize);
        var row_bytes = try col.DynBuf.[u8].init(self.alloc, row_sz);
        errdefer row_bytes.destroy(self.alloc);
        let a1 = self.eir_val_at(args_r, 1_usize);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a1), row_sz, &mut row_bytes);
        var ci: usize = 0_usize;
        while ci < ncols {
            let foff = self.env.struct_field_offset(elem_ty, ci).offset;
            let cty = self.pool_col_ty(col_range, ci);
            let col_esz = max_usize(self.env.x64_layout_impl(cty, false).size, 1_usize);
            let col_ptr = try self.mem_read_u64_off(p0.ptr, ci *% 8_usize);
            let dst_addr = try self.mem_ptr_add(col_ptr, len *% col_esz);
            let rbs = row_bytes.as_slice();
            if foff +% col_esz <= rbs.len {
                let fslice = rbs.sub(foff, foff +% col_esz) catch { break; };
                _ = try self.mem_write(dst_addr, fslice);
            }
            ci = ci +% 1_usize;
        }
        _ = try self.mem_write_u64_off(p0.ptr, ncols *% 8_usize, (len +% 1_usize).widen.[u64]());
        let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
        let res = try self.pack_error_union(ret_ty, ok_ty, 0_u32, val_scalar(len.widen.[u64]()));
        row_bytes.destroy(self.alloc);
        self.mem_free_quiet(p0.temp);
        return res;
    }

    fn slot_pool_grow(
        self: *mut Self,
        sp_ptr: u64,
        cap_ptr: u64,
        col_range: ast.IdRange,
        cap: usize,
    ) -> bool ! OutOfMemory {
        let ncols = col_range.len.widen.[usize]();
        let new_cap = max_usize(cap *% 2_usize, 4_usize);
        let old_gen = try self.mem_read_u64_off(sp_ptr, ncols *% 8_usize);
        let old_free = try self.mem_read_u64_off(sp_ptr, (ncols +% 1_usize) *% 8_usize);
        if self.st.faulted {
            return false;
        }
        var new_allocs = try col.DynBuf.[TrackedAllocRec].init(self.alloc, ncols +% 2_usize);
        errdefer new_allocs.destroy(self.alloc);
        let new_gen = try self.alloc_raw_tracked(cap_ptr, new_cap *% 4_usize);
        if self.st.faulted || new_gen == 0_u64 {
            new_allocs.destroy(self.alloc);
            return false;
        }
        try new_allocs.push(self.alloc, TrackedAllocRec.{ ptr: new_gen, sz: new_cap *% 4_usize });
        let new_free = try self.alloc_raw_tracked(cap_ptr, new_cap *% 4_usize);
        if self.st.faulted || new_free == 0_u64 {
            if !self.st.faulted {
                try self.rollback_tracked(cap_ptr, new_allocs.as_slice());
            }
            new_allocs.destroy(self.alloc);
            return false;
        }
        try new_allocs.push(self.alloc, TrackedAllocRec.{ ptr: new_free, sz: new_cap *% 4_usize });

        var old_cols = try col.DynBuf.[u64].init(self.alloc, max_usize(ncols, 4_usize));
        errdefer old_cols.destroy(self.alloc);
        var new_cols = try col.DynBuf.[u64].init(self.alloc, max_usize(ncols, 4_usize));
        errdefer new_cols.destroy(self.alloc);
        var col_eszs = try col.DynBuf.[usize].init(self.alloc, max_usize(ncols, 4_usize));
        errdefer col_eszs.destroy(self.alloc);

        var ci: usize = 0_usize;
        while ci < ncols {
            let cty = self.pool_col_ty(col_range, ci);
            let esz = max_usize(self.env.x64_layout_impl(cty, true).size, 1_usize);
            let old_c = try self.mem_read_u64_off(sp_ptr, ci *% 8_usize);
            let new_c = try self.alloc_raw_tracked(cap_ptr, new_cap *% esz);
            if self.st.faulted || new_c == 0_u64 {
                if !self.st.faulted {
                    try self.rollback_tracked(cap_ptr, new_allocs.as_slice());
                }
                col_eszs.destroy(self.alloc);
                new_cols.destroy(self.alloc);
                old_cols.destroy(self.alloc);
                new_allocs.destroy(self.alloc);
                return false;
            }
            try new_allocs.push(self.alloc, TrackedAllocRec.{ ptr: new_c, sz: new_cap *% esz });
            try old_cols.push(self.alloc, old_c);
            try new_cols.push(self.alloc, new_c);
            try col_eszs.push(self.alloc, esz);
            ci = ci +% 1_usize;
        }

        var copy_tmp = try col.DynBuf.[u8].init(self.alloc, max_usize(cap *% 4_usize, 16_usize));
        errdefer copy_tmp.destroy(self.alloc);
        if try self.mem_read_dyn(old_gen, cap *% 4_usize, &mut copy_tmp) {
            _ = try self.mem_write(new_gen, copy_tmp.as_slice());
        }
        try self.free_raw_tracked(cap_ptr, old_gen, cap *% 4_usize);
        try self.free_raw_tracked(cap_ptr, old_free, cap *% 4_usize);

        let added = new_cap -% cap;
        var fi: usize = 0_usize;
        while fi < added {
            let sidx = (new_cap -% 1_usize -% fi).trunc.[u32]();
            _ = try self.mem_write_u32_off(new_free, fi *% 4_usize, sidx);
            fi = fi +% 1_usize;
        }
        let ocs = old_cols.as_slice();
        let ncs = new_cols.as_slice();
        let eszs = col_eszs.as_slice();
        var k: usize = 0_usize;
        while k < ncols && k < ocs.len && k < ncs.len && k < eszs.len {
            let bytes_n = cap *% eszs[k];
            if try self.mem_read_dyn(ocs[k], bytes_n, &mut copy_tmp) {
                _ = try self.mem_write(ncs[k], copy_tmp.as_slice());
            }
            try self.free_raw_tracked(cap_ptr, ocs[k], bytes_n);
            _ = try self.mem_write_u64_off(sp_ptr, k *% 8_usize, ncs[k]);
            k = k +% 1_usize;
        }
        _ = try self.mem_write_u64_off(sp_ptr, ncols *% 8_usize, new_gen);
        _ = try self.mem_write_u64_off(sp_ptr, (ncols +% 1_usize) *% 8_usize, new_free);
        _ = try self.mem_write_u64_off(sp_ptr, (ncols +% 3_usize) *% 8_usize, new_cap.widen.[u64]());
        _ = try self.mem_write_u64_off(sp_ptr, (ncols +% 4_usize) *% 8_usize, added.widen.[u64]());

        copy_tmp.destroy(self.alloc);
        col_eszs.destroy(self.alloc);
        new_cols.destroy(self.alloc);
        old_cols.destroy(self.alloc);
        new_allocs.destroy(self.alloc);
        return !self.st.faulted;
    }

    fn exec_slot_pool_init(
        self: *mut Self,
        fn_id: u32,
        elem_ty: types.TyId,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let pdef = self.pool_def_of_ty(elem_ty);
        let col_range = if let pm = self.env.get_pool(pdef) { pm.columns } else { ast.range_empty() };
        let ncols = col_range.len.widen.[usize]();
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let a1 = self.eir_val_at(args_r, 1_usize);
        let cap = max_usize(self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize](), 4_usize);
        let sp_sz = (ncols +% 5_usize) *% 8_usize;
        var sp_bytes = try col.DynBuf.[u8].init(self.alloc, sp_sz);
        errdefer sp_bytes.destroy(self.alloc);
        try push_zero_bytes(self.alloc, &mut sp_bytes, sp_sz);
        var allocs = try col.DynBuf.[TrackedAllocRec].init(self.alloc, ncols +% 2_usize);
        errdefer allocs.destroy(self.alloc);

        var oom = false;
        let gen_ptr = try self.alloc_raw_tracked(p0.ptr, cap *% 4_usize);
        if self.st.faulted || gen_ptr == 0_u64 {
            oom = true;
        } else {
            try allocs.push(self.alloc, TrackedAllocRec.{ ptr: gen_ptr, sz: cap *% 4_usize });
        }
        var free_ptr: u64 = 0_u64;
        if !oom {
            free_ptr = try self.alloc_raw_tracked(p0.ptr, cap *% 4_usize);
            if self.st.faulted || free_ptr == 0_u64 {
                oom = true;
            } else {
                try allocs.push(self.alloc, TrackedAllocRec.{ ptr: free_ptr, sz: cap *% 4_usize });
            }
        }
        var ci: usize = 0_usize;
        while !oom && ci < ncols {
            let cty = self.pool_col_ty(col_range, ci);
            let esz = max_usize(self.env.x64_layout_impl(cty, true).size, 1_usize);
            let cptr = try self.alloc_raw_tracked(p0.ptr, cap *% esz);
            if self.st.faulted || cptr == 0_u64 {
                oom = true;
                break;
            }
            try allocs.push(self.alloc, TrackedAllocRec.{ ptr: cptr, sz: cap *% esz });
            write_le_u64_at(sp_bytes.as_mut_slice(), ci *% 8_usize, cptr, 8_usize);
            ci = ci +% 1_usize;
        }
        var res = val_void();
        if oom {
            if !self.st.faulted {
                try self.rollback_tracked(p0.ptr, allocs.as_slice());
                res = try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
            }
        } else {
            var fi: usize = 0_usize;
            while fi < cap {
                _ = try self.mem_write_u32_off(free_ptr, fi *% 4_usize, (cap -% 1_usize -% fi).trunc.[u32]());
                fi = fi +% 1_usize;
            }
            let sbm = sp_bytes.as_mut_slice();
            write_le_u64_at(sbm, ncols *% 8_usize, gen_ptr, 8_usize);
            write_le_u64_at(sbm, (ncols +% 1_usize) *% 8_usize, free_ptr, 8_usize);
            write_le_u64_at(sbm, (ncols +% 2_usize) *% 8_usize, 0_u64, 8_usize);
            write_le_u64_at(sbm, (ncols +% 3_usize) *% 8_usize, cap.widen.[u64](), 8_usize);
            write_le_u64_at(sbm, (ncols +% 4_usize) *% 8_usize, cap.widen.[u64](), 8_usize);
            let spv = try self.st.vals.from_bytes(self.alloc, sp_bytes.as_slice());
            let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
            res = try self.pack_error_union(ret_ty, ok_ty, 0_u32, spv);
        }
        allocs.destroy(self.alloc);
        sp_bytes.destroy(self.alloc);
        self.mem_free_quiet(p0.temp);
        return res;
    }

    fn exec_slot_pool_insert(
        self: *mut Self,
        fn_id: u32,
        elem_ty: types.TyId,
        is_try: bool,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let pdef = self.pool_def_of_ty(elem_ty);
        let col_range = if let pm = self.env.get_pool(pdef) { pm.columns } else { ast.range_empty() };
        let ncols = col_range.len.widen.[usize]();
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        var free_top = (try self.mem_read_u64_off(p0.ptr, (ncols +% 4_usize) *% 8_usize)).trunc.[usize]();
        let cap = (try self.mem_read_u64_off(p0.ptr, (ncols +% 3_usize) *% 8_usize)).trunc.[usize]();
        if self.st.faulted {
            self.mem_free_quiet(p0.temp);
            return val_void();
        }
        if free_top == 0_usize && !is_try {
            let pc = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 1_usize, frame);
            let grew = try self.slot_pool_grow(p0.ptr, pc.ptr, col_range, cap);
            self.mem_free_quiet(pc.temp);
            if self.st.faulted {
                self.mem_free_quiet(p0.temp);
                return val_void();
            }
            if !grew {
                self.mem_free_quiet(p0.temp);
                return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
            }
            free_top = (try self.mem_read_u64_off(p0.ptr, (ncols +% 4_usize) *% 8_usize)).trunc.[usize]();
        }
        if free_top == 0_usize {
            self.mem_free_quiet(p0.temp);
            return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
        }
        let row_arg_idx: usize = if is_try { 1_usize } else { 2_usize };
        let gen_ptr = try self.mem_read_u64_off(p0.ptr, ncols *% 8_usize);
        let free_ptr = try self.mem_read_u64_off(p0.ptr, (ncols +% 1_usize) *% 8_usize);
        free_top = free_top -% 1_usize;
        _ = try self.mem_write_u64_off(p0.ptr, (ncols +% 4_usize) *% 8_usize, free_top.widen.[u64]());
        let idx = (try self.mem_read_u32_off(free_ptr, free_top *% 4_usize)).widen.[usize]();
        let old_g = try self.mem_read_u32_off(gen_ptr, idx *% 4_usize);
        let new_g = (old_g +% 1_u32) | 1_u32;
        _ = try self.mem_write_u32_off(gen_ptr, idx *% 4_usize, new_g);

        let row_sz = max_usize(self.env.x64_layout(elem_ty).size, 1_usize);
        var row_bytes = try col.DynBuf.[u8].init(self.alloc, row_sz);
        errdefer row_bytes.destroy(self.alloc);
        let rv_arg = self.eir_val_at(args_r, row_arg_idx);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(rv_arg), row_sz, &mut row_bytes);
        var ci: usize = 0_usize;
        while ci < ncols {
            let foff = self.env.struct_field_offset(elem_ty, ci).offset;
            let cty = self.pool_col_ty(col_range, ci);
            let esz = max_usize(self.env.x64_layout_impl(cty, true).size, 1_usize);
            let cptr = try self.mem_read_u64_off(p0.ptr, ci *% 8_usize);
            let dst_p = try self.mem_ptr_add(cptr, idx *% esz);
            let rbs = row_bytes.as_slice();
            if foff +% esz <= rbs.len {
                let fslice = rbs.sub(foff, foff +% esz) catch { break; };
                _ = try self.mem_write(dst_p, fslice);
            }
            ci = ci +% 1_usize;
        }
        let old_len = try self.mem_read_u64_off(p0.ptr, (ncols +% 2_usize) *% 8_usize);
        _ = try self.mem_write_u64_off(p0.ptr, (ncols +% 2_usize) *% 8_usize, old_len +% 1_u64);
        var gid: [8]u8 = [0_u8; 8];
        write_le_u32_at(&mut gid, 0_usize, idx.trunc.[u32]());
        write_le_u32_at(&mut gid, 4_usize, new_g);
        let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
        let res = try self.pack_error_union(ret_ty, ok_ty, 0_u32, val_scalar(read_le_u64_at(&gid, 0_usize)));
        row_bytes.destroy(self.alloc);
        self.mem_free_quiet(p0.temp);
        return res;
    }

    fn exec_slot_pool_remove(
        self: *mut Self,
        fn_id: u32,
        elem_ty: types.TyId,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let pdef = self.pool_def_of_ty(elem_ty);
        let col_range = if let pm = self.env.get_pool(pdef) { pm.columns } else { ast.range_empty() };
        let ncols = col_range.len.widen.[usize]();
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        var gid: [8]u8 = [0_u8; 8];
        let a1 = self.eir_val_at(args_r, 1_usize);
        self.st.vals.write_bytes_to(frame.get_val(a1), &mut gid);
        let idx = read_le_u32_at(&gid, 0_usize).widen.[usize]();
        let slot_gen = read_le_u32_at(&gid, 4_usize);
        let cap = (try self.mem_read_u64_off(p0.ptr, (ncols +% 3_usize) *% 8_usize)).trunc.[usize]();
        let gen_ptr = try self.mem_read_u64_off(p0.ptr, ncols *% 8_usize);
        var alive = false;
        if !self.st.faulted && slot_gen != 0_u32 && (slot_gen & 1_u32) != 0_u32 && idx < cap {
            let cg = try self.mem_read_u32_off(gen_ptr, idx *% 4_usize);
            alive = !self.st.faulted && cg == slot_gen;
        }
        if self.st.faulted {
            self.mem_free_quiet(p0.temp);
            return val_void();
        }
        let ok_ty = error_union_ok_ty(self.env, ret_ty, elem_ty);
        if !alive {
            self.mem_free_quiet(p0.temp);
            return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_STALE_ID, val_void());
        }
        let row_sz = max_usize(self.env.x64_layout(ok_ty).size, 1_usize);
        var row_bytes = try col.DynBuf.[u8].init(self.alloc, row_sz);
        errdefer row_bytes.destroy(self.alloc);
        try push_zero_bytes(self.alloc, &mut row_bytes, row_sz);
        var ctmp = try col.DynBuf.[u8].init(self.alloc, 16_usize);
        errdefer ctmp.destroy(self.alloc);
        var ci: usize = 0_usize;
        while ci < ncols {
            let foff = self.env.struct_field_offset(ok_ty, ci).offset;
            let cty = self.pool_col_ty(col_range, ci);
            let esz = max_usize(self.env.x64_layout_impl(cty, true).size, 1_usize);
            let cptr = try self.mem_read_u64_off(p0.ptr, ci *% 8_usize);
            let src_p = try self.mem_ptr_add(cptr, idx *% esz);
            if try self.mem_read_dyn(src_p, esz, &mut ctmp) {
                if foff +% esz <= row_bytes.len() {
                    copy_bytes_slice(row_bytes.as_mut_slice(), foff, ctmp.as_slice(), 0_usize, esz);
                }
            }
            ci = ci +% 1_usize;
        }
        _ = try self.mem_write_u32_off(gen_ptr, idx *% 4_usize, slot_gen +% 1_u32);
        let free_ptr = try self.mem_read_u64_off(p0.ptr, (ncols +% 1_usize) *% 8_usize);
        let ftop = (try self.mem_read_u64_off(p0.ptr, (ncols +% 4_usize) *% 8_usize)).trunc.[usize]();
        _ = try self.mem_write_u32_off(free_ptr, ftop *% 4_usize, idx.trunc.[u32]());
        _ = try self.mem_write_u64_off(p0.ptr, (ncols +% 4_usize) *% 8_usize, (ftop +% 1_usize).widen.[u64]());
        let len = try self.mem_read_u64_off(p0.ptr, (ncols +% 2_usize) *% 8_usize);
        _ = try self.mem_write_u64_off(
            p0.ptr,
            (ncols +% 2_usize) *% 8_usize,
            if len > 0_u64 { len -% 1_u64 } else { 0_u64 },
        );
        let rv = try self.st.vals.from_bytes(self.alloc, row_bytes.as_slice());
        let res = try self.pack_error_union(ret_ty, ok_ty, 0_u32, rv);
        ctmp.destroy(self.alloc);
        row_bytes.destroy(self.alloc);
        self.mem_free_quiet(p0.temp);
        return res;
    }

    fn exec_slot_pool_destroy(
        self: *mut Self,
        fn_id: u32,
        elem_ty: types.TyId,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let pdef = self.pool_def_of_ty(elem_ty);
        let col_range = if let pm = self.env.get_pool(pdef) { pm.columns } else { ast.range_empty() };
        let ncols = col_range.len.widen.[usize]();
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let p1 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 1_usize, frame);
        let cap = (try self.mem_read_u64_off(p0.ptr, (ncols +% 3_usize) *% 8_usize)).trunc.[usize]();
        var ci: usize = 0_usize;
        while ci < ncols {
            let cty = self.pool_col_ty(col_range, ci);
            let esz = max_usize(self.env.x64_layout_impl(cty, true).size, 1_usize);
            let cptr = try self.mem_read_u64_off(p0.ptr, ci *% 8_usize);
            try self.free_raw_tracked(p1.ptr, cptr, cap *% esz);
            ci = ci +% 1_usize;
        }
        let gen_ptr = try self.mem_read_u64_off(p0.ptr, ncols *% 8_usize);
        let free_ptr = try self.mem_read_u64_off(p0.ptr, (ncols +% 1_usize) *% 8_usize);
        try self.free_raw_tracked(p1.ptr, gen_ptr, cap *% 4_usize);
        try self.free_raw_tracked(p1.ptr, free_ptr, cap *% 4_usize);
        self.mem_free_quiet(p0.temp);
        self.mem_free_quiet(p1.temp);
        return val_void();
    }

    fn exec_builtin_slot_pool(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        match op.kind {
            .SlotPoolInit => {
                return try self.exec_slot_pool_init(fn_id, op.ty0, args_r, slots_r, ret_ty, frame);
            }
            .SlotPoolInsert => {
                return try self.exec_slot_pool_insert(fn_id, op.ty0, false, args_r, slots_r, ret_ty, frame);
            }
            .SlotPoolTryInsert => {
                return try self.exec_slot_pool_insert(fn_id, op.ty0, true, args_r, slots_r, ret_ty, frame);
            }
            .SlotPoolRemove => {
                return try self.exec_slot_pool_remove(fn_id, op.ty0, args_r, slots_r, ret_ty, frame);
            }
            .SlotPoolGet => {
                return try self.exec_slot_pool_get_or_at(fn_id, op.ty0, false, args_r, slots_r, ret_ty, frame);
            }
            .SlotPoolAt => {
                return try self.exec_slot_pool_get_or_at(fn_id, op.ty0, true, args_r, slots_r, ret_ty, frame);
            }
            .SlotPoolLen => {
                return try self.exec_slot_pool_meta_u64(fn_id, true, args_r, slots_r, frame);
            }
            .SlotPoolCap => {
                return try self.exec_slot_pool_meta_u64(fn_id, false, args_r, slots_r, frame);
            }
            .SlotPoolIsAlive => {
                let pdef = self.pool_def_of_ty(op.ty0);
                let ncols = if let pm = self.env.get_pool(pdef) { pm.columns.len.widen.[usize]() } else { 0_usize };
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let a1 = self.eir_val_at(args_r, 1_usize);
                let idx = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                let cap = (try self.mem_read_u64_off(p0.ptr, (ncols +% 3_usize) *% 8_usize)).trunc.[usize]();
                let gen_ptr = try self.mem_read_u64_off(p0.ptr, ncols *% 8_usize);
                var alive = false;
                if !self.st.faulted && idx < cap {
                    let g = try self.mem_read_u32_off(gen_ptr, idx *% 4_usize);
                    alive = (g & 1_u32) != 0_u32;
                }
                self.mem_free_quiet(p0.temp);
                return val_scalar(if alive { 1_u64 } else { 0_u64 });
            }
            .SlotPoolIdAt => {
                let pdef = self.pool_def_of_ty(op.ty0);
                let ncols = if let pm = self.env.get_pool(pdef) { pm.columns.len.widen.[usize]() } else { 0_usize };
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let a1 = self.eir_val_at(args_r, 1_usize);
                let idx = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                let cap = (try self.mem_read_u64_off(p0.ptr, (ncols +% 3_usize) *% 8_usize)).trunc.[usize]();
                let gen_ptr = try self.mem_read_u64_off(p0.ptr, ncols *% 8_usize);
                var sgen: u32 = 0_u32;
                if !self.st.faulted && idx < cap {
                    sgen = try self.mem_read_u32_off(gen_ptr, idx *% 4_usize);
                }
                self.mem_free_quiet(p0.temp);
                var gid: [8]u8 = [0_u8; 8];
                write_le_u32_at(&mut gid, 0_usize, idx.trunc.[u32]());
                write_le_u32_at(&mut gid, 4_usize, sgen);
                return val_scalar(read_le_u64_at(&gid, 0_usize));
            }
            .SlotPoolDestroy => {
                return try self.exec_slot_pool_destroy(fn_id, op.ty0, args_r, slots_r, frame);
            }
            _ => { return val_void(); }
        }
    }

    fn exec_slot_pool_get_or_at(
        self: *mut Self,
        fn_id: u32,
        elem_ty: types.TyId,
        returns_eu: bool,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let pdef = self.pool_def_of_ty(elem_ty);
        let ncols = if let pm = self.env.get_pool(pdef) { pm.columns.len.widen.[usize]() } else { 0_usize };
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        var gid: [8]u8 = [0_u8; 8];
        let a1 = self.eir_val_at(args_r, 1_usize);
        self.st.vals.write_bytes_to(frame.get_val(a1), &mut gid);
        let idx = read_le_u32_at(&gid, 0_usize).widen.[usize]();
        let slot_gen = read_le_u32_at(&gid, 4_usize);
        let cap = (try self.mem_read_u64_off(p0.ptr, (ncols +% 3_usize) *% 8_usize)).trunc.[usize]();
        let gen_ptr = try self.mem_read_u64_off(p0.ptr, ncols *% 8_usize);
        var alive = false;
        if !self.st.faulted && slot_gen != 0_u32 && (slot_gen & 1_u32) != 0_u32 && idx < cap {
            let cg = try self.mem_read_u32_off(gen_ptr, idx *% 4_usize);
            alive = !self.st.faulted && cg == slot_gen;
        }
        let rv = try self.st.vals.from_pair(self.alloc, p0.ptr, idx.widen.[u64]());
        var res = val_void();
        if returns_eu {
            if alive {
                let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                res = try self.pack_error_union(ret_ty, ok_ty, 0_u32, rv);
            } else {
                res = try self.pack_error_union(ret_ty, types.TY_VOID, ERR_STALE_ID, val_void());
            }
        } else if alive {
            let rn = self.env.get(ret_ty);
            let inner = if rn.kind == .Optional { rn.primary } else { ret_ty };
            res = try self.eval_cast(.WrapOptional, rv, inner, ret_ty);
        } else {
            res = try self.zero_val_of_size(self.env.x64_layout(ret_ty).size);
        }
        self.mem_free_quiet(p0.temp);
        return res;
    }

    fn exec_slot_pool_meta_u64(
        self: *mut Self,
        fn_id: u32,
        is_len: bool,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let a0 = self.eir_val_at(args_r, 0_usize);
        let ty0 = self.eir.fn_val_ty(fn_id, a0);
        let deref = deref_single_ty(self.env, ty0);
        let dn = self.env.get(deref);
        let ncols = if dn.kind == .Builtin {
            self.env.pool_col_count(self.env.node_gval_list(&dn))
        } else {
            0_usize
        };
        let off = if is_len { (ncols +% 2_usize) *% 8_usize } else { (ncols +% 3_usize) *% 8_usize };
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let v = try self.mem_read_u64_off(p0.ptr, off);
        self.mem_free_quiet(p0.temp);
        return val_scalar(v);
    }

    fn exec_builtin_buf(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        match op.kind {
            .BufInit => {
                return try self.exec_buf_init(fn_id, op.ty0, args_r, slots_r, ret_ty, frame);
            }
            .BufPush => {
                return try self.exec_buf_push(fn_id, op.ty0, args_r, slots_r, ret_ty, frame);
            }
            .BufPushSlice => {
                return try self.exec_buf_push_slice(fn_id, op.ty0, args_r, slots_r, ret_ty, frame);
            }
            .BufPop => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let data_ptr = try self.mem_read_u64(p0.ptr);
                let len = (try self.mem_read_u64_off(p0.ptr, 8_usize)).trunc.[usize]();
                var res = val_void();
                if self.st.faulted {
                    res = val_void();
                } else if len == 0_usize {
                    res = try self.opt_null_val(ret_ty);
                } else {
                    let new_len = len -% 1_usize;
                    _ = try self.mem_write_u64_off(p0.ptr, 8_usize, new_len.widen.[u64]());
                    let ep = try self.mem_ptr_add(data_ptr, new_len *% esz);
                    let ev = try self.mem_read_val(ep, esz);
                    res = try self.eval_cast(.WrapOptional, ev, op.ty0, ret_ty);
                }
                self.mem_free_quiet(p0.temp);
                return res;
            }
            .BufDestroy => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let p1 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 1_usize, frame);
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let data_ptr = try self.mem_read_u64(p0.ptr);
                let cap = (try self.mem_read_u64_off(p0.ptr, 16_usize)).trunc.[usize]();
                if !self.st.faulted {
                    try self.free_raw_tracked(p1.ptr, data_ptr, cap *% esz);
                    _ = try self.mem_write_u64(p0.ptr, 0_u64);
                    _ = try self.mem_write_u64_off(p0.ptr, 8_usize, 0_u64);
                    _ = try self.mem_write_u64_off(p0.ptr, 16_usize, 0_u64);
                }
                self.mem_free_quiet(p0.temp);
                self.mem_free_quiet(p1.temp);
                return val_void();
            }
            _ => {
                return try self.exec_buf_query(fn_id, op, args_r, slots_r, ret_ty, frame);
            }
        }
    }

    fn exec_buf_init(
        self: *mut Self,
        fn_id: u32,
        el_ty: types.TyId,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let a1 = self.eir_val_at(args_r, 1_usize);
        let cap = max_usize(self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize](), 1_usize);
        let esz = max_usize(self.env.x64_layout(el_ty).size, 1_usize);
        let data_ptr = try self.alloc_raw_tracked(p0.ptr, cap *% esz);
        self.mem_free_quiet(p0.temp);
        if self.st.faulted {
            return val_void();
        }
        if data_ptr == 0_u64 {
            return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
        }
        var bb: [24]u8 = [0_u8; 24];
        write_le_u64_at(&mut bb, 0_usize, data_ptr, 8_usize);
        write_le_u64_at(&mut bb, 8_usize, 0_u64, 8_usize);
        write_le_u64_at(&mut bb, 16_usize, cap.widen.[u64](), 8_usize);
        let bv = try self.st.vals.from_bytes(self.alloc, &bb);
        let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
        return try self.pack_error_union(ret_ty, ok_ty, 0_u32, bv);
    }

    fn exec_buf_push(
        self: *mut Self,
        fn_id: u32,
        el_ty: types.TyId,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let val_arg = self.eir_val_at(args_r, if args_r.len >= 3_u32 { 2_usize } else { 1_usize });
        let esz = max_usize(self.env.x64_layout(el_ty).size, 1_usize);
        let data_ptr = try self.mem_read_u64(p0.ptr);
        let len = (try self.mem_read_u64_off(p0.ptr, 8_usize)).trunc.[usize]();
        let cap = (try self.mem_read_u64_off(p0.ptr, 16_usize)).trunc.[usize]();
        var res = val_void();
        if self.st.faulted {
            res = val_void();
        } else if len >= cap {
            res = try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
        } else {
            var eb = try col.DynBuf.[u8].init(self.alloc, esz);
            errdefer eb.destroy(self.alloc);
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(val_arg), esz, &mut eb);
            let dst_p = try self.mem_ptr_add(data_ptr, len *% esz);
            _ = try self.mem_write(dst_p, eb.as_slice());
            _ = try self.mem_write_u64_off(p0.ptr, 8_usize, (len +% 1_usize).widen.[u64]());
            res = try self.pack_error_union(ret_ty, types.TY_VOID, 0_u32, val_void());
            eb.destroy(self.alloc);
        }
        self.mem_free_quiet(p0.temp);
        return res;
    }

    fn exec_buf_push_slice(
        self: *mut Self,
        fn_id: u32,
        el_ty: types.TyId,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let slice_arg = self.eir_val_at(args_r, if args_r.len >= 3_u32 { 2_usize } else { 1_usize });
        let sp = self.st.vals.as_pair(frame.get_val(slice_arg));
        let slen = sp.b.trunc.[usize]();
        let esz = max_usize(self.env.x64_layout(el_ty).size, 1_usize);
        let data_ptr = try self.mem_read_u64(p0.ptr);
        let len = (try self.mem_read_u64_off(p0.ptr, 8_usize)).trunc.[usize]();
        let cap = (try self.mem_read_u64_off(p0.ptr, 16_usize)).trunc.[usize]();
        var res = val_void();
        if self.st.faulted {
            res = val_void();
        } else if cap < len || (cap -% len) < slen {
            res = try self.pack_error_union(ret_ty, types.TY_VOID, ERR_OOM, val_void());
        } else {
            if slen > 0_usize {
                let nbytes = slen *% esz;
                var copy_buf = try col.DynBuf.[u8].init(self.alloc, nbytes);
                errdefer copy_buf.destroy(self.alloc);
                if try self.mem_read_dyn(sp.a, nbytes, &mut copy_buf) {
                    let dst_p = try self.mem_ptr_add(data_ptr, len *% esz);
                    _ = try self.mem_write(dst_p, copy_buf.as_slice());
                }
                copy_buf.destroy(self.alloc);
            }
            _ = try self.mem_write_u64_off(p0.ptr, 8_usize, (len +% slen).widen.[u64]());
            res = try self.pack_error_union(ret_ty, types.TY_VOID, 0_u32, val_void());
        }
        self.mem_free_quiet(p0.temp);
        return res;
    }

    fn exec_buf_query(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        match op.kind {
            .BufLen => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let v = try self.mem_read_u64_off(p0.ptr, 8_usize);
                self.mem_free_quiet(p0.temp);
                return val_scalar(v);
            }
            .BufCap => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let v = try self.mem_read_u64_off(p0.ptr, 16_usize);
                self.mem_free_quiet(p0.temp);
                return val_scalar(v);
            }
            .BufClear => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                _ = try self.mem_write_u64_off(p0.ptr, 8_usize, 0_u64);
                self.mem_free_quiet(p0.temp);
                return val_void();
            }
            .BufAsSlice => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let data_ptr = try self.mem_read_u64(p0.ptr);
                let len = try self.mem_read_u64_off(p0.ptr, 8_usize);
                self.mem_free_quiet(p0.temp);
                return try self.st.vals.from_pair(self.alloc, data_ptr, len);
            }
            .BufAt => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let data_ptr = try self.mem_read_u64(p0.ptr);
                let len = (try self.mem_read_u64_off(p0.ptr, 8_usize)).trunc.[usize]();
                let a1 = self.eir_val_at(args_r, 1_usize);
                let idx = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                self.mem_free_quiet(p0.temp);
                if idx < len {
                    let ep = try self.mem_ptr_add(data_ptr, idx *% esz);
                    let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                    return try self.pack_error_union(ret_ty, ok_ty, 0_u32, val_scalar(ep));
                }
                return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_BOUNDS, val_void());
            }
            .BufGet => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let data_ptr = try self.mem_read_u64(p0.ptr);
                let len = (try self.mem_read_u64_off(p0.ptr, 8_usize)).trunc.[usize]();
                let a1 = self.eir_val_at(args_r, 1_usize);
                let idx = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                self.mem_free_quiet(p0.temp);
                if idx < len {
                    return val_scalar(try self.mem_ptr_add(data_ptr, idx *% esz));
                }
                return val_scalar(0_u64);
            }
            .BufSub => {
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let data_ptr = try self.mem_read_u64(p0.ptr);
                let len = (try self.mem_read_u64_off(p0.ptr, 8_usize)).trunc.[usize]();
                let a1 = self.eir_val_at(args_r, 1_usize);
                let a2 = self.eir_val_at(args_r, 2_usize);
                let lo = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                let hi = self.st.vals.as_u64(frame.get_val(a2)).trunc.[usize]();
                self.mem_free_quiet(p0.temp);
                if lo <= hi && hi <= len {
                    let sub_ptr = try self.mem_ptr_add(data_ptr, lo *% esz);
                    let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                    let sv = try self.st.vals.from_pair(self.alloc, sub_ptr, (hi -% lo).widen.[u64]());
                    return try self.pack_error_union(ret_ty, ok_ty, 0_u32, sv);
                }
                return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_BOUNDS, val_void());
            }
            _ => { return val_void(); }
        }
    }

    fn exec_builtin_atomic_mmio(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        match op.kind {
            .AtomicNew => {
                let a0 = self.eir_val_at(args_r, 0_usize);
                return frame.get_val(a0);
            }
            .AtomicLoad => {
                let sz = clamp_usize(self.env.x64_layout(op.ty0).size, 1_usize, 8_usize);
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let v = try self.mem_read_val(p0.ptr, sz);
                self.mem_free_quiet(p0.temp);
                return v;
            }
            .AtomicStore => {
                let sz = clamp_usize(self.env.x64_layout(op.ty0).size, 1_usize, 8_usize);
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                var wb: [8]u8 = [0_u8; 8];
                let a1 = self.eir_val_at(args_r, 1_usize);
                self.st.vals.write_bytes_to(frame.get_val(a1), &mut wb);
                let wref: *[u8] = &wb;
                let wslice = wref.sub(0_usize, sz) catch { wref };
                _ = try self.mem_write(p0.ptr, wslice);
                self.mem_free_quiet(p0.temp);
                return val_void();
            }
            .AtomicFetchAdd => {
                return try self.exec_atomic_fetch_op(fn_id, op.ty0, true, args_r, slots_r, frame);
            }
            .AtomicFetchSub => {
                return try self.exec_atomic_fetch_op(fn_id, op.ty0, false, args_r, slots_r, frame);
            }
            .AtomicSwap => {
                let sz = clamp_usize(self.env.x64_layout(op.ty0).size, 1_usize, 8_usize);
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let old = try self.mem_read_val(p0.ptr, sz);
                var wb: [8]u8 = [0_u8; 8];
                let a1 = self.eir_val_at(args_r, 1_usize);
                self.st.vals.write_bytes_to(frame.get_val(a1), &mut wb);
                let wref: *[u8] = &wb;
                let wslice = wref.sub(0_usize, sz) catch { wref };
                _ = try self.mem_write(p0.ptr, wslice);
                self.mem_free_quiet(p0.temp);
                return old;
            }
            .AtomicCas => {
                let sz = clamp_usize(self.env.x64_layout(op.ty0).size, 1_usize, 8_usize);
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                var cur: [8]u8 = [0_u8; 8];
                var exp: [8]u8 = [0_u8; 8];
                let ok_rd = try self.mem_read_into_n(p0.ptr, &mut cur, sz);
                let a1 = self.eir_val_at(args_r, 1_usize);
                self.st.vals.write_bytes_to(frame.get_val(a1), &mut exp);
                var eq = ok_rd;
                var i: usize = 0_usize;
                while eq && i < sz && i < 8_usize {
                    if cur[i] != exp[i] {
                        eq = false;
                    }
                    i = i +% 1_usize;
                }
                if eq {
                    var wb: [8]u8 = [0_u8; 8];
                    let a2 = self.eir_val_at(args_r, 2_usize);
                    self.st.vals.write_bytes_to(frame.get_val(a2), &mut wb);
                    let wref: *[u8] = &wb;
                    let wslice = wref.sub(0_usize, sz) catch { wref };
                    _ = try self.mem_write(p0.ptr, wslice);
                }
                self.mem_free_quiet(p0.temp);
                return val_scalar(if eq { 1_u64 } else { 0_u64 });
            }
            .MmioRead => {
                let sz = clamp_usize(self.env.x64_layout(op.ty0).size, 1_usize, 8_usize);
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                let v = try self.mem_read_val(p0.ptr, sz);
                self.mem_free_quiet(p0.temp);
                return v;
            }
            .MmioWrite => {
                let sz = clamp_usize(self.env.x64_layout(op.ty0).size, 1_usize, 8_usize);
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                var wb: [8]u8 = [0_u8; 8];
                let a1 = self.eir_val_at(args_r, 1_usize);
                self.st.vals.write_bytes_to(frame.get_val(a1), &mut wb);
                let wref: *[u8] = &wb;
                let wslice = wref.sub(0_usize, sz) catch { wref };
                _ = try self.mem_write(p0.ptr, wslice);
                self.mem_free_quiet(p0.temp);
                return val_void();
            }
            .RawPtrFromUsize => {
                let a0 = self.eir_val_at(args_r, 0_usize);
                return val_scalar(self.st.vals.as_u64(frame.get_val(a0)));
            }
            .RawPtrAsUsize => {
                let a0 = self.eir_val_at(args_r, 0_usize);
                return val_scalar(self.st.vals.as_u64(frame.get_val(a0)));
            }
            _ => { return val_void(); }
        }
    }

    fn exec_atomic_fetch_op(
        self: *mut Self,
        fn_id: u32,
        el_ty: types.TyId,
        is_add: bool,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let sz = clamp_usize(self.env.x64_layout(el_ty).size, 1_usize, 8_usize);
        let bits = self.env.int_bits(el_ty);
        let m = mask_bits(bits);
        let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
        let old_v = try self.mem_read_val(p0.ptr, sz);
        let old = self.st.vals.as_u64(old_v);
        let a1 = self.eir_val_at(args_r, 1_usize);
        let delta = self.st.vals.as_u64(frame.get_val(a1));
        let new_v = (if is_add { old +% delta } else { old -% delta }) & m;
        var wb: [8]u8 = [0_u8; 8];
        write_le_u64_at(&mut wb, 0_usize, new_v, sz);
        let wref: *[u8] = &wb;
        let wslice = wref.sub(0_usize, sz) catch { wref };
        _ = try self.mem_write(p0.ptr, wslice);
        self.mem_free_quiet(p0.temp);
        return val_scalar(old & m);
    }
}

// ===========================================================================
// Section 9: Builtins — Math, Slices/Str, SIMD Vec, ParReduce, ScheduleRun
// ===========================================================================

fn bswap_bits(v: u64, bits: u8) -> u64 {
    if bits <= 8_u8 {
        return v & 0xFF_u64;
    }
    if bits <= 16_u8 {
        let lo = v & 0xFF_u64;
        let hi = (v >> 8_u64) & 0xFF_u64;
        return (lo <<% 8_u64) | hi;
    }
    if bits <= 32_u8 {
        let b0 = v & 0xFF_u64;
        let b1 = (v >> 8_u64) & 0xFF_u64;
        let b2 = (v >> 16_u64) & 0xFF_u64;
        let b3 = (v >> 24_u64) & 0xFF_u64;
        return (b0 <<% 24_u64) | (b1 <<% 16_u64) | (b2 <<% 8_u64) | b3;
    }
    let b0 = v & 0xFF_u64;
    let b1 = (v >> 8_u64) & 0xFF_u64;
    let b2 = (v >> 16_u64) & 0xFF_u64;
    let b3 = (v >> 24_u64) & 0xFF_u64;
    let b4 = (v >> 32_u64) & 0xFF_u64;
    let b5 = (v >> 40_u64) & 0xFF_u64;
    let b6 = (v >> 48_u64) & 0xFF_u64;
    let b7 = (v >> 56_u64) & 0xFF_u64;
    return (b0 <<% 56_u64) | (b1 <<% 48_u64) | (b2 <<% 40_u64) | (b3 <<% 32_u64)
        | (b4 <<% 24_u64) | (b5 <<% 16_u64) | (b6 <<% 8_u64) | b7;
}

fn lzcnt_bits(v: u64, bits: u8) -> u64 {
    let w: u8 = if bits <= 8_u8 {
        8_u8
    } else if bits <= 16_u8 {
        16_u8
    } else if bits <= 32_u8 {
        32_u8
    } else {
        64_u8
    };
    var x = v & mask_bits(w);
    if x == 0_u64 {
        return w.widen.[u64]();
    }
    var n: u64 = 0_u64;
    if (x & 0xFFFFFFFF00000000_u64) == 0_u64 { n = n +% 32_u64; x = x <<% 32_u64; }
    if (x & 0xFFFF000000000000_u64) == 0_u64 { n = n +% 16_u64; x = x <<% 16_u64; }
    if (x & 0xFF00000000000000_u64) == 0_u64 { n = n +% 8_u64; x = x <<% 8_u64; }
    if (x & 0xF000000000000000_u64) == 0_u64 { n = n +% 4_u64; x = x <<% 4_u64; }
    if (x & 0xC000000000000000_u64) == 0_u64 { n = n +% 2_u64; x = x <<% 2_u64; }
    if (x & 0x8000000000000000_u64) == 0_u64 { n = n +% 1_u64; }
    let pad = (64_u8 -% w).widen.[u64]();
    return if n >= pad { n -% pad } else { 0_u64 };
}

fn tzcnt_bits(v: u64, bits: u8) -> u64 {
    let w: u8 = if bits <= 8_u8 {
        8_u8
    } else if bits <= 16_u8 {
        16_u8
    } else if bits <= 32_u8 {
        32_u8
    } else {
        64_u8
    };
    let m = v & mask_bits(w);
    if m == 0_u64 {
        return w.widen.[u64]();
    }
    return @tzcnt(m);
}

fn popcnt_bits(v: u64, bits: u8) -> u64 {
    let w: u8 = if bits <= 8_u8 {
        8_u8
    } else if bits <= 16_u8 {
        16_u8
    } else if bits <= 32_u8 {
        32_u8
    } else {
        64_u8
    };
    var x = v & mask_bits(w);
    x = x -% ((x >> 1_u64) & 0x5555555555555555_u64);
    x = (x & 0x3333333333333333_u64) +% ((x >> 2_u64) & 0x3333333333333333_u64);
    x = (x +% (x >> 4_u64)) & 0x0F0F0F0F0F0F0F0F_u64;
    return (x *% 0x0101010101010101_u64) >> 56_u64;
}

const ARG_MATCH_NONE: u8 = 255_u8;
const ARG_MATCH_EXACT: u8 = 0_u8;
const ARG_MATCH_MUT_TO_CONST: u8 = 1_u8;
const ARG_MATCH_DEREF: u8 = 2_u8;
const ARG_MATCH_BORROW: u8 = 3_u8;

fn match_arg_type(env: *types.TypeEnv, arg_ty: types.TyId, param_ty: types.TyId) -> u8 {
    if arg_ty == param_ty {
        return ARG_MATCH_EXACT;
    }
    let an = env.get(arg_ty);
    let pn = env.get(param_ty);
    if an.kind == .Borrow && pn.kind == .Borrow
        && an.flag0 && !pn.flag0
        && an.borrow_kind == pn.borrow_kind
        && an.primary == pn.primary
    {
        return ARG_MATCH_MUT_TO_CONST;
    }
    if an.kind == .RawPtr && pn.kind == .RawPtr
        && an.flag0 && !pn.flag0
        && an.primary == pn.primary
    {
        return ARG_MATCH_MUT_TO_CONST;
    }
    if ((an.kind == .Borrow && an.borrow_kind == .Single) || an.kind == .RawPtr)
        && an.primary == param_ty
    {
        return ARG_MATCH_DEREF;
    }
    if ((pn.kind == .Borrow && pn.borrow_kind == .Single) || pn.kind == .RawPtr)
        && arg_ty == pn.primary
    {
        return ARG_MATCH_BORROW;
    }
    return ARG_MATCH_NONE;
}

fn is_pool_or_cap_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    let inner = deref_single_ty(env, ty);
    let n = env.get(inner);
    if n.kind == .Pool {
        return true;
    }
    if n.kind == .Builtin {
        match n.builtin_kind {
            .ArenaPool => { return true; }
            .SlotPool => { return true; }
            .AllocCap => { return true; }
            .FsCap => { return true; }
            .DirCap => { return true; }
            .NetCap => { return true; }
            .ClockCap => { return true; }
            .IoCap => { return true; }
            .ArgsCap => { return true; }
            .Env => { return true; }
            _ => { return false; }
        }
    }
    return false;
}

fn classify_reduce_op(op_name: *[u8]) -> u8 {
    if str.bytes_eq(op_name, "Min".as_bytes()) || str.bytes_eq(op_name, "min".as_bytes()) {
        return 1_u8;
    }
    if str.bytes_eq(op_name, "Max".as_bytes()) || str.bytes_eq(op_name, "max".as_bytes()) {
        return 2_u8;
    }
    if str.bytes_eq(op_name, "Mul".as_bytes())
        || str.bytes_eq(op_name, "MulWrap".as_bytes())
        || str.bytes_eq(op_name, "mul".as_bytes())
    {
        return 3_u8;
    }
    if str.bytes_eq(op_name, "And".as_bytes())
        || str.bytes_eq(op_name, "BitAnd".as_bytes())
        || str.bytes_eq(op_name, "and".as_bytes())
        || str.bytes_eq(op_name, "bitand".as_bytes())
    {
        return 4_u8;
    }
    if str.bytes_eq(op_name, "Or".as_bytes())
        || str.bytes_eq(op_name, "BitOr".as_bytes())
        || str.bytes_eq(op_name, "or".as_bytes())
        || str.bytes_eq(op_name, "bitor".as_bytes())
    {
        return 5_u8;
    }
    if str.bytes_eq(op_name, "Xor".as_bytes())
        || str.bytes_eq(op_name, "BitXor".as_bytes())
        || str.bytes_eq(op_name, "xor".as_bytes())
        || str.bytes_eq(op_name, "bitxor".as_bytes())
    {
        return 6_u8;
    }
    return 0_u8;
}

impl Interp {
    fn exec_builtin_math(
        self: *Self,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot {
        let a0 = self.eir_val_at(args_r, 0_usize);
        let x = self.st.vals.as_u64(frame.get_val(a0));
        match op.kind {
            .MathSqrt => {
                let tn = self.env.get(op.ty0);
                if tn.kind == .Float && tn.u8_val == 16_u8 {
                    let f = f16_bits_to_f32_bits(x.trunc.[u16]()).bitcast.[f32]();
                    return val_scalar(f32_bits_to_f16_bits(@sqrt(f).bitcast.[u32]()).widen.[u64]());
                }
                if tn.kind == .Float && tn.u8_val == 32_u8 {
                    let f = x.trunc.[u32]().bitcast.[f32]();
                    return val_scalar(@sqrt(f).bitcast.[u32]().widen.[u64]());
                }
                let f = x.bitcast.[f64]();
                return val_scalar(@sqrt(f).bitcast.[u64]());
            }
            .MathFma => {
                let a1 = self.eir_val_at(args_r, 1_usize);
                let a2 = self.eir_val_at(args_r, 2_usize);
                let xb = self.st.vals.as_u64(frame.get_val(a1));
                let xc = self.st.vals.as_u64(frame.get_val(a2));
                let tn = self.env.get(op.ty0);
                if tn.kind == .Float && tn.u8_val == 16_u8 {
                    let a = f16_bits_to_f32_bits(x.trunc.[u16]()).bitcast.[f32]();
                    let b = f16_bits_to_f32_bits(xb.trunc.[u16]()).bitcast.[f32]();
                    let c = f16_bits_to_f32_bits(xc.trunc.[u16]()).bitcast.[f32]();
                    return val_scalar(f32_bits_to_f16_bits(@fma(a, b, c).bitcast.[u32]()).widen.[u64]());
                }
                if tn.kind == .Float && tn.u8_val == 32_u8 {
                    let a = x.trunc.[u32]().bitcast.[f32]();
                    let b = xb.trunc.[u32]().bitcast.[f32]();
                    let c = xc.trunc.[u32]().bitcast.[f32]();
                    return val_scalar(@fma(a, b, c).bitcast.[u32]().widen.[u64]());
                }
                let a = x.bitcast.[f64]();
                let b = xb.bitcast.[f64]();
                let c = xc.bitcast.[f64]();
                return val_scalar(@fma(a, b, c).bitcast.[u64]());
            }
            .MathLzcnt => { return val_scalar(lzcnt_bits(x, self.env.int_bits(op.ty0))); }
            .MathTzcnt => { return val_scalar(tzcnt_bits(x, self.env.int_bits(op.ty0))); }
            .MathPopcnt => { return val_scalar(popcnt_bits(x, self.env.int_bits(op.ty0))); }
            .MathBswap => { return val_scalar(bswap_bits(x, self.env.int_bits(op.ty0))); }
            _ => { return val_void(); }
        }
    }

    fn exec_builtin_slice_arr(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *mut FrameState,
    ) -> ValSlot ! OutOfMemory {
        let a0 = self.eir_val_at(args_r, 0_usize);
        match op.kind {
            .SliceLen => { return val_scalar(self.st.vals.as_pair(frame.get_val(a0)).b); }
            .StrLen => { return val_scalar(self.st.vals.as_pair(frame.get_val(a0)).b); }
            .ArrayLen => {
                let deref = deref_single_ty(self.env, self.eir.fn_val_ty(fn_id, a0));
                let dn = self.env.get(deref);
                return val_scalar(if dn.kind == .Array { dn.u64_val } else { 0_u64 });
            }
            .StrAsBytes => { return frame.get_val(a0); }
            .BytesAsStr => {
                let pr = self.st.vals.as_pair(frame.get_val(a0));
                var tmp = try col.DynBuf.[u8].init(self.alloc, max_usize(pr.b.trunc.[usize](), 16_usize));
                errdefer tmp.destroy(self.alloc);
                var res = val_void();
                if try self.mem_read_dyn(pr.a, pr.b.trunc.[usize](), &mut tmp) {
                    var valid = true;
                    str.validate_utf8(tmp.as_slice()) catch {
                        valid = false;
                    };
                    if valid {
                        let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                        let sv = try self.st.vals.from_pair(self.alloc, pr.a, pr.b);
                        res = try self.pack_error_union(ret_ty, ok_ty, 0_u32, sv);
                    } else {
                        res = try self.pack_error_union(ret_ty, types.TY_VOID, ERR_UTF8, val_void());
                    }
                }
                tmp.destroy(self.alloc);
                return res;
            }
            .SliceAt => {
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let pr = self.st.vals.as_pair(frame.get_val(a0));
                let a1 = self.eir_val_at(args_r, 1_usize);
                let idx = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                if idx < pr.b.trunc.[usize]() {
                    let ep = try self.mem_ptr_add(pr.a, idx *% esz);
                    let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                    return try self.pack_error_union(ret_ty, ok_ty, 0_u32, val_scalar(ep));
                }
                return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_BOUNDS, val_void());
            }
            .ArrayAt => {
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let deref = deref_single_ty(self.env, self.eir.fn_val_ty(fn_id, a0));
                let dn = self.env.get(deref);
                let alen = if dn.kind == .Array { dn.u64_val.trunc.[usize]() } else { 0_usize };
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                if p0.temp != 0_u64 {
                    try frame.rvalue_temps.push(self.alloc, p0.temp);
                }
                let a1 = self.eir_val_at(args_r, 1_usize);
                let idx = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                if idx < alen {
                    let ep = try self.mem_ptr_add(p0.ptr, idx *% esz);
                    let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                    return try self.pack_error_union(ret_ty, ok_ty, 0_u32, val_scalar(ep));
                }
                return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_BOUNDS, val_void());
            }
            .SliceGet => {
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let pr = self.st.vals.as_pair(frame.get_val(a0));
                let a1 = self.eir_val_at(args_r, 1_usize);
                let idx = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                if idx < pr.b.trunc.[usize]() {
                    return val_scalar(try self.mem_ptr_add(pr.a, idx *% esz));
                }
                return val_scalar(0_u64);
            }
            .ArrayGet => {
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let deref = deref_single_ty(self.env, self.eir.fn_val_ty(fn_id, a0));
                let dn = self.env.get(deref);
                let alen = if dn.kind == .Array { dn.u64_val.trunc.[usize]() } else { 0_usize };
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                if p0.temp != 0_u64 {
                    try frame.rvalue_temps.push(self.alloc, p0.temp);
                }
                let a1 = self.eir_val_at(args_r, 1_usize);
                let idx = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                if idx < alen {
                    return val_scalar(try self.mem_ptr_add(p0.ptr, idx *% esz));
                }
                return val_scalar(0_u64);
            }
            .SliceSub => {
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let pr = self.st.vals.as_pair(frame.get_val(a0));
                let a1 = self.eir_val_at(args_r, 1_usize);
                let a2 = self.eir_val_at(args_r, 2_usize);
                let lo = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                let hi = self.st.vals.as_u64(frame.get_val(a2)).trunc.[usize]();
                if lo <= hi && hi <= pr.b.trunc.[usize]() {
                    let sp = try self.mem_ptr_add(pr.a, lo *% esz);
                    let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                    let sv = try self.st.vals.from_pair(self.alloc, sp, (hi -% lo).widen.[u64]());
                    return try self.pack_error_union(ret_ty, ok_ty, 0_u32, sv);
                }
                return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_BOUNDS, val_void());
            }
            .ArraySub => {
                let esz = max_usize(self.env.x64_layout(op.ty0).size, 1_usize);
                let deref = deref_single_ty(self.env, self.eir.fn_val_ty(fn_id, a0));
                let dn = self.env.get(deref);
                let alen = if dn.kind == .Array { dn.u64_val.trunc.[usize]() } else { 0_usize };
                let p0 = try self.resolve_ptr_arg(fn_id, args_r, slots_r, 0_usize, frame);
                if p0.temp != 0_u64 {
                    try frame.rvalue_temps.push(self.alloc, p0.temp);
                }
                let a1 = self.eir_val_at(args_r, 1_usize);
                let a2 = self.eir_val_at(args_r, 2_usize);
                let lo = self.st.vals.as_u64(frame.get_val(a1)).trunc.[usize]();
                let hi = self.st.vals.as_u64(frame.get_val(a2)).trunc.[usize]();
                if lo <= hi && hi <= alen {
                    let sp = try self.mem_ptr_add(p0.ptr, lo *% esz);
                    let ok_ty = error_union_ok_ty(self.env, ret_ty, ret_ty);
                    let sv = try self.st.vals.from_pair(self.alloc, sp, (hi -% lo).widen.[u64]());
                    return try self.pack_error_union(ret_ty, ok_ty, 0_u32, sv);
                }
                return try self.pack_error_union(ret_ty, types.TY_VOID, ERR_BOUNDS, val_void());
            }
            _ => { return val_void(); }
        }
    }

    fn exec_builtin_vec(
        self: *mut Self,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let a0 = self.eir_val_at(args_r, 0_usize);
        match op.kind {
            .VecLen => { return val_scalar(op.len_u8.widen.[u64]()); }
            .VecMaskAny => {
                let n = op.len_u8.widen.[usize]();
                var mb = try col.DynBuf.[u8].init(self.alloc, max_usize(n, 8_usize));
                errdefer mb.destroy(self.alloc);
                try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), n, &mut mb);
                let bs = mb.as_slice();
                var found = false;
                var i: usize = 0_usize;
                while i < bs.len {
                    if bs[i] != 0_u8 { found = true; break; }
                    i = i +% 1_usize;
                }
                mb.destroy(self.alloc);
                return val_scalar(if found { 1_u64 } else { 0_u64 });
            }
            .VecMaskAll => {
                let n = op.len_u8.widen.[usize]();
                var mb = try col.DynBuf.[u8].init(self.alloc, max_usize(n, 8_usize));
                errdefer mb.destroy(self.alloc);
                try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), n, &mut mb);
                let bs = mb.as_slice();
                var all = true;
                var i: usize = 0_usize;
                while i < bs.len {
                    if bs[i] == 0_u8 { all = false; break; }
                    i = i +% 1_usize;
                }
                mb.destroy(self.alloc);
                return val_scalar(if all { 1_u64 } else { 0_u64 });
            }
            .VecBitmask => {
                let n = op.len_u8.widen.[usize]();
                var mb = try col.DynBuf.[u8].init(self.alloc, max_usize(n, 8_usize));
                errdefer mb.destroy(self.alloc);
                try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), n, &mut mb);
                let bs = mb.as_slice();
                var bits: u64 = 0_u64;
                var i: usize = 0_usize;
                while i < bs.len && i < 64_usize {
                    if bs[i] != 0_u8 {
                        bits = bits | (1_u64 <<% i.trunc.[u64]());
                    }
                    i = i +% 1_usize;
                }
                mb.destroy(self.alloc);
                return val_scalar(bits);
            }
            .VecSplat => { return try self.exec_vec_splat(op.ty0, args_r, frame); }
            .VecCmp => { return try self.exec_vec_cmp(op.ty0, op.bin_op, args_r, frame); }
            .VecSelect => { return try self.exec_vec_select_or_minmax(op.ty0, 0_u8, args_r, frame); }
            .VecMin => { return try self.exec_vec_select_or_minmax(op.ty0, 1_u8, args_r, frame); }
            .VecMax => { return try self.exec_vec_select_or_minmax(op.ty0, 2_u8, args_r, frame); }
            .VecFma => { return try self.exec_vec_fma(op.ty0, args_r, frame); }
            .VecReduceAdd => { return try self.exec_vec_reduce(op.ty0, 0_u8, args_r, frame); }
            .VecReduceMin => { return try self.exec_vec_reduce(op.ty0, 1_u8, args_r, frame); }
            .VecReduceMax => { return try self.exec_vec_reduce(op.ty0, 2_u8, args_r, frame); }
            .VecDot => { return try self.exec_vec_dot(op.ty0, args_r, frame); }
            .VecShuffle => { return try self.exec_vec_shuffle(op.ty0, op.ty1, op.flag, args_r, frame); }
            _ => { return val_void(); }
        }
    }

    fn exec_vec_splat(
        self: *mut Self,
        vec_ty: types.TyId,
        args_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let vn = self.env.get(vec_ty);
        if vn.kind != .Vec {
            try self.fail("EIR-Interp: VecSplat on non-vec");
            return val_void();
        }
        let esz = max_usize(self.env.x64_layout(vn.primary).size, 1_usize);
        let lanes = vn.u8_val.widen.[usize]();
        var lane = try col.DynBuf.[u8].init(self.alloc, esz);
        errdefer lane.destroy(self.alloc);
        let a0 = self.eir_val_at(args_r, 0_usize);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), esz, &mut lane);
        var out = try col.DynBuf.[u8].init(self.alloc, esz *% lanes);
        errdefer out.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < lanes {
            try out.push_slice(self.alloc, lane.as_slice());
            i = i +% 1_usize;
        }
        let res = try self.st.vals.from_bytes(self.alloc, out.as_slice());
        out.destroy(self.alloc);
        lane.destroy(self.alloc);
        return res;
    }

    fn exec_vec_cmp(
        self: *mut Self,
        vec_ty: types.TyId,
        bin_op: ast.BinaryOp,
        args_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let vn = self.env.get(vec_ty);
        if vn.kind != .Vec {
            try self.fail("EIR-Interp: VecCmp on non-vec");
            return val_void();
        }
        let elem = vn.primary;
        let lanes = vn.u8_val.widen.[usize]();
        let esz = max_usize(self.env.x64_layout(elem).size, 1_usize);
        let total = esz *% lanes;
        var ab = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer ab.destroy(self.alloc);
        var bb = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer bb.destroy(self.alloc);
        let a0 = self.eir_val_at(args_r, 0_usize);
        let a1 = self.eir_val_at(args_r, 1_usize);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), total, &mut ab);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a1), total, &mut bb);
        var out = try col.DynBuf.[u8].init(self.alloc, lanes);
        errdefer out.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < lanes {
            let off = i *% esz;
            let la = try self.st.vals.from_bytes(self.alloc, ab.as_slice().sub(off, off +% esz) catch { break; });
            let lb = try self.st.vals.from_bytes(self.alloc, bb.as_slice().sub(off, off +% esz) catch { break; });
            let rv = try self.eval_binary(bin_op, la, lb, elem, types.TY_BOOL);
            try out.push(self.alloc, if self.st.vals.as_u64(rv) != 0_u64 { 1_u8 } else { 0_u8 });
            i = i +% 1_usize;
        }
        let res = try self.st.vals.from_bytes(self.alloc, out.as_slice());
        out.destroy(self.alloc);
        bb.destroy(self.alloc);
        ab.destroy(self.alloc);
        return res;
    }

    fn exec_vec_select_or_minmax(
        self: *mut Self,
        vec_ty: types.TyId,
        mode: u8,
        args_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let vn = self.env.get(vec_ty);
        if vn.kind != .Vec {
            try self.fail("EIR-Interp: vector op on non-vec");
            return val_void();
        }
        let elem = vn.primary;
        let lanes = vn.u8_val.widen.[usize]();
        let esz = max_usize(self.env.x64_layout(elem).size, 1_usize);
        let total = esz *% lanes;
        var mb = try col.DynBuf.[u8].init(self.alloc, max_usize(lanes, 8_usize));
        errdefer mb.destroy(self.alloc);
        var ab = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer ab.destroy(self.alloc);
        var bb = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer bb.destroy(self.alloc);
        let a0 = self.eir_val_at(args_r, 0_usize);
        let a1 = self.eir_val_at(args_r, 1_usize);
        if mode == 0_u8 {
            let a2 = self.eir_val_at(args_r, 2_usize);
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), lanes, &mut mb);
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a1), total, &mut ab);
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a2), total, &mut bb);
        } else {
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), total, &mut ab);
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a1), total, &mut bb);
        }
        var out = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer out.destroy(self.alloc);
        try push_zero_bytes(self.alloc, &mut out, total);
        let cmp: ast.BinaryOp = if mode == 1_u8 { .Lt } else { .Gt };
        var i: usize = 0_usize;
        while i < lanes {
            let off = i *% esz;
            var take_a = false;
            if mode == 0_u8 {
                let mbs = mb.as_slice();
                take_a = i < mbs.len && mbs[i] != 0_u8;
            } else {
                let la = try self.st.vals.from_bytes(self.alloc, ab.as_slice().sub(off, off +% esz) catch { break; });
                let lb = try self.st.vals.from_bytes(self.alloc, bb.as_slice().sub(off, off +% esz) catch { break; });
                let cv = try self.eval_binary(cmp, la, lb, elem, types.TY_BOOL);
                take_a = self.st.vals.as_u64(cv) != 0_u64;
            }
            if take_a {
                copy_bytes_slice(out.as_mut_slice(), off, ab.as_slice(), off, esz);
            } else {
                copy_bytes_slice(out.as_mut_slice(), off, bb.as_slice(), off, esz);
            }
            i = i +% 1_usize;
        }
        let res = try self.st.vals.from_bytes(self.alloc, out.as_slice());
        out.destroy(self.alloc);
        bb.destroy(self.alloc);
        ab.destroy(self.alloc);
        mb.destroy(self.alloc);
        return res;
    }

    fn exec_vec_fma(
        self: *mut Self,
        vec_ty: types.TyId,
        args_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let vn = self.env.get(vec_ty);
        if vn.kind != .Vec {
            try self.fail("EIR-Interp: VecFma on non-vec");
            return val_void();
        }
        let elem = vn.primary;
        let lanes = vn.u8_val.widen.[usize]();
        let esz = max_usize(self.env.x64_layout(elem).size, 1_usize);
        let total = esz *% lanes;
        var ab = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer ab.destroy(self.alloc);
        var bb = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer bb.destroy(self.alloc);
        var cb = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer cb.destroy(self.alloc);
        let a0 = self.eir_val_at(args_r, 0_usize);
        let a1 = self.eir_val_at(args_r, 1_usize);
        let a2 = self.eir_val_at(args_r, 2_usize);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), total, &mut ab);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a1), total, &mut bb);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a2), total, &mut cb);
        let is_flt = self.env.is_float(elem);
        let mul_op: ast.BinaryOp = if is_flt { .Mul } else { .MulWrap };
        let add_op: ast.BinaryOp = if is_flt { .Add } else { .AddWrap };
        var out = try col.DynBuf.[u8].init(self.alloc, total);
        errdefer out.destroy(self.alloc);
        try push_zero_bytes(self.alloc, &mut out, total);
        var eb = try col.DynBuf.[u8].init(self.alloc, esz);
        errdefer eb.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < lanes {
            let off = i *% esz;
            let la = try self.st.vals.from_bytes(self.alloc, ab.as_slice().sub(off, off +% esz) catch { break; });
            let lb = try self.st.vals.from_bytes(self.alloc, bb.as_slice().sub(off, off +% esz) catch { break; });
            let lc = try self.st.vals.from_bytes(self.alloc, cb.as_slice().sub(off, off +% esz) catch { break; });
            let prod = try self.eval_binary(mul_op, la, lb, elem, elem);
            let sum = try self.eval_binary(add_op, prod, lc, elem, elem);
            try self.st.vals.to_dyn_bytes(self.alloc, sum, esz, &mut eb);
            copy_bytes_slice(out.as_mut_slice(), off, eb.as_slice(), 0_usize, esz);
            i = i +% 1_usize;
        }
        let res = try self.st.vals.from_bytes(self.alloc, out.as_slice());
        eb.destroy(self.alloc);
        out.destroy(self.alloc);
        cb.destroy(self.alloc);
        bb.destroy(self.alloc);
        ab.destroy(self.alloc);
        return res;
    }

    fn exec_vec_reduce(
        self: *mut Self,
        vec_ty: types.TyId,
        mode: u8,
        args_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let vn = self.env.get(vec_ty);
        if vn.kind != .Vec {
            try self.fail("EIR-Interp: VecReduce on non-vec");
            return val_void();
        }
        let elem = vn.primary;
        let lanes = vn.u8_val.widen.[usize]();
        let esz = max_usize(self.env.x64_layout(elem).size, 1_usize);
        let total = esz *% lanes;
        var ab = try col.DynBuf.[u8].init(self.alloc, max_usize(total, esz));
        errdefer ab.destroy(self.alloc);
        let a0 = self.eir_val_at(args_r, 0_usize);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), total, &mut ab);
        if lanes == 0_usize {
            ab.destroy(self.alloc);
            return val_void();
        }
        var acc = try self.st.vals.from_bytes(self.alloc, ab.as_slice().sub(0_usize, esz) catch {
            ab.destroy(self.alloc);
            return val_void();
        });
        let add_op: ast.BinaryOp = if self.env.is_float(elem) { .Add } else { .AddWrap };
        let cmp_op: ast.BinaryOp = if mode == 1_u8 { .Lt } else { .Gt };
        var i: usize = 1_usize;
        while i < lanes {
            let off = i *% esz;
            let lane = try self.st.vals.from_bytes(self.alloc, ab.as_slice().sub(off, off +% esz) catch { break; });
            if mode == 0_u8 {
                acc = try self.eval_binary(add_op, acc, lane, elem, elem);
            } else {
                let cv = try self.eval_binary(cmp_op, lane, acc, elem, types.TY_BOOL);
                if self.st.vals.as_u64(cv) != 0_u64 {
                    acc = lane;
                }
            }
            i = i +% 1_usize;
        }
        ab.destroy(self.alloc);
        return acc;
    }

    fn exec_vec_dot(
        self: *mut Self,
        vec_ty: types.TyId,
        args_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let vn = self.env.get(vec_ty);
        if vn.kind != .Vec {
            try self.fail("EIR-Interp: VecDot on non-vec");
            return val_void();
        }
        let elem = vn.primary;
        let lanes = vn.u8_val.widen.[usize]();
        let esz = max_usize(self.env.x64_layout(elem).size, 1_usize);
        let total = esz *% lanes;
        var ab = try col.DynBuf.[u8].init(self.alloc, max_usize(total, esz));
        errdefer ab.destroy(self.alloc);
        var bb = try col.DynBuf.[u8].init(self.alloc, max_usize(total, esz));
        errdefer bb.destroy(self.alloc);
        let v0 = self.eir_val_at(args_r, 0_usize);
        let v1 = self.eir_val_at(args_r, 1_usize);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(v0), total, &mut ab);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(v1), total, &mut bb);
        if lanes == 0_usize {
            bb.destroy(self.alloc);
            ab.destroy(self.alloc);
            return val_void();
        }
        let is_flt = self.env.is_float(elem);
        let mul_op: ast.BinaryOp = if is_flt { .Mul } else { .MulWrap };
        let add_op: ast.BinaryOp = if is_flt { .Add } else { .AddWrap };
        let a0 = try self.st.vals.from_bytes(self.alloc, ab.as_slice().sub(0_usize, esz) catch {
            bb.destroy(self.alloc);
            ab.destroy(self.alloc);
            return val_void();
        });
        let b0 = try self.st.vals.from_bytes(self.alloc, bb.as_slice().sub(0_usize, esz) catch {
            bb.destroy(self.alloc);
            ab.destroy(self.alloc);
            return val_void();
        });
        var acc = try self.eval_binary(mul_op, a0, b0, elem, elem);
        var i: usize = 1_usize;
        while i < lanes {
            let off = i *% esz;
            let la = try self.st.vals.from_bytes(self.alloc, ab.as_slice().sub(off, off +% esz) catch { break; });
            let lb = try self.st.vals.from_bytes(self.alloc, bb.as_slice().sub(off, off +% esz) catch { break; });
            let prod = try self.eval_binary(mul_op, la, lb, elem, elem);
            acc = try self.eval_binary(add_op, acc, prod, elem, elem);
            i = i +% 1_usize;
        }
        bb.destroy(self.alloc);
        ab.destroy(self.alloc);
        return acc;
    }

    fn exec_vec_shuffle(
        self: *mut Self,
        src_ty: types.TyId,
        idx_ty: types.TyId,
        two_src: bool,
        args_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let sn = self.env.get(src_ty);
        let in_n = self.env.get(idx_ty);
        if sn.kind != .Vec || in_n.kind != .Vec {
            try self.fail("EIR-Interp: VecShuffle on non-vec");
            return val_void();
        }
        let elem = sn.primary;
        let src_len = sn.u8_val.widen.[usize]();
        let ielem = in_n.primary;
        let dst_len = in_n.u8_val.widen.[usize]();
        let esz = max_usize(self.env.x64_layout(elem).size, 1_usize);
        let isz = max_usize(self.env.x64_layout(ielem).size, 1_usize);
        let sbytes = esz *% src_len;
        let ibytes = isz *% dst_len;
        var v0 = try col.DynBuf.[u8].init(self.alloc, max_usize(sbytes, 8_usize));
        errdefer v0.destroy(self.alloc);
        var v1 = try col.DynBuf.[u8].init(self.alloc, max_usize(sbytes, 8_usize));
        errdefer v1.destroy(self.alloc);
        var ib = try col.DynBuf.[u8].init(self.alloc, max_usize(ibytes, 8_usize));
        errdefer ib.destroy(self.alloc);
        let a0 = self.eir_val_at(args_r, 0_usize);
        let a1 = self.eir_val_at(args_r, 1_usize);
        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a0), sbytes, &mut v0);
        if two_src {
            let a2 = self.eir_val_at(args_r, 2_usize);
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a1), sbytes, &mut v1);
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a2), ibytes, &mut ib);
        } else {
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(a1), ibytes, &mut ib);
        }
        let total = if two_src { src_len *% 2_usize } else { src_len };
        let out_sz = esz *% dst_len;
        var out = try col.DynBuf.[u8].init(self.alloc, max_usize(out_sz, 8_usize));
        errdefer out.destroy(self.alloc);
        try push_zero_bytes(self.alloc, &mut out, out_sz);
        if total > 0_usize {
            var i: usize = 0_usize;
            while i < dst_len {
                let raw_k = read_le_u64_at(ib.as_slice(), i *% isz).trunc.[usize]();
                let k = raw_k % total;
                if k < src_len {
                    copy_bytes_slice(out.as_mut_slice(), i *% esz, v0.as_slice(), k *% esz, esz);
                } else {
                    let k2 = k -% src_len;
                    copy_bytes_slice(out.as_mut_slice(), i *% esz, v1.as_slice(), k2 *% esz, esz);
                }
                i = i +% 1_usize;
            }
        }
        let res = try self.st.vals.from_bytes(self.alloc, out.as_slice());
        out.destroy(self.alloc);
        ib.destroy(self.alloc);
        v1.destroy(self.alloc);
        v0.destroy(self.alloc);
        return res;
    }

    fn exec_par_reduce(
        self: *mut Self,
        elem_ty: types.TyId,
        op_sym: u32,
        args_r: ast.IdRange,
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let a0 = self.eir_val_at(args_r, 0_usize);
        let pr = self.st.vals.as_pair(frame.get_val(a0));
        var acc = if args_r.len >= 3_u32 {
            frame.get_val(self.eir_val_at(args_r, 2_usize))
        } else {
            val_scalar(0_u64)
        };
        let esz = max_usize(self.env.x64_layout(elem_ty).size, 1_usize);
        let op_code = classify_reduce_op(self.interner.get(op_sym));
        let en = self.env.get(elem_ty);
        let is_flt = en.kind == .Float;
        let fbits = if is_flt { en.u8_val } else { 0_u8 };
        let len = pr.b.trunc.[usize]();
        var i: usize = 0_usize;
        while i < len {
            let ep = try self.mem_ptr_add(pr.a, i *% esz);
            let elem = try self.mem_read_val(ep, esz);
            if self.st.faulted {
                return val_void();
            }
            if op_code == 1_u8 {
                var is_lt = false;
                if is_flt {
                    let eu = self.st.vals.as_u64(elem);
                    let au = self.st.vals.as_u64(acc);
                    if fbits == 16_u8 {
                        is_lt = f32_total_key(f16_bits_to_f32_bits(eu.trunc.[u16]()))
                            < f32_total_key(f16_bits_to_f32_bits(au.trunc.[u16]()));
                    } else if fbits == 32_u8 {
                        is_lt = f32_total_key(eu.trunc.[u32]()) < f32_total_key(au.trunc.[u32]());
                    } else {
                        is_lt = f64_total_key(eu) < f64_total_key(au);
                    }
                } else {
                    let cv = try self.eval_binary(.Lt, elem, acc, elem_ty, types.TY_BOOL);
                    is_lt = self.st.vals.as_u64(cv) != 0_u64;
                }
                if is_lt { acc = elem; }
            } else if op_code == 2_u8 {
                var is_gt = false;
                if is_flt {
                    let eu = self.st.vals.as_u64(elem);
                    let au = self.st.vals.as_u64(acc);
                    if fbits == 16_u8 {
                        is_gt = f32_total_key(f16_bits_to_f32_bits(eu.trunc.[u16]()))
                            > f32_total_key(f16_bits_to_f32_bits(au.trunc.[u16]()));
                    } else if fbits == 32_u8 {
                        is_gt = f32_total_key(eu.trunc.[u32]()) > f32_total_key(au.trunc.[u32]());
                    } else {
                        is_gt = f64_total_key(eu) > f64_total_key(au);
                    }
                } else {
                    let cv = try self.eval_binary(.Gt, elem, acc, elem_ty, types.TY_BOOL);
                    is_gt = self.st.vals.as_u64(cv) != 0_u64;
                }
                if is_gt { acc = elem; }
            } else if op_code == 3_u8 {
                let bin: ast.BinaryOp = if is_flt { .Mul } else { .MulWrap };
                acc = try self.eval_binary(bin, acc, elem, elem_ty, elem_ty);
            } else if op_code == 4_u8 {
                acc = try self.eval_binary(.BitAnd, acc, elem, elem_ty, elem_ty);
            } else if op_code == 5_u8 {
                acc = try self.eval_binary(.BitOr, acc, elem, elem_ty, elem_ty);
            } else if op_code == 6_u8 {
                acc = try self.eval_binary(.BitXor, acc, elem, elem_ty, elem_ty);
            } else {
                let bin: ast.BinaryOp = if is_flt { .Add } else { .AddWrap };
                acc = try self.eval_binary(bin, acc, elem, elem_ty, elem_ty);
            }
            if self.st.faulted {
                return val_void();
            }
            i = i +% 1_usize;
        }
        return acc;
    }

    @recursive
    fn exec_schedule_run(
        self: *mut Self,
        fn_id: u32,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        frame: *FrameState,
    ) -> !OutOfMemory {
        let a0 = self.eir_val_at(args_r, 0_usize);
        let sched_idx = self.st.vals.as_u64(frame.get_val(a0)).trunc.[u32]();
        if sched_idx >= self.eir.schedule_count() {
            try self.fail_with_u64("EIR-Interp: invalid schedule index ", sched_idx.widen.[u64]());
            return;
        }
        let alen = args_r.len.widen.[usize]();
        let run_count = if alen > 1_usize { alen -% 1_usize } else { 0_usize };
        let nwaves = self.eir.schedule_waves(sched_idx).len;
        var wi: usize = 0_usize;
        while wi < nwaves {
            let wsl = self.eir.schedule_waves(sched_idx);
            if wi >= wsl.len {
                break;
            }
            let sys_r = wsl[wi].systems;
            let nsyss = sys_r.len.widen.[usize]();
            var si: usize = 0_usize;
            while si < nsyss {
                let ssl = self.eir.wave_systems(sys_r);
                if si >= ssl.len {
                    break;
                }
                let sys_def = ssl[si];
                let sys_fn_id = self.eir.find_fn_by_key(cfg_ir.fn_key_top_def(sys_def)) orelse {
                    try self.fail("EIR-Interp: unresolved scheduled system");
                    return;
                };
                try self.exec_scheduled_system(fn_id, sys_fn_id, args_r, slots_r, run_count, frame);
                if self.st.faulted {
                    return;
                }
                si = si +% 1_usize;
            }
            wi = wi +% 1_usize;
        }
        return;
    }

    @recursive
    fn exec_scheduled_system(
        self: *mut Self,
        caller_fn_id: u32,
        sys_fn_id: u32,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        run_count: usize,
        frame: *FrameState,
    ) -> !OutOfMemory {
        let n_params = self.eir.fn_params(sys_fn_id).len;
        var used = try col.BitSet.init(self.alloc, max_usize(run_count, 1_usize));
        errdefer used.destroy(self.alloc);
        var sys_args = try col.DynBuf.[ValSlot].init(self.alloc, max_usize(n_params, 4_usize));
        errdefer sys_args.destroy(self.alloc);
        var temp_allocs = try col.DynBuf.[u64].init(self.alloc, 4_usize);
        errdefer temp_allocs.destroy(self.alloc);

        var p_idx: usize = 0_usize;
        while p_idx < n_params {
            let fps = self.eir.fn_params(sys_fn_id);
            if p_idx >= fps.len {
                break;
            }
            let sp_v = fps[p_idx];
            let p_ty = self.eir.fn_val_ty(sys_fn_id, sp_v);
            var best_k: usize = 0_usize;
            var best_kind = ARG_MATCH_NONE;
            var k: usize = 0_usize;
            while k < run_count {
                if !used.test(k) {
                    let av = self.eir_val_at(args_r, 1_usize +% k);
                    let av_ty = self.eir.fn_val_ty(caller_fn_id, av);
                    let mk = match_arg_type(self.env, av_ty, p_ty);
                    if mk < best_kind {
                        best_kind = mk;
                        best_k = k;
                    }
                }
                k = k +% 1_usize;
            }
            if best_kind == ARG_MATCH_NONE && is_pool_or_cap_ty(self.env, p_ty) {
                var k2: usize = 0_usize;
                while k2 < run_count {
                    let av = self.eir_val_at(args_r, 1_usize +% k2);
                    let av_ty = self.eir.fn_val_ty(caller_fn_id, av);
                    let mk = match_arg_type(self.env, av_ty, p_ty);
                    if mk < best_kind {
                        best_kind = mk;
                        best_k = k2;
                    }
                    k2 = k2 +% 1_usize;
                }
            }
            if best_kind != ARG_MATCH_NONE {
                used.set(best_k);
                let arg_v = self.eir_val_at(args_r, 1_usize +% best_k);
                if best_kind == ARG_MATCH_EXACT || best_kind == ARG_MATCH_MUT_TO_CONST {
                    try sys_args.push(self.alloc, frame.get_val(arg_v));
                } else if best_kind == ARG_MATCH_DEREF {
                    let ptr = self.st.vals.as_u64(frame.get_val(arg_v));
                    let sz = interp_ty_size(self.env, p_ty);
                    let rv = try self.mem_read_val(ptr, sz);
                    try sys_args.push(self.alloc, rv);
                } else {
                    let pt = try self.resolve_ptr_arg(caller_fn_id, args_r, slots_r, 1_usize +% best_k, frame);
                    if pt.temp != 0_u64 {
                        try temp_allocs.push(self.alloc, pt.temp);
                    }
                    try sys_args.push(self.alloc, val_scalar(pt.ptr));
                }
            } else if p_idx < run_count {
                let av = self.eir_val_at(args_r, 1_usize +% p_idx);
                try sys_args.push(self.alloc, frame.get_val(av));
            } else {
                try self.fail("EIR-Interp: missing argument for scheduled system");
                break;
            }
            if self.st.faulted {
                break;
            }
            p_idx = p_idx +% 1_usize;
        }
        if !self.st.faulted {
            _ = try self.exec_fn(sys_fn_id, sys_args.as_slice());
        }
        let ts = temp_allocs.as_slice();
        var ti: usize = 0_usize;
        while ti < ts.len {
            self.mem_free_quiet(ts[ti]);
            ti = ti +% 1_usize;
        }
        temp_allocs.destroy(self.alloc);
        sys_args.destroy(self.alloc);
        used.destroy(self.alloc);
        return;
    }

    @recursive
    fn exec_builtin(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
        args_r: ast.IdRange,
        slots_r: ast.IdRange,
        ret_ty: types.TyId,
        frame: *mut FrameState,
    ) -> ValSlot ! OutOfMemory {
        match op.kind {
            .ArenaInit => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .ArenaAlloc => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .ArenaReset => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .ArenaDestroy => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .ArenaUsedBytes => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .ArenaCapacity => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .AllocCapLiveAllocs => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .AllocCapUsedBytes => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .AllocCapPeakBytes => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .AllocCapSubBudget => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .ClockNowNs => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .ArgsLen => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .ArgsGet => { return try self.exec_builtin_mem_caps(fn_id, op, args_r, slots_r, ret_ty, frame); }

            .FsOpenDir => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .FsReadFile => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .FsWriteFile => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .FsWriteExecutable => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .FsIsDir => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .FsMkdirAll => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .FsListDir => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .FsSpawnWait => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .DirSubDir => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .DirReadFile => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .DirWriteFile => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .DirClose => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .NetRestrictHost => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .IoNopRoundtrip => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .IoRunFibers => { return try self.exec_builtin_fs_io(fn_id, op, args_r, slots_r, ret_ty, frame); }

            .BuildAddModule => { return try self.exec_builtin_build(fn_id, op, args_r, slots_r, frame); }
            .BuildAddExe => { return try self.exec_builtin_build(fn_id, op, args_r, slots_r, frame); }
            .BuildAddSharedLib => { return try self.exec_builtin_build(fn_id, op, args_r, slots_r, frame); }
            .BuildSetOutDir => { return try self.exec_builtin_build(fn_id, op, args_r, slots_r, frame); }
            .BuildSetSanitize => { return try self.exec_builtin_build(fn_id, op, args_r, slots_r, frame); }
            .BuildSetAuditTcb => { return try self.exec_builtin_build(fn_id, op, args_r, slots_r, frame); }
            .BuildSetOptLevel => { return try self.exec_builtin_build(fn_id, op, args_r, slots_r, frame); }
            .BuildLinkLib => { return try self.exec_builtin_build(fn_id, op, args_r, slots_r, frame); }
            .BuildAllowHal => { return try self.exec_builtin_build(fn_id, op, args_r, slots_r, frame); }
            .BuildOutPath => { return try self.exec_builtin_build(fn_id, op, args_r, slots_r, frame); }

            .ScheduleRun => {
                try self.exec_schedule_run(fn_id, args_r, slots_r, frame);
                return val_void();
            }
            .ScheduleBuild => { return val_scalar(0_u64); }
            .ParReduce => { return try self.exec_par_reduce(op.ty0, op.sym, args_r, frame); }

            .MathSqrt => { return self.exec_builtin_math(op, args_r, frame); }
            .MathFma => { return self.exec_builtin_math(op, args_r, frame); }
            .MathLzcnt => { return self.exec_builtin_math(op, args_r, frame); }
            .MathTzcnt => { return self.exec_builtin_math(op, args_r, frame); }
            .MathPopcnt => { return self.exec_builtin_math(op, args_r, frame); }
            .MathBswap => { return self.exec_builtin_math(op, args_r, frame); }
            _ => { return try self.exec_builtin_hi(fn_id, op, args_r, slots_r, ret_ty, frame); }
        }
    }

    fn exec_builtin_hi(
        self: *mut Self,
        fn_id: u32,
        op: *cfg_ir.CfgBuiltinOp,
