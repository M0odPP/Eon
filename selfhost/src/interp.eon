            .SliceSub => { return try self.exec_builtin_slice_arr(fn_id, op, args_r, slots_r, ret_ty, frame); }
            .ArraySub => { return try self.exec_builtin_slice_arr(fn_id, op, args_r, slots_r, ret_ty, frame); }

            .GpuGlobalId => {
                try self.fail("ICE [eir_interp]: GPU intrinsic cannot execute in CPU interpreter");
                return val_void();
            }
            .GpuLocalId => {
                try self.fail("ICE [eir_interp]: GPU intrinsic cannot execute in CPU interpreter");
                return val_void();
            }
            .GpuWorkgroupId => {
                try self.fail("ICE [eir_interp]: GPU intrinsic cannot execute in CPU interpreter");
                return val_void();
            }
            .GpuWorkgroupBarrier => {
                try self.fail("ICE [eir_interp]: GPU intrinsic cannot execute in CPU interpreter");
                return val_void();
            }

            _ => { return try self.exec_builtin_vec(op, args_r, frame); }
        }
    }
}

// ===========================================================================
// Section 10: Instruction & Frame Execution + Public Entrypoints
// ===========================================================================

fn is_ascii_ws(b: u8) -> bool {
    return b == b' ' || b == b'\t' || b == b'\n' || b == b'\r';
}

view fn trim_ascii_ws(bs: *[u8]) -> *[u8] {
    var s: usize = 0_usize;
    var e = bs.len;
    while s < e && is_ascii_ws(bs[s]) {
        s = s +% 1_usize;
    }
    while e > s && is_ascii_ws(bs[e -% 1_usize]) {
        e = e -% 1_usize;
    }
    return bs.sub(s, e) catch { return bs; };
}

impl Interp {
    @recursive
    fn exec_call_dyn(
        self: *mut Self,
        method_idx: u32,
        call_args: *mut col.DynBuf[ValSlot],
    ) -> ValSlot ! OutOfMemory {
        let cas0 = call_args.as_slice();
        if cas0.len == 0_usize {
            try self.fail("EIR-Interp: dyn call missing receiver");
            return val_void();
        }
        let pr = self.st.vals.as_pair(cas0[0_usize]);
        let cas = call_args.as_mut_slice();
        if cas.len > 0_usize {
            cas[0_usize] = val_scalar(pr.a);
        }
        let vt_id = pr.b.trunc.[usize]();
        let midx = method_idx.widen.[usize]();
        var ok_vt = false;
        var mpos: usize = 0_usize;
        let rsl = self.st.tables.vtable_ranges.as_slice();
        if vt_id > 0_usize && vt_id < rsl.len {
            let r = rsl[vt_id];
            if midx < r.len.widen.[usize]() {
                mpos = r.start.widen.[usize]() +% midx;
                ok_vt = true;
            }
        }
        if !ok_vt {
            try self.fail_with_u64("EIR-Interp: invalid dyn vtable ", pr.b);
            return val_void();
        }
        var found_m = false;
        var mkey = cfg_ir.fn_key_top_def(0_u32);
        let msl = self.st.tables.vtable_methods.as_slice();
        if mpos < msl.len {
            mkey = msl[mpos];
            found_m = true;
        }
        if !found_m {
            try self.fail("EIR-Interp: dyn vtable method out of bounds");
            return val_void();
        }
        return try self.call_key(mkey, call_args.as_slice());
    }

    @recursive
    fn exec_call_fn_ptr(
        self: *mut Self,
        callee_val: eir.EirValue,
        call_args: *[ValSlot],
        frame: *FrameState,
    ) -> ValSlot ! OutOfMemory {
        let pr = self.st.vals.as_pair(frame.get_val(callee_val));
        let h = pr.a.trunc.[usize]();
        var ok_h = false;
        var key = cfg_ir.fn_key_top_def(0_u32);
        let hsl = self.st.tables.handle_to_fn.as_slice();
        if pr.a != 0_u64 && h < hsl.len {
            key = hsl[h];
            ok_h = true;
        }
        if !ok_h {
            try self.fail_with_u64("EIR-Interp: invalid function pointer handle ", pr.a);
            return val_void();
        }
        if key.kind == .Closure {
            var cl_args = try col.DynBuf.[ValSlot].init(self.alloc, call_args.len +% 1_usize);
            errdefer cl_args.destroy(self.alloc);
            try cl_args.push(self.alloc, val_scalar(pr.b));
            try cl_args.push_slice(self.alloc, call_args);
            let res = try self.call_key(key, cl_args.as_slice());
            cl_args.destroy(self.alloc);
            return res;
        }
        return try self.call_key(key, call_args);
    }

    @recursive
    fn exec_inst_call(
        self: *mut Self,
        inst: *eir.EirInst,
        frame: *mut FrameState,
    ) -> !OutOfMemory {
        let cd_ptr = self.eir.get_call(inst.aux0) orelse {
            try self.fail("EIR-Interp: missing call data");
            return;
        };
        let cd = copy cd_ptr.*;
        let alen = cd.args.len.widen.[usize]();
        var call_args = try col.DynBuf.[ValSlot].init(self.alloc, max_usize(alen +% 1_usize, 4_usize));
        errdefer call_args.destroy(self.alloc);
        var i: usize = 0_usize;
        while i < alen {
            let av = self.eir_val_at(cd.args, i);
            try call_args.push(self.alloc, frame.get_val(av));
            i = i +% 1_usize;
        }
        var res = val_void();
        match cd.callee.kind {
            .DirectFn => {
                res = try self.call_key(cfg_ir.fn_key_top_def(cd.callee.a), call_args.as_slice());
            }
            .Method => {
                res = try self.call_key(cfg_ir.fn_key_impl_method(cd.callee.a, cd.callee.b), call_args.as_slice());
            }
            .GenericInst => {
                res = try self.call_key(cfg_ir.fn_key_generic_inst(cd.callee.a), call_args.as_slice());
            }
            .DynCall => {
                res = try self.exec_call_dyn(cd.callee.b, &mut call_args);
            }
            .ExternFn => {
                res = try self.exec_extern_fn(cd.callee.b, call_args.as_slice());
            }
            .FnPtr => {
                res = try self.exec_call_fn_ptr(cd.callee.a, call_args.as_slice(), frame);
            }
        }
        call_args.destroy(self.alloc);
        if !self.st.faulted && inst.dst != eir.EIR_NONE {
            frame.set_val(inst.dst, res);
        }
        return;
    }

    fn exec_inst_unwrap(
        self: *mut Self,
        inst: *eir.EirInst,
        frame: *mut FrameState,
    ) -> !OutOfMemory {
        match inst.kind {
            .UnwrapOptional => {
                if inst.ty0 == types.TY_VOID {
                    frame.set_val(inst.dst, val_void());
                    return;
                }
                let sn = self.env.get(inst.ty1);
                let inner = if sn.kind == .Optional { sn.primary } else { inst.ty0 };
                let sv = frame.get_val(inst.v0);
                if !self.eval_is_non_null(sv, inner) {
                    try self.fail("EIR-Interp: attempted to unwrap null Optional");
                    return;
                }
                if self.env.is_niche_id_opt(inner) {
                    frame.set_val(inst.dst, sv);
                    return;
                }
                let sz = self.env.x64_layout(inst.ty1).size;
                var raw_b = try col.DynBuf.[u8].init(self.alloc, max_usize(sz, 8_usize));
                errdefer raw_b.destroy(self.alloc);
                try self.st.vals.to_dyn_bytes(self.alloc, sv, sz, &mut raw_b);
                let voff = self.env.opt_val_offset(inner);
                let dsz = self.env.x64_layout(inst.ty0).size;
                let sub = raw_b.as_slice().sub(voff, voff +% dsz) catch {
                    raw_b.destroy(self.alloc);
                    frame.set_val(inst.dst, val_void());
                    return;
                };
                frame.set_val(inst.dst, try self.st.vals.from_bytes(self.alloc, sub));
                raw_b.destroy(self.alloc);
            }
            .UnwrapErrorOk => {
                let sz = max_usize(self.env.x64_layout(inst.ty1).size, 4_usize);
                var raw_b = try col.DynBuf.[u8].init(self.alloc, sz);
                errdefer raw_b.destroy(self.alloc);
                try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(inst.v0), sz, &mut raw_b);
                let err_tag = read_le_u32_at(raw_b.as_slice(), 0_usize);
                if err_tag != 0_u32 {
                    try self.fail_with_u64("EIR-Interp: UnwrapErrorOk on ErrorUnion with err=", err_tag.widen.[u64]());
                    raw_b.destroy(self.alloc);
                    return;
                }
                if inst.ty0 == types.TY_VOID {
                    frame.set_val(inst.dst, val_void());
                } else {
                    let ok_off = self.env.eu_ok_offset(inst.ty0);
                    let dsz = self.env.x64_layout(inst.ty0).size;
                    let sub = raw_b.as_slice().sub(ok_off, ok_off +% dsz) catch {
                        raw_b.destroy(self.alloc);
                        frame.set_val(inst.dst, val_void());
                        return;
                    };
                    frame.set_val(inst.dst, try self.st.vals.from_bytes(self.alloc, sub));
                }
                raw_b.destroy(self.alloc);
            }
            .FieldExtract => {
                if inst.ty0 == types.TY_VOID {
                    frame.set_val(inst.dst, val_void());
                    return;
                }
                let sn = self.env.get(inst.ty1);
                let p_off = if sn.kind == .Union { self.env.union_payload_offset(sn.primary) } else { 4_usize };
                let sz = self.env.x64_layout(inst.ty1).size;
                let dsz = self.env.x64_layout(inst.ty0).size;
                var raw_b = try col.DynBuf.[u8].init(self.alloc, max_usize(sz, p_off +% dsz));
                errdefer raw_b.destroy(self.alloc);
                try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(inst.v0), max_usize(sz, p_off +% dsz), &mut raw_b);
                let sub = raw_b.as_slice().sub(p_off, p_off +% dsz) catch {
                    raw_b.destroy(self.alloc);
                    frame.set_val(inst.dst, val_void());
                    return;
                };
                frame.set_val(inst.dst, try self.st.vals.from_bytes(self.alloc, sub));
                raw_b.destroy(self.alloc);
            }
            _ => {}
        }
        return;
    }

    @recursive
    fn exec_inst_hi(
        self: *mut Self,
        fn_id: u32,
        inst: *eir.EirInst,
        frame: *mut FrameState,
    ) -> !OutOfMemory {
        match inst.kind {
            .UnwrapOptional => { try self.exec_inst_unwrap(inst, frame); }
            .UnwrapErrorOk => { try self.exec_inst_unwrap(inst, frame); }
            .FieldExtract => { try self.exec_inst_unwrap(inst, frame); }
            .UnwrapErrorErr => {
                var raw_b: [4]u8 = [0_u8; 4];
                self.st.vals.write_bytes_to(frame.get_val(inst.v0), &mut raw_b);
                frame.set_val(inst.dst, val_scalar(read_le_u32_at(&raw_b, 0_usize).widen.[u64]()));
            }
            .IsNonNull => {
                let sn = self.env.get(inst.ty1);
                let inner = if sn.kind == .Optional { sn.primary } else { inst.ty1 };
                let ok = self.eval_is_non_null(frame.get_val(inst.v0), inner);
                frame.set_val(inst.dst, val_scalar(if ok { 1_u64 } else { 0_u64 }));
            }
            .IsError => {
                var raw_b: [4]u8 = [0_u8; 4];
                self.st.vals.write_bytes_to(frame.get_val(inst.v0), &mut raw_b);
                let tag = read_le_u32_at(&raw_b, 0_usize);
                frame.set_val(inst.dst, val_scalar(if tag != 0_u32 { 1_u64 } else { 0_u64 }));
            }
            .MatchTag => {
                let sk = self.env.get(inst.ty1).kind;
                if sk == .ErrorUnion || sk == .Union {
                    var raw_b: [4]u8 = [0_u8; 4];
                    self.st.vals.write_bytes_to(frame.get_val(inst.v0), &mut raw_b);
                    frame.set_val(inst.dst, val_scalar(read_le_u32_at(&raw_b, 0_usize).widen.[u64]()));
                } else {
                    let u = self.st.vals.as_u64(frame.get_val(inst.v0)) & 0xFFFFFFFF_u64;
                    frame.set_val(inst.dst, val_scalar(u));
                }
            }
            .MakeDyn => {
                let data_ptr = self.st.vals.as_u64(frame.get_val(inst.v0));
                let vt_id = self.st.tables.vtables.get(pack_u64_u32(inst.aux0, inst.ty1)) orelse {
                    try self.fail("EIR-Interp: missing vtable for dyn conversion");
                    return;
                };
                frame.set_val(inst.dst, try self.st.vals.from_pair(self.alloc, data_ptr, vt_id));
            }
            .MakeClosure => {
                let h = try self.intern_fn_handle(cfg_ir.fn_key_closure(inst.aux0));
                let ep = if inst.v0 != eir.EIR_NONE {
                    self.st.vals.as_u64(frame.get_val(inst.v0))
                } else {
                    0_u64
                };
                frame.set_val(inst.dst, try self.st.vals.from_pair(self.alloc, h, ep));
            }
            .InlineAsm => {
                if let ad = self.eir.get_asm(inst.aux0) {
                    let tpl_r = ad.template;
                    var tbuf = try col.DynBuf.[u8].init(self.alloc, max_usize(tpl_r.len.widen.[usize](), 8_usize));
                    errdefer tbuf.destroy(self.alloc);
                    try tbuf.push_slice(self.alloc, trim_ascii_ws(self.eir.bytes_slice(tpl_r)));
                    if !str.bytes_eq(tbuf.as_slice(), "pause".as_bytes()) {
                        try self.fail_with_bytes(
                            "EIR-Interp: inline asm `",
                            tbuf.as_slice(),
                            "` cannot be executed in portable interpreter",
                        );
                    }
                    tbuf.destroy(self.alloc);
                }
            }
            .Call => {
                try self.exec_inst_call(inst, frame);
            }
            .BuiltinCall => {
                if let bc_ptr = self.eir.get_builtin_call(inst.aux0) {
                    let bc = copy bc_ptr.*;
                    let r = try self.exec_builtin(fn_id, &bc.op, bc.args, bc.arg_slots, bc.ret_ty, frame);
                    if !self.st.faulted && inst.dst != eir.EIR_NONE {
                        frame.set_val(inst.dst, r);
                    }
                }
            }
            .GetVar => {
                try self.fail("ICE [eir_interp]: unlowered GetVar/SetVar reached interpreter");
            }
            .SetVar => {
                try self.fail("ICE [eir_interp]: unlowered GetVar/SetVar reached interpreter");
            }
            .ParForHint => {}
            .VecLoad => {
                let vn = self.env.get(inst.ty0);
                let lanes = if vn.kind == .Vec { vn.u8_val.widen.[usize]() } else { 1_usize };
                let esz = max_usize(interp_ty_size(self.env, inst.ty1), 1_usize);
                let total = lanes *% esz;
                let base_v = frame.get_val(inst.v0);
                let idx_v = self.st.vals.as_u64(frame.get_val(inst.v1));
                var base_ptr: u64 = 0_u64;
                if inst.flag0 {
                    base_ptr = self.st.vals.as_u64(base_v);
                } else {
                    let pr = self.st.vals.as_pair(base_v);
                    base_ptr = pr.a;
                    if idx_v +% lanes.widen.[u64]() > pr.b {
                        try self.fail("EIR-Interp: VecLoad out of bounds");
                        return;
                    }
                }
                let addr = try self.mem_ptr_add(base_ptr, idx_v.trunc.[usize]() *% esz);
                if !self.st.faulted {
                    let v = try self.mem_read_val(addr, total);
                    frame.set_val(inst.dst, v);
                }
            }
            .VecStore => {
                let vn = self.env.get(inst.ty0);
                let lanes = if vn.kind == .Vec { vn.u8_val.widen.[usize]() } else { 1_usize };
                let esz = max_usize(interp_ty_size(self.env, inst.ty1), 1_usize);
                let total = lanes *% esz;
                let base_v = frame.get_val(inst.v0);
                let idx_v = self.st.vals.as_u64(frame.get_val(inst.v1));
                var base_ptr: u64 = 0_u64;
                if inst.flag0 {
                    base_ptr = self.st.vals.as_u64(base_v);
                } else {
                    let pr = self.st.vals.as_pair(base_v);
                    base_ptr = pr.a;
                    if idx_v +% lanes.widen.[u64]() > pr.b {
                        try self.fail("EIR-Interp: VecStore out of bounds");
                        return;
                    }
                }
                let addr = try self.mem_ptr_add(base_ptr, idx_v.trunc.[usize]() *% esz);
                if !self.st.faulted {
                    var tmp = try col.DynBuf.[u8].init(self.alloc, max_usize(total, 16_usize));
                    errdefer tmp.destroy(self.alloc);
                    try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(inst.v2), total, &mut tmp);
                    _ = try self.mem_write(addr, tmp.as_slice());
                    tmp.destroy(self.alloc);
                }
            }
            .VecFma => {
                let vn = self.env.get(inst.ty0);
                if vn.kind != .Vec {
                    try self.fail("EIR-Interp: VecFma inst on non-vec");
                    return;
                }
                let elem = vn.primary;
                let lanes = vn.u8_val.widen.[usize]();
                let esz = max_usize(self.env.x64_layout(elem).size, 1_usize);
                let total = esz *% lanes;
                var ab = try col.DynBuf.[u8].init(self.alloc, total);
                errdefer ab.destroy(self.alloc);
                var bb = try col.DynBuf.[u8].init(self.alloc, total);
                errdefer bb.destroy(self.alloc);
                var cb = try col.DynBuf.[u8].init(self.alloc, total);
                errdefer cb.destroy(self.alloc);
                try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(inst.v0), total, &mut ab);
                try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(inst.v1), total, &mut bb);
                try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(inst.v2), total, &mut cb);
                let is_flt = self.env.is_float(elem);
                let mul_op: ast.BinaryOp = if is_flt { .Mul } else { .MulWrap };
                let add_op: ast.BinaryOp = if is_flt { .Add } else { .AddWrap };
                var out = try col.DynBuf.[u8].init(self.alloc, total);
                errdefer out.destroy(self.alloc);
                try push_zero_bytes(self.alloc, &mut out, total);
                var eb = try col.DynBuf.[u8].init(self.alloc, esz);
                errdefer eb.destroy(self.alloc);
                var li: usize = 0_usize;
                while li < lanes {
                    let off = li *% esz;
                    let la = try self.st.vals.from_bytes(self.alloc, ab.as_slice().sub(off, off +% esz) catch { break; });
                    let lb = try self.st.vals.from_bytes(self.alloc, bb.as_slice().sub(off, off +% esz) catch { break; });
                    let lc = try self.st.vals.from_bytes(self.alloc, cb.as_slice().sub(off, off +% esz) catch { break; });
                    let prod = try self.eval_binary(mul_op, la, lb, elem, elem);
                    let sum = try self.eval_binary(add_op, prod, lc, elem, elem);
                    try self.st.vals.to_dyn_bytes(self.alloc, sum, esz, &mut eb);
                    copy_bytes_slice(out.as_mut_slice(), off, eb.as_slice(), 0_usize, esz);
                    li = li +% 1_usize;
                }
                let res = try self.st.vals.from_bytes(self.alloc, out.as_slice());
                eb.destroy(self.alloc);
                out.destroy(self.alloc);
                cb.destroy(self.alloc);
                bb.destroy(self.alloc);
                ab.destroy(self.alloc);
                if !self.st.faulted && inst.dst != eir.EIR_NONE {
                    frame.set_val(inst.dst, res);
                }
            }
            _ => {}
        }
        return;
    }

    fn exec_inst_slice(
        self: *mut Self,
        inst: *eir.EirInst,
        frame: *mut FrameState,
    ) -> !OutOfMemory {
        let dn = self.env.get(inst.ty0);
        let elem_sz = if dn.kind == .Borrow && dn.borrow_kind == .Slice {
            max_usize(self.env.x64_layout(dn.primary).size, 1_usize)
        } else {
            1_usize
        };
        let bn = self.env.get(inst.ty1);
        var base_ptr: u64 = 0_u64;
        var base_len: u64 = 0_u64;
        if (bn.kind == .Borrow && (bn.borrow_kind == .Slice || bn.borrow_kind == .Str)) || bn.kind == .Str {
            let pr = self.st.vals.as_pair(frame.get_val(inst.v0));
            base_ptr = pr.a;
            base_len = pr.b;
        } else if bn.kind == .Borrow && bn.borrow_kind == .Single {
            let ptr = self.st.vals.as_u64(frame.get_val(inst.v0));
            let an = self.env.get(bn.primary);
            if an.kind == .Array {
                base_ptr = ptr;
                base_len = an.u64_val;
            } else {
                base_ptr = try self.mem_read_u64(ptr);
                base_len = try self.mem_read_u64_off(ptr, 8_usize);
            }
        } else if bn.kind == .Array {
            let sz = max_usize(self.env.x64_layout(inst.ty1).size, 1_usize);
            var tmp = try col.DynBuf.[u8].init(self.alloc, sz);
            errdefer tmp.destroy(self.alloc);
            try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(inst.v0), sz, &mut tmp);
            let p = try self.mem_alloc_bytes(tmp.as_slice(), false);
            if p != 0_u64 {
                try frame.rvalue_temps.push(self.alloc, p);
            }
            tmp.destroy(self.alloc);
            base_ptr = p;
            base_len = bn.u64_val;
        } else {
            let pr = self.st.vals.as_pair(frame.get_val(inst.v0));
            base_ptr = pr.a;
            base_len = pr.b;
        }
        if self.st.faulted {
            return;
        }
        let lo_v = if inst.v1 != eir.EIR_NONE { self.st.vals.as_u64(frame.get_val(inst.v1)) } else { 0_u64 };
        let hi_v = if inst.v2 != eir.EIR_NONE { self.st.vals.as_u64(frame.get_val(inst.v2)) } else { base_len };
        if lo_v > hi_v || hi_v > base_len {
            try self.fail("EIR-Interp: proven slice bounds violated");
            return;
        }
        let new_ptr = if lo_v == 0_u64 {
            base_ptr
        } else {
            try self.mem_ptr_add(base_ptr, lo_v.trunc.[usize]() *% elem_sz)
        };
        frame.set_val(inst.dst, try self.st.vals.from_pair(self.alloc, new_ptr, hi_v -% lo_v));
        return;
    }

    fn exec_inst_mem(
        self: *mut Self,
        fn_id: u32,
        inst: *eir.EirInst,
        frame: *mut FrameState,
    ) -> !OutOfMemory {
        match inst.kind {
            .LoadPlace => {
                if let p_ptr = self.eir.get_place(inst.aux0) {
                    let p = copy p_ptr.*;
                    let pt = try self.eval_place_addr(fn_id, &p, frame);
                    if self.st.faulted {
                        return;
                    }
                    if pt.kind == PT_SLICE_VAL {
                        frame.set_val(inst.dst, pt.slice_val);
                    } else if pt.kind == PT_BITFIELD {
                        let bsz = clamp_usize(self.env.x64_layout(pt.base_ty).size, 1_usize, 8_usize);
                        let raw_v = try self.mem_read_val(pt.addr, bsz);
                        let raw_b = self.st.vals.as_u64(raw_v);
                        let width: u8 = if pt.hi_bit > pt.lo_bit { pt.hi_bit -% pt.lo_bit } else { 1_u8 };
                        let extracted = (raw_b >> (pt.lo_bit.widen.[u64]() & 63_u64)) & mask_bits(width);
                        let final_v = if self.env.is_signed_int(pt.field_ty) {
                            sign_extend_i128(extracted, width, true).lo
                        } else {
                            extracted
                        };
                        frame.set_val(inst.dst, val_scalar(final_v));
                        self.mem_free_quiet(pt.temp_alloc);
                    } else {
                        let ty = self.eir.fn_val_ty(fn_id, inst.dst);
                        let sz = interp_ty_size(self.env, ty);
                        let v = try self.mem_read_val(pt.addr, sz);
                        frame.set_val(inst.dst, v);
                        self.mem_free_quiet(pt.temp_alloc);
                    }
                }
            }
            .StorePlace => {
                if let p_ptr = self.eir.get_place(inst.aux0) {
                    let p = copy p_ptr.*;
                    let pty = p.ty;
                    let pt = try self.eval_place_addr(fn_id, &p, frame);
                    if self.st.faulted {
                        return;
                    }
                    if pt.kind == PT_SLICE_VAL {
                        try self.fail("EIR-Interp: cannot store directly into bare pool column slice");
                    } else if pt.kind == PT_BITFIELD {
                        let bsz = clamp_usize(self.env.x64_layout(pt.base_ty).size, 1_usize, 8_usize);
                        let old_v = try self.mem_read_val(pt.addr, bsz);
                        let old = self.st.vals.as_u64(old_v);
                        let width: u8 = if pt.hi_bit > pt.lo_bit { pt.hi_bit -% pt.lo_bit } else { 1_u8 };
                        let m = mask_bits(width);
                        let sh = pt.lo_bit.widen.[u64]() & 63_u64;
                        let ins = self.st.vals.as_u64(frame.get_val(inst.v0)) & m;
                        let updated = (old & (~(m <<% sh))) | (ins <<% sh);
                        var wb: [8]u8 = [0_u8; 8];
                        write_le_u64_at(&mut wb, 0_usize, updated, bsz);
                        let wref: *[u8] = &wb;
                        let wslice = wref.sub(0_usize, bsz) catch { wref };
                        _ = try self.mem_write(pt.addr, wslice);
                        self.mem_free_quiet(pt.temp_alloc);
                    } else {
                        let sz = interp_ty_size(self.env, pty);
                        var tmp = try col.DynBuf.[u8].init(self.alloc, max_usize(sz, 8_usize));
                        errdefer tmp.destroy(self.alloc);
                        try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(inst.v0), sz, &mut tmp);
                        _ = try self.mem_write(pt.addr, tmp.as_slice());
                        tmp.destroy(self.alloc);
                        self.mem_free_quiet(pt.temp_alloc);
                    }
                }
            }
            .PlaceAddr => {
                if let p_ptr = self.eir.get_place(inst.aux0) {
                    let p = copy p_ptr.*;
                    let pt = try self.eval_place_addr(fn_id, &p, frame);
                    if self.st.faulted {
                        return;
                    }
                    if pt.kind == PT_ADDR {
                        if pt.temp_alloc != 0_u64 {
                            try frame.rvalue_temps.push(self.alloc, pt.temp_alloc);
                        }
                        frame.set_val(inst.dst, val_scalar(pt.addr));
                    } else {
                        self.mem_free_quiet(pt.temp_alloc);
                        try self.fail("EIR-Interp: cannot take address of non-addressable place");
                    }
                }
            }
            .PoolColumnLoad => {
                if let op_ptr = self.eir.get_pool_col_op(inst.aux0) {
                    let op = copy op_ptr.*;
                    let pt = try self.eval_pool_base_ptr(op.pool_base, op.pool_is_ptr, frame);
                    let col_ptr = try self.mem_read_u64_off(pt.ptr, op.col_idx.widen.[usize]() *% 8_usize);
                    let raw_idx = self.st.vals.as_u64(frame.get_val(op.index));
                    let idx = if op.is_slot_pool { (raw_idx & 0xFFFFFFFF_u64).trunc.[usize]() } else { raw_idx.trunc.[usize]() };
                    let esz = max_usize(self.env.x64_layout_impl(op.elem_ty, op.is_slot_pool).size, 1_usize);
                    let dty = self.eir.fn_val_ty(fn_id, inst.dst);
                    let dsz = self.env.x64_layout_impl(dty, op.is_slot_pool).size;
                    let ep = try self.mem_ptr_add(col_ptr, idx *% esz);
                    let v = try self.mem_read_val(ep, dsz);
                    frame.set_val(inst.dst, v);
                    self.mem_free_quiet(pt.temp);
                }
            }
            .PoolColumnStore => {
                if let op_ptr = self.eir.get_pool_col_op(inst.aux0) {
                    let op = copy op_ptr.*;
                    let pt = try self.eval_pool_base_ptr(op.pool_base, op.pool_is_ptr, frame);
                    let col_ptr = try self.mem_read_u64_off(pt.ptr, op.col_idx.widen.[usize]() *% 8_usize);
                    let raw_idx = self.st.vals.as_u64(frame.get_val(op.index));
                    let idx = if op.is_slot_pool { (raw_idx & 0xFFFFFFFF_u64).trunc.[usize]() } else { raw_idx.trunc.[usize]() };
                    let esz = max_usize(self.env.x64_layout_impl(op.elem_ty, op.is_slot_pool).size, 1_usize);
                    var tmp = try col.DynBuf.[u8].init(self.alloc, esz);
                    errdefer tmp.destroy(self.alloc);
                    try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(inst.v0), esz, &mut tmp);
                    let ep = try self.mem_ptr_add(col_ptr, idx *% esz);
                    _ = try self.mem_write(ep, tmp.as_slice());
                    tmp.destroy(self.alloc);
                    self.mem_free_quiet(pt.temp);
                }
            }
            _ => {}
        }
        return;
    }

    @recursive
    fn exec_inst(
        self: *mut Self,
        fn_id: u32,
        inst: *eir.EirInst,
        frame: *mut FrameState,
    ) -> !OutOfMemory {
        match inst.kind {
            .Const => {
                if let c_ptr = self.eir.get_const(inst.aux0) {
                    let c = copy c_ptr.*;
                    let v = try self.eval_const(inst.ty0, &c);
                    frame.set_val(inst.dst, v);
                }
            }
            .Copy => {
                frame.set_val(inst.dst, frame.get_val(inst.v0));
            }
            .LoadSlot => {
                let ty = self.eir.fn_val_ty(fn_id, inst.dst);
                let sz = interp_ty_size(self.env, ty);
                let v = try self.mem_read_val(frame.get_slot_ptr(inst.aux0), sz);
                frame.set_val(inst.dst, v);
            }
            .StoreSlot => {
                if let s = self.eir.fn_slot(fn_id, inst.aux0) {
                    let sz = interp_ty_size(self.env, s.ty);
                    var tmp = try col.DynBuf.[u8].init(self.alloc, max_usize(sz, 8_usize));
                    errdefer tmp.destroy(self.alloc);
                    try self.st.vals.to_dyn_bytes(self.alloc, frame.get_val(inst.v0), sz, &mut tmp);
                    _ = try self.mem_write(frame.get_slot_ptr(inst.aux0), tmp.as_slice());
                    tmp.destroy(self.alloc);
                }
            }
            .SlotAddr => {
                frame.set_val(inst.dst, val_scalar(frame.get_slot_ptr(inst.aux0)));
            }
            .LoadPlace => { try self.exec_inst_mem(fn_id, inst, frame); }
            .StorePlace => { try self.exec_inst_mem(fn_id, inst, frame); }
            .PlaceAddr => { try self.exec_inst_mem(fn_id, inst, frame); }
            .PoolColumnLoad => { try self.exec_inst_mem(fn_id, inst, frame); }
            .PoolColumnStore => { try self.exec_inst_mem(fn_id, inst, frame); }
            .Unary => {
                let v = try self.eval_unary(inst.unary_op, frame.get_val(inst.v0), inst.ty0);
                frame.set_val(inst.dst, v);
            }
            .Binary => {
                let v = try self.eval_binary(
                    inst.bin_op,
                    frame.get_val(inst.v0),
                    frame.get_val(inst.v1),
                    inst.ty1,
                    inst.ty0,
                );
                frame.set_val(inst.dst, v);
            }
            .Cast => {
                let v = try self.eval_cast(inst.cast_kind, frame.get_val(inst.v0), inst.ty1, inst.ty0);
                frame.set_val(inst.dst, v);
            }
            .Slice => {
                try self.exec_inst_slice(inst, frame);
            }
            .Aggregate => {
                if let agg_ptr = self.eir.get_aggregate(inst.aux0) {
                    let agg = copy agg_ptr.*;
                    let v = try self.eval_aggregate(&agg, inst.range, inst.ty0, frame);
                    frame.set_val(inst.dst, v);
                }
            }
            _ => {
                try self.exec_inst_hi(fn_id, inst, frame);
            }
        }
        return;
    }

    @recursive
    fn call_key(self: *mut Self, key: cfg_ir.CfgFnKey, args: *[ValSlot]) -> ValSlot ! OutOfMemory {
        let fn_id = self.eir.find_fn_by_key(key) orelse {
            try self.fail("EIR-Interp: unresolved function call");
            return val_void();
        };
        return try self.exec_fn(fn_id, args);
    }

    @recursive
    fn exec_fn(self: *mut Self, fn_id: u32, args: *[ValSlot]) -> ValSlot ! OutOfMemory {
        let f = self.eir.get_fn(fn_id) orelse {
            try self.fail("EIR-Interp: invalid function id");
            return val_void();
        };
        let fname = f.name;
        if self.st.depth >= MAX_CALL_DEPTH {
            try self.fail_with_sym(
                "EIR-Interp: call stack overflow (depth >= 512) entering `",
                fname,
                "`",
            );
            return val_void();
        }
        self.st.depth = self.st.depth +% 1_u32;
        let res = try self.exec_fn_inner(fn_id, args);
        self.st.depth = self.st.depth -% 1_u32;
        return res;
    }

    @recursive
    fn exec_fn_inner(self: *mut Self, fn_id: u32, args: *[ValSlot]) -> ValSlot ! OutOfMemory {
        let f = self.eir.get_fn(fn_id) orelse {
            return val_void();
        };
        let fname_sym = f.name;
        let entry_bb = f.entry;
        let n_vals = f.value_tys.len.widen.[usize]();
        let n_slots = f.slots.len.widen.[usize]();
        let n_params = f.params.len.widen.[usize]();

        let saved_val_cursor = self.st.vals.cursor;
        var frame = try FrameState.init(self.alloc, n_vals, n_slots);
        errdefer frame.destroy(self.alloc);

        var pi: usize = 0_usize;
        while pi < n_params && pi < args.len {
            let psl = self.eir.fn_params(fn_id);
            if pi >= psl.len {
                break;
            }
            let pv = psl[pi];
            frame.set_val(pv, args[pi]);
            pi = pi +% 1_usize;
        }
        var si: usize = 0_usize;
        while si < n_slots {
            let ssl = self.eir.fn_slots(fn_id);
            if si >= ssl.len {
                break;
            }
            let slot_ty = ssl[si].ty;
            let sz = max_usize(interp_ty_size(self.env, slot_ty), 1_usize);
            let p = try self.mem_alloc(sz, false);
            if self.st.faulted {
                break;
            }
            try frame.slot_ptrs.push(self.alloc, p);
            si = si +% 1_usize;
        }

        var ret_val = val_void();
        if !self.st.faulted {
            ret_val = try self.run_fn_blocks(fn_id, fname_sym, entry_bb, &mut frame);
        }

        let sp = frame.slot_ptrs.as_slice();
        var fi: usize = 0_usize;
        while fi < sp.len {
            self.mem_free_quiet(sp[fi]);
            fi = fi +% 1_usize;
        }
        let rt = frame.rvalue_temps.as_slice();
        var ri: usize = 0_usize;
        while ri < rt.len {
            self.mem_free_quiet(rt[ri]);
            ri = ri +% 1_usize;
        }
        frame.destroy(self.alloc);
        return self.st.vals.reset_frame_cursor(saved_val_cursor, ret_val);
    }

    @recursive
    fn run_fn_blocks(
        self: *mut Self,
        fn_id: u32,
        fname_sym: u32,
        entry_bb: cfg_ir.BlockId,
        frame: *mut FrameState,
    ) -> ValSlot ! OutOfMemory {
        var cur_bb = entry_bb;
        var has_prev = false;
        var prev_bb: cfg_ir.BlockId = 0_u32;

        loop {
            let b = self.eir.fn_block(fn_id, cur_bb) orelse {
                try self.fail("EIR-Interp: invalid basic block id");
                return val_void();
            };
            let phis_r = b.phis;
            let insts_r = b.insts;
            let term = b.term;

            if has_prev {
                let n_phis = phis_r.len.widen.[usize]();
                frame.phi_updates.clear();
                var phi_i: usize = 0_usize;
                while phi_i < n_phis {
                    let psl = self.eir.phis_slice(phis_r);
                    if phi_i >= psl.len {
                        break;
                    }
                    let phi_node = psl[phi_i];
                    let incs = self.eir.phi_incoming(phi_node.incoming);
                    var found = false;
                    var src_v: eir.EirValue = 0_u32;
                    var ki: usize = 0_usize;
                    while ki < incs.len {
                        if incs[ki].pred_bb == prev_bb {
                            found = true;
                            src_v = incs[ki].val;
                            break;
                        }
                        ki = ki +% 1_usize;
                    }
                    if !found {
                        try self.fail_with_sym(
                            "EIR-Interp: missing phi incoming edge in `",
                            fname_sym,
                            "`",
                        );
                        return val_void();
                    }
                    let sv = frame.get_val(src_v);
                    try frame.phi_updates.push(
                        self.alloc,
                        PhiUpdate.{ dst: phi_node.dst, val: sv },
                    );
                    phi_i = phi_i +% 1_usize;
                }
                let n_ups = frame.phi_updates.len();
                var ui: usize = 0_usize;
                while ui < n_ups {
                    let usl = frame.phi_updates.as_slice();
                    if ui >= usl.len {
                        break;
                    }
                    let u = usl[ui];
                    frame.set_val(u.dst, u.val);
                    ui = ui +% 1_usize;
                }
            }

            let n_insts = insts_r.len.widen.[usize]();
            var ii: usize = 0_usize;
            while ii < n_insts {
                self.st.steps = self.st.steps +% 1_u64;
                if self.st.steps > self.st.step_limit {
                    try self.fail_with_sym(
                        "EIR-Interp: step limit exceeded in `",
                        fname_sym,
                        "`",
                    );
                    return val_void();
                }
                let isl = self.eir.insts_slice(insts_r);
                if ii >= isl.len {
                    break;
                }
                let inst_copy = isl[ii];
                try self.exec_inst(fn_id, &inst_copy, frame);
                if self.st.faulted {
                    return val_void();
                }
                ii = ii +% 1_usize;
            }

            self.st.steps = self.st.steps +% 1_u64;
            has_prev = true;
            prev_bb = cur_bb;
            match term.kind {
                .Goto => { cur_bb = term.bb0; }
                .Branch => {
                    let c = self.st.vals.as_u64(frame.get_val(term.val)) != 0_u64;
                    cur_bb = if c { term.bb0 } else { term.bb1 };
                }
                .SwitchInt => {
                    let dty = self.eir.fn_val_ty(fn_id, term.val);
                    let signed = self.env.is_signed_int(dty);
                    let bits = self.env.int_bits(dty);
                    let dv = sign_extend_i128(self.st.vals.as_u64(frame.get_val(term.val)), bits, signed);
                    let ts = self.eir.switch_targets_slice(term.targets);
                    cur_bb = term.bb0;
                    var ti: usize = 0_usize;
                    while ti < ts.len {
                        if types.int_val_eq(ts[ti].val, dv) {
                            cur_bb = ts[ti].target;
                            break;
                        }
                        ti = ti +% 1_usize;
                    }
                }
                .Return => {
                    if term.flag {
                        return frame.get_val(term.val);
                    }
                    return val_void();
                }
                .Unreachable => {
                    try self.fail_with_sym(
                        "EIR-Interp: reached `unreachable` in `",
                        fname_sym,
                        "`",
                    );
                    return val_void();
                }
            }
        }
    }
}

fn find_non_gpu_fn_by_name(
    eir: *eir.EirProgram,
    interner: *span.SymInterner,
    target_name: *[u8],
) -> ?u32 {
    let n = eir.fn_count();
    var i: u32 = 0_u32;
    while i < n {
        if let f = eir.get_fn(i) {
            if !f.sig.effects.is_gpu && str.bytes_eq(interner.get(f.name), target_name) {
                return i;
            }
        }
        i = i +% 1_u32;
    }
    return null;
}

fn param_is_single_builtin(env: *types.TypeEnv, ty: types.TyId, bk: resolve.BuiltinKind) -> bool {
    let n = env.get(ty);
    if n.kind == .Borrow && n.borrow_kind == .Single {
        let inn = env.get(n.primary);
        return inn.kind == .Builtin && inn.builtin_kind == bk;
    }
    return false;
}

fn setup_main_args_table(
    interp: *mut Interp,
    alloc: *mut AllocCap,
    prog_args: *[u8],
    argc_out: *mut u64,
) -> u64 ! OutOfMemory {
    argc_out.* = 0_u64;
    if prog_args.len == 0_usize {
        return 0_u64;
    }
    let eff_len = if prog_args[prog_args.len -% 1_usize] == 0_u8 {
        prog_args.len -% 1_usize
    } else {
        prog_args.len
    };
    if eff_len == 0_usize {
        return 0_u64;
    }
    var table = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer table.destroy(alloc);
    var seg_start: usize = 0_usize;
    var i: usize = 0_usize;
    var argc: u64 = 0_u64;
    while i <= eff_len {
        var at_nul = i == eff_len;
        if !at_nul && i < prog_args.len {
            at_nul = prog_args[i] == 0_u8;
        }
        if at_nul {
            let seg = prog_args.sub(seg_start, i) catch {
                break;
            };
            let sptr = try interp.intern_ro_bytes(seg);
            var ent: [16]u8 = [0_u8; 16];
            write_le_u64_at(&mut ent, 0_usize, sptr, 8_usize);
            write_le_u64_at(&mut ent, 8_usize, seg.len.widen.[u64](), 8_usize);
            try table.push_slice(alloc, &ent);
            argc = argc +% 1_u64;
            seg_start = i +% 1_usize;
        }
        i = i +% 1_usize;
    }
    argc_out.* = argc;
    let tptr = if table.is_empty() {
        0_u64
    } else {
        try interp.mem_alloc_bytes(table.as_slice(), true)
    };
    table.destroy(alloc);
    return tptr;
}

/// Execute an `EirProgram` starting at `main` with NUL-delimited `prog_args`.
pub fn interpret_eir(
    alloc: *mut AllocCap,
    host_fs: *FsCap,
    eir: *eir.EirProgram,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *span.SymInterner,
    prog_args: *[u8],
    step_limit: u64,
) -> InterpResult ! OutOfMemory {
    _ = prog;
    var st = try VmState.init(alloc, step_limit);
    errdefer st.destroy(alloc);
    var dummy_plan = try build_sys.BuildPlan.init(alloc, "".as_bytes());
    errdefer dummy_plan.destroy(alloc);

    var interp = Interp.{
        alloc: alloc,
        host_fs: host_fs,
        eir: eir,
        env: env,
        ct: ct,
        interner: interner,
        plan: &mut dummy_plan,
        st: &mut st,
    };
    try interp.init_vtables();

    let mf_id = find_non_gpu_fn_by_name(eir, interner, "main".as_bytes()) orelse {
        try interp.fail("EIR-Interp: no `main` function found");
        dummy_plan.destroy(alloc);
        return st.into_result(alloc, 1_i32);
    };
    let mf = eir.get_fn(mf_id) orelse {
        try interp.fail("EIR-Interp: no `main` function found");
        dummy_plan.destroy(alloc);
        return st.into_result(alloc, 1_i32);
    };
    let mf_ret = mf.sig.ret;
    let sig_params = env.params_range(mf.sig.params);
    var takes_env = false;
    var takes_alloc = false;
    if mf.params.len == 1_u32 && sig_params.len > 0_usize {
        let p0_ty = sig_params[0_usize].ty;
        takes_env = param_is_single_builtin(env, p0_ty, .Env);
        if !takes_env {
            takes_alloc = param_is_single_builtin(env, p0_ty, .AllocCap);
        }
    }

    var ret_val = val_void();
    var main_args = try col.DynBuf.[ValSlot].init(alloc, 2_usize);
    errdefer main_args.destroy(alloc);
    if takes_env {
        let env_ptr = try interp.mem_alloc(88_usize, false);
        var argc: u64 = 0_u64;
        let args_table_ptr = try setup_main_args_table(&mut interp, alloc, prog_args, &mut argc);
        if !interp.st.faulted {
            _ = try interp.mem_write_u64_off(env_ptr, 40_usize, 1_u64);
            _ = try interp.mem_write_u64_off(env_ptr, 48_usize, 0_u64);
            _ = try interp.mem_write_u64_off(env_ptr, 56_usize, 1_u64);
            _ = try interp.mem_write_u64_off(env_ptr, 64_usize, 1_u64);
            _ = try interp.mem_write_u64_off(env_ptr, 72_usize, argc);
            _ = try interp.mem_write_u64_off(env_ptr, 80_usize, args_table_ptr);
        }
        try main_args.push(alloc, val_scalar(env_ptr));
    } else if takes_alloc {
        let p = try interp.mem_alloc(40_usize, false);
        try main_args.push(alloc, val_scalar(p));
    }
    if !interp.st.faulted {
        ret_val = try interp.exec_fn(mf_id, main_args.as_slice());
    }

    var exit_code: i32 = 0_i32;
    if !interp.st.faulted {
        let rn = env.get(mf_ret);
        if rn.kind == .Int {
            exit_code = interp.st.vals.as_u64(ret_val).trunc.[u32]().bitcast.[i32]();
        } else if rn.kind == .ErrorUnion {
            let sz = max_usize(env.x64_layout(mf_ret).size, 4_usize);
            var raw_b = try col.DynBuf.[u8].init(alloc, sz);
            errdefer raw_b.destroy(alloc);
            try interp.st.vals.to_dyn_bytes(alloc, ret_val, sz, &mut raw_b);
            let err_tag = read_le_u32_at(raw_b.as_slice(), 0_usize);
            if err_tag != 0_u32 {
                exit_code = err_tag.bitcast.[i32]();
            } else if rn.primary != types.TY_VOID && rn.primary != types.TY_NEVER {
                let ok_off = env.eu_ok_offset(rn.primary);
                let ok_sz = clamp_usize(env.x64_layout(rn.primary).size, 1_usize, 8_usize);
                let ok_sl = raw_b.as_slice().sub(ok_off, ok_off +% ok_sz) catch {
                    raw_b.as_slice()
                };
                exit_code = read_le_u64_at(ok_sl, 0_usize).trunc.[u32]().bitcast.[i32]();
            }
            raw_b.destroy(alloc);
        }
    }

    main_args.destroy(alloc);
    dummy_plan.destroy(alloc);
    return st.into_result(alloc, exit_code);
}

/// Execute a sandboxed `build.eon` script entry function, populating `plan`.
pub fn interpret_build_script(
    alloc: *mut AllocCap,
    host_fs: *FsCap,
    eir: *eir.EirProgram,
    entry_key: cfg_ir.CfgFnKey,
    prog: *resolve.ResolvedProgram,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *span.SymInterner,
    plan: *mut build_sys.BuildPlan,
    err_out: *mut str.StrBuf,
) -> bool ! OutOfMemory {
    _ = prog;
    var entry_id_opt = eir.find_fn_by_key(entry_key);
    if entry_id_opt == null {
        entry_id_opt = find_non_gpu_fn_by_name(eir, interner, "build".as_bytes());
    }
    if entry_id_opt == null {
        entry_id_opt = find_non_gpu_fn_by_name(eir, interner, "main".as_bytes());
    }
    let entry_id = entry_id_opt orelse {
        return true;
    };
    let entry_fn = eir.get_fn(entry_id) orelse {
        return true;
    };
    let entry_name_sym = entry_fn.name;
    let entry_ret = entry_fn.sig.ret;
    let has_cap_arg = entry_fn.params.len == 1_u32;

    var st = try VmState.init(alloc, DEFAULT_STEP_LIMIT);
    errdefer st.destroy(alloc);

    var interp = Interp.{
        alloc: alloc,
        host_fs: host_fs,
        eir: eir,
        env: env,
        ct: ct,
        interner: interner,
        plan: plan,
        st: &mut st,
    };
    try interp.init_vtables();

    var ret_val = val_void();
    var args = try col.DynBuf.[ValSlot].init(alloc, 2_usize);
    errdefer args.destroy(alloc);
    if has_cap_arg {
        let cap_ptr = try interp.mem_alloc(16_usize, false);
        try args.push(alloc, val_scalar(cap_ptr));
    }
    if !interp.st.faulted {
        ret_val = try interp.exec_fn(entry_id, args.as_slice());
    }

    var ok = true;
    if interp.st.faulted {
        try err_out.push_bytes_grow(alloc, interp.st.err_msg.as_bytes());
        ok = false;
    } else if env.get(entry_ret).kind == .ErrorUnion {
        var raw_b: [4]u8 = [0_u8; 4];
        interp.st.vals.write_bytes_to(ret_val, &mut raw_b);
        let err_tag = read_le_u32_at(&raw_b, 0_usize);
        if err_tag != 0_u32 {
            try err_out.push_str_grow(alloc, "build.eon entry function `");
            try err_out.push_bytes_grow(alloc, interner.get(entry_name_sym));
            try err_out.push_str_grow(alloc, "` failed with error code ");
            try err_out.push_u64_grow(alloc, err_tag.widen.[u64]());
            ok = false;
        }
    }

    args.destroy(alloc);
    st.destroy(alloc);
    return ok;
}
