module eonc.eir_opt;

import core.col;
import core.str;
import core.sync;
import std.rt;
import eonc.span;
import eonc.ast;
import eonc.types;
import eonc.cfg_ir;
import eonc.eir;

// ===========================================================================
// Section 1: Public API, Pass Orchestration, and Core SSA / CFG Utilities
// ===========================================================================

pub struct OptStats {
    pub passes_run: u64;
    pub inlined_calls: u64;
    pub sroa_slots: u64;
    pub mem2reg_slots: u64;
    pub folded_consts: u64;
    pub gvn_eliminated: u64;
    pub licm_hoisted: u64;
    pub dbm_checks_eliminated: u64;
    pub fused_pool_loops: u64;
    pub tail_calls_eliminated: u64;
    pub devirt_calls: u64;
    pub dce_removed: u64;
}

pub fn opt_stats_zero() -> OptStats {
    return OptStats.{
        passes_run: 0_u64,
        inlined_calls: 0_u64,
        sroa_slots: 0_u64,
        mem2reg_slots: 0_u64,
        folded_consts: 0_u64,
        gvn_eliminated: 0_u64,
        licm_hoisted: 0_u64,
        dbm_checks_eliminated: 0_u64,
        fused_pool_loops: 0_u64,
        tail_calls_eliminated: 0_u64,
        devirt_calls: 0_u64,
        dce_removed: 0_u64,
    };
}

struct OptCtx {
    cfg: eir.EirOptConfig;
    pass_counter: i64;
    failed: bool;
    stats: OptStats;
}

fn opt_ctx_new(cfg: eir.EirOptConfig) -> OptCtx {
    return OptCtx.{
        cfg: cfg,
        pass_counter: 0_i64,
        failed: false,
        stats: opt_stats_zero(),
    };
}

fn opt_should_run(ctx: *mut OptCtx) -> bool {
    if ctx.failed {
        return false;
    }
    if ctx.cfg.opt_bisect >= 0_i64 && ctx.pass_counter >= ctx.cfg.opt_bisect {
        return false;
    }
    ctx.pass_counter = ctx.pass_counter +% 1_i64;
    ctx.stats.passes_run = ctx.stats.passes_run +% 1_u64;
    return true;
}

fn opt_verify_after_pass(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    ctx: *mut OptCtx,
    pass_name: *str,
    err_out: *mut str.StrBuf,
) -> !OutOfMemory {
    if !ctx.cfg.verify_opt || ctx.failed {
        return;
    }
    let ok = try eir.lint_program(alloc, eir_prog, err_out);
    if !ok {
        try err_out.push_str_grow(alloc, " [after pass: ");
        try err_out.push_str_grow(alloc, pass_name);
        try err_out.push_str_grow(alloc, "]");
        ctx.failed = true;
    }
    return;
}

fn max_usize(a: usize, b: usize) -> usize {
    return if a > b { a } else { b };
}

fn u32_at(buf: *col.DynBuf[u32], idx: usize) -> u32 {
    let s = buf.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return eir.EIR_NONE;
}

fn u32_set(buf: *mut col.DynBuf[u32], idx: usize, val: u32) {
    let s = buf.as_mut_slice();
    if idx < s.len {
        s[idx] = val;
    }
}

fn u8_at(buf: *col.DynBuf[u8], idx: usize) -> u8 {
    let s = buf.as_slice();
    if idx < s.len {
        return s[idx];
    }
    return 0_u8;
}

fn u8_set(buf: *mut col.DynBuf[u8], idx: usize, val: u8) {
    let s = buf.as_mut_slice();
    if idx < s.len {
        s[idx] = val;
    }
}

fn u64_set(buf: *mut col.DynBuf[u64], idx: usize, val: u64) {
    let s = buf.as_mut_slice();
    if idx < s.len {
        s[idx] = val;
    }
}

fn fill_u32(alloc: *mut AllocCap, buf: *mut col.DynBuf[u32], n: usize, val: u32) -> !OutOfMemory {
    var i: usize = 0_usize;
    while i < n {
        try buf.push(alloc, val);
        i = i +% 1_usize;
    }
    return;
}

fn fill_u8(alloc: *mut AllocCap, buf: *mut col.DynBuf[u8], n: usize, val: u8) -> !OutOfMemory {
    var i: usize = 0_usize;
    while i < n {
        try buf.push(alloc, val);
        i = i +% 1_usize;
    }
    return;
}

fn fill_u64(alloc: *mut AllocCap, buf: *mut col.DynBuf[u64], n: usize, val: u64) -> !OutOfMemory {
    var i: usize = 0_usize;
    while i < n {
        try buf.push(alloc, val);
        i = i +% 1_usize;
    }
    return;
}

fn is_opt_protected_fn(f: *eir.EirFunction) -> bool {
    return f.sig.effects.is_naked || f.sig.effects.is_interrupt;
}

fn has_par_for(f: *eir.EirFunction) -> bool {
    return f.par_for_regions.len > 0_u32;
}

fn collect_par_for_slots(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    out: *mut col.BitSet,
) {
    let regs = eir_prog.fn_par_for_regions(fn_id);
    var i: usize = 0_usize;
    while i < regs.len {
        let r = regs[i];
        if r.idx_slot != eir.EIR_NONE {
            out.set(r.idx_slot.widen.[usize]());
        }
        if r.end_slot != eir.EIR_NONE {
            out.set(r.end_slot.widen.[usize]());
        }
        i = i +% 1_usize;
    }
}

fn is_par_for_header(eir_prog: *eir.EirProgram, fn_id: u32, bb: eir.BlockId) -> bool {
    let regs = eir_prog.fn_par_for_regions(fn_id);
    var i: usize = 0_usize;
    while i < regs.len {
        if regs[i].header_bb == bb || regs[i].body_bb == bb || regs[i].step_bb == bb || regs[i].exit_bb == bb {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn hash_mix_u64(h: u64, x: u64) -> u64 {
    var v = (h ^ x) *% 0x100000001B3_u64;
    v = v ^ (v >> 33_u64);
    return v;
}

fn hash_bytes_u64(bs: *[u8]) -> u64 {
    var h: u64 = 0xCBF29CE484222325_u64;
    var i: usize = 0_usize;
    while i < bs.len {
        h = (h ^ bs[i].widen.[u64]()) *% 0x100000001B3_u64;
        i = i +% 1_usize;
    }
    return h;
}

fn mask_bits_u64(bits: u8) -> u64 {
    if bits == 0_u8 {
        return 0_u64;
    }
    if bits >= 64_u8 {
        return 0xFFFFFFFFFFFFFFFF_u64;
    }
    return (1_u64 <<% bits.widen.[u64]()) -% 1_u64;
}

fn sext_bits_i64(raw_u: u64, bits: u8) -> i64 {
    if bits == 0_u8 || bits >= 64_u8 {
        return raw_u.bitcast.[i64]();
    }
    let sh = (64_u8 -% bits).widen.[u64]() & 63_u64;
    let shi = sh.bitcast.[i64]() & 63_i64;
    return (raw_u <<% sh).bitcast.[i64]() >> shi;
}

fn u64_to_int_val(raw_u: u64, bits: u8, signed: bool) -> types.IntVal {
    let m = raw_u & mask_bits_u64(bits);
    if signed {
        return types.int_val_from_i64(sext_bits_i64(m, bits));
    }
    return types.int_val_from_u64(m);
}

fn int_val_to_raw_u64(v: types.IntVal, bits: u8) -> ?u64 {
    if bits > 64_u8 {
        return null;
    }
    if v.hi == 0_i64 || v.hi == -1_i64 {
        return v.lo & mask_bits_u64(bits);
    }
    return null;
}

fn pow2_exp_u64(v: u64) -> ?u8 {
    if v == 0_u64 || (v & (v -% 1_u64)) != 0_u64 {
        return null;
    }
    var x = v;
    var k: u8 = 0_u8;
    while x > 1_u64 {
        x = x >> 1_u64;
        k = k +% 1_u8;
    }
    return k;
}

fn append_insts_with_flags(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    insts: *[eir.EirInst],
    flags: *[u8],
) -> ast.IdRange ! OutOfMemory {
    let r = try eir_prog.append_insts(alloc, insts);
    let n = if insts.len < flags.len { insts.len } else { flags.len };
    var i: usize = 0_usize;
    while i < n {
        if flags[i] != 0_u8 {
            try eir_prog.set_inst_proven_flags(alloc, r.start +% i.trunc.[u32](), flags[i]);
        }
        i = i +% 1_usize;
    }
    return r;
}

fn resolve_val_chain(v: eir.EirValue, remap: *[eir.EirValue]) -> eir.EirValue {
    var cur = v;
    var guard: usize = 0_usize;
    while guard < 64_usize {
        let cu = cur.widen.[usize]();
        if cu >= remap.len {
            break;
        }
        let nxt = remap[cu];
        if nxt == eir.EIR_NONE || nxt == cur {
            break;
        }
        cur = nxt;
        guard = guard +% 1_usize;
    }
    return cur;
}

fn rewrite_term_val(term: *mut eir.EirTerm, remap: *[eir.EirValue]) {
    if term.kind == .Branch || term.kind == .SwitchInt || (term.kind == .Return && term.flag) {
        if term.val != eir.EIR_NONE {
            term.val = resolve_val_chain(term.val, remap);
        }
    }
}

fn rewrite_term_target(
    eir_prog: *mut eir.EirProgram,
    term: *mut eir.EirTerm,
    old_bb: eir.BlockId,
    new_bb: eir.BlockId,
) -> bool {
    var changed = false;
    match term.kind {
        .Goto => {
            if term.bb0 == old_bb {
                term.bb0 = new_bb;
                changed = true;
            }
        }
        .Branch => {
            if term.bb0 == old_bb {
                term.bb0 = new_bb;
                changed = true;
            }
            if term.bb1 == old_bb {
                term.bb1 = new_bb;
                changed = true;
            }
        }
        .SwitchInt => {
            if term.bb0 == old_bb {
                term.bb0 = new_bb;
                changed = true;
            }
            let ts = eir_prog.switch_targets_slice_mut(term.targets);
            var i: usize = 0_usize;
            while i < ts.len {
                if ts[i].target == old_bb {
                    ts[i].target = new_bb;
                    changed = true;
                }
                i = i +% 1_usize;
            }
        }
        _ => {}
    }
    return changed;
}

fn find_const_bool_in_fn(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    hint_bb: eir.BlockId,
    v: eir.EirValue,
) -> i8 {
    if v == eir.EIR_NONE {
        return -1_i8;
    }
    if let hb = eir_prog.fn_block(fn_id, hint_bb) {
        let insts = eir_prog.insts_slice(hb.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .Const && inst.dst == v {
                if let kc = eir_prog.get_const(inst.aux0) {
                    if kc.kind == .Bool {
                        return if kc.bool_val { 1_i8 } else { 0_i8 };
                    }
                }
                return -1_i8;
            }
            ii = ii +% 1_usize;
        }
    }
    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bb = rpo[ri];
        if bb != hint_bb {
            if let blk = eir_prog.fn_block(fn_id, bb) {
                let insts = eir_prog.insts_slice(blk.insts);
                var ii: usize = 0_usize;
                while ii < insts.len {
                    let inst = insts[ii];
                    if inst.kind == .Const && inst.dst == v {
                        if let kc = eir_prog.get_const(inst.aux0) {
                            if kc.kind == .Bool {
                                return if kc.bool_val { 1_i8 } else { 0_i8 };
                            }
                        }
                        return -1_i8;
                    }
                    ii = ii +% 1_usize;
                }
            }
        }
        ri = ri +% 1_usize;
    }
    return -1_i8;
}

fn clone_block_phi_pred_edge(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    bb: eir.BlockId,
    src_pred: eir.BlockId,
    new_pred: eir.BlockId,
) -> !OutOfMemory {
    var phis_r = ast.range_empty();
    if let bp = eir_prog.fn_block(fn_id, bb) {
        phis_r = bp.phis;
    }
    if phis_r.len == 0_u32 {
        return;
    }
    var tmp_phis = try col.DynBuf.[eir.EirPhi].init(alloc, phis_r.len.widen.[usize]());
    errdefer tmp_phis.destroy(alloc);
    var tmp_inc = try col.DynBuf.[eir.EirPhiIn].init(alloc, 8_usize);
    errdefer tmp_inc.destroy(alloc);

    var pi: u32 = 0_u32;
    while pi < phis_r.len {
        if let pp = eir_prog.funcs.phis.get((phis_r.start +% pi).widen.[usize]()) {
            let phi = pp.*;
            tmp_inc.clear();
            var cloned_val = eir.EIR_NONE;
            var ki: u32 = 0_u32;
            while ki < phi.incoming.len {
                if let inp = eir_prog.funcs.phi_in.get((phi.incoming.start +% ki).widen.[usize]()) {
                    let ent = inp.*;
                    try tmp_inc.push(alloc, ent);
                    if ent.pred_bb == src_pred {
                        cloned_val = ent.val;
                    }
                }
                ki = ki +% 1_u32;
            }
            if cloned_val != eir.EIR_NONE {
                try tmp_inc.push(alloc, eir.EirPhiIn.{ pred_bb: new_pred, val: cloned_val });
            }
            let nir = try eir_prog.append_phi_incoming(alloc, tmp_inc.as_slice());
            try tmp_phis.push(alloc, eir.EirPhi.{ dst: phi.dst, ty: phi.ty, incoming: nir });
        }
        pi = pi +% 1_u32;
    }
    let npr = try eir_prog.append_phis(alloc, tmp_phis.as_slice());
    if let bbm = eir_prog.fn_block_mut(fn_id, bb) {
        bbm.phis = npr;
    }
    tmp_inc.destroy(alloc);
    tmp_phis.destroy(alloc);
    return;
}

fn update_block_phi_pred(
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    bb: eir.BlockId,
    old_pred: eir.BlockId,
    new_pred: eir.BlockId,
) {
    var phis_r = ast.range_empty();
    if let bp = eir_prog.fn_block(fn_id, bb) {
        phis_r = bp.phis;
    }
    var pi: u32 = 0_u32;
    while pi < phis_r.len {
        var inc_r = ast.range_empty();
        if let pp = eir_prog.funcs.phis.get((phis_r.start +% pi).widen.[usize]()) {
            inc_r = pp.incoming;
        }
        let incs = eir_prog.phi_incoming_mut(inc_r);
        var ki: usize = 0_usize;
        while ki < incs.len {
            if incs[ki].pred_bb == old_pred {
                incs[ki].pred_bb = new_pred;
            }
            ki = ki +% 1_usize;
        }
        pi = pi +% 1_u32;
    }
}

fn apply_val_remap_fn(
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    remap: *[eir.EirValue],
) {
    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        rpo_r = f.rpo;
    } else {
        return;
    }
    var ri: u32 = 0_u32;
    while ri < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% ri).widen.[usize]()) {
            bb = bp.*;
        } else {
            ri = ri +% 1_u32;
            continue;
        }
        var phis_r = ast.range_empty();
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            phis_r = blk.phis;
            insts_r = blk.insts;
        }
        var pi: u32 = 0_u32;
        while pi < phis_r.len {
            var inc_r = ast.range_empty();
            if let pp = eir_prog.funcs.phis.get((phis_r.start +% pi).widen.[usize]()) {
                inc_r = pp.incoming;
            }
            let incs = eir_prog.phi_incoming_mut(inc_r);
            var ki: usize = 0_usize;
            while ki < incs.len {
                incs[ki].val = resolve_val_chain(incs[ki].val, remap);
                ki = ki +% 1_usize;
            }
            pi = pi +% 1_u32;
        }
        var ii: u32 = 0_u32;
        while ii < insts_r.len {
            let gid = insts_r.start +% ii;
            var icopy = eir.inst_zero(span.span_dummy(), .ParForHint);
            var have_i = false;
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                icopy = ip.*;
                have_i = true;
            }
            if have_i {
                eir.rewrite_inst_operands(eir_prog, &mut icopy, remap);
                if let im = eir_prog.get_inst_mut(gid) {
                    im.* = icopy;
                }
            }
            ii = ii +% 1_u32;
        }
        if let bm = eir_prog.fn_block_mut(fn_id, bb) {
            rewrite_term_val(&mut bm.term, remap);
        }
        ri = ri +% 1_u32;
    }
}

fn clear_unreachable_blocks(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
) -> !OutOfMemory {
    var nblks: usize = 0_usize;
    if let f = eir_prog.get_fn(fn_id) {
        nblks = f.blocks.len.widen.[usize]();
    } else {
        return;
    }
    var reach = try col.BitSet.init(alloc, max_usize(nblks, 1_usize));
    errdefer reach.destroy(alloc);
    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bu = rpo[ri].widen.[usize]();
        if bu < nblks {
            reach.set(bu);
        }
        ri = ri +% 1_usize;
    }
    var bi: usize = 0_usize;
    while bi < nblks {
        if !reach.test(bi) {
            if let bm = eir_prog.fn_block_mut(fn_id, bi.trunc.[u32]()) {
                bm.phis = ast.range_empty();
                bm.insts = ast.range_empty();
                bm.preds = ast.range_empty();
                bm.idom = eir.EIR_NONE;
                bm.term = eir.term_unreachable(span.span_dummy(), false);
            }
        }
        bi = bi +% 1_usize;
    }
    reach.destroy(alloc);
    return;
}

/// Collapses Copy instructions and trivial single-value Phis in `fn_id`.
fn eliminate_copies_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
) -> u64 ! OutOfMemory {
    var nvals: usize = 0_usize;
    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        nvals = f.value_tys.len.widen.[usize]();
        rpo_r = f.rpo;
    } else {
        return 0_u64;
    }
    if nvals == 0_usize || rpo_r.len == 0_u32 {
        return 0_u64;
    }

    var remap = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer remap.destroy(alloc);
    try fill_u32(alloc, &mut remap, nvals, eir.EIR_NONE);

    var removed: u64 = 0_u64;
    var any_found = true;
    var iter: usize = 0_usize;
    while any_found && iter < 8_usize {
        any_found = false;
        iter = iter +% 1_usize;

        var ri: u32 = 0_u32;
        while ri < rpo_r.len {
            var bb: eir.BlockId = 0_u32;
            if let bp = eir_prog.meta.rpo.get((rpo_r.start +% ri).widen.[usize]()) {
                bb = bp.*;
            } else {
                ri = ri +% 1_u32;
                continue;
            }
            let phis = eir_prog.block_phis(fn_id, bb);
            var pi: usize = 0_usize;
            while pi < phis.len {
                let phi = phis[pi];
                let du = phi.dst.widen.[usize]();
                if du < nvals && u32_at(&remap, du) == eir.EIR_NONE {
                    let incs = eir_prog.phi_incoming(phi.incoming);
                    var cand = eir.EIR_NONE;
                    var trivial = incs.len > 0_usize;
                    var ki: usize = 0_usize;
                    while ki < incs.len {
                        let iv = resolve_val_chain(incs[ki].val, remap.as_slice());
                        if iv != phi.dst {
                            if cand == eir.EIR_NONE {
                                cand = iv;
                            } else if cand != iv {
                                trivial = false;
                                break;
                            }
                        }
                        ki = ki +% 1_usize;
                    }
                    if trivial && cand != eir.EIR_NONE && cand != phi.dst {
                        if eir_prog.fn_val_ty(fn_id, phi.dst) == eir_prog.fn_val_ty(fn_id, cand) {
                            u32_set(&mut remap, du, cand);
                            any_found = true;
                        }
                    }
                }
                pi = pi +% 1_usize;
            }

            let insts = eir_prog.block_insts(fn_id, bb);
            var ii: usize = 0_usize;
            while ii < insts.len {
                let inst = insts[ii];
                if inst.kind == .Copy && inst.dst != eir.EIR_NONE && inst.v0 != eir.EIR_NONE {
                    let du = inst.dst.widen.[usize]();
                    if du < nvals && u32_at(&remap, du) == eir.EIR_NONE {
                        let src = resolve_val_chain(inst.v0, remap.as_slice());
                        if src != inst.dst && eir_prog.fn_val_ty(fn_id, inst.dst) == eir_prog.fn_val_ty(fn_id, src) {
                            u32_set(&mut remap, du, src);
                            any_found = true;
                        }
                    }
                }
                ii = ii +% 1_usize;
            }
            ri = ri +% 1_u32;
        }
    }

    var has_remap = false;
    var vi: usize = 0_usize;
    while vi < nvals {
        if u32_at(&remap, vi) != eir.EIR_NONE {
            has_remap = true;
            break;
        }
        vi = vi +% 1_usize;
    }
    if !has_remap {
        remap.destroy(alloc);
        return 0_u64;
    }

    apply_val_remap_fn(eir_prog, fn_id, remap.as_slice());

    var new_phis = try col.DynBuf.[eir.EirPhi].init(alloc, 8_usize);
    errdefer new_phis.destroy(alloc);
    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);

    var ri2: u32 = 0_u32;
    while ri2 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% ri2).widen.[usize]()) {
            bb = bp.*;
        } else {
            ri2 = ri2 +% 1_u32;
            continue;
        }
        var phis_r = ast.range_empty();
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            phis_r = blk.phis;
            insts_r = blk.insts;
        }

        if phis_r.len > 0_u32 {
            new_phis.clear();
            var pchanged = false;
            var pi: u32 = 0_u32;
            while pi < phis_r.len {
                if let pp = eir_prog.funcs.phis.get((phis_r.start +% pi).widen.[usize]()) {
                    let phi = pp.*;
                    if u32_at(&remap, phi.dst.widen.[usize]()) != eir.EIR_NONE {
                        pchanged = true;
                        removed = removed +% 1_u64;
                    } else {
                        try new_phis.push(alloc, phi);
                    }
                }
                pi = pi +% 1_u32;
            }
            if pchanged {
                try eir_prog.replace_block_phis_reuse(alloc, fn_id, bb, new_phis.as_slice());
            }
        }

        if insts_r.len > 0_u32 {
            new_insts.clear();
            new_flags.clear();
            var ichanged = false;
            var ii: u32 = 0_u32;
            while ii < insts_r.len {
                let gid = insts_r.start +% ii;
                if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                    let inst = ip.*;
                    if inst.kind == .Copy && u32_at(&remap, inst.dst.widen.[usize]()) != eir.EIR_NONE {
                        ichanged = true;
                        removed = removed +% 1_u64;
                    } else {
                        try new_insts.push(alloc, inst);
                        try new_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                    }
                }
                ii = ii +% 1_u32;
            }
            if ichanged {
                try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
            }
        }
        ri2 = ri2 +% 1_u32;
    }

    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    new_phis.destroy(alloc);
    remap.destroy(alloc);
    return removed;
}

/// Builds dominator-tree child adjacency lists for reachable blocks in `fn_id`.
linear struct DomTree {
    child_head: col.DynBuf[u32];
    child_next: col.DynBuf[u32];
    nblks: usize;
}

impl DomTree {
    fn build(
        alloc: *mut AllocCap,
        eir_prog: *eir.EirProgram,
        fn_id: u32,
    ) -> DomTree ! OutOfMemory {
        let blks = eir_prog.fn_blocks(fn_id);
        let n = blks.len;
        var head = try col.DynBuf.[u32].init(alloc, max_usize(n, 1_usize));
        errdefer head.destroy(alloc);
        var next = try col.DynBuf.[u32].init(alloc, max_usize(n, 1_usize));
        errdefer next.destroy(alloc);
        try fill_u32(alloc, &mut head, n, eir.EIR_NONE);
        try fill_u32(alloc, &mut next, n, eir.EIR_NONE);

        var entry: eir.BlockId = 0_u32;
        if let f = eir_prog.get_fn(fn_id) {
            entry = f.entry;
        }
        let rpo = eir_prog.fn_rpo(fn_id);
        // Walk RPO in reverse so children are visited in RPO order when iterating linked lists.
        var ri = rpo.len;
        while ri > 0_usize {
            ri = ri -% 1_usize;
            let b = rpo[ri];
            let bu = b.widen.[usize]();
            if b != entry && bu < blks.len {
                let idom = blks[bu].idom;
                let iu = idom.widen.[usize]();
                if idom != eir.EIR_NONE && idom != b && iu < n {
                    let old_h = u32_at(&head, iu);
                    u32_set(&mut next, bu, old_h);
                    u32_set(&mut head, iu, b);
                }
            }
        }
        return DomTree.{ child_head: head, child_next: next, nblks: n };
    }

    fn destroy(self: DomTree, alloc: *mut AllocCap) {
        let DomTree.{ child_head, child_next, nblks } = self;
        _ = nblks;
        child_head.destroy(alloc);
        child_next.destroy(alloc);
    }
}

fn make_typed_zero_const(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    ty: types.TyId,
    dst: eir.EirValue,
    sp: span.Span,
) -> eir.EirInst ! OutOfMemory {
    let n = env.get(ty);
    var konst = cfg_ir.const_null(ty);
    if n.kind == .Bool {
        konst = cfg_ir.const_bool(false);
    } else if n.kind == .Char {
        konst = cfg_ir.const_char(0_u32);
    } else if n.kind == .Float {
        let r = try eir_prog.add_str(alloc, "0.0");
        konst = cfg_ir.const_float(r, ty);
    } else if n.kind == .Enum {
        var tag_sym = span.SYM_EMPTY;
        var tag_val = types.int_val_zero();
        if let em = env.get_enum(n.primary) {
            let vs = env.enum_variants_range(em.variants);
            if vs.len > 0_usize {
                tag_sym = vs[0_usize].name;
                tag_val = vs[0_usize].val;
            }
        }
        konst = cfg_ir.const_enum_tag(ty, tag_sym, tag_val);
    } else if env.is_integer(ty) || env.is_address(ty) || n.kind == .Bitfield {
        konst = cfg_ir.const_int(types.int_val_zero(), ty);
    } else if n.kind == .ErrorSet {
        konst = cfg_ir.const_error_tag(ty, span.SYM_EMPTY, 0_u32);
    } else if n.kind == .Builtin {
        konst = cfg_ir.const_int(types.int_val_zero(), ty);
    }
    let cid = try eir_prog.push_const(alloc, konst);
    var inst = eir.inst_zero(sp, .Const);
    inst.dst = dst;
    inst.ty0 = ty;
    inst.aux0 = cid;
    return inst;
}

fn is_pure_stateless_builtin(kind: cfg_ir.CfgBuiltinOpKind) -> bool {
    match kind {
        .MathSqrt => { return true; }
        .MathFma => { return true; }
        .MathLzcnt => { return true; }
        .MathTzcnt => { return true; }
        .MathPopcnt => { return true; }
        .MathBswap => { return true; }
        .RawPtrFromUsize => { return true; }
        .RawPtrAsUsize => { return true; }
        .SliceLen => { return true; }
        .ArrayLen => { return true; }
        .StrLen => { return true; }
        .StrAsBytes => { return true; }
        .VecSplat => { return true; }
        .VecLen => { return true; }
        .VecCmp => { return true; }
        .VecMaskAny => { return true; }
        .VecMaskAll => { return true; }
        .VecBitmask => { return true; }
        .VecSelect => { return true; }
        .VecMin => { return true; }
        .VecMax => { return true; }
        .VecFma => { return true; }
        .VecReduceAdd => { return true; }
        .VecReduceMin => { return true; }
        .VecReduceMax => { return true; }
        .VecDot => { return true; }
        .VecShuffle => { return true; }
        _ => { return false; }
    }
}

fn is_readonly_nontrapping_builtin(kind: cfg_ir.CfgBuiltinOpKind) -> bool {
    if is_pure_stateless_builtin(kind) {
        return true;
    }
    match kind {
        .ArenaUsedBytes => { return true; }
        .ArenaCapacity => { return true; }
        .ArenaPoolLen => { return true; }
        .ArenaPoolIdAt => { return true; }
        .SlotPoolLen => { return true; }
        .SlotPoolCap => { return true; }
        .SlotPoolIsAlive => { return true; }
        .SlotPoolIdAt => { return true; }
        .SlotPoolGet => { return true; }
        .BufLen => { return true; }
        .BufCap => { return true; }
        .BufAsSlice => { return true; }
        .BufGet => { return true; }
        .BufSub => { return true; }
        .BytesAsStr => { return true; }
        .SliceGet => { return true; }
        .ArrayGet => { return true; }
        .SliceSub => { return true; }
        .ArraySub => { return true; }
        .ScheduleBuild => { return true; }
        _ => { return false; }
    }
}

fn is_pool_mutating_builtin(kind: cfg_ir.CfgBuiltinOpKind) -> bool {
    match kind {
        .ArenaPoolInit => { return true; }
        .ArenaPoolPush => { return true; }
        .ArenaPoolReset => { return true; }
        .SlotPoolInit => { return true; }
        .SlotPoolInsert => { return true; }
        .SlotPoolTryInsert => { return true; }
        .SlotPoolRemove => { return true; }
        .SlotPoolDestroy => { return true; }
        _ => { return false; }
    }
}

/// Pure by-value builtins that read only `bc.args` (never `bc.arg_slots`),
/// so slots appearing in their `arg_slots` metadata remain eligible for mem2reg/ADCE.
fn builtin_ignores_arg_slots(kind: cfg_ir.CfgBuiltinOpKind) -> bool {
    match kind {
        .VecSplat => { return true; }
        .VecLen => { return true; }
        .VecCmp => { return true; }
        .VecMaskAny => { return true; }
        .VecMaskAll => { return true; }
        .VecBitmask => { return true; }
        .VecSelect => { return true; }
        .VecMin => { return true; }
        .VecMax => { return true; }
        .VecFma => { return true; }
        .VecReduceAdd => { return true; }
        .VecReduceMin => { return true; }
        .VecReduceMax => { return true; }
        .VecDot => { return true; }
        .VecShuffle => { return true; }
        .MathSqrt => { return true; }
        .MathFma => { return true; }
        .MathLzcnt => { return true; }
        .MathTzcnt => { return true; }
        .MathPopcnt => { return true; }
        .MathBswap => { return true; }
        .SliceLen => { return true; }
        .ArrayLen => { return true; }
        .StrLen => { return true; }
        .StrAsBytes => { return true; }
        .BytesAsStr => { return true; }
        .SliceAt => { return true; }
        .SliceGet => { return true; }
        .SliceSub => { return true; }
        .RawPtrFromUsize => { return true; }
        .RawPtrAsUsize => { return true; }
        _ => { return false; }
    }
}

/// Returns true iff `bc.arg_slots[idx]` is actually observed by lowering/execution of `kind`.
/// By-value arguments (e.g., row struct pushed into ArenaPoolPush, index arg of ArenaPoolIdAt)
/// are read purely from `bc.args[idx]`, never from `bc.arg_slots[idx]`.
fn builtin_uses_arg_slot_at(kind: cfg_ir.CfgBuiltinOpKind, idx: usize) -> bool {
    if builtin_ignores_arg_slots(kind) {
        return false;
    }
    match kind {
        .ArenaPoolPush => { return idx == 0_usize; }
        .ArenaPoolIdAt => { return idx == 0_usize; }
        .ArenaPoolLen => { return idx == 0_usize; }
        .ArenaPoolReset => { return idx == 0_usize; }
        .SlotPoolGet => { return idx == 0_usize; }
        .SlotPoolAt => { return idx == 0_usize; }
        .SlotPoolRemove => { return idx == 0_usize; }
        .SlotPoolTryInsert => { return idx == 0_usize; }
        .SlotPoolLen => { return idx == 0_usize; }
        .SlotPoolCap => { return idx == 0_usize; }
        .SlotPoolIsAlive => { return idx == 0_usize; }
        .SlotPoolIdAt => { return idx == 0_usize; }
        .SlotPoolInsert => { return idx <= 1_usize; }
        .ArenaAlloc => { return idx == 0_usize; }
        .ArenaReset => { return idx == 0_usize; }
        .BufPush => { return idx == 0_usize; }
        .BufPushSlice => { return idx == 0_usize; }
        .BufPop => { return idx == 0_usize; }
        .BufLen => { return idx == 0_usize; }
        .BufCap => { return idx == 0_usize; }
        .BufClear => { return idx == 0_usize; }
        .BufAsSlice => { return idx == 0_usize; }
        .BufAt => { return idx == 0_usize; }
        .BufGet => { return idx == 0_usize; }
        .BufSub => { return idx == 0_usize; }
        _ => { return true; }
    }
}

fn remap_id(id: u32, map: *[u32]) -> u32 {
    if id == eir.EIR_NONE {
        return eir.EIR_NONE;
    }
    let idx = id.widen.[usize]();
    if idx < map.len && map[idx] != eir.EIR_NONE {
        return map[idx];
    }
    return id;
}

/// Deep-clones an instruction (allocating fresh Places/Calls/Builtins/PoolColOps/ValRanges)
/// while remapping SSA values via `val_map` and stack slots via `slot_map`.
fn clone_and_remap_inst(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    orig: *eir.EirInst,
    val_map: *[eir.EirValue],
    slot_map: *[eir.EirSlot],
) -> eir.EirInst ! OutOfMemory {
    var inst = orig.*;
    if inst.dst != eir.EIR_NONE {
        inst.dst = remap_id(inst.dst, val_map);
    }
    match inst.kind {
        .Const => {}
        .ParForHint => {}
        .Copy => { inst.v0 = remap_id(inst.v0, val_map); }
        .LoadSlot => { inst.aux0 = remap_id(inst.aux0, slot_map); }
        .StoreSlot => {
            inst.aux0 = remap_id(inst.aux0, slot_map);
            inst.v0 = remap_id(inst.v0, val_map);
        }
        .SlotAddr => { inst.aux0 = remap_id(inst.aux0, slot_map); }
        .LoadPlace => {
            inst.aux0 = try clone_and_remap_place(alloc, eir_prog, inst.aux0, val_map, slot_map);
        }
        .PlaceAddr => {
            inst.aux0 = try clone_and_remap_place(alloc, eir_prog, inst.aux0, val_map, slot_map);
        }
        .StorePlace => {
            inst.aux0 = try clone_and_remap_place(alloc, eir_prog, inst.aux0, val_map, slot_map);
            inst.v0 = remap_id(inst.v0, val_map);
        }
        .PoolColumnLoad => {
            inst.aux0 = try clone_and_remap_pool_op(alloc, eir_prog, inst.aux0, val_map, slot_map);
        }
        .PoolColumnStore => {
            inst.aux0 = try clone_and_remap_pool_op(alloc, eir_prog, inst.aux0, val_map, slot_map);
            inst.v0 = remap_id(inst.v0, val_map);
        }
        .Unary => { inst.v0 = remap_id(inst.v0, val_map); }
        .Cast => { inst.v0 = remap_id(inst.v0, val_map); }
        .Binary => {
            inst.v0 = remap_id(inst.v0, val_map);
            inst.v1 = remap_id(inst.v1, val_map);
        }
        .Slice => {
            inst.v0 = remap_id(inst.v0, val_map);
            if inst.v1 != eir.EIR_NONE {
                inst.v1 = remap_id(inst.v1, val_map);
            }
            if inst.v2 != eir.EIR_NONE {
                inst.v2 = remap_id(inst.v2, val_map);
            }
        }
        .Aggregate => {
            inst.range = try clone_and_remap_val_range(alloc, eir_prog, inst.range, val_map);
        }
        .UnwrapOptional => { inst.v0 = remap_id(inst.v0, val_map); }
        .UnwrapErrorOk => { inst.v0 = remap_id(inst.v0, val_map); }
        .UnwrapErrorErr => { inst.v0 = remap_id(inst.v0, val_map); }
        .IsNonNull => { inst.v0 = remap_id(inst.v0, val_map); }
        .IsError => { inst.v0 = remap_id(inst.v0, val_map); }
        .MatchTag => { inst.v0 = remap_id(inst.v0, val_map); }
        .FieldExtract => { inst.v0 = remap_id(inst.v0, val_map); }
        .MakeDyn => { inst.v0 = remap_id(inst.v0, val_map); }
        .MakeClosure => {
            if inst.v0 != eir.EIR_NONE {
                inst.v0 = remap_id(inst.v0, val_map);
            }
        }
        .Call => {
            var cd = eir.EirCallData.{
                callee: eir.callee_direct_fn(0_u32),
                args: ast.range_empty(),
                ret_ty: types.TY_VOID,
            };
            if let cdp = eir_prog.get_call(inst.aux0) {
                cd = cdp.*;
            }
            if cd.callee.kind == .FnPtr {
                cd.callee.a = remap_id(cd.callee.a, val_map);
            }
            let new_args = try clone_and_remap_val_range(alloc, eir_prog, cd.args, val_map);
            cd.args = new_args;
            inst.aux0 = try eir_prog.push_call(alloc, cd);
            inst.range = new_args;
        }
        .BuiltinCall => {
            var bc = eir.EirBuiltinCallData.{
                op: cfg_ir.builtin_op_simple(.ArenaInit),
                args: ast.range_empty(),
                arg_slots: ast.range_empty(),
                ret_ty: types.TY_VOID,
            };
            if let bcp = eir_prog.get_builtin_call(inst.aux0) {
                bc = bcp.*;
            }
            let new_args = try clone_and_remap_val_range(alloc, eir_prog, bc.args, val_map);
            let new_slots = try clone_and_remap_slot_range(alloc, eir_prog, bc.arg_slots, slot_map);
            bc.args = new_args;
            bc.arg_slots = new_slots;
            inst.aux0 = try eir_prog.push_builtin_call(alloc, bc);
            inst.range = new_args;
        }
        .InlineAsm => {
            var ad = eir.EirInlineAsmData.{ template: ast.range_empty(), inputs: ast.range_empty() };
            if let adp = eir_prog.get_asm(inst.aux0) {
                ad = adp.*;
            }
            var inps = try col.DynBuf.[eir.EirAsmInput].init(alloc, max_usize(ad.inputs.len.widen.[usize](), 1_usize));
            errdefer inps.destroy(alloc);
            var ki: u32 = 0_u32;
            while ki < ad.inputs.len {
                if let ip = eir_prog.meta.asm_inputs.get((ad.inputs.start +% ki).widen.[usize]()) {
                    var inp = ip.*;
                    inp.val = remap_id(inp.val, val_map);
                    try inps.push(alloc, inp);
                }
                ki = ki +% 1_u32;
            }
            ad.inputs = try eir_prog.add_asm_inputs(alloc, inps.as_slice());
            inst.aux0 = try eir_prog.add_asm(alloc, ad);
            inps.destroy(alloc);
        }
        _ => {}
    }
    return inst;
}

fn clone_and_remap_val_range(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    r: ast.IdRange,
    val_map: *[eir.EirValue],
) -> ast.IdRange ! OutOfMemory {
    if r.len == 0_u32 {
        return ast.range_empty();
    }
    var buf = try col.DynBuf.[eir.EirValue].init(alloc, r.len.widen.[usize]());
    errdefer buf.destroy(alloc);
    var i: u32 = 0_u32;
    while i < r.len {
        var v = eir.EIR_NONE;
        if let vp = eir_prog.exprs.vals.get((r.start +% i).widen.[usize]()) {
            v = vp.*;
        }
        try buf.push(alloc, remap_id(v, val_map));
        i = i +% 1_u32;
    }
    let out = try eir_prog.append_vals(alloc, buf.as_slice());
    buf.destroy(alloc);
    return out;
}

fn clone_and_remap_slot_range(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    r: ast.IdRange,
    slot_map: *[eir.EirSlot],
) -> ast.IdRange ! OutOfMemory {
    if r.len == 0_u32 {
        return ast.range_empty();
    }
    var buf = try col.DynBuf.[eir.EirSlot].init(alloc, r.len.widen.[usize]());
    errdefer buf.destroy(alloc);
    var i: u32 = 0_u32;
    while i < r.len {
        var s = eir.EIR_NONE;
        if let sp = eir_prog.exprs.arg_slots.get((r.start +% i).widen.[usize]()) {
            s = sp.*;
        }
        try buf.push(alloc, remap_id(s, slot_map));
        i = i +% 1_u32;
    }
    let out = try eir_prog.append_arg_slots(alloc, buf.as_slice());
    buf.destroy(alloc);
    return out;
}

fn clone_and_remap_place(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    place_id: u32,
    val_map: *[eir.EirValue],
    slot_map: *[eir.EirSlot],
) -> u32 ! OutOfMemory {
    var pl = eir.EirPlace.{
        base: eir.place_base_slot(0_u32),
        projs: ast.range_empty(),
        ty: types.TY_VOID,
    };
    if let pp = eir_prog.get_place(place_id) {
        pl = pp.*;
    }
    if pl.base.kind == .Slot {
        pl.base.id = remap_id(pl.base.id, slot_map);
    } else {
        pl.base.id = remap_id(pl.base.id, val_map);
    }
    var pbuf = try col.DynBuf.[eir.EirProj].init(alloc, max_usize(pl.projs.len.widen.[usize](), 1_usize));
    errdefer pbuf.destroy(alloc);
    var i: u32 = 0_u32;
    while i < pl.projs.len {
        if let prp = eir_prog.exprs.projs.get((pl.projs.start +% i).widen.[usize]()) {
            var pr = prp.*;
            if pr.kind == .Index {
                pr.index = remap_id(pr.index, val_map);
            }
            try pbuf.push(alloc, pr);
        }
        i = i +% 1_u32;
    }
    pl.projs = try eir_prog.append_projs(alloc, pbuf.as_slice());
    let pid = try eir_prog.push_place(alloc, pl);
    pbuf.destroy(alloc);
    return pid;
}

fn clone_and_remap_pool_op(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    op_id: u32,
    val_map: *[eir.EirValue],
    slot_map: *[eir.EirSlot],
) -> u32 ! OutOfMemory {
    var op = eir.EirPoolColOp.{
        pool_base: eir.place_base_slot(0_u32),
        pool_is_ptr: false,
        is_slot_pool: false,
        col: span.SYM_EMPTY,
        col_idx: 0_u32,
        index: eir.EIR_NONE,
        elem_ty: types.TY_VOID,
    };
    if let opp = eir_prog.get_pool_col_op(op_id) {
        op = opp.*;
    }
    if op.pool_base.kind == .Slot {
        op.pool_base.id = remap_id(op.pool_base.id, slot_map);
    } else {
        op.pool_base.id = remap_id(op.pool_base.id, val_map);
    }
    op.index = remap_id(op.index, val_map);
    return try eir_prog.push_pool_col_op(alloc, op);
}

/// Computes natural loops for `fn_id` and records every block's exact loop nesting depth
/// via `eir_prog.set_block_depth` (used by Pass 7 LICM, Pass 10 refresh, and `mach_regalloc`).
fn compute_and_set_loop_depths(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
) -> !OutOfMemory {
    let blks = eir_prog.fn_blocks(fn_id);
    let n = blks.len;
    if n == 0_usize {
        return;
    }
    var depths = try col.DynBuf.[u8].init(alloc, n);
    errdefer depths.destroy(alloc);
    try fill_u8(alloc, &mut depths, n, 0_u8);

    // Collect unique loop headers (any h with a back-edge u -> h where h dominates u).
    var is_hdr = try col.BitSet.init(alloc, n);
    errdefer is_hdr.destroy(alloc);
    var hdrs = try col.DynBuf.[eir.BlockId].init(alloc, 8_usize);
    errdefer hdrs.destroy(alloc);

    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let u = rpo[ri];
        let uu = u.widen.[usize]();
        if uu < blks.len {
            let term = blks[uu].term;
            let sc = eir_prog.term_successor_count(&term);
            var si: usize = 0_usize;
            while si < sc {
                let h = eir_prog.term_successor_at(&term, si);
                let hu = h.widen.[usize]();
                if h != eir.EIR_NONE && hu < n && eir_prog.dominates_block(fn_id, h, u) {
                    if !is_hdr.test(hu) {
                        is_hdr.set(hu);
                        try hdrs.push(alloc, h);
                    }
                }
                si = si +% 1_usize;
            }
        }
        ri = ri +% 1_usize;
    }

    var body = try col.BitSet.init(alloc, n);
    errdefer body.destroy(alloc);
    var work = try col.DynBuf.[eir.BlockId].init(alloc, 16_usize);
    errdefer work.destroy(alloc);

    let hsl = hdrs.as_slice();
    var hi: usize = 0_usize;
    while hi < hsl.len {
        let h = hsl[hi];
        let hu = h.widen.[usize]();
        body.clear();
        work.clear();
        body.set(hu);

        let hpreds = eir_prog.block_preds(fn_id, h);
        var pri: usize = 0_usize;
        while pri < hpreds.len {
            let u = hpreds[pri];
            let uu = u.widen.[usize]();
            if uu < n && eir_prog.dominates_block(fn_id, h, u) {
                if !body.test(uu) {
                    body.set(uu);
                    try work.push(alloc, u);
                }
            }
            pri = pri +% 1_usize;
        }
        while !work.is_empty() {
            let cur = work.pop() orelse { break; };
            let cpreds = eir_prog.block_preds(fn_id, cur);
            var pi: usize = 0_usize;
            while pi < cpreds.len {
                let p = cpreds[pi];
                let pu = p.widen.[usize]();
                if pu < n && !body.test(pu) {
                    body.set(pu);
                    try work.push(alloc, p);
                }
                pi = pi +% 1_usize;
            }
        }

        var bi: usize = 0_usize;
        while bi < n {
            if body.test(bi) {
                let cur_d = u8_at(&depths, bi);
                if cur_d < 255_u8 {
                    u8_set(&mut depths, bi, cur_d +% 1_u8);
                }
            }
            bi = bi +% 1_usize;
        }
        hi = hi +% 1_usize;
    }

    var bi2: usize = 0_usize;
    while bi2 < n {
        try eir_prog.set_block_depth(alloc, fn_id, bi2.trunc.[u32](), u8_at(&depths, bi2));
        bi2 = bi2 +% 1_usize;
    }

    work.destroy(alloc);
    body.destroy(alloc);
    hdrs.destroy(alloc);
    is_hdr.destroy(alloc);
    depths.destroy(alloc);
    return;
}

// ===========================================================================
// Section 2: Pass 1 — Mem2Reg (Slot-to-SSA Promotion)
// ===========================================================================

fn is_mem2reg_scalar_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    let sz = env.x64_layout(ty).size;
    let n = env.get(ty);
    if n.kind == .Vec && (sz == 16_usize || sz == 32_usize) {
        let en = env.get(n.primary);
        if en.kind == .Bool {
            return true;
        }
        if en.kind == .Int && en.u8_val <= 64_u8 {
            return true;
        }
        if en.kind == .Float && en.u8_val >= 32_u8 {
            return true;
        }
        return false;
    }
    if sz == 0_usize || sz > 8_usize {
        return false;
    }
    match n.kind {
        .Bool => { return true; }
        .Char => { return true; }
        .Int => { return n.u8_val <= 64_u8; }
        .Float => { return true; }
        .Enum => { return true; }
        .PhysAddr => { return true; }
        .VirtAddr => { return true; }
        .DmaAddr => { return true; }
        .RawPtr => { return true; }
        .FnPtr => { return true; }
        .ErrorSet => { return true; }
        .Bitfield => { return true; }
        .Borrow => { return n.borrow_kind == .Single; }
        .Optional => {
            return env.opt_niche(n.primary).kind != .None;
        }
        .Builtin => {
            return n.builtin_kind == .IdBrand
                || n.builtin_kind == .GenId
                || n.builtin_kind == .Link
                || n.builtin_kind == .Ordering;
        }
        _ => { return false; }
    }
}

struct Mem2RegPhi {
    slot: eir.EirSlot;
    bb: eir.BlockId;
    dst: eir.EirValue;
    ty: types.TyId;
    inc_head: u32;
}

struct Mem2RegPhiInNode {
    pred_bb: eir.BlockId;
    val: eir.EirValue;
    next: u32;
}

struct Mem2RegFrame {
    bb: eir.BlockId;
    child_cur: u32;
    entered: bool;
    push_mark: usize;
}

struct Mem2RegStackNode {
    val: eir.EirValue;
    prev: u32;
}

fn mem2reg_disqualify_inst(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    inst: *eir.EirInst,
    nslots: usize,
    promotable: *mut col.BitSet,
    single_ok: *mut col.BitSet,
    store_cnt: *mut col.DynBuf[u32],
    store_bb: *mut col.DynBuf[u32],
    store_pos: *mut col.DynBuf[u32],
    store_val: *mut col.DynBuf[u32],
    bb: eir.BlockId,
    pos: u32,
) {
    match inst.kind {
        .SlotAddr => {
            let su = inst.aux0.widen.[usize]();
            if su < nslots {
                promotable.unset(su);
                single_ok.unset(su);
            }
        }
        .LoadSlot => {
            let su = inst.aux0.widen.[usize]();
            if su < nslots {
                if let si = eir_prog.fn_slot(fn_id, inst.aux0) {
                    if eir_prog.fn_val_ty(fn_id, inst.dst) != si.ty {
                        promotable.unset(su);
                        single_ok.unset(su);
                    }
                }
            }
        }
        .StoreSlot => {
            let su = inst.aux0.widen.[usize]();
            if su < nslots {
                if let si = eir_prog.fn_slot(fn_id, inst.aux0) {
                    if eir_prog.fn_val_ty(fn_id, inst.v0) != si.ty {
                        promotable.unset(su);
                        single_ok.unset(su);
                    }
                }
                let c = u32_at(store_cnt, su) +% 1_u32;
                u32_set(store_cnt, su, c);
                u32_set(store_bb, su, bb);
                u32_set(store_pos, su, pos);
                u32_set(store_val, su, inst.v0);
            }
        }
        .LoadPlace => {
            if let pl = eir_prog.get_place(inst.aux0) {
                if pl.base.kind == .Slot {
                    let su = pl.base.id.widen.[usize]();
                    if su < nslots {
                        promotable.unset(su);
                        single_ok.unset(su);
                    }
                }
            }
        }
        .StorePlace => {
            if let pl = eir_prog.get_place(inst.aux0) {
                if pl.base.kind == .Slot {
                    let su = pl.base.id.widen.[usize]();
                    if su < nslots {
                        promotable.unset(su);
                        single_ok.unset(su);
                    }
                }
            }
        }
        .PlaceAddr => {
            if let pl = eir_prog.get_place(inst.aux0) {
                if pl.base.kind == .Slot {
                    let su = pl.base.id.widen.[usize]();
                    if su < nslots {
                        promotable.unset(su);
                        single_ok.unset(su);
                    }
                }
            }
        }
        .PoolColumnLoad => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Slot {
                    let su = op.pool_base.id.widen.[usize]();
                    if su < nslots {
                        promotable.unset(su);
                        single_ok.unset(su);
                    }
                }
            }
        }
        .PoolColumnStore => {
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Slot {
                    let su = op.pool_base.id.widen.[usize]();
                    if su < nslots {
                        promotable.unset(su);
                        single_ok.unset(su);
                    }
                }
            }
        }
        .BuiltinCall => {
            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                if !builtin_ignores_arg_slots(bc.op.kind) {
                    let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                    var ki: usize = 0_usize;
                    while ki < ss.len {
                        if ss[ki] != eir.EIR_NONE && builtin_uses_arg_slot_at(bc.op.kind, ki) {
                            let su = ss[ki].widen.[usize]();
                            if su < nslots {
                                promotable.unset(su);
                                single_ok.unset(su);
                            }
                        }
                        ki = ki +% 1_usize;
                    }
                }
            }
            _ = 0_u8;
        }
        _ => {}
    }
}

fn find_const_lane_in_fn(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    v: eir.EirValue,
    max_lanes: u32,
) -> u32 {
    if v == eir.EIR_NONE {
        return eir.EIR_NONE;
    }
    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let insts = eir_prog.block_insts(fn_id, rpo[ri]);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.dst == v && inst.kind == .Const {
                if let kc = eir_prog.get_const(inst.aux0) {
                    if kc.kind == .Int && kc.int_val.hi == 0_i64 && kc.int_val.lo < max_lanes.widen.[u64]() {
                        return kc.int_val.lo.trunc.[u32]();
                    }
                }
                return eir.EIR_NONE;
            }
            ii = ii +% 1_usize;
        }
        ri = ri +% 1_usize;
    }
    return eir.EIR_NONE;
}

/// Rewrites `LoadPlace(Slot(s), [Field(lane)])` and `LoadPlace(Slot(s), [Index(const lane)])`
/// on non-escaping `.Vec` slots into `tmp = LoadSlot(s); dst = FieldExtract(tmp, lane)` so
/// `mem2reg` promotes the vector to an SSA XMM/YMM register and unlocks `VSqrtPS` / `VShufPS` fusion.
fn rewrite_vec_field_loads_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    nslots: usize,
) -> !OutOfMemory {
    var cand = try col.BitSet.init(alloc, nslots);
    errdefer cand.destroy(alloc);
    var has_field_load = try col.BitSet.init(alloc, nslots);
    errdefer has_field_load.destroy(alloc);

    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < nslots && si < slots.len {
        let sty = slots[si].ty;
        if env.get(sty).kind == .Vec && is_mem2reg_scalar_ty(env, sty) {
            cand.set(si);
        }
        si = si +% 1_usize;
    }

    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bb = rpo[ri];
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            match inst.kind {
                .SlotAddr => {
                    let su = inst.aux0.widen.[usize]();
                    if su < nslots { cand.unset(su); }
                }
                .StorePlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                            cand.unset(pl.base.id.widen.[usize]());
                        }
                    }
                    _ = 0_u8;
                }
                .PlaceAddr => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                            cand.unset(pl.base.id.widen.[usize]());
                        }
                    }
                    _ = 0_u8;
                }
                .LoadPlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots && cand.test(su) {
                                let ps = eir_prog.projs_slice(pl.projs);
                                var ok_lane = false;
                                if ps.len == 1_usize {
                                    if ps[0_usize].kind == .Field {
                                        ok_lane = true;
                                    } else if ps[0_usize].kind == .Index && su < slots.len {
                                        let vlanes = env.get(slots[su].ty).u8_val.widen.[u32]();
                                        if find_const_lane_in_fn(eir_prog, fn_id, ps[0_usize].index, vlanes) != eir.EIR_NONE {
                                            ok_lane = true;
                                        }
                                    }
                                }
                                if ok_lane {
                                    has_field_load.set(su);
                                } else {
                                    cand.unset(su);
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .BuiltinCall => {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        if !builtin_ignores_arg_slots(bc.op.kind) {
                            let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                            var ki: usize = 0_usize;
                            while ki < ss.len {
                                if ss[ki] != eir.EIR_NONE && ss[ki].widen.[usize]() < nslots {
                                    cand.unset(ss[ki].widen.[usize]());
                                }
                                ki = ki +% 1_usize;
                            }
                        }
                    }
                    _ = 0_u8;
                }
                _ => {}
            }
            ii = ii +% 1_usize;
        }
        ri = ri +% 1_usize;
    }

    var any = false;
    si = 0_usize;
    while si < nslots {
        if cand.test(si) && has_field_load.test(si) {
            any = true;
            break;
        }
        si = si +% 1_usize;
    }
    if !any {
        has_field_load.destroy(alloc);
        cand.destroy(alloc);
        return;
    }

    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);

    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        rpo_r = f.rpo;
    }
    var r2: u32 = 0_u32;
    while r2 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r2).widen.[usize]()) {
            bb = bp.*;
        }
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            insts_r = blk.insts;
        }
        new_insts.clear();
        new_flags.clear();
        var changed = false;
        var ii: u32 = 0_u32;
        while ii < insts_r.len {
            let gid = insts_r.start +% ii;
            var did_rw = false;
            var inst = eir.inst_zero(span.span_dummy(), .Copy);
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                inst = ip.*;
            }
            var rw_slot: eir.EirSlot = eir.EIR_NONE;
            var rw_lane: u32 = 0_u32;
            if inst.kind == .LoadPlace {
                if let pl = eir_prog.get_place(inst.aux0) {
                    if pl.base.kind == .Slot {
                        let su = pl.base.id.widen.[usize]();
                        if su < nslots && cand.test(su) && has_field_load.test(su) {
                            let ps = eir_prog.projs_slice(pl.projs);
                            if ps.len == 1_usize && ps[0_usize].kind == .Field {
                                rw_slot = pl.base.id;
                                rw_lane = ps[0_usize].index;
                            } else if ps.len == 1_usize && ps[0_usize].kind == .Index {
                                if let sinfo = eir_prog.fn_slot(fn_id, pl.base.id) {
                                    let vlanes = env.get(sinfo.ty).u8_val.widen.[u32]();
                                    let kl = find_const_lane_in_fn(eir_prog, fn_id, ps[0_usize].index, vlanes);
                                    if kl != eir.EIR_NONE {
                                        rw_slot = pl.base.id;
                                        rw_lane = kl;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if rw_slot != eir.EIR_NONE {
                var sty = types.TY_VOID;
                if let sinfo = eir_prog.fn_slot(fn_id, rw_slot) {
                    sty = sinfo.ty;
                }
                let tmp_v = try eir_prog.alloc_fn_value(alloc, fn_id, sty);
                var ld = eir.inst_zero(inst.span, .LoadSlot);
                ld.dst = tmp_v;
                ld.ty0 = sty;
                ld.aux0 = rw_slot;
                try new_insts.push(alloc, ld);
                try new_flags.push(alloc, 0_u8);

                var ext = eir.inst_zero(inst.span, .FieldExtract);
                ext.dst = inst.dst;
                ext.v0 = tmp_v;
                ext.ty0 = eir_prog.fn_val_ty(fn_id, inst.dst);
                ext.ty1 = sty;
                ext.aux0 = rw_lane;
                try new_insts.push(alloc, ext);
                try new_flags.push(alloc, 0_u8);
                did_rw = true;
                changed = true;
            }
            if !did_rw {
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, eir_prog.inst_proven_flags(gid));
            }
            ii = ii +% 1_u32;
        }
        if changed {
            try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
        }
        r2 = r2 +% 1_u32;
    }

    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    has_field_load.destroy(alloc);
    cand.destroy(alloc);
    return;
}

/// Promotes non-escaping pointer-to-pool parameter/local slots (`*ArenaPool`, `*mut ArenaPool`,
/// `*SlotPool`, `*mut SlotPool`) out of `PoolColumnLoad`/`PoolColumnStore` (`pool_base = Slot(s),
/// pool_is_ptr = true`) and `BuiltinCall` `arg_slots` into `LoadSlot(s)` SSA values so `mem2reg`
/// keeps the pool pointer in a single register across the entire function!
fn rewrite_pool_ptr_slot_ops_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    nslots: usize,
) -> !OutOfMemory {
    var cand = try col.BitSet.init(alloc, nslots);
    errdefer cand.destroy(alloc);
    var has_rw = try col.BitSet.init(alloc, nslots);
    errdefer has_rw.destroy(alloc);

    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < nslots && si < slots.len {
        let sty = slots[si].ty;
        let sn = env.get(sty);
        let is_single_ptr = (sn.kind == .Borrow && sn.borrow_kind == .Single && env.get(sn.primary).kind != .Pool)
            || sn.kind == .RawPtr;
        if is_single_ptr && is_mem2reg_scalar_ty(env, sty) {
            cand.set(si);
        }
        si = si +% 1_usize;
    }

    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bb = rpo[ri];
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            match inst.kind {
                .SlotAddr => {
                    let su = inst.aux0.widen.[usize]();
                    if su < nslots { cand.unset(su); }
                }
                .LoadPlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots && cand.test(su) {
                                let ps = eir_prog.projs_slice(pl.projs);
                                if ps.len > 0_usize {
                                    has_rw.set(su);
                                } else {
                                    cand.unset(su);
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .StorePlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots && cand.test(su) {
                                let ps = eir_prog.projs_slice(pl.projs);
                                if ps.len > 0_usize {
                                    has_rw.set(su);
                                } else {
                                    cand.unset(su);
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .PlaceAddr => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots && cand.test(su) {
                                let ps = eir_prog.projs_slice(pl.projs);
                                if ps.len > 0_usize {
                                    has_rw.set(su);
                                } else {
                                    cand.unset(su);
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .PoolColumnLoad => {
                    if let op = eir_prog.get_pool_col_op(inst.aux0) {
                        if op.pool_base.kind == .Slot {
                            let su = op.pool_base.id.widen.[usize]();
                            if su < nslots && cand.test(su) {
                                if op.pool_is_ptr {
                                    has_rw.set(su);
                                } else {
                                    cand.unset(su);
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .PoolColumnStore => {
                    if let op = eir_prog.get_pool_col_op(inst.aux0) {
                        if op.pool_base.kind == .Slot {
                            let su = op.pool_base.id.widen.[usize]();
                            if su < nslots && cand.test(su) {
                                if op.pool_is_ptr {
                                    has_rw.set(su);
                                } else {
                                    cand.unset(su);
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .BuiltinCall => {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        if !builtin_ignores_arg_slots(bc.op.kind) {
                            let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                            let args = eir_prog.vals_slice(bc.args);
                            var ki: usize = 0_usize;
                            while ki < ss.len {
                                if ss[ki] != eir.EIR_NONE && builtin_uses_arg_slot_at(bc.op.kind, ki) {
                                    let su = ss[ki].widen.[usize]();
                                    if su < nslots && cand.test(su) {
                                        if ki < args.len && args[ki] != eir.EIR_NONE
                                            && su < slots.len
                                            && eir_prog.fn_val_ty(fn_id, args[ki]) == slots[su].ty
                                        {
                                            has_rw.set(su);
                                        } else {
                                            cand.unset(su);
                                        }
                                    }
                                }
                                ki = ki +% 1_usize;
                            }
                        }
                    }
                    _ = 0_u8;
                }
                _ => {}
            }
            ii = ii +% 1_usize;
        }
        ri = ri +% 1_usize;
    }

    var any = false;
    si = 0_usize;
    while si < nslots {
        if cand.test(si) && has_rw.test(si) {
            any = true;
            break;
        }
        si = si +% 1_usize;
    }
    if !any {
        has_rw.destroy(alloc);
        cand.destroy(alloc);
        return;
    }

    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);
    var tmp_slots = try col.DynBuf.[eir.EirSlot].init(alloc, 4_usize);
    errdefer tmp_slots.destroy(alloc);

    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        rpo_r = f.rpo;
    }
    var r2: u32 = 0_u32;
    while r2 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r2).widen.[usize]()) {
            bb = bp.*;
        }
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            insts_r = blk.insts;
        }
        new_insts.clear();
        new_flags.clear();
        var changed = false;
        var ii: u32 = 0_u32;
        while ii < insts_r.len {
            let gid = insts_r.start +% ii;
            var inst = eir.inst_zero(span.span_dummy(), .Copy);
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                inst = ip.*;
            }
            let fl = eir_prog.inst_proven_flags(gid);
            if inst.kind == .LoadPlace || inst.kind == .StorePlace || inst.kind == .PlaceAddr {
                var rw_slot = eir.EIR_NONE;
                var pl_copy = eir.EirPlace.{
                    base: eir.place_base_slot(0_u32),
                    projs: ast.range_empty(),
                    ty: types.TY_VOID,
                };
                if let pl_p = eir_prog.get_place(inst.aux0) {
                    if pl_p.base.kind == .Slot {
                        let su = pl_p.base.id.widen.[usize]();
                        let ps = eir_prog.projs_slice(pl_p.projs);
                        if su < nslots && cand.test(su) && has_rw.test(su) && ps.len > 0_usize {
                            rw_slot = pl_p.base.id;
                            pl_copy = pl_p.*;
                        }
                    }
                }
                if rw_slot != eir.EIR_NONE {
                    var sty = types.TY_VOID;
                    if let sinfo = eir_prog.fn_slot(fn_id, rw_slot) {
                        sty = sinfo.ty;
                    }
                    let tmp_v = try eir_prog.alloc_fn_value(alloc, fn_id, sty);
                    var ld = eir.inst_zero(inst.span, .LoadSlot);
                    ld.dst = tmp_v;
                    ld.ty0 = sty;
                    ld.aux0 = rw_slot;
                    try new_insts.push(alloc, ld);
                    try new_flags.push(alloc, 0_u8);

                    pl_copy.base = eir.place_base_val(tmp_v);
                    inst.aux0 = try eir_prog.push_place(alloc, pl_copy);
                    try new_insts.push(alloc, inst);
                    try new_flags.push(alloc, fl);
                    changed = true;
                } else {
                    try new_insts.push(alloc, inst);
                    try new_flags.push(alloc, fl);
                }
            } else if inst.kind == .PoolColumnLoad || inst.kind == .PoolColumnStore {
                var rw_slot = eir.EIR_NONE;
                var op_copy = eir.EirPoolColOp.{
                    pool_base: eir.place_base_slot(0_u32),
                    pool_is_ptr: false,
                    is_slot_pool: false,
                    col: 0_u32,
                    col_idx: 0_u32,
                    index: eir.EIR_NONE,
                    elem_ty: types.TY_VOID,
                };
                if let op_p = eir_prog.get_pool_col_op(inst.aux0) {
                    if op_p.pool_base.kind == .Slot && op_p.pool_is_ptr {
                        let su = op_p.pool_base.id.widen.[usize]();
                        if su < nslots && cand.test(su) && has_rw.test(su) {
                            rw_slot = op_p.pool_base.id;
                            op_copy = op_p.*;
                        }
                    }
                }
                if rw_slot != eir.EIR_NONE {
                    var sty = types.TY_VOID;
                    if let sinfo = eir_prog.fn_slot(fn_id, rw_slot) {
                        sty = sinfo.ty;
                    }
                    let tmp_v = try eir_prog.alloc_fn_value(alloc, fn_id, sty);
                    var ld = eir.inst_zero(inst.span, .LoadSlot);
                    ld.dst = tmp_v;
                    ld.ty0 = sty;
                    ld.aux0 = rw_slot;
                    try new_insts.push(alloc, ld);
                    try new_flags.push(alloc, 0_u8);

                    op_copy.pool_base = eir.place_base_val(tmp_v);
                    inst.aux0 = try eir_prog.push_pool_col_op(alloc, op_copy);
                    try new_insts.push(alloc, inst);
                    try new_flags.push(alloc, fl);
                    changed = true;
                } else {
                    try new_insts.push(alloc, inst);
                    try new_flags.push(alloc, fl);
                }
            } else if inst.kind == .BuiltinCall {
                var need_rw = false;
                var bc_copy = eir.EirBuiltinCallData.{
                    op: cfg_ir.builtin_op_simple(.SliceLen),
                    args: ast.range_empty(),
                    arg_slots: ast.range_empty(),
                    ret_ty: types.TY_VOID,
                };
                if let bc_p = eir_prog.get_builtin_call(inst.aux0) {
                    if !builtin_ignores_arg_slots(bc_p.op.kind) {
                        let ss = eir_prog.arg_slots_slice(bc_p.arg_slots);
                        var ki: usize = 0_usize;
                        while ki < ss.len {
                            if ss[ki] != eir.EIR_NONE && builtin_uses_arg_slot_at(bc_p.op.kind, ki) {
                                let su = ss[ki].widen.[usize]();
                                if su < nslots && cand.test(su) && has_rw.test(su) {
                                    need_rw = true;
                                    bc_copy = bc_p.*;
                                    break;
                                }
                            }
                            ki = ki +% 1_usize;
                        }
                    }
                }
                if need_rw {
                    tmp_slots.clear();
                    let ss = eir_prog.arg_slots_slice(bc_copy.arg_slots);
                    var ki: usize = 0_usize;
                    while ki < ss.len {
                        let s0 = ss[ki];
                        if s0 != eir.EIR_NONE && builtin_uses_arg_slot_at(bc_copy.op.kind, ki) {
                            let su = s0.widen.[usize]();
                            if su < nslots && cand.test(su) && has_rw.test(su) {
                                try tmp_slots.push(alloc, eir.EIR_NONE);
                            } else {
                                try tmp_slots.push(alloc, s0);
                            }
                        } else {
                            try tmp_slots.push(alloc, s0);
                        }
                        ki = ki +% 1_usize;
                    }
                    bc_copy.arg_slots = try eir_prog.append_arg_slots(alloc, tmp_slots.as_slice());
                    inst.aux0 = try eir_prog.push_builtin_call(alloc, bc_copy);
                    changed = true;
                }
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            } else {
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            }
            ii = ii +% 1_u32;
        }
        if changed {
            try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
        }
        r2 = r2 +% 1_u32;
    }

    tmp_slots.destroy(alloc);
    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    has_rw.destroy(alloc);
    cand.destroy(alloc);
    return;
}

fn mem2reg_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> u64 ! OutOfMemory {
    var nslots: usize = 0_usize;
    var nblks: usize = 0_usize;
    var entry: eir.BlockId = 0_u32;
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) {
            return 0_u64;
        }
        nslots = f.slots.len.widen.[usize]();
        nblks = f.blocks.len.widen.[usize]();
        entry = f.entry;
    } else {
        return 0_u64;
    }
    if nslots == 0_usize || nblks == 0_usize {
        return 0_u64;
    }

    try rewrite_vec_field_loads_fn(alloc, eir_prog, fn_id, env, nslots);
    try rewrite_pool_ptr_slot_ops_fn(alloc, eir_prog, fn_id, env, nslots);

    var par_slots = try col.BitSet.init(alloc, nslots);
    errdefer par_slots.destroy(alloc);
    collect_par_for_slots(eir_prog, fn_id, &mut par_slots);

    // `promotable`: scalar slots eligible for full SSA construction (with Phis).
    // `single_ok`: ANY non-escaping slot (including 16-byte slices/structs) eligible for single-def promotion.
    var promotable = try col.BitSet.init(alloc, nslots);
    errdefer promotable.destroy(alloc);
    var single_ok = try col.BitSet.init(alloc, nslots);
    errdefer single_ok.destroy(alloc);
    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < nslots && si < slots.len {
        if !par_slots.test(si) {
            single_ok.set(si);
            if is_mem2reg_scalar_ty(env, slots[si].ty) {
                promotable.set(si);
            }
        }
        si = si +% 1_usize;
    }

    var store_cnt = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer store_cnt.destroy(alloc);
    var store_bb = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer store_bb.destroy(alloc);
    var store_pos = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer store_pos.destroy(alloc);
    var store_val = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer store_val.destroy(alloc);
    try fill_u32(alloc, &mut store_cnt, nslots, 0_u32);
    try fill_u32(alloc, &mut store_bb, nslots, eir.EIR_NONE);
    try fill_u32(alloc, &mut store_pos, nslots, 0_u32);
    try fill_u32(alloc, &mut store_val, nslots, eir.EIR_NONE);

    // Scan all reachable blocks to disqualify escaped slots and count stores.
    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bb = rpo[ri];
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            mem2reg_disqualify_inst(
                eir_prog, fn_id, &inst, nslots,
                &mut promotable, &mut single_ok,
                &mut store_cnt, &mut store_bb, &mut store_pos, &mut store_val,
                bb, ii.trunc.[u32](),
            );
            ii = ii +% 1_usize;
        }
        ri = ri +% 1_usize;
    }

    // Check single-def dominance for slots with store_cnt == 1.
    var single_dom = try col.BitSet.init(alloc, nslots);
    errdefer single_dom.destroy(alloc);
    var si0: usize = 0_usize;
    while si0 < nslots {
        let sc = u32_at(&store_cnt, si0);
        if sc == 0_u32 {
            promotable.unset(si0);
            single_ok.unset(si0);
        } else if sc == 1_u32 && single_ok.test(si0) {
            single_dom.set(si0);
        }
        si0 = si0 +% 1_usize;
    }

    var ri_chk: usize = 0_usize;
    while ri_chk < rpo.len {
        let bb = rpo[ri_chk];
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .LoadSlot {
                let su = inst.aux0.widen.[usize]();
                if su < nslots && single_dom.test(su) {
                    let sbb = u32_at(&store_bb, su);
                    let spos = u32_at(&store_pos, su);
                    if !eir_prog.dominates_block(fn_id, sbb, bb) || (sbb == bb && spos >= ii.trunc.[u32]()) {
                        single_dom.unset(su);
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        ri_chk = ri_chk +% 1_usize;
    }

    // Collect multi-def promotable slots (scalar, promotable, !single_dom).
    var multi_prom = try col.BitSet.init(alloc, nslots);
    errdefer multi_prom.destroy(alloc);
    var promoted_count: u64 = 0_u64;
    var has_multi = false;
    var si1: usize = 0_usize;
    while si1 < nslots {
        if single_dom.test(si1) {
            promoted_count = promoted_count +% 1_u64;
        } else if promotable.test(si1) {
            multi_prom.set(si1);
            has_multi = true;
            promoted_count = promoted_count +% 1_u64;
        }
        si1 = si1 +% 1_usize;
    }

    if promoted_count == 0_u64 {
        multi_prom.destroy(alloc);
        single_dom.destroy(alloc);
        store_val.destroy(alloc);
        store_pos.destroy(alloc);
        store_bb.destroy(alloc);
        store_cnt.destroy(alloc);
        single_ok.destroy(alloc);
        promotable.destroy(alloc);
        par_slots.destroy(alloc);
        return 0_u64;
    }

    // Fast path: only single-def dominating slots (no Phis needed!).
    if !has_multi {
        var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
        errdefer new_insts.destroy(alloc);
        var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
        errdefer new_flags.destroy(alloc);

        var rpo_r = ast.range_empty();
        if let f = eir_prog.get_fn(fn_id) {
            rpo_r = f.rpo;
        }
        var r2: u32 = 0_u32;
        while r2 < rpo_r.len {
            var bb: eir.BlockId = 0_u32;
            if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r2).widen.[usize]()) {
                bb = bp.*;
            }
            var insts_r = ast.range_empty();
            if let blk = eir_prog.fn_block(fn_id, bb) {
                insts_r = blk.insts;
            }
            new_insts.clear();
            new_flags.clear();
            var changed = false;
            var ii: u32 = 0_u32;
            while ii < insts_r.len {
                let gid = insts_r.start +% ii;
                if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                    let inst = ip.*;
                    if inst.kind == .StoreSlot && single_dom.test(inst.aux0.widen.[usize]()) {
                        changed = true;
                    } else if inst.kind == .LoadSlot && single_dom.test(inst.aux0.widen.[usize]()) {
                        let sv = u32_at(&store_val, inst.aux0.widen.[usize]());
                        var cpy = eir.inst_zero(inst.span, .Copy);
                        cpy.dst = inst.dst;
                        cpy.v0 = sv;
                        try new_insts.push(alloc, cpy);
                        try new_flags.push(alloc, 0_u8);
                        changed = true;
                    } else {
                        try new_insts.push(alloc, inst);
                        try new_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                    }
                }
                ii = ii +% 1_u32;
            }
            if changed {
                try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
            }
            r2 = r2 +% 1_u32;
        }
        _ = try eliminate_copies_fn(alloc, eir_prog, fn_id);
        new_flags.destroy(alloc);
        new_insts.destroy(alloc);
        multi_prom.destroy(alloc);
        single_dom.destroy(alloc);
        store_val.destroy(alloc);
        store_pos.destroy(alloc);
        store_bb.destroy(alloc);
        store_cnt.destroy(alloc);
        single_ok.destroy(alloc);
        promotable.destroy(alloc);
        par_slots.destroy(alloc);
        return promoted_count;
    }

    // General path: Cytron Dominance-Frontier SSA construction for multi_prom + single_dom.
    try mem2reg_cytron_ssa(
        alloc, eir_prog, fn_id, env, nblks, nslots, entry,
        &single_dom, &multi_prom, &store_val,
    );
    _ = try eliminate_copies_fn(alloc, eir_prog, fn_id);

    multi_prom.destroy(alloc);
    single_dom.destroy(alloc);
    store_val.destroy(alloc);
    store_pos.destroy(alloc);
    store_bb.destroy(alloc);
    store_cnt.destroy(alloc);
    single_ok.destroy(alloc);
    promotable.destroy(alloc);
    par_slots.destroy(alloc);
    return promoted_count;
}

fn mem2reg_cytron_ssa(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    nblks: usize,
    nslots: usize,
    entry: eir.BlockId,
    single_dom: *col.BitSet,
    multi_prom: *col.BitSet,
    store_val: *col.DynBuf[u32],
) -> !OutOfMemory {
    // 1. Compute Dominance Frontiers DF[b] for all reachable blocks.
    var df_head = try col.DynBuf.[u32].init(alloc, nblks);
    errdefer df_head.destroy(alloc);
    try fill_u32(alloc, &mut df_head, nblks, eir.EIR_NONE);
    var df_val = try col.DynBuf.[eir.BlockId].init(alloc, nblks *% 2_usize +% 4_usize);
    errdefer df_val.destroy(alloc);
    var df_next = try col.DynBuf.[u32].init(alloc, nblks *% 2_usize +% 4_usize);
    errdefer df_next.destroy(alloc);

    let rpo_init = eir_prog.fn_rpo(fn_id);
    var r0: usize = 0_usize;
    while r0 < rpo_init.len {
        let b = rpo_init[r0];
        let bpreds = eir_prog.block_preds(fn_id, b);
        if bpreds.len >= 2_usize {
            var b_idom = eir.EIR_NONE;
            if let bp = eir_prog.fn_block(fn_id, b) {
                b_idom = bp.idom;
            }
            var pi: usize = 0_usize;
            while pi < bpreds.len {
                var runner = bpreds[pi];
                var guard: usize = 0_usize;
                while runner != eir.EIR_NONE && runner != b_idom && guard < nblks {
                    let ru = runner.widen.[usize]();
                    if ru >= nblks {
                        break;
                    }
                    // Add `b` to DF[runner] if not already present.
                    var dup = false;
                    var cur = u32_at(&df_head, ru);
                    while cur != eir.EIR_NONE {
                        let cu = cur.widen.[usize]();
                        if u32_at(&df_val, cu) == b {
                            dup = true;
                            break;
                        }
                        cur = u32_at(&df_next, cu);
                    }
                    if !dup {
                        let nid = df_val.len().trunc.[u32]();
                        try df_val.push(alloc, b);
                        try df_next.push(alloc, u32_at(&df_head, ru));
                        u32_set(&mut df_head, ru, nid);
                    }
                    if let rbp = eir_prog.fn_block(fn_id, runner) {
                        if rbp.idom == runner {
                            break;
                        }
                        runner = rbp.idom;
                    } else {
                        break;
                    }
                    guard = guard +% 1_usize;
                }
                pi = pi +% 1_usize;
            }
        }
        r0 = r0 +% 1_usize;
    }

    // 2. Collect per-slot def-block lists for multi_prom slots.
    var sdef_head = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer sdef_head.destroy(alloc);
    try fill_u32(alloc, &mut sdef_head, nslots, eir.EIR_NONE);
    var sdef_bb = try col.DynBuf.[eir.BlockId].init(alloc, nslots *% 2_usize +% 4_usize);
    errdefer sdef_bb.destroy(alloc);
    var sdef_next = try col.DynBuf.[u32].init(alloc, nslots *% 2_usize +% 4_usize);
    errdefer sdef_next.destroy(alloc);

    var r1: usize = 0_usize;
    while r1 < rpo_init.len {
        let bb = rpo_init[r1];
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .StoreSlot {
                let su = inst.aux0.widen.[usize]();
                if su < nslots && multi_prom.test(su) {
                    let head_cur = u32_at(&sdef_head, su);
                    var already = false;
                    if head_cur != eir.EIR_NONE && u32_at(&sdef_bb, head_cur.widen.[usize]()) == bb {
                        already = true;
                    }
                    if !already {
                        let nid = sdef_bb.len().trunc.[u32]();
                        try sdef_bb.push(alloc, bb);
                        try sdef_next.push(alloc, head_cur);
                        u32_set(&mut sdef_head, su, nid);
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        r1 = r1 +% 1_usize;
    }

    // 3. Insert Phis at Iterated Dominance Frontiers.
    var new_phis = try col.DynBuf.[Mem2RegPhi].init(alloc, 16_usize);
    errdefer new_phis.destroy(alloc);
    var blk_phi_head = try col.DynBuf.[u32].init(alloc, nblks);
    errdefer blk_phi_head.destroy(alloc);
    try fill_u32(alloc, &mut blk_phi_head, nblks, eir.EIR_NONE);
    var blk_phi_next = try col.DynBuf.[u32].init(alloc, 16_usize);
    errdefer blk_phi_next.destroy(alloc);

    var has_phi = try col.BitSet.init(alloc, nblks);
    errdefer has_phi.destroy(alloc);
    var in_work = try col.BitSet.init(alloc, nblks);
    errdefer in_work.destroy(alloc);
    var wlist = try col.DynBuf.[eir.BlockId].init(alloc, 16_usize);
    errdefer wlist.destroy(alloc);

    var s_i: usize = 0_usize;
    while s_i < nslots {
        if multi_prom.test(s_i) {
            var sty = types.TY_ERROR;
            if let sp = eir_prog.fn_slot(fn_id, s_i.trunc.[u32]()) {
                sty = sp.ty;
            }
            has_phi.clear();
            in_work.clear();
            wlist.clear();
            var dc = u32_at(&sdef_head, s_i);
            while dc != eir.EIR_NONE {
                let dbb = u32_at(&sdef_bb, dc.widen.[usize]());
                let du = dbb.widen.[usize]();
                if du < nblks && !in_work.test(du) {
                    in_work.set(du);
                    try wlist.push(alloc, dbb);
                }
                dc = u32_at(&sdef_next, dc.widen.[usize]());
            }
            while !wlist.is_empty() {
                let x = wlist.pop() orelse { break; };
                let xu = x.widen.[usize]();
                var fcur = u32_at(&df_head, xu);
                while fcur != eir.EIR_NONE {
                    let y = u32_at(&df_val, fcur.widen.[usize]());
                    let yu = y.widen.[usize]();
                    if yu < nblks && !has_phi.test(yu) {
                        has_phi.set(yu);
                        let phi_dst = try eir_prog.alloc_fn_value(alloc, fn_id, sty);
                        let pid = new_phis.len().trunc.[u32]();
                        try new_phis.push(alloc, Mem2RegPhi.{
                            slot: s_i.trunc.[u32](),
                            bb: y,
                            dst: phi_dst,
                            ty: sty,
                            inc_head: eir.EIR_NONE,
                        });
                        try blk_phi_next.push(alloc, u32_at(&blk_phi_head, yu));
                        u32_set(&mut blk_phi_head, yu, pid);
                        if !in_work.test(yu) {
                            in_work.set(yu);
                            try wlist.push(alloc, y);
                        }
                    }
                    fcur = u32_at(&df_next, fcur.widen.[usize]());
                }
            }
        }
        s_i = s_i +% 1_usize;
    }

    // 4. Dominator-tree iterative preorder DFS renaming.
    let dtree = try DomTree.build(alloc, eir_prog, fn_id);
    errdefer dtree.destroy(alloc);

    var stack_top = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer stack_top.destroy(alloc);
    try fill_u32(alloc, &mut stack_top, nslots, eir.EIR_NONE);
    var stack_nodes = try col.DynBuf.[Mem2RegStackNode].init(alloc, nslots *% 2_usize +% 16_usize);
    errdefer stack_nodes.destroy(alloc);
    var pushed_slots = try col.DynBuf.[eir.EirSlot].init(alloc, 64_usize);
    errdefer pushed_slots.destroy(alloc);

    // Lazy zero-constant fallback in `entry` if any edge/load reads an uninitialized promoted slot.
    var zero_for_slot = try col.DynBuf.[eir.EirValue].init(alloc, nslots);
    errdefer zero_for_slot.destroy(alloc);
    try fill_u32(alloc, &mut zero_for_slot, nslots, eir.EIR_NONE);
    var entry_zeros = try col.DynBuf.[eir.EirInst].init(alloc, 4_usize);
    errdefer entry_zeros.destroy(alloc);

    var phi_in_nodes = try col.DynBuf.[Mem2RegPhiInNode].init(alloc, 32_usize);
    errdefer phi_in_nodes.destroy(alloc);
    var seen_succ = try col.DynBuf.[eir.BlockId].init(alloc, 8_usize);
    errdefer seen_succ.destroy(alloc);
    var tmp_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer tmp_insts.destroy(alloc);
    var tmp_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer tmp_flags.destroy(alloc);

    var dfs = try col.DynBuf.[Mem2RegFrame].init(alloc, 32_usize);
    errdefer dfs.destroy(alloc);
    try dfs.push(alloc, Mem2RegFrame.{
        bb: entry,
        child_cur: u32_at(&dtree.child_head, entry.widen.[usize]()),
        entered: false,
        push_mark: 0_usize,
    });

    while !dfs.is_empty() {
        let top_i = dfs.len() -% 1_usize;
        var fr = Mem2RegFrame.{ bb: 0_u32, child_cur: eir.EIR_NONE, entered: false, push_mark: 0_usize };
        if let fp = dfs.get(top_i) {
            fr = fp.*;
        }
        if !fr.entered {
            let pmark = pushed_slots.len();
            if let fm = dfs.get_mut(top_i) {
                fm.entered = true;
                fm.push_mark = pmark;
            }
            let bb = fr.bb;
            let bu = bb.widen.[usize]();

            // Push new phi defs at top of block.
            var pcur = u32_at(&blk_phi_head, bu);
            while pcur != eir.EIR_NONE {
                let pu = pcur.widen.[usize]();
                if let pp = new_phis.get(pu) {
                    let s = pp.slot;
                    let su = s.widen.[usize]();
                    let nid = stack_nodes.len().trunc.[u32]();
                    try stack_nodes.push(alloc, Mem2RegStackNode.{ val: pp.dst, prev: u32_at(&stack_top, su) });
                    u32_set(&mut stack_top, su, nid);
                    try pushed_slots.push(alloc, s);
                }
                pcur = u32_at(&blk_phi_next, pu);
            }

            // Rewrite LoadSlot / remove StoreSlot in this block.
            var insts_r = ast.range_empty();
            if let blk = eir_prog.fn_block(fn_id, bb) {
                insts_r = blk.insts;
            }
            tmp_insts.clear();
            tmp_flags.clear();
            var bchanged = false;
            var ii: u32 = 0_u32;
            while ii < insts_r.len {
                let gid = insts_r.start +% ii;
                if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                    let inst = ip.*;
                    if inst.kind == .StoreSlot {
                        let su = inst.aux0.widen.[usize]();
                        if su < nslots && single_dom.test(su) {
                            bchanged = true;
                        } else if su < nslots && multi_prom.test(su) {
                            let nid = stack_nodes.len().trunc.[u32]();
                            try stack_nodes.push(alloc, Mem2RegStackNode.{ val: inst.v0, prev: u32_at(&stack_top, su) });
                            u32_set(&mut stack_top, su, nid);
                            try pushed_slots.push(alloc, inst.aux0);
                            bchanged = true;
                        } else {
                            try tmp_insts.push(alloc, inst);
                            try tmp_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                        }
                    } else if inst.kind == .LoadSlot {
                        let su = inst.aux0.widen.[usize]();
                        if su < nslots && single_dom.test(su) {
                            var cpy = eir.inst_zero(inst.span, .Copy);
                            cpy.dst = inst.dst;
                            cpy.v0 = u32_at(store_val, su);
                            try tmp_insts.push(alloc, cpy);
                            try tmp_flags.push(alloc, 0_u8);
                            bchanged = true;
                        } else if su < nslots && multi_prom.test(su) {
                            let rv = try mem2reg_peek_or_zero(
                                alloc, eir_prog, fn_id, env, inst.aux0,
                                &stack_top, &stack_nodes, &mut zero_for_slot, &mut entry_zeros, inst.span,
                            );
                            var cpy = eir.inst_zero(inst.span, .Copy);
                            cpy.dst = inst.dst;
                            cpy.v0 = rv;
                            try tmp_insts.push(alloc, cpy);
                            try tmp_flags.push(alloc, 0_u8);
                            bchanged = true;
                        } else {
                            try tmp_insts.push(alloc, inst);
                            try tmp_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                        }
                    } else {
                        try tmp_insts.push(alloc, inst);
                        try tmp_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                    }
                }
                ii = ii +% 1_u32;
            }
            if bchanged {
                try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, tmp_insts.as_slice(), tmp_flags.as_slice());
            }

            // Populate incoming edges for newly inserted phis in unique successors.
            seen_succ.clear();
            var term = eir.term_unreachable(span.span_dummy(), false);
            if let blk = eir_prog.fn_block(fn_id, bb) {
                term = blk.term;
            }
            let sc = eir_prog.term_successor_count(&term);
            var sci: usize = 0_usize;
            while sci < sc {
                let succ = eir_prog.term_successor_at(&term, sci);
                let su_b = succ.widen.[usize]();
                var dup_s = false;
                let sssl = seen_succ.as_slice();
                var ki: usize = 0_usize;
                while ki < sssl.len {
                    if sssl[ki] == succ {
                        dup_s = true;
                        break;
                    }
                    ki = ki +% 1_usize;
                }
                if !dup_s && succ != eir.EIR_NONE && su_b < nblks {
                    try seen_succ.push(alloc, succ);
                    var spcur = u32_at(&blk_phi_head, su_b);
                    while spcur != eir.EIR_NONE {
                        let spu = spcur.widen.[usize]();
                        var p_slot: eir.EirSlot = 0_u32;
                        var p_head = eir.EIR_NONE;
                        if let pp = new_phis.get(spu) {
                            p_slot = pp.slot;
                            p_head = pp.inc_head;
                        }
                        let rv = try mem2reg_peek_or_zero(
                            alloc, eir_prog, fn_id, env, p_slot,
                            &stack_top, &stack_nodes, &mut zero_for_slot, &mut entry_zeros, span.span_dummy(),
                        );
                        let in_id = phi_in_nodes.len().trunc.[u32]();
                        try phi_in_nodes.push(alloc, Mem2RegPhiInNode.{
                            pred_bb: bb,
                            val: rv,
                            next: p_head,
                        });
                        if let ppm = new_phis.get_mut(spu) {
                            ppm.inc_head = in_id;
                        }
                        spcur = u32_at(&blk_phi_next, spu);
                    }
                }
                sci = sci +% 1_usize;
            }
        } else if fr.child_cur != eir.EIR_NONE {
            let child = fr.child_cur;
            let next_c = u32_at(&dtree.child_next, child.widen.[usize]());
            if let fm = dfs.get_mut(top_i) {
                fm.child_cur = next_c;
            }
            try dfs.push(alloc, Mem2RegFrame.{
                bb: child,
                child_cur: u32_at(&dtree.child_head, child.widen.[usize]()),
                entered: false,
                push_mark: 0_usize,
            });
        } else {
            // Pop all defs pushed by this block.
            while pushed_slots.len() > fr.push_mark {
                let s = pushed_slots.pop() orelse { break; };
                let su = s.widen.[usize]();
                let top_n = u32_at(&stack_top, su);
                if top_n != eir.EIR_NONE {
                    if let sn = stack_nodes.get(top_n.widen.[usize]()) {
                        u32_set(&mut stack_top, su, sn.prev);
                    }
                }
            }
            _ = dfs.pop();
        }
    }

    // 5. Prepend any lazy zero constants to `entry`.
    if !entry_zeros.is_empty() {
        tmp_insts.clear();
        tmp_flags.clear();
        let ezs = entry_zeros.as_slice();
        var ei: usize = 0_usize;
        while ei < ezs.len {
            try tmp_insts.push(alloc, ezs[ei]);
            try tmp_flags.push(alloc, 0_u8);
            ei = ei +% 1_usize;
        }
        var einsts_r = ast.range_empty();
        if let eblk = eir_prog.fn_block(fn_id, entry) {
            einsts_r = eblk.insts;
        }
        var ii: u32 = 0_u32;
        while ii < einsts_r.len {
            let gid = einsts_r.start +% ii;
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                try tmp_insts.push(alloc, ip.*);
                try tmp_flags.push(alloc, eir_prog.inst_proven_flags(gid));
            }
            ii = ii +% 1_u32;
        }
        try eir_prog.replace_block_insts_reuse(alloc, fn_id, entry, tmp_insts.as_slice(), tmp_flags.as_slice());
    }

    // 6. Commit newly built Phis onto each block (preserving existing Phis).
    var merged_phis = try col.DynBuf.[eir.EirPhi].init(alloc, 8_usize);
    errdefer merged_phis.destroy(alloc);
    var inc_buf = try col.DynBuf.[eir.EirPhiIn].init(alloc, 8_usize);
    errdefer inc_buf.destroy(alloc);

    var bi: usize = 0_usize;
    while bi < nblks {
        let phead = u32_at(&blk_phi_head, bi);
        if phead != eir.EIR_NONE {
            let bb = bi.trunc.[u32]();
            merged_phis.clear();
            var old_pr = ast.range_empty();
            if let blk = eir_prog.fn_block(fn_id, bb) {
                old_pr = blk.phis;
            }
            var oi: u32 = 0_u32;
            while oi < old_pr.len {
                if let op = eir_prog.funcs.phis.get((old_pr.start +% oi).widen.[usize]()) {
                    try merged_phis.push(alloc, op.*);
                }
                oi = oi +% 1_u32;
            }
            var pc = phead;
            while pc != eir.EIR_NONE {
                let pu = pc.widen.[usize]();
                if let np = new_phis.get(pu) {
                    inc_buf.clear();
                    var ic = np.inc_head;
                    while ic != eir.EIR_NONE {
                        if let node = phi_in_nodes.get(ic.widen.[usize]()) {
                            try inc_buf.push(alloc, eir.EirPhiIn.{ pred_bb: node.pred_bb, val: node.val });
                            ic = node.next;
                        } else {
                            break;
                        }
                    }
                    let ir = try eir_prog.append_phi_incoming(alloc, inc_buf.as_slice());
                    try merged_phis.push(alloc, eir.EirPhi.{ dst: np.dst, ty: np.ty, incoming: ir });
                }
                pc = u32_at(&blk_phi_next, pu);
            }
            let pr = try eir_prog.append_phis(alloc, merged_phis.as_slice());
            if let bm = eir_prog.fn_block_mut(fn_id, bb) {
                bm.phis = pr;
            }
        }
        bi = bi +% 1_usize;
    }

    inc_buf.destroy(alloc);
    merged_phis.destroy(alloc);
    dfs.destroy(alloc);
    tmp_flags.destroy(alloc);
    tmp_insts.destroy(alloc);
    seen_succ.destroy(alloc);
    phi_in_nodes.destroy(alloc);
    entry_zeros.destroy(alloc);
    zero_for_slot.destroy(alloc);
    pushed_slots.destroy(alloc);
    stack_nodes.destroy(alloc);
    stack_top.destroy(alloc);
    dtree.destroy(alloc);
    wlist.destroy(alloc);
    in_work.destroy(alloc);
    has_phi.destroy(alloc);
    blk_phi_next.destroy(alloc);
    blk_phi_head.destroy(alloc);
    new_phis.destroy(alloc);
    sdef_next.destroy(alloc);
    sdef_bb.destroy(alloc);
    sdef_head.destroy(alloc);
    df_next.destroy(alloc);
    df_val.destroy(alloc);
    df_head.destroy(alloc);
    return;
}

fn mem2reg_peek_or_zero(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    slot: eir.EirSlot,
    stack_top: *col.DynBuf[u32],
    stack_nodes: *col.DynBuf[Mem2RegStackNode],
    zero_for_slot: *mut col.DynBuf[eir.EirValue],
    entry_zeros: *mut col.DynBuf[eir.EirInst],
    sp: span.Span,
) -> eir.EirValue ! OutOfMemory {
    let su = slot.widen.[usize]();
    let top_n = u32_at(stack_top, su);
    if top_n != eir.EIR_NONE {
        if let sn = stack_nodes.get(top_n.widen.[usize]()) {
            return sn.val;
        }
    }
    let existing = u32_at(zero_for_slot, su);
    if existing != eir.EIR_NONE {
        return existing;
    }
    var sty = types.TY_U64;
    if let si = eir_prog.fn_slot(fn_id, slot) {
        sty = si.ty;
    }
    let sn = env.get(sty);
    if sn.kind == .Vec {
        let elem_ty = sn.primary;
        let z_elem = try eir_prog.alloc_fn_value(alloc, fn_id, elem_ty);
        let z_einst = try make_typed_zero_const(alloc, eir_prog, env, elem_ty, z_elem, sp);
        try entry_zeros.push(alloc, z_einst);

        let zv = try eir_prog.alloc_fn_value(alloc, fn_id, sty);
        var bop = cfg_ir.builtin_op_simple(.VecSplat);
        bop.ty0 = sty;
        bop.ty1 = elem_ty;
        bop.len_u8 = sn.u8_val;
        let a_arr: [1]eir.EirValue = [z_elem];
        let s_arr: [1]eir.EirSlot = [eir.EIR_NONE];
        let ar = try eir_prog.append_vals(alloc, &a_arr);
        let sr = try eir_prog.append_arg_slots(alloc, &s_arr);
        let bc_id = try eir_prog.push_builtin_call(alloc, eir.EirBuiltinCallData.{
            op: bop,
            args: ar,
            arg_slots: sr,
            ret_ty: sty,
        });
        var sinst = eir.inst_zero(sp, .BuiltinCall);
        sinst.dst = zv;
        sinst.ty0 = sty;
        sinst.aux0 = bc_id;
        try entry_zeros.push(alloc, sinst);
        u32_set(zero_for_slot, su, zv);
        return zv;
    }
    let zv = try eir_prog.alloc_fn_value(alloc, fn_id, sty);
    let zinst = try make_typed_zero_const(alloc, eir_prog, env, sty, zv, sp);
    try entry_zeros.push(alloc, zinst);
    u32_set(zero_for_slot, su, zv);
    return zv;
}

fn is_stub_fn(eir_prog: *eir.EirProgram, fi: u32) -> bool {
    if let f = eir_prog.get_fn(fi) {
        return f.is_emi_stub || f.blocks.len == 0_u32;
    }
    return true;
}

fn pass_mem2reg(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    stats: *mut OptStats,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) {
            let promoted = try mem2reg_fn(alloc, eir_prog, fi, env);
            stats.mem2reg_slots = stats.mem2reg_slots +% promoted;
        }
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Section 3: Pass 2A (Devirtualization) & Pass 2B (Schedule Expansion)
// ===========================================================================

fn method_target_eq_opt(a: types.MethodTarget, b: types.MethodTarget) -> bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == .Def {
        return a.def_id == b.def_id;
    }
    return a.builtin == b.builtin;
}

fn resolve_dyn_method_impl(
    env: *types.TypeEnv,
    iface_def: u32,
    method_idx: u32,
    concrete_ty: types.TyId,
) -> ?cfg_ir.CfgFnKey {
    let imeta = env.get_iface(iface_def) orelse {
        return null;
    };
    let iface_methods = env.iface_methods_range(imeta.methods);
    let midx = method_idx.widen.[usize]();
    if midx >= iface_methods.len {
        return null;
    }
    let mname = iface_methods[midx].name;

    let cn = env.get(concrete_ty);
    var has_tk = false;
    var tk = types.MethodTarget.{ kind: .Def, def_id: 0_u32, builtin: .Prim };
    match cn.kind {
        .Struct => { has_tk = true; tk.def_id = cn.primary; }
        .Pool => { has_tk = true; tk.def_id = cn.primary; }
        .Enum => { has_tk = true; tk.def_id = cn.primary; }
        .Union => { has_tk = true; tk.def_id = cn.primary; }
        .Bitfield => { has_tk = true; tk.def_id = cn.primary; }
        .Builtin => {
            has_tk = true;
            tk.kind = .Builtin;
            tk.builtin = cn.builtin_kind;
        }
        _ => {}
    }
    if !has_tk {
        return null;
    }

    let impls = env.decls.impls.as_slice();
    var impl_idx: usize = 0_usize;
    while impl_idx < impls.len {
        let im = impls[impl_idx];
        if im.has_iface && im.iface_def == iface_def && method_target_eq_opt(im.target, tk) {
            let im_methods = env.impl_methods_range(im.methods);
            var ji: usize = 0_usize;
            while ji < im_methods.len {
                if im_methods[ji].sig.name == mname {
                    return cfg_ir.fn_key_impl_method(impl_idx.trunc.[u32](), im_methods[ji].sub_idx);
                }
                ji = ji +% 1_usize;
            }
            return null;
        }
        impl_idx = impl_idx +% 1_usize;
    }
    return null;
}

struct DynOrigin {
    valid: bool;
    ptr_val: eir.EirValue;
    ptr_def_bb: eir.BlockId;
    iface_def: u32;
    concrete_ty: types.TyId;
}

fn dyn_origin_none() -> DynOrigin {
    return DynOrigin.{
        valid: false,
        ptr_val: eir.EIR_NONE,
        ptr_def_bb: eir.EIR_NONE,
        iface_def: 0_u32,
        concrete_ty: types.TY_ERROR,
    };
}

fn devirt_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> u64 ! OutOfMemory {
    return try devirt_fn_with_lookup(alloc, eir_prog, eir_prog, fn_id, env);
}

fn devirt_fn_with_lookup(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    lookup_eir: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> u64 ! OutOfMemory {
    var nvals: usize = 0_usize;
    var nslots: usize = 0_usize;
    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) {
            return 0_u64;
        }
        nvals = f.value_tys.len.widen.[usize]();
        nslots = f.slots.len.widen.[usize]();
        rpo_r = f.rpo;
    } else {
        return 0_u64;
    }
    if nvals == 0_usize || rpo_r.len == 0_u32 {
        return 0_u64;
    }

    // Track defining block of each SSA value (for dominance check on devirt receiver).
    var val_def_bb = try col.DynBuf.[u32].init(alloc, nvals);
    errdefer val_def_bb.destroy(alloc);
    try fill_u32(alloc, &mut val_def_bb, nvals, eir.EIR_NONE);
    var entry_bb: eir.BlockId = 0_u32;
    if let f = eir_prog.get_fn(fn_id) {
        entry_bb = f.entry;
    }
    let params = eir_prog.fn_params(fn_id);
    var pi: usize = 0_usize;
    while pi < params.len {
        u32_set(&mut val_def_bb, params[pi].widen.[usize](), entry_bb);
        pi = pi +% 1_usize;
    }

    var slot_store_cnt = try col.DynBuf.[u32].init(alloc, max_usize(nslots, 1_usize));
    errdefer slot_store_cnt.destroy(alloc);
    try fill_u32(alloc, &mut slot_store_cnt, nslots, 0_u32);
    var slot_esc = try col.BitSet.init(alloc, max_usize(nslots, 1_usize));
    errdefer slot_esc.destroy(alloc);

    var r0: u32 = 0_u32;
    while r0 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r0).widen.[usize]()) {
            bb = bp.*;
        }
        let phis = eir_prog.block_phis(fn_id, bb);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len {
            u32_set(&mut val_def_bb, phis[phi_i].dst.widen.[usize](), bb);
            phi_i = phi_i +% 1_usize;
        }
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            let d = eir.inst_def(&inst);
            if d != eir.EIR_NONE {
                u32_set(&mut val_def_bb, d.widen.[usize](), bb);
            }
            if inst.kind == .StoreSlot {
                let su = inst.aux0.widen.[usize]();
                if su < nslots {
                    let prev_sc = u32_at(&slot_store_cnt, su);
                    u32_set(&mut slot_store_cnt, su, prev_sc +% 1_u32);
                }
            } else if inst.kind == .SlotAddr {
                let su = inst.aux0.widen.[usize]();
                if su < nslots {
                    slot_esc.set(su);
                }
            } else if inst.kind == .PlaceAddr || inst.kind == .StorePlace {
                if let pl = eir_prog.get_place(inst.aux0) {
                    if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                        slot_esc.set(pl.base.id.widen.[usize]());
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        r0 = r0 +% 1_u32;
    }

    var origins = try col.DynBuf.[DynOrigin].init(alloc, nvals);
    errdefer origins.destroy(alloc);
    var oi: usize = 0_usize;
    while oi < nvals {
        try origins.push(alloc, dyn_origin_none());
        oi = oi +% 1_usize;
    }
    var slot_origins = try col.DynBuf.[DynOrigin].init(alloc, max_usize(nslots, 1_usize));
    errdefer slot_origins.destroy(alloc);
    var soi: usize = 0_usize;
    while soi < nslots {
        try slot_origins.push(alloc, dyn_origin_none());
        soi = soi +% 1_usize;
    }

    var devirt_cnt: u64 = 0_u64;
    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);
    var arg_buf = try col.DynBuf.[eir.EirValue].init(alloc, 8_usize);
    errdefer arg_buf.destroy(alloc);

    var r1: u32 = 0_u32;
    while r1 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r1).widen.[usize]()) {
            bb = bp.*;
        }
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            insts_r = blk.insts;
        }
        new_insts.clear();
        new_flags.clear();
        var bchanged = false;

        var ii: u32 = 0_u32;
        while ii < insts_r.len {
            let gid = insts_r.start +% ii;
            var inst = eir.inst_zero(span.span_dummy(), .ParForHint);
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                inst = ip.*;
            }
            let fl = eir_prog.inst_proven_flags(gid);

            if inst.kind == .MakeDyn && inst.dst != eir.EIR_NONE {
                let du = inst.dst.widen.[usize]();
                let pdb = u32_at(&val_def_bb, inst.v0.widen.[usize]());
                if du < origins.len() && pdb != eir.EIR_NONE {
                    if let om = origins.get_mut(du) {
                        om.* = DynOrigin.{
                            valid: true,
                            ptr_val: inst.v0,
                            ptr_def_bb: pdb,
                            iface_def: inst.aux0,
                            concrete_ty: inst.ty1,
                        };
                    }
                }
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            } else if inst.kind == .Copy && inst.dst != eir.EIR_NONE {
                let su = inst.v0.widen.[usize]();
                let du = inst.dst.widen.[usize]();
                if su < origins.len() && du < origins.len() {
                    var orig_c = dyn_origin_none();
                    if let op = origins.get(su) {
                        orig_c = op.*;
                    }
                    if orig_c.valid {
                        if let om = origins.get_mut(du) {
                            om.* = orig_c;
                        }
                    }
                }
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            } else if inst.kind == .StoreSlot {
                let su = inst.aux0.widen.[usize]();
                let vu = inst.v0.widen.[usize]();
                if su < nslots && !slot_esc.test(su) && u32_at(&slot_store_cnt, su) == 1_u32 && vu < origins.len() {
                    var orig_c = dyn_origin_none();
                    if let op = origins.get(vu) {
                        orig_c = op.*;
                    }
                    if orig_c.valid {
                        if let som = slot_origins.get_mut(su) {
                            som.* = orig_c;
                        }
                    }
                }
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            } else if inst.kind == .LoadSlot && inst.dst != eir.EIR_NONE {
                let su = inst.aux0.widen.[usize]();
                let du = inst.dst.widen.[usize]();
                if su < nslots && du < origins.len() {
                    var orig_c = dyn_origin_none();
                    if let sop = slot_origins.get(su) {
                        orig_c = sop.*;
                    }
                    if orig_c.valid && eir_prog.dominates_block(fn_id, orig_c.ptr_def_bb, bb) {
                        if let om = origins.get_mut(du) {
                            om.* = orig_c;
                        }
                    }
                }
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            } else if inst.kind == .Call {
                var rewritten = false;
                var cd = eir.EirCallData.{
                    callee: eir.callee_direct_fn(0_u32),
                    args: ast.range_empty(),
                    ret_ty: types.TY_VOID,
                };
                var have_cd = false;
                if let cdp = eir_prog.get_call(inst.aux0) {
                    cd = cdp.*;
                    have_cd = true;
                }
                if have_cd && cd.callee.kind == .DynCall && cd.args.len >= 1_u32 {
                    var recv_v = eir.EIR_NONE;
                    if let vp = eir_prog.exprs.vals.get(cd.args.start.widen.[usize]()) {
                        recv_v = vp.*;
                    }
                    let ru = recv_v.widen.[usize]();
                    var orig_c = dyn_origin_none();
                    if ru < origins.len() {
                        if let op = origins.get(ru) {
                            orig_c = op.*;
                        }
                    }
                    if orig_c.valid
                        && orig_c.iface_def == cd.callee.a
                        && eir_prog.dominates_block(fn_id, orig_c.ptr_def_bb, bb)
                    {
                        if let mkey = resolve_dyn_method_impl(env, cd.callee.a, cd.callee.b, orig_c.concrete_ty) {
                            if let tfid = lookup_eir.find_fn_by_key(mkey) {
                                let tparams_len = lookup_eir.fn_params(tfid).len;
                                if tparams_len == cd.args.len.widen.[usize]() {
                                    var p0_ty = types.TY_ERROR;
                                    let tps = lookup_eir.fn_params(tfid);
                                    if tps.len > 0_usize {
                                        p0_ty = lookup_eir.fn_val_ty(tfid, tps[0_usize]);
                                    }
                                    let ptr_ty = eir_prog.fn_val_ty(fn_id, orig_c.ptr_val);
                                    var recv_arg = orig_c.ptr_val;
                                    var recv_ok = false;
                                    if ptr_ty == p0_ty {
                                        recv_ok = true;
                                    } else {
                                        let an = env.get(ptr_ty);
                                        let pn = env.get(p0_ty);
                                        if an.kind == .Borrow && pn.kind == .Borrow
                                            && an.flag0 && !pn.flag0
                                            && an.borrow_kind == pn.borrow_kind
                                            && an.primary == pn.primary
                                        {
                                            let cast_v = try eir_prog.alloc_fn_value(alloc, fn_id, p0_ty);
                                            var cinst = eir.inst_zero(inst.span, .Cast);
                                            cinst.dst = cast_v;
                                            cinst.cast_kind = .MutToConst;
                                            cinst.v0 = orig_c.ptr_val;
                                            cinst.ty0 = p0_ty;
                                            cinst.ty1 = ptr_ty;
                                            try new_insts.push(alloc, cinst);
                                            try new_flags.push(alloc, 0_u8);
                                            recv_arg = cast_v;
                                            recv_ok = true;
                                        }
                                    }
                                    if recv_ok {
                                        arg_buf.clear();
                                        try arg_buf.push(alloc, recv_arg);
                                        var ai: u32 = 1_u32;
                                        while ai < cd.args.len {
                                            if let avp = eir_prog.exprs.vals.get((cd.args.start +% ai).widen.[usize]()) {
                                                try arg_buf.push(alloc, avp.*);
                                            }
                                            ai = ai +% 1_u32;
                                        }
                                        let new_ar = try eir_prog.append_vals(alloc, arg_buf.as_slice());
                                        let new_cid = try eir_prog.push_call(
                                            alloc,
                                            eir.EirCallData.{
                                                callee: eir.callee_method(mkey.a, mkey.b),
                                                args: new_ar,
                                                ret_ty: cd.ret_ty,
                                            },
                                        );
                                        var ninst = copy inst;
                                        ninst.aux0 = new_cid;
                                        ninst.range = new_ar;
                                        try new_insts.push(alloc, ninst);
                                        try new_flags.push(alloc, fl);
                                        rewritten = true;
                                        bchanged = true;
                                        devirt_cnt = devirt_cnt +% 1_u64;
                                    }
                                }
                            }
                        }
                    }
                }
                if !rewritten {
                    try new_insts.push(alloc, inst);
                    try new_flags.push(alloc, fl);
                }
            } else {
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            }
            ii = ii +% 1_u32;
        }

        if bchanged {
            try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
        }
        r1 = r1 +% 1_u32;
    }

    arg_buf.destroy(alloc);
    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    slot_origins.destroy(alloc);
    origins.destroy(alloc);
    slot_esc.destroy(alloc);
    slot_store_cnt.destroy(alloc);
    val_def_bb.destroy(alloc);
    return devirt_cnt;
}

fn pass_devirt(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    stats: *mut OptStats,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) {
            let c = try devirt_fn(alloc, eir_prog, fi, env);
            stats.devirt_calls = stats.devirt_calls +% c;
        }
        fi = fi +% 1_u32;
    }
    return;
}

// --- Pass 2B: Schedule Expansion (`ScheduleRun` -> Direct `sys` Calls) ---

const SCHED_ARG_EXACT: u8 = 0_u8;
const SCHED_ARG_MUT_TO_CONST: u8 = 1_u8;
const SCHED_ARG_DEREF: u8 = 2_u8;
const SCHED_ARG_BORROW: u8 = 3_u8;
const SCHED_ARG_NONE: u8 = 9_u8;

fn sched_match_arg_type(env: *types.TypeEnv, arg_ty: types.TyId, param_ty: types.TyId) -> u8 {
    if arg_ty == param_ty {
        return SCHED_ARG_EXACT;
    }
    let an = env.get(arg_ty);
    let pn = env.get(param_ty);
    if an.kind == .Borrow && pn.kind == .Borrow
        && an.flag0 && !pn.flag0
        && an.borrow_kind == pn.borrow_kind
        && an.primary == pn.primary
    {
        return SCHED_ARG_MUT_TO_CONST;
    }
    if an.kind == .RawPtr && pn.kind == .RawPtr
        && an.flag0 && !pn.flag0
        && an.primary == pn.primary
    {
        return SCHED_ARG_MUT_TO_CONST;
    }
    if ((an.kind == .Borrow && an.borrow_kind == .Single) || an.kind == .RawPtr)
        && an.primary == param_ty
    {
        return SCHED_ARG_DEREF;
    }
    if ((pn.kind == .Borrow && pn.borrow_kind == .Single) || pn.kind == .RawPtr)
        && arg_ty == pn.primary
    {
        return SCHED_ARG_BORROW;
    }
    return SCHED_ARG_NONE;
}

fn sched_is_pool_or_cap_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    var inner = ty;
    let n0 = env.get(ty);
    if (n0.kind == .Borrow && n0.borrow_kind == .Single) || n0.kind == .RawPtr {
        inner = n0.primary;
    }
    let n = env.get(inner);
    if n.kind == .Pool {
        return true;
    }
    if n.kind == .Builtin {
        match n.builtin_kind {
            .ArenaPool => { return true; }
            .SlotPool => { return true; }
            .AllocCap => { return true; }
            .FsCap => { return true; }
            .DirCap => { return true; }
            .NetCap => { return true; }
            .ClockCap => { return true; }
            .IoCap => { return true; }
            .ArgsCap => { return true; }
            .Env => { return true; }
            _ => { return false; }
        }
    }
    return false;
}

struct SchedArgChoice {
    run_idx: usize;
    kind: u8;
}

fn sched_match_sys_params(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    caller_fn_id: u32,
    sys_fid: u32,
    run_args: *[eir.EirValue],
    run_slots: *[eir.EirSlot],
    out: *mut col.DynBuf[SchedArgChoice],
) -> bool ! OutOfMemory {
    out.clear();
    let sys_params = eir_prog.fn_params(sys_fid);
    var used = try col.BitSet.init(alloc, max_usize(run_args.len, 1_usize));
    errdefer used.destroy(alloc);

    var pi: usize = 0_usize;
    while pi < sys_params.len {
        let pty = eir_prog.fn_val_ty(sys_fid, sys_params[pi]);
        var best_k: usize = 0_usize;
        var best_kind = SCHED_ARG_NONE;
        var k: usize = 0_usize;
        while k < run_args.len {
            if !used.test(k) {
                let mk = sched_match_arg_type(env, eir_prog.fn_val_ty(caller_fn_id, run_args[k]), pty);
                if mk < best_kind {
                    best_kind = mk;
                    best_k = k;
                }
            }
            k = k +% 1_usize;
        }
        if best_kind == SCHED_ARG_NONE && sched_is_pool_or_cap_ty(env, pty) {
            var k2: usize = 0_usize;
            while k2 < run_args.len {
                let mk = sched_match_arg_type(env, eir_prog.fn_val_ty(caller_fn_id, run_args[k2]), pty);
                if mk < best_kind {
                    best_kind = mk;
                    best_k = k2;
                }
                k2 = k2 +% 1_usize;
            }
        }
        if best_kind == SCHED_ARG_NONE {
            used.destroy(alloc);
            return false;
        }
        if best_kind == SCHED_ARG_BORROW {
            if best_k >= run_slots.len || run_slots[best_k] == eir.EIR_NONE {
                used.destroy(alloc);
                return false;
            }
        }
        used.set(best_k);
        try out.push(alloc, SchedArgChoice.{ run_idx: best_k, kind: best_kind });
        pi = pi +% 1_usize;
    }

    used.destroy(alloc);
    return true;
}

fn expand_schedules_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> u64 ! OutOfMemory {
    let nsched = eir_prog.schedule_count();
    if nsched == 0_u32 {
        return 0_u64;
    }
    var nvals: usize = 0_usize;
    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) {
            return 0_u64;
        }
        nvals = f.value_tys.len.widen.[usize]();
        rpo_r = f.rpo;
    } else {
        return 0_u64;
    }
    if rpo_r.len == 0_u32 {
        return 0_u64;
    }

    // Track known constant integer values (for statically known schedule indices).
    var has_k = try col.BitSet.init(alloc, max_usize(nvals, 1_usize));
    errdefer has_k.destroy(alloc);
    var k_val = try col.DynBuf.[u32].init(alloc, max_usize(nvals, 1_usize));
    errdefer k_val.destroy(alloc);
    try fill_u32(alloc, &mut k_val, nvals, 0_u32);

    var expanded: u64 = 0_u64;
    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);
    var sys_defs = try col.DynBuf.[u32].init(alloc, 8_usize);
    errdefer sys_defs.destroy(alloc);
    var run_args_buf = try col.DynBuf.[eir.EirValue].init(alloc, 8_usize);
    errdefer run_args_buf.destroy(alloc);
    var run_slots_buf = try col.DynBuf.[eir.EirSlot].init(alloc, 8_usize);
    errdefer run_slots_buf.destroy(alloc);
    var choices = try col.DynBuf.[SchedArgChoice].init(alloc, 8_usize);
    errdefer choices.destroy(alloc);
    var call_args = try col.DynBuf.[eir.EirValue].init(alloc, 8_usize);
    errdefer call_args.destroy(alloc);

    var r0: u32 = 0_u32;
    while r0 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r0).widen.[usize]()) {
            bb = bp.*;
        }
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            insts_r = blk.insts;
        }
        new_insts.clear();
        new_flags.clear();
        var bchanged = false;

        var ii: u32 = 0_u32;
        while ii < insts_r.len {
            let gid = insts_r.start +% ii;
            var inst = eir.inst_zero(span.span_dummy(), .ParForHint);
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                inst = ip.*;
            }
            let fl = eir_prog.inst_proven_flags(gid);

            if inst.kind == .Const && inst.dst != eir.EIR_NONE {
                if let kc = eir_prog.get_const(inst.aux0) {
                    if kc.kind == .Int && kc.int_val.hi == 0_i64 {
                        let du = inst.dst.widen.[usize]();
                        if du < nvals {
                            has_k.set(du);
                            u32_set(&mut k_val, du, kc.int_val.lo.trunc.[u32]());
                        }
                    }
                }
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            } else if inst.kind == .Copy && inst.dst != eir.EIR_NONE {
                let su = inst.v0.widen.[usize]();
                let du = inst.dst.widen.[usize]();
                if su < nvals && du < nvals && has_k.test(su) {
                    has_k.set(du);
                    let prev_k = u32_at(&k_val, su);
                    u32_set(&mut k_val, du, prev_k);
                }
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            } else if inst.kind == .BuiltinCall {
                var did_expand = false;
                var bc = eir.EirBuiltinCallData.{
                    op: cfg_ir.builtin_op_simple(.ArenaInit),
                    args: ast.range_empty(),
                    arg_slots: ast.range_empty(),
                    ret_ty: types.TY_VOID,
                };
                var have_bc = false;
                if let bcp = eir_prog.get_builtin_call(inst.aux0) {
                    bc = bcp.*;
                    have_bc = true;
                }
                if have_bc && bc.op.kind == .ScheduleRun && bc.args.len >= 1_u32 {
                    var sched_v = eir.EIR_NONE;
                    if let vp = eir_prog.exprs.vals.get(bc.args.start.widen.[usize]()) {
                        sched_v = vp.*;
                    }
                    var know_sched = false;
                    var sched_idx: u32 = 0_u32;
                    if nsched == 1_u32 {
                        know_sched = true;
                        sched_idx = 0_u32;
                    } else if sched_v.widen.[usize]() < nvals && has_k.test(sched_v.widen.[usize]()) {
                        sched_idx = u32_at(&k_val, sched_v.widen.[usize]());
                        if sched_idx < nsched {
                            know_sched = true;
                        }
                    }

                    if know_sched {
                        // Collect all systems across waves in order and verify all match cleanly.
                        sys_defs.clear();
                        let waves = eir_prog.schedule_waves(sched_idx);
                        var all_ok = waves.len > 0_usize;
                        var wi: usize = 0_usize;
                        while wi < waves.len && all_ok {
                            let syss = eir_prog.wave_systems(waves[wi].systems);
                            var si: usize = 0_usize;
                            while si < syss.len {
                                let sd = syss[si];
                                if let sfid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(sd)) {
                                    if let sf = eir_prog.get_fn(sfid) {
                                        if sf.sig.ret != types.TY_VOID {
                                            all_ok = false;
                                            break;
                                        }
                                    }
                                    try sys_defs.push(alloc, sd);
                                } else {
                                    all_ok = false;
                                    break;
                                }
                                si = si +% 1_usize;
                            }
                            wi = wi +% 1_usize;
                        }

                        if all_ok {
                            run_args_buf.clear();
                            run_slots_buf.clear();
                            var ai: u32 = 1_u32;
                            while ai < bc.args.len {
                                var av = eir.EIR_NONE;
                                if let avp = eir_prog.exprs.vals.get((bc.args.start +% ai).widen.[usize]()) {
                                    av = avp.*;
                                }
                                try run_args_buf.push(alloc, av);
                                var aslot = eir.EIR_NONE;
                                if ai < bc.arg_slots.len {
                                    if let asp = eir_prog.exprs.arg_slots.get((bc.arg_slots.start +% ai).widen.[usize]()) {
                                        aslot = asp.*;
                                    }
                                }
                                try run_slots_buf.push(alloc, aslot);
                                ai = ai +% 1_u32;
                            }

                            // Dry-run parameter matching for EVERY system before emitting.
                            let sdefs = sys_defs.as_slice();
                            var sdi: usize = 0_usize;
                            while sdi < sdefs.len && all_ok {
                                if let sfid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(sdefs[sdi])) {
                                    let matched = try sched_match_sys_params(
                                        alloc, eir_prog, env, fn_id, sfid,
                                        run_args_buf.as_slice(), run_slots_buf.as_slice(), &mut choices,
                                    );
                                    if !matched {
                                        all_ok = false;
                                    }
                                } else {
                                    all_ok = false;
                                }
                                sdi = sdi +% 1_usize;
                            }

                            if all_ok {
                                var sdi2: usize = 0_usize;
                                while sdi2 < sdefs.len {
                                    let sd = sdefs[sdi2];
                                    if let sfid = eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(sd)) {
                                        _ = try sched_match_sys_params(
                                            alloc, eir_prog, env, fn_id, sfid,
                                            run_args_buf.as_slice(), run_slots_buf.as_slice(), &mut choices,
                                        );
                                        call_args.clear();
                                        let chs = choices.as_slice();
                                        var ci: usize = 0_usize;
                                        while ci < chs.len {
                                            let ch = chs[ci];
                                            var pty = types.TY_VOID;
                                            let sps = eir_prog.fn_params(sfid);
                                            if ci < sps.len {
                                                pty = eir_prog.fn_val_ty(sfid, sps[ci]);
                                            }
                                            let av = u32_at(&run_args_buf, ch.run_idx);
                                            let aty = eir_prog.fn_val_ty(fn_id, av);
                                            if ch.kind == SCHED_ARG_EXACT {
                                                try call_args.push(alloc, av);
                                            } else if ch.kind == SCHED_ARG_MUT_TO_CONST {
                                                let cv = try eir_prog.alloc_fn_value(alloc, fn_id, pty);
                                                var cinst = eir.inst_zero(inst.span, .Cast);
                                                cinst.dst = cv;
                                                cinst.cast_kind = .MutToConst;
                                                cinst.v0 = av;
                                                cinst.ty0 = pty;
                                                cinst.ty1 = aty;
                                                try new_insts.push(alloc, cinst);
                                                try new_flags.push(alloc, 0_u8);
                                                try call_args.push(alloc, cv);
                                            } else if ch.kind == SCHED_ARG_DEREF {
                                                let dv = try eir_prog.alloc_fn_value(alloc, fn_id, pty);
                                                let p1: [1]eir.EirProj = [eir.proj_deref()];
                                                let pr = try eir_prog.append_projs(alloc, &p1);
                                                let pid = try eir_prog.push_place(
                                                    alloc,
                                                    eir.EirPlace.{ base: eir.place_base_val(av), projs: pr, ty: pty },
                                                );
                                                var linst = eir.inst_zero(inst.span, .LoadPlace);
                                                linst.dst = dv;
                                                linst.aux0 = pid;
                                                try new_insts.push(alloc, linst);
                                                try new_flags.push(alloc, 0_u8);
                                                try call_args.push(alloc, dv);
                                            } else {
                                                let aslot = u32_at(&run_slots_buf, ch.run_idx);
                                                let pv = try eir_prog.alloc_fn_value(alloc, fn_id, pty);
                                                let pn = env.get(pty);
                                                var sinst = eir.inst_zero(inst.span, .SlotAddr);
                                                sinst.dst = pv;
                                                sinst.aux0 = aslot;
                                                sinst.flag0 = pn.flag0;
                                                sinst.ty0 = pty;
                                                try new_insts.push(alloc, sinst);
                                                try new_flags.push(alloc, 0_u8);
                                                try call_args.push(alloc, pv);
                                            }
                                            ci = ci +% 1_usize;
                                        }
                                        let new_ar = try eir_prog.append_vals(alloc, call_args.as_slice());
                                        let new_cid = try eir_prog.push_call(
                                            alloc,
                                            eir.EirCallData.{
                                                callee: eir.callee_direct_fn(sd),
                                                args: new_ar,
                                                ret_ty: types.TY_VOID,
                                            },
                                        );
                                        var call_inst = eir.inst_zero(inst.span, .Call);
                                        call_inst.dst = eir.EIR_NONE;
                                        call_inst.aux0 = new_cid;
                                        call_inst.range = new_ar;
                                        call_inst.ty0 = types.TY_VOID;
                                        try new_insts.push(alloc, call_inst);
                                        try new_flags.push(alloc, 0_u8);
                                    }
                                    sdi2 = sdi2 +% 1_usize;
                                }
                                if inst.dst != eir.EIR_NONE {
                                    let vc = try eir_prog.push_const(alloc, cfg_ir.const_void());
                                    var vinst = eir.inst_zero(inst.span, .Const);
                                    vinst.dst = inst.dst;
                                    vinst.ty0 = types.TY_VOID;
                                    vinst.aux0 = vc;
                                    try new_insts.push(alloc, vinst);
                                    try new_flags.push(alloc, 0_u8);
                                }
                                did_expand = true;
                                bchanged = true;
                                expanded = expanded +% 1_u64;
                            }
                        }
                    }
                }
                if !did_expand {
                    try new_insts.push(alloc, inst);
                    try new_flags.push(alloc, fl);
                }
            } else {
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            }
            ii = ii +% 1_u32;
        }

        if bchanged {
            try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
        }
        r0 = r0 +% 1_u32;
    }

    call_args.destroy(alloc);
    choices.destroy(alloc);
    run_slots_buf.destroy(alloc);
    run_args_buf.destroy(alloc);
    sys_defs.destroy(alloc);
    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    k_val.destroy(alloc);
    has_k.destroy(alloc);
    return expanded;
}

fn pass_schedule_expand(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) {
            _ = try expand_schedules_fn(alloc, eir_prog, fi, env);
        }
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Section 4: Pass 2C (Smart Function Inlining) & SlotAddr+Deref Folding
// ===========================================================================

fn resolve_direct_callee_fn(eir_prog: *eir.EirProgram, callee: eir.EirCallee) -> ?u32 {
    match callee.kind {
        .DirectFn => { return eir_prog.find_fn_by_key(cfg_ir.fn_key_top_def(callee.a)); }
        .Method => { return eir_prog.find_fn_by_key(cfg_ir.fn_key_impl_method(callee.a, callee.b)); }
        .GenericInst => { return eir_prog.find_fn_by_key(cfg_ir.fn_key_generic_inst(callee.a)); }
        _ => { return null; }
    }
}

fn fn_reachable_inst_count(eir_prog: *eir.EirProgram, fn_id: u32) -> usize {
    let rpo = eir_prog.fn_rpo(fn_id);
    var total: usize = 0_usize;
    var ri: usize = 0_usize;
    while ri < rpo.len {
        total = total +% eir_prog.block_insts(fn_id, rpo[ri]).len;
        ri = ri +% 1_usize;
    }
    return total;
}

fn mark_loop_blocks_fn(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    in_loop: *mut col.BitSet,
) -> !OutOfMemory {
    in_loop.clear();
    let blks = eir_prog.fn_blocks(fn_id);
    let n = blks.len;
    if n == 0_usize {
        return;
    }
    var work = try col.DynBuf.[eir.BlockId].init(alloc, 16_usize);
    errdefer work.destroy(alloc);
    var seen = try col.BitSet.init(alloc, n);
    errdefer seen.destroy(alloc);

    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let u = rpo[ri];
        let uu = u.widen.[usize]();
        if uu < blks.len {
            let term = blks[uu].term;
            let sc = eir_prog.term_successor_count(&term);
            var si: usize = 0_usize;
            while si < sc {
                let h = eir_prog.term_successor_at(&term, si);
                let hu = h.widen.[usize]();
                if h != eir.EIR_NONE && hu < n && eir_prog.dominates_block(fn_id, h, u) {
                    seen.clear();
                    work.clear();
                    seen.set(hu);
                    in_loop.set(hu);
                    if !seen.test(uu) {
                        seen.set(uu);
                        in_loop.set(uu);
                        try work.push(alloc, u);
                    }
                    while !work.is_empty() {
                        let cur = work.pop() orelse { break; };
                        let cpreds = eir_prog.block_preds(fn_id, cur);
                        var pi: usize = 0_usize;
                        while pi < cpreds.len {
                            let p = cpreds[pi];
                            let pu = p.widen.[usize]();
                            if pu < n && !seen.test(pu) {
                                seen.set(pu);
                                in_loop.set(pu);
                                try work.push(alloc, p);
                            }
                            pi = pi +% 1_usize;
                        }
                    }
                }
                si = si +% 1_usize;
            }
        }
        ri = ri +% 1_usize;
    }

    seen.destroy(alloc);
    work.destroy(alloc);
    return;
}

struct TarjanFrame {
    u: u32;
    edge_cur: u32;
    entered: bool;
}

/// Marks every function participating in a call-graph cycle (self or mutual recursion)
/// and records a deterministic bottom-up (callees-before-callers) topological order in `topo_order`.
fn find_recursive_fns(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    nfns: usize,
    is_rec: *mut col.BitSet,
    callsite_cnt: *mut col.DynBuf[u32],
    has_asm: *mut col.BitSet,
    topo_order: *mut col.DynBuf[u32],
) -> !OutOfMemory {
    var adj_head = try col.DynBuf.[u32].init(alloc, max_usize(nfns, 1_usize));
    errdefer adj_head.destroy(alloc);
    try fill_u32(alloc, &mut adj_head, nfns, eir.EIR_NONE);
    var adj_to = try col.DynBuf.[u32].init(alloc, nfns *% 2_usize +% 16_usize);
    errdefer adj_to.destroy(alloc);
    var adj_next = try col.DynBuf.[u32].init(alloc, nfns *% 2_usize +% 16_usize);
    errdefer adj_next.destroy(alloc);

    var fi: usize = 0_usize;
    while fi < nfns {
        let fid = fi.trunc.[u32]();
        let rpo = eir_prog.fn_rpo(fid);
        var ri: usize = 0_usize;
        while ri < rpo.len {
            let insts = eir_prog.block_insts(fid, rpo[ri]);
            var ii: usize = 0_usize;
            while ii < insts.len {
                let inst = insts[ii];
                if inst.kind == .InlineAsm {
                    has_asm.set(fi);
                } else if inst.kind == .Call {
                    if let cd = eir_prog.get_call(inst.aux0) {
                        if let callee_fid = resolve_direct_callee_fn(eir_prog, cd.callee) {
                            let cu = callee_fid.widen.[usize]();
                            if cu < nfns {
                                u32_set(callsite_cnt, cu, u32_at(callsite_cnt, cu) +% 1_u32);
                                if cu == fi {
                                    is_rec.set(fi);
                                } else {
                                    let eid = adj_to.len().trunc.[u32]();
                                    try adj_to.push(alloc, callee_fid);
                                    try adj_next.push(alloc, u32_at(&adj_head, fi));
                                    u32_set(&mut adj_head, fi, eid);
                                }
                            }
                        }
                    }
                }
                ii = ii +% 1_usize;
            }
            ri = ri +% 1_usize;
        }
        fi = fi +% 1_usize;
    }

    // Iterative Tarjan SCC to detect mutual recursion.
    var disc = try col.DynBuf.[u32].init(alloc, max_usize(nfns, 1_usize));
    errdefer disc.destroy(alloc);
    var low = try col.DynBuf.[u32].init(alloc, max_usize(nfns, 1_usize));
    errdefer low.destroy(alloc);
    try fill_u32(alloc, &mut disc, nfns, eir.EIR_NONE);
    try fill_u32(alloc, &mut low, nfns, eir.EIR_NONE);
    var on_stack = try col.BitSet.init(alloc, max_usize(nfns, 1_usize));
    errdefer on_stack.destroy(alloc);
    var scc_stack = try col.DynBuf.[u32].init(alloc, 32_usize);
    errdefer scc_stack.destroy(alloc);
    var dfs = try col.DynBuf.[TarjanFrame].init(alloc, 32_usize);
    errdefer dfs.destroy(alloc);
    var timer: u32 = 0_u32;

    var start_f: usize = 0_usize;
    while start_f < nfns {
        if u32_at(&disc, start_f) == eir.EIR_NONE {
            try dfs.push(alloc, TarjanFrame.{
                u: start_f.trunc.[u32](),
                edge_cur: u32_at(&adj_head, start_f),
                entered: false,
            });
            while !dfs.is_empty() {
                let top_i = dfs.len() -% 1_usize;
                var fr = TarjanFrame.{ u: 0_u32, edge_cur: eir.EIR_NONE, entered: false };
                if let fp = dfs.get(top_i) {
                    fr = fp.*;
                }
                let uu = fr.u.widen.[usize]();
                if !fr.entered {
                    u32_set(&mut disc, uu, timer);
                    u32_set(&mut low, uu, timer);
                    timer = timer +% 1_u32;
                    on_stack.set(uu);
                    try scc_stack.push(alloc, fr.u);
                    if let fm = dfs.get_mut(top_i) {
                        fm.entered = true;
                    }
                } else if fr.edge_cur != eir.EIR_NONE {
                    let eid = fr.edge_cur.widen.[usize]();
                    let v = u32_at(&adj_to, eid);
                    let vu = v.widen.[usize]();
                    let next_e = u32_at(&adj_next, eid);
                    if let fm = dfs.get_mut(top_i) {
                        fm.edge_cur = next_e;
                    }
                    if vu < nfns {
                        if u32_at(&disc, vu) == eir.EIR_NONE {
                            try dfs.push(alloc, TarjanFrame.{
                                u: v,
                                edge_cur: u32_at(&adj_head, vu),
                                entered: false,
                            });
                        } else if on_stack.test(vu) {
                            let lu = u32_at(&low, uu);
                            let dv = u32_at(&disc, vu);
                            if dv < lu {
                                u32_set(&mut low, uu, dv);
                            }
                        }
                    }
                } else {
                    _ = dfs.pop();
                    if !dfs.is_empty() {
                        let p_i = dfs.len() -% 1_usize;
                        if let pp = dfs.get(p_i) {
                            let pu = pp.u.widen.[usize]();
                            let lp = u32_at(&low, pu);
                            let lu = u32_at(&low, uu);
                            if lu < lp {
                                u32_set(&mut low, pu, lu);
                            }
                        }
                    }
                    if u32_at(&low, uu) == u32_at(&disc, uu) {
                        var scc_cnt: usize = 0_usize;
                        let first_node = fr.u;
                        while !scc_stack.is_empty() {
                            let w = scc_stack.pop() orelse { break; };
                            let wu = w.widen.[usize]();
                            on_stack.unset(wu);
                            try topo_order.push(alloc, w);
                            scc_cnt = scc_cnt +% 1_usize;
                            if scc_cnt == 2_usize {
                                is_rec.set(first_node.widen.[usize]());
                            }
                            if scc_cnt >= 2_usize {
                                is_rec.set(wu);
                            }
                            if w == fr.u {
                                break;
                            }
                        }
                    }
                }
            }
        }
        start_f = start_f +% 1_usize;
    }

    dfs.destroy(alloc);
    scc_stack.destroy(alloc);
    on_stack.destroy(alloc);
    low.destroy(alloc);
    disc.destroy(alloc);
    adj_next.destroy(alloc);
    adj_to.destroy(alloc);
    adj_head.destroy(alloc);
    return;
}

fn fn_has_loop_quick(eir_prog: *eir.EirProgram, fn_id: u32) -> bool {
    let blks = eir_prog.fn_blocks(fn_id);
    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let u = rpo[ri];
        let uu = u.widen.[usize]();
        if uu < blks.len {
            let term = blks[uu].term;
            let sc = eir_prog.term_successor_count(&term);
            var si: usize = 0_usize;
            while si < sc {
                let h = eir_prog.term_successor_at(&term, si);
                if h != eir.EIR_NONE && h.widen.[usize]() < blks.len && eir_prog.dominates_block(fn_id, h, u) {
                    return true;
                }
                si = si +% 1_usize;
            }
        }
        ri = ri +% 1_usize;
    }
    return false;
}

fn callee_eligible_for_inline(
    eir_prog: *eir.EirProgram,
    caller_fid: u32,
    callee_fid: u32,
    caller_insts: usize,
    callee_insts: usize,
    in_loop: bool,
    callsites: u32,
    is_rec: *col.BitSet,
    has_asm: *col.BitSet,
    call_inst: *eir.EirInst,
    cd: *eir.EirCallData,
    incremental_cgu: bool,
) -> bool {
    if callee_fid == caller_fid {
        return false;
    }
    let cu = callee_fid.widen.[usize]();
    if is_rec.test(cu) || has_asm.test(cu) {
        return false;
    }
    let cf = eir_prog.get_fn(callee_fid) orelse {
        return false;
    };
    if incremental_cgu
        && !cf.sig.effects.is_inline
        && cf.key.kind != .GenericInst
        && cf.key.kind != .Closure
    {
        return false;
    }
    if is_opt_protected_fn(cf)
        || cf.sig.effects.is_recursive
        || cf.sig.effects.is_export_c
        || has_par_for(cf)
        || cf.blocks.len == 0_u32
        || cf.rpo.len == 0_u32
    {
        return false;
    }
    let max_caller: usize = if cf.sig.effects.is_inline {
        4000_usize
    } else if callee_insts <= 32_usize {
        3000_usize
    } else if cf.is_sys {
        1600_usize
    } else {
        1200_usize
    };
    if caller_insts +% callee_insts > max_caller {
        return false;
    }

    // Budget checks (L1i friendly + hotness / single-callsite / sys).
    var budget: usize = 55_usize;
    if cf.sig.effects.is_inline {
        budget = 420_usize;
    }
    if in_loop || callsites <= 1_u32 {
        if budget < 140_usize {
            budget = 140_usize;
        }
        if cf.is_sys && budget < 280_usize {
            budget = 280_usize;
        }
    }
    if callee_insts > budget {
        return false;
    }
    // Avoid inlining large non-sys, non-@inline looping callees (e.g. cold needle match loops / big layout passes)
    // into already-looping hot callers where their live ranges would spill outer induction vars.
    if !cf.is_sys && !cf.sig.effects.is_inline && in_loop && callee_insts > 75_usize && fn_has_loop_quick(eir_prog, callee_fid) {
        return false;
    }

    // Verify exact argument count and types match callee parameters & return type.
    let cparams = eir_prog.fn_params(callee_fid);
    if cparams.len != cd.args.len.widen.[usize]() {
        return false;
    }
    let cargs = eir_prog.vals_slice(cd.args);
    if cparams.len != cargs.len {
        return false;
    }
    var pi: usize = 0_usize;
    while pi < cparams.len && pi < cargs.len {
        let pty = eir_prog.fn_val_ty(callee_fid, cparams[pi]);
        let aty = eir_prog.fn_val_ty(caller_fid, cargs[pi]);
        if pty != aty {
            return false;
        }
        pi = pi +% 1_usize;
    }
    if call_inst.dst != eir.EIR_NONE {
        let dst_ty = eir_prog.fn_val_ty(caller_fid, call_inst.dst);
        if dst_ty != cf.sig.ret {
            return false;
        }
        // Verify every reachable Return in callee returns a value of matching type.
        let crpo = eir_prog.fn_rpo(callee_fid);
        var ri: usize = 0_usize;
        while ri < crpo.len {
            if let bp = eir_prog.fn_block(callee_fid, crpo[ri]) {
                if bp.term.kind == .Return {
                    if !bp.term.flag || eir_prog.fn_val_ty(callee_fid, bp.term.val) != dst_ty {
                        return false;
                    }
                }
            }
            ri = ri +% 1_usize;
        }
    }
    return true;
}

/// Inlines `callee_fid` at `(call_bb, call_ii)` inside `caller_fid`.
/// Appends propagated callee value facts into `(acc_fact_dsts, acc_fact_vals)` for batched commit per caller.
/// Returns: 0 = failed, 1 = single-block fast inline (no CFG change), 2 = multi-block inline (CFG changed).
fn inline_call_site(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    caller_fid: u32,
    callee_fid: u32,
    call_bb: eir.BlockId,
    call_ii: u32,
    acc_fact_dsts: *mut col.DynBuf[eir.EirValue],
    acc_fact_vals: *mut col.DynBuf[eir.EirValueFact],
) -> u8 ! OutOfMemory {
    // Snapshot call instruction and call args.
    var call_inst = eir.inst_zero(span.span_dummy(), .ParForHint);
    var call_insts_r = ast.range_empty();
    var call_term = eir.term_unreachable(span.span_dummy(), false);
    if let cb = eir_prog.fn_block(caller_fid, call_bb) {
        call_insts_r = cb.insts;
        call_term = cb.term;
    } else {
        return 0_u8;
    }
    if call_ii >= call_insts_r.len {
        return 0_u8;
    }
    if let ip = eir_prog.funcs.insts.get((call_insts_r.start +% call_ii).widen.[usize]()) {
        call_inst = ip.*;
    } else {
        return 0_u8;
    }
    if call_inst.kind != .Call {
        return 0_u8;
    }
    var cd_args_r = ast.range_empty();
    if let cd = eir_prog.get_call(call_inst.aux0) {
        cd_args_r = cd.args;
    } else {
        return 0_u8;
    }

    // Snapshot callee metadata.
    var callee_nvals: usize = 0_usize;
    var callee_nslots: usize = 0_usize;
    var callee_nblks: usize = 0_usize;
    var callee_entry: eir.BlockId = 0_u32;
    var callee_rpo_r = ast.range_empty();
    var callee_slots_r = ast.range_empty();
    var callee_vtys_r = ast.range_empty();
    var callee_params_r = ast.range_empty();
    if let cf = eir_prog.get_fn(callee_fid) {
        callee_nvals = cf.value_tys.len.widen.[usize]();
        callee_nslots = cf.slots.len.widen.[usize]();
        callee_nblks = cf.blocks.len.widen.[usize]();
        callee_entry = cf.entry;
        callee_rpo_r = cf.rpo;
        callee_slots_r = cf.slots;
        callee_vtys_r = cf.value_tys;
        callee_params_r = cf.params;
    } else {
        return 0_u8;
    }
    if callee_rpo_r.len == 0_u32 {
        return 0_u8;
    }

    var orig_caller_nblks: u32 = 0_u32;
    var orig_caller_blks_r = ast.range_empty();
    if let f = eir_prog.get_fn(caller_fid) {
        orig_caller_nblks = f.blocks.len;
        orig_caller_blks_r = f.blocks;
    }

    // 1. Map callee slots -> fresh caller slots.
    var slot_map = try col.DynBuf.[eir.EirSlot].init(alloc, max_usize(callee_nslots, 1_usize));
    errdefer slot_map.destroy(alloc);
    var si: u32 = 0_u32;
    while si < callee_slots_r.len {
        var sinfo = eir.EirSlotInfo.{
            id: 0_u32,
            ty: types.TY_VOID,
            has_name: false,
            name: span.SYM_EMPTY,
            is_mut: true,
        };
        if let sp = eir_prog.funcs.slots.get((callee_slots_r.start +% si).widen.[usize]()) {
            sinfo = sp.*;
        }
        let ns = try eir_prog.alloc_fn_slot(alloc, caller_fid, sinfo);
        try slot_map.push(alloc, ns);
        si = si +% 1_u32;
    }

    // 2. Map callee SSA values -> call args (for params) or fresh caller values (for reachable defs).
    var val_map = try col.DynBuf.[eir.EirValue].init(alloc, max_usize(callee_nvals, 1_usize));
    errdefer val_map.destroy(alloc);
    try fill_u32(alloc, &mut val_map, callee_nvals, eir.EIR_NONE);

    var pi: u32 = 0_u32;
    while pi < callee_params_r.len && pi < cd_args_r.len {
        var cpv = eir.EIR_NONE;
        var cav = eir.EIR_NONE;
        if let pvp = eir_prog.funcs.param_vals.get((callee_params_r.start +% pi).widen.[usize]()) {
            cpv = pvp.*;
        }
        if let avp = eir_prog.exprs.vals.get((cd_args_r.start +% pi).widen.[usize]()) {
            cav = avp.*;
        }
        if cpv != eir.EIR_NONE && cpv.widen.[usize]() < callee_nvals {
            u32_set(&mut val_map, cpv.widen.[usize](), cav);
        }
        pi = pi +% 1_u32;
    }

    // Allocate fresh caller SSA values for every def in reachable callee blocks.
    var cri: u32 = 0_u32;
    while cri < callee_rpo_r.len {
        var cbb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((callee_rpo_r.start +% cri).widen.[usize]()) {
            cbb = bp.*;
        }
        var cphis_r = ast.range_empty();
        var cinsts_r = ast.range_empty();
        if let cblk = eir_prog.fn_block(callee_fid, cbb) {
            cphis_r = cblk.phis;
            cinsts_r = cblk.insts;
        }
        var cpi: u32 = 0_u32;
        while cpi < cphis_r.len {
            var pdst = eir.EIR_NONE;
            var pty = types.TY_ERROR;
            if let pp = eir_prog.funcs.phis.get((cphis_r.start +% cpi).widen.[usize]()) {
                pdst = pp.dst;
                pty = pp.ty;
            }
            let pdu = pdst.widen.[usize]();
            if pdst != eir.EIR_NONE && pdu < callee_nvals && u32_at(&val_map, pdu) == eir.EIR_NONE {
                let nv = try eir_prog.alloc_fn_value(alloc, caller_fid, pty);
                u32_set(&mut val_map, pdu, nv);
                let fact = eir_prog.fn_val_fact(callee_fid, pdst);
                if fact.has_range || fact.non_neg || fact.non_zero || fact.is_const || fact.fits_u32 || fact.fits_i32 {
                    try acc_fact_dsts.push(alloc, nv);
                    try acc_fact_vals.push(alloc, fact);
                }
            }
            cpi = cpi +% 1_u32;
        }
        var cii: u32 = 0_u32;
        while cii < cinsts_r.len {
            var d = eir.EIR_NONE;
            if let ip = eir_prog.funcs.insts.get((cinsts_r.start +% cii).widen.[usize]()) {
                d = eir.inst_def(ip);
            }
            let du = d.widen.[usize]();
            if d != eir.EIR_NONE && du < callee_nvals && u32_at(&val_map, du) == eir.EIR_NONE {
                var dty = types.TY_VOID;
                if let tp = eir_prog.funcs.value_tys.get((callee_vtys_r.start +% d).widen.[usize]()) {
                    dty = tp.*;
                }
                let nv = try eir_prog.alloc_fn_value(alloc, caller_fid, dty);
                u32_set(&mut val_map, du, nv);
                let fact = eir_prog.fn_val_fact(callee_fid, d);
                if fact.has_range || fact.non_neg || fact.non_zero || fact.is_const || fact.fits_u32 || fact.fits_i32 {
                    try acc_fact_dsts.push(alloc, nv);
                    try acc_fact_vals.push(alloc, fact);
                }
            }
            cii = cii +% 1_u32;
        }
        cri = cri +% 1_u32;
    }

    // 2b. Fast path: single-block returning callee -> splice directly into `call_bb` (ZERO CFG rebuild!).
    if callee_rpo_r.len == 1_u32 {
        var cbb0: eir.BlockId = eir.EIR_NONE;
        if let bp = eir_prog.meta.rpo.get(callee_rpo_r.start.widen.[usize]()) {
            cbb0 = bp.*;
        }
        if cbb0 == callee_entry {
            var cphis0 = ast.range_empty();
            var cinsts0 = ast.range_empty();
            var cterm0 = eir.term_unreachable(span.span_dummy(), false);
            if let cblk0 = eir_prog.fn_block(callee_fid, cbb0) {
                cphis0 = cblk0.phis;
                cinsts0 = cblk0.insts;
                cterm0 = cblk0.term;
            }
            if cphis0.len == 0_u32 && cterm0.kind == .Return && (call_inst.dst == eir.EIR_NONE || cterm0.flag) {
                let total_cap = call_insts_r.len.widen.[usize]() +% cinsts0.len.widen.[usize]() +% 2_usize;
                var spl_insts = try col.DynBuf.[eir.EirInst].init(alloc, total_cap);
                errdefer spl_insts.destroy(alloc);
                var spl_flags = try col.DynBuf.[u8].init(alloc, total_cap);
                errdefer spl_flags.destroy(alloc);

                var pre_i: u32 = 0_u32;
                while pre_i < call_ii {
                    let gid = call_insts_r.start +% pre_i;
                    if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                        try spl_insts.push(alloc, ip.*);
                        try spl_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                    }
                    pre_i = pre_i +% 1_u32;
                }
                var kii0: u32 = 0_u32;
                while kii0 < cinsts0.len {
                    let old_gid = cinsts0.start +% kii0;
                    if let ip = eir_prog.funcs.insts.get(old_gid.widen.[usize]()) {
                        let orig_i = ip.*;
                        let old_fl = eir_prog.inst_proven_flags(old_gid);
                        let cloned = try clone_and_remap_inst(alloc, eir_prog, &orig_i, val_map.as_slice(), slot_map.as_slice());
                        try spl_insts.push(alloc, cloned);
                        try spl_flags.push(alloc, old_fl);
                    }
                    kii0 = kii0 +% 1_u32;
                }
                if call_inst.dst != eir.EIR_NONE {
                    let rv = remap_id(cterm0.val, val_map.as_slice());
                    var cpy = eir.inst_zero(call_inst.span, .Copy);
                    cpy.dst = call_inst.dst;
                    cpy.v0 = rv;
                    try spl_insts.push(alloc, cpy);
                    try spl_flags.push(alloc, 0_u8);
                }
                var post_i: u32 = call_ii +% 1_u32;
                while post_i < call_insts_r.len {
                    let gid = call_insts_r.start +% post_i;
                    if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                        try spl_insts.push(alloc, ip.*);
                        try spl_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                    }
                    post_i = post_i +% 1_u32;
                }
                try eir_prog.replace_block_insts_reuse(alloc, caller_fid, call_bb, spl_insts.as_slice(), spl_flags.as_slice());
                spl_flags.destroy(alloc);
                spl_insts.destroy(alloc);
                val_map.destroy(alloc);
                slot_map.destroy(alloc);
                return 1_u8;
            }
        }
    }

    // 3. Assign new block IDs: cont_bb = orig_caller_nblks, callee blocks = orig_caller_nblks + 1 + idx.
    let cont_bb: eir.BlockId = orig_caller_nblks;
    var bb_map = try col.DynBuf.[eir.BlockId].init(alloc, max_usize(callee_nblks, 1_usize));
    errdefer bb_map.destroy(alloc);
    try fill_u32(alloc, &mut bb_map, callee_nblks, eir.EIR_NONE);

    var cri2: u32 = 0_u32;
    while cri2 < callee_rpo_r.len {
        var cbb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((callee_rpo_r.start +% cri2).widen.[usize]()) {
            cbb = bp.*;
        }
        let cu = cbb.widen.[usize]();
        if cu < callee_nblks {
            u32_set(&mut bb_map, cu, orig_caller_nblks +% 1_u32 +% cri2);
        }
        cri2 = cri2 +% 1_u32;
    }

    let callee_entry_mapped = u32_at(&bb_map, callee_entry.widen.[usize]());
    if callee_entry_mapped == eir.EIR_NONE {
        bb_map.destroy(alloc);
        val_map.destroy(alloc);
        slot_map.destroy(alloc);
        return 0_u8;
    }

    // 4. Split `call_bb` instructions into pre-call (`call_bb`) and post-call (`cont_bb`) zero-copy.
    let pre_r = ast.range_new(call_insts_r.start, call_ii);

    // 5. Update ALL caller block Phis that referenced `pred_bb == call_bb` -> `cont_bb`!
    var cbi: u32 = 0_u32;
    while cbi < orig_caller_nblks {
        update_block_phi_pred(eir_prog, caller_fid, cbi, call_bb, cont_bb);
        cbi = cbi +% 1_u32;
    }

    // 6. Clone all reachable callee blocks & collect `Return` edges -> `cont_bb`.
    var ret_edges = try col.DynBuf.[eir.EirPhiIn].init(alloc, 4_usize);
    errdefer ret_edges.destroy(alloc);
    var cloned_blks = try col.DynBuf.[eir.EirBlock].init(alloc, callee_rpo_r.len.widen.[usize]());
    errdefer cloned_blks.destroy(alloc);
    var tmp_phis = try col.DynBuf.[eir.EirPhi].init(alloc, 8_usize);
    errdefer tmp_phis.destroy(alloc);
    var tmp_inc = try col.DynBuf.[eir.EirPhiIn].init(alloc, 8_usize);
    errdefer tmp_inc.destroy(alloc);
    var tmp_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer tmp_insts.destroy(alloc);
    var tmp_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer tmp_flags.destroy(alloc);
    var tmp_sw = try col.DynBuf.[cfg_ir.SwitchTarget].init(alloc, 8_usize);
    errdefer tmp_sw.destroy(alloc);

    var cri3: u32 = 0_u32;
    while cri3 < callee_rpo_r.len {
        var cbb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((callee_rpo_r.start +% cri3).widen.[usize]()) {
            cbb = bp.*;
        }
        let new_bb_id = u32_at(&bb_map, cbb.widen.[usize]());
        var cphis_r = ast.range_empty();
        var cinsts_r = ast.range_empty();
        var cterm = eir.term_unreachable(span.span_dummy(), false);
        if let cblk = eir_prog.fn_block(callee_fid, cbb) {
            cphis_r = cblk.phis;
            cinsts_r = cblk.insts;
            cterm = cblk.term;
        }

        // Clone Phis.
        tmp_phis.clear();
        var kpi: u32 = 0_u32;
        while kpi < cphis_r.len {
            if let pp = eir_prog.funcs.phis.get((cphis_r.start +% kpi).widen.[usize]()) {
                let phi = pp.*;
                tmp_inc.clear();
                var ki: u32 = 0_u32;
                while ki < phi.incoming.len {
                    if let inp = eir_prog.funcs.phi_in.get((phi.incoming.start +% ki).widen.[usize]()) {
                        let entry_in = inp.*;
                        let mapped_pred = u32_at(&bb_map, entry_in.pred_bb.widen.[usize]());
                        if mapped_pred != eir.EIR_NONE {
                            try tmp_inc.push(alloc, eir.EirPhiIn.{
                                pred_bb: mapped_pred,
                                val: remap_id(entry_in.val, val_map.as_slice()),
                            });
                        }
                    }
                    ki = ki +% 1_u32;
                }
                let inc_r = try eir_prog.append_phi_incoming(alloc, tmp_inc.as_slice());
                try tmp_phis.push(alloc, eir.EirPhi.{
                    dst: remap_id(phi.dst, val_map.as_slice()),
                    ty: phi.ty,
                    incoming: inc_r,
                });
            }
            kpi = kpi +% 1_u32;
        }
        let new_phis_r = try eir_prog.append_phis(alloc, tmp_phis.as_slice());

        // Clone Instructions (preserving proven_safe_insts flags!).
        tmp_insts.clear();
        tmp_flags.clear();
        var kii: u32 = 0_u32;
        while kii < cinsts_r.len {
            let old_gid = cinsts_r.start +% kii;
            if let ip = eir_prog.funcs.insts.get(old_gid.widen.[usize]()) {
                let orig_i = ip.*;
                let old_fl = eir_prog.inst_proven_flags(old_gid);
                let cloned = try clone_and_remap_inst(alloc, eir_prog, &orig_i, val_map.as_slice(), slot_map.as_slice());
                try tmp_insts.push(alloc, cloned);
                try tmp_flags.push(alloc, old_fl);
            }
            kii = kii +% 1_u32;
        }
        let new_insts_r = try append_insts_with_flags(alloc, eir_prog, tmp_insts.as_slice(), tmp_flags.as_slice());

        // Clone & Remap Terminator.
        var new_term = copy cterm;
        match cterm.kind {
            .Goto => {
                new_term.bb0 = u32_at(&bb_map, cterm.bb0.widen.[usize]());
            }
            .Branch => {
                new_term.val = remap_id(cterm.val, val_map.as_slice());
                new_term.bb0 = u32_at(&bb_map, cterm.bb0.widen.[usize]());
                new_term.bb1 = u32_at(&bb_map, cterm.bb1.widen.[usize]());
            }
            .SwitchInt => {
                new_term.val = remap_id(cterm.val, val_map.as_slice());
                new_term.bb0 = u32_at(&bb_map, cterm.bb0.widen.[usize]());
                tmp_sw.clear();
                var ti: u32 = 0_u32;
                while ti < cterm.targets.len {
                    if let tp = eir_prog.funcs.switch_targets.get((cterm.targets.start +% ti).widen.[usize]()) {
                        var st = tp.*;
                        st.target = u32_at(&bb_map, st.target.widen.[usize]());
                        try tmp_sw.push(alloc, st);
                    }
                    ti = ti +% 1_u32;
                }
                new_term.targets = try eir_prog.push_switch_targets(alloc, tmp_sw.as_slice());
            }
            .Return => {
                new_term = eir.term_goto(cont_bb);
                let rv = if cterm.flag { remap_id(cterm.val, val_map.as_slice()) } else { eir.EIR_NONE };
                try ret_edges.push(alloc, eir.EirPhiIn.{ pred_bb: new_bb_id, val: rv });
            }
            .Unreachable => {}
        }

        try cloned_blks.push(alloc, eir.EirBlock.{
            id: new_bb_id,
            phis: new_phis_r,
            insts: new_insts_r,
            term: new_term,
            preds: ast.range_empty(),
            idom: eir.EIR_NONE,
        });
        cri3 = cri3 +% 1_u32;
    }

    // 7. Build `cont_bb` with return value Copy/Phi + remaining post-call insts (zero-copy in-place slice!).
    var cont_phis_r = ast.range_empty();
    var cont_insts_r = ast.range_empty();
    var cont_term = call_term;
    if ret_edges.is_empty() {
        // Callee never returns -> cont_bb is unreachable.
        cont_term = eir.term_unreachable(call_inst.span, false);
    } else {
        var put_copy_at_call = false;
        if call_inst.dst != eir.EIR_NONE {
            let resl = ret_edges.as_slice();
            if resl.len == 1_usize {
                var cpy = eir.inst_zero(call_inst.span, .Copy);
                cpy.dst = call_inst.dst;
                cpy.v0 = resl[0_usize].val;
                let call_gid = call_insts_r.start +% call_ii;
                let inst_mut = eir_prog.funcs.insts.as_mut_slice();
                if call_gid.widen.[usize]() < inst_mut.len {
                    inst_mut[call_gid.widen.[usize]()] = cpy;
                }
                if call_gid.widen.[usize]() < eir_prog.proven_safe_insts.len() {
                    try eir_prog.set_inst_proven_flags(alloc, call_gid, 0_u8);
                }
                put_copy_at_call = true;
            } else {
                let inc_r = try eir_prog.append_phi_incoming(alloc, resl);
                let dty = eir_prog.fn_val_ty(caller_fid, call_inst.dst);
                let p1: [1]eir.EirPhi = [eir.EirPhi.{ dst: call_inst.dst, ty: dty, incoming: inc_r }];
                cont_phis_r = try eir_prog.append_phis(alloc, &p1);
            }
        }
        if put_copy_at_call {
            let rem = if call_insts_r.len > call_ii { call_insts_r.len -% call_ii } else { 0_u32 };
            cont_insts_r = ast.range_new(call_insts_r.start +% call_ii, rem);
        } else {
            let post_off = call_ii +% 1_u32;
            let rem = if call_insts_r.len > post_off { call_insts_r.len -% post_off } else { 0_u32 };
            cont_insts_r = ast.range_new(call_insts_r.start +% post_off, rem);
        }
    }

    // 8. Extend caller's blocks slice (`0..orig_caller_nblks` + `cont_bb` + `cloned_blks`),
    // using O(callee) tail-extend when caller's blocks are already at the arena tail!
    let cont_blk = eir.EirBlock.{
        id: cont_bb,
        phis: cont_phis_r,
        insts: cont_insts_r,
        term: cont_term,
        preds: ast.range_empty(),
        idom: eir.EIR_NONE,
    };
    let tail_blks = orig_caller_blks_r.len > 0_u32
        && (orig_caller_blks_r.start.widen.[usize]() +% orig_caller_blks_r.len.widen.[usize]()) == eir_prog.funcs.blocks.len();
    if tail_blks {
        let cb_idx = (orig_caller_blks_r.start +% call_bb).widen.[usize]();
        let bm_sl = eir_prog.funcs.blocks.as_mut_slice();
        if cb_idx < bm_sl.len {
            bm_sl[cb_idx].insts = pre_r;
            bm_sl[cb_idx].term = eir.term_goto(callee_entry_mapped);
        }
        try eir_prog.funcs.blocks.push(alloc, cont_blk);
        try eir_prog.funcs.blocks.push_slice(alloc, cloned_blks.as_slice());
        let new_len = orig_caller_nblks +% 1_u32 +% cloned_blks.len().trunc.[u32]();
        if let fm = eir_prog.get_fn_mut(caller_fid) {
            fm.blocks = ast.range_new(orig_caller_blks_r.start, new_len);
        }
    } else {
        var all_blks = try col.DynBuf.[eir.EirBlock].init(
            alloc,
            orig_caller_nblks.widen.[usize]() +% 1_usize +% cloned_blks.len(),
        );
        errdefer all_blks.destroy(alloc);
        var bi: u32 = 0_u32;
        while bi < orig_caller_nblks {
            var blk = eir.EirBlock.{
                id: bi,
                phis: ast.range_empty(),
                insts: ast.range_empty(),
                term: eir.term_unreachable(span.span_dummy(), false),
                preds: ast.range_empty(),
                idom: eir.EIR_NONE,
            };
            if let bp = eir_prog.funcs.blocks.get((orig_caller_blks_r.start +% bi).widen.[usize]()) {
                blk = bp.*;
            }
            if bi == call_bb {
                blk.insts = pre_r;
                blk.term = eir.term_goto(callee_entry_mapped);
            }
            try all_blks.push(alloc, blk);
            bi = bi +% 1_u32;
        }
        try all_blks.push(alloc, cont_blk);
        try all_blks.push_slice(alloc, cloned_blks.as_slice());

        let new_blks_r = try eir_prog.append_blocks(alloc, all_blks.as_slice());
        if let fm = eir_prog.get_fn_mut(caller_fid) {
            fm.blocks = new_blks_r;
        }
        all_blks.destroy(alloc);
    }

    // 9. Rebuild caller RPO/preds/dominators & prune unreachable phi preds.
    try eir_prog.rebuild_fn_rpo(alloc, caller_fid);
    try eir_prog.prune_fn_phi_preds(alloc, caller_fid);
    try clear_unreachable_blocks(alloc, eir_prog, caller_fid);

    tmp_sw.destroy(alloc);
    tmp_flags.destroy(alloc);
    tmp_insts.destroy(alloc);
    tmp_inc.destroy(alloc);
    tmp_phis.destroy(alloc);
    cloned_blks.destroy(alloc);
    ret_edges.destroy(alloc);
    bb_map.destroy(alloc);
    val_map.destroy(alloc);
    slot_map.destroy(alloc);
    return 2_u8;
}

struct InlineSiteFound {
    found: bool;
    ri: usize;
    bb: eir.BlockId;
    ii: u32;
    callee: u32;
}

fn find_inline_site_from(
    eir_prog: *eir.EirProgram,
    caller_fid: u32,
    start_ri: usize,
    cur_caller_sz: usize,
    in_loop: *col.BitSet,
    fn_sizes: *col.DynBuf[u32],
    callsite_cnt: *col.DynBuf[u32],
    is_rec: *col.BitSet,
    has_asm: *col.BitSet,
    incremental_cgu: bool,
) -> InlineSiteFound {
    var res = InlineSiteFound.{ found: false, ri: 0_usize, bb: 0_u32, ii: 0_u32, callee: 0_u32 };
    let rpo = eir_prog.fn_rpo(caller_fid);
    var ri = start_ri;
    while ri < rpo.len && !res.found {
        let bb = rpo[ri];
        let bb_in_loop = in_loop.test(bb.widen.[usize]());
        let insts = eir_prog.block_insts(caller_fid, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .Call {
                if let cd = eir_prog.get_call(inst.aux0) {
                    if let cfid = resolve_direct_callee_fn(eir_prog, cd.callee) {
                        let cu = cfid.widen.[usize]();
                        let csz = u32_at(fn_sizes, cu).widen.[usize]();
                        let csites = u32_at(callsite_cnt, cu);
                        if callee_eligible_for_inline(
                            eir_prog, caller_fid, cfid, cur_caller_sz, csz,
                            bb_in_loop, csites, is_rec, has_asm, &inst, cd, incremental_cgu,
                        ) {
                            res = InlineSiteFound.{
                                found: true,
                                ri: ri,
                                bb: bb,
                                ii: ii.trunc.[u32](),
                                callee: cfid,
                            };
                            break;
                        }
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        ri = ri +% 1_usize;
    }
    return res;
}

fn pass_inline(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    stats: *mut OptStats,
    incremental_cgu: bool,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count().widen.[usize]();
    if nfns == 0_usize {
        return;
    }

    var is_rec = try col.BitSet.init(alloc, nfns);
    errdefer is_rec.destroy(alloc);
    var has_asm = try col.BitSet.init(alloc, nfns);
    errdefer has_asm.destroy(alloc);
    var callsite_cnt = try col.DynBuf.[u32].init(alloc, nfns);
    errdefer callsite_cnt.destroy(alloc);
    try fill_u32(alloc, &mut callsite_cnt, nfns, 0_u32);
    var fn_sizes = try col.DynBuf.[u32].init(alloc, nfns);
    errdefer fn_sizes.destroy(alloc);
    try fill_u32(alloc, &mut fn_sizes, nfns, 0_u32);

    var topo_order = try col.DynBuf.[u32].init(alloc, nfns);
    errdefer topo_order.destroy(alloc);
    try find_recursive_fns(alloc, eir_prog, nfns, &mut is_rec, &mut callsite_cnt, &mut has_asm, &mut topo_order);

    var fi0: usize = 0_usize;
    while fi0 < nfns {
        u32_set(&mut fn_sizes, fi0, fn_reachable_inst_count(eir_prog, fi0.trunc.[u32]()).trunc.[u32]());
        fi0 = fi0 +% 1_usize;
    }

    var acc_fact_dsts = try col.DynBuf.[eir.EirValue].init(alloc, 32_usize);
    errdefer acc_fact_dsts.destroy(alloc);
    var acc_fact_vals = try col.DynBuf.[eir.EirValueFact].init(alloc, 32_usize);
    errdefer acc_fact_vals.destroy(alloc);

    // Single bottom-up pass (callees before callers via Tarjan SCC reverse-topological order!):
    // every callee is already inlined before any caller processes it, so each caller extends
    // its `value_tys` / `slots` / `blocks` / `value_facts` pools AT MOST ONCE!
    let topo_sl = topo_order.as_slice();
    var ti: usize = 0_usize;
    while ti < topo_sl.len {
        let caller_fid = topo_sl[ti];
        let caller_i = caller_fid.widen.[usize]();
        var skip_caller = false;
        var caller_nblks: usize = 0_usize;
        if let f = eir_prog.get_fn(caller_fid) {
            if is_opt_protected_fn(f) || has_par_for(f) || f.rpo.len == 0_u32 {
                skip_caller = true;
            } else {
                caller_nblks = f.blocks.len.widen.[usize]();
            }
        } else {
            skip_caller = true;
        }
        if !skip_caller {
            var in_loop = try col.BitSet.init(alloc, max_usize(caller_nblks, 1_usize));
            errdefer in_loop.destroy(alloc);
            try mark_loop_blocks_fn(alloc, eir_prog, caller_fid, &mut in_loop);
            var cur_caller_sz = u32_at(&fn_sizes, caller_i).widen.[usize]();
            var scan_ri: usize = 0_usize;
            var inlines_here: usize = 0_usize;
            acc_fact_dsts.clear();
            acc_fact_vals.clear();
            while inlines_here < 32_usize {
                let site = find_inline_site_from(
                    eir_prog, caller_fid, scan_ri, cur_caller_sz, &in_loop,
                    &fn_sizes, &callsite_cnt, &is_rec, &has_asm, incremental_cgu,
                );
                if !site.found {
                    break;
                }
                let csz_in = u32_at(&fn_sizes, site.callee.widen.[usize]()).widen.[usize]();
                let in_res = try inline_call_site(
                    alloc, eir_prog, caller_fid, site.callee, site.bb, site.ii,
                    &mut acc_fact_dsts, &mut acc_fact_vals,
                );
                if in_res == 0_u8 {
                    break;
                }
                stats.inlined_calls = stats.inlined_calls +% 1_u64;
                inlines_here = inlines_here +% 1_usize;
                if in_res == 1_u8 {
                    cur_caller_sz = cur_caller_sz +% csz_in;
                    scan_ri = site.ri;
                } else {
                    cur_caller_sz = fn_reachable_inst_count(eir_prog, caller_fid);
                    var new_nb: usize = 1_usize;
                    if let f2 = eir_prog.get_fn(caller_fid) {
                        new_nb = max_usize(f2.blocks.len.widen.[usize](), 1_usize);
                    }
                    if new_nb > in_loop.len() {
                        let next_il = try col.BitSet.init(alloc, new_nb);
                        in_loop.destroy(alloc);
                        in_loop = next_il;
                    } else {
                        in_loop.clear();
                    }
                    try mark_loop_blocks_fn(alloc, eir_prog, caller_fid, &mut in_loop);
                    scan_ri = 0_usize;
                }
            }
            if inlines_here > 0_usize {
                if !acc_fact_dsts.is_empty() {
                    var cur_nvals: usize = 0_usize;
                    if let f3 = eir_prog.get_fn(caller_fid) {
                        cur_nvals = f3.value_tys.len.widen.[usize]();
                    }
                    try eir_prog.extend_fn_value_facts(
                        alloc, caller_fid, cur_nvals, acc_fact_dsts.as_slice(), acc_fact_vals.as_slice(),
                    );
                }
                _ = try eliminate_copies_fn(alloc, eir_prog, caller_fid);
                u32_set(&mut fn_sizes, caller_i, fn_reachable_inst_count(eir_prog, caller_fid).trunc.[u32]());
            }
            in_loop.destroy(alloc);
        }
        ti = ti +% 1_usize;
    }

    acc_fact_vals.destroy(alloc);
    acc_fact_dsts.destroy(alloc);
    topo_order.destroy(alloc);
    fn_sizes.destroy(alloc);
    callsite_cnt.destroy(alloc);
    has_asm.destroy(alloc);
    is_rec.destroy(alloc);
    return;
}

// --- Post-Inlining Canonicalizer: SlotAddr + Deref Folding ---
// Turns `p = SlotAddr(s); LoadPlace(Val(p), [.Deref, rest...])` directly into
// `LoadSlot(s)` / `LoadPlace(Slot(s), [rest...])` and removes dead `SlotAddr`s,
// unlocking SROA and Mem2Reg on inlined `&mut self` methods!

fn fold_slot_addr_derefs_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
) -> !OutOfMemory {
    var nvals: usize = 0_usize;
    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) {
            return;
        }
        nvals = f.value_tys.len.widen.[usize]();
        rpo_r = f.rpo;
    } else {
        return;
    }
    if nvals == 0_usize || rpo_r.len == 0_u32 {
        return;
    }

    // Track `val -> slot` for `SlotAddr(s)` (propagated through `Copy` and `Cast(MutToConst)`).
    var addr_slot = try col.DynBuf.[eir.EirSlot].init(alloc, nvals);
    errdefer addr_slot.destroy(alloc);
    try fill_u32(alloc, &mut addr_slot, nvals, eir.EIR_NONE);

    var any_addr = false;
    var r0: u32 = 0_u32;
    while r0 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r0).widen.[usize]()) {
            bb = bp.*;
        }
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .SlotAddr && inst.dst != eir.EIR_NONE {
                u32_set(&mut addr_slot, inst.dst.widen.[usize](), inst.aux0);
                any_addr = true;
            } else if (inst.kind == .Copy || (inst.kind == .Cast && inst.cast_kind == .MutToConst))
                && inst.dst != eir.EIR_NONE
            {
                let sl = u32_at(&addr_slot, inst.v0.widen.[usize]());
                if sl != eir.EIR_NONE {
                    u32_set(&mut addr_slot, inst.dst.widen.[usize](), sl);
                }
            }
            ii = ii +% 1_usize;
        }
        r0 = r0 +% 1_u32;
    }
    if !any_addr {
        addr_slot.destroy(alloc);
        return;
    }

    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);
    var rem_projs = try col.DynBuf.[eir.EirProj].init(alloc, 8_usize);
    errdefer rem_projs.destroy(alloc);

    var any_folded = false;
    var r1: u32 = 0_u32;
    while r1 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r1).widen.[usize]()) {
            bb = bp.*;
        }
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            insts_r = blk.insts;
        }
        new_insts.clear();
        new_flags.clear();
        var bchanged = false;

        var ii: u32 = 0_u32;
        while ii < insts_r.len {
            let gid = insts_r.start +% ii;
            var inst = eir.inst_zero(span.span_dummy(), .ParForHint);
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                inst = ip.*;
            }
            let fl = eir_prog.inst_proven_flags(gid);
            var handled = false;

            if inst.kind == .LoadPlace || inst.kind == .StorePlace || inst.kind == .PlaceAddr {
                var pl = eir.EirPlace.{
                    base: eir.place_base_slot(0_u32),
                    projs: ast.range_empty(),
                    ty: types.TY_VOID,
                };
                var have_pl = false;
                if let pp = eir_prog.get_place(inst.aux0) {
                    pl = pp.*;
                    have_pl = true;
                }
                if have_pl && pl.base.kind == .Val && pl.projs.len >= 1_u32 {
                    let s = u32_at(&addr_slot, pl.base.id.widen.[usize]());
                    if s != eir.EIR_NONE {
                        var first_deref = false;
                        if let pr0 = eir_prog.exprs.projs.get(pl.projs.start.widen.[usize]()) {
                            first_deref = pr0.kind == .Deref;
                        }
                        if first_deref {
                            var sty = types.TY_ERROR;
                            if let si = eir_prog.fn_slot(fn_id, s) {
                                sty = si.ty;
                            }
                            if pl.projs.len == 1_u32 {
                                if inst.kind == .LoadPlace && eir_prog.fn_val_ty(fn_id, inst.dst) == sty {
                                    var ls = eir.inst_zero(inst.span, .LoadSlot);
                                    ls.dst = inst.dst;
                                    ls.aux0 = s;
                                    try new_insts.push(alloc, ls);
                                    try new_flags.push(alloc, 0_u8);
                                    handled = true;
                                    bchanged = true;
                                    any_folded = true;
                                } else if inst.kind == .StorePlace && eir_prog.fn_val_ty(fn_id, inst.v0) == sty {
                                    var ss = eir.inst_zero(inst.span, .StoreSlot);
                                    ss.aux0 = s;
                                    ss.v0 = inst.v0;
                                    try new_insts.push(alloc, ss);
                                    try new_flags.push(alloc, 0_u8);
                                    handled = true;
                                    bchanged = true;
                                    any_folded = true;
                                } else if inst.kind == .PlaceAddr {
                                    var sa = eir.inst_zero(inst.span, .SlotAddr);
                                    sa.dst = inst.dst;
                                    sa.aux0 = s;
                                    sa.flag0 = inst.flag0;
                                    sa.ty0 = inst.ty0;
                                    try new_insts.push(alloc, sa);
                                    try new_flags.push(alloc, 0_u8);
                                    handled = true;
                                    bchanged = true;
                                    any_folded = true;
                                }
                            } else {
                                rem_projs.clear();
                                var pri: u32 = 1_u32;
                                while pri < pl.projs.len {
                                    if let prp = eir_prog.exprs.projs.get((pl.projs.start +% pri).widen.[usize]()) {
                                        try rem_projs.push(alloc, prp.*);
                                    }
                                    pri = pri +% 1_u32;
                                }
                                let npr = try eir_prog.append_projs(alloc, rem_projs.as_slice());
                                let npid = try eir_prog.push_place(
                                    alloc,
                                    eir.EirPlace.{ base: eir.place_base_slot(s), projs: npr, ty: pl.ty },
                                );
                                var ninst = copy inst;
                                ninst.aux0 = npid;
                                try new_insts.push(alloc, ninst);
                                try new_flags.push(alloc, fl);
                                handled = true;
                                bchanged = true;
                                any_folded = true;
                            }
                        }
                    }
                }
            } else if inst.kind == .PoolColumnLoad || inst.kind == .PoolColumnStore {
                var op = eir.EirPoolColOp.{
                    pool_base: eir.place_base_slot(0_u32),
                    pool_is_ptr: false,
                    is_slot_pool: false,
                    col: span.SYM_EMPTY,
                    col_idx: 0_u32,
                    index: eir.EIR_NONE,
                    elem_ty: types.TY_VOID,
                };
                var have_op = false;
                if let opp = eir_prog.get_pool_col_op(inst.aux0) {
                    op = opp.*;
                    have_op = true;
                }
                if have_op && op.pool_base.kind == .Val && op.pool_is_ptr {
                    let s = u32_at(&addr_slot, op.pool_base.id.widen.[usize]());
                    if s != eir.EIR_NONE {
                        op.pool_base = eir.place_base_slot(s);
                        op.pool_is_ptr = false;
                        let nop_id = try eir_prog.push_pool_col_op(alloc, op);
                        var ninst = copy inst;
                        ninst.aux0 = nop_id;
                        try new_insts.push(alloc, ninst);
                        try new_flags.push(alloc, fl);
                        handled = true;
                        bchanged = true;
                        any_folded = true;
                    }
                }
            }

            if !handled {
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            }
            ii = ii +% 1_u32;
        }

        if bchanged {
            try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
        }
        r1 = r1 +% 1_u32;
    }

    // Sweep dead unused `SlotAddr` / `Cast(MutToConst)` of SlotAddr so SROA & Mem2Reg immediately see slots unescaped!
    if any_folded {
        var sweep: usize = 0_usize;
        var used_vals = try col.BitSet.init(alloc, nvals);
        errdefer used_vals.destroy(alloc);
        var uses = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
        errdefer uses.destroy(alloc);
        while sweep < 2_usize {
            used_vals.clear();
            var rs: u32 = 0_u32;
            while rs < rpo_r.len {
                var bb: eir.BlockId = 0_u32;
                if let bp = eir_prog.meta.rpo.get((rpo_r.start +% rs).widen.[usize]()) {
                    bb = bp.*;
                }
                let phis = eir_prog.block_phis(fn_id, bb);
                var pi: usize = 0_usize;
                while pi < phis.len {
                    let incs = eir_prog.phi_incoming(phis[pi].incoming);
                    var ki: usize = 0_usize;
                    while ki < incs.len {
                        let vu = incs[ki].val.widen.[usize]();
                        if vu < nvals {
                            used_vals.set(vu);
                        }
                        ki = ki +% 1_usize;
                    }
                    pi = pi +% 1_usize;
                }
                let insts = eir_prog.block_insts(fn_id, bb);
                var ii: usize = 0_usize;
                while ii < insts.len {
                    try eir.collect_inst_uses(alloc, eir_prog, &insts[ii], &mut uses);
                    let usl = uses.as_slice();
                    var ui: usize = 0_usize;
                    while ui < usl.len {
                        let vu = usl[ui].widen.[usize]();
                        if vu < nvals {
                            used_vals.set(vu);
                        }
                        ui = ui +% 1_usize;
                    }
                    ii = ii +% 1_usize;
                }
                if let blk = eir_prog.fn_block(fn_id, bb) {
                    if blk.term.kind == .Branch || blk.term.kind == .SwitchInt || (blk.term.kind == .Return && blk.term.flag) {
                        let vu = blk.term.val.widen.[usize]();
                        if vu < nvals {
                            used_vals.set(vu);
                        }
                    }
                }
                rs = rs +% 1_u32;
            }

            var removed_any = false;
            var rs2: u32 = 0_u32;
            while rs2 < rpo_r.len {
                var bb: eir.BlockId = 0_u32;
                if let bp = eir_prog.meta.rpo.get((rpo_r.start +% rs2).widen.[usize]()) {
                    bb = bp.*;
                }
                var insts_r = ast.range_empty();
                if let blk = eir_prog.fn_block(fn_id, bb) {
                    insts_r = blk.insts;
                }
                new_insts.clear();
                new_flags.clear();
                var bch = false;
                var ii: u32 = 0_u32;
                while ii < insts_r.len {
                    let gid = insts_r.start +% ii;
                    if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                        let inst = ip.*;
                        let is_dead_addr = (inst.kind == .SlotAddr
                            || inst.kind == .Copy
                            || (inst.kind == .Cast && inst.cast_kind == .MutToConst))
                            && inst.dst != eir.EIR_NONE
                            && inst.dst.widen.[usize]() < nvals
                            && u32_at(&addr_slot, inst.dst.widen.[usize]()) != eir.EIR_NONE
                            && !used_vals.test(inst.dst.widen.[usize]());
                        if is_dead_addr {
                            bch = true;
                            removed_any = true;
                        } else {
                            try new_insts.push(alloc, inst);
                            try new_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                        }
                    }
                    ii = ii +% 1_u32;
                }
                if bch {
                    try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
                }
                rs2 = rs2 +% 1_u32;
            }
            if !removed_any {
                break;
            }
            sweep = sweep +% 1_usize;
        }
        uses.destroy(alloc);
        used_vals.destroy(alloc);
    }

    rem_projs.destroy(alloc);
    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    addr_slot.destroy(alloc);
    return;
}

fn fold_slot_addr_derefs_prog(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        try fold_slot_addr_derefs_fn(alloc, eir_prog, fi);
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Section 5: Pass 3 — SROA (Scalar Replacement of Aggregates & view struct)
// ===========================================================================

fn sroa_agg_field_count(env: *types.TypeEnv, ty: types.TyId) -> usize {
    let n = env.get(ty);
    match n.kind {
        .Struct => {
            if let sm = env.get_struct(n.primary) {
                return sm.fields.len.widen.[usize]();
            }
            return 0_usize;
        }
        .AnonStruct => { return n.list_len.widen.[usize](); }
        .Tuple => { return n.list_len.widen.[usize](); }
        _ => { return 0_usize; }
    }
}

fn sroa_is_concrete_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    let k = env.get(ty).kind;
    return k != .Error && k != .GenericParam && k != .ComptimeInt && k != .ComptimeFloat && k != .Void && k != .Never;
}

fn sroa_fn_once(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> u64 ! OutOfMemory {
    var nslots: usize = 0_usize;
    var nvals: usize = 0_usize;
    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) {
            return 0_u64;
        }
        nslots = f.slots.len.widen.[usize]();
        nvals = f.value_tys.len.widen.[usize]();
        rpo_r = f.rpo;
    } else {
        return 0_u64;
    }
    if nslots == 0_usize || rpo_r.len == 0_u32 {
        return 0_u64;
    }

    var par_slots = try col.BitSet.init(alloc, nslots);
    errdefer par_slots.destroy(alloc);
    collect_par_for_slots(eir_prog, fn_id, &mut par_slots);

    // 1. Identify candidate aggregate slots (Struct / AnonStruct / Tuple, 1..=16 concrete fields)
    //    AND single-def slice borrow slots (`Borrow(Slice|Str)`).
    var agg_cand = try col.BitSet.init(alloc, nslots);
    errdefer agg_cand.destroy(alloc);
    var slice_cand = try col.BitSet.init(alloc, nslots);
    errdefer slice_cand.destroy(alloc);
    var field_cnts = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer field_cnts.destroy(alloc);
    try fill_u32(alloc, &mut field_cnts, nslots, 0_u32);

    var si: usize = 0_usize;
    while si < nslots {
        if !par_slots.test(si) {
            if let sp = eir_prog.fn_slot(fn_id, si.trunc.[u32]()) {
                let sty = sp.ty;
                let sn = env.get(sty);
                let fc = sroa_agg_field_count(env, sty);
                if fc >= 1_usize && fc <= 16_usize {
                    var all_conc = true;
                    var fi: usize = 0_usize;
                    while fi < fc {
                        let fty = env.struct_field_offset(sty, fi).ty;
                        if !sroa_is_concrete_ty(env, fty) {
                            all_conc = false;
                            break;
                        }
                        fi = fi +% 1_usize;
                    }
                    if all_conc {
                        agg_cand.set(si);
                        u32_set(&mut field_cnts, si, fc.trunc.[u32]());
                    }
                } else if sn.kind == .Borrow && (sn.borrow_kind == .Slice || sn.borrow_kind == .Str) {
                    slice_cand.set(si);
                }
            }
        }
        si = si +% 1_usize;
    }

    // 2. Map SSA values defined by `Aggregate(Struct|AnonStruct|Tuple)` -> global inst index.
    var agg_def_gid = try col.DynBuf.[u32].init(alloc, max_usize(nvals, 1_usize));
    errdefer agg_def_gid.destroy(alloc);
    try fill_u32(alloc, &mut agg_def_gid, nvals, eir.EIR_NONE);
    var agg_def_bb = try col.DynBuf.[u32].init(alloc, max_usize(nvals, 1_usize));
    errdefer agg_def_bb.destroy(alloc);
    try fill_u32(alloc, &mut agg_def_bb, nvals, eir.EIR_NONE);

    var slice_stores = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer slice_stores.destroy(alloc);
    var slice_sbb = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer slice_sbb.destroy(alloc);
    var slice_spos = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer slice_spos.destroy(alloc);
    var slice_sval = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer slice_sval.destroy(alloc);
    try fill_u32(alloc, &mut slice_stores, nslots, 0_u32);
    try fill_u32(alloc, &mut slice_sbb, nslots, eir.EIR_NONE);
    try fill_u32(alloc, &mut slice_spos, nslots, 0_u32);
    try fill_u32(alloc, &mut slice_sval, nslots, eir.EIR_NONE);

    var agg_has_use = try col.BitSet.init(alloc, nslots);
    errdefer agg_has_use.destroy(alloc);
    var slice_has_idx = try col.BitSet.init(alloc, nslots);
    errdefer slice_has_idx.destroy(alloc);

    var r0: u32 = 0_u32;
    while r0 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r0).widen.[usize]()) {
            bb = bp.*;
        }
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            insts_r = blk.insts;
        }
        var ii: u32 = 0_u32;
        while ii < insts_r.len {
            let gid = insts_r.start +% ii;
            var inst = eir.inst_zero(span.span_dummy(), .ParForHint);
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                inst = ip.*;
            }
            if inst.kind == .Aggregate && inst.dst != eir.EIR_NONE {
                if let ak = eir_prog.get_aggregate(inst.aux0) {
                    if ak.tag == .Struct || ak.tag == .AnonStruct || ak.tag == .Tuple {
                        u32_set(&mut agg_def_gid, inst.dst.widen.[usize](), gid);
                        u32_set(&mut agg_def_bb, inst.dst.widen.[usize](), bb);
                    }
                }
            }
            match inst.kind {
                .SlotAddr => {
                    let su = inst.aux0.widen.[usize]();
                    if su < nslots {
                        agg_cand.unset(su);
                        slice_cand.unset(su);
                    }
                }
                .LoadSlot => {
                    let su = inst.aux0.widen.[usize]();
                    if su < nslots {
                        agg_cand.unset(su);
                    }
                }
                .StoreSlot => {
                    let su = inst.aux0.widen.[usize]();
                    if su < nslots {
                        if agg_cand.test(su) {
                            let vu = inst.v0.widen.[usize]();
                            let agid = u32_at(&agg_def_gid, vu);
                            let abb = u32_at(&agg_def_bb, vu);
                            var ok_store = false;
                            if agid != eir.EIR_NONE && eir_prog.dominates_block(fn_id, abb, bb) {
                                if let aip = eir_prog.funcs.insts.get(agid.widen.[usize]()) {
                                    let fc = u32_at(&field_cnts, su);
                                    if aip.range.len == fc {
                                        var sty = types.TY_ERROR;
                                        if let sp = eir_prog.fn_slot(fn_id, inst.aux0) {
                                            sty = sp.ty;
                                        }
                                        let elems = eir_prog.vals_slice(aip.range);
                                        ok_store = true;
                                        var k: usize = 0_usize;
                                        while k < elems.len {
                                            let fty = env.struct_field_offset(sty, k).ty;
                                            if eir_prog.fn_val_ty(fn_id, elems[k]) != fty {
                                                ok_store = false;
                                                break;
                                            }
                                            k = k +% 1_usize;
                                        }
                                    }
                                }
                            }
                            if !ok_store {
                                agg_cand.unset(su);
                            } else {
                                agg_has_use.set(su);
                            }
                            _ = 0_u8;
                        }
                        if slice_cand.test(su) {
                            let prev_ss = u32_at(&slice_stores, su);
                            u32_set(&mut slice_stores, su, prev_ss +% 1_u32);
                            u32_set(&mut slice_sbb, su, bb);
                            u32_set(&mut slice_spos, su, ii);
                            u32_set(&mut slice_sval, su, inst.v0);
                        }
                    }
                    _ = 0_u8;
                }
                .LoadPlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots {
                                let ps = eir_prog.projs_slice(pl.projs);
                                if agg_cand.test(su) {
                                    let fc = u32_at(&field_cnts, su);
                                    var ok_p = false;
                                    if ps.len >= 1_usize {
                                        let p0 = ps[0_usize];
                                        ok_p = (p0.kind == .Field || p0.kind == .TupleField) && p0.index < fc;
                                        if ok_p && ps.len == 1_usize {
                                            if let sp = eir_prog.fn_slot(fn_id, pl.base.id) {
                                                let fty = env.struct_field_offset(sp.ty, p0.index.widen.[usize]()).ty;
                                                if eir_prog.fn_val_ty(fn_id, inst.dst) != fty {
                                                    ok_p = false;
                                                }
                                            }
                                        }
                                    }
                                    if !ok_p {
                                        agg_cand.unset(su);
                                    } else {
                                        agg_has_use.set(su);
                                    }
                                    _ = 0_u8;
                                }
                                if slice_cand.test(su) {
                                    if ps.len >= 1_usize && ps[0_usize].kind == .Index {
                                        slice_has_idx.set(su);
                                    } else {
                                        slice_cand.unset(su);
                                    }
                                    _ = 0_u8;
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .StorePlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots {
                                let ps = eir_prog.projs_slice(pl.projs);
                                if agg_cand.test(su) {
                                    let fc = u32_at(&field_cnts, su);
                                    var ok_p = false;
                                    if ps.len >= 1_usize {
                                        let p0 = ps[0_usize];
                                        ok_p = (p0.kind == .Field || p0.kind == .TupleField) && p0.index < fc;
                                        if ok_p && ps.len == 1_usize {
                                            if let sp = eir_prog.fn_slot(fn_id, pl.base.id) {
                                                let fty = env.struct_field_offset(sp.ty, p0.index.widen.[usize]()).ty;
                                                if eir_prog.fn_val_ty(fn_id, inst.v0) != fty {
                                                    ok_p = false;
                                                }
                                            }
                                        }
                                    }
                                    if !ok_p {
                                        agg_cand.unset(su);
                                    } else {
                                        agg_has_use.set(su);
                                    }
                                    _ = 0_u8;
                                }
                                if slice_cand.test(su) {
                                    if ps.len >= 1_usize && ps[0_usize].kind == .Index {
                                        slice_has_idx.set(su);
                                    } else {
                                        slice_cand.unset(su);
                                    }
                                    _ = 0_u8;
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .PlaceAddr => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots {
                                slice_cand.unset(su);
                                if agg_cand.test(su) {
                                    let ps = eir_prog.projs_slice(pl.projs);
                                    let fc = u32_at(&field_cnts, su);
                                    var ok_p = false;
                                    if ps.len >= 1_usize {
                                        let p0 = ps[0_usize];
                                        ok_p = (p0.kind == .Field || p0.kind == .TupleField) && p0.index < fc;
                                    }
                                    if !ok_p {
                                        agg_cand.unset(su);
                                    } else {
                                        agg_has_use.set(su);
                                    }
                                    _ = 0_u8;
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .PoolColumnLoad => {
                    if let op = eir_prog.get_pool_col_op(inst.aux0) {
                        if op.pool_base.kind == .Slot && op.pool_base.id.widen.[usize]() < nslots {
                            agg_cand.unset(op.pool_base.id.widen.[usize]());
                            slice_cand.unset(op.pool_base.id.widen.[usize]());
                        }
                    }
                }
                .PoolColumnStore => {
                    if let op = eir_prog.get_pool_col_op(inst.aux0) {
                        if op.pool_base.kind == .Slot && op.pool_base.id.widen.[usize]() < nslots {
                            agg_cand.unset(op.pool_base.id.widen.[usize]());
                            slice_cand.unset(op.pool_base.id.widen.[usize]());
                        }
                    }
                }
                .BuiltinCall => {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                        var ki: usize = 0_usize;
                        while ki < ss.len {
                            if ss[ki] != eir.EIR_NONE && ss[ki].widen.[usize]() < nslots {
                                agg_cand.unset(ss[ki].widen.[usize]());
                                slice_cand.unset(ss[ki].widen.[usize]());
                            }
                            ki = ki +% 1_usize;
                        }
                    }
                }
                _ => {}
            }
            ii = ii +% 1_u32;
        }
        r0 = r0 +% 1_u32;
    }

    // Validate slice_cand dominance (must have exactly 1 StoreSlot dominating all uses).
    var s_chk: usize = 0_usize;
    while s_chk < nslots {
        if agg_cand.test(s_chk) && !agg_has_use.test(s_chk) {
            agg_cand.unset(s_chk);
        }
        if slice_cand.test(s_chk) {
            if u32_at(&slice_stores, s_chk) != 1_u32 || !slice_has_idx.test(s_chk) {
                slice_cand.unset(s_chk);
            }
        }
        s_chk = s_chk +% 1_usize;
    }

    var r_sc: u32 = 0_u32;
    while r_sc < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r_sc).widen.[usize]()) {
            bb = bp.*;
        }
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            var chk_s = eir.EIR_NONE;
            if inst.kind == .LoadSlot {
                chk_s = inst.aux0;
            } else if inst.kind == .LoadPlace || inst.kind == .StorePlace {
                if let pl = eir_prog.get_place(inst.aux0) {
                    if pl.base.kind == .Slot {
                        chk_s = pl.base.id;
                    }
                }
            }
            if chk_s != eir.EIR_NONE && chk_s.widen.[usize]() < nslots && slice_cand.test(chk_s.widen.[usize]()) {
                let su = chk_s.widen.[usize]();
                let sbb = u32_at(&slice_sbb, su);
                let spos = u32_at(&slice_spos, su);
                if !eir_prog.dominates_block(fn_id, sbb, bb) || (sbb == bb && spos >= ii.trunc.[u32]()) {
                    slice_cand.unset(su);
                }
            }
            ii = ii +% 1_usize;
        }
        r_sc = r_sc +% 1_u32;
    }

    // 3. Allocate scalar field slots for every winning `agg_cand` slot.
    var fslot_off = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer fslot_off.destroy(alloc);
    try fill_u32(alloc, &mut fslot_off, nslots, eir.EIR_NONE);
    var fslots_flat = try col.DynBuf.[eir.EirSlot].init(alloc, 16_usize);
    errdefer fslots_flat.destroy(alloc);

    var sroa_cnt: u64 = 0_u64;
    var si2: usize = 0_usize;
    while si2 < nslots {
        if agg_cand.test(si2) {
            var sty = types.TY_ERROR;
            var is_m = true;
            if let sp = eir_prog.fn_slot(fn_id, si2.trunc.[u32]()) {
                sty = sp.ty;
                is_m = sp.is_mut;
            }
            let fc = u32_at(&field_cnts, si2).widen.[usize]();
            u32_set(&mut fslot_off, si2, fslots_flat.len().trunc.[u32]());
            var k: usize = 0_usize;
            while k < fc {
                let fty = env.struct_field_offset(sty, k).ty;
                let ns = try eir_prog.alloc_fn_slot(
                    alloc,
                    fn_id,
                    eir.EirSlotInfo.{
                        id: 0_u32,
                        ty: fty,
                        has_name: false,
                        name: span.SYM_EMPTY,
                        is_mut: is_m,
                    },
                );
                try fslots_flat.push(alloc, ns);
                k = k +% 1_usize;
            }
            sroa_cnt = sroa_cnt +% 1_u64;
        } else if slice_cand.test(si2) {
            sroa_cnt = sroa_cnt +% 1_u64;
        }
        si2 = si2 +% 1_usize;
    }

    if sroa_cnt == 0_u64 {
        fslots_flat.destroy(alloc);
        fslot_off.destroy(alloc);
        slice_has_idx.destroy(alloc);
        agg_has_use.destroy(alloc);
        slice_sval.destroy(alloc);
        slice_spos.destroy(alloc);
        slice_sbb.destroy(alloc);
        slice_stores.destroy(alloc);
        agg_def_bb.destroy(alloc);
        agg_def_gid.destroy(alloc);
        field_cnts.destroy(alloc);
        slice_cand.destroy(alloc);
        agg_cand.destroy(alloc);
        par_slots.destroy(alloc);
        return 0_u64;
    }

    // 4. Rewrite instructions for exploded aggregates and promoted slice slots.
    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);
    var rem_projs = try col.DynBuf.[eir.EirProj].init(alloc, 8_usize);
    errdefer rem_projs.destroy(alloc);
    var elem_vals = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
    errdefer elem_vals.destroy(alloc);

    var r1: u32 = 0_u32;
    while r1 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r1).widen.[usize]()) {
            bb = bp.*;
        }
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            insts_r = blk.insts;
        }
        new_insts.clear();
        new_flags.clear();
        var bchanged = false;

        var ii: u32 = 0_u32;
        while ii < insts_r.len {
            let gid = insts_r.start +% ii;
            var inst = eir.inst_zero(span.span_dummy(), .ParForHint);
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                inst = ip.*;
            }
            let fl = eir_prog.inst_proven_flags(gid);
            var handled = false;

            if inst.kind == .StoreSlot {
                let su = inst.aux0.widen.[usize]();
                if su < nslots && agg_cand.test(su) {
                    let agid = u32_at(&agg_def_gid, inst.v0.widen.[usize]());
                    let foff = u32_at(&fslot_off, su).widen.[usize]();
                    elem_vals.clear();
                    if let aip = eir_prog.funcs.insts.get(agid.widen.[usize]()) {
                        let evs = eir_prog.vals_slice(aip.range);
                        try elem_vals.push_slice(alloc, evs);
                    }
                    let evsl = elem_vals.as_slice();
                    var k: usize = 0_usize;
                    while k < evsl.len {
                        var st = eir.inst_zero(inst.span, .StoreSlot);
                        st.aux0 = u32_at(&fslots_flat, foff +% k);
                        st.v0 = evsl[k];
                        try new_insts.push(alloc, st);
                        try new_flags.push(alloc, 0_u8);
                        k = k +% 1_usize;
                    }
                    handled = true;
                    bchanged = true;
                } else if su < nslots && slice_cand.test(su) {
                    handled = true;
                    bchanged = true;
                }
            } else if inst.kind == .LoadSlot {
                let su = inst.aux0.widen.[usize]();
                if su < nslots && slice_cand.test(su) {
                    var cpy = eir.inst_zero(inst.span, .Copy);
                    cpy.dst = inst.dst;
                    cpy.v0 = u32_at(&slice_sval, su);
                    try new_insts.push(alloc, cpy);
                    try new_flags.push(alloc, 0_u8);
                    handled = true;
                    bchanged = true;
                }
            } else if inst.kind == .LoadPlace || inst.kind == .StorePlace || inst.kind == .PlaceAddr {
                var pl = eir.EirPlace.{
                    base: eir.place_base_slot(0_u32),
                    projs: ast.range_empty(),
                    ty: types.TY_VOID,
                };
                var have_pl = false;
                if let pp = eir_prog.get_place(inst.aux0) {
                    pl = pp.*;
                    have_pl = true;
                }
                if have_pl && pl.base.kind == .Slot {
                    let su = pl.base.id.widen.[usize]();
                    if su < nslots && agg_cand.test(su) && pl.projs.len >= 1_u32 {
                        var fidx: u32 = 0_u32;
                        if let pr0 = eir_prog.exprs.projs.get(pl.projs.start.widen.[usize]()) {
                            fidx = pr0.index;
                        }
                        let foff = u32_at(&fslot_off, su).widen.[usize]();
                        let fslot = u32_at(&fslots_flat, foff +% fidx.widen.[usize]());
                        if pl.projs.len == 1_u32 {
                            if inst.kind == .LoadPlace {
                                var ls = eir.inst_zero(inst.span, .LoadSlot);
                                ls.dst = inst.dst;
                                ls.aux0 = fslot;
                                try new_insts.push(alloc, ls);
                                try new_flags.push(alloc, 0_u8);
                            } else if inst.kind == .StorePlace {
                                var ss = eir.inst_zero(inst.span, .StoreSlot);
                                ss.aux0 = fslot;
                                ss.v0 = inst.v0;
                                try new_insts.push(alloc, ss);
                                try new_flags.push(alloc, 0_u8);
                            } else {
                                var sa = eir.inst_zero(inst.span, .SlotAddr);
                                sa.dst = inst.dst;
                                sa.aux0 = fslot;
                                sa.flag0 = inst.flag0;
                                sa.ty0 = inst.ty0;
                                try new_insts.push(alloc, sa);
                                try new_flags.push(alloc, 0_u8);
                            }
                        } else {
                            rem_projs.clear();
                            var pri: u32 = 1_u32;
                            while pri < pl.projs.len {
                                if let prp = eir_prog.exprs.projs.get((pl.projs.start +% pri).widen.[usize]()) {
                                    try rem_projs.push(alloc, prp.*);
                                }
                                pri = pri +% 1_u32;
                            }
                            let npr = try eir_prog.append_projs(alloc, rem_projs.as_slice());
                            let npid = try eir_prog.push_place(
                                alloc,
                                eir.EirPlace.{ base: eir.place_base_slot(fslot), projs: npr, ty: pl.ty },
                            );
                            var ninst = copy inst;
                            ninst.aux0 = npid;
                            try new_insts.push(alloc, ninst);
                            try new_flags.push(alloc, fl);
                        }
                        handled = true;
                        bchanged = true;
                    } else if su < nslots && slice_cand.test(su) && inst.kind != .PlaceAddr {
                        let sv = u32_at(&slice_sval, su);
                        rem_projs.clear();
                        var pri: u32 = 0_u32;
                        while pri < pl.projs.len {
                            if let prp = eir_prog.exprs.projs.get((pl.projs.start +% pri).widen.[usize]()) {
                                try rem_projs.push(alloc, prp.*);
                            }
                            pri = pri +% 1_u32;
                        }
                        let npr = try eir_prog.append_projs(alloc, rem_projs.as_slice());
                        let npid = try eir_prog.push_place(
                            alloc,
                            eir.EirPlace.{ base: eir.place_base_val(sv), projs: npr, ty: pl.ty },
                        );
                        var ninst = copy inst;
                        ninst.aux0 = npid;
                        try new_insts.push(alloc, ninst);
                        try new_flags.push(alloc, fl);
                        handled = true;
                        bchanged = true;
                    }
                }
            }

            if !handled {
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            }
            ii = ii +% 1_u32;
        }

        if bchanged {
            try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
        }
        r1 = r1 +% 1_u32;
    }

    _ = try eliminate_copies_fn(alloc, eir_prog, fn_id);
    elem_vals.destroy(alloc);
    rem_projs.destroy(alloc);
    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    fslots_flat.destroy(alloc);
    fslot_off.destroy(alloc);
    slice_has_idx.destroy(alloc);
    agg_has_use.destroy(alloc);
    slice_sval.destroy(alloc);
    slice_spos.destroy(alloc);
    slice_sbb.destroy(alloc);
    slice_stores.destroy(alloc);
    agg_def_bb.destroy(alloc);
    agg_def_gid.destroy(alloc);
    field_cnts.destroy(alloc);
    slice_cand.destroy(alloc);
    agg_cand.destroy(alloc);
    par_slots.destroy(alloc);
    return sroa_cnt;
}

/// Eliminates redundant local stack copies of immutable borrow slice/struct loads:
///   `v = LoadPlace(imm_borrow_val, [Index/Field...]); StoreSlot(s, v); ... LoadPlace(Slot(s), [Field(f)...])`
/// -> rewrites field loads directly to `LoadPlace(imm_borrow_val, [Index/Field..., Field(f)...])`!
/// Soundness: `imm_borrow_val` is a non-mut `.Borrow` (guaranteed immutable by Eon borrow checker!).
fn eliminate_readonly_struct_slot_copy_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> !OutOfMemory {
    var nslots: usize = 0_usize;
    var nvals: usize = 0_usize;
    if let f = eir_prog.get_fn(fn_id) {
        nslots = f.slots.len.widen.[usize]();
        nvals = f.value_tys.len.widen.[usize]();
    } else {
        return;
    }
    if nslots == 0_usize || nvals == 0_usize {
        return;
    }

    var cand = try col.BitSet.init(alloc, nslots);
    errdefer cand.destroy(alloc);
    var has_read = try col.BitSet.init(alloc, nslots);
    errdefer has_read.destroy(alloc);
    var store_cnt = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer store_cnt.destroy(alloc);
    try fill_u32(alloc, &mut store_cnt, nslots, 0_u32);
    var store_bb = try col.DynBuf.[eir.BlockId].init(alloc, nslots);
    errdefer store_bb.destroy(alloc);
    try fill_u32(alloc, &mut store_bb, nslots, eir.EIR_NONE);
    var store_pos = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer store_pos.destroy(alloc);
    try fill_u32(alloc, &mut store_pos, nslots, 0_u32);
    var store_val = try col.DynBuf.[eir.EirValue].init(alloc, nslots);
    errdefer store_val.destroy(alloc);
    try fill_u32(alloc, &mut store_val, nslots, eir.EIR_NONE);

    var val_ld_place = try col.DynBuf.[u32].init(alloc, nvals);
    errdefer val_ld_place.destroy(alloc);
    try fill_u32(alloc, &mut val_ld_place, nvals, eir.EIR_NONE);
    var val_ld_bb = try col.DynBuf.[eir.BlockId].init(alloc, nvals);
    errdefer val_ld_bb.destroy(alloc);
    try fill_u32(alloc, &mut val_ld_bb, nvals, eir.EIR_NONE);
    var val_ld_pos = try col.DynBuf.[u32].init(alloc, nvals);
    errdefer val_ld_pos.destroy(alloc);
    try fill_u32(alloc, &mut val_ld_pos, nvals, 0_u32);

    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < nslots && si < slots.len {
        let sn = env.get(slots[si].ty);
        if (sn.kind == .Struct || sn.kind == .AnonStruct || sn.kind == .Tuple) && env.x64_layout(slots[si].ty).size > 8_usize {
            cand.set(si);
        }
        si = si +% 1_usize;
    }

    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bb = rpo[ri];
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            match inst.kind {
                .StoreSlot => {
                    let su = inst.aux0.widen.[usize]();
                    if su < nslots && cand.test(su) {
                        let sc = u32_at(&store_cnt, su) +% 1_u32;
                        u32_set(&mut store_cnt, su, sc);
                        if sc == 1_u32 {
                            u32_set(&mut store_bb, su, bb);
                            u32_set(&mut store_pos, su, ii.trunc.[u32]());
                            u32_set(&mut store_val, su, inst.v0);
                        } else {
                            cand.unset(su);
                        }
                    }
                }
                .LoadSlot => {
                    let su = inst.aux0.widen.[usize]();
                    if su < nslots { cand.unset(su); }
                }
                .SlotAddr => {
                    let su = inst.aux0.widen.[usize]();
                    if su < nslots { cand.unset(su); }
                }
                .StorePlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots { cand.unset(su); }
                        }
                    }
                    _ = 0_u8;
                }
                .PlaceAddr => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots { cand.unset(su); }
                        }
                    }
                    _ = 0_u8;
                }
                .PoolColumnLoad => {
                    if let op = eir_prog.get_pool_col_op(inst.aux0) {
                        if op.pool_base.kind == .Slot {
                            let su = op.pool_base.id.widen.[usize]();
                            if su < nslots { cand.unset(su); }
                        }
                    }
                    _ = 0_u8;
                }
                .PoolColumnStore => {
                    if let op = eir_prog.get_pool_col_op(inst.aux0) {
                        if op.pool_base.kind == .Slot {
                            let su = op.pool_base.id.widen.[usize]();
                            if su < nslots { cand.unset(su); }
                        }
                    }
                    _ = 0_u8;
                }
                .BuiltinCall => {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                        var ki: usize = 0_usize;
                        while ki < ss.len {
                            if ss[ki] != eir.EIR_NONE && ss[ki].widen.[usize]() < nslots {
                                cand.unset(ss[ki].widen.[usize]());
                            }
                            ki = ki +% 1_usize;
                        }
                    }
                    _ = 0_u8;
                }
                .LoadPlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots && cand.test(su) {
                                let ps = eir_prog.projs_slice(pl.projs);
                                if ps.len > 0_usize && u32_at(&store_cnt, su) == 1_u32
                                    && u32_at(&store_bb, su) == bb
                                    && ii.trunc.[u32]() > u32_at(&store_pos, su)
                                {
                                    has_read.set(su);
                                } else {
                                    cand.unset(su);
                                }
                            }
                        } else if pl.base.kind == .Val && inst.dst != eir.EIR_NONE {
                            let bty = eir_prog.fn_val_ty(fn_id, pl.base.id);
                            let bn = env.get(bty);
                            if bn.kind == .Borrow && !bn.flag0 {
                                let ps = eir_prog.projs_slice(pl.projs);
                                var all_safe = ps.len > 0_usize;
                                var pi: usize = 0_usize;
                                while pi < ps.len {
                                    if ps[pi].kind == .Deref || ps[pi].kind == .PoolCol {
                                        all_safe = false;
                                        break;
                                    }
                                    pi = pi +% 1_usize;
                                }
                                if all_safe {
                                    let du = inst.dst.widen.[usize]();
                                    u32_set(&mut val_ld_place, du, inst.aux0);
                                    u32_set(&mut val_ld_bb, du, bb);
                                    u32_set(&mut val_ld_pos, du, ii.trunc.[u32]());
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                _ => {}
            }
            ii = ii +% 1_usize;
        }
        ri = ri +% 1_usize;
    }

    // Validate each candidate slot's source LoadPlace is in the same block before StoreSlot!
    var any = false;
    var slot_src_place = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer slot_src_place.destroy(alloc);
    try fill_u32(alloc, &mut slot_src_place, nslots, eir.EIR_NONE);
    si = 0_usize;
    while si < nslots {
        if cand.test(si) && has_read.test(si) && u32_at(&store_cnt, si) == 1_u32 {
            let sv = u32_at(&store_val, si);
            if sv != eir.EIR_NONE && sv.widen.[usize]() < nvals {
                let sp_id = u32_at(&val_ld_place, sv.widen.[usize]());
                let s_bb = u32_at(&store_bb, si);
                let l_bb = u32_at(&val_ld_bb, sv.widen.[usize]());
                let s_pos = u32_at(&store_pos, si);
                let l_pos = u32_at(&val_ld_pos, sv.widen.[usize]());
                if sp_id != eir.EIR_NONE && l_bb == s_bb && l_pos < s_pos {
                    u32_set(&mut slot_src_place, si, sp_id);
                    any = true;
                }
            }
        }
        si = si +% 1_usize;
    }

    if any {
        var new_projs = try col.DynBuf.[eir.EirProj].init(alloc, 8_usize);
        errdefer new_projs.destroy(alloc);
        var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
        errdefer new_insts.destroy(alloc);
        var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
        errdefer new_flags.destroy(alloc);

        var rpo_r = ast.range_empty();
        if let f = eir_prog.get_fn(fn_id) { rpo_r = f.rpo; }
        var r2: u32 = 0_u32;
        while r2 < rpo_r.len {
            var bb: eir.BlockId = 0_u32;
            if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r2).widen.[usize]()) { bb = bp.*; }
            var insts_r = ast.range_empty();
            if let blk = eir_prog.fn_block(fn_id, bb) { insts_r = blk.insts; }
            new_insts.clear();
            new_flags.clear();
            var changed = false;
            var ii: u32 = 0_u32;
            while ii < insts_r.len {
                let gid = insts_r.start +% ii;
                var inst = eir.inst_zero(span.span_dummy(), .Copy);
                if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) { inst = ip.*; }
                let fl = eir_prog.inst_proven_flags(gid);
                var drop = false;
                if inst.kind == .StoreSlot {
                    let su = inst.aux0.widen.[usize]();
                    if su < nslots && u32_at(&slot_src_place, su) != eir.EIR_NONE {
                        drop = true;
                        changed = true;
                    }
                } else if inst.kind == .LoadPlace {
                    var rw_src_pid = eir.EIR_NONE;
                    var dst_projs_r = ast.range_empty();
                    var dst_pl_ty = types.TY_VOID;
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot {
                            let su = pl.base.id.widen.[usize]();
                            if su < nslots {
                                let pid = u32_at(&slot_src_place, su);
                                if pid != eir.EIR_NONE {
                                    rw_src_pid = pid;
                                    dst_projs_r = pl.projs;
                                    dst_pl_ty = pl.ty;
                                }
                            }
                        }
                    }
                    if rw_src_pid != eir.EIR_NONE {
                        var src_base = eir.place_base_slot(0_u32);
                        var src_projs_r = ast.range_empty();
                        if let spl = eir_prog.get_place(rw_src_pid) {
                            src_base = spl.base;
                            src_projs_r = spl.projs;
                        }
                        new_projs.clear();
                        var pi: u32 = 0_u32;
                        while pi < src_projs_r.len {
                            if let pr = eir_prog.exprs.projs.get((src_projs_r.start +% pi).widen.[usize]()) {
                                try new_projs.push(alloc, pr.*);
                            }
                            pi = pi +% 1_u32;
                        }
                        pi = 0_u32;
                        while pi < dst_projs_r.len {
                            if let pr = eir_prog.exprs.projs.get((dst_projs_r.start +% pi).widen.[usize]()) {
                                try new_projs.push(alloc, pr.*);
                            }
                            pi = pi +% 1_u32;
                        }
                        let pr_rng = try eir_prog.add_projs(alloc, new_projs.as_slice());
                        inst.aux0 = try eir_prog.push_place(alloc, eir.EirPlace.{
                            base: src_base,
                            projs: pr_rng,
                            ty: dst_pl_ty,
                        });
                        changed = true;
                    }
                }
                if !drop {
                    try new_insts.push(alloc, inst);
                    try new_flags.push(alloc, fl);
                }
                ii = ii +% 1_u32;
            }
            if changed {
                try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
            }
            r2 = r2 +% 1_u32;
        }
        new_flags.destroy(alloc);
        new_insts.destroy(alloc);
        new_projs.destroy(alloc);
    }

    slot_src_place.destroy(alloc);
    val_ld_pos.destroy(alloc);
    val_ld_bb.destroy(alloc);
    val_ld_place.destroy(alloc);
    store_val.destroy(alloc);
    store_pos.destroy(alloc);
    store_bb.destroy(alloc);
    store_cnt.destroy(alloc);
    has_read.destroy(alloc);
    cand.destroy(alloc);
    return;
}

fn pass_sroa(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    stats: *mut OptStats,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) {
            try eliminate_readonly_struct_slot_copy_fn(alloc, eir_prog, fi, env);
            var iter: usize = 0_usize;
            while iter < 2_usize {
                let c = try sroa_fn_once(alloc, eir_prog, fi, env);
                stats.sroa_slots = stats.sroa_slots +% c;
                if c == 0_u64 {
                    break;
                }
                iter = iter +% 1_usize;
            }
        }
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Section 6: Pass 4 — SCCP + Constant Folding + Algebraic + DBM Proof Opt (#2)
// ===========================================================================

const KNOW_NONE: u8 = 0_u8;
const KNOW_BOOL: u8 = 1_u8;
const KNOW_INT: u8 = 2_u8;
const KNOW_NULL: u8 = 3_u8;
const KNOW_WRAP_OPT: u8 = 4_u8;
const KNOW_WRAP_OK: u8 = 5_u8;
const KNOW_WRAP_ERR: u8 = 6_u8;
const KNOW_AGG: u8 = 7_u8;
const KNOW_STR: u8 = 8_u8;
const KNOW_NOT_ERR: u8 = 9_u8;

struct ValKnow {
    kind: u8;
    bval: bool;
    u64_val: u64;
    aux_u32: u32;
    ty: types.TyId;
}

fn val_know_none() -> ValKnow {
    return ValKnow.{
        kind: KNOW_NONE,
        bval: false,
        u64_val: 0_u64,
        aux_u32: eir.EIR_NONE,
        ty: types.TY_VOID,
    };
}

fn make_bool_const_inst(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    sp: span.Span,
    dst: eir.EirValue,
    b: bool,
) -> eir.EirInst ! OutOfMemory {
    let cid = try eir_prog.push_const(alloc, cfg_ir.const_bool(b));
    var inst = eir.inst_zero(sp, .Const);
    inst.dst = dst;
    inst.ty0 = types.TY_BOOL;
    inst.aux0 = cid;
    return inst;
}

fn make_int_const_inst(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    sp: span.Span,
    dst: eir.EirValue,
    raw_u64: u64,
    ty: types.TyId,
) -> eir.EirInst ! OutOfMemory {
    let bits = env.int_bits(ty);
    let signed = env.is_signed_int(ty);
    let iv = u64_to_int_val(raw_u64, bits, signed);
    let cid = try eir_prog.push_const(alloc, cfg_ir.const_int(iv, ty));
    var inst = eir.inst_zero(sp, .Const);
    inst.dst = dst;
    inst.ty0 = ty;
    inst.aux0 = cid;
    return inst;
}

struct FoldBinRes {
    folded: bool;
    is_bool: bool;
    bval: bool;
    u64_val: u64;
}

fn fold_bin_none() -> FoldBinRes {
    return FoldBinRes.{ folded: false, is_bool: false, bval: false, u64_val: 0_u64 };
}

fn eval_const_int_binary(
    env: *types.TypeEnv,
    op: ast.BinaryOp,
    lraw: u64,
    rraw: u64,
    op_ty: types.TyId,
) -> FoldBinRes {
    if !env.is_concrete_integer(op_ty) {
        return fold_bin_none();
    }
    let bits = env.int_bits(op_ty);
    if bits == 0_u8 || bits > 64_u8 {
        return fold_bin_none();
    }
    let signed = env.is_signed_int(op_ty);
    let mask = mask_bits_u64(bits);
    let lu = lraw & mask;
    let ru = rraw & mask;
    let a = u64_to_int_val(lu, bits, signed);
    let b = u64_to_int_val(ru, bits, signed);
    let tb = types.int_bounds(env.get(op_ty));

    match op {
        .Eq => { return FoldBinRes.{ folded: true, is_bool: true, bval: types.int_val_eq(a, b), u64_val: 0_u64 }; }
        .NotEq => { return FoldBinRes.{ folded: true, is_bool: true, bval: !types.int_val_eq(a, b), u64_val: 0_u64 }; }
        .Lt => { return FoldBinRes.{ folded: true, is_bool: true, bval: types.int_val_cmp(a, b) < 0_i32, u64_val: 0_u64 }; }
        .LtEq => { return FoldBinRes.{ folded: true, is_bool: true, bval: types.int_val_cmp(a, b) <= 0_i32, u64_val: 0_u64 }; }
        .Gt => { return FoldBinRes.{ folded: true, is_bool: true, bval: types.int_val_cmp(a, b) > 0_i32, u64_val: 0_u64 }; }
        .GtEq => { return FoldBinRes.{ folded: true, is_bool: true, bval: types.int_val_cmp(a, b) >= 0_i32, u64_val: 0_u64 }; }
        .BitAnd => { return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: (lu & ru) & mask }; }
        .BitOr => { return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: (lu | ru) & mask }; }
        .BitXor => { return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: (lu ^ ru) & mask }; }
        .AddWrap => { return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: (lu +% ru) & mask }; }
        .SubWrap => { return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: (lu -% ru) & mask }; }
        .MulWrap => { return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: (lu *% ru) & mask }; }
        .Add => {
            if let r = types.int_val_checked_add(a, b) {
                if tb.valid && types.int_val_cmp(r, tb.min) >= 0_i32 && types.int_val_cmp(r, tb.max) <= 0_i32 {
                    return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: r.lo & mask };
                }
            }
            return fold_bin_none();
        }
        .Sub => {
            if let r = types.int_val_checked_sub(a, b) {
                if tb.valid && types.int_val_cmp(r, tb.min) >= 0_i32 && types.int_val_cmp(r, tb.max) <= 0_i32 {
                    return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: r.lo & mask };
                }
            }
            return fold_bin_none();
        }
        .Mul => {
            if let r = types.int_val_checked_mul(a, b) {
                if tb.valid && types.int_val_cmp(r, tb.min) >= 0_i32 && types.int_val_cmp(r, tb.max) <= 0_i32 {
                    return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: r.lo & mask };
                }
            }
            return fold_bin_none();
        }
        .AddSat => {
            if tb.valid {
                if let r = types.int_val_checked_add(a, b) {
                    if types.int_val_cmp(r, tb.min) < 0_i32 {
                        return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: tb.min.lo & mask };
                    }
                    if types.int_val_cmp(r, tb.max) > 0_i32 {
                        return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: tb.max.lo & mask };
                    }
                    return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: r.lo & mask };
                }
            }
            return fold_bin_none();
        }
        .SubSat => {
            if tb.valid {
                if let r = types.int_val_checked_sub(a, b) {
                    if types.int_val_cmp(r, tb.min) < 0_i32 {
                        return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: tb.min.lo & mask };
                    }
                    if types.int_val_cmp(r, tb.max) > 0_i32 {
                        return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: tb.max.lo & mask };
                    }
                    return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: r.lo & mask };
                }
            }
            return fold_bin_none();
        }
        .MulSat => {
            if tb.valid {
                if let r = types.int_val_checked_mul(a, b) {
                    if types.int_val_cmp(r, tb.min) < 0_i32 {
                        return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: tb.min.lo & mask };
                    }
                    if types.int_val_cmp(r, tb.max) > 0_i32 {
                        return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: tb.max.lo & mask };
                    }
                    return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: r.lo & mask };
                }
            }
            return fold_bin_none();
        }
        .Div => {
            if !types.int_val_is_zero(b) {
                if let r = types.int_val_checked_div(a, b) {
                    if tb.valid && types.int_val_cmp(r, tb.min) >= 0_i32 && types.int_val_cmp(r, tb.max) <= 0_i32 {
                        return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: r.lo & mask };
                    }
                }
            }
            return fold_bin_none();
        }
        .Mod => {
            if !types.int_val_is_zero(b) {
                if let r = types.int_val_checked_rem(a, b) {
                    if tb.valid && types.int_val_cmp(r, tb.min) >= 0_i32 && types.int_val_cmp(r, tb.max) <= 0_i32 {
                        return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: r.lo & mask };
                    }
                }
            }
            return fold_bin_none();
        }
        .Shl => {
            if ru < bits.widen.[u64]() {
                return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: (lu <<% (ru & 63_u64)) & mask };
            }
            return fold_bin_none();
        }
        .ShlWrap => {
            let bmask = (bits -% 1_u8).widen.[u64]();
            let sh = (ru & bmask) & 63_u64;
            return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: (lu <<% sh) & mask };
        }
        .Shr => {
            if ru < bits.widen.[u64]() {
                if signed {
                    let sr = types.int_val_shr(a, ru.trunc.[u32]());
                    return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: sr.lo & mask };
                }
                return FoldBinRes.{ folded: true, is_bool: false, bval: false, u64_val: (lu >> (ru & 63_u64)) & mask };
            }
            return fold_bin_none();
        }
        _ => { return fold_bin_none(); }
    }
}

/// Helper: verifies `lbb` dominates `idom` with no unsafe call/asm on the chain or in `idom`'s loop.
fn verify_pool_guard_safe(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    nblks: usize,
    lbb: eir.BlockId,
    idom: eir.BlockId,
    unsafe_dom_blks: *col.BitSet,
) -> bool ! OutOfMemory {
    if lbb == eir.EIR_NONE || !eir_prog.dominates_block(fn_id, lbb, idom) {
        return false;
    }
    var path_ok = !unsafe_dom_blks.test(idom.widen.[usize]());
    var walk = idom;
    var wh: usize = 0_usize;
    while path_ok && walk != lbb && wh < 24_usize {
        if let wb = eir_prog.fn_block(fn_id, walk) {
            if wb.idom == eir.EIR_NONE || wb.idom == walk {
                path_ok = false;
                break;
            }
            walk = wb.idom;
            if walk != lbb && unsafe_dom_blks.test(walk.widen.[usize]()) {
                path_ok = false;
                break;
            }
        } else {
            path_ok = false;
            break;
        }
        wh = wh +% 1_usize;
    }
    if !path_ok || walk != lbb {
        return false;
    }
    var lbody = try col.BitSet.init(alloc, max_usize(nblks, 1_usize));
    errdefer lbody.destroy(alloc);
    try collect_loop_body_bs(alloc, eir_prog, fn_id, idom, nblks, &mut lbody);
    var loop_safe = true;
    var bi: usize = 0_usize;
    while bi < nblks {
        if lbody.test(bi) && unsafe_dom_blks.test(bi) {
            loop_safe = false;
            break;
        }
        bi = bi +% 1_usize;
    }
    lbody.destroy(alloc);
    return loop_safe;
}

/// Checks if `ArenaPoolIdAt(pool_v, idx_v)` in block `bb` is dominated by:
/// 1) Forward guard: `Branch(Lt(idx_v, bound_v), true_bb, _)` where `bound_v <= ArenaPoolLen(pool)`, OR
/// 2) Reverse countdown guard: `idx_v = Sub(phi_v, 1)` where `phi_v = Phi(len_v, idx_v)` at `idom`
///    and `idom` branches on `Gt(phi_v, 0)` or `NotEq(phi_v, 0)` to `true_bb` dominating `bb`!
fn is_pool_id_at_loop_guarded(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    bb: eir.BlockId,
    nblks: usize,
    pool_id: PoolId,
    idx_v: eir.EirValue,
    canon_val: *[eir.EirValue],
    slot_addr_of: *[eir.EirSlot],
    pool_len_of: *[eir.EirValue],
    pool_len_bb: *[eir.BlockId],
    lt_lhs: *[eir.EirValue],
    lt_rhs: *[eir.EirValue],
    gt0_val: *[eir.EirValue],
    sub1_src: *[eir.EirValue],
    fn_has_pool_reset: bool,
    unsafe_dom_blks: *col.BitSet,
) -> bool ! OutOfMemory {
    if fn_has_pool_reset || !pool_id.valid || idx_v == eir.EIR_NONE {
        return false;
    }
    let idx_root = resolve_val_chain(idx_v, canon_val);
    let idx_sub1_phi = if idx_root.widen.[usize]() < sub1_src.len {
        resolve_val_chain(sub1_src[idx_root.widen.[usize]()], canon_val)
    } else {
        eir.EIR_NONE
    };
    var cur = bb;
    var hops: usize = 0_usize;
    while hops < 16_usize {
        var idom = eir.EIR_NONE;
        if let bp = eir_prog.fn_block(fn_id, cur) {
            idom = bp.idom;
        }
        if idom == eir.EIR_NONE || idom == cur {
            break;
        }
        if unsafe_dom_blks.test(cur.widen.[usize]()) {
            return false;
        }
        if let db = eir_prog.fn_block(fn_id, idom) {
            if db.term.kind == .Branch && db.term.bb0 != db.term.bb1 {
                if eir_prog.dominates_block(fn_id, db.term.bb0, bb) {
                    let cu = db.term.val.widen.[usize]();
                    // Pattern 1: forward `idx_v < bound_v` where `bound_v <= pool.len()`
                    if cu < lt_lhs.len && cu < lt_rhs.len {
                        let lhs = resolve_val_chain(lt_lhs[cu], canon_val);
                        let rhs = resolve_val_chain(lt_rhs[cu], canon_val);
                        if lhs == idx_root && rhs != eir.EIR_NONE {
                            let ru = rhs.widen.[usize]();
                            if ru < pool_len_of.len && ru < pool_len_bb.len {
                                let lp = pool_len_of[ru];
                                let lbb = pool_len_bb[ru];
                                let lpid = canonical_pool_from_val(lp, canon_val, slot_addr_of);
                                if pool_id_eq(lpid, pool_id) {
                                    let safe_g = try verify_pool_guard_safe(alloc, eir_prog, fn_id, nblks, lbb, idom, unsafe_dom_blks);
                                    if safe_g {
                                        return true;
                                    }
                                }
                            }
                        }
                    }
                    // Pattern 2: reverse countdown `phi = Phi(len_v, phi - 1); while phi > 0 { idx = phi - 1; id_at(idx) }`
                    if idx_sub1_phi != eir.EIR_NONE && cu < gt0_val.len {
                        let gv = resolve_val_chain(gt0_val[cu], canon_val);
                        if gv == idx_sub1_phi {
                            let phis = eir_prog.phis_slice(db.phis);
                            var pi: usize = 0_usize;
                            while pi < phis.len {
                                if phis[pi].dst == idx_sub1_phi {
                                    let incs = eir_prog.phi_incoming(phis[pi].incoming);
                                    if incs.len == 2_usize {
                                        let v0 = resolve_val_chain(incs[0_usize].val, canon_val);
                                        let v1 = resolve_val_chain(incs[1_usize].val, canon_val);
                                        var init_v = eir.EIR_NONE;
                                        if v0 == idx_root {
                                            init_v = v1;
                                        } else if v1 == idx_root {
                                            init_v = v0;
                                        }
                                        if init_v != eir.EIR_NONE {
                                            let iu = init_v.widen.[usize]();
                                            if iu < pool_len_of.len && iu < pool_len_bb.len {
                                                let lp = pool_len_of[iu];
                                                let lbb = pool_len_bb[iu];
                                                let lpid = canonical_pool_from_val(lp, canon_val, slot_addr_of);
                                                if pool_id_eq(lpid, pool_id) {
                                                    let safe_g2 = try verify_pool_guard_safe(alloc, eir_prog, fn_id, nblks, lbb, idom, unsafe_dom_blks);
                                                    if safe_g2 {
                                                        return true;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    break;
                                }
                                pi = pi +% 1_usize;
                            }
                        }
                    }
                }
            }
        }
        cur = idom;
        hops = hops +% 1_usize;
    }
    return false;
}

fn sccp_fold_dbm_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    stats: *mut OptStats,
) -> !OutOfMemory {
    var nvals: usize = 0_usize;
    var nblks: usize = 0_usize;
    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) {
            return;
        }
        nvals = f.value_tys.len.widen.[usize]();
        nblks = f.blocks.len.widen.[usize]();
        rpo_r = f.rpo;
    } else {
        return;
    }
    if nvals == 0_usize || rpo_r.len == 0_u32 {
        return;
    }

    _ = try eliminate_copies_fn(alloc, eir_prog, fn_id);

    // Pre-scan canonical pool pointers (`Copy`/`MutToConst`/`SlotAddr`), `ArenaPoolLen`, `Binary(Lt)`, and `ArenaPoolReset`/`Call`.
    var canon_val = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer canon_val.destroy(alloc);
    try fill_u32(alloc, &mut canon_val, nvals, eir.EIR_NONE);
    var slot_addr_of = try col.DynBuf.[eir.EirSlot].init(alloc, nvals);
    errdefer slot_addr_of.destroy(alloc);
    try fill_u32(alloc, &mut slot_addr_of, nvals, eir.EIR_NONE);
    var pool_len_of = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer pool_len_of.destroy(alloc);
    try fill_u32(alloc, &mut pool_len_of, nvals, eir.EIR_NONE);
    var pool_len_bb = try col.DynBuf.[eir.BlockId].init(alloc, nvals);
    errdefer pool_len_bb.destroy(alloc);
    try fill_u32(alloc, &mut pool_len_bb, nvals, eir.EIR_NONE);
    var lt_lhs = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer lt_lhs.destroy(alloc);
    try fill_u32(alloc, &mut lt_lhs, nvals, eir.EIR_NONE);
    var lt_rhs = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer lt_rhs.destroy(alloc);
    try fill_u32(alloc, &mut lt_rhs, nvals, eir.EIR_NONE);
    var gt0_val = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer gt0_val.destroy(alloc);
    try fill_u32(alloc, &mut gt0_val, nvals, eir.EIR_NONE);
    var sub1_src = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer sub1_src.destroy(alloc);
    try fill_u32(alloc, &mut sub1_src, nvals, eir.EIR_NONE);
    var is_zero_const = try col.BitSet.init(alloc, max_usize(nvals, 1_usize));
    errdefer is_zero_const.destroy(alloc);
    var is_one_const = try col.BitSet.init(alloc, max_usize(nvals, 1_usize));
    errdefer is_one_const.destroy(alloc);
    var unary_src = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer unary_src.destroy(alloc);
    try fill_u32(alloc, &mut unary_src, nvals, eir.EIR_NONE);
    var unary_kind = try col.DynBuf.[u8].init(alloc, nvals);
    errdefer unary_kind.destroy(alloc);
    try fill_u8(alloc, &mut unary_kind, nvals, 0_u8);
    var unsafe_dom_blks = try col.BitSet.init(alloc, max_usize(nblks, 1_usize));
    errdefer unsafe_dom_blks.destroy(alloc);
    var fn_has_pool_reset = false;

    var rpre: u32 = 0_u32;
    while rpre < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% rpre).widen.[usize]()) {
            bb = bp.*;
        }
        // Propagate `limit <= pool.len()` across `if x < limit { limit = x }` min-clamp Phis!
        if let blk = eir_prog.fn_block(fn_id, bb) {
            let phis = eir_prog.phis_slice(blk.phis);
            var pi: usize = 0_usize;
            while pi < phis.len {
                let ph_dst = phis[pi].dst;
                let incs = eir_prog.phi_incoming(phis[pi].incoming);
                if incs.len == 2_usize && ph_dst != eir.EIR_NONE {
                    let v0 = resolve_val_chain(incs[0_usize].val, canon_val.as_slice());
                    let v1 = resolve_val_chain(incs[1_usize].val, canon_val.as_slice());
                    let p0 = incs[0_usize].pred_bb;
                    let p1 = incs[1_usize].pred_bb;
                    var matched_len_v = eir.EIR_NONE;
                    var cand_lt_v = eir.EIR_NONE;
                    var cand_pred = eir.EIR_NONE;
                    if v0 != eir.EIR_NONE && u32_at(&pool_len_of, v0.widen.[usize]()) != eir.EIR_NONE {
                        matched_len_v = v0;
                        cand_lt_v = v1;
                        cand_pred = p1;
                    } else if v1 != eir.EIR_NONE && u32_at(&pool_len_of, v1.widen.[usize]()) != eir.EIR_NONE {
                        matched_len_v = v1;
                        cand_lt_v = v0;
                        cand_pred = p0;
                    }
                    if matched_len_v != eir.EIR_NONE && cand_pred != eir.EIR_NONE {
                        var dom_br = eir.EIR_NONE;
                        if let pb = eir_prog.fn_block(fn_id, cand_pred) {
                            dom_br = if pb.term.kind == .Branch { cand_pred } else { pb.idom };
                        }
                        if dom_br != eir.EIR_NONE {
                            if let db = eir_prog.fn_block(fn_id, dom_br) {
                                if db.term.kind == .Branch {
                                    let cu = db.term.val.widen.[usize]();
                                    let lhs_v = resolve_val_chain(u32_at(&lt_lhs, cu), canon_val.as_slice());
                                    let rhs_v = resolve_val_chain(u32_at(&lt_rhs, cu), canon_val.as_slice());
                                    let ok_true = ((cand_pred == dom_br && db.term.bb0 == bb)
                                        || (cand_pred != dom_br && eir_prog.dominates_block(fn_id, db.term.bb0, cand_pred)))
                                        && lhs_v == cand_lt_v && rhs_v == matched_len_v;
                                    let ok_false = ((cand_pred == dom_br && db.term.bb1 == bb)
                                        || (cand_pred != dom_br && eir_prog.dominates_block(fn_id, db.term.bb1, cand_pred)))
                                        && lhs_v == matched_len_v && rhs_v == cand_lt_v;
                                    if ok_true || ok_false {
                                        let du = ph_dst.widen.[usize]();
                                        let m_of = u32_at(&pool_len_of, matched_len_v.widen.[usize]());
                                        let m_bb = u32_at(&pool_len_bb, matched_len_v.widen.[usize]());
                                        u32_set(&mut pool_len_of, du, m_of);
                                        u32_set(&mut pool_len_bb, du, m_bb);
                                    }
                                }
                            }
                        }
                    }
                }
                pi = pi +% 1_usize;
            }
        }
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .Const && inst.dst != eir.EIR_NONE {
                if let kc = eir_prog.get_const(inst.aux0) {
                    if kc.kind == .Int && kc.int_val.hi == 0_i64 {
                        if kc.int_val.lo == 0_u64 {
                            is_zero_const.set(inst.dst.widen.[usize]());
                        } else if kc.int_val.lo == 1_u64 {
                            is_one_const.set(inst.dst.widen.[usize]());
                        }
                    }
                }
            } else if inst.kind == .Copy || (inst.kind == .Cast && inst.cast_kind == .MutToConst) {
                if inst.dst != eir.EIR_NONE && inst.v0 != eir.EIR_NONE {
                    u32_set(&mut canon_val, inst.dst.widen.[usize](), inst.v0);
                }
            } else if inst.kind == .SlotAddr && inst.dst != eir.EIR_NONE {
                u32_set(&mut slot_addr_of, inst.dst.widen.[usize](), inst.aux0);
            } else if inst.kind == .Call || inst.kind == .InlineAsm {
                unsafe_dom_blks.set(bb.widen.[usize]());
            } else if inst.kind == .BuiltinCall {
                if let bc = eir_prog.get_builtin_call(inst.aux0) {
                    if bc.op.kind == .ArenaPoolReset {
                        fn_has_pool_reset = true;
                        unsafe_dom_blks.set(bb.widen.[usize]());
                    } else if bc.op.kind == .ArenaPoolLen && inst.dst != eir.EIR_NONE && bc.args.len >= 1_u32 {
                        let bargs = eir_prog.vals_slice(bc.args);
                        if bargs.len >= 1_usize {
                            u32_set(&mut pool_len_of, inst.dst.widen.[usize](), bargs[0_usize]);
                            u32_set(&mut pool_len_bb, inst.dst.widen.[usize](), bb);
                        }
                    }
                }
            } else if inst.kind == .Binary && inst.dst != eir.EIR_NONE && env.is_concrete_integer(inst.ty1) && !env.is_signed_int(inst.ty1) {
                if inst.bin_op == .Lt {
                    u32_set(&mut lt_lhs, inst.dst.widen.[usize](), inst.v0);
                    u32_set(&mut lt_rhs, inst.dst.widen.[usize](), inst.v1);
                } else if inst.bin_op == .Gt {
                    u32_set(&mut lt_lhs, inst.dst.widen.[usize](), inst.v1);
                    u32_set(&mut lt_rhs, inst.dst.widen.[usize](), inst.v0);
                    if inst.v1 != eir.EIR_NONE && is_zero_const.test(inst.v1.widen.[usize]()) {
                        u32_set(&mut gt0_val, inst.dst.widen.[usize](), inst.v0);
                    }
                } else if inst.bin_op == .NotEq
                    && inst.v1 != eir.EIR_NONE && is_zero_const.test(inst.v1.widen.[usize]())
                {
                    u32_set(&mut gt0_val, inst.dst.widen.[usize](), inst.v0);
                } else if (inst.bin_op == .Sub || inst.bin_op == .SubWrap)
                    && inst.v1 != eir.EIR_NONE && is_one_const.test(inst.v1.widen.[usize]())
                {
                    u32_set(&mut sub1_src, inst.dst.widen.[usize](), inst.v0);
                }
            }
            ii = ii +% 1_usize;
        }
        rpre = rpre +% 1_u32;
    }

    var know = try col.DynBuf.[ValKnow].init(alloc, nvals);
    errdefer know.destroy(alloc);
    var ki0: usize = 0_usize;
    while ki0 < nvals {
        try know.push(alloc, val_know_none());
        ki0 = ki0 +% 1_usize;
    }

    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);

    var cfg_changed = false;
    var r0: u32 = 0_u32;
    while r0 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r0).widen.[usize]()) {
            bb = bp.*;
        }
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            insts_r = blk.insts;
        }
        new_insts.clear();
        new_flags.clear();
        var bchanged = false;

        var ii: u32 = 0_u32;
        while ii < insts_r.len {
            let gid = insts_r.start +% ii;
            var inst = eir.inst_zero(span.span_dummy(), .ParForHint);
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                inst = ip.*;
            }
            var fl = eir_prog.inst_proven_flags(gid);
            var emitted = false;

            match inst.kind {
                .Const => {
                    if inst.dst != eir.EIR_NONE && inst.dst.widen.[usize]() < know.len() {
                        if let kc = eir_prog.get_const(inst.aux0) {
                            var vk = val_know_none();
                            match kc.kind {
                                .Bool => {
                                    vk.kind = KNOW_BOOL;
                                    vk.bval = kc.bool_val;
                                    vk.ty = types.TY_BOOL;
                                }
                                .Char => {
                                    vk.kind = KNOW_INT;
                                    vk.u64_val = kc.aux_u32.widen.[u64]();
                                    vk.ty = types.TY_CHAR;
                                }
                                .Int => {
                                    let bits = env.int_bits(inst.ty0);
                                    if let rv = int_val_to_raw_u64(kc.int_val, bits) {
                                        vk.kind = KNOW_INT;
                                        vk.u64_val = rv;
                                        vk.ty = inst.ty0;
                                    }
                                }
                                .EnumTag => {
                                    if let rv = int_val_to_raw_u64(kc.int_val, 64_u8) {
                                        vk.kind = KNOW_INT;
                                        vk.u64_val = rv;
                                        vk.ty = inst.ty0;
                                    }
                                }
                                .Null => {
                                    vk.kind = KNOW_NULL;
                                    vk.ty = inst.ty0;
                                }
                                .Str => {
                                    vk.kind = KNOW_STR;
                                    vk.u64_val = kc.bytes.len.widen.[u64]();
                                    vk.ty = types.TY_STR;
                                }
                                _ => {}
                            }
                            if vk.kind != KNOW_NONE {
                                if let km = know.get_mut(inst.dst.widen.[usize]()) {
                                    km.* = vk;
                                }
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .Copy => {
                    if inst.dst != eir.EIR_NONE && inst.v0.widen.[usize]() < know.len() && inst.dst.widen.[usize]() < know.len() {
                        var src_k = val_know_none();
                        if let kp = know.get(inst.v0.widen.[usize]()) {
                            src_k = kp.*;
                        }
                        if src_k.kind != KNOW_NONE {
                            if let km = know.get_mut(inst.dst.widen.[usize]()) {
                                km.* = src_k;
                            }
                        }
                    }
                }
                .Aggregate => {
                    if inst.dst != eir.EIR_NONE && inst.dst.widen.[usize]() < know.len() {
                        if let km = know.get_mut(inst.dst.widen.[usize]()) {
                            km.* = ValKnow.{
                                kind: KNOW_AGG,
                                bval: false,
                                u64_val: 0_u64,
                                aux_u32: gid,
                                ty: inst.ty0,
                            };
                        }
                    }
                }
                .Unary => {
                    let du = inst.dst.widen.[usize]();
                    let su = inst.v0.widen.[usize]();
                    var sk = val_know_none();
                    if su < know.len() {
                        if let kp = know.get(su) {
                            sk = kp.*;
                        }
                    }
                    if inst.unary_op == .Not {
                        if sk.kind == KNOW_BOOL {
                            let ci = try make_bool_const_inst(alloc, eir_prog, inst.span, inst.dst, !sk.bval);
                            try new_insts.push(alloc, ci);
                            try new_flags.push(alloc, 0_u8);
                            if du < know.len() {
                                if let km = know.get_mut(du) {
                                    km.* = ValKnow.{ kind: KNOW_BOOL, bval: !sk.bval, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: types.TY_BOOL };
                                }
                            }
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        } else if su < unary_kind.len() && u8_at(&unary_kind, su) == 1_u8 {
                            // Not(Not(x)) -> Copy(x)
                            var cpy = eir.inst_zero(inst.span, .Copy);
                            cpy.dst = inst.dst;
                            cpy.v0 = u32_at(&unary_src, su);
                            try new_insts.push(alloc, cpy);
                            try new_flags.push(alloc, 0_u8);
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        } else if du < unary_kind.len() {
                            u8_set(&mut unary_kind, du, 1_u8);
                            u32_set(&mut unary_src, du, inst.v0);
                        }
                        _ = 0_u8;
                    } else if inst.unary_op == .BitNot && env.is_concrete_integer(inst.ty0) && env.int_bits(inst.ty0) <= 64_u8 {
                        if sk.kind == KNOW_INT {
                            let res = (~sk.u64_val) & mask_bits_u64(env.int_bits(inst.ty0));
                            let ci = try make_int_const_inst(alloc, eir_prog, env, inst.span, inst.dst, res, inst.ty0);
                            try new_insts.push(alloc, ci);
                            try new_flags.push(alloc, 0_u8);
                            if du < know.len() {
                                if let km = know.get_mut(du) {
                                    km.* = ValKnow.{ kind: KNOW_INT, bval: false, u64_val: res, aux_u32: eir.EIR_NONE, ty: inst.ty0 };
                                }
                            }
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        } else if su < unary_kind.len() && u8_at(&unary_kind, su) == 2_u8 {
                            var cpy = eir.inst_zero(inst.span, .Copy);
                            cpy.dst = inst.dst;
                            cpy.v0 = u32_at(&unary_src, su);
                            try new_insts.push(alloc, cpy);
                            try new_flags.push(alloc, 0_u8);
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        } else if du < unary_kind.len() {
                            u8_set(&mut unary_kind, du, 2_u8);
                            u32_set(&mut unary_src, du, inst.v0);
                        }
                        _ = 0_u8;
                    } else if inst.unary_op == .Neg && env.is_concrete_integer(inst.ty0) && env.int_bits(inst.ty0) <= 64_u8 && sk.kind == KNOW_INT {
                        let bits = env.int_bits(inst.ty0);
                        let signed = env.is_signed_int(inst.ty0);
                        let iv = u64_to_int_val(sk.u64_val, bits, signed);
                        let tb = types.int_bounds(env.get(inst.ty0));
                        if let nr = types.int_val_checked_neg(iv) {
                            if tb.valid && types.int_val_cmp(nr, tb.min) >= 0_i32 && types.int_val_cmp(nr, tb.max) <= 0_i32 {
                                let res = nr.lo & mask_bits_u64(bits);
                                let ci = try make_int_const_inst(alloc, eir_prog, env, inst.span, inst.dst, res, inst.ty0);
                                try new_insts.push(alloc, ci);
                                try new_flags.push(alloc, 0_u8);
                                if du < know.len() {
                                    if let km = know.get_mut(du) {
                                        km.* = ValKnow.{ kind: KNOW_INT, bval: false, u64_val: res, aux_u32: eir.EIR_NONE, ty: inst.ty0 };
                                    }
                                }
                                emitted = true;
                                bchanged = true;
                                stats.folded_consts = stats.folded_consts +% 1_u64;
                            }
                        }
                    }
                    _ = emitted;
                }
                .Binary => {
                    let du = inst.dst.widen.[usize]();
                    let lu = inst.v0.widen.[usize]();
                    let ru = inst.v1.widen.[usize]();
                    var lk = val_know_none();
                    var rk = val_know_none();
                    if lu < know.len() {
                        if let kp = know.get(lu) { lk = kp.*; }
                    }
                    if ru < know.len() {
                        if let kp = know.get(ru) { rk = kp.*; }
                    }

                    // 1. DBM Super-Opt #2: Checked arithmetic proven overflow-free -> Wrap/Div + WrapOk!
                    let is_chk_addsubmul = inst.bin_op == .AddCheck || inst.bin_op == .SubCheck || inst.bin_op == .MulCheck;
                    let is_chk_divmod = inst.bin_op == .DivCheck || inst.bin_op == .ModCheck;
                    if is_chk_addsubmul && (fl & eir.PROVEN_NO_OVERFLOW) != 0_u8 && env.is_concrete_integer(inst.ty1) {
                        let raw_v = try eir_prog.alloc_fn_value(alloc, fn_id, inst.ty1);
                        var raw_b = eir.inst_zero(inst.span, .Binary);
                        raw_b.dst = raw_v;
                        raw_b.bin_op = if inst.bin_op == .AddCheck {
                            .AddWrap
                        } else if inst.bin_op == .SubCheck {
                            .SubWrap
                        } else {
                            .MulWrap
                        };
                        raw_b.v0 = inst.v0;
                        raw_b.v1 = inst.v1;
                        raw_b.ty0 = inst.ty1;
                        raw_b.ty1 = inst.ty1;
                        try new_insts.push(alloc, raw_b);
                        try new_flags.push(alloc, fl);

                        var wok = eir.inst_zero(inst.span, .Cast);
                        wok.dst = inst.dst;
                        wok.cast_kind = .WrapOk;
                        wok.v0 = raw_v;
                        wok.ty0 = inst.ty0;
                        wok.ty1 = inst.ty1;
                        try new_insts.push(alloc, wok);
                        try new_flags.push(alloc, 0_u8);
                        if du < know.len() {
                            if let km = know.get_mut(du) {
                                km.* = ValKnow.{ kind: KNOW_WRAP_OK, bval: false, u64_val: 0_u64, aux_u32: raw_v, ty: inst.ty0 };
                            }
                        }
                        emitted = true;
                        bchanged = true;
                        stats.dbm_checks_eliminated = stats.dbm_checks_eliminated +% 1_u64;
                    } else if is_chk_divmod
                        && (fl & eir.PROVEN_NO_OVERFLOW) != 0_u8
                        && (fl & eir.PROVEN_NONZERO_DIV) != 0_u8
                        && env.is_concrete_integer(inst.ty1)
                    {
                        let raw_v = try eir_prog.alloc_fn_value(alloc, fn_id, inst.ty1);
                        var raw_b = eir.inst_zero(inst.span, .Binary);
                        raw_b.dst = raw_v;
                        raw_b.bin_op = if inst.bin_op == .DivCheck { .Div } else { .Mod };
                        raw_b.v0 = inst.v0;
                        raw_b.v1 = inst.v1;
                        raw_b.ty0 = inst.ty1;
                        raw_b.ty1 = inst.ty1;
                        try new_insts.push(alloc, raw_b);
                        try new_flags.push(alloc, fl);

                        var wok = eir.inst_zero(inst.span, .Cast);
                        wok.dst = inst.dst;
                        wok.cast_kind = .WrapOk;
                        wok.v0 = raw_v;
                        wok.ty0 = inst.ty0;
                        wok.ty1 = inst.ty1;
                        try new_insts.push(alloc, wok);
                        try new_flags.push(alloc, 0_u8);
                        if du < know.len() {
                            if let km = know.get_mut(du) {
                                km.* = ValKnow.{ kind: KNOW_WRAP_OK, bval: false, u64_val: 0_u64, aux_u32: raw_v, ty: inst.ty0 };
                            }
                        }
                        emitted = true;
                        bchanged = true;
                        stats.dbm_checks_eliminated = stats.dbm_checks_eliminated +% 1_u64;
                    } else if (inst.bin_op == .AddSat || inst.bin_op == .SubSat || inst.bin_op == .MulSat)
                        && (fl & eir.PROVEN_NO_OVERFLOW) != 0_u8
                        && env.is_concrete_integer(inst.ty1)
                    {
                        inst.bin_op = if inst.bin_op == .AddSat {
                            .AddWrap
                        } else if inst.bin_op == .SubSat {
                            .SubWrap
                        } else {
                            .MulWrap
                        };
                        bchanged = true;
                        stats.dbm_checks_eliminated = stats.dbm_checks_eliminated +% 1_u64;
                    }

                    // 2. Bool constant folding.
                    if !emitted && inst.ty1 == types.TY_BOOL && lk.kind == KNOW_BOOL && rk.kind == KNOW_BOOL {
                        var bres = false;
                        var ok_b = true;
                        match inst.bin_op {
                            .And => { bres = lk.bval && rk.bval; }
                            .Or => { bres = lk.bval || rk.bval; }
                            .Eq => { bres = lk.bval == rk.bval; }
                            .NotEq => { bres = lk.bval != rk.bval; }
                            _ => { ok_b = false; }
                        }
                        if ok_b {
                            let ci = try make_bool_const_inst(alloc, eir_prog, inst.span, inst.dst, bres);
                            try new_insts.push(alloc, ci);
                            try new_flags.push(alloc, 0_u8);
                            if du < know.len() {
                                if let km = know.get_mut(du) {
                                    km.* = ValKnow.{ kind: KNOW_BOOL, bval: bres, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: types.TY_BOOL };
                                }
                            }
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        }
                    }

                    // 3. Integer / Char / Enum constant folding.
                    if !emitted && lk.kind == KNOW_INT && rk.kind == KNOW_INT {
                        if env.is_concrete_integer(inst.ty1) {
                            let fres = eval_const_int_binary(env, inst.bin_op, lk.u64_val, rk.u64_val, inst.ty1);
                            if fres.folded {
                                if fres.is_bool {
                                    let ci = try make_bool_const_inst(alloc, eir_prog, inst.span, inst.dst, fres.bval);
                                    try new_insts.push(alloc, ci);
                                    try new_flags.push(alloc, 0_u8);
                                    if du < know.len() {
                                        if let km = know.get_mut(du) {
                                            km.* = ValKnow.{ kind: KNOW_BOOL, bval: fres.bval, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: types.TY_BOOL };
                                        }
                                    }
                                } else {
                                    let ci = try make_int_const_inst(alloc, eir_prog, env, inst.span, inst.dst, fres.u64_val, inst.ty0);
                                    try new_insts.push(alloc, ci);
                                    try new_flags.push(alloc, 0_u8);
                                    if du < know.len() {
                                        if let km = know.get_mut(du) {
                                            km.* = ValKnow.{ kind: KNOW_INT, bval: false, u64_val: fres.u64_val, aux_u32: eir.EIR_NONE, ty: inst.ty0 };
                                        }
                                    }
                                }
                                emitted = true;
                                bchanged = true;
                                stats.folded_consts = stats.folded_consts +% 1_u64;
                            }
                        } else if inst.bin_op == .Eq || inst.bin_op == .NotEq {
                            let eq = lk.u64_val == rk.u64_val;
                            let bres = if inst.bin_op == .Eq { eq } else { !eq };
                            let ci = try make_bool_const_inst(alloc, eir_prog, inst.span, inst.dst, bres);
                            try new_insts.push(alloc, ci);
                            try new_flags.push(alloc, 0_u8);
                            if du < know.len() {
                                if let km = know.get_mut(du) {
                                    km.* = ValKnow.{ kind: KNOW_BOOL, bval: bres, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: types.TY_BOOL };
                                }
                            }
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        }
                        _ = 0_u8;
                    }

                    // 4. Algebraic identities & power-of-2 strength reduction (integers ONLY — preserves IEEE-754 floats!).
                    if !emitted && env.is_concrete_integer(inst.ty1) && env.int_bits(inst.ty1) <= 64_u8 {
                        let bits = env.int_bits(inst.ty1);
                        let signed = env.is_signed_int(inst.ty1);
                        let same_ops = inst.v0 == inst.v1;

                        if same_ops && (inst.bin_op == .Sub || inst.bin_op == .SubWrap || inst.bin_op == .BitXor) {
                            let ci = try make_int_const_inst(alloc, eir_prog, env, inst.span, inst.dst, 0_u64, inst.ty0);
                            try new_insts.push(alloc, ci);
                            try new_flags.push(alloc, 0_u8);
                            if du < know.len() {
                                if let km = know.get_mut(du) {
                                    km.* = ValKnow.{ kind: KNOW_INT, bval: false, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: inst.ty0 };
                                }
                            }
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        } else if same_ops && (inst.bin_op == .BitAnd || inst.bin_op == .BitOr) {
                            var cpy = eir.inst_zero(inst.span, .Copy);
                            cpy.dst = inst.dst;
                            cpy.v0 = inst.v0;
                            try new_insts.push(alloc, cpy);
                            try new_flags.push(alloc, 0_u8);
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        } else if same_ops && (inst.bin_op == .Eq || inst.bin_op == .NotEq) {
                            let bv = inst.bin_op == .Eq;
                            let ci = try make_bool_const_inst(alloc, eir_prog, inst.span, inst.dst, bv);
                            try new_insts.push(alloc, ci);
                            try new_flags.push(alloc, 0_u8);
                            if du < know.len() {
                                if let km = know.get_mut(du) {
                                    km.* = ValKnow.{ kind: KNOW_BOOL, bval: bv, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: types.TY_BOOL };
                                }
                            }
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        } else if rk.kind == KNOW_INT {
                            let rv = rk.u64_val;
                            let is_id_zero = rv == 0_u64 && (inst.bin_op == .Add || inst.bin_op == .AddWrap
                                || inst.bin_op == .Sub || inst.bin_op == .SubWrap
                                || inst.bin_op == .BitOr || inst.bin_op == .BitXor
                                || inst.bin_op == .Shl || inst.bin_op == .ShlWrap || inst.bin_op == .Shr);
                            let is_id_one = rv == 1_u64 && (inst.bin_op == .Mul || inst.bin_op == .MulWrap || inst.bin_op == .Div);
                            let is_zero_res = (rv == 0_u64 && (inst.bin_op == .Mul || inst.bin_op == .MulWrap || inst.bin_op == .BitAnd))
                                || (rv == 1_u64 && inst.bin_op == .Mod);
                            if is_id_zero || is_id_one {
                                var cpy = eir.inst_zero(inst.span, .Copy);
                                cpy.dst = inst.dst;
                                cpy.v0 = inst.v0;
                                try new_insts.push(alloc, cpy);
                                try new_flags.push(alloc, 0_u8);
                                emitted = true;
                                bchanged = true;
                                stats.folded_consts = stats.folded_consts +% 1_u64;
                            } else if is_zero_res {
                                let ci = try make_int_const_inst(alloc, eir_prog, env, inst.span, inst.dst, 0_u64, inst.ty0);
                                try new_insts.push(alloc, ci);
                                try new_flags.push(alloc, 0_u8);
                                if du < know.len() {
                                    if let km = know.get_mut(du) {
                                        km.* = ValKnow.{ kind: KNOW_INT, bval: false, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: inst.ty0 };
                                    }
                                }
                                emitted = true;
                                bchanged = true;
                                stats.folded_consts = stats.folded_consts +% 1_u64;
                            } else if let exp = pow2_exp_u64(rv) {
                                if exp >= 1_u8 && exp < bits && (!signed || exp < (bits -% 1_u8)) {
                                    if inst.bin_op == .Mul || inst.bin_op == .MulWrap {
                                        let sh_v = try eir_prog.alloc_fn_value(alloc, fn_id, inst.ty1);
                                        let sh_c = try make_int_const_inst(alloc, eir_prog, env, inst.span, sh_v, exp.widen.[u64](), inst.ty1);
                                        try new_insts.push(alloc, sh_c);
                                        try new_flags.push(alloc, 0_u8);
                                        var bsh = copy inst;
                                        bsh.bin_op = .ShlWrap;
                                        bsh.v1 = sh_v;
                                        try new_insts.push(alloc, bsh);
                                        try new_flags.push(alloc, fl);
                                        emitted = true;
                                        bchanged = true;
                                        stats.folded_consts = stats.folded_consts +% 1_u64;
                                    } else if inst.bin_op == .Div {
                                        let x_nonneg = !signed || eir_prog.fn_val_fact(fn_id, inst.v0).non_neg;
                                        if x_nonneg {
                                            let sh_v = try eir_prog.alloc_fn_value(alloc, fn_id, inst.ty1);
                                            let sh_c = try make_int_const_inst(alloc, eir_prog, env, inst.span, sh_v, exp.widen.[u64](), inst.ty1);
                                            try new_insts.push(alloc, sh_c);
                                            try new_flags.push(alloc, 0_u8);
                                            var bsh = copy inst;
                                            bsh.bin_op = .Shr;
                                            bsh.v1 = sh_v;
                                            try new_insts.push(alloc, bsh);
                                            try new_flags.push(alloc, fl);
                                            emitted = true;
                                            bchanged = true;
                                            if signed {
                                                stats.dbm_checks_eliminated = stats.dbm_checks_eliminated +% 1_u64;
                                            } else {
                                                stats.folded_consts = stats.folded_consts +% 1_u64;
                                            }
                                            _ = 0_u8;
                                        }
                                    } else if inst.bin_op == .Mod {
                                        let x_nonneg = !signed || eir_prog.fn_val_fact(fn_id, inst.v0).non_neg;
                                        if x_nonneg {
                                            let m_v = try eir_prog.alloc_fn_value(alloc, fn_id, inst.ty1);
                                            let m_c = try make_int_const_inst(alloc, eir_prog, env, inst.span, m_v, rv -% 1_u64, inst.ty1);
                                            try new_insts.push(alloc, m_c);
                                            try new_flags.push(alloc, 0_u8);
                                            var band = copy inst;
                                            band.bin_op = .BitAnd;
                                            band.v1 = m_v;
                                            try new_insts.push(alloc, band);
                                            try new_flags.push(alloc, fl);
                                            emitted = true;
                                            bchanged = true;
                                            if signed {
                                                stats.dbm_checks_eliminated = stats.dbm_checks_eliminated +% 1_u64;
                                            } else {
                                                stats.folded_consts = stats.folded_consts +% 1_u64;
                                            }
                                            _ = 0_u8;
                                        }
                                    }
                                    _ = 0_u8;
                                }
                            }
                            _ = 0_u8;
                        } else if lk.kind == KNOW_INT {
                            let lv = lk.u64_val;
                            let is_id_zero = lv == 0_u64 && (inst.bin_op == .Add || inst.bin_op == .AddWrap || inst.bin_op == .BitOr || inst.bin_op == .BitXor);
                            let is_id_one = lv == 1_u64 && (inst.bin_op == .Mul || inst.bin_op == .MulWrap);
                            let is_zero_res = lv == 0_u64 && (inst.bin_op == .Mul || inst.bin_op == .MulWrap || inst.bin_op == .BitAnd);
                            if is_id_zero || is_id_one {
                                var cpy = eir.inst_zero(inst.span, .Copy);
                                cpy.dst = inst.dst;
                                cpy.v0 = inst.v1;
                                try new_insts.push(alloc, cpy);
                                try new_flags.push(alloc, 0_u8);
                                emitted = true;
                                bchanged = true;
                                stats.folded_consts = stats.folded_consts +% 1_u64;
                            } else if is_zero_res {
                                let ci = try make_int_const_inst(alloc, eir_prog, env, inst.span, inst.dst, 0_u64, inst.ty0);
                                try new_insts.push(alloc, ci);
                                try new_flags.push(alloc, 0_u8);
                                if du < know.len() {
                                    if let km = know.get_mut(du) {
                                        km.* = ValKnow.{ kind: KNOW_INT, bval: false, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: inst.ty0 };
                                    }
                                }
                                emitted = true;
                                bchanged = true;
                                stats.folded_consts = stats.folded_consts +% 1_u64;
                            } else if let exp = pow2_exp_u64(lv) {
                                if exp >= 1_u8 && exp < bits && (!signed || exp < (bits -% 1_u8)) && (inst.bin_op == .Mul || inst.bin_op == .MulWrap) {
                                    let sh_v = try eir_prog.alloc_fn_value(alloc, fn_id, inst.ty1);
                                    let sh_c = try make_int_const_inst(alloc, eir_prog, env, inst.span, sh_v, exp.widen.[u64](), inst.ty1);
                                    try new_insts.push(alloc, sh_c);
                                    try new_flags.push(alloc, 0_u8);
                                    var bsh = copy inst;
                                    bsh.bin_op = .ShlWrap;
                                    bsh.v0 = inst.v1;
                                    bsh.v1 = sh_v;
                                    try new_insts.push(alloc, bsh);
                                    try new_flags.push(alloc, fl);
                                    emitted = true;
                                    bchanged = true;
                                    stats.folded_consts = stats.folded_consts +% 1_u64;
                                }
                            }
                            _ = 0_u8;
                        }
                        _ = emitted;
                    }
                    _ = emitted;
                }
                .Cast => {
                    let du = inst.dst.widen.[usize]();
                    let su = inst.v0.widen.[usize]();
                    var sk = val_know_none();
                    if su < know.len() {
                        if let kp = know.get(su) { sk = kp.*; }
                    }
                    if inst.cast_kind == .WrapOptional && du < know.len() {
                        if let km = know.get_mut(du) {
                            km.* = ValKnow.{ kind: KNOW_WRAP_OPT, bval: false, u64_val: 0_u64, aux_u32: inst.v0, ty: inst.ty0 };
                        }
                    } else if inst.cast_kind == .WrapOk && du < know.len() {
                        if let km = know.get_mut(du) {
                            km.* = ValKnow.{ kind: KNOW_WRAP_OK, bval: false, u64_val: 0_u64, aux_u32: inst.v0, ty: inst.ty0 };
                        }
                    } else if inst.cast_kind == .WrapErr && du < know.len() {
                        if let km = know.get_mut(du) {
                            km.* = ValKnow.{ kind: KNOW_WRAP_ERR, bval: false, u64_val: 0_u64, aux_u32: inst.v0, ty: inst.ty0 };
                        }
                    } else if inst.ty0 == inst.ty1
                        && (inst.cast_kind == .Widen || inst.cast_kind == .Trunc || inst.cast_kind == .Clamp || inst.cast_kind == .Bitcast)
                    {
                        var cpy = eir.inst_zero(inst.span, .Copy);
                        cpy.dst = inst.dst;
                        cpy.v0 = inst.v0;
                        try new_insts.push(alloc, cpy);
                        try new_flags.push(alloc, 0_u8);
                        if du < know.len() && sk.kind != KNOW_NONE {
                            if let km = know.get_mut(du) { km.* = sk; }
                        }
                        emitted = true;
                        bchanged = true;
                        stats.folded_consts = stats.folded_consts +% 1_u64;
                    } else if (sk.kind == KNOW_INT || sk.kind == KNOW_BOOL)
                        && env.is_concrete_integer(inst.ty0)
                        && env.int_bits(inst.ty0) <= 64_u8
                    {
                        let to_bits = env.int_bits(inst.ty0);
                        let to_mask = mask_bits_u64(to_bits);
                        var folded_c = false;
                        var out_raw: u64 = 0_u64;
                        if inst.cast_kind == .Widen {
                            if sk.kind == KNOW_BOOL {
                                out_raw = if sk.bval { 1_u64 } else { 0_u64 };
                                folded_c = true;
                            } else if env.is_concrete_integer(inst.ty1) && env.int_bits(inst.ty1) <= 64_u8 {
                                let fb = env.int_bits(inst.ty1);
                                let fs = env.is_signed_int(inst.ty1);
                                let iv = u64_to_int_val(sk.u64_val, fb, fs);
                                out_raw = iv.lo & to_mask;
                                folded_c = true;
                            }
                            _ = 0_u8;
                        } else if inst.cast_kind == .Trunc || inst.cast_kind == .AsU64 {
                            if sk.kind == KNOW_INT {
                                out_raw = sk.u64_val & to_mask;
                                folded_c = true;
                            }
                        } else if inst.cast_kind == .Bitcast && sk.kind == KNOW_INT && env.is_concrete_integer(inst.ty1) && env.int_bits(inst.ty1) == to_bits {
                            out_raw = sk.u64_val & to_mask;
                            folded_c = true;
                        } else if inst.cast_kind == .Clamp && sk.kind == KNOW_INT && env.is_concrete_integer(inst.ty1) && env.int_bits(inst.ty1) <= 64_u8 {
                            let fb = env.int_bits(inst.ty1);
                            let fs = env.is_signed_int(inst.ty1);
                            let iv = u64_to_int_val(sk.u64_val, fb, fs);
                            let tb = types.int_bounds(env.get(inst.ty0));
                            if tb.valid {
                                if types.int_val_cmp(iv, tb.min) < 0_i32 {
                                    out_raw = tb.min.lo & to_mask;
                                } else if types.int_val_cmp(iv, tb.max) > 0_i32 {
                                    out_raw = tb.max.lo & to_mask;
                                } else {
                                    out_raw = iv.lo & to_mask;
                                }
                                folded_c = true;
                            }
                        }
                        if folded_c {
                            let ci = try make_int_const_inst(alloc, eir_prog, env, inst.span, inst.dst, out_raw, inst.ty0);
                            try new_insts.push(alloc, ci);
                            try new_flags.push(alloc, 0_u8);
                            if du < know.len() {
                                if let km = know.get_mut(du) {
                                    km.* = ValKnow.{ kind: KNOW_INT, bval: false, u64_val: out_raw, aux_u32: eir.EIR_NONE, ty: inst.ty0 };
                                }
                            }
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        }
                    }
                    _ = 0_u8;
                }
                .IsNonNull => {
                    let du = inst.dst.widen.[usize]();
                    let su = inst.v0.widen.[usize]();
                    if su < know.len() {
                        var sk = val_know_none();
                        if let kp = know.get(su) { sk = kp.*; }
                        if sk.kind == KNOW_NULL || sk.kind == KNOW_WRAP_OPT {
                            let bv = sk.kind == KNOW_WRAP_OPT;
                            let ci = try make_bool_const_inst(alloc, eir_prog, inst.span, inst.dst, bv);
                            try new_insts.push(alloc, ci);
                            try new_flags.push(alloc, 0_u8);
                            if du < know.len() {
                                if let km = know.get_mut(du) {
                                    km.* = ValKnow.{ kind: KNOW_BOOL, bval: bv, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: types.TY_BOOL };
                                }
                            }
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        }
                    }
                }
                .UnwrapOptional => {
                    let su = inst.v0.widen.[usize]();
                    if su < know.len() {
                        var sk = val_know_none();
                        if let kp = know.get(su) { sk = kp.*; }
                        if sk.kind == KNOW_WRAP_OPT && sk.aux_u32 != eir.EIR_NONE
                            && eir_prog.fn_val_ty(fn_id, sk.aux_u32) == eir_prog.fn_val_ty(fn_id, inst.dst)
                        {
                            var cpy = eir.inst_zero(inst.span, .Copy);
                            cpy.dst = inst.dst;
                            cpy.v0 = sk.aux_u32;
                            try new_insts.push(alloc, cpy);
                            try new_flags.push(alloc, 0_u8);
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        }
                    }
                }
                .IsError => {
                    let du = inst.dst.widen.[usize]();
                    let su = inst.v0.widen.[usize]();
                    if su < know.len() {
                        var sk = val_know_none();
                        if let kp = know.get(su) { sk = kp.*; }
                        if sk.kind == KNOW_WRAP_OK || sk.kind == KNOW_WRAP_ERR || sk.kind == KNOW_NOT_ERR {
                            let bv = sk.kind == KNOW_WRAP_ERR;
                            let ci = try make_bool_const_inst(alloc, eir_prog, inst.span, inst.dst, bv);
                            try new_insts.push(alloc, ci);
                            try new_flags.push(alloc, 0_u8);
                            if du < know.len() {
                                if let km = know.get_mut(du) {
                                    km.* = ValKnow.{ kind: KNOW_BOOL, bval: bv, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: types.TY_BOOL };
                                }
                            }
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        }
                    }
                }
                .UnwrapErrorOk => {
                    let su = inst.v0.widen.[usize]();
                    if su < know.len() {
                        var sk = val_know_none();
                        if let kp = know.get(su) { sk = kp.*; }
                        if sk.kind == KNOW_WRAP_OK && sk.aux_u32 != eir.EIR_NONE
                            && eir_prog.fn_val_ty(fn_id, sk.aux_u32) == eir_prog.fn_val_ty(fn_id, inst.dst)
                        {
                            var cpy = eir.inst_zero(inst.span, .Copy);
                            cpy.dst = inst.dst;
                            cpy.v0 = sk.aux_u32;
                            try new_insts.push(alloc, cpy);
                            try new_flags.push(alloc, 0_u8);
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        }
                    }
                }
                .UnwrapErrorErr => {
                    let su = inst.v0.widen.[usize]();
                    if su < know.len() {
                        var sk = val_know_none();
                        if let kp = know.get(su) { sk = kp.*; }
                        if sk.kind == KNOW_WRAP_ERR && sk.aux_u32 != eir.EIR_NONE
                            && eir_prog.fn_val_ty(fn_id, sk.aux_u32) == eir_prog.fn_val_ty(fn_id, inst.dst)
                        {
                            var cpy = eir.inst_zero(inst.span, .Copy);
                            cpy.dst = inst.dst;
                            cpy.v0 = sk.aux_u32;
                            try new_insts.push(alloc, cpy);
                            try new_flags.push(alloc, 0_u8);
                            emitted = true;
                            bchanged = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        }
                    }
                }
                .MatchTag => {
                    let du = inst.dst.widen.[usize]();
                    let su = inst.v0.widen.[usize]();
                    if su < know.len() {
                        var sk = val_know_none();
                        if let kp = know.get(su) { sk = kp.*; }
                        var have_tag = false;
                        var tag_u64: u64 = 0_u64;
                        if sk.kind == KNOW_INT {
                            tag_u64 = sk.u64_val & 0xFFFFFFFF_u64;
                            have_tag = true;
                        } else if sk.kind == KNOW_WRAP_OK || sk.kind == KNOW_NOT_ERR {
                            tag_u64 = 0_u64;
                            have_tag = true;
                        } else if sk.kind == KNOW_AGG && sk.aux_u32 != eir.EIR_NONE {
                            if let aip = eir_prog.funcs.insts.get(sk.aux_u32.widen.[usize]()) {
                                if let ak = eir_prog.get_aggregate(aip.aux0) {
                                    if ak.tag == .UnionVariant {
                                        tag_u64 = ak.variant_idx.widen.[u64]();
                                        have_tag = true;
                                    }
                                }
                            }
                        }
                        if have_tag {
                            let dty = eir_prog.fn_val_ty(fn_id, inst.dst);
                            if env.is_concrete_integer(dty) {
                                let ci = try make_int_const_inst(alloc, eir_prog, env, inst.span, inst.dst, tag_u64, dty);
                                try new_insts.push(alloc, ci);
                                try new_flags.push(alloc, 0_u8);
                                if du < know.len() {
                                    if let km = know.get_mut(du) {
                                        km.* = ValKnow.{ kind: KNOW_INT, bval: false, u64_val: tag_u64, aux_u32: eir.EIR_NONE, ty: dty };
                                    }
                                }
                                emitted = true;
                                bchanged = true;
                                stats.folded_consts = stats.folded_consts +% 1_u64;
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .FieldExtract => {
                    let su = inst.v0.widen.[usize]();
                    if su < know.len() {
                        var sk = val_know_none();
                        if let kp = know.get(su) { sk = kp.*; }
                        if sk.kind == KNOW_AGG && sk.aux_u32 != eir.EIR_NONE {
                            var elem_v = eir.EIR_NONE;
                            if let aip = eir_prog.funcs.insts.get(sk.aux_u32.widen.[usize]()) {
                                if let ak = eir_prog.get_aggregate(aip.aux0) {
                                    let evs = eir_prog.vals_slice(aip.range);
                                    let fidx = inst.aux0.widen.[usize]();
                                    if ak.tag == .UnionVariant && evs.len == 1_usize {
                                        elem_v = evs[0_usize];
                                    } else if (ak.tag == .Struct || ak.tag == .AnonStruct || ak.tag == .Tuple)
                                        && fidx < evs.len
                                    {
                                        elem_v = evs[fidx];
                                    }
                                }
                                _ = 0_u8;
                            }
                            if elem_v != eir.EIR_NONE && eir_prog.fn_val_ty(fn_id, elem_v) == eir_prog.fn_val_ty(fn_id, inst.dst) {
                                var cpy = eir.inst_zero(inst.span, .Copy);
                                cpy.dst = inst.dst;
                                cpy.v0 = elem_v;
                                try new_insts.push(alloc, cpy);
                                try new_flags.push(alloc, 0_u8);
                                emitted = true;
                                bchanged = true;
                                stats.folded_consts = stats.folded_consts +% 1_u64;
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .BuiltinCall => {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        if bc.op.kind == .ArenaPoolIdAt && inst.dst != eir.EIR_NONE && bc.args.len >= 2_u32 {
                            let bargs = eir_prog.vals_slice(bc.args);
                            if bargs.len >= 2_usize {
                                let pid = canonical_pool_from_val(bargs[0_usize], canon_val.as_slice(), slot_addr_of.as_slice());
                                let idx_v = bargs[1_usize];
                                if try is_pool_id_at_loop_guarded(
                                    alloc, eir_prog, fn_id, bb, nblks, pid, idx_v,
                                    canon_val.as_slice(), slot_addr_of.as_slice(),
                                    pool_len_of.as_slice(), pool_len_bb.as_slice(),
                                    lt_lhs.as_slice(), lt_rhs.as_slice(),
                                    gt0_val.as_slice(), sub1_src.as_slice(),
                                    fn_has_pool_reset, &unsafe_dom_blks,
                                ) {
                                    if (fl & eir.PROVEN_BOUNDS_SAFE) == 0_u8 {
                                        fl = fl | eir.PROVEN_BOUNDS_SAFE;
                                        bchanged = true;
                                        stats.dbm_checks_eliminated = stats.dbm_checks_eliminated +% 1_u64;
                                    }
                                    let du = inst.dst.widen.[usize]();
                                    if du < know.len() {
                                        if let km = know.get_mut(du) {
                                            km.* = ValKnow.{ kind: KNOW_NOT_ERR, bval: false, u64_val: 0_u64, aux_u32: eir.EIR_NONE, ty: inst.ty0 };
                                        }
                                    }
                                }
                            }
                        } else if bc.op.kind == .ArrayLen && inst.dst != eir.EIR_NONE && bc.args.len >= 1_u32 {
                            let bargs = eir_prog.vals_slice(bc.args);
                            if bargs.len >= 1_usize {
                                var aty = eir_prog.fn_val_ty(fn_id, bargs[0_usize]);
                                let an0 = env.get(aty);
                                if an0.kind == .Borrow && an0.borrow_kind == .Single {
                                    aty = an0.primary;
                                }
                                let an = env.get(aty);
                                if an.kind == .Array {
                                    let dty = eir_prog.fn_val_ty(fn_id, inst.dst);
                                    if env.is_concrete_integer(dty) {
                                        let ci = try make_int_const_inst(alloc, eir_prog, env, inst.span, inst.dst, an.u64_val, dty);
                                        try new_insts.push(alloc, ci);
                                        try new_flags.push(alloc, 0_u8);
                                        let du = inst.dst.widen.[usize]();
                                        if du < know.len() {
                                            if let km = know.get_mut(du) {
                                                km.* = ValKnow.{ kind: KNOW_INT, bval: false, u64_val: an.u64_val, aux_u32: eir.EIR_NONE, ty: dty };
                                            }
                                        }
                                        emitted = true;
                                        bchanged = true;
                                        stats.folded_consts = stats.folded_consts +% 1_u64;
                                    }
                                }
                            }
                        } else if bc.op.kind == .StrLen && inst.dst != eir.EIR_NONE && bc.args.len >= 1_u32 {
                            let bargs = eir_prog.vals_slice(bc.args);
                            if bargs.len >= 1_usize {
                                let au = bargs[0_usize].widen.[usize]();
                                if au < know.len() {
                                    var sk = val_know_none();
                                    if let kp = know.get(au) { sk = kp.*; }
                                    if sk.kind == KNOW_STR {
                                        let dty = eir_prog.fn_val_ty(fn_id, inst.dst);
                                        if env.is_concrete_integer(dty) {
                                            let ci = try make_int_const_inst(alloc, eir_prog, env, inst.span, inst.dst, sk.u64_val, dty);
                                            try new_insts.push(alloc, ci);
                                            try new_flags.push(alloc, 0_u8);
                                            let du = inst.dst.widen.[usize]();
                                            if du < know.len() {
                                                if let km = know.get_mut(du) {
                                                    km.* = ValKnow.{ kind: KNOW_INT, bval: false, u64_val: sk.u64_val, aux_u32: eir.EIR_NONE, ty: dty };
                                                }
                                            }
                                            emitted = true;
                                            bchanged = true;
                                            stats.folded_consts = stats.folded_consts +% 1_u64;
                                        }
                                    }
                                }
                            }
                        }
                        _ = emitted;
                    }
                    _ = emitted;
                }
                _ => {}
            }

            if !emitted {
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            }
            ii = ii +% 1_u32;
        }

        if bchanged {
            try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
        }

        // Fold constant Branch & SwitchInt terminators (never corrupt par_for_regions headers).
        if !is_par_for_header(eir_prog, fn_id, bb) {
            var term = eir.term_unreachable(span.span_dummy(), false);
            if let blk = eir_prog.fn_block(fn_id, bb) {
                term = blk.term;
            }
            if term.kind == .Branch {
                if term.bb0 == term.bb1 {
                    if let bm = eir_prog.fn_block_mut(fn_id, bb) {
                        bm.term = eir.term_goto(term.bb0);
                    }
                    cfg_changed = true;
                    stats.folded_consts = stats.folded_consts +% 1_u64;
                } else {
                    let cu = term.val.widen.[usize]();
                    if cu < know.len() {
                        var ck = val_know_none();
                        if let kp = know.get(cu) { ck = kp.*; }
                        if ck.kind == KNOW_BOOL {
                            let target = if ck.bval { term.bb0 } else { term.bb1 };
                            if let bm = eir_prog.fn_block_mut(fn_id, bb) {
                                bm.term = eir.term_goto(target);
                            }
                            cfg_changed = true;
                            stats.folded_consts = stats.folded_consts +% 1_u64;
                        }
                    }
                }
            } else if term.kind == .SwitchInt {
                let du = term.val.widen.[usize]();
                if du < know.len() {
                    var dk = val_know_none();
                    if let kp = know.get(du) { dk = kp.*; }
                    if dk.kind == KNOW_INT {
                        let bits = if env.is_concrete_integer(dk.ty) { env.int_bits(dk.ty) } else { 64_u8 };
                        let signed = env.is_concrete_integer(dk.ty) && env.is_signed_int(dk.ty);
                        let iv = u64_to_int_val(dk.u64_val, bits, signed);
                        var target = term.bb0;
                        let ts = eir_prog.switch_targets_slice(term.targets);
                        var ti: usize = 0_usize;
                        while ti < ts.len {
                            if types.int_val_eq(ts[ti].val, iv) {
                                target = ts[ti].target;
                                break;
                            }
                            ti = ti +% 1_usize;
                        }
                        if let bm = eir_prog.fn_block_mut(fn_id, bb) {
                            bm.term = eir.term_goto(target);
                        }
                        cfg_changed = true;
                        stats.folded_consts = stats.folded_consts +% 1_u64;
                    }
                }
            }
        }
        r0 = r0 +% 1_u32;
    }

    if cfg_changed {
        try eir_prog.rebuild_fn_rpo(alloc, fn_id);
        try eir_prog.prune_fn_phi_preds(alloc, fn_id);
        try clear_unreachable_blocks(alloc, eir_prog, fn_id);
    }
    _ = try eliminate_copies_fn(alloc, eir_prog, fn_id);

    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    know.destroy(alloc);
    unsafe_dom_blks.destroy(alloc);
    unary_kind.destroy(alloc);
    unary_src.destroy(alloc);
    is_one_const.destroy(alloc);
    is_zero_const.destroy(alloc);
    sub1_src.destroy(alloc);
    gt0_val.destroy(alloc);
    lt_rhs.destroy(alloc);
    lt_lhs.destroy(alloc);
    pool_len_bb.destroy(alloc);
    pool_len_of.destroy(alloc);
    slot_addr_of.destroy(alloc);
    canon_val.destroy(alloc);
    return;
}

fn pass_sccp_fold_dbm(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    stats: *mut OptStats,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) {
            try sccp_fold_dbm_fn(alloc, eir_prog, fi, env, stats);
        }
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Section 7: Pass 5 — Proven `noalias` Load / Store-to-Load Forwarding (#1)
// ===========================================================================

const FWD_SLOT: u8 = 1_u8;
const FWD_FIELD1: u8 = 2_u8;
const FWD_FIELD2: u8 = 3_u8;
const FWD_POOL_COL: u8 = 4_u8;

struct FwdEntry {
    active: bool;
    kind: u8;
    base_is_slot: bool;
    base_id: u32;
    k0: u8;
    idx0: u32;
    k1: u8;
    idx1: u32;
    ty: types.TyId;
    val: eir.EirValue;
}

struct FwdUndo {
    entry_idx: u32;
    prev_active: bool;
    prev_val: eir.EirValue;
}

struct FwdFrame {
    bb: eir.BlockId;
    child_cur: u32;
    entered: bool;
    undo_mark: usize;
    entries_mark: usize;
}

fn fwd_deactivate(
    alloc: *mut AllocCap,
    entries: *mut col.DynBuf[FwdEntry],
    undo: *mut col.DynBuf[FwdUndo],
    idx: usize,
) -> !OutOfMemory {
    let es = entries.as_mut_slice();
    if idx < es.len && es[idx].active {
        try undo.push(alloc, FwdUndo.{
            entry_idx: idx.trunc.[u32](),
            prev_active: true,
            prev_val: es[idx].val,
        });
        es[idx].active = false;
    }
    return;
}

fn fwd_record(
    alloc: *mut AllocCap,
    entries: *mut col.DynBuf[FwdEntry],
    undo: *mut col.DynBuf[FwdUndo],
    cand: FwdEntry,
) -> !OutOfMemory {
    let es = entries.as_mut_slice();
    var i: usize = 0_usize;
    while i < es.len {
        let e = es[i];
        if e.active
            && e.kind == cand.kind
            && e.base_is_slot == cand.base_is_slot
            && e.base_id == cand.base_id
            && e.k0 == cand.k0
            && e.idx0 == cand.idx0
            && e.k1 == cand.k1
            && e.idx1 == cand.idx1
            && e.ty == cand.ty
        {
            try undo.push(alloc, FwdUndo.{
                entry_idx: i.trunc.[u32](),
                prev_active: true,
                prev_val: e.val,
            });
            es[i].val = cand.val;
            return;
        }
        i = i +% 1_usize;
    }
    if entries.len() < 256_usize {
        try entries.push(alloc, cand);
    }
    return;
}

fn fwd_lookup(entries: *col.DynBuf[FwdEntry], cand: *FwdEntry) -> eir.EirValue {
    let es = entries.as_slice();
    var i: usize = 0_usize;
    while i < es.len {
        let e = es[i];
        if e.active
            && e.kind == cand.kind
            && e.base_is_slot == cand.base_is_slot
            && e.base_id == cand.base_id
            && e.k0 == cand.k0
            && e.idx0 == cand.idx0
            && e.k1 == cand.k1
            && e.idx1 == cand.idx1
            && e.ty == cand.ty
        {
            return e.val;
        }
        i = i +% 1_usize;
    }
    return eir.EIR_NONE;
}

fn fwd_rollback(
    entries: *mut col.DynBuf[FwdEntry],
    undo: *mut col.DynBuf[FwdUndo],
    undo_mark: usize,
    entries_mark: usize,
) {
    while undo.len() > undo_mark {
        let u = undo.pop() orelse { break; };
        let es = entries.as_mut_slice();
        let idx = u.entry_idx.widen.[usize]();
        if idx < es.len {
            es[idx].active = u.prev_active;
            es[idx].val = u.prev_val;
        }
    }
    while entries.len() > entries_mark {
        _ = entries.pop();
    }
}

fn proj_kind_u8(k: eir.EirProjKind) -> u8 {
    match k {
        .Deref => { return 0_u8; }
        .Field => { return 1_u8; }
        .TupleField => { return 2_u8; }
        .Index => { return 3_u8; }
        .PoolCol => { return 4_u8; }
    }
}

fn slot_is_ptr_like(eir_prog: *eir.EirProgram, env: *types.TypeEnv, fn_id: u32, slot_id: u32) -> bool {
    if let si = eir_prog.fn_slot(fn_id, slot_id) {
        let tn = env.get(si.ty);
        if tn.kind == .Borrow || tn.kind == .RawPtr {
            return true;
        }
    }
    return false;
}

fn load_forwarding_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> u64 ! OutOfMemory {
    var nvals: usize = 0_usize;
    var nslots: usize = 0_usize;
    var entry: eir.BlockId = 0_u32;
    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) {
            return 0_u64;
        }
        nvals = f.value_tys.len.widen.[usize]();
        nslots = f.slots.len.widen.[usize]();
        entry = f.entry;
        rpo_r = f.rpo;
    } else {
        return 0_u64;
    }
    if nvals == 0_usize || rpo_r.len == 0_u32 {
        return 0_u64;
    }

    // Pre-scan canonical base values (unwrapping Copy & Cast(MutToConst)),
    // address-taken slots, and noalias parameters.
    var canon = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer canon.destroy(alloc);
    try fill_u32(alloc, &mut canon, nvals, eir.EIR_NONE);
    var addr_taken = try col.BitSet.init(alloc, max_usize(nslots, 1_usize));
    errdefer addr_taken.destroy(alloc);
    var ptr_slots = try col.BitSet.init(alloc, max_usize(nslots, 1_usize));
    errdefer ptr_slots.destroy(alloc);
    var psi: usize = 0_usize;
    while psi < nslots {
        if slot_is_ptr_like(eir_prog, env, fn_id, psi.trunc.[u32]()) {
            ptr_slots.set(psi);
            addr_taken.set(psi);
        }
        psi = psi +% 1_usize;
    }
    var noalias_vals = try col.BitSet.init(alloc, nvals);
    errdefer noalias_vals.destroy(alloc);

    let nap = eir_prog.fn_noalias_params(fn_id);
    let params = eir_prog.fn_params(fn_id);
    var ni: usize = 0_usize;
    while ni < nap.len {
        let p_idx = nap[ni].widen.[usize]();
        if p_idx < params.len {
            let pv = params[p_idx].widen.[usize]();
            if pv < nvals {
                noalias_vals.set(pv);
            }
        }
        ni = ni +% 1_usize;
    }

    var rpre: u32 = 0_u32;
    while rpre < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% rpre).widen.[usize]()) {
            bb = bp.*;
        }
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .Copy || (inst.kind == .Cast && inst.cast_kind == .MutToConst) {
                if inst.dst != eir.EIR_NONE && inst.v0 != eir.EIR_NONE {
                    u32_set(&mut canon, inst.dst.widen.[usize](), inst.v0);
                }
            } else if inst.kind == .SlotAddr {
                if inst.aux0.widen.[usize]() < nslots {
                    addr_taken.set(inst.aux0.widen.[usize]());
                }
            } else if inst.kind == .PlaceAddr {
                if let pl = eir_prog.get_place(inst.aux0) {
                    if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                        addr_taken.set(pl.base.id.widen.[usize]());
                    }
                }
            } else if inst.kind == .BuiltinCall {
                if let bc = eir_prog.get_builtin_call(inst.aux0) {
                    let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                    var ki: usize = 0_usize;
                    while ki < ss.len {
                        if ss[ki] != eir.EIR_NONE && ss[ki].widen.[usize]() < nslots {
                            addr_taken.set(ss[ki].widen.[usize]());
                        }
                        ki = ki +% 1_usize;
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        rpre = rpre +% 1_u32;
    }

    let dtree = try DomTree.build(alloc, eir_prog, fn_id);
    errdefer dtree.destroy(alloc);
    var entries = try col.DynBuf.[FwdEntry].init(alloc, 32_usize);
    errdefer entries.destroy(alloc);
    var undo = try col.DynBuf.[FwdUndo].init(alloc, 64_usize);
    errdefer undo.destroy(alloc);
    var dfs = try col.DynBuf.[FwdFrame].init(alloc, 32_usize);
    errdefer dfs.destroy(alloc);
    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);

    var forwarded: u64 = 0_u64;
    try dfs.push(alloc, FwdFrame.{
        bb: entry,
        child_cur: u32_at(&dtree.child_head, entry.widen.[usize]()),
        entered: false,
        undo_mark: 0_usize,
        entries_mark: 0_usize,
    });

    while !dfs.is_empty() {
        let top_i = dfs.len() -% 1_usize;
        var fr = FwdFrame.{ bb: 0_u32, child_cur: eir.EIR_NONE, entered: false, undo_mark: 0_usize, entries_mark: 0_usize };
        if let fp = dfs.get(top_i) {
            fr = fp.*;
        }
        if !fr.entered {
            let umark = undo.len();
            let emark = entries.len();
            if let fm = dfs.get_mut(top_i) {
                fm.entered = true;
                fm.undo_mark = umark;
                fm.entries_mark = emark;
            }
            let bb = fr.bb;

            // Only inherit parent's memory cache when `bb` has a single CFG predecessor equal to `bb.idom`.
            var keep_parent_cache = bb == entry;
            if bb != entry {
                var idom = eir.EIR_NONE;
                var preds_r = ast.range_empty();
                if let blk = eir_prog.fn_block(fn_id, bb) {
                    idom = blk.idom;
                    preds_r = blk.preds;
                }
                if preds_r.len == 1_u32 {
                    let bpreds = eir_prog.preds_slice(preds_r);
                    if bpreds.len == 1_usize && bpreds[0_usize] == idom {
                        keep_parent_cache = true;
                    }
                }
            }
            if !keep_parent_cache {
                var ei: usize = 0_usize;
                while ei < entries.len() {
                    try fwd_deactivate(alloc, &mut entries, &mut undo, ei);
                    ei = ei +% 1_usize;
                }
            }

            var insts_r = ast.range_empty();
            if let blk = eir_prog.fn_block(fn_id, bb) {
                insts_r = blk.insts;
            }
            new_insts.clear();
            new_flags.clear();
            var bchanged = false;

            var ii: u32 = 0_u32;
            while ii < insts_r.len {
                let gid = insts_r.start +% ii;
                var inst = eir.inst_zero(span.span_dummy(), .ParForHint);
                if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                    inst = ip.*;
                }
                let fl = eir_prog.inst_proven_flags(gid);
                var replaced = false;

                match inst.kind {
                    .LoadSlot => {
                        let dty = eir_prog.fn_val_ty(fn_id, inst.dst);
                        let key = FwdEntry.{
                            active: true, kind: FWD_SLOT, base_is_slot: true, base_id: inst.aux0,
                            k0: 0_u8, idx0: 0_u32, k1: 0_u8, idx1: 0_u32, ty: dty, val: inst.dst,
                        };
                        let hit = fwd_lookup(&entries, &key);
                        if hit != eir.EIR_NONE && eir_prog.fn_val_ty(fn_id, hit) == dty {
                            var cpy = eir.inst_zero(inst.span, .Copy);
                            cpy.dst = inst.dst;
                            cpy.v0 = hit;
                            try new_insts.push(alloc, cpy);
                            try new_flags.push(alloc, 0_u8);
                            replaced = true;
                            bchanged = true;
                            forwarded = forwarded +% 1_u64;
                        } else {
                            try fwd_record(alloc, &mut entries, &mut undo, key);
                        }
                        _ = 0_u8;
                    }
                    .StoreSlot => {
                        let s = inst.aux0;
                        let s_esc = s.widen.[usize]() < nslots && addr_taken.test(s.widen.[usize]());
                        var ei: usize = 0_usize;
                        while ei < entries.len() {
                            var kill = false;
                            if let ep = entries.get(ei) {
                                if ep.active {
                                    if ep.kind == FWD_SLOT && ep.base_id == s {
                                        kill = true;
                                    } else if (ep.kind == FWD_FIELD1 || ep.kind == FWD_FIELD2 || ep.kind == FWD_POOL_COL) && ep.base_is_slot && ep.base_id == s {
                                        kill = true;
                                    } else if s_esc && (ep.kind == FWD_FIELD1 || ep.kind == FWD_FIELD2 || ep.kind == FWD_POOL_COL) && !ep.base_is_slot {
                                        kill = true;
                                    }
                                    _ = 0_u8;
                                }
                            }
                            if kill {
                                try fwd_deactivate(alloc, &mut entries, &mut undo, ei);
                            }
                            ei = ei +% 1_usize;
                        }
                        let vty = eir_prog.fn_val_ty(fn_id, inst.v0);
                        try fwd_record(alloc, &mut entries, &mut undo, FwdEntry.{
                            active: true, kind: FWD_SLOT, base_is_slot: true, base_id: s,
                            k0: 0_u8, idx0: 0_u32, k1: 0_u8, idx1: 0_u32, ty: vty, val: inst.v0,
                        });
                    }
                    .LoadPlace => {
                        if let pl = eir_prog.get_place(inst.aux0) {
                            let ps = eir_prog.projs_slice(pl.projs);
                            let dty = eir_prog.fn_val_ty(fn_id, inst.dst);
                            let is_sl = pl.base.kind == .Slot;
                            let bid = if is_sl { pl.base.id } else { resolve_val_chain(pl.base.id, canon.as_slice()) };
                            if ps.len == 1_usize && (ps[0_usize].kind == .Field || ps[0_usize].kind == .TupleField || ps[0_usize].kind == .Deref) {
                                let key = FwdEntry.{
                                    active: true, kind: FWD_FIELD1, base_is_slot: is_sl, base_id: bid,
                                    k0: proj_kind_u8(ps[0_usize].kind), idx0: ps[0_usize].index,
                                    k1: 0_u8, idx1: 0_u32, ty: dty, val: inst.dst,
                                };
                                let hit = fwd_lookup(&entries, &key);
                                if hit != eir.EIR_NONE && eir_prog.fn_val_ty(fn_id, hit) == dty {
                                    var cpy = eir.inst_zero(inst.span, .Copy);
                                    cpy.dst = inst.dst;
                                    cpy.v0 = hit;
                                    try new_insts.push(alloc, cpy);
                                    try new_flags.push(alloc, 0_u8);
                                    replaced = true;
                                    bchanged = true;
                                    forwarded = forwarded +% 1_u64;
                                } else {
                                    try fwd_record(alloc, &mut entries, &mut undo, key);
                                }
                                _ = 0_u8;
                            } else if ps.len == 2_usize
                                && (ps[0_usize].kind == .Deref || ps[0_usize].kind == .Field || ps[0_usize].kind == .TupleField)
                                && (ps[1_usize].kind == .Field || ps[1_usize].kind == .TupleField)
                            {
                                let key = FwdEntry.{
                                    active: true, kind: FWD_FIELD2, base_is_slot: is_sl, base_id: bid,
                                    k0: proj_kind_u8(ps[0_usize].kind), idx0: ps[0_usize].index,
                                    k1: proj_kind_u8(ps[1_usize].kind), idx1: ps[1_usize].index,
                                    ty: dty, val: inst.dst,
                                };
                                let hit = fwd_lookup(&entries, &key);
                                if hit != eir.EIR_NONE && eir_prog.fn_val_ty(fn_id, hit) == dty {
                                    var cpy = eir.inst_zero(inst.span, .Copy);
                                    cpy.dst = inst.dst;
                                    cpy.v0 = hit;
                                    try new_insts.push(alloc, cpy);
                                    try new_flags.push(alloc, 0_u8);
                                    replaced = true;
                                    bchanged = true;
                                    forwarded = forwarded +% 1_u64;
                                } else {
                                    try fwd_record(alloc, &mut entries, &mut undo, key);
                                }
                                _ = 0_u8;
                            }
                        }
                        _ = 0_u8;
                    }
                    .StorePlace => {
                        if let pl = eir_prog.get_place(inst.aux0) {
                            let ps = eir_prog.projs_slice(pl.projs);
                            let vty = eir_prog.fn_val_ty(fn_id, inst.v0);
                            let is_sl = pl.base.kind == .Slot;
                            let bid = if is_sl { pl.base.id } else { resolve_val_chain(pl.base.id, canon.as_slice()) };
                            let is_priv_sl = is_sl && !(bid.widen.[usize]() < nslots && ptr_slots.test(bid.widen.[usize]()));
                            if is_priv_sl && ps.len == 1_usize && (ps[0_usize].kind == .Field || ps[0_usize].kind == .TupleField) {
                                let fk = proj_kind_u8(ps[0_usize].kind);
                                let fidx = ps[0_usize].index;
                                let s_esc = bid.widen.[usize]() < nslots && addr_taken.test(bid.widen.[usize]());
                                var ei: usize = 0_usize;
                                while ei < entries.len() {
                                    var kill = false;
                                    if let ep = entries.get(ei) {
                                        if ep.active {
                                            if ep.kind == FWD_SLOT && ep.base_id == bid {
                                                kill = true;
                                            } else if ep.kind == FWD_FIELD1 && ep.base_is_slot && ep.base_id == bid && ep.k0 == fk && ep.idx0 == fidx {
                                                kill = true;
                                            } else if ep.kind == FWD_FIELD2 && ep.base_is_slot && ep.base_id == bid && ep.k0 == fk && ep.idx0 == fidx {
                                                kill = true;
                                            } else if s_esc && (ep.kind == FWD_FIELD1 || ep.kind == FWD_FIELD2) && !ep.base_is_slot {
                                                kill = true;
                                            }
                                            _ = 0_u8;
                                        }
                                    }
                                    if kill {
                                        try fwd_deactivate(alloc, &mut entries, &mut undo, ei);
                                    }
                                    ei = ei +% 1_usize;
                                }
                                try fwd_record(alloc, &mut entries, &mut undo, FwdEntry.{
                                    active: true, kind: FWD_FIELD1, base_is_slot: true, base_id: bid,
                                    k0: fk, idx0: fidx, k1: 0_u8, idx1: 0_u32, ty: vty, val: inst.v0,
                                });
                            } else if !is_sl && ps.len == 2_usize && ps[0_usize].kind == .Deref
                                && (ps[1_usize].kind == .Field || ps[1_usize].kind == .TupleField)
                            {
                                // Eon noalias: `*mut T` field store never aliases distinct field or PoolColumn!
                                let f1k = proj_kind_u8(ps[1_usize].kind);
                                let f1idx = ps[1_usize].index;
                                let bid_noalias = bid.widen.[usize]() < nvals && noalias_vals.test(bid.widen.[usize]());
                                var ei: usize = 0_usize;
                                while ei < entries.len() {
                                    var kill = false;
                                    if let ep = entries.get(ei) {
                                        if ep.active && ep.kind != FWD_POOL_COL {
                                            if ep.base_is_slot {
                                                if ep.base_id.widen.[usize]() < nslots && addr_taken.test(ep.base_id.widen.[usize]()) {
                                                    kill = true;
                                                }
                                            } else if ep.kind == FWD_FIELD1 {
                                                kill = true;
                                            } else if ep.kind == FWD_FIELD2 {
                                                if ep.k1 == f1k && ep.idx1 == f1idx {
                                                    let ep_noalias = ep.base_id.widen.[usize]() < nvals && noalias_vals.test(ep.base_id.widen.[usize]());
                                                    if ep.base_id == bid || !(bid_noalias && ep_noalias) {
                                                        kill = true;
                                                    }
                                                }
                                            }
                                            _ = 0_u8;
                                        }
                                    }
                                    if kill {
                                        try fwd_deactivate(alloc, &mut entries, &mut undo, ei);
                                    }
                                    ei = ei +% 1_usize;
                                }
                                try fwd_record(alloc, &mut entries, &mut undo, FwdEntry.{
                                    active: true, kind: FWD_FIELD2, base_is_slot: false, base_id: bid,
                                    k0: 0_u8, idx0: 0_u32, k1: f1k, idx1: f1idx, ty: vty, val: inst.v0,
                                });
                            } else {
                                // General heap/indexed store: never invalidates non-addr-taken slots or PoolColumn!
                                var ei: usize = 0_usize;
                                while ei < entries.len() {
                                    var kill = false;
                                    if let ep = entries.get(ei) {
                                        if ep.active && ep.kind != FWD_POOL_COL {
                                            if !ep.base_is_slot {
                                                kill = true;
                                            } else if (is_sl && ep.base_id == bid)
                                                || (ep.base_id.widen.[usize]() < nslots && addr_taken.test(ep.base_id.widen.[usize]()))
                                            {
                                                kill = true;
                                            }
                                        }
                                        _ = 0_u8;
                                    }
                                    if kill {
                                        try fwd_deactivate(alloc, &mut entries, &mut undo, ei);
                                    }
                                    ei = ei +% 1_usize;
                                }
                            }
                            _ = is_sl;
                        }
                        _ = inst.aux0;
                    }
                    .PoolColumnLoad => {
                        if let op = eir_prog.get_pool_col_op(inst.aux0) {
                            let is_sl = op.pool_base.kind == .Slot;
                            let pbid = if is_sl { op.pool_base.id } else { resolve_val_chain(op.pool_base.id, canon.as_slice()) };
                            let cidx = resolve_val_chain(op.index, canon.as_slice());
                            let dty = eir_prog.fn_val_ty(fn_id, inst.dst);
                            let key = FwdEntry.{
                                active: true, kind: FWD_POOL_COL, base_is_slot: is_sl, base_id: pbid,
                                k0: 0_u8, idx0: op.col_idx, k1: 0_u8, idx1: cidx, ty: dty, val: inst.dst,
                            };
                            let hit = fwd_lookup(&entries, &key);
                            if hit != eir.EIR_NONE && eir_prog.fn_val_ty(fn_id, hit) == dty {
                                var cpy = eir.inst_zero(inst.span, .Copy);
                                cpy.dst = inst.dst;
                                cpy.v0 = hit;
                                try new_insts.push(alloc, cpy);
                                try new_flags.push(alloc, 0_u8);
                                replaced = true;
                                bchanged = true;
                                forwarded = forwarded +% 1_u64;
                            } else {
                                try fwd_record(alloc, &mut entries, &mut undo, key);
                            }
                            _ = 0_u8;
                        }
                        _ = 0_u8;
                    }
                    .PoolColumnStore => {
                        // SUPER-OPT #1: Store to pool column `col_idx` NEVER invalidates `other_col_idx != col_idx`!
                        if let op = eir_prog.get_pool_col_op(inst.aux0) {
                            let is_sl = op.pool_base.kind == .Slot;
                            let pbid = if is_sl { op.pool_base.id } else { resolve_val_chain(op.pool_base.id, canon.as_slice()) };
                            let cidx = resolve_val_chain(op.index, canon.as_slice());
                            let col = op.col_idx;
                            var ei: usize = 0_usize;
                            while ei < entries.len() {
                                var kill = false;
                                if let ep = entries.get(ei) {
                                    if ep.active && ep.kind == FWD_POOL_COL && ep.idx0 == col {
                                        kill = true;
                                    }
                                }
                                if kill {
                                    try fwd_deactivate(alloc, &mut entries, &mut undo, ei);
                                }
                                ei = ei +% 1_usize;
                            }
                            let vty = eir_prog.fn_val_ty(fn_id, inst.v0);
                            try fwd_record(alloc, &mut entries, &mut undo, FwdEntry.{
                                active: true, kind: FWD_POOL_COL, base_is_slot: is_sl, base_id: pbid,
                                k0: 0_u8, idx0: col, k1: 0_u8, idx1: cidx, ty: vty, val: inst.v0,
                            });
                        }
                        _ = 0_u8;
                    }
                    .Call => {
                        var ei: usize = 0_usize;
                        while ei < entries.len() {
                            var kill = false;
                            if let ep = entries.get(ei) {
                                if ep.active {
                                    if ep.kind == FWD_POOL_COL || !ep.base_is_slot {
                                        kill = true;
                                    } else if ep.base_id.widen.[usize]() < nslots && addr_taken.test(ep.base_id.widen.[usize]()) {
                                        kill = true;
                                    }
                                    _ = 0_u8;
                                }
                            }
                            if kill {
                                try fwd_deactivate(alloc, &mut entries, &mut undo, ei);
                            }
                            ei = ei +% 1_usize;
                        }
                        _ = 0_u8;
                    }
                    .InlineAsm => {
                        var ei: usize = 0_usize;
                        while ei < entries.len() {
                            try fwd_deactivate(alloc, &mut entries, &mut undo, ei);
                            ei = ei +% 1_usize;
                        }
                    }
                    .BuiltinCall => {
                        var is_ro = false;
                        if let bc = eir_prog.get_builtin_call(inst.aux0) {
                            is_ro = is_readonly_nontrapping_builtin(bc.op.kind);
                        }
                        if !is_ro {
                            var ei: usize = 0_usize;
                            while ei < entries.len() {
                                var kill = false;
                                if let ep = entries.get(ei) {
                                    if ep.active {
                                        if ep.kind == FWD_POOL_COL || !ep.base_is_slot {
                                            kill = true;
                                        } else if ep.base_id.widen.[usize]() < nslots && addr_taken.test(ep.base_id.widen.[usize]()) {
                                            kill = true;
                                        }
                                        _ = 0_u8;
                                    }
                                }
                                if kill {
                                    try fwd_deactivate(alloc, &mut entries, &mut undo, ei);
                                }
                                ei = ei +% 1_usize;
                            }
                        }
                        _ = 0_u8;
                    }
                    _ => {}
                }

                if !replaced {
                    try new_insts.push(alloc, inst);
                    try new_flags.push(alloc, fl);
                }
                ii = ii +% 1_u32;
            }

            if bchanged {
                try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
            }
        } else if fr.child_cur != eir.EIR_NONE {
            let child = fr.child_cur;
            let next_c = u32_at(&dtree.child_next, child.widen.[usize]());
            if let fm = dfs.get_mut(top_i) {
                fm.child_cur = next_c;
            }
            try dfs.push(alloc, FwdFrame.{
                bb: child,
                child_cur: u32_at(&dtree.child_head, child.widen.[usize]()),
                entered: false,
                undo_mark: 0_usize,
                entries_mark: 0_usize,
            });
        } else {
            fwd_rollback(&mut entries, &mut undo, fr.undo_mark, fr.entries_mark);
            _ = dfs.pop();
        }
    }

    if forwarded > 0_u64 {
        _ = try eliminate_copies_fn(alloc, eir_prog, fn_id);
    }

    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    dfs.destroy(alloc);
    undo.destroy(alloc);
    entries.destroy(alloc);
    dtree.destroy(alloc);
    noalias_vals.destroy(alloc);
    ptr_slots.destroy(alloc);
    addr_taken.destroy(alloc);
    canon.destroy(alloc);
    return forwarded;
}

fn pass_load_forwarding(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    stats: *mut OptStats,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) {
            let c = try load_forwarding_fn(alloc, eir_prog, fi, env);
            stats.gvn_eliminated = stats.gvn_eliminated +% c;
        }
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Section 8: Pass 6 — Dominator-Scoped GVN / CSE
// ===========================================================================

fn is_commutative_binop(op: ast.BinaryOp) -> bool {
    match op {
        .Add => { return true; }
        .AddWrap => { return true; }
        .AddSat => { return true; }
        .AddCheck => { return true; }
        .Mul => { return true; }
        .MulWrap => { return true; }
        .MulSat => { return true; }
        .MulCheck => { return true; }
        .BitAnd => { return true; }
        .BitOr => { return true; }
        .BitXor => { return true; }
        .Eq => { return true; }
        .NotEq => { return true; }
        .And => { return true; }
        .Or => { return true; }
        _ => { return false; }
    }
}

fn inst_kind_u8(k: eir.EirInstKind) -> u8 {
    match k {
        .Const => { return 0_u8; }
        .Copy => { return 1_u8; }
        .LoadSlot => { return 2_u8; }
        .StoreSlot => { return 3_u8; }
        .SlotAddr => { return 4_u8; }
        .LoadPlace => { return 5_u8; }
        .StorePlace => { return 6_u8; }
        .PlaceAddr => { return 7_u8; }
        .PoolColumnLoad => { return 8_u8; }
        .PoolColumnStore => { return 9_u8; }
        .Unary => { return 10_u8; }
        .Binary => { return 11_u8; }
        .Cast => { return 12_u8; }
        .Slice => { return 13_u8; }
        .Aggregate => { return 14_u8; }
        .UnwrapOptional => { return 15_u8; }
        .UnwrapErrorOk => { return 16_u8; }
        .UnwrapErrorErr => { return 17_u8; }
        .IsNonNull => { return 18_u8; }
        .IsError => { return 19_u8; }
        .MatchTag => { return 20_u8; }
        .FieldExtract => { return 21_u8; }
        .MakeDyn => { return 22_u8; }
        .MakeClosure => { return 23_u8; }
        .Call => { return 24_u8; }
        .BuiltinCall => { return 25_u8; }
        .InlineAsm => { return 26_u8; }
        .GetVar => { return 27_u8; }
        .SetVar => { return 28_u8; }
        .ParForHint => { return 29_u8; }
    }
}

fn unary_op_u8(op: ast.UnaryOp) -> u8 {
    match op {
        .Neg => { return 0_u8; }
        .Not => { return 1_u8; }
        .BitNot => { return 2_u8; }
        .Borrow => { return 3_u8; }
        .BorrowMut => { return 4_u8; }
        .Move => { return 5_u8; }
        .Copy => { return 6_u8; }
        .Try => { return 7_u8; }
    }
}

fn bin_op_u8(op: ast.BinaryOp) -> u8 {
    match op {
        .Or => { return 0_u8; }
        .And => { return 1_u8; }
        .Eq => { return 2_u8; }
        .NotEq => { return 3_u8; }
        .Lt => { return 4_u8; }
        .LtEq => { return 5_u8; }
        .Gt => { return 6_u8; }
        .GtEq => { return 7_u8; }
        .BitOr => { return 8_u8; }
        .BitXor => { return 9_u8; }
        .BitAnd => { return 10_u8; }
        .Shl => { return 11_u8; }
        .Shr => { return 12_u8; }
        .ShlWrap => { return 13_u8; }
        .Add => { return 14_u8; }
        .Sub => { return 15_u8; }
        .AddWrap => { return 16_u8; }
        .SubWrap => { return 17_u8; }
        .AddSat => { return 18_u8; }
        .SubSat => { return 19_u8; }
        .AddCheck => { return 20_u8; }
        .SubCheck => { return 21_u8; }
        .Mul => { return 22_u8; }
        .Div => { return 23_u8; }
        .Mod => { return 24_u8; }
        .MulWrap => { return 25_u8; }
        .MulSat => { return 26_u8; }
        .MulCheck => { return 27_u8; }
        .DivCheck => { return 28_u8; }
        .ModCheck => { return 29_u8; }
    }
}

fn cast_kind_u8(k: cfg_ir.CastKind) -> u8 {
    match k {
        .Widen => { return 0_u8; }
        .Trunc => { return 1_u8; }
        .Clamp => { return 2_u8; }
        .ToFloat => { return 3_u8; }
        .TruncToInt => { return 4_u8; }
        .Bitcast => { return 5_u8; }
        .AsU64 => { return 6_u8; }
        .WrapOptional => { return 7_u8; }
        .WrapOk => { return 8_u8; }
        .WrapErr => { return 9_u8; }
        .MutToConst => { return 10_u8; }
        .ArrayBorrowToSlice => { return 11_u8; }
    }
}

fn const_eq_eir(eir_prog: *eir.EirProgram, cid_a: u32, cid_b: u32) -> bool {
    if cid_a == cid_b {
        return true;
    }
    let a = eir_prog.get_const(cid_a) orelse { return false; };
    let b = eir_prog.get_const(cid_b) orelse { return false; };
    if a.kind != b.kind || a.ty != b.ty {
        return false;
    }
    match a.kind {
        .Void => { return true; }
        .Null => { return true; }
        .Bool => { return a.bool_val == b.bool_val; }
        .Char => { return a.aux_u32 == b.aux_u32; }
        .Int => { return types.int_val_eq(a.int_val, b.int_val); }
        .Float => { return str.bytes_eq(eir_prog.bytes_slice(a.bytes), eir_prog.bytes_slice(b.bytes)); }
        .Str => { return str.bytes_eq(eir_prog.bytes_slice(a.bytes), eir_prog.bytes_slice(b.bytes)); }
        .Bytes => { return str.bytes_eq(eir_prog.bytes_slice(a.bytes), eir_prog.bytes_slice(b.bytes)); }
        .EnumTag => { return a.sym == b.sym && types.int_val_eq(a.int_val, b.int_val); }
        .ErrorTag => { return a.sym == b.sym && a.aux_u32 == b.aux_u32; }
        .FnRef => { return a.aux_u32 == b.aux_u32; }
        .ConstDef => { return a.aux_u32 == b.aux_u32; }
    }
}

fn place_eq_eir(eir_prog: *eir.EirProgram, pid_a: u32, pid_b: u32) -> bool {
    if pid_a == pid_b {
        return true;
    }
    let a = eir_prog.get_place(pid_a) orelse { return false; };
    let b = eir_prog.get_place(pid_b) orelse { return false; };
    if a.base.kind != b.base.kind || a.base.id != b.base.id || a.ty != b.ty || a.projs.len != b.projs.len {
        return false;
    }
    let pa = eir_prog.projs_slice(a.projs);
    let pb = eir_prog.projs_slice(b.projs);
    if pa.len != pb.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < pa.len {
        if pa[i].kind != pb[i].kind || pa[i].index != pb[i].index || pa[i].ty != pb[i].ty || pa[i].is_slot_pool != pb[i].is_slot_pool {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

fn builtin_call_eq_eir(eir_prog: *eir.EirProgram, id_a: u32, id_b: u32, canon: *[eir.EirValue]) -> bool {
    let a = eir_prog.get_builtin_call(id_a) orelse { return false; };
    let b = eir_prog.get_builtin_call(id_b) orelse { return false; };
    if a.op.kind != b.op.kind
        || a.op.flag != b.op.flag
        || a.op.len_u8 != b.op.len_u8
        || a.op.bin_op != b.op.bin_op
        || a.op.ty0 != b.op.ty0
        || a.op.ty1 != b.op.ty1
        || a.op.sym != b.op.sym
        || a.ret_ty != b.ret_ty
        || a.args.len != b.args.len
    {
        return false;
    }
    let aa = eir_prog.vals_slice(a.args);
    let ba = eir_prog.vals_slice(b.args);
    if aa.len != ba.len {
        return false;
    }
    var i: usize = 0_usize;
    while i < aa.len {
        let va = if a.op.kind == .ArenaPoolIdAt && i == 0_usize { resolve_val_chain(aa[i], canon) } else { aa[i] };
        let vb = if b.op.kind == .ArenaPoolIdAt && i == 0_usize { resolve_val_chain(ba[i], canon) } else { ba[i] };
        if va != vb {
            return false;
        }
        i = i +% 1_usize;
    }
    return true;
}

struct GvnNode {
    hash: u64;
    inst: eir.EirInst;
    val: eir.EirValue;
    prev_in_bucket: u32;
}

struct GvnUndo {
    hash: u64;
    prev_head: u32;
}

struct GvnFrame {
    bb: eir.BlockId;
    child_cur: u32;
    entered: bool;
    undo_mark: usize;
}

fn gvn_hash_inst(
    eir_prog: *eir.EirProgram,
    inst: *eir.EirInst,
    canon: *[eir.EirValue],
    fn_has_pool_reset: bool,
) -> ?u64 {
    if inst.dst == eir.EIR_NONE {
        return null;
    }
    var h: u64 = hash_mix_u64(0xCBF29CE484222325_u64, inst_kind_u8(inst.kind).widen.[u64]());
    h = hash_mix_u64(h, inst.ty0.widen.[u64]());
    match inst.kind {
        .Const => {
            let kc = eir_prog.get_const(inst.aux0) orelse { return null; };
            h = hash_mix_u64(h, kc.ty.widen.[u64]());
            match kc.kind {
                .Void => { h = hash_mix_u64(h, 1_u64); }
                .Null => { h = hash_mix_u64(h, 2_u64); }
                .Bool => { h = hash_mix_u64(h, if kc.bool_val { 3_u64 } else { 4_u64 }); }
                .Char => { h = hash_mix_u64(h, 5_u64); h = hash_mix_u64(h, kc.aux_u32.widen.[u64]()); }
                .Int => {
                    h = hash_mix_u64(h, 6_u64);
                    h = hash_mix_u64(h, kc.int_val.lo);
                    h = hash_mix_u64(h, kc.int_val.hi.bitcast.[u64]());
                }
                .Float => { h = hash_mix_u64(h, 7_u64); h = hash_mix_u64(h, hash_bytes_u64(eir_prog.bytes_slice(kc.bytes))); }
                .Str => { h = hash_mix_u64(h, 8_u64); h = hash_mix_u64(h, hash_bytes_u64(eir_prog.bytes_slice(kc.bytes))); }
                .Bytes => { h = hash_mix_u64(h, 9_u64); h = hash_mix_u64(h, hash_bytes_u64(eir_prog.bytes_slice(kc.bytes))); }
                .EnumTag => {
                    h = hash_mix_u64(h, 10_u64);
                    h = hash_mix_u64(h, kc.sym.widen.[u64]());
                    h = hash_mix_u64(h, kc.int_val.lo);
                }
                .ErrorTag => {
                    h = hash_mix_u64(h, 11_u64);
                    h = hash_mix_u64(h, kc.sym.widen.[u64]());
                    h = hash_mix_u64(h, kc.aux_u32.widen.[u64]());
                }
                .FnRef => { h = hash_mix_u64(h, 12_u64); h = hash_mix_u64(h, kc.aux_u32.widen.[u64]()); }
                .ConstDef => { h = hash_mix_u64(h, 13_u64); h = hash_mix_u64(h, kc.aux_u32.widen.[u64]()); }
            }
            return h;
        }
        .SlotAddr => {
            h = hash_mix_u64(h, inst.aux0.widen.[u64]());
            h = hash_mix_u64(h, if inst.flag0 { 1_u64 } else { 0_u64 });
            return h;
        }
        .Unary => {
            h = hash_mix_u64(h, unary_op_u8(inst.unary_op).widen.[u64]());
            h = hash_mix_u64(h, inst.v0.widen.[u64]());
            return h;
        }
        .Binary => {
            h = hash_mix_u64(h, bin_op_u8(inst.bin_op).widen.[u64]());
            h = hash_mix_u64(h, inst.ty1.widen.[u64]());
            var a = inst.v0;
            var b = inst.v1;
            if is_commutative_binop(inst.bin_op) && a > b {
                let tmp = a;
                a = b;
                b = tmp;
            }
            h = hash_mix_u64(h, a.widen.[u64]());
            h = hash_mix_u64(h, b.widen.[u64]());
            return h;
        }
        .Cast => {
            h = hash_mix_u64(h, cast_kind_u8(inst.cast_kind).widen.[u64]());
            h = hash_mix_u64(h, inst.ty1.widen.[u64]());
            h = hash_mix_u64(h, inst.v0.widen.[u64]());
            return h;
        }
        .FieldExtract => {
            h = hash_mix_u64(h, inst.ty1.widen.[u64]());
            h = hash_mix_u64(h, inst.aux0.widen.[u64]());
            h = hash_mix_u64(h, inst.v0.widen.[u64]());
            return h;
        }
        .IsNonNull => {
            h = hash_mix_u64(h, inst.ty1.widen.[u64]());
            h = hash_mix_u64(h, inst.v0.widen.[u64]());
            return h;
        }
        .IsError => {
            h = hash_mix_u64(h, inst.ty1.widen.[u64]());
            h = hash_mix_u64(h, inst.v0.widen.[u64]());
            return h;
        }
        .MatchTag => {
            h = hash_mix_u64(h, inst.ty1.widen.[u64]());
            h = hash_mix_u64(h, inst.v0.widen.[u64]());
            return h;
        }
        .UnwrapOptional => {
            h = hash_mix_u64(h, inst.ty1.widen.[u64]());
            h = hash_mix_u64(h, inst.v0.widen.[u64]());
            return h;
        }
        .UnwrapErrorOk => {
            h = hash_mix_u64(h, inst.ty1.widen.[u64]());
            h = hash_mix_u64(h, inst.v0.widen.[u64]());
            return h;
        }
        .PlaceAddr => {
            let pl = eir_prog.get_place(inst.aux0) orelse { return null; };
            h = hash_mix_u64(h, if inst.flag0 { 1_u64 } else { 0_u64 });
            h = hash_mix_u64(h, if pl.base.kind == .Slot { 1_u64 } else { 2_u64 });
            h = hash_mix_u64(h, pl.base.id.widen.[u64]());
            let ps = eir_prog.projs_slice(pl.projs);
            var i: usize = 0_usize;
            while i < ps.len {
                h = hash_mix_u64(h, proj_kind_u8(ps[i].kind).widen.[u64]());
                h = hash_mix_u64(h, ps[i].index.widen.[u64]());
                i = i +% 1_usize;
            }
            return h;
        }
        .BuiltinCall => {
            let bc = eir_prog.get_builtin_call(inst.aux0) orelse { return null; };
            let ok = is_pure_stateless_builtin(bc.op.kind)
                || (bc.op.kind == .ArenaPoolIdAt && !fn_has_pool_reset);
            if !ok {
                return null;
            }
            h = hash_mix_u64(h, bc.op.ty0.widen.[u64]());
            h = hash_mix_u64(h, bc.op.ty1.widen.[u64]());
            h = hash_mix_u64(h, bc.ret_ty.widen.[u64]());
            let args = eir_prog.vals_slice(bc.args);
            var i: usize = 0_usize;
            while i < args.len {
                let av = if bc.op.kind == .ArenaPoolIdAt && i == 0_usize {
                    resolve_val_chain(args[i], canon)
                } else {
                    args[i]
                };
                h = hash_mix_u64(h, av.widen.[u64]());
                i = i +% 1_usize;
            }
            return h;
        }
        _ => { return null; }
    }
}

fn gvn_inst_eq(
    eir_prog: *eir.EirProgram,
    a: *eir.EirInst,
    b: *eir.EirInst,
    canon: *[eir.EirValue],
) -> bool {
    if a.kind != b.kind || a.ty0 != b.ty0 {
        return false;
    }
    match a.kind {
        .Const => { return const_eq_eir(eir_prog, a.aux0, b.aux0); }
        .SlotAddr => { return a.aux0 == b.aux0 && a.flag0 == b.flag0; }
        .Unary => { return a.unary_op == b.unary_op && a.v0 == b.v0; }
        .Binary => {
            if a.bin_op != b.bin_op || a.ty1 != b.ty1 {
                return false;
            }
            if a.v0 == b.v0 && a.v1 == b.v1 {
                return true;
            }
            if is_commutative_binop(a.bin_op) && a.v0 == b.v1 && a.v1 == b.v0 {
                return true;
            }
            return false;
        }
        .Cast => { return a.cast_kind == b.cast_kind && a.ty1 == b.ty1 && a.v0 == b.v0; }
        .FieldExtract => { return a.ty1 == b.ty1 && a.aux0 == b.aux0 && a.v0 == b.v0; }
        .IsNonNull => { return a.ty1 == b.ty1 && a.v0 == b.v0; }
        .IsError => { return a.ty1 == b.ty1 && a.v0 == b.v0; }
        .MatchTag => { return a.ty1 == b.ty1 && a.v0 == b.v0; }
        .UnwrapOptional => { return a.ty1 == b.ty1 && a.v0 == b.v0; }
        .UnwrapErrorOk => { return a.ty1 == b.ty1 && a.v0 == b.v0; }
        .PlaceAddr => { return a.flag0 == b.flag0 && place_eq_eir(eir_prog, a.aux0, b.aux0); }
        .BuiltinCall => { return builtin_call_eq_eir(eir_prog, a.aux0, b.aux0, canon); }
        _ => { return false; }
    }
}

fn gvn_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
) -> u64 ! OutOfMemory {
    var nvals: usize = 0_usize;
    var entry: eir.BlockId = 0_u32;
    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) {
            return 0_u64;
        }
        nvals = f.value_tys.len.widen.[usize]();
        entry = f.entry;
        rpo_r = f.rpo;
    } else {
        return 0_u64;
    }
    if nvals == 0_usize || rpo_r.len == 0_u32 {
        return 0_u64;
    }

    var canon = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer canon.destroy(alloc);
    try fill_u32(alloc, &mut canon, nvals, eir.EIR_NONE);
    var fn_has_pool_reset = false;
    var rpre: u32 = 0_u32;
    while rpre < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% rpre).widen.[usize]()) {
            bb = bp.*;
        }
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if (inst.kind == .Copy || (inst.kind == .Cast && inst.cast_kind == .MutToConst))
                && inst.dst != eir.EIR_NONE && inst.v0 != eir.EIR_NONE
            {
                u32_set(&mut canon, inst.dst.widen.[usize](), inst.v0);
            } else if inst.kind == .BuiltinCall {
                if let bc = eir_prog.get_builtin_call(inst.aux0) {
                    if bc.op.kind == .ArenaPoolReset {
                        fn_has_pool_reset = true;
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        rpre = rpre +% 1_u32;
    }

    let dtree = try DomTree.build(alloc, eir_prog, fn_id);
    errdefer dtree.destroy(alloc);
    var buckets = try col.HashMap.[u32].init(alloc, 64_usize);
    errdefer buckets.destroy(alloc);
    var nodes = try col.DynBuf.[GvnNode].init(alloc, 64_usize);
    errdefer nodes.destroy(alloc);
    var undo = try col.DynBuf.[GvnUndo].init(alloc, 64_usize);
    errdefer undo.destroy(alloc);
    var dfs = try col.DynBuf.[GvnFrame].init(alloc, 32_usize);
    errdefer dfs.destroy(alloc);
    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);

    var eliminated: u64 = 0_u64;
    try dfs.push(alloc, GvnFrame.{
        bb: entry,
        child_cur: u32_at(&dtree.child_head, entry.widen.[usize]()),
        entered: false,
        undo_mark: 0_usize,
    });

    while !dfs.is_empty() {
        let top_i = dfs.len() -% 1_usize;
        var fr = GvnFrame.{ bb: 0_u32, child_cur: eir.EIR_NONE, entered: false, undo_mark: 0_usize };
        if let fp = dfs.get(top_i) {
            fr = fp.*;
        }
        if !fr.entered {
            let umark = undo.len();
            if let fm = dfs.get_mut(top_i) {
                fm.entered = true;
                fm.undo_mark = umark;
            }
            let bb = fr.bb;
            var insts_r = ast.range_empty();
            if let blk = eir_prog.fn_block(fn_id, bb) {
                insts_r = blk.insts;
            }
            new_insts.clear();
            new_flags.clear();
            var bchanged = false;

            var ii: u32 = 0_u32;
            while ii < insts_r.len {
                let gid = insts_r.start +% ii;
                var inst = eir.inst_zero(span.span_dummy(), .ParForHint);
                if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                    inst = ip.*;
                }
                let fl = eir_prog.inst_proven_flags(gid);
                var replaced = false;

                if let h = gvn_hash_inst(eir_prog, &inst, canon.as_slice(), fn_has_pool_reset) {
                    var existing = eir.EIR_NONE;
                    var cur_n = buckets.get(h) orelse eir.EIR_NONE;
                    while cur_n != eir.EIR_NONE {
                        if let np = nodes.get(cur_n.widen.[usize]()) {
                            let nd = np.*;
                            if nd.hash == h && gvn_inst_eq(eir_prog, &nd.inst, &inst, canon.as_slice()) {
                                existing = nd.val;
                                break;
                            }
                            cur_n = nd.prev_in_bucket;
                        } else {
                            break;
                        }
                    }
                    if existing != eir.EIR_NONE && eir_prog.fn_val_ty(fn_id, existing) == eir_prog.fn_val_ty(fn_id, inst.dst) {
                        var cpy = eir.inst_zero(inst.span, .Copy);
                        cpy.dst = inst.dst;
                        cpy.v0 = existing;
                        try new_insts.push(alloc, cpy);
                        try new_flags.push(alloc, 0_u8);
                        replaced = true;
                        bchanged = true;
                        eliminated = eliminated +% 1_u64;
                    } else {
                        let prev_h = buckets.get(h) orelse eir.EIR_NONE;
                        let nid = nodes.len().trunc.[u32]();
                        try nodes.push(alloc, GvnNode.{
                            hash: h,
                            inst: copy inst,
                            val: inst.dst,
                            prev_in_bucket: prev_h,
                        });
                        try buckets.insert(alloc, h, nid);
                        try undo.push(alloc, GvnUndo.{ hash: h, prev_head: prev_h });
                    }
                }

                if !replaced {
                    try new_insts.push(alloc, inst);
                    try new_flags.push(alloc, fl);
                }
                ii = ii +% 1_u32;
            }

            if bchanged {
                try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
            }
        } else if fr.child_cur != eir.EIR_NONE {
            let child = fr.child_cur;
            let next_c = u32_at(&dtree.child_next, child.widen.[usize]());
            if let fm = dfs.get_mut(top_i) {
                fm.child_cur = next_c;
            }
            try dfs.push(alloc, GvnFrame.{
                bb: child,
                child_cur: u32_at(&dtree.child_head, child.widen.[usize]()),
                entered: false,
                undo_mark: 0_usize,
            });
        } else {
            while undo.len() > fr.undo_mark {
                let u = undo.pop() orelse { break; };
                if u.prev_head == eir.EIR_NONE {
                    _ = buckets.remove(u.hash);
                } else {
                    try buckets.insert(alloc, u.hash, u.prev_head);
                }
            }
            _ = dfs.pop();
        }
    }

    if eliminated > 0_u64 {
        _ = try eliminate_copies_fn(alloc, eir_prog, fn_id);
    }

    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    dfs.destroy(alloc);
    undo.destroy(alloc);
    nodes.destroy(alloc);
    buckets.destroy(alloc);
    dtree.destroy(alloc);
    canon.destroy(alloc);
    return eliminated;
}

fn pass_gvn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    stats: *mut OptStats,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) {
            let c = try gvn_fn(alloc, eir_prog, fi);
            stats.gvn_eliminated = stats.gvn_eliminated +% c;
        }
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Section 9: Pass 7 — Natural Loop Detection + `block_loop_depth` + LICM
// ===========================================================================

struct NatLoopRange {
    header: eir.BlockId;
    start: u32;
    len: u32;
}

fn sort_loops_by_len(loops: *mut [NatLoopRange]) {
    var i: usize = 1_usize;
    while i < loops.len {
        let key = loops[i];
        var j = i;
        while j > 0_usize {
            let prev = j -% 1_usize;
            if loops[prev].len <= key.len {
                break;
            }
            loops[j] = loops[prev];
            j = prev;
        }
        loops[j] = key;
        i = i +% 1_usize;
    }
}

fn licm_inst_is_hoistable(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
    inst: *eir.EirInst,
    fl: u8,
    bb: eir.BlockId,
    hdr: eir.BlockId,
    nslots: usize,
    addr_taken: *col.BitSet,
    loop_written_slots: *col.BitSet,
    loop_writes_any_mem: bool,
    loop_has_call_or_asm: bool,
    loop_has_pool_mut: bool,
    loop_written_cols: *col.BitSet,
    loop_writes_high_col: bool,
) -> bool {
    if eir.inst_def(inst) == eir.EIR_NONE {
        return false;
    }
    match inst.kind {
        .Const => {
            // Never hoist small integer/bool/char/enum/null constants into loop preheaders:
            // x86-64 folds them directly as zero-cost immediates, whereas hoisting burns GPRs!
            if let kc = eir_prog.get_const(inst.aux0) {
                match kc.kind {
                    .Float => { return true; }
                    .Str => { return true; }
                    .Bytes => { return true; }
                    .Int => {
                        return kc.int_val.hi != 0_i64 || kc.int_val.lo > 0x7FFFFFFF_u64;
                    }
                    _ => { return false; }
                }
            }
            return false;
        }
        .SlotAddr => { return false; }
        .Copy => { return false; }
        .Cast => { return true; }
        .Aggregate => { return true; }
        .FieldExtract => { return true; }
        .MakeDyn => { return true; }
        .MakeClosure => { return true; }
        .IsNonNull => { return true; }
        .IsError => { return true; }
        .MatchTag => { return true; }
        .Unary => {
            if inst.unary_op == .Not || inst.unary_op == .BitNot {
                return true;
            }
            if inst.unary_op == .Neg {
                return env.is_float(inst.ty0) || (fl & eir.PROVEN_NO_OVERFLOW) != 0_u8;
            }
            return false;
        }
        .Binary => {
            if env.is_float(inst.ty1) {
                return true;
            }
            match inst.bin_op {
                .Div => { return bb == hdr && (fl & eir.PROVEN_NONZERO_DIV) != 0_u8 && (!env.is_signed_int(inst.ty1) || (fl & eir.PROVEN_NO_OVERFLOW) != 0_u8); }
                .Mod => { return bb == hdr && (fl & eir.PROVEN_NONZERO_DIV) != 0_u8 && (!env.is_signed_int(inst.ty1) || (fl & eir.PROVEN_NO_OVERFLOW) != 0_u8); }
                .Shl => { return bb == hdr || (fl & eir.PROVEN_NO_OVERFLOW) != 0_u8; }
                .Shr => { return bb == hdr || (fl & eir.PROVEN_NO_OVERFLOW) != 0_u8; }
                _ => { return true; }
            }
        }
        .PlaceAddr => {
            if let pl = eir_prog.get_place(inst.aux0) {
                let ps = eir_prog.projs_slice(pl.projs);
                var has_deref = false;
                if pl.base.kind == .Slot && ps.len > 0_usize && slot_is_ptr_like(eir_prog, env, fn_id, pl.base.id) {
                    has_deref = true;
                }
                var i: usize = 0_usize;
                while i < ps.len {
                    if ps[i].kind == .Index {
                        return false;
                    }
                    if ps[i].kind == .Deref || ps[i].kind == .PoolCol {
                        has_deref = true;
                    }
                    if i + 1_usize < ps.len {
                        let ptn = env.get(ps[i].ty);
                        if ptn.kind == .Borrow || ptn.kind == .RawPtr {
                            has_deref = true;
                        }
                    }
                    i = i +% 1_usize;
                }
                if has_deref {
                    if bb != hdr || loop_writes_any_mem || loop_has_call_or_asm {
                        return false;
                    }
                    if pl.base.kind == .Slot {
                        let su = pl.base.id.widen.[usize]();
                        if su >= nslots || loop_written_slots.test(su) {
                            return false;
                        }
                    }
                }
                return true;
            }
            return false;
        }
        .LoadSlot => {
            let su = inst.aux0.widen.[usize]();
            if su >= nslots || loop_written_slots.test(su) {
                return false;
            }
            if addr_taken.test(su) && (loop_writes_any_mem || loop_has_call_or_asm) {
                return false;
            }
            return true;
        }
        .LoadPlace => {
            if loop_writes_any_mem || loop_has_call_or_asm {
                return false;
            }
            if let pl = eir_prog.get_place(inst.aux0) {
                var has_deref = false;
                if pl.base.kind == .Slot {
                    let su = pl.base.id.widen.[usize]();
                    if su >= nslots || loop_written_slots.test(su) {
                        return false;
                    }
                    if slot_is_ptr_like(eir_prog, env, fn_id, pl.base.id) {
                        has_deref = true;
                    }
                }
                let ps = eir_prog.projs_slice(pl.projs);
                var i: usize = 0_usize;
                while i < ps.len {
                    if ps[i].kind == .Index {
                        return false;
                    }
                    if ps[i].kind == .Deref || ps[i].kind == .PoolCol {
                        has_deref = true;
                    }
                    i = i +% 1_usize;
                }
                if has_deref {
                    return bb == hdr;
                }
                return bb == hdr || pl.base.kind == .Slot;
            }
            return false;
        }
        .PoolColumnLoad => {
            if bb != hdr || loop_has_call_or_asm || loop_has_pool_mut || loop_writes_high_col {
                return false;
            }
            if (fl & eir.PROVEN_BOUNDS_SAFE) == 0_u8 {
                return false;
            }
            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                if op.pool_base.kind == .Slot {
                    let su = op.pool_base.id.widen.[usize]();
                    if su >= nslots || loop_written_slots.test(su) {
                        return false;
                    }
                }
                let ci = op.col_idx.widen.[usize]();
                return ci < 64_usize && !loop_written_cols.test(ci);
            }
            return false;
        }
        .BuiltinCall => {
            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                if is_pure_stateless_builtin(bc.op.kind) {
                    return true;
                }
                let is_pool_len = bc.op.kind == .ArenaPoolLen;
                let is_mem_len = bc.op.kind == .BufLen || bc.op.kind == .BufCap || bc.op.kind == .BufAsSlice
                    || bc.op.kind == .SlotPoolLen || bc.op.kind == .SlotPoolCap;
                if is_pool_len || is_mem_len {
                    if loop_has_call_or_asm {
                        return false;
                    }
                    if is_pool_len && loop_has_pool_mut {
                        return false;
                    }
                    if is_mem_len && loop_writes_any_mem {
                        return false;
                    }
                    let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                    var ksi: usize = 0_usize;
                    while ksi < ss.len {
                        let sid = ss[ksi];
                        if sid != eir.EIR_NONE {
                            let su = sid.widen.[usize]();
                            if su >= nslots || loop_written_slots.test(su) {
                                return false;
                            }
                            if is_mem_len && addr_taken.test(su) && loop_writes_any_mem {
                                return false;
                            }
                        }
                        ksi = ksi +% 1_usize;
                    }
                    return bb == hdr;
                }
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

/// Inserts a dedicated preheader block before loop header `hdr` for `out_preds`.
fn insert_loop_preheader(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    hdr: eir.BlockId,
    out_preds: *[eir.BlockId],
    in_body: *col.BitSet,
) -> eir.BlockId ! OutOfMemory {
    var orig_nblks: u32 = 0_u32;
    var orig_blks_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        orig_nblks = f.blocks.len;
        orig_blks_r = f.blocks;
    }
    let pre_bb: eir.BlockId = orig_nblks;

    // Redirect all outside predecessors' terminators: hdr -> pre_bb.
    var oi: usize = 0_usize;
    while oi < out_preds.len {
        let p = out_preds[oi];
        if let pbm = eir_prog.fn_block_mut(fn_id, p) {
            var t = pbm.term;
            _ = rewrite_term_target(eir_prog, &mut t, hdr, pre_bb);
            pbm.term = t;
        }
        oi = oi +% 1_usize;
    }

    // Split `hdr`'s Phis into outside incoming (`pre_bb`) vs inside incoming (`hdr`).
    var pre_phis = try col.DynBuf.[eir.EirPhi].init(alloc, 4_usize);
    errdefer pre_phis.destroy(alloc);
    var out_inc = try col.DynBuf.[eir.EirPhiIn].init(alloc, 4_usize);
    errdefer out_inc.destroy(alloc);
    var in_inc = try col.DynBuf.[eir.EirPhiIn].init(alloc, 4_usize);
    errdefer in_inc.destroy(alloc);

    var hdr_phis_r = ast.range_empty();
    if let hb = eir_prog.fn_block(fn_id, hdr) {
        hdr_phis_r = hb.phis;
    }
    var pi: u32 = 0_u32;
    while pi < hdr_phis_r.len {
        let phi_gid = (hdr_phis_r.start +% pi).widen.[usize]();
        var phi = eir.EirPhi.{ dst: eir.EIR_NONE, ty: types.TY_VOID, incoming: ast.range_empty() };
        if let pp = eir_prog.funcs.phis.get(phi_gid) {
            phi = pp.*;
        }
        out_inc.clear();
        in_inc.clear();
        var ki: u32 = 0_u32;
        while ki < phi.incoming.len {
            if let ip = eir_prog.funcs.phi_in.get((phi.incoming.start +% ki).widen.[usize]()) {
                let ent = ip.*;
                if in_body.test(ent.pred_bb.widen.[usize]()) {
                    try in_inc.push(alloc, ent);
                } else {
                    try out_inc.push(alloc, ent);
                }
            }
            ki = ki +% 1_u32;
        }
        let oslice = out_inc.as_slice();
        if oslice.len == 1_usize {
            try in_inc.push(alloc, eir.EirPhiIn.{ pred_bb: pre_bb, val: oslice[0_usize].val });
        } else if oslice.len >= 2_usize {
            let pre_v = try eir_prog.alloc_fn_value(alloc, fn_id, phi.ty);
            let pre_ir = try eir_prog.append_phi_incoming(alloc, oslice);
            try pre_phis.push(alloc, eir.EirPhi.{ dst: pre_v, ty: phi.ty, incoming: pre_ir });
            try in_inc.push(alloc, eir.EirPhiIn.{ pred_bb: pre_bb, val: pre_v });
        }
        let new_hdr_ir = try eir_prog.append_phi_incoming(alloc, in_inc.as_slice());
        if let ppm = eir_prog.funcs.phis.get_mut(phi_gid) {
            ppm.incoming = new_hdr_ir;
        }
        pi = pi +% 1_u32;
    }

    let pre_phis_r = try eir_prog.append_phis(alloc, pre_phis.as_slice());

    var all_blks = try col.DynBuf.[eir.EirBlock].init(alloc, orig_nblks.widen.[usize]() +% 1_usize);
    errdefer all_blks.destroy(alloc);
    var bi: u32 = 0_u32;
    while bi < orig_nblks {
        if let bp = eir_prog.funcs.blocks.get((orig_blks_r.start +% bi).widen.[usize]()) {
            try all_blks.push(alloc, bp.*);
        }
        bi = bi +% 1_u32;
    }
    try all_blks.push(alloc, eir.EirBlock.{
        id: pre_bb,
        phis: pre_phis_r,
        insts: ast.range_empty(),
        term: eir.term_goto(hdr),
        preds: ast.range_empty(),
        idom: eir.EIR_NONE,
    });
    let new_br = try eir_prog.append_blocks(alloc, all_blks.as_slice());
    if let fm = eir_prog.get_fn_mut(fn_id) {
        fm.blocks = new_br;
    }
    try eir_prog.rebuild_fn_rpo(alloc, fn_id);

    all_blks.destroy(alloc);
    in_inc.destroy(alloc);
    out_inc.destroy(alloc);
    pre_phis.destroy(alloc);
    return pre_bb;
}

fn licm_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> u64 ! OutOfMemory {
    try compute_and_set_loop_depths(alloc, eir_prog, fn_id);

    var nblks0: usize = 0_usize;
    var nslots: usize = 0_usize;
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) {
            return 0_u64;
        }
        nblks0 = f.blocks.len.widen.[usize]();
        nslots = f.slots.len.widen.[usize]();
    } else {
        return 0_u64;
    }
    if nblks0 == 0_usize {
        return 0_u64;
    }

    // 1. Collect all natural loops sorted innermost-first.
    var is_hdr = try col.BitSet.init(alloc, nblks0);
    errdefer is_hdr.destroy(alloc);
    var loops = try col.DynBuf.[NatLoopRange].init(alloc, 8_usize);
    errdefer loops.destroy(alloc);
    var loop_blks_flat = try col.DynBuf.[eir.BlockId].init(alloc, 32_usize);
    errdefer loop_blks_flat.destroy(alloc);
    var work = try col.DynBuf.[eir.BlockId].init(alloc, 16_usize);
    errdefer work.destroy(alloc);
    var body_bs = try col.BitSet.init(alloc, nblks0);
    errdefer body_bs.destroy(alloc);

    let rpo0 = eir_prog.fn_rpo(fn_id);
    var ri0: usize = 0_usize;
    while ri0 < rpo0.len {
        let u = rpo0[ri0];
        if let ub = eir_prog.fn_block(fn_id, u) {
            let term = ub.term;
            let sc = eir_prog.term_successor_count(&term);
            var si: usize = 0_usize;
            while si < sc {
                let h = eir_prog.term_successor_at(&term, si);
                let hu = h.widen.[usize]();
                if h != eir.EIR_NONE && hu < nblks0 && eir_prog.dominates_block(fn_id, h, u) && !is_hdr.test(hu) {
                    is_hdr.set(hu);
                    body_bs.clear();
                    work.clear();
                    body_bs.set(hu);
                    let hpreds = eir_prog.block_preds(fn_id, h);
                    var pri: usize = 0_usize;
                    while pri < hpreds.len {
                        let p = hpreds[pri];
                        let pu = p.widen.[usize]();
                        if pu < nblks0 && eir_prog.dominates_block(fn_id, h, p) && !body_bs.test(pu) {
                            body_bs.set(pu);
                            try work.push(alloc, p);
                        }
                        pri = pri +% 1_usize;
                    }
                    while !work.is_empty() {
                        let cur = work.pop() orelse { break; };
                        let cpreds = eir_prog.block_preds(fn_id, cur);
                        var pi: usize = 0_usize;
                        while pi < cpreds.len {
                            let p = cpreds[pi];
                            let pu = p.widen.[usize]();
                            if pu < nblks0 && !body_bs.test(pu) {
                                body_bs.set(pu);
                                try work.push(alloc, p);
                            }
                            pi = pi +% 1_usize;
                        }
                    }
                    let bstart = loop_blks_flat.len().trunc.[u32]();
                    // Push loop body blocks in RPO order so hoisted instructions preserve dependency order.
                    var rk: usize = 0_usize;
                    while rk < rpo0.len {
                        if body_bs.test(rpo0[rk].widen.[usize]()) {
                            try loop_blks_flat.push(alloc, rpo0[rk]);
                        }
                        rk = rk +% 1_usize;
                    }
                    let blen = loop_blks_flat.len().trunc.[u32]() -% bstart;
                    try loops.push(alloc, NatLoopRange.{ header: h, start: bstart, len: blen });
                }
                si = si +% 1_usize;
            }
        }
        ri0 = ri0 +% 1_usize;
    }

    if loops.is_empty() {
        body_bs.destroy(alloc);
        work.destroy(alloc);
        loop_blks_flat.destroy(alloc);
        loops.destroy(alloc);
        is_hdr.destroy(alloc);
        return 0_u64;
    }

    sort_loops_by_len(loops.as_mut_slice());

    // Precompute address-taken slots across the whole function.
    var addr_taken = try col.BitSet.init(alloc, max_usize(nslots, 1_usize));
    errdefer addr_taken.destroy(alloc);
    var ra: usize = 0_usize;
    while ra < rpo0.len {
        let insts = eir_prog.block_insts(fn_id, rpo0[ra]);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .SlotAddr && inst.aux0.widen.[usize]() < nslots {
                addr_taken.set(inst.aux0.widen.[usize]());
            } else if inst.kind == .PlaceAddr {
                if let pl = eir_prog.get_place(inst.aux0) {
                    if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                        addr_taken.set(pl.base.id.widen.[usize]());
                    }
                }
            } else if inst.kind == .BuiltinCall {
                if let bc = eir_prog.get_builtin_call(inst.aux0) {
                    let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                    var ki: usize = 0_usize;
                    while ki < ss.len {
                        if ss[ki] != eir.EIR_NONE && ss[ki].widen.[usize]() < nslots {
                            addr_taken.set(ss[ki].widen.[usize]());
                        }
                        ki = ki +% 1_usize;
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        ra = ra +% 1_usize;
    }

    var hoisted_total: u64 = 0_u64;
    var added_preheader = false;
    var out_preds = try col.DynBuf.[eir.BlockId].init(alloc, 4_usize);
    errdefer out_preds.destroy(alloc);
    var uses = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
    errdefer uses.destroy(alloc);
    var hoisted_insts = try col.DynBuf.[eir.EirInst].init(alloc, 16_usize);
    errdefer hoisted_insts.destroy(alloc);
    var hoisted_flags = try col.DynBuf.[u8].init(alloc, 16_usize);
    errdefer hoisted_flags.destroy(alloc);
    var keep_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer keep_insts.destroy(alloc);
    var keep_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer keep_flags.destroy(alloc);

    let lcount = loops.len();
    var li: usize = 0_usize;
    while li < lcount {
        var lp = NatLoopRange.{ header: 0_u32, start: 0_u32, len: 0_u32 };
        if let lpp = loops.get(li) {
            lp = lpp.*;
        }
        var cur_nblks: usize = 0_usize;
        var cur_nvals: usize = 0_usize;
        if let f = eir_prog.get_fn(fn_id) {
            cur_nblks = f.blocks.len.widen.[usize]();
            cur_nvals = f.value_tys.len.widen.[usize]();
        }
        var in_body = try col.BitSet.init(alloc, max_usize(cur_nblks, 1_usize));
        errdefer in_body.destroy(alloc);
        var cur_body_blks = try col.DynBuf.[eir.BlockId].init(alloc, max_usize(lp.len.widen.[usize](), 4_usize));
        errdefer cur_body_blks.destroy(alloc);
        if !added_preheader {
            var bi: u32 = 0_u32;
            while bi < lp.len {
                let b = u32_at(&loop_blks_flat, (lp.start +% bi).widen.[usize]());
                if b.widen.[usize]() < cur_nblks {
                    in_body.set(b.widen.[usize]());
                    try cur_body_blks.push(alloc, b);
                }
                bi = bi +% 1_u32;
            }
        } else {
            // Recompute loop body dynamically on current CFG so newly inserted inner preheaders are included!
            work.clear();
            let hu = lp.header.widen.[usize]();
            if hu < cur_nblks {
                in_body.set(hu);
                let hpreds_cur = eir_prog.block_preds(fn_id, lp.header);
                var pri0: usize = 0_usize;
                while pri0 < hpreds_cur.len {
                    let p = hpreds_cur[pri0];
                    let pu = p.widen.[usize]();
                    if pu < cur_nblks && eir_prog.dominates_block(fn_id, lp.header, p) && !in_body.test(pu) {
                        in_body.set(pu);
                        try work.push(alloc, p);
                    }
                    pri0 = pri0 +% 1_usize;
                }
                while !work.is_empty() {
                    let cur = work.pop() orelse { break; };
                    let cpreds = eir_prog.block_preds(fn_id, cur);
                    var pi0: usize = 0_usize;
                    while pi0 < cpreds.len {
                        let p = cpreds[pi0];
                        let pu = p.widen.[usize]();
                        if pu < cur_nblks && !in_body.test(pu) {
                            in_body.set(pu);
                            try work.push(alloc, p);
                        }
                        pi0 = pi0 +% 1_usize;
                    }
                }
                let rpo_cur = eir_prog.fn_rpo(fn_id);
                var rk0: usize = 0_usize;
                while rk0 < rpo_cur.len {
                    let rb = rpo_cur[rk0];
                    if rb.widen.[usize]() < cur_nblks && in_body.test(rb.widen.[usize]()) {
                        try cur_body_blks.push(alloc, rb);
                    }
                    rk0 = rk0 +% 1_usize;
                }
            }
        }
        let cur_body_len = cur_body_blks.len();

        // Collect outside predecessors of header.
        out_preds.clear();
        let hpreds = eir_prog.block_preds(fn_id, lp.header);
        var pri: usize = 0_usize;
        while pri < hpreds.len {
            let p = hpreds[pri];
            if p.widen.[usize]() < cur_nblks && !in_body.test(p.widen.[usize]()) {
                try out_preds.push(alloc, p);
            }
            pri = pri +% 1_usize;
        }

        if !out_preds.is_empty() && cur_nvals > 0_usize {
            var def_in_loop = try col.BitSet.init(alloc, cur_nvals);
            errdefer def_in_loop.destroy(alloc);
            var loop_written_slots = try col.BitSet.init(alloc, max_usize(nslots, 1_usize));
            errdefer loop_written_slots.destroy(alloc);
            var loop_written_cols = try col.BitSet.init(alloc, 64_usize);
            errdefer loop_written_cols.destroy(alloc);
            var loop_has_call_or_asm = false;
            var loop_writes_any_mem = false;
            var loop_has_pool_mut = false;
            var loop_writes_high_col = false;

            // Scan loop body for defs and side effects.
            var bi1: usize = 0_usize;
            while bi1 < cur_body_len {
                let bb = u32_at(&cur_body_blks, bi1);
                let phis = eir_prog.block_phis(fn_id, bb);
                var ppi: usize = 0_usize;
                while ppi < phis.len {
                    let du = phis[ppi].dst.widen.[usize]();
                    if du < cur_nvals {
                        def_in_loop.set(du);
                    }
                    ppi = ppi +% 1_usize;
                }
                let insts = eir_prog.block_insts(fn_id, bb);
                var ii: usize = 0_usize;
                while ii < insts.len {
                    let inst = insts[ii];
                    let d = eir.inst_def(&inst);
                    if d != eir.EIR_NONE && d.widen.[usize]() < cur_nvals {
                        def_in_loop.set(d.widen.[usize]());
                    }
                    match inst.kind {
                        .StoreSlot => {
                            let su = inst.aux0.widen.[usize]();
                            if su < nslots {
                                loop_written_slots.set(su);
                                if addr_taken.test(su) {
                                    loop_writes_any_mem = true;
                                    loop_has_pool_mut = true;
                                }
                            }
                        }
                        .StorePlace => {
                            loop_writes_any_mem = true;
                            if let pl = eir_prog.get_place(inst.aux0) {
                                if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                                    loop_written_slots.set(pl.base.id.widen.[usize]());
                                    loop_has_pool_mut = true;
                                }
                            }
                        }
                        .PoolColumnStore => {
                            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                                let ci = op.col_idx.widen.[usize]();
                                if ci < 64_usize {
                                    loop_written_cols.set(ci);
                                } else {
                                    loop_writes_high_col = true;
                                }
                                _ = 0_u8;
                            }
                            _ = 0_u8;
                        }
                        .Call => {
                            loop_has_call_or_asm = true;
                            loop_writes_any_mem = true;
                            loop_has_pool_mut = true;
                        }
                        .InlineAsm => {
                            loop_has_call_or_asm = true;
                            loop_writes_any_mem = true;
                            loop_has_pool_mut = true;
                        }
                        .BuiltinCall => {
                            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                                if is_pool_mutating_builtin(bc.op.kind) {
                                    loop_has_pool_mut = true;
                                    loop_writes_any_mem = true;
                                } else if !is_readonly_nontrapping_builtin(bc.op.kind) {
                                    loop_has_call_or_asm = true;
                                    loop_writes_any_mem = true;
                                }
                                if !is_readonly_nontrapping_builtin(bc.op.kind) {
                                    let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                                    var ksi: usize = 0_usize;
                                    while ksi < ss.len {
                                        if ss[ksi] != eir.EIR_NONE && ss[ksi].widen.[usize]() < nslots {
                                            loop_written_slots.set(ss[ksi].widen.[usize]());
                                        }
                                        ksi = ksi +% 1_usize;
                                    }
                                }
                            }
                            _ = 0_u8;
                        }
                        _ => {}
                    }
                    ii = ii +% 1_usize;
                }
                bi1 = bi1 +% 1_usize;
            }

            // Fixpoint discovery of hoistable SSA values (up to 4 sweeps).
            var hoist_vals = try col.BitSet.init(alloc, cur_nvals);
            errdefer hoist_vals.destroy(alloc);
            var sweep: usize = 0_usize;
            while sweep < 4_usize {
                var found_new = false;
                var bi2: usize = 0_usize;
                while bi2 < cur_body_len {
                    let bb = u32_at(&cur_body_blks, bi2);
                    var insts_r = ast.range_empty();
                    if let blk = eir_prog.fn_block(fn_id, bb) {
                        insts_r = blk.insts;
                    }
                    var ii: u32 = 0_u32;
                    while ii < insts_r.len {
                        let gid = insts_r.start +% ii;
                        if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                            let inst = ip.*;
                            let d = eir.inst_def(&inst);
                            if d != eir.EIR_NONE && d.widen.[usize]() < cur_nvals && !hoist_vals.test(d.widen.[usize]()) {
                                let fl = eir_prog.inst_proven_flags(gid);
                                if licm_inst_is_hoistable(
                                    eir_prog, fn_id, env, &inst, fl, bb, lp.header, nslots,
                                    &addr_taken, &loop_written_slots, loop_writes_any_mem,
                                    loop_has_call_or_asm, loop_has_pool_mut,
                                    &loop_written_cols, loop_writes_high_col,
                                ) {
                                    try eir.collect_inst_uses(alloc, eir_prog, &inst, &mut uses);
                                    let usl = uses.as_slice();
                                    var all_inv = true;
                                    var ui: usize = 0_usize;
                                    while ui < usl.len {
                                        let vu = usl[ui].widen.[usize]();
                                        if vu < cur_nvals && def_in_loop.test(vu) {
                                            all_inv = false;
                                            break;
                                        }
                                        ui = ui +% 1_usize;
                                    }
                                    if all_inv {
                                        hoist_vals.set(d.widen.[usize]());
                                        def_in_loop.unset(d.widen.[usize]());
                                        found_new = true;
                                    }
                                }
                            }
                        }
                        ii = ii +% 1_u32;
                    }
                    bi2 = bi2 +% 1_usize;
                }
                if !found_new {
                    break;
                }
                sweep = sweep +% 1_usize;
            }

            if hoist_vals.count_ones() > 0_usize {
                // Find existing single-succ preheader or lazily insert one!
                var pre_bb = eir.EIR_NONE;
                if out_preds.len() == 1_usize {
                    let cand_p = u32_at(&out_preds, 0_usize);
                    if let pb = eir_prog.fn_block(fn_id, cand_p) {
                        if pb.term.kind == .Goto && pb.term.bb0 == lp.header {
                            pre_bb = cand_p;
                        }
                    }
                }
                if pre_bb == eir.EIR_NONE {
                    pre_bb = try insert_loop_preheader(alloc, eir_prog, fn_id, lp.header, out_preds.as_slice(), &in_body);
                    added_preheader = true;
                }

                // Collect hoisted instructions in RPO order and strip them from loop blocks.
                hoisted_insts.clear();
                hoisted_flags.clear();
                var bi3: usize = 0_usize;
                while bi3 < cur_body_len {
                    let bb = u32_at(&cur_body_blks, bi3);
                    var insts_r = ast.range_empty();
                    if let blk = eir_prog.fn_block(fn_id, bb) {
                        insts_r = blk.insts;
                    }
                    keep_insts.clear();
                    keep_flags.clear();
                    var bch = false;
                    var ii: u32 = 0_u32;
                    while ii < insts_r.len {
                        let gid = insts_r.start +% ii;
                        if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                            let inst = ip.*;
                            let fl = eir_prog.inst_proven_flags(gid);
                            let d = eir.inst_def(&inst);
                            if d != eir.EIR_NONE && d.widen.[usize]() < cur_nvals && hoist_vals.test(d.widen.[usize]()) {
                                try hoisted_insts.push(alloc, inst);
                                try hoisted_flags.push(alloc, fl);
                                bch = true;
                                hoisted_total = hoisted_total +% 1_u64;
                            } else {
                                try keep_insts.push(alloc, inst);
                                try keep_flags.push(alloc, fl);
                            }
                        }
                        ii = ii +% 1_u32;
                    }
                    if bch {
                        try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, keep_insts.as_slice(), keep_flags.as_slice());
                    }
                    bi3 = bi3 +% 1_usize;
                }

                // Append hoisted instructions to the end of `pre_bb`.
                if !hoisted_insts.is_empty() {
                    keep_insts.clear();
                    keep_flags.clear();
                    var pinsts_r = ast.range_empty();
                    if let pb = eir_prog.fn_block(fn_id, pre_bb) {
                        pinsts_r = pb.insts;
                    }
                    var pii: u32 = 0_u32;
                    while pii < pinsts_r.len {
                        let gid = pinsts_r.start +% pii;
                        if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                            try keep_insts.push(alloc, ip.*);
                            try keep_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                        }
                        pii = pii +% 1_u32;
                    }
                    try keep_insts.push_slice(alloc, hoisted_insts.as_slice());
                    try keep_flags.push_slice(alloc, hoisted_flags.as_slice());
                    try eir_prog.replace_block_insts_reuse(alloc, fn_id, pre_bb, keep_insts.as_slice(), keep_flags.as_slice());
                }
            }

            hoist_vals.destroy(alloc);
            loop_written_cols.destroy(alloc);
            loop_written_slots.destroy(alloc);
            def_in_loop.destroy(alloc);
        }

        cur_body_blks.destroy(alloc);
        in_body.destroy(alloc);
        li = li +% 1_usize;
    }

    if added_preheader {
        try compute_and_set_loop_depths(alloc, eir_prog, fn_id);
    }

    keep_flags.destroy(alloc);
    keep_insts.destroy(alloc);
    hoisted_flags.destroy(alloc);
    hoisted_insts.destroy(alloc);
    uses.destroy(alloc);
    out_preds.destroy(alloc);
    addr_taken.destroy(alloc);
    body_bs.destroy(alloc);
    work.destroy(alloc);
    loop_blks_flat.destroy(alloc);
    loops.destroy(alloc);
    is_hdr.destroy(alloc);
    return hoisted_total;
}

fn pass_licm(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    stats: *mut OptStats,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) {
            let c = try licm_fn(alloc, eir_prog, fi, env);
            stats.licm_hoisted = stats.licm_hoisted +% c;
        }
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Section 10: Pass 8 — Tail-Call Elimination (TCE)
// ===========================================================================

struct TailCallSite {
    bb: eir.BlockId;
    call_ii: u32;
    args_r: ast.IdRange;
}

fn tce_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
) -> u64 ! OutOfMemory {
    var old_entry: eir.BlockId = 0_u32;
    var old_nblks: u32 = 0_u32;
    var nvals: usize = 0_usize;
    var rpo_r = ast.range_empty();
    var orig_blks_r = ast.range_empty();
    var params_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) || f.rpo.len == 0_u32 {
            return 0_u64;
        }
        old_entry = f.entry;
        old_nblks = f.blocks.len;
        nvals = f.value_tys.len.widen.[usize]();
        rpo_r = f.rpo;
        orig_blks_r = f.blocks;
        params_r = f.params;
    } else {
        return 0_u64;
    }
    if let eb = eir_prog.fn_block(fn_id, old_entry) {
        if eb.phis.len > 0_u32 {
            return 0_u64;
        }
    }

    // Soundness check: no escaping stack-slot addresses in `fn_id`, and discover self tail calls.
    var sites = try col.DynBuf.[TailCallSite].init(alloc, 4_usize);
    errdefer sites.destroy(alloc);
    var has_slot_addr = false;

    var r0: u32 = 0_u32;
    while r0 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r0).widen.[usize]()) {
            bb = bp.*;
        }
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .SlotAddr {
                has_slot_addr = true;
                break;
            } else if inst.kind == .PlaceAddr {
                if let pl = eir_prog.get_place(inst.aux0) {
                    if pl.base.kind == .Slot {
                        has_slot_addr = true;
                        break;
                    }
                }
            } else if inst.kind == .BuiltinCall {
                if let bc = eir_prog.get_builtin_call(inst.aux0) {
                    let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                    var ki: usize = 0_usize;
                    while ki < ss.len {
                        if ss[ki] != eir.EIR_NONE {
                            has_slot_addr = true;
                            break;
                        }
                        ki = ki +% 1_usize;
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        if has_slot_addr {
            break;
        }

        // Check if `bb` ends with a self-recursive tail call + Return.
        if let blk = eir_prog.fn_block(fn_id, bb) {
            if blk.term.kind == .Return && insts.len > 0_usize {
                var want_val = if blk.term.flag { blk.term.val } else { eir.EIR_NONE };
                var scan_i = insts.len;
                var found_call = false;
                var call_idx: usize = 0_usize;
                while scan_i > 0_usize {
                    scan_i = scan_i -% 1_usize;
                    let cur = insts[scan_i];
                    if cur.kind == .Copy && cur.dst == want_val && want_val != eir.EIR_NONE {
                        want_val = cur.v0;
                    } else if cur.kind == .Const && cur.dst == want_val && !blk.term.flag {
                        want_val = eir.EIR_NONE;
                    } else if cur.kind == .Call {
                        if let cd = eir_prog.get_call(cur.aux0) {
                            if let tfid = resolve_direct_callee_fn(eir_prog, cd.callee) {
                                if tfid == fn_id && cd.args.len == params_r.len {
                                    let ret_ok = (!blk.term.flag && cur.dst == eir.EIR_NONE)
                                        || (blk.term.flag && cur.dst == want_val && cur.dst != eir.EIR_NONE);
                                    if ret_ok {
                                        var tys_ok = true;
                                        let cargs = eir_prog.vals_slice(cd.args);
                                        let fps = eir_prog.fn_params(fn_id);
                                        var ai: usize = 0_usize;
                                        while ai < cargs.len && ai < fps.len {
                                            if eir_prog.fn_val_ty(fn_id, cargs[ai]) != eir_prog.fn_val_ty(fn_id, fps[ai]) {
                                                tys_ok = false;
                                                break;
                                            }
                                            ai = ai +% 1_usize;
                                        }
                                        if tys_ok {
                                            found_call = true;
                                            call_idx = scan_i;
                                            try sites.push(alloc, TailCallSite.{
                                                bb: bb,
                                                call_ii: call_idx.trunc.[u32](),
                                                args_r: cd.args,
                                            });
                                        }
                                    }
                                }
                            }
                        }
                        break;
                    } else {
                        break;
                    }
                }
                _ = found_call;
            }
        }
        r0 = r0 +% 1_u32;
    }

    if has_slot_addr || sites.is_empty() {
        sites.destroy(alloc);
        return 0_u64;
    }

    // Create new_entry -> old_entry preheader and param Phis on old_entry!
    let new_entry: eir.BlockId = old_nblks;
    var remap = try col.DynBuf.[eir.EirValue].init(alloc, max_usize(nvals, 1_usize));
    errdefer remap.destroy(alloc);
    try fill_u32(alloc, &mut remap, nvals, eir.EIR_NONE);

    let nparams = params_r.len.widen.[usize]();
    var old_params = try col.DynBuf.[eir.EirValue].init(alloc, max_usize(nparams, 1_usize));
    errdefer old_params.destroy(alloc);
    var phi_params = try col.DynBuf.[eir.EirValue].init(alloc, max_usize(nparams, 1_usize));
    errdefer phi_params.destroy(alloc);

    var pi: u32 = 0_u32;
    while pi < params_r.len {
        var opv = eir.EIR_NONE;
        if let pvp = eir_prog.funcs.param_vals.get((params_r.start +% pi).widen.[usize]()) {
            opv = pvp.*;
        }
        let pty = eir_prog.fn_val_ty(fn_id, opv);
        let ppv = try eir_prog.alloc_fn_value(alloc, fn_id, pty);
        try old_params.push(alloc, opv);
        try phi_params.push(alloc, ppv);
        if opv.widen.[usize]() < nvals {
            u32_set(&mut remap, opv.widen.[usize](), ppv);
        }
        pi = pi +% 1_u32;
    }

    // Remap all uses of old_params -> phi_params across all old blocks!
    apply_val_remap_fn(eir_prog, fn_id, remap.as_slice());

    // Build parameter Phis on `old_entry`.
    var entry_phis = try col.DynBuf.[eir.EirPhi].init(alloc, max_usize(nparams, 1_usize));
    errdefer entry_phis.destroy(alloc);
    var inc_buf = try col.DynBuf.[eir.EirPhiIn].init(alloc, sites.len() +% 1_usize);
    errdefer inc_buf.destroy(alloc);

    let ssl = sites.as_slice();
    var pi2: usize = 0_usize;
    while pi2 < nparams {
        let opv = u32_at(&old_params, pi2);
        let ppv = u32_at(&phi_params, pi2);
        let pty = eir_prog.fn_val_ty(fn_id, opv);
        inc_buf.clear();
        try inc_buf.push(alloc, eir.EirPhiIn.{ pred_bb: new_entry, val: opv });
        var si: usize = 0_usize;
        while si < ssl.len {
            var arg_v = eir.EIR_NONE;
            if let avp = eir_prog.exprs.vals.get((ssl[si].args_r.start +% pi2.trunc.[u32]()).widen.[usize]()) {
                arg_v = avp.*;
            }
            let r_arg = resolve_val_chain(arg_v, remap.as_slice());
            try inc_buf.push(alloc, eir.EirPhiIn.{ pred_bb: ssl[si].bb, val: r_arg });
            si = si +% 1_usize;
        }
        let ir = try eir_prog.append_phi_incoming(alloc, inc_buf.as_slice());
        try entry_phis.push(alloc, eir.EirPhi.{ dst: ppv, ty: pty, incoming: ir });
        pi2 = pi2 +% 1_usize;
    }
    let ephis_r = try eir_prog.append_phis(alloc, entry_phis.as_slice());

    // Trim each tail-call block and change its terminator to `Goto(old_entry)`.
    var keep_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer keep_insts.destroy(alloc);
    var keep_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer keep_flags.destroy(alloc);

    var si2: usize = 0_usize;
    while si2 < ssl.len {
        let site = ssl[si2];
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, site.bb) {
            insts_r = blk.insts;
        }
        keep_insts.clear();
        keep_flags.clear();
        var ki: u32 = 0_u32;
        while ki < site.call_ii && ki < insts_r.len {
            let gid = insts_r.start +% ki;
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                try keep_insts.push(alloc, ip.*);
                try keep_flags.push(alloc, eir_prog.inst_proven_flags(gid));
            }
            ki = ki +% 1_u32;
        }
        try eir_prog.replace_block_insts_reuse(alloc, fn_id, site.bb, keep_insts.as_slice(), keep_flags.as_slice());
        if let bm = eir_prog.fn_block_mut(fn_id, site.bb) {
            bm.term = eir.term_goto(old_entry);
        }
        si2 = si2 +% 1_usize;
    }

    // Append `new_entry` and update `f.entry` + `old_entry.phis`.
    var all_blks = try col.DynBuf.[eir.EirBlock].init(alloc, old_nblks.widen.[usize]() +% 1_usize);
    errdefer all_blks.destroy(alloc);
    var bi: u32 = 0_u32;
    while bi < old_nblks {
        var blk = eir.EirBlock.{
            id: bi,
            phis: ast.range_empty(),
            insts: ast.range_empty(),
            term: eir.term_unreachable(span.span_dummy(), false),
            preds: ast.range_empty(),
            idom: eir.EIR_NONE,
        };
        if let bp = eir_prog.funcs.blocks.get((orig_blks_r.start +% bi).widen.[usize]()) {
            blk = bp.*;
        }
        if bi == old_entry {
            blk.phis = ephis_r;
        }
        try all_blks.push(alloc, blk);
        bi = bi +% 1_u32;
    }
    try all_blks.push(alloc, eir.EirBlock.{
        id: new_entry,
        phis: ast.range_empty(),
        insts: ast.range_empty(),
        term: eir.term_goto(old_entry),
        preds: ast.range_empty(),
        idom: eir.EIR_NONE,
    });
    let new_br = try eir_prog.append_blocks(alloc, all_blks.as_slice());
    if let fm = eir_prog.get_fn_mut(fn_id) {
        fm.blocks = new_br;
        fm.entry = new_entry;
    }
    try eir_prog.rebuild_fn_rpo(alloc, fn_id);
    try eir_prog.prune_fn_phi_preds(alloc, fn_id);

    let count = sites.len().trunc.[u64]();
    all_blks.destroy(alloc);
    keep_flags.destroy(alloc);
    keep_insts.destroy(alloc);
    inc_buf.destroy(alloc);
    entry_phis.destroy(alloc);
    phi_params.destroy(alloc);
    old_params.destroy(alloc);
    remap.destroy(alloc);
    sites.destroy(alloc);
    return count;
}

fn pass_tce(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    stats: *mut OptStats,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) {
            let c = try tce_fn(alloc, eir_prog, fi);
            stats.tail_calls_eliminated = stats.tail_calls_eliminated +% c;
        }
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Section 11: Pass 9 — Domain Super-Opt #3: SoA Loop Fusion
// ===========================================================================

struct PoolId {
    valid: bool;
    is_slot: bool;
    id: u32;
}

fn pool_id_none() -> PoolId {
    return PoolId.{ valid: false, is_slot: false, id: eir.EIR_NONE };
}

fn pool_id_eq(a: PoolId, b: PoolId) -> bool {
    return a.valid && b.valid && a.is_slot == b.is_slot && a.id == b.id;
}

fn canonical_pool_from_val(
    v: eir.EirValue,
    canon: *[eir.EirValue],
    slot_addr_of: *[eir.EirSlot],
) -> PoolId {
    if v == eir.EIR_NONE {
        return pool_id_none();
    }
    let root = resolve_val_chain(v, canon);
    let ru = root.widen.[usize]();
    if ru < slot_addr_of.len && slot_addr_of[ru] != eir.EIR_NONE {
        return PoolId.{ valid: true, is_slot: true, id: slot_addr_of[ru] };
    }
    return PoolId.{ valid: true, is_slot: false, id: root };
}

fn canonical_pool_from_op(
    op: *eir.EirPoolColOp,
    canon: *[eir.EirValue],
    slot_addr_of: *[eir.EirSlot],
) -> PoolId {
    if op.pool_base.kind == .Slot {
        return PoolId.{ valid: true, is_slot: true, id: op.pool_base.id };
    }
    return canonical_pool_from_val(op.pool_base.id, canon, slot_addr_of);
}

struct SoaLoopInfo {
    valid: bool;
    header: eir.BlockId;
    pre_bb: eir.BlockId;
    latch_bb: eir.BlockId;
    body_bb: eir.BlockId;
    exit_bb: eir.BlockId;
    ind_val: eir.EirValue;
    ind_ty: types.TyId;
    step_val: eir.EirValue;
    bound_val: eir.EirValue;
    pool_id: PoolId;
    latch_is_pure_step: bool;
}

fn soa_loop_none() -> SoaLoopInfo {
    return SoaLoopInfo.{
        valid: false,
        header: 0_u32,
        pre_bb: eir.EIR_NONE,
        latch_bb: eir.EIR_NONE,
        body_bb: eir.EIR_NONE,
        exit_bb: eir.EIR_NONE,
        ind_val: eir.EIR_NONE,
        ind_ty: types.TY_VOID,
        step_val: eir.EIR_NONE,
        bound_val: eir.EIR_NONE,
        pool_id: pool_id_none(),
        latch_is_pure_step: false,
    };
}

fn is_soa_ind_index(
    v: eir.EirValue,
    ind_val: eir.EirValue,
    pool_id: PoolId,
    canon: *[eir.EirValue],
    slot_addr_of: *[eir.EirSlot],
    trunc_src: *[eir.EirValue],
    unwrap_ok_src: *[eir.EirValue],
    id_at_pool: *[eir.EirValue],
    id_at_idx: *[eir.EirValue],
) -> bool {
    let cur = resolve_val_chain(v, canon);
    if cur == ind_val {
        return true;
    }
    let cu = cur.widen.[usize]();
    if cu < trunc_src.len && trunc_src[cu] != eir.EIR_NONE {
        if resolve_val_chain(trunc_src[cu], canon) == ind_val {
            return true;
        }
    }
    if cu < unwrap_ok_src.len && unwrap_ok_src[cu] != eir.EIR_NONE {
        let eu = resolve_val_chain(unwrap_ok_src[cu], canon);
        let euu = eu.widen.[usize]();
        if euu < id_at_pool.len && euu < id_at_idx.len && id_at_idx[euu] != eir.EIR_NONE {
            let pid = canonical_pool_from_val(id_at_pool[euu], canon, slot_addr_of);
            if pool_id_eq(pid, pool_id) && resolve_val_chain(id_at_idx[euu], canon) == ind_val {
                return true;
            }
        }
    }
    return false;
}

fn collect_loop_body_bs(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    hdr: eir.BlockId,
    nblks: usize,
    out: *mut col.BitSet,
) -> !OutOfMemory {
    out.clear();
    out.set(hdr.widen.[usize]());
    var work = try col.DynBuf.[eir.BlockId].init(alloc, 16_usize);
    errdefer work.destroy(alloc);
    let hpreds = eir_prog.block_preds(fn_id, hdr);
    var pri: usize = 0_usize;
    while pri < hpreds.len {
        let p = hpreds[pri];
        let pu = p.widen.[usize]();
        if pu < nblks && eir_prog.dominates_block(fn_id, hdr, p) && !out.test(pu) {
            out.set(pu);
            try work.push(alloc, p);
        }
        pri = pri +% 1_usize;
    }
    while !work.is_empty() {
        let cur = work.pop() orelse { break; };
        let cpreds = eir_prog.block_preds(fn_id, cur);
        var pi: usize = 0_usize;
        while pi < cpreds.len {
            let p = cpreds[pi];
            let pu = p.widen.[usize]();
            if pu < nblks && !out.test(pu) {
                out.set(pu);
                try work.push(alloc, p);
            }
            pi = pi +% 1_usize;
        }
    }
    work.destroy(alloc);
    return;
}

fn analyze_soa_loop(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    hdr: eir.BlockId,
    nblks: usize,
    nvals: usize,
    canon: *[eir.EirValue],
    slot_addr_of: *[eir.EirSlot],
    is_const_int: *col.BitSet,
    const_int_u64: *[u64],
    trunc_src: *[eir.EirValue],
    unwrap_ok_src: *[eir.EirValue],
    id_at_pool: *[eir.EirValue],
    id_at_idx: *[eir.EirValue],
    body_out: *mut col.BitSet,
) -> SoaLoopInfo ! OutOfMemory {
    try collect_loop_body_bs(alloc, eir_prog, fn_id, hdr, nblks, body_out);

    let hblk = eir_prog.fn_block(fn_id, hdr) orelse { return soa_loop_none(); };
    // Must have exactly 1 Phi (induction var) and 2 preds (1 preheader + 1 latch).
    let hphis = eir_prog.phis_slice(hblk.phis);
    let hpreds = eir_prog.preds_slice(hblk.preds);
    if hphis.len != 1_usize || hpreds.len != 2_usize {
        return soa_loop_none();
    }
    var pre_bb = eir.EIR_NONE;
    var latch_bb = eir.EIR_NONE;
    if body_out.test(hpreds[0_usize].widen.[usize]()) && !body_out.test(hpreds[1_usize].widen.[usize]()) {
        latch_bb = hpreds[0_usize];
        pre_bb = hpreds[1_usize];
    } else if body_out.test(hpreds[1_usize].widen.[usize]()) && !body_out.test(hpreds[0_usize].widen.[usize]()) {
        latch_bb = hpreds[1_usize];
        pre_bb = hpreds[0_usize];
    } else {
        return soa_loop_none();
    }

    let ind_phi = hphis[0_usize];
    let ind_val = ind_phi.dst;
    let ind_ty = ind_phi.ty;
    let incs = eir_prog.phi_incoming(ind_phi.incoming);
    if incs.len != 2_usize {
        return soa_loop_none();
    }
    var start_v = eir.EIR_NONE;
    var step_v = eir.EIR_NONE;
    if incs[0_usize].pred_bb == pre_bb {
        start_v = incs[0_usize].val;
        step_v = incs[1_usize].val;
    } else {
        start_v = incs[1_usize].val;
        step_v = incs[0_usize].val;
    }
    let start_root = resolve_val_chain(start_v, canon);
    let sr_u = start_root.widen.[usize]();
    if sr_u >= nvals || sr_u >= const_int_u64.len || !is_const_int.test(sr_u) || const_int_u64[sr_u] != 0_u64 {
        return soa_loop_none();
    }

    // Header terminator must be `Branch(Lt(ind_val, bound_val), body_bb, exit_bb)`.
    if hblk.term.kind != .Branch {
        return soa_loop_none();
    }
    let body_bb = hblk.term.bb0;
    let exit_bb = hblk.term.bb1;
    if body_bb == hdr || !body_out.test(body_bb.widen.[usize]()) || body_out.test(exit_bb.widen.[usize]()) {
        return soa_loop_none();
    }
    let cond_v = resolve_val_chain(hblk.term.val, canon);
    var bound_val = eir.EIR_NONE;
    let hinsts = eir_prog.insts_slice(hblk.insts);
    var hi: usize = 0_usize;
    while hi < hinsts.len {
        let inst = hinsts[hi];
        if inst.kind == .Binary && inst.dst == cond_v && inst.bin_op == .Lt
            && resolve_val_chain(inst.v0, canon) == ind_val
        {
            bound_val = resolve_val_chain(inst.v1, canon);
            break;
        }
        hi = hi +% 1_usize;
    }
    if bound_val == eir.EIR_NONE {
        return soa_loop_none();
    }

    // Check `latch_bb` ends in `Goto(hdr)` and computes `step_val = Add|AddWrap(ind_val, Const(1))`.
    let lblk = eir_prog.fn_block(fn_id, latch_bb) orelse { return soa_loop_none(); };
    if lblk.term.kind != .Goto || lblk.term.bb0 != hdr || lblk.phis.len != 0_u32 {
        return soa_loop_none();
    }
    var step_ok = false;
    var latch_pure = latch_bb != body_bb && latch_bb != hdr;
    let linsts = eir_prog.insts_slice(lblk.insts);
    var li: usize = 0_usize;
    while li < linsts.len {
        let inst = linsts[li];
        if inst.kind == .Binary && inst.dst == step_v
            && (inst.bin_op == .Add || inst.bin_op == .AddWrap)
            && resolve_val_chain(inst.v0, canon) == ind_val
        {
            let rv = resolve_val_chain(inst.v1, canon);
            let rvu = rv.widen.[usize]();
            if rvu < nvals && rvu < const_int_u64.len && is_const_int.test(rvu) && const_int_u64[rvu] == 1_u64 {
                step_ok = true;
            }
        } else if inst.kind != .Const && inst.kind != .Copy {
            latch_pure = false;
        }
        li = li +% 1_usize;
    }
    if !step_ok {
        return soa_loop_none();
    }

    // Scan ALL blocks in `body_out`:
    // - No exits other than `hdr -> exit_bb`!
    // - No Call, InlineAsm, StorePlace, StoreSlot, or mutating BuiltinCall!
    // - All PoolColumnLoad / PoolColumnStore must operate on ONE canonical `PoolId` indexed ONLY by `ind_val`!
    // - No SSA value defined inside `body_out` is used outside `body_out`!
    var def_in_loop = try col.BitSet.init(alloc, max_usize(nvals, 1_usize));
    errdefer def_in_loop.destroy(alloc);
    var pool_id = pool_id_none();
    var pool_ops: usize = 0_usize;
    var valid = true;

    var bi: usize = 0_usize;
    while bi < nblks && valid {
        if body_out.test(bi) {
            let bb = bi.trunc.[u32]();
            if let blk = eir_prog.fn_block(fn_id, bb) {
                let bphis = eir_prog.phis_slice(blk.phis);
                var ppi: usize = 0_usize;
                while ppi < bphis.len {
                    if bphis[ppi].dst.widen.[usize]() < nvals {
                        def_in_loop.set(bphis[ppi].dst.widen.[usize]());
                    }
                    ppi = ppi +% 1_usize;
                }
                if bb != hdr {
                    let sc = eir_prog.term_successor_count(&blk.term);
                    if sc == 0_usize {
                        valid = false;
                        break;
                    }
                    var sci: usize = 0_usize;
                    while sci < sc {
                        let succ = eir_prog.term_successor_at(&blk.term, sci);
                        if succ == eir.EIR_NONE || succ.widen.[usize]() >= nblks || !body_out.test(succ.widen.[usize]()) {
                            valid = false;
                            break;
                        }
                        sci = sci +% 1_usize;
                    }
                }
                let binsts = eir_prog.insts_slice(blk.insts);
                var ii: usize = 0_usize;
                while ii < binsts.len && valid {
                    let inst = binsts[ii];
                    let d = eir.inst_def(&inst);
                    if d != eir.EIR_NONE && d.widen.[usize]() < nvals {
                        def_in_loop.set(d.widen.[usize]());
                    }
                    match inst.kind {
                        .Call => { valid = false; }
                        .InlineAsm => { valid = false; }
                        .StorePlace => { valid = false; }
                        .StoreSlot => { valid = false; }
                        .BuiltinCall => {
                            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                                if !is_readonly_nontrapping_builtin(bc.op.kind) {
                                    valid = false;
                                }
                            } else {
                                valid = false;
                            }
                            _ = 0_u8;
                        }
                        .PoolColumnLoad => {
                            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                                let pid = canonical_pool_from_op(op, canon, slot_addr_of);
                                if !pid.valid || op.is_slot_pool {
                                    valid = false;
                                } else if !pool_id.valid {
                                    pool_id = pid;
                                } else if !pool_id_eq(pool_id, pid) {
                                    valid = false;
                                }
                                if valid && !is_soa_ind_index(
                                    op.index, ind_val, pool_id, canon, slot_addr_of,
                                    trunc_src, unwrap_ok_src, id_at_pool, id_at_idx,
                                ) {
                                    valid = false;
                                }
                                pool_ops = pool_ops +% 1_usize;
                            } else {
                                valid = false;
                            }
                            _ = 0_u8;
                        }
                        .PoolColumnStore => {
                            if let op = eir_prog.get_pool_col_op(inst.aux0) {
                                let pid = canonical_pool_from_op(op, canon, slot_addr_of);
                                if !pid.valid || op.is_slot_pool {
                                    valid = false;
                                } else if !pool_id.valid {
                                    pool_id = pid;
                                } else if !pool_id_eq(pool_id, pid) {
                                    valid = false;
                                }
                                if valid && !is_soa_ind_index(
                                    op.index, ind_val, pool_id, canon, slot_addr_of,
                                    trunc_src, unwrap_ok_src, id_at_pool, id_at_idx,
                                ) {
                                    valid = false;
                                }
                                pool_ops = pool_ops +% 1_usize;
                            } else {
                                valid = false;
                            }
                            _ = 0_u8;
                        }
                        _ => {}
                    }
                    ii = ii +% 1_usize;
                }
            }
        }
        bi = bi +% 1_usize;
    }

    // Verify no value defined inside `body_out` is used outside `body_out`.
    if valid && pool_ops > 0_usize && pool_id.valid {
        var uses = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
        errdefer uses.destroy(alloc);
        let rpo = eir_prog.fn_rpo(fn_id);
        var ri: usize = 0_usize;
        while ri < rpo.len && valid {
            let bb = rpo[ri];
            if !body_out.test(bb.widen.[usize]()) {
                let phis = eir_prog.block_phis(fn_id, bb);
                var ppi: usize = 0_usize;
                while ppi < phis.len && valid {
                    let incs2 = eir_prog.phi_incoming(phis[ppi].incoming);
                    var ki: usize = 0_usize;
                    while ki < incs2.len {
                        let vu = incs2[ki].val.widen.[usize]();
                        if vu < nvals && def_in_loop.test(vu) {
                            valid = false;
                            break;
                        }
                        ki = ki +% 1_usize;
                    }
                    ppi = ppi +% 1_usize;
                }
                let insts = eir_prog.block_insts(fn_id, bb);
                var ii: usize = 0_usize;
                while ii < insts.len && valid {
                    try eir.collect_inst_uses(alloc, eir_prog, &insts[ii], &mut uses);
                    let usl = uses.as_slice();
                    var ui: usize = 0_usize;
                    while ui < usl.len {
                        let vu = usl[ui].widen.[usize]();
                        if vu < nvals && def_in_loop.test(vu) {
                            valid = false;
                            break;
                        }
                        ui = ui +% 1_usize;
                    }
                    ii = ii +% 1_usize;
                }
                if valid {
                    if let blk = eir_prog.fn_block(fn_id, bb) {
                        if blk.term.kind == .Branch || blk.term.kind == .SwitchInt || (blk.term.kind == .Return && blk.term.flag) {
                            let vu = blk.term.val.widen.[usize]();
                            if vu < nvals && def_in_loop.test(vu) {
                                valid = false;
                            }
                        }
                    }
                }
            }
            ri = ri +% 1_usize;
        }
        uses.destroy(alloc);
    } else {
        valid = false;
    }

    def_in_loop.destroy(alloc);
    if !valid {
        return soa_loop_none();
    }
    return SoaLoopInfo.{
        valid: true,
        header: hdr,
        pre_bb: pre_bb,
        latch_bb: latch_bb,
        body_bb: body_bb,
        exit_bb: exit_bb,
        ind_val: ind_val,
        ind_ty: ind_ty,
        step_val: step_v,
        bound_val: bound_val,
        pool_id: pool_id,
        latch_is_pure_step: latch_pure,
    };
}

fn is_pure_bridge_inst(eir_prog: *eir.EirProgram, inst: *eir.EirInst) -> bool {
    match inst.kind {
        .Const => { return true; }
        .Copy => { return true; }
        .Cast => { return true; }
        .SlotAddr => { return true; }
        .Unary => { return true; }
        .Binary => { return inst.bin_op != .Div && inst.bin_op != .Mod; }
        .BuiltinCall => {
            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                return is_pure_stateless_builtin(bc.op.kind) || bc.op.kind == .ArenaPoolLen;
            }
            return false;
        }
        _ => { return false; }
    }
}

fn fuse_one_soa_pair_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
) -> bool ! OutOfMemory {
    var nblks: usize = 0_usize;
    var nvals: usize = 0_usize;
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) || f.rpo.len == 0_u32 {
            return false;
        }
        nblks = f.blocks.len.widen.[usize]();
        nvals = f.value_tys.len.widen.[usize]();
    } else {
        return false;
    }
    if nblks < 4_usize || nvals == 0_usize {
        return false;
    }

    // Pre-scan SSA metadata for canonical pool IDs, constants, ArenaPoolLen, ArenaPoolIdAt.
    var canon = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer canon.destroy(alloc);
    try fill_u32(alloc, &mut canon, nvals, eir.EIR_NONE);
    var slot_addr_of = try col.DynBuf.[eir.EirSlot].init(alloc, nvals);
    errdefer slot_addr_of.destroy(alloc);
    try fill_u32(alloc, &mut slot_addr_of, nvals, eir.EIR_NONE);
    var is_const_int = try col.BitSet.init(alloc, nvals);
    errdefer is_const_int.destroy(alloc);
    var const_int_u64 = try col.DynBuf.[u64].init(alloc, nvals);
    errdefer const_int_u64.destroy(alloc);
    try fill_u64(alloc, &mut const_int_u64, nvals, 0_u64);
    var trunc_src = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer trunc_src.destroy(alloc);
    try fill_u32(alloc, &mut trunc_src, nvals, eir.EIR_NONE);
    var unwrap_ok_src = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer unwrap_ok_src.destroy(alloc);
    try fill_u32(alloc, &mut unwrap_ok_src, nvals, eir.EIR_NONE);
    var id_at_pool = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer id_at_pool.destroy(alloc);
    try fill_u32(alloc, &mut id_at_pool, nvals, eir.EIR_NONE);
    var id_at_idx = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer id_at_idx.destroy(alloc);
    try fill_u32(alloc, &mut id_at_idx, nvals, eir.EIR_NONE);
    var pool_len_arg = try col.DynBuf.[eir.EirValue].init(alloc, nvals);
    errdefer pool_len_arg.destroy(alloc);
    try fill_u32(alloc, &mut pool_len_arg, nvals, eir.EIR_NONE);
    var pool_len_slot = try col.DynBuf.[eir.EirSlot].init(alloc, nvals);
    errdefer pool_len_slot.destroy(alloc);
    try fill_u32(alloc, &mut pool_len_slot, nvals, eir.EIR_NONE);

    // Collect loop headers in RPO order.
    var is_hdr = try col.BitSet.init(alloc, nblks);
    errdefer is_hdr.destroy(alloc);
    var hdrs = try col.DynBuf.[eir.BlockId].init(alloc, 8_usize);
    errdefer hdrs.destroy(alloc);

    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bb = rpo[ri];
        if let blk = eir_prog.fn_block(fn_id, bb) {
            let term = blk.term;
            let sc = eir_prog.term_successor_count(&term);
            var si: usize = 0_usize;
            while si < sc {
                let h = eir_prog.term_successor_at(&term, si);
                if h != eir.EIR_NONE && h.widen.[usize]() < nblks && eir_prog.dominates_block(fn_id, h, bb) {
                    if !is_hdr.test(h.widen.[usize]()) {
                        is_hdr.set(h.widen.[usize]());
                        try hdrs.push(alloc, h);
                    }
                }
                si = si +% 1_usize;
            }
            let insts = eir_prog.insts_slice(blk.insts);
            var ii: usize = 0_usize;
            while ii < insts.len {
                let inst = insts[ii];
                if inst.dst != eir.EIR_NONE {
                    let du = inst.dst.widen.[usize]();
                    if inst.kind == .Copy || (inst.kind == .Cast && inst.cast_kind == .MutToConst) {
                        u32_set(&mut canon, du, inst.v0);
                    } else if inst.kind == .SlotAddr {
                        u32_set(&mut slot_addr_of, du, inst.aux0);
                    } else if inst.kind == .Const {
                        if let kc = eir_prog.get_const(inst.aux0) {
                            if kc.kind == .Int && kc.int_val.hi == 0_i64 {
                                is_const_int.set(du);
                                u64_set(&mut const_int_u64, du, kc.int_val.lo);
                            }
                        }
                    } else if inst.kind == .Cast && inst.cast_kind == .Trunc {
                        u32_set(&mut trunc_src, du, inst.v0);
                    } else if inst.kind == .UnwrapErrorOk {
                        u32_set(&mut unwrap_ok_src, du, inst.v0);
                    } else if inst.kind == .BuiltinCall {
                        if let bc = eir_prog.get_builtin_call(inst.aux0) {
                            let bargs = eir_prog.vals_slice(bc.args);
                            let bslots = eir_prog.arg_slots_slice(bc.arg_slots);
                            if bc.op.kind == .ArenaPoolIdAt && bargs.len >= 2_usize {
                                u32_set(&mut id_at_pool, du, bargs[0_usize]);
                                u32_set(&mut id_at_idx, du, bargs[1_usize]);
                            } else if bc.op.kind == .ArenaPoolLen && bargs.len >= 1_usize {
                                u32_set(&mut pool_len_arg, du, bargs[0_usize]);
                                if bslots.len >= 1_usize {
                                    u32_set(&mut pool_len_slot, du, bslots[0_usize]);
                                }
                            }
                        }
                    }
                }
                ii = ii +% 1_usize;
            }
        }
        ri = ri +% 1_usize;
    }

    var body1 = try col.BitSet.init(alloc, nblks);
    errdefer body1.destroy(alloc);
    var body2 = try col.BitSet.init(alloc, nblks);
    errdefer body2.destroy(alloc);
    var bridge = try col.DynBuf.[eir.BlockId].init(alloc, 8_usize);
    errdefer bridge.destroy(alloc);

    var fused = false;
    var h1_i: usize = 0_usize;
    while h1_i < hdrs.len() && !fused {
        let h1 = u32_at(&hdrs, h1_i);
        let l1 = try analyze_soa_loop(
            alloc, eir_prog, fn_id, h1, nblks, nvals,
            canon.as_slice(), slot_addr_of.as_slice(),
            &is_const_int, const_int_u64.as_slice(),
            trunc_src.as_slice(), unwrap_ok_src.as_slice(),
            id_at_pool.as_slice(), id_at_idx.as_slice(), &mut body1,
        );
        if l1.valid {
            // Walk unique single-pred pure `Goto` bridge from `l1.exit_bb` to find `h2`!
            bridge.clear();
            var cur = l1.exit_bb;
            var prev = l1.header;
            var found_h2 = eir.EIR_NONE;
            var hops: usize = 0_usize;
            while hops < 8_usize {
                if is_hdr.test(cur.widen.[usize]()) && cur != l1.header {
                    found_h2 = cur;
                    break;
                }
                let cb = eir_prog.fn_block(fn_id, cur) orelse { break; };
                let cpreds = eir_prog.preds_slice(cb.preds);
                if cpreds.len != 1_usize || cpreds[0_usize] != prev || cb.phis.len != 0_u32 || cb.term.kind != .Goto {
                    break;
                }
                let cinsts = eir_prog.insts_slice(cb.insts);
                var bridge_ok = true;
                var ci: usize = 0_usize;
                while ci < cinsts.len {
                    if !is_pure_bridge_inst(eir_prog, &cinsts[ci]) {
                        bridge_ok = false;
                        break;
                    }
                    ci = ci +% 1_usize;
                }
                if !bridge_ok {
                    break;
                }
                try bridge.push(alloc, cur);
                prev = cur;
                cur = cb.term.bb0;
                hops = hops +% 1_usize;
            }

            if found_h2 != eir.EIR_NONE {
                let l2 = try analyze_soa_loop(
                    alloc, eir_prog, fn_id, found_h2, nblks, nvals,
                    canon.as_slice(), slot_addr_of.as_slice(),
                    &is_const_int, const_int_u64.as_slice(),
                    trunc_src.as_slice(), unwrap_ok_src.as_slice(),
                    id_at_pool.as_slice(), id_at_idx.as_slice(), &mut body2,
                );
                if l2.valid
                    && l2.pre_bb == prev
                    && l1.ind_ty == l2.ind_ty
                    && pool_id_eq(l1.pool_id, l2.pool_id)
                {
                    // Check `l2.body_bb` has 0 phis and `body1` & `body2` are disjoint.
                    var b2_no_phis = false;
                    if let b2b = eir_prog.fn_block(fn_id, l2.body_bb) {
                        b2_no_phis = b2b.phis.len == 0_u32;
                    }
                    var disjoint = true;
                    var di: usize = 0_usize;
                    while di < nblks {
                        if body1.test(di) && body2.test(di) {
                            disjoint = false;
                            break;
                        }
                        di = di +% 1_usize;
                    }
                    // Verify matching trip counts (`n1 == n2`, OR both are `ArenaPoolLen` on `l1.pool_id`).
                    var same_bound = l1.bound_val == l2.bound_val;
                    if !same_bound {
                        let b1u = l1.bound_val.widen.[usize]();
                        let b2u = l2.bound_val.widen.[usize]();
                        if b1u < nvals && b2u < nvals {
                            var p1 = canonical_pool_from_val(u32_at(&pool_len_arg, b1u), canon.as_slice(), slot_addr_of.as_slice());
                            if !p1.valid && u32_at(&pool_len_slot, b1u) != eir.EIR_NONE {
                                p1 = PoolId.{ valid: true, is_slot: true, id: u32_at(&pool_len_slot, b1u) };
                            }
                            var p2 = canonical_pool_from_val(u32_at(&pool_len_arg, b2u), canon.as_slice(), slot_addr_of.as_slice());
                            if !p2.valid && u32_at(&pool_len_slot, b2u) != eir.EIR_NONE {
                                p2 = PoolId.{ valid: true, is_slot: true, id: u32_at(&pool_len_slot, b2u) };
                            }
                            if pool_id_eq(p1, l1.pool_id) && pool_id_eq(p2, l1.pool_id) {
                                same_bound = true;
                            }
                        }
                    }

                    // Ensure `l1.pre_bb` ends in `Goto(l1.header)` so we can hoist `bridge` into `l1.pre_bb`.
                    var pre1_goto = false;
                    if let p1b = eir_prog.fn_block(fn_id, l1.pre_bb) {
                        pre1_goto = p1b.term.kind == .Goto && p1b.term.bb0 == l1.header;
                    }

                    if b2_no_phis && disjoint && same_bound && pre1_goto {
                        try execute_soa_fusion(alloc, eir_prog, fn_id, &l1, &l2, &body1, &bridge, nblks, nvals);
                        fused = true;
                    }
                }
            }
        }
        h1_i = h1_i +% 1_usize;
    }

    bridge.destroy(alloc);
    body2.destroy(alloc);
    body1.destroy(alloc);
    hdrs.destroy(alloc);
    is_hdr.destroy(alloc);
    pool_len_slot.destroy(alloc);
    pool_len_arg.destroy(alloc);
    id_at_idx.destroy(alloc);
    id_at_pool.destroy(alloc);
    unwrap_ok_src.destroy(alloc);
    trunc_src.destroy(alloc);
    const_int_u64.destroy(alloc);
    is_const_int.destroy(alloc);
    slot_addr_of.destroy(alloc);
    canon.destroy(alloc);
    return fused;
}

fn execute_soa_fusion(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    l1: *SoaLoopInfo,
    l2: *SoaLoopInfo,
    body1: *col.BitSet,
    bridge: *col.DynBuf[eir.BlockId],
    nblks: usize,
    nvals: usize,
) -> !OutOfMemory {
    // 1. Move all pure `bridge` instructions to the end of `l1.pre_bb` so they dominate `l1.header` & fused body!
    if !bridge.is_empty() {
        var pre_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
        errdefer pre_insts.destroy(alloc);
        var pre_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
        errdefer pre_flags.destroy(alloc);

        var p1_r = ast.range_empty();
        if let p1b = eir_prog.fn_block(fn_id, l1.pre_bb) {
            p1_r = p1b.insts;
        }
        var pi: u32 = 0_u32;
        while pi < p1_r.len {
            let gid = p1_r.start +% pi;
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                try pre_insts.push(alloc, ip.*);
                try pre_flags.push(alloc, eir_prog.inst_proven_flags(gid));
            }
            pi = pi +% 1_u32;
        }
        let bsl = bridge.as_slice();
        var bi: usize = 0_usize;
        while bi < bsl.len {
            var br_r = ast.range_empty();
            if let bb = eir_prog.fn_block(fn_id, bsl[bi]) {
                br_r = bb.insts;
            }
            var ii: u32 = 0_u32;
            while ii < br_r.len {
                let gid = br_r.start +% ii;
                if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                    try pre_insts.push(alloc, ip.*);
                    try pre_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                }
                ii = ii +% 1_u32;
            }
            if let bbm = eir_prog.fn_block_mut(fn_id, bsl[bi]) {
                bbm.insts = ast.range_empty();
                bbm.term = eir.term_unreachable(span.span_dummy(), false);
            }
            bi = bi +% 1_usize;
        }
        let nr = try append_insts_with_flags(alloc, eir_prog, pre_insts.as_slice(), pre_flags.as_slice());
        if let p1bm = eir_prog.fn_block_mut(fn_id, l1.pre_bb) {
            p1bm.insts = nr;
        }
        pre_flags.destroy(alloc);
        pre_insts.destroy(alloc);
    }

    // 2. Rewire CFG: L1 body -> L2.body_bb -> ... -> L2.latch_bb -> step_bb -> L1.header!
    var step_bb = l1.latch_bb;
    if l1.latch_is_pure_step {
        // Every block inside `body1` (except `l1.latch_bb`) jumping to `l1.latch_bb` now jumps to `l2.body_bb`.
        var bi: usize = 0_usize;
        while bi < nblks {
            let b = bi.trunc.[u32]();
            if body1.test(bi) && b != l1.latch_bb {
                if let bm = eir_prog.fn_block_mut(fn_id, b) {
                    var t = bm.term;
                    _ = rewrite_term_target(eir_prog, &mut t, l1.latch_bb, l2.body_bb);
                    bm.term = t;
                }
            }
            bi = bi +% 1_usize;
        }
    } else {
        // Split step insts out of `l1.latch_bb` into a fresh `new_step_bb`!
        var orig_nblks: u32 = 0_u32;
        var orig_blks_r = ast.range_empty();
        if let f = eir_prog.get_fn(fn_id) {
            orig_nblks = f.blocks.len;
            orig_blks_r = f.blocks;
        }
        let new_step_bb: eir.BlockId = orig_nblks;
        step_bb = new_step_bb;

        var keep_i = try col.DynBuf.[eir.EirInst].init(alloc, 16_usize);
        errdefer keep_i.destroy(alloc);
        var keep_f = try col.DynBuf.[u8].init(alloc, 16_usize);
        errdefer keep_f.destroy(alloc);
        var step_i = try col.DynBuf.[eir.EirInst].init(alloc, 4_usize);
        errdefer step_i.destroy(alloc);
        var step_f = try col.DynBuf.[u8].init(alloc, 4_usize);
        errdefer step_f.destroy(alloc);

        var l1_r = ast.range_empty();
        if let lb = eir_prog.fn_block(fn_id, l1.latch_bb) {
            l1_r = lb.insts;
        }
        var ii: u32 = 0_u32;
        while ii < l1_r.len {
            let gid = l1_r.start +% ii;
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                let inst = ip.*;
                let fl = eir_prog.inst_proven_flags(gid);
                if inst.dst == l1.step_val {
                    try step_i.push(alloc, inst);
                    try step_f.push(alloc, fl);
                } else {
                    try keep_i.push(alloc, inst);
                    try keep_f.push(alloc, fl);
                }
            }
            ii = ii +% 1_u32;
        }
        let kr = try append_insts_with_flags(alloc, eir_prog, keep_i.as_slice(), keep_f.as_slice());
        let sr = try append_insts_with_flags(alloc, eir_prog, step_i.as_slice(), step_f.as_slice());

        if let lbm = eir_prog.fn_block_mut(fn_id, l1.latch_bb) {
            lbm.insts = kr;
            lbm.term = eir.term_goto(l2.body_bb);
        }
        update_block_phi_pred(eir_prog, fn_id, l1.header, l1.latch_bb, new_step_bb);

        var all_blks = try col.DynBuf.[eir.EirBlock].init(alloc, orig_nblks.widen.[usize]() +% 1_usize);
        errdefer all_blks.destroy(alloc);
        var bi: u32 = 0_u32;
        while bi < orig_nblks {
            if let bp = eir_prog.funcs.blocks.get((orig_blks_r.start +% bi).widen.[usize]()) {
                try all_blks.push(alloc, bp.*);
            }
            bi = bi +% 1_u32;
        }
        try all_blks.push(alloc, eir.EirBlock.{
            id: new_step_bb,
            phis: ast.range_empty(),
            insts: sr,
            term: eir.term_goto(l1.header),
            preds: ast.range_empty(),
            idom: eir.EIR_NONE,
        });
        let new_br = try eir_prog.append_blocks(alloc, all_blks.as_slice());
        if let fm = eir_prog.get_fn_mut(fn_id) {
            fm.blocks = new_br;
        }
        all_blks.destroy(alloc);
        step_f.destroy(alloc);
        step_i.destroy(alloc);
        keep_f.destroy(alloc);
        keep_i.destroy(alloc);
    }

    // Redirect `l2.latch_bb` -> `step_bb`.
    if let l2bm = eir_prog.fn_block_mut(fn_id, l2.latch_bb) {
        l2bm.term = eir.term_goto(step_bb);
    }
    // Redirect `l1.header` exit edge: `l1.exit_bb` -> `l2.exit_bb`.
    if let h1bm = eir_prog.fn_block_mut(fn_id, l1.header) {
        var t = h1bm.term;
        _ = rewrite_term_target(eir_prog, &mut t, l1.exit_bb, l2.exit_bb);
        h1bm.term = t;
    }
    // Update Phis in `l2.exit_bb`: `l2.header` -> `l1.header`.
    update_block_phi_pred(eir_prog, fn_id, l2.exit_bb, l2.header, l1.header);

    // Clear dead `l2.header` and remap `l2.ind_val -> l1.ind_val`!
    if let h2bm = eir_prog.fn_block_mut(fn_id, l2.header) {
        h2bm.phis = ast.range_empty();
        h2bm.insts = ast.range_empty();
        h2bm.term = eir.term_unreachable(span.span_dummy(), false);
    }

    var remap = try col.DynBuf.[eir.EirValue].init(alloc, max_usize(nvals, 1_usize));
    errdefer remap.destroy(alloc);
    try fill_u32(alloc, &mut remap, nvals, eir.EIR_NONE);
    if l2.ind_val.widen.[usize]() < nvals {
        u32_set(&mut remap, l2.ind_val.widen.[usize](), l1.ind_val);
    }

    try eir_prog.rebuild_fn_rpo(alloc, fn_id);
    apply_val_remap_fn(eir_prog, fn_id, remap.as_slice());
    try eir_prog.prune_fn_phi_preds(alloc, fn_id);
    try clear_unreachable_blocks(alloc, eir_prog, fn_id);
    remap.destroy(alloc);
    return;
}

/// Forwards read-only `ArenaPool` value copies (`StoreSlot(dst, LoadSlot(src))`)
/// when `dst` is never header-mutated and `src`'s header is never mutated in `dst`'s
/// dominated region. Eliminates redundant 80-byte `rep movsb` pool copies and unifies
/// canonical pool identities so `pass_soa_loop_fusion` fuses adjacent ECS systems!
fn forward_readonly_pool_copies_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> bool ! OutOfMemory {
    var nslots: usize = 0_usize;
    var nvals: usize = 0_usize;
    var nblks: usize = 0_usize;
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) || f.rpo.len == 0_u32 {
            return false;
        }
        nslots = f.slots.len.widen.[usize]();
        nvals = f.value_tys.len.widen.[usize]();
        nblks = f.blocks.len.widen.[usize]();
    } else {
        return false;
    }
    if nslots < 2_usize || nvals == 0_usize {
        return false;
    }

    let slots = eir_prog.fn_slots(fn_id);
    var pool_cnt: usize = 0_usize;
    var si_chk: usize = 0_usize;
    while si_chk < nslots && si_chk < slots.len {
        let sn = env.get(slots[si_chk].ty);
        if sn.kind == .Builtin && sn.builtin_kind == .ArenaPool {
            pool_cnt = pool_cnt +% 1_usize;
            if pool_cnt >= 2_usize {
                break;
            }
        }
        si_chk = si_chk +% 1_usize;
    }
    if pool_cnt < 2_usize {
        return false;
    }

    var cand = try col.BitSet.init(alloc, nslots);
    errdefer cand.destroy(alloc);
    var si: usize = 0_usize;
    while si < nslots && si < slots.len {
        let sn = env.get(slots[si].ty);
        if sn.kind == .Builtin && sn.builtin_kind == .ArenaPool {
            cand.set(si);
        }
        si = si +% 1_usize;
    }

    var store_cnt = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer store_cnt.destroy(alloc);
    var def_bb = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer def_bb.destroy(alloc);
    var def_pos = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer def_pos.destroy(alloc);
    var def_val = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer def_val.destroy(alloc);
    try fill_u32(alloc, &mut store_cnt, nslots, 0_u32);
    try fill_u32(alloc, &mut def_bb, nslots, eir.EIR_NONE);
    try fill_u32(alloc, &mut def_pos, nslots, 0_u32);
    try fill_u32(alloc, &mut def_val, nslots, eir.EIR_NONE);

    var load_slot_of = try col.DynBuf.[u32].init(alloc, nvals);
    errdefer load_slot_of.destroy(alloc);
    var load_bb_of = try col.DynBuf.[u32].init(alloc, nvals);
    errdefer load_bb_of.destroy(alloc);
    var load_pos_of = try col.DynBuf.[u32].init(alloc, nvals);
    errdefer load_pos_of.destroy(alloc);
    var sa_slot_of = try col.DynBuf.[u32].init(alloc, nvals);
    errdefer sa_slot_of.destroy(alloc);
    try fill_u32(alloc, &mut load_slot_of, nvals, eir.EIR_NONE);
    try fill_u32(alloc, &mut load_bb_of, nvals, eir.EIR_NONE);
    try fill_u32(alloc, &mut load_pos_of, nvals, 0_u32);
    try fill_u32(alloc, &mut sa_slot_of, nvals, eir.EIR_NONE);

    var blk_has_call_or_storeplace = try col.BitSet.init(alloc, max_usize(nblks, 1_usize));
    errdefer blk_has_call_or_storeplace.destroy(alloc);

    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bb = rpo[ri];
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            match inst.kind {
                .Copy => {
                    if inst.dst != eir.EIR_NONE && inst.v0 != eir.EIR_NONE
                        && inst.dst.widen.[usize]() < nvals && inst.v0.widen.[usize]() < nvals
                    {
                        let s0 = u32_at(&sa_slot_of, inst.v0.widen.[usize]());
                        if s0 != eir.EIR_NONE {
                            u32_set(&mut sa_slot_of, inst.dst.widen.[usize](), s0);
                        }
                    }
                }
                .Cast => {
                    if inst.cast_kind == .MutToConst && inst.dst != eir.EIR_NONE && inst.v0 != eir.EIR_NONE
                        && inst.dst.widen.[usize]() < nvals && inst.v0.widen.[usize]() < nvals
                    {
                        let s0 = u32_at(&sa_slot_of, inst.v0.widen.[usize]());
                        if s0 != eir.EIR_NONE {
                            u32_set(&mut sa_slot_of, inst.dst.widen.[usize](), s0);
                        }
                    }
                }
                .LoadSlot => {
                    if inst.dst != eir.EIR_NONE && inst.dst.widen.[usize]() < nvals {
                        u32_set(&mut load_slot_of, inst.dst.widen.[usize](), inst.aux0);
                        u32_set(&mut load_bb_of, inst.dst.widen.[usize](), bb);
                        u32_set(&mut load_pos_of, inst.dst.widen.[usize](), ii.trunc.[u32]());
                    }
                }
                .StoreSlot => {
                    let su = inst.aux0.widen.[usize]();
                    if su < nslots {
                        let prev_cnt = u32_at(&store_cnt, su);
                        u32_set(&mut store_cnt, su, prev_cnt +% 1_u32);
                        u32_set(&mut def_bb, su, bb);
                        u32_set(&mut def_pos, su, ii.trunc.[u32]());
                        u32_set(&mut def_val, su, inst.v0);
                    }
                }
                .SlotAddr => {
                    if inst.dst != eir.EIR_NONE && inst.dst.widen.[usize]() < nvals && inst.aux0.widen.[usize]() < nslots {
                        u32_set(&mut sa_slot_of, inst.dst.widen.[usize](), inst.aux0);
                    }
                }
                .LoadPlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        let ps = eir_prog.projs_slice(pl.projs);
                        if pl.base.kind == .Slot {
                            if ps.len == 0_usize && inst.dst != eir.EIR_NONE && inst.dst.widen.[usize]() < nvals {
                                u32_set(&mut load_slot_of, inst.dst.widen.[usize](), pl.base.id);
                                u32_set(&mut load_bb_of, inst.dst.widen.[usize](), bb);
                                u32_set(&mut load_pos_of, inst.dst.widen.[usize](), ii.trunc.[u32]());
                            }
                            if pl.base.id.widen.[usize]() < nslots {
                                cand.unset(pl.base.id.widen.[usize]());
                            }
                        } else if pl.base.kind == .Val && ps.len == 1_usize && ps[0_usize].kind == .Deref
                            && pl.base.id.widen.[usize]() < nvals && inst.dst != eir.EIR_NONE && inst.dst.widen.[usize]() < nvals
                        {
                            let s0 = u32_at(&sa_slot_of, pl.base.id.widen.[usize]());
                            if s0 != eir.EIR_NONE {
                                u32_set(&mut load_slot_of, inst.dst.widen.[usize](), s0);
                                u32_set(&mut load_bb_of, inst.dst.widen.[usize](), bb);
                                u32_set(&mut load_pos_of, inst.dst.widen.[usize](), ii.trunc.[u32]());
                            }
                        }
                    }
                    _ = 0_u8;
                }
                .StorePlace => {
                    blk_has_call_or_storeplace.set(bb.widen.[usize]());
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                            cand.unset(pl.base.id.widen.[usize]());
                        }
                    }
                    _ = 0_u8;
                }
                .PlaceAddr => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                            cand.unset(pl.base.id.widen.[usize]());
                        }
                    }
                    _ = 0_u8;
                }
                .Call => { blk_has_call_or_storeplace.set(bb.widen.[usize]()); }
                .InlineAsm => { blk_has_call_or_storeplace.set(bb.widen.[usize]()); }
                .BuiltinCall => {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        let k = bc.op.kind;
                        if k != .ArenaPoolLen && k != .ArenaPoolIdAt && !builtin_ignores_arg_slots(k) {
                            let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                            var ki: usize = 0_usize;
                            while ki < ss.len {
                                if ss[ki] != eir.EIR_NONE && builtin_uses_arg_slot_at(k, ki) && ss[ki].widen.[usize]() < nslots {
                                    cand.unset(ss[ki].widen.[usize]());
                                }
                                ki = ki +% 1_usize;
                            }
                        }
                    }
                    _ = 0_u8;
                }
                _ => {}
            }
            ii = ii +% 1_usize;
        }
        ri = ri +% 1_usize;
    }

    // Disqualify any candidate slot whose `SlotAddr` value escapes to anything other than
    // Copy, Cast(MutToConst), ArenaPoolLen, ArenaPoolIdAt, PoolColumnLoad, or PoolColumnStore!
    var sa_uses = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
    errdefer sa_uses.destroy(alloc);
    ri = 0_usize;
    while ri < rpo.len {
        let bb = rpo[ri];
        let phis = eir_prog.block_phis(fn_id, bb);
        var pi: usize = 0_usize;
        while pi < phis.len {
            let incs = eir_prog.phi_incoming(phis[pi].incoming);
            var inc_i: usize = 0_usize;
            while inc_i < incs.len {
                let iv = incs[inc_i].val;
                if iv != eir.EIR_NONE && iv.widen.[usize]() < nvals {
                    let ss = u32_at(&sa_slot_of, iv.widen.[usize]());
                    if ss != eir.EIR_NONE && ss.widen.[usize]() < nslots {
                        cand.unset(ss.widen.[usize]());
                    }
                }
                inc_i = inc_i +% 1_usize;
            }
            pi = pi +% 1_usize;
        }
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            let safe_sa_user = inst.kind == .Copy
                || (inst.kind == .Cast && inst.cast_kind == .MutToConst)
                || inst.kind == .PoolColumnLoad
                || inst.kind == .PoolColumnStore;
            if !safe_sa_user {
                var allow_b0 = false;
                if inst.kind == .BuiltinCall {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        if bc.op.kind == .ArenaPoolLen || bc.op.kind == .ArenaPoolIdAt {
                            allow_b0 = true;
                        }
                    }
                }
                if !allow_b0 {
                    sa_uses.clear();
                    try eir.collect_inst_uses(alloc, eir_prog, &inst, &mut sa_uses);
                    let us = sa_uses.as_slice();
                    var ui: usize = 0_usize;
                    while ui < us.len {
                        let uv = us[ui];
                        if uv != eir.EIR_NONE && uv.widen.[usize]() < nvals {
                            let ss = u32_at(&sa_slot_of, uv.widen.[usize]());
                            if ss != eir.EIR_NONE && ss.widen.[usize]() < nslots {
                                cand.unset(ss.widen.[usize]());
                            }
                        }
                        ui = ui +% 1_usize;
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        if let blk = eir_prog.fn_block(fn_id, bb) {
            if blk.term.val != eir.EIR_NONE && blk.term.val.widen.[usize]() < nvals {
                let ss = u32_at(&sa_slot_of, blk.term.val.widen.[usize]());
                if ss != eir.EIR_NONE && ss.widen.[usize]() < nslots {
                    cand.unset(ss.widen.[usize]());
                }
            }
        }
        ri = ri +% 1_usize;
    }

    var redirect = try col.DynBuf.[u32].init(alloc, nslots);
    errdefer redirect.destroy(alloc);
    try fill_u32(alloc, &mut redirect, nslots, eir.EIR_NONE);
    var any_redir = false;

    si = 0_usize;
    while si < nslots && si < slots.len {
        if !cand.test(si) || u32_at(&store_cnt, si) != 1_u32 {
            si = si +% 1_usize;
            continue;
        }
        let sbb = u32_at(&def_bb, si);
        let spos = u32_at(&def_pos, si);
        let sval = u32_at(&def_val, si);
        if sval == eir.EIR_NONE || sval.widen.[usize]() >= nvals {
            si = si +% 1_usize;
            continue;
        }
        let src_slot = u32_at(&load_slot_of, sval.widen.[usize]());
        let lbb = u32_at(&load_bb_of, sval.widen.[usize]());
        let lpos = u32_at(&load_pos_of, sval.widen.[usize]());
        if src_slot == eir.EIR_NONE || src_slot == si.trunc.[u32]() || src_slot.widen.[usize]() >= slots.len {
            si = si +% 1_usize;
            continue;
        }
        let src_ty = slots[src_slot.widen.[usize]()].ty;
        let dst_ty = slots[si].ty;
        let same_ty = if src_ty == dst_ty {
            true
        } else {
            let sn = env.get(src_ty);
            let dn = env.get(dst_ty);
            sn.kind == .Builtin && dn.kind == .Builtin
                && sn.builtin_kind == .ArenaPool && dn.builtin_kind == .ArenaPool
                && env.x64_layout(src_ty).size == env.x64_layout(dst_ty).size
        };
        if !same_ty {
            si = si +% 1_usize;
            continue;
        }
        // Require LoadSlot/LoadPlace(src) dominates StoreSlot(dst), and no mutation of src
        // in (lpos..end of lbb) or in any block dominated by lbb, and every use of dst dominated by (sbb, spos).
        if !eir_prog.dominates_block(fn_id, lbb, sbb) || (lbb == sbb && lpos >= spos) {
            si = si +% 1_usize;
            continue;
        }
        var ok = true;
        var ri2: usize = 0_usize;
        while ri2 < rpo.len && ok {
            let bb = rpo[ri2];
            let dom_by_def = eir_prog.dominates_block(fn_id, sbb, bb);
            let dom_by_load = eir_prog.dominates_block(fn_id, lbb, bb);
            let insts = eir_prog.block_insts(fn_id, bb);
            var ii: usize = 0_usize;
            while ii < insts.len && ok {
                let inst = insts[ii];
                let i32_pos = ii.trunc.[u32]();
                // Check every use of dst is dominated by (sbb, spos)
                var uses_dst = false;
                if (inst.kind == .LoadSlot || inst.kind == .SlotAddr) && inst.aux0 == si.trunc.[u32]() {
                    uses_dst = true;
                } else if (inst.kind == .PoolColumnLoad || inst.kind == .PoolColumnStore) {
                    if let op = eir_prog.get_pool_col_op(inst.aux0) {
                        if op.pool_base.kind == .Slot && op.pool_base.id == si.trunc.[u32]() {
                            uses_dst = true;
                        }
                    }
                } else if inst.kind == .BuiltinCall {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        if !builtin_ignores_arg_slots(bc.op.kind) {
                            let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                            var ki: usize = 0_usize;
                            while ki < ss.len {
                                if ss[ki] == si.trunc.[u32]() {
                                    uses_dst = true;
                                    break;
                                }
                                ki = ki +% 1_usize;
                            }
                        }
                    }
                }
                if uses_dst {
                    if !dom_by_def || (bb == sbb && i32_pos <= spos) {
                        ok = false;
                        break;
                    }
                }
                // Check no mutation of src header in dominated region (or after lpos in lbb)
                let in_src_window = (bb == lbb && i32_pos > lpos) || (bb != lbb && dom_by_load);
                if in_src_window {
                    if inst.kind == .StoreSlot && inst.aux0 == src_slot {
                        ok = false;
                        break;
                    }
                    if inst.kind == .Call || inst.kind == .InlineAsm || inst.kind == .StorePlace {
                        ok = false;
                        break;
                    }
                    if inst.kind == .BuiltinCall {
                        if let bc = eir_prog.get_builtin_call(inst.aux0) {
                            if is_pool_mutating_builtin(bc.op.kind) {
                                ok = false;
                                break;
                            }
                        }
                    }
                }
                ii = ii +% 1_usize;
            }
            ri2 = ri2 +% 1_usize;
        }
        if ok {
            u32_set(&mut redirect, si, src_slot);
            any_redir = true;
        }
        si = si +% 1_usize;
    }

    if !any_redir {
        redirect.destroy(alloc);
        sa_uses.destroy(alloc);
        blk_has_call_or_storeplace.destroy(alloc);
        sa_slot_of.destroy(alloc);
        load_pos_of.destroy(alloc);
        load_bb_of.destroy(alloc);
        load_slot_of.destroy(alloc);
        def_val.destroy(alloc);
        def_pos.destroy(alloc);
        def_bb.destroy(alloc);
        store_cnt.destroy(alloc);
        cand.destroy(alloc);
        return false;
    }

    // Resolve chains (dst -> mid -> root) safely (max 8 hops)
    si = 0_usize;
    while si < nslots {
        var cur = u32_at(&redirect, si);
        if cur != eir.EIR_NONE {
            var hops: usize = 0_usize;
            while hops < 8_usize {
                let nxt = u32_at(&redirect, cur.widen.[usize]());
                if nxt == eir.EIR_NONE || nxt == si.trunc.[u32]() {
                    break;
                }
                cur = nxt;
                hops = hops +% 1_usize;
            }
            u32_set(&mut redirect, si, cur);
        }
        si = si +% 1_usize;
    }

    // Rewrite blocks
    var new_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer new_insts.destroy(alloc);
    var new_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer new_flags.destroy(alloc);
    var tmp_slots = try col.DynBuf.[eir.EirSlot].init(alloc, 4_usize);
    errdefer tmp_slots.destroy(alloc);

    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        rpo_r = f.rpo;
    }
    var r2: u32 = 0_u32;
    while r2 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r2).widen.[usize]()) {
            bb = bp.*;
        }
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            insts_r = blk.insts;
        }
        new_insts.clear();
        new_flags.clear();
        var changed = false;
        var ii: u32 = 0_u32;
        while ii < insts_r.len {
            let gid = insts_r.start +% ii;
            var inst = eir.inst_zero(span.span_dummy(), .Copy);
            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                inst = ip.*;
            }
            let fl = eir_prog.inst_proven_flags(gid);
            if inst.kind == .StoreSlot && u32_at(&redirect, inst.aux0.widen.[usize]()) != eir.EIR_NONE {
                changed = true;
            } else if (inst.kind == .LoadSlot || inst.kind == .SlotAddr) && u32_at(&redirect, inst.aux0.widen.[usize]()) != eir.EIR_NONE {
                inst.aux0 = u32_at(&redirect, inst.aux0.widen.[usize]());
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
                changed = true;
            } else if inst.kind == .PoolColumnLoad || inst.kind == .PoolColumnStore {
                var did_op = false;
                if let op_p = eir_prog.get_pool_col_op(inst.aux0) {
                    if op_p.pool_base.kind == .Slot {
                        let mapped = u32_at(&redirect, op_p.pool_base.id.widen.[usize]());
                        if mapped != eir.EIR_NONE {
                            var nop = op_p.*;
                            nop.pool_base.id = mapped;
                            inst.aux0 = try eir_prog.push_pool_col_op(alloc, nop);
                            did_op = true;
                            changed = true;
                        }
                    }
                }
                _ = did_op;
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            } else if inst.kind == .BuiltinCall {
                if let bc_p = eir_prog.get_builtin_call(inst.aux0) {
                    let bc = bc_p.*;
                    let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                    var need_rw = false;
                    var ki: usize = 0_usize;
                    while ki < ss.len {
                        if ss[ki] != eir.EIR_NONE && u32_at(&redirect, ss[ki].widen.[usize]()) != eir.EIR_NONE {
                            need_rw = true;
                            break;
                        }
                        ki = ki +% 1_usize;
                    }
                    if need_rw {
                        tmp_slots.clear();
                        ki = 0_usize;
                        while ki < ss.len {
                            let s0 = ss[ki];
                            if s0 != eir.EIR_NONE && u32_at(&redirect, s0.widen.[usize]()) != eir.EIR_NONE {
                                try tmp_slots.push(alloc, u32_at(&redirect, s0.widen.[usize]()));
                            } else {
                                try tmp_slots.push(alloc, s0);
                            }
                            ki = ki +% 1_usize;
                        }
                        let nsr = try eir_prog.append_arg_slots(alloc, tmp_slots.as_slice());
                        var nbc = bc;
                        nbc.arg_slots = nsr;
                        inst.aux0 = try eir_prog.push_builtin_call(alloc, nbc);
                        changed = true;
                    }
                }
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            } else {
                try new_insts.push(alloc, inst);
                try new_flags.push(alloc, fl);
            }
            ii = ii +% 1_u32;
        }
        if changed {
            try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, new_insts.as_slice(), new_flags.as_slice());
        }
        r2 = r2 +% 1_u32;
    }

    tmp_slots.destroy(alloc);
    new_flags.destroy(alloc);
    new_insts.destroy(alloc);
    redirect.destroy(alloc);
    sa_uses.destroy(alloc);
    blk_has_call_or_storeplace.destroy(alloc);
    sa_slot_of.destroy(alloc);
    load_pos_of.destroy(alloc);
    load_bb_of.destroy(alloc);
    load_slot_of.destroy(alloc);
    def_val.destroy(alloc);
    def_pos.destroy(alloc);
    def_bb.destroy(alloc);
    store_cnt.destroy(alloc);
    cand.destroy(alloc);
    return true;
}

fn fn_has_arena_pool_ops(
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> bool {
    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < slots.len {
        let sn = env.get(slots[si].ty);
        if sn.kind == .Builtin && sn.builtin_kind == .ArenaPool {
            return true;
        }
        si = si +% 1_usize;
    }
    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let insts = eir_prog.block_insts(fn_id, rpo[ri]);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let k = insts[ii].kind;
            if k == .PoolColumnLoad || k == .PoolColumnStore {
                return true;
            }
            if k == .BuiltinCall {
                if let bc = eir_prog.get_builtin_call(insts[ii].aux0) {
                    if bc.op.kind == .ArenaPoolIdAt || bc.op.kind == .ArenaPoolLen {
                        return true;
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        ri = ri +% 1_usize;
    }
    return false;
}

fn pass_soa_loop_fusion(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    stats: *mut OptStats,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) && fn_has_arena_pool_ops(eir_prog, fi, env) {
            var did_any_fwd = false;
            var rcopy: usize = 0_usize;
            while rcopy < 4_usize {
                let did_fwd = try forward_readonly_pool_copies_fn(alloc, eir_prog, fi, env);
                if !did_fwd {
                    break;
                }
                did_any_fwd = true;
                rcopy = rcopy +% 1_usize;
            }
            // Clean dead forwarded pool-copy StoreSlot/LoadPlace bridge insts before SoA loop fusion!
            let _ = try adce_fn(alloc, eir_prog, fi, env);
            _ = try simplify_cfg_fn(alloc, eir_prog, fi);
            let _ = did_any_fwd;
            var iter: usize = 0_usize;
            while iter < 16_usize {
                let did = try fuse_one_soa_pair_fn(alloc, eir_prog, fi);
                if !did {
                    break;
                }
                stats.fused_pool_loops = stats.fused_pool_loops +% 1_u64;
                iter = iter +% 1_usize;
            }
        }
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Section 12: Pass 10 — ADCE + CFG Simplification + `optimize_program`
// ===========================================================================

fn adce_inst_is_root(
    eir_prog: *eir.EirProgram,
    env: *types.TypeEnv,
    inst: *eir.EirInst,
    fl: u8,
    nslots: usize,
    observed_slots: *col.BitSet,
) -> bool {
    match inst.kind {
        .StoreSlot => {
            let su = inst.aux0.widen.[usize]();
            return su < nslots && observed_slots.test(su);
        }
        .StorePlace => { return true; }
        .PoolColumnStore => { return true; }
        .Call => { return true; }
        .InlineAsm => { return true; }
        .ParForHint => { return true; }
        .SetVar => { return true; }
        .BuiltinCall => {
            if let bc = eir_prog.get_builtin_call(inst.aux0) {
                return !is_readonly_nontrapping_builtin(bc.op.kind);
            }
            return true;
        }
        .Binary => {
            if (inst.bin_op == .Div || inst.bin_op == .Mod) && env.is_concrete_integer(inst.ty1) {
                return (fl & eir.PROVEN_NONZERO_DIV) == 0_u8;
            }
            return false;
        }
        .LoadPlace => {
            if (fl & eir.PROVEN_BOUNDS_SAFE) != 0_u8 {
                return false;
            }
            if let pl = eir_prog.get_place(inst.aux0) {
                let ps = eir_prog.projs_slice(pl.projs);
                var i: usize = 0_usize;
                while i < ps.len {
                    if ps[i].kind == .Index {
                        return true;
                    }
                    i = i +% 1_usize;
                }
            }
            return false;
        }
        .Slice => { return (fl & eir.PROVEN_BOUNDS_SAFE) == 0_u8; }
        _ => { return false; }
    }
}

fn adce_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
    env: *types.TypeEnv,
) -> u64 ! OutOfMemory {
    var nvals: usize = 0_usize;
    var nslots: usize = 0_usize;
    var rpo_r = ast.range_empty();
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) {
            return 0_u64;
        }
        nvals = f.value_tys.len.widen.[usize]();
        nslots = f.slots.len.widen.[usize]();
        rpo_r = f.rpo;
    } else {
        return 0_u64;
    }
    if nvals == 0_usize || rpo_r.len == 0_u32 {
        return 0_u64;
    }

    // 1. Identify observed slots (read or address-taken or par_for).
    var observed_slots = try col.BitSet.init(alloc, max_usize(nslots, 1_usize));
    errdefer observed_slots.destroy(alloc);
    collect_par_for_slots(eir_prog, fn_id, &mut observed_slots);

    // 2. Build SSA def-site table: def_kind (0=param/none, 1=phi, 2=inst), def_bb, def_local_idx.
    var def_kind = try col.DynBuf.[u8].init(alloc, nvals);
    errdefer def_kind.destroy(alloc);
    var def_bb = try col.DynBuf.[u32].init(alloc, nvals);
    errdefer def_bb.destroy(alloc);
    var def_idx = try col.DynBuf.[u32].init(alloc, nvals);
    errdefer def_idx.destroy(alloc);
    try fill_u8(alloc, &mut def_kind, nvals, 0_u8);
    try fill_u32(alloc, &mut def_bb, nvals, eir.EIR_NONE);
    try fill_u32(alloc, &mut def_idx, nvals, 0_u32);

    var r0: u32 = 0_u32;
    while r0 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r0).widen.[usize]()) {
            bb = bp.*;
        }
        let phis = eir_prog.block_phis(fn_id, bb);
        var pi: usize = 0_usize;
        while pi < phis.len {
            let du = phis[pi].dst.widen.[usize]();
            if du < nvals {
                u8_set(&mut def_kind, du, 1_u8);
                u32_set(&mut def_bb, du, bb);
                u32_set(&mut def_idx, du, pi.trunc.[u32]());
            }
            pi = pi +% 1_usize;
        }
        let insts = eir_prog.block_insts(fn_id, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            let d = eir.inst_def(&inst);
            if d != eir.EIR_NONE && d.widen.[usize]() < nvals {
                u8_set(&mut def_kind, d.widen.[usize](), 2_u8);
                u32_set(&mut def_bb, d.widen.[usize](), bb);
                u32_set(&mut def_idx, d.widen.[usize](), ii.trunc.[u32]());
            }
            match inst.kind {
                .LoadSlot => {
                    if inst.aux0.widen.[usize]() < nslots { observed_slots.set(inst.aux0.widen.[usize]()); }
                }
                .SlotAddr => {
                    if inst.aux0.widen.[usize]() < nslots { observed_slots.set(inst.aux0.widen.[usize]()); }
                }
                .LoadPlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                            observed_slots.set(pl.base.id.widen.[usize]());
                        }
                    }
                }
                .StorePlace => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                            observed_slots.set(pl.base.id.widen.[usize]());
                        }
                    }
                }
                .PlaceAddr => {
                    if let pl = eir_prog.get_place(inst.aux0) {
                        if pl.base.kind == .Slot && pl.base.id.widen.[usize]() < nslots {
                            observed_slots.set(pl.base.id.widen.[usize]());
                        }
                    }
                }
                .PoolColumnLoad => {
                    if let op = eir_prog.get_pool_col_op(inst.aux0) {
                        if op.pool_base.kind == .Slot && op.pool_base.id.widen.[usize]() < nslots {
                            observed_slots.set(op.pool_base.id.widen.[usize]());
                        }
                    }
                }
                .PoolColumnStore => {
                    if let op = eir_prog.get_pool_col_op(inst.aux0) {
                        if op.pool_base.kind == .Slot && op.pool_base.id.widen.[usize]() < nslots {
                            observed_slots.set(op.pool_base.id.widen.[usize]());
                        }
                    }
                }
                .BuiltinCall => {
                    if let bc = eir_prog.get_builtin_call(inst.aux0) {
                        if !builtin_ignores_arg_slots(bc.op.kind) {
                            let ss = eir_prog.arg_slots_slice(bc.arg_slots);
                            var ki: usize = 0_usize;
                            while ki < ss.len {
                                if ss[ki] != eir.EIR_NONE && builtin_uses_arg_slot_at(bc.op.kind, ki) && ss[ki].widen.[usize]() < nslots {
                                    observed_slots.set(ss[ki].widen.[usize]());
                                }
                                ki = ki +% 1_usize;
                            }
                        }
                    }
                    _ = 0_u8;
                }
                _ => {}
            }
            ii = ii +% 1_usize;
        }
        r0 = r0 +% 1_u32;
    }

    // 3. Seed worklist with root side-effecting insts & terminator operands.
    var live_val = try col.BitSet.init(alloc, nvals);
    errdefer live_val.destroy(alloc);
    var work = try col.DynBuf.[eir.EirValue].init(alloc, 32_usize);
    errdefer work.destroy(alloc);
    var uses = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
    errdefer uses.destroy(alloc);

    var r1: u32 = 0_u32;
    while r1 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r1).widen.[usize]()) {
            bb = bp.*;
        }
        if let blk = eir_prog.fn_block(fn_id, bb) {
            if blk.term.kind == .Branch || blk.term.kind == .SwitchInt || (blk.term.kind == .Return && blk.term.flag) {
                let tv = blk.term.val;
                let tvu = tv.widen.[usize]();
                if tv != eir.EIR_NONE && tvu < nvals && !live_val.test(tvu) {
                    live_val.set(tvu);
                    try work.push(alloc, tv);
                }
            }
            let insts_r = blk.insts;
            var ii: u32 = 0_u32;
            while ii < insts_r.len {
                let gid = insts_r.start +% ii;
                if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                    let inst = ip.*;
                    let fl = eir_prog.inst_proven_flags(gid);
                    if adce_inst_is_root(eir_prog, env, &inst, fl, nslots, &observed_slots) {
                        let d = eir.inst_def(&inst);
                        if d != eir.EIR_NONE && d.widen.[usize]() < nvals && !live_val.test(d.widen.[usize]()) {
                            live_val.set(d.widen.[usize]());
                        }
                        try eir.collect_inst_uses(alloc, eir_prog, &inst, &mut uses);
                        let usl = uses.as_slice();
                        var ui: usize = 0_usize;
                        while ui < usl.len {
                            let vu = usl[ui].widen.[usize]();
                            if vu < nvals && !live_val.test(vu) {
                                live_val.set(vu);
                                try work.push(alloc, usl[ui]);
                            }
                            ui = ui +% 1_usize;
                        }
                    }
                }
                ii = ii +% 1_u32;
            }
        }
        r1 = r1 +% 1_u32;
    }

    // 4. Propagate liveness backwards through SSA def-use & Phis.
    while !work.is_empty() {
        let v = work.pop() orelse { break; };
        let vu = v.widen.[usize]();
        let dk = u8_at(&def_kind, vu);
        if dk == 1_u8 {
            let dbb = u32_at(&def_bb, vu);
            let dpi = u32_at(&def_idx, vu);
            let phis = eir_prog.block_phis(fn_id, dbb);
            if dpi.widen.[usize]() < phis.len {
                let incs = eir_prog.phi_incoming(phis[dpi.widen.[usize]()].incoming);
                var ki: usize = 0_usize;
                while ki < incs.len {
                    let ivu = incs[ki].val.widen.[usize]();
                    if ivu < nvals && !live_val.test(ivu) {
                        live_val.set(ivu);
                        try work.push(alloc, incs[ki].val);
                    }
                    ki = ki +% 1_usize;
                }
            }
        } else if dk == 2_u8 {
            let dbb = u32_at(&def_bb, vu);
            let dii = u32_at(&def_idx, vu);
            let insts = eir_prog.block_insts(fn_id, dbb);
            if dii.widen.[usize]() < insts.len {
                try eir.collect_inst_uses(alloc, eir_prog, &insts[dii.widen.[usize]()], &mut uses);
                let usl = uses.as_slice();
                var ui: usize = 0_usize;
                while ui < usl.len {
                    let uvu = usl[ui].widen.[usize]();
                    if uvu < nvals && !live_val.test(uvu) {
                        live_val.set(uvu);
                        try work.push(alloc, usl[ui]);
                    }
                    ui = ui +% 1_usize;
                }
            }
        }
    }

    // 5. Filter out dead Phis and dead instructions.
    var removed: u64 = 0_u64;
    var keep_phis = try col.DynBuf.[eir.EirPhi].init(alloc, 8_usize);
    errdefer keep_phis.destroy(alloc);
    var keep_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer keep_insts.destroy(alloc);
    var keep_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer keep_flags.destroy(alloc);

    var r2: u32 = 0_u32;
    while r2 < rpo_r.len {
        var bb: eir.BlockId = 0_u32;
        if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r2).widen.[usize]()) {
            bb = bp.*;
        }
        var phis_r = ast.range_empty();
        var insts_r = ast.range_empty();
        if let blk = eir_prog.fn_block(fn_id, bb) {
            phis_r = blk.phis;
            insts_r = blk.insts;
        }
        if phis_r.len > 0_u32 {
            keep_phis.clear();
            var pchanged = false;
            var pi: u32 = 0_u32;
            while pi < phis_r.len {
                if let pp = eir_prog.funcs.phis.get((phis_r.start +% pi).widen.[usize]()) {
                    let phi = pp.*;
                    if phi.dst.widen.[usize]() < nvals && live_val.test(phi.dst.widen.[usize]()) {
                        try keep_phis.push(alloc, phi);
                    } else {
                        pchanged = true;
                        removed = removed +% 1_u64;
                    }
                }
                pi = pi +% 1_u32;
            }
            if pchanged {
                try eir_prog.replace_block_phis_reuse(alloc, fn_id, bb, keep_phis.as_slice());
            }
        }
        if insts_r.len > 0_u32 {
            keep_insts.clear();
            keep_flags.clear();
            var ichanged = false;
            var ii: u32 = 0_u32;
            while ii < insts_r.len {
                let gid = insts_r.start +% ii;
                if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                    let inst = ip.*;
                    let fl = eir_prog.inst_proven_flags(gid);
                    let d = eir.inst_def(&inst);
                    let is_live = adce_inst_is_root(eir_prog, env, &inst, fl, nslots, &observed_slots)
                        || (d != eir.EIR_NONE && d.widen.[usize]() < nvals && live_val.test(d.widen.[usize]()));
                    if is_live {
                        try keep_insts.push(alloc, inst);
                        try keep_flags.push(alloc, fl);
                    } else {
                        ichanged = true;
                        removed = removed +% 1_u64;
                    }
                }
                ii = ii +% 1_u32;
            }
            if ichanged {
                try eir_prog.replace_block_insts_reuse(alloc, fn_id, bb, keep_insts.as_slice(), keep_flags.as_slice());
            }
        }
        r2 = r2 +% 1_u32;
    }

    keep_flags.destroy(alloc);
    keep_insts.destroy(alloc);
    keep_phis.destroy(alloc);
    uses.destroy(alloc);
    work.destroy(alloc);
    live_val.destroy(alloc);
    def_idx.destroy(alloc);
    def_bb.destroy(alloc);
    def_kind.destroy(alloc);
    observed_slots.destroy(alloc);
    return removed;
}

fn preds_contains_bb(preds: *[eir.BlockId], target: eir.BlockId) -> bool {
    var i: usize = 0_usize;
    while i < preds.len {
        if preds[i] == target {
            return true;
        }
        i = i +% 1_usize;
    }
    return false;
}

fn count_val_uses_fn(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    nvals: usize,
    out_cnt: *mut col.DynBuf[u32],
) -> !OutOfMemory {
    out_cnt.clear();
    try fill_u32(alloc, out_cnt, nvals, 0_u32);
    var uses = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
    errdefer uses.destroy(alloc);
    let rpo = eir_prog.fn_rpo(fn_id);
    var ri: usize = 0_usize;
    while ri < rpo.len {
        let bb = rpo[ri];
        if let blk = eir_prog.fn_block(fn_id, bb) {
            let phis = eir_prog.phis_slice(blk.phis);
            var pi: usize = 0_usize;
            while pi < phis.len {
                let incs = eir_prog.phi_incoming(phis[pi].incoming);
                var ki: usize = 0_usize;
                while ki < incs.len {
                    let vu = incs[ki].val.widen.[usize]();
                    let cs = out_cnt.as_mut_slice();
                    if vu < cs.len {
                        cs[vu] = cs[vu] +% 1_u32;
                    }
                    ki = ki +% 1_usize;
                }
                pi = pi +% 1_usize;
            }
            let insts = eir_prog.insts_slice(blk.insts);
            var ii: usize = 0_usize;
            while ii < insts.len {
                uses.clear();
                try eir.collect_inst_uses(alloc, eir_prog, &insts[ii], &mut uses);
                let us = uses.as_slice();
                var ui: usize = 0_usize;
                while ui < us.len {
                    let vu = us[ui].widen.[usize]();
                    let cs = out_cnt.as_mut_slice();
                    if vu < cs.len {
                        cs[vu] = cs[vu] +% 1_u32;
                    }
                    ui = ui +% 1_usize;
                }
                ii = ii +% 1_usize;
            }
            if blk.term.kind == .Branch || blk.term.kind == .SwitchInt || (blk.term.kind == .Return && blk.term.flag) {
                let vu = blk.term.val.widen.[usize]();
                let cs = out_cnt.as_mut_slice();
                if vu < cs.len {
                    cs[vu] = cs[vu] +% 1_u32;
                }
            }
        }
        ri = ri +% 1_usize;
    }
    uses.destroy(alloc);
    return;
}

fn remap_switch_targets_redir(
    sw_mut: *mut [cfg_ir.SwitchTarget],
    targets: ast.IdRange,
    redir: *col.DynBuf[u32],
) -> bool {
    var mod_t = false;
    let sw_base = targets.start.widen.[usize]();
    let sw_cnt = targets.len.widen.[usize]();
    var ti: usize = 0_usize;
    while ti < sw_cnt {
        let pos = sw_base +% ti;
        if pos < sw_mut.len {
            let mt = u32_at(redir, sw_mut[pos].target.widen.[usize]());
            if mt != eir.EIR_NONE {
                sw_mut[pos].target = mt;
                mod_t = true;
            }
        }
        ti = ti +% 1_usize;
    }
    return mod_t;
}

/// Simplifies CFG chains, collapses empty jump-only blocks, and compacts unreachable blocks.
/// Returns `true` if any CFG/block change was performed.
fn simplify_cfg_fn(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    fn_id: u32,
) -> bool ! OutOfMemory {
    var init_nblks: usize = 0_usize;
    var init_nvals: usize = 0_usize;
    if let f = eir_prog.get_fn(fn_id) {
        if is_opt_protected_fn(f) || has_par_for(f) || f.rpo.len == 0_u32 {
            return false;
        }
        init_nblks = f.blocks.len.widen.[usize]();
        init_nvals = f.value_tys.len.widen.[usize]();
    } else {
        return false;
    }

    var merged_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer merged_insts.destroy(alloc);
    var merged_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer merged_flags.destroy(alloc);
    var dead_bb = try col.BitSet.init(alloc, max_usize(init_nblks, 1_usize));
    errdefer dead_bb.destroy(alloc);
    var touched = try col.BitSet.init(alloc, max_usize(init_nblks, 1_usize));
    errdefer touched.destroy(alloc);
    var redir = try col.DynBuf.[eir.BlockId].init(alloc, max_usize(init_nblks, 1_usize));
    errdefer redir.destroy(alloc);
    var use_cnt = try col.DynBuf.[u32].init(alloc, 4_usize);
    errdefer use_cnt.destroy(alloc);

    var any_changed = false;

    // Up to 32 simplification rounds (exits early as soon as !changed; batches chains & empty jumps!).
    var round: usize = 0_usize;
    while round < 32_usize {
        var changed = false;
        var uses_ready = false;
        var entry: eir.BlockId = 0_u32;
        var rpo_r = ast.range_empty();
        var cur_nblks: usize = 0_usize;
        if let f = eir_prog.get_fn(fn_id) {
            entry = f.entry;
            rpo_r = f.rpo;
            cur_nblks = f.blocks.len.widen.[usize]();
        }

        // 1. Batch-merge `A -> B -> ...` disjoint linear chains in a single pass.
        dead_bb.clear();
        touched.clear();
        var r0: u32 = 0_u32;
        while r0 < rpo_r.len {
            var a: eir.BlockId = 0_u32;
            if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r0).widen.[usize]()) {
                a = bp.*;
            }
            let au = a.widen.[usize]();
            if au >= cur_nblks || dead_bb.test(au) || touched.test(au) {
                r0 = r0 +% 1_u32;
                continue;
            }
            var cur_term = eir.term_unreachable(span.span_dummy(), false);
            var a_insts_r = ast.range_empty();
            if let ab = eir_prog.fn_block(fn_id, a) {
                cur_term = ab.term;
                a_insts_r = ab.insts;
            }
            var merged_any_here = false;
            var prev_tail = a;
            while cur_term.kind == .Goto {
                let b = cur_term.bb0;
                let bu = b.widen.[usize]();
                if b == a || b == prev_tail || b == entry || bu >= cur_nblks || dead_bb.test(bu) || touched.test(bu) {
                    break;
                }
                var can_merge = false;
                var b_insts_r = ast.range_empty();
                var b_term = eir.term_unreachable(span.span_dummy(), false);
                if let bb = eir_prog.fn_block(fn_id, b) {
                    let bpreds = eir_prog.preds_slice(bb.preds);
                    if bpreds.len == 1_usize && bpreds[0_usize] == prev_tail && bb.phis.len == 0_u32 {
                        can_merge = true;
                        b_insts_r = bb.insts;
                        b_term = bb.term;
                    }
                }
                if !can_merge {
                    break;
                }
                let sc = eir_prog.term_successor_count(&b_term);
                var phi_conflict = false;
                var sci0: usize = 0_usize;
                while sci0 < sc {
                    let succ = eir_prog.term_successor_at(&b_term, sci0);
                    if succ != eir.EIR_NONE {
                        let su = succ.widen.[usize]();
                        if let sb = eir_prog.fn_block(fn_id, succ) {
                            if sb.phis.len > 0_u32 && (preds_contains_bb(eir_prog.preds_slice(sb.preds), a) || (su < cur_nblks && touched.test(su))) {
                                phi_conflict = true;
                                break;
                            }
                        }
                    }
                    sci0 = sci0 +% 1_usize;
                }
                if phi_conflict {
                    break;
                }
                if !merged_any_here {
                    merged_insts.clear();
                    merged_flags.clear();
                    var ai: u32 = 0_u32;
                    while ai < a_insts_r.len {
                        let gid = a_insts_r.start +% ai;
                        if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                            try merged_insts.push(alloc, ip.*);
                            try merged_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                        }
                        ai = ai +% 1_u32;
                    }
                    merged_any_here = true;
                }
                var bi: u32 = 0_u32;
                while bi < b_insts_r.len {
                    let gid = b_insts_r.start +% bi;
                    if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                        try merged_insts.push(alloc, ip.*);
                        try merged_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                    }
                    bi = bi +% 1_u32;
                }
                var sci: usize = 0_usize;
                while sci < sc {
                    let succ = eir_prog.term_successor_at(&b_term, sci);
                    if succ != eir.EIR_NONE {
                        var has_p = false;
                        if let sb = eir_prog.fn_block(fn_id, succ) {
                            has_p = sb.phis.len > 0_u32;
                        }
                        if has_p {
                            update_block_phi_pred(eir_prog, fn_id, succ, b, a);
                            let su = succ.widen.[usize]();
                            if su < cur_nblks {
                                touched.set(su);
                            }
                        }
                    }
                    sci = sci +% 1_usize;
                }
                if let bbm = eir_prog.fn_block_mut(fn_id, b) {
                    bbm.insts = ast.range_empty();
                    bbm.phis = ast.range_empty();
                    bbm.term = eir.term_unreachable(span.span_dummy(), false);
                }
                dead_bb.set(bu);
                prev_tail = b;
                cur_term = b_term;
            }
            if merged_any_here {
                try eir_prog.replace_block_insts_reuse(alloc, fn_id, a, merged_insts.as_slice(), merged_flags.as_slice());
                if let abm = eir_prog.fn_block_mut(fn_id, a) {
                    abm.term = cur_term;
                }
                touched.set(au);
                changed = true;
            }
            r0 = r0 +% 1_u32;
        }

        // 2. Collapse empty jump-only blocks `E -> T` (batching all non-phi targets in 1 sweep!).
        if !changed {
            redir.clear();
            try fill_u32(alloc, &mut redir, cur_nblks, eir.EIR_NONE);
            var any_redir = false;
            var r1: u32 = 0_u32;
            while r1 < rpo_r.len {
                var e_bb: eir.BlockId = 0_u32;
                if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r1).widen.[usize]()) {
                    e_bb = bp.*;
                }
                let eu = e_bb.widen.[usize]();
                if e_bb != entry && eu < cur_nblks {
                    var t_bb = eir.EIR_NONE;
                    if let eb = eir_prog.fn_block(fn_id, e_bb) {
                        if eb.phis.len == 0_u32 && eb.insts.len == 0_u32 && eb.term.kind == .Goto && eb.term.bb0 != e_bb {
                            t_bb = eb.term.bb0;
                        }
                    }
                    if t_bb != eir.EIR_NONE {
                        var t_has_phis = true;
                        if let tb = eir_prog.fn_block(fn_id, t_bb) {
                            t_has_phis = tb.phis.len > 0_u32;
                        }
                        if !t_has_phis {
                            u32_set(&mut redir, eu, t_bb);
                            any_redir = true;
                        }
                    }
                }
                r1 = r1 +% 1_u32;
            }
            if any_redir {
                var bi_c: usize = 0_usize;
                while bi_c < cur_nblks {
                    var cur = u32_at(&redir, bi_c);
                    if cur != eir.EIR_NONE {
                        var hops: usize = 0_usize;
                        while hops < 16_usize {
                            let nxt = u32_at(&redir, cur.widen.[usize]());
                            if nxt == eir.EIR_NONE {
                                break;
                            }
                            if nxt == bi_c.trunc.[u32]() || nxt == cur {
                                cur = eir.EIR_NONE;
                                break;
                            }
                            cur = nxt;
                            hops = hops +% 1_usize;
                        }
                        u32_set(&mut redir, bi_c, cur);
                    }
                    bi_c = bi_c +% 1_usize;
                }
                var r1b: u32 = 0_u32;
                while r1b < rpo_r.len {
                    var bb: eir.BlockId = 0_u32;
                    if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r1b).widen.[usize]()) {
                        bb = bp.*;
                    }
                    let bu = bb.widen.[usize]();
                    if bu < cur_nblks && u32_at(&redir, bu) != eir.EIR_NONE {
                        if let bbm = eir_prog.fn_block_mut(fn_id, bb) {
                            bbm.term = eir.term_unreachable(span.span_dummy(), false);
                        }
                        changed = true;
                    } else if let bbm = eir_prog.fn_block_mut(fn_id, bb) {
                        var t = bbm.term;
                        var mod_t = false;
                        match t.kind {
                            .Goto => {
                                let m0 = u32_at(&redir, t.bb0.widen.[usize]());
                                if m0 != eir.EIR_NONE { t.bb0 = m0; mod_t = true; }
                            }
                            .Branch => {
                                let m0 = u32_at(&redir, t.bb0.widen.[usize]());
                                if m0 != eir.EIR_NONE { t.bb0 = m0; mod_t = true; }
                                let m1 = u32_at(&redir, t.bb1.widen.[usize]());
                                if m1 != eir.EIR_NONE { t.bb1 = m1; mod_t = true; }
                            }
                            .SwitchInt => {
                                let m0 = u32_at(&redir, t.bb0.widen.[usize]());
                                if m0 != eir.EIR_NONE { t.bb0 = m0; mod_t = true; }
                                if remap_switch_targets_redir(eir_prog.funcs.switch_targets.as_mut_slice(), t.targets, &redir) {
                                    mod_t = true;
                                }
                            }
                            _ => {}
                        }
                        if mod_t {
                            if let bbm2 = eir_prog.fn_block_mut(fn_id, bb) {
                                bbm2.term = t;
                            }
                            changed = true;
                        }
                    }
                    r1b = r1b +% 1_u32;
                }
            } else {
                // Single-pred empty jump-only block into phi-bearing target.
                var r1p: u32 = 0_u32;
                while r1p < rpo_r.len {
                    var e_bb: eir.BlockId = 0_u32;
                    if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r1p).widen.[usize]()) {
                        e_bb = bp.*;
                    }
                    if e_bb != entry {
                        var e_empty_goto = false;
                        var t_bb = eir.EIR_NONE;
                        var e_preds_r = ast.range_empty();
                        if let eb = eir_prog.fn_block(fn_id, e_bb) {
                            if eb.phis.len == 0_u32 && eb.insts.len == 0_u32 && eb.term.kind == .Goto && eb.term.bb0 != e_bb && eb.preds.len == 1_u32 {
                                e_empty_goto = true;
                                t_bb = eb.term.bb0;
                                e_preds_r = eb.preds;
                            }
                        }
                        if e_empty_goto && t_bb != eir.EIR_NONE {
                            var p = eir.EIR_NONE;
                            if let pp = eir_prog.meta.preds.get(e_preds_r.start.widen.[usize]()) {
                                p = pp.*;
                            }
                            if p != eir.EIR_NONE && !preds_contains_bb(eir_prog.block_preds(fn_id, t_bb), p) {
                                if let pbm = eir_prog.fn_block_mut(fn_id, p) {
                                    var pt = pbm.term;
                                    _ = rewrite_term_target(eir_prog, &mut pt, e_bb, t_bb);
                                    pbm.term = pt;
                                }
                                update_block_phi_pred(eir_prog, fn_id, t_bb, e_bb, p);
                                if let ebm = eir_prog.fn_block_mut(fn_id, e_bb) {
                                    ebm.term = eir.term_unreachable(span.span_dummy(), false);
                                }
                                changed = true;
                                break;
                            }
                        }
                    }
                    r1p = r1p +% 1_u32;
                }
            }
        }

        // 2.5. Jump threading across `Branch(Phi(const_bool, ...))` (short-circuit `&&` / `||`).
        if !changed {
            var r2: u32 = 0_u32;
            while r2 < rpo_r.len && !changed {
                var j_bb: eir.BlockId = 0_u32;
                if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r2).widen.[usize]()) {
                    j_bb = bp.*;
                }
                if j_bb != entry {
                    var cand_ok = false;
                    var j_phis_r = ast.range_empty();
                    var j_insts_r = ast.range_empty();
                    var j_val = eir.EIR_NONE;
                    var j_then = eir.EIR_NONE;
                    var j_else = eir.EIR_NONE;
                    if let jb = eir_prog.fn_block(fn_id, j_bb) {
                        if jb.phis.len == 1_u32
                            && jb.term.kind == .Branch
                            && jb.term.bb0 != j_bb && jb.term.bb1 != j_bb
                            && jb.term.bb0 != jb.term.bb1
                        {
                            var all_const = true;
                            let jinsts = eir_prog.insts_slice(jb.insts);
                            var jii: usize = 0_usize;
                            while jii < jinsts.len {
                                if jinsts[jii].kind != .Const {
                                    all_const = false;
                                    break;
                                }
                                jii = jii +% 1_usize;
                            }
                            if all_const {
                                cand_ok = true;
                                j_phis_r = jb.phis;
                                j_insts_r = jb.insts;
                                j_val = jb.term.val;
                                j_then = jb.term.bb0;
                                j_else = jb.term.bb1;
                            }
                        }
                    }
                    if cand_ok && j_insts_r.len > 0_u32 {
                        // Hoist pure Const insts from `j_bb` to `entry` so `j_bb` becomes empty for jump threading!
                        var e_insts_r = ast.range_empty();
                        if let eb = eir_prog.fn_block(fn_id, entry) {
                            e_insts_r = eb.insts;
                        }
                        merged_insts.clear();
                        merged_flags.clear();
                        var ei: u32 = 0_u32;
                        while ei < e_insts_r.len {
                            let gid = e_insts_r.start +% ei;
                            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                                try merged_insts.push(alloc, ip.*);
                                try merged_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                            }
                            ei = ei +% 1_u32;
                        }
                        var ji: u32 = 0_u32;
                        while ji < j_insts_r.len {
                            let gid = j_insts_r.start +% ji;
                            if let ip = eir_prog.funcs.insts.get(gid.widen.[usize]()) {
                                try merged_insts.push(alloc, ip.*);
                                try merged_flags.push(alloc, eir_prog.inst_proven_flags(gid));
                            }
                            ji = ji +% 1_u32;
                        }
                        let new_er = try append_insts_with_flags(alloc, eir_prog, merged_insts.as_slice(), merged_flags.as_slice());
                        if let ebm = eir_prog.fn_block_mut(fn_id, entry) {
                            ebm.insts = new_er;
                        }
                        if let jbm = eir_prog.fn_block_mut(fn_id, j_bb) {
                            jbm.insts = ast.range_empty();
                        }
                    }
                    if cand_ok {
                        var phi_dst = eir.EIR_NONE;
                        var phi_inc = ast.range_empty();
                        if let pp = eir_prog.funcs.phis.get(j_phis_r.start.widen.[usize]()) {
                            phi_dst = pp.dst;
                            phi_inc = pp.incoming;
                        }
                        if phi_dst == j_val && phi_inc.len >= 2_u32 {
                            if !uses_ready {
                                try count_val_uses_fn(alloc, eir_prog, fn_id, init_nvals, &mut use_cnt);
                                uses_ready = true;
                            }
                            let only_here = u32_at(&use_cnt, phi_dst.widen.[usize]()) == 1_u32;
                            if only_here {
                                var ki: u32 = 0_u32;
                                while ki < phi_inc.len {
                                    var p = eir.EIR_NONE;
                                    var pv = eir.EIR_NONE;
                                    if let inp = eir_prog.funcs.phi_in.get((phi_inc.start +% ki).widen.[usize]()) {
                                        p = inp.pred_bb;
                                        pv = inp.val;
                                    }
                                    if p != eir.EIR_NONE && p != j_bb {
                                        let cb = find_const_bool_in_fn(eir_prog, fn_id, p, pv);
                                        if cb >= 0_i8 {
                                            let tgt = if cb == 1_i8 { j_then } else { j_else };
                                            var tgt_has_phis = false;
                                            if let tb = eir_prog.fn_block(fn_id, tgt) {
                                                tgt_has_phis = tb.phis.len > 0_u32;
                                            }
                                            if !tgt_has_phis || !preds_contains_bb(eir_prog.block_preds(fn_id, tgt), p) {
                                                var did_rw = false;
                                                if let pbm = eir_prog.fn_block_mut(fn_id, p) {
                                                    var pt = pbm.term;
                                                    did_rw = rewrite_term_target(eir_prog, &mut pt, j_bb, tgt);
                                                    pbm.term = pt;
                                                }
                                                if did_rw {
                                                    if tgt_has_phis {
                                                        try clone_block_phi_pred_edge(alloc, eir_prog, fn_id, tgt, j_bb, p);
                                                    }
                                                    changed = true;
                                                    break;
                                                }
                                            }
                                        }
                                    }
                                    ki = ki +% 1_u32;
                                }
                            }
                        }
                    }
                }
                r2 = r2 +% 1_u32;
            }
        }

        // 2.6. Collapse empty phi-forwarding join blocks `J -> H` directly into `H`'s phis!
        // Eliminates nested `if/else` join-phi register doubling inside loops (100% SSA-sound).
        if !changed {
            var r3: u32 = 0_u32;
            while r3 < rpo_r.len && !changed {
                var j_bb: eir.BlockId = 0_u32;
                if let bp = eir_prog.meta.rpo.get((rpo_r.start +% r3).widen.[usize]()) {
                    j_bb = bp.*;
                }
                if j_bb != entry {
                    var j_ok = false;
                    var h_bb = eir.EIR_NONE;
                    var j_phis_r = ast.range_empty();
                    var j_preds_r = ast.range_empty();
                    if let jb = eir_prog.fn_block(fn_id, j_bb) {
                        if jb.insts.len == 0_u32
                            && jb.term.kind == .Goto
                            && jb.term.bb0 != j_bb
                            && jb.preds.len >= 1_u32
                        {
                            j_ok = true;
                            h_bb = jb.term.bb0;
                            j_phis_r = jb.phis;
                            j_preds_r = jb.preds;
                        }
                    }
                    if j_ok && h_bb != eir.EIR_NONE {
                        var h_phis_r = ast.range_empty();
                        if let hb = eir_prog.fn_block(fn_id, h_bb) {
                            h_phis_r = hb.phis;
                        }
                        if h_phis_r.len > 0_u32 {
                            // Verify every pred P of J is distinct from J, H, not already a pred of H,
                            // and has a single edge to J (Goto or distinct-target Branch).
                            var preds_ok = true;
                            var pi: u32 = 0_u32;
                            while pi < j_preds_r.len && preds_ok {
                                var p = eir.EIR_NONE;
                                if let pp = eir_prog.meta.preds.get((j_preds_r.start +% pi).widen.[usize]()) {
                                    p = pp.*;
                                }
                                if p == eir.EIR_NONE || p == j_bb || p == h_bb
                                    || preds_contains_bb(eir_prog.block_preds(fn_id, h_bb), p)
                                {
                                    preds_ok = false;
                                } else if let pb = eir_prog.fn_block(fn_id, p) {
                                    if pb.term.kind == .Goto {
                                        if pb.term.bb0 != j_bb {
                                            preds_ok = false;
                                        }
                                    } else if pb.term.kind == .Branch {
                                        if pb.term.bb0 == pb.term.bb1 {
                                            preds_ok = false;
                                        }
                                    } else {
                                        preds_ok = false;
                                    }
                                } else {
                                    preds_ok = false;
                                }
                                pi = pi +% 1_u32;
                            }

                            // Verify every phi in J is only used by H's phis along edge (J -> H),
                            // and every pred P of J appears in every J phi's incoming list.
                            if preds_ok && j_phis_r.len > 0_u32 {
                                if !uses_ready {
                                    try count_val_uses_fn(alloc, eir_prog, fn_id, init_nvals, &mut use_cnt);
                                    uses_ready = true;
                                }
                                var jpi: u32 = 0_u32;
                                while jpi < j_phis_r.len && preds_ok {
                                    var jp_dst = eir.EIR_NONE;
                                    var jp_inc = ast.range_empty();
                                    if let jpp = eir_prog.funcs.phis.get((j_phis_r.start +% jpi).widen.[usize]()) {
                                        jp_dst = jpp.dst;
                                        jp_inc = jpp.incoming;
                                    }
                                    var h_uses: u32 = 0_u32;
                                    var hpi_u: u32 = 0_u32;
                                    while hpi_u < h_phis_r.len {
                                        if let hpp = eir_prog.funcs.phis.get((h_phis_r.start +% hpi_u).widen.[usize]()) {
                                            let h_inc = hpp.incoming;
                                            var hki: u32 = 0_u32;
                                            while hki < h_inc.len {
                                                if let inp = eir_prog.funcs.phi_in.get((h_inc.start +% hki).widen.[usize]()) {
                                                    if inp.pred_bb == j_bb && inp.val == jp_dst {
                                                        h_uses = h_uses +% 1_u32;
                                                    }
                                                }
                                                hki = hki +% 1_u32;
                                            }
                                        }
                                        hpi_u = hpi_u +% 1_u32;
                                    }
                                    if u32_at(&use_cnt, jp_dst.widen.[usize]()) != h_uses {
                                        preds_ok = false;
                                    } else {
                                        var pk: u32 = 0_u32;
                                        while pk < j_preds_r.len && preds_ok {
                                            var p = eir.EIR_NONE;
                                            if let pp = eir_prog.meta.preds.get((j_preds_r.start +% pk).widen.[usize]()) {
                                                p = pp.*;
                                            }
                                            var found_p = false;
                                            var ki: u32 = 0_u32;
                                            while ki < jp_inc.len {
                                                if let inp = eir_prog.funcs.phi_in.get((jp_inc.start +% ki).widen.[usize]()) {
                                                    if inp.pred_bb == p {
                                                        found_p = true;
                                                        break;
                                                    }
                                                }
                                                ki = ki +% 1_u32;
                                            }
                                            if !found_p {
                                                preds_ok = false;
                                            }
                                            pk = pk +% 1_u32;
                                        }
                                    }
                                    jpi = jpi +% 1_u32;
                                }
                            }

                            if preds_ok {
                                // Snapshot J's preds before rewriting
                                var j_preds_snap = try col.DynBuf.[eir.BlockId].init(alloc, j_preds_r.len.widen.[usize]());
                                errdefer j_preds_snap.destroy(alloc);
                                var ps_i: u32 = 0_u32;
                                while ps_i < j_preds_r.len {
                                    if let pp = eir_prog.meta.preds.get((j_preds_r.start +% ps_i).widen.[usize]()) {
                                        try j_preds_snap.push(alloc, pp.*);
                                    }
                                    ps_i = ps_i +% 1_u32;
                                }

                                // Rebuild H's phis expanding edge (J, val) into (P, resolved_val) for every P in J.preds
                                var new_h_phis = try col.DynBuf.[eir.EirPhi].init(alloc, h_phis_r.len.widen.[usize]());
                                errdefer new_h_phis.destroy(alloc);
                                var new_inc = try col.DynBuf.[eir.EirPhiIn].init(alloc, 8_usize);
                                errdefer new_inc.destroy(alloc);

                                var hpi: u32 = 0_u32;
                                while hpi < h_phis_r.len {
                                    var hp_dst = eir.EIR_NONE;
                                    var hp_ty: types.TyId = types.TY_VOID;
                                    var hp_inc = ast.range_empty();
                                    if let hpp = eir_prog.funcs.phis.get((h_phis_r.start +% hpi).widen.[usize]()) {
                                        hp_dst = hpp.dst;
                                        hp_ty = hpp.ty;
                                        hp_inc = hpp.incoming;
                                    }
                                    new_inc.clear();
                                    var val_from_j = eir.EIR_NONE;
                                    var had_j = false;
                                    var ki: u32 = 0_u32;
                                    while ki < hp_inc.len {
                                        if let inp = eir_prog.funcs.phi_in.get((hp_inc.start +% ki).widen.[usize]()) {
                                            let ent = inp.*;
                                            if ent.pred_bb == j_bb {
                                                val_from_j = ent.val;
                                                had_j = true;
                                            } else {
                                                try new_inc.push(alloc, ent);
                                            }
                                        }
                                        ki = ki +% 1_u32;
                                    }
                                    if had_j {
                                        // Check if `val_from_j` is a phi defined in J
                                        var matched_jp_inc = ast.range_empty();
                                        var is_j_phi = false;
                                        var jpi2: u32 = 0_u32;
                                        while jpi2 < j_phis_r.len {
                                            if let jpp = eir_prog.funcs.phis.get((j_phis_r.start +% jpi2).widen.[usize]()) {
                                                if jpp.dst == val_from_j {
                                                    matched_jp_inc = jpp.incoming;
                                                    is_j_phi = true;
                                                    break;
                                                }
                                            }
                                            jpi2 = jpi2 +% 1_u32;
                                        }
                                        let jps = j_preds_snap.as_slice();
                                        var pk: usize = 0_usize;
                                        while pk < jps.len {
                                            let p = jps[pk];
                                            var resolved = val_from_j;
                                            if is_j_phi {
                                                var mi: u32 = 0_u32;
                                                while mi < matched_jp_inc.len {
                                                    if let inp = eir_prog.funcs.phi_in.get((matched_jp_inc.start +% mi).widen.[usize]()) {
                                                        if inp.pred_bb == p {
                                                            resolved = inp.val;
                                                            break;
                                                        }
                                                    }
                                                    mi = mi +% 1_u32;
                                                }
                                            }
                                            try new_inc.push(alloc, eir.EirPhiIn.{ pred_bb: p, val: resolved });
                                            pk = pk +% 1_usize;
                                        }
                                    }
                                    let nir = try eir_prog.append_phi_incoming(alloc, new_inc.as_slice());
                                    try new_h_phis.push(alloc, eir.EirPhi.{ dst: hp_dst, ty: hp_ty, incoming: nir });
                                    hpi = hpi +% 1_u32;
                                }

                                let new_h_pr = try eir_prog.append_phis(alloc, new_h_phis.as_slice());
                                if let hbm = eir_prog.fn_block_mut(fn_id, h_bb) {
                                    hbm.phis = new_h_pr;
                                }
                                let jps2 = j_preds_snap.as_slice();
                                var pk2: usize = 0_usize;
                                while pk2 < jps2.len {
                                    let p = jps2[pk2];
                                    if let pbm = eir_prog.fn_block_mut(fn_id, p) {
                                        var pt = pbm.term;
                                        _ = rewrite_term_target(eir_prog, &mut pt, j_bb, h_bb);
                                        pbm.term = pt;
                                    }
                                    pk2 = pk2 +% 1_usize;
                                }
                                if let jbm = eir_prog.fn_block_mut(fn_id, j_bb) {
                                    jbm.phis = ast.range_empty();
                                    jbm.term = eir.term_unreachable(span.span_dummy(), false);
                                }
                                new_inc.destroy(alloc);
                                new_h_phis.destroy(alloc);
                                j_preds_snap.destroy(alloc);
                                changed = true;
                                break;
                            }
                        }
                    }
                }
                r3 = r3 +% 1_u32;
            }
        }

        if !changed {
            break;
        }
        any_changed = true;
        try eir_prog.rebuild_fn_rpo(alloc, fn_id);
        try eir_prog.prune_fn_phi_preds(alloc, fn_id);
        try clear_unreachable_blocks(alloc, eir_prog, fn_id);
        round = round +% 1_usize;
    }
    if any_changed {
        _ = try eliminate_copies_fn(alloc, eir_prog, fn_id);
    }

    // 3. Compact unreachable blocks out of `f.blocks` (renumbering reachable blocks to `0..rpo.len`).
    var nblks: usize = 0_usize;
    var rpo_len: usize = 0_usize;
    var old_entry: eir.BlockId = 0_u32;
    if let f = eir_prog.get_fn(fn_id) {
        nblks = f.blocks.len.widen.[usize]();
        rpo_len = f.rpo.len.widen.[usize]();
        old_entry = f.entry;
    }
    if rpo_len > 0_usize && rpo_len < nblks {
        var bb_map = try col.DynBuf.[eir.BlockId].init(alloc, nblks);
        errdefer bb_map.destroy(alloc);
        try fill_u32(alloc, &mut bb_map, nblks, eir.EIR_NONE);
        var rpo_copy = try col.DynBuf.[eir.BlockId].init(alloc, rpo_len);
        errdefer rpo_copy.destroy(alloc);
        let rpo_sl = eir_prog.fn_rpo(fn_id);
        var ri: usize = 0_usize;
        while ri < rpo_sl.len {
            let ob = rpo_sl[ri];
            try rpo_copy.push(alloc, ob);
            u32_set(&mut bb_map, ob.widen.[usize](), ri.trunc.[u32]());
            ri = ri +% 1_usize;
        }

        var comp_blks = try col.DynBuf.[eir.EirBlock].init(alloc, rpo_len);
        errdefer comp_blks.destroy(alloc);
        var tmp_inc = try col.DynBuf.[eir.EirPhiIn].init(alloc, 8_usize);
        errdefer tmp_inc.destroy(alloc);

        var ni: usize = 0_usize;
        while ni < rpo_copy.len() {
            let ob = u32_at(&rpo_copy, ni);
            var blk = eir.EirBlock.{
                id: ni.trunc.[u32](),
                phis: ast.range_empty(),
                insts: ast.range_empty(),
                term: eir.term_unreachable(span.span_dummy(), false),
                preds: ast.range_empty(),
                idom: eir.EIR_NONE,
            };
            if let bp = eir_prog.fn_block(fn_id, ob) {
                blk = bp.*;
            }
            blk.id = ni.trunc.[u32]();

            // Remap Phi incoming pred_bbs in-place (always <= old lengths!).
            if blk.phis.len > 0_u32 {
                var pi: u32 = 0_u32;
                while pi < blk.phis.len {
                    let phi_gid = (blk.phis.start +% pi).widen.[usize]();
                    if let pp = eir_prog.funcs.phis.get(phi_gid) {
                        let phi = pp.*;
                        tmp_inc.clear();
                        var ki: u32 = 0_u32;
                        while ki < phi.incoming.len {
                            if let inp = eir_prog.funcs.phi_in.get((phi.incoming.start +% ki).widen.[usize]()) {
                                let ent = inp.*;
                                let mp = u32_at(&bb_map, ent.pred_bb.widen.[usize]());
                                if mp != eir.EIR_NONE {
                                    try tmp_inc.push(alloc, eir.EirPhiIn.{ pred_bb: mp, val: ent.val });
                                }
                            }
                            ki = ki +% 1_u32;
                        }
                        let tis = tmp_inc.as_slice();
                        let pin_mut = eir_prog.funcs.phi_in.as_mut_slice();
                        let ibase = phi.incoming.start.widen.[usize]();
                        var wi_i: usize = 0_usize;
                        while wi_i < tis.len {
                            let pos = ibase +% wi_i;
                            if pos < pin_mut.len {
                                pin_mut[pos] = tis[wi_i];
                            }
                            wi_i = wi_i +% 1_usize;
                        }
                        if let ppm = eir_prog.funcs.phis.get_mut(phi_gid) {
                            ppm.incoming = ast.range_new(phi.incoming.start, tis.len.trunc.[u32]());
                        }
                    }
                    pi = pi +% 1_u32;
                }
            }

            // Remap Terminator targets in-place.
            match blk.term.kind {
                .Goto => { blk.term.bb0 = u32_at(&bb_map, blk.term.bb0.widen.[usize]()); }
                .Branch => {
                    blk.term.bb0 = u32_at(&bb_map, blk.term.bb0.widen.[usize]());
                    blk.term.bb1 = u32_at(&bb_map, blk.term.bb1.widen.[usize]());
                }
                .SwitchInt => {
                    blk.term.bb0 = u32_at(&bb_map, blk.term.bb0.widen.[usize]());
                    let sw_mut = eir_prog.funcs.switch_targets.as_mut_slice();
                    let sw_base = blk.term.targets.start.widen.[usize]();
                    var ti: usize = 0_usize;
                    while ti < blk.term.targets.len.widen.[usize]() {
                        let pos = sw_base +% ti;
                        if pos < sw_mut.len {
                            sw_mut[pos].target = u32_at(&bb_map, sw_mut[pos].target.widen.[usize]());
                        }
                        ti = ti +% 1_usize;
                    }
                }
                _ => {}
            }
            try comp_blks.push(alloc, blk);
            ni = ni +% 1_usize;
        }

        var old_blks_r = ast.range_empty();
        if let f_ro = eir_prog.get_fn(fn_id) {
            old_blks_r = f_ro.blocks;
        }
        let cb_sl = comp_blks.as_slice();
        let new_entry = u32_at(&bb_map, old_entry.widen.[usize]());
        if cb_sl.len <= old_blks_r.len.widen.[usize]() {
            let b_dst = eir_prog.funcs.blocks.as_mut_slice();
            let b_base = old_blks_r.start.widen.[usize]();
            var bi_w: usize = 0_usize;
            while bi_w < cb_sl.len {
                let pos = b_base +% bi_w;
                if pos < b_dst.len {
                    b_dst[pos] = cb_sl[bi_w];
                }
                bi_w = bi_w +% 1_usize;
            }
            if let fm = eir_prog.get_fn_mut(fn_id) {
                fm.blocks = ast.range_new(old_blks_r.start, cb_sl.len.trunc.[u32]());
                fm.entry = new_entry;
            }
        } else {
            let new_br = try eir_prog.append_blocks(alloc, cb_sl);
            if let fm = eir_prog.get_fn_mut(fn_id) {
                fm.blocks = new_br;
                fm.entry = new_entry;
            }
        }
        try eir_prog.rebuild_fn_rpo(alloc, fn_id);
        try eir_prog.prune_fn_phi_preds(alloc, fn_id);

        tmp_inc.destroy(alloc);
        comp_blks.destroy(alloc);
        rpo_copy.destroy(alloc);
        bb_map.destroy(alloc);
        any_changed = true;
    }
    use_cnt.destroy(alloc);
    redir.destroy(alloc);
    touched.destroy(alloc);
    dead_bb.destroy(alloc);
    merged_flags.destroy(alloc);
    merged_insts.destroy(alloc);
    return any_changed;
}

fn pass_adce_cfg_simplify(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    stats: *mut OptStats,
) -> !OutOfMemory {
    let nfns = eir_prog.fn_count();
    var fi: u32 = 0_u32;
    while fi < nfns {
        if !is_stub_fn(eir_prog, fi) {
            let c1 = try eliminate_copies_fn(alloc, eir_prog, fi);
            stats.dce_removed = stats.dce_removed +% c1;
            let c2 = try adce_fn(alloc, eir_prog, fi, env);
            stats.dce_removed = stats.dce_removed +% c2;
            let cfg_ch = try simplify_cfg_fn(alloc, eir_prog, fi);
            if cfg_ch {
                let c3 = try adce_fn(alloc, eir_prog, fi, env);
                stats.dce_removed = stats.dce_removed +% c3;
            }
            try compute_and_set_loop_depths(alloc, eir_prog, fi);
        }
        fi = fi +% 1_u32;
    }
    return;
}

// ===========================================================================
// Public Entry Point: `optimize_program`
// ===========================================================================

fn print_opt_pass_line(
    alloc: *mut AllocCap,
    clock: *ClockCap,
    name: *str,
    t0: u64,
    u0: usize,
) -> !OutOfMemory {
    let dt_ns = rt.now_ns(clock) -% t0;
    let ms_whole = dt_ns / 1000000_u64;
    let ms_frac = (dt_ns % 1000000_u64) / 10000_u64;
    let u1 = alloc.used_bytes();
    let pk = alloc.peak_bytes();
    var sb = try str.StrBuf.init(alloc, 128_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, "[profile-opt] ");
    try sb.push_str_grow(alloc, name);
    try sb.push_str_grow(alloc, ": wall=");
    try sb.push_u64_grow(alloc, ms_whole);
    try sb.push_byte_grow(alloc, b'.');
    if ms_frac < 10_u64 {
        try sb.push_byte_grow(alloc, b'0');
    }
    try sb.push_u64_grow(alloc, ms_frac);
    try sb.push_str_grow(alloc, "ms used=");
    try sb.push_u64_grow(alloc, (u1 / 1024_usize).widen.[u64]());
    try sb.push_str_grow(alloc, "KiB (delta=");
    if u1 >= u0 {
        try sb.push_byte_grow(alloc, b'+');
        try sb.push_u64_grow(alloc, ((u1 - u0) / 1024_usize).widen.[u64]());
    } else {
        try sb.push_byte_grow(alloc, b'-');
        try sb.push_u64_grow(alloc, ((u0 - u1) / 1024_usize).widen.[u64]());
    }
    try sb.push_str_grow(alloc, "KiB) peak=");
    try sb.push_u64_grow(alloc, (pk / 1024_usize).widen.[u64]());
    try sb.push_str_grow(alloc, "KiB\n");
    rt.eprint_bytes(sb.as_bytes());
    sb.destroy(alloc);
    return;
}

pub fn optimize_program(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    cfg: eir.EirOptConfig,
    err_out: *mut str.StrBuf,
) -> OptStats ! OutOfMemory {
    return try optimize_program_with_jobs(alloc, eir_prog, env, interner, cfg, err_out, 0_u32);
}

pub fn optimize_program_with_jobs(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    cfg: eir.EirOptConfig,
    err_out: *mut str.StrBuf,
    jobs: u32,
) -> OptStats ! OutOfMemory {
    if cfg.opt_level == 0_u8 {
        return opt_stats_zero();
    }
    if cfg.opt_bisect >= 0_i64 || cfg.verify_opt {
        return try optimize_program_impl(alloc, null, false, eir_prog, env, interner, cfg, err_out);
    }
    return try optimize_program_parallel(alloc, null, false, eir_prog, env, cfg, jobs);
}

pub fn optimize_program_profiled(
    alloc: *mut AllocCap,
    clock: *ClockCap,
    profile_passes: bool,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    cfg: eir.EirOptConfig,
    err_out: *mut str.StrBuf,
) -> OptStats ! OutOfMemory {
    return try optimize_program_profiled_with_jobs(
        alloc, clock, profile_passes, eir_prog, env, interner, cfg, err_out, 0_u32,
    );
}

pub fn optimize_program_profiled_with_jobs(
    alloc: *mut AllocCap,
    clock: *ClockCap,
    profile_passes: bool,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    cfg: eir.EirOptConfig,
    err_out: *mut str.StrBuf,
    jobs: u32,
) -> OptStats ! OutOfMemory {
    if cfg.opt_level == 0_u8 {
        return opt_stats_zero();
    }
    if cfg.opt_bisect >= 0_i64 || cfg.verify_opt {
        return try optimize_program_impl(alloc, clock, profile_passes, eir_prog, env, interner, cfg, err_out);
    }
    return try optimize_program_parallel(alloc, clock, profile_passes, eir_prog, env, cfg, jobs);
}

// ===========================================================================
// Section 13: Parallel 12-Worker SSA Optimizer (Split-Program Inliner + Stages 1/2/3)
// ===========================================================================

fn merge_opt_stats(dst: *mut OptStats, src: *OptStats) {
    dst.passes_run = dst.passes_run +% src.passes_run;
    dst.inlined_calls = dst.inlined_calls +% src.inlined_calls;
    dst.sroa_slots = dst.sroa_slots +% src.sroa_slots;
    dst.mem2reg_slots = dst.mem2reg_slots +% src.mem2reg_slots;
    dst.folded_consts = dst.folded_consts +% src.folded_consts;
    dst.gvn_eliminated = dst.gvn_eliminated +% src.gvn_eliminated;
    dst.licm_hoisted = dst.licm_hoisted +% src.licm_hoisted;
    dst.dbm_checks_eliminated = dst.dbm_checks_eliminated +% src.dbm_checks_eliminated;
    dst.fused_pool_loops = dst.fused_pool_loops +% src.fused_pool_loops;
    dst.tail_calls_eliminated = dst.tail_calls_eliminated +% src.tail_calls_eliminated;
    dst.devirt_calls = dst.devirt_calls +% src.devirt_calls;
    dst.dce_removed = dst.dce_removed +% src.dce_removed;
}

fn clone_and_remap_val_range_split(
    alloc: *mut AllocCap,
    dst_eir: *mut eir.EirProgram,
    src_eir: *eir.EirProgram,
    r: ast.IdRange,
    val_map: *[eir.EirValue],
) -> ast.IdRange ! OutOfMemory {
    if r.len == 0_u32 {
        return ast.range_empty();
    }
    var buf = try col.DynBuf.[eir.EirValue].init(alloc, r.len.widen.[usize]());
    errdefer buf.destroy(alloc);
    var i: u32 = 0_u32;
    while i < r.len {
        var v = eir.EIR_NONE;
        if let vp = src_eir.exprs.vals.get((r.start +% i).widen.[usize]()) {
            v = vp.*;
        }
        try buf.push(alloc, remap_id(v, val_map));
        i = i +% 1_u32;
    }
    let out = try dst_eir.append_vals(alloc, buf.as_slice());
    buf.destroy(alloc);
    return out;
}

fn clone_and_remap_slot_range_split(
    alloc: *mut AllocCap,
    dst_eir: *mut eir.EirProgram,
    src_eir: *eir.EirProgram,
    r: ast.IdRange,
    slot_map: *[eir.EirSlot],
) -> ast.IdRange ! OutOfMemory {
    if r.len == 0_u32 {
        return ast.range_empty();
    }
    var buf = try col.DynBuf.[eir.EirSlot].init(alloc, r.len.widen.[usize]());
    errdefer buf.destroy(alloc);
    var i: u32 = 0_u32;
    while i < r.len {
        var s = eir.EIR_NONE;
        if let sp = src_eir.exprs.arg_slots.get((r.start +% i).widen.[usize]()) {
            s = sp.*;
        }
        try buf.push(alloc, remap_id(s, slot_map));
        i = i +% 1_u32;
    }
    let out = try dst_eir.append_arg_slots(alloc, buf.as_slice());
    buf.destroy(alloc);
    return out;
}

fn clone_and_remap_place_split(
    alloc: *mut AllocCap,
    dst_eir: *mut eir.EirProgram,
    src_eir: *eir.EirProgram,
    place_id: u32,
    val_map: *[eir.EirValue],
    slot_map: *[eir.EirSlot],
) -> u32 ! OutOfMemory {
    var pl = eir.EirPlace.{
        base: eir.place_base_slot(0_u32),
        projs: ast.range_empty(),
        ty: types.TY_VOID,
    };
    if let pp = src_eir.get_place(place_id) {
        pl = pp.*;
    }
    if pl.base.kind == .Slot {
        pl.base.id = remap_id(pl.base.id, slot_map);
    } else {
        pl.base.id = remap_id(pl.base.id, val_map);
    }
    var pbuf = try col.DynBuf.[eir.EirProj].init(alloc, max_usize(pl.projs.len.widen.[usize](), 1_usize));
    errdefer pbuf.destroy(alloc);
    var i: u32 = 0_u32;
    while i < pl.projs.len {
        if let prp = src_eir.exprs.projs.get((pl.projs.start +% i).widen.[usize]()) {
            var pr = prp.*;
            if pr.kind == .Index {
                pr.index = remap_id(pr.index, val_map);
            }
            try pbuf.push(alloc, pr);
        }
        i = i +% 1_u32;
    }
    pl.projs = try dst_eir.append_projs(alloc, pbuf.as_slice());
    let pid = try dst_eir.push_place(alloc, pl);
    pbuf.destroy(alloc);
    return pid;
}

fn clone_and_remap_pool_op_split(
    alloc: *mut AllocCap,
    dst_eir: *mut eir.EirProgram,
    src_eir: *eir.EirProgram,
    op_id: u32,
    val_map: *[eir.EirValue],
    slot_map: *[eir.EirSlot],
) -> u32 ! OutOfMemory {
    var op = eir.EirPoolColOp.{
        pool_base: eir.place_base_slot(0_u32),
        pool_is_ptr: false,
        is_slot_pool: false,
        col: span.SYM_EMPTY,
        col_idx: 0_u32,
        index: eir.EIR_NONE,
        elem_ty: types.TY_VOID,
    };
    if let opp = src_eir.get_pool_col_op(op_id) {
        op = opp.*;
    }
    if op.pool_base.kind == .Slot {
        op.pool_base.id = remap_id(op.pool_base.id, slot_map);
    } else {
        op.pool_base.id = remap_id(op.pool_base.id, val_map);
    }
    op.index = remap_id(op.index, val_map);
    return try dst_eir.push_pool_col_op(alloc, op);
}

fn clone_and_remap_inst_split(
    alloc: *mut AllocCap,
    dst_eir: *mut eir.EirProgram,
    src_eir: *eir.EirProgram,
    orig: *eir.EirInst,
    val_map: *[eir.EirValue],
    slot_map: *[eir.EirSlot],
) -> eir.EirInst ! OutOfMemory {
    var inst = orig.*;
    if inst.dst != eir.EIR_NONE {
        inst.dst = remap_id(inst.dst, val_map);
    }
    match inst.kind {
        .Const => {
            if let kp = src_eir.get_const(inst.aux0) {
                var kc = kp.*;
                if (kc.kind == .Float || kc.kind == .Str || kc.kind == .Bytes) && kc.bytes.len > 0_u32 {
                    kc.bytes = try dst_eir.add_bytes(alloc, src_eir.bytes_slice(kc.bytes));
                }
                inst.aux0 = try dst_eir.add_const(alloc, kc);
            }
            _ = 0_u8;
        }
        .ParForHint => {}
        .Copy => { inst.v0 = remap_id(inst.v0, val_map); }
        .LoadSlot => { inst.aux0 = remap_id(inst.aux0, slot_map); }
        .StoreSlot => {
            inst.aux0 = remap_id(inst.aux0, slot_map);
            inst.v0 = remap_id(inst.v0, val_map);
        }
        .SlotAddr => { inst.aux0 = remap_id(inst.aux0, slot_map); }
        .LoadPlace => {
            inst.aux0 = try clone_and_remap_place_split(alloc, dst_eir, src_eir, inst.aux0, val_map, slot_map);
        }
        .PlaceAddr => {
            inst.aux0 = try clone_and_remap_place_split(alloc, dst_eir, src_eir, inst.aux0, val_map, slot_map);
        }
        .StorePlace => {
            inst.aux0 = try clone_and_remap_place_split(alloc, dst_eir, src_eir, inst.aux0, val_map, slot_map);
            inst.v0 = remap_id(inst.v0, val_map);
        }
        .PoolColumnLoad => {
            inst.aux0 = try clone_and_remap_pool_op_split(alloc, dst_eir, src_eir, inst.aux0, val_map, slot_map);
        }
        .PoolColumnStore => {
            inst.aux0 = try clone_and_remap_pool_op_split(alloc, dst_eir, src_eir, inst.aux0, val_map, slot_map);
            inst.v0 = remap_id(inst.v0, val_map);
        }
        .Unary => { inst.v0 = remap_id(inst.v0, val_map); }
        .Cast => { inst.v0 = remap_id(inst.v0, val_map); }
        .Binary => {
            inst.v0 = remap_id(inst.v0, val_map);
            inst.v1 = remap_id(inst.v1, val_map);
        }
        .Slice => {
            inst.v0 = remap_id(inst.v0, val_map);
            if inst.v1 != eir.EIR_NONE {
                inst.v1 = remap_id(inst.v1, val_map);
            }
            if inst.v2 != eir.EIR_NONE {
                inst.v2 = remap_id(inst.v2, val_map);
            }
        }
        .Aggregate => {
            if let akp = src_eir.get_aggregate(inst.aux0) {
                var ak = akp.*;
                if ak.field_syms.len > 0_u32 {
                    ak.field_syms = try dst_eir.add_syms(alloc, src_eir.syms_slice(ak.field_syms));
                }
                inst.aux0 = try dst_eir.add_aggregate(alloc, ak);
            }
            inst.range = try clone_and_remap_val_range_split(alloc, dst_eir, src_eir, inst.range, val_map);
        }
        .UnwrapOptional => { inst.v0 = remap_id(inst.v0, val_map); }
        .UnwrapErrorOk => { inst.v0 = remap_id(inst.v0, val_map); }
        .UnwrapErrorErr => { inst.v0 = remap_id(inst.v0, val_map); }
        .IsNonNull => { inst.v0 = remap_id(inst.v0, val_map); }
        .IsError => { inst.v0 = remap_id(inst.v0, val_map); }
        .MatchTag => { inst.v0 = remap_id(inst.v0, val_map); }
        .FieldExtract => { inst.v0 = remap_id(inst.v0, val_map); }
        .MakeDyn => { inst.v0 = remap_id(inst.v0, val_map); }
        .MakeClosure => {
            if inst.v0 != eir.EIR_NONE {
                inst.v0 = remap_id(inst.v0, val_map);
            }
        }
        .Call => {
            var cd = eir.EirCallData.{
                callee: eir.callee_direct_fn(0_u32),
                args: ast.range_empty(),
                ret_ty: types.TY_VOID,
            };
            if let cdp = src_eir.get_call(inst.aux0) {
                cd = cdp.*;
            }
            if cd.callee.kind == .FnPtr {
                cd.callee.a = remap_id(cd.callee.a, val_map);
            }
            let new_args = try clone_and_remap_val_range_split(alloc, dst_eir, src_eir, cd.args, val_map);
            cd.args = new_args;
            inst.aux0 = try dst_eir.push_call(alloc, cd);
            inst.range = new_args;
        }
        .BuiltinCall => {
            var bc = eir.EirBuiltinCallData.{
                op: cfg_ir.builtin_op_simple(.ArenaInit),
                args: ast.range_empty(),
                arg_slots: ast.range_empty(),
                ret_ty: types.TY_VOID,
            };
            if let bcp = src_eir.get_builtin_call(inst.aux0) {
                bc = bcp.*;
            }
            let new_args = try clone_and_remap_val_range_split(alloc, dst_eir, src_eir, bc.args, val_map);
            let new_slots = try clone_and_remap_slot_range_split(alloc, dst_eir, src_eir, bc.arg_slots, slot_map);
            bc.args = new_args;
            bc.arg_slots = new_slots;
            inst.aux0 = try dst_eir.push_builtin_call(alloc, bc);
            inst.range = new_args;
        }
        .InlineAsm => {
            var ad = eir.EirInlineAsmData.{ template: ast.range_empty(), inputs: ast.range_empty() };
            if let adp = src_eir.get_asm(inst.aux0) {
                ad = adp.*;
            }
            ad.template = try dst_eir.add_bytes(alloc, src_eir.bytes_slice(ad.template));
            var inps = try col.DynBuf.[eir.EirAsmInput].init(alloc, max_usize(ad.inputs.len.widen.[usize](), 1_usize));
            errdefer inps.destroy(alloc);
            var ki: u32 = 0_u32;
            while ki < ad.inputs.len {
                if let ip = src_eir.meta.asm_inputs.get((ad.inputs.start +% ki).widen.[usize]()) {
                    var inp = ip.*;
                    inp.name = try dst_eir.add_bytes(alloc, src_eir.bytes_slice(inp.name));
                    inp.val = remap_id(inp.val, val_map);
                    try inps.push(alloc, inp);
                }
                ki = ki +% 1_u32;
            }
            ad.inputs = try dst_eir.add_asm_inputs(alloc, inps.as_slice());
            inst.aux0 = try dst_eir.add_asm(alloc, ad);
            inps.destroy(alloc);
        }
        _ => {}
    }
    return inst;
}

fn callee_eligible_for_inline_split(
    caller_eir: *eir.EirProgram,
    caller_fid: u32,
    orig_caller_fid: u32,
    callee_eir: *eir.EirProgram,
    callee_fid: u32,
    caller_insts: usize,
    callee_insts: usize,
    in_loop: bool,
    callsites: u32,
    is_rec: *col.BitSet,
    has_asm: *col.BitSet,
    call_inst: *eir.EirInst,
    cd: *eir.EirCallData,
    incremental_cgu: bool,
) -> bool {
    if callee_fid == orig_caller_fid {
        return false;
    }
    let cu = callee_fid.widen.[usize]();
    if is_rec.test(cu) || has_asm.test(cu) {
        return false;
    }
    let cf = callee_eir.get_fn(callee_fid) orelse {
        return false;
    };
    if incremental_cgu
        && !cf.sig.effects.is_inline
        && cf.key.kind != .GenericInst
        && cf.key.kind != .Closure
    {
        return false;
    }
    if is_opt_protected_fn(cf)
        || cf.sig.effects.is_recursive
        || cf.sig.effects.is_export_c
        || has_par_for(cf)
        || cf.blocks.len == 0_u32
        || cf.rpo.len == 0_u32
    {
        return false;
    }
    let max_caller: usize = if cf.sig.effects.is_inline {
        4000_usize
    } else if callee_insts <= 32_usize {
        3000_usize
    } else if cf.is_sys {
        1600_usize
    } else {
        1200_usize
    };
    if caller_insts +% callee_insts > max_caller {
        return false;
    }
    var budget: usize = 55_usize;
    if cf.sig.effects.is_inline {
        budget = 420_usize;
    }
    if in_loop || callsites <= 1_u32 {
        if budget < 140_usize {
            budget = 140_usize;
        }
        if cf.is_sys && budget < 280_usize {
            budget = 280_usize;
        }
    }
    if callee_insts > budget {
        return false;
    }
    if !cf.is_sys && !cf.sig.effects.is_inline && in_loop && callee_insts > 75_usize && fn_has_loop_quick(callee_eir, callee_fid) {
        return false;
    }
    let cparams = callee_eir.fn_params(callee_fid);
    if cparams.len != cd.args.len.widen.[usize]() {
        return false;
    }
    let cargs = caller_eir.vals_slice(cd.args);
    if cparams.len != cargs.len {
        return false;
    }
    var pi: usize = 0_usize;
    while pi < cparams.len && pi < cargs.len {
        let pty = callee_eir.fn_val_ty(callee_fid, cparams[pi]);
        let aty = caller_eir.fn_val_ty(caller_fid, cargs[pi]);
        if pty != aty {
            return false;
        }
        pi = pi +% 1_usize;
    }
    if call_inst.dst != eir.EIR_NONE {
        let dst_ty = caller_eir.fn_val_ty(caller_fid, call_inst.dst);
        if dst_ty != cf.sig.ret {
            return false;
        }
        let crpo = callee_eir.fn_rpo(callee_fid);
        var ri: usize = 0_usize;
        while ri < crpo.len {
            if let bp = callee_eir.fn_block(callee_fid, crpo[ri]) {
                if bp.term.kind == .Return {
                    if !bp.term.flag || callee_eir.fn_val_ty(callee_fid, bp.term.val) != dst_ty {
                        return false;
                    }
                }
            }
            ri = ri +% 1_usize;
        }
    }
    return true;
}

fn find_inline_site_from_split(
    caller_eir: *eir.EirProgram,
    caller_fid: u32,
    orig_caller_fid: u32,
    callee_eir: *eir.EirProgram,
    start_ri: usize,
    cur_caller_sz: usize,
    in_loop: *col.BitSet,
    fn_sizes: *col.DynBuf[u32],
    callsite_cnt: *col.DynBuf[u32],
    is_rec: *col.BitSet,
    has_asm: *col.BitSet,
    incremental_cgu: bool,
) -> InlineSiteFound {
    var res = InlineSiteFound.{ found: false, ri: 0_usize, bb: 0_u32, ii: 0_u32, callee: 0_u32 };
    let rpo = caller_eir.fn_rpo(caller_fid);
    var ri = start_ri;
    while ri < rpo.len && !res.found {
        let bb = rpo[ri];
        let bb_in_loop = in_loop.test(bb.widen.[usize]());
        let insts = caller_eir.block_insts(caller_fid, bb);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let inst = insts[ii];
            if inst.kind == .Call {
                if let cd = caller_eir.get_call(inst.aux0) {
                    if let cfid = resolve_direct_callee_fn(callee_eir, cd.callee) {
                        let cu = cfid.widen.[usize]();
                        let csz = u32_at(fn_sizes, cu).widen.[usize]();
                        let csites = u32_at(callsite_cnt, cu);
                        if callee_eligible_for_inline_split(
                            caller_eir, caller_fid, orig_caller_fid, callee_eir, cfid, cur_caller_sz, csz,
                            bb_in_loop, csites, is_rec, has_asm, &inst, cd, incremental_cgu,
                        ) {
                            res = InlineSiteFound.{
                                found: true,
                                ri: ri,
                                bb: bb,
                                ii: ii.trunc.[u32](),
                                callee: cfid,
                            };
                            break;
                        }
                    }
                }
            }
            ii = ii +% 1_usize;
        }
        ri = ri +% 1_usize;
    }
    return res;
}

fn inline_call_site_split(
    alloc: *mut AllocCap,
    caller_eir: *mut eir.EirProgram,
    caller_fid: u32,
    callee_eir: *eir.EirProgram,
    callee_fid: u32,
    call_bb: eir.BlockId,
    call_ii: u32,
    acc_fact_dsts: *mut col.DynBuf[eir.EirValue],
    acc_fact_vals: *mut col.DynBuf[eir.EirValueFact],
) -> u8 ! OutOfMemory {
    var call_inst = eir.inst_zero(span.span_dummy(), .ParForHint);
    var call_insts_r = ast.range_empty();
    var call_term = eir.term_unreachable(span.span_dummy(), false);
    if let cb = caller_eir.fn_block(caller_fid, call_bb) {
        call_insts_r = cb.insts;
        call_term = cb.term;
    } else {
        return 0_u8;
    }
    if call_ii >= call_insts_r.len {
        return 0_u8;
    }
    if let ip = caller_eir.funcs.insts.get((call_insts_r.start +% call_ii).widen.[usize]()) {
        call_inst = ip.*;
    } else {
        return 0_u8;
    }
    if call_inst.kind != .Call {
        return 0_u8;
    }
    var cd_args_r = ast.range_empty();
    if let cd = caller_eir.get_call(call_inst.aux0) {
        cd_args_r = cd.args;
    } else {
        return 0_u8;
    }

    var callee_nvals: usize = 0_usize;
    var callee_nslots: usize = 0_usize;
    var callee_nblks: usize = 0_usize;
    var callee_entry: eir.BlockId = 0_u32;
    var callee_rpo_r = ast.range_empty();
    var callee_slots_r = ast.range_empty();
    var callee_vtys_r = ast.range_empty();
    var callee_params_r = ast.range_empty();
    if let cf = callee_eir.get_fn(callee_fid) {
        callee_nvals = cf.value_tys.len.widen.[usize]();
        callee_nslots = cf.slots.len.widen.[usize]();
        callee_nblks = cf.blocks.len.widen.[usize]();
        callee_entry = cf.entry;
        callee_rpo_r = cf.rpo;
        callee_slots_r = cf.slots;
        callee_vtys_r = cf.value_tys;
        callee_params_r = cf.params;
    } else {
        return 0_u8;
    }
    if callee_rpo_r.len == 0_u32 {
        return 0_u8;
    }

    var orig_caller_nblks: u32 = 0_u32;
    var orig_caller_blks_r = ast.range_empty();
    if let f = caller_eir.get_fn(caller_fid) {
        orig_caller_nblks = f.blocks.len;
        orig_caller_blks_r = f.blocks;
    }

    var slot_map = try col.DynBuf.[eir.EirSlot].init(alloc, max_usize(callee_nslots, 1_usize));
    errdefer slot_map.destroy(alloc);
    var si: u32 = 0_u32;
    while si < callee_slots_r.len {
        var sinfo = eir.EirSlotInfo.{
            id: 0_u32,
            ty: types.TY_VOID,
            has_name: false,
            name: span.SYM_EMPTY,
            is_mut: true,
        };
        if let sp = callee_eir.funcs.slots.get((callee_slots_r.start +% si).widen.[usize]()) {
            sinfo = sp.*;
        }
        let ns = try caller_eir.alloc_fn_slot(alloc, caller_fid, sinfo);
        try slot_map.push(alloc, ns);
        si = si +% 1_u32;
    }

    var val_map = try col.DynBuf.[eir.EirValue].init(alloc, max_usize(callee_nvals, 1_usize));
    errdefer val_map.destroy(alloc);
    try fill_u32(alloc, &mut val_map, callee_nvals, eir.EIR_NONE);

    var pi: u32 = 0_u32;
    while pi < callee_params_r.len && pi < cd_args_r.len {
        var cpv = eir.EIR_NONE;
        var cav = eir.EIR_NONE;
        if let pvp = callee_eir.funcs.param_vals.get((callee_params_r.start +% pi).widen.[usize]()) {
            cpv = pvp.*;
        }
        if let avp = caller_eir.exprs.vals.get((cd_args_r.start +% pi).widen.[usize]()) {
            cav = avp.*;
        }
        if cpv != eir.EIR_NONE && cpv.widen.[usize]() < callee_nvals {
            u32_set(&mut val_map, cpv.widen.[usize](), cav);
        }
        pi = pi +% 1_u32;
    }

    var cri: u32 = 0_u32;
    while cri < callee_rpo_r.len {
        var cbb: eir.BlockId = 0_u32;
        if let bp = callee_eir.meta.rpo.get((callee_rpo_r.start +% cri).widen.[usize]()) {
            cbb = bp.*;
        }
        var cphis_r = ast.range_empty();
        var cinsts_r = ast.range_empty();
        if let cblk = callee_eir.fn_block(callee_fid, cbb) {
            cphis_r = cblk.phis;
            cinsts_r = cblk.insts;
        }
        var cpi: u32 = 0_u32;
        while cpi < cphis_r.len {
            var pdst = eir.EIR_NONE;
            var pty = types.TY_ERROR;
            if let pp = callee_eir.funcs.phis.get((cphis_r.start +% cpi).widen.[usize]()) {
                pdst = pp.dst;
                pty = pp.ty;
            }
            let pdu = pdst.widen.[usize]();
            if pdst != eir.EIR_NONE && pdu < callee_nvals && u32_at(&val_map, pdu) == eir.EIR_NONE {
                let nv = try caller_eir.alloc_fn_value(alloc, caller_fid, pty);
                u32_set(&mut val_map, pdu, nv);
                let fact = callee_eir.fn_val_fact(callee_fid, pdst);
                if fact.has_range || fact.non_neg || fact.non_zero || fact.is_const || fact.fits_u32 || fact.fits_i32 {
                    try acc_fact_dsts.push(alloc, nv);
                    try acc_fact_vals.push(alloc, fact);
                }
            }
            cpi = cpi +% 1_u32;
        }
        var cii: u32 = 0_u32;
        while cii < cinsts_r.len {
            var d = eir.EIR_NONE;
            if let ip = callee_eir.funcs.insts.get((cinsts_r.start +% cii).widen.[usize]()) {
                d = eir.inst_def(ip);
            }
            let du = d.widen.[usize]();
            if d != eir.EIR_NONE && du < callee_nvals && u32_at(&val_map, du) == eir.EIR_NONE {
                var dty = types.TY_VOID;
                if let tp = callee_eir.funcs.value_tys.get((callee_vtys_r.start +% d).widen.[usize]()) {
                    dty = tp.*;
                }
                let nv = try caller_eir.alloc_fn_value(alloc, caller_fid, dty);
                u32_set(&mut val_map, du, nv);
                let fact = callee_eir.fn_val_fact(callee_fid, d);
                if fact.has_range || fact.non_neg || fact.non_zero || fact.is_const || fact.fits_u32 || fact.fits_i32 {
                    try acc_fact_dsts.push(alloc, nv);
                    try acc_fact_vals.push(alloc, fact);
                }
            }
            cii = cii +% 1_u32;
        }
        cri = cri +% 1_u32;
    }

    if callee_rpo_r.len == 1_u32 {
        var cbb0: eir.BlockId = eir.EIR_NONE;
        if let bp = callee_eir.meta.rpo.get(callee_rpo_r.start.widen.[usize]()) {
            cbb0 = bp.*;
        }
        if cbb0 == callee_entry {
            var cphis0 = ast.range_empty();
            var cinsts0 = ast.range_empty();
            var cterm0 = eir.term_unreachable(span.span_dummy(), false);
            if let cblk0 = callee_eir.fn_block(callee_fid, cbb0) {
                cphis0 = cblk0.phis;
                cinsts0 = cblk0.insts;
                cterm0 = cblk0.term;
            }
            if cphis0.len == 0_u32 && cterm0.kind == .Return && (call_inst.dst == eir.EIR_NONE || cterm0.flag) {
                let total_cap = call_insts_r.len.widen.[usize]() +% cinsts0.len.widen.[usize]() +% 2_usize;
                var spl_insts = try col.DynBuf.[eir.EirInst].init(alloc, total_cap);
                errdefer spl_insts.destroy(alloc);
                var spl_flags = try col.DynBuf.[u8].init(alloc, total_cap);
                errdefer spl_flags.destroy(alloc);

                var pre_i: u32 = 0_u32;
                while pre_i < call_ii {
                    let gid = call_insts_r.start +% pre_i;
                    if let ip = caller_eir.funcs.insts.get(gid.widen.[usize]()) {
                        try spl_insts.push(alloc, ip.*);
                        try spl_flags.push(alloc, caller_eir.inst_proven_flags(gid));
                    }
                    pre_i = pre_i +% 1_u32;
                }
                var kii0: u32 = 0_u32;
                while kii0 < cinsts0.len {
                    let old_gid = cinsts0.start +% kii0;
                    if let ip = callee_eir.funcs.insts.get(old_gid.widen.[usize]()) {
                        let orig_i = ip.*;
                        let old_fl = callee_eir.inst_proven_flags(old_gid);
                        let cloned = try clone_and_remap_inst_split(
                            alloc, caller_eir, callee_eir, &orig_i, val_map.as_slice(), slot_map.as_slice(),
                        );
                        try spl_insts.push(alloc, cloned);
                        try spl_flags.push(alloc, old_fl);
                    }
                    kii0 = kii0 +% 1_u32;
                }
                if call_inst.dst != eir.EIR_NONE {
                    let rv = remap_id(cterm0.val, val_map.as_slice());
                    var cpy = eir.inst_zero(call_inst.span, .Copy);
                    cpy.dst = call_inst.dst;
                    cpy.v0 = rv;
                    try spl_insts.push(alloc, cpy);
                    try spl_flags.push(alloc, 0_u8);
                }
                var post_i: u32 = call_ii +% 1_u32;
                while post_i < call_insts_r.len {
                    let gid = call_insts_r.start +% post_i;
                    if let ip = caller_eir.funcs.insts.get(gid.widen.[usize]()) {
                        try spl_insts.push(alloc, ip.*);
                        try spl_flags.push(alloc, caller_eir.inst_proven_flags(gid));
                    }
                    post_i = post_i +% 1_u32;
                }
                try caller_eir.replace_block_insts_reuse(alloc, caller_fid, call_bb, spl_insts.as_slice(), spl_flags.as_slice());
                spl_flags.destroy(alloc);
                spl_insts.destroy(alloc);
                val_map.destroy(alloc);
                slot_map.destroy(alloc);
                return 1_u8;
            }
        }
    }

    let cont_bb: eir.BlockId = orig_caller_nblks;
    var bb_map = try col.DynBuf.[eir.BlockId].init(alloc, max_usize(callee_nblks, 1_usize));
    errdefer bb_map.destroy(alloc);
    try fill_u32(alloc, &mut bb_map, callee_nblks, eir.EIR_NONE);

    var cri2: u32 = 0_u32;
    while cri2 < callee_rpo_r.len {
        var cbb: eir.BlockId = 0_u32;
        if let bp = callee_eir.meta.rpo.get((callee_rpo_r.start +% cri2).widen.[usize]()) {
            cbb = bp.*;
        }
        let cu = cbb.widen.[usize]();
        if cu < callee_nblks {
            u32_set(&mut bb_map, cu, orig_caller_nblks +% 1_u32 +% cri2);
        }
        cri2 = cri2 +% 1_u32;
    }

    let callee_entry_mapped = u32_at(&bb_map, callee_entry.widen.[usize]());
    if callee_entry_mapped == eir.EIR_NONE {
        bb_map.destroy(alloc);
        val_map.destroy(alloc);
        slot_map.destroy(alloc);
        return 0_u8;
    }

    let pre_r = ast.range_new(call_insts_r.start, call_ii);
    var cbi: u32 = 0_u32;
    while cbi < orig_caller_nblks {
        update_block_phi_pred(caller_eir, caller_fid, cbi, call_bb, cont_bb);
        cbi = cbi +% 1_u32;
    }

    var ret_edges = try col.DynBuf.[eir.EirPhiIn].init(alloc, 4_usize);
    errdefer ret_edges.destroy(alloc);
    var cloned_blks = try col.DynBuf.[eir.EirBlock].init(alloc, callee_rpo_r.len.widen.[usize]());
    errdefer cloned_blks.destroy(alloc);
    var tmp_phis = try col.DynBuf.[eir.EirPhi].init(alloc, 8_usize);
    errdefer tmp_phis.destroy(alloc);
    var tmp_inc = try col.DynBuf.[eir.EirPhiIn].init(alloc, 8_usize);
    errdefer tmp_inc.destroy(alloc);
    var tmp_insts = try col.DynBuf.[eir.EirInst].init(alloc, 32_usize);
    errdefer tmp_insts.destroy(alloc);
    var tmp_flags = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer tmp_flags.destroy(alloc);
    var tmp_sw = try col.DynBuf.[cfg_ir.SwitchTarget].init(alloc, 8_usize);
    errdefer tmp_sw.destroy(alloc);

    var cri3: u32 = 0_u32;
    while cri3 < callee_rpo_r.len {
        var cbb: eir.BlockId = 0_u32;
        if let bp = callee_eir.meta.rpo.get((callee_rpo_r.start +% cri3).widen.[usize]()) {
            cbb = bp.*;
        }
        let new_bb_id = u32_at(&bb_map, cbb.widen.[usize]());
        var cphis_r = ast.range_empty();
        var cinsts_r = ast.range_empty();
        var cterm = eir.term_unreachable(span.span_dummy(), false);
        if let cblk = callee_eir.fn_block(callee_fid, cbb) {
            cphis_r = cblk.phis;
            cinsts_r = cblk.insts;
            cterm = cblk.term;
        }

        tmp_phis.clear();
        var kpi: u32 = 0_u32;
        while kpi < cphis_r.len {
            if let pp = callee_eir.funcs.phis.get((cphis_r.start +% kpi).widen.[usize]()) {
                let phi = pp.*;
                tmp_inc.clear();
                var ki: u32 = 0_u32;
                while ki < phi.incoming.len {
                    if let inp = callee_eir.funcs.phi_in.get((phi.incoming.start +% ki).widen.[usize]()) {
                        let entry_in = inp.*;
                        let mapped_pred = u32_at(&bb_map, entry_in.pred_bb.widen.[usize]());
                        if mapped_pred != eir.EIR_NONE {
                            try tmp_inc.push(alloc, eir.EirPhiIn.{
                                pred_bb: mapped_pred,
                                val: remap_id(entry_in.val, val_map.as_slice()),
                            });
                        }
                    }
                    ki = ki +% 1_u32;
                }
                let inc_r = try caller_eir.append_phi_incoming(alloc, tmp_inc.as_slice());
                try tmp_phis.push(alloc, eir.EirPhi.{
                    dst: remap_id(phi.dst, val_map.as_slice()),
                    ty: phi.ty,
                    incoming: inc_r,
                });
            }
            kpi = kpi +% 1_u32;
        }
        let new_phis_r = try caller_eir.append_phis(alloc, tmp_phis.as_slice());

        tmp_insts.clear();
        tmp_flags.clear();
        var kii: u32 = 0_u32;
        while kii < cinsts_r.len {
            let old_gid = cinsts_r.start +% kii;
            if let ip = callee_eir.funcs.insts.get(old_gid.widen.[usize]()) {
                let orig_i = ip.*;
                let old_fl = callee_eir.inst_proven_flags(old_gid);
                let cloned = try clone_and_remap_inst_split(
                    alloc, caller_eir, callee_eir, &orig_i, val_map.as_slice(), slot_map.as_slice(),
                );
                try tmp_insts.push(alloc, cloned);
                try tmp_flags.push(alloc, old_fl);
            }
            kii = kii +% 1_u32;
        }
        let new_insts_r = try append_insts_with_flags(alloc, caller_eir, tmp_insts.as_slice(), tmp_flags.as_slice());

        var new_term = copy cterm;
        match cterm.kind {
            .Goto => {
                new_term.bb0 = u32_at(&bb_map, cterm.bb0.widen.[usize]());
            }
            .Branch => {
                new_term.val = remap_id(cterm.val, val_map.as_slice());
                new_term.bb0 = u32_at(&bb_map, cterm.bb0.widen.[usize]());
                new_term.bb1 = u32_at(&bb_map, cterm.bb1.widen.[usize]());
            }
            .SwitchInt => {
                new_term.val = remap_id(cterm.val, val_map.as_slice());
                new_term.bb0 = u32_at(&bb_map, cterm.bb0.widen.[usize]());
                tmp_sw.clear();
                var ti: u32 = 0_u32;
                while ti < cterm.targets.len {
                    if let tp = callee_eir.funcs.switch_targets.get((cterm.targets.start +% ti).widen.[usize]()) {
                        var st = tp.*;
                        st.target = u32_at(&bb_map, st.target.widen.[usize]());
                        try tmp_sw.push(alloc, st);
                    }
                    ti = ti +% 1_u32;
                }
                new_term.targets = try caller_eir.push_switch_targets(alloc, tmp_sw.as_slice());
            }
            .Return => {
                new_term = eir.term_goto(cont_bb);
                let rv = if cterm.flag { remap_id(cterm.val, val_map.as_slice()) } else { eir.EIR_NONE };
                try ret_edges.push(alloc, eir.EirPhiIn.{ pred_bb: new_bb_id, val: rv });
            }
            .Unreachable => {}
        }

        try cloned_blks.push(alloc, eir.EirBlock.{
            id: new_bb_id,
            phis: new_phis_r,
            insts: new_insts_r,
            term: new_term,
            preds: ast.range_empty(),
            idom: eir.EIR_NONE,
        });
        cri3 = cri3 +% 1_u32;
    }

    var cont_phis_r = ast.range_empty();
    var cont_insts_r = ast.range_empty();
    var cont_term = call_term;
    if ret_edges.is_empty() {
        cont_term = eir.term_unreachable(call_inst.span, false);
    } else {
        var put_copy_at_call = false;
        if call_inst.dst != eir.EIR_NONE {
            let resl = ret_edges.as_slice();
            if resl.len == 1_usize {
                var cpy = eir.inst_zero(call_inst.span, .Copy);
                cpy.dst = call_inst.dst;
                cpy.v0 = resl[0_usize].val;
                let call_gid = call_insts_r.start +% call_ii;
                let inst_mut = caller_eir.funcs.insts.as_mut_slice();
                if call_gid.widen.[usize]() < inst_mut.len {
                    inst_mut[call_gid.widen.[usize]()] = cpy;
                }
                if call_gid.widen.[usize]() < caller_eir.proven_safe_insts.len() {
                    try caller_eir.set_inst_proven_flags(alloc, call_gid, 0_u8);
                }
                put_copy_at_call = true;
            } else {
                let inc_r = try caller_eir.append_phi_incoming(alloc, resl);
                let dty = caller_eir.fn_val_ty(caller_fid, call_inst.dst);
                let p1: [1]eir.EirPhi = [eir.EirPhi.{ dst: call_inst.dst, ty: dty, incoming: inc_r }];
                cont_phis_r = try caller_eir.append_phis(alloc, &p1);
            }
        }
        if put_copy_at_call {
            let rem = if call_insts_r.len > call_ii { call_insts_r.len -% call_ii } else { 0_u32 };
            cont_insts_r = ast.range_new(call_insts_r.start +% call_ii, rem);
        } else {
            let post_off = call_ii +% 1_u32;
            let rem = if call_insts_r.len > post_off { call_insts_r.len -% post_off } else { 0_u32 };
            cont_insts_r = ast.range_new(call_insts_r.start +% post_off, rem);
        }
    }

    let cont_blk = eir.EirBlock.{
        id: cont_bb,
        phis: cont_phis_r,
        insts: cont_insts_r,
        term: cont_term,
        preds: ast.range_empty(),
        idom: eir.EIR_NONE,
    };
    let tail_blks = orig_caller_blks_r.len > 0_u32
        && (orig_caller_blks_r.start.widen.[usize]() +% orig_caller_blks_r.len.widen.[usize]()) == caller_eir.funcs.blocks.len();
    if tail_blks {
        let cb_idx = (orig_caller_blks_r.start +% call_bb).widen.[usize]();
        let bm_sl = caller_eir.funcs.blocks.as_mut_slice();
        if cb_idx < bm_sl.len {
            bm_sl[cb_idx].insts = pre_r;
            bm_sl[cb_idx].term = eir.term_goto(callee_entry_mapped);
        }
        try caller_eir.funcs.blocks.push(alloc, cont_blk);
        try caller_eir.funcs.blocks.push_slice(alloc, cloned_blks.as_slice());
        let new_len = orig_caller_nblks +% 1_u32 +% cloned_blks.len().trunc.[u32]();
        if let fm = caller_eir.get_fn_mut(caller_fid) {
            fm.blocks = ast.range_new(orig_caller_blks_r.start, new_len);
        }
    } else {
        var all_blks = try col.DynBuf.[eir.EirBlock].init(
            alloc,
            orig_caller_nblks.widen.[usize]() +% 1_usize +% cloned_blks.len(),
        );
        errdefer all_blks.destroy(alloc);
        var bi: u32 = 0_u32;
        while bi < orig_caller_nblks {
            var blk = eir.EirBlock.{
                id: bi,
                phis: ast.range_empty(),
                insts: ast.range_empty(),
                term: eir.term_unreachable(span.span_dummy(), false),
                preds: ast.range_empty(),
                idom: eir.EIR_NONE,
            };
            if let bp = caller_eir.funcs.blocks.get((orig_caller_blks_r.start +% bi).widen.[usize]()) {
                blk = bp.*;
            }
            if bi == call_bb {
                blk.insts = pre_r;
                blk.term = eir.term_goto(callee_entry_mapped);
            }
            try all_blks.push(alloc, blk);
            bi = bi +% 1_u32;
        }
        try all_blks.push(alloc, cont_blk);
        try all_blks.push_slice(alloc, cloned_blks.as_slice());

        let new_blks_r = try caller_eir.append_blocks(alloc, all_blks.as_slice());
        if let fm = caller_eir.get_fn_mut(caller_fid) {
            fm.blocks = new_blks_r;
        }
        all_blks.destroy(alloc);
    }

    try caller_eir.rebuild_fn_rpo(alloc, caller_fid);
    try caller_eir.prune_fn_phi_preds(alloc, caller_fid);
    try clear_unreachable_blocks(alloc, caller_eir, caller_fid);

    tmp_sw.destroy(alloc);
    tmp_flags.destroy(alloc);
    tmp_insts.destroy(alloc);
    tmp_inc.destroy(alloc);
    tmp_phis.destroy(alloc);
    cloned_blks.destroy(alloc);
    ret_edges.destroy(alloc);
    bb_map.destroy(alloc);
    val_map.destroy(alloc);
    slot_map.destroy(alloc);
    return 2_u8;
}

linear struct WorkerOptState {
    scratch: eir.EirProgram;
    out: eir.EirProgram;
    copy_sc: eir.EirCopyScratch;
    stats: OptStats;
    oom: bool;
}

impl WorkerOptState {
    fn init(alloc: *mut AllocCap) -> WorkerOptState ! OutOfMemory {
        let scratch = try eir.EirProgram.init(alloc);
        errdefer scratch.destroy(alloc);
        let out = try eir.EirProgram.init(alloc);
        errdefer out.destroy(alloc);
        let copy_sc = try eir.EirCopyScratch.init(alloc);
        return WorkerOptState.{
            scratch: scratch,
            out: out,
            copy_sc: copy_sc,
            stats: opt_stats_zero(),
            oom: false,
        };
    }

    fn reset_for_stage(self: *mut Self) {
        self.scratch.clear_all();
        self.out.clear_all();
    }

    fn destroy(self: WorkerOptState, alloc: *mut AllocCap) {
        let WorkerOptState.{ scratch, out, copy_sc, stats, oom } = self;
        _ = stats;
        _ = oom;
        copy_sc.destroy(alloc);
        out.destroy(alloc);
        scratch.destroy(alloc);
    }
}

fn fn_opt_work_weight(eir_prog: *eir.EirProgram, fi: u32) -> u32 {
    if let f = eir_prog.get_fn(fi) {
        if f.is_emi_stub {
            return 0_u32;
        }
        return f.blocks.len *% 4_u32 +% f.value_tys.len;
    }
    return 0_u32;
}

fn sort_work_order_desc(order: *mut [u32], weights: *[u32]) {
    let n = order.len;
    if n <= 1_usize {
        return;
    }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third {
        gap = (gap *% 3_usize) +% 1_usize;
    }
    while gap > 0_usize {
        var i = gap;
        while i < order.len {
            let fi = order[i];
            let wf = if fi.widen.[usize]() < weights.len { weights[fi.widen.[usize]()] } else { 0_u32 };
            var j = i;
            while j >= gap && j < order.len {
                let prev = j - gap;
                let pf = order[prev];
                let wp = if pf.widen.[usize]() < weights.len { weights[pf.widen.[usize]()] } else { 0_u32 };
                if wp > wf || (wp == wf && pf < fi) {
                    break;
                }
                order[j] = pf;
                j = prev;
            }
            order[j] = fi;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

fn opt_stage1_worker_loop(
    wi: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    fn_loc: *mut [u64],
    orig_eir: *eir.EirProgram,
    env: *types.TypeEnv,
    w: *mut WorkerOptState,
) -> !OutOfMemory {
    while true {
        let pos = next_pos.fetch_add(1_u64, .AcqRel).trunc.[usize]();
        if pos >= work_order.len {
            break;
        }
        let fi = work_order[pos];
        let fiu = fi.widen.[usize]();
        w.scratch.clear_all();
        _ = try eir.copy_fn_into_eir_scratch(alloc, orig_eir, fi, &mut w.scratch, &mut w.copy_sc);
        if !is_stub_fn(&w.scratch, 0_u32) {
            let p1 = try mem2reg_fn(alloc, &mut w.scratch, 0_u32, env);
            w.stats.mem2reg_slots = w.stats.mem2reg_slots +% p1;
            let d1 = try devirt_fn_with_lookup(alloc, &mut w.scratch, orig_eir, 0_u32, env);
            w.stats.devirt_calls = w.stats.devirt_calls +% d1;
        }
        let local_idx = try eir.copy_fn_into_eir_scratch(alloc, &w.scratch, 0_u32, &mut w.out, &mut w.copy_sc);
        if fiu < fn_loc.len {
            fn_loc[fiu] = ((wi +% 1_u32).widen.[u64]() <<% 32_u64) | local_idx.widen.[u64]();
        }
    }
    return;
}

fn run_opt_stage1_entry(
    wi: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    fn_loc: *mut [u64],
    orig_eir: *eir.EirProgram,
    env: *types.TypeEnv,
    w: *mut WorkerOptState,
) {
    opt_stage1_worker_loop(wi, alloc, next_pos, work_order, fn_loc, orig_eir, env, w) catch {
        w.oom = true;
    };
}

fn dispatch_opt_stage1_workers(
    n_workers: usize,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    fn_loc: *mut [u64],
    orig_eir: *eir.EirProgram,
    env: *types.TypeEnv,
    w0: *mut WorkerOptState,
    w1: *mut WorkerOptState,
    w2: *mut WorkerOptState,
    w3: *mut WorkerOptState,
    w4: *mut WorkerOptState,
    w5: *mut WorkerOptState,
    w6: *mut WorkerOptState,
    w7: *mut WorkerOptState,
    w8: *mut WorkerOptState,
    w9: *mut WorkerOptState,
    w10: *mut WorkerOptState,
    w11: *mut WorkerOptState,
) {
    if n_workers <= 1_usize {
        run_opt_stage1_entry(0_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w0);
        return;
    }
    par for wi in 0_usize..n_workers {
        if wi == 0_usize { run_opt_stage1_entry(0_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w0); }
        else if wi == 1_usize { run_opt_stage1_entry(1_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w1); }
        else if wi == 2_usize { run_opt_stage1_entry(2_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w2); }
        else if wi == 3_usize { run_opt_stage1_entry(3_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w3); }
        else if wi == 4_usize { run_opt_stage1_entry(4_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w4); }
        else if wi == 5_usize { run_opt_stage1_entry(5_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w5); }
        else if wi == 6_usize { run_opt_stage1_entry(6_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w6); }
        else if wi == 7_usize { run_opt_stage1_entry(7_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w7); }
        else if wi == 8_usize { run_opt_stage1_entry(8_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w8); }
        else if wi == 9_usize { run_opt_stage1_entry(9_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w9); }
        else if wi == 10_usize { run_opt_stage1_entry(10_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w10); }
        else if wi == 11_usize { run_opt_stage1_entry(11_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w11); }
    }
}

fn opt_inline_wave_worker_loop(
    wi: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    wave_fns: *[u32],
    fn_loc: *mut [u64],
    new_sizes: *mut [u32],
    orig_eir: *eir.EirProgram,
    fn_sizes: *col.DynBuf[u32],
    callsite_cnt: *col.DynBuf[u32],
    is_rec: *col.BitSet,
    has_asm: *col.BitSet,
    incremental_cgu: bool,
    w: *mut WorkerOptState,
) -> !OutOfMemory {
    var acc_fact_dsts = try col.DynBuf.[eir.EirValue].init(alloc, 32_usize);
    errdefer acc_fact_dsts.destroy(alloc);
    var acc_fact_vals = try col.DynBuf.[eir.EirValueFact].init(alloc, 32_usize);
    errdefer acc_fact_vals.destroy(alloc);

    while true {
        let pos = next_pos.fetch_add(1_u64, .AcqRel).trunc.[usize]();
        if pos >= wave_fns.len {
            break;
        }
        let caller_fid = wave_fns[pos];
        let caller_i = caller_fid.widen.[usize]();
        var skip_caller = false;
        var caller_nblks: usize = 0_usize;
        if let f = orig_eir.get_fn(caller_fid) {
            if is_opt_protected_fn(f) || has_par_for(f) || f.rpo.len == 0_u32 {
                skip_caller = true;
            } else {
                caller_nblks = f.blocks.len.widen.[usize]();
            }
        } else {
            skip_caller = true;
        }
        if !skip_caller {
            w.scratch.clear_all();
            _ = try eir.copy_fn_into_eir_scratch(alloc, orig_eir, caller_fid, &mut w.scratch, &mut w.copy_sc);
            var in_loop = try col.BitSet.init(alloc, max_usize(caller_nblks, 1_usize));
            errdefer in_loop.destroy(alloc);
            try mark_loop_blocks_fn(alloc, &w.scratch, 0_u32, &mut in_loop);
            var cur_caller_sz = u32_at(fn_sizes, caller_i).widen.[usize]();
            var scan_ri: usize = 0_usize;
            var inlines_here: usize = 0_usize;
            acc_fact_dsts.clear();
            acc_fact_vals.clear();
            while inlines_here < 32_usize {
                let site = find_inline_site_from_split(
                    &w.scratch, 0_u32, caller_fid, orig_eir, scan_ri, cur_caller_sz, &in_loop,
                    fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu,
                );
                if !site.found {
                    break;
                }
                let csz_in = u32_at(fn_sizes, site.callee.widen.[usize]()).widen.[usize]();
                let in_res = try inline_call_site_split(
                    alloc, &mut w.scratch, 0_u32, orig_eir, site.callee, site.bb, site.ii,
                    &mut acc_fact_dsts, &mut acc_fact_vals,
                );
                if in_res == 0_u8 {
                    break;
                }
                w.stats.inlined_calls = w.stats.inlined_calls +% 1_u64;
                inlines_here = inlines_here +% 1_usize;
                if in_res == 1_u8 {
                    cur_caller_sz = cur_caller_sz +% csz_in;
                    scan_ri = site.ri;
                } else {
                    cur_caller_sz = fn_reachable_inst_count(&w.scratch, 0_u32);
                    var new_nb: usize = 1_usize;
                    if let f2 = w.scratch.get_fn(0_u32) {
                        new_nb = max_usize(f2.blocks.len.widen.[usize](), 1_usize);
                    }
                    if new_nb > in_loop.len() {
                        let next_il = try col.BitSet.init(alloc, new_nb);
                        in_loop.destroy(alloc);
                        in_loop = next_il;
                    } else {
                        in_loop.clear();
                    }
                    try mark_loop_blocks_fn(alloc, &w.scratch, 0_u32, &mut in_loop);
                    scan_ri = 0_usize;
                }
            }
            if inlines_here > 0_usize {
                if !acc_fact_dsts.is_empty() {
                    var cur_nvals: usize = 0_usize;
                    if let f3 = w.scratch.get_fn(0_u32) {
                        cur_nvals = f3.value_tys.len.widen.[usize]();
                    }
                    try w.scratch.extend_fn_value_facts(
                        alloc, 0_u32, cur_nvals, acc_fact_dsts.as_slice(), acc_fact_vals.as_slice(),
                    );
                }
                _ = try eliminate_copies_fn(alloc, &mut w.scratch, 0_u32);
                let final_sz = fn_reachable_inst_count(&w.scratch, 0_u32).trunc.[u32]();
                let local_idx = try eir.copy_fn_into_eir_scratch(alloc, &w.scratch, 0_u32, &mut w.out, &mut w.copy_sc);
                if caller_i < new_sizes.len {
                    new_sizes[caller_i] = final_sz;
                }
                if caller_i < fn_loc.len {
                    fn_loc[caller_i] = ((wi +% 1_u32).widen.[u64]() <<% 32_u64) | local_idx.widen.[u64]();
                }
            }
            in_loop.destroy(alloc);
        }
    }

    acc_fact_vals.destroy(alloc);
    acc_fact_dsts.destroy(alloc);
    return;
}

fn run_opt_inline_wave_entry(
    wi: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    wave_fns: *[u32],
    fn_loc: *mut [u64],
    new_sizes: *mut [u32],
    orig_eir: *eir.EirProgram,
    fn_sizes: *col.DynBuf[u32],
    callsite_cnt: *col.DynBuf[u32],
    is_rec: *col.BitSet,
    has_asm: *col.BitSet,
    incremental_cgu: bool,
    w: *mut WorkerOptState,
) {
    opt_inline_wave_worker_loop(
        wi, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w,
    ) catch {
        w.oom = true;
    };
}

fn dispatch_opt_inline_wave_workers(
    n_workers: usize,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    wave_fns: *[u32],
    fn_loc: *mut [u64],
    new_sizes: *mut [u32],
    orig_eir: *eir.EirProgram,
    fn_sizes: *col.DynBuf[u32],
    callsite_cnt: *col.DynBuf[u32],
    is_rec: *col.BitSet,
    has_asm: *col.BitSet,
    incremental_cgu: bool,
    w0: *mut WorkerOptState,
    w1: *mut WorkerOptState,
    w2: *mut WorkerOptState,
    w3: *mut WorkerOptState,
    w4: *mut WorkerOptState,
    w5: *mut WorkerOptState,
    w6: *mut WorkerOptState,
    w7: *mut WorkerOptState,
    w8: *mut WorkerOptState,
    w9: *mut WorkerOptState,
    w10: *mut WorkerOptState,
    w11: *mut WorkerOptState,
) {
    if n_workers <= 1_usize || wave_fns.len <= 2_usize {
        run_opt_inline_wave_entry(0_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w0);
        return;
    }
    let eff = if wave_fns.len < n_workers { wave_fns.len } else { n_workers };
    par for wi in 0_usize..eff {
        if wi == 0_usize { run_opt_inline_wave_entry(0_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w0); }
        else if wi == 1_usize { run_opt_inline_wave_entry(1_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w1); }
        else if wi == 2_usize { run_opt_inline_wave_entry(2_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w2); }
        else if wi == 3_usize { run_opt_inline_wave_entry(3_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w3); }
        else if wi == 4_usize { run_opt_inline_wave_entry(4_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w4); }
        else if wi == 5_usize { run_opt_inline_wave_entry(5_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w5); }
        else if wi == 6_usize { run_opt_inline_wave_entry(6_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w6); }
        else if wi == 7_usize { run_opt_inline_wave_entry(7_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w7); }
        else if wi == 8_usize { run_opt_inline_wave_entry(8_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w8); }
        else if wi == 9_usize { run_opt_inline_wave_entry(9_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w9); }
        else if wi == 10_usize { run_opt_inline_wave_entry(10_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w10); }
        else if wi == 11_usize { run_opt_inline_wave_entry(11_u32, alloc, next_pos, wave_fns, fn_loc, new_sizes, orig_eir, fn_sizes, callsite_cnt, is_rec, has_asm, incremental_cgu, w11); }
    }
}

fn opt_stage3_worker_loop(
    wi: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    fn_loc: *mut [u64],
    orig_eir: *eir.EirProgram,
    env: *types.TypeEnv,
    w: *mut WorkerOptState,
) -> !OutOfMemory {
    while true {
        let pos = next_pos.fetch_add(1_u64, .AcqRel).trunc.[usize]();
        if pos >= work_order.len {
            break;
        }
        let fi = work_order[pos];
        let fiu = fi.widen.[usize]();
        w.scratch.clear_all();
        _ = try eir.copy_fn_into_eir_scratch(alloc, orig_eir, fi, &mut w.scratch, &mut w.copy_sc);
        if !is_stub_fn(&w.scratch, 0_u32) {
            // Post-inline canonicalizer + SROA + Mem2Reg2 + Pool-Copy Forwarding
            try fold_slot_addr_derefs_fn(alloc, &mut w.scratch, 0_u32);
            try eliminate_readonly_struct_slot_copy_fn(alloc, &mut w.scratch, 0_u32, env);
            var sroa_it: usize = 0_usize;
            while sroa_it < 2_usize {
                let sc = try sroa_fn_once(alloc, &mut w.scratch, 0_u32, env);
                w.stats.sroa_slots = w.stats.sroa_slots +% sc;
                if sc == 0_u64 {
                    break;
                }
                sroa_it = sroa_it +% 1_usize;
            }
            let m2 = try mem2reg_fn(alloc, &mut w.scratch, 0_u32, env);
            w.stats.mem2reg_slots = w.stats.mem2reg_slots +% m2;
            var rcopy: usize = 0_usize;
            while rcopy < 4_usize {
                if !(try forward_readonly_pool_copies_fn(alloc, &mut w.scratch, 0_u32, env)) {
                    break;
                }
                rcopy = rcopy +% 1_usize;
            }

            // Pass 4: SCCP + Fold + DBM
            try sccp_fold_dbm_fn(alloc, &mut w.scratch, 0_u32, env, &mut w.stats);

            // Pass 5: Load Forwarding
            let lf = try load_forwarding_fn(alloc, &mut w.scratch, 0_u32, env);
            w.stats.gvn_eliminated = w.stats.gvn_eliminated +% lf;

            // Pass 6: GVN
            let gv = try gvn_fn(alloc, &mut w.scratch, 0_u32);
            w.stats.gvn_eliminated = w.stats.gvn_eliminated +% gv;

            // Pass 7: LICM
            let li = try licm_fn(alloc, &mut w.scratch, 0_u32, env);
            w.stats.licm_hoisted = w.stats.licm_hoisted +% li;

            // Pass 8: TCE
            let tc = try tce_fn(alloc, &mut w.scratch, 0_u32);
            w.stats.tail_calls_eliminated = w.stats.tail_calls_eliminated +% tc;

            // Pass 9: SoA Loop Fusion (+ post-fusion cleanup if fused)
            if fn_has_arena_pool_ops(&w.scratch, 0_u32, env) {
                var rcopy2: usize = 0_usize;
                while rcopy2 < 4_usize {
                    if !(try forward_readonly_pool_copies_fn(alloc, &mut w.scratch, 0_u32, env)) {
                        break;
                    }
                    rcopy2 = rcopy2 +% 1_usize;
                }
                let _ = try adce_fn(alloc, &mut w.scratch, 0_u32, env);
                _ = try simplify_cfg_fn(alloc, &mut w.scratch, 0_u32);
                var fused_here: u64 = 0_u64;
                var fit: usize = 0_usize;
                while fit < 16_usize {
                    if !(try fuse_one_soa_pair_fn(alloc, &mut w.scratch, 0_u32)) {
                        break;
                    }
                    fused_here = fused_here +% 1_u64;
                    fit = fit +% 1_usize;
                }
                if fused_here > 0_u64 {
                    w.stats.fused_pool_loops = w.stats.fused_pool_loops +% fused_here;
                    let lf2 = try load_forwarding_fn(alloc, &mut w.scratch, 0_u32, env);
                    w.stats.gvn_eliminated = w.stats.gvn_eliminated +% lf2;
                    let gv2 = try gvn_fn(alloc, &mut w.scratch, 0_u32);
                    w.stats.gvn_eliminated = w.stats.gvn_eliminated +% gv2;
                    try sccp_fold_dbm_fn(alloc, &mut w.scratch, 0_u32, env, &mut w.stats);
                }
            }

            // Pass 10: ADCE + CFG Simplify + Block Compaction + Final Loop Depths
            let c1 = try eliminate_copies_fn(alloc, &mut w.scratch, 0_u32);
            w.stats.dce_removed = w.stats.dce_removed +% c1;
            let c2 = try adce_fn(alloc, &mut w.scratch, 0_u32, env);
            w.stats.dce_removed = w.stats.dce_removed +% c2;
            let cfg_ch = try simplify_cfg_fn(alloc, &mut w.scratch, 0_u32);
            if cfg_ch {
                let c3 = try adce_fn(alloc, &mut w.scratch, 0_u32, env);
                w.stats.dce_removed = w.stats.dce_removed +% c3;
            }
            try compute_and_set_loop_depths(alloc, &mut w.scratch, 0_u32);
        }
        let local_idx = try eir.copy_fn_into_eir_scratch(alloc, &w.scratch, 0_u32, &mut w.out, &mut w.copy_sc);
        if fiu < fn_loc.len {
            fn_loc[fiu] = ((wi +% 1_u32).widen.[u64]() <<% 32_u64) | local_idx.widen.[u64]();
        }
    }
    return;
}

fn run_opt_stage3_entry(
    wi: u32,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    fn_loc: *mut [u64],
    orig_eir: *eir.EirProgram,
    env: *types.TypeEnv,
    w: *mut WorkerOptState,
) {
    opt_stage3_worker_loop(wi, alloc, next_pos, work_order, fn_loc, orig_eir, env, w) catch {
        w.oom = true;
    };
}

fn dispatch_opt_stage3_workers(
    n_workers: usize,
    alloc: *mut AllocCap,
    next_pos: *mut sync.AtomicCounter,
    work_order: *[u32],
    fn_loc: *mut [u64],
    orig_eir: *eir.EirProgram,
    env: *types.TypeEnv,
    w0: *mut WorkerOptState,
    w1: *mut WorkerOptState,
    w2: *mut WorkerOptState,
    w3: *mut WorkerOptState,
    w4: *mut WorkerOptState,
    w5: *mut WorkerOptState,
    w6: *mut WorkerOptState,
    w7: *mut WorkerOptState,
    w8: *mut WorkerOptState,
    w9: *mut WorkerOptState,
    w10: *mut WorkerOptState,
    w11: *mut WorkerOptState,
) {
    if n_workers <= 1_usize {
        run_opt_stage3_entry(0_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w0);
        return;
    }
    par for wi in 0_usize..n_workers {
        if wi == 0_usize { run_opt_stage3_entry(0_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w0); }
        else if wi == 1_usize { run_opt_stage3_entry(1_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w1); }
        else if wi == 2_usize { run_opt_stage3_entry(2_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w2); }
        else if wi == 3_usize { run_opt_stage3_entry(3_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w3); }
        else if wi == 4_usize { run_opt_stage3_entry(4_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w4); }
        else if wi == 5_usize { run_opt_stage3_entry(5_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w5); }
        else if wi == 6_usize { run_opt_stage3_entry(6_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w6); }
        else if wi == 7_usize { run_opt_stage3_entry(7_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w7); }
        else if wi == 8_usize { run_opt_stage3_entry(8_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w8); }
        else if wi == 9_usize { run_opt_stage3_entry(9_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w9); }
        else if wi == 10_usize { run_opt_stage3_entry(10_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w10); }
        else if wi == 11_usize { run_opt_stage3_entry(11_u32, alloc, next_pos, work_order, fn_loc, orig_eir, env, w11); }
    }
}

fn copy_fn_from_worker_out(
    alloc: *mut AllocCap,
    wid: u32,
    local_idx: u32,
    dst: *mut eir.EirProgram,
    sc: *mut eir.EirCopyScratch,
    w0: *WorkerOptState,
    w1: *WorkerOptState,
    w2: *WorkerOptState,
    w3: *WorkerOptState,
    w4: *WorkerOptState,
    w5: *WorkerOptState,
    w6: *WorkerOptState,
    w7: *WorkerOptState,
    w8: *WorkerOptState,
    w9: *WorkerOptState,
    w10: *WorkerOptState,
    w11: *WorkerOptState,
) -> !OutOfMemory {
    if wid == 0_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w0.out, local_idx, dst, sc); }
    else if wid == 1_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w1.out, local_idx, dst, sc); }
    else if wid == 2_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w2.out, local_idx, dst, sc); }
    else if wid == 3_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w3.out, local_idx, dst, sc); }
    else if wid == 4_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w4.out, local_idx, dst, sc); }
    else if wid == 5_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w5.out, local_idx, dst, sc); }
    else if wid == 6_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w6.out, local_idx, dst, sc); }
    else if wid == 7_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w7.out, local_idx, dst, sc); }
    else if wid == 8_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w8.out, local_idx, dst, sc); }
    else if wid == 9_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w9.out, local_idx, dst, sc); }
    else if wid == 10_u32 { _ = try eir.copy_fn_into_eir_scratch(alloc, &w10.out, local_idx, dst, sc); }
    else { _ = try eir.copy_fn_into_eir_scratch(alloc, &w11.out, local_idx, dst, sc); }
    return;
}

fn overwrite_fn_from_worker_out(
    alloc: *mut AllocCap,
    wid: u32,
    local_idx: u32,
    dst: *mut eir.EirProgram,
    dst_fi: u32,
    sc: *mut eir.EirCopyScratch,
    w0: *WorkerOptState,
    w1: *WorkerOptState,
    w2: *WorkerOptState,
    w3: *WorkerOptState,
    w4: *WorkerOptState,
    w5: *WorkerOptState,
    w6: *WorkerOptState,
    w7: *WorkerOptState,
    w8: *WorkerOptState,
    w9: *WorkerOptState,
    w10: *WorkerOptState,
    w11: *WorkerOptState,
) -> !OutOfMemory {
    if wid == 0_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w0.out, local_idx, dst, dst_fi, sc); }
    else if wid == 1_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w1.out, local_idx, dst, dst_fi, sc); }
    else if wid == 2_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w2.out, local_idx, dst, dst_fi, sc); }
    else if wid == 3_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w3.out, local_idx, dst, dst_fi, sc); }
    else if wid == 4_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w4.out, local_idx, dst, dst_fi, sc); }
    else if wid == 5_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w5.out, local_idx, dst, dst_fi, sc); }
    else if wid == 6_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w6.out, local_idx, dst, dst_fi, sc); }
    else if wid == 7_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w7.out, local_idx, dst, dst_fi, sc); }
    else if wid == 8_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w8.out, local_idx, dst, dst_fi, sc); }
    else if wid == 9_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w9.out, local_idx, dst, dst_fi, sc); }
    else if wid == 10_u32 { try eir.overwrite_fn_from_eir_scratch(alloc, &w10.out, local_idx, dst, dst_fi, sc); }
    else { try eir.overwrite_fn_from_eir_scratch(alloc, &w11.out, local_idx, dst, dst_fi, sc); }
    return;
}

fn merge_all_worker_fns_into_eir(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    nfns: usize,
    fn_loc: *[u64],
    sc: *mut eir.EirCopyScratch,
    w0: *WorkerOptState,
    w1: *WorkerOptState,
    w2: *WorkerOptState,
    w3: *WorkerOptState,
    w4: *WorkerOptState,
    w5: *WorkerOptState,
    w6: *WorkerOptState,
    w7: *WorkerOptState,
    w8: *WorkerOptState,
    w9: *WorkerOptState,
    w10: *WorkerOptState,
    w11: *WorkerOptState,
) -> !OutOfMemory {
    var globals_tmp = try eir.EirProgram.init(alloc);
    errdefer globals_tmp.destroy(alloc);
    try eir.copy_program_globals(alloc, eir_prog, &mut globals_tmp);

    eir_prog.clear_all();
    try eir.copy_program_globals(alloc, &globals_tmp, eir_prog);

    var fi: usize = 0_usize;
    while fi < nfns {
        let loc = if fi < fn_loc.len { fn_loc[fi] } else { 0_u64 };
        let wid = ((loc >> 32_u64) -% 1_u64).trunc.[u32]();
        let local_idx = (loc & 0xFFFFFFFF_u64).trunc.[u32]();
        try copy_fn_from_worker_out(
            alloc, wid, local_idx, eir_prog, sc,
            w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11,
        );
        fi = fi +% 1_usize;
    }

    globals_tmp.destroy(alloc);
    return;
}

fn commit_inline_wave_results(
    alloc: *mut AllocCap,
    eir_prog: *mut eir.EirProgram,
    wave_fns: *[u32],
    fn_loc: *mut [u64],
    new_sizes: *[u32],
    fn_sizes: *mut col.DynBuf[u32],
    sc: *mut eir.EirCopyScratch,
    w0: *WorkerOptState,
    w1: *WorkerOptState,
    w2: *WorkerOptState,
    w3: *WorkerOptState,
    w4: *WorkerOptState,
    w5: *WorkerOptState,
    w6: *WorkerOptState,
    w7: *WorkerOptState,
    w8: *WorkerOptState,
    w9: *WorkerOptState,
    w10: *WorkerOptState,
    w11: *WorkerOptState,
) -> !OutOfMemory {
    var i: usize = 0_usize;
    while i < wave_fns.len {
        let u = wave_fns[i];
        let uu = u.widen.[usize]();
        if uu < fn_loc.len && fn_loc[uu] != 0_u64 {
            let loc = fn_loc[uu];
            let wid = ((loc >> 32_u64) -% 1_u64).trunc.[u32]();
            let local_idx = (loc & 0xFFFFFFFF_u64).trunc.[u32]();
            try overwrite_fn_from_worker_out(
                alloc, wid, local_idx, eir_prog, u, sc,
                w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11,
            );
            if uu < new_sizes.len {
                u32_set(fn_sizes, uu, new_sizes[uu]);
            }
            fn_loc[uu] = 0_u64;
        }
        i = i +% 1_usize;
    }
    return;
}

fn any_worker_oom(
    w0: *WorkerOptState,
    w1: *WorkerOptState,
    w2: *WorkerOptState,
    w3: *WorkerOptState,
    w4: *WorkerOptState,
    w5: *WorkerOptState,
    w6: *WorkerOptState,
    w7: *WorkerOptState,
    w8: *WorkerOptState,
    w9: *WorkerOptState,
    w10: *WorkerOptState,
    w11: *WorkerOptState,
) -> bool {
    return w0.oom || w1.oom || w2.oom || w3.oom || w4.oom || w5.oom
        || w6.oom || w7.oom || w8.oom || w9.oom || w10.oom || w11.oom;
}

fn optimize_program_parallel(
    alloc: *mut AllocCap,
    clock_opt: ?*ClockCap,
    profile_passes: bool,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    cfg: eir.EirOptConfig,
    jobs: u32,
) -> OptStats ! OutOfMemory {
    let nfns = eir_prog.fn_count().widen.[usize]();
    if nfns == 0_usize {
        return opt_stats_zero();
    }

    var n_workers: usize = 1_usize;
    if jobs == 1_u32 {
        n_workers = 1_usize;
    } else if jobs > 1_u32 {
        n_workers = jobs.widen.[usize]();
        if n_workers > 12_usize { n_workers = 12_usize; }
        if n_workers > nfns { n_workers = nfns; }
    } else {
        if nfns < 32_usize {
            n_workers = 1_usize;
        } else if nfns < 192_usize {
            n_workers = 4_usize;
        } else if nfns < 480_usize {
            n_workers = 8_usize;
        } else {
            n_workers = 12_usize;
        }
    }
    if nfns < 4_usize {
        n_workers = 1_usize;
    }

    var t0: u64 = 0_u64;
    var u0: usize = 0_usize;
    if profile_passes {
        if let clk = clock_opt {
            t0 = rt.now_ns(clk);
            u0 = alloc.used_bytes();
        }
    }

    var w0 = try WorkerOptState.init(alloc);
    errdefer w0.destroy(alloc);
    var w1 = try WorkerOptState.init(alloc);
    errdefer w1.destroy(alloc);
    var w2 = try WorkerOptState.init(alloc);
    errdefer w2.destroy(alloc);
    var w3 = try WorkerOptState.init(alloc);
    errdefer w3.destroy(alloc);
    var w4 = try WorkerOptState.init(alloc);
    errdefer w4.destroy(alloc);
    var w5 = try WorkerOptState.init(alloc);
    errdefer w5.destroy(alloc);
    var w6 = try WorkerOptState.init(alloc);
    errdefer w6.destroy(alloc);
    var w7 = try WorkerOptState.init(alloc);
    errdefer w7.destroy(alloc);
    var w8 = try WorkerOptState.init(alloc);
    errdefer w8.destroy(alloc);
    var w9 = try WorkerOptState.init(alloc);
    errdefer w9.destroy(alloc);
    var w10 = try WorkerOptState.init(alloc);
    errdefer w10.destroy(alloc);
    var w11 = try WorkerOptState.init(alloc);
    errdefer w11.destroy(alloc);

    var work_order = try col.DynBuf.[u32].init(alloc, nfns);
    errdefer work_order.destroy(alloc);
    var weights = try col.DynBuf.[u32].init(alloc, nfns);
    errdefer weights.destroy(alloc);
    var fn_loc = try col.DynBuf.[u64].init(alloc, nfns);
    errdefer fn_loc.destroy(alloc);
    var merge_sc = try eir.EirCopyScratch.init(alloc);
    errdefer merge_sc.destroy(alloc);

    var fi0: usize = 0_usize;
    while fi0 < nfns {
        let fid = fi0.trunc.[u32]();
        try work_order.push(alloc, fid);
        try weights.push(alloc, fn_opt_work_weight(eir_prog, fid));
        try fn_loc.push(alloc, 0_u64);
        fi0 = fi0 +% 1_usize;
    }
    sort_work_order_desc(work_order.as_mut_slice(), weights.as_slice());

    // Stage 1: Parallel mem2reg_1 + devirt (compacted merge into eir_prog!)
    var next_pos = sync.AtomicCounter.init(0_u64);
    dispatch_opt_stage1_workers(
        n_workers, alloc, &mut next_pos, work_order.as_slice(), fn_loc.as_mut_slice(), eir_prog, env,
        &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
        &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
    );
    var failed_oom = any_worker_oom(&w0, &w1, &w2, &w3, &w4, &w5, &w6, &w7, &w8, &w9, &w10, &w11);
    if !failed_oom {
        try merge_all_worker_fns_into_eir(
            alloc, eir_prog, nfns, fn_loc.as_slice(), &mut merge_sc,
            &w0, &w1, &w2, &w3, &w4, &w5, &w6, &w7, &w8, &w9, &w10, &w11,
        );
    }
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "mt_stage1_mem2reg_devirt", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }

    // Pass 2B: Schedule Expansion (serial, <0.1ms)
    if !failed_oom {
        try pass_schedule_expand(alloc, eir_prog, env);
    }

    // Stage 2: Parallel Bottom-Up Wave Inliner
    if !failed_oom {
        var is_rec = try col.BitSet.init(alloc, nfns);
        errdefer is_rec.destroy(alloc);
        var has_asm = try col.BitSet.init(alloc, nfns);
        errdefer has_asm.destroy(alloc);
        var callsite_cnt = try col.DynBuf.[u32].init(alloc, nfns);
        errdefer callsite_cnt.destroy(alloc);
        try fill_u32(alloc, &mut callsite_cnt, nfns, 0_u32);
        var fn_sizes = try col.DynBuf.[u32].init(alloc, nfns);
        errdefer fn_sizes.destroy(alloc);
        try fill_u32(alloc, &mut fn_sizes, nfns, 0_u32);
        var new_sizes = try col.DynBuf.[u32].init(alloc, nfns);
        errdefer new_sizes.destroy(alloc);
        try fill_u32(alloc, &mut new_sizes, nfns, 0_u32);
        var topo_order = try col.DynBuf.[u32].init(alloc, nfns);
        errdefer topo_order.destroy(alloc);
        var wave_lvl = try col.DynBuf.[u32].init(alloc, nfns);
        errdefer wave_lvl.destroy(alloc);
        try fill_u32(alloc, &mut wave_lvl, nfns, 0_u32);
        var wave_fns = try col.DynBuf.[u32].init(alloc, 64_usize);
        errdefer wave_fns.destroy(alloc);

        try find_recursive_fns(alloc, eir_prog, nfns, &mut is_rec, &mut callsite_cnt, &mut has_asm, &mut topo_order);
        var fi_s: usize = 0_usize;
        while fi_s < nfns {
            u32_set(&mut fn_sizes, fi_s, fn_reachable_inst_count(eir_prog, fi_s.trunc.[u32]()).trunc.[u32]());
            fi_s = fi_s +% 1_usize;
        }

        // Assign each function its bottom-up wave level (`0` = no potentially inlineable callees).
        var max_wave: u32 = 0_u32;
        let topo_sl = topo_order.as_slice();
        var ti: usize = 0_usize;
        while ti < topo_sl.len {
            let u = topo_sl[ti];
            let uu = u.widen.[usize]();
            var w_here: u32 = 0_u32;
            let rpo = eir_prog.fn_rpo(u);
            var ri: usize = 0_usize;
            while ri < rpo.len {
                let insts = eir_prog.block_insts(u, rpo[ri]);
                var ii: usize = 0_usize;
                while ii < insts.len {
                    let inst = insts[ii];
                    if inst.kind == .Call {
                        if let cd = eir_prog.get_call(inst.aux0) {
                            if let v = resolve_direct_callee_fn(eir_prog, cd.callee) {
                                let vu = v.widen.[usize]();
                                if v != u && vu < nfns && !is_rec.test(vu) && !has_asm.test(vu) && u32_at(&fn_sizes, vu) <= 512_u32 {
                                    var can_v = false;
                                    if let vf = eir_prog.get_fn(v) {
                                        if !is_opt_protected_fn(vf)
                                            && !vf.sig.effects.is_recursive
                                            && !vf.sig.effects.is_export_c
                                            && !has_par_for(vf)
                                            && (!cfg.incremental_cgu || vf.sig.effects.is_inline || vf.key.kind == .GenericInst || vf.key.kind == .Closure)
                                        {
                                            can_v = true;
                                        }
                                    }
                                    if can_v {
                                        let cand_w = u32_at(&wave_lvl, vu) +% 1_u32;
                                        if cand_w > w_here {
                                            w_here = cand_w;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ii = ii +% 1_usize;
                }
                ri = ri +% 1_usize;
            }
            u32_set(&mut wave_lvl, uu, w_here);
            if w_here > max_wave {
                max_wave = w_here;
            }
            ti = ti +% 1_usize;
        }

        let loc_mut = fn_loc.as_mut_slice();
        var li_z: usize = 0_usize;
        while li_z < loc_mut.len {
            loc_mut[li_z] = 0_u64;
            li_z = li_z +% 1_usize;
        }

        var cur_w: u32 = 1_u32;
        while cur_w <= max_wave && !failed_oom {
            wave_fns.clear();
            var ti2: usize = 0_usize;
            while ti2 < topo_sl.len {
                let u = topo_sl[ti2];
                if u32_at(&wave_lvl, u.widen.[usize]()) == cur_w {
                    try wave_fns.push(alloc, u);
                }
                ti2 = ti2 +% 1_usize;
            }
            if !wave_fns.is_empty() {
                sort_work_order_desc(wave_fns.as_mut_slice(), fn_sizes.as_slice());
                w0.reset_for_stage();
                w1.reset_for_stage();
                w2.reset_for_stage();
                w3.reset_for_stage();
                w4.reset_for_stage();
                w5.reset_for_stage();
                w6.reset_for_stage();
                w7.reset_for_stage();
                w8.reset_for_stage();
                w9.reset_for_stage();
                w10.reset_for_stage();
                w11.reset_for_stage();
                next_pos.store(0_u64, .Release);
                dispatch_opt_inline_wave_workers(
                    n_workers, alloc, &mut next_pos, wave_fns.as_slice(), fn_loc.as_mut_slice(),
                    new_sizes.as_mut_slice(), eir_prog, &fn_sizes, &callsite_cnt, &is_rec, &has_asm, cfg.incremental_cgu,
                    &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
                    &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
                );
                failed_oom = any_worker_oom(&w0, &w1, &w2, &w3, &w4, &w5, &w6, &w7, &w8, &w9, &w10, &w11);
                if !failed_oom {
                    try commit_inline_wave_results(
                        alloc, eir_prog, wave_fns.as_slice(), fn_loc.as_mut_slice(), new_sizes.as_slice(), &mut fn_sizes, &mut merge_sc,
                        &w0, &w1, &w2, &w3, &w4, &w5, &w6, &w7, &w8, &w9, &w10, &w11,
                    );
                }
            }
            cur_w = cur_w +% 1_u32;
        }

        wave_fns.destroy(alloc);
        wave_lvl.destroy(alloc);
        topo_order.destroy(alloc);
        new_sizes.destroy(alloc);
        fn_sizes.destroy(alloc);
        callsite_cnt.destroy(alloc);
        has_asm.destroy(alloc);
        is_rec.destroy(alloc);
    }
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "mt_stage2_inline_waves", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }

    // Stage 3: Parallel Post-Inline Fused 10-Pass Pipeline + Full Compaction
    if !failed_oom {
        w0.reset_for_stage();
        w1.reset_for_stage();
        w2.reset_for_stage();
        w3.reset_for_stage();
        w4.reset_for_stage();
        w5.reset_for_stage();
        w6.reset_for_stage();
        w7.reset_for_stage();
        w8.reset_for_stage();
        w9.reset_for_stage();
        w10.reset_for_stage();
        w11.reset_for_stage();

        // Re-weight functions AFTER inlining so large post-inline callers run first (LPT)!
        let wm = weights.as_mut_slice();
        let wo = work_order.as_mut_slice();
        var fi3: usize = 0_usize;
        while fi3 < nfns && fi3 < wm.len && fi3 < wo.len {
            let fid = fi3.trunc.[u32]();
            wo[fi3] = fid;
            wm[fi3] = fn_opt_work_weight(eir_prog, fid);
            fi3 = fi3 +% 1_usize;
        }
        sort_work_order_desc(work_order.as_mut_slice(), weights.as_slice());

        next_pos.store(0_u64, .Release);
        dispatch_opt_stage3_workers(
            n_workers, alloc, &mut next_pos, work_order.as_slice(), fn_loc.as_mut_slice(), eir_prog, env,
            &mut w0, &mut w1, &mut w2, &mut w3, &mut w4, &mut w5,
            &mut w6, &mut w7, &mut w8, &mut w9, &mut w10, &mut w11,
        );
        failed_oom = any_worker_oom(&w0, &w1, &w2, &w3, &w4, &w5, &w6, &w7, &w8, &w9, &w10, &w11);
        if !failed_oom {
            try merge_all_worker_fns_into_eir(
                alloc, eir_prog, nfns, fn_loc.as_slice(), &mut merge_sc,
                &w0, &w1, &w2, &w3, &w4, &w5, &w6, &w7, &w8, &w9, &w10, &w11,
            );
        }
    }
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "mt_stage3_post_inline", t0, u0); } }

    var total_stats = opt_stats_zero();
    total_stats.passes_run = 10_u64;
    merge_opt_stats(&mut total_stats, &w0.stats);
    merge_opt_stats(&mut total_stats, &w1.stats);
    merge_opt_stats(&mut total_stats, &w2.stats);
    merge_opt_stats(&mut total_stats, &w3.stats);
    merge_opt_stats(&mut total_stats, &w4.stats);
    merge_opt_stats(&mut total_stats, &w5.stats);
    merge_opt_stats(&mut total_stats, &w6.stats);
    merge_opt_stats(&mut total_stats, &w7.stats);
    merge_opt_stats(&mut total_stats, &w8.stats);
    merge_opt_stats(&mut total_stats, &w9.stats);
    merge_opt_stats(&mut total_stats, &w10.stats);
    merge_opt_stats(&mut total_stats, &w11.stats);

    merge_sc.destroy(alloc);
    fn_loc.destroy(alloc);
    weights.destroy(alloc);
    work_order.destroy(alloc);
    w11.destroy(alloc);
    w10.destroy(alloc);
    w9.destroy(alloc);
    w8.destroy(alloc);
    w7.destroy(alloc);
    w6.destroy(alloc);
    w5.destroy(alloc);
    w4.destroy(alloc);
    w3.destroy(alloc);
    w2.destroy(alloc);
    w1.destroy(alloc);
    w0.destroy(alloc);

    if failed_oom {
        return OutOfMemory;
    }
    return total_stats;
}

fn optimize_program_impl(
    alloc: *mut AllocCap,
    clock_opt: ?*ClockCap,
    profile_passes: bool,
    eir_prog: *mut eir.EirProgram,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    cfg: eir.EirOptConfig,
    err_out: *mut str.StrBuf,
) -> OptStats ! OutOfMemory {
    _ = interner;
    if cfg.opt_level == 0_u8 {
        return opt_stats_zero();
    }

    var ctx = opt_ctx_new(cfg);
    var t0: u64 = 0_u64;
    var u0: usize = 0_usize;
    if profile_passes {
        if let clk = clock_opt {
            t0 = rt.now_ns(clk);
            u0 = alloc.used_bytes();
        }
    }

    // Pass 1: Mem2Reg (Slot-to-SSA Promotion)
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_mem2reg(alloc, eir_prog, env, &mut ctx.stats);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "mem2reg_1", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "mem2reg_1", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    if ctx.failed { return ctx.stats; }

    // Pass 2A: Devirtualization
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_devirt(alloc, eir_prog, env, &mut ctx.stats);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "devirt", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "devirt", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    if ctx.failed { return ctx.stats; }

    // Pass 2B: Schedule Expansion (`ScheduleRun` -> direct `sys` calls)
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_schedule_expand(alloc, eir_prog, env);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "schedule_expand", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "schedule_expand", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    if ctx.failed { return ctx.stats; }

    // Pass 2C: Smart Function Inlining + SlotAddr-Deref Canonicalization
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_inline(alloc, eir_prog, &mut ctx.stats, ctx.cfg.incremental_cgu);
    try fold_slot_addr_derefs_prog(alloc, eir_prog);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "inline", err_out);
    if profile_passes {
        if let clk = clock_opt {
            try print_opt_pass_line(alloc, clk, "inline+fold_deref", t0, u0);
            t0 = rt.now_ns(clk);
            u0 = alloc.used_bytes();
            var pbuf = try str.StrBuf.init(alloc, 256_usize);
            errdefer pbuf.destroy(alloc);
            try pbuf.push_str_grow(alloc, "[profile-eir-pools] blks=");
            try pbuf.push_u64_grow(alloc, eir_prog.funcs.blocks.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " insts=");
            try pbuf.push_u64_grow(alloc, eir_prog.funcs.insts.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " phis=");
            try pbuf.push_u64_grow(alloc, eir_prog.funcs.phis.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " phi_in=");
            try pbuf.push_u64_grow(alloc, eir_prog.funcs.phi_in.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " slots=");
            try pbuf.push_u64_grow(alloc, eir_prog.funcs.slots.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " vtys=");
            try pbuf.push_u64_grow(alloc, eir_prog.funcs.value_tys.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " vfacts=");
            try pbuf.push_u64_grow(alloc, eir_prog.value_facts.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " places=");
            try pbuf.push_u64_grow(alloc, eir_prog.exprs.places.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " projs=");
            try pbuf.push_u64_grow(alloc, eir_prog.exprs.projs.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " vals=");
            try pbuf.push_u64_grow(alloc, eir_prog.exprs.vals.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " calls=");
            try pbuf.push_u64_grow(alloc, eir_prog.exprs.calls.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " rpo=");
            try pbuf.push_u64_grow(alloc, eir_prog.meta.rpo.len().widen.[u64]());
            try pbuf.push_str_grow(alloc, " preds=");
            try pbuf.push_u64_grow(alloc, eir_prog.meta.preds.len().widen.[u64]());
            try pbuf.push_byte_grow(alloc, b'\n');
            rt.eprint_bytes(pbuf.as_bytes());
            pbuf.destroy(alloc);
        }
    }
    if ctx.failed { return ctx.stats; }

    // Pass 3: SROA (Scalar Replacement of Aggregates & view struct) + Mem2Reg Round 2 + Pool-Copy Forwarding
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_sroa(alloc, eir_prog, env, &mut ctx.stats);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "sroa", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    try pass_mem2reg(alloc, eir_prog, env, &mut ctx.stats);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "mem2reg_2", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    let nfns_pc = eir_prog.fn_count();
    var fi_pc: u32 = 0_u32;
    while fi_pc < nfns_pc {
        if !is_stub_fn(eir_prog, fi_pc) {
            var rcopy: usize = 0_usize;
            while rcopy < 4_usize {
                if !(try forward_readonly_pool_copies_fn(alloc, eir_prog, fi_pc, env)) {
                    break;
                }
                rcopy = rcopy +% 1_usize;
            }
        }
        fi_pc = fi_pc +% 1_u32;
    }
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "sroa_mem2reg", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "pool_copy_fwd", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    if ctx.failed { return ctx.stats; }

    // Pass 4: SCCP + Constant Folding + Algebraic Simplification + DBM Proof Exploitation (#2)
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_sccp_fold_dbm(alloc, eir_prog, env, &mut ctx.stats);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "sccp_fold_dbm", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "sccp_fold_dbm", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    if ctx.failed { return ctx.stats; }

    // Pass 5: Proven `noalias` Load Forwarding + Store-to-Load Forwarding (#1)
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_load_forwarding(alloc, eir_prog, env, &mut ctx.stats);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "load_forwarding", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "load_forwarding", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    if ctx.failed { return ctx.stats; }

    // Pass 6: Dominator-Scoped GVN / CSE
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_gvn(alloc, eir_prog, &mut ctx.stats);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "gvn", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "gvn", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    if ctx.failed { return ctx.stats; }

    // Pass 7: Natural Loop Detection + `block_loop_depth` + LICM
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_licm(alloc, eir_prog, env, &mut ctx.stats);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "licm", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "licm", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    if ctx.failed { return ctx.stats; }

    // Pass 8: Tail-Call Elimination (TCE)
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_tce(alloc, eir_prog, &mut ctx.stats);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "tce", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "tce", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    if ctx.failed { return ctx.stats; }

    // Pass 9: Domain Super-Opt #3 — SoA Loop Fusion
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_soa_loop_fusion(alloc, eir_prog, env, &mut ctx.stats);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "soa_loop_fusion", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "soa_loop_fusion", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
    if ctx.failed { return ctx.stats; }

    // Post-Fusion `noalias` Pool Column Store-to-Load Forwarding & GVN Cleanup
    if ctx.stats.fused_pool_loops > 0_u64 {
        if !opt_should_run(&mut ctx) { return ctx.stats; }
        try pass_load_forwarding(alloc, eir_prog, env, &mut ctx.stats);
        try pass_gvn(alloc, eir_prog, &mut ctx.stats);
        try pass_sccp_fold_dbm(alloc, eir_prog, env, &mut ctx.stats);
        try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "post_fusion_fwd", err_out);
        if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "post_fusion_fwd", t0, u0); t0 = rt.now_ns(clk); u0 = alloc.used_bytes(); } }
        if ctx.failed { return ctx.stats; }
    }

    // Pass 10: ADCE + CFG Simplification + Block Compaction + Final `block_loop_depth`
    if !opt_should_run(&mut ctx) { return ctx.stats; }
    try pass_adce_cfg_simplify(alloc, eir_prog, env, &mut ctx.stats);
    try opt_verify_after_pass(alloc, eir_prog, &mut ctx, "adce_cfg_simplify", err_out);
    if profile_passes { if let clk = clock_opt { try print_opt_pass_line(alloc, clk, "adce_cfg_simplify", t0, u0); } }

    return ctx.stats;
}
