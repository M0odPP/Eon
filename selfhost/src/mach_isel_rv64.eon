module eonc.mach_isel_rv64;

import core.col;
import core.str;
import eonc.span;
import eonc.ast;
import eonc.types;
import eonc.ctvm;
import eonc.cfg_ir;
import eonc.eir;
import eonc.target;
import eonc.rv64_asm;
import eonc.elf64;
import eonc.mach_ir;
import eonc.mach_x64;
import eonc.mach_isel_a64;

// ============================================================================
// Section 1: Public RISC-V 64 Blob Type, ABI Helpers & Literal Utilities
// ============================================================================

pub linear struct Rv64FnBlob {
    pub ok: bool;
    pub sym_id: u32;
    pub own_stack_bytes: u64;
    pub code: col.DynBuf[u8];
    pub relocs: col.DynBuf[rv64_asm.Rv64Reloc];
    pub rodata_items: col.DynBuf[mach_x64.RodataItemMeta];
    pub rodata_bytes: col.DynBuf[u8];
    pub rodata_relocs: col.DynBuf[mach_x64.RodataReloc];
    pub used_helpers: col.DynBuf[u32];
    pub line_entries: col.DynBuf[elf64.LineEntry];
    pub fn_ref_thunks: col.DynBuf[mach_x64.FnRefThunkReq];
    pub err_msg: str.StrBuf;
}

impl Rv64FnBlob {
    pub fn init(alloc: *mut AllocCap, sym_id: u32) -> Rv64FnBlob ! OutOfMemory {
        let code = try col.DynBuf.[u8].init(alloc, 128_usize);
        errdefer code.destroy(alloc);
        let relocs = try col.DynBuf.[rv64_asm.Rv64Reloc].init(alloc, 8_usize);
        errdefer relocs.destroy(alloc);
        let rodata_items = try col.DynBuf.[mach_x64.RodataItemMeta].init(alloc, 4_usize);
        errdefer rodata_items.destroy(alloc);
        let rodata_bytes = try col.DynBuf.[u8].init(alloc, 32_usize);
        errdefer rodata_bytes.destroy(alloc);
        let rodata_relocs = try col.DynBuf.[mach_x64.RodataReloc].init(alloc, 4_usize);
        errdefer rodata_relocs.destroy(alloc);
        let used_helpers = try col.DynBuf.[u32].init(alloc, 4_usize);
        errdefer used_helpers.destroy(alloc);
        let line_entries = try col.DynBuf.[elf64.LineEntry].init(alloc, 16_usize);
        errdefer line_entries.destroy(alloc);
        let fn_ref_thunks = try col.DynBuf.[mach_x64.FnRefThunkReq].init(alloc, 4_usize);
        errdefer fn_ref_thunks.destroy(alloc);
        let err_msg = try str.StrBuf.init(alloc, 16_usize);
        errdefer err_msg.destroy(alloc);
        return Rv64FnBlob.{
            ok: false, sym_id: sym_id, own_stack_bytes: 0_u64,
            code: code, relocs: relocs, rodata_items: rodata_items,
            rodata_bytes: rodata_bytes, rodata_relocs: rodata_relocs,
            used_helpers: used_helpers, line_entries: line_entries,
            fn_ref_thunks: fn_ref_thunks, err_msg: err_msg,
        };
    }

    pub fn destroy(self: Rv64FnBlob, alloc: *mut AllocCap) {
        let Rv64FnBlob.{
            ok: _, sym_id: _, own_stack_bytes: _, code, relocs, rodata_items,
            rodata_bytes, rodata_relocs, used_helpers, line_entries, fn_ref_thunks, err_msg,
        } = self;
        code.destroy(alloc); relocs.destroy(alloc); rodata_items.destroy(alloc);
        rodata_bytes.destroy(alloc); rodata_relocs.destroy(alloc); used_helpers.destroy(alloc);
        line_entries.destroy(alloc); fn_ref_thunks.destroy(alloc); err_msg.destroy(alloc);
    }
}

fn rv_gp_arg(idx: usize) -> ?u8 {
    if idx >= 8_usize { return null; }
    return rv64_asm.A0 +% idx.trunc.[u8]();
}

fn rv_flt_arg(idx: usize) -> ?u8 {
    if idx >= 8_usize { return null; }
    return rv64_asm.FA0 +% idx.trunc.[u8]();
}

fn intern_rodata_sym(alloc: *mut AllocCap, interner: *mut span.SymInterner, fn_sym_id: u32, idx: u64) -> u32 ! OutOfMemory {
    var sb = try str.StrBuf.init(alloc, 64_usize);
    errdefer sb.destroy(alloc);
    try sb.push_str_grow(alloc, ".Lrvro_");
    try sb.push_bytes_grow(alloc, interner.get(fn_sym_id));
    try sb.push_byte_grow(alloc, b'_');
    try sb.push_u64_grow(alloc, idx);
    let sid = try interner.intern(alloc, sb.as_bytes());
    sb.destroy(alloc);
    return sid;
}

fn parse_f64_lit(src: *[u8]) -> f64 {
    var end = src.len;
    if end >= 4_usize && src[end - 4_usize] == b'_' && src[end - 3_usize] == b'f' { end = end - 4_usize; }
    else if end >= 3_usize && src[end - 3_usize] == b'f' { end = end - 3_usize; }
    var i: usize = 0_usize;
    var neg = false;
    if i < end && src[i] == b'-' { neg = true; i = i +% 1_usize; }
    else if i < end && src[i] == b'+' { i = i +% 1_usize; }
    var int_p: f64 = 0.0_f64;
    while i < end {
        let ch = src[i];
        if ch == b'_' { i = i +% 1_usize; continue; }
        if ch >= b'0' && ch <= b'9' { int_p = int_p * 10.0_f64 + (ch - b'0').widen.[u64]().to_float.[f64](); i = i +% 1_usize; }
        else { break; }
    }
    var frac_p: f64 = 0.0_f64;
    var frac_d: f64 = 1.0_f64;
    if i < end && src[i] == b'.' {
        i = i +% 1_usize;
        while i < end {
            let ch = src[i];
            if ch == b'_' { i = i +% 1_usize; continue; }
            if ch >= b'0' && ch <= b'9' {
                frac_p = frac_p * 10.0_f64 + (ch - b'0').widen.[u64]().to_float.[f64]();
                frac_d = frac_d * 10.0_f64;
                i = i +% 1_usize;
            } else { break; }
        }
    }
    var val: f64 = int_p + (frac_p / frac_d);
    if i < end && (src[i] == b'e' || src[i] == b'E') {
        i = i +% 1_usize;
        var exp_neg = false;
        if i < end && src[i] == b'-' { exp_neg = true; i = i +% 1_usize; }
        else if i < end && src[i] == b'+' { i = i +% 1_usize; }
        var ea: i32 = 0_i32;
        while i < end {
            let ch = src[i];
            if ch == b'_' { i = i +% 1_usize; continue; }
            if ch >= b'0' && ch <= b'9' {
                if ea < 1000_i32 { ea = ea *% 10_i32 +% (ch - b'0').widen.[i32](); }
                i = i +% 1_usize;
            } else { break; }
        }
        var p10: f64 = 1.0_f64;
        var base: f64 = 10.0_f64;
        while ea > 0_i32 {
            if (ea & 1_i32) != 0_i32 { p10 = p10 * base; }
            base = base * base;
            ea = ea >> 1_i32;
        }
        if exp_neg { val = val / p10; } else { val = val * p10; }
    }
    if neg { val = -val; }
    return val;
}

fn f64_bits_to_f32_bits(bits: u64) -> u32 {
    let sign = ((bits >> 32_u64) & 0x80000000_u64).trunc.[u32]();
    let exp = ((bits >> 52_u64) & 0x7FF_u64).trunc.[i32]();
    let frac = bits & 0x000FFFFFFFFFFFFF_u64;
    if exp == 0x7FF_i32 {
        if frac != 0_u64 {
            let p = (frac >> 29_u64).trunc.[u32]();
            return sign | 0x7F800000_u32 | (if p == 0_u32 { 1_u32 } else { p });
        }
        return sign | 0x7F800000_u32;
    }
    if exp == 0_i32 { return sign; }
    let ub = exp -% 1023_i32;
    if ub > 127_i32 { return sign | 0x7F800000_u32; }
    if ub < -149_i32 { return sign; }
    if ub < -126_i32 {
        let full = frac | 0x0010000000000000_u64;
        let sh = (((-126_i32 -% ub).bitcast.[u32]() +% 29_u32).widen.[u64]()) & 63_u64;
        let m = (full >> sh).trunc.[u32]();
        let rem = full & ((1_u64 <<% sh) -% 1_u64);
        let half = 1_u64 <<% (sh -% 1_u64);
        let rnd: u32 = if rem > half || (rem == half && (m & 1_u32) != 0_u32) { 1_u32 } else { 0_u32 };
        return sign | (m +% rnd);
    }
    let fe = ((ub +% 127_i32).bitcast.[u32]()) <<% 23_u32;
    let m = (frac >> 29_u64).trunc.[u32]();
    let rem = frac & 0x1FFFFFFF_u64;
    let rnd: u32 = if rem > 0x10000000_u64 || (rem == 0x10000000_u64 && (m & 1_u32) != 0_u32) { 1_u32 } else { 0_u32 };
    return sign | (fe +% m +% rnd);
}

fn f32_bits_to_f16_bits(bits: u32) -> u16 {
    let sign = ((bits >> 16_u32) & 0x8000_u32).trunc.[u16]();
    let exp = ((bits >> 23_u32) & 0xFF_u32).bitcast.[i32]() -% 127_i32;
    let frac = bits & 0x007FFFFF_u32;
    if exp == 128_i32 {
        if frac != 0_u32 { return sign | 0x7E00_u16 | ((frac >> 13_u32).trunc.[u16]() & 0x03FF_u16); }
        return sign | 0x7C00_u16;
    }
    if exp > 15_i32 { return sign | 0x7C00_u16; }
    if exp < -14_i32 {
        if exp < -24_i32 { return sign; }
        let sh = (14_i32 -% exp +% 13_i32).bitcast.[u32]();
        if sh >= 32_u32 { return sign; }
        return sign | ((frac | 0x00800000_u32) >> sh).trunc.[u16]();
    }
    let he = ((exp +% 15_i32).bitcast.[u32]() & 0x1F_u32) <<% 10_u32;
    return sign | he.trunc.[u16]() | (frac >> 13_u32).trunc.[u16]();
}

// ============================================================================
// Section 2: Optimized SSA EIR -> `MachFunc` ISel for RISC-V 64 (`--release`)
// ============================================================================

fn is_fast_rv64_int_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    let n = env.get(ty);
    if n.kind == .Bool { return true; }
    if n.kind == .Int { let b = env.int_bits(ty); return b == 8_u8 || b == 16_u8 || b == 32_u8 || b == 64_u8; }
    if n.kind == .Enum || n.kind == .Char || n.kind == .RawPtr {
        let s = env.x64_layout(ty).size;
        return s == 1_usize || s == 2_usize || s == 4_usize || s == 8_usize;
    }
    return false;
}

fn is_fast_rv64_ty(env: *types.TypeEnv, ty: types.TyId) -> bool {
    let n = env.get(ty);
    if n.kind == .Void || n.kind == .Never || is_fast_rv64_int_ty(env, ty) { return true; }
    return n.kind == .Float && (n.u8_val == 32_u8 || n.u8_val == 64_u8);
}

fn rv_isel_vreg_of(vmap: *[u32], v: eir.EirValue) -> mach_ir.VReg {
    let idx = v.widen.[usize]();
    if idx < vmap.len { return vmap[idx]; }
    return mach_ir.VREG_NONE;
}

fn rv_isel_ensure_vreg(alloc: *mut AllocCap, mf: *mut mach_ir.MachFunc, eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, vmap: *mut [u32], v: eir.EirValue) -> mach_ir.VReg ! OutOfMemory {
    let idx = v.widen.[usize]();
    if idx < vmap.len && vmap[idx] != mach_ir.VREG_NONE { return vmap[idx]; }
    let cls: mach_ir.RegClass = if env.get(eir_prog.fn_val_ty(fn_id, v)).kind == .Float { .Vec128 } else { .Gpr };
    let vr = try mf.new_vreg(alloc, cls);
    if idx < vmap.len { vmap[idx] = vr; }
    return vr;
}

fn emit_mi1(alloc: *mut AllocCap, mf: *mut mach_ir.MachFunc, op: mach_ir.MachOp, dst: mach_ir.VReg, src0: mach_ir.VReg, sp: span.Span) -> !OutOfMemory {
    var mi = mach_ir.inst_empty(op, sp);
    mi.dst = dst; mi.src0 = src0;
    try mf.emit_inst(alloc, mi);
    return;
}

fn emit_mi2(alloc: *mut AllocCap, mf: *mut mach_ir.MachFunc, op: mach_ir.MachOp, dst: mach_ir.VReg, src0: mach_ir.VReg, src1: mach_ir.VReg, sp: span.Span) -> !OutOfMemory {
    var mi = mach_ir.inst_empty(op, sp);
    mi.dst = dst; mi.src0 = src0; mi.src1 = src1;
    try mf.emit_inst(alloc, mi);
    return;
}

fn emit_mi_ext(alloc: *mut AllocCap, mf: *mut mach_ir.MachFunc, dst: mach_ir.VReg, src0: mach_ir.VReg, bytes: u8, signed: bool, sp: span.Span) -> !OutOfMemory {
    if bytes >= 8_u8 { return; }
    var ex = mach_ir.inst_empty(.Extend, sp);
    ex.dst = dst; ex.src0 = src0; ex.size_bytes = bytes; ex.flag0 = signed;
    try mf.emit_inst(alloc, ex);
    return;
}

fn rv_args_fit_regs(eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, vals: *[eir.EirValue]) -> bool {
    var gp: usize = 0_usize;
    var fp: usize = 0_usize;
    var i: usize = 0_usize;
    while i < vals.len {
        let ty = eir_prog.fn_val_ty(fn_id, vals[i]);
        if !is_fast_rv64_ty(env, ty) { return false; }
        let cls = mach_isel_a64.a64_classify_arg(ty, env);
        if cls == .IntReg { if gp >= 8_usize { return false; } gp = gp +% 1_usize; }
        else if cls == .FloatReg { if fp >= 8_usize { return false; } fp = fp +% 1_usize; }
        else if cls != .Zst { return false; }
        i = i +% 1_usize;
    }
    return true;
}

fn rv_is_mach_eligible(eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv) -> bool {
    let f = eir_prog.get_fn(fn_id) orelse { return false; };
    if f.sig.effects.is_naked || f.sig.effects.is_interrupt || f.par_for_regions.len > 0_u32 { return false; }
    let rc = mach_isel_a64.a64_classify_ret(f.sig.ret, env);
    if rc.kind == .Sret || rc.kind == .TwoIntRegs || rc.kind == .ErrorUnion || !is_fast_rv64_ty(env, f.sig.ret) { return false; }
    if !rv_args_fit_regs(eir_prog, fn_id, env, eir_prog.fn_params(fn_id)) { return false; }
    let slots = eir_prog.fn_slots(fn_id);
    var si: usize = 0_usize;
    while si < slots.len { if !is_fast_rv64_ty(env, slots[si].ty) { return false; } si = si +% 1_usize; }
    let blks = eir_prog.fn_blocks(fn_id);
    if blks.len == 0_usize { return false; }
    var bi: usize = 0_usize;
    while bi < blks.len {
        let cur_b = blks[bi];
        let phis = eir_prog.phis_slice(cur_b.phis);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len { if !is_fast_rv64_ty(env, phis[phi_i].ty) { return false; } phi_i = phi_i +% 1_usize; }
        let insts = eir_prog.insts_slice(cur_b.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let ins = insts[ii];
            if ins.kind == .Const {
                if !is_fast_rv64_ty(env, ins.ty0) { return false; }
                let c = eir_prog.get_const(ins.aux0) orelse { return false; };
                if c.kind != .Void && c.kind != .Bool && c.kind != .Char && c.kind != .Int && c.kind != .EnumTag && c.kind != .Float { return false; }
                if c.kind == .Int && env.x64_layout(ins.ty0).size > 8_usize { return false; }
            } else if ins.kind == .Copy || ins.kind == .LoadSlot {
                if !is_fast_rv64_ty(env, eir_prog.fn_val_ty(fn_id, ins.dst)) { return false; }
            } else if ins.kind == .StoreSlot {
                if !is_fast_rv64_ty(env, eir_prog.fn_val_ty(fn_id, ins.v0)) { return false; }
            } else if ins.kind == .Unary {
                if !is_fast_rv64_int_ty(env, ins.ty0) { return false; }
                if ins.unary_op != .Neg && ins.unary_op != .Not && ins.unary_op != .BitNot { return false; }
            } else if ins.kind == .Binary {
                if !is_fast_rv64_ty(env, ins.ty0) || !is_fast_rv64_ty(env, ins.ty1) { return false; }
                if ins.bin_op == .AddCheck || ins.bin_op == .SubCheck || ins.bin_op == .MulCheck
                    || ins.bin_op == .DivCheck || ins.bin_op == .ModCheck
                    || ins.bin_op == .AddSat || ins.bin_op == .SubSat || ins.bin_op == .MulSat { return false; }
                if env.get(ins.ty1).kind == .Float && ins.bin_op != .Add && ins.bin_op != .Sub && ins.bin_op != .Mul && ins.bin_op != .Div { return false; }
            } else if ins.kind == .Cast {
                if !is_fast_rv64_ty(env, ins.ty0) || !is_fast_rv64_ty(env, ins.ty1) { return false; }
                if ins.cast_kind != .Widen && ins.cast_kind != .Trunc && ins.cast_kind != .Bitcast
                    && ins.cast_kind != .ToFloat && ins.cast_kind != .TruncToInt && ins.cast_kind != .AsU64 { return false; }
                if (ins.cast_kind == .ToFloat && !env.is_signed_int(ins.ty1)) || (ins.cast_kind == .TruncToInt && !env.is_signed_int(ins.ty0)) { return false; }
            } else if ins.kind == .Call {
                let cd = eir_prog.get_call(ins.aux0) orelse { return false; };
                if cd.callee.kind != .DirectFn && cd.callee.kind != .Method && cd.callee.kind != .GenericInst { return false; }
                let crc = mach_isel_a64.a64_classify_ret(cd.ret_ty, env);
                if crc.kind == .Sret || crc.kind == .TwoIntRegs || crc.kind == .ErrorUnion || !is_fast_rv64_ty(env, cd.ret_ty) { return false; }
                if !rv_args_fit_regs(eir_prog, fn_id, env, eir_prog.vals_slice(cd.args)) { return false; }
            } else { return false; }
            ii = ii +% 1_usize;
        }
        let bt = cur_b.term;
        if bt.kind == .SwitchInt { return false; }
        if bt.kind == .Branch && (eir_prog.block_phis(fn_id, bt.bb0).len > 0_usize || eir_prog.block_phis(fn_id, bt.bb1).len > 0_usize) { return false; }
        bi = bi +% 1_usize;
    }
    return true;
}

fn rv_lower_inst_mem(alloc: *mut AllocCap, mf: *mut mach_ir.MachFunc, eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, vmap: *mut [u32], slot_s: *[i32], ins: eir.EirInst) -> !OutOfMemory {
    let sp = ins.span;
    if ins.kind == .Const {
        if ins.dst != eir.EIR_NONE && env.x64_layout(ins.ty0).size > 0_usize {
            let dvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.dst);
            if let c = eir_prog.get_const(ins.aux0) {
                if c.kind == .Bool { try mf.emit_inst(alloc, mach_ir.inst_mov_imm(dvr, if c.bool_val { 1_i64 } else { 0_i64 }, sp)); }
                else if c.kind == .Char { try mf.emit_inst(alloc, mach_ir.inst_mov_imm(dvr, c.aux_u32.widen.[i64](), sp)); }
                else if c.kind == .Int || c.kind == .EnumTag { try mf.emit_inst(alloc, mach_ir.inst_mov_imm(dvr, c.int_val.lo.bitcast.[i64](), sp)); }
                else if c.kind == .Float {
                    let fval = parse_f64_lit(eir_prog.bytes_slice(c.bytes));
                    let is64 = env.get(ins.ty0).u8_val == 64_u8;
                    let tmp = try mf.new_vreg(alloc, .Gpr);
                    let bits: i64 = if is64 { fval.bitcast.[i64]() } else { f64_bits_to_f32_bits(fval.bitcast.[u64]()).widen.[i64]() };
                    try mf.emit_inst(alloc, mach_ir.inst_mov_imm(tmp, bits, sp));
                    try emit_mi1(alloc, mf, if is64 { .VMovQToXmm } else { .VMovDToXmm }, dvr, tmp, sp);
                }
            }
        }
    } else if ins.kind == .Copy {
        let ty = eir_prog.fn_val_ty(fn_id, ins.dst);
        if env.x64_layout(ty).size > 0_usize {
            let svr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.v0);
            let dvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.dst);
            if env.get(ty).kind == .Float { try emit_mi1(alloc, mf, .VMovVecReg, dvr, svr, sp); }
            else { try mf.emit_inst(alloc, mach_ir.inst_copy(dvr, svr, sp)); }
        }
    } else if ins.kind == .LoadSlot || ins.kind == .StoreSlot {
        let is_ld = ins.kind == .LoadSlot;
        let val = if is_ld { ins.dst } else { ins.v0 };
        let ty = eir_prog.fn_val_ty(fn_id, val);
        let lay = env.x64_layout(ty);
        if lay.size > 0_usize {
            let vr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, val);
            let sidx = ins.aux0.widen.[usize]();
            let m = mach_ir.mem_stack_slot(if sidx < slot_s.len { slot_s[sidx] } else { -8_i32 });
            if env.get(ty).kind == .Float {
                let is64 = env.get(ty).u8_val == 64_u8;
                let op: mach_ir.MachOp = if is_ld { if is64 { .VMovSDLoad } else { .VMovSSLoad } } else { if is64 { .VMovSDStore } else { .VMovSSStore } };
                var mi = mach_ir.inst_empty(op, sp);
                if is_ld { mi.dst = vr; } else { mi.src0 = vr; }
                mi.mem = m;
                try mf.emit_inst(alloc, mi);
            } else if is_ld {
                let op: mach_ir.MachOp = if env.is_signed_int(ty) && lay.size < 8_usize { .LoadSX } else { .Load };
                var mi = mach_ir.inst_empty(op, sp);
                mi.dst = vr; mi.mem = m; mi.size_bytes = lay.size.trunc.[u8]();
                try mf.emit_inst(alloc, mi);
            } else {
                try mf.emit_inst(alloc, mach_ir.inst_store(m, vr, lay.size.trunc.[u8](), sp));
            }
        }
    }
    return;
}

fn rv_lower_inst_alu(alloc: *mut AllocCap, mf: *mut mach_ir.MachFunc, eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, vmap: *mut [u32], ins: eir.EirInst) -> !OutOfMemory {
    let sp = ins.span;
    if ins.kind == .Unary {
        let svr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.v0);
        let dvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.dst);
        if ins.unary_op == .Not {
            var mi = mach_ir.inst_empty(.XorImm, sp);
            mi.dst = dvr; mi.src0 = svr; mi.imm = 1_i64;
            try mf.emit_inst(alloc, mi);
        } else {
            try emit_mi1(alloc, mf, if ins.unary_op == .Neg { .Neg } else { .Not }, dvr, svr, sp);
            try emit_mi_ext(alloc, mf, dvr, dvr, env.x64_layout(ins.ty0).size.trunc.[u8](), env.is_signed_int(ins.ty0), sp);
        }
        return;
    }
    let lvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.v0);
    let rvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.v1);
    let dvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.dst);
    if env.get(ins.ty1).kind == .Float {
        let is64 = env.get(ins.ty1).u8_val == 64_u8;
        var mop: mach_ir.MachOp = if is64 { .VDivSD } else { .VDivSS };
        if ins.bin_op == .Add { mop = if is64 { .VAddSD } else { .VAddSS }; }
        else if ins.bin_op == .Sub { mop = if is64 { .VSubSD } else { .VSubSS }; }
        else if ins.bin_op == .Mul { mop = if is64 { .VMulSD } else { .VMulSS }; }
        try emit_mi2(alloc, mf, mop, dvr, lvr, rvr, sp);
        return;
    }
    let signed = env.is_signed_int(ins.ty1);
    let bytes = env.x64_layout(ins.ty1).size.trunc.[u8]();
    let dbytes = env.x64_layout(ins.ty0).size.trunc.[u8]();
    if ins.bin_op == .Eq || ins.bin_op == .NotEq || ins.bin_op == .Lt || ins.bin_op == .LtEq || ins.bin_op == .Gt || ins.bin_op == .GtEq {
        try emit_mi2(alloc, mf, .Cmp, mach_ir.VREG_NONE, lvr, rvr, sp);
        var sc = mach_ir.inst_empty(.Setcc, sp);
        sc.dst = dvr; sc.cc = if signed { .Ge } else { .Ae };
        if ins.bin_op == .Eq { sc.cc = .E; }
        else if ins.bin_op == .NotEq { sc.cc = .Ne; }
        else if ins.bin_op == .Lt { sc.cc = if signed { .L } else { .B }; }
        else if ins.bin_op == .LtEq { sc.cc = if signed { .Le } else { .Be }; }
        else if ins.bin_op == .Gt { sc.cc = if signed { .G } else { .A }; }
        try mf.emit_inst(alloc, sc);
    } else if ins.bin_op == .Div || ins.bin_op == .Mod {
        var dv = mach_ir.inst_empty(if signed { .Idiv } else { .Div }, sp);
        dv.src0 = lvr; dv.src1 = rvr;
        if ins.bin_op == .Div { dv.dst = dvr; } else { dv.dst2 = dvr; }
        try mf.emit_inst(alloc, dv);
        try emit_mi_ext(alloc, mf, dvr, dvr, dbytes, signed, sp);
    } else {
        var mop: mach_ir.MachOp = if signed { .Sar } else { .Shr };
        if ins.bin_op == .Add || ins.bin_op == .AddWrap { mop = .Add; }
        else if ins.bin_op == .Sub || ins.bin_op == .SubWrap { mop = .Sub; }
        else if ins.bin_op == .Mul || ins.bin_op == .MulWrap { mop = .Mul; }
        else if ins.bin_op == .BitAnd || ins.bin_op == .And { mop = .And; }
        else if ins.bin_op == .BitOr || ins.bin_op == .Or { mop = .Or; }
        else if ins.bin_op == .BitXor { mop = .Xor; }
        else if ins.bin_op == .Shl || ins.bin_op == .ShlWrap { mop = .Shl; }
        var src_r = rvr;
        if ins.bin_op == .ShlWrap && bytes < 8_u8 {
            let mvr = try mf.new_vreg(alloc, .Gpr);
            var am = mach_ir.inst_empty(.AndImm, sp);
            am.dst = mvr; am.src0 = rvr; am.imm = (bytes.widen.[i64]() *% 8_i64) -% 1_i64;
            try mf.emit_inst(alloc, am);
            src_r = mvr;
        }
        try emit_mi2(alloc, mf, mop, dvr, lvr, src_r, sp);
        if ins.bin_op != .And && ins.bin_op != .Or {
            try emit_mi_ext(alloc, mf, dvr, dvr, dbytes, env.is_signed_int(ins.ty0), sp);
        }
    }
    return;
}

fn rv_lower_inst_cast_call(alloc: *mut AllocCap, mf: *mut mach_ir.MachFunc, eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, interner: *mut span.SymInterner, vmap: *mut [u32], ins: eir.EirInst) -> !OutOfMemory {
    let sp = ins.span;
    if ins.kind == .Cast {
        let svr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.v0);
        let dvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.dst);
        let fn_n = env.get(ins.ty1);
        let tn_n = env.get(ins.ty0);
        let bytes = env.x64_layout(ins.ty0).size.trunc.[u8]();
        if ins.cast_kind == .Widen {
            if fn_n.kind == .Float && tn_n.kind == .Float {
                try emit_mi1(alloc, mf, if fn_n.u8_val == 32_u8 && tn_n.u8_val == 64_u8 { .VCvtSS2SD } else { .VMovVecReg }, dvr, svr, sp);
            } else { try mf.emit_inst(alloc, mach_ir.inst_copy(dvr, svr, sp)); }
        } else if ins.cast_kind == .Trunc {
            if fn_n.kind == .Float && tn_n.kind == .Float {
                try emit_mi1(alloc, mf, if fn_n.u8_val == 64_u8 && tn_n.u8_val == 32_u8 { .VCvtSD2SS } else { .VMovVecReg }, dvr, svr, sp);
            } else if bytes < 8_u8 { try emit_mi_ext(alloc, mf, dvr, svr, bytes, env.is_signed_int(ins.ty0), sp); }
            else { try mf.emit_inst(alloc, mach_ir.inst_copy(dvr, svr, sp)); }
        } else if ins.cast_kind == .ToFloat || ins.cast_kind == .TruncToInt {
            let is_tf = ins.cast_kind == .ToFloat;
            let op: mach_ir.MachOp = if is_tf {
                if tn_n.u8_val == 64_u8 { .VCvtSI2SD } else { .VCvtSI2SS }
            } else {
                if fn_n.u8_val == 64_u8 { .VCvtTTSD2SI } else { .VCvtTTSS2SI }
            };
            var mi = mach_ir.inst_empty(op, sp);
            mi.dst = dvr; mi.src0 = svr; mi.size_bytes = 8_u8;
            try mf.emit_inst(alloc, mi);
            if !is_tf { try emit_mi_ext(alloc, mf, dvr, dvr, bytes, env.is_signed_int(ins.ty0), sp); }
        } else if ins.cast_kind == .Bitcast {
            if fn_n.kind == .Float && tn_n.kind != .Float {
                try emit_mi1(alloc, mf, if fn_n.u8_val == 64_u8 { .VMovQFromXmm } else { .VMovDFromXmm }, dvr, svr, sp);
                if env.is_signed_int(ins.ty0) { try emit_mi_ext(alloc, mf, dvr, dvr, bytes, true, sp); }
            } else if fn_n.kind != .Float && tn_n.kind == .Float {
                try emit_mi1(alloc, mf, if tn_n.u8_val == 64_u8 { .VMovQToXmm } else { .VMovDToXmm }, dvr, svr, sp);
            } else if bytes < 8_u8 { try emit_mi_ext(alloc, mf, dvr, svr, bytes, env.is_signed_int(ins.ty0), sp); }
            else { try mf.emit_inst(alloc, mach_ir.inst_copy(dvr, svr, sp)); }
        } else { try mf.emit_inst(alloc, mach_ir.inst_copy(dvr, svr, sp)); }
        return;
    }
    if ins.kind == .Call {
        if let cd = eir_prog.get_call(ins.aux0) {
            let cargs = eir_prog.vals_slice(cd.args);
            var gpi: usize = 0_usize;
            var fpi: usize = 0_usize;
            var cai: usize = 0_usize;
            while cai < cargs.len {
                let av = cargs[cai];
                let cls = mach_isel_a64.a64_classify_arg(eir_prog.fn_val_ty(fn_id, av), env);
                if cls == .IntReg || cls == .FloatReg {
                    let avr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, av);
                    let pr: u8 = if cls == .IntReg { rv64_asm.A0 +% gpi.trunc.[u8]() } else { rv64_asm.FA0 +% fpi.trunc.[u8]() };
                    try mf.emit_inst(alloc, mach_ir.inst_use_fixed(avr, pr, sp));
                    if cls == .IntReg { gpi = gpi +% 1_usize; } else { fpi = fpi +% 1_usize; }
                }
                cai = cai +% 1_usize;
            }
            var ckey = cfg_ir.fn_key_generic_inst(cd.callee.a);
            if cd.callee.kind == .DirectFn { ckey = cfg_ir.fn_key_top_def(cd.callee.a); }
            else if cd.callee.kind == .Method { ckey = cfg_ir.fn_key_impl_method(cd.callee.a, cd.callee.b); }
            let csym = try mach_isel_a64.a64_fn_sym_name_id(alloc, ckey, eir_prog, interner);
            try mf.emit_inst(alloc, mach_ir.inst_call_sym(csym, mf.reg_file.caller_saved_gprs, mf.reg_file.caller_saved_vecs, sp));
            if ins.dst != eir.EIR_NONE && env.x64_layout(cd.ret_ty).size > 0_usize {
                let dvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fn_id, env, vmap, ins.dst);
                try mf.emit_inst(alloc, mach_ir.inst_def_fixed(dvr, if env.get(cd.ret_ty).kind == .Float { rv64_asm.FA0 } else { rv64_asm.A0 }, sp));
            }
        }
    }
    return;
}

pub fn try_lower_eir_to_mach_rv64(
    alloc: *mut AllocCap,
    eir_prog: *eir.EirProgram,
    fi: u32,
    fn_sym: u32,
    env: *types.TypeEnv,
    interner: *mut span.SymInterner,
    tspec: target.TargetSpec,
    mf: *mut mach_ir.MachFunc,
) -> bool ! OutOfMemory {
    _ = fn_sym;
    if !rv_is_mach_eligible(eir_prog, fi, env) { return false; }
    let f = eir_prog.get_fn(fi) orelse { return false; };
    let params = eir_prog.fn_params(fi);
    let slots = eir_prog.fn_slots(fi);
    let blks = eir_prog.fn_blocks(fi);
    mf.reg_file = target.TargetRegFile.for_target(tspec);

    let nvals = f.value_tys.len.widen.[usize]();
    var vmap = try col.DynBuf.[u32].init(alloc, if nvals > 8_usize { nvals } else { 8_usize });
    errdefer vmap.destroy(alloc);
    var vi0: usize = 0_usize;
    while vi0 < nvals { try vmap.push(alloc, mach_ir.VREG_NONE); vi0 = vi0 +% 1_usize; }
    var slot_offs = try col.DynBuf.[i32].init(alloc, if slots.len > 4_usize { slots.len } else { 4_usize });
    errdefer slot_offs.destroy(alloc);
    var si: usize = 0_usize;
    while si < slots.len {
        let sl = env.x64_layout(slots[si].ty);
        try slot_offs.push(alloc, mf.alloc_stack_slot(if sl.size == 0_usize { 8_usize } else { sl.size }, if sl.align == 0_usize { 8_usize } else { sl.align }));
        si = si +% 1_usize;
    }

    var bi: usize = 0_usize;
    while bi < blks.len { _ = try mf.add_block(alloc, 0_u8); bi = bi +% 1_usize; }
    mf.entry_block = 0_u32;

    var pi: usize = 0_usize;
    while pi < params.len {
        if env.x64_layout(eir_prog.fn_val_ty(fi, params[pi])).size > 0_usize {
            _ = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fi, env, vmap.as_mut_slice(), params[pi]);
        }
        pi = pi +% 1_usize;
    }
    bi = 0_usize;
    while bi < blks.len {
        let phis = eir_prog.phis_slice(blks[bi].phis);
        var phi_i: usize = 0_usize;
        while phi_i < phis.len {
            if env.x64_layout(phis[phi_i].ty).size > 0_usize {
                _ = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fi, env, vmap.as_mut_slice(), phis[phi_i].dst);
            }
            phi_i = phi_i +% 1_usize;
        }
        bi = bi +% 1_usize;
    }

    let slot_s = slot_offs.as_slice();
    bi = 0_usize;
    while bi < blks.len {
        let cur_blk = blks[bi];
        let bb = bi.trunc.[u32]();
        mf.begin_block_insts(bb);
        if bi == 0_usize {
            var gpi: usize = 0_usize;
            var fpi: usize = 0_usize;
            var k: usize = 0_usize;
            while k < params.len {
                let pv = params[k];
                let cls = mach_isel_a64.a64_classify_arg(eir_prog.fn_val_ty(fi, pv), env);
                if cls == .IntReg || cls == .FloatReg {
                    let pr: u8 = if cls == .IntReg { rv64_asm.A0 +% gpi.trunc.[u8]() } else { rv64_asm.FA0 +% fpi.trunc.[u8]() };
                    try mf.emit_inst(alloc, mach_ir.inst_def_fixed(rv_isel_vreg_of(vmap.as_slice(), pv), pr, f.body_span));
                    if cls == .IntReg { gpi = gpi +% 1_usize; } else { fpi = fpi +% 1_usize; }
                }
                k = k +% 1_usize;
            }
        }
        let insts = eir_prog.insts_slice(cur_blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let ins = insts[ii];
            if ins.kind == .Const || ins.kind == .Copy || ins.kind == .LoadSlot || ins.kind == .StoreSlot {
                try rv_lower_inst_mem(alloc, mf, eir_prog, fi, env, vmap.as_mut_slice(), slot_s, ins);
            } else if ins.kind == .Unary || ins.kind == .Binary {
                try rv_lower_inst_alu(alloc, mf, eir_prog, fi, env, vmap.as_mut_slice(), ins);
            } else if ins.kind == .Cast || ins.kind == .Call {
                try rv_lower_inst_cast_call(alloc, mf, eir_prog, fi, env, interner, vmap.as_mut_slice(), ins);
            }
            ii = ii +% 1_usize;
        }
        let term = cur_blk.term;
        let tsp = term.span;
        if term.kind == .Goto {
            let ps = mf.pcopy_pairs.len().trunc.[u32]();
            let tphis = eir_prog.block_phis(fi, term.bb0);
            var tpi: usize = 0_usize;
            while tpi < tphis.len {
                let tphi = tphis[tpi];
                let inc = eir_prog.phi_incoming(tphi.incoming);
                var k: usize = 0_usize;
                while k < inc.len {
                    if inc[k].pred_bb == bb && inc[k].val != tphi.dst && env.x64_layout(tphi.ty).size > 0_usize {
                        let dvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fi, env, vmap.as_mut_slice(), tphi.dst);
                        let svr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fi, env, vmap.as_mut_slice(), inc[k].val);
                        try mf.add_pcopy_pair(alloc, dvr, svr);
                        break;
                    }
                    k = k +% 1_usize;
                }
                tpi = tpi +% 1_usize;
            }
            try mf.emit_parallel_copy(alloc, ps, mf.pcopy_pairs.len().trunc.[u32]() -% ps, tsp);
            try mf.emit_inst(alloc, mach_ir.inst_jmp(term.bb0, tsp));
        } else if term.kind == .Branch {
            let cvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fi, env, vmap.as_mut_slice(), term.val);
            var tst = mach_ir.inst_empty(.Cmp32Imm, tsp);
            tst.src0 = cvr; tst.imm = 0_i64;
            try mf.emit_inst(alloc, tst);
            try mf.emit_inst(alloc, mach_ir.inst_jcc(.Ne, term.bb0, tsp));
            try mf.emit_inst(alloc, mach_ir.inst_jmp(term.bb1, tsp));
        } else if term.kind == .Return {
            if term.flag && env.x64_layout(f.sig.ret).size > 0_usize {
                let rvr = try rv_isel_ensure_vreg(alloc, mf, eir_prog, fi, env, vmap.as_mut_slice(), term.val);
                try mf.emit_inst(alloc, mach_ir.inst_use_fixed(rvr, if env.get(f.sig.ret).kind == .Float { rv64_asm.FA0 } else { rv64_asm.A0 }, tsp));
            }
            try mf.emit_inst(alloc, mach_ir.inst_ret(tsp));
        } else if term.kind == .Unreachable {
            try mf.emit_inst(alloc, mach_ir.inst_empty(.Ud2, tsp));
        }
        mf.end_block_insts(bb);
        bi = bi +% 1_usize;
    }

    slot_offs.destroy(alloc);
    vmap.destroy(alloc);
    return true;
}

// ============================================================================
// Section 3: Direct 100%-EIR RV64 Codegen — Frame Planning & Linear Scan
// ============================================================================

const RV_LS_REG_COUNT: usize = 8_usize;

fn rv_ls_reg(idx: usize) -> u8 {
    if idx == 0_usize { return rv64_asm.S1; }
    return (17_usize +% idx).trunc.[u8]();
}

enum RvLocKind : u8 { Reg = 0, Stack = 1 }
struct RvValLoc { kind: RvLocKind; reg: u8; stack_off: i32; }
struct RvLiveIv { val: u32; start: u32; end: u32; }
struct RvActiveReg { end: u32; reg_idx: usize; }

fn loc_reg(r: u8) -> RvValLoc { return RvValLoc.{ kind: .Reg, reg: r, stack_off: 0_i32 }; }
fn loc_stack(off: i32) -> RvValLoc { return RvValLoc.{ kind: .Stack, reg: 0_u8, stack_off: off }; }

fn is_scalar_reg_cand(ty: types.TyId, env: *types.TypeEnv) -> bool {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize || lay.size > 8_usize { return false; }
    let n = env.get(ty);
    if n.kind == .Borrow { return n.borrow_kind == .Single; }
    if n.kind == .Builtin { return n.builtin_kind == .IdBrand || n.builtin_kind == .GenId || n.builtin_kind == .Link; }
    return n.kind == .Bool || n.kind == .Char || n.kind == .Int || n.kind == .Enum
        || n.kind == .ErrorSet || n.kind == .Bitfield || n.kind == .RawPtr
        || n.kind == .PhysAddr || n.kind == .VirtAddr || n.kind == .DmaAddr;
}

linear struct RvFramePlan {
    has_sret: bool;
    sret_off: i32;
    temp_off: i32;
    slot_offs: col.DynBuf[i32];
    val_locs: col.DynBuf[RvValLoc];
    saved_regs: col.DynBuf[u8];
    local_bytes: usize;
    saved_bytes: usize;
    total_sub: usize;
}

impl RvFramePlan {
    fn destroy(self: RvFramePlan, alloc: *mut AllocCap) {
        let RvFramePlan.{ has_sret: _, sret_off: _, temp_off: _, slot_offs, val_locs, saved_regs, local_bytes: _, saved_bytes: _, total_sub: _ } = self;
        slot_offs.destroy(alloc); val_locs.destroy(alloc); saved_regs.destroy(alloc);
    }
}

fn collect_inst_uses(alloc: *mut AllocCap, eir_prog: *eir.EirProgram, inst: *eir.EirInst, out: *mut col.DynBuf[eir.EirValue]) -> !OutOfMemory {
    if inst.kind == .LoadPlace || inst.kind == .StorePlace || inst.kind == .PlaceAddr {
        if let p = eir_prog.get_place(inst.aux0) {
            if p.base.kind == .Val { try out.push(alloc, p.base.id); }
            let projs = eir_prog.projs_slice(p.projs);
            var i: usize = 0_usize;
            while i < projs.len { if projs[i].kind == .Index { try out.push(alloc, projs[i].index); } i = i +% 1_usize; }
        }
        if inst.kind == .StorePlace { try out.push(alloc, inst.v0); }
        return;
    }
    if inst.kind == .PoolColumnLoad || inst.kind == .PoolColumnStore {
        if let op = eir_prog.get_pool_col_op(inst.aux0) {
            if op.pool_base.kind == .Val { try out.push(alloc, op.pool_base.id); }
            try out.push(alloc, op.index);
        }
        if inst.kind == .PoolColumnStore { try out.push(alloc, inst.v0); }
        return;
    }
    if inst.kind == .Aggregate {
        let es = eir_prog.vals_slice(inst.range);
        var i: usize = 0_usize;
        while i < es.len { try out.push(alloc, es[i]); i = i +% 1_usize; }
        return;
    }
    if inst.kind == .Call {
        if let cd = eir_prog.get_call(inst.aux0) {
            if cd.callee.kind == .FnPtr { try out.push(alloc, cd.callee.a); }
            let args = eir_prog.vals_slice(cd.args);
            var i: usize = 0_usize;
            while i < args.len { try out.push(alloc, args[i]); i = i +% 1_usize; }
        }
        return;
    }
    if inst.kind == .BuiltinCall {
        if let bc = eir_prog.get_builtin_call(inst.aux0) {
            let args = eir_prog.vals_slice(bc.args);
            var i: usize = 0_usize;
            while i < args.len { try out.push(alloc, args[i]); i = i +% 1_usize; }
        }
        return;
    }
    if inst.kind == .InlineAsm {
        if let ad = eir_prog.get_asm(inst.aux0) {
            let ins = eir_prog.asm_inputs_slice(ad.inputs);
            var i: usize = 0_usize;
            while i < ins.len { try out.push(alloc, ins[i].val); i = i +% 1_usize; }
        }
        return;
    }
    if inst.kind != .Const && inst.kind != .SlotAddr && inst.kind != .LoadSlot && inst.kind != .ParForHint {
        if inst.v0 != eir.EIR_NONE { try out.push(alloc, inst.v0); }
        if inst.v1 != eir.EIR_NONE { try out.push(alloc, inst.v1); }
        if inst.v2 != eir.EIR_NONE { try out.push(alloc, inst.v2); }
    }
    return;
}

fn sort_rv_ivs(iv: *mut [RvLiveIv]) {
    let n = iv.len;
    if n <= 1_usize { return; }
    var gap: usize = 1_usize;
    let third = n / 3_usize;
    while gap < third { gap = (gap *% 3_usize) +% 1_usize; }
    while gap > 0_usize {
        var i = gap;
        while i < n {
            let cur = iv[i];
            var j = i;
            while j >= gap && j < n {
                let p = iv[j - gap];
                if p.start < cur.start || (p.start == cur.start && p.val <= cur.val) { break; }
                iv[j] = p;
                j = j - gap;
            }
            iv[j] = cur;
            i = i +% 1_usize;
        }
        gap = gap / 3_usize;
    }
}

fn rv_set_def_end(dp: *mut [u32], ep: *mut [u32], idx: usize, d: u32, e: u32) {
    if idx < dp.len && dp[idx] == 0xFFFFFFFF_u32 { dp[idx] = d; }
    if idx < ep.len && e > ep[idx] { ep[idx] = e; }
}

fn plan_rv_direct_frame(alloc: *mut AllocCap, eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, has_sret: bool) -> RvFramePlan ! OutOfMemory {
    let slots = eir_prog.fn_slots(fn_id);
    let nvals = if let f0 = eir_prog.get_fn(fn_id) { f0.value_tys.len.widen.[usize]() } else { 0_usize };
    var slot_offs = try col.DynBuf.[i32].init(alloc, if slots.len > 4_usize { slots.len } else { 4_usize });
    errdefer slot_offs.destroy(alloc);
    var val_locs = try col.DynBuf.[RvValLoc].init(alloc, if nvals > 8_usize { nvals } else { 8_usize });
    errdefer val_locs.destroy(alloc);
    var saved_regs = try col.DynBuf.[u8].init(alloc, RV_LS_REG_COUNT);
    errdefer saved_regs.destroy(alloc);

    var cursor: usize = 0_usize;
    var sret_off: i32 = 0_i32;
    if has_sret { cursor = 8_usize; sret_off = -8_i32; }
    cursor = types.align_up_usize(cursor +% 128_usize, 16_usize);
    let temp_off = 0_i32 -% cursor.trunc.[i32]();

    var si: usize = 0_usize;
    while si < slots.len {
        let lay = env.x64_layout(slots[si].ty);
        let al = if lay.align <= 8_usize { 8_usize } else if lay.align <= 16_usize { 16_usize } else { 32_usize };
        cursor = types.align_up_usize(cursor +% (if lay.size == 0_usize { 8_usize } else { lay.size }), al);
        try slot_offs.push(alloc, 0_i32 -% cursor.trunc.[i32]());
        si = si +% 1_usize;
    }

    var need_addr = try col.BitSet.init(alloc, if nvals > 1_usize { nvals } else { 1_usize });
    errdefer need_addr.destroy(alloc);
    var def_pos = try col.DynBuf.[u32].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer def_pos.destroy(alloc);
    var end_pos = try col.DynBuf.[u32].init(alloc, if nvals > 4_usize { nvals } else { 4_usize });
    errdefer end_pos.destroy(alloc);
    var vi0: usize = 0_usize;
    while vi0 < nvals {
        try val_locs.push(alloc, loc_stack(0_i32));
        try def_pos.push(alloc, 0xFFFFFFFF_u32);
        try end_pos.push(alloc, 0_u32);
        vi0 = vi0 +% 1_usize;
    }

    let dp_m = def_pos.as_mut_slice();
    let ep_m = end_pos.as_mut_slice();
    let params = eir_prog.fn_params(fn_id);
    var pi: usize = 0_usize;
    while pi < params.len { rv_set_def_end(dp_m, ep_m, params[pi].widen.[usize](), 0_u32, 1_u32); pi = pi +% 1_usize; }

    var uses_tmp = try col.DynBuf.[eir.EirValue].init(alloc, 16_usize);
    errdefer uses_tmp.destroy(alloc);
    let blks = eir_prog.fn_blocks(fn_id);
    var pos: u32 = 2_u32;
    var bi: usize = 0_usize;
    while bi < blks.len {
        let cur_blk = blks[bi];
        let insts = eir_prog.insts_slice(cur_blk.insts);
        var ii: usize = 0_usize;
        while ii < insts.len {
            let ins = insts[ii];
            uses_tmp.clear();
            try collect_inst_uses(alloc, eir_prog, &ins, &mut uses_tmp);
            let us = uses_tmp.as_slice();
            var ui: usize = 0_usize;
            while ui < us.len { rv_set_def_end(dp_m, ep_m, us[ui].widen.[usize](), 0_u32, pos); ui = ui +% 1_usize; }
            if ins.dst != eir.EIR_NONE { rv_set_def_end(dp_m, ep_m, ins.dst.widen.[usize](), pos, pos); }
            if ins.kind == .LoadPlace || ins.kind == .StorePlace || ins.kind == .PlaceAddr {
                if let pl = eir_prog.get_place(ins.aux0) { if pl.base.kind == .Val { need_addr.set(pl.base.id.widen.[usize]()); } }
            } else if ins.kind == .PoolColumnLoad || ins.kind == .PoolColumnStore {
                if let op = eir_prog.get_pool_col_op(ins.aux0) { if op.pool_base.kind == .Val && !op.pool_is_ptr { need_addr.set(op.pool_base.id.widen.[usize]()); } }
            } else if ins.kind == .Slice { need_addr.set(ins.v0.widen.[usize]()); }
            else if ins.kind == .Call {
                if let cd = eir_prog.get_call(ins.aux0) {
                    let cargs = eir_prog.vals_slice(cd.args);
                    var ci: usize = 0_usize;
                    while ci < cargs.len {
                        if mach_isel_a64.a64_classify_arg(eir_prog.fn_val_ty(fn_id, cargs[ci]), env) == .ByPtr { need_addr.set(cargs[ci].widen.[usize]()); }
                        ci = ci +% 1_usize;
                    }
                }
            } else if ins.kind == .BuiltinCall {
                if let bc = eir_prog.get_builtin_call(ins.aux0) {
                    let ba = eir_prog.vals_slice(bc.args);
                    if ba.len > 0_usize { need_addr.set(ba[0_usize].widen.[usize]()); }
                }
            }
            pos = pos +% 1_u32; ii = ii +% 1_usize;
        }
        let term = cur_blk.term;
        if (term.kind == .Branch || term.kind == .SwitchInt || (term.kind == .Return && term.flag)) && term.val != eir.EIR_NONE {
            rv_set_def_end(dp_m, ep_m, term.val.widen.[usize](), 0_u32, pos);
        }
        pos = pos +% 1_u32; bi = bi +% 1_usize;
    }

    let vl_m = val_locs.as_mut_slice();
    if blks.len <= 1_usize {
        let dp_ro = def_pos.as_slice();
        let ep_ro = end_pos.as_slice();
        var cands = try col.DynBuf.[RvLiveIv].init(alloc, 16_usize);
        errdefer cands.destroy(alloc);
        var vi: usize = 0_usize;
        while vi < nvals && vi < dp_ro.len && vi < ep_ro.len {
            if is_scalar_reg_cand(eir_prog.fn_val_ty(fn_id, vi.trunc.[u32]()), env) && !need_addr.test(vi) && dp_ro[vi] != 0xFFFFFFFF_u32 {
                try cands.push(alloc, RvLiveIv.{ val: vi.trunc.[u32](), start: dp_ro[vi], end: ep_ro[vi] });
            }
            vi = vi +% 1_usize;
        }
        sort_rv_ivs(cands.as_mut_slice());
        var active = try col.DynBuf.[RvActiveReg].init(alloc, RV_LS_REG_COUNT);
        errdefer active.destroy(alloc);
        var reg_free: [8]bool = [true; 8];
        var reg_used: [8]bool = [false; 8];
        let cs = cands.as_slice();
        var ci: usize = 0_usize;
        while ci < cs.len {
            let iv = cs[ci];
            var ae: usize = 0_usize;
            while ae < active.len() {
                let am = active.as_mut_slice();
                if ae >= am.len { break; }
                if am[ae].end < iv.start {
                    let ridx = am[ae].reg_idx;
                    if ridx < 8_usize { reg_free[ridx] = true; }
                    let li = am.len - 1_usize;
                    if ae != li { am[ae] = am[li]; }
                    _ = active.pop();
                } else { ae = ae +% 1_usize; }
            }
            var ri: usize = 0_usize;
            while ri < RV_LS_REG_COUNT {
                if reg_free[ri] {
                    reg_free[ri] = false; reg_used[ri] = true;
                    try active.push(alloc, RvActiveReg.{ end: iv.end, reg_idx: ri });
                    let ivu = iv.val.widen.[usize]();
                    if ivu < vl_m.len { vl_m[ivu] = loc_reg(rv_ls_reg(ri)); }
                    break;
                }
                ri = ri +% 1_usize;
            }
            ci = ci +% 1_usize;
        }
        var rs: usize = 0_usize;
        while rs < RV_LS_REG_COUNT { if reg_used[rs] { try saved_regs.push(alloc, rv_ls_reg(rs)); } rs = rs +% 1_usize; }
        active.destroy(alloc);
        cands.destroy(alloc);
    }

    var vi: usize = 0_usize;
    while vi < nvals && vi < vl_m.len {
        if vl_m[vi].kind == .Stack {
            let lay = env.x64_layout(eir_prog.fn_val_ty(fn_id, vi.trunc.[u32]()));
            if lay.size > 0_usize {
                let al = if lay.align <= 8_usize { 8_usize } else if lay.align <= 16_usize { 16_usize } else { 32_usize };
                cursor = types.align_up_usize(cursor +% (if lay.size < 8_usize { 8_usize } else { lay.size }), al);
                vl_m[vi] = loc_stack(0_i32 -% cursor.trunc.[i32]());
            }
        }
        vi = vi +% 1_usize;
    }

    uses_tmp.destroy(alloc); end_pos.destroy(alloc); def_pos.destroy(alloc); need_addr.destroy(alloc);
    let local_bytes = types.align_up_usize(cursor, 16_usize);
    let saved_bytes = types.align_up_usize(saved_regs.len() *% 8_usize, 16_usize);
    return RvFramePlan.{
        has_sret: has_sret, sret_off: sret_off, temp_off: temp_off,
        slot_offs: slot_offs, val_locs: val_locs, saved_regs: saved_regs,
        local_bytes: local_bytes, saved_bytes: saved_bytes, total_sub: local_bytes +% saved_bytes,
    };
}

// ============================================================================
// Section 4: Direct RV64 Codegen State & Core Memory/Value Helpers
// ============================================================================

linear struct RvCg {
    fn_id: u32;
    fn_sym_id: u32;
    ret_ty: types.TyId;
    ret_class: mach_isel_a64.A64RetClass;
    is_naked: bool;
    is_export_c: bool;
    sanitize: bool;
    emit_debug_line: bool;
    failed: bool;
    oom: bool;
    err_msg: str.StrBuf;
    frame: RvFramePlan;
    buf: rv64_asm.Rv64Buf;
    blk_labels: col.DynBuf[u32];
    rodata_items: col.DynBuf[mach_x64.RodataItemMeta];
    rodata_bytes: col.DynBuf[u8];
    rodata_relocs: col.DynBuf[mach_x64.RodataReloc];
    used_helpers: col.DynBuf[u32];
    line_entries: col.DynBuf[elf64.LineEntry];
    fn_ref_thunks: col.DynBuf[mach_x64.FnRefThunkReq];
    last_line_file: u32;
    last_line_num: u32;
    max_call_stk: u64;
}

impl RvCg {
    fn destroy(self: RvCg, alloc: *mut AllocCap) {
        let RvCg.{
            fn_id: _, fn_sym_id: _, ret_ty: _, ret_class: _, is_naked: _, is_export_c: _, sanitize: _, emit_debug_line: _,
            failed: _, oom: _, err_msg, frame, buf, blk_labels, rodata_items, rodata_bytes, rodata_relocs,
            used_helpers, line_entries, fn_ref_thunks, last_line_file: _, last_line_num: _, max_call_stk: _,
        } = self;
        err_msg.destroy(alloc); frame.destroy(alloc); buf.destroy(alloc); blk_labels.destroy(alloc);
        rodata_items.destroy(alloc); rodata_bytes.destroy(alloc); rodata_relocs.destroy(alloc);
        used_helpers.destroy(alloc); line_entries.destroy(alloc); fn_ref_thunks.destroy(alloc);
    }
}

fn ld(alloc: *mut AllocCap, cg: *mut RvCg, rd: u8, base: u8, disp: i32, sz: u8) {
    cg.buf.load_mem(alloc, rd, base, disp, sz, false, rv64_asm.T6);
    return;
}

fn lds(alloc: *mut AllocCap, cg: *mut RvCg, rd: u8, base: u8, disp: i32, sz: u8, s: bool) {
    cg.buf.load_mem(alloc, rd, base, disp, sz, s, rv64_asm.T6);
    return;
}

fn st(alloc: *mut AllocCap, cg: *mut RvCg, base: u8, disp: i32, val: u8, sz: u8) {
    cg.buf.store_mem(alloc, base, disp, val, sz, rv64_asm.T6);
    return;
}

fn ldf(alloc: *mut AllocCap, cg: *mut RvCg, is64: bool, fd: u8, base: u8, disp: i32) {
    cg.buf.fload(alloc, is64, fd, base, disp, rv64_asm.T6);
    return;
}

fn stf(alloc: *mut AllocCap, cg: *mut RvCg, is64: bool, base: u8, disp: i32, fs: u8) {
    cg.buf.fstore(alloc, is64, base, disp, fs, rv64_asm.T6);
    return;
}

fn addl(alloc: *mut AllocCap, cg: *mut RvCg, rd: u8, rs: u8, disp: i64) {
    cg.buf.add_imm_large(alloc, rd, rs, disp, rv64_asm.T6);
    return;
}

fn st_eu_err(alloc: *mut AllocCap, cg: *mut RvCg, doff: i32, tag: i32) {
    cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, tag);
    st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 4_u8);
    return;
}

fn cg_fail(alloc: *mut AllocCap, cg: *mut RvCg, msg: *str) {
    if !cg.failed { cg.failed = true; cg.err_msg.clear(); cg.err_msg.push_str_grow(alloc, msg) catch { cg.oom = true; }; }
}

fn cg_val_loc(cg: *RvCg, v: eir.EirValue) -> RvValLoc {
    let idx = v.widen.[usize]();
    let s = cg.frame.val_locs.as_slice();
    if idx < s.len { return s[idx]; }
    return loc_stack(0_i32);
}

fn cg_val_off(cg: *RvCg, v: eir.EirValue) -> i32 { return cg_val_loc(cg, v).stack_off; }

fn cg_slot_off(cg: *RvCg, slot: eir.EirSlot) -> i32 {
    let idx = slot.widen.[usize]();
    let s = cg.frame.slot_offs.as_slice();
    if idx < s.len { return s[idx]; }
    return 0_i32;
}

fn cg_blk_lbl(cg: *RvCg, bb: eir.BlockId) -> u32 {
    let idx = bb.widen.[usize]();
    let s = cg.blk_labels.as_slice();
    if idx < s.len { return s[idx]; }
    return 0_u32;
}

fn cg_note_helper(alloc: *mut AllocCap, cg: *mut RvCg, sym: u32) {
    let hs = cg.used_helpers.as_slice();
    var i: usize = 0_usize;
    while i < hs.len { if hs[i] == sym { return; } i = i +% 1_usize; }
    cg.used_helpers.push(alloc, sym) catch { cg.oom = true; };
}

fn cg_helper_call(alloc: *mut AllocCap, cg: *mut RvCg, interner: *mut span.SymInterner, name: *str) {
    let sym = interner.intern_str(alloc, name) catch { cg.oom = true; return; };
    cg_note_helper(alloc, cg, sym);
    cg.buf.call_sym(alloc, sym);
}

fn cg_call_alloc_raw(alloc: *mut AllocCap, cg: *mut RvCg, interner: *mut span.SymInterner) {
    cg_helper_call(alloc, cg, interner, if cg.sanitize { "eon_alloc_raw_san" } else { "eon_alloc_raw" });
    return;
}

fn cg_call_free_raw(alloc: *mut AllocCap, cg: *mut RvCg, interner: *mut span.SymInterner) {
    cg_helper_call(alloc, cg, interner, if cg.sanitize { "eon_free_raw_san" } else { "eon_free_raw" });
    return;
}

fn cg_intern_rodata(alloc: *mut AllocCap, cg: *mut RvCg, interner: *mut span.SymInterner, bytes: *[u8], align: u32) -> u32 {
    let sym = intern_rodata_sym(alloc, interner, cg.fn_sym_id, cg.rodata_items.len().widen.[u64]()) catch { cg.oom = true; return 0_u32; };
    let data_off = cg.rodata_bytes.len().trunc.[u32]();
    cg.rodata_bytes.push_slice(alloc, bytes) catch { cg.oom = true; return 0_u32; };
    cg.rodata_items.push(alloc, mach_x64.RodataItemMeta.{
        sym_id: sym, data_off: data_off, data_len: bytes.len.trunc.[u32](), align: align, reloc_start: 0_u32, reloc_len: 0_u32,
    }) catch { cg.oom = true; return 0_u32; };
    return sym;
}

fn cg_record_line(alloc: *mut AllocCap, cg: *mut RvCg, sm: *span.SourceMap, sp: span.Span) {
    if !cg.emit_debug_line || sp.file == span.FILE_DUMMY { return; }
    let lc = sm.line_col(sp.file, sp.start);
    if lc.line == 0_u32 || (sp.file == cg.last_line_file && lc.line == cg.last_line_num) { return; }
    cg.last_line_file = sp.file; cg.last_line_num = lc.line;
    cg.line_entries.push(alloc, elf64.LineEntry.{ code_offset: cg.buf.pos(), file_idx: sp.file +% 1_u32, line: lc.line, col: lc.col }) catch { cg.oom = true; };
}

/// Copies `size` bytes preserving ALL of `A0..A7`, `T0..T4`, `S1..S11`.
fn cg_copy_mem(alloc: *mut AllocCap, cg: *mut RvCg, dst_base: u8, dst_disp: i32, src_base: u8, src_disp: i32, size: usize) {
    if size == 0_usize { return; }
    if size <= 32_usize {
        var off: usize = 0_usize;
        while off < size {
            let rem = size - off;
            let step: usize = if rem >= 8_usize { 8_usize } else if rem >= 4_usize { 4_usize } else if rem >= 2_usize { 2_usize } else { 1_usize };
            ld(alloc, cg, rv64_asm.T5, src_base, src_disp +% off.trunc.[i32](), step.trunc.[u8]());
            st(alloc, cg, dst_base, dst_disp +% off.trunc.[i32](), rv64_asm.T5, step.trunc.[u8]());
            off = off +% step;
        }
        return;
    }
    let save_off = cg.frame.temp_off +% 104_i32;
    st(alloc, cg, rv64_asm.FP, save_off, rv64_asm.T3, 8_u8);
    st(alloc, cg, rv64_asm.FP, save_off +% 8_i32, rv64_asm.T4, 8_u8);
    addl(alloc, cg, rv64_asm.T5, dst_base, dst_disp.widen.[i64]());
    addl(alloc, cg, rv64_asm.T4, src_base, src_disp.widen.[i64]());
    cg.buf.mv(alloc, rv64_asm.T3, rv64_asm.T5);
    cg.buf.li64(alloc, rv64_asm.T5, (size >> 3_usize).widen.[u64]());
    let l_lp = cg.buf.new_label(alloc);
    cg.buf.bind_label(l_lp);
    ld(alloc, cg, rv64_asm.T6, rv64_asm.T4, 0_i32, 8_u8);
    st(alloc, cg, rv64_asm.T3, 0_i32, rv64_asm.T6, 8_u8);
    cg.buf.addi(alloc, rv64_asm.T4, rv64_asm.T4, 8_i32);
    cg.buf.addi(alloc, rv64_asm.T3, rv64_asm.T3, 8_i32);
    cg.buf.addi(alloc, rv64_asm.T5, rv64_asm.T5, -1_i32);
    cg.buf.br_short_label(alloc, .Ne, rv64_asm.T5, rv64_asm.ZERO, l_lp);
    var tail: usize = 0_usize;
    let rem = size & 7_usize;
    while tail < rem {
        cg.buf.load_mem(alloc, rv64_asm.T6, rv64_asm.T4, tail.trunc.[i32](), 1_u8, false, rv64_asm.T5);
        cg.buf.store_mem(alloc, rv64_asm.T3, tail.trunc.[i32](), rv64_asm.T6, 1_u8, rv64_asm.T5);
        tail = tail +% 1_usize;
    }
    ld(alloc, cg, rv64_asm.T3, rv64_asm.FP, save_off, 8_u8);
    ld(alloc, cg, rv64_asm.T4, rv64_asm.FP, save_off +% 8_i32, 8_u8);
    return;
}

fn cg_copy_mem_dyn(alloc: *mut AllocCap, cg: *mut RvCg, dst_reg: u8, src_reg: u8, cnt_reg: u8) {
    let l_lp = cg.buf.new_label(alloc);
    let l_dn = cg.buf.new_label(alloc);
    cg.buf.bind_label(l_lp);
    cg.buf.br_short_label(alloc, .Eq, cnt_reg, rv64_asm.ZERO, l_dn);
    ld(alloc, cg, rv64_asm.T5, src_reg, 0_i32, 1_u8);
    st(alloc, cg, dst_reg, 0_i32, rv64_asm.T5, 1_u8);
    cg.buf.addi(alloc, src_reg, src_reg, 1_i32);
    cg.buf.addi(alloc, dst_reg, dst_reg, 1_i32);
    cg.buf.addi(alloc, cnt_reg, cnt_reg, -1_i32);
    cg.buf.j_label(alloc, l_lp);
    cg.buf.bind_label(l_dn);
    return;
}

fn cg_memzero(alloc: *mut AllocCap, cg: *mut RvCg, dst_base: u8, dst_disp: i32, size: usize) {
    if size == 0_usize { return; }
    if size <= 32_usize {
        var off: usize = 0_usize;
        while off < size {
            let rem = size - off;
            let step: usize = if rem >= 8_usize { 8_usize } else if rem >= 4_usize { 4_usize } else { 1_usize };
            st(alloc, cg, dst_base, dst_disp +% off.trunc.[i32](), rv64_asm.ZERO, step.trunc.[u8]());
            off = off +% step;
        }
        return;
    }
    addl(alloc, cg, rv64_asm.T5, dst_base, dst_disp.widen.[i64]());
    cg.buf.li64(alloc, rv64_asm.T6, (size >> 3_usize).widen.[u64]());
    let l_lp = cg.buf.new_label(alloc);
    cg.buf.bind_label(l_lp);
    st(alloc, cg, rv64_asm.T5, 0_i32, rv64_asm.ZERO, 8_u8);
    cg.buf.addi(alloc, rv64_asm.T5, rv64_asm.T5, 8_i32);
    cg.buf.addi(alloc, rv64_asm.T6, rv64_asm.T6, -1_i32);
    cg.buf.br_short_label(alloc, .Ne, rv64_asm.T6, rv64_asm.ZERO, l_lp);
    var tail: usize = 0_usize;
    let rem = size & 7_usize;
    while tail < rem { st(alloc, cg, rv64_asm.T5, tail.trunc.[i32](), rv64_asm.ZERO, 1_u8); tail = tail +% 1_usize; }
    return;
}

fn cg_norm_subword(alloc: *mut AllocCap, cg: *mut RvCg, env: *types.TypeEnv, ty: types.TyId, reg: u8) {
    let bits = env.int_bits(ty);
    if bits > 0_u8 && bits < 64_u8 { cg.buf.extend_bits(alloc, reg, reg, bits, env.is_signed_int(ty)); }
    return;
}

fn cg_load_scalar_raw(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, v: eir.EirValue, dst: u8) {
    let lay = env.x64_layout(eir_prog.fn_val_ty(cg.fn_id, v));
    if lay.size == 0_usize { cg.buf.mv(alloc, dst, rv64_asm.ZERO); return; }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg { cg.buf.mv(alloc, dst, loc.reg); }
    else { ld(alloc, cg, dst, rv64_asm.FP, loc.stack_off, if lay.size <= 8_usize { lay.size.trunc.[u8]() } else { 8_u8 }); }
    return;
}

fn cg_load_scalar_val(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, v: eir.EirValue, dst: u8) {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize { cg.buf.mv(alloc, dst, rv64_asm.ZERO); return; }
    let signed = env.is_signed_int(ty);
    let bits = env.int_bits(ty);
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        if bits > 0_u8 && bits < 64_u8 { cg.buf.extend_bits(alloc, dst, loc.reg, bits, signed); }
        else if lay.size < 8_usize { cg.buf.extend_bits(alloc, dst, loc.reg, (lay.size *% 8_usize).trunc.[u8](), signed); }
        else { cg.buf.mv(alloc, dst, loc.reg); }
    } else {
        let bytes = if lay.size <= 8_usize { lay.size.trunc.[u8]() } else { 8_u8 };
        lds(alloc, cg, dst, rv64_asm.FP, loc.stack_off, bytes, signed);
        if bits > 0_u8 && bits < 64_u8 && bits != (bytes *% 8_u8) { cg.buf.extend_bits(alloc, dst, dst, bits, signed); }
    }
    return;
}

fn cg_store_scalar_val(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, v: eir.EirValue, src: u8) {
    let ty = eir_prog.fn_val_ty(cg.fn_id, v);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize { return; }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg {
        let bits = env.int_bits(ty);
        let signed = env.is_signed_int(ty);
        if bits > 0_u8 && bits < 64_u8 { cg.buf.extend_bits(alloc, loc.reg, src, bits, signed); }
        else if lay.size < 8_usize { cg.buf.extend_bits(alloc, loc.reg, src, (lay.size *% 8_usize).trunc.[u8](), signed); }
        else { cg.buf.mv(alloc, loc.reg, src); }
    } else {
        st(alloc, cg, rv64_asm.FP, loc.stack_off, src, if lay.size <= 8_usize { lay.size.trunc.[u8]() } else { 8_u8 });
    }
    return;
}

fn cg_load_float_val(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, v: eir.EirValue, fdst: u8) {
    let n = env.get(eir_prog.fn_val_ty(cg.fn_id, v));
    if n.kind == .Float && n.u8_val == 16_u8 {
        cg_load_scalar_raw(alloc, cg, eir_prog, env, v, rv64_asm.A0);
        cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        cg.buf.fmv(alloc, false, fdst, rv64_asm.FA0);
        return;
    }
    ldf(alloc, cg, n.kind == .Float && n.u8_val == 64_u8, fdst, rv64_asm.FP, cg_val_off(cg, v));
    return;
}

fn cg_store_float_val(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, v: eir.EirValue, fsrc: u8) {
    let n = env.get(eir_prog.fn_val_ty(cg.fn_id, v));
    if n.kind == .Float && n.u8_val == 16_u8 {
        cg.buf.fmv(alloc, false, rv64_asm.FA0, fsrc);
        cg_helper_call(alloc, cg, interner, "eon_f32_to_f16");
        cg_store_scalar_val(alloc, cg, eir_prog, env, v, rv64_asm.A0);
        return;
    }
    stf(alloc, cg, n.kind == .Float && n.u8_val == 64_u8, rv64_asm.FP, cg_val_off(cg, v), fsrc);
    return;
}

fn cg_val_addr_into(alloc: *mut AllocCap, cg: *mut RvCg, v: eir.EirValue, dst: u8) {
    addl(alloc, cg, dst, rv64_asm.FP, cg_val_off(cg, v).widen.[i64]());
    return;
}

fn cg_copy_val_to_val(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, src: eir.EirValue) {
    if dst == src { return; }
    let ty = eir_prog.fn_val_ty(cg.fn_id, dst);
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize { return; }
    let dloc = cg_val_loc(cg, dst);
    let sloc = cg_val_loc(cg, src);
    let b = if lay.size <= 8_usize { lay.size.trunc.[u8]() } else { 8_u8 };
    if dloc.kind == .Reg && sloc.kind == .Reg { cg.buf.mv(alloc, dloc.reg, sloc.reg); }
    else if dloc.kind == .Reg { lds(alloc, cg, dloc.reg, rv64_asm.FP, sloc.stack_off, b, env.is_signed_int(ty)); }
    else if sloc.kind == .Reg { st(alloc, cg, rv64_asm.FP, dloc.stack_off, sloc.reg, b); }
    else if dloc.stack_off != sloc.stack_off { cg_copy_mem(alloc, cg, rv64_asm.FP, dloc.stack_off, rv64_asm.FP, sloc.stack_off, lay.size); }
    return;
}

fn cg_store_val_to_mem(alloc: *mut AllocCap, cg: *mut RvCg, env: *types.TypeEnv, base: u8, disp: i32, v: eir.EirValue, ty: types.TyId) {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize { return; }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg { st(alloc, cg, base, disp, loc.reg, lay.size.trunc.[u8]()); }
    else { cg_copy_mem(alloc, cg, base, disp, rv64_asm.FP, loc.stack_off, lay.size); }
    return;
}

fn cg_load_val_from_mem(alloc: *mut AllocCap, cg: *mut RvCg, env: *types.TypeEnv, v: eir.EirValue, base: u8, disp: i32, ty: types.TyId) {
    let lay = env.x64_layout(ty);
    if lay.size == 0_usize { return; }
    let loc = cg_val_loc(cg, v);
    if loc.kind == .Reg { lds(alloc, cg, loc.reg, base, disp, lay.size.trunc.[u8](), env.is_signed_int(ty)); }
    else { cg_copy_mem(alloc, cg, rv64_asm.FP, loc.stack_off, base, disp, lay.size); }
    return;
}

fn cg_emit_opt_null(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, opt_ty: types.TyId) {
    let n = env.get(opt_ty);
    let loc = cg_val_loc(cg, dst);
    let lay = env.x64_layout(opt_ty);
    if n.kind != .Optional {
        if n.kind == .Builtin && n.builtin_kind == .IdBrand {
            cg.buf.li64(alloc, rv64_asm.A0, 0xFFFFFFFF_u64);
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
        } else if lay.size > 0_usize {
            if loc.kind == .Reg { cg.buf.mv(alloc, loc.reg, rv64_asm.ZERO); }
            else { cg_memzero(alloc, cg, rv64_asm.FP, loc.stack_off, lay.size); }
        }
        return;
    }
    let niche = env.opt_niche(n.primary);
    match niche.kind {
        .IdBrand => { cg.buf.li64(alloc, rv64_asm.A0, 0xFFFFFFFF_u64); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        .BoolTag => { cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, 2_i32); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        .ScalarSentinel => { cg.buf.li64(alloc, rv64_asm.A0, niche.sentinel); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        .SliceMaxLen => {
            st(alloc, cg, rv64_asm.FP, loc.stack_off, rv64_asm.ZERO, 8_u8);
            cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, -1_i32);
            st(alloc, cg, rv64_asm.FP, loc.stack_off +% 8_i32, rv64_asm.A0, 8_u8);
        }
        .GenId => { cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.ZERO); }
        .NullPtr => { cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.ZERO); }
        _ => {
            if loc.kind == .Reg { cg.buf.mv(alloc, loc.reg, rv64_asm.ZERO); }
            else { cg_memzero(alloc, cg, rv64_asm.FP, loc.stack_off, lay.size); }
        }
    }
    return;
}

fn cg_load_ptr_arg(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, arg_val: eir.EirValue, arg_slot: eir.EirSlot, dst: u8) {
    if arg_slot != eir.EIR_NONE {
        addl(alloc, cg, dst, rv64_asm.FP, cg_slot_off(cg, arg_slot).widen.[i64]());
        if let sinfo = eir_prog.fn_slot(cg.fn_id, arg_slot) {
            let sn = env.get(sinfo.ty);
            if sn.kind == .Borrow || sn.kind == .RawPtr { ld(alloc, cg, dst, dst, 0_i32, 8_u8); }
        }
        return;
    }
    let n = env.get(eir_prog.fn_val_ty(cg.fn_id, arg_val));
    if n.kind == .Borrow || n.kind == .RawPtr { cg_load_scalar_raw(alloc, cg, eir_prog, env, arg_val, dst); return; }
    let loc = cg_val_loc(cg, arg_val);
    if loc.kind == .Stack { addl(alloc, cg, dst, rv64_asm.FP, loc.stack_off.widen.[i64]()); }
    else { cg.buf.mv(alloc, dst, loc.reg); }
    return;
}

// ============================================================================
// Section 5: Places, Bitfields, Prologue/Epilogue & Params
// ============================================================================

struct BitfieldAccess { has_bf: bool; base_bytes: u8; lo: u8; width: u8; member_ty: types.TyId; }

fn bf_none() -> BitfieldAccess { return BitfieldAccess.{ has_bf: false, base_bytes: 0_u8, lo: 0_u8, width: 0_u8, member_ty: types.TY_VOID }; }

fn lookup_bf_member(env: *types.TypeEnv, bf_def: u32, fidx: usize) -> BitfieldAccess {
    let bm = env.get_bitfield(bf_def) orelse { return bf_none(); };
    let mems = env.bitfield_members_range(bm.members);
    if fidx >= mems.len { return bf_none(); }
    let m = mems[fidx];
    return BitfieldAccess.{ has_bf: true, base_bytes: ((bm.base_bits.widen.[usize]() +% 7_usize) / 8_usize).trunc.[u8](), lo: m.lo, width: m.hi -% m.lo, member_ty: m.ty };
}

fn place_base_ty(eir_prog: *eir.EirProgram, fn_id: u32, base: eir.EirPlaceBase) -> types.TyId {
    if base.kind == .Slot { if let s = eir_prog.fn_slot(fn_id, base.id) { return s.ty; } return types.TY_ERROR; }
    return eir_prog.fn_val_ty(fn_id, base.id);
}

fn cg_split_bitfield_tail(eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, place: *eir.EirPlace) -> BitfieldAccess {
    let projs = eir_prog.projs_slice(place.projs);
    if projs.len == 0_usize || projs[projs.len - 1_usize].kind != .Field { return bf_none(); }
    var cur_ty = place_base_ty(eir_prog, fn_id, place.base);
    var i: usize = 0_usize;
    while i + 1_usize < projs.len {
        let pr = projs[i];
        if pr.kind == .Deref {
            let cn = env.get(cur_ty);
            if cn.kind == .Borrow || cn.kind == .RawPtr { cur_ty = cn.primary; }
        } else { cur_ty = pr.ty; }
        i = i +% 1_usize;
    }
    var cn = env.get(cur_ty);
    if cn.kind == .Borrow && cn.borrow_kind == .Single { cur_ty = cn.primary; cn = env.get(cur_ty); }
    if cn.kind == .Bitfield { return lookup_bf_member(env, cn.primary, projs[projs.len - 1_usize].index.widen.[usize]()); }
    return bf_none();
}

fn cg_scale_add(alloc: *mut AllocCap, cg: *mut RvCg, dst: u8, base: u8, idx: u8, elem_sz: usize) {
    if elem_sz == 2_usize { cg.buf.slli(alloc, idx, idx, 1_u8); }
    else if elem_sz == 4_usize { cg.buf.slli(alloc, idx, idx, 2_u8); }
    else if elem_sz == 8_usize { cg.buf.slli(alloc, idx, idx, 3_u8); }
    else if elem_sz > 1_usize { cg.buf.li64(alloc, rv64_asm.T5, elem_sz.widen.[u64]()); cg.buf.mul(alloc, idx, idx, rv64_asm.T5); }
    cg.buf.add(alloc, dst, base, idx);
    return;
}

fn cg_compute_place_addr(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, place: *eir.EirPlace, n_projs: usize, dst: u8) -> types.TyId {
    var cur_ty = place_base_ty(eir_prog, cg.fn_id, place.base);
    let projs = eir_prog.projs_slice(place.projs);
    if place.base.kind == .Slot {
        addl(alloc, cg, dst, rv64_asm.FP, cg_slot_off(cg, place.base.id).widen.[i64]());
    } else {
        let loc = cg_val_loc(cg, place.base.id);
        let n = env.get(cur_ty);
        let is_row = n.kind == .Borrow && n.borrow_kind == .Single && env.get(n.primary).kind == .Pool;
        if (n.kind == .Borrow && n.borrow_kind == .Single && !is_row) || n.kind == .RawPtr {
            cg_load_scalar_raw(alloc, cg, eir_prog, env, place.base.id, dst);
        } else if loc.kind == .Stack { addl(alloc, cg, dst, rv64_asm.FP, loc.stack_off.widen.[i64]()); }
        else { cg.buf.mv(alloc, dst, loc.reg); }
    }
    var pi: usize = 0_usize;
    while pi < n_projs && pi < projs.len {
        let pr = projs[pi];
        let cn = env.get(cur_ty);
        let is_ptr = (cn.kind == .Borrow && cn.borrow_kind == .Single) || cn.kind == .RawPtr;
        let base_is_val_ptr = pi == 0_usize && place.base.kind == .Val && is_ptr;
        match pr.kind {
            .Deref => {
                let inner_ty = if cn.kind == .Borrow || cn.kind == .RawPtr { cn.primary } else { cur_ty };
                if env.get(inner_ty).kind != .Pool && !base_is_val_ptr { ld(alloc, cg, dst, dst, 0_i32, 8_u8); }
                cur_ty = inner_ty;
            }
            .Field => {
                let deref_ty = if is_ptr { cn.primary } else { cur_ty };
                if env.get(deref_ty).kind == .Pool && is_ptr {
                    ld(alloc, cg, rv64_asm.T2, dst, 0_i32, 8_u8);
                    ld(alloc, cg, rv64_asm.T3, dst, 8_i32, 4_u8);
                    ld(alloc, cg, dst, rv64_asm.T2, pr.index.trunc.[i32]() *% 8_i32, 8_u8);
                    let er = env.x64_layout_impl(pr.ty, true).size;
                    cg_scale_add(alloc, cg, dst, dst, rv64_asm.T3, if er == 0_usize { 1_usize } else { er });
                } else {
                    if is_ptr { if !base_is_val_ptr { ld(alloc, cg, dst, dst, 0_i32, 8_u8); } cur_ty = deref_ty; }
                    let foff = env.struct_field_offset(cur_ty, pr.index.widen.[usize]()).offset;
                    if foff > 0_usize { addl(alloc, cg, dst, dst, foff.widen.[u64]().bitcast.[i64]()); }
                }
                cur_ty = pr.ty;
            }
            .TupleField => {
                if is_ptr { if !base_is_val_ptr { ld(alloc, cg, dst, dst, 0_i32, 8_u8); } cur_ty = cn.primary; }
                let foff = env.struct_field_offset(cur_ty, pr.index.widen.[usize]()).offset;
                if foff > 0_usize { addl(alloc, cg, dst, dst, foff.widen.[u64]().bitcast.[i64]()); }
                cur_ty = pr.ty;
            }
            .PoolCol => {
                if is_ptr && !base_is_val_ptr { ld(alloc, cg, dst, dst, 0_i32, 8_u8); }
                ld(alloc, cg, dst, dst, pr.index.trunc.[i32]() *% 8_i32, 8_u8);
                if pi +% 1_usize < n_projs && pi +% 1_usize < projs.len && projs[pi +% 1_usize].kind == .Index {
                    let npr = projs[pi +% 1_usize];
                    cg.buf.mv(alloc, rv64_asm.T4, dst);
                    cg_load_scalar_raw(alloc, cg, eir_prog, env, npr.index, rv64_asm.A1);
                    if pr.is_slot_pool { cg.buf.extend_bits(alloc, rv64_asm.A1, rv64_asm.A1, 32_u8, false); }
                    let er = env.x64_layout_impl(pr.ty, pr.is_slot_pool).size;
                    cg_scale_add(alloc, cg, dst, rv64_asm.T4, rv64_asm.A1, if er == 0_usize { 1_usize } else { er });
                    cur_ty = npr.ty; pi = pi +% 2_usize; continue;
                }
                cur_ty = pr.ty;
            }
            .Index => {
                cg.buf.mv(alloc, rv64_asm.T4, dst);
                cg_load_scalar_raw(alloc, cg, eir_prog, env, pr.index, rv64_asm.A1);
                if (cn.kind == .Borrow && (cn.borrow_kind == .Slice || cn.borrow_kind == .Str)) || cn.kind == .Str {
                    ld(alloc, cg, rv64_asm.T4, rv64_asm.T4, 0_i32, 8_u8);
                } else if cn.kind == .Borrow && cn.borrow_kind == .Single && !base_is_val_ptr {
                    ld(alloc, cg, rv64_asm.T4, rv64_asm.T4, 0_i32, 8_u8);
                }
                cg_scale_add(alloc, cg, dst, rv64_asm.T4, rv64_asm.A1, env.x64_layout(pr.ty).size);
                cur_ty = pr.ty;
            }
        }
        pi = pi +% 1_usize;
    }
    return cur_ty;
}

fn cg_emit_prologue(alloc: *mut AllocCap, cg: *mut RvCg) {
    if cg.is_naked { return; }
    cg.buf.addi(alloc, rv64_asm.SP, rv64_asm.SP, -16_i32);
    st(alloc, cg, rv64_asm.SP, 0_i32, rv64_asm.FP, 8_u8);
    st(alloc, cg, rv64_asm.SP, 8_i32, rv64_asm.RA, 8_u8);
    cg.buf.mv(alloc, rv64_asm.FP, rv64_asm.SP);
    if cg.frame.total_sub > 0_usize { addl(alloc, cg, rv64_asm.SP, rv64_asm.SP, 0_i64 -% cg.frame.total_sub.widen.[u64]().bitcast.[i64]()); }
    let srs = cg.frame.saved_regs.as_slice();
    var i: usize = 0_usize;
    while i < srs.len { st(alloc, cg, rv64_asm.SP, (i *% 8_usize).trunc.[i32](), srs[i], 8_u8); i = i +% 1_usize; }
    return;
}

fn cg_emit_epilogue(alloc: *mut AllocCap, cg: *mut RvCg) {
    if cg.is_naked { return; }
    let srs = cg.frame.saved_regs.as_slice();
    var i: usize = 0_usize;
    while i < srs.len { ld(alloc, cg, srs[i], rv64_asm.SP, (i *% 8_usize).trunc.[i32](), 8_u8); i = i +% 1_usize; }
    if cg.frame.total_sub > 0_usize { cg.buf.mv(alloc, rv64_asm.SP, rv64_asm.FP); }
    ld(alloc, cg, rv64_asm.FP, rv64_asm.SP, 0_i32, 8_u8);
    ld(alloc, cg, rv64_asm.RA, rv64_asm.SP, 8_i32, 8_u8);
    cg.buf.addi(alloc, rv64_asm.SP, rv64_asm.SP, 16_i32);
    return;
}

fn cg_receive_params(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv) {
    if cg.is_naked { return; }
    var gp_i: usize = 0_usize;
    var flt_i: usize = 0_usize;
    var stk_off: i32 = 16_i32;
    if cg.frame.has_sret { st(alloc, cg, rv64_asm.FP, cg.frame.sret_off, rv64_asm.A0, 8_u8); gp_i = 1_usize; }
    let params = eir_prog.fn_params(cg.fn_id);
    var pi: usize = 0_usize;
    while pi < params.len {
        let pv = params[pi];
        let ty = eir_prog.fn_val_ty(cg.fn_id, pv);
        let lay = env.x64_layout(ty);
        let doff = cg_val_off(cg, pv);
        match mach_isel_a64.a64_classify_arg(ty, env) {
            .Zst => {}
            .IntReg => {
                if let r = rv_gp_arg(gp_i) { cg_store_scalar_val(alloc, cg, eir_prog, env, pv, r); gp_i = gp_i +% 1_usize; }
                else {
                    lds(alloc, cg, rv64_asm.T1, rv64_asm.FP, stk_off, lay.size.trunc.[u8](), env.is_signed_int(ty));
                    cg_store_scalar_val(alloc, cg, eir_prog, env, pv, rv64_asm.T1);
                    stk_off = stk_off +% 8_i32;
                }
            }
            .TwoIntRegs => {
                if gp_i +% 1_usize < 8_usize {
                    st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0 +% gp_i.trunc.[u8](), 8_u8);
                    if lay.size > 8_usize { st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.A0 +% (gp_i +% 1_usize).trunc.[u8](), (lay.size - 8_usize).trunc.[u8]()); }
                    gp_i = gp_i +% 2_usize;
                } else { cg_copy_mem(alloc, cg, rv64_asm.FP, doff, rv64_asm.FP, stk_off, lay.size); stk_off = stk_off +% 16_i32; }
            }
            .FloatReg => {
                let is64 = env.get(ty).u8_val == 64_u8;
                if let fr = rv_flt_arg(flt_i) { stf(alloc, cg, is64, rv64_asm.FP, doff, fr); flt_i = flt_i +% 1_usize; }
                else { cg_copy_mem(alloc, cg, rv64_asm.FP, doff, rv64_asm.FP, stk_off, if is64 { 8_usize } else { 4_usize }); stk_off = stk_off +% 8_i32; }
            }
            .ByPtr => {
                if let r = rv_gp_arg(gp_i) { cg_copy_mem(alloc, cg, rv64_asm.FP, doff, r, 0_i32, lay.size); gp_i = gp_i +% 1_usize; }
                else { ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, stk_off, 8_u8); cg_copy_mem(alloc, cg, rv64_asm.FP, doff, rv64_asm.T1, 0_i32, lay.size); stk_off = stk_off +% 8_i32; }
            }
        }
        pi = pi +% 1_usize;
    }
    return;
}

// ============================================================================
// Section 6: Load/Store Place, Pool Cols, Const, Unary, Binary, Cast, Agg
// ============================================================================

fn cg_emit_load_place(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, place_id: u32) {
    let place = eir_prog.get_place(place_id) orelse { return; };
    let bf = cg_split_bitfield_tail(eir_prog, cg.fn_id, env, place);
    let projs = eir_prog.projs_slice(place.projs);
    if bf.has_bf && projs.len > 0_usize {
        _ = cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs.len - 1_usize, rv64_asm.T1);
        ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, bf.base_bytes);
        if bf.lo > 0_u8 { cg.buf.srli(alloc, rv64_asm.A0, rv64_asm.A0, bf.lo); }
        if bf.width < 64_u8 { cg.buf.extend_bits(alloc, rv64_asm.A0, rv64_asm.A0, bf.width, env.is_signed_int(bf.member_ty)); }
        cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
        return;
    }
    if projs.len > 0_usize && projs[projs.len - 1_usize].kind == .PoolCol {
        let lpr = projs[projs.len - 1_usize];
        let pty = cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs.len - 1_usize, rv64_asm.T1);
        let pn = env.get(pty);
        var dty = pty;
        if pn.kind == .Borrow && pn.borrow_kind == .Single {
            if !(projs.len == 1_usize && place.base.kind == .Val) { ld(alloc, cg, rv64_asm.T1, rv64_asm.T1, 0_i32, 8_u8); }
            dty = pn.primary;
        }
        let dn = env.get(dty);
        let ncols = if dn.kind == .Builtin { env.pool_col_count(env.node_gval_list(&dn)) } else { 0_usize };
        let loff: i32 = (if lpr.is_slot_pool { ncols +% 2_usize } else { ncols } *% 8_usize).trunc.[i32]();
        ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, lpr.index.trunc.[i32]() *% 8_i32, 8_u8);
        ld(alloc, cg, rv64_asm.A1, rv64_asm.T1, loff, 8_u8);
        let doff = cg_val_off(cg, dst);
        st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 8_u8);
        st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.A1, 8_u8);
        return;
    }
    _ = cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs.len, rv64_asm.T1);
    cg_load_val_from_mem(alloc, cg, env, dst, rv64_asm.T1, 0_i32, eir_prog.fn_val_ty(cg.fn_id, dst));
    return;
}

fn cg_emit_store_place(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, place_id: u32, val: eir.EirValue) {
    let place = eir_prog.get_place(place_id) orelse { return; };
    let bf = cg_split_bitfield_tail(eir_prog, cg.fn_id, env, place);
    let projs_len = place.projs.len.widen.[usize]();
    if bf.has_bf && projs_len > 0_usize {
        _ = cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs_len - 1_usize, rv64_asm.T1);
        ld(alloc, cg, rv64_asm.T2, rv64_asm.T1, 0_i32, bf.base_bytes);
        cg_load_scalar_raw(alloc, cg, eir_prog, env, val, rv64_asm.A0);
        let mask: u64 = if bf.width >= 64_u8 { 0xFFFFFFFFFFFFFFFF_u64 } else { (1_u64 <<% bf.width.widen.[u64]()) -% 1_u64 };
        cg.buf.li64(alloc, rv64_asm.A1, mask);
        cg.buf.and_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
        if bf.lo > 0_u8 { cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.A0, bf.lo); cg.buf.slli(alloc, rv64_asm.A1, rv64_asm.A1, bf.lo); }
        cg.buf.xori(alloc, rv64_asm.A1, rv64_asm.A1, -1_i32);
        cg.buf.and_r(alloc, rv64_asm.T2, rv64_asm.T2, rv64_asm.A1);
        cg.buf.or_r(alloc, rv64_asm.T2, rv64_asm.T2, rv64_asm.A0);
        st(alloc, cg, rv64_asm.T1, 0_i32, rv64_asm.T2, bf.base_bytes);
        return;
    }
    _ = cg_compute_place_addr(alloc, cg, eir_prog, env, place, projs_len, rv64_asm.T1);
    cg_store_val_to_mem(alloc, cg, env, rv64_asm.T1, 0_i32, val, eir_prog.fn_val_ty(cg.fn_id, val));
    return;
}

fn cg_emit_pool_col_addr(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, op: *eir.EirPoolColOp) {
    if op.pool_base.kind == .Slot {
        addl(alloc, cg, rv64_asm.T1, rv64_asm.FP, cg_slot_off(cg, op.pool_base.id).widen.[i64]());
        if op.pool_is_ptr { ld(alloc, cg, rv64_asm.T1, rv64_asm.T1, 0_i32, 8_u8); }
    } else if op.pool_is_ptr {
        cg_load_scalar_raw(alloc, cg, eir_prog, env, op.pool_base.id, rv64_asm.T1);
    } else {
        cg_val_addr_into(alloc, cg, op.pool_base.id, rv64_asm.T1);
    }
    ld(alloc, cg, rv64_asm.T1, rv64_asm.T1, op.col_idx.trunc.[i32]() *% 8_i32, 8_u8);
    cg_load_scalar_raw(alloc, cg, eir_prog, env, op.index, rv64_asm.A1);
    if op.is_slot_pool { cg.buf.extend_bits(alloc, rv64_asm.A1, rv64_asm.A1, 32_u8, false); }
    let er = env.x64_layout_impl(op.elem_ty, op.is_slot_pool).size;
    cg_scale_add(alloc, cg, rv64_asm.T1, rv64_asm.T1, rv64_asm.A1, if er == 0_usize { 1_usize } else { er });
    return;
}

fn cg_emit_const(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, ct: *ctvm.CtArena, interner: *mut span.SymInterner, dst: eir.EirValue, const_id: u32, ty: types.TyId) -> !OutOfMemory {
    let c = eir_prog.get_const(const_id) orelse { return; };
    let lay = env.x64_layout(ty);
    match c.kind {
        .Void => {}
        .Null => { cg_emit_opt_null(alloc, cg, eir_prog, env, dst, ty); }
        .Bool => { cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, if c.bool_val { 1_i32 } else { 0_i32 }); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        .Char => { cg.buf.li64(alloc, rv64_asm.A0, c.aux_u32.widen.[u64]()); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        .ErrorTag => { cg.buf.li64(alloc, rv64_asm.A0, c.aux_u32.widen.[u64]()); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        .EnumTag => { cg.buf.li64(alloc, rv64_asm.A0, c.int_val.lo); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        .Int => {
            if lay.size == 16_usize {
                let off = cg_val_off(cg, dst);
                cg.buf.li64(alloc, rv64_asm.A0, c.int_val.lo);
                st(alloc, cg, rv64_asm.FP, off, rv64_asm.A0, 8_u8);
                cg.buf.li64(alloc, rv64_asm.A0, c.int_val.hi.bitcast.[u64]());
                st(alloc, cg, rv64_asm.FP, off +% 8_i32, rv64_asm.A0, 8_u8);
            } else {
                cg.buf.li64(alloc, rv64_asm.A0, c.int_val.lo);
                cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            }
        }
        .Float => {
            let f64_b = parse_f64_lit(eir_prog.bytes_slice(c.bytes)).bitcast.[u64]();
            let n = env.get(ty);
            if n.kind == .Float && n.u8_val == 16_u8 {
                cg.buf.li64(alloc, rv64_asm.A0, f32_bits_to_f16_bits(f64_bits_to_f32_bits(f64_b)).widen.[u64]());
                cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            } else {
                let is64 = n.kind == .Float && n.u8_val == 64_u8;
                cg.buf.li64(alloc, rv64_asm.A0, if is64 { f64_b } else { f64_bits_to_f32_bits(f64_b).widen.[u64]() });
                st(alloc, cg, rv64_asm.FP, cg_val_off(cg, dst), rv64_asm.A0, if is64 { 8_u8 } else { 4_u8 });
            }
        }
        .Str => {
            let bytes = eir_prog.bytes_slice(c.bytes);
            let sym = cg_intern_rodata(alloc, cg, interner, bytes, 1_u32);
            let off = cg_val_off(cg, dst);
            cg.buf.lea_sym(alloc, rv64_asm.A0, sym, 0_i64);
            st(alloc, cg, rv64_asm.FP, off, rv64_asm.A0, 8_u8);
            cg.buf.li64(alloc, rv64_asm.A0, bytes.len.widen.[u64]());
            st(alloc, cg, rv64_asm.FP, off +% 8_i32, rv64_asm.A0, 8_u8);
        }
        .Bytes => {
            let bytes = eir_prog.bytes_slice(c.bytes);
            let sym = cg_intern_rodata(alloc, cg, interner, bytes, 1_u32);
            let off = cg_val_off(cg, dst);
            cg.buf.lea_sym(alloc, rv64_asm.A0, sym, 0_i64);
            st(alloc, cg, rv64_asm.FP, off, rv64_asm.A0, 8_u8);
            cg.buf.li64(alloc, rv64_asm.A0, bytes.len.widen.[u64]());
            st(alloc, cg, rv64_asm.FP, off +% 8_i32, rv64_asm.A0, 8_u8);
        }
        .FnRef => {
            let def_id = c.aux_u32;
            let tsym = try mach_isel_a64.intern_sym_u64(alloc, interner, "eon_fnref_thunk_", def_id.widen.[u64]());
            try cg.fn_ref_thunks.push(alloc, mach_x64.FnRefThunkReq.{ thunk_sym: tsym, target_def: def_id });
            let off = cg_val_off(cg, dst);
            cg.buf.lea_sym(alloc, rv64_asm.A0, tsym, 0_i64);
            st(alloc, cg, rv64_asm.FP, off, rv64_asm.A0, 8_u8);
            if lay.size >= 16_usize { st(alloc, cg, rv64_asm.FP, off +% 8_i32, rv64_asm.ZERO, 8_u8); }
        }
        .ConstDef => {
            if lay.size == 0_usize { return; }
            if let vid = ct.get_const_val(c.aux_u32) {
                var enc = try col.DynBuf.[u8].init(alloc, if lay.size > 8_usize { lay.size } else { 8_usize });
                errdefer enc.destroy(alloc);
                let ok = try ctvm.encode_ct_val_bytes(alloc, ct, vid, ty, env, &mut enc);
                if ok && enc.len() > 0_usize {
                    let ro = cg_intern_rodata(alloc, cg, interner, enc.as_slice(), if lay.align == 0_usize { 1_u32 } else { lay.align.trunc.[u32]() });
                    cg.buf.lea_sym(alloc, rv64_asm.T1, ro, 0_i64);
                    cg_load_val_from_mem(alloc, cg, env, dst, rv64_asm.T1, 0_i32, ty);
                    enc.destroy(alloc);
                    return;
                }
                enc.destroy(alloc);
            }
            if let cm = env.get_const(c.aux_u32) {
                if cm.has_int_val {
                    cg.buf.li64(alloc, rv64_asm.A0, cm.int_val.lo);
                    cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
                    return;
                }
            }
            let loc = cg_val_loc(cg, dst);
            if loc.kind == .Reg { cg.buf.mv(alloc, loc.reg, rv64_asm.ZERO); }
            else { cg_memzero(alloc, cg, rv64_asm.FP, loc.stack_off, lay.size); }
        }
    }
    return;
}

fn cg_emit_unary(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: ast.UnaryOp, operand: eir.EirValue, ty: types.TyId) {
    let n = env.get(ty);
    if n.kind == .Float && op == .Neg {
        if n.u8_val == 16_u8 {
            cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, rv64_asm.A0);
            cg.buf.li64(alloc, rv64_asm.A1, 0x8000_u64);
            cg.buf.xor(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return;
        }
        cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, rv64_asm.FA0);
        cg.buf.fneg(alloc, n.u8_val == 64_u8, rv64_asm.FA0, rv64_asm.FA0);
        cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, rv64_asm.FA0);
        return;
    }
    if n.kind == .Vec && op == .Neg {
        let elem = n.primary;
        let lanes = n.u8_val.widen.[usize]();
        let esz = env.x64_layout(elem).size;
        let is_flt = env.get(elem).kind == .Float;
        let doff = cg_val_off(cg, dst);
        let soff = cg_val_off(cg, operand);
        var li: usize = 0_usize;
        while li < lanes {
            let d = (li *% esz).trunc.[i32]();
            if is_flt {
                ldf(alloc, cg, esz == 8_usize, rv64_asm.FA0, rv64_asm.FP, soff +% d);
                cg.buf.fneg(alloc, esz == 8_usize, rv64_asm.FA0, rv64_asm.FA0);
                stf(alloc, cg, esz == 8_usize, rv64_asm.FP, doff +% d, rv64_asm.FA0);
            } else {
                lds(alloc, cg, rv64_asm.A0, rv64_asm.FP, soff +% d, esz.trunc.[u8](), env.is_signed_int(elem));
                cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.ZERO, rv64_asm.A0);
                st(alloc, cg, rv64_asm.FP, doff +% d, rv64_asm.A0, esz.trunc.[u8]());
            }
            li = li +% 1_usize;
        }
        return;
    }
    cg_load_scalar_val(alloc, cg, eir_prog, env, operand, rv64_asm.A0);
    if op == .Neg { cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.ZERO, rv64_asm.A0); cg_norm_subword(alloc, cg, env, ty, rv64_asm.A0); }
    else if op == .Not { cg.buf.xori(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32); cg.buf.andi(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32); }
    else if op == .BitNot { cg.buf.xori(alloc, rv64_asm.A0, rv64_asm.A0, -1_i32); cg_norm_subword(alloc, cg, env, ty, rv64_asm.A0); }
    cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
    return;
}

fn cg_emit_fp_cmp_to_a0(alloc: *mut AllocCap, cg: *mut RvCg, is64: bool, op: ast.BinaryOp, f1: u8, f2: u8) {
    if op == .Eq { cg.buf.feq(alloc, is64, rv64_asm.A0, f1, f2); }
    else if op == .NotEq { cg.buf.feq(alloc, is64, rv64_asm.A0, f1, f2); cg.buf.xori(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32); }
    else if op == .Lt { cg.buf.flt(alloc, is64, rv64_asm.A0, f1, f2); }
    else if op == .LtEq { cg.buf.fle(alloc, is64, rv64_asm.A0, f1, f2); }
    else if op == .Gt { cg.buf.flt(alloc, is64, rv64_asm.A0, f2, f1); }
    else { cg.buf.fle(alloc, is64, rv64_asm.A0, f2, f1); }
    return;
}

fn cg_emit_int_cmp_to_a0(alloc: *mut AllocCap, cg: *mut RvCg, op: ast.BinaryOp, signed: bool, a: u8, b: u8) {
    if op == .Eq { cg.buf.xor(alloc, rv64_asm.A0, a, b); cg.buf.sltiu(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32); }
    else if op == .NotEq { cg.buf.xor(alloc, rv64_asm.A0, a, b); cg.buf.sltu(alloc, rv64_asm.A0, rv64_asm.ZERO, rv64_asm.A0); }
    else {
        let swap = op == .LtEq || op == .Gt;
        let inv = op == .LtEq || op == .GtEq;
        let r1 = if swap { b } else { a };
        let r2 = if swap { a } else { b };
        if signed { cg.buf.slt(alloc, rv64_asm.A0, r1, r2); }
        else { cg.buf.sltu(alloc, rv64_asm.A0, r1, r2); }
        if inv { cg.buf.xori(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32); }
    }
    return;
}

fn cg_emit_binary_float(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: ast.BinaryOp, lhs: eir.EirValue, rhs: eir.EirValue, op_ty: types.TyId) {
    let is_f16 = env.get(op_ty).u8_val == 16_u8;
    let use_f64 = !is_f16 && env.get(op_ty).u8_val == 64_u8;
    if is_f16 {
        cg_load_scalar_raw(alloc, cg, eir_prog, env, rhs, rv64_asm.A0);
        cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        stf(alloc, cg, false, rv64_asm.FP, cg.frame.temp_off, rv64_asm.FA0);
        cg_load_scalar_raw(alloc, cg, eir_prog, env, lhs, rv64_asm.A0);
        cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
        ldf(alloc, cg, false, rv64_asm.FA1, rv64_asm.FP, cg.frame.temp_off);
    } else {
        cg_load_float_val(alloc, cg, eir_prog, env, interner, lhs, rv64_asm.FA0);
        cg_load_float_val(alloc, cg, eir_prog, env, interner, rhs, rv64_asm.FA1);
    }
    if op == .Add || op == .Sub || op == .Mul || op == .Div {
        if op == .Add { cg.buf.fadd(alloc, use_f64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
        else if op == .Sub { cg.buf.fsub(alloc, use_f64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
        else if op == .Mul { cg.buf.fmul(alloc, use_f64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
        else { cg.buf.fdiv(alloc, use_f64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
        cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, rv64_asm.FA0);
    } else {
        cg_emit_fp_cmp_to_a0(alloc, cg, use_f64, op, rv64_asm.FA0, rv64_asm.FA1);
        cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
    }
    return;
}

fn cg_emit_binary_vec(alloc: *mut AllocCap, cg: *mut RvCg, env: *types.TypeEnv, dst: eir.EirValue, op: ast.BinaryOp, lhs: eir.EirValue, rhs: eir.EirValue, op_ty: types.TyId) {
    let vn = env.get(op_ty);
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem);
    let esz = env.x64_layout(elem).size;
    let doff = cg_val_off(cg, dst);
    let loff = cg_val_off(cg, lhs);
    let roff = cg_val_off(cg, rhs);
    let signed = env.is_signed_int(elem);
    let ebits = env.int_bits(elem);
    var li: usize = 0_usize;
    while li < lanes {
        let d = (li *% esz).trunc.[i32]();
        if en.kind == .Float {
            let is64 = en.u8_val == 64_u8;
            ldf(alloc, cg, is64, rv64_asm.FA0, rv64_asm.FP, loff +% d);
            ldf(alloc, cg, is64, rv64_asm.FA1, rv64_asm.FP, roff +% d);
            if op == .Add { cg.buf.fadd(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
            else if op == .Sub { cg.buf.fsub(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
            else if op == .Mul { cg.buf.fmul(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
            else { cg.buf.fdiv(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
            stf(alloc, cg, is64, rv64_asm.FP, doff +% d, rv64_asm.FA0);
        } else {
            let b = esz.trunc.[u8]();
            lds(alloc, cg, rv64_asm.A0, rv64_asm.FP, loff +% d, b, signed);
            lds(alloc, cg, rv64_asm.A1, rv64_asm.FP, roff +% d, b, signed);
            if op == .Add || op == .AddWrap { cg.buf.add(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else if op == .Sub || op == .SubWrap { cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else if op == .Mul || op == .MulWrap { cg.buf.mul(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else if op == .BitAnd { cg.buf.and_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else if op == .BitOr { cg.buf.or_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else if op == .BitXor { cg.buf.xor(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else if op == .Shl || op == .ShlWrap {
                if op == .ShlWrap && ebits > 0_u8 && ebits < 64_u8 { cg.buf.andi(alloc, rv64_asm.A1, rv64_asm.A1, (ebits -% 1_u8).widen.[i32]()); }
                cg.buf.sll(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
            } else if op == .Shr {
                if signed { cg.buf.sra(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
                else { cg.buf.srl(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            }
            st(alloc, cg, rv64_asm.FP, doff +% d, rv64_asm.A0, b);
        }
        li = li +% 1_usize;
    }
    return;
}

fn cg_emit_binary_checked(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, op: ast.BinaryOp, lhs: eir.EirValue, rhs: eir.EirValue, op_ty: types.TyId) {
    let signed = env.is_signed_int(op_ty);
    let bits = env.int_bits(op_ty);
    let ok_sz = env.x64_layout(op_ty).size.trunc.[u8]();
    let ok_off = env.eu_ok_offset(op_ty).trunc.[i32]();
    let doff = cg_val_off(cg, dst);
    let bnds = types.int_bounds(env.get(op_ty));
    cg_load_scalar_val(alloc, cg, eir_prog, env, lhs, rv64_asm.A0);
    cg_load_scalar_val(alloc, cg, eir_prog, env, rhs, rv64_asm.A1);
    let l_ovf = cg.buf.new_label(alloc);
    let l_done = cg.buf.new_label(alloc);
    if op == .DivCheck || op == .ModCheck {
        let l_dz = cg.buf.new_label(alloc);
        cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A1, rv64_asm.ZERO, l_dz);
        if signed {
            let l_okd = cg.buf.new_label(alloc);
            cg.buf.li64(alloc, rv64_asm.A2, bnds.min.lo);
            cg.buf.br_cond_label(alloc, .Ne, rv64_asm.A0, rv64_asm.A2, l_okd);
            cg.buf.addi(alloc, rv64_asm.A3, rv64_asm.ZERO, -1_i32);
            cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A1, rv64_asm.A3, l_ovf);
            cg.buf.bind_label(l_okd);
            if op == .DivCheck { cg.buf.div(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else { cg.buf.rem(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        } else if op == .DivCheck { cg.buf.divu(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        else { cg.buf.remu(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
        st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.A0, ok_sz);
        cg.buf.j_label(alloc, l_done);
        cg.buf.bind_label(l_dz);
        st_eu_err(alloc, cg, doff, 2_i32);
        cg.buf.j_label(alloc, l_done);
    } else if bits < 64_u8 {
        if !signed && op == .SubCheck {
            cg.buf.br_cond_label(alloc, .Ltu, rv64_asm.A0, rv64_asm.A1, l_ovf);
            cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
        } else {
            if op == .AddCheck { cg.buf.add(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else if op == .SubCheck { cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else { cg.buf.mul(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            if signed {
                cg.buf.li64(alloc, rv64_asm.A2, bnds.min.lo);
                cg.buf.br_cond_label(alloc, .Lt, rv64_asm.A0, rv64_asm.A2, l_ovf);
            }
            cg.buf.li64(alloc, rv64_asm.A2, bnds.max.lo);
            cg.buf.br_cond_label(alloc, if signed { .Lt } else { .Ltu }, rv64_asm.A2, rv64_asm.A0, l_ovf);
        }
        st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
        st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.A0, ok_sz);
        cg.buf.j_label(alloc, l_done);
    } else {
        if op == .AddCheck {
            cg.buf.add(alloc, rv64_asm.A2, rv64_asm.A0, rv64_asm.A1);
            if signed {
                cg.buf.xor(alloc, rv64_asm.A3, rv64_asm.A2, rv64_asm.A0);
                cg.buf.xor(alloc, rv64_asm.A4, rv64_asm.A2, rv64_asm.A1);
                cg.buf.and_r(alloc, rv64_asm.A3, rv64_asm.A3, rv64_asm.A4);
                cg.buf.br_cond_label(alloc, .Lt, rv64_asm.A3, rv64_asm.ZERO, l_ovf);
            } else { cg.buf.br_cond_label(alloc, .Ltu, rv64_asm.A2, rv64_asm.A0, l_ovf); }
            cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.A2);
        } else if op == .SubCheck {
            if !signed { cg.buf.br_cond_label(alloc, .Ltu, rv64_asm.A0, rv64_asm.A1, l_ovf); cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else {
                cg.buf.sub(alloc, rv64_asm.A2, rv64_asm.A0, rv64_asm.A1);
                cg.buf.xor(alloc, rv64_asm.A3, rv64_asm.A0, rv64_asm.A1);
                cg.buf.xor(alloc, rv64_asm.A4, rv64_asm.A0, rv64_asm.A2);
                cg.buf.and_r(alloc, rv64_asm.A3, rv64_asm.A3, rv64_asm.A4);
                cg.buf.br_cond_label(alloc, .Lt, rv64_asm.A3, rv64_asm.ZERO, l_ovf);
                cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.A2);
            }
        } else if signed {
            cg.buf.mulh(alloc, rv64_asm.A2, rv64_asm.A0, rv64_asm.A1);
            cg.buf.mul(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
            cg.buf.srai(alloc, rv64_asm.A3, rv64_asm.A0, 63_u8);
            cg.buf.br_cond_label(alloc, .Ne, rv64_asm.A2, rv64_asm.A3, l_ovf);
        } else {
            cg.buf.mulhu(alloc, rv64_asm.A2, rv64_asm.A0, rv64_asm.A1);
            cg.buf.mul(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
            cg.buf.br_cond_label(alloc, .Ne, rv64_asm.A2, rv64_asm.ZERO, l_ovf);
        }
        st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
        st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.A0, ok_sz);
        cg.buf.j_label(alloc, l_done);
    }
    cg.buf.bind_label(l_ovf);
    st_eu_err(alloc, cg, doff, 1_i32);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_clamp_reg(alloc: *mut AllocCap, cg: *mut RvCg, r: u8, min_v: u64, max_v: u64, signed: bool) {
    let cc: rv64_asm.RvBrCond = if signed { .Ge } else { .Geu };
    if signed || min_v != 0_u64 {
        let l_lo = cg.buf.new_label(alloc);
        cg.buf.li64(alloc, rv64_asm.A2, min_v);
        cg.buf.br_short_label(alloc, cc, r, rv64_asm.A2, l_lo);
        cg.buf.mv(alloc, r, rv64_asm.A2);
        cg.buf.bind_label(l_lo);
    }
    let l_hi = cg.buf.new_label(alloc);
    cg.buf.li64(alloc, rv64_asm.A2, max_v);
    cg.buf.br_short_label(alloc, cc, rv64_asm.A2, r, l_hi);
    cg.buf.mv(alloc, r, rv64_asm.A2);
    cg.buf.bind_label(l_hi);
    return;
}

fn cg_emit_binary_sat(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, op: ast.BinaryOp, lhs: eir.EirValue, rhs: eir.EirValue, op_ty: types.TyId) {
    let signed = env.is_signed_int(op_ty);
    let bits = env.int_bits(op_ty);
    let bnds = types.int_bounds(env.get(op_ty));
    cg_load_scalar_val(alloc, cg, eir_prog, env, lhs, rv64_asm.A0);
    cg_load_scalar_val(alloc, cg, eir_prog, env, rhs, rv64_asm.A1);
    let l_done = cg.buf.new_label(alloc);
    if bits < 64_u8 {
        if !signed && op == .SubSat {
            let l_ok = cg.buf.new_label(alloc);
            cg.buf.br_short_label(alloc, .Geu, rv64_asm.A0, rv64_asm.A1, l_ok);
            cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.ZERO);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_ok);
            cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
        } else {
            if op == .AddSat { cg.buf.add(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else if op == .SubSat { cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else { cg.buf.mul(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            cg_emit_clamp_reg(alloc, cg, rv64_asm.A0, bnds.min.lo, bnds.max.lo, signed);
        }
    } else if !signed {
        if op == .AddSat {
            cg.buf.add(alloc, rv64_asm.A2, rv64_asm.A0, rv64_asm.A1);
            let l_ov = cg.buf.new_label(alloc);
            cg.buf.br_short_label(alloc, .Ltu, rv64_asm.A2, rv64_asm.A0, l_ov);
            cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.A2);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_ov);
            cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, -1_i32);
        } else if op == .SubSat {
            let l_ov = cg.buf.new_label(alloc);
            cg.buf.br_short_label(alloc, .Ltu, rv64_asm.A0, rv64_asm.A1, l_ov);
            cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_ov);
            cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.ZERO);
        } else {
            cg.buf.mulhu(alloc, rv64_asm.A2, rv64_asm.A0, rv64_asm.A1);
            cg.buf.mul(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
            cg.buf.br_short_label(alloc, .Eq, rv64_asm.A2, rv64_asm.ZERO, l_done);
            cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, -1_i32);
        }
    } else {
        let l_ovf = cg.buf.new_label(alloc);
        cg.buf.mv(alloc, rv64_asm.T1, rv64_asm.A0);
        if op == .AddSat || op == .SubSat {
            if op == .AddSat {
                cg.buf.add(alloc, rv64_asm.A2, rv64_asm.A0, rv64_asm.A1);
                cg.buf.xor(alloc, rv64_asm.A3, rv64_asm.A2, rv64_asm.A0);
                cg.buf.xor(alloc, rv64_asm.A4, rv64_asm.A2, rv64_asm.A1);
            } else {
                cg.buf.sub(alloc, rv64_asm.A2, rv64_asm.A0, rv64_asm.A1);
                cg.buf.xor(alloc, rv64_asm.A3, rv64_asm.A0, rv64_asm.A1);
                cg.buf.xor(alloc, rv64_asm.A4, rv64_asm.A0, rv64_asm.A2);
            }
            cg.buf.and_r(alloc, rv64_asm.A3, rv64_asm.A3, rv64_asm.A4);
            cg.buf.br_short_label(alloc, .Lt, rv64_asm.A3, rv64_asm.ZERO, l_ovf);
            cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.A2);
            cg.buf.j_label(alloc, l_done);
        } else {
            cg.buf.xor(alloc, rv64_asm.T1, rv64_asm.A0, rv64_asm.A1);
            cg.buf.mulh(alloc, rv64_asm.A2, rv64_asm.A0, rv64_asm.A1);
            cg.buf.mul(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
            cg.buf.srai(alloc, rv64_asm.A3, rv64_asm.A0, 63_u8);
            cg.buf.br_short_label(alloc, .Eq, rv64_asm.A2, rv64_asm.A3, l_done);
        }
        cg.buf.bind_label(l_ovf);
        cg.buf.li64(alloc, rv64_asm.A0, 0x7FFFFFFFFFFFFFFF_u64);
        cg.buf.br_short_label(alloc, .Ge, rv64_asm.T1, rv64_asm.ZERO, l_done);
        cg.buf.li64(alloc, rv64_asm.A0, 0x8000000000000000_u64);
    }
    cg.buf.bind_label(l_done);
    cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
    return;
}

fn cg_emit_binary(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: ast.BinaryOp, lhs: eir.EirValue, rhs: eir.EirValue, dst_ty: types.TyId, op_ty: types.TyId) {
    let op_n = env.get(op_ty);
    if op_n.kind == .Float { cg_emit_binary_float(alloc, cg, eir_prog, env, interner, dst, op, lhs, rhs, op_ty); return; }
    if op_n.kind == .Vec { cg_emit_binary_vec(alloc, cg, env, dst, op, lhs, rhs, op_ty); return; }
    if op == .AddCheck || op == .SubCheck || op == .MulCheck || op == .DivCheck || op == .ModCheck {
        cg_emit_binary_checked(alloc, cg, eir_prog, env, dst, op, lhs, rhs, op_ty); return;
    }
    if op == .AddSat || op == .SubSat || op == .MulSat { cg_emit_binary_sat(alloc, cg, eir_prog, env, dst, op, lhs, rhs, op_ty); return; }

    let signed = env.is_signed_int(op_ty);
    cg_load_scalar_val(alloc, cg, eir_prog, env, lhs, rv64_asm.A0);
    cg_load_scalar_val(alloc, cg, eir_prog, env, rhs, rv64_asm.A1);
    if op == .Eq || op == .NotEq || op == .Lt || op == .LtEq || op == .Gt || op == .GtEq {
        cg_emit_int_cmp_to_a0(alloc, cg, op, signed, rv64_asm.A0, rv64_asm.A1);
    } else if op == .And || op == .Or {
        if op == .And { cg.buf.and_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        else { cg.buf.or_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        cg.buf.andi(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32);
    } else {
        if op == .Add || op == .AddWrap { cg.buf.add(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        else if op == .Sub || op == .SubWrap { cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        else if op == .Mul || op == .MulWrap { cg.buf.mul(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        else if op == .Div { if signed { cg.buf.div(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); } else { cg.buf.divu(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); } }
        else if op == .Mod { if signed { cg.buf.rem(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); } else { cg.buf.remu(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); } }
        else if op == .BitAnd { cg.buf.and_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        else if op == .BitOr { cg.buf.or_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        else if op == .BitXor { cg.buf.xor(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        else if op == .Shl || op == .ShlWrap {
            let bits = env.int_bits(op_ty);
            if op == .ShlWrap && bits > 0_u8 && bits < 64_u8 { cg.buf.andi(alloc, rv64_asm.A1, rv64_asm.A1, (bits -% 1_u8).widen.[i32]()); }
            cg.buf.sll(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
        } else if op == .Shr {
            if signed { cg.buf.sra(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
            else { cg.buf.srl(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        }
        cg_norm_subword(alloc, cg, env, dst_ty, rv64_asm.A0);
    }
    cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
    return;
}

fn cg_emit_cast(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, kind: cfg_ir.CastKind, operand: eir.EirValue, from_ty: types.TyId, to_ty: types.TyId) {
    let fn_n = env.get(from_ty);
    let tn_n = env.get(to_ty);
    match kind {
        .Widen => {
            if fn_n.kind == .Float && tn_n.kind == .Float {
                cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, rv64_asm.FA0);
                if fn_n.u8_val != 64_u8 && tn_n.u8_val == 64_u8 { cg.buf.fcvt_d_s(alloc, rv64_asm.FA0, rv64_asm.FA0); }
                cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, rv64_asm.FA0);
            } else {
                cg_load_scalar_val(alloc, cg, eir_prog, env, operand, rv64_asm.A0);
                cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            }
        }
        .Trunc => {
            if fn_n.kind == .Float && tn_n.kind == .Float {
                cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, rv64_asm.FA0);
                if fn_n.u8_val == 64_u8 && tn_n.u8_val != 64_u8 { cg.buf.fcvt_s_d(alloc, rv64_asm.FA0, rv64_asm.FA0); }
                cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, rv64_asm.FA0);
            } else {
                cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, rv64_asm.A0);
                cg_norm_subword(alloc, cg, env, to_ty, rv64_asm.A0);
                cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            }
        }
        .Clamp => {
            cg_load_scalar_val(alloc, cg, eir_prog, env, operand, rv64_asm.A0);
            let ss = env.is_signed_int(from_ty);
            let ds = env.is_signed_int(to_ty);
            let bnds = types.int_bounds(tn_n);
            if ss && !ds {
                let l0 = cg.buf.new_label(alloc);
                cg.buf.br_short_label(alloc, .Ge, rv64_asm.A0, rv64_asm.ZERO, l0);
                cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.ZERO);
                cg.buf.bind_label(l0);
                if env.int_bits(to_ty) < 64_u8 { cg_emit_clamp_reg(alloc, cg, rv64_asm.A0, 0_u64, bnds.max.lo, false); }
            } else { cg_emit_clamp_reg(alloc, cg, rv64_asm.A0, bnds.min.lo, bnds.max.lo, ss); }
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
        }
        .ToFloat => {
            cg_load_scalar_val(alloc, cg, eir_prog, env, operand, rv64_asm.A0);
            cg.buf.fcvt_int_to_fp(alloc, tn_n.u8_val == 64_u8, true, !env.is_signed_int(from_ty), rv64_asm.FA0, rv64_asm.A0);
            cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, rv64_asm.FA0);
        }
        .TruncToInt => {
            cg_load_float_val(alloc, cg, eir_prog, env, interner, operand, rv64_asm.FA0);
            cg.buf.fcvt_fp_to_int(alloc, fn_n.u8_val == 64_u8, true, !env.is_signed_int(to_ty), rv64_asm.A0, rv64_asm.FA0);
            cg_norm_subword(alloc, cg, env, to_ty, rv64_asm.A0);
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
        }
        .Bitcast => {
            let sz = env.x64_layout(to_ty).size;
            if sz == 0_usize { return; }
            let dloc = cg_val_loc(cg, dst);
            let sloc = cg_val_loc(cg, operand);
            if dloc.kind == .Reg || sloc.kind == .Reg {
                cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, rv64_asm.A0);
                cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            } else { cg_copy_mem(alloc, cg, rv64_asm.FP, dloc.stack_off, rv64_asm.FP, sloc.stack_off, sz); }
        }
        .AsU64 => { cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, rv64_asm.A0); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        .MutToConst => { cg_copy_val_to_val(alloc, cg, eir_prog, env, dst, operand); }
        .ArrayBorrowToSlice => {
            cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, rv64_asm.A0);
            let doff = cg_val_off(cg, dst);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 8_u8);
            cg.buf.li64(alloc, rv64_asm.A0, env.get(fn_n.primary).u64_val);
            st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.A0, 8_u8);
        }
        .WrapOptional => {
            let inner = tn_n.primary;
            if env.opt_niche(inner).kind != .None { cg_copy_val_to_val(alloc, cg, eir_prog, env, dst, operand); }
            else {
                let doff = cg_val_off(cg, dst);
                cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, 1_i32);
                st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 1_u8);
                cg_store_val_to_mem(alloc, cg, env, rv64_asm.FP, doff +% env.opt_val_offset(inner).trunc.[i32](), operand, inner);
            }
        }
        .WrapOk => {
            let ok_ty = tn_n.primary;
            let doff = cg_val_off(cg, dst);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
            if env.x64_layout(ok_ty).size > 0_usize { cg_store_val_to_mem(alloc, cg, env, rv64_asm.FP, doff +% env.eu_ok_offset(ok_ty).trunc.[i32](), operand, ok_ty); }
        }
        .WrapErr => {
            cg_load_scalar_raw(alloc, cg, eir_prog, env, operand, rv64_asm.A0);
            st(alloc, cg, rv64_asm.FP, cg_val_off(cg, dst), rv64_asm.A0, 4_u8);
        }
    }
    return;
}

fn cg_emit_slice(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, base: eir.EirValue, lo_val: eir.EirValue, hi_val: eir.EirValue, base_ty: types.TyId) {
    let bn = env.get(base_ty);
    var esz: usize = 1_usize;
    if bn.kind == .Array {
        esz = env.x64_layout(bn.primary).size;
        cg_val_addr_into(alloc, cg, base, rv64_asm.T1);
        cg.buf.li64(alloc, rv64_asm.T2, bn.u64_val);
    } else if bn.kind == .Borrow && bn.borrow_kind == .Single {
        let inner = env.get(bn.primary);
        if inner.kind == .Array {
            esz = env.x64_layout(inner.primary).size;
            cg_load_scalar_raw(alloc, cg, eir_prog, env, base, rv64_asm.T1);
            cg.buf.li64(alloc, rv64_asm.T2, inner.u64_val);
        }
    } else {
        if bn.kind == .Borrow && bn.borrow_kind == .Slice { esz = env.x64_layout(bn.primary).size; }
        let boff = cg_val_off(cg, base);
        ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, boff, 8_u8);
        ld(alloc, cg, rv64_asm.T2, rv64_asm.FP, boff +% 8_i32, 8_u8);
    }
    if lo_val != eir.EIR_NONE { cg_load_scalar_raw(alloc, cg, eir_prog, env, lo_val, rv64_asm.A1); }
    else { cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO); }
    if hi_val != eir.EIR_NONE { cg_load_scalar_raw(alloc, cg, eir_prog, env, hi_val, rv64_asm.A2); }
    else { cg.buf.mv(alloc, rv64_asm.A2, rv64_asm.T2); }
    cg.buf.sub(alloc, rv64_asm.A2, rv64_asm.A2, rv64_asm.A1);
    cg_scale_add(alloc, cg, rv64_asm.T1, rv64_asm.T1, rv64_asm.A1, esz);
    let doff = cg_val_off(cg, dst);
    st(alloc, cg, rv64_asm.FP, doff, rv64_asm.T1, 8_u8);
    st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.A2, 8_u8);
    return;
}

fn cg_emit_aggregate(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, agg_id: u32, elems_range: ast.IdRange, dst_ty: types.TyId) {
    let agg = eir_prog.get_aggregate(agg_id) orelse { return; };
    let elems = eir_prog.vals_slice(elems_range);
    let dlay = env.x64_layout(dst_ty);
    if dlay.size == 0_usize { return; }
    let dloc = cg_val_loc(cg, dst);
    if agg.tag == .Bitfield {
        cg.buf.mv(alloc, rv64_asm.T2, rv64_asm.ZERO);
        if let bm = env.get_bitfield(agg.def_id) {
            let mems = env.bitfield_members_range(bm.members);
            var i: usize = 0_usize;
            while i < elems.len && i < mems.len {
                let m = mems[i];
                cg_load_scalar_raw(alloc, cg, eir_prog, env, elems[i], rv64_asm.A0);
                if (m.hi -% m.lo) < 64_u8 { cg.buf.extend_bits(alloc, rv64_asm.A0, rv64_asm.A0, m.hi -% m.lo, false); }
                if m.lo > 0_u8 { cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.A0, m.lo); }
                cg.buf.or_r(alloc, rv64_asm.T2, rv64_asm.T2, rv64_asm.A0);
                i = i +% 1_usize;
            }
        }
        cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.T2);
        return;
    }
    let doff = dloc.stack_off;
    if dloc.kind == .Stack { cg_memzero(alloc, cg, rv64_asm.FP, doff, dlay.size); }
    if agg.tag == .Struct || agg.tag == .AnonStruct || agg.tag == .Tuple {
        var i: usize = 0_usize;
        while i < elems.len {
            let fo = env.struct_field_offset(dst_ty, i);
            cg_store_val_to_mem(alloc, cg, env, rv64_asm.FP, doff +% fo.offset.trunc.[i32](), elems[i], fo.ty);
            i = i +% 1_usize;
        }
    } else if agg.tag == .PoolRow {
        var i: usize = 0_usize;
        while i < elems.len {
            let fo = env.struct_field_offset(dst_ty, i);
            let is_lk = env.is_link_or_opt_link(fo.ty);
            let ev_ty = eir_prog.fn_val_ty(cg.fn_id, elems[i]);
            if !agg.is_slot_pool && is_lk && env.x64_layout(ev_ty).size == 4_usize {
                cg_load_scalar_raw(alloc, cg, eir_prog, env, elems[i], rv64_asm.A0);
                st(alloc, cg, rv64_asm.FP, doff +% fo.offset.trunc.[i32](), rv64_asm.A0, 4_u8);
                st(alloc, cg, rv64_asm.FP, doff +% fo.offset.trunc.[i32]() +% 4_i32, rv64_asm.ZERO, 4_u8);
            } else {
                cg_store_val_to_mem(alloc, cg, env, rv64_asm.FP, doff +% fo.offset.trunc.[i32](), elems[i], if agg.is_slot_pool && is_lk { ev_ty } else { fo.ty });
            }
            i = i +% 1_usize;
        }
    } else if agg.tag == .Array || agg.tag == .Vec {
        let esz = env.x64_layout(agg.elem_ty).size;
        var i: usize = 0_usize;
        while i < elems.len { cg_store_val_to_mem(alloc, cg, env, rv64_asm.FP, doff +% (i *% esz).trunc.[i32](), elems[i], agg.elem_ty); i = i +% 1_usize; }
    } else if agg.tag == .ArrayRepeat && elems.len > 0_usize && agg.count > 0_u64 {
        let esz = env.x64_layout(agg.elem_ty).size;
        cg_store_val_to_mem(alloc, cg, env, rv64_asm.FP, doff, elems[0_usize], agg.elem_ty);
        if agg.count > 1_u64 {
            addl(alloc, cg, rv64_asm.T1, rv64_asm.FP, doff.widen.[i64]());
            cg.buf.addi(alloc, rv64_asm.T2, rv64_asm.ZERO, 1_i32);
            cg.buf.li64(alloc, rv64_asm.T3, agg.count);
            let l_lp = cg.buf.new_label(alloc);
            cg.buf.bind_label(l_lp);
            addl(alloc, cg, rv64_asm.T1, rv64_asm.T1, esz.widen.[u64]().bitcast.[i64]());
            cg_copy_mem(alloc, cg, rv64_asm.T1, 0_i32, rv64_asm.FP, doff, esz);
            cg.buf.addi(alloc, rv64_asm.T2, rv64_asm.T2, 1_i32);
            cg.buf.br_cond_label(alloc, .Ltu, rv64_asm.T2, rv64_asm.T3, l_lp);
        }
    } else if agg.tag == .UnionVariant {
        cg.buf.li64(alloc, rv64_asm.A0, agg.variant_idx.widen.[u64]());
        st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 4_u8);
        if elems.len > 0_usize {
            let po = env.union_payload_offset(agg.def_id).trunc.[i32]();
            cg_store_val_to_mem(alloc, cg, env, rv64_asm.FP, doff +% po, elems[0_usize], eir_prog.fn_val_ty(cg.fn_id, elems[0_usize]));
        }
    }
    return;
}

fn cg_emit_unwrap_and_extract(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, inst: *eir.EirInst) {
    match inst.kind {
        .UnwrapOptional => {
            if env.opt_niche(inst.ty0).kind != .None { cg_copy_val_to_val(alloc, cg, eir_prog, env, inst.dst, inst.v0); }
            else { cg_load_val_from_mem(alloc, cg, env, inst.dst, rv64_asm.FP, cg_val_off(cg, inst.v0) +% env.opt_val_offset(inst.ty0).trunc.[i32](), inst.ty0); }
        }
        .UnwrapErrorOk => {
            if env.x64_layout(inst.ty0).size > 0_usize {
                cg_load_val_from_mem(alloc, cg, env, inst.dst, rv64_asm.FP, cg_val_off(cg, inst.v0) +% env.eu_ok_offset(inst.ty0).trunc.[i32](), inst.ty0);
            }
        }
        .UnwrapErrorErr => {
            ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, cg_val_off(cg, inst.v0), 4_u8);
            cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, rv64_asm.A0);
        }
        .IsNonNull => {
            let niche = env.opt_niche(env.get(inst.ty1).primary);
            let sloc = cg_val_loc(cg, inst.v0);
            if niche.kind == .IdBrand || niche.kind == .ScalarSentinel {
                cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, rv64_asm.A0);
                var sent_val: u64 = niche.sentinel;
                if niche.kind == .IdBrand { sent_val = 0xFFFFFFFF_u64; }
                cg.buf.li64(alloc, rv64_asm.A1, sent_val);
                cg.buf.xor(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
            } else if niche.kind == .GenId || niche.kind == .Link {
                cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, rv64_asm.A0);
                cg.buf.srli(alloc, rv64_asm.A0, rv64_asm.A0, 32_u8);
            } else if niche.kind == .NullPtr {
                cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, rv64_asm.A0);
            } else if niche.kind == .FatPtrNullFirst {
                ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, sloc.stack_off, 8_u8);
            } else if niche.kind == .SliceMaxLen {
                ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, sloc.stack_off +% 8_i32, 8_u8);
                cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32);
            } else if niche.kind == .BoolTag {
                cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, rv64_asm.A0);
                cg.buf.xori(alloc, rv64_asm.A0, rv64_asm.A0, 2_i32);
            } else {
                ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, sloc.stack_off, 1_u8);
            }
            cg.buf.sltu(alloc, rv64_asm.A0, rv64_asm.ZERO, rv64_asm.A0);
            cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, rv64_asm.A0);
        }
        .IsError => {
            ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, cg_val_off(cg, inst.v0), 4_u8);
            cg.buf.sltu(alloc, rv64_asm.A0, rv64_asm.ZERO, rv64_asm.A0);
            cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, rv64_asm.A0);
        }
        .MatchTag => {
            let sn = env.get(inst.ty1);
            if sn.kind == .Union || sn.kind == .ErrorUnion { ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, cg_val_off(cg, inst.v0), 4_u8); }
            else { cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, rv64_asm.A0); }
            cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, rv64_asm.A0);
        }
        .FieldExtract => {
            let sn = env.get(inst.ty1);
            if sn.kind == .Union {
                let soff = cg_val_off(cg, inst.v0);
                cg_load_val_from_mem(alloc, cg, env, inst.dst, rv64_asm.FP, soff +% env.union_payload_offset(sn.primary).trunc.[i32](), inst.ty0);
                return;
            }
            if sn.kind == .Bitfield {
                let bf = lookup_bf_member(env, sn.primary, inst.aux0.widen.[usize]());
                cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, rv64_asm.A0);
                if bf.lo > 0_u8 { cg.buf.srli(alloc, rv64_asm.A0, rv64_asm.A0, bf.lo); }
                if bf.width < 64_u8 { cg.buf.extend_bits(alloc, rv64_asm.A0, rv64_asm.A0, bf.width, env.is_signed_int(bf.member_ty)); }
                cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, rv64_asm.A0);
                return;
            }
            let foff = env.struct_field_offset(inst.ty1, inst.aux0.widen.[usize]()).offset;
            let sloc = cg_val_loc(cg, inst.v0);
            if sloc.kind == .Reg {
                cg.buf.mv(alloc, rv64_asm.A0, sloc.reg);
                if foff > 0_usize { cg.buf.srli(alloc, rv64_asm.A0, rv64_asm.A0, (foff *% 8_usize).trunc.[u8]()); }
                cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, rv64_asm.A0);
            } else {
                cg_load_val_from_mem(alloc, cg, env, inst.dst, rv64_asm.FP, sloc.stack_off +% foff.trunc.[i32](), inst.ty0);
            }
        }
        .MakeDyn => {
            let vt = mach_isel_a64.intern_sym_u64_2(alloc, interner, "eon_vtable_", inst.aux0.widen.[u64](), inst.ty1.widen.[u64]()) catch { cg.oom = true; return; };
            let doff = cg_val_off(cg, inst.dst);
            cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, rv64_asm.A0);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 8_u8);
            cg.buf.lea_sym(alloc, rv64_asm.A0, vt, 0_i64);
            st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.A0, 8_u8);
        }
        .MakeClosure => {
            let csym = mach_isel_a64.a64_fn_sym_name_id(alloc, cfg_ir.fn_key_closure(inst.aux0), eir_prog, interner) catch { cg.oom = true; return; };
            let doff = cg_val_off(cg, inst.dst);
            cg.buf.lea_sym(alloc, rv64_asm.A0, csym, 0_i64);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 8_u8);
            if inst.v0 != eir.EIR_NONE { cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v0, rv64_asm.A0); st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.A0, 8_u8); }
            else { st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.ZERO, 8_u8); }
        }
        .InlineAsm => {
            if let ad = eir_prog.get_asm(inst.aux0) {
                let ins = eir_prog.asm_inputs_slice(ad.inputs);
                var i: usize = 0_usize;
                while i < ins.len {
                    if let r = rv_gp_arg(i) { cg_load_scalar_raw(alloc, cg, eir_prog, env, ins[i].val, r); }
                    i = i +% 1_usize;
                }
                let ok_asm = rv64_asm.encode_rv64_inline_asm(alloc, eir_prog.bytes_slice(ad.template), &mut cg.buf) catch { cg.oom = true; return; };
                if !ok_asm {
                    cg_fail(alloc, cg, "riscv64 codegen error: unsupported inline asm template");
                }
            }
        }
        _ => {}
    }
    return;
}

// ============================================================================
// Section 7: Calls (`EonCall` T0 Error Channel + `LP64D`)
// ============================================================================

struct RvCallArgSlot { val: eir.EirValue; ty: types.TyId; cls: mach_isel_a64.A64ArgClass; is_reg: bool; idx: usize; stk_off: i32; }

fn cg_emit_call(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, call_id: u32) -> !OutOfMemory {
    let cd = eir_prog.get_call(call_id) orelse { return; };
    let callee = cd.callee;
    let args = eir_prog.vals_slice(cd.args);
    let rc = mach_isel_a64.a64_classify_ret(cd.ret_ty, env);
    let uses_sret = mach_isel_a64.a64_ret_uses_sret(rc);
    var gp_i: usize = if uses_sret { 1_usize } else { 0_usize };
    var flt_i: usize = 0_usize;
    var stk_b: usize = 0_usize;
    var env_gp: usize = 99_usize;
    var dyn_gp: usize = 99_usize;
    var start_a: usize = 0_usize;
    if callee.kind == .FnPtr { env_gp = gp_i; gp_i = gp_i +% 1_usize; }
    else if callee.kind == .DynCall { dyn_gp = gp_i; gp_i = gp_i +% 1_usize; start_a = 1_usize; }

    var plan = try col.DynBuf.[RvCallArgSlot].init(alloc, if args.len > 4_usize { args.len } else { 4_usize });
    errdefer plan.destroy(alloc);
    var ai = start_a;
    while ai < args.len {
        let av = args[ai];
        let aty = eir_prog.fn_val_ty(cg.fn_id, av);
        let cls = mach_isel_a64.a64_classify_arg(aty, env);
        if cls == .IntReg || cls == .ByPtr {
            if gp_i < 8_usize { try plan.push(alloc, RvCallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, idx: gp_i, stk_off: 0_i32 }); gp_i = gp_i +% 1_usize; }
            else { try plan.push(alloc, RvCallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, idx: 0_usize, stk_off: stk_b.trunc.[i32]() }); stk_b = stk_b +% 8_usize; }
        } else if cls == .TwoIntRegs {
            if gp_i +% 1_usize < 8_usize { try plan.push(alloc, RvCallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, idx: gp_i, stk_off: 0_i32 }); gp_i = gp_i +% 2_usize; }
            else { try plan.push(alloc, RvCallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, idx: 0_usize, stk_off: stk_b.trunc.[i32]() }); stk_b = stk_b +% 16_usize; }
        } else if cls == .FloatReg {
            if flt_i < 8_usize { try plan.push(alloc, RvCallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: true, idx: flt_i, stk_off: 0_i32 }); flt_i = flt_i +% 1_usize; }
            else { try plan.push(alloc, RvCallArgSlot.{ val: av, ty: aty, cls: cls, is_reg: false, idx: 0_usize, stk_off: stk_b.trunc.[i32]() }); stk_b = stk_b +% 8_usize; }
        }
        ai = ai +% 1_usize;
    }

    var disc_sret: usize = 0_usize;
    if uses_sret && dst == eir.EIR_NONE {
        disc_sret = types.align_up_usize(env.x64_layout(if rc.kind == .ErrorUnion { rc.ok_ty } else { cd.ret_ty }).size, 16_usize);
        if disc_sret == 0_usize { disc_sret = 16_usize; }
    }
    let aligned_stk = types.align_up_usize(stk_b +% disc_sret, 16_usize);
    if aligned_stk > 0_usize {
        if aligned_stk.widen.[u64]() > cg.max_call_stk { cg.max_call_stk = aligned_stk.widen.[u64](); }
        addl(alloc, cg, rv64_asm.SP, rv64_asm.SP, 0_i64 -% aligned_stk.widen.[u64]().bitcast.[i64]());
    }

    let ps = plan.as_slice();
    var pi: usize = 0_usize;
    while pi < ps.len {
        let s = ps[pi];
        if !s.is_reg {
            let lay = env.x64_layout(s.ty);
            if s.cls == .IntReg { cg_load_scalar_val(alloc, cg, eir_prog, env, s.val, rv64_asm.T1); st(alloc, cg, rv64_asm.SP, s.stk_off, rv64_asm.T1, 8_u8); }
            else if s.cls == .ByPtr { cg_val_addr_into(alloc, cg, s.val, rv64_asm.T1); st(alloc, cg, rv64_asm.SP, s.stk_off, rv64_asm.T1, 8_u8); }
            else {
                let sz = if s.cls == .TwoIntRegs { lay.size } else if env.get(s.ty).u8_val == 64_u8 { 8_usize } else { 4_usize };
                cg_copy_mem(alloc, cg, rv64_asm.SP, s.stk_off, rv64_asm.FP, cg_val_off(cg, s.val), sz);
            }
        }
        pi = pi +% 1_usize;
    }
    pi = 0_usize;
    while pi < ps.len {
        let s = ps[pi];
        if s.is_reg {
            let lay = env.x64_layout(s.ty);
            if s.cls == .IntReg { cg_load_scalar_val(alloc, cg, eir_prog, env, s.val, rv64_asm.A0 +% s.idx.trunc.[u8]()); }
            else if s.cls == .ByPtr { cg_val_addr_into(alloc, cg, s.val, rv64_asm.A0 +% s.idx.trunc.[u8]()); }
            else if s.cls == .FloatReg { ldf(alloc, cg, env.get(s.ty).u8_val == 64_u8, rv64_asm.FA0 +% s.idx.trunc.[u8](), rv64_asm.FP, cg_val_off(cg, s.val)); }
            else if s.cls == .TwoIntRegs {
                let soff = cg_val_off(cg, s.val);
                let r0 = rv64_asm.A0 +% s.idx.trunc.[u8]();
                ld(alloc, cg, r0, rv64_asm.FP, soff, 8_u8);
                if lay.size > 8_usize { ld(alloc, cg, r0 +% 1_u8, rv64_asm.FP, soff +% 8_i32, (lay.size - 8_usize).trunc.[u8]()); }
                else { cg.buf.mv(alloc, r0 +% 1_u8, rv64_asm.ZERO); }
            }
        }
        pi = pi +% 1_usize;
    }

    if uses_sret {
        if dst == eir.EIR_NONE { addl(alloc, cg, rv64_asm.A0, rv64_asm.SP, stk_b.widen.[u64]().bitcast.[i64]()); }
        else {
            var sd = cg_val_off(cg, dst);
            if rc.kind == .ErrorUnion { sd = sd +% env.eu_ok_offset(rc.ok_ty).trunc.[i32](); }
            addl(alloc, cg, rv64_asm.A0, rv64_asm.FP, sd.widen.[i64]());
        }
    }
    if callee.kind == .FnPtr {
        let foff = cg_val_off(cg, callee.a);
        if env_gp < 8_usize { ld(alloc, cg, rv64_asm.A0 +% env_gp.trunc.[u8](), rv64_asm.FP, foff +% 8_i32, 8_u8); }
        ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, foff, 8_u8);
    } else if callee.kind == .DynCall && args.len > 0_usize {
        let doff = cg_val_off(cg, args[0_usize]);
        if dyn_gp < 8_usize { ld(alloc, cg, rv64_asm.A0 +% dyn_gp.trunc.[u8](), rv64_asm.FP, doff, 8_u8); }
        ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, doff +% 8_i32, 8_u8);
        ld(alloc, cg, rv64_asm.T1, rv64_asm.T1, (callee.b.widen.[usize]() *% 8_usize).trunc.[i32](), 8_u8);
    }

    if callee.kind == .DirectFn { cg.buf.call_sym(alloc, try mach_isel_a64.a64_fn_sym_name_id(alloc, cfg_ir.fn_key_top_def(callee.a), eir_prog, interner)); }
    else if callee.kind == .Method { cg.buf.call_sym(alloc, try mach_isel_a64.a64_fn_sym_name_id(alloc, cfg_ir.fn_key_impl_method(callee.a, callee.b), eir_prog, interner)); }
    else if callee.kind == .GenericInst { cg.buf.call_sym(alloc, try mach_isel_a64.a64_fn_sym_name_id(alloc, cfg_ir.fn_key_generic_inst(callee.a), eir_prog, interner)); }
    else if callee.kind == .ExternFn {
        if mach_isel_a64.a64_is_builtin_rt_helper(interner.get(callee.b)) { cg_note_helper(alloc, cg, callee.b); }
        cg.buf.call_sym(alloc, callee.b);
    } else { cg.buf.call_reg(alloc, rv64_asm.T1); }

    if aligned_stk > 0_usize { addl(alloc, cg, rv64_asm.SP, rv64_asm.SP, aligned_stk.widen.[u64]().bitcast.[i64]()); }

    if dst != eir.EIR_NONE {
        let lay = env.x64_layout(cd.ret_ty);
        if rc.kind == .IntReg { cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        else if rc.kind == .TwoIntRegs {
            let doff = cg_val_off(cg, dst);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 8_u8);
            if lay.size > 8_usize { st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.A1, (lay.size - 8_usize).trunc.[u8]()); }
        } else if rc.kind == .FloatReg { cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, rv64_asm.FA0); }
        else if rc.kind == .ErrorUnion {
            let l_err = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            let doff = cg_val_off(cg, dst);
            cg.buf.br_cond_label(alloc, .Ne, rv64_asm.T0, rv64_asm.ZERO, l_err);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
            let ok_off = env.eu_ok_offset(rc.ok_ty).trunc.[i32]();
            let ok_lay = env.x64_layout(rc.ok_ty);
            if rc.ok_kind == .IntReg { st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.A0, ok_lay.size.trunc.[u8]()); }
            else if rc.ok_kind == .TwoIntRegs {
                st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.A0, 8_u8);
                if ok_lay.size > 8_usize { st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 8_i32, rv64_asm.A1, (ok_lay.size - 8_usize).trunc.[u8]()); }
            } else if rc.ok_kind == .FloatReg { stf(alloc, cg, env.get(rc.ok_ty).u8_val == 64_u8, rv64_asm.FP, doff +% ok_off, rv64_asm.FA0); }
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_err);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.T0, 4_u8);
            cg.buf.bind_label(l_done);
        }
    }
    plan.destroy(alloc);
    return;
}

// ============================================================================
// Section 8: Complete RV64 Builtin Operations (Arena, Pools, Buf, Atomic/MMIO,
//            Slice/Array/Str, Math, Vec, ParReduce, SysIO)
// ============================================================================

fn get_arg_slot(arg_slots: *[eir.EirSlot], idx: usize) -> eir.EirSlot {
    if idx < arg_slots.len { return arg_slots[idx]; }
    return eir.EIR_NONE;
}

fn cg_bptr(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], idx: usize, dst: u8) {
    if idx < args.len { cg_load_ptr_arg(alloc, cg, eir_prog, env, args[idx], get_arg_slot(arg_slots, idx), dst); }
    return;
}

fn pool_ncols_ty(env: *types.TypeEnv, elem_ty: types.TyId) -> usize {
    let n = env.get(elem_ty);
    if n.kind == .Pool { if let pm = env.get_pool(n.primary) { return pm.columns.len.widen.[usize](); } }
    return 0_usize;
}

fn pool_ncols_arg(env: *types.TypeEnv, arg_ty: types.TyId) -> usize {
    var cur = arg_ty;
    let n0 = env.get(cur);
    if n0.kind == .Borrow && n0.borrow_kind == .Single { cur = n0.primary; }
    let n1 = env.get(cur);
    if n1.kind == .Builtin { return env.pool_col_count(env.node_gval_list(&n1)); }
    return 0_usize;
}

fn array_len_arg(eir_prog: *eir.EirProgram, fn_id: u32, env: *types.TypeEnv, v: eir.EirValue) -> u64 {
    var ty = eir_prog.fn_val_ty(fn_id, v);
    let n0 = env.get(ty);
    if n0.kind == .Borrow && n0.borrow_kind == .Single { ty = n0.primary; }
    let n1 = env.get(ty);
    if n1.kind == .Array { return n1.u64_val; }
    return 0_u64;
}

/// Completes OOM check + ErrorUnion store for ArenaInit (mode=0), ArenaAlloc (mode=1), BufInit (mode=2).
fn cg_emit_eu_alloc_finish(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, doff: i32, ok_off: i32, args: *[eir.EirValue], mode: u8) {
    if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A1); }
    else { cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO); }
    let l_ok = cg.buf.new_label(alloc);
    let l_done = cg.buf.new_label(alloc);
    cg.buf.br_cond_label(alloc, .Ne, rv64_asm.A0, rv64_asm.ZERO, l_ok);
    cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A1, rv64_asm.ZERO, l_ok);
    st_eu_err(alloc, cg, doff, 7_i32);
    cg.buf.j_label(alloc, l_done);
    cg.buf.bind_label(l_ok);
    st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
    st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.A0, 8_u8);
    if mode == 0_u8 {
        st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 8_i32, rv64_asm.A1, 8_u8);
        st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 16_i32, rv64_asm.ZERO, 8_u8);
    } else if mode == 1_u8 {
        st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 8_i32, rv64_asm.A1, 8_u8);
    } else {
        st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 8_i32, rv64_asm.ZERO, 8_u8);
        st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 16_i32, rv64_asm.A1, 8_u8);
    }
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_pool_write_row(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, pdef: u32, row_v: eir.EirValue, is_slot: bool) {
    // Expects pool_ptr in T1 and row index in T2.
    let row_off = cg_val_off(cg, row_v);
    let row_ty = eir_prog.fn_val_ty(cg.fn_id, row_v);
    if let pm = env.get_pool(pdef) {
        let cols = env.pool_cols_range(pm.columns);
        var ci: usize = 0_usize;
        while ci < cols.len {
            let foff = env.struct_field_offset(row_ty, ci).offset;
            let er = env.x64_layout_impl(cols[ci].ty, is_slot).size;
            let esz = if er == 0_usize { 1_usize } else { er };
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, (ci *% 8_usize).trunc.[i32](), 8_u8);
            cg.buf.mv(alloc, rv64_asm.T4, rv64_asm.T2);
            cg_scale_add(alloc, cg, rv64_asm.T3, rv64_asm.T3, rv64_asm.T4, esz);
            cg_copy_mem(alloc, cg, rv64_asm.T3, 0_i32, rv64_asm.FP, row_off +% foff.trunc.[i32](), esz);
            ci = ci +% 1_usize;
        }
    }
    return;
}

fn cg_emit_init_free_stack(alloc: *mut AllocCap, cg: *mut RvCg) {
    // Populates free_stack [A0] in reverse order for indices [T2 .. T3).
    let l_fk = cg.buf.new_label(alloc);
    let l_end = cg.buf.new_label(alloc);
    cg.buf.bind_label(l_fk);
    cg.buf.br_short_label(alloc, .Geu, rv64_asm.T2, rv64_asm.T3, l_end);
    cg.buf.addi(alloc, rv64_asm.T4, rv64_asm.T3, -1_i32);
    cg.buf.sub(alloc, rv64_asm.T4, rv64_asm.T4, rv64_asm.T2);
    cg.buf.slli(alloc, rv64_asm.T4, rv64_asm.T4, 2_u8);
    cg.buf.add(alloc, rv64_asm.T4, rv64_asm.A0, rv64_asm.T4);
    st(alloc, cg, rv64_asm.T4, 0_i32, rv64_asm.T2, 4_u8);
    cg.buf.addi(alloc, rv64_asm.T2, rv64_asm.T2, 1_i32);
    cg.buf.j_label(alloc, l_fk);
    cg.buf.bind_label(l_end);
    return;
}

fn cg_emit_pool_realloc_buf(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], field_off: i32, esz: usize, align: i32, l_oom: u32) {
    let tmp = cg.frame.temp_off;
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, rv64_asm.A0);
    ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, tmp +% 8_i32, 8_u8);
    if esz != 1_usize { cg.buf.li64(alloc, rv64_asm.T4, esz.widen.[u64]()); cg.buf.mul(alloc, rv64_asm.A1, rv64_asm.A1, rv64_asm.T4); }
    cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.ZERO, align);
    cg_call_alloc_raw(alloc, cg, interner);
    cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A0, rv64_asm.ZERO, l_oom);
    st(alloc, cg, rv64_asm.FP, tmp +% 16_i32, rv64_asm.A0, 8_u8);
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
    cg.buf.mv(alloc, rv64_asm.T2, rv64_asm.A0);
    ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, field_off, 8_u8);
    ld(alloc, cg, rv64_asm.T4, rv64_asm.FP, tmp, 8_u8);
    if esz != 1_usize { cg.buf.li64(alloc, rv64_asm.A1, esz.widen.[u64]()); cg.buf.mul(alloc, rv64_asm.T4, rv64_asm.T4, rv64_asm.A1); }
    cg_copy_mem_dyn(alloc, cg, rv64_asm.T2, rv64_asm.T3, rv64_asm.T4);
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, rv64_asm.A0);
    ld(alloc, cg, rv64_asm.A1, rv64_asm.T1, field_off, 8_u8);
    ld(alloc, cg, rv64_asm.A2, rv64_asm.FP, tmp, 8_u8);
    if esz != 1_usize { cg.buf.li64(alloc, rv64_asm.T4, esz.widen.[u64]()); cg.buf.mul(alloc, rv64_asm.A2, rv64_asm.A2, rv64_asm.T4); }
    cg_call_free_raw(alloc, cg, interner);
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
    ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, tmp +% 16_i32, 8_u8);
    st(alloc, cg, rv64_asm.T1, field_off, rv64_asm.A0, 8_u8);
    return;
}

fn cg_emit_bounds_at(alloc: *mut AllocCap, cg: *mut RvCg, env: *types.TypeEnv, dst: eir.EirValue, esz: usize) {
    // Expects ptr=T1, idx=T2, len=T3.
    let doff = cg_val_off(cg, dst);
    let ok_off = env.eu_ok_offset(types.TY_USIZE).trunc.[i32]();
    let l_oob = cg.buf.new_label(alloc);
    let l_done = cg.buf.new_label(alloc);
    cg.buf.br_cond_label(alloc, .Geu, rv64_asm.T2, rv64_asm.T3, l_oob);
    cg_scale_add(alloc, cg, rv64_asm.T1, rv64_asm.T1, rv64_asm.T2, esz);
    st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
    st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.T1, 8_u8);
    cg.buf.j_label(alloc, l_done);
    cg.buf.bind_label(l_oob);
    st_eu_err(alloc, cg, doff, 4_i32);
    st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.ZERO, 8_u8);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_bounds_get(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, esz: usize) {
    let l_oob = cg.buf.new_label(alloc);
    let l_done = cg.buf.new_label(alloc);
    cg.buf.br_cond_label(alloc, .Geu, rv64_asm.T2, rv64_asm.T3, l_oob);
    cg_scale_add(alloc, cg, rv64_asm.T1, rv64_asm.T1, rv64_asm.T2, esz);
    cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.T1);
    cg.buf.j_label(alloc, l_done);
    cg.buf.bind_label(l_oob);
    cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.ZERO);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_bounds_sub(alloc: *mut AllocCap, cg: *mut RvCg, env: *types.TypeEnv, dst: eir.EirValue, ret_ty: types.TyId, esz: usize) {
    // Expects ptr=T1, lo=T2, hi=T3, len=T4.
    let doff = cg_val_off(cg, dst);
    let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
    let l_oob = cg.buf.new_label(alloc);
    let l_done = cg.buf.new_label(alloc);
    cg.buf.br_cond_label(alloc, .Ltu, rv64_asm.T3, rv64_asm.T2, l_oob);
    cg.buf.br_cond_label(alloc, .Ltu, rv64_asm.T4, rv64_asm.T3, l_oob);
    cg.buf.sub(alloc, rv64_asm.T3, rv64_asm.T3, rv64_asm.T2);
    cg_scale_add(alloc, cg, rv64_asm.T1, rv64_asm.T1, rv64_asm.T2, esz);
    st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
    st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.T1, 8_u8);
    st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 8_i32, rv64_asm.T3, 8_u8);
    cg.buf.j_label(alloc, l_done);
    cg.buf.bind_label(l_oob);
    st_eu_err(alloc, cg, doff, 4_i32);
    st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.ZERO, 8_u8);
    st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 8_i32, rv64_asm.ZERO, 8_u8);
    cg.buf.bind_label(l_done);
    return;
}

fn cg_emit_builtin_arena(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId) -> bool {
    match op.kind {
        .ArenaInit => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.A0);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A1); }
            else { cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO); }
            cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.ZERO, 64_i32);
            cg_call_alloc_raw(alloc, cg, interner);
            cg_emit_eu_alloc_finish(alloc, cg, eir_prog, env, cg_val_off(cg, dst), env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32](), args, 0_u8);
            return true;
        }
        .ArenaAlloc => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.A0);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A1); }
            else { cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO); }
            cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.ZERO, 16_i32);
            cg_helper_call(alloc, cg, interner, "eon_arena_alloc_aligned");
            cg_emit_eu_alloc_finish(alloc, cg, eir_prog, env, cg_val_off(cg, dst), env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32](), args, 1_u8);
            return true;
        }
        .ArenaReset => { cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1); st(alloc, cg, rv64_asm.T1, 16_i32, rv64_asm.ZERO, 8_u8); return true; }
        .ArenaDestroy => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, rv64_asm.A0);
            ld(alloc, cg, rv64_asm.A1, rv64_asm.T1, 0_i32, 8_u8);
            ld(alloc, cg, rv64_asm.A2, rv64_asm.T1, 8_i32, 8_u8);
            cg_call_free_raw(alloc, cg, interner);
            return true;
        }
        .AllocCapSubBudget => {
            let doff = cg_val_off(cg, dst);
            cg_memzero(alloc, cg, rv64_asm.FP, doff, 40_usize);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A0); st(alloc, cg, rv64_asm.FP, doff +% 24_i32, rv64_asm.A0, 8_u8); }
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.A0);
            st(alloc, cg, rv64_asm.FP, doff +% 32_i32, rv64_asm.A0, 8_u8);
            return true;
        }
        _ => {}
    }
    var fld: i32 = -1_i32;
    if op.kind == .AllocCapLiveAllocs { fld = 0_i32; }
    else if op.kind == .ArenaCapacity || op.kind == .AllocCapUsedBytes { fld = 8_i32; }
    else if op.kind == .ArenaUsedBytes || op.kind == .AllocCapPeakBytes { fld = 16_i32; }
    if fld >= 0_i32 {
        cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
        ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, fld, 8_u8);
        cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
        return true;
    }
    return false;
}

fn cg_emit_builtin_arena_pool(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId) -> bool {
    match op.kind {
        .ArenaPoolInit => {
            let pdef = env.get(op.ty0).primary;
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            let ncols = pool_ncols_ty(env, op.ty0);
            cg_memzero(alloc, cg, rv64_asm.FP, doff, env.x64_layout(ret_ty).size);
            if args.len > 1_usize {
                cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A0);
                st(alloc, cg, rv64_asm.FP, doff +% ok_off +% ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), rv64_asm.A0, 8_u8);
            }
            let l_fail = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let er = env.x64_layout_impl(cols[ci].ty, false).size;
                    let esz = if er == 0_usize { 1_usize } else { er };
                    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.A0);
                    if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A1); }
                    else { cg.buf.addi(alloc, rv64_asm.A1, rv64_asm.ZERO, 1_i32); }
                    let l_nz = cg.buf.new_label(alloc);
                    cg.buf.br_short_label(alloc, .Ne, rv64_asm.A1, rv64_asm.ZERO, l_nz);
                    cg.buf.addi(alloc, rv64_asm.A1, rv64_asm.ZERO, 1_i32);
                    cg.buf.bind_label(l_nz);
                    if esz != 1_usize { cg.buf.li64(alloc, rv64_asm.T4, esz.widen.[u64]()); cg.buf.mul(alloc, rv64_asm.A1, rv64_asm.A1, rv64_asm.T4); }
                    cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.ZERO, 64_i32);
                    cg_helper_call(alloc, cg, interner, "eon_arena_alloc_aligned");
                    cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A0, rv64_asm.ZERO, l_fail);
                    st(alloc, cg, rv64_asm.FP, doff +% ok_off +% (ci *% 8_usize).trunc.[i32](), rv64_asm.A0, 8_u8);
                    ci = ci +% 1_usize;
                }
            }
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_fail);
            st_eu_err(alloc, cg, doff, 7_i32);
            cg.buf.bind_label(l_done);
            return true;
        }
        .ArenaPoolPush => {
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_ty(env, op.ty0);
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_U32).trunc.[i32]();
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.T2, rv64_asm.T1, (ncols *% 8_usize).trunc.[i32](), 8_u8);
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), 8_u8);
            let l_oom = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            cg.buf.br_cond_label(alloc, .Geu, rv64_asm.T2, rv64_asm.T3, l_oom);
            cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.T2, 1_i32);
            st(alloc, cg, rv64_asm.T1, (ncols *% 8_usize).trunc.[i32](), rv64_asm.A0, 8_u8);
            if args.len > 1_usize { cg_emit_pool_write_row(alloc, cg, eir_prog, env, pdef, args[1_usize], false); }
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
            st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.T2, 4_u8);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_oom);
            st_eu_err(alloc, cg, doff, 7_i32);
            cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, -1_i32);
            st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.A0, 4_u8);
            cg.buf.bind_label(l_done);
            return true;
        }
        .ArenaPoolIdAt => {
            let ncols = if args.len > 0_usize { pool_ncols_arg(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(types.TY_U32).trunc.[i32]();
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2); }
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, (ncols *% 8_usize).trunc.[i32](), 8_u8);
            let l_oob = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            cg.buf.br_cond_label(alloc, .Geu, rv64_asm.T2, rv64_asm.T3, l_oob);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
            st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.T2, 4_u8);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_oob);
            st_eu_err(alloc, cg, doff, 4_i32);
            cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, -1_i32);
            st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.A0, 4_u8);
            cg.buf.bind_label(l_done);
            return true;
        }
        .ArenaPoolReset => {
            let ncols = pool_ncols_ty(env, op.ty0);
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            st(alloc, cg, rv64_asm.T1, (ncols *% 8_usize).trunc.[i32](), rv64_asm.ZERO, 8_u8);
            if dst != eir.EIR_NONE { cg_load_val_from_mem(alloc, cg, env, dst, rv64_asm.T1, 0_i32, ret_ty); }
            return true;
        }
        .ArenaPoolLen => {
            let ncols = if args.len > 0_usize { pool_ncols_arg(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, (ncols *% 8_usize).trunc.[i32](), 8_u8);
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return true;
        }
        _ => {}
    }
    return false;
}

fn cg_slot_pool_validate_gid(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, ncols: usize, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], l_stale: u32) {
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
    if args.len > 1_usize {
        let loc = cg_val_loc(cg, args[1_usize]);
        if loc.kind == .Reg { cg.buf.extend_bits(alloc, rv64_asm.T2, loc.reg, 32_u8, false); cg.buf.srli(alloc, rv64_asm.T3, loc.reg, 32_u8); }
        else { ld(alloc, cg, rv64_asm.T2, rv64_asm.FP, loc.stack_off, 4_u8); ld(alloc, cg, rv64_asm.T3, rv64_asm.FP, loc.stack_off +% 4_i32, 4_u8); }
    }
    cg.buf.br_cond_label(alloc, .Eq, rv64_asm.T3, rv64_asm.ZERO, l_stale);
    cg.buf.andi(alloc, rv64_asm.A0, rv64_asm.T3, 1_i32);
    cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A0, rv64_asm.ZERO, l_stale);
    ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_u8);
    cg.buf.br_cond_label(alloc, .Geu, rv64_asm.T2, rv64_asm.A0, l_stale);
    ld(alloc, cg, rv64_asm.T4, rv64_asm.T1, (ncols *% 8_usize).trunc.[i32](), 8_u8);
    cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.T2, 2_u8);
    cg.buf.add(alloc, rv64_asm.T4, rv64_asm.T4, rv64_asm.A0);
    ld(alloc, cg, rv64_asm.A0, rv64_asm.T4, 0_i32, 4_u8);
    cg.buf.br_cond_label(alloc, .Ne, rv64_asm.A0, rv64_asm.T3, l_stale);
    return;
}

fn cg_emit_slot_pool_grow(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, pdef: u32, ncols: usize, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], l_oom: u32) {
    let tmp = cg.frame.temp_off;
    ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_u8);
    st(alloc, cg, rv64_asm.FP, tmp, rv64_asm.A0, 8_u8);
    cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.A0, 1_u8);
    let l_nz = cg.buf.new_label(alloc);
    cg.buf.br_short_label(alloc, .Ne, rv64_asm.A0, rv64_asm.ZERO, l_nz);
    cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, 4_i32);
    cg.buf.bind_label(l_nz);
    st(alloc, cg, rv64_asm.FP, tmp +% 8_i32, rv64_asm.A0, 8_u8);

    cg_emit_pool_realloc_buf(alloc, cg, eir_prog, env, interner, args, arg_slots, (ncols *% 8_usize).trunc.[i32](), 4_usize, 4_i32, l_oom);

    // Reallocate free_stack and populate newly added slots [old_cap..new_cap)
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, rv64_asm.A0);
    ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, tmp +% 8_i32, 8_u8);
    cg.buf.slli(alloc, rv64_asm.A1, rv64_asm.A1, 2_u8);
    cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.ZERO, 4_i32);
    cg_call_alloc_raw(alloc, cg, interner);
    cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A0, rv64_asm.ZERO, l_oom);
    st(alloc, cg, rv64_asm.FP, tmp +% 16_i32, rv64_asm.A0, 8_u8);
    ld(alloc, cg, rv64_asm.T2, rv64_asm.FP, tmp, 8_u8);
    ld(alloc, cg, rv64_asm.T3, rv64_asm.FP, tmp +% 8_i32, 8_u8);
    cg_emit_init_free_stack(alloc, cg);
    let fs_off = ((ncols +% 1_usize) *% 8_usize).trunc.[i32]();
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, rv64_asm.A0);
    ld(alloc, cg, rv64_asm.A1, rv64_asm.T1, fs_off, 8_u8);
    ld(alloc, cg, rv64_asm.A2, rv64_asm.FP, tmp, 8_u8);
    cg.buf.slli(alloc, rv64_asm.A2, rv64_asm.A2, 2_u8);
    cg_call_free_raw(alloc, cg, interner);
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
    ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, tmp +% 16_i32, 8_u8);
    st(alloc, cg, rv64_asm.T1, fs_off, rv64_asm.A0, 8_u8);

    if let pm = env.get_pool(pdef) {
        let cols = env.pool_cols_range(pm.columns);
        var ci: usize = 0_usize;
        while ci < cols.len {
            let er = env.x64_layout_impl(cols[ci].ty, true).size;
            cg_emit_pool_realloc_buf(alloc, cg, eir_prog, env, interner, args, arg_slots, (ci *% 8_usize).trunc.[i32](), if er == 0_usize { 1_usize } else { er }, 64_i32, l_oom);
            ci = ci +% 1_usize;
        }
    }
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
    ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, tmp +% 8_i32, 8_u8);
    st(alloc, cg, rv64_asm.T1, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), rv64_asm.A0, 8_u8);
    ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, tmp, 8_u8);
    cg.buf.sub(alloc, rv64_asm.T2, rv64_asm.A0, rv64_asm.A1);
    st(alloc, cg, rv64_asm.T1, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), rv64_asm.T2, 8_u8);
    return;
}

fn cg_emit_free_pool_field(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], field_off: i32) {
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, rv64_asm.A0);
    ld(alloc, cg, rv64_asm.A1, rv64_asm.T1, field_off, 8_u8);
    cg.buf.mv(alloc, rv64_asm.A2, rv64_asm.ZERO);
    cg_call_free_raw(alloc, cg, interner);
    return;
}

fn cg_emit_slot_pool_insert(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId, can_grow: bool) {
    let pdef = env.get(op.ty0).primary;
    let ncols = pool_ncols_ty(env, op.ty0);
    let doff = cg_val_off(cg, dst);
    let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
    let l_oom = cg.buf.new_label(alloc);
    let l_done = cg.buf.new_label(alloc);
    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
    ld(alloc, cg, rv64_asm.T2, rv64_asm.T1, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), 8_u8);
    if can_grow {
        let l_has = cg.buf.new_label(alloc);
        cg.buf.br_cond_label(alloc, .Ne, rv64_asm.T2, rv64_asm.ZERO, l_has);
        cg_emit_slot_pool_grow(alloc, cg, eir_prog, env, interner, pdef, ncols, args, arg_slots, l_oom);
        cg.buf.bind_label(l_has);
    } else {
        cg.buf.br_cond_label(alloc, .Eq, rv64_asm.T2, rv64_asm.ZERO, l_oom);
    }
    cg.buf.addi(alloc, rv64_asm.T2, rv64_asm.T2, -1_i32);
    st(alloc, cg, rv64_asm.T1, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), rv64_asm.T2, 8_u8);
    ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), 8_u8);
    cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.T2, 2_u8);
    cg.buf.add(alloc, rv64_asm.T3, rv64_asm.T3, rv64_asm.A0);
    ld(alloc, cg, rv64_asm.T2, rv64_asm.T3, 0_i32, 4_u8);
    ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, (ncols *% 8_usize).trunc.[i32](), 8_u8);
    cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.T2, 2_u8);
    cg.buf.add(alloc, rv64_asm.T3, rv64_asm.T3, rv64_asm.A0);
    ld(alloc, cg, rv64_asm.A0, rv64_asm.T3, 0_i32, 4_u8);
    cg.buf.addiw(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32);
    st(alloc, cg, rv64_asm.T3, 0_i32, rv64_asm.A0, 4_u8);
    st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.T2, 4_u8);
    st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 4_i32, rv64_asm.A0, 4_u8);
    st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
    ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, ((ncols +% 2_usize) *% 8_usize).trunc.[i32](), 8_u8);
    cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32);
    st(alloc, cg, rv64_asm.T1, ((ncols +% 2_usize) *% 8_usize).trunc.[i32](), rv64_asm.A0, 8_u8);
    let row_idx: usize = if can_grow { 2_usize } else { 1_usize };
    if args.len > row_idx { cg_emit_pool_write_row(alloc, cg, eir_prog, env, pdef, args[row_idx], true); }
    cg.buf.j_label(alloc, l_done);
    cg.buf.bind_label(l_oom);
    st_eu_err(alloc, cg, doff, 7_i32);
    st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.ZERO, 8_u8);
    cg.buf.bind_label(l_done);
}

fn cg_emit_builtin_slot_pool(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId) -> bool {
    match op.kind {
        .SlotPoolInit => {
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_ty(env, op.ty0);
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            let tmp = cg.frame.temp_off;
            cg_memzero(alloc, cg, rv64_asm.FP, doff, env.x64_layout(ret_ty).size);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A0); }
            else { cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, 4_i32); }
            let l_nz = cg.buf.new_label(alloc);
            cg.buf.br_short_label(alloc, .Ne, rv64_asm.A0, rv64_asm.ZERO, l_nz);
            cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, 4_i32);
            cg.buf.bind_label(l_nz);
            st(alloc, cg, rv64_asm.FP, tmp, rv64_asm.A0, 8_u8);
            st(alloc, cg, rv64_asm.FP, doff +% ok_off +% ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), rv64_asm.A0, 8_u8);
            st(alloc, cg, rv64_asm.FP, doff +% ok_off +% ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), rv64_asm.A0, 8_u8);
            let l_fail = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let er = env.x64_layout_impl(cols[ci].ty, true).size;
                    let esz = if er == 0_usize { 1_usize } else { er };
                    cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.A0);
                    ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, tmp, 8_u8);
                    if esz != 1_usize { cg.buf.li64(alloc, rv64_asm.T4, esz.widen.[u64]()); cg.buf.mul(alloc, rv64_asm.A1, rv64_asm.A1, rv64_asm.T4); }
                    cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.ZERO, 64_i32);
                    cg_call_alloc_raw(alloc, cg, interner);
                    cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A0, rv64_asm.ZERO, l_fail);
                    st(alloc, cg, rv64_asm.FP, doff +% ok_off +% (ci *% 8_usize).trunc.[i32](), rv64_asm.A0, 8_u8);
                    ci = ci +% 1_usize;
                }
            }
            var ki: usize = 0_usize;
            while ki < 2_usize {
                cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.A0);
                ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, tmp, 8_u8);
                cg.buf.slli(alloc, rv64_asm.A1, rv64_asm.A1, 2_u8);
                cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.ZERO, 4_i32);
                cg_call_alloc_raw(alloc, cg, interner);
                cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A0, rv64_asm.ZERO, l_fail);
                st(alloc, cg, rv64_asm.FP, doff +% ok_off +% ((ncols +% ki) *% 8_usize).trunc.[i32](), rv64_asm.A0, 8_u8);
                ki = ki +% 1_usize;
            }
            cg.buf.mv(alloc, rv64_asm.T2, rv64_asm.ZERO);
            ld(alloc, cg, rv64_asm.T3, rv64_asm.FP, tmp, 8_u8);
            cg_emit_init_free_stack(alloc, cg);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_fail);
            st_eu_err(alloc, cg, doff, 7_i32);
            cg.buf.bind_label(l_done);
            return true;
        }
        .SlotPoolInsert => { cg_emit_slot_pool_insert(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, true); return true; }
        .SlotPoolTryInsert => { cg_emit_slot_pool_insert(alloc, cg, eir_prog, env, interner, dst, op, args, arg_slots, ret_ty, false); return true; }
        .SlotPoolRemove => {
            let pdef = env.get(op.ty0).primary;
            let ncols = pool_ncols_ty(env, op.ty0);
            let doff = cg_val_off(cg, dst);
            let ok_ty = env.get(ret_ty).primary;
            let ok_off = env.eu_ok_offset(ok_ty).trunc.[i32]();
            let l_stale = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            cg_slot_pool_validate_gid(alloc, cg, eir_prog, env, ncols, args, arg_slots, l_stale);
            cg_memzero(alloc, cg, rv64_asm.FP, doff, env.x64_layout(ret_ty).size);
            if let pm = env.get_pool(pdef) {
                let cols = env.pool_cols_range(pm.columns);
                var ci: usize = 0_usize;
                while ci < cols.len {
                    let foff = env.struct_field_offset(ok_ty, ci).offset;
                    let er = env.x64_layout_impl(cols[ci].ty, true).size;
                    let esz = if er == 0_usize { 1_usize } else { er };
                    ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, (ci *% 8_usize).trunc.[i32](), 8_u8);
                    cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.T2);
                    cg_scale_add(alloc, cg, rv64_asm.T3, rv64_asm.T3, rv64_asm.A0, esz);
                    cg_copy_mem(alloc, cg, rv64_asm.FP, doff +% ok_off +% foff.trunc.[i32](), rv64_asm.T3, 0_i32, esz);
                    ci = ci +% 1_usize;
                }
            }
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T4, 0_i32, 4_u8);
            cg.buf.addiw(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32);
            st(alloc, cg, rv64_asm.T4, 0_i32, rv64_asm.A0, 4_u8);
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), 8_u8);
            ld(alloc, cg, rv64_asm.T4, rv64_asm.T1, ((ncols +% 1_usize) *% 8_usize).trunc.[i32](), 8_u8);
            cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.T3, 2_u8);
            cg.buf.add(alloc, rv64_asm.T4, rv64_asm.T4, rv64_asm.A0);
            st(alloc, cg, rv64_asm.T4, 0_i32, rv64_asm.T2, 4_u8);
            cg.buf.addi(alloc, rv64_asm.T3, rv64_asm.T3, 1_i32);
            st(alloc, cg, rv64_asm.T1, ((ncols +% 4_usize) *% 8_usize).trunc.[i32](), rv64_asm.T3, 8_u8);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, ((ncols +% 2_usize) *% 8_usize).trunc.[i32](), 8_u8);
            cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.A0, -1_i32);
            st(alloc, cg, rv64_asm.T1, ((ncols +% 2_usize) *% 8_usize).trunc.[i32](), rv64_asm.A0, 8_u8);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_stale);
            st_eu_err(alloc, cg, doff, 11_i32);
            cg.buf.bind_label(l_done);
            return true;
        }
        .SlotPoolGet => {
            let doff = cg_val_off(cg, dst);
            let l_stale = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            cg_slot_pool_validate_gid(alloc, cg, eir_prog, env, pool_ncols_ty(env, op.ty0), args, arg_slots, l_stale);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.T1, 8_u8);
            st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.T2, 4_u8);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_stale);
            cg_emit_opt_null(alloc, cg, eir_prog, env, dst, ret_ty);
            cg.buf.bind_label(l_done);
            return true;
        }
        .SlotPoolAt => {
            let doff = cg_val_off(cg, dst);
            let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
            let l_stale = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            cg_slot_pool_validate_gid(alloc, cg, eir_prog, env, pool_ncols_ty(env, op.ty0), args, arg_slots, l_stale);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
            st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.T1, 8_u8);
            st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 8_i32, rv64_asm.T2, 4_u8);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_stale);
            st_eu_err(alloc, cg, doff, 11_i32);
            st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.ZERO, 8_u8);
            st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 8_i32, rv64_asm.ZERO, 8_u8);
            cg.buf.bind_label(l_done);
            return true;
        }
        .SlotPoolLen => {
            let ncols = if args.len > 0_usize { pool_ncols_arg(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, ((ncols +% 2_usize) *% 8_usize).trunc.[i32](), 8_u8);
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return true;
        }
        .SlotPoolCap => {
            let ncols = if args.len > 0_usize { pool_ncols_arg(env, eir_prog.fn_val_ty(cg.fn_id, args[0_usize])) } else { 0_usize };
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_u8);
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return true;
        }
        .SlotPoolIsAlive => {
            let ncols = pool_ncols_ty(env, op.ty0);
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2); }
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, ((ncols +% 3_usize) *% 8_usize).trunc.[i32](), 8_u8);
            let l_false = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            cg.buf.br_cond_label(alloc, .Geu, rv64_asm.T2, rv64_asm.T3, l_false);
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, (ncols *% 8_usize).trunc.[i32](), 8_u8);
            cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.T2, 2_u8);
            cg.buf.add(alloc, rv64_asm.T3, rv64_asm.T3, rv64_asm.A0);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T3, 0_i32, 4_u8);
            cg.buf.andi(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_false);
            cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.ZERO);
            cg.buf.bind_label(l_done);
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return true;
        }
        .SlotPoolIdAt => {
            let ncols = pool_ncols_ty(env, op.ty0);
            let doff = cg_val_off(cg, dst);
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2); }
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, (ncols *% 8_usize).trunc.[i32](), 8_u8);
            cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.T2, 2_u8);
            cg.buf.add(alloc, rv64_asm.T3, rv64_asm.T3, rv64_asm.A0);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T3, 0_i32, 4_u8);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.T2, 4_u8);
            st(alloc, cg, rv64_asm.FP, doff +% 4_i32, rv64_asm.A0, 4_u8);
            return true;
        }
        .SlotPoolDestroy => {
            let ncols = pool_ncols_ty(env, op.ty0);
            var ci: usize = 0_usize;
            while ci < ncols +% 2_usize {
                cg_emit_free_pool_field(alloc, cg, eir_prog, env, interner, args, arg_slots, (ci *% 8_usize).trunc.[i32]());
                ci = ci +% 1_usize;
            }
            return true;
        }
        _ => {}
    }
    return false;
}

fn cg_emit_builtin_buf_slice(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot], ret_ty: types.TyId) -> bool {
    let elay = env.x64_layout(op.ty0);
    let esz = if elay.size == 0_usize { 1_usize } else { elay.size };
    match op.kind {
        .BufInit => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.A0);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A1); }
            else { cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO); }
            if esz != 1_usize { cg.buf.li64(alloc, rv64_asm.T4, esz.widen.[u64]()); cg.buf.mul(alloc, rv64_asm.A1, rv64_asm.A1, rv64_asm.T4); }
            cg.buf.li64(alloc, rv64_asm.A2, (if elay.align == 0_usize { 1_usize } else { elay.align }).widen.[u64]());
            cg_call_alloc_raw(alloc, cg, interner);
            cg_emit_eu_alloc_finish(alloc, cg, eir_prog, env, cg_val_off(cg, dst), env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32](), args, 2_u8);
            return true;
        }
        .BufPush => {
            let doff = cg_val_off(cg, dst);
            let va = if args.len >= 3_usize { args[2_usize] } else if args.len > 1_usize { args[1_usize] } else { 0_u32 };
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.T2, rv64_asm.T1, 8_i32, 8_u8);
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, 16_i32, 8_u8);
            let l_full = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            cg.buf.br_cond_label(alloc, .Geu, rv64_asm.T2, rv64_asm.T3, l_full);
            cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.T2, 1_i32);
            st(alloc, cg, rv64_asm.T1, 8_i32, rv64_asm.A0, 8_u8);
            ld(alloc, cg, rv64_asm.T1, rv64_asm.T1, 0_i32, 8_u8);
            cg_scale_add(alloc, cg, rv64_asm.T1, rv64_asm.T1, rv64_asm.T2, esz);
            cg_store_val_to_mem(alloc, cg, env, rv64_asm.T1, 0_i32, va, op.ty0);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_full);
            st_eu_err(alloc, cg, doff, 7_i32);
            cg.buf.bind_label(l_done);
            return true;
        }
        .BufPushSlice => {
            let doff = cg_val_off(cg, dst);
            let soff = cg_val_off(cg, if args.len >= 3_usize { args[2_usize] } else if args.len > 1_usize { args[1_usize] } else { 0_u32 });
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.T2, rv64_asm.T1, 8_i32, 8_u8);
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, 16_i32, 8_u8);
            ld(alloc, cg, rv64_asm.T4, rv64_asm.FP, soff +% 8_i32, 8_u8);
            cg.buf.sub(alloc, rv64_asm.A0, rv64_asm.T3, rv64_asm.T2);
            let l_full = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            cg.buf.br_cond_label(alloc, .Ltu, rv64_asm.A0, rv64_asm.T4, l_full);
            cg.buf.add(alloc, rv64_asm.A0, rv64_asm.T2, rv64_asm.T4);
            st(alloc, cg, rv64_asm.T1, 8_i32, rv64_asm.A0, 8_u8);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, 8_u8);
            if esz != 1_usize { cg.buf.li64(alloc, rv64_asm.A2, esz.widen.[u64]()); cg.buf.mul(alloc, rv64_asm.T2, rv64_asm.T2, rv64_asm.A2); cg.buf.mul(alloc, rv64_asm.T4, rv64_asm.T4, rv64_asm.A2); }
            cg.buf.add(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.T2);
            ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, soff, 8_u8);
            cg_copy_mem_dyn(alloc, cg, rv64_asm.A0, rv64_asm.A1, rv64_asm.T4);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_full);
            st_eu_err(alloc, cg, doff, 7_i32);
            cg.buf.bind_label(l_done);
            return true;
        }
        .BufPop => {
            let doff = cg_val_off(cg, dst);
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.T2, rv64_asm.T1, 8_i32, 8_u8);
            let l_empty = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            cg.buf.br_cond_label(alloc, .Eq, rv64_asm.T2, rv64_asm.ZERO, l_empty);
            cg.buf.addi(alloc, rv64_asm.T2, rv64_asm.T2, -1_i32);
            st(alloc, cg, rv64_asm.T1, 8_i32, rv64_asm.T2, 8_u8);
            ld(alloc, cg, rv64_asm.T1, rv64_asm.T1, 0_i32, 8_u8);
            cg_scale_add(alloc, cg, rv64_asm.T1, rv64_asm.T1, rv64_asm.T2, esz);
            if env.opt_niche(op.ty0).kind != .None { cg_load_val_from_mem(alloc, cg, env, dst, rv64_asm.T1, 0_i32, op.ty0); }
            else {
                cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, 1_i32);
                st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 1_u8);
                cg_copy_mem(alloc, cg, rv64_asm.FP, doff +% env.opt_val_offset(op.ty0).trunc.[i32](), rv64_asm.T1, 0_i32, esz);
            }
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_empty);
            cg_emit_opt_null(alloc, cg, eir_prog, env, dst, ret_ty);
            cg.buf.bind_label(l_done);
            return true;
        }
        .BufClear => { cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1); st(alloc, cg, rv64_asm.T1, 8_i32, rv64_asm.ZERO, 8_u8); return true; }
        .BufAsSlice => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            let doff = cg_val_off(cg, dst);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, 8_u8);
            ld(alloc, cg, rv64_asm.A1, rv64_asm.T1, 8_i32, 8_u8);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 8_u8);
            st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.A1, 8_u8);
            return true;
        }
        .BufDestroy => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 1_usize, rv64_asm.A0);
            ld(alloc, cg, rv64_asm.A1, rv64_asm.T1, 0_i32, 8_u8);
            ld(alloc, cg, rv64_asm.A2, rv64_asm.T1, 16_i32, 8_u8);
            cg_call_free_raw(alloc, cg, interner);
            return true;
        }
        .BufLen => { cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1); ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 8_i32, 8_u8); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); return true; }
        .BufCap => { cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1); ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 16_i32, 8_u8); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); return true; }
        .BufAt => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2); }
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, 8_i32, 8_u8);
            ld(alloc, cg, rv64_asm.T1, rv64_asm.T1, 0_i32, 8_u8);
            cg_emit_bounds_at(alloc, cg, env, dst, esz);
            return true;
        }
        .BufGet => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2); }
            ld(alloc, cg, rv64_asm.T3, rv64_asm.T1, 8_i32, 8_u8);
            ld(alloc, cg, rv64_asm.T1, rv64_asm.T1, 0_i32, 8_u8);
            cg_emit_bounds_get(alloc, cg, eir_prog, env, dst, esz);
            return true;
        }
        .BufSub => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.T4, rv64_asm.T1, 8_i32, 8_u8);
            ld(alloc, cg, rv64_asm.T1, rv64_asm.T1, 0_i32, 8_u8);
            if args.len > 1_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2); }
            if args.len > 2_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], rv64_asm.T3); }
            cg_emit_bounds_sub(alloc, cg, env, dst, ret_ty, esz);
            return true;
        }
        .SliceLen => { if args.len > 0_usize { ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, cg_val_off(cg, args[0_usize]) +% 8_i32, 8_u8); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); } return true; }
        .StrLen => { if args.len > 0_usize { ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, cg_val_off(cg, args[0_usize]) +% 8_i32, 8_u8); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); } return true; }
        .ArrayLen => { cg.buf.li64(alloc, rv64_asm.A0, if args.len > 0_usize { array_len_arg(eir_prog, cg.fn_id, env, args[0_usize]) } else { 0_u64 }); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); return true; }
        .StrAsBytes => { if args.len > 0_usize { cg_copy_val_to_val(alloc, cg, eir_prog, env, dst, args[0_usize]); } return true; }
        .BytesAsStr => {
            if args.len > 0_usize {
                let doff = cg_val_off(cg, dst);
                let ok_off = env.eu_ok_offset(env.get(ret_ty).primary).trunc.[i32]();
                let soff = cg_val_off(cg, args[0_usize]);
                ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, soff, 8_u8);
                ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, soff +% 8_i32, 8_u8);
                cg_helper_call(alloc, cg, interner, "eon_rt_validate_utf8");
                let l_err = cg.buf.new_label(alloc);
                let l_done = cg.buf.new_label(alloc);
                cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A0, rv64_asm.ZERO, l_err);
                st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
                ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, soff, 8_u8);
                ld(alloc, cg, rv64_asm.T2, rv64_asm.FP, soff +% 8_i32, 8_u8);
                st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.T1, 8_u8);
                st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 8_i32, rv64_asm.T2, 8_u8);
                cg.buf.j_label(alloc, l_done);
                cg.buf.bind_label(l_err);
                st_eu_err(alloc, cg, doff, 5_i32);
                st(alloc, cg, rv64_asm.FP, doff +% ok_off, rv64_asm.ZERO, 8_u8);
                st(alloc, cg, rv64_asm.FP, doff +% ok_off +% 8_i32, rv64_asm.ZERO, 8_u8);
                cg.buf.bind_label(l_done);
            }
            return true;
        }
        .SliceAt => {
            if args.len > 1_usize {
                let soff = cg_val_off(cg, args[0_usize]);
                ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, soff, 8_u8);
                ld(alloc, cg, rv64_asm.T3, rv64_asm.FP, soff +% 8_i32, 8_u8);
                cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2);
                cg_emit_bounds_at(alloc, cg, env, dst, esz);
            }
            return true;
        }
        .ArrayAt => {
            if args.len > 1_usize {
                cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
                cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2);
                cg.buf.li64(alloc, rv64_asm.T3, array_len_arg(eir_prog, cg.fn_id, env, args[0_usize]));
                cg_emit_bounds_at(alloc, cg, env, dst, esz);
            }
            return true;
        }
        .SliceGet => {
            if args.len > 1_usize {
                let soff = cg_val_off(cg, args[0_usize]);
                ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, soff, 8_u8);
                ld(alloc, cg, rv64_asm.T3, rv64_asm.FP, soff +% 8_i32, 8_u8);
                cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2);
                cg_emit_bounds_get(alloc, cg, eir_prog, env, dst, esz);
            }
            return true;
        }
        .ArrayGet => {
            if args.len > 1_usize {
                cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
                cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2);
                cg.buf.li64(alloc, rv64_asm.T3, array_len_arg(eir_prog, cg.fn_id, env, args[0_usize]));
                cg_emit_bounds_get(alloc, cg, eir_prog, env, dst, esz);
            }
            return true;
        }
        .SliceSub => {
            if args.len > 2_usize {
                let soff = cg_val_off(cg, args[0_usize]);
                ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, soff, 8_u8);
                ld(alloc, cg, rv64_asm.T4, rv64_asm.FP, soff +% 8_i32, 8_u8);
                cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2);
                cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], rv64_asm.T3);
                cg_emit_bounds_sub(alloc, cg, env, dst, ret_ty, esz);
            }
            return true;
        }
        .ArraySub => {
            if args.len > 2_usize {
                cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
                cg.buf.li64(alloc, rv64_asm.T4, array_len_arg(eir_prog, cg.fn_id, env, args[0_usize]));
                cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T2);
                cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], rv64_asm.T3);
                cg_emit_bounds_sub(alloc, cg, env, dst, ret_ty, esz);
            }
            return true;
        }
        _ => {}
    }
    return false;
}

fn cg_emit_atomic_subword_rmw(alloc: *mut AllocCap, cg: *mut RvCg, sz: u8, mode: u8) {
    cg.buf.andi(alloc, rv64_asm.T2, rv64_asm.T1, -4_i32);
    cg.buf.andi(alloc, rv64_asm.T3, rv64_asm.T1, 3_i32);
    cg.buf.slli(alloc, rv64_asm.T3, rv64_asm.T3, 3_u8);
    cg.buf.li64(alloc, rv64_asm.T4, if sz == 1_u8 { 0xFF_u64 } else { 0xFFFF_u64 });
    cg.buf.sll(alloc, rv64_asm.T5, rv64_asm.T4, rv64_asm.T3);
    cg.buf.xori(alloc, rv64_asm.T6, rv64_asm.T5, -1_i32);
    let l_r = cg.buf.new_label(alloc);
    cg.buf.bind_label(l_r);
    cg.buf.lr(alloc, false, true, true, rv64_asm.A2, rv64_asm.T2);
    cg.buf.srl(alloc, rv64_asm.A0, rv64_asm.A2, rv64_asm.T3);
    cg.buf.and_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.T4);
    if mode == 0_u8 { cg.buf.add(alloc, rv64_asm.A3, rv64_asm.A0, rv64_asm.A1); }
    else if mode == 1_u8 { cg.buf.sub(alloc, rv64_asm.A3, rv64_asm.A0, rv64_asm.A1); }
    else { cg.buf.mv(alloc, rv64_asm.A3, rv64_asm.A1); }
    cg.buf.and_r(alloc, rv64_asm.A3, rv64_asm.A3, rv64_asm.T4);
    cg.buf.sll(alloc, rv64_asm.A3, rv64_asm.A3, rv64_asm.T3);
    cg.buf.and_r(alloc, rv64_asm.A2, rv64_asm.A2, rv64_asm.T6);
    cg.buf.or_r(alloc, rv64_asm.A2, rv64_asm.A2, rv64_asm.A3);
    cg.buf.sc(alloc, false, true, true, rv64_asm.A3, rv64_asm.A2, rv64_asm.T2);
    cg.buf.br_short_label(alloc, .Ne, rv64_asm.A3, rv64_asm.ZERO, l_r);
    return;
}

fn cg_emit_builtin_atomic_mmio(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot]) -> bool {
    let rsz = env.x64_layout(op.ty0).size;
    let sz: u8 = if rsz <= 1_usize { 1_u8 } else if rsz <= 2_usize { 2_u8 } else if rsz <= 4_usize { 4_u8 } else { 8_u8 };
    let is64 = sz == 8_u8;
    match op.kind {
        .AtomicNew => { if args.len > 0_usize { cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], rv64_asm.A0); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); } return true; }
        .RawPtrFromUsize => { if args.len > 0_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[0_usize], rv64_asm.A0); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); } return true; }
        .RawPtrAsUsize => { if args.len > 0_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[0_usize], rv64_asm.A0); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); } return true; }
        .AtomicLoad => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            cg.buf.fence_rw_rw(alloc);
            lds(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, sz, env.is_signed_int(op.ty0));
            cg.buf.fence_rw_rw(alloc);
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return true;
        }
        .AtomicStore => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A0); }
            cg.buf.fence_rw_rw(alloc);
            st(alloc, cg, rv64_asm.T1, 0_i32, rv64_asm.A0, sz);
            cg.buf.fence_rw_rw(alloc);
            return true;
        }
        .AtomicFetchAdd => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A1); }
            if sz >= 4_u8 { cg.buf.amo(alloc, 0x00_u32, is64, true, true, rv64_asm.A0, rv64_asm.A1, rv64_asm.T1); }
            else { cg_emit_atomic_subword_rmw(alloc, cg, sz, 0_u8); }
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return true;
        }
        .AtomicFetchSub => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A1); }
            if sz >= 4_u8 { cg.buf.sub(alloc, rv64_asm.A1, rv64_asm.ZERO, rv64_asm.A1); cg.buf.amo(alloc, 0x00_u32, is64, true, true, rv64_asm.A0, rv64_asm.A1, rv64_asm.T1); }
            else { cg_emit_atomic_subword_rmw(alloc, cg, sz, 1_u8); }
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return true;
        }
        .AtomicSwap => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A1); }
            if sz >= 4_u8 { cg.buf.amo(alloc, 0x01_u32, is64, true, true, rv64_asm.A0, rv64_asm.A1, rv64_asm.T1); }
            else { cg_emit_atomic_subword_rmw(alloc, cg, sz, 2_u8); }
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return true;
        }
        .AtomicCas => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A1); }
            if args.len > 2_usize { cg_load_scalar_raw(alloc, cg, eir_prog, env, args[2_usize], rv64_asm.A2); }
            let l_r = cg.buf.new_label(alloc);
            let l_fail = cg.buf.new_label(alloc);
            let l_done = cg.buf.new_label(alloc);
            if sz >= 4_u8 {
                if !is64 { cg.buf.addiw(alloc, rv64_asm.A1, rv64_asm.A1, 0_i32); }
                cg.buf.bind_label(l_r);
                cg.buf.lr(alloc, is64, true, true, rv64_asm.A0, rv64_asm.T1);
                cg.buf.br_short_label(alloc, .Ne, rv64_asm.A0, rv64_asm.A1, l_fail);
                cg.buf.sc(alloc, is64, true, true, rv64_asm.A3, rv64_asm.A2, rv64_asm.T1);
                cg.buf.br_short_label(alloc, .Ne, rv64_asm.A3, rv64_asm.ZERO, l_r);
            } else {
                cg.buf.andi(alloc, rv64_asm.T2, rv64_asm.T1, -4_i32);
                cg.buf.andi(alloc, rv64_asm.T3, rv64_asm.T1, 3_i32);
                cg.buf.slli(alloc, rv64_asm.T3, rv64_asm.T3, 3_u8);
                cg.buf.li64(alloc, rv64_asm.T4, if sz == 1_u8 { 0xFF_u64 } else { 0xFFFF_u64 });
                cg.buf.sll(alloc, rv64_asm.T5, rv64_asm.T4, rv64_asm.T3);
                cg.buf.xori(alloc, rv64_asm.T6, rv64_asm.T5, -1_i32);
                cg.buf.and_r(alloc, rv64_asm.A1, rv64_asm.A1, rv64_asm.T4);
                cg.buf.and_r(alloc, rv64_asm.A2, rv64_asm.A2, rv64_asm.T4);
                cg.buf.sll(alloc, rv64_asm.A2, rv64_asm.A2, rv64_asm.T3);
                cg.buf.bind_label(l_r);
                cg.buf.lr(alloc, false, true, true, rv64_asm.A3, rv64_asm.T2);
                cg.buf.srl(alloc, rv64_asm.A0, rv64_asm.A3, rv64_asm.T3);
                cg.buf.and_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.T4);
                cg.buf.br_short_label(alloc, .Ne, rv64_asm.A0, rv64_asm.A1, l_fail);
                cg.buf.and_r(alloc, rv64_asm.A3, rv64_asm.A3, rv64_asm.T6);
                cg.buf.or_r(alloc, rv64_asm.A3, rv64_asm.A3, rv64_asm.A2);
                cg.buf.sc(alloc, false, true, true, rv64_asm.A4, rv64_asm.A3, rv64_asm.T2);
                cg.buf.br_short_label(alloc, .Ne, rv64_asm.A4, rv64_asm.ZERO, l_r);
            }
            cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, 1_i32);
            cg.buf.j_label(alloc, l_done);
            cg.buf.bind_label(l_fail);
            cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.ZERO);
            cg.buf.bind_label(l_done);
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return true;
        }
        .MmioRead => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            lds(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, sz, env.is_signed_int(op.ty0));
            cg.buf.fence_rw_rw(alloc);
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            return true;
        }
        .MmioWrite => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            if args.len > 1_usize { cg_load_scalar_raw(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.A0); }
            cg.buf.fence_rw_rw(alloc);
            st(alloc, cg, rv64_asm.T1, 0_i32, rv64_asm.A0, sz);
            return true;
        }
        _ => {}
    }
    return false;
}

fn cg_emit_builtin_math(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue]) -> bool {
    if op.kind != .MathSqrt && op.kind != .MathFma && op.kind != .MathLzcnt && op.kind != .MathTzcnt && op.kind != .MathPopcnt && op.kind != .MathBswap { return false; }
    if args.len == 0_usize { return true; }
    let aty = eir_prog.fn_val_ty(cg.fn_id, args[0_usize]);
    let an = env.get(aty);
    let is_f64 = an.kind == .Float && an.u8_val == 64_u8;
    let rb = env.x64_layout(aty).size.trunc.[u8]();
    let bytes: u8 = if rb == 0_u8 { 1_u8 } else { rb };
    let nbits: u8 = bytes *% 8_u8;
    if op.kind == .MathSqrt {
        cg_load_float_val(alloc, cg, eir_prog, env, interner, args[0_usize], rv64_asm.FA0);
        cg.buf.fsqrt(alloc, is_f64, rv64_asm.FA0, rv64_asm.FA0);
        cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, rv64_asm.FA0);
    } else if op.kind == .MathFma && args.len >= 3_usize {
        cg_load_float_val(alloc, cg, eir_prog, env, interner, args[0_usize], rv64_asm.FA0);
        cg_load_float_val(alloc, cg, eir_prog, env, interner, args[1_usize], rv64_asm.FA1);
        cg_load_float_val(alloc, cg, eir_prog, env, interner, args[2_usize], rv64_asm.FA2);
        cg.buf.fmadd(alloc, is_f64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1, rv64_asm.FA2);
        cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, rv64_asm.FA0);
    } else if op.kind == .MathLzcnt || op.kind == .MathTzcnt {
        cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], rv64_asm.A0);
        if op.kind == .MathLzcnt && nbits < 64_u8 { cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.A0, 64_u8 -% nbits); }
        else if op.kind == .MathTzcnt && nbits < 64_u8 { cg.buf.extend_bits(alloc, rv64_asm.A0, rv64_asm.A0, nbits, false); }
        cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO);
        cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.ZERO, nbits.widen.[i32]());
        let l_lp = cg.buf.new_label(alloc);
        let l_dn = cg.buf.new_label(alloc);
        cg.buf.bind_label(l_lp);
        cg.buf.br_short_label(alloc, .Eq, rv64_asm.A1, rv64_asm.A2, l_dn);
        if op.kind == .MathLzcnt {
            cg.buf.br_short_label(alloc, .Lt, rv64_asm.A0, rv64_asm.ZERO, l_dn);
            cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.A0, 1_u8);
        } else {
            cg.buf.andi(alloc, rv64_asm.A3, rv64_asm.A0, 1_i32);
            cg.buf.br_short_label(alloc, .Ne, rv64_asm.A3, rv64_asm.ZERO, l_dn);
            cg.buf.srli(alloc, rv64_asm.A0, rv64_asm.A0, 1_u8);
        }
        cg.buf.addi(alloc, rv64_asm.A1, rv64_asm.A1, 1_i32);
        cg.buf.j_label(alloc, l_lp);
        cg.buf.bind_label(l_dn);
        cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A1);
    } else if op.kind == .MathPopcnt {
        cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], rv64_asm.A0);
        if nbits < 64_u8 { cg.buf.extend_bits(alloc, rv64_asm.A0, rv64_asm.A0, nbits, false); }
        cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO);
        let l_lp = cg.buf.new_label(alloc);
        let l_dn = cg.buf.new_label(alloc);
        cg.buf.bind_label(l_lp);
        cg.buf.br_short_label(alloc, .Eq, rv64_asm.A0, rv64_asm.ZERO, l_dn);
        cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.A0, -1_i32);
        cg.buf.and_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A2);
        cg.buf.addi(alloc, rv64_asm.A1, rv64_asm.A1, 1_i32);
        cg.buf.j_label(alloc, l_lp);
        cg.buf.bind_label(l_dn);
        cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A1);
    } else if op.kind == .MathBswap {
        cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], rv64_asm.A0);
        if bytes > 1_u8 {
            cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO);
            cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.ZERO, bytes.widen.[i32]());
            let l_lp = cg.buf.new_label(alloc);
            cg.buf.bind_label(l_lp);
            cg.buf.slli(alloc, rv64_asm.A1, rv64_asm.A1, 8_u8);
            cg.buf.andi(alloc, rv64_asm.A3, rv64_asm.A0, 0xFF_i32);
            cg.buf.or_r(alloc, rv64_asm.A1, rv64_asm.A1, rv64_asm.A3);
            cg.buf.srli(alloc, rv64_asm.A0, rv64_asm.A0, 8_u8);
            cg.buf.addi(alloc, rv64_asm.A2, rv64_asm.A2, -1_i32);
            cg.buf.br_short_label(alloc, .Ne, rv64_asm.A2, rv64_asm.ZERO, l_lp);
            cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.A1);
        }
        cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
    }
    return true;
}

fn cg_emit_int_minmax_a0_a1(alloc: *mut AllocCap, cg: *mut RvCg, is_min: bool, signed: bool) {
    let l_keep = cg.buf.new_label(alloc);
    let cc: rv64_asm.RvBrCond = if signed { .Ge } else { .Geu };
    if is_min { cg.buf.br_short_label(alloc, cc, rv64_asm.A1, rv64_asm.A0, l_keep); }
    else { cg.buf.br_short_label(alloc, cc, rv64_asm.A0, rv64_asm.A1, l_keep); }
    cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.A1);
    cg.buf.bind_label(l_keep);
    return;
}

fn cg_emit_vec_mmf(alloc: *mut AllocCap, cg: *mut RvCg, env: *types.TypeEnv, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue]) {
    if args.len < 2_usize { return; }
    let vn = env.get(op.ty0);
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem);
    let esz = if env.x64_layout(elem).size == 0_usize { 1_usize } else { env.x64_layout(elem).size };
    let sgn = env.is_signed_int(elem);
    let aoff = cg_val_off(cg, args[0_usize]);
    let boff = cg_val_off(cg, args[1_usize]);
    let coff: i32 = if op.kind == .VecFma && args.len > 2_usize { cg_val_off(cg, args[2_usize]) } else { 0_i32 };
    let doff = cg_val_off(cg, dst);
    var li: usize = 0_usize;
    while li < lanes {
        let d = (li *% esz).trunc.[i32]();
        if en.kind == .Float {
            let is64 = en.u8_val == 64_u8;
            ldf(alloc, cg, is64, rv64_asm.FA0, rv64_asm.FP, aoff +% d);
            ldf(alloc, cg, is64, rv64_asm.FA1, rv64_asm.FP, boff +% d);
            if op.kind == .VecFma { ldf(alloc, cg, is64, rv64_asm.FA2, rv64_asm.FP, coff +% d); cg.buf.fmadd(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1, rv64_asm.FA2); }
            else if op.kind == .VecMin { cg.buf.fmin(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
            else { cg.buf.fmax(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
            stf(alloc, cg, is64, rv64_asm.FP, doff +% d, rv64_asm.FA0);
        } else {
            let b = esz.trunc.[u8]();
            lds(alloc, cg, rv64_asm.A0, rv64_asm.FP, aoff +% d, b, sgn);
            lds(alloc, cg, rv64_asm.A1, rv64_asm.FP, boff +% d, b, sgn);
            cg_emit_int_minmax_a0_a1(alloc, cg, op.kind == .VecMin, sgn);
            st(alloc, cg, rv64_asm.FP, doff +% d, rv64_asm.A0, b);
        }
        li = li +% 1_usize;
    }
    return;
}

fn cg_emit_vec_reduce(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue]) {
    if args.len == 0_usize { return; }
    let vn = env.get(op.ty0);
    if vn.kind != .Vec { return; }
    let elem = vn.primary;
    let lanes = vn.u8_val.widen.[usize]();
    let en = env.get(elem);
    let esz = if env.x64_layout(elem).size == 0_usize { 1_usize } else { env.x64_layout(elem).size };
    let sgn = env.is_signed_int(elem);
    let aoff = cg_val_off(cg, args[0_usize]);
    let is_dot = op.kind == .VecDot;
    let boff: i32 = if is_dot && args.len > 1_usize { cg_val_off(cg, args[1_usize]) } else { 0_i32 };
    var li: usize = 0_usize;
    if en.kind == .Float {
        let is64 = en.u8_val == 64_u8;
        while li < lanes {
            let d = (li *% esz).trunc.[i32]();
            ldf(alloc, cg, is64, rv64_asm.FA1, rv64_asm.FP, aoff +% d);
            if is_dot { ldf(alloc, cg, is64, rv64_asm.FA2, rv64_asm.FP, boff +% d); cg.buf.fmul(alloc, is64, rv64_asm.FA1, rv64_asm.FA1, rv64_asm.FA2); }
            if li == 0_usize { cg.buf.fmv(alloc, is64, rv64_asm.FA0, rv64_asm.FA1); }
            else if op.kind == .VecReduceMin { cg.buf.fmin(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
            else if op.kind == .VecReduceMax { cg.buf.fmax(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
            else { cg.buf.fadd(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
            li = li +% 1_usize;
        }
        cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, rv64_asm.FA0);
        return;
    }
    while li < lanes {
        let d = (li *% esz).trunc.[i32]();
        lds(alloc, cg, rv64_asm.A1, rv64_asm.FP, aoff +% d, esz.trunc.[u8](), sgn);
        if is_dot { lds(alloc, cg, rv64_asm.A2, rv64_asm.FP, boff +% d, esz.trunc.[u8](), sgn); cg.buf.mul(alloc, rv64_asm.A1, rv64_asm.A1, rv64_asm.A2); }
        if li == 0_usize { cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.A1); }
        else if op.kind == .VecReduceMin { cg_emit_int_minmax_a0_a1(alloc, cg, true, sgn); }
        else if op.kind == .VecReduceMax { cg_emit_int_minmax_a0_a1(alloc, cg, false, sgn); }
        else { cg.buf.add(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
        li = li +% 1_usize;
    }
    cg_norm_subword(alloc, cg, env, elem, rv64_asm.A0);
    cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
    return;
}

fn cg_emit_builtin_vec(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue]) -> bool {
    match op.kind {
        .VecSplat => {
            if args.len == 0_usize { return true; }
            let vn = env.get(op.ty0);
            let elem = vn.primary;
            let lanes = vn.u8_val.widen.[usize]();
            let esz = if env.x64_layout(elem).size == 0_usize { 1_usize } else { env.x64_layout(elem).size };
            let doff = cg_val_off(cg, dst);
            let en = env.get(elem);
            var li: usize = 0_usize;
            if en.kind == .Float && en.u8_val != 16_u8 {
                cg_load_float_val(alloc, cg, eir_prog, env, interner, args[0_usize], rv64_asm.FA0);
                while li < lanes { stf(alloc, cg, en.u8_val == 64_u8, rv64_asm.FP, doff +% (li *% esz).trunc.[i32](), rv64_asm.FA0); li = li +% 1_usize; }
            } else {
                cg_load_scalar_raw(alloc, cg, eir_prog, env, args[0_usize], rv64_asm.A0);
                while li < lanes { st(alloc, cg, rv64_asm.FP, doff +% (li *% esz).trunc.[i32](), rv64_asm.A0, esz.trunc.[u8]()); li = li +% 1_usize; }
            }
            return true;
        }
        .VecLen => { cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, op.len_u8.widen.[i32]()); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); return true; }
        .VecCmp => {
            if args.len < 2_usize { return true; }
            let vn = env.get(op.ty0);
            if vn.kind != .Vec { return true; }
            let elem = vn.primary;
            let lanes = vn.u8_val.widen.[usize]();
            let esz = if env.x64_layout(elem).size == 0_usize { 1_usize } else { env.x64_layout(elem).size };
            let en = env.get(elem);
            let sgn = env.is_signed_int(elem);
            let aoff = cg_val_off(cg, args[0_usize]);
            let boff = cg_val_off(cg, args[1_usize]);
            let doff = cg_val_off(cg, dst);
            var li: usize = 0_usize;
            while li < lanes {
                let d = (li *% esz).trunc.[i32]();
                if en.kind == .Float {
                    let is_f16 = en.u8_val == 16_u8;
                    let is_f64 = en.u8_val == 64_u8;
                    if is_f16 {
                        ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, boff +% d, 2_u8);
                        cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
                        stf(alloc, cg, false, rv64_asm.FP, cg.frame.temp_off, rv64_asm.FA0);
                        ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, aoff +% d, 2_u8);
                        cg_helper_call(alloc, cg, interner, "eon_f16_to_f32");
                        ldf(alloc, cg, false, rv64_asm.FA1, rv64_asm.FP, cg.frame.temp_off);
                    } else {
                        ldf(alloc, cg, is_f64, rv64_asm.FA0, rv64_asm.FP, aoff +% d);
                        ldf(alloc, cg, is_f64, rv64_asm.FA1, rv64_asm.FP, boff +% d);
                    }
                    cg_emit_fp_cmp_to_a0(alloc, cg, !is_f16 && is_f64, op.bin_op, rv64_asm.FA0, rv64_asm.FA1);
                } else {
                    lds(alloc, cg, rv64_asm.A0, rv64_asm.FP, aoff +% d, esz.trunc.[u8](), sgn);
                    lds(alloc, cg, rv64_asm.A1, rv64_asm.FP, boff +% d, esz.trunc.[u8](), sgn);
                    cg_emit_int_cmp_to_a0(alloc, cg, op.bin_op, sgn, rv64_asm.A0, rv64_asm.A1);
                }
                st(alloc, cg, rv64_asm.FP, doff +% li.trunc.[i32](), rv64_asm.A0, 1_u8);
                li = li +% 1_usize;
            }
            return true;
        }
        .VecMaskAny => {
            if args.len > 0_usize {
                let aoff = cg_val_off(cg, args[0_usize]);
                cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.ZERO);
                var li: usize = 0_usize;
                while li < op.len_u8.widen.[usize]() { ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, aoff +% li.trunc.[i32](), 1_u8); cg.buf.or_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); li = li +% 1_usize; }
                cg.buf.sltu(alloc, rv64_asm.A0, rv64_asm.ZERO, rv64_asm.A0);
                cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            }
            return true;
        }
        .VecMaskAll => {
            if args.len > 0_usize {
                let aoff = cg_val_off(cg, args[0_usize]);
                cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.ZERO, 1_i32);
                var li: usize = 0_usize;
                while li < op.len_u8.widen.[usize]() { ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, aoff +% li.trunc.[i32](), 1_u8); cg.buf.and_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); li = li +% 1_usize; }
                cg.buf.andi(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32);
                cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            }
            return true;
        }
        .VecBitmask => {
            if args.len > 0_usize {
                let aoff = cg_val_off(cg, args[0_usize]);
                cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.ZERO);
                var li: usize = 0_usize;
                while li < op.len_u8.widen.[usize]() {
                    ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, aoff +% li.trunc.[i32](), 1_u8);
                    cg.buf.andi(alloc, rv64_asm.A1, rv64_asm.A1, 1_i32);
                    if li > 0_usize { cg.buf.slli(alloc, rv64_asm.A1, rv64_asm.A1, li.trunc.[u8]()); }
                    cg.buf.or_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1);
                    li = li +% 1_usize;
                }
                cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            }
            return true;
        }
        .VecSelect => {
            if args.len >= 3_usize {
                let vn = env.get(op.ty0);
                let esz = if env.x64_layout(vn.primary).size == 0_usize { 1_usize } else { env.x64_layout(vn.primary).size };
                let moff = cg_val_off(cg, args[0_usize]);
                let aoff = cg_val_off(cg, args[1_usize]);
                let boff = cg_val_off(cg, args[2_usize]);
                let doff = cg_val_off(cg, dst);
                var li: usize = 0_usize;
                while li < vn.u8_val.widen.[usize]() {
                    let d = (li *% esz).trunc.[i32]();
                    ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, boff +% d, esz.trunc.[u8]());
                    ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, aoff +% d, esz.trunc.[u8]());
                    ld(alloc, cg, rv64_asm.A2, rv64_asm.FP, moff +% li.trunc.[i32](), 1_u8);
                    let l_sk = cg.buf.new_label(alloc);
                    cg.buf.br_short_label(alloc, .Eq, rv64_asm.A2, rv64_asm.ZERO, l_sk);
                    cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.A1);
                    cg.buf.bind_label(l_sk);
                    st(alloc, cg, rv64_asm.FP, doff +% d, rv64_asm.A0, esz.trunc.[u8]());
                    li = li +% 1_usize;
                }
            }
            return true;
        }
        .VecMin => { cg_emit_vec_mmf(alloc, cg, env, dst, op, args); return true; }
        .VecMax => { cg_emit_vec_mmf(alloc, cg, env, dst, op, args); return true; }
        .VecFma => { if args.len >= 3_usize { cg_emit_vec_mmf(alloc, cg, env, dst, op, args); } return true; }
        .VecReduceAdd => { cg_emit_vec_reduce(alloc, cg, eir_prog, env, interner, dst, op, args); return true; }
        .VecReduceMin => { cg_emit_vec_reduce(alloc, cg, eir_prog, env, interner, dst, op, args); return true; }
        .VecReduceMax => { cg_emit_vec_reduce(alloc, cg, eir_prog, env, interner, dst, op, args); return true; }
        .VecDot => { cg_emit_vec_reduce(alloc, cg, eir_prog, env, interner, dst, op, args); return true; }
        .VecShuffle => {
            let sn = env.get(op.ty0);
            let in_n = env.get(op.ty1);
            if sn.kind != .Vec || in_n.kind != .Vec || args.len < 2_usize || (op.flag && args.len < 3_usize) { return true; }
            let src_lanes = sn.u8_val.widen.[usize]();
            let total_lanes = if op.flag { src_lanes *% 2_usize } else { src_lanes };
            if total_lanes == 0_usize { return true; }
            let idx_esz = if env.x64_layout(in_n.primary).size == 0_usize { 1_usize } else { env.x64_layout(in_n.primary).size };
            let esz = if env.x64_layout(sn.primary).size == 0_usize { 1_usize } else { env.x64_layout(sn.primary).size };
            let aoff = cg_val_off(cg, args[0_usize]);
            let boff: i32 = if op.flag { cg_val_off(cg, args[1_usize]) } else { aoff };
            let ioff: i32 = if op.flag && args.len >= 3_usize { cg_val_off(cg, args[2_usize]) } else { cg_val_off(cg, args[1_usize]) };
            let doff = cg_val_off(cg, dst);
            var li: usize = 0_usize;
            while li < in_n.u8_val.widen.[usize]() {
                ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, ioff +% (li *% idx_esz).trunc.[i32](), idx_esz.trunc.[u8]());
                cg.buf.li64(alloc, rv64_asm.A2, (total_lanes -% 1_usize).widen.[u64]());
                let l_ib = cg.buf.new_label(alloc);
                cg.buf.br_short_label(alloc, .Geu, rv64_asm.A2, rv64_asm.A1, l_ib);
                cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.A2);
                cg.buf.bind_label(l_ib);
                addl(alloc, cg, rv64_asm.T1, rv64_asm.FP, aoff.widen.[i64]());
                if op.flag {
                    let l_f = cg.buf.new_label(alloc);
                    cg.buf.li64(alloc, rv64_asm.T2, src_lanes.widen.[u64]());
                    cg.buf.br_short_label(alloc, .Ltu, rv64_asm.A1, rv64_asm.T2, l_f);
                    cg.buf.sub(alloc, rv64_asm.A1, rv64_asm.A1, rv64_asm.T2);
                    addl(alloc, cg, rv64_asm.T1, rv64_asm.FP, boff.widen.[i64]());
                    cg.buf.bind_label(l_f);
                }
                cg_scale_add(alloc, cg, rv64_asm.T1, rv64_asm.T1, rv64_asm.A1, esz);
                ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, esz.trunc.[u8]());
                st(alloc, cg, rv64_asm.FP, doff +% (li *% esz).trunc.[i32](), rv64_asm.A0, esz.trunc.[u8]());
                li = li +% 1_usize;
            }
            return true;
        }
        _ => {}
    }
    return false;
}

fn cg_emit_builtin_sys_io(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, op: cfg_ir.CfgBuiltinOp, args: *[eir.EirValue], arg_slots: *[eir.EirSlot]) {
    match op.kind {
        .ClockNowNs => { cg_helper_call(alloc, cg, interner, "eon_rt_now_ns"); if dst != eir.EIR_NONE { cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); } }
        .ArgsLen => { cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1); ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, 8_u8); cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        .ArgsGet => {
            if args.len < 2_usize { return; }
            let doff = cg_val_off(cg, dst);
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.T2, rv64_asm.T1, 0_i32, 8_u8);
            cg_load_scalar_val(alloc, cg, eir_prog, env, args[1_usize], rv64_asm.T3);
            let l_oob = cg.buf.new_label(alloc);
            let l_sl = cg.buf.new_label(alloc);
            let l_sd = cg.buf.new_label(alloc);
            let l_dn = cg.buf.new_label(alloc);
            cg.buf.br_cond_label(alloc, .Geu, rv64_asm.T3, rv64_asm.T2, l_oob);
            ld(alloc, cg, rv64_asm.T4, rv64_asm.T1, 8_i32, 8_u8);
            cg.buf.slli(alloc, rv64_asm.A0, rv64_asm.T3, 3_u8);
            cg.buf.add(alloc, rv64_asm.T4, rv64_asm.T4, rv64_asm.A0);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T4, 0_i32, 8_u8);
            cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A0, rv64_asm.ZERO, l_oob);
            cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO);
            cg.buf.bind_label(l_sl);
            cg.buf.add(alloc, rv64_asm.A2, rv64_asm.A0, rv64_asm.A1);
            ld(alloc, cg, rv64_asm.A3, rv64_asm.A2, 0_i32, 1_u8);
            cg.buf.br_short_label(alloc, .Eq, rv64_asm.A3, rv64_asm.ZERO, l_sd);
            cg.buf.addi(alloc, rv64_asm.A1, rv64_asm.A1, 1_i32);
            cg.buf.j_label(alloc, l_sl);
            cg.buf.bind_label(l_sd);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.A0, 8_u8);
            st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.A1, 8_u8);
            cg.buf.j_label(alloc, l_dn);
            cg.buf.bind_label(l_oob);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 8_u8);
            cg.buf.addi(alloc, rv64_asm.A1, rv64_asm.ZERO, -1_i32);
            st(alloc, cg, rv64_asm.FP, doff +% 8_i32, rv64_asm.A1, 8_u8);
            cg.buf.bind_label(l_dn);
        }
        .FsIsDir => {
            if args.len < 2_usize { return; }
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, 8_u8);
            let po = cg_val_off(cg, args[1_usize]);
            ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, po, 8_u8);
            ld(alloc, cg, rv64_asm.A2, rv64_asm.FP, po +% 8_i32, 8_u8);
            cg_helper_call(alloc, cg, interner, "eon_rt_is_dir");
            cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
        }
        .FsMkdirAll => {
            if args.len < 2_usize { return; }
            let doff = cg_val_off(cg, dst);
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, 8_u8);
            let po = cg_val_off(cg, args[1_usize]);
            ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, po, 8_u8);
            ld(alloc, cg, rv64_asm.A2, rv64_asm.FP, po +% 8_i32, 8_u8);
            cg_helper_call(alloc, cg, interner, "eon_rt_mkdir_all");
            let l_ok = cg.buf.new_label(alloc);
            let l_dn = cg.buf.new_label(alloc);
            cg.buf.br_cond_label(alloc, .Ge, rv64_asm.A0, rv64_asm.ZERO, l_ok);
            st_eu_err(alloc, cg, doff, 17_i32);
            cg.buf.j_label(alloc, l_dn);
            cg.buf.bind_label(l_ok);
            st(alloc, cg, rv64_asm.FP, doff, rv64_asm.ZERO, 4_u8);
            cg.buf.bind_label(l_dn);
        }
        .DirClose => {
            cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
            ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, 8_u8);
            cg.buf.addi(alloc, rv64_asm.A1, rv64_asm.ZERO, -1_i32);
            st(alloc, cg, rv64_asm.T1, 0_i32, rv64_asm.A1, 8_u8);
            let l_sk = cg.buf.new_label(alloc);
            cg.buf.br_cond_label(alloc, .Lt, rv64_asm.A0, rv64_asm.ZERO, l_sk);
            cg_helper_call(alloc, cg, interner, "eon_rt_close_fd");
            cg.buf.bind_label(l_sk);
        }
        .NetRestrictHost => {
            if dst != eir.EIR_NONE {
                cg_bptr(alloc, cg, eir_prog, env, args, arg_slots, 0_usize, rv64_asm.T1);
                ld(alloc, cg, rv64_asm.A0, rv64_asm.T1, 0_i32, 8_u8);
                cg.buf.addi(alloc, rv64_asm.A0, rv64_asm.A0, 1_i32);
                cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0);
            }
        }
        .ParReduce => {
            if args.len == 0_usize { return; }
            let ety = op.ty0;
            let op_name = interner.get(op.sym);
            let en = env.get(ety);
            let is_flt = en.kind == .Float;
            let is_f64 = is_flt && en.u8_val == 64_u8;
            let esz = if env.x64_layout(ety).size == 0_usize { 1_usize } else { env.x64_layout(ety).size };
            let sgn = env.is_signed_int(ety);
            let soff = cg_val_off(cg, args[0_usize]);
            ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, soff, 8_u8);
            ld(alloc, cg, rv64_asm.T2, rv64_asm.FP, soff +% 8_i32, 8_u8);
            cg.buf.mv(alloc, rv64_asm.T3, rv64_asm.ZERO);
            if is_flt {
                if args.len > 2_usize { cg_load_float_val(alloc, cg, eir_prog, env, interner, args[2_usize], rv64_asm.FA0); }
                else { cg.buf.fmv_fp_x(alloc, is_f64, rv64_asm.FA0, rv64_asm.ZERO); }
            } else if args.len > 2_usize { cg_load_scalar_val(alloc, cg, eir_prog, env, args[2_usize], rv64_asm.A0); }
            else { cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.ZERO); }
            let l_hd = cg.buf.new_label(alloc);
            let l_end = cg.buf.new_label(alloc);
            cg.buf.bind_label(l_hd);
            cg.buf.br_cond_label(alloc, .Geu, rv64_asm.T3, rv64_asm.T2, l_end);
            if is_flt {
                ldf(alloc, cg, is_f64, rv64_asm.FA1, rv64_asm.T1, 0_i32);
                if str.bytes_eq(op_name, "Mul".as_bytes()) { cg.buf.fmul(alloc, is_f64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
                else if str.bytes_eq(op_name, "Min".as_bytes()) { cg.buf.fmin(alloc, is_f64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
                else if str.bytes_eq(op_name, "Max".as_bytes()) { cg.buf.fmax(alloc, is_f64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
                else { cg.buf.fadd(alloc, is_f64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1); }
            } else {
                lds(alloc, cg, rv64_asm.A1, rv64_asm.T1, 0_i32, esz.trunc.[u8](), sgn);
                if str.bytes_eq(op_name, "Min".as_bytes()) { cg_emit_int_minmax_a0_a1(alloc, cg, true, sgn); }
                else if str.bytes_eq(op_name, "Max".as_bytes()) { cg_emit_int_minmax_a0_a1(alloc, cg, false, sgn); }
                else if str.bytes_eq(op_name, "Mul".as_bytes()) { cg.buf.mul(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); cg_norm_subword(alloc, cg, env, ety, rv64_asm.A0); }
                else if str.bytes_eq(op_name, "And".as_bytes()) || str.bytes_eq(op_name, "BitAnd".as_bytes()) { cg.buf.and_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
                else if str.bytes_eq(op_name, "Or".as_bytes()) || str.bytes_eq(op_name, "BitOr".as_bytes()) { cg.buf.or_r(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
                else if str.bytes_eq(op_name, "Xor".as_bytes()) || str.bytes_eq(op_name, "BitXor".as_bytes()) { cg.buf.xor(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); }
                else { cg.buf.add(alloc, rv64_asm.A0, rv64_asm.A0, rv64_asm.A1); cg_norm_subword(alloc, cg, env, ety, rv64_asm.A0); }
            }
            addl(alloc, cg, rv64_asm.T1, rv64_asm.T1, esz.widen.[u64]().bitcast.[i64]());
            cg.buf.addi(alloc, rv64_asm.T3, rv64_asm.T3, 1_i32);
            cg.buf.j_label(alloc, l_hd);
            cg.buf.bind_label(l_end);
            if is_flt { cg_store_float_val(alloc, cg, eir_prog, env, interner, dst, rv64_asm.FA0); }
            else { cg_store_scalar_val(alloc, cg, eir_prog, env, dst, rv64_asm.A0); }
        }
        _ => {}
    }
    return;
}

fn cg_emit_builtin_call(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, dst: eir.EirValue, bc_id: u32) {
    let bc = eir_prog.get_builtin_call(bc_id) orelse { return; };
    let args = eir_prog.vals_slice(bc.args);
    let aslots = eir_prog.arg_slots_slice(bc.arg_slots);
    if cg_emit_builtin_arena(alloc, cg, eir_prog, env, interner, dst, bc.op, args, aslots, bc.ret_ty) { return; }
    if cg_emit_builtin_arena_pool(alloc, cg, eir_prog, env, interner, dst, bc.op, args, aslots, bc.ret_ty) { return; }
    if cg_emit_builtin_slot_pool(alloc, cg, eir_prog, env, interner, dst, bc.op, args, aslots, bc.ret_ty) { return; }
    if cg_emit_builtin_buf_slice(alloc, cg, eir_prog, env, interner, dst, bc.op, args, aslots, bc.ret_ty) { return; }
    if cg_emit_builtin_atomic_mmio(alloc, cg, eir_prog, env, dst, bc.op, args, aslots) { return; }
    if cg_emit_builtin_math(alloc, cg, eir_prog, env, interner, dst, bc.op, args) { return; }
    if cg_emit_builtin_vec(alloc, cg, eir_prog, env, interner, dst, bc.op, args) { return; }
    cg_emit_builtin_sys_io(alloc, cg, eir_prog, env, interner, dst, bc.op, args, aslots);
    return;
}

// ============================================================================
// Section 9: Instruction Dispatch, Parallel Phi Copies, Terminators & Entry
// ============================================================================

struct RvPhiPair { dst: eir.EirValue; src: eir.EirValue; }

fn cg_emit_phi_edge(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, from_bb: eir.BlockId, to_bb: eir.BlockId) -> !OutOfMemory {
    let phis = eir_prog.block_phis(cg.fn_id, to_bb);
    if phis.len == 0_usize { return; }
    var pairs = try col.DynBuf.[RvPhiPair].init(alloc, phis.len);
    errdefer pairs.destroy(alloc);
    var i: usize = 0_usize;
    while i < phis.len {
        let inc = eir_prog.phi_incoming(phis[i].incoming);
        var j: usize = 0_usize;
        while j < inc.len {
            if inc[j].pred_bb == from_bb && inc[j].val != phis[i].dst { try pairs.push(alloc, RvPhiPair.{ dst: phis[i].dst, src: inc[j].val }); break; }
            j = j +% 1_usize;
        }
        i = i +% 1_usize;
    }
    if pairs.is_empty() { pairs.destroy(alloc); return; }
    let ps = pairs.as_slice();
    var has_conflict = false;
    var ic: usize = 1_usize;
    while ic < ps.len && !has_conflict {
        let sloc = cg_val_loc(cg, ps[ic].src);
        var jc: usize = 0_usize;
        while jc < ic {
            let dloc = cg_val_loc(cg, ps[jc].dst);
            if ps[jc].dst == ps[ic].src || (sloc.kind == .Reg && dloc.kind == .Reg && sloc.reg == dloc.reg) || (sloc.kind == .Stack && dloc.kind == .Stack && sloc.stack_off == dloc.stack_off) {
                has_conflict = true; break;
            }
            jc = jc +% 1_usize;
        }
        ic = ic +% 1_usize;
    }
    if !has_conflict {
        var pi: usize = 0_usize;
        while pi < ps.len { cg_copy_val_to_val(alloc, cg, eir_prog, env, ps[pi].dst, ps[pi].src); pi = pi +% 1_usize; }
        pairs.destroy(alloc);
        return;
    }
    var snap_offs = try col.DynBuf.[i32].init(alloc, ps.len);
    errdefer snap_offs.destroy(alloc);
    var total_snap: usize = 0_usize;
    var pi: usize = 0_usize;
    while pi < ps.len {
        try snap_offs.push(alloc, total_snap.trunc.[i32]());
        let sz = env.x64_layout(eir_prog.fn_val_ty(cg.fn_id, ps[pi].dst)).size;
        if sz > 0_usize { total_snap = total_snap +% types.align_up_usize(if sz < 8_usize { 8_usize } else { sz }, 8_usize); }
        pi = pi +% 1_usize;
    }
    let pad = types.align_up_usize(total_snap, 16_usize);
    if pad > 0_usize { addl(alloc, cg, rv64_asm.SP, rv64_asm.SP, 0_i64 -% pad.widen.[u64]().bitcast.[i64]()); }
    let so = snap_offs.as_slice();
    pi = 0_usize;
    while pi < ps.len && pi < so.len {
        let sz = env.x64_layout(eir_prog.fn_val_ty(cg.fn_id, ps[pi].dst)).size;
        if sz > 0_usize && sz <= 8_usize { cg_load_scalar_raw(alloc, cg, eir_prog, env, ps[pi].src, rv64_asm.A0); st(alloc, cg, rv64_asm.SP, so[pi], rv64_asm.A0, 8_u8); }
        else if sz > 8_usize { cg_copy_mem(alloc, cg, rv64_asm.SP, so[pi], rv64_asm.FP, cg_val_off(cg, ps[pi].src), sz); }
        pi = pi +% 1_usize;
    }
    pi = 0_usize;
    while pi < ps.len && pi < so.len {
        let sz = env.x64_layout(eir_prog.fn_val_ty(cg.fn_id, ps[pi].dst)).size;
        if sz > 0_usize && sz <= 8_usize { ld(alloc, cg, rv64_asm.A0, rv64_asm.SP, so[pi], 8_u8); cg_store_scalar_val(alloc, cg, eir_prog, env, ps[pi].dst, rv64_asm.A0); }
        else if sz > 8_usize { cg_copy_mem(alloc, cg, rv64_asm.FP, cg_val_off(cg, ps[pi].dst), rv64_asm.SP, so[pi], sz); }
        pi = pi +% 1_usize;
    }
    if pad > 0_usize { addl(alloc, cg, rv64_asm.SP, rv64_asm.SP, pad.widen.[u64]().bitcast.[i64]()); }
    snap_offs.destroy(alloc);
    pairs.destroy(alloc);
    return;
}

fn cg_emit_return_term(alloc: *mut AllocCap, cg: *mut RvCg, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, has_val: bool, val: eir.EirValue) {
    if cg.is_naked { return; }
    let rc = cg.ret_class;
    match rc.kind {
        .Void => {}
        .IntReg => {
            if has_val { cg_load_scalar_val(alloc, cg, eir_prog, env, val, rv64_asm.A0); }
            else { cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.ZERO); }
        }
        .TwoIntRegs => {
            cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.ZERO);
            cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO);
            if has_val {
                let soff = cg_val_off(cg, val);
                let sz = env.x64_layout(cg.ret_ty).size;
                ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, soff, 8_u8);
                if sz > 8_usize { ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, soff +% 8_i32, (sz - 8_usize).trunc.[u8]()); }
            }
        }
        .FloatReg => {
            if has_val { cg_load_float_val(alloc, cg, eir_prog, env, interner, val, rv64_asm.FA0); }
            else { cg.buf.fmv_fp_x(alloc, env.get(cg.ret_ty).u8_val == 64_u8, rv64_asm.FA0, rv64_asm.ZERO); }
        }
        .Sret => {
            ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, cg.frame.sret_off, 8_u8);
            if has_val { cg_store_val_to_mem(alloc, cg, env, rv64_asm.T1, 0_i32, val, cg.ret_ty); cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.T1); }
        }
        .ErrorUnion => {
            if !has_val { cg.buf.mv(alloc, rv64_asm.T0, rv64_asm.ZERO); }
            else {
                let soff = cg_val_off(cg, val);
                let l_err = cg.buf.new_label(alloc);
                ld(alloc, cg, rv64_asm.T0, rv64_asm.FP, soff, 4_u8);
                cg.buf.br_cond_label(alloc, .Ne, rv64_asm.T0, rv64_asm.ZERO, l_err);
                let ok_off = env.eu_ok_offset(rc.ok_ty).trunc.[i32]();
                let ok_sz = env.x64_layout(rc.ok_ty).size;
                if rc.ok_kind == .IntReg { lds(alloc, cg, rv64_asm.A0, rv64_asm.FP, soff +% ok_off, ok_sz.trunc.[u8](), env.is_signed_int(rc.ok_ty)); }
                else if rc.ok_kind == .TwoIntRegs {
                    ld(alloc, cg, rv64_asm.A0, rv64_asm.FP, soff +% ok_off, 8_u8);
                    if ok_sz > 8_usize { ld(alloc, cg, rv64_asm.A1, rv64_asm.FP, soff +% ok_off +% 8_i32, (ok_sz - 8_usize).trunc.[u8]()); }
                    else { cg.buf.mv(alloc, rv64_asm.A1, rv64_asm.ZERO); }
                } else if rc.ok_kind == .FloatReg { ldf(alloc, cg, env.get(rc.ok_ty).u8_val == 64_u8, rv64_asm.FA0, rv64_asm.FP, soff +% ok_off); }
                else if rc.ok_kind == .Sret {
                    ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, cg.frame.sret_off, 8_u8);
                    cg_copy_mem(alloc, cg, rv64_asm.T1, 0_i32, rv64_asm.FP, soff +% ok_off, ok_sz);
                    cg.buf.mv(alloc, rv64_asm.A0, rv64_asm.T1);
                }
                cg.buf.bind_label(l_err);
            }
        }
    }
    cg_emit_epilogue(alloc, cg);
    cg.buf.ret(alloc);
    return;
}

fn cg_emit_inst(alloc: *mut AllocCap, cg: *mut RvCg, sm: *span.SourceMap, eir_prog: *eir.EirProgram, env: *types.TypeEnv, ct: *ctvm.CtArena, interner: *mut span.SymInterner, inst: *eir.EirInst) -> !OutOfMemory {
    if cg.is_naked && inst.kind != .InlineAsm { return; }
    cg_record_line(alloc, cg, sm, inst.span);
    match inst.kind {
        .Const => { try cg_emit_const(alloc, cg, eir_prog, env, ct, interner, inst.dst, inst.aux0, inst.ty0); }
        .Copy => { cg_copy_val_to_val(alloc, cg, eir_prog, env, inst.dst, inst.v0); }
        .LoadSlot => { cg_load_val_from_mem(alloc, cg, env, inst.dst, rv64_asm.FP, cg_slot_off(cg, inst.aux0), eir_prog.fn_val_ty(cg.fn_id, inst.dst)); }
        .StoreSlot => { cg_store_val_to_mem(alloc, cg, env, rv64_asm.FP, cg_slot_off(cg, inst.aux0), inst.v0, eir_prog.fn_val_ty(cg.fn_id, inst.v0)); }
        .SlotAddr => { addl(alloc, cg, rv64_asm.A0, rv64_asm.FP, cg_slot_off(cg, inst.aux0).widen.[i64]()); cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, rv64_asm.A0); }
        .LoadPlace => { cg_emit_load_place(alloc, cg, eir_prog, env, inst.dst, inst.aux0); }
        .StorePlace => { cg_emit_store_place(alloc, cg, eir_prog, env, inst.aux0, inst.v0); }
        .PlaceAddr => { if let pl = eir_prog.get_place(inst.aux0) { _ = cg_compute_place_addr(alloc, cg, eir_prog, env, pl, pl.projs.len.widen.[usize](), rv64_asm.T1); cg_store_scalar_val(alloc, cg, eir_prog, env, inst.dst, rv64_asm.T1); } }
        .PoolColumnLoad => { if let op = eir_prog.get_pool_col_op(inst.aux0) { cg_emit_pool_col_addr(alloc, cg, eir_prog, env, op); cg_load_val_from_mem(alloc, cg, env, inst.dst, rv64_asm.T1, 0_i32, eir_prog.fn_val_ty(cg.fn_id, inst.dst)); } }
        .PoolColumnStore => { if let op = eir_prog.get_pool_col_op(inst.aux0) { cg_emit_pool_col_addr(alloc, cg, eir_prog, env, op); cg_store_val_to_mem(alloc, cg, env, rv64_asm.T1, 0_i32, inst.v0, op.elem_ty); } }
        .Unary => { cg_emit_unary(alloc, cg, eir_prog, env, interner, inst.dst, inst.unary_op, inst.v0, inst.ty0); }
        .Binary => { cg_emit_binary(alloc, cg, eir_prog, env, interner, inst.dst, inst.bin_op, inst.v0, inst.v1, inst.ty0, inst.ty1); }
        .Cast => { cg_emit_cast(alloc, cg, eir_prog, env, interner, inst.dst, inst.cast_kind, inst.v0, inst.ty1, inst.ty0); }
        .Slice => { cg_emit_slice(alloc, cg, eir_prog, env, inst.dst, inst.v0, inst.v1, inst.v2, inst.ty1); }
        .VecLoad => {
            let esz = if env.x64_layout(inst.ty1).size == 0_usize { 4_usize } else { env.x64_layout(inst.ty1).size };
            ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, cg_val_off(cg, inst.v0), 8_u8);
            cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v1, rv64_asm.T2);
            cg_scale_add(alloc, cg, rv64_asm.T1, rv64_asm.T1, rv64_asm.T2, esz);
            cg_copy_mem(alloc, cg, rv64_asm.FP, cg_val_off(cg, inst.dst), rv64_asm.T1, 0_i32, env.x64_layout(inst.ty0).size);
        }
        .VecStore => {
            let esz = if env.x64_layout(inst.ty1).size == 0_usize { 4_usize } else { env.x64_layout(inst.ty1).size };
            ld(alloc, cg, rv64_asm.T1, rv64_asm.FP, cg_val_off(cg, inst.v0), 8_u8);
            cg_load_scalar_raw(alloc, cg, eir_prog, env, inst.v1, rv64_asm.T2);
            cg_scale_add(alloc, cg, rv64_asm.T1, rv64_asm.T1, rv64_asm.T2, esz);
            cg_copy_mem(alloc, cg, rv64_asm.T1, 0_i32, rv64_asm.FP, cg_val_off(cg, inst.v2), env.x64_layout(inst.ty0).size);
        }
        .VecFma => {
            let vn = env.get(inst.ty0);
            let is64 = env.get(vn.primary).u8_val == 64_u8;
            let esz: usize = if is64 { 8_usize } else { 4_usize };
            let aoff = cg_val_off(cg, inst.v0);
            let boff = cg_val_off(cg, inst.v1);
            let coff = cg_val_off(cg, inst.v2);
            let doff = cg_val_off(cg, inst.dst);
            var li: usize = 0_usize;
            while li < vn.u8_val.widen.[usize]() {
                let d = (li *% esz).trunc.[i32]();
                ldf(alloc, cg, is64, rv64_asm.FA0, rv64_asm.FP, aoff +% d);
                ldf(alloc, cg, is64, rv64_asm.FA1, rv64_asm.FP, boff +% d);
                ldf(alloc, cg, is64, rv64_asm.FA2, rv64_asm.FP, coff +% d);
                cg.buf.fmadd(alloc, is64, rv64_asm.FA0, rv64_asm.FA0, rv64_asm.FA1, rv64_asm.FA2);
                stf(alloc, cg, is64, rv64_asm.FP, doff +% d, rv64_asm.FA0);
                li = li +% 1_usize;
            }
        }
        .Aggregate => { cg_emit_aggregate(alloc, cg, eir_prog, env, inst.dst, inst.aux0, inst.range, inst.ty0); }
        .Call => { try cg_emit_call(alloc, cg, eir_prog, env, interner, inst.dst, inst.aux0); }
        .BuiltinCall => { cg_emit_builtin_call(alloc, cg, eir_prog, env, interner, inst.dst, inst.aux0); }
        .ParForHint => {}
        _ => { cg_emit_unwrap_and_extract(alloc, cg, eir_prog, env, interner, inst); }
    }
    return;
}

fn cg_emit_term(alloc: *mut AllocCap, cg: *mut RvCg, sm: *span.SourceMap, eir_prog: *eir.EirProgram, env: *types.TypeEnv, interner: *mut span.SymInterner, bb: eir.BlockId, term: *eir.EirTerm, next_bb: eir.BlockId) -> !OutOfMemory {
    cg_record_line(alloc, cg, sm, term.span);
    match term.kind {
        .Goto => {
            try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, term.bb0);
            if term.bb0 != next_bb { let l0 = cg_blk_lbl(cg, term.bb0); cg.buf.j_label(alloc, l0); }
        }
        .Branch => {
            cg_load_scalar_val(alloc, cg, eir_prog, env, term.val, rv64_asm.A0);
            let l_else = cg.buf.new_label(alloc);
            cg.buf.br_cond_label(alloc, .Eq, rv64_asm.A0, rv64_asm.ZERO, l_else);
            try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, term.bb0);
            let l0 = cg_blk_lbl(cg, term.bb0);
            cg.buf.j_label(alloc, l0);
            cg.buf.bind_label(l_else);
            try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, term.bb1);
            if term.bb1 != next_bb { let l1 = cg_blk_lbl(cg, term.bb1); cg.buf.j_label(alloc, l1); }
        }
        .SwitchInt => {
            let targets = eir_prog.switch_targets_slice(term.targets);
            cg_load_scalar_val(alloc, cg, eir_prog, env, term.val, rv64_asm.A0);
            var ti: usize = 0_usize;
            while ti < targets.len {
                let l_sk = cg.buf.new_label(alloc);
                cg.buf.li64(alloc, rv64_asm.A1, targets[ti].val.lo);
                cg.buf.br_cond_label(alloc, .Ne, rv64_asm.A0, rv64_asm.A1, l_sk);
                try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, targets[ti].target);
                let tl = cg_blk_lbl(cg, targets[ti].target);
                cg.buf.j_label(alloc, tl);
                cg.buf.bind_label(l_sk);
                ti = ti +% 1_usize;
            }
            try cg_emit_phi_edge(alloc, cg, eir_prog, env, bb, term.bb0);
            if term.bb0 != next_bb { let dl = cg_blk_lbl(cg, term.bb0); cg.buf.j_label(alloc, dl); }
        }
        .Return => { cg_emit_return_term(alloc, cg, eir_prog, env, interner, term.flag, term.val); }
        .Unreachable => { cg.buf.trap(alloc); }
    }
    return;
}

fn init_rv_cg(alloc: *mut AllocCap, eir_prog: *eir.EirProgram, fn_id: u32, fn_sym_id: u32, env: *types.TypeEnv, opts: *mach_x64.CompileOptions, f: *eir.EirFunction, rc: mach_isel_a64.A64RetClass) -> RvCg ! OutOfMemory {
    let frame = try plan_rv_direct_frame(alloc, eir_prog, fn_id, env, mach_isel_a64.a64_ret_uses_sret(rc));
    errdefer frame.destroy(alloc);
    let buf = try rv64_asm.Rv64Buf.init(alloc);
    errdefer buf.destroy(alloc);
    let blk_labels = try col.DynBuf.[u32].init(alloc, 8_usize);
    errdefer blk_labels.destroy(alloc);
    let rodata_items = try col.DynBuf.[mach_x64.RodataItemMeta].init(alloc, 4_usize);
    errdefer rodata_items.destroy(alloc);
    let rodata_bytes = try col.DynBuf.[u8].init(alloc, 32_usize);
    errdefer rodata_bytes.destroy(alloc);
    let rodata_relocs = try col.DynBuf.[mach_x64.RodataReloc].init(alloc, 4_usize);
    errdefer rodata_relocs.destroy(alloc);
    let used_helpers = try col.DynBuf.[u32].init(alloc, 4_usize);
    errdefer used_helpers.destroy(alloc);
    let line_entries = try col.DynBuf.[elf64.LineEntry].init(alloc, 16_usize);
    errdefer line_entries.destroy(alloc);
    let fn_ref_thunks = try col.DynBuf.[mach_x64.FnRefThunkReq].init(alloc, 4_usize);
    errdefer fn_ref_thunks.destroy(alloc);
    let err_msg = try str.StrBuf.init(alloc, 16_usize);
    errdefer err_msg.destroy(alloc);
    return RvCg.{
        fn_id: fn_id, fn_sym_id: fn_sym_id, ret_ty: f.sig.ret, ret_class: rc,
        is_naked: f.sig.effects.is_naked, is_export_c: f.sig.effects.is_export_c,
        sanitize: opts.sanitize, emit_debug_line: opts.emit_debug_line,
        failed: false, oom: false, err_msg: err_msg, frame: frame, buf: buf, blk_labels: blk_labels,
        rodata_items: rodata_items, rodata_bytes: rodata_bytes, rodata_relocs: rodata_relocs,
        used_helpers: used_helpers, line_entries: line_entries, fn_ref_thunks: fn_ref_thunks,
        last_line_file: span.FILE_DUMMY, last_line_num: 0_u32, max_call_stk: 0_u64,
    };
}

pub fn compile_fn_rv64_direct(
    alloc: *mut AllocCap,
    sm: *span.SourceMap,
    eir_prog: *eir.EirProgram,
    fn_id: u32,
    fn_sym_id: u32,
    env: *types.TypeEnv,
    ct: *ctvm.CtArena,
    interner: *mut span.SymInterner,
    opts: *mach_x64.CompileOptions,
) -> Rv64FnBlob ! OutOfMemory {
    var out = try Rv64FnBlob.init(alloc, fn_sym_id);
    errdefer out.destroy(alloc);
    let f = eir_prog.get_fn(fn_id) orelse { return out; };
    var cg = try init_rv_cg(alloc, eir_prog, fn_id, fn_sym_id, env, opts, f, mach_isel_a64.a64_classify_ret(f.sig.ret, env));
    errdefer cg.destroy(alloc);

    let blks = eir_prog.fn_blocks(fn_id);
    var bi: usize = 0_usize;
    while bi < blks.len { try cg.blk_labels.push(alloc, cg.buf.new_label(alloc)); bi = bi +% 1_usize; }
    cg_emit_prologue(alloc, &mut cg);
    cg_receive_params(alloc, &mut cg, eir_prog, env);

    bi = 0_usize;
    while bi < blks.len && !cg.failed && !cg.oom && !cg.buf.oom {
        let bb = bi.trunc.[u32]();
        let next_bb: eir.BlockId = if bi +% 1_usize < blks.len { (bi +% 1_usize).trunc.[u32]() } else { 0xFFFFFFFF_u32 };
        let blbl = cg_blk_lbl(&cg, bb);
        cg.buf.bind_label(blbl);
        let insts = eir_prog.insts_slice(blks[bi].insts);
        var ii: usize = 0_usize;
        while ii < insts.len && !cg.failed && !cg.oom && !cg.buf.oom { try cg_emit_inst(alloc, &mut cg, sm, eir_prog, env, ct, interner, &insts[ii]); ii = ii +% 1_usize; }
        if !cg.failed { try cg_emit_term(alloc, &mut cg, sm, eir_prog, env, interner, bb, &blks[bi].term, next_bb); }
        bi = bi +% 1_usize;
    }

    try cg.buf.check_oom();
    if cg.oom { return .OutOfMemory; }
    let fin_ok = !cg.failed && cg.buf.finish();
    out.ok = fin_ok;
    out.own_stack_bytes = 16_u64 +% cg.frame.total_sub.widen.[u64]() +% cg.max_call_stk;
    if fin_ok {
        try out.code.push_slice(alloc, cg.buf.code.as_slice());
        try out.relocs.push_slice(alloc, cg.buf.relocs.as_slice());
        try out.rodata_items.push_slice(alloc, cg.rodata_items.as_slice());
        try out.rodata_bytes.push_slice(alloc, cg.rodata_bytes.as_slice());
        try out.rodata_relocs.push_slice(alloc, cg.rodata_relocs.as_slice());
        try out.used_helpers.push_slice(alloc, cg.used_helpers.as_slice());
        try out.line_entries.push_slice(alloc, cg.line_entries.as_slice());
        try out.fn_ref_thunks.push_slice(alloc, cg.fn_ref_thunks.as_slice());
    } else if cg.err_msg.len() > 0_usize {
        try out.err_msg.push_bytes_grow(alloc, cg.err_msg.as_bytes());
    } else {
        try out.err_msg.push_str_grow(alloc, "riscv64 codegen error: branch fixup failed");
    }
    cg.destroy(alloc);
    return out;
}
