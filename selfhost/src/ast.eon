    RawStringLit = 3,
    ByteStringLit = 4,
    CharLit = 5,
    ByteCharLit = 6,
    BoolLit = 7,
    Null = 8,
    SelfVal = 9,
    ReturnVal = 10,
    Ident = 11,
    EnumLit = 12,
    AnonStructLit = 13,
    NamedStructLit = 14,
    ArrayLit = 15,
    ArrayRepeat = 16,
    Tuple = 17,
    Paren = 18,
    Closure = 19,
    If = 20,
    Match = 21,
    Loop = 22,
    ComptimeBlock = 23,
    ComptimeExpr = 24,
    Builtin = 25,
    Asm = 26,
    Unary = 27,
    Binary = 28,
    Is = 29,
    Orelse = 30,
    Catch = 31,
    Field = 32,
    Deref = 33,
    GenericApply = 34,
    Call = 35,
    Index = 36,
    Slice = 37,
