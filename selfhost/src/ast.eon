// ---------------------------------------------------------------------------
// AST Node Structs
// ---------------------------------------------------------------------------

pub struct UnitNode {
    pub file: u32;
    pub profile: span.FileProfile;
    pub module_path: IdRange;
    pub is_hal: bool;
    pub has_hal_span: bool;
    pub hal_span: span.Span;
    pub imports: IdRange;
    pub decls: IdRange;
    pub is_emi_stub: bool;
}

pub struct ImportItemNode {
    pub span: span.Span;
    pub name: IdentSpan;
    pub alias: IdentSpan;
}

pub struct ImportNode {
    pub span: span.Span;
    pub path: IdRange;
    pub tail_kind: ImportTailKind;
    pub alias: IdentSpan;
    pub items: IdRange;
}

pub struct AttrArgNode {
    pub span: span.Span;
    pub name: IdentSpan;
    pub value: u32;
}

pub struct AttrNode {
    pub span: span.Span;
    pub name: IdentSpan;
    pub args: IdRange;
    pub has_parens: bool;
}

pub struct GenericParamNode {
    pub span: span.Span;
    pub is_comptime: bool;
    pub name: IdentSpan;
    pub comptime_ty: u32;
    pub bounds: IdRange;
}

pub struct GenericArgNode {
    pub span: span.Span;
    pub kind: GenericArgKind;
    pub node_id: u32;
    pub segs: IdRange;
}

pub struct ParamNode {
    pub span: span.Span;
    pub attrs: IdRange;
    pub is_comptime: bool;
    pub modifier: ParamModifier;
    pub name: IdentSpan;
    pub is_self: bool;
    pub access: AccessMode;
    pub ty: u32;
}

pub struct SysParamNode {
    pub span: span.Span;
    pub attrs: IdRange;
    pub is_comptime: bool;
    pub modifier: ParamModifier;
    pub name: IdentSpan;
    pub is_self: bool;
    pub access: AccessMode;
    pub ty: u32;
    pub columns: IdRange;
}

pub struct FieldNode {
    pub span: span.Span;
    pub attrs: IdRange;
    pub is_pub: bool;
    pub name: IdentSpan;
    pub ty: u32;
    pub default: u32;
}

pub struct DeclNode {
    pub span: span.Span;
    pub attrs: IdRange;
    pub is_pub: bool;
    pub kind: DeclKind;
    pub payload: u32;
}

pub struct FnDeclNode {
    pub is_comptime: bool;
    pub is_view: bool;
    pub name: IdentSpan;
    pub generics: IdRange;
    pub params: IdRange;
    pub ret_type: u32;
    pub effects: IdRange;
    pub where_clauses: IdRange;
    pub ensures_clauses: IdRange;
    pub body: u32;
    pub is_emi_stub_body: bool;
}

pub struct SysDeclNode {
    pub name: IdentSpan;
    pub generics: IdRange;
    pub params: IdRange;
    pub ret_type: u32;
    pub effects: IdRange;
    pub where_clauses: IdRange;
    pub ensures_clauses: IdRange;
    pub body: u32;
    pub is_emi_stub_body: bool;
}

pub struct StructDeclNode {
    pub is_linear: bool;
    pub is_view: bool;
    pub name: IdentSpan;
    pub generics: IdRange;
    pub where_clauses: IdRange;
    pub fields: IdRange;
}

pub struct EnumVariantNode {
    pub span: span.Span;
    pub name: IdentSpan;
    pub value: u32;
}

pub struct EnumDeclNode {
    pub name: IdentSpan;
    pub repr_int: IdentSpan;
    pub variants: IdRange;
}

pub struct UnionVariantNode {
    pub span: span.Span;
    pub name: IdentSpan;
    pub ty: u32;
}

pub struct UnionDeclNode {
    pub is_linear: bool;
    pub name: IdentSpan;
    pub generics: IdRange;
    pub where_clauses: IdRange;
    pub variants: IdRange;
}

pub struct BitfieldMemberNode {
    pub span: span.Span;
    pub name: IdentSpan;
    pub ty: IdentSpan;
    pub has_bits: bool;
    pub bits_lo: u32;
    pub bits_hi: u32;
}

pub struct BitfieldDeclNode {
    pub name: IdentSpan;
    pub base_int: IdentSpan;
    pub members: IdRange;
}

pub struct IfaceMethodNode {
    pub span: span.Span;
    pub attrs: IdRange;
    pub is_view: bool;
    pub name: IdentSpan;
    pub generics: IdRange;
    pub params: IdRange;
    pub ret_type: u32;
    pub effects: IdRange;
    pub where_clauses: IdRange;
    pub ensures_clauses: IdRange;
}

pub struct IfaceDeclNode {
    pub name: IdentSpan;
    pub generics: IdRange;
    pub methods: IdRange;
}

pub struct ImplDeclNode {
    pub generics: IdRange;
    pub iface_type: u32;
    pub target_type: u32;
    pub where_clauses: IdRange;
    pub decls: IdRange;
}

pub struct ErrorDeclNode {
    pub name: IdentSpan;
    pub variants: IdRange;
}

pub struct TypeAliasDeclNode {
    pub name: IdentSpan;
    pub generics: IdRange;
    pub where_clauses: IdRange;
    pub ty: u32;
}

pub struct ConstDeclNode {
    pub name: IdentSpan;
    pub ty: u32;
    pub value: u32;
}

pub struct ExternDeclNode {
    pub abi: u32;
    pub name: IdentSpan;
    pub params: IdRange;
    pub fields: IdRange;
    pub ret_type: u32;
}

pub struct TypeNode {
    pub span: span.Span;
    pub kind: TypeKind;
    pub is_mut: bool;
    pub borrow_target: BorrowTargetKind;
    pub primary: u32;
    pub aux: u32;
    pub list: IdRange;
    pub list2: IdRange;
}

pub fn type_zero(sp: span.Span, kind: TypeKind) -> TypeNode {
    return TypeNode.{
        span: sp,
        kind: kind,
        is_mut: false,
        borrow_target: .Single,
        primary: NONE_ID,
        aux: NONE_ID,
        list: range_empty(),
        list2: range_empty(),
    };
}

pub struct PatFieldNode {
    pub span: span.Span;
    pub name: IdentSpan;
    pub pat: u32;
}

pub struct PatNode {
    pub span: span.Span;
    pub kind: PatKind;
    pub flag: bool;
    pub has_range: bool;
    pub range_kind: RangeKind;
    pub range_neg: bool;
    pub data0: u32;
    pub data1: u32;
    pub ident: IdentSpan;
    pub list: IdRange;
    pub path_segs: IdRange;
    pub path_gens: IdRange;
}

pub fn pat_zero(sp: span.Span, kind: PatKind) -> PatNode {
    return PatNode.{
        span: sp,
        kind: kind,
        flag: false,
        has_range: false,
        range_kind: .Exclusive,
        range_neg: false,
        data0: 0_u32,
        data1: 0_u32,
        ident: ident_none(),
        list: range_empty(),
        path_segs: range_empty(),
        path_gens: range_empty(),
    };
}

pub struct BlockNode {
    pub span: span.Span;
    pub stmts: IdRange;
    pub tail_expr: u32;
}

pub struct JumpNode {
    pub kind: JumpKind;
    pub label: IdentSpan;
    pub value: u32;
}

pub struct IfNode {
    pub span: span.Span;
    pub is_comptime: bool;
    pub cond_kind: IfCondKind;
    pub cond_pat: u32;
    pub cond_expr: u32;
    pub then_block: u32;
    pub else_kind: ElseKind;
    pub else_id: u32;
}

pub struct MatchArmNode {
    pub span: span.Span;
    pub pat: u32;
    pub guard: u32;
    pub body_kind: BodyKind;
    pub body_id: u32;
}

pub struct StmtNode {
    pub span: span.Span;
    pub kind: StmtKind;
    pub assign_op: AssignOp;
    pub body_kind: BodyKind;
    pub range_kind: RangeKind;
    pub has_range: bool;
    pub ident: IdentSpan;
    pub a: u32;
    pub b: u32;
    pub c: u32;
    pub d: u32;
    pub list: IdRange;
}

pub fn stmt_zero(sp: span.Span, kind: StmtKind) -> StmtNode {
    return StmtNode.{
        span: sp,
        kind: kind,
        assign_op: .Assign,
        body_kind: .Block,
        range_kind: .Exclusive,
        has_range: false,
        ident: ident_none(),
        a: NONE_ID,
        b: NONE_ID,
        c: NONE_ID,
        d: NONE_ID,
        list: range_empty(),
    };
}

pub struct FieldInitNode {
    pub span: span.Span;
    pub name: IdentSpan;
    pub value: u32;
}

pub struct AsmOperandNode {
    pub span: span.Span;
    pub kind: AsmOperandKind;
    pub dir: IdentSpan;
    pub expr: u32;
    pub arg: u32;
}

pub struct ExprNode {
    pub span: span.Span;
    pub kind: ExprKind;
    pub flag: bool;
    pub unary_op: UnaryOp;
    pub bin_op: BinaryOp;
    pub body_kind: BodyKind;
    pub a: u32;
    pub b: u32;
    pub c: u32;
    pub ident: IdentSpan;
    pub list: IdRange;
    pub list2: IdRange;
}

pub fn expr_zero(sp: span.Span, kind: ExprKind) -> ExprNode {
    return ExprNode.{
        span: sp,
        kind: kind,
        flag: false,
        unary_op: .Neg,
        bin_op: .Add,
        body_kind: .Expr,
        a: NONE_ID,
        b: NONE_ID,
        c: NONE_ID,
        ident: ident_none(),
        list: range_empty(),
        list2: range_empty(),
    };
}

// ---------------------------------------------------------------------------
// Linear Sub-Pools (kept compact to stay well inside stack/DBM bounds)
// ---------------------------------------------------------------------------

pub linear struct AstMetaPools {
    pub units: col.DynBuf[UnitNode];
    pub imports: col.DynBuf[ImportNode];
    pub import_items: col.DynBuf[ImportItemNode];
    pub attrs: col.DynBuf[AttrNode];
    pub attr_args: col.DynBuf[AttrArgNode];
    pub idents: col.DynBuf[IdentSpan];
    pub generic_params: col.DynBuf[GenericParamNode];
    pub generic_args: col.DynBuf[GenericArgNode];
    pub params: col.DynBuf[ParamNode];
    pub sys_params: col.DynBuf[SysParamNode];
    pub fields: col.DynBuf[FieldNode];
}

impl AstMetaPools {
    pub fn init(alloc: *mut AllocCap) -> AstMetaPools ! OutOfMemory {
        let units = try col.DynBuf.[UnitNode].init(alloc, 4_usize);
        errdefer units.destroy(alloc);
        let imports = try col.DynBuf.[ImportNode].init(alloc, 16_usize);
        errdefer imports.destroy(alloc);
        let import_items = try col.DynBuf.[ImportItemNode].init(alloc, 16_usize);
        errdefer import_items.destroy(alloc);
        let attrs = try col.DynBuf.[AttrNode].init(alloc, 16_usize);
        errdefer attrs.destroy(alloc);
        let attr_args = try col.DynBuf.[AttrArgNode].init(alloc, 16_usize);
        errdefer attr_args.destroy(alloc);
        let idents = try col.DynBuf.[IdentSpan].init(alloc, 64_usize);
        errdefer idents.destroy(alloc);
        let generic_params = try col.DynBuf.[GenericParamNode].init(alloc, 16_usize);
        errdefer generic_params.destroy(alloc);
        let generic_args = try col.DynBuf.[GenericArgNode].init(alloc, 32_usize);
        errdefer generic_args.destroy(alloc);
        let params = try col.DynBuf.[ParamNode].init(alloc, 64_usize);
        errdefer params.destroy(alloc);
        let sys_params = try col.DynBuf.[SysParamNode].init(alloc, 8_usize);
        errdefer sys_params.destroy(alloc);
        let fields = try col.DynBuf.[FieldNode].init(alloc, 64_usize);
        errdefer fields.destroy(alloc);
        return AstMetaPools.{
            units: units,
            imports: imports,
            import_items: import_items,
            attrs: attrs,
            attr_args: attr_args,
            idents: idents,
            generic_params: generic_params,
            generic_args: generic_args,
            params: params,
            sys_params: sys_params,
            fields: fields,
        };
    }

    pub fn destroy(self: AstMetaPools, alloc: *mut AllocCap) {
        let AstMetaPools.{
            units,
            imports,
            import_items,
            attrs,
            attr_args,
            idents,
            generic_params,
            generic_args,
            params,
            sys_params,
            fields,
        } = self;
        units.destroy(alloc);
        imports.destroy(alloc);
        import_items.destroy(alloc);
        attrs.destroy(alloc);
        attr_args.destroy(alloc);
        idents.destroy(alloc);
        generic_params.destroy(alloc);
        generic_args.destroy(alloc);
        params.destroy(alloc);
        sys_params.destroy(alloc);
        fields.destroy(alloc);
    }

    pub fn release_pools(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.units.reset_free(alloc, 4_usize);
        try self.imports.reset_free(alloc, 4_usize);
        try self.import_items.reset_free(alloc, 4_usize);
        try self.attrs.reset_free(alloc, 4_usize);
        try self.attr_args.reset_free(alloc, 4_usize);
        try self.idents.reset_free(alloc, 4_usize);
        try self.generic_params.reset_free(alloc, 4_usize);
        try self.generic_args.reset_free(alloc, 4_usize);
        try self.params.reset_free(alloc, 4_usize);
        try self.sys_params.reset_free(alloc, 4_usize);
        try self.fields.reset_free(alloc, 4_usize);
        return;
    }
}

pub linear struct AstDeclCorePools {
    pub decls: col.DynBuf[DeclNode];
    pub decl_lists: col.DynBuf[u32];
    pub fn_decls: col.DynBuf[FnDeclNode];
    pub sys_decls: col.DynBuf[SysDeclNode];
    pub struct_decls: col.DynBuf[StructDeclNode];
    pub impl_decls: col.DynBuf[ImplDeclNode];
    pub type_decls: col.DynBuf[TypeAliasDeclNode];
    pub const_decls: col.DynBuf[ConstDeclNode];
    pub extern_decls: col.DynBuf[ExternDeclNode];
}

impl AstDeclCorePools {
    pub fn init(alloc: *mut AllocCap) -> AstDeclCorePools ! OutOfMemory {
        let decls = try col.DynBuf.[DeclNode].init(alloc, 64_usize);
        errdefer decls.destroy(alloc);
        let decl_lists = try col.DynBuf.[u32].init(alloc, 64_usize);
        errdefer decl_lists.destroy(alloc);
        let fn_decls = try col.DynBuf.[FnDeclNode].init(alloc, 32_usize);
        errdefer fn_decls.destroy(alloc);
        let sys_decls = try col.DynBuf.[SysDeclNode].init(alloc, 4_usize);
        errdefer sys_decls.destroy(alloc);
        let struct_decls = try col.DynBuf.[StructDeclNode].init(alloc, 16_usize);
        errdefer struct_decls.destroy(alloc);
        let impl_decls = try col.DynBuf.[ImplDeclNode].init(alloc, 16_usize);
        errdefer impl_decls.destroy(alloc);
        let type_decls = try col.DynBuf.[TypeAliasDeclNode].init(alloc, 8_usize);
        errdefer type_decls.destroy(alloc);
        let const_decls = try col.DynBuf.[ConstDeclNode].init(alloc, 16_usize);
        errdefer const_decls.destroy(alloc);
        let extern_decls = try col.DynBuf.[ExternDeclNode].init(alloc, 8_usize);
        errdefer extern_decls.destroy(alloc);
        return AstDeclCorePools.{
            decls: decls,
            decl_lists: decl_lists,
            fn_decls: fn_decls,
            sys_decls: sys_decls,
            struct_decls: struct_decls,
            impl_decls: impl_decls,
            type_decls: type_decls,
            const_decls: const_decls,
            extern_decls: extern_decls,
        };
    }

    pub fn destroy(self: AstDeclCorePools, alloc: *mut AllocCap) {
        let AstDeclCorePools.{
            decls,
            decl_lists,
            fn_decls,
            sys_decls,
            struct_decls,
            impl_decls,
            type_decls,
            const_decls,
            extern_decls,
        } = self;
        decls.destroy(alloc);
        decl_lists.destroy(alloc);
        fn_decls.destroy(alloc);
        sys_decls.destroy(alloc);
        struct_decls.destroy(alloc);
        impl_decls.destroy(alloc);
        type_decls.destroy(alloc);
        const_decls.destroy(alloc);
        extern_decls.destroy(alloc);
    }

    pub fn release_pools(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.decls.reset_free(alloc, 4_usize);
        try self.decl_lists.reset_free(alloc, 4_usize);
        try self.fn_decls.reset_free(alloc, 4_usize);
        try self.sys_decls.reset_free(alloc, 4_usize);
        try self.struct_decls.reset_free(alloc, 4_usize);
        try self.impl_decls.reset_free(alloc, 4_usize);
        try self.type_decls.reset_free(alloc, 4_usize);
        try self.const_decls.reset_free(alloc, 4_usize);
        try self.extern_decls.reset_free(alloc, 4_usize);
        return;
    }
}

pub linear struct AstDeclTypePools {
    pub enum_decls: col.DynBuf[EnumDeclNode];
    pub enum_variants: col.DynBuf[EnumVariantNode];
    pub union_decls: col.DynBuf[UnionDeclNode];
    pub union_variants: col.DynBuf[UnionVariantNode];
    pub bitfield_decls: col.DynBuf[BitfieldDeclNode];
    pub bitfield_members: col.DynBuf[BitfieldMemberNode];
    pub iface_decls: col.DynBuf[IfaceDeclNode];
    pub iface_methods: col.DynBuf[IfaceMethodNode];
    pub error_decls: col.DynBuf[ErrorDeclNode];
}

impl AstDeclTypePools {
    pub fn init(alloc: *mut AllocCap) -> AstDeclTypePools ! OutOfMemory {
        let enum_decls = try col.DynBuf.[EnumDeclNode].init(alloc, 8_usize);
        errdefer enum_decls.destroy(alloc);
        let enum_variants = try col.DynBuf.[EnumVariantNode].init(alloc, 32_usize);
        errdefer enum_variants.destroy(alloc);
        let union_decls = try col.DynBuf.[UnionDeclNode].init(alloc, 8_usize);
        errdefer union_decls.destroy(alloc);
        let union_variants = try col.DynBuf.[UnionVariantNode].init(alloc, 16_usize);
        errdefer union_variants.destroy(alloc);
        let bitfield_decls = try col.DynBuf.[BitfieldDeclNode].init(alloc, 4_usize);
        errdefer bitfield_decls.destroy(alloc);
        let bitfield_members = try col.DynBuf.[BitfieldMemberNode].init(alloc, 8_usize);
        errdefer bitfield_members.destroy(alloc);
        let iface_decls = try col.DynBuf.[IfaceDeclNode].init(alloc, 8_usize);
        errdefer iface_decls.destroy(alloc);
        let iface_methods = try col.DynBuf.[IfaceMethodNode].init(alloc, 16_usize);
        errdefer iface_methods.destroy(alloc);
        let error_decls = try col.DynBuf.[ErrorDeclNode].init(alloc, 8_usize);
        errdefer error_decls.destroy(alloc);
        return AstDeclTypePools.{
            enum_decls: enum_decls,
            enum_variants: enum_variants,
            union_decls: union_decls,
            union_variants: union_variants,
            bitfield_decls: bitfield_decls,
            bitfield_members: bitfield_members,
            iface_decls: iface_decls,
            iface_methods: iface_methods,
            error_decls: error_decls,
        };
    }

    pub fn destroy(self: AstDeclTypePools, alloc: *mut AllocCap) {
        let AstDeclTypePools.{
            enum_decls,
            enum_variants,
            union_decls,
            union_variants,
            bitfield_decls,
            bitfield_members,
            iface_decls,
            iface_methods,
            error_decls,
        } = self;
        enum_decls.destroy(alloc);
        enum_variants.destroy(alloc);
        union_decls.destroy(alloc);
        union_variants.destroy(alloc);
        bitfield_decls.destroy(alloc);
        bitfield_members.destroy(alloc);
        iface_decls.destroy(alloc);
        iface_methods.destroy(alloc);
        error_decls.destroy(alloc);
    }

    pub fn release_pools(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.enum_decls.reset_free(alloc, 4_usize);
        try self.enum_variants.reset_free(alloc, 4_usize);
        try self.union_decls.reset_free(alloc, 4_usize);
        try self.union_variants.reset_free(alloc, 4_usize);
        try self.bitfield_decls.reset_free(alloc, 4_usize);
        try self.bitfield_members.reset_free(alloc, 4_usize);
        try self.iface_decls.reset_free(alloc, 4_usize);
        try self.iface_methods.reset_free(alloc, 4_usize);
        try self.error_decls.reset_free(alloc, 4_usize);
        return;
    }
}

pub linear struct AstStmtPatPools {
    pub types: col.DynBuf[TypeNode];
    pub type_lists: col.DynBuf[u32];
    pub pats: col.DynBuf[PatNode];
    pub pat_lists: col.DynBuf[u32];
    pub pat_fields: col.DynBuf[PatFieldNode];
    pub stmts: col.DynBuf[StmtNode];
    pub stmt_lists: col.DynBuf[u32];
    pub blocks: col.DynBuf[BlockNode];
    pub jumps: col.DynBuf[JumpNode];
    pub if_nodes: col.DynBuf[IfNode];
    pub match_arms: col.DynBuf[MatchArmNode];
}

impl AstStmtPatPools {
    pub fn init(alloc: *mut AllocCap) -> AstStmtPatPools ! OutOfMemory {
        let types = try col.DynBuf.[TypeNode].init(alloc, 128_usize);
        errdefer types.destroy(alloc);
        let type_lists = try col.DynBuf.[u32].init(alloc, 64_usize);
        errdefer type_lists.destroy(alloc);
        let pats = try col.DynBuf.[PatNode].init(alloc, 64_usize);
        errdefer pats.destroy(alloc);
        let pat_lists = try col.DynBuf.[u32].init(alloc, 32_usize);
        errdefer pat_lists.destroy(alloc);
        let pat_fields = try col.DynBuf.[PatFieldNode].init(alloc, 16_usize);
        errdefer pat_fields.destroy(alloc);
        let stmts = try col.DynBuf.[StmtNode].init(alloc, 256_usize);
        errdefer stmts.destroy(alloc);
        let stmt_lists = try col.DynBuf.[u32].init(alloc, 256_usize);
        errdefer stmt_lists.destroy(alloc);
        let blocks = try col.DynBuf.[BlockNode].init(alloc, 64_usize);
        errdefer blocks.destroy(alloc);
        let jumps = try col.DynBuf.[JumpNode].init(alloc, 32_usize);
        errdefer jumps.destroy(alloc);
        let if_nodes = try col.DynBuf.[IfNode].init(alloc, 32_usize);
        errdefer if_nodes.destroy(alloc);
        let match_arms = try col.DynBuf.[MatchArmNode].init(alloc, 32_usize);
        errdefer match_arms.destroy(alloc);
        return AstStmtPatPools.{
            types: types,
            type_lists: type_lists,
            pats: pats,
            pat_lists: pat_lists,
            pat_fields: pat_fields,
            stmts: stmts,
            stmt_lists: stmt_lists,
            blocks: blocks,
            jumps: jumps,
            if_nodes: if_nodes,
            match_arms: match_arms,
        };
    }

    pub fn destroy(self: AstStmtPatPools, alloc: *mut AllocCap) {
        let AstStmtPatPools.{
            types,
            type_lists,
            pats,
            pat_lists,
            pat_fields,
            stmts,
            stmt_lists,
            blocks,
            jumps,
            if_nodes,
            match_arms,
        } = self;
        types.destroy(alloc);
        type_lists.destroy(alloc);
        pats.destroy(alloc);
        pat_lists.destroy(alloc);
        pat_fields.destroy(alloc);
        stmts.destroy(alloc);
        stmt_lists.destroy(alloc);
        blocks.destroy(alloc);
        jumps.destroy(alloc);
        if_nodes.destroy(alloc);
        match_arms.destroy(alloc);
    }

    pub fn release_pools(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.types.reset_free(alloc, 4_usize);
        try self.type_lists.reset_free(alloc, 4_usize);
        try self.pats.reset_free(alloc, 4_usize);
        try self.pat_lists.reset_free(alloc, 4_usize);
        try self.pat_fields.reset_free(alloc, 4_usize);
        try self.stmts.reset_free(alloc, 4_usize);
        try self.stmt_lists.reset_free(alloc, 4_usize);
        try self.blocks.reset_free(alloc, 4_usize);
        try self.jumps.reset_free(alloc, 4_usize);
        try self.if_nodes.reset_free(alloc, 4_usize);
        try self.match_arms.reset_free(alloc, 4_usize);
        return;
    }
}

pub linear struct AstExprPools {
    pub exprs: col.DynBuf[ExprNode];
    pub expr_lists: col.DynBuf[u32];
    pub field_inits: col.DynBuf[FieldInitNode];
    pub asm_ops: col.DynBuf[AsmOperandNode];
