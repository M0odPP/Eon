        return range_new(start, src.len.trunc.[u32]());
    }

    pub fn push_str_bytes(self: *mut Self, alloc: *mut AllocCap, src: *[u8]) -> IdRange ! OutOfMemory {
        let start = self.expr_pools.str_bytes.len().trunc.[u32]();
        try self.expr_pools.str_bytes.push_slice(alloc, src);
        return range_new(start, src.len.trunc.[u32]());
    }

    pub fn push_byte_bytes(self: *mut Self, alloc: *mut AllocCap, src: *[u8]) -> IdRange ! OutOfMemory {
        let start = self.expr_pools.byte_bytes.len().trunc.[u32]();
        try self.expr_pools.byte_bytes.push_slice(alloc, src);
        return range_new(start, src.len.trunc.[u32]());
    }

    // --- Single-node view getters ---

    pub view fn get_unit(self: *Self, id: u32) -> ?*UnitNode {
        return self.meta.units.get(id.widen.[usize]());
    }

    pub fn mark_unit_emi_stub(self: *mut Self, id: u32) {
        let us = self.meta.units.as_mut_slice();
        let idx = id.widen.[usize]();
        if idx < us.len {
            us[idx].is_emi_stub = true;
        }
    }

    pub fn mark_fn_emi_stub_body(self: *mut Self, id: u32) {
        let fs = self.decl_core.fn_decls.as_mut_slice();
        let idx = id.widen.[usize]();
        if idx < fs.len {
            fs[idx].is_emi_stub_body = true;
        }
    }

    pub view fn get_decl(self: *Self, id: u32) -> ?*DeclNode {
        return self.decl_core.decls.get(id.widen.[usize]());
    }

    pub view fn get_fn_decl(self: *Self, id: u32) -> ?*FnDeclNode {
        return self.decl_core.fn_decls.get(id.widen.[usize]());
    }

