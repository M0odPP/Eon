    pub byte_bytes: col.DynBuf[u8];
}

impl AstExprPools {
    pub fn init(alloc: *mut AllocCap) -> AstExprPools ! OutOfMemory {
        let exprs = try col.DynBuf.[ExprNode].init(alloc, 512_usize);
        errdefer exprs.destroy(alloc);
        let expr_lists = try col.DynBuf.[u32].init(alloc, 256_usize);
        errdefer expr_lists.destroy(alloc);
        let field_inits = try col.DynBuf.[FieldInitNode].init(alloc, 64_usize);
        errdefer field_inits.destroy(alloc);
        let asm_ops = try col.DynBuf.[AsmOperandNode].init(alloc, 8_usize);
        errdefer asm_ops.destroy(alloc);
        let str_bytes = try col.DynBuf.[u8].init(alloc, 256_usize);
        errdefer str_bytes.destroy(alloc);
        let byte_bytes = try col.DynBuf.[u8].init(alloc, 64_usize);
        errdefer byte_bytes.destroy(alloc);
        return AstExprPools.{
            exprs: exprs,
            expr_lists: expr_lists,
            field_inits: field_inits,
            asm_ops: asm_ops,
            str_bytes: str_bytes,
            byte_bytes: byte_bytes,
        };
    }

    pub fn destroy(self: AstExprPools, alloc: *mut AllocCap) {
        let AstExprPools.{
            exprs,
            expr_lists,
            field_inits,
            asm_ops,
            str_bytes,
            byte_bytes,
        } = self;
        exprs.destroy(alloc);
        expr_lists.destroy(alloc);
        field_inits.destroy(alloc);
        asm_ops.destroy(alloc);
        str_bytes.destroy(alloc);
        byte_bytes.destroy(alloc);
    }

    pub fn release_pools(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.exprs.reset_free(alloc, 4_usize);
        try self.expr_lists.reset_free(alloc, 4_usize);
        try self.field_inits.reset_free(alloc, 4_usize);
        try self.asm_ops.reset_free(alloc, 4_usize);
        try self.str_bytes.reset_free(alloc, 4_usize);
        try self.byte_bytes.reset_free(alloc, 4_usize);
        return;
    }
}

// ---------------------------------------------------------------------------
// Generic Slice Helper & Top-Level AstArena
// ---------------------------------------------------------------------------

view fn slice_range[T](all: *[T], r: IdRange) -> *[T] {
    let start = r.start.widen.[usize]();
    let end = start +% r.len.widen.[usize]();
    let s = all.sub(start, end) catch {
        return all.sub(0_usize, 0_usize) catch {
            return all;
        };
    };
    return s;
}

pub linear struct AstArena {
    pub meta: AstMetaPools;
    pub decl_core: AstDeclCorePools;
    pub decl_types: AstDeclTypePools;
    pub stmt_pat: AstStmtPatPools;
    pub expr_pools: AstExprPools;
}

impl AstArena {
    pub fn init(alloc: *mut AllocCap) -> AstArena ! OutOfMemory {
        let meta = try AstMetaPools.init(alloc);
        errdefer meta.destroy(alloc);
        let decl_core = try AstDeclCorePools.init(alloc);
        errdefer decl_core.destroy(alloc);
        let decl_types = try AstDeclTypePools.init(alloc);
        errdefer decl_types.destroy(alloc);
        let stmt_pat = try AstStmtPatPools.init(alloc);
        errdefer stmt_pat.destroy(alloc);
        let expr_pools = try AstExprPools.init(alloc);
        errdefer expr_pools.destroy(alloc);
        return AstArena.{
            meta: meta,
            decl_core: decl_core,
            decl_types: decl_types,
            stmt_pat: stmt_pat,
            expr_pools: expr_pools,
        };
    }

    pub fn destroy(self: AstArena, alloc: *mut AllocCap) {
        let AstArena.{ meta, decl_core, decl_types, stmt_pat, expr_pools } = self;
        meta.destroy(alloc);
        decl_core.destroy(alloc);
        decl_types.destroy(alloc);
        stmt_pat.destroy(alloc);
        expr_pools.destroy(alloc);
    }

    pub fn release_non_expr_pools(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.meta.release_pools(alloc);
        try self.decl_core.release_pools(alloc);
        try self.decl_types.release_pools(alloc);
        try self.stmt_pat.release_pools(alloc);
        return;
    }

    pub fn release_all_pools(self: *mut Self, alloc: *mut AllocCap) -> !OutOfMemory {
        try self.release_non_expr_pools(alloc);
        try self.expr_pools.release_pools(alloc);
        return;
    }

    // --- Single-node builders ---

    pub fn add_unit(self: *mut Self, alloc: *mut AllocCap, node: UnitNode) -> u32 ! OutOfMemory {
        let id = self.meta.units.len().trunc.[u32]();
        try self.meta.units.push(alloc, node);
        return id;
    }

    pub fn add_decl(self: *mut Self, alloc: *mut AllocCap, node: DeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_core.decls.len().trunc.[u32]();
        try self.decl_core.decls.push(alloc, node);
        return id;
    }

    pub fn add_fn_decl(self: *mut Self, alloc: *mut AllocCap, node: FnDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_core.fn_decls.len().trunc.[u32]();
        try self.decl_core.fn_decls.push(alloc, node);
        return id;
    }

    pub fn add_sys_decl(self: *mut Self, alloc: *mut AllocCap, node: SysDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_core.sys_decls.len().trunc.[u32]();
        try self.decl_core.sys_decls.push(alloc, node);
        return id;
    }

    pub fn add_struct_decl(self: *mut Self, alloc: *mut AllocCap, node: StructDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_core.struct_decls.len().trunc.[u32]();
        try self.decl_core.struct_decls.push(alloc, node);
        return id;
    }

    pub fn add_enum_decl(self: *mut Self, alloc: *mut AllocCap, node: EnumDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_types.enum_decls.len().trunc.[u32]();
        try self.decl_types.enum_decls.push(alloc, node);
        return id;
    }

    pub fn add_union_decl(self: *mut Self, alloc: *mut AllocCap, node: UnionDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_types.union_decls.len().trunc.[u32]();
        try self.decl_types.union_decls.push(alloc, node);
        return id;
    }

    pub fn add_bitfield_decl(self: *mut Self, alloc: *mut AllocCap, node: BitfieldDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_types.bitfield_decls.len().trunc.[u32]();
        try self.decl_types.bitfield_decls.push(alloc, node);
        return id;
    }

    pub fn add_iface_decl(self: *mut Self, alloc: *mut AllocCap, node: IfaceDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_types.iface_decls.len().trunc.[u32]();
        try self.decl_types.iface_decls.push(alloc, node);
        return id;
    }

    pub fn add_impl_decl(self: *mut Self, alloc: *mut AllocCap, node: ImplDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_core.impl_decls.len().trunc.[u32]();
        try self.decl_core.impl_decls.push(alloc, node);
        return id;
    }

    pub fn add_error_decl(self: *mut Self, alloc: *mut AllocCap, node: ErrorDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_types.error_decls.len().trunc.[u32]();
        try self.decl_types.error_decls.push(alloc, node);
        return id;
    }

    pub fn add_type_decl(self: *mut Self, alloc: *mut AllocCap, node: TypeAliasDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_core.type_decls.len().trunc.[u32]();
        try self.decl_core.type_decls.push(alloc, node);
        return id;
    }

    pub fn add_const_decl(self: *mut Self, alloc: *mut AllocCap, node: ConstDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_core.const_decls.len().trunc.[u32]();
        try self.decl_core.const_decls.push(alloc, node);
        return id;
    }

    pub fn add_extern_decl(self: *mut Self, alloc: *mut AllocCap, node: ExternDeclNode) -> u32 ! OutOfMemory {
        let id = self.decl_core.extern_decls.len().trunc.[u32]();
        try self.decl_core.extern_decls.push(alloc, node);
        return id;
    }

    pub fn add_type(self: *mut Self, alloc: *mut AllocCap, node: TypeNode) -> u32 ! OutOfMemory {
        let id = self.stmt_pat.types.len().trunc.[u32]();
        try self.stmt_pat.types.push(alloc, node);
        return id;
    }

    pub fn add_pat(self: *mut Self, alloc: *mut AllocCap, node: PatNode) -> u32 ! OutOfMemory {
        let id = self.stmt_pat.pats.len().trunc.[u32]();
        try self.stmt_pat.pats.push(alloc, node);
        return id;
    }

    pub fn add_stmt(self: *mut Self, alloc: *mut AllocCap, node: StmtNode) -> u32 ! OutOfMemory {
        let id = self.stmt_pat.stmts.len().trunc.[u32]();
        try self.stmt_pat.stmts.push(alloc, node);
        return id;
    }

    pub fn add_block(self: *mut Self, alloc: *mut AllocCap, node: BlockNode) -> u32 ! OutOfMemory {
        let id = self.stmt_pat.blocks.len().trunc.[u32]();
        try self.stmt_pat.blocks.push(alloc, node);
        return id;
    }

    pub fn add_jump(self: *mut Self, alloc: *mut AllocCap, node: JumpNode) -> u32 ! OutOfMemory {
        let id = self.stmt_pat.jumps.len().trunc.[u32]();
        try self.stmt_pat.jumps.push(alloc, node);
        return id;
    }

    pub fn add_if(self: *mut Self, alloc: *mut AllocCap, node: IfNode) -> u32 ! OutOfMemory {
        let id = self.stmt_pat.if_nodes.len().trunc.[u32]();
        try self.stmt_pat.if_nodes.push(alloc, node);
        return id;
    }

    pub fn add_expr(self: *mut Self, alloc: *mut AllocCap, node: ExprNode) -> u32 ! OutOfMemory {
        let id = self.expr_pools.exprs.len().trunc.[u32]();
        try self.expr_pools.exprs.push(alloc, node);
        return id;
    }

    // --- Slice / range committers ---

    pub fn push_imports(self: *mut Self, alloc: *mut AllocCap, src: *[ImportNode]) -> IdRange ! OutOfMemory {
        let start = self.meta.imports.len().trunc.[u32]();
        try self.meta.imports.push_slice(alloc, src);
        return range_new(start, src.len.trunc.[u32]());
    }

    pub fn push_import_items(self: *mut Self, alloc: *mut AllocCap, src: *[ImportItemNode]) -> IdRange ! OutOfMemory {
        let start = self.meta.import_items.len().trunc.[u32]();
        try self.meta.import_items.push_slice(alloc, src);
        return range_new(start, src.len.trunc.[u32]());
    }

    pub fn push_attrs(self: *mut Self, alloc: *mut AllocCap, src: *[AttrNode]) -> IdRange ! OutOfMemory {
        let start = self.meta.attrs.len().trunc.[u32]();
