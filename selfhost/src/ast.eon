module eonc.ast;

import core.col;
import core.str;
import eonc.span;

// ---------------------------------------------------------------------------
// Constants and Core Value Types
// ---------------------------------------------------------------------------

pub const NONE_ID: u32 = 4294967295_u32;

pub struct IdRange {
    pub start: u32;
    pub len: u32;
}

pub fn range_empty() -> IdRange {
    return IdRange.{ start: 0_u32, len: 0_u32 };
}

pub fn range_new(start: u32, len: u32) -> IdRange {
    return IdRange.{ start: start, len: len };
}

pub struct IdentSpan {
    pub sym: u32;
    pub span: span.Span;
}

pub fn ident_new(sym: u32, sp: span.Span) -> IdentSpan {
    return IdentSpan.{ sym: sym, span: sp };
}

pub fn ident_none() -> IdentSpan {
    return IdentSpan.{ sym: NONE_ID, span: span.span_dummy() };
}

pub fn ident_is_some(id: IdentSpan) -> bool {
    return id.sym != NONE_ID;
}

pub struct TypePath {
    pub segments: IdRange;
    pub generics: IdRange;
}

pub fn type_path_empty() -> TypePath {
    return TypePath.{ segments: range_empty(), generics: range_empty() };
}

pub fn type_path_new(segments: IdRange, generics: IdRange) -> TypePath {
    return TypePath.{ segments: segments, generics: generics };
}

// ---------------------------------------------------------------------------
// AST Enums
// ---------------------------------------------------------------------------

pub enum ImportTailKind : u8 {
    None = 0,
    Alias = 1,
    Items = 2,
}

pub enum ParamModifier : u8 {
    None = 0,
    Mut = 1,
    From = 2,
}

pub enum AccessMode : u8 {
    None = 0,
    Read = 1,
    Write = 2,
}

pub enum DeclKind : u8 {
    Fn = 0,
    Sys = 1,
    Struct = 2,
    Pool = 3,
    Enum = 4,
    Union = 5,
    Bitfield = 6,
    Iface = 7,
    Impl = 8,
    Error = 9,
    TypeAlias = 10,
    Const = 11,
    ExternFn = 12,
    ExternStruct = 13,
    ExternUnion = 14,
}

pub enum GenericArgKind : u8 {
    Type = 0,
    Expr = 1,
    TypeOrConst = 2,
}

pub enum BorrowTargetKind : u8 {
    Single = 0,
    Slice = 1,
    Str = 2,
}

pub enum TypeKind : u8 {
    ErrorUnion = 0,
    Optional = 1,
    Borrow = 2,
    Array = 3,
    Dyn = 4,
    FnPtr = 5,
    InlineStruct = 6,
    Tuple = 7,
    Void = 8,
    Never = 9,
    TypeType = 10,
    SelfType = 11,
    Inferred = 12,
    Path = 13,
    Error = 14,
}

pub enum RangeKind : u8 {
    Exclusive = 0,
    Inclusive = 1,
}

pub enum BodyKind : u8 {
    Block = 0,
    Expr = 1,
    Jump = 2,
}

pub enum JumpKind : u8 {
    Return = 0,
    Break = 1,
    Continue = 2,
    Unreachable = 3,
}

pub enum IfCondKind : u8 {
    Expr = 0,
    Let = 1,
}

pub enum ElseKind : u8 {
    None = 0,
    Block = 1,
    If = 2,
}

pub enum AssignOp : u8 {
    Assign = 0,
    AddAssign = 1,
    SubAssign = 2,
    MulAssign = 3,
    AddWrapAssign = 4,
    SubWrapAssign = 5,
    MulWrapAssign = 6,
    AddSatAssign = 7,
    SubSatAssign = 8,
    MulSatAssign = 9,
    BitAndAssign = 10,
    BitOrAssign = 11,
    BitXorAssign = 12,
    ShlAssign = 13,
    ShrAssign = 14,
}

pub enum UnaryOp : u8 {
    Neg = 0,
    Not = 1,
    BitNot = 2,
    Borrow = 3,
    BorrowMut = 4,
    Move = 5,
    Copy = 6,
    Try = 7,
}

pub enum BinaryOp : u8 {
    Or = 0,
    And = 1,
    Eq = 2,
    NotEq = 3,
    Lt = 4,
    LtEq = 5,
    Gt = 6,
    GtEq = 7,
    BitOr = 8,
    BitXor = 9,
    BitAnd = 10,
    Shl = 11,
    Shr = 12,
    ShlWrap = 13,
    Add = 14,
    Sub = 15,
    AddWrap = 16,
    SubWrap = 17,
    AddSat = 18,
    SubSat = 19,
    AddCheck = 20,
    SubCheck = 21,
    Mul = 22,
    Div = 23,
    Mod = 24,
    MulWrap = 25,
    MulSat = 26,
    MulCheck = 27,
    DivCheck = 28,
    ModCheck = 29,
}

pub enum StmtKind : u8 {
    Let = 0,
    Var = 1,
    Const = 2,
    Defer = 3,
    Errdefer = 4,
    Jump = 5,
    If = 6,
    Match = 7,
    While = 8,
    For = 9,
    ParFor = 10,
    Loop = 11,
    ComptimeBlock = 12,
    RawBlock = 13,
    Assign = 14,
