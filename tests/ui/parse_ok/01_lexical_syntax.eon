//! Module documentation comment
module tests.lexical_and_syntax;

/// Outer doc comment on constant.
pub const SHADER_DOC: *str =
    \\First raw line with "quotes" and \backslashes\
    \\Second raw line
;

pub const BYTES: *[4]u8 = b"\xDE\xAD\xBE\xEF";
pub const BYTE_CH: u8 = b'a';
pub const UNICODE_CH: char = 'Ж';
pub const EMOJI_CH: char = '\u{1F680}';
pub const HEX_FLOAT: f64 = 0x1.fp+3;
pub const DEC_FLOAT: f64 = 1.0e-9;
pub const BIG_INT: u64 = 1_000_000_u64;
pub const MIN_I64: i64 = -9223372036854775808_i64;
pub const BIN_OCT: u32 = 0b1010_0101_u32 +% 0o755_u32;

/* Nested /* block /* comments */ work */ cleanly */
pub fn clamp_byte(x: u32) -> u8 {
    if x > 255_u32 {
        return 255_u8;
    }
    return x.trunc.[u8]();
}

pub fn labels_and_if_let(parent: ?u32) -> u32 {
    if let p = parent {
        return p;
    } else {
        'outer: for i in 0_u32..10_u32 {
            if i == 5_u32 {
                break 'outer;
            }
        }
    }
    let val = 'blk: loop {
        break 'blk 42_u32;
    };
    return val;
}
