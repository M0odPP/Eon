module ui.render;

@layout(std430)
pub struct Quad {
    pub rect:   f32x4;
    pub color:  f32x4;
    pub radius: f32;
    pub _pad:   [3]f32;
}

@gpu(.Compute, local_size = (8, 8, 1))
pub fn render_tiles(
    @binding(0, 0) quads:   read  GpuBuf[Quad],
    @binding(0, 1) out_img: write GpuImage2D[u8x4],
    @push_const    screen:  u32x2,
) {
    @gpu_shared var tile: [64]f32 = [0.0_f32; 64];
    let px = @gpu_global_id().xy;
    if px.x >= screen.x || px.y >= screen.y {
        return;
    }
    @gpu_workgroup_barrier();
    let q = quads[0_usize];
    tile[0_usize] = q.radius;
    out_img.store(px, u8x4.{ 255_u8, 0_u8, 0_u8, 255_u8 });
}
