module example.ownership_ok;

pub linear struct PhysPage {
    base: PhysAddr;
}

impl[T] SlotPool[T] {
    pub view fn get(self: *Self, id: GenId[T]) -> ?*T {
        return null;
    }
    pub view fn get_mut(self: *mut Self, id: GenId[T]) -> ?*mut T {
        return null;
    }
}

pub fn free_page(page: PhysPage, pmm: *mut Pmm) {
    let PhysPage.{ base } = page;
    pmm.release_frame(base);
}

pub fn map_two_pages(pmm: *mut Pmm, vmm: *mut Vmm) -> (PhysPage, PhysPage) ! MemError {
    let p1 = try pmm.alloc_page();
    errdefer pmm.free_page(p1);

    let p2 = try pmm.alloc_page();
    errdefer pmm.free_page(p2);

    try vmm.map(&p1, &p2);
    return (p1, p2);
}

pub fn drain_pages(pages: LinearBuf[PhysPage], alloc: *mut AllocCap, pmm: *mut Pmm) {
    pages.drain(alloc, |page| {
        pmm.free_page(page);
    });
}

pub fn move_widget(p: *mut ArenaPool[Widget], id: Id[p], dx: f32) {
    p.pos[id].x = p.pos[id].x + dx;
}

pub fn use_arena_pool(frame_arena: *mut Arena) ! MemError {
    var ui = try ArenaPool.[Widget].init(frame_arena, 1024_usize);
    let panel: Id[ui] = try ui.push(.{
        pos: .{ 0.0, 0.0 },
        size: .{ 800.0, 48.0 },
        color: .{ 24, 24, 28, 255 },
        flags: 0_u32,
        parent: null,
    });
    ui.pos[panel] = .{ 10.0, 20.0 };
    return;
}

pub fn swap_fields(p: *mut struct { a: u32; b: u32; }) {
    let tmp = p.a;
    p.a = p.b;
    p.b = tmp;
}

pub fn pass_disjoint(a: *mut u32, b: *mut u32) {
    a.* = a.* +% 1_u32;
    b.* = b.* +% 2_u32;
}

pub fn caller() {
    var pair = .{ a: 1_u32, b: 2_u32 };
    pass_disjoint(&mut pair.a, &mut pair.b);
}
