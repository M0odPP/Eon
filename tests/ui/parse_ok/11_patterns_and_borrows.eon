module tests.patterns_and_borrows;

pub fn pattern_cases(x: i32, c: char, opt: ?u32) -> i32 {
    let a = match x {
        -100..=-1 => -1_i32,
        0 => 0_i32,
        1..10 => 1_i32,
        _ => 2_i32,
    };
    let b = match c {
        'a'..='z' => 1_i32,
        '0'..='9' => 2_i32,
        _ => 0_i32,
    };
    let d = match opt {
        null => 0_i32,
        _ => 1_i32,
    };
    return a +% b +% d;
}

pub fn borrow_arrays(
    slice: *[u8],
    mut_slice: *mut [u8],
    arr: *[16]u8,
    mut_arr: *mut [16](u32, u32),
    text: *str,
    cb: fn(*[u8]) -> u32 @pure @noalloc,
) -> u32 {
    _ = mut_slice;
    _ = arr;
    _ = mut_arr;
    _ = text;
    return cb(slice);
}
