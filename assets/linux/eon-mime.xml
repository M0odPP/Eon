<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-eon">
    <comment>Eon source code</comment>
    <sub-class-of type="text/plain"/>
    <icon name="text-x-eon"/>
    <glob pattern="*.eon"/>
  </mime-type>
  <mime-type type="text/x-eon-hal">
    <comment>Eon HAL trust-boundary source</comment>
    <sub-class-of type="text/x-eon"/>
    <icon name="text-x-eon-hal"/>
    <glob pattern="*.hal.eon" weight="60"/>
  </mime-type>
</mime-info>
