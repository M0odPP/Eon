const SSBO_CAPACITY_BYTES: u64 = 131072_u64; // 128 KiB per layer (~1024 quads/shadows/sprites)

// ----------------------------------------------------------------------------
// ABI-exact C-call trampolines (SysV x86_64, AAPCS64, RV64 LP64D, Win64)
