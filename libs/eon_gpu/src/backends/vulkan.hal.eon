module eon_gpu.backends.vulkan @hal;

import core.color;
import eon_win.events;
import eon_gpu.scene;

// ============================================================================
// Native Vulkan 1.1+ UI-RHI Backend (`libs/eon_gpu/src/backends/vulkan.hal.eon`)
// Zero C toolchain, ZERO OpenGL — dynamic `libvulkan.so.1` / `vulkan-1.dll` /
// `libvulkan.so` loading, real platform WSI surfaces (Wayland/XCB/Xlib/Win32/
// Android), real swapchain & render pass, all 6 GPUI pipelines directly from
// `@embed_gpu_spirv(...)`, persistent mapped SSBOs, R8/RGBA8 atlas textures,
// and instanced draw submission.
// ============================================================================

extern "C" fn dlopen(filename: u64, flags: i32) -> u64;
extern "C" fn dlsym(handle: u64, symbol: u64) -> u64;
extern "C" fn dlclose(handle: u64) -> i32;

extern "C" fn LoadLibraryA(name: u64) -> u64;
extern "C" fn GetProcAddress(mod_h: u64, name: u64) -> u64;
extern "C" fn FreeLibrary(mod_h: u64) -> i32;

const RTLD_NOW: i32 = 2_i32;

// Vulkan constants
const VK_API_VERSION_1_1: u32 = (1_u32 << 22_u32) | (1_u32 << 12_u32);
const VK_STRUCTURE_TYPE_APPLICATION_INFO: u32 = 0_u32;
const VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO: u32 = 1_u32;
