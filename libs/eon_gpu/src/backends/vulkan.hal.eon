@naked
pub fn vk_c1(_fp: u64, _a0: u64) -> u64 {
    comptime if @target_os() == .Windows {
        raw { asm("mov rax, rdi; mov rcx, rsi; push r11; push r11; push r11; push r11; push r11; call rax; pop r11; pop r11; pop r11; pop r11; pop r11; ret", options(noreturn)); }
    } else comptime if @target_arch() == .AArch64 {
        raw { asm("mov x16, x0; mov x0, x1; br x16", options(noreturn)); }
    } else comptime if @target_arch() == .RiscV64 {
        raw { asm("mv t0, a0; mv a0, a1; jr t0", options(noreturn)); }
    } else {
        raw { asm("mov r10, rdi; mov rdi, rsi; jmp r10", options(noreturn)); }
    }
    return 0_u64;
}

