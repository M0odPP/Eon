module eon_win.events;

// ============================================================================
// Cross-platform Windowing, Surface, Input, Cursor & Event Types (100% safe,
// 100% core/-only, zero heap allocations — works identically on hosted OSes
// and bare-metal nostd targets).
// ============================================================================

pub struct WindowSize {
    pub width: u32;
    pub height: u32;
}

impl WindowSize {
    @inline
    pub fn new(width: u32, height: u32) -> WindowSize {
        return WindowSize.{ width: width, height: height };
    }
}

pub struct WindowOptions {
    pub title: [128]u8;
    pub title_len: usize;
    pub width: u32;
    pub height: u32;
    pub min_width: u32;
    pub min_height: u32;
    pub resizable: bool;
    pub headless: bool;
}

impl WindowOptions {
    pub fn new(title: *str, width: u32, height: u32) -> WindowOptions {
        var buf: [128]u8 = [0_u8; 128];
        let src = title.as_bytes();
        let n: usize = if src.len < 127_usize { src.len } else { 127_usize };
        var i: usize = 0_usize;
        while i < n {
            buf[i] = src[i];
            i = i +% 1_usize;
        }
        return WindowOptions.{
            title: buf,
            title_len: n,
            width: width,
            height: height,
            min_width: 320_u32,
            min_height: 240_u32,
            resizable: true,
            headless: false,
        };
    }

    pub fn headless(title: *str, width: u32, height: u32) -> WindowOptions {
        var o = WindowOptions.new(title, width, height);
        o.min_width = 64_u32;
        o.min_height = 64_u32;
        o.headless = true;
        return o;
    }

    pub view fn title_bytes(self: *Self) -> *[u8] {
        let n: usize = if self.title_len <= 128_usize { self.title_len } else { 128_usize };
        return self.title[0_usize..n];
    }
}

pub enum SurfaceKind : u8 {
    None = 0,
    Wayland = 1,
    Xcb = 2,
    Xlib = 3,
    Win32 = 4,
    Metal = 5,
    Android = 6,
    NoStdFb = 7,
    Headless = 8,
}

/// Safe opaque platform surface descriptor passed to `eon_gpu` backends.
pub struct SurfaceInfo {
    pub kind: SurfaceKind;
    pub display_handle: u64;
    pub window_handle: u64;
    pub extra_handle: u64;
    pub width: u32;
    pub height: u32;
    pub scale_factor: f32;
    pub fb_base_addr: u64;
    pub fb_pitch_bytes: u32;
    pub fb_is_bgr: bool;
}

impl SurfaceInfo {
    pub fn empty() -> SurfaceInfo {
        return SurfaceInfo.{
            kind: .None,
            display_handle: 0_u64,
            window_handle: 0_u64,
            extra_handle: 0_u64,
            width: 0_u32,
            height: 0_u32,
            scale_factor: 1.0_f32,
            fb_base_addr: 0_u64,
            fb_pitch_bytes: 0_u32,
            fb_is_bgr: false,
        };
    }
}

pub enum MouseButton : u8 {
    Left = 0,
    Right = 1,
    Middle = 2,
    Back = 3,
    Forward = 4,
}

pub struct Modifiers {
    pub bits: u8;
}

pub const MOD_SHIFT: u8 = 1_u8;
pub const MOD_CTRL: u8 = 2_u8;
pub const MOD_ALT: u8 = 4_u8;
pub const MOD_META: u8 = 8_u8;

impl Modifiers {
    @inline
    pub fn none() -> Modifiers {
        return Modifiers.{ bits: 0_u8 };
    }

    @inline
    pub fn from_bits(bits: u8) -> Modifiers {
        return Modifiers.{ bits: bits };
    }

    @inline
    pub fn has_shift(self: Self) -> bool {
        return (self.bits & MOD_SHIFT) != 0_u8;
    }

    @inline
    pub fn has_ctrl(self: Self) -> bool {
        return (self.bits & MOD_CTRL) != 0_u8;
    }

    @inline
    pub fn has_alt(self: Self) -> bool {
        return (self.bits & MOD_ALT) != 0_u8;
    }

    @inline
    pub fn has_meta(self: Self) -> bool {
        return (self.bits & MOD_META) != 0_u8;
    }

    @inline
    pub fn has_primary(self: Self) -> bool {
        comptime if @target_os() == .MacOS || @target_os() == .IOS {
            return self.has_meta() || self.has_ctrl();
        } else {
            return self.has_ctrl();
        }
    }
}

