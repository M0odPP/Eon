pub enum TouchPhase : u8 {
    Started = 0,
    Moved = 1,
    Ended = 2,
    Cancelled = 3,
}

pub enum CursorShape : u8 {
    Default = 0,
    Pointer = 1,
    Text = 2,
    Grab = 3,
    Grabbing = 4,
    NotAllowed = 5,
    ResizeEW = 6,
    ResizeNS = 7,
}

pub struct MouseMoveEvent {
    pub x: f32;
    pub y: f32;
    pub mods: Modifiers;
}

pub struct MouseButtonEvent {
    pub button: MouseButton;
    pub x: f32;
    pub y: f32;
    pub click_count: u8;
    pub mods: Modifiers;
}

pub struct MouseWheelEvent {
    pub dx: f32;
    pub dy: f32;
    pub x: f32;
    pub y: f32;
    pub mods: Modifiers;
}

pub struct KeyEvent {
    pub key: Key;
    pub scancode: u32;
    pub repeat: bool;
    pub mods: Modifiers;
}

pub struct TouchEvent {
    pub id: u32;
    pub phase: TouchPhase;
    pub x: f32;
    pub y: f32;
}

pub union PlatformEvent {
    MouseMove: MouseMoveEvent,
    MouseDown: MouseButtonEvent,
    MouseUp: MouseButtonEvent,
    MouseWheel: MouseWheelEvent,
    KeyDown: KeyEvent,
    KeyUp: KeyEvent,
    TextInput: u32,
    Touch: TouchEvent,
    Resized: WindowSize,
    ScaleFactorChanged: f32,
    FocusChanged: bool,
    CloseRequested,
    RedrawRequested,
}

/// Fixed-capacity allocation-free circular event queue (works in both hosted & nostd).
pub struct EventQueue {
    items: [32]PlatformEvent;
    head: usize;
    tail: usize;
    count: usize;
}

impl EventQueue {
    pub fn new() -> EventQueue {
        let init_ev: PlatformEvent = .RedrawRequested;
        return EventQueue.{
            items: [init_ev; 32],
            head: 0_usize,
            tail: 0_usize,
            count: 0_usize,
        };
    }

    pub fn len(self: *Self) -> usize {
        return self.count;
    }

    pub fn is_empty(self: *Self) -> bool {
        return self.count == 0_usize;
    }

    pub fn clear(self: *mut Self) {
        self.head = 0_usize;
        self.tail = 0_usize;
        self.count = 0_usize;
    }

    pub fn push(self: *mut Self, ev: PlatformEvent) {
        if self.count >= 32_usize {
            self.head = (self.head +% 1_usize) & 31_usize;
            self.count = 31_usize;
        }
        let idx = self.tail & 31_usize;
        self.items[idx] = ev;
        self.tail = (self.tail +% 1_usize) & 31_usize;
        self.count = self.count +% 1_usize;
    }

    pub fn pop(self: *mut Self) -> ?PlatformEvent {
        if self.count == 0_usize {
            return null;
        }
        let idx = self.head & 31_usize;
        let ev = self.items[idx];
        self.head = (self.head +% 1_usize) & 31_usize;
        self.count = self.count - 1_usize;
        return ev;
    }
}

/// Fixed-capacity UTF-8 clipboard buffer (512 B, zero heap allocations, nostd stack-safe).
pub struct ClipboardBuf {
    pub data: [512]u8;
    pub len: usize;
}

impl ClipboardBuf {
    pub fn new() -> ClipboardBuf {
        return ClipboardBuf.{ data: [0_u8; 512], len: 0_usize };
    }

    pub fn clear(self: *mut Self) {
        self.len = 0_usize;
    }

    pub fn set_bytes(self: *mut Self, src: *[u8]) {
        let n: usize = if src.len < 511_usize { src.len } else { 511_usize };
        var i: usize = 0_usize;
        while i < n {
            self.data[i] = src[i];
            i = i +% 1_usize;
        }
        self.data[n] = 0_u8;
        self.len = n;
    }

    pub fn set_str(self: *mut Self, s: *str) {
        self.set_bytes(s.as_bytes());
    }

    pub view fn as_bytes(self: *Self) -> *[u8] {
        let n: usize = if self.len <= 512_usize { self.len } else { 512_usize };
        return self.data[0_usize..n];
    }
}

// ---------------------------------------------------------------------------
// Portable Key Translation Helpers (ASCII, Linux evdev / XKB, Win32 VK, Android)
// ---------------------------------------------------------------------------

pub fn key_from_ascii(ch: u8) -> Key {
    if ch >= 48_u8 && ch <= 57_u8 {
        match ch - 48_u8 {
            0_u8 => { return .Digit0; }
            1_u8 => { return .Digit1; }
            2_u8 => { return .Digit2; }
            3_u8 => { return .Digit3; }
            4_u8 => { return .Digit4; }
            5_u8 => { return .Digit5; }
            6_u8 => { return .Digit6; }
            7_u8 => { return .Digit7; }
            8_u8 => { return .Digit8; }
            _ => { return .Digit9; }
        }
    }
    let lo: u8 = if ch >= 65_u8 && ch <= 90_u8 { ch +% 32_u8 } else { ch };
    match lo {
        97_u8 => { return .A; }
        98_u8 => { return .B; }
        99_u8 => { return .C; }
        100_u8 => { return .D; }
        101_u8 => { return .E; }
        102_u8 => { return .F; }
        103_u8 => { return .G; }
        104_u8 => { return .H; }
        105_u8 => { return .I; }
        106_u8 => { return .J; }
        107_u8 => { return .K; }
        108_u8 => { return .L; }
        109_u8 => { return .M; }
        110_u8 => { return .N; }
        111_u8 => { return .O; }
        112_u8 => { return .P; }
        113_u8 => { return .Q; }
        114_u8 => { return .R; }
        115_u8 => { return .S; }
        116_u8 => { return .T; }
        117_u8 => { return .U; }
        118_u8 => { return .V; }
        119_u8 => { return .W; }
        120_u8 => { return .X; }
        121_u8 => { return .Y; }
        122_u8 => { return .Z; }
        43_u8 => { return .Plus; }
        45_u8 => { return .Minus; }
        42_u8 => { return .Multiply; }
        47_u8 => { return .Divide; }
        46_u8 => { return .Period; }
        44_u8 => { return .Comma; }
        40_u8 => { return .LParen; }
        41_u8 => { return .RParen; }
        37_u8 => { return .Percent; }
        94_u8 => { return .Caret; }
        61_u8 => { return .Equal; }
        32_u8 => { return .Space; }
        10_u8 => { return .Enter; }
        13_u8 => { return .Enter; }
        9_u8 => { return .Tab; }
        27_u8 => { return .Escape; }
        8_u8 => { return .Backspace; }
        127_u8 => { return .Delete; }
        _ => { return .Unknown; }
    }
}

/// Map Linux input-event / Wayland / PS2 set-1 scancode to logical `Key`.
pub fn key_from_evdev(sc: u32) -> Key {
    match sc {
        1_u32 => { return .Escape; }
        2_u32 => { return .Digit1; }
        3_u32 => { return .Digit2; }
        4_u32 => { return .Digit3; }
