        10_u32 => { return .Digit9; }
        11_u32 => { return .Digit0; }
        12_u32 => { return .Minus; }
        13_u32 => { return .Equal; }
        14_u32 => { return .Backspace; }
        15_u32 => { return .Tab; }
        16_u32 => { return .Q; }
        17_u32 => { return .W; }
        18_u32 => { return .E; }
        19_u32 => { return .R; }
        20_u32 => { return .T; }
        21_u32 => { return .Y; }
        22_u32 => { return .U; }
        23_u32 => { return .I; }
        24_u32 => { return .O; }
        25_u32 => { return .P; }
        26_u32 => { return .LBracket; }
        27_u32 => { return .RBracket; }
        28_u32 => { return .Enter; }
        29_u32 => { return .Control; }
        30_u32 => { return .A; }
        31_u32 => { return .S; }
        32_u32 => { return .D; }
        33_u32 => { return .F; }
        34_u32 => { return .G; }
        35_u32 => { return .H; }
        36_u32 => { return .J; }
        37_u32 => { return .K; }
        38_u32 => { return .L; }
        39_u32 => { return .Semicolon; }
        40_u32 => { return .Quote; }
        41_u32 => { return .Grave; }
        42_u32 => { return .Shift; }
        43_u32 => { return .Backslash; }
        44_u32 => { return .Z; }
        45_u32 => { return .X; }
        46_u32 => { return .C; }
        47_u32 => { return .V; }
        48_u32 => { return .B; }
        49_u32 => { return .N; }
        50_u32 => { return .M; }
        51_u32 => { return .Comma; }
        52_u32 => { return .Period; }
        53_u32 => { return .Slash; }
        54_u32 => { return .Shift; }
        55_u32 => { return .Multiply; }
        56_u32 => { return .Alt; }
        57_u32 => { return .Space; }
        59_u32 => { return .F1; }
        60_u32 => { return .F2; }
        61_u32 => { return .F3; }
        62_u32 => { return .F4; }
        63_u32 => { return .F5; }
        64_u32 => { return .F6; }
        65_u32 => { return .F7; }
        66_u32 => { return .F8; }
        67_u32 => { return .F9; }
        68_u32 => { return .F10; }
        71_u32 => { return .Digit7; }
        72_u32 => { return .Digit8; }
        73_u32 => { return .Digit9; }
        74_u32 => { return .Minus; }
        75_u32 => { return .Digit4; }
        76_u32 => { return .Digit5; }
        77_u32 => { return .Digit6; }
        78_u32 => { return .Plus; }
        79_u32 => { return .Digit1; }
        80_u32 => { return .Digit2; }
        81_u32 => { return .Digit3; }
        82_u32 => { return .Digit0; }
        83_u32 => { return .Period; }
        87_u32 => { return .F11; }
        88_u32 => { return .F12; }
        96_u32 => { return .Enter; }
        97_u32 => { return .Control; }
        98_u32 => { return .Divide; }
        100_u32 => { return .Alt; }
        102_u32 => { return .Home; }
        103_u32 => { return .Up; }
        104_u32 => { return .PageUp; }
        105_u32 => { return .Left; }
        106_u32 => { return .Right; }
        107_u32 => { return .End; }
        108_u32 => { return .Down; }
        109_u32 => { return .PageDown; }
