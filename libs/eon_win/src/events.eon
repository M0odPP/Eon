        _ => { return .Unknown; }
    }
}

/// Map Win32 Virtual-Key code (`VK_*`) to logical `Key`.
pub fn key_from_vk(vk: u32) -> Key {
    if vk >= 0x30_u32 && vk <= 0x39_u32 {
        return key_from_ascii(vk.trunc.[u8]());
    }
    if vk >= 0x41_u32 && vk <= 0x5A_u32 {
        return key_from_ascii(vk.trunc.[u8]());
    }
    if vk >= 0x60_u32 && vk <= 0x69_u32 {
        return key_from_ascii(48_u8 +% (vk - 0x60_u32).trunc.[u8]());
    }
    match vk {
        0x08_u32 => { return .Backspace; }
        0x09_u32 => { return .Tab; }
        0x0D_u32 => { return .Enter; }
        0x10_u32 => { return .Shift; }
        0x11_u32 => { return .Control; }
        0x12_u32 => { return .Alt; }
        0x1B_u32 => { return .Escape; }
        0x20_u32 => { return .Space; }
        0x21_u32 => { return .PageUp; }
        0x22_u32 => { return .PageDown; }
        0x23_u32 => { return .End; }
        0x24_u32 => { return .Home; }
        0x25_u32 => { return .Left; }
        0x26_u32 => { return .Up; }
        0x27_u32 => { return .Right; }
        0x28_u32 => { return .Down; }
        0x2E_u32 => { return .Delete; }
        0x6A_u32 => { return .Multiply; }
        0x6B_u32 => { return .Plus; }
        0x6D_u32 => { return .Minus; }
        0x6E_u32 => { return .Period; }
        0x6F_u32 => { return .Divide; }
        0x70_u32 => { return .F1; }
        0x71_u32 => { return .F2; }
        0x72_u32 => { return .F3; }
        0x73_u32 => { return .F4; }
        0x74_u32 => { return .F5; }
        0x75_u32 => { return .F6; }
        0x76_u32 => { return .F7; }
        0x77_u32 => { return .F8; }
        0x78_u32 => { return .F9; }
        0x79_u32 => { return .F10; }
        0x7A_u32 => { return .F11; }
        0x7B_u32 => { return .F12; }
        0xBB_u32 => { return .Equal; }
        0xBC_u32 => { return .Comma; }
        0xBD_u32 => { return .Minus; }
        0xBE_u32 => { return .Period; }
        0xBF_u32 => { return .Slash; }
        _ => { return .Unknown; }
    }
}

/// Map XKB keysym to logical `Key`.
pub fn key_from_xkb_sym(sym: u32) -> Key {
    if sym >= 0x20_u32 && sym <= 0x7E_u32 {
        return key_from_ascii(sym.trunc.[u8]());
    }
    match sym {
        0xFF08_u32 => { return .Backspace; }
        0xFF09_u32 => { return .Tab; }
        0xFF0D_u32 => { return .Enter; }
        0xFF1B_u32 => { return .Escape; }
        0xFF50_u32 => { return .Home; }
        0xFF51_u32 => { return .Left; }
        0xFF52_u32 => { return .Up; }
        0xFF53_u32 => { return .Right; }
        0xFF54_u32 => { return .Down; }
        0xFF55_u32 => { return .PageUp; }
        0xFF56_u32 => { return .PageDown; }
        0xFF57_u32 => { return .End; }
        0xFFFF_u32 => { return .Delete; }
        0xFF8D_u32 => { return .Enter; }
        0xFFAA_u32 => { return .Multiply; }
        0xFFAB_u32 => { return .Plus; }
        0xFFAD_u32 => { return .Minus; }
        0xFFAE_u32 => { return .Period; }
        0xFFAF_u32 => { return .Divide; }
        0xFFB0_u32 => { return .Digit0; }
        0xFFB1_u32 => { return .Digit1; }
        0xFFB2_u32 => { return .Digit2; }
        0xFFB3_u32 => { return .Digit3; }
        0xFFB4_u32 => { return .Digit4; }
        0xFFB5_u32 => { return .Digit5; }
        0xFFB6_u32 => { return .Digit6; }
        0xFFB7_u32 => { return .Digit7; }
        0xFFB8_u32 => { return .Digit8; }
        0xFFB9_u32 => { return .Digit9; }
        0xFFBE_u32 => { return .F1; }
        0xFFBF_u32 => { return .F2; }
        0xFFC0_u32 => { return .F3; }
        0xFFC1_u32 => { return .F4; }
        0xFFC2_u32 => { return .F5; }
        0xFFC3_u32 => { return .F6; }
        0xFFC4_u32 => { return .F7; }
        0xFFC5_u32 => { return .F8; }
        0xFFC6_u32 => { return .F9; }
        0xFFC7_u32 => { return .F10; }
        0xFFC8_u32 => { return .F11; }
        0xFFC9_u32 => { return .F12; }
        0xFFE1_u32 => { return .Shift; }
        0xFFE2_u32 => { return .Shift; }
        0xFFE3_u32 => { return .Control; }
        0xFFE4_u32 => { return .Control; }
        0xFFE9_u32 => { return .Alt; }
        0xFFEA_u32 => { return .Alt; }
        0xFFEB_u32 => { return .Meta; }
        0xFFEC_u32 => { return .Meta; }
        _ => { return .Unknown; }
    }
}

/// Map Android `AKEYCODE_*` to logical `Key`.
pub fn key_from_android(code: i32) -> Key {
    if code >= 7_i32 && code <= 16_i32 {
        return key_from_ascii(48_u8 +% (code - 7_i32).trunc.[u8]());
    }
    if code >= 29_i32 && code <= 54_i32 {
        return key_from_ascii(97_u8 +% (code - 29_i32).trunc.[u8]());
    }
    match code {
        4_i32 => { return .Escape; }
        19_i32 => { return .Up; }
        20_i32 => { return .Down; }
        21_i32 => { return .Left; }
        22_i32 => { return .Right; }
        55_i32 => { return .Comma; }
        56_i32 => { return .Period; }
        57_i32 => { return .Alt; }
        58_i32 => { return .Alt; }
        59_i32 => { return .Shift; }
        60_i32 => { return .Shift; }
        61_i32 => { return .Tab; }
        62_i32 => { return .Space; }
        66_i32 => { return .Enter; }
        67_i32 => { return .Backspace; }
        69_i32 => { return .Minus; }
        70_i32 => { return .Equal; }
        76_i32 => { return .Slash; }
        81_i32 => { return .Plus; }
        111_i32 => { return .Escape; }
        112_i32 => { return .Delete; }
        113_i32 => { return .Control; }
        114_i32 => { return .Control; }
        155_i32 => { return .Multiply; }
        156_i32 => { return .Minus; }
        157_i32 => { return .Plus; }
        160_i32 => { return .Enter; }
        162_i32 => { return .LParen; }
        163_i32 => { return .RParen; }
        _ => { return .Unknown; }
    }
}
