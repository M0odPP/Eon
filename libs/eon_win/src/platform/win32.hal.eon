}

pub fn utf8_to_utf16_z(src: *[u8], dst: *mut [u16]) -> usize {
    if dst.len == 0_usize {
        return 0_usize;
    }
    let lim = dst.len - 1_usize;
    var di: usize = 0_usize;
    var si: usize = 0_usize;
    while si < src.len && di < lim {
        let b = src[si];
        if b < 0x80_u8 {
            dst[di] = b.widen.[u16]();
            di = di +% 1_usize;
            si = si +% 1_usize;
        } else if (b & 0xE0_u8) == 0xC0_u8 && si +% 1_usize < src.len {
            let cp = (((b & 0x1F_u8).widen.[u16]()) << 6_u16) | (src[si +% 1_usize] & 0x3F_u8).widen.[u16]();
            dst[di] = cp;
            di = di +% 1_usize;
            si = si +% 2_usize;
        } else if (b & 0xF0_u8) == 0xE0_u8 && si +% 2_usize < src.len {
            let cp = (((b & 0x0F_u8).widen.[u16]()) << 12_u16)
                | (((src[si +% 1_usize] & 0x3F_u8).widen.[u16]()) << 6_u16)
                | (src[si +% 2_usize] & 0x3F_u8).widen.[u16]();
            dst[di] = cp;
            di = di +% 1_usize;
            si = si +% 3_usize;
        } else {
            dst[di] = b'?'.widen.[u16]();
            di = di +% 1_usize;
            si = si +% 1_usize;
        }
    }
    if di < dst.len {
        dst[di] = 0_u16;
    }
    return di;
}

pub struct Win32State {
    pub hwnd: u64;
    pub hinstance: u64;
    pub width: u32;
    pub height: u32;
    pub scale_factor: f32;
    pub should_close: bool;
    pub queue_ptr: u64;
}

@naked
pub fn queue_mut_ptr(_q: *mut events.EventQueue) -> u64 {
    comptime if @target_arch() == .AArch64 || @target_arch() == .RiscV64 {
        raw { asm("ret", options(noreturn)); }
    } else {
        raw { asm("mov rax, rdi; ret", options(noreturn)); }
    }
    return 0_u64;
}

pub fn push_ev(qp: u64, ev: events.PlatformEvent) {
    if qp != 0_u64 {
        raw {
            let q = rawptr_mut.[events.EventQueue].from_usize(qp.trunc.[usize]());
            q.*.push(ev);
        }
    }
}

pub fn query_win32_mods() -> events.Modifiers {
    comptime if @target_os() == .Windows {
        var bits: u8 = 0_u8;
        raw {
            if (GetKeyState(VK_SHIFT) & (-32768_i16)) != 0_i16 { bits = bits | events.MOD_SHIFT; }
            if (GetKeyState(VK_CONTROL) & (-32768_i16)) != 0_i16 { bits = bits | events.MOD_CTRL; }
            if (GetKeyState(VK_MENU) & (-32768_i16)) != 0_i16 { bits = bits | events.MOD_ALT; }
        }
        return events.Modifiers.from_bits(bits);
    } else {
        return events.Modifiers.none();
    }
}

@inline
pub fn lo_i16(lp: i64) -> f32 {
    let v = (lp & 0xFFFF_i64).trunc.[i16]();
    return v.widen.[i32]().to_float.[f32]();
}

@inline
pub fn hi_i16(lp: i64) -> f32 {
    let v = ((lp >> 16_i64) & 0xFFFF_i64).trunc.[i16]();
    return v.widen.[i32]().to_float.[f32]();
}

@extern("C")
pub fn eon_win32_wndproc(hwnd: u64, msg: u32, wp: u64, lp: i64) -> i64 {
    comptime if @target_os() == .Windows {
        if msg == WM_NCCREATE {
            raw {
                // First field of CREATESTRUCTW is `lpCreateParams` (offset 0).
                let cs_ptr = rawptr.[u64].from_usize(lp.bitcast.[u64]().trunc.[usize]());
                let state_ptr = cs_ptr.*;
                _ = SetWindowLongPtrW(hwnd, GWLP_USERDATA, state_ptr.bitcast.[i64]());
                return DefWindowProcW(hwnd, msg, wp, lp);
            }
        }
        var raw_st: i64 = 0_i64;
        raw {
            raw_st = GetWindowLongPtrW(hwnd, GWLP_USERDATA);
        }
        if raw_st != 0_i64 {
            raw {
                let st = rawptr_mut.[Win32State].from_usize(raw_st.bitcast.[u64]().trunc.[usize]());
                if msg == WM_CLOSE {
                    st.*.should_close = true;
                    push_ev(st.*.queue_ptr, .CloseRequested);
                    return 0_i64;
                }
                if msg == WM_DESTROY {
                    st.*.should_close = true;
                    PostQuitMessage(0_i32);
                    return 0_i64;
                }
                if msg == WM_SIZE {
                    let nw = (lp & 0xFFFF_i64).bitcast.[u64]().trunc.[u32]();
                    let nh = ((lp >> 16_i64) & 0xFFFF_i64).bitcast.[u64]().trunc.[u32]();
                    if nw > 0_u32 && nh > 0_u32 {
                        st.*.width = nw;
                        st.*.height = nh;
                        push_ev(st.*.queue_ptr, .Resized(events.WindowSize.{ width: nw, height: nh }));
                    }
                    return 0_i64;
                }
                if msg == WM_DPICHANGED {
                    let dpi = (wp & 0xFFFF_u64).trunc.[u32]();
                    if dpi >= 48_u32 {
                        let sc = dpi.to_float.[f32]() / 96.0_f32;
                        st.*.scale_factor = sc;
                        push_ev(st.*.queue_ptr, .ScaleFactorChanged(sc));
                    }
                    return 0_i64;
                }
                if msg == WM_PAINT {
                    var ps = PaintStruct.{
                        hdc: 0_u64,
                        f_erase: 0_i32,
                        rc_paint: WinRect.{ left: 0_i32, top: 0_i32, right: 0_i32, bottom: 0_i32 },
                        f_restore: 0_i32,
                        f_inc_update: 0_i32,
                        rgb_reserved: [0_u8; 32],
                    };
                    _ = BeginPaint(hwnd, &mut ps);
                    _ = EndPaint(hwnd, &ps);
                    push_ev(st.*.queue_ptr, .RedrawRequested);
                    return 0_i64;
                }
                if msg == WM_SETFOCUS {
                    push_ev(st.*.queue_ptr, .FocusChanged(true));
                    return 0_i64;
                }
                if msg == WM_KILLFOCUS {
                    push_ev(st.*.queue_ptr, .FocusChanged(false));
                    return 0_i64;
                }
                if msg == WM_MOUSEMOVE {
                    let mods = query_win32_mods();
                    push_ev(st.*.queue_ptr, .MouseMove(events.MouseMoveEvent.{ x: lo_i16(lp), y: hi_i16(lp), mods: mods }));
                    return 0_i64;
                }
                if msg == WM_LBUTTONDOWN || msg == WM_RBUTTONDOWN || msg == WM_MBUTTONDOWN {
                    let btn: events.MouseButton = if msg == WM_LBUTTONDOWN { .Left } else if msg == WM_RBUTTONDOWN { .Right } else { .Middle };
                    push_ev(st.*.queue_ptr, .MouseDown(events.MouseButtonEvent.{ button: btn, x: lo_i16(lp), y: hi_i16(lp), click_count: 1_u8, mods: query_win32_mods() }));
                    return 0_i64;
                }
                if msg == WM_LBUTTONUP || msg == WM_RBUTTONUP || msg == WM_MBUTTONUP {
                    let btn: events.MouseButton = if msg == WM_LBUTTONUP { .Left } else if msg == WM_RBUTTONUP { .Right } else { .Middle };
                    push_ev(st.*.queue_ptr, .MouseUp(events.MouseButtonEvent.{ button: btn, x: lo_i16(lp), y: hi_i16(lp), click_count: 0_u8, mods: query_win32_mods() }));
                    return 0_i64;
                }
                if msg == WM_MOUSEWHEEL {
                    let delta_i = ((wp >> 16_u64) & 0xFFFF_u64).trunc.[u16]().bitcast.[i16]();
                    let dy = delta_i.widen.[i32]().to_float.[f32]() / 120.0_f32 * 36.0_f32;
                    push_ev(st.*.queue_ptr, .MouseWheel(events.MouseWheelEvent.{ dx: 0.0_f32, dy: dy, x: lo_i16(lp), y: hi_i16(lp), mods: query_win32_mods() }));
                    return 0_i64;
                }
                if msg == WM_KEYDOWN || msg == WM_SYSKEYDOWN {
                    let key = events.key_from_vk((wp & 0xFFFF_u64).trunc.[u32]());
                    let sc = ((lp >> 16_i64) & 0xFF_i64).bitcast.[u64]().trunc.[u32]();
                    let rep = ((lp >> 30_i64) & 1_i64) != 0_i64;
                    push_ev(st.*.queue_ptr, .KeyDown(events.KeyEvent.{ key: key, scancode: sc, repeat: rep, mods: query_win32_mods() }));
                    return 0_i64;
                }
                if msg == WM_KEYUP || msg == WM_SYSKEYUP {
                    let key = events.key_from_vk((wp & 0xFFFF_u64).trunc.[u32]());
                    let sc = ((lp >> 16_i64) & 0xFF_i64).bitcast.[u64]().trunc.[u32]();
                    push_ev(st.*.queue_ptr, .KeyUp(events.KeyEvent.{ key: key, scancode: sc, repeat: false, mods: query_win32_mods() }));
                    return 0_i64;
                }
                if msg == WM_CHAR {
                    let ch = (wp & 0xFFFF_u64).trunc.[u32]();
                    if ch >= 0x20_u32 && ch != 0x7F_u32 {
                        push_ev(st.*.queue_ptr, .TextInput(ch));
                    }
                    return 0_i64;
                }
            }
        }
        raw {
            return DefWindowProcW(hwnd, msg, wp, lp);
        }
    } else {
        _ = hwnd;
        _ = msg;
        _ = wp;
        _ = lp;
        return 0_i64;
    }
}

pub struct Win32Window {
    pub state: Win32State;
    pub hicon: u64;
    pub opened: bool;
}

impl Win32Window {
    pub fn empty() -> Win32Window {
        return Win32Window.{
            state: Win32State.{
                hwnd: 0_u64,
                hinstance: 0_u64,
                width: 0_u32,
                height: 0_u32,
                scale_factor: 1.0_f32,
                should_close: false,
                queue_ptr: 0_u64,
            },
            hicon: 0_u64,
            opened: false,
        };
    }

    pub fn open_into(self: *mut Self, opts: *events.WindowOptions) -> bool {
        self.state.width = opts.width;
        self.state.height = opts.height;
        self.state.scale_factor = 1.0_f32;
        self.state.should_close = false;
        comptime if @target_os() == .Windows {
            var cls_w: [32]u16 = [0_u16; 32];
            var title_w: [256]u16 = [0_u16; 256];
            _ = utf8_to_utf16_z("EonWin32Window".as_bytes(), &mut cls_w);
            _ = utf8_to_utf16_z(opts.title_bytes(), &mut title_w);
            var icon_dib: [4264]u8 = [0_u8; 4264];
            let icon_len = icon.build_win32_icon_dib_32(&mut icon_dib);
            raw {
                // DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2 = -4
                _ = SetProcessDpiAwarenessContext(-4_i64);
                let hinst = GetModuleHandleW(0_u64);
                self.state.hinstance = hinst;
                var hi: u64 = 0_u64;
                if icon_len == 4264_usize {
                    hi = CreateIconFromResourceEx(u8_slice_addr(&icon_dib), 4264_u32, 1_i32, 0x00030000_u32, 32_i32, 32_i32, 0_u32);
                }
                self.hicon = hi;
                let wc = WndClassExW.{
                    cb_size: 80_u32,
                    style: CS_HREDRAW | CS_VREDRAW | CS_OWNDC,
                    lpfn_wnd_proc: wndproc_fn_addr(eon_win32_wndproc),
                    cb_cls_extra: 0_i32,
                    cb_wnd_extra: 0_i32,
                    h_instance: hinst,
                    h_icon: hi,
                    h_cursor: LoadCursorW(0_u64, IDC_ARROW),
                    hbr_background: 0_u64,
                    lpsz_menu_name: 0_u64,
                    lpsz_class_name: u16_slice_addr(&cls_w),
                    h_icon_sm: hi,
                };
                _ = RegisterClassExW(&wc);
                var style = WS_OVERLAPPEDWINDOW | WS_VISIBLE;
                if !opts.resizable {
                    style = style & (~(WS_THICKFRAME | WS_MAXIMIZEBOX));
                }
                var rc = WinRect.{
                    left: 0_i32,
                    top: 0_i32,
                    right: opts.width.bitcast.[i32](),
                    bottom: opts.height.bitcast.[i32](),
                };
                _ = AdjustWindowRectEx(&mut rc, style, 0_i32, 0_u32);
                let win_w = rc.right -% rc.left;
                let win_h = rc.bottom -% rc.top;
                let hwnd = CreateWindowExW(
                    0_u32,
                    u16_slice_addr(&cls_w),
                    u16_slice_addr(&title_w),
                    style,
                    CW_USEDEFAULT,
                    CW_USEDEFAULT,
                    win_w,
                    win_h,
                    0_u64,
                    0_u64,
                    hinst,
                    state_mut_addr(&mut self.state),
                );
                if hwnd == 0_u64 {
                    return false;
                }
                self.state.hwnd = hwnd;
                if self.hicon != 0_u64 {
                    // WM_SETICON (0x0080): ICON_SMALL=0, ICON_BIG=1
                    _ = SendMessageW(hwnd, 0x0080_u32, 0_u64, self.hicon.bitcast.[i64]());
                    _ = SendMessageW(hwnd, 0x0080_u32, 1_u64, self.hicon.bitcast.[i64]());
                }
                let dpi = GetDpiForWindow(hwnd);
                if dpi >= 48_u32 {
                    self.state.scale_factor = dpi.to_float.[f32]() / 96.0_f32;
                }
                _ = ShowWindow(hwnd, SW_SHOW);
                _ = UpdateWindow(hwnd);
            }
            self.opened = true;
            return true;
        } else {
            _ = icon.WING_STEPS;
            return false;
        }
    }

    pub fn surface_info(self: *Self) -> events.SurfaceInfo {
        return events.SurfaceInfo.{
            kind: .Win32,
            display_handle: self.state.hinstance,
            window_handle: self.state.hwnd,
            extra_handle: 0_u64,
            width: self.state.width,
            height: self.state.height,
            scale_factor: self.state.scale_factor,
            fb_base_addr: 0_u64,
            fb_pitch_bytes: 0_u32,
            fb_is_bgr: true,
        };
    }

    pub fn poll_events(self: *mut Self, out_q: *mut events.EventQueue) {
        comptime if @target_os() == .Windows {
            if !self.opened || self.state.hwnd == 0_u64 {
                return;
            }
            var msg = WinMsg.{
                hwnd: 0_u64,
                message: 0_u32,
                _pad0: 0_u32,
                wparam: 0_u64,
                lparam: 0_i64,
                time: 0_u32,
                pt: WinPoint.{ x: 0_i32, y: 0_i32 },
                _pad1: 0_u32,
            };
            self.state.queue_ptr = queue_mut_ptr(out_q);
            var guard: u32 = 0_u32;
            while guard < 128_u32 {
                var got: i32 = 0_i32;
                raw {
                    got = PeekMessageW(&mut msg, 0_u64, 0_u32, 0_u32, PM_REMOVE);
                }
                if got == 0_i32 {
                    break;
                }
                if msg.message == WM_QUIT {
                    self.state.should_close = true;
                    out_q.push(.CloseRequested);
                    break;
                }
                raw {
                    _ = TranslateMessage(&msg);
                    _ = DispatchMessageW(&msg);
                }
                guard = guard +% 1_u32;
            }
            self.state.queue_ptr = 0_u64;
        } else {
            _ = self;
            _ = out_q;
        }
    }

    pub fn set_title(self: *mut Self, title: *str) {
        comptime if @target_os() == .Windows {
            if self.state.hwnd == 0_u64 { return; }
            var title_w: [256]u16 = [0_u16; 256];
            _ = utf8_to_utf16_z(title.as_bytes(), &mut title_w);
            raw { _ = SetWindowTextW(self.state.hwnd, u16_slice_addr(&title_w)); }
        } else {
            _ = self;
            _ = title;
        }
    }

    pub fn set_cursor(self: *mut Self, shape: events.CursorShape) {
        comptime if @target_os() == .Windows {
            if self.state.hwnd == 0_u64 { return; }
            let id: u64 = match shape {
                .Default => IDC_ARROW,
                .Pointer => IDC_HAND,
                .Text => IDC_IBEAM,
                .Grab => IDC_HAND,
                .Grabbing => IDC_HAND,
                .NotAllowed => IDC_NO,
                .ResizeEW => IDC_SIZEWE,
                .ResizeNS => IDC_SIZENS,
            };
            raw {
                let hc = LoadCursorW(0_u64, id);
                if hc != 0_u64 { _ = SetCursor(hc); }
            }
        } else {
            _ = self;
            _ = shape;
        }
    }

    pub fn request_redraw(self: *mut Self) {
        comptime if @target_os() == .Windows {
            if self.state.hwnd != 0_u64 {
                raw { _ = InvalidateRect(self.state.hwnd, 0_u64, 0_i32); }
            }
        } else {
            _ = self;
        }
    }

    pub fn clipboard_set(self: *mut Self, text: *[u8]) -> bool {
        comptime if @target_os() == .Windows {
            var wide: [2048]u16 = [0_u16; 2048];
            let n = utf8_to_utf16_z(text, &mut wide);
            let bytes = (n +% 1_usize) *% 2_usize;
            raw {
                if OpenClipboard(self.state.hwnd) == 0_i32 { return false; }
                _ = EmptyClipboard();
                let hmem = GlobalAlloc(GMEM_MOVEABLE, bytes);
                if hmem == 0_u64 { _ = CloseClipboard(); return false; }
                let dst = GlobalLock(hmem);
                if dst != 0_u64 {
                    var i: usize = 0_usize;
                    while i <= n && i < 2048_usize {
                        let p = rawptr_mut.[u16].from_usize((dst +% (i *% 2_usize).widen.[u64]()).trunc.[usize]());
                        p.* = wide[i];
                        i = i +% 1_usize;
                    }
                    _ = GlobalUnlock(hmem);
                    _ = SetClipboardData(CF_UNICODETEXT, hmem);
                }
                _ = CloseClipboard();
            }
            return true;
        } else {
            _ = self;
            _ = text;
            return false;
        }
    }

    pub fn clipboard_get(self: *mut Self, dst: *mut events.ClipboardBuf) -> bool {
        dst.clear();
        comptime if @target_os() == .Windows {
            raw {
                if OpenClipboard(self.state.hwnd) == 0_i32 { return false; }
                let hmem = GetClipboardData(CF_UNICODETEXT);
                if hmem == 0_u64 { _ = CloseClipboard(); return false; }
                let src = GlobalLock(hmem);
                if src != 0_u64 {
                    var out_len: usize = 0_usize;
                    var i: usize = 0_usize;
                    while i < 512_usize && out_len < 508_usize {
                        let ch = rawptr.[u16].from_usize((src +% (i *% 2_usize).widen.[u64]()).trunc.[usize]()).*;
                        if ch == 0_u16 { break; }
                        if ch < 0x80_u16 {
                            dst.data[out_len] = ch.trunc.[u8]();
                            out_len = out_len +% 1_usize;
                        } else if ch < 0x800_u16 {
                            dst.data[out_len] = (0xC0_u16 | (ch >> 6_u16)).trunc.[u8]();
                            dst.data[out_len +% 1_usize] = (0x80_u16 | (ch & 0x3F_u16)).trunc.[u8]();
                            out_len = out_len +% 2_usize;
                        } else {
                            dst.data[out_len] = (0xE0_u16 | (ch >> 12_u16)).trunc.[u8]();
                            dst.data[out_len +% 1_usize] = (0x80_u16 | ((ch >> 6_u16) & 0x3F_u16)).trunc.[u8]();
                            dst.data[out_len +% 2_usize] = (0x80_u16 | (ch & 0x3F_u16)).trunc.[u8]();
                            out_len = out_len +% 3_usize;
                        }
                        i = i +% 1_usize;
                    }
                    dst.len = out_len;
                    _ = GlobalUnlock(hmem);
                }
                _ = CloseClipboard();
            }
            return dst.len > 0_usize;
        } else {
            _ = self;
            return false;
        }
    }

    /// Blit RGBA8 software buffer to the Win32 window client area via GDI `StretchDIBits` (row-wise BGRA swap).
    pub fn present_rgba8(self: *mut Self, rgba: *[u8], w: u32, h: u32) {
        comptime if @target_os() == .Windows {
            if !self.opened || self.state.hwnd == 0_u64 || w == 0_u32 || h == 0_u32 {
                return;
            }
            let row_w: u32 = if w <= 1024_u32 { w } else { 1024_u32 };
            let bmi = BitmapInfoHeader.{
                bi_size: 40_u32,
                bi_width: row_w.bitcast.[i32](),
                bi_height: -1_i32,
                bi_planes: 1_u16,
                bi_bit_count: 32_u16,
                bi_compression: BI_RGB,
                bi_size_image: 0_u32,
                bi_xpels_per_meter: 0_i32,
                bi_ypels_per_meter: 0_i32,
                bi_clr_used: 0_u32,
                bi_clr_important: 0_u32,
            };
            var bgra_row: [4096]u8 = [0_u8; 4096];
            raw {
                let hdc = GetDC(self.state.hwnd);
                if hdc != 0_u64 {
                    var y: u32 = 0_u32;
                    while y < h {
                        let base = (y *% w).widen.[usize]() *% 4_usize;
                        var x: u32 = 0_u32;
                        while x < row_w {
                            let si = base +% x.widen.[usize]() *% 4_usize;
                            let di = x.widen.[usize]() *% 4_usize;
                            if rgba.len >= 4_usize && si <= rgba.len - 4_usize && di <= 4092_usize {
                                bgra_row[di] = rgba[si + 2_usize];
                                bgra_row[di + 1_usize] = rgba[si + 1_usize];
                                bgra_row[di + 2_usize] = rgba[si];
                                bgra_row[di + 3_usize] = rgba[si + 3_usize];
                            }
                            x = x +% 1_u32;
                        }
                        _ = StretchDIBits(
                            hdc,
                            0_i32,
                            y.bitcast.[i32](),
                            row_w.bitcast.[i32](),
                            1_i32,
                            0_i32,
                            0_i32,
                            row_w.bitcast.[i32](),
                            1_i32,
                            u8_slice_addr(&bgra_row),
                            &bmi,
                            DIB_RGB_COLORS,
                            SRCCOPY,
                        );
                        y = y +% 1_u32;
                    }
                    _ = ReleaseDC(self.state.hwnd, hdc);
                }
            }
        } else {
            _ = self;
            _ = rgba;
            _ = w;
            _ = h;
        }
    }

    pub fn close(self: *mut Self) {
        comptime if @target_os() == .Windows {
            if self.state.hwnd != 0_u64 {
                raw { _ = DestroyWindow(self.state.hwnd); }
                self.state.hwnd = 0_u64;
            }
            if self.hicon != 0_u64 {
                raw { _ = DestroyIcon(self.hicon); }
                self.hicon = 0_u64;
            }
        }
        self.opened = false;
    }
}
