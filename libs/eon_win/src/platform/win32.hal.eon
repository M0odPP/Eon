const WS_OVERLAPPEDWINDOW: u32 = 0x00CF0000_u32;
const WS_VISIBLE: u32 = 0x10000000_u32;
const WS_THICKFRAME: u32 = 0x00040000_u32;
const WS_MAXIMIZEBOX: u32 = 0x00010000_u32;
const CS_HREDRAW: u32 = 0x0002_u32;
const CS_VREDRAW: u32 = 0x0001_u32;
const CS_OWNDC: u32 = 0x0020_u32;
const CW_USEDEFAULT: i32 = -2147483648_i32;
const SW_SHOW: i32 = 5_i32;
const PM_REMOVE: u32 = 0x0001_u32;
const GWLP_USERDATA: i32 = -21_i32;
const CF_UNICODETEXT: u32 = 13_u32;
const GMEM_MOVEABLE: u32 = 0x0002_u32;
const DIB_RGB_COLORS: u32 = 0_u32;
const SRCCOPY: u32 = 0x00CC0020_u32;
const BI_RGB: u32 = 0_u32;

const WM_DESTROY: u32 = 0x0002_u32;
const WM_SIZE: u32 = 0x0005_u32;
const WM_SETFOCUS: u32 = 0x0007_u32;
const WM_KILLFOCUS: u32 = 0x0008_u32;
const WM_PAINT: u32 = 0x000F_u32;
const WM_CLOSE: u32 = 0x0010_u32;
const WM_QUIT: u32 = 0x0012_u32;
const WM_NCCREATE: u32 = 0x0081_u32;
const WM_KEYDOWN: u32 = 0x0100_u32;
const WM_KEYUP: u32 = 0x0101_u32;
const WM_CHAR: u32 = 0x0102_u32;
const WM_SYSKEYDOWN: u32 = 0x0104_u32;
const WM_SYSKEYUP: u32 = 0x0105_u32;
const WM_MOUSEMOVE: u32 = 0x0200_u32;
const WM_LBUTTONDOWN: u32 = 0x0201_u32;
const WM_LBUTTONUP: u32 = 0x0202_u32;
const WM_RBUTTONDOWN: u32 = 0x0204_u32;
const WM_RBUTTONUP: u32 = 0x0205_u32;
const WM_MBUTTONDOWN: u32 = 0x0207_u32;
const WM_MBUTTONUP: u32 = 0x0208_u32;
const WM_MOUSEWHEEL: u32 = 0x020A_u32;
const WM_DPICHANGED: u32 = 0x02E0_u32;

const VK_SHIFT: i32 = 0x10_i32;
const VK_CONTROL: i32 = 0x11_i32;
const VK_MENU: i32 = 0x12_i32;

const IDC_ARROW: u64 = 32512_u64;
const IDC_IBEAM: u64 = 32513_u64;
const IDC_SIZEWE: u64 = 32644_u64;
const IDC_SIZENS: u64 = 32645_u64;
const IDC_NO: u64 = 32648_u64;
const IDC_HAND: u64 = 32649_u64;

@layout(c)
struct WndClassExW {
    cb_size: u32;
    style: u32;
    lpfn_wnd_proc: u64;
    cb_cls_extra: i32;
    cb_wnd_extra: i32;
    h_instance: u64;
    h_icon: u64;
    h_cursor: u64;
    hbr_background: u64;
    lpsz_menu_name: u64;
    lpsz_class_name: u64;
    h_icon_sm: u64;
}

@layout(c)
struct WinPoint {
    x: i32;
    y: i32;
}

@layout(c)
struct WinRect {
    left: i32;
    top: i32;
    right: i32;
    bottom: i32;
}

@layout(c)
struct WinMsg {
    hwnd: u64;
    message: u32;
    _pad0: u32;
    wparam: u64;
    lparam: i64;
    time: u32;
    pt: WinPoint;
    _pad1: u32;
}

@layout(c)
struct PaintStruct {
    hdc: u64;
    f_erase: i32;
    rc_paint: WinRect;
    f_restore: i32;
    f_inc_update: i32;
    rgb_reserved: [32]u8;
}

@layout(c)
struct BitmapInfoHeader {
    bi_size: u32;
    bi_width: i32;
    bi_height: i32;
    bi_planes: u16;
    bi_bit_count: u16;
    bi_compression: u32;
    bi_size_image: u32;
    bi_xpels_per_meter: i32;
    bi_ypels_per_meter: i32;
    bi_clr_used: u32;
    bi_clr_important: u32;
}

