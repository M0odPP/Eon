}

pub fn call7(fp: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> u64 {
    comptime if @target_arch() == .X86_64 {
        return call7_x64(a0, a1, a2, a3, a4, a5, fp, 0_u64, a6);
    } else {
        return call7_reg(fp, a0, a1, a2, a3, a4, a5, a6);
    }
}

// Wayland ABI descriptors (exact match to `/usr/include/wayland-util.h`)
@layout(c)
struct WlMessage {
    name: u64;
    signature: u64;
    types: u64;
}

@layout(c)
struct WlInterface {
    name: u64;
    version: i32;
    method_count: i32;
    methods: u64;
    event_count: i32;
    _pad0: i32;
    events: u64;
}

@layout(c)
struct PollFd {
    fd: i32;
    events: i16;
    revents: i16;
}

@layout(c)
struct Timespec {
    tv_sec: i64;
    tv_nsec: i64;
}

