                scale_factor: 1.0_f32,
                configured: false,
                should_close: false,
                pointer_x: 0.0_f32,
                pointer_y: 0.0_f32,
                mods: 0_u8,
                queue_ptr: 0_u64,
            },
            opened: false,
        };
    }

    pub fn open_into(self: *mut Self, opts: *events.WindowOptions) -> bool {
        self.st.width = opts.width;
        self.st.height = opts.height;
        self.st.scale_factor = 1.0_f32;
        self.st.should_close = false;
        self.st.configured = false;
        comptime if @target_os() == .Linux {
            let lib = dl_open("libwayland-client.so.0\0".as_bytes());
            if lib == 0_u64 { return false; }
            let f_conn = dl_sym(lib, "wl_display_connect\0".as_bytes());
            self.st.fn_disconnect = dl_sym(lib, "wl_display_disconnect\0".as_bytes());
            self.st.fn_roundtrip = dl_sym(lib, "wl_display_roundtrip\0".as_bytes());
            self.st.fn_dispatch_pending = dl_sym(lib, "wl_display_dispatch_pending\0".as_bytes());
            self.st.fn_prepare_read = dl_sym(lib, "wl_display_prepare_read\0".as_bytes());
            self.st.fn_read_events = dl_sym(lib, "wl_display_read_events\0".as_bytes());
            self.st.fn_cancel_read = dl_sym(lib, "wl_display_cancel_read\0".as_bytes());
            self.st.fn_flush = dl_sym(lib, "wl_display_flush\0".as_bytes());
            self.st.fn_get_fd = dl_sym(lib, "wl_display_get_fd\0".as_bytes());
            self.st.fn_marshal_array_flags = dl_sym(lib, "wl_proxy_marshal_array_flags\0".as_bytes());
            self.st.fn_add_dispatcher = dl_sym(lib, "wl_proxy_add_dispatcher\0".as_bytes());
            self.st.fn_proxy_destroy = dl_sym(lib, "wl_proxy_destroy\0".as_bytes());
            self.st.fn_proxy_get_version = dl_sym(lib, "wl_proxy_get_version\0".as_bytes());

            self.st.iface_registry = dl_sym(lib, "wl_registry_interface\0".as_bytes());
            self.st.iface_compositor = dl_sym(lib, "wl_compositor_interface\0".as_bytes());
            self.st.iface_surface = dl_sym(lib, "wl_surface_interface\0".as_bytes());
            self.st.iface_shm = dl_sym(lib, "wl_shm_interface\0".as_bytes());
            self.st.iface_shm_pool = dl_sym(lib, "wl_shm_pool_interface\0".as_bytes());
            self.st.iface_buffer = dl_sym(lib, "wl_buffer_interface\0".as_bytes());
            self.st.iface_seat = dl_sym(lib, "wl_seat_interface\0".as_bytes());
            self.st.iface_pointer = dl_sym(lib, "wl_pointer_interface\0".as_bytes());
            self.st.iface_keyboard = dl_sym(lib, "wl_keyboard_interface\0".as_bytes());
            self.st.iface_touch = dl_sym(lib, "wl_touch_interface\0".as_bytes());

            if f_conn == 0_u64 || self.st.fn_marshal_array_flags == 0_u64 || self.st.fn_add_dispatcher == 0_u64 {
                raw { _ = dlclose(lib); }
                return false;
            }
            let dpy = call1(f_conn, 0_u64);
            if dpy == 0_u64 {
                raw { _ = dlclose(lib); }
                return false;
            }
            self.st.lib_wl = lib;
            self.st.display = dpy;

            // Optional libxkbcommon for accurate keyboard layout & Unicode text translation.
            let xkb = dl_open("libxkbcommon.so.0\0".as_bytes());
            if xkb != 0_u64 {
                self.st.lib_xkb = xkb;
                self.st.fn_xkb_ctx_new = dl_sym(xkb, "xkb_context_new\0".as_bytes());
                self.st.fn_xkb_ctx_unref = dl_sym(xkb, "xkb_context_unref\0".as_bytes());
                self.st.fn_xkb_keymap_new_from_str = dl_sym(xkb, "xkb_keymap_new_from_string\0".as_bytes());
                self.st.fn_xkb_keymap_unref = dl_sym(xkb, "xkb_keymap_unref\0".as_bytes());
                self.st.fn_xkb_state_new = dl_sym(xkb, "xkb_state_new\0".as_bytes());
                self.st.fn_xkb_state_unref = dl_sym(xkb, "xkb_state_unref\0".as_bytes());
                self.st.fn_xkb_state_update_key = dl_sym(xkb, "xkb_state_update_key\0".as_bytes());
                self.st.fn_xkb_state_update_mask = dl_sym(xkb, "xkb_state_update_mask\0".as_bytes());
                self.st.fn_xkb_state_get_one_sym = dl_sym(xkb, "xkb_state_key_get_one_sym\0".as_bytes());
                self.st.fn_xkb_state_get_utf32 = dl_sym(xkb, "xkb_state_key_get_utf32\0".as_bytes());
                if self.st.fn_xkb_ctx_new != 0_u64 {
                    self.st.xkb_ctx = call1(self.st.fn_xkb_ctx_new, 0_u64);
                }
            }

            init_xdg_ifaces(&mut self.st);

            // wl_display.get_registry (REQ 1)
            let reg_args: [1]u64 = [0_u64];
            let reg = wl_marshal(&self.st, dpy, 1_u32, self.st.iface_registry, 1_u32, 0_u32, &reg_args);
            self.st.registry = reg;
            wl_add_disp(&mut self.st, reg);
            _ = call1(self.st.fn_roundtrip, dpy);

            if self.st.compositor == 0_u64 || self.st.xdg_wm_base == 0_u64 {
                self.close();
                return false;
            }

            // wl_compositor.create_surface (REQ 0)
            let cs_args: [1]u64 = [0_u64];
            let surf = wl_marshal(&self.st, self.st.compositor, 0_u32, self.st.iface_surface, 1_u32, 0_u32, &cs_args);
            self.st.surface = surf;
            if surf == 0_u64 {
                self.close();
                return false;
            }

            // xdg_wm_base.get_xdg_surface (REQ 2: new_id, wl_surface)
            let xs_args: [2]u64 = [0_u64, surf];
            let xsurf = wl_marshal(&self.st, self.st.xdg_wm_base, 2_u32, wl_iface_ptr(&self.st.iface_xdg_surface), 1_u32, 0_u32, &xs_args);
            self.st.xdg_surface = xsurf;
            wl_add_disp(&mut self.st, xsurf);

            // xdg_surface.get_toplevel (REQ 1)
            let xt_args: [1]u64 = [0_u64];
            let xtop = wl_marshal(&self.st, xsurf, 1_u32, wl_iface_ptr(&self.st.iface_xdg_toplevel), 1_u32, 0_u32, &xt_args);
            self.st.xdg_toplevel = xtop;
            wl_add_disp(&mut self.st, xtop);

            // Set title, app_id, min_size, and initial commit
            self.set_title_bytes(opts.title_bytes());
            let aid_args: [1]u64 = [slice_ptr("dev.eon.app\0".as_bytes())];
            _ = wl_marshal(&self.st, xtop, 3_u32, 0_u64, 1_u32, 0_u32, &aid_args);
            let min_args: [2]u64 = [opts.min_width.widen.[u64](), opts.min_height.widen.[u64]()];
            _ = wl_marshal(&self.st, xtop, 8_u32, 0_u64, 1_u32, 0_u32, &min_args);
            if !opts.resizable {
                let max_args: [2]u64 = [opts.width.widen.[u64](), opts.height.widen.[u64]()];
                _ = wl_marshal(&self.st, xtop, 7_u32, 0_u64, 1_u32, 0_u32, &max_args);
            }
            let empty_a: [1]u64 = [0_u64];
            // wl_surface.commit (REQ 6)
            _ = wl_marshal(&self.st, surf, 6_u32, 0_u64, 1_u32, 0_u32, &empty_a);
            _ = call1(self.st.fn_roundtrip, dpy);
            self.opened = true;
            return true;
        } else {
            return false;
        }
    }

    pub fn surface_info(self: *Self) -> events.SurfaceInfo {
        return events.SurfaceInfo.{
            kind: .Wayland,
            display_handle: self.st.display,
            window_handle: self.st.surface,
            extra_handle: self.st.xdg_toplevel,
            width: self.st.width,
            height: self.st.height,
            scale_factor: self.st.scale_factor,
            fb_base_addr: 0_u64,
            fb_pitch_bytes: 0_u32,
            fb_is_bgr: true,
        };
    }

    pub fn poll_events(self: *mut Self, out_q: *mut events.EventQueue) {
        comptime if @target_os() == .Linux {
            if !self.opened || self.st.display == 0_u64 { return; }
            self.st.queue_ptr = queue_mut_ptr(out_q);
            _ = call1(self.st.fn_dispatch_pending, self.st.display);
            _ = call1(self.st.fn_flush, self.st.display);
            if self.st.fn_prepare_read != 0_u64 && self.st.fn_get_fd != 0_u64 {
                let pr = call1(self.st.fn_prepare_read, self.st.display).trunc.[i32]();
                if pr == 0_i32 {
                    let fd = call1(self.st.fn_get_fd, self.st.display).trunc.[i32]();
                    var pfd = PollFd.{ fd: fd, events: POLLIN, revents: 0_i16 };
                    let ts = Timespec.{ tv_sec: 0_i64, tv_nsec: 0_i64 };
                    let ready = sys5(sys_nr_ppoll(), pollfd_ptr(&mut pfd), 1_u64, timespec_ptr(&ts), 0_u64, 0_u64);
                    if ready > 0_i64 && (pfd.revents & POLLIN) != 0_i16 {
                        _ = call1(self.st.fn_read_events, self.st.display);
                        _ = call1(self.st.fn_dispatch_pending, self.st.display);
                    } else {
                        _ = call1(self.st.fn_cancel_read, self.st.display);
                    }
                } else {
                    _ = call1(self.st.fn_dispatch_pending, self.st.display);
                }
            }
            self.st.queue_ptr = 0_u64;
        } else {
            _ = self;
            _ = out_q;
        }
    }

    pub fn set_title_bytes(self: *mut Self, src: *[u8]) {
        comptime if @target_os() == .Linux {
            if self.st.xdg_toplevel == 0_u64 { return; }
            var cbuf: [256]u8 = [0_u8; 256];
            let n: usize = if src.len < 255_usize { src.len } else { 255_usize };
            var i: usize = 0_usize;
            while i < n { cbuf[i] = src[i]; i = i +% 1_usize; }
            let args: [1]u64 = [slice_ptr(&cbuf)];
            _ = wl_marshal(&self.st, self.st.xdg_toplevel, 2_u32, 0_u64, 1_u32, 0_u32, &args);
        } else {
            _ = self;
            _ = src;
        }
    }

    pub fn set_title(self: *mut Self, title: *str) {
        self.set_title_bytes(title.as_bytes());
    }

    pub fn destroy_shm(self: *mut Self) {
        comptime if @target_os() == .Linux {
            let empty_a: [1]u64 = [0_u64];
            if self.st.shm_buffer != 0_u64 {
                _ = wl_marshal(&self.st, self.st.shm_buffer, 0_u32, 0_u64, 1_u32, WL_MARSHAL_FLAG_DESTROY, &empty_a);
                self.st.shm_buffer = 0_u64;
            }
            if self.st.shm_pool != 0_u64 {
                _ = wl_marshal(&self.st, self.st.shm_pool, 1_u32, 0_u64, 1_u32, WL_MARSHAL_FLAG_DESTROY, &empty_a);
                self.st.shm_pool = 0_u64;
            }
            if self.st.shm_ptr != 0_u64 && self.st.shm_size > 0_usize {
                _ = sys2(sys_nr_munmap(), self.st.shm_ptr, self.st.shm_size.widen.[u64]());
                self.st.shm_ptr = 0_u64;
                self.st.shm_size = 0_usize;
            }
            if self.st.shm_fd >= 0_i32 {
                _ = sys1(sys_nr_close(), self.st.shm_fd.bitcast.[u32]().widen.[u64]());
                self.st.shm_fd = -1_i32;
            }
            self.st.shm_w = 0_u32;
            self.st.shm_h = 0_u32;
        } else {
            _ = self;
        }
    }

    pub fn ensure_shm(self: *mut Self, w: u32, h: u32) -> bool {
        comptime if @target_os() == .Linux {
            if self.st.shm == 0_u64 || w == 0_u32 || h == 0_u32 { return false; }
            if self.st.shm_ptr != 0_u64 && self.st.shm_w == w && self.st.shm_h == h {
                return true;
            }
            self.destroy_shm();
            let stride = w *% 4_u32;
            let sz = stride.widen.[usize]() *% h.widen.[usize]();
            let fd = sys2(sys_nr_memfd_create(), slice_ptr("eon_wl_shm\0".as_bytes()), 1_u64).trunc.[i32]();
            if fd < 0_i32 { return false; }
            let tr = sys2(sys_nr_ftruncate(), fd.bitcast.[u32]().widen.[u64](), sz.widen.[u64]());
            if tr < 0_i64 {
                _ = sys1(sys_nr_close(), fd.bitcast.[u32]().widen.[u64]());
                return false;
            }
            let ptr = sys6(sys_nr_mmap(), 0_u64, sz.widen.[u64](), PROT_READ | PROT_WRITE, MAP_SHARED, fd.bitcast.[u32]().widen.[u64](), 0_u64);
            if ptr <= 0_i64 {
                _ = sys1(sys_nr_close(), fd.bitcast.[u32]().widen.[u64]());
                return false;
            }
            let p_args: [3]u64 = [0_u64, fd.bitcast.[u32]().widen.[u64](), sz.widen.[u64]()];
            let shm_p = wl_marshal(&self.st, self.st.shm, 0_u32, self.st.iface_shm_pool, 1_u32, 0_u32, &p_args);
            if shm_p == 0_u64 {
                _ = sys2(sys_nr_munmap(), ptr.bitcast.[u64](), sz.widen.[u64]());
                _ = sys1(sys_nr_close(), fd.bitcast.[u32]().widen.[u64]());
                return false;
            }
            let b_args: [6]u64 = [0_u64, 0_u64, w.widen.[u64](), h.widen.[u64](), stride.widen.[u64](), WL_SHM_FORMAT_XRGB8888.widen.[u64]()];
            let buf = wl_marshal(&self.st, shm_p, 0_u32, self.st.iface_buffer, 1_u32, 0_u32, &b_args);
            self.st.shm_fd = fd;
            self.st.shm_pool = shm_p;
            self.st.shm_buffer = buf;
            self.st.shm_ptr = ptr.bitcast.[u64]();
            self.st.shm_size = sz;
            self.st.shm_w = w;
            self.st.shm_h = h;
            return buf != 0_u64;
        } else {
            _ = self; _ = w; _ = h;
            return false;
        }
    }

    /// Software presentation fallback over `wl_shm` (RGBA8 -> XRGB8888 attach + damage + commit).
    pub fn present_rgba8(self: *mut Self, rgba: *[u8], w: u32, h: u32) {
        comptime if @target_os() == .Linux {
            if !self.opened || self.st.surface == 0_u64 { return; }
            if !self.ensure_shm(w, h) { return; }
            let n_px = w.widen.[usize]() *% h.widen.[usize]();
            if rgba.len >= 4_usize {
                let lim = rgba.len - 4_usize;
                var i: usize = 0_usize;
                while i < n_px {
                    let si = i *% 4_usize;
                    if si <= lim {
                        let r = rgba[si].widen.[u32]();
                        let g = rgba[si + 1_usize].widen.[u32]();
                        let b = rgba[si + 2_usize].widen.[u32]();
                        let xrgb = b | (g << 8_u32) | (r << 16_u32) | 0xFF000000_u32;
                        raw {
                            let p = rawptr_mut.[u32].from_usize((self.st.shm_ptr +% si.widen.[u64]()).trunc.[usize]());
                            p.* = xrgb;
                        }
                    }
                    i = i +% 1_usize;
                }
            }
            let att_args: [3]u64 = [self.st.shm_buffer, 0_u64, 0_u64];
            _ = wl_marshal(&self.st, self.st.surface, 1_u32, 0_u64, 1_u32, 0_u32, &att_args);
            let dmg_args: [4]u64 = [0_u64, 0_u64, w.widen.[u64](), h.widen.[u64]()];
            _ = wl_marshal(&self.st, self.st.surface, 2_u32, 0_u64, 1_u32, 0_u32, &dmg_args);
            let empty_a: [1]u64 = [0_u64];
            _ = wl_marshal(&self.st, self.st.surface, 6_u32, 0_u64, 1_u32, 0_u32, &empty_a);
            _ = call1(self.st.fn_flush, self.st.display);
        } else {
            _ = self; _ = rgba; _ = w; _ = h;
        }
    }

    pub fn close(self: *mut Self) {
        comptime if @target_os() == .Linux {
            self.destroy_shm();
            let empty_a: [1]u64 = [0_u64];
            if self.st.xdg_toplevel != 0_u64 {
                _ = wl_marshal(&self.st, self.st.xdg_toplevel, 0_u32, 0_u64, 1_u32, WL_MARSHAL_FLAG_DESTROY, &empty_a);
                self.st.xdg_toplevel = 0_u64;
            }
            if self.st.xdg_surface != 0_u64 {
                _ = wl_marshal(&self.st, self.st.xdg_surface, 0_u32, 0_u64, 1_u32, WL_MARSHAL_FLAG_DESTROY, &empty_a);
                self.st.xdg_surface = 0_u64;
            }
            if self.st.surface != 0_u64 {
                _ = wl_marshal(&self.st, self.st.surface, 0_u32, 0_u64, 1_u32, WL_MARSHAL_FLAG_DESTROY, &empty_a);
                self.st.surface = 0_u64;
            }
            if self.st.pointer != 0_u64 && self.st.fn_proxy_destroy != 0_u64 {
                _ = call1(self.st.fn_proxy_destroy, self.st.pointer);
                self.st.pointer = 0_u64;
            }
            if self.st.keyboard != 0_u64 && self.st.fn_proxy_destroy != 0_u64 {
                _ = call1(self.st.fn_proxy_destroy, self.st.keyboard);
                self.st.keyboard = 0_u64;
            }
            if self.st.touch != 0_u64 && self.st.fn_proxy_destroy != 0_u64 {
                _ = call1(self.st.fn_proxy_destroy, self.st.touch);
                self.st.touch = 0_u64;
            }
            if self.st.seat != 0_u64 && self.st.fn_proxy_destroy != 0_u64 {
                _ = call1(self.st.fn_proxy_destroy, self.st.seat);
                self.st.seat = 0_u64;
            }
            if self.st.xdg_wm_base != 0_u64 {
                _ = wl_marshal(&self.st, self.st.xdg_wm_base, 0_u32, 0_u64, 1_u32, WL_MARSHAL_FLAG_DESTROY, &empty_a);
                self.st.xdg_wm_base = 0_u64;
            }
            if self.st.shm != 0_u64 && self.st.fn_proxy_destroy != 0_u64 {
                _ = call1(self.st.fn_proxy_destroy, self.st.shm);
                self.st.shm = 0_u64;
            }
            if self.st.compositor != 0_u64 && self.st.fn_proxy_destroy != 0_u64 {
                _ = call1(self.st.fn_proxy_destroy, self.st.compositor);
                self.st.compositor = 0_u64;
            }
            if self.st.registry != 0_u64 && self.st.fn_proxy_destroy != 0_u64 {
                _ = call1(self.st.fn_proxy_destroy, self.st.registry);
                self.st.registry = 0_u64;
            }
            if self.st.display != 0_u64 && self.st.fn_disconnect != 0_u64 {
                _ = call1(self.st.fn_disconnect, self.st.display);
                self.st.display = 0_u64;
            }
            if self.st.xkb_state != 0_u64 && self.st.fn_xkb_state_unref != 0_u64 {
                _ = call1(self.st.fn_xkb_state_unref, self.st.xkb_state);
                self.st.xkb_state = 0_u64;
            }
            if self.st.xkb_keymap != 0_u64 && self.st.fn_xkb_keymap_unref != 0_u64 {
                _ = call1(self.st.fn_xkb_keymap_unref, self.st.xkb_keymap);
                self.st.xkb_keymap = 0_u64;
            }
            if self.st.xkb_ctx != 0_u64 && self.st.fn_xkb_ctx_unref != 0_u64 {
                _ = call1(self.st.fn_xkb_ctx_unref, self.st.xkb_ctx);
                self.st.xkb_ctx = 0_u64;
            }
            if self.st.lib_xkb != 0_u64 {
                raw { _ = dlclose(self.st.lib_xkb); }
                self.st.lib_xkb = 0_u64;
            }
            if self.st.lib_wl != 0_u64 {
                raw { _ = dlclose(self.st.lib_wl); }
                self.st.lib_wl = 0_u64;
            }
        }
        self.opened = false;
    }
}
