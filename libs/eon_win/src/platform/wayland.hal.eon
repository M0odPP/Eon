module eon_win.platform.wayland @hal;

import eon_win.events;

// ============================================================================
// Native Linux Wayland Client Adapter (`libwayland-client.so.0` +
// `libxkbcommon.so.0` via `dlopen`/`dlsym`, non-variadic `wl_proxy_marshal_array_flags`
// + `wl_proxy_add_dispatcher`, `xdg-shell`, `wl_shm` software present,
// `VK_KHR_wayland_surface` handles) — Zero C Toolchain!
// ============================================================================

const RTLD_LAZY: i32 = 1_i32;
const PROT_READ: u64 = 1_u64;
const PROT_WRITE: u64 = 2_u64;
const MAP_SHARED: u64 = 1_u64;
const POLLIN: i16 = 1_i16;
const WL_SHM_FORMAT_XRGB8888: u32 = 1_u32;
const WL_MARSHAL_FLAG_DESTROY: u32 = 1_u32;

const BTN_LEFT: u32 = 0x110_u32;
const BTN_RIGHT: u32 = 0x111_u32;
const BTN_MIDDLE: u32 = 0x112_u32;
const BTN_SIDE: u32 = 0x113_u32;
const BTN_EXTRA: u32 = 0x114_u32;

extern "C" fn dlopen(path: u64, flags: i32) -> u64;
extern "C" fn dlsym(handle: u64, sym: u64) -> u64;
extern "C" fn dlclose(handle: u64) -> i32;

@inline pub fn sys_nr_close() -> u64 { comptime if @target_arch() == .AArch64 || @target_arch() == .RiscV64 { return 57_u64; } else { return 3_u64; } }
@inline pub fn sys_nr_ftruncate() -> u64 { comptime if @target_arch() == .AArch64 || @target_arch() == .RiscV64 { return 46_u64; } else { return 77_u64; } }
@inline pub fn sys_nr_mmap() -> u64 { comptime if @target_arch() == .AArch64 || @target_arch() == .RiscV64 { return 222_u64; } else { return 9_u64; } }
@inline pub fn sys_nr_munmap() -> u64 { comptime if @target_arch() == .AArch64 || @target_arch() == .RiscV64 { return 215_u64; } else { return 11_u64; } }
@inline pub fn sys_nr_memfd_create() -> u64 { comptime if @target_arch() == .AArch64 || @target_arch() == .RiscV64 { return 279_u64; } else { return 319_u64; } }
@inline pub fn sys_nr_ppoll() -> u64 { comptime if @target_arch() == .AArch64 || @target_arch() == .RiscV64 { return 73_u64; } else { return 271_u64; } }

@naked
pub fn sys1(_nr: u64, _a0: u64) -> i64 {
    comptime if @target_os() == .Linux && @target_arch() == .AArch64 {
        raw { asm("mov x8, x0; mov x0, x1; svc #0; ret", options(noreturn)); }
    } else comptime if @target_os() == .Linux && @target_arch() == .RiscV64 {
        raw { asm("mv a7, a0; mv a0, a1; ecall; ret", options(noreturn)); }
    } else comptime if @target_os() == .Linux {
        raw { asm("mov rax, rdi; mov rdi, rsi; syscall; ret", options(noreturn)); }
    } else {
        raw { asm("ret", options(noreturn)); }
    }
    return 0_i64;
}

