}

pub fn cstr_eq(ptr: u64, lit: *[u8]) -> bool {
    if ptr == 0_u64 { return false; }
    var i: usize = 0_usize;
    while i < lit.len {
        var b: u8 = 0_u8;
        raw { b = rawptr.[u8].from_usize((ptr +% i.widen.[u64]()).trunc.[usize]()).*; }
        if b != lit[i] { return false; }
        i = i +% 1_usize;
    }
    var term: u8 = 1_u8;
    raw { term = rawptr.[u8].from_usize((ptr +% lit.len.widen.[u64]()).trunc.[usize]()).*; }
    return term == 0_u8;
}

pub fn wl_arg_u32(args: u64, idx: usize) -> u32 {
    raw { return rawptr.[u32].from_usize((args +% (idx *% 8_usize).widen.[u64]()).trunc.[usize]()).*; }
}

pub fn wl_arg_i32(args: u64, idx: usize) -> i32 {
    raw { return rawptr.[i32].from_usize((args +% (idx *% 8_usize).widen.[u64]()).trunc.[usize]()).*; }
}

pub fn wl_arg_u64(args: u64, idx: usize) -> u64 {
    raw { return rawptr.[u64].from_usize((args +% (idx *% 8_usize).widen.[u64]()).trunc.[usize]()).*; }
}

pub fn dl_open(name_z: *[u8]) -> u64 {
    comptime if @target_os() == .Linux {
        raw { return dlopen(slice_ptr(name_z), RTLD_LAZY); }
    } else {
        _ = name_z;
        return 0_u64;
    }
}

pub fn dl_sym(h: u64, name_z: *[u8]) -> u64 {
    comptime if @target_os() == .Linux {
        if h == 0_u64 { return 0_u64; }
        raw { return dlsym(h, slice_ptr(name_z)); }
    } else {
        _ = h; _ = name_z;
        return 0_u64;
    }
}

pub struct WaylandState {
    pub lib_wl: u64;
    pub lib_xkb: u64;
    pub display: u64;
    pub registry: u64;
    pub compositor: u64;
    pub shm: u64;
    pub surface: u64;
    pub xdg_wm_base: u64;
    pub xdg_surface: u64;
    pub xdg_toplevel: u64;
    pub seat: u64;
    pub pointer: u64;
    pub keyboard: u64;
    pub touch: u64;

    // Function pointers resolved from libwayland-client.so.0
    pub fn_disconnect: u64;
    pub fn_roundtrip: u64;
    pub fn_dispatch_pending: u64;
    pub fn_prepare_read: u64;
    pub fn_read_events: u64;
    pub fn_cancel_read: u64;
    pub fn_flush: u64;
    pub fn_get_fd: u64;
    pub fn_marshal_array_flags: u64;
    pub fn_add_dispatcher: u64;
    pub fn_proxy_destroy: u64;
    pub fn_proxy_get_version: u64;

    // Standard wl_interface pointers from libwayland-client.so.0
    pub iface_registry: u64;
    pub iface_compositor: u64;
    pub iface_surface: u64;
    pub iface_shm: u64;
    pub iface_shm_pool: u64;
    pub iface_buffer: u64;
    pub iface_seat: u64;
    pub iface_pointer: u64;
    pub iface_keyboard: u64;
    pub iface_touch: u64;

    // xkbcommon function pointers & state
    pub xkb_ctx: u64;
    pub xkb_keymap: u64;
    pub xkb_state: u64;
    pub fn_xkb_ctx_new: u64;
    pub fn_xkb_ctx_unref: u64;
    pub fn_xkb_keymap_new_from_str: u64;
    pub fn_xkb_keymap_unref: u64;
    pub fn_xkb_state_new: u64;
    pub fn_xkb_state_unref: u64;
    pub fn_xkb_state_update_key: u64;
    pub fn_xkb_state_update_mask: u64;
    pub fn_xkb_state_get_one_sym: u64;
    pub fn_xkb_state_get_utf32: u64;

    // Inline xdg-shell protocol tables (lifetime == WaylandState)
    xdg_null_types: [8]u64;
    xdg_get_surf_types: [2]u64;
    xdg_get_top_types: [1]u64;
    xdg_wm_reqs: [4]WlMessage;
    xdg_wm_evs: [1]WlMessage;
    xdg_surf_reqs: [5]WlMessage;
    xdg_surf_evs: [1]WlMessage;
    xdg_top_reqs: [14]WlMessage;
    xdg_top_evs: [4]WlMessage;
    pub iface_xdg_wm_base: WlInterface;
    pub iface_xdg_surface: WlInterface;
    pub iface_xdg_toplevel: WlInterface;

    // SHM software presentation buffer
    pub shm_fd: i32;
    pub shm_pool: u64;
    pub shm_buffer: u64;
    pub shm_ptr: u64;
    pub shm_size: usize;
    pub shm_w: u32;
    pub shm_h: u32;

    // Live window state
    pub width: u32;
    pub height: u32;
    pub pending_w: u32;
    pub pending_h: u32;
    pub scale_factor: f32;
    pub configured: bool;
    pub should_close: bool;
    pub pointer_x: f32;
    pub pointer_y: f32;
    pub mods: u8;
    pub queue_ptr: u64;
}

@naked
pub fn queue_mut_ptr(_q: *mut events.EventQueue) -> u64 {
    comptime if @target_arch() == .AArch64 || @target_arch() == .RiscV64 {
        raw { asm("ret", options(noreturn)); }
    } else {
        raw { asm("mov rax, rdi; ret", options(noreturn)); }
    }
    return 0_u64;
}

pub fn push_ev(qp: u64, ev: events.PlatformEvent) {
    if qp != 0_u64 {
        raw {
            let q = rawptr_mut.[events.EventQueue].from_usize(qp.trunc.[usize]());
            q.*.push(ev);
        }
    }
}

pub fn wl_marshal(st: *WaylandState, proxy: u64, op: u32, wl_if: u64, ver: u32, flags: u32, args: *[u64]) -> u64 {
    if proxy == 0_u64 || st.fn_marshal_array_flags == 0_u64 { return 0_u64; }
    return call6(
        st.fn_marshal_array_flags,
        proxy,
        op.widen.[u64](),
        wl_if,
        ver.widen.[u64](),
        flags.widen.[u64](),
        u64_slice_ptr(args),
    );
}

pub fn wl_bind_global(st: *mut WaylandState, name: u32, iface_ptr: u64, iface_name_z: *[u8], ver: u32) -> u64 {
    let args: [4]u64 = [
        name.widen.[u64](),
        slice_ptr(iface_name_z),
        ver.widen.[u64](),
        0_u64,
    ];
    return wl_marshal(st, st.registry, 0_u32, iface_ptr, ver, 0_u32, &args);
}

pub fn wl_add_disp(st: *mut WaylandState, proxy: u64) {
    if proxy == 0_u64 || st.fn_add_dispatcher == 0_u64 { return; }
    let self_addr = wl_state_ptr(st);
    _ = call4(st.fn_add_dispatcher, proxy, disp_fn_ptr(eon_wl_dispatch), self_addr, self_addr);
}

@extern("C")
pub fn eon_wl_dispatch(user_data: u64, target: u64, opcode: u32, _msg: u64, args: u64) -> i32 {
    comptime if @target_os() == .Linux {
        if user_data == 0_u64 || target == 0_u64 { return 0_i32; }
        raw {
            let st = rawptr_mut.[WaylandState].from_usize(user_data.trunc.[usize]());
            if target == st.*.registry {
                if opcode == 0_u32 {
                    let gname = wl_arg_u32(args, 0_usize);
                    let giface = wl_arg_u64(args, 1_usize);
                    let gver = wl_arg_u32(args, 2_usize);
                    if cstr_eq(giface, "wl_compositor".as_bytes()) && st.*.compositor == 0_u64 {
                        let v: u32 = if gver < 4_u32 { gver } else { 4_u32 };
                        st.*.compositor = wl_bind_global(&mut st.*, gname, st.*.iface_compositor, "wl_compositor\0".as_bytes(), v);
                    } else if cstr_eq(giface, "wl_shm".as_bytes()) && st.*.shm == 0_u64 {
                        st.*.shm = wl_bind_global(&mut st.*, gname, st.*.iface_shm, "wl_shm\0".as_bytes(), 1_u32);
                    } else if cstr_eq(giface, "xdg_wm_base".as_bytes()) && st.*.xdg_wm_base == 0_u64 {
                        let v: u32 = if gver < 2_u32 { gver } else { 2_u32 };
                        let xdg_if = wl_iface_ptr(&st.*.iface_xdg_wm_base);
                        let xb = wl_bind_global(&mut st.*, gname, xdg_if, "xdg_wm_base\0".as_bytes(), v);
                        st.*.xdg_wm_base = xb;
                        wl_add_disp(&mut st.*, xb);
                    } else if cstr_eq(giface, "wl_seat".as_bytes()) && st.*.seat == 0_u64 {
                        let v: u32 = if gver < 5_u32 { gver } else { 5_u32 };
                        let seat = wl_bind_global(&mut st.*, gname, st.*.iface_seat, "wl_seat\0".as_bytes(), v);
                        st.*.seat = seat;
                        wl_add_disp(&mut st.*, seat);
                    }
                }
                return 0_i32;
            }
            if target == st.*.xdg_wm_base {
                if opcode == 0_u32 {
                    let serial = wl_arg_u32(args, 0_usize);
                    let pargs: [1]u64 = [serial.widen.[u64]()];
                    _ = wl_marshal(&st.*, target, 3_u32, 0_u64, 1_u32, 0_u32, &pargs);
                }
                return 0_i32;
            }
            if target == st.*.xdg_surface {
                if opcode == 0_u32 {
                    let serial = wl_arg_u32(args, 0_usize);
                    let aargs: [1]u64 = [serial.widen.[u64]()];
                    _ = wl_marshal(&st.*, target, 4_u32, 0_u64, 1_u32, 0_u32, &aargs);
                    if st.*.pending_w > 0_u32 && st.*.pending_h > 0_u32 {
                        if st.*.pending_w != st.*.width || st.*.pending_h != st.*.height {
                            st.*.width = st.*.pending_w;
                            st.*.height = st.*.pending_h;
                            push_ev(st.*.queue_ptr, .Resized(events.WindowSize.{ width: st.*.width, height: st.*.height }));
                        }
                        st.*.pending_w = 0_u32;
                        st.*.pending_h = 0_u32;
                    }
                    st.*.configured = true;
                    push_ev(st.*.queue_ptr, .RedrawRequested);
                }
                return 0_i32;
            }
            if target == st.*.xdg_toplevel {
                if opcode == 0_u32 {
                    let nw = wl_arg_i32(args, 0_usize);
                    let nh = wl_arg_i32(args, 1_usize);
                    if nw > 0_i32 && nh > 0_i32 {
                        st.*.pending_w = nw.bitcast.[u32]();
                        st.*.pending_h = nh.bitcast.[u32]();
                    }
                } else if opcode == 1_u32 {
                    st.*.should_close = true;
                    push_ev(st.*.queue_ptr, .CloseRequested);
                }
                return 0_i32;
            }
            if target == st.*.seat {
                if opcode == 0_u32 {
                    let caps = wl_arg_u32(args, 0_usize);
                    let empty_a: [1]u64 = [0_u64];
                    if (caps & 1_u32) != 0_u32 && st.*.pointer == 0_u64 {
                        let ptr = wl_marshal(&st.*, target, 0_u32, st.*.iface_pointer, 1_u32, 0_u32, &empty_a);
                        st.*.pointer = ptr;
                        wl_add_disp(&mut st.*, ptr);
                    }
                    if (caps & 2_u32) != 0_u32 && st.*.keyboard == 0_u64 {
                        let kbd = wl_marshal(&st.*, target, 1_u32, st.*.iface_keyboard, 1_u32, 0_u32, &empty_a);
                        st.*.keyboard = kbd;
                        wl_add_disp(&mut st.*, kbd);
                    }
                    if (caps & 4_u32) != 0_u32 && st.*.touch == 0_u64 {
                        let tch = wl_marshal(&st.*, target, 2_u32, st.*.iface_touch, 1_u32, 0_u32, &empty_a);
                        st.*.touch = tch;
                        wl_add_disp(&mut st.*, tch);
                    }
                }
                return 0_i32;
            }
            if target == st.*.pointer {
                if opcode == 0_u32 {
                    let fx = wl_arg_i32(args, 2_usize).to_float.[f32]() / 256.0_f32;
                    let fy = wl_arg_i32(args, 3_usize).to_float.[f32]() / 256.0_f32;
                    st.*.pointer_x = fx;
                    st.*.pointer_y = fy;
                    push_ev(st.*.queue_ptr, .MouseMove(events.MouseMoveEvent.{ x: fx, y: fy, mods: events.Modifiers.from_bits(st.*.mods) }));
                } else if opcode == 2_u32 {
                    let fx = wl_arg_i32(args, 1_usize).to_float.[f32]() / 256.0_f32;
                    let fy = wl_arg_i32(args, 2_usize).to_float.[f32]() / 256.0_f32;
                    st.*.pointer_x = fx;
                    st.*.pointer_y = fy;
                    push_ev(st.*.queue_ptr, .MouseMove(events.MouseMoveEvent.{ x: fx, y: fy, mods: events.Modifiers.from_bits(st.*.mods) }));
                } else if opcode == 3_u32 {
                    let btn_c = wl_arg_u32(args, 2_usize);
                    let state = wl_arg_u32(args, 3_usize);
                    let btn: events.MouseButton = if btn_c == BTN_LEFT { .Left }
                        else if btn_c == BTN_RIGHT { .Right }
                        else if btn_c == BTN_MIDDLE { .Middle }
                        else if btn_c == BTN_SIDE { .Back }
                        else { .Forward };
                    let mods = events.Modifiers.from_bits(st.*.mods);
                    if state != 0_u32 {
                        push_ev(st.*.queue_ptr, .MouseDown(events.MouseButtonEvent.{ button: btn, x: st.*.pointer_x, y: st.*.pointer_y, click_count: 1_u8, mods: mods }));
                    } else {
                        push_ev(st.*.queue_ptr, .MouseUp(events.MouseButtonEvent.{ button: btn, x: st.*.pointer_x, y: st.*.pointer_y, click_count: 0_u8, mods: mods }));
                    }
                } else if opcode == 4_u32 {
                    let axis = wl_arg_u32(args, 1_usize);
                    let val = wl_arg_i32(args, 2_usize).to_float.[f32]() / 256.0_f32;
                    let dx: f32 = if axis == 1_u32 { -val } else { 0.0_f32 };
                    let dy: f32 = if axis == 0_u32 { -val } else { 0.0_f32 };
                    push_ev(st.*.queue_ptr, .MouseWheel(events.MouseWheelEvent.{ dx: dx, dy: dy, x: st.*.pointer_x, y: st.*.pointer_y, mods: events.Modifiers.from_bits(st.*.mods) }));
                }
                return 0_i32;
            }
            if target == st.*.keyboard {
                if opcode == 0_u32 {
                    let fmt = wl_arg_u32(args, 0_usize);
                    let fd = wl_arg_i32(args, 1_usize);
                    let sz = wl_arg_u32(args, 2_usize);
                    if fmt == 1_u32 && fd >= 0_i32 && sz > 0_u32 && st.*.xkb_ctx != 0_u64 && st.*.fn_xkb_keymap_new_from_str != 0_u64 {
                        let map = sys6(sys_nr_mmap(), 0_u64, sz.widen.[u64](), PROT_READ, MAP_SHARED, fd.bitcast.[u32]().widen.[u64](), 0_u64);
                        if map > 0_i64 {
                            if st.*.xkb_state != 0_u64 && st.*.fn_xkb_state_unref != 0_u64 {
                                _ = call1(st.*.fn_xkb_state_unref, st.*.xkb_state);
                                st.*.xkb_state = 0_u64;
                            }
                            if st.*.xkb_keymap != 0_u64 && st.*.fn_xkb_keymap_unref != 0_u64 {
                                _ = call1(st.*.fn_xkb_keymap_unref, st.*.xkb_keymap);
                                st.*.xkb_keymap = 0_u64;
                            }
                            let km = call4(st.*.fn_xkb_keymap_new_from_str, st.*.xkb_ctx, map.bitcast.[u64](), 1_u64, 0_u64);
                            st.*.xkb_keymap = km;
                            if km != 0_u64 && st.*.fn_xkb_state_new != 0_u64 {
                                st.*.xkb_state = call1(st.*.fn_xkb_state_new, km);
                            }
                            _ = sys2(sys_nr_munmap(), map.bitcast.[u64](), sz.widen.[u64]());
                        }
                    }
                    if fd >= 0_i32 {
                        _ = sys1(sys_nr_close(), fd.bitcast.[u32]().widen.[u64]());
                    }
                } else if opcode == 1_u32 {
                    push_ev(st.*.queue_ptr, .FocusChanged(true));
                } else if opcode == 2_u32 {
                    push_ev(st.*.queue_ptr, .FocusChanged(false));
                } else if opcode == 3_u32 {
                    let sc = wl_arg_u32(args, 2_usize);
                    let state = wl_arg_u32(args, 3_usize);
                    let xkb_kc = sc +% 8_u32;
                    var key = events.key_from_evdev(sc);
                    var ch: u32 = 0_u32;
                    if st.*.xkb_state != 0_u64 && st.*.fn_xkb_state_get_one_sym != 0_u64 {
                        let sym = call2(st.*.fn_xkb_state_get_one_sym, st.*.xkb_state, xkb_kc.widen.[u64]()).trunc.[u32]();
                        let xk = events.key_from_xkb_sym(sym);
                        if xk != .Unknown { key = xk; }
                        if state != 0_u32 && st.*.fn_xkb_state_get_utf32 != 0_u64 {
                            ch = call2(st.*.fn_xkb_state_get_utf32, st.*.xkb_state, xkb_kc.widen.[u64]()).trunc.[u32]();
                        }
                    }
                    if key == .Shift {
                        if state != 0_u32 { st.*.mods = st.*.mods | events.MOD_SHIFT; }
                        else { st.*.mods = st.*.mods & (~events.MOD_SHIFT); }
                    } else if key == .Control {
                        if state != 0_u32 { st.*.mods = st.*.mods | events.MOD_CTRL; }
                        else { st.*.mods = st.*.mods & (~events.MOD_CTRL); }
                    } else if key == .Alt {
                        if state != 0_u32 { st.*.mods = st.*.mods | events.MOD_ALT; }
                        else { st.*.mods = st.*.mods & (~events.MOD_ALT); }
                    } else if key == .Meta {
                        if state != 0_u32 { st.*.mods = st.*.mods | events.MOD_META; }
                        else { st.*.mods = st.*.mods & (~events.MOD_META); }
                    }
                    let mods = events.Modifiers.from_bits(st.*.mods);
                    if state != 0_u32 {
                        push_ev(st.*.queue_ptr, .KeyDown(events.KeyEvent.{ key: key, scancode: sc, repeat: false, mods: mods }));
                        if ch >= 0x20_u32 && ch != 0x7F_u32 && !mods.has_ctrl() && !mods.has_alt() {
                            push_ev(st.*.queue_ptr, .TextInput(ch));
                        }
                    } else {
                        push_ev(st.*.queue_ptr, .KeyUp(events.KeyEvent.{ key: key, scancode: sc, repeat: false, mods: mods }));
                    }
                } else if opcode == 4_u32 {
                    let dep = wl_arg_u32(args, 1_usize);
                    let lat = wl_arg_u32(args, 2_usize);
                    let lck = wl_arg_u32(args, 3_usize);
                    let grp = wl_arg_u32(args, 4_usize);
                    if st.*.xkb_state != 0_u64 && st.*.fn_xkb_state_update_mask != 0_u64 {
                        _ = call7(st.*.fn_xkb_state_update_mask, st.*.xkb_state, dep.widen.[u64](), lat.widen.[u64](), lck.widen.[u64](), 0_u64, 0_u64, grp.widen.[u64]());
                    }
                    var mb: u8 = 0_u8;
                    if (dep & 1_u32) != 0_u32 { mb = mb | events.MOD_SHIFT; }
                    if (dep & 4_u32) != 0_u32 { mb = mb | events.MOD_CTRL; }
                    if (dep & 8_u32) != 0_u32 { mb = mb | events.MOD_ALT; }
                    if (dep & 64_u32) != 0_u32 { mb = mb | events.MOD_META; }
                    st.*.mods = mb;
                }
                return 0_i32;
            }
            if target == st.*.touch {
                if opcode == 0_u32 {
                    let id = wl_arg_u32(args, 3_usize);
                    let x = wl_arg_i32(args, 4_usize).to_float.[f32]() / 256.0_f32;
                    let y = wl_arg_i32(args, 5_usize).to_float.[f32]() / 256.0_f32;
                    push_ev(st.*.queue_ptr, .Touch(events.TouchEvent.{ id: id, phase: .Started, x: x, y: y }));
                } else if opcode == 1_u32 {
                    let id = wl_arg_u32(args, 2_usize);
                    push_ev(st.*.queue_ptr, .Touch(events.TouchEvent.{ id: id, phase: .Ended, x: st.*.pointer_x, y: st.*.pointer_y }));
                } else if opcode == 2_u32 {
                    let id = wl_arg_u32(args, 1_usize);
                    let x = wl_arg_i32(args, 2_usize).to_float.[f32]() / 256.0_f32;
                    let y = wl_arg_i32(args, 3_usize).to_float.[f32]() / 256.0_f32;
                    push_ev(st.*.queue_ptr, .Touch(events.TouchEvent.{ id: id, phase: .Moved, x: x, y: y }));
                }
                return 0_i32;
            }
        }
        return 0_i32;
    } else {
        _ = user_data; _ = target; _ = opcode; _ = args;
        return 0_i32;
    }
}

pub fn empty_wl_msg() -> WlMessage {
    return WlMessage.{ name: 0_u64, signature: 0_u64, types: 0_u64 };
}

pub fn empty_wl_iface() -> WlInterface {
    return WlInterface.{ name: 0_u64, version: 1_i32, method_count: 0_i32, methods: 0_u64, event_count: 0_i32, _pad0: 0_i32, events: 0_u64 };
}

pub fn init_xdg_ifaces(st: *mut WaylandState) {
    let nt = u64_slice_ptr(&st.xdg_null_types);

    // Pre-populate type tables (note: pointers inside `st` stay stable while `st` is pinned in caller)
    st.xdg_get_surf_types[0_usize] = wl_iface_ptr(&st.iface_xdg_surface);
    st.xdg_get_surf_types[1_usize] = st.iface_surface;
    st.xdg_get_top_types[0_usize] = wl_iface_ptr(&st.iface_xdg_toplevel);

    // xdg_wm_base (v2)
    st.xdg_wm_reqs[0_usize] = WlMessage.{ name: slice_ptr("destroy\0".as_bytes()), signature: slice_ptr("\0".as_bytes()), types: nt };
    st.xdg_wm_reqs[1_usize] = WlMessage.{ name: slice_ptr("create_positioner\0".as_bytes()), signature: slice_ptr("n\0".as_bytes()), types: nt };
    st.xdg_wm_reqs[2_usize] = WlMessage.{ name: slice_ptr("get_xdg_surface\0".as_bytes()), signature: slice_ptr("no\0".as_bytes()), types: u64_slice_ptr(&st.xdg_get_surf_types) };
    st.xdg_wm_reqs[3_usize] = WlMessage.{ name: slice_ptr("pong\0".as_bytes()), signature: slice_ptr("u\0".as_bytes()), types: nt };
    st.xdg_wm_evs[0_usize] = WlMessage.{ name: slice_ptr("ping\0".as_bytes()), signature: slice_ptr("u\0".as_bytes()), types: nt };
    st.iface_xdg_wm_base = WlInterface.{
        name: slice_ptr("xdg_wm_base\0".as_bytes()),
        version: 2_i32,
        method_count: 4_i32,
        methods: wl_msg_slice_ptr(&st.xdg_wm_reqs),
        event_count: 1_i32,
        _pad0: 0_i32,
        events: wl_msg_slice_ptr(&st.xdg_wm_evs),
    };

    // xdg_surface (v2)
    st.xdg_surf_reqs[0_usize] = WlMessage.{ name: slice_ptr("destroy\0".as_bytes()), signature: slice_ptr("\0".as_bytes()), types: nt };
    st.xdg_surf_reqs[1_usize] = WlMessage.{ name: slice_ptr("get_toplevel\0".as_bytes()), signature: slice_ptr("n\0".as_bytes()), types: u64_slice_ptr(&st.xdg_get_top_types) };
    st.xdg_surf_reqs[2_usize] = WlMessage.{ name: slice_ptr("get_popup\0".as_bytes()), signature: slice_ptr("n?oo\0".as_bytes()), types: nt };
    st.xdg_surf_reqs[3_usize] = WlMessage.{ name: slice_ptr("set_window_geometry\0".as_bytes()), signature: slice_ptr("iiii\0".as_bytes()), types: nt };
    st.xdg_surf_reqs[4_usize] = WlMessage.{ name: slice_ptr("ack_configure\0".as_bytes()), signature: slice_ptr("u\0".as_bytes()), types: nt };
    st.xdg_surf_evs[0_usize] = WlMessage.{ name: slice_ptr("configure\0".as_bytes()), signature: slice_ptr("u\0".as_bytes()), types: nt };
    st.iface_xdg_surface = WlInterface.{
        name: slice_ptr("xdg_surface\0".as_bytes()),
        version: 2_i32,
        method_count: 5_i32,
        methods: wl_msg_slice_ptr(&st.xdg_surf_reqs),
        event_count: 1_i32,
        _pad0: 0_i32,
        events: wl_msg_slice_ptr(&st.xdg_surf_evs),
    };

    // xdg_toplevel (v2)
    st.xdg_top_reqs[0_usize] = WlMessage.{ name: slice_ptr("destroy\0".as_bytes()), signature: slice_ptr("\0".as_bytes()), types: nt };
    st.xdg_top_reqs[1_usize] = WlMessage.{ name: slice_ptr("set_parent\0".as_bytes()), signature: slice_ptr("?o\0".as_bytes()), types: nt };
    st.xdg_top_reqs[2_usize] = WlMessage.{ name: slice_ptr("set_title\0".as_bytes()), signature: slice_ptr("s\0".as_bytes()), types: nt };
    st.xdg_top_reqs[3_usize] = WlMessage.{ name: slice_ptr("set_app_id\0".as_bytes()), signature: slice_ptr("s\0".as_bytes()), types: nt };
    st.xdg_top_reqs[4_usize] = WlMessage.{ name: slice_ptr("show_window_menu\0".as_bytes()), signature: slice_ptr("ouii\0".as_bytes()), types: nt };
    st.xdg_top_reqs[5_usize] = WlMessage.{ name: slice_ptr("move\0".as_bytes()), signature: slice_ptr("ou\0".as_bytes()), types: nt };
    st.xdg_top_reqs[6_usize] = WlMessage.{ name: slice_ptr("resize\0".as_bytes()), signature: slice_ptr("ouu\0".as_bytes()), types: nt };
    st.xdg_top_reqs[7_usize] = WlMessage.{ name: slice_ptr("set_max_size\0".as_bytes()), signature: slice_ptr("ii\0".as_bytes()), types: nt };
    st.xdg_top_reqs[8_usize] = WlMessage.{ name: slice_ptr("set_min_size\0".as_bytes()), signature: slice_ptr("ii\0".as_bytes()), types: nt };
    st.xdg_top_reqs[9_usize] = WlMessage.{ name: slice_ptr("set_maximized\0".as_bytes()), signature: slice_ptr("\0".as_bytes()), types: nt };
    st.xdg_top_reqs[10_usize] = WlMessage.{ name: slice_ptr("unset_maximized\0".as_bytes()), signature: slice_ptr("\0".as_bytes()), types: nt };
    st.xdg_top_reqs[11_usize] = WlMessage.{ name: slice_ptr("set_fullscreen\0".as_bytes()), signature: slice_ptr("?o\0".as_bytes()), types: nt };
    st.xdg_top_reqs[12_usize] = WlMessage.{ name: slice_ptr("unset_fullscreen\0".as_bytes()), signature: slice_ptr("\0".as_bytes()), types: nt };
    st.xdg_top_reqs[13_usize] = WlMessage.{ name: slice_ptr("set_minimized\0".as_bytes()), signature: slice_ptr("\0".as_bytes()), types: nt };
    st.xdg_top_evs[0_usize] = WlMessage.{ name: slice_ptr("configure\0".as_bytes()), signature: slice_ptr("iia\0".as_bytes()), types: nt };
    st.xdg_top_evs[1_usize] = WlMessage.{ name: slice_ptr("close\0".as_bytes()), signature: slice_ptr("\0".as_bytes()), types: nt };
    st.xdg_top_evs[2_usize] = WlMessage.{ name: slice_ptr("configure_bounds\0".as_bytes()), signature: slice_ptr("4ii\0".as_bytes()), types: nt };
    st.xdg_top_evs[3_usize] = WlMessage.{ name: slice_ptr("wm_capabilities\0".as_bytes()), signature: slice_ptr("5a\0".as_bytes()), types: nt };
    st.iface_xdg_toplevel = WlInterface.{
        name: slice_ptr("xdg_toplevel\0".as_bytes()),
        version: 2_i32,
        method_count: 14_i32,
        methods: wl_msg_slice_ptr(&st.xdg_top_reqs),
        event_count: 4_i32,
        _pad0: 0_i32,
        events: wl_msg_slice_ptr(&st.xdg_top_evs),
    };
}

pub struct WaylandWindow {
    pub st: WaylandState;
    pub opened: bool;
}

impl WaylandWindow {
