                fn_get_fd: 0_u64,
                fn_marshal_array_flags: 0_u64,
                fn_add_dispatcher: 0_u64,
                fn_proxy_destroy: 0_u64,
                fn_proxy_get_version: 0_u64,
                iface_registry: 0_u64,
                iface_compositor: 0_u64,
                iface_surface: 0_u64,
                iface_shm: 0_u64,
                iface_shm_pool: 0_u64,
                iface_buffer: 0_u64,
                iface_seat: 0_u64,
                iface_pointer: 0_u64,
                iface_keyboard: 0_u64,
                iface_touch: 0_u64,
                xkb_ctx: 0_u64,
                xkb_keymap: 0_u64,
                xkb_state: 0_u64,
                fn_xkb_ctx_new: 0_u64,
                fn_xkb_ctx_unref: 0_u64,
                fn_xkb_keymap_new_from_str: 0_u64,
                fn_xkb_keymap_unref: 0_u64,
                fn_xkb_state_new: 0_u64,
                fn_xkb_state_unref: 0_u64,
                fn_xkb_state_update_key: 0_u64,
                fn_xkb_state_update_mask: 0_u64,
                fn_xkb_state_get_one_sym: 0_u64,
                fn_xkb_state_get_utf32: 0_u64,
                xdg_null_types: [0_u64; 8],
                xdg_get_surf_types: [0_u64; 2],
