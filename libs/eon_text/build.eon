module eon_text.build;

pub fn build(b: *mut BuildCap) {
    b.add_dep("eon_win", "../eon_win");
    b.add_dep("eon_gpu", "../eon_gpu");
    b.allow_hal("eon_win.platform.wayland");
    b.allow_hal("eon_win.platform.x11");
    b.allow_hal("eon_win.platform.win32");
    b.allow_hal("eon_win.platform.macos");
    b.allow_hal("eon_win.platform.android");
    b.allow_hal("eon_win.platform.ios");
    b.allow_hal("eon_win.platform.nostd_fb");
    b.allow_hal("eon_gpu.backends.vulkan");
    b.allow_hal("eon_gpu.backends.metal");
    b.allow_hal("eon_text.sys_font");
    b.set_out_dir("out");
    b.add_lib("eon_text", "src");
}
