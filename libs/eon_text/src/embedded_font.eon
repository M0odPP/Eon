module eon_text.embedded_font;

// ============================================================================
// Embedded SIL Open Font License 1.1 TrueType Subsets (100% Freestanding!)
// Derived from Liberation Sans Regular (24404 B) and Liberation Mono Regular (17860 B).
// Covers printable ASCII (U+0020..U+007E) plus UI & calculator/math symbols.
// Stored as single .rodata Base64 literals for instant zero-bloat compilation
// and decoded once at engine init into genuine TrueType (.ttf) byte buffers.
// ============================================================================

pub const FONT_UI_SANS_LEN: usize = 24404_usize;
pub const FONT_UI_MONO_LEN: usize = 17860_usize;

pub const FONT_UI_SANS_B64: *str = "";
pub const FONT_UI_MONO_B64: *str = "";

@inline
fn b64_val(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' { return c - b'A'; }
    if c >= b'a' && c <= b'z' { return (c - b'a') +% 26_u8; }
    if c >= b'0' && c <= b'9' { return (c - b'0') +% 52_u8; }
    if c == b'+' { return 62_u8; }
    if c == b'/' { return 63_u8; }
    return 0_u8;
}

/// Decode Base64 string `src` into `dst`, returning exact decoded byte count.
pub fn decode_b64(src: *str, dst: *mut [u8]) -> usize {
    let sb = src.as_bytes();
    var si: usize = 0_usize;
    var di: usize = 0_usize;
    while sb.len >= 4_usize && si <= sb.len - 4_usize {
        let c0 = sb[si];
        let c1 = sb[si + 1_usize];
        let c2 = sb[si + 2_usize];
        let c3 = sb[si + 3_usize];
        let v0 = b64_val(c0).widen.[u32]();
        let v1 = b64_val(c1).widen.[u32]();
        let v2 = b64_val(c2).widen.[u32]();
        let v3 = b64_val(c3).widen.[u32]();
        let triple = (v0 << 18_u32) | (v1 << 12_u32) | (v2 << 6_u32) | v3;
        if di < dst.len {
            dst[di] = ((triple >> 16_u32) & 0xFF_u32).trunc.[u8]();
            di = di +% 1_usize;
        }
        if c2 != b'=' && di < dst.len {
            dst[di] = ((triple >> 8_u32) & 0xFF_u32).trunc.[u8]();
            di = di +% 1_usize;
        }
        if c3 != b'=' && di < dst.len {
            dst[di] = (triple & 0xFF_u32).trunc.[u8]();
            di = di +% 1_usize;
        }
        si = si +% 4_usize;
    }
    return di;
}
